\import \parent.\parent.Hom[V := V, W := U, source := left, target := target] \as LeftMaps;
\import \parent.\parent.Hom[V := W, W := U, source := right, target := target] \as RightMaps;
\import \parent.\parent.Hom[V := Carrier, W := U, source := space, target := target] \as Maps;
\import \parent.\parent.Laws[V := U, space := target] \as Target;
\import algebra.Group[].Of[Carrier := U, group := Target.additive] \as Group;
\definition copair(f: LeftMaps.Map)(g: RightMaps.Map): Maps.Map := Maps.Map {
  apply := \fun (x: Carrier) => #add{target} (#apply{f} (first x)) (#apply{g} (second x)),
  addition := \fun (x, y: Carrier) => trans!{U} _ _ _
    (congr2!{U U U} (#add{target}) _ _ _ _ (#addition{f} (first x) (first y)) (#addition{g} (second x) (second y)))
    (Group.four (#apply{f} (first x)) (#apply{f} (first y)) (#apply{g} (second x)) (#apply{g} (second y))),
  scalar := \fun (a: R)(x: Carrier) => trans!{U} _ _ _
    (congr2!{U U U} (#add{target}) _ _ _ _ (#scalar{f} a (first x)) (#scalar{g} a (second x)))
    (sym!{U} _ _ (#vectorAdd{target} a (#apply{f} (first x)) (#apply{g} (second x)))),
};
\definition onLeft: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(x: V) -> #apply{(copair f g)} (#apply{firstInjection} x) = #apply{f} x :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map)(x: V) => trans!{U} _ _ _
    (congr!{U U} (#add{target} (#apply{f} x)) _ _ (RightMaps.zeroPreserved g)) (Group.zeroRight (#apply{f} x));
\definition onRight: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(x: W) -> #apply{(copair f g)} (#apply{secondInjection} x) = #apply{g} x :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map)(x: W) => trans!{U} _ _ _
    (congr!{U U} (\fun (a: U) => #add{target} a (#apply{g} x)) _ _ (LeftMaps.zeroPreserved f)) (Group.zeroLeft (#apply{g} x));
\definition unique: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(h: Maps.Map) ->
  (\forall (x: V) -> #apply{h} (#apply{firstInjection} x) = #apply{f} x) ->
  (\forall (x: W) -> #apply{h} (#apply{secondInjection} x) = #apply{g} x) -> h = copair f g :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map)(h: Maps.Map)(onLeft: _)(onRight: _) => Maps.ext h (copair f g)
    (\fun (x: Carrier) => trans!{U} _ _ _
      (congr!{Carrier U} (#apply{h}) _ _ (sym!{Carrier} _ _ (reconstruction x)))
      (trans!{U} _ _ _ (#addition{h} (#apply{firstInjection} (first x)) (#apply{secondInjection} (second x)))
        (congr2!{U U U} (#add{target}) _ _ _ _ (onLeft (first x)) (onRight (second x)))));
