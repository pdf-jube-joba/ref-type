\import \root.Module[].Over[R := R, ring := ring] \as Modules;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Composition[U := A1.Carrier, domain := A1.space] \as BeforeFirst;
\import Modules.Hom[V := B.Carrier, W := B1.Carrier, source := B.space, target := B1.space].Composition[U := A1.Carrier, domain := A1.space] \as AfterFirst;
\import Modules.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space].Composition[U := B1.Carrier, domain := B1.space] \as BeforeLast;
\import Modules.Hom[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space].Composition[U := B1.Carrier, domain := B1.space] \as AfterLast;
\definition first: Modules.MapBetween A1 B1 := AfterFirst.compose (b).forward (BeforeFirst.compose sequence.first (a).backward);
\definition last: Modules.MapBetween B1 C1 := AfterLast.compose (c).forward (BeforeLast.compose sequence.last (b).backward);
\import \parent.Transport[A1 := A1, B1 := B1, C1 := C1, sequence := sequence, f := first, g := last, a := a, b := b, c := c] \as Transport;
\definition firstCommutes: Transport.FirstCommutes := \fun (x: A.Carrier) => sym!{B1.Carrier} _ _
  (congr!{A.Carrier B1.Carrier} (\fun (y: A.Carrier) => ((b).forward).apply ((sequence.first).apply y)) _ _ ((a).leftInverse x));
\definition lastCommutes: Transport.LastCommutes := \fun (x: B.Carrier) => sym!{C1.Carrier} _ _
  (congr!{B.Carrier C1.Carrier} (\fun (y: B.Carrier) => ((c).forward).apply ((sequence.last).apply y)) _ _ ((b).leftInverse x));
\definition transported: Modules.ExactPair[A := A1, B := B1, C := C1].Sequence := Transport.transported firstCommutes lastCommutes;
