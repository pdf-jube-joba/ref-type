\import \parent.\parent.ExactPair[A := A1, B := B1, C := C1] \as Target;
\definition data: Target.Data := Target.Data { first := f, last := g };
\definition FirstCommutes: \Prop := \forall (x: A.Carrier) -> b.forward.apply (sequence.first.apply x) = f.apply (a.forward.apply x);
\definition LastCommutes: \Prop := \forall (x: B.Carrier) -> c.forward.apply (sequence.last.apply x) = g.apply (b.forward.apply x);
\import \parent.\parent.Hom[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space] \as ForwardLast;
\import \parent.\parent.Hom[V := C1.Carrier, W := C.Carrier, source := C1.space, target := C.space] \as BackwardLast;
\definition firstInverse: FirstCommutes -> \forall (x: A1.Carrier) ->
  f.apply x = b.forward.apply (sequence.first.apply (a.backward.apply x)) :=
  \fun (commutes: FirstCommutes)(x: A1.Carrier) => trans!{B1.Carrier} _ _ _
    (congr!{A1.Carrier B1.Carrier} (f.apply) _ _ (sym!{A1.Carrier} _ _ (a.rightInverse x)))
    (sym!{B1.Carrier} _ _ (commutes (a.backward.apply x)));
\definition lastInverse: LastCommutes -> \forall (x: B1.Carrier) ->
  g.apply x = c.forward.apply (sequence.last.apply (b.backward.apply x)) :=
  \fun (commutes: LastCommutes)(x: B1.Carrier) => trans!{C1.Carrier} _ _ _
    (congr!{B1.Carrier C1.Carrier} (g.apply) _ _ (sym!{B1.Carrier} _ _ (b.rightInverse x)))
    (sym!{C1.Carrier} _ _ (commutes (b.backward.apply x)));
\definition zero: FirstCommutes -> LastCommutes -> \forall (x: A1.Carrier) -> g.apply (f.apply x) = C1.space.zero :=
  \fun (first: FirstCommutes)(last: LastCommutes)(x: A1.Carrier) => trans!{C1.Carrier} _ _ _
    (congr!{B1.Carrier C1.Carrier} (g.apply) _ _ (firstInverse first x))
    (trans!{C1.Carrier} _ _ _ (sym!{C1.Carrier} _ _ (last (sequence.first.apply (a.backward.apply x))))
      (trans!{C1.Carrier} _ _ _
        (congr!{C.Carrier C1.Carrier} (c.forward.apply) _ _ (sequence.zero (a.backward.apply x)))
        (ForwardLast.zeroPreserved c.forward)));
\definition kernelImage: FirstCommutes -> LastCommutes -> \forall (x: B1.Carrier) -> g.apply x = C1.space.zero ->
  \exists { y: A1.Carrier \where f.apply y = x } := \block {
  \fun (first: FirstCommutes)(last: LastCommutes)(x: B1.Carrier)(closed: _) \then
  \let sourceClosed: sequence.last.apply (b.backward.apply x) = C.space.zero :=
    trans!{C.Carrier} _ _ _ (sym!{C.Carrier} _ _ (c.leftInverse (sequence.last.apply (b.backward.apply x))))
      (trans!{C.Carrier} _ _ _
        (congr!{C1.Carrier C.Carrier} (c.backward.apply) _ _ (trans!{C1.Carrier} _ _ _ (sym!{C1.Carrier} _ _ (lastInverse last x)) closed))
        (BackwardLast.zeroPreserved c.backward)) \then
  \takefrom y: \Cast[A.Carrier] ({ y: A.Carrier \where sequence.first.apply y = b.backward.apply x }) \by sequence.kernelImage (b.backward.apply x) sourceClosed \then
  \return Logic.existsIntro[A1.Carrier, { y: A1.Carrier \where f.apply y = x }] (a.forward.apply y)
    (trans!{B1.Carrier} _ _ _ (sym!{B1.Carrier} _ _ (first y))
      (trans!{B1.Carrier} _ _ _
        (congr!{B.Carrier B1.Carrier} (b.forward.apply) _ _ (\bysub(A.Carrier, { y: A.Carrier \where sequence.first.apply y = b.backward.apply x }, y)))
        (b.rightInverse x)))
};
\definition laws: FirstCommutes -> LastCommutes -> Target.Laws[data] :=
  \fun (first: FirstCommutes)(last: LastCommutes) => Target.Laws[data] { zero := zero first last, kernelImage := kernelImage first last };
\definition transported(first: FirstCommutes)(last: LastCommutes): Target.Sequence :=
  \into[Target.Data](data, { data: Target.Data \where Target.Laws[data] }) \by { laws first last };
