\import ReverseTargetIso.Inverse[] \as Inverse;
\import \parent.\parent.Isomorphism[V := C.Carrier, W := A.Carrier, source := C.space, target := A.space]
  .Composition[U := B.Carrier, final := B.space] \as First;
\definition middle: \parent.\parent.Isomorphism[V := C.Carrier, W := B.Carrier, source := C.space, target := B.space].Isomorphism := First.compose c a;
\import \parent.\parent.Isomorphism[V := C.Carrier, W := B.Carrier, source := C.space, target := B.space]
  .Composition[U := D.Carrier, final := D.space] \as Last;
\import \parent.\parent.Isomorphism[V := C.Carrier, W := D.Carrier, source := C.space, target := D.space] \as Iso;
\definition candidate: Iso.Isomorphism := Last.compose (Inverse.inverse b) middle;
\definition Commutes: \Prop := \forall (x: C.Carrier) -> #apply{#forward{b}} (#apply{f} x) = #apply{#forward{c}} (#apply{#forward{a}} x);
\definition forwardEquality: Commutes -> \forall (x: C.Carrier) -> #apply{f} x = #apply{#forward{candidate}} x :=
  \fun (commutes: Commutes)(x: C.Carrier) => trans!{D.Carrier} _ _ _
    (sym!{D.Carrier} _ _ (#leftInverse{b} (#apply{f} x)))
    (congr!{B.Carrier D.Carrier} (#apply{#backward{b}}) _ _ (commutes x));
\definition isomorphism(commutes: Commutes): Iso.Isomorphism := Iso.Isomorphism {
  forward := f, backward := #backward{candidate},
  leftInverse := \fun (x: C.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{D.Carrier C.Carrier} (#apply{#backward{candidate}}) _ _ (forwardEquality commutes x)) (#leftInverse{candidate} x),
  rightInverse := \fun (y: D.Carrier) => trans!{D.Carrier} _ _ _ (forwardEquality commutes (#apply{#backward{candidate}} y)) (#rightInverse{candidate} y),
};
