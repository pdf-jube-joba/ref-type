\import std.Data[].List[] \as Lists;
\definition zero: R := ring.zero;
\definition one: R := ring.one;
\definition add: R -> R -> R := ring.add;
\definition neg: R -> R := ring.neg;
\definition mul: R -> R -> R := ring.mul;
\definition addZeroLeft: _ := Scalars.zeroLeft;
\definition addZeroRight: _ := Scalars.zeroRight;
\definition addAssoc: _ := Scalars.assoc;
\definition addComm: _ := Scalars.comm;
\definition mulZeroLeft: _ := (ring.semiring).zeroAbsorbsLeft;
\definition mulZeroRight: _ := (ring.semiring).zeroAbsorbsRight;
\definition mulOneLeft: _ := ((ring.semiring).multiplicative).leftIdentity;
\definition mulAdd: _ := (ring.semiring).leftDistributive;
\definition addMul: _ := (ring.semiring).rightDistributive;
\definition sum(indices: Lists.List[I]) (f: I -> R): R :=
  Lists.foldr I R (\fun (i: _) (tail: _) => add (f i) tail) zero indices;

\import Lists.Distinct[A := I] \as Enumeration;
\definition keys: Lists.List[I] -> \Pow I := Enumeration.keys;
\definition Distinct(indices: Lists.List[I]): \Prop :=
  Enumeration.Distinct indices;
\definition distinctNil: Distinct Lists.List[I]::nil :=
  \fun (P: _) (base: _) (step: _) => base;
\definition distinctCons: \forall (i: I) -> \forall (tail: Lists.List[I]) ->
  Logic.Not (\In[I] (keys tail) i) -> Distinct tail -> Distinct (Lists.List[I]::cons i tail) :=
  \fun (i: _) (tail: _) (fresh: _) (distinct: Distinct tail) (P: _) (base: _) (step: _) =>
    step i tail fresh (distinct P base step);
\module Prop;
\module Single;
\module Vector(V: \Set, space: Space V);
