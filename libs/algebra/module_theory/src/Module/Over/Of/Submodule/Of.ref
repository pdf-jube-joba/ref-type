\definition Carrier: \Set := \Cast[V] (#carrier{S});
\definition additive: Alg.CommutativeGroup[Carrier] := Subgroups.subgroup (#carrier{S}) (closed S);
\definition zeroIn: Carrier := Subgroups.zeroIn (#carrier{S}) (closed S);
\definition addIn: Carrier -> Carrier -> Carrier := Subgroups.addIn (#carrier{S}) (closed S);
\definition negIn: Carrier -> Carrier := Subgroups.negIn (#carrier{S}) (closed S);
\definition scaleIn(a: R)(x: Carrier): Carrier :=
  \into[V](scale a x, #carrier{S}) \by { #scalar{S} a x (\bysub(V, #carrier{S}, x)) };
\definition moduleSpace: Space Carrier := Ring.RingModule[R, Carrier, ring] {
  zero := zeroIn, add := addIn, neg := negIn, smul := scaleIn,
  additive := Alg.CommutativeGroupLaws[Carrier, Alg.CommutativeGroupData[Carrier]::# (Alg.GroupData[Carrier]::# zeroIn addIn negIn)] {
    group := #group{additive}, commutative := #commutative{additive},
  },
  scalarOne := \fun (x: Carrier) => #scalarOne{space} x,
  scalarAssoc := \fun (a, b: R)(x: Carrier) => #scalarAssoc{space} a b x,
  scalarAdd := \fun (a, b: R)(x: Carrier) => #scalarAdd{space} a b x,
  vectorAdd := \fun (a: R)(x, y: Carrier) => #vectorAdd{space} a x y,
};
\import \parent.\parent.\parent.Hom[V := Carrier, W := V, source := moduleSpace, target := space] \as Inclusion;
\definition inclusion: Inclusion.Map := Inclusion.Map {
  apply := \fun (x: Carrier) => x,
  addition := \fun (x, y: Carrier) => \refl(add x y),
  scalar := \fun (a: R)(x: Carrier) => \refl(scale a x),
};
