\definition Carrier: \Set := \Cast[V] (S.carrier);
\definition additive: Alg.CommutativeGroup[Carrier] := Subgroups.subgroup (S.carrier) (closed S);
\definition zeroIn: Carrier := Subgroups.zeroIn (S.carrier) (closed S);
\definition addIn: Carrier -> Carrier -> Carrier := Subgroups.addIn (S.carrier) (closed S);
\definition negIn: Carrier -> Carrier := Subgroups.negIn (S.carrier) (closed S);
\definition scaleIn(a: R)(x: Carrier): Carrier :=
  \into[V](scale a x, S.carrier) \by { S.scalar a x (\bysub(V, S.carrier, x)) };
\definition moduleSpace: Space Carrier := Ring.RingModule[R, Carrier, ring] {
  zero := zeroIn, add := addIn, neg := negIn, smul := scaleIn,
  additive := Alg.CommutativeGroupLaws[Carrier, Alg.CommutativeGroupData[Carrier]::# (Alg.GroupData[Carrier]::# zeroIn addIn negIn)] {
    group := additive.group, commutative := additive.commutative,
  },
  scalarOne := \fun (x: Carrier) => space.scalarOne x,
  scalarAssoc := \fun (a, b: R)(x: Carrier) => space.scalarAssoc a b x,
  scalarAdd := \fun (a, b: R)(x: Carrier) => space.scalarAdd a b x,
  vectorAdd := \fun (a: R)(x, y: Carrier) => space.vectorAdd a x y,
};
\import \parent.\parent.\parent.Hom[V := Carrier, W := V, source := moduleSpace, target := space] \as Inclusion;
\definition inclusion: Inclusion.Map := Inclusion.Map {
  apply := \fun (x: Carrier) => x,
  addition := \fun (x, y: Carrier) => \refl(add x y),
  scalar := \fun (a: R)(x: Carrier) => \refl(scale a x),
};
