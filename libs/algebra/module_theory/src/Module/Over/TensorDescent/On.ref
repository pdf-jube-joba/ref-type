\use std.Logic[].Equality[].eq_reason_in;
\definition Onto: \Prop := \forall (c: C.Carrier) -> \exists ( b: B.Carrier \where q.apply b = c );
\definition Kills: \Prop := \forall (b: B.Carrier) -> q.apply b = C.space.zero -> \forall (y: N.Carrier) -> f.apply (Source.tensor b y) = U.space.zero;
\module At(y: N.Carrier) {
  \import \parent.\parent.\parent.Hom[V := B.Carrier, W := U.Carrier, source := B.space, target := U.space] \as Linear;
  \definition evaluate: Linear.Map := Linear.Map {
    apply := \fun (b: B.Carrier) => f.apply (Source.tensor b y),
    addition := \fun (b, c: B.Carrier) => trans!{U.Carrier} _ _ _
      (congr!{Source.Carrier U.Carrier} (f.apply) _ _ (Source.bilinear.addLeft b c y))
      (f.addition (Source.tensor b y) (Source.tensor c y)),
    scalar := \fun (a: R)(b: B.Carrier) => trans!{U.Carrier} _ _ _
      (congr!{Source.Carrier U.Carrier} (f.apply) _ _ (Source.bilinear.scaleLeft a b y))
      (f.scalar a (Source.tensor b y)),
  };
  \import Descent.On[q := q, f := evaluate] \as D;
  \definition vanishes: Kills -> D.KillsKernel := \fun (kills: Kills) => \fun (b: B.Carrier)(zero: q.apply b = C.space.zero) => kills b zero y;
  \definition map[onto: Onto][kills: Kills]: \parent.\parent.\parent.Hom[V := C.Carrier, W := U.Carrier, source := C.space, target := U.space].Map := D.map onto (vanishes kills);
  \definition onImage: \forall (onto: Onto)(kills: Kills)(b: B.Carrier) -> (map onto kills).apply (q.apply b) = f.apply (Source.tensor b y) := \fun (onto: Onto)(kills: Kills) => D.onImage onto (vanishes kills);
}
\definition bilinear[onto: Onto][kills: Kills][c: C.Carrier][y: N.Carrier]: U.Carrier := (At[y := y].map onto kills).apply c;
\definition rightAdd: \forall (onto: Onto)(kills: Kills)(c: C.Carrier)(y, z: N.Carrier) -> bilinear onto kills c (N.space.add y z) = U.space.add (bilinear onto kills c y) (bilinear onto kills c z) := \block {
  \fun (onto: Onto)(kills: Kills)(c: C.Carrier)(y, z: N.Carrier) \then
  \takefrom b: \Cast[B.Carrier] ({ b: B.Carrier \where q.apply b = c }) \by onto c \then
  \let equal: q.apply b = c := \bysub(B.Carrier, { b: B.Carrier \where q.apply b = c }, b) \then
  \return eq_reason!{{bilinear onto kills c (N.space.add y z)}
    "=" {bilinear onto kills (q.apply b) (N.space.add y z)} "by" {congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => bilinear onto kills c (N.space.add y z)) _ _ (sym!{C.Carrier} _ _ equal)}
    "=" {f.apply (Source.tensor b (N.space.add y z))} "by" {At[y := N.space.add y z].onImage onto kills b}
    "=" {f.apply (Source.space.add (Source.tensor b y) (Source.tensor b z))} "by" {congr!{Source.Carrier U.Carrier} (f.apply) _ _ (Source.bilinear.addRight b y z)}
    "=" {U.space.add (f.apply (Source.tensor b y)) (f.apply (Source.tensor b z))} "by" {f.addition (Source.tensor b y) (Source.tensor b z)}
    "=" {U.space.add (bilinear onto kills c y) (bilinear onto kills c z)} "by" {congr!{U.Carrier U.Carrier U.Carrier} (U.space.add) _ _ _ _
      (trans!{U.Carrier} _ _ _ (sym!{U.Carrier} _ _ (At[y := y].onImage onto kills b)) (congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => bilinear onto kills c y) _ _ equal))
      (trans!{U.Carrier} _ _ _ (sym!{U.Carrier} _ _ (At[y := z].onImage onto kills b)) (congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => bilinear onto kills c z) _ _ equal))}}
};
\definition rightScalar: \forall (onto: Onto)(kills: Kills)(a: R)(c: C.Carrier)(y: N.Carrier) -> bilinear onto kills c (N.space.smul a y) = U.space.smul a (bilinear onto kills c y) := \block {
  \fun (onto: Onto)(kills: Kills)(a: R)(c: C.Carrier)(y: N.Carrier) \then
  \takefrom b: \Cast[B.Carrier] ({ b: B.Carrier \where q.apply b = c }) \by onto c \then
  \let equal: q.apply b = c := \bysub(B.Carrier, { b: B.Carrier \where q.apply b = c }, b) \then
  \return eq_reason!{{bilinear onto kills c (N.space.smul a y)}
    "=" {bilinear onto kills (q.apply b) (N.space.smul a y)} "by" {congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => bilinear onto kills c (N.space.smul a y)) _ _ (sym!{C.Carrier} _ _ equal)}
    "=" {f.apply (Source.tensor b (N.space.smul a y))} "by" {At[y := N.space.smul a y].onImage onto kills b}
    "=" {f.apply (Source.space.smul a (Source.tensor b y))} "by" {congr!{Source.Carrier U.Carrier} (f.apply) _ _ (Source.bilinear.scaleRight a b y)}
    "=" {U.space.smul a (f.apply (Source.tensor b y))} "by" {f.scalar a (Source.tensor b y)}
    "=" {U.space.smul a (bilinear onto kills c y)} "by" {congr!{U.Carrier U.Carrier} (U.space.smul a) _ _
      (trans!{U.Carrier} _ _ _ (sym!{U.Carrier} _ _ (At[y := y].onImage onto kills b)) (congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => bilinear onto kills c y) _ _ equal))}}
};
\definition laws[onto: Onto][kills: Kills]: Target.BilinearLaws[U.Carrier, U.space, (bilinear onto kills)] := Target.BilinearLaws[U.Carrier, U.space, (bilinear onto kills)] {
  addLeft := \fun (c, d: C.Carrier)(y: N.Carrier) => (At[y := y].map onto kills).addition c d,
  scaleLeft := \fun (a: R)(c: C.Carrier)(y: N.Carrier) => (At[y := y].map onto kills).scalar a c,
  addRight := rightAdd onto kills, scaleRight := rightScalar onto kills,
};
\definition map[onto: Onto][kills: Kills]: Output.Map := Universal.map (bilinear onto kills) (laws onto kills);
\definition onTensor: \forall (onto: Onto)(kills: Kills)(c: C.Carrier)(y: N.Carrier) -> (map onto kills).apply (Target.tensor c y) = bilinear onto kills c y :=
  \fun (onto: Onto)(kills: Kills) => Universal.onTensor (bilinear onto kills) (laws onto kills);
\definition factor: \forall (onto: Onto)(kills: Kills) -> Composition.compose (map onto kills) (Mapping.map q Coefficients.identity) = f :=
  \fun (onto: Onto)(kills: Kills) => Equality.ext (Composition.compose (map onto kills) (Mapping.map q Coefficients.identity)) f
    (\fun (b: B.Carrier)(y: N.Carrier) => eq_reason_in!{U.Carrier _
      "=" _ "by" { congr!{Target.Carrier U.Carrier} ((map onto kills).apply) _ _ (Mapping.onTensor q Coefficients.identity b y) }
      "=" _ "by" { onTensor onto kills (q.apply b) y }
      "=" _ "by" { At[y := y].onImage onto kills b }
    });
\definition unique: \forall (onto: Onto)(kills: Kills)(h: Output.Map) -> Composition.compose h (Mapping.map q Coefficients.identity) = f -> h = map onto kills :=
  \fun (onto: Onto)(kills: Kills)(h: Output.Map)(factors: Composition.compose h (Mapping.map q Coefficients.identity) = f) => Universal.ext h (map onto kills) (\block {
    \fun (c: C.Carrier)(y: N.Carrier) \then
    \takefrom b: \Cast[B.Carrier] ({ b: B.Carrier \where q.apply b = c }) \by onto c \then
    \let equal: q.apply b = c := \bysub(B.Carrier, { b: B.Carrier \where q.apply b = c }, b) \then
    \return eq_reason!{{h.apply (Target.tensor c y)}
      "=" {h.apply (Target.tensor (q.apply b) y)} "by" {congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => h.apply (Target.tensor c y)) _ _ (sym!{C.Carrier} _ _ equal)}
      "=" {h.apply ((Mapping.map q Coefficients.identity).apply (Source.tensor b y))}
      "by" {congr!{Target.Carrier U.Carrier} (h.apply) _ _ (sym!{Target.Carrier} _ _ (Mapping.onTensor q Coefficients.identity b y))}
      "=" {f.apply (Source.tensor b y)} "by" {congr!{Input.Map U.Carrier} (\fun (g: Input.Map) => g.apply (Source.tensor b y)) _ _ factors}
      "=" {bilinear onto kills (q.apply b) y} "by" {sym!{U.Carrier} _ _ (At[y := y].onImage onto kills b)}
      "=" {bilinear onto kills c y} "by" {congr!{C.Carrier U.Carrier} (\fun (c: C.Carrier) => bilinear onto kills c y) _ _ equal}
      "=" {(map onto kills).apply (Target.tensor c y)} "by" {sym!{U.Carrier} _ _ (onTensor onto kills c y)}}
  });

\definition factorExists: Onto -> Kills -> \exists ( h: Output.Map \where Composition.compose h (Mapping.map q Coefficients.identity) = f ) :=
  \fun (onto: Onto)(kills: Kills) => Logic.existsIntro[Output.Map, { h: Output.Map \where Composition.compose h (Mapping.map q Coefficients.identity) = f }] (map onto kills)
    (factor onto kills);
