\import \parent.Laws[V := V, space := space] \as ModuleLaws;
\definition zero: V := ModuleLaws.zero;
\definition add: V -> V -> V := ModuleLaws.add;
\definition neg: V -> V := ModuleLaws.neg;
\definition scale: R -> V -> V := ModuleLaws.scale;
\definition additive: Alg.CommutativeGroup[V] := ModuleLaws.additive;
\import algebra.Group[].Of[Carrier := V, group := additive] \as Group;
\definition negativeOne: \forall (x: V) -> scale (ring.neg (ring.one)) x = neg x := ModuleLaws.negativeOne;
\structure Data: \Set {
  carrier: \Pow V,
}
\structure Laws[data: Data]: \Prop {
  zero: \In[V] data.carrier zero,
  addition: \forall (x, y: V) -> \In[V] data.carrier x -> \In[V] data.carrier y -> \In[V] data.carrier (add x y),
  scalar: \forall (a: R)(x: V) -> \In[V] data.carrier x -> \In[V] data.carrier (scale a x),
}
\definition Submodule: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition dataExt: \forall (S, T: Data) -> S.carrier = T.carrier -> S = T :=
  \induction (S: Data) \return \forall (T: Data) -> S.carrier = T.carrier -> S = T \with {
    | # : \fun (S: \Pow V) => \induction (T: Data) \return S = T.carrier -> Data::# S = T \with {
      | # : \fun (T: \Pow V)(equal: S = T) => congr!{{\Pow V} Data} (\fun (U: \Pow V) => Data::# U) S T equal
    }
  };
\definition ext: \forall (S, T: Submodule) ->
  (\forall (x: V) -> \In[V] (S.carrier) x -> \In[V] (T.carrier) x) ->
  (\forall (x: V) -> \In[V] (T.carrier) x -> \In[V] (S.carrier) x) -> S = T :=
  \fun (S, T: Submodule)(forward: \forall (x: V) -> \In[V] (S.carrier) x -> \In[V] (T.carrier) x)
    (backward: \forall (x: V) -> \In[V] (T.carrier) x -> \In[V] (S.carrier) x) =>
      dataExt S T (\axiom:setext(S.carrier, T.carrier, forward, backward));
\definition Member(S: Submodule)(x: V): \Prop := \In[V] (S.carrier) x;
\definition negativeClosed: \forall (S: Submodule)(x: V) -> Member S x -> Member S (neg x) :=
  \fun (S: _)(x: _)(member: _) => \idelim scale (ring.neg (ring.one)) x = neg x \with y: V => Member S y \by {
    base: S.scalar (ring.neg (ring.one)) x member,
    equality: negativeOne x
  };
\definition differenceClosed: \forall (S: Submodule)(x, y: V) -> Member S x -> Member S y -> Member S (Group.difference x y) :=
  \fun (S: _)(x, y: _)(left: _)(right: _) => S.addition x (neg y) left (negativeClosed S y right);
\import Group.Subgroups[] \as Subgroups;
\definition closed(S: Submodule): Subgroups.Closed[S.carrier] := Subgroups.Closed[S.carrier] {
  zero := S.zero, add := S.addition, neg := negativeClosed S,
};
