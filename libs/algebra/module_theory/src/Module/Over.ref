\definition Space[V: \Set]: \Set := Ring.RingModule[R, V, ring];
\structure Bundle := {
  Carrier: \Set,
  space: Space Carrier,
};
\structure Family[Index: \Set] := {
  Carrier: Index -> \Set,
  space: \forall (i: Index) -> Space (Carrier i),
};
\definition scalarGroup: Alg.CommutativeGroup[R] := Alg.CommutativeGroup[R] {
  base := Alg.GroupData[R]::# (ring.zero) (ring.add) (ring.neg),
  group := Alg.GroupLaws[R, Alg.GroupData[R]::# (ring.zero) (ring.add) (ring.neg)] {
    monoid := ((ring.semiring).additive).monoid,
    leftInverse := ring.additiveInverse,
    rightInverse := \fun (a: R) => trans!{R} _ _ _ (((ring.semiring).additive).commutative a (ring.neg a)) (ring.additiveInverse a),
  },
  commutative := ((ring.semiring).additive).commutative,
};
\import algebra.Group[].Of[Carrier := R, group := scalarGroup] \as Scalars;
\module Laws(V: \Set, space: Space V);
\module Submodule(V: \Set, space: Space V);
\module Of(V: \Set, space: Space V);
\module Hom(V, W: \Set, source: Space V, target: Space W);
\module End(V: \Set, space: Space V) {
  \import \parent.Hom[V := V, W := V, source := space, target := space] \as Maps;
  \definition identity: Maps.Map := Maps.Map {
    apply := \fun (x: V) => x,
    addition := \fun (x, y: V) => \refl(space.add x y),
    scalar := \fun (a: R)(x: V) => \refl(space.smul a x),
  };
}
\module Zero;
\definition scalarModule: Space R := Ring.RingModule[R, R, ring] {
  zero := ring.zero, add := ring.add, neg := ring.neg, smul := ring.mul,
  additive := Alg.CommutativeGroupLaws[R, Alg.CommutativeGroupData[R]::# (Alg.GroupData[R]::# (ring.zero) (ring.add) (ring.neg))] {
    group := scalarGroup.group, commutative := scalarGroup.commutative,
  },
  scalarOne := ((ring.semiring).multiplicative).leftIdentity,
  scalarAssoc := ((ring.semiring).multiplicative).associative,
  scalarAdd := (ring.semiring).rightDistributive,
  vectorAdd := (ring.semiring).leftDistributive,
};
\module Isomorphism(V, W: \Set, source: Space V, target: Space W);
\module Functions(X, V: \Set, target: Space V);
\definition MapBetween[A, B: Bundle]: \Set := Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Map;
\definition Surjective[A, B: Bundle][f: MapBetween A B]: \Prop := \forall (y: B.Carrier) -> \exists ( x: A.Carrier \where f.apply x = y );
\definition Injective[A, B: Bundle][f: MapBetween A B]: \Prop := \forall (x, y: A.Carrier) -> f.apply x = f.apply y -> x = y;
\definition Projective[P: Bundle]: \Prop :=
  \forall (A, B: Bundle)(q: MapBetween A B) -> Surjective A B q -> \forall (f: MapBetween P B) ->
    \exists ( g: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (g.apply x) = f.apply x );
\module Presentation(Generators: \Set);
\module Free(Generators: \Set);
\module CanonicalFree(M: Bundle);
\module Tensor(V, W: \Set, left: Space V, right: Space W);
\module Product(Index: \Set, family: Family[Index]);
\module Biproduct(V, W: \Set, left: Space V, right: Space W);
\module FirstIsomorphism(V, W: \Set, source: Space V, target: Space W, f: \parent.Hom[V := V, W := W, source := source, target := target].Map);
\module FreeResolution(M: Bundle);
\module ShortExact(A, B, C: Bundle);
\module ProjectiveLaws;
\module Coordinates(I: \Set);
\module Sums(I: \Set);
\module Alternating(V: \Set, space: Space V);
\module DirectSum(Index: \Set, family: Family[Index]);
\module FinitelySupported(Index: \Set, family: Family[Index]);
\module ShortExactComparison(A, B, C, A1, B1, C1: Bundle);
\module ExactFive(A, B, C, D, E: Bundle);
\module ExactFiveComparison(A, B, C, D, E, A1, B1, C1, D1, E1: Bundle);
\module FiveLemma(A, B, C, D, E, A1, B1, C1, D1, E1: Bundle);
\module Snake(A, B, C, A1, B1, C1: Bundle);
\module QuotientMapping(A, B: Bundle);

\module QuotientCorrespondence(V: \Set, space: Space V, S: \parent.Submodule[V := V, space := space].Submodule);
\module SurjectiveDescent(A, B, U: Bundle);
\module TensorDescent(B, C, N, U: Bundle);
\module RightExact(A, B, C: Bundle);
\module TensorRightExact(A, B, C, N: Bundle);
\module FiniteCoordinates(n: std.Data[].Nat[].Nat^);
\module KernelTransport(V, W, X, Y: \Set, vSpace: Space V, wSpace: Space W, xSpace: Space X, ySpace: Space Y,
  f: \parent.Hom[V := V, W := W, source := vSpace, target := wSpace].Map,
  g: \parent.Hom[V := X, W := Y, source := xSpace, target := ySpace].Map,
  domainIso: \parent.Isomorphism[V := V, W := X, source := vSpace, target := xSpace].Isomorphism,
  codomainIso: \parent.Isomorphism[V := W, W := Y, source := wSpace, target := ySpace].Isomorphism);

\module FamilyInjection(Index: \Set, family: Family[Index]);

\module SnakeNaturality(A, B, C, A1, B1, C1, A2, B2, C2, A3, B3, C3: Bundle);

\module ExactPair(A, B, C: Bundle);
\module TensorSplitShortExact(A, B, C, N: Bundle);
\module Pushout(A, B, C: Bundle);

\module DirectSumMapping(Index: \Set, sourceFamily, targetFamily: Family[Index]);
\module IsomorphismSquare(A, B, C, D: Bundle) {
  \import \parent.Isomorphism[V := A.Carrier, W := C.Carrier, source := A.space, target := C.space] \as SourceIso;
  \import \parent.Isomorphism[V := B.Carrier, W := D.Carrier, source := B.space, target := D.space] \as TargetIso;
  \import \parent.Isomorphism[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as TopIso;
  \import \parent.Hom[V := C.Carrier, W := D.Carrier, source := C.space, target := D.space] \as Maps;
  \module On(a: SourceIso.Isomorphism, b: TargetIso.Isomorphism, c: TopIso.Isomorphism, f: Maps.Map);
  \import \parent.Isomorphism[V := C.Carrier, W := A.Carrier, source := C.space, target := A.space] \as ReverseSourceIso;
  \import \parent.Isomorphism[V := D.Carrier, W := B.Carrier, source := D.space, target := B.space] \as ReverseTargetIso;
  \module Incoming(a: ReverseSourceIso.Isomorphism, b: ReverseTargetIso.Isomorphism, c: TopIso.Isomorphism, f: Maps.Map);
  \import \parent.Isomorphism[V := C.Carrier, W := D.Carrier, source := C.space, target := D.space] \as Result;
  \definition transport[a: SourceIso.Isomorphism][b: TargetIso.Isomorphism][c: TopIso.Isomorphism][f: Maps.Map]
    [commutes: \forall (x: A.Carrier) -> (f).apply (((a).forward).apply x) = ((b).forward).apply (((c).forward).apply x)]: Result.Isomorphism :=
      On[a := a, b := b, c := c, f := f].isomorphism commutes;
  \definition incoming[a: ReverseSourceIso.Isomorphism][b: ReverseTargetIso.Isomorphism][c: TopIso.Isomorphism][f: Maps.Map]
    [commutes: \forall (x: C.Carrier) -> ((b).forward).apply ((f).apply x) = ((c).forward).apply (((a).forward).apply x)]: Result.Isomorphism :=
      Incoming[a := a, b := b, c := c, f := f].isomorphism commutes;
}
\module FreePullback(Left, Right, Overlap, Whole: \Set);

\module Identity(V: \Set, space: Space V) {
  \import \parent.End[V := V, space := space] \as Maps;
  \import \parent.Isomorphism[V := V, W := V, source := space, target := space] \as Iso;
  \definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
    forward := Maps.identity, backward := Maps.identity,
    leftInverse := \fun (x: V) => \refl(x), rightInverse := \fun (x: V) => \refl(x),
  };
}
\module AbelianHom(N: Bundle);
