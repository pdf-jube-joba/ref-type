\import \parent.Representation[W := V, J := I, target := space] \as Representation;
\import \parent.\parent.Square[I := I] \as Matrices;
\import End.Operations[] \as Operations;
\definition traceMatrix: \forall (b: Basis) -> \forall (f: End.Map) ->
  trace b f = Matrices.trace (b.indices) (Representation.toMatrix b b f) :=
  \fun (b: Basis) (f: End.Map) => \refl(trace b f);
\definition traceZero: \forall (b: Basis) -> trace b Operations.zeroMap = zero :=
  \fun (b: Basis) => trans!{K} _ _ _
    (SumLaws.congruent (b.indices) (\fun (i: _) => coordinates b (space.zero) i) (\fun (i: _) => zero)
      (\fun (i: _) => congr!{Coordinates.Vector K} (\fun (x: _) => x i) _ _ ((b.coordinates).preservesZero)))
    (SumLaws.zeroSum (b.indices));
\definition traceAdd: \forall (b: Basis) -> \forall (f, g: End.Map) ->
  trace b (Operations.plus f g) = add (trace b f) (trace b g) :=
  \fun (b: Basis) (f, g: End.Map) => trans!{K} _ _ _
    (SumLaws.congruent (b.indices)
      (\fun (i: _) => coordinates b (space.add (f.apply (b.vectors i)) (g.apply (b.vectors i))) i)
      (\fun (i: _) => add (coordinates b (f.apply (b.vectors i)) i) (coordinates b (g.apply (b.vectors i)) i))
      (\fun (i: _) => (coordinate b i).preservesAdd (f.apply (b.vectors i)) (g.apply (b.vectors i))))
    (SumLaws.additive (b.indices) (\fun (i: _) => coordinates b (f.apply (b.vectors i)) i) (\fun (i: _) => coordinates b (g.apply (b.vectors i)) i));
\definition traceScale: \forall (b: Basis) -> \forall (a: K) -> \forall (f: End.Map) ->
  trace b (Operations.scale a f) = mul a (trace b f) :=
  \fun (b: Basis) (a: _) (f: End.Map) => trans!{K} _ _ _
    (SumLaws.congruent (b.indices)
      (\fun (i: _) => coordinates b (space.smul a (f.apply (b.vectors i))) i)
      (\fun (i: _) => mul a (coordinates b (f.apply (b.vectors i)) i))
      (\fun (i: _) => (coordinate b i).preservesScale a (f.apply (b.vectors i))))
    (SumLaws.multiplyLeft (b.indices) a (\fun (i: _) => coordinates b (f.apply (b.vectors i)) i));
