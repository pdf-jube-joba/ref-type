\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Coordinates[I := I].Kronecker[] \as Kronecker;
\import \parent.\parent.Sums[I := I].Single[] \as Single;
\import \parent.\parent.Eigen[V := V, space := space] \as Eigen;
\definition naturalScalar: N.Nat^ -> K :=
  \induction (n: N.Nat^) \return K \with {
    | zero: zero
    | succ: \fun (n: N.Nat^) (value: K) => add one value
  };
\definition diagonalOne: \forall (b: Basis) (i: I) -> \In[I] (Sums.keys b.indices) i -> coordinates b (b.vectors i) i = one := \block {
  \fun (b: Basis) (i: I) (member: _) \then
  \let x: Coordinates.Vector := \fun (j: I) => Kronecker.delta i j \then
  \let coefficient: I -> K := \fun (j: I) => coordinates b (b.vectors i) j \then
  \return eq_reason_in!{K _
    "=" _ "by" { sym!{K} _ _ (Single.extract b.indices b.distinct i member coefficient) }
    "=" _ "by" { b.dualReconstruction x i }
    "=" _ "by" { Kronecker.self i }
  }
};
\definition sumOnes: \forall (indices: Lists.List[I]) -> Sums.sum indices (\fun (_: I) => one) = naturalScalar (Lists.length I indices) :=
  \induction (indices: Lists.List[I]) \return Sums.sum indices (\fun (_: I) => one) = naturalScalar (Lists.length I indices) \with {
    | nil: \refl(zero)
    | cons: \fun (i: I) (tail: Lists.List[I]) (ih: _) => congr!{K K} (add one) _ _ ih
  };
\definition identityTrace: \forall (b: Basis) -> trace b Eigen.identity = naturalScalar (dimension b) :=
  \fun (b: Basis) => trans!{K} _ _ _
    (SumLaws.congruentOnKeys b.indices (\fun (i: I) => coordinates b (b.vectors i) i) (\fun (_: I) => one) (diagonalOne b))
    (sumOnes b.indices);
\module Comparison(J: \Set) {
  \import \parent.\parent.Rebase[J := J] \as Rebase;
  \import \parent.\parent.\parent.Finite[V := V, I := J, space := space] \as Other;
  \import Other.Dimension[] \as OtherDimension;
  \definition equalScalarDimension: \forall (b: Basis) (c: Other.Basis) -> naturalScalar (dimension b) = OtherDimension.naturalScalar (Other.dimension c) :=
    \fun (b: Basis) (c: Other.Basis) => eq_reason_in!{K _
      "=" _ "by" { sym!{K} _ _ (identityTrace b) }
      "=" _ "by" { Rebase.traceIndependent b c Eigen.identity }
      "=" _ "by" { OtherDimension.identityTrace c }
    };
}
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition omittedTrivial: \forall (b: Basis) (i: I) -> Logic.Not (\In[I] (Sums.keys b.indices) i) -> zero = one :=
  \fun (b: Basis)(i: I)(absent: _) => eq_reason_in!{K zero
    "=" _ "by" { sym!{K} _ _ (Single.absent b.indices i absent (\fun (j: I) => coordinates b (b.vectors i) j)) }
    "=" _ "by" { b.dualReconstruction (\fun (j: I) => Kronecker.delta i j) i }
    "=" one "by" { Kronecker.self i }
  };
\definition trivialEquality: zero = one -> \forall (a, b: K) -> a = b :=
  \fun (trivial: zero = one)(a, b: K) => eq_reason_in!{K a
    "=" { mul a one } "by" { sym!{K} _ _ (mulOneRight a) }
    "=" { mul a zero } "by" { congr!{K K} (mul a) _ _ (sym!{K} _ _ trivial) }
    "=" zero "by" { mulZeroRight a }
    "=" { mul b zero } "by" { sym!{K} _ _ (mulZeroRight b) }
    "=" { mul b one } "by" { congr!{K K} (mul b) _ _ trivial }
    "=" b "by" { mulOneRight b }
  };
\definition biorthogonal: \forall (b: Basis) (i, j: I) -> coordinates b (b.vectors i) j = Kronecker.delta j i :=
  \fun (b: Basis)(i, j: I) => either!{{(Classical.excludedMiddle (\In[I] (Sums.keys b.indices) j))} {coordinates b (b.vectors i) j = Kronecker.delta j i}
    {\fun (member: _) => trans!{K} _ _ _
      (sym!{K} _ _ (Single.extract b.indices b.distinct j member (\fun (k: I) => coordinates b (b.vectors i) k)))
      (b.dualReconstruction (\fun (k: I) => Kronecker.delta j k) i)}
    {\fun (absent: _) => trivialEquality (omittedTrivial b j absent) _ _}
  };
\definition extract: \forall (b: Basis)(i: I)(x: Coordinates.Vector) ->
  Sums.sum b.indices (\fun (j: I) => mul (Kronecker.delta i j) (x j)) = x i :=
  \fun (b: Basis)(i: I)(x: Coordinates.Vector) => trans!{K} _ _ _
    (SumLaws.congruent b.indices (\fun (j: I) => mul (Kronecker.delta i j) (x j))
      (\fun (j: I) => mul (x j) (coordinates b (b.vectors i) j))
      (\fun (j: I) => trans!{K} _ _ _ (mulComm (Kronecker.delta i j) (x j))
        (congr!{K K} (mul (x j)) _ _ (trans!{K} _ _ _ (Kronecker.symmetric i j) (sym!{K} _ _ (biorthogonal b i j))))))
    (b.dualReconstruction x i);
