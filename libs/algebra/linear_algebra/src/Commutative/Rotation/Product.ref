\definition path[t: K]: Isos.Isomorphism := Blocks.compose (Blocks.stabilize a)
  (Blocks.compose (rotation t) (Blocks.compose (Blocks.stabilize b) (Isos.inverse (rotation t))));
\definition starts: \forall (p: Sum.Carrier) -> (path Spaces.zero).forward.apply p = Sum.make (a.forward.apply (b.forward.apply (Sum.first p))) (Sum.second p) :=
  \fun (p: Sum.Carrier) => trans!{Sum.Carrier} _ _ _
    (congr!{Sum.Carrier Sum.Carrier} (\fun (q: Sum.Carrier) => (Blocks.diagonal a.forward).apply ((rotation Spaces.zero).forward.apply ((Blocks.diagonal b.forward).apply q))) _ _ (inverseAtZero p))
    (congr!{Sum.Carrier Sum.Carrier} (Blocks.diagonal a.forward).apply _ _ (atZero ((Blocks.diagonal b.forward).apply p)));
\definition conjugates: \forall (p: Sum.Carrier) ->
  (rotation Spaces.one).forward.apply ((Blocks.diagonal b.forward).apply ((rotation Spaces.one).backward.apply p)) = Sum.make (Sum.first p) (b.forward.apply (Sum.second p)) :=
  \fun (p: Sum.Carrier) => trans!{Sum.Carrier} _ _ _
    (congr!{Sum.Carrier Sum.Carrier} (\fun (q: Sum.Carrier) => (rotation Spaces.one).forward.apply ((Blocks.diagonal b.forward).apply q)) _ _ (inverseAtOne p))
    (trans!{Sum.Carrier} _ _ _
      (atOne (Sum.make (b.forward.apply (space.neg (Sum.second p))) (Sum.first p)))
      (Pairs.pairCong _ _ _ _ (\refl(Sum.first p))
        (trans!{V} _ _ _ (congr!{V V} space.neg _ _ (Maps.Operations[].preservesNeg b.forward (Sum.second p))) (Group.negNeg (b.forward.apply (Sum.second p))))));
\definition ends: \forall (p: Sum.Carrier) -> (path Spaces.one).forward.apply p = Sum.make (a.forward.apply (Sum.first p)) (b.forward.apply (Sum.second p)) :=
  \fun (p: Sum.Carrier) => congr!{Sum.Carrier Sum.Carrier} (Blocks.diagonal a.forward).apply _ _ (conjugates p);
