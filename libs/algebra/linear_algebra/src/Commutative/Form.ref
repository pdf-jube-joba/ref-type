\import \parent.Linear[V := V, W := V, source := space, target := space] \as End;
\structure BilinearData: \Set := {
  form: V -> V -> K,
};
\structure BilinearLaws[data: BilinearData]: \Prop := {
  zeroLeft: \forall (x: V) -> data.form (space.zero) x = zero,
  zeroRight: \forall (x: V) -> data.form x (space.zero) = zero,
  addLeft: \forall (x, y, z: V) -> data.form (space.add x y) z = add (data.form x z) (data.form y z),
  addRight: \forall (x, y, z: V) -> data.form x (space.add y z) = add (data.form x y) (data.form x z),
  scaleLeft: \forall (a: K) (x, y: V) -> data.form (space.smul a x) y = mul a (data.form x y),
  scaleRight: \forall (a: K) (x, y: V) -> data.form x (space.smul a y) = mul a (data.form x y),
};
\definition Bilinear: \Set := \Cast[BilinearData] ({ data: BilinearData \where BilinearLaws[data] });
\definition Symmetric[h: Bilinear]: \Prop := \forall (x, y: V) -> h.form x y = h.form y x;
\definition Alternating[h: Bilinear]: \Prop := \forall (x: V) -> h.form x x = zero;
\definition Nondegenerate[h: Bilinear]: \Prop := \forall (x: V) -> (\forall (y: V) -> h.form x y = zero) -> x = space.zero;
\definition Adjoint[h: Bilinear] [f, g: End.Map]: \Prop :=
  \forall (x, y: V) -> h.form (f.apply x) y = h.form x (g.apply y);
\definition SelfAdjoint[h: Bilinear] [f: End.Map]: \Prop := Adjoint h f f;
