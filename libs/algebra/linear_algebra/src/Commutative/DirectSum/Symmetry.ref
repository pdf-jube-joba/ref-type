\import \parent.\parent.DirectSum[V := W, W := V, left := right, right := left] \as Opposite;
\import \parent.\parent.Linear[V := Carrier, W := Opposite.Carrier, source := space, target := Opposite.space] \as ForwardMaps;
\import \parent.\parent.Linear[V := Opposite.Carrier, W := Carrier, source := Opposite.space, target := space] \as BackwardMaps;
\definition forward: ForwardMaps.Map := ForwardMaps.Map {
  apply := \fun (v: Carrier) => Opposite.make (second v) (first v),
  preservesAdd := \fun (v, w: Carrier) => \refl(Opposite.plus (Opposite.make (second v) (first v)) (Opposite.make (second w) (first w))),
  preservesScale := \fun (a: K)(v: Carrier) => \refl(Opposite.scale a (Opposite.make (second v) (first v)))
};
\definition backward: BackwardMaps.Map := BackwardMaps.Map {
  apply := \fun (v: Opposite.Carrier) => make (Opposite.second v) (Opposite.first v),
  preservesAdd := \fun (v, w: Opposite.Carrier) => \refl(plus (make (Opposite.second v) (Opposite.first v)) (make (Opposite.second w) (Opposite.first w))),
  preservesScale := \fun (a: K)(v: Opposite.Carrier) => \refl(scale a (make (Opposite.second v) (Opposite.first v)))
};
\import \parent.\parent.Isomorphism[V := Carrier, W := Opposite.Carrier, source := space, target := Opposite.space] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := Pairs.eta,
  rightInverse := Pair.Prop[A := W, B := V].eta
};
