\import \parent.\parent.Isomorphism[V := U, W := V, source := domain, target := source] \as Before;
\import \parent.\parent.Isomorphism[V := U, W := W, source := domain, target := target] \as Result;
\import \parent.\parent.Linear[V := V, W := U, source := source, target := domain].Composition[U := W, domain := target] \as Return;
\definition compose[a: Isomorphism][b: Before.Isomorphism]: Result.Isomorphism := Result.Isomorphism {
  forward := Forward.Composition[U := U, domain := domain].compose a.forward b.forward,
  backward := Return.compose b.backward a.backward,
  leftInverse := \fun (u: U) => trans!{U} _ _ _
    (congr!{V U} b.backward.apply _ _ ((laws a).leftInverse (b.forward.apply u))) ((Before.laws b).leftInverse u),
  rightInverse := \fun (w: W) => trans!{W} _ _ _
    (congr!{V W} a.forward.apply _ _ ((Before.laws b).rightInverse (a.backward.apply w))) ((laws a).rightInverse w),
};
