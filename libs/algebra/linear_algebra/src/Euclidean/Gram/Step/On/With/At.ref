\use std.Logic[].Equality[].eq_reason_in;
\definition expanded: apply (Triangular.forward.apply v) = space.add (space.smul (Split.head v) column) (tailMap.apply (Split.tail v)) :=
  trans!{Vector} _ _ _ (congr!{Vector Vector Vector} space.add _ _ _ _
    (congr!{{R.Real} Vector} (\fun (a: R.Real) => space.smul a unit.vector) _ _ (Triangular.At[v := v].forwardHead))
    (trans!{Vector} _ _ _ (congr!{{Source.Vector} Vector} previous.frame.apply _ _ (Triangular.At[v := v].forwardTail)) (sym!{Vector} _ _ (previous.formula (Split.tail v)))))
    (\axiom:funext((space.add (space.smul (R.add (R.mul Normalize.length (Split.head v)) (row.apply (Split.tail v))) unit.vector)
      (residual.apply (Split.tail v))), space.add (space.smul (Split.head v) column) (tailMap.apply (Split.tail v)),
      \fun (j: Fin.Fin n) => trans!{{R.Real}} _ _ _ (recombine (Split.head v) (row.apply (Split.tail v)) (unit.vector j) (tailMap.apply (Split.tail v) j))
        (congr!{{R.Real} {R.Real}} (\fun (a: R.Real) => R.add (R.mul (Split.head v) a) (tailMap.apply (Split.tail v) j)) _ _
          (sym!{{R.Real}} _ _ (congr!{Vector {R.Real}} (\fun (w: Vector) => w j) _ _ columnFormula)))));
\definition formula: A.apply v = frame.apply (Triangular.forward.apply v) := sym!{Vector} _ _
  (eq_reason_in!{Vector _
    "=" _ "by" expanded
    "=" _ "by" { sym!{Vector} _ _ (joinFormula (Split.head v) (Split.tail v)) }
    "=" _ "by" { congr!{{Higher.Vector} Vector} A.apply _ _ (Split.recover v) }
  });
