\import Higher.Matrix[m := n] \as HigherMatrix;
\import Shared.Of[h := sharedForm].Gram[k := k] \as Generic;
\import Generic.Step[].On[A := A, injective := injective, positive := sharedPositive] \as Step;
\definition genericPrevious: Generic.Factorization[Step.residual] := Generic.Factorization[Step.residual] {
  frame := previous.frame, isometry := Matrix.isometryLaws previous.frame, change := previous.change, formula := previous.formula,
};
\import Step.With[previous := genericPrevious] \as Construct;
\definition value: HigherMaps.Map := Construct.value;
\definition frame: HigherMatrix.Isometry := \into[HigherMaps.Map](value, HigherMatrix.Isometry) \by { Construct.isometry };
\definition factorization: HigherGram.Factorization[A] := HigherGram.Factorization[A] {
  frame := frame, change := Construct.factorization.change, formula := Construct.formula,
};
