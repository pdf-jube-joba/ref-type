\use std.Logic[].Equality[].eq_reason_in;
/* Projection, orthogonal complement, and the inverse on the image. */
\import Matrix.OfIsometry[f := factor.frame] \as Frame;
\definition tangent: Projection := Frame.projection;
\definition normal: Projection := Frame.normal;
\definition coordinates: Spaces.Linear[V := Vector, W := Source.Vector, source := space, target := Source.space].Map := Matrix.transpose factor.frame;
\definition Orthogonal[w: Vector]: \Prop := \forall (v: Source.Vector) -> dot w (A.apply v) = R.zero;
\definition frameFormula: \forall (v: Source.Vector) -> A.apply (factor.change.backward.apply v) = factor.frame.apply v :=
  \fun (v: Source.Vector) => trans!{Vector} _ _ _ (factor.formula (factor.change.backward.apply v))
    (congr!{{Source.Vector} Vector} factor.frame.apply _ _ ((Isomorphisms.laws factor.change).rightInverse v));
\definition orthogonalCoordinates: \forall (w: Vector) -> Orthogonal w -> coordinates.apply w = Source.space.zero :=
  \fun (w: Vector)(orthogonal: Orthogonal w) => \axiom:funext((coordinates.apply w), Source.space.zero,
    \fun (j: Fin.Fin k) => eq_reason_in!{{R.Real} _
      "=" _ "by" { symmetric (factor.frame.apply (Source.basis j)) w }
      "=" _ "by" { congr!{Vector {R.Real}} (dot w) _ _ (sym!{Vector} _ _ (frameFormula (Source.basis j))) }
      "=" _ "by" { orthogonal (factor.change.backward.apply (Source.basis j)) }
    });
\definition coordinatesOrthogonal: \forall (w: Vector) -> coordinates.apply w = Source.space.zero -> Orthogonal w :=
  \fun (w: Vector)(zero: _)(v: Source.Vector) => eq_reason_in!{{R.Real} _
    "=" _ "by" { congr!{Vector {R.Real}} (dot w) _ _ (factor.formula v) }
    "=" _ "by" { symmetric w (factor.frame.apply (factor.change.forward.apply v)) }
    "=" _ "by" { Matrix.adjoint factor.frame (factor.change.forward.apply v) w }
    "=" _ "by" { congr!{{Source.Vector} {R.Real}} (Source.dot (factor.change.forward.apply v)) _ _ zero }
    "=" _ "by" { Source.form.zeroRight (factor.change.forward.apply v) }
  };
\import Spaces.Linear[V := Vector, W := Source.Vector, source := space, target := Source.space].Operations[] \as CoordinateOperations;
\definition normalCoordinates: \forall (w: Vector) -> coordinates.apply (normal.map.apply w) = Source.space.zero :=
  \fun (w: Vector) => eq_reason_in!{{Source.Vector} _
    "=" _ "by" { coordinates.preservesAdd w (space.neg (tangent.map.apply w)) }
    "=" _ "by" { congr!{{Source.Vector} {Source.Vector}} (Source.space.add (coordinates.apply w)) _ _
      (trans!{{Source.Vector}} _ _ _ (CoordinateOperations.preservesNeg coordinates (tangent.map.apply w))
        (congr!{{Source.Vector} {Source.Vector}} Source.space.neg _ _ (Frame.leftInverse (coordinates.apply w)))) }
    "=" _ "by" { Source.differenceSelf (coordinates.apply w) }
  };
\definition normalOrthogonal: \forall (w: Vector) -> Orthogonal (normal.map.apply w) := \fun (w: Vector) => coordinatesOrthogonal (normal.map.apply w) (normalCoordinates w);
\definition orthogonalFixed: \forall (w: Vector) -> Orthogonal w -> normal.map.apply w = w :=
  \fun (w: Vector)(orthogonal: Orthogonal w) => trans!{Vector} _ _ _ (congr!{Vector Vector} (difference w) _ _
    (trans!{Vector} _ _ _ (congr!{{Source.Vector} Vector} factor.frame.apply _ _ (orthogonalCoordinates w orthogonal)) factor.frame.preservesZero)) (differenceZero w);
\definition fixedOrthogonal: \forall (w: Vector) -> normal.map.apply w = w -> Orthogonal w := \fun (w: Vector)(fixed: _) =>
  coordinatesOrthogonal w (trans!{{Source.Vector}} _ _ _ (congr!{Vector {Source.Vector}} coordinates.apply _ _ (sym!{Vector} _ _ fixed)) (normalCoordinates w));
\import Spaces.Linear[V := Source.Vector, W := Source.Vector, source := Source.space, target := Source.space].Composition[U := Vector, domain := space] \as InverseComposition;
\definition inverse: Spaces.Linear[V := Vector, W := Source.Vector, source := space, target := Source.space].Map := InverseComposition.compose factor.change.backward coordinates;
\definition leftInverse: \forall (v: Source.Vector) -> inverse.apply (A.apply v) = v :=
  \fun (v: Source.Vector) => trans!{{Source.Vector}} _ _ _ (congr!{{Source.Vector} {Source.Vector}} factor.change.backward.apply _ _
    (trans!{{Source.Vector}} _ _ _ (congr!{Vector {Source.Vector}} coordinates.apply _ _ (factor.formula v)) (Frame.leftInverse (factor.change.forward.apply v)))) ((Isomorphisms.laws factor.change).leftInverse v);
\definition imageInverse: \forall (w: Vector) -> A.apply (inverse.apply w) = tangent.map.apply w := \fun (w: Vector) => frameFormula (coordinates.apply w);
\definition splitting: \forall (w: Vector) -> space.add (A.apply (inverse.apply w)) (normal.map.apply w) = w :=
  \fun (w: Vector) => trans!{Vector} _ _ _ (congr!{Vector Vector} (\fun (v: Vector) => space.add v (normal.map.apply w)) _ _ (imageInverse w))
    (\axiom:funext((space.add (tangent.map.apply w) (normal.map.apply w)), w, \fun (j: Fin.Fin n) =>
      trans!{{R.Real}} _ _ _ (Arithmetic.addComm (tangent.map.apply w j) (R.sub (w j) (tangent.map.apply w j))) (R.Distance[].subAddCancel (w j) (tangent.map.apply w j))));
\definition tangentTrace: trace tangent = naturalCount k := Frame.traceFormula;
\definition normalTrace: trace normal = R.sub (naturalCount n) (naturalCount k) := trans!{{R.Real}} _ _ _ (complementTrace tangent)
  (congr!{{R.Real} {R.Real}} (R.sub (naturalCount n)) _ _ tangentTrace);
