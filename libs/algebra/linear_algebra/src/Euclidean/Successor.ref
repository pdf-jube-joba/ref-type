/* First coordinate and tail, with linear maps in both directions. */
\import \root.Euclidean[n := N.Nat^::succ n] \as Next;
\import Fin.Tuples[A := R.Real] \as Tuples;
\definition head[v: Next.Vector]: R.Real := v (Fin.zero n);
\definition tail[v: Next.Vector][i: Fin.Fin n]: R.Real := v (Fin.succ n i);
\definition join[a: R.Real][v: Vector]: Next.Vector := Tuples.extend n a v;
\definition joinHead: \forall (a: R.Real)(v: Vector) -> head (join a v) = a := Tuples.atZero n;
\definition joinTail: \forall (a: R.Real)(v: Vector) -> tail (join a v) = v :=
  \fun (a: R.Real)(v: Vector) => \axiom:funext(tail (join a v), v, Tuples.atSuccessor n a v);
\definition recover: \forall (v: Next.Vector) -> join (head v) (tail v) = v := Tuples.recover n;
\definition ext: \forall (x, y: Next.Vector) -> head x = head y -> tail x = tail y -> x = y :=
  \fun (x, y: Next.Vector)(first: _)(rest: _) => Tuples.extensionality n x y first
    (\fun (i: Fin.Fin n) => congr!{Vector {R.Real}} (\fun (v: Vector) => v i) _ _ rest);
\definition addition: \forall (a, b: R.Real)(x, y: Vector) -> join (R.add a b) (space.add x y) = Next.space.add (join a x) (join b y) :=
  \fun (a, b: R.Real)(x, y: Vector) => ext _ _
    (trans!{{R.Real}} _ _ _ (joinHead (R.add a b) (space.add x y))
      (sym!{{R.Real}} _ _ (congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _ (joinHead a x) (joinHead b y))))
    (trans!{Vector} _ _ _ (joinTail (R.add a b) (space.add x y))
      (sym!{Vector} _ _ (congr!{Vector Vector Vector} space.add _ _ _ _ (joinTail a x) (joinTail b y))));
\definition scalar: \forall (c, a: R.Real)(v: Vector) -> join (R.mul c a) (space.smul c v) = Next.space.smul c (join a v) :=
  \fun (c, a: R.Real)(v: Vector) => ext _ _
    (trans!{{R.Real}} _ _ _ (joinHead (R.mul c a) (space.smul c v)) (sym!{{R.Real}} _ _ (congr!{{R.Real} {R.Real}} (R.mul c) _ _ (joinHead a v))))
    (trans!{Vector} _ _ _ (joinTail (R.mul c a) (space.smul c v)) (sym!{Vector} _ _ (congr!{Vector Vector} (space.smul c) _ _ (joinTail a v))));
\definition zero: join R.zero space.zero = Next.space.zero := ext _ _ (joinHead R.zero space.zero) (joinTail R.zero space.zero);
\import Spaces.Linear[V := Vector, W := Next.Vector, source := space, target := Next.space] \as Embeddings;
\definition embedding: Embeddings.Map := Embeddings.Map {
  apply := join R.zero,
  preservesAdd := \fun (x, y: Vector) => trans!{{Next.Vector}} _ _ _
    (congr!{{R.Real} {Next.Vector}} (\fun (a: R.Real) => join a (space.add x y)) _ _ (sym!{{R.Real}} _ _ (Arithmetic.addZeroLeft R.zero))) (addition R.zero R.zero x y),
  preservesScale := \fun (a: R.Real)(x: Vector) => trans!{{Next.Vector}} _ _ _
    (congr!{{R.Real} {Next.Vector}} (\fun (b: R.Real) => join b (space.smul a x)) _ _ (sym!{{R.Real}} _ _ (Spaces.mulZeroRight a))) (scalar a R.zero x),
};
\definition first: Next.Vector := join R.one space.zero;
\definition firstHead: head first = R.one := joinHead R.one space.zero;
\definition firstTail: tail first = space.zero := joinTail R.one space.zero;
\definition decompose: \forall (v: Next.Vector) -> Next.space.add (Next.space.smul (head v) first) (embedding.apply (tail v)) = v :=
  \fun (v: Next.Vector) => ext _ _
    (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _
      (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul (head v)) _ _ firstHead) (Spaces.mulOneRight (head v))) (joinHead R.zero (tail v))) (Arithmetic.addZeroRight (head v)))
    (trans!{Vector} _ _ _ (congr!{Vector Vector Vector} space.add _ _ _ _
      (trans!{Vector} _ _ _ (congr!{Vector Vector} (space.smul (head v)) _ _ firstTail) (Laws.scaleZero (head v))) (joinTail R.zero (tail v))) (Laws.zeroLeft (tail v)));
\definition dotSplit: \forall (v, w: Next.Vector) -> Next.dot v w = R.add (R.mul (head v) (head w)) (dot (tail v) (tail w)) :=
  \fun (v, w: Next.Vector) => \refl(Next.dot v w);
\import Spaces.Linear[V := Next.Vector, W := R.Real, source := Next.space, target := Spaces.scalarSpace] \as Rows;
\import Spaces.Linear[V := Next.Vector, W := Vector, source := Next.space, target := space] \as Restrictions;
\definition headMap: Rows.Map := Rows.Map {
  apply := head, preservesAdd := \fun (v, w: Next.Vector) => \refl(R.add (head v) (head w)),
  preservesScale := \fun (a: R.Real)(v: Next.Vector) => \refl(R.mul a (head v)),
};
\definition tailMap: Restrictions.Map := Restrictions.Map {
  apply := tail, preservesAdd := \fun (v, w: Next.Vector) => \refl(space.add (tail v) (tail w)),
  preservesScale := \fun (a: R.Real)(v: Next.Vector) => \refl(space.smul a (tail v)),
};
\module Joining(V: \Set, source: Spaces.VectorSpace V, first: Spaces.Linear[V := V, W := R.Real, source := source, target := Spaces.scalarSpace].Map,
  rest: Spaces.Linear[V := V, W := Vector, source := source, target := space].Map);
\import Spaces.Isomorphism[V := Vector, W := Vector, source := space, target := space] \as Isomorphisms;
\import Spaces.Linear[V := Vector, W := R.Real, source := space, target := Spaces.scalarSpace] \as Coefficients;
\module Triangular(l: R.Real, nonzero: Logic.Not (l = R.zero), row: Coefficients.Map, lower: Isomorphisms.Isomorphism);
