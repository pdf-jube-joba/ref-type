\import Spaces.Linear[V := V, W := Next.Vector, source := source, target := Next.space] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (v: V) => join (first.apply v) (rest.apply v),
  preservesAdd := \fun (v, w: V) => trans!{{Next.Vector}} _ _ _
    (congr!{{R.Real} Vector {Next.Vector}} join _ _ _ _ (first.preservesAdd v w) (rest.preservesAdd v w))
    (addition (first.apply v) (first.apply w) (rest.apply v) (rest.apply w)),
  preservesScale := \fun (a: R.Real)(v: V) => trans!{{Next.Vector}} _ _ _
    (congr!{{R.Real} Vector {Next.Vector}} join _ _ _ _ (first.preservesScale a v) (rest.preservesScale a v))
    (scalar a (first.apply v) (rest.apply v)),
};
