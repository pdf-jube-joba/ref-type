\import \root.Euclidean[n := n].OnProjection[P := P] \as Projector;
\module Column(c: Projector.NonzeroColumn);
\definition tracePositive: Order.Lt R.zero (trace P) := Order.ltReplaceRight R.zero (naturalCount (N.Nat^::succ k)) (trace P)
  (sym!{{R.Real}} _ _ rank) (\root.Real[].Dimension[].successorPositive k);
\definition exists: \exists Frame (N.Nat^::succ k) P := \block {
  \takefrom c: Projector.NonzeroColumn \by Projector.nonzeroColumn tracePositive \then
  \return Column[c := c].exists
};
