\definition raw: Vector := P.map.apply (basis c.index);
\definition nonzero: \Cast[Vector] ({ v: Vector \where Order.Lt R.zero (squared v) }) :=
  \into[Vector](raw, { v: Vector \where Order.Lt R.zero (squared v) }) \by { positive raw c.nonzero };
\import \root.Euclidean[n := n].Normalization[v := nonzero] \as Normalize;
\definition unit: Projector.UnitIn := Projector.UnitIn {
  vector := Normalize.normalized, norm := Normalize.unitNorm,
  fixed := trans!{Vector} _ _ _ (P.map.preservesScale Normalize.factor raw)
    (congr!{Vector Vector} (space.smul Normalize.factor) _ _ (P.idempotent (basis c.index))),
};
\import Projector.Unit[u := unit] \as Reduce;
\definition exists: \exists Frame (N.Nat^::succ k) P := \block {
  \takefrom old: Frame k Reduce.reduced \by previous Reduce.reduced (Reduce.traceDecrease k rank) \then
  \return \exact(Reduce.Resolve[k := k].With[previous := old].frame, Frame (N.Nat^::succ k) P)
};
