\import \parent.\parent.OnProjection[P := P] \as Projector;
\import Projector.Rank[k := N.Nat^::zero] \as Rank;
\import \root.Euclidean[n := N.Nat^::zero] \as Empty;
\import Spaces.Linear[V := Empty.Vector, W := Vector, source := Empty.space, target := space].Operations[] \as Forward;
\import Spaces.Linear[V := Vector, W := Empty.Vector, source := space, target := Empty.space].Operations[] \as Backward;
\definition frame: Rank.Frame := Rank.Frame {
  value := Forward.zeroMap, coordinate := Backward.zeroMap,
  leftInverse := \fun (v: Empty.Vector) => sym!{{Empty.Vector}} _ _ (Finite.emptyVector v),
  reconstruction := \fun (v: Vector) => sym!{Vector} _ _ (Projector.zeroTrace rank v),
  adjoint := \fun (v: Empty.Vector)(w: Vector) => form.zeroLeft w,
};
\definition exists: \exists Frame N.Nat^::zero P := \exact(frame, Frame N.Nat^::zero P);
