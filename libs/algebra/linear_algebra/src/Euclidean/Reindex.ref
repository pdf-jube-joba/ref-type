\import Spaces.Isomorphism[V := Vector, W := Vector, source := space, target := space] \as Self;
\definition identity: OrthogonalIsomorphism[n] := OrthogonalIsomorphism[n] {
  linear := Self.Isomorphism { forward := Eigen.identity, backward := Eigen.identity,
    leftInverse := \fun (v: Vector) => \refl(v), rightInverse := \fun (v: Vector) => \refl(v) },
  isometry := \fun (v, w: Vector) => \refl(dot v w),
};
\definition value: OrthogonalIsomorphism[m] := Equality.Transport[A := N.Nat^].cast (\fun (d: N.Nat^) => OrthogonalIsomorphism[d]) n m same identity;
\definition isomorphism: Spaces.Isomorphism[V := Vector, W := \root.Euclidean[n := m].Vector, source := space, target := \root.Euclidean[n := m].space].Isomorphism := value.linear;
\definition isometry: \forall (v, w: Vector) -> \root.Euclidean[n := m].dot (isomorphism.forward.apply v) (isomorphism.forward.apply w) = dot v w := value.isometry;
