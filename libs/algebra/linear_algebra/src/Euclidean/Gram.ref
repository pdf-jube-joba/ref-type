\import \root.Euclidean[n := k] \as Source;
\import Source.Matrix[m := n] \as Matrix;
\import Spaces.Linear[V := Source.Vector, W := Vector, source := Source.space, target := space] \as Maps;
\import Spaces.Isomorphism[V := Source.Vector, W := Source.Vector, source := Source.space, target := Source.space] \as Isomorphisms;
\structure Factorization[A: Maps.Map]: \Set := {
  frame: Matrix.Isometry,
  change: Isomorphisms.Isomorphism,
  formula: \forall (v: Source.Vector) -> A.apply v = frame.apply (change.forward.apply v),
};
\definition Injective[A: Maps.Map]: \Prop := \forall (v, w: Source.Vector) -> A.apply v = A.apply w -> v = w;
\module Step;
\module Of(A: Maps.Map, factor: Factorization[A]);
