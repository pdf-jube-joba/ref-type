/* An orthonormal basis of a projection's image, counted by its trace. */
\definition Frame[k: N.Nat^][P: Projection]: \Set := \parent.OnProjection[P := P].Rank[k := k].Frame;
\module Zero(P: Projection, rank: trace P = naturalCount N.Nat^::zero);
\definition Previous[k: N.Nat^]: \Prop := \forall (P: Projection) -> trace P = naturalCount k -> \exists Frame k P;
\module Step(k: N.Nat^, previous: Previous k);
\definition exists: \forall (k: N.Nat^)(P: Projection) -> trace P = naturalCount k -> \exists Frame k P :=
  \induction (k: N.Nat^) \return \forall (P: Projection) -> trace P = naturalCount k -> \exists Frame k P \with {
    | zero: \fun (P: Projection)(rank: _) => Zero[P := P, rank := rank].exists
    | succ: \fun (k: N.Nat^)(previous: Previous k) => Step[k := k, previous := previous].exists
  };
