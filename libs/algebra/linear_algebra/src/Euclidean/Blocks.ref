\use std.Logic[].Equality[].eq_reason_in;
\import Spaces.CoordinateSum[n := n, m := m] \as Coordinates;
\import \root.Euclidean[n := m] \as Right;
\import \root.Euclidean[n := Coordinates.dimension] \as Total;
\definition dimension: N.Nat^ := Coordinates.dimension;
\definition left: Total.Vector -> Vector := Coordinates.left;
\definition right: Total.Vector -> Right.Vector := Coordinates.right;
\definition join: Vector -> Right.Vector -> Total.Vector := Coordinates.join;
\definition leftJoin: \forall (v: Vector)(w: Right.Vector) -> left (join v w) = v := Coordinates.leftJoin;
\definition rightJoin: \forall (v: Vector)(w: Right.Vector) -> right (join v w) = w := Coordinates.rightJoin;
\definition recover: \forall (v: Total.Vector) -> join (left v) (right v) = v := Coordinates.recover;
\definition dotSplit: \forall (v, w: Total.Vector) -> Total.dot v w = R.add (dot (left v) (left w)) (Right.dot (right v) (right w)) :=
  \fun (v, w: Total.Vector) => Sums.blocks n m (\fun (i: Fin.Fin dimension) => R.mul (v i) (w i));
\import Spaces.Linear[V := Total.Vector, W := Vector, source := Total.space, target := space] \as LeftMaps;
\import Spaces.Linear[V := Total.Vector, W := Right.Vector, source := Total.space, target := Right.space] \as RightMaps;
\definition leftMap: LeftMaps.Map := LeftMaps.Map { apply := left,
  preservesAdd := \fun (v, w: Total.Vector) => \refl(space.add (left v) (left w)),
  preservesScale := \fun (a: R.Real)(v: Total.Vector) => \refl(space.smul a (left v)) };
\definition rightMap: RightMaps.Map := RightMaps.Map { apply := right,
  preservesAdd := \fun (v, w: Total.Vector) => \refl(Right.space.add (right v) (right w)),
  preservesScale := \fun (a: R.Real)(v: Total.Vector) => \refl(Right.space.smul a (right v)) };
\import Spaces.Linear[V := Vector, W := Total.Vector, source := space, target := Total.space] \as Inclusions;
\import Spaces.Laws[V := Right.Vector, space := Right.space] \as RightLaws;
\definition inclusion: Inclusions.Map := Inclusions.Map {
  apply := \fun (v: Vector) => join v Right.space.zero,
  preservesAdd := \fun (v, w: Vector) => trans!{{Total.Vector}} _ _ _
    (congr!{{Right.Vector} {Total.Vector}} (join (space.add v w)) _ _ (sym!{{Right.Vector}} _ _ (RightLaws.zeroLeft Right.space.zero))) (Coordinates.addition v w Right.space.zero Right.space.zero),
  preservesScale := \fun (a: R.Real)(v: Vector) => trans!{{Total.Vector}} _ _ _
    (congr!{{Right.Vector} {Total.Vector}} (join (space.smul a v)) _ _ (sym!{{Right.Vector}} _ _ (RightLaws.scaleZero a))) (Coordinates.scalar a v Right.space.zero),
};
\definition dotIncluded: \forall (w: Total.Vector)(v: Vector) -> Total.dot w (inclusion.apply v) = dot (left w) v :=
  \fun (w: Total.Vector)(v: Vector) => eq_reason_in!{{R.Real} _
    "=" _ "by" { dotSplit w (inclusion.apply v) }
    "=" _ "by" { congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _
      (congr!{Vector {R.Real}} (dot (left w)) _ _ (leftJoin v Right.space.zero))
      (trans!{{R.Real}} _ _ _ (congr!{{Right.Vector} {R.Real}} (Right.dot (right w)) _ _ (rightJoin v Right.space.zero)) (Right.form.zeroRight (right w))) }
    "=" _ "by" { Arithmetic.addZeroRight (dot (left w) v) }
  };
\definition addition: \forall (v, w: Vector)(a, b: Right.Vector) -> join (space.add v w) (Right.space.add a b) = Total.space.add (join v a) (join w b) := Coordinates.addition;
\definition scalar: \forall (a: R.Real)(v: Vector)(w: Right.Vector) -> join (space.smul a v) (Right.space.smul a w) = Total.space.smul a (join v w) := Coordinates.scalar;

\definition dotWithJoined: \forall (w: Total.Vector)(u: Vector)(v: Right.Vector) -> Total.dot w (join u v) = R.add (dot (left w) u) (Right.dot (right w) v) :=
  \fun (w: Total.Vector)(u: Vector)(v: Right.Vector) => trans!{R.Real} _ _ _ (dotSplit w (join u v))
    (congr!{R.Real R.Real R.Real} R.add _ _ _ _
      (congr!{Vector R.Real} (dot (left w)) _ _ (leftJoin u v))
      (congr!{{Right.Vector} R.Real} (Right.dot (right w)) _ _ (rightJoin u v)));
\definition dotJoined: \forall (u, v: Vector)(a, b: Right.Vector) -> Total.dot (join u a) (join v b) = R.add (dot u v) (Right.dot a b) :=
  \fun (u, v: Vector)(a, b: Right.Vector) => trans!{R.Real} _ _ _ (dotWithJoined (join u a) v b)
    (congr!{R.Real R.Real R.Real} R.add _ _ _ _
      (congr!{Vector R.Real} (\fun (w: Vector) => dot w v) _ _ (leftJoin u a))
      (congr!{{Right.Vector} R.Real} (\fun (w: Right.Vector) => Right.dot w b) _ _ (rightJoin u a)));
