\use std.Logic[].Equality[].eq_reason_in;
\import R.SquareRoot[] \as Root;
\import R.Inverse[] \as Inverse;
\definition positive: Order.Lt R.zero (squared v) := \bysub(Vector, { v: Vector \where Order.Lt R.zero (squared v) }, v);
\import Shared.Of[h := sharedForm].Normalize[v := v, positive := positive] \as SharedNormalization;
\definition length: R.Real := SharedNormalization.length;
\definition lengthSquared: R.mul length length = squared v := SharedNormalization.lengthSquared;
\definition lengthNonzero: Logic.Not (length = R.zero) := SharedNormalization.lengthNonzero;
\definition factor: R.Real := SharedNormalization.factor;
\definition normalized: Vector := SharedNormalization.value;
\definition inverseLength: R.mul factor length = R.one := SharedNormalization.inverseLength;
\definition inverseSquared: R.mul (R.mul factor factor) (squared v) = R.one := SharedNormalization.inverseSquared;
\definition unitNorm: squared normalized = R.one := SharedNormalization.unitNorm;
\definition inverseSquare: R.mul factor factor = Arithmetic.fieldInv (squared v) := Inverse.inverseUnique (squared v) (R.mul factor factor)
  (Inverse.positiveNonzero (squared v) positive) inverseSquared;
