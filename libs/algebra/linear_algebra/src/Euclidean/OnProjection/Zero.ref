\definition onBasis: \forall (i: Fin.Fin n) -> P.map.apply (basis i) = space.zero := \fun (i: Fin.Fin n) =>
  separated (P.map.apply (basis i)) (trans!{{R.Real}} _ _ _ (diagonalEnergy i)
    (Order.leAntisym _ _
      (Order.leReplaceRight _ (trace P) R.zero same (Sums.coordinateUpper n (\fun (j: Fin.Fin n) => P.map.apply (basis j) j) diagonalNonnegative i))
      (diagonalNonnegative i)));
\module Row(v: Vector, i: Fin.Fin n) {
  \definition row: Finite.Map n := Finite.Data[n] {
    apply := \fun (w: Vector) => P.map.apply w i,
    additive := \fun (u, w: Vector) => congr!{Vector {R.Real}} (\fun (t: Vector) => t i) _ _ (P.map.preservesAdd u w),
    homogeneous := \fun (a: R.Real)(w: Vector) => congr!{Vector {R.Real}} (\fun (t: Vector) => t i) _ _ (P.map.preservesScale a w),
  };
  \definition zero: P.map.apply v i = R.zero := trans!{{R.Real}} _ _ _ (Finite.expansion n row v)
    (trans!{{R.Real}} _ _ _ (Sums.congruent n _ (\fun (j: Fin.Fin n) => R.zero)
      (\fun (j: Fin.Fin n) => trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul (v j)) _ _
        (congr!{Vector {R.Real}} (\fun (t: Vector) => t i) _ _ (onBasis j))) (Spaces.mulZeroRight (v j)))) (Sums.zeroSum n));
}
\definition zero: \forall (v: Vector) -> P.map.apply v = space.zero :=
  \fun (v: Vector) => \axiom:funext((P.map.apply v), space.zero, \fun (i: Fin.Fin n) => Row[v := v, i := i].zero);
