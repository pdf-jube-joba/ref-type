\import \root.Euclidean[n := n].OnProjection[P := reduced].Rank[k := k] \as Lower;
\import \parent.\parent.Rank[k := N.Nat^::succ k] \as Upper;
\import Spaces.CoordinateLine[] \as Line;
\import Spaces.CoordinateSum[n := Line.one, m := k] \as Coordinates;
\import std.Data[].FinSet[].Sum[m := Line.one, n := k] \as Indices;
\definition head[w: Fin.Fin (N.Nat^::succ k) -> R.Real]: R.Real := Coordinates.left w (Fin.zero N.Nat^::zero);
\definition tail[w: Fin.Fin (N.Nat^::succ k) -> R.Real]: Fin.Fin k -> R.Real := Coordinates.right w;
\module With(previous: Lower.Frame);
