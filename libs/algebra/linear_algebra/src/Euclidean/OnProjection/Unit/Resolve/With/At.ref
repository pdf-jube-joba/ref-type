\import Spaces.Isomorphism[V := R.Real, W := Fin.Fin Line.one -> R.Real, source := Spaces.scalarSpace, target := Spaces.Coordinates[I := Fin.Fin Line.one].space] \as LineIso;
\definition leftInverse: coordinate.apply (value.apply w) = w := trans!{{Higher.Vector}} _ _ _
  (congr2!{{Fin.Fin Line.one -> R.Real} {Domain.Vector} {Higher.Vector}} Coordinates.join _ _ _ _
    (trans!{{Fin.Fin Line.one -> R.Real}} _ _ _ (congr!{{R.Real} {Fin.Fin Line.one -> R.Real}} Line.forward.apply _ _ (unitCoordinate w))
      ((LineIso.laws Line.isomorphism).rightInverse (Coordinates.left w)))
    (lowerCoordinate w)) (Coordinates.recover w);
