\import Algebra.Linear[V := V, W := V, source := space, target := space] \as End;
\structure InnerProductData: \Set {
  inner: V -> V -> Scalar,
}
\structure InnerProductLaws[data: InnerProductData]: \Prop {
  symmetric: \forall (x, y: V) -> data.inner x y = data.inner y x,
  zeroRight: \forall (x: V) -> data.inner x (space.zero) = D.zero,
  addRight: \forall (x, y, z: V) -> data.inner x (space.add y z) = D.add (data.inner x y) (data.inner x z),
  scaleRight: \forall (a: Scalar) (x, y: V) -> data.inner x (space.smul a y) = P.fieldMul a (data.inner x y),
  nonnegative: \forall (x: V) -> R.Le D.zero (data.inner x x),
  definite: \forall (x: V) -> data.inner x x = D.zero -> x = space.zero,
}
\definition InnerProduct: \Set := \Cast[InnerProductData] ({ data: InnerProductData \where InnerProductLaws[data] });
\definition normSquared(h: InnerProduct) (x: V): Scalar := h.inner x x;
\definition Orthogonal(h: InnerProduct) (x, y: V): \Prop := h.inner x y = D.zero;
\definition SelfAdjoint(h: InnerProduct) (f: End.Map): \Prop :=
  \forall (x, y: V) -> h.inner (f.apply x) y = h.inner x (f.apply y);
\definition Isometry(h: InnerProduct) (f: End.Map): \Prop :=
  \forall (x, y: V) -> h.inner (f.apply x) (f.apply y) = h.inner x y;
\definition scaleLeft: \forall (h: InnerProduct) -> \forall (a: Scalar) -> \forall (x, y: V) ->
  h.inner (space.smul a x) y = P.fieldMul a (h.inner x y) :=
  \fun (h: InnerProduct) (a: _) (x, y: _) => trans!{Scalar} _ _ _ (h.symmetric (space.smul a x) y)
    (trans!{Scalar} _ _ _ (h.scaleRight a y x) (congr!{Scalar Scalar} (P.fieldMul a) _ _ (h.symmetric y x)));
\import Algebra.Form[V := V, space := space] \as Forms;
\definition asBilinear(h: InnerProduct): Forms.Bilinear := Forms.Bilinear {
  form := h.inner,
  zeroLeft := \fun (x: _) => trans!{Scalar} _ _ _ (h.symmetric (space.zero) x) (h.zeroRight x),
  zeroRight := h.zeroRight,
  addLeft := \fun (x, y, z: _) => trans!{Scalar} _ _ _ (h.symmetric (space.add x y) z)
    (trans!{Scalar} _ _ _ (h.addRight z x y) (congr2!{Scalar Scalar Scalar} D.add _ _ _ _ (h.symmetric z x) (h.symmetric z y))),
  addRight := h.addRight, scaleLeft := scaleLeft h, scaleRight := h.scaleRight,
};
