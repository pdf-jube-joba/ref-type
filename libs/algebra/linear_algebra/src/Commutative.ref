\import std.Alg[].Ring[] \as Ring;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Monoid[] \as Monoid;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;

\definition ring: Ring.Ring[K] := Ring.commutativeRingAsRing K scalarRing;
\definition zero: K := ring.zero;
\definition one: K := ring.one;
\definition add: K -> K -> K := ring.add;
\definition neg: K -> K := ring.neg;
\definition mul: K -> K -> K := ring.mul;
\definition VectorSpace[Carrier: \Set]: \Set := Ring.RingModule[K, Carrier, ring];

\definition addZeroLeft: \forall (a: K) -> add zero a = a := (((ring.semiring).additive).monoid).leftIdentity;
\definition addZeroRight: \forall (a: K) -> add a zero = a := (((ring.semiring).additive).monoid).rightIdentity;
\definition addAssoc: \forall (a, b, c: K) -> add (add a b) c = add a (add b c) := (((ring.semiring).additive).monoid).associative;
\definition addComm: \forall (a, b: K) -> add a b = add b a := ((ring.semiring).additive).commutative;
\definition mulOneLeft: \forall (a: K) -> mul one a = a := ((ring.semiring).multiplicative).leftIdentity;
\definition mulOneRight: \forall (a: K) -> mul a one = a := ((ring.semiring).multiplicative).rightIdentity;
\definition mulAssoc: \forall (a, b, c: K) -> mul (mul a b) c = mul a (mul b c) := ((ring.semiring).multiplicative).associative;
\definition mulComm: \forall (a, b: K) -> mul a b = mul b a := scalarRing.mulCommutative;
\definition mulAdd: \forall (a, b, c: K) -> mul a (add b c) = add (mul a b) (mul a c) := (ring.semiring).leftDistributive;
\definition addMul: \forall (a, b, c: K) -> mul (add a b) c = add (mul a c) (mul b c) := (ring.semiring).rightDistributive;
\definition mulZeroLeft: \forall (a: K) -> mul zero a = zero := (ring.semiring).zeroAbsorbsLeft;
\definition mulZeroRight: \forall (a: K) -> mul a zero = zero := (ring.semiring).zeroAbsorbsRight;
\definition addNegLeft: \forall (a: K) -> add (neg a) a = zero := ring.additiveInverse;
\definition addNegRight: \forall (a: K) -> add a (neg a) = zero :=
  \fun (a: _) => trans!{K} _ _ _ (addComm a (neg a)) (addNegLeft a);

\definition scalarSpace: VectorSpace K := Ring.RingModule[K, K, ring] {
  zero := zero, add := add, neg := neg, smul := mul,
  additive := Alg.CommutativeGroupLaws[K, Alg.CommutativeGroupData[K]::# (Alg.GroupData[K]::# zero add neg)] {
    group := Alg.GroupLaws[K, Alg.GroupData[K]::# zero add neg] {
      monoid := Monoid.MonoidLaws[K, Monoid.MonoidData[K]::# zero add] {
        leftIdentity := addZeroLeft, rightIdentity := addZeroRight, associative := addAssoc,
      },
      leftInverse := addNegLeft, rightInverse := addNegRight,
    },
    commutative := addComm,
  },
  scalarOne := mulOneLeft, scalarAssoc := mulAssoc, scalarAdd := addMul, vectorAdd := mulAdd,
};

\module Laws(V: \Set, space: VectorSpace V);
\module Sign;
\module Coordinates(I: \Set);
\module DependentProduct(I: \Set, F: I -> \Set, familySpace: \forall (i: I) -> VectorSpace (F i));
\module Linear(V, W: \Set, source: VectorSpace V, target: VectorSpace W);
\module Sums(I: \Set);
\module Shuffle(I: \Set);
\module Subspace(V: \Set, space: VectorSpace V);
\module Form(V: \Set, space: VectorSpace V);
\module Matrix(I, J: \Set);
\module Eigen(V: \Set, space: VectorSpace V);
\module Square(I: \Set);
\module Finite(V, I: \Set, space: VectorSpace V);
\module FiniteCoordinateEnumeration;
\module FiniteCoordinates(n: std.Data[].Nat[].Nat^);
\module EigenCoordinates(V, I: \Set, space: VectorSpace V);
\module Isomorphism(V, W: \Set, source: VectorSpace V, target: VectorSpace W);
\module DirectSum(V, W: \Set, left: VectorSpace V, right: VectorSpace W);
\module Dual(V: \Set, source: VectorSpace V);
\module Tensor(V, W: \Set, left: VectorSpace V, right: VectorSpace W);
\module Quotient(V: \Set, space: VectorSpace V);
\module Multilinear(V: \Set, space: VectorSpace V);
\module Exterior(V: \Set, space: VectorSpace V);

\definition FiniteBasis[V: \Set][space: VectorSpace V][n: std.Data[].Nat[].Nat^]: \Set := Finite[V := V, I := std.Data[].FinSet[].Fin n, space := space].Basis;
\module FiniteExterior(V: \Set, space: VectorSpace V, n: std.Data[].Nat[].Nat^, b: FiniteBasis V space n);
\module CoordinateSum(n, m: std.Data[].Nat[].Nat^);
\module CoordinateLine;
\module CoordinateBasis(V: \Set, space: VectorSpace V, n: std.Data[].Nat[].Nat^);
\module Pullback(V, W: \Set, target: VectorSpace W);
\module Blocks(V, W: \Set, left: VectorSpace V, right: VectorSpace W);
\module Rotation(V: \Set, space: VectorSpace V);
