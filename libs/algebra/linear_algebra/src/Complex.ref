\import std.Alg[].Field[] \as Fields;
\import complex.Complex[] \as C;
\import C.Algebra[] \as A;
\import \root.Field[].Space[K := C.Complex, field := A.field] \as Algebra;
\definition Scalar: \Set := C.Complex;
\definition field: Fields.Field[Scalar] := A.field;
\module InnerProduct(V: \Set, space: Algebra.VectorSpace V);
\module Matrix(I, J: \Set);
\module Square(I: \Set);
\module Dimension;
