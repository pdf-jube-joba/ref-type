\import \parent.\parent.Gram[k := N.Nat^::zero] \as Gram;
\import \parent.\parent.\parent.\parent.Finite[n := N.Nat^::zero] \as Empty;
\import Spaces.Linear[V := Empty.Vector, W := V, source := Empty.space, target := space].Operations[] \as Maps;
\import Spaces.Eigen[V := Empty.Vector, space := Empty.space] \as Eigen;
\definition empty: \forall (v: Empty.Vector) -> v = Empty.space.zero := \fun (v: Empty.Vector) =>
  \axiom:funext(v, Empty.space.zero, \fun (i: Fin.Fin N.Nat^::zero) => Logic.falseElim (v i = Spaces.zero) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
\definition factor: \forall (A: Gram.Map) -> Gram.Factorization[A] := \fun (A: Gram.Map) => Gram.Factorization[A] {
  frame := Maps.zeroMap,
  isometry := \fun (v, w: Empty.Vector) => zeroLeft space.zero,
  change := Gram.Change {
    forward := Eigen.identity, backward := Eigen.identity,
    leftInverse := \fun (v: Empty.Vector) => \refl(v), rightInverse := \fun (v: Empty.Vector) => \refl(v),
  },
  formula := \fun (v: Empty.Vector) => trans!{V} _ _ _ (congr!{{Empty.Vector} V} A.apply _ _ (empty v)) A.preservesZero,
};
\definition exists: Previous N.Nat^::zero := \fun (A: Gram.Map)(injective: _)(positive: _) => \exact(factor A, Gram.Factorization[A]);
