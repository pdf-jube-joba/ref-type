\definition Previous[k: N.Nat^]: \Prop := \forall (A: \parent.Gram[k := k].Map) -> \parent.Gram[k := k].Injective A -> \forall (positive: Positive[h]) -> \exists \parent.Gram[k := k].Factorization[A];
\module Zero;
\module Step(k: N.Nat^, previous: Previous k);
\definition exists: \forall (k: N.Nat^) -> Previous k := \induction (k: N.Nat^) \return Previous k \with {
  | zero: Zero[].exists
  | succ: \fun (k: N.Nat^)(previous: Previous k) => Step[k := k, previous := previous].exists
};
