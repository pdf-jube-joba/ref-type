\definition a: K := Split.head v;
\definition b: K := row.apply (Split.tail v);
\definition t: V := tailMap.apply (Split.tail v);
\definition expanded: value.apply (Triangular.forward.apply v) =
  space.add (space.smul (Spaces.add (Spaces.mul (embed Normalize.length) a) b) unit) (residual.apply (Split.tail v)) :=
  congr!{V V V} space.add
    (space.smul (Split.head (Triangular.forward.apply v)) unit)
    (space.smul (Spaces.add (Spaces.mul (embed Normalize.length) a) b) unit)
    (previous.frame.apply (Split.tail (Triangular.forward.apply v)))
    (residual.apply (Split.tail v))
    (congr!{K V} (\fun (c: K) => space.smul c unit) _ _ (Triangular.At[v := v].forwardHead))
    (trans!{V} _ _ _ (congr!{{Source.Vector} V} previous.frame.apply _ _ (Triangular.At[v := v].forwardTail)) (sym!{V} _ _ (previous.formula (Split.tail v))));
\definition formula: A.apply v = value.apply (Triangular.forward.apply v) := sym!{V} _ _ (eq_reason_in!{V _
  "=" _ "by" expanded
  "=" { space.add (space.smul (Spaces.add (Spaces.mul (embed Normalize.length) a) b) unit) (subtract t (space.smul b unit)) } "by" {
    congr!{V V} (space.add (space.smul (Spaces.add (Spaces.mul (embed Normalize.length) a) b) unit)) _ _ (Unit.residualFormula t) }
  "=" { space.add (space.smul a (space.smul (embed Normalize.length) unit)) t } "by" { recombine (embed Normalize.length) a b unit t }
  "=" { space.add (space.smul a column) t } "by" { congr!{V V} (\fun (w: V) => space.add (space.smul a w) t) _ _ (sym!{V} _ _ columnFormula) }
  "=" { A.apply (Split.join a (Split.tail v)) } "by" { sym!{V} _ _ (joinFormula a (Split.tail v)) }
  "=" { A.apply v } "by" { congr!{{Higher.Vector} V} A.apply _ _ (Split.recover v) }
});
