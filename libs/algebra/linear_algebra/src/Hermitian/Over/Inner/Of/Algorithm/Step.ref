\import \parent.\parent.Gram[k := N.Nat^::succ k] \as Gram;
\import \parent.\parent.Gram[k := k] \as Lower;
\module On(A: Gram.Map, injective: Gram.Injective A, positive: Positive[h]) {
  \import \parent.\parent.\parent.Gram[k := k].Step[].On[A := A, injective := injective, positive := positive] \as Step;
  \definition exists: \exists Gram.Factorization[A] := \block {
    \takefrom factor: Lower.Factorization[Step.residual] \by previous Step.residual Step.residualInjective positive \then
    \return \exact(Step.With[previous := factor].factorization, Gram.Factorization[A])
  };
}
\definition exists: Previous (N.Nat^::succ k) := \fun (A: Gram.Map)(injective: _)(positive: _) => On[A := A, injective := injective, positive := positive].exists;
