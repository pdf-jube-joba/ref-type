\import Spaces.Laws[V := V, space := space] \as Laws;
\import Spaces.Linear[V := V, W := V, source := space, target := space] \as End;
\structure Form: \Set := {
  dot: V -> V -> K,
  symmetric: \forall (x, y: V) -> dot x y = conj (dot y x),
  zeroRight: \forall (x: V) -> dot x space.zero = Spaces.zero,
  addRight: \forall (x, y, z: V) -> dot x (space.add y z) = Spaces.add (dot x y) (dot x z),
  scaleRight: \forall (a: K)(x, y: V) -> dot x (space.smul a y) = Spaces.mul a (dot x y),
};
\structure Positive[h: Form]: \Prop := {
  nonnegative: \forall (v: V) -> Order.Le R.zero (re (h.dot v v)),
  definite: \forall (v: V) -> h.dot v v = Spaces.zero -> v = space.zero,
};
\module Of(h: Form);
