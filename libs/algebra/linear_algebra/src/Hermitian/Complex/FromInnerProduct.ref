\import Geometry.Inner[V := V, space := space] \as Inner;
\definition form: Inner.Form := Inner.Form {
  dot := h.inner, symmetric := h.conjugateSymmetric, zeroRight := h.zeroRight, addRight := h.addRight, scaleRight := h.scaleRight,
};
\definition positive: Inner.Positive[form] := Inner.Positive[form] { nonnegative := h.nonnegative, definite := h.definite };
