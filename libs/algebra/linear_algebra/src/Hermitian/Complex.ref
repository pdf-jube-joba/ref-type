\import complex.Complex[] \as C;
\import C.Def[] \as D;
\import C.Prop[] \as P;
\import C.Algebra[] \as A;
\import \root.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex A.field] \as Spaces;
\import \root.Complex[].InnerProduct[V := C.Complex, space := Spaces.scalarSpace] \as Inner;
\definition scalar: Scalar[C.Complex, A.field] := Scalar[C.Complex, A.field] {
  conjugate := D.conj, embed := D.ofReal, realPart := C.re,
  conjugateAdd := P.conjAdd, conjugateMul := P.conjMul, involution := P.conjConj,
  embedZero := \refl(D.zero), embedOne := \refl(D.one),
  embedAdd := P.ofRealAdd,
  embedMul := \fun (a, b: R.Real) => sym!{C.Complex} _ _ (P.ofRealMul a b),
  conjugateReal := P.conjOfReal,
  realEmbed := \fun (a: R.Real) => \refl(a),
  fixedReal := Inner.conjugateFixedReal,
  scalarNonnegative := \fun (a: C.Complex) => Order.leReplaceRight R.zero _ _
    (sym!{R.Real} _ _ (congr!{C.Complex R.Real} C.re _ _ (P.conjMulSelf a))) (P.normSqNonnegative a),
  scalarDefinite := \fun (a: C.Complex)(zero: _) => P.normSqZero a
    (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (congr!{C.Complex R.Real} C.re _ _ (P.conjMulSelf a))) zero),
};
\import \parent.Over[K := C.Complex, field := A.field, scalar := scalar] \as Geometry;
\module FromInnerProduct(V: \Set, space: Spaces.VectorSpace V, h: \root.Complex[].InnerProduct[V := V, space := space].InnerProduct);
