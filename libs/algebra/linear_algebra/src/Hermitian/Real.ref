\definition scalar: Scalar[R.Real, R.Algebra[].field] := Scalar[R.Real, R.Algebra[].field] {
  conjugate := \fun (a: R.Real) => a,
  embed := \fun (a: R.Real) => a,
  realPart := \fun (a: R.Real) => a,
  conjugateAdd := \fun (a, b: R.Real) => \refl(R.add a b),
  conjugateMul := \fun (a, b: R.Real) => \refl(R.mul a b),
  involution := \fun (a: R.Real) => \refl(a),
  embedZero := \refl(R.zero), embedOne := \refl(R.one),
  embedAdd := \fun (a, b: R.Real) => \refl(R.add a b),
  embedMul := \fun (a, b: R.Real) => \refl(R.mul a b),
  conjugateReal := \fun (a: R.Real) => \refl(a),
  realEmbed := \fun (a: R.Real) => \refl(a),
  fixedReal := \fun (a: R.Real)(_: _) => \refl(a),
  scalarNonnegative := R.Algebra[].squareNonnegative,
  scalarDefinite := R.Algebra[].squareZero,
};
\import \parent.Over[K := R.Real, field := R.Algebra[].field, scalar := scalar] \as Geometry;
