/* Real and complex positive Hermitian geometry share these scalar laws. */
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\import std.Alg[].Field[] \as Fields;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\use Equality.eq_reason;
\structure Scalar[K: \Set, field: Fields.Field[K]]: \Set := {
  conjugate: K -> K,
  embed: R.Real -> K,
  realPart: K -> R.Real,
  conjugateAdd: \forall (a, b: K) -> conjugate (field.add a b) = field.add (conjugate a) (conjugate b),
  conjugateMul: \forall (a, b: K) -> conjugate (field.mul a b) = field.mul (conjugate a) (conjugate b),
  involution: \forall (a: K) -> conjugate (conjugate a) = a,
  embedZero: embed R.zero = field.zero,
  embedOne: embed R.one = field.one,
  embedAdd: \forall (a, b: R.Real) -> embed (R.add a b) = field.add (embed a) (embed b),
  embedMul: \forall (a, b: R.Real) -> embed (R.mul a b) = field.mul (embed a) (embed b),
  conjugateReal: \forall (a: R.Real) -> conjugate (embed a) = embed a,
  realEmbed: \forall (a: R.Real) -> realPart (embed a) = a,
  fixedReal: \forall (a: K) -> conjugate a = a -> a = embed (realPart a),
  scalarNonnegative: \forall (a: K) -> Order.Le R.zero (realPart (field.mul (conjugate a) a)),
  scalarDefinite: \forall (a: K) -> realPart (field.mul (conjugate a) a) = R.zero -> a = field.zero,
};
\module Over(K: \Set, field: Fields.Field[K], scalar: Scalar[K, field]);
\module Real;
\module Complex;
