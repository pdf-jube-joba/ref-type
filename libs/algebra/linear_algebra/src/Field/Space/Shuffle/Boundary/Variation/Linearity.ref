
\import Other.Vector[space := target] \as Vectors;
\import \parent.\parent.\parent.\parent.Linear[V := J, W := K, source := target, target := scalarSpace] \as Maps;
\definition headMap(f: Other.Function)(linear: Vectors.Linear f)(tail: Lists.List[J]): Maps.Map := Maps.Map {
  apply := \fun (v: J) => f (Lists.List[J]::cons v tail),
  preservesAdd := \fun (v, w: J) => congr!{{Other.Function} K} (\fun (g: Other.Function) => g tail)
    (Other.shift (#add{target} v w) f) (Other.plus (Other.shift v f) (Other.shift w f)) (Vectors.Head[xs := tail].shiftAddition f linear v w),
  preservesScale := \fun (a: K)(v: J) => congr!{{Other.Function} K} (\fun (g: Other.Function) => g tail)
    (Other.shift (#smul{target} a v) f) (Other.scale a (Other.shift v f)) (Vectors.Head[xs := tail].shiftScalar f linear a v),
};
\module Sums(T: \Set);
