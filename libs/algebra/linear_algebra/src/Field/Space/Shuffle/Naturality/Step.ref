\definition law: (\forall (f: I -> J)(h, g: Other.Function) -> product (mapSeries f h) (mapSeries f g) xs = Other.product h g (Lists.map I J f xs)) ->
  \forall (head: I)(f: I -> J)(h, g: Other.Function) -> product (mapSeries f h) (mapSeries f g) (Lists.List[I]::cons head xs) = Other.product h g (Lists.map I J f (Lists.List[I]::cons head xs)) := \block {
  \fun (previous: \forall (f: I -> J)(h, g: Other.Function) -> product (mapSeries f h) (mapSeries f g) xs = Other.product h g (Lists.map I J f xs))(head: I)(f: I -> J)(h, g: Other.Function) \then
  \let right: product (twist (mapSeries f h)) (shift head (mapSeries f g)) xs = Other.product (Other.twist h) (Other.shift (f head) g) (Lists.map I J f xs) :=
    trans!{K} _ _ _ (Laws.congruent (twist (mapSeries f h)) (mapSeries f (Other.twist h)) (shift head (mapSeries f g)) (mapSeries f (Other.shift (f head) g))
      (twistMap f h) (\fun (ys: Lists.List[I]) => \refl(g (Lists.List[J]::cons (f head) (Lists.map I J f ys)))) xs)
      (previous f (Other.twist h) (Other.shift (f head) g)) \then
  \return eq_reason!{
    {product (mapSeries f h) (mapSeries f g) (Lists.List[I]::cons head xs)}
    "=" {add (product (shift head (mapSeries f h)) (mapSeries f g) xs) (product (twist (mapSeries f h)) (shift head (mapSeries f g)) xs)} "by" {atCons head xs (mapSeries f h) (mapSeries f g)}
    "=" {add (Other.product (Other.shift (f head) h) g (Lists.map I J f xs)) (Other.product (Other.twist h) (Other.shift (f head) g) (Lists.map I J f xs))} "by" {
      congr2!{K K K} add _ _ _ _ (previous f (Other.shift (f head) h) g) right}
    "=" {Other.product h g (Lists.List[J]::cons (f head) (Lists.map I J f xs))} "by" {sym!{K} _ _ (Other.atCons (f head) (Lists.map I J f xs) h g)}
  }
};
