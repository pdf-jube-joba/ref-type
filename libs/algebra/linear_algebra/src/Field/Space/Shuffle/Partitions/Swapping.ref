\definition step: (\forall (h: Split -> K) -> Sums.sum (partitions xs) (\fun (s: Split) => h (swap s)) = Sums.sum (partitions xs) h) ->
  \forall (i: I)(h: Split -> K) -> Sums.sum (partitions (Lists.List[I]::cons i xs)) (\fun (s: Split) => h (swap s)) = Sums.sum (partitions (Lists.List[I]::cons i xs)) h := \block {
  \fun (previous: \forall (h: Split -> K) -> Sums.sum (partitions xs) (\fun (s: Split) => h (swap s)) = Sums.sum (partitions xs) h)(i: I)(h: Split -> K) \then
  \let left: Lists.List[Split] := Lists.map Split Split (insertLeft i) (partitions xs) \then
  \let right: Lists.List[Split] := Lists.map Split Split (insertRight i) (partitions xs) \then
  \let swapped: Split -> K := \fun (s: Split) => h (swap s) \then
  \let hl: Split -> K := \fun (s: Split) => h (insertLeft i s) \then
  \let hr: Split -> K := \fun (s: Split) => h (insertRight i s) \then
  \let first: Sums.sum left swapped = Sums.sum (partitions xs) hr := eq_reason!{
    {Sums.sum left swapped}
    "=" {Sums.sum (partitions xs) (\fun (s: Split) => h (swap (insertLeft i s)))} "by" {Mapping.sumMap (partitions xs) (insertLeft i) swapped}
    "=" {Sums.sum (partitions xs) (\fun (s: Split) => hr (swap s))} "by" {
      SumLaws.congruent (partitions xs) (\fun (s: Split) => h (swap (insertLeft i s))) (\fun (s: Split) => hr (swap s))
        (\fun (s: Split) => congr!{Split K} h (swap (insertLeft i s)) (insertRight i (swap s)) (swapLeft i s))}
    "=" {Sums.sum (partitions xs) hr} "by" {previous hr}
  } \then
  \let second: Sums.sum right swapped = Sums.sum (partitions xs) hl := eq_reason!{
    {Sums.sum right swapped}
    "=" {Sums.sum (partitions xs) (\fun (s: Split) => h (swap (insertRight i s)))} "by" {Mapping.sumMap (partitions xs) (insertRight i) swapped}
    "=" {Sums.sum (partitions xs) (\fun (s: Split) => hl (swap s))} "by" {
      SumLaws.congruent (partitions xs) (\fun (s: Split) => h (swap (insertRight i s))) (\fun (s: Split) => hl (swap s))
        (\fun (s: Split) => congr!{Split K} h (swap (insertRight i s)) (insertLeft i (swap s)) (swapRight i s))}
    "=" {Sums.sum (partitions xs) hl} "by" {previous hl}
  } \then
  \return eq_reason!{
    {Sums.sum (partitions (Lists.List[I]::cons i xs)) swapped}
    "=" {add (Sums.sum left swapped) (Sums.sum right swapped)} "by" {SumLaws.append left right swapped}
    "=" {add (Sums.sum (partitions xs) hr) (Sums.sum (partitions xs) hl)} "by" {congr2!{K K K} add _ _ _ _ first second}
    "=" {add (Sums.sum (partitions xs) hl) (Sums.sum (partitions xs) hr)} "by" {addComm (Sums.sum (partitions xs) hr) (Sums.sum (partitions xs) hl)}
    "=" {add (Sums.sum left h) (Sums.sum right h)} "by" {congr2!{K K K} add _ _ _ _
      (sym!{K} (Sums.sum left h) (Sums.sum (partitions xs) hl) (Mapping.sumMap (partitions xs) (insertLeft i) h))
      (sym!{K} (Sums.sum right h) (Sums.sum (partitions xs) hr) (Mapping.sumMap (partitions xs) (insertRight i) h))}
    "=" {Sums.sum (partitions (Lists.List[I]::cons i xs)) h} "by" {sym!{K} _ _ (SumLaws.append left right h)}
  }
};
