\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import N.Basic[].Prop[] \as Arithmetic;
\import Product.Degrees[p := one, q := k] \as Wedge;
\import Product.Regrade[k := Nat.add one k, l := N.Nat^::succ k] \as Regrade;
\definition degree: Nat.add one k = N.Nat^::succ k :=
  trans!{{N.Nat^}} (Nat.add one k) (N.Nat^::succ (Nat.add N.Nat^::zero k)) (N.Nat^::succ k)
    (Arithmetic.addSuccLeft N.Nat^::zero k)
    (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ (Nat.add N.Nat^::zero k) k (Arithmetic.addZeroLeft k));
\definition tail(indices: Fin.Fin (N.Nat^::succ k) -> Fin.Fin n): Fin.Fin k -> Fin.Fin n :=
  \fun (i: Fin.Fin k) => indices (Fin.succ k i);
\definition value: Operator k -> Operator (N.Nat^::succ k) :=
  \fun (previous: Operator k)(indices: Fin.Fin (N.Nat^::succ k) -> Fin.Fin n) =>
  Regrade.cast (Wedge.wedge (coordinate (indices (Fin.zero k))) (previous (tail indices))) degree;
