\import \parent.\parent.Linear[V := V, W := W, source := space, target := target] \as Linear;
\import \parent.\parent.Exterior[V := W, space := target] \as Other;
\import \parent.\parent.Multilinear[V := W, space := target] \as OtherMultilinear;
\import OtherMultilinear.Alternating[] \as OtherAlternating;
\import Alternating.Precomposition[W := W, target := target] \as Precomposition;
\import \parent.\parent.Shuffle[I := W] \as OtherShuffle;
\import Shuffle.Naturality[J := W] \as ShuffleMapping;
\import Lists.Mapping[A := V, B := W] \as ListMap;
\import ListMap.Prop[] \as ListMapLaws;
\import TuplesList.Mapping[B := W] \as TupleMapping;
\definition mapped(k: N.Nat^)(f: Linear.Map)(omega: Other.Form k): Series := ShuffleMapping.mapSeries (#apply{f}) (Other.component k omega);
\module Components(k: N.Nat^);
\module Naturality(p, q: N.Nat^);
