\import \parent.SeriesShift[k := N.Nat^::zero] \as Shift;
\import \parent.ZeroHeads[] \as ZeroHeads;
\import \parent.\parent.Sign[] \as Sign;
\definition two: \forall (f: Multilinear.Function (N.Nat^::succ N.Nat^::zero))(x, y: V)(xs: Lists.List[V]) -> component (N.Nat^::succ N.Nat^::zero) f (Lists.List[V]::cons x (Lists.List[V]::cons y xs)) = zero :=
  \fun (f: Multilinear.Function (N.Nat^::succ N.Nat^::zero))(x, y: V)(xs: Lists.List[V]) => trans!{K} _ _ zero
    (Shift.atCons f x (Lists.List[V]::cons y xs)) (ZeroHeads.nonempty (Shift.contraction f x) y xs);
\definition laws: \forall (f: Form (N.Nat^::succ N.Nat^::zero)) -> HeadLaws[N.Nat^::succ N.Nat^::zero, f] :=
  \fun (f: Form (N.Nat^::succ N.Nat^::zero)) => HeadLaws[N.Nat^::succ N.Nat^::zero, f] {
    swap := \fun (x, y: V)(xs: Lists.List[V]) => trans!{K} _ zero _ (two f x y xs)
      (trans!{K} zero (neg zero) _ (sym!{K} (neg zero) zero Sign.negativeZero) (congr!{K K} neg _ _ (sym!{K} _ _ (two f y x xs)))),
    repeated := \fun (x: V)(xs: Lists.List[V]) => two f x x xs,
  };
