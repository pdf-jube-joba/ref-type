\import Multilinear.ListSeries[k := N.Nat^::zero] \as Base;
\import \parent.ZeroHeads[] \as ZeroHeads;
\definition componentUnit: component N.Nat^::zero unit = Shuffle.unit :=
  \axiom:funext(component N.Nat^::zero unit, Shuffle.unit,
    \induction (xs: Lists.List[V]) \return component N.Nat^::zero unit xs = Shuffle.unit xs \with {
      | nil: Base.inside unit (\into[Lists.List[V]](Lists.List[V]::nil, ArgumentsList.Degree N.Nat^::zero) \by { \refl(N.Nat^::zero) })
      | cons: \fun (head: V)(xs: Lists.List[V])(unused: component N.Nat^::zero unit xs = Shuffle.unit xs) => ZeroHeads.nonempty unit head xs
    });
