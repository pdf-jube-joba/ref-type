\import \parent.\parent.Linear[V := U, W := V, source := domain, target := left] \as LeftMaps;
\import \parent.\parent.Linear[V := U, W := W, source := domain, target := right] \as RightMaps;
\import \parent.\parent.Linear[V := U, W := Carrier, source := domain, target := space] \as Maps;
\definition pair(f: LeftMaps.Map) (g: RightMaps.Map): Maps.Map := Maps.Map {
  apply := \fun (x: U) => make (f.apply x) (g.apply x),
  preservesAdd := \fun (x, y: U) => Pairs.pairCong _ _ _ _ (f.preservesAdd x y) (g.preservesAdd x y),
  preservesScale := \fun (a: K) (x: U) => Pairs.pairCong _ _ _ _ (f.preservesScale a x) (g.preservesScale a x),
};
\definition unique: \forall (f: LeftMaps.Map) (g: RightMaps.Map) (h: Maps.Map) ->
  (\forall (x: U) -> first (h.apply x) = f.apply x) ->
  (\forall (x: U) -> second (h.apply x) = g.apply x) ->
  h.apply = (pair f g).apply :=
  \fun (f: _) (g: _) (h: _) (lf: _) (rg: _) => \axiom:funext(h.apply, (pair f g).apply,
    \fun (x: U) => Pairs.ext _ _ (lf x) (rg x));
