\import \parent.\parent.Dual[V := W, source := target] \as Other;
\import \parent.\parent.Linear[V := V, W := W, source := source, target := target] \as Forward;
\import \parent.\parent.Linear[V := Other.Carrier, W := Carrier, source := Other.space, target := space] \as Backward;
\definition apply(f: Forward.Map) (g: Other.Carrier): Carrier :=
  \into[Functions.Vector](\fun (x: V) => g (f.apply x), subspace.carrier) \by {
    Maps.MapLaws[Maps.MapData { apply := \fun (x: V) => g (f.apply x) }] {
      preservesAdd := \fun (x, y: V) => trans!{K} _ _ _
        (congr!{W K} g _ _ (f.preservesAdd x y)) ((Other.laws g).preservesAdd (f.apply x) (f.apply y)),
      preservesScale := \fun (a: K) (x: V) => trans!{K} _ _ _
        (congr!{W K} g _ _ (f.preservesScale a x)) ((Other.laws g).preservesScale a (f.apply x)),
    }
  };
\definition map(f: Forward.Map): Backward.Map := Backward.Map {
  apply := apply f,
  preservesAdd := \fun (g, h: Other.Carrier) => ext
    (apply f (Other.space.add g h)) (space.add (apply f g) (apply f h))
    (\fun (x: V) => \refl(add (g (f.apply x)) (h (f.apply x)))),
  preservesScale := \fun (a: K) (g: Other.Carrier) => ext
    (apply f (Other.space.smul a g)) (space.smul a (apply f g))
    (\fun (x: V) => \refl(mul a (g (f.apply x)))),
};
