\import \parent.\parent.Laws[V := V, space := space] \as Laws;
\definition Carrier: \Set := \Cast[V] (subspace.carrier);
\definition origin: Carrier := \into[V](space.zero, subspace.carrier) \by { subspace.containsZero };
\definition plus[x, y: Carrier]: Carrier := \into[V](space.add x y, subspace.carrier) \by {
  subspace.closedAdd x y (\bysub(V, subspace.carrier, x)) (\bysub(V, subspace.carrier, y))
};
\definition scale[a: K] [x: Carrier]: Carrier := \into[V](space.smul a x, subspace.carrier) \by {
  subspace.closedScale a x (\bysub(V, subspace.carrier, x))
};
\definition negative[x: Carrier]: Carrier := \into[V](space.neg x, subspace.carrier) \by {
  \idelim space.smul (neg one) x = space.neg x
    \with y: V => Member subspace y
    \by { base: subspace.closedScale (neg one) x (\bysub(V, subspace.carrier, x)), equality: Laws.minusOneScale x }
};
\definition induced: VectorSpace Carrier := Ring.RingModule[K, Carrier, ring] {
  zero := origin, add := plus, neg := negative, smul := scale,
  additive := Alg.CommutativeGroupLaws[Carrier, Alg.CommutativeGroupData[Carrier]::# (Alg.GroupData[Carrier]::# origin plus negative)] {
    group := Alg.GroupLaws[Carrier, Alg.GroupData[Carrier]::# origin plus negative] {
      monoid := Monoid.MonoidLaws[Carrier, Monoid.MonoidData[Carrier]::# origin plus] {
        leftIdentity := \fun (x: Carrier) => Laws.zeroLeft x,
        rightIdentity := \fun (x: Carrier) => Laws.zeroRight x,
        associative := \fun (x, y, z: Carrier) => Laws.assoc x y z,
      },
      leftInverse := \fun (x: Carrier) => Laws.inverseLeft x,
      rightInverse := \fun (x: Carrier) => trans!{V} _ _ _ (Laws.comm x (space.neg x)) (Laws.inverseLeft x),
    },
    commutative := \fun (x, y: Carrier) => Laws.comm x y,
  },
  scalarOne := \fun (x: Carrier) => space.scalarOne x,
  scalarAssoc := \fun (a, b: K) (x: Carrier) => space.scalarAssoc a b x,
  scalarAdd := \fun (a, b: K) (x: Carrier) => space.scalarAdd a b x,
  vectorAdd := \fun (a: K) (x, y: Carrier) => space.vectorAdd a x y,
};
\import \parent.\parent.Linear[V := Carrier, W := V, source := induced, target := space] \as Into;
\definition inclusion: Into.Map := Into.Map {
  apply := \fun (x: Carrier) => x,
  preservesAdd := \fun (x, y: Carrier) => \refl(space.add x y),
  preservesScale := \fun (a: K) (x: Carrier) => \refl(space.smul a x),
};
