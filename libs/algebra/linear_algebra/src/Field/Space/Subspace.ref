\structure SubspaceData: \Set {
  carrier: \Pow V,
}
\structure SubspaceLaws[data: SubspaceData]: \Prop {
  containsZero: \In[V] data.carrier (space.zero),
  closedAdd: \forall (x, y: V) -> \In[V] data.carrier x -> \In[V] data.carrier y -> \In[V] data.carrier (space.add x y),
  closedScale: \forall (a: K) (x: V) -> \In[V] data.carrier x -> \In[V] data.carrier (space.smul a x),
}
\definition Subspace: \Set := \Cast[SubspaceData] ({ data: SubspaceData \where SubspaceLaws[data] });
\definition Member(s: SubspaceData) (x: V): \Prop := \In[V] (s.carrier) x;
\module Of(subspace: Subspace);
\module Kernel(W: \Set, target: VectorSpace W) {
  \import \parent.\parent.Linear[V := V, W := W, source := space, target := target] \as Maps;
  \import \parent.\parent.Laws[V := W, space := target] \as TargetLaws;
  \definition kernel(f: Maps.Map): Subspace := Subspace {
    carrier := { x: V \where f.apply x = target.zero },
    containsZero := f.preservesZero,
    closedAdd := \fun (x, y: _) (hx: _) (hy: _) => eq_reason!{
      {f.apply (space.add x y)}
      "=" {target.add (f.apply x) (f.apply y)} "by" {f.preservesAdd x y}
      "=" {target.add (target.zero) (target.zero)} "by" {congr2!{W W W} (target.add) _ _ _ _ hx hy}
      "=" {target.zero} "by" {TargetLaws.zeroLeft (target.zero)}
    },
    closedScale := \fun (a: _) (x: _) (hx: _) => trans!{W} _ _ _ (f.preservesScale a x)
      (trans!{W} _ _ _ (congr!{W W} (target.smul a) _ _ hx) (TargetLaws.scaleZero a)),
  };
}
\module Image(U: \Set, source: VectorSpace U) {
  \import \parent.\parent.Linear[V := U, W := V, source := source, target := space] \as Linear;
  \import module_theory.Module[].Over[R := K, ring := ring] \as Modules;
  \import Modules.Of[V := V, space := space] \as Target;
  \import Target.Submodule[] \as Submodules;
  \import Submodules.Image[U := U, source := source] \as Images;
  \import Modules.Hom[V := U, W := V, source := source, target := space] \as Maps;
  \definition asModuleMap(f: Linear.Map): Maps.Map := Maps.Map {
    apply := f.apply, addition := f.preservesAdd, scalar := f.preservesScale,
  };
  \definition image(f: Linear.Map): Subspace := Subspace {
    carrier := (Images.image (asModuleMap f)).carrier,
    containsZero := (Images.image (asModuleMap f)).zero,
    closedAdd := (Images.image (asModuleMap f)).addition,
    closedScale := (Images.image (asModuleMap f)).scalar,
  };
}
