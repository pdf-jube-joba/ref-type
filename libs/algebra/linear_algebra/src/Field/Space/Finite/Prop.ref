\definition coordinatesInjective: \forall (b: Basis) -> \forall (x, y: V) -> coordinates b x = coordinates b y -> x = y :=
  \fun (b: Basis) (x, y: _) (equal: _) => eq_reason!{
    x "=" {synthesize b (coordinates b x)} "by" {sym!{V} _ _ (b.reconstruction x)}
      "=" {synthesize b (coordinates b y)} "by" {congr!{Coordinates.Vector V} (synthesize b) _ _ equal}
      "=" y "by" {b.reconstruction y}
  };

\definition synthesis[b: Basis]: Decode.Map := Decode.Map {
  apply := synthesize b,
  preservesAdd := \fun (x, y: _) => coordinatesInjective b _ _ (eq_reason!{
    {coordinates b (synthesize b (Coordinates.plus x y))}
    "=" {Coordinates.plus x y} "by" {b.coordinateReconstruction (Coordinates.plus x y)}
    "=" {Coordinates.plus (coordinates b (synthesize b x)) (coordinates b (synthesize b y))} "by" {
      sym!{Coordinates.Vector} _ _ (congr!{Coordinates.Vector Coordinates.Vector Coordinates.Vector} Coordinates.plus _ _ _ _
        (b.coordinateReconstruction x) (b.coordinateReconstruction y))}
    "=" {coordinates b (space.add (synthesize b x) (synthesize b y))} "by" {
      sym!{Coordinates.Vector} _ _ ((b.coordinates).preservesAdd (synthesize b x) (synthesize b y))}
  }),
  preservesScale := \fun (a: _) (x: _) => coordinatesInjective b _ _ (eq_reason!{
    {coordinates b (synthesize b (Coordinates.scale a x))}
    "=" {Coordinates.scale a x} "by" {b.coordinateReconstruction (Coordinates.scale a x)}
    "=" {Coordinates.scale a (coordinates b (synthesize b x))} "by" {
      sym!{Coordinates.Vector} _ _ (congr!{Coordinates.Vector Coordinates.Vector} (Coordinates.scale a) _ _ (b.coordinateReconstruction x))}
    "=" {coordinates b (space.smul a (synthesize b x))} "by" {
      sym!{Coordinates.Vector} _ _ ((b.coordinates).preservesScale a (synthesize b x))}
  }),
};

\definition evaluateSum: \forall (indices: Lists.List[I]) -> \forall (f: I -> V) -> \forall (h: Dual.Map) ->
  h.apply (vectorSum indices f) = Sums.sum indices (\fun (i: _) => h.apply (f i)) :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> V) -> \forall (h: Dual.Map) ->
    h.apply (vectorSum indices f) = Sums.sum indices (\fun (i: _) => h.apply (f i)) \with {
  | nil : \fun (f: _) (h: Dual.Map) => h.preservesZero
  | cons : \fun (i: I) (tail: Lists.List[I])
      (ih: \forall (f: I -> V) -> \forall (h: Dual.Map) ->
        h.apply (vectorSum tail f) = Sums.sum tail (\fun (i: _) => h.apply (f i)))
      (f: I -> V) (h: Dual.Map) => trans!{K} _ _ _
      (h.preservesAdd (f i) (vectorSum tail f))
      (congr!{K K} (add (h.apply (f i))) _ _ (ih f h))
  };

\definition functionalExpansion: \forall (b: Basis) -> \forall (h: Dual.Map) -> \forall (x: V) ->
  h.apply x = Sums.sum (b.indices) (\fun (i: _) => mul (coordinates b x i) (h.apply (b.vectors i))) :=
  \fun (b: Basis) (h: Dual.Map) (x: _) => eq_reason!{
    {h.apply x}
    "=" {h.apply (synthesize b (coordinates b x))} "by" {congr!{V K} (h.apply) _ _ (sym!{V} _ _ (b.reconstruction x))}
    "=" {Sums.sum (b.indices) (\fun (i: _) => h.apply (space.smul (coordinates b x i) (b.vectors i)))} "by" {
      evaluateSum (b.indices) (\fun (i: _) => space.smul (coordinates b x i) (b.vectors i)) h}
    "=" {Sums.sum (b.indices) (\fun (i: _) => mul (coordinates b x i) (h.apply (b.vectors i)))} "by" {
      SumLaws.congruent (b.indices)
        (\fun (i: _) => h.apply (space.smul (coordinates b x i) (b.vectors i)))
        (\fun (i: _) => mul (coordinates b x i) (h.apply (b.vectors i)))
        (\fun (i: _) => h.preservesScale (coordinates b x i) (b.vectors i))}
  };
