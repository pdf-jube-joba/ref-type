\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Dual[V := V, source := space] \as Functionals;
\import \parent.Dimension[] \as Dimension;
\import \parent.\parent.Finite[V := Functionals.Carrier, I := I, space := Functionals.space] \as DualFinite;
\import DualFinite.Prop[] \as DualBasisLaws;
\import \parent.\parent.Linear[V := Functionals.Carrier, W := Coordinates.Vector, source := Functionals.space, target := Coordinates.space] \as Encode;
\import \parent.\parent.Coordinates[I := I].Kronecker[] \as Kronecker;
\import \parent.\parent.Sums[I := I].Single[] \as Single;
\definition vectors[b: Basis] [i: I]: Functionals.Carrier := Functionals.fromMap (coordinate b i);
\definition encode[b: Basis]: Encode.Map := Encode.Map {
  apply := \fun (f: Functionals.Carrier) (i: I) => f (b.vectors i),
  preservesAdd := \fun (f, g: Functionals.Carrier) => \refl(\fun (i: I) => add (f (b.vectors i)) (g (b.vectors i))),
  preservesScale := \fun (a: K) (f: Functionals.Carrier) => \refl(\fun (i: I) => mul a (f (b.vectors i))),
};
\definition raw[b: Basis]: DualFinite.BasisData := DualFinite.BasisData {
  indices := b.indices, vectors := vectors b, coordinates := encode b,
};
\definition synthesisEvaluation: \forall (b: Basis) (x: Coordinates.Vector) (v: V) ->
  DualFinite.synthesize (raw b) x v = Sums.sum b.indices (\fun (i: I) => mul (x i) (coordinates b v i)) :=
  \fun (b: Basis) (x: Coordinates.Vector) (v: V) => DualBasisLaws.evaluateSum b.indices
    (\fun (i: I) => Functionals.space.smul (x i) (vectors b i)) (Functionals.evaluate v);
\definition evaluationSum: \forall (indices: Lists.List[I]) (f: I -> V) (h: Functionals.Carrier) ->
  h (vectorSum indices f) = Sums.sum indices (\fun (i: I) => h (f i)) :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> V) (h: Functionals.Carrier) ->
    h (vectorSum indices f) = Sums.sum indices (\fun (i: I) => h (f i)) \with {
      | nil: \fun (f: _) (h: Functionals.Carrier) => (Functionals.laws h).preservesZero
      | cons: \fun (i: I) (tail: Lists.List[I]) (ih: _) (f: _) (h: Functionals.Carrier) =>
        trans!{K} _ _ _ ((Functionals.laws h).preservesAdd (f i) (vectorSum tail f))
          (congr!{K K} (add (h (f i))) _ _ (ih f h))
    };
\definition functionalExpansion: \forall (b: Basis) (f: Functionals.Carrier) (v: V) ->
  f v = Sums.sum b.indices (\fun (i: I) => mul (coordinates b v i) (f (b.vectors i))) :=
  \fun (b: Basis) (f: Functionals.Carrier) (v: V) => eq_reason_in!{K _
    "=" _ "by" { congr!{V K} f _ _ (sym!{V} _ _ (b.reconstruction v)) }
    "=" _ "by" { evaluationSum b.indices (\fun (i: I) => space.smul (coordinates b v i) (b.vectors i)) f }
    "=" _ "by" { SumLaws.congruent b.indices
        (\fun (i: I) => f (space.smul (coordinates b v i) (b.vectors i)))
        (\fun (i: I) => mul (coordinates b v i) (f (b.vectors i)))
        (\fun (i: I) => (Functionals.laws f).preservesScale (coordinates b v i) (b.vectors i)) }
  };
\definition reconstruction: \forall (b: Basis) (f: Functionals.Carrier) ->
  DualFinite.synthesize (raw b) (DualFinite.coordinates (raw b) f) = f :=
  \fun (b: Basis) (f: Functionals.Carrier) => Functionals.ext
    (DualFinite.synthesize (raw b) (DualFinite.coordinates (raw b) f)) f (\fun (v: V) => eq_reason_in!{K _
      "=" _ "by" { synthesisEvaluation b (DualFinite.coordinates (raw b) f) v }
      "=" _ "by" { SumLaws.congruent b.indices
        (\fun (i: I) => mul (f (b.vectors i)) (coordinates b v i))
        (\fun (i: I) => mul (coordinates b v i) (f (b.vectors i)))
        (\fun (i: I) => mulComm (f (b.vectors i)) (coordinates b v i)) }
      "=" _ "by" { sym!{K} _ _ (functionalExpansion b f v) }
    });
\definition coordinateReconstruction: \forall (b: Basis) (x: Coordinates.Vector) ->
  DualFinite.coordinates (raw b) (DualFinite.synthesize (raw b) x) = x :=
  \fun (b: Basis) (x: Coordinates.Vector) => \axiom:funext(
    DualFinite.coordinates (raw b) (DualFinite.synthesize (raw b) x), x,
    (\fun (i: I) => eq_reason_in!{K _
      "=" _ "by" { synthesisEvaluation b x (b.vectors i) }
      "=" _ "by" { SumLaws.congruent b.indices
        (\fun (j: I) => mul (x j) (coordinates b (b.vectors i) j))
        (\fun (j: I) => mul (Kronecker.delta i j) (x j))
        (\fun (j: I) => trans!{K} _ _ _ (mulComm (x j) (coordinates b (b.vectors i) j))
          (congr!{K K} (\fun (a: K) => mul a (x j)) _ _
            (trans!{K} _ _ _ (Dimension.biorthogonal b i j) (Kronecker.symmetric j i)))) }
      "=" _ "by" { Single.extract b.indices b.distinct i (Dimension.indicesExhaustive b i) x }
    }));
\definition dualReconstruction: \forall (b: Basis) (x: Coordinates.Vector) (i: I) ->
  Sums.sum b.indices (\fun (j: I) => mul (x j) (DualFinite.coordinates (raw b) (vectors b i) j)) = x i :=
  \fun (b: Basis) (x: Coordinates.Vector) (i: I) => trans!{K} _ _ _ (SumLaws.congruent b.indices
    (\fun (j: I) => mul (x j) (coordinates b (b.vectors j) i))
    (\fun (j: I) => mul (Kronecker.delta i j) (x j))
    (\fun (j: I) => trans!{K} _ _ _ (mulComm (x j) (coordinates b (b.vectors j) i))
      (congr!{K K} (\fun (a: K) => mul a (x j)) _ _ (Dimension.biorthogonal b j i))))
    (Single.extract b.indices b.distinct i (Dimension.indicesExhaustive b i) x);
\definition basis[b: Basis]: DualFinite.Basis := DualFinite.Basis {
  indices := b.indices, vectors := vectors b, coordinates := encode b,
  distinct := b.distinct, reconstruction := reconstruction b,
  coordinateReconstruction := coordinateReconstruction b, dualReconstruction := dualReconstruction b,
};
\definition dimensionLaw: \forall (b: Basis) -> DualFinite.dimension (basis b) = dimension b := \fun (b: Basis) => \refl(dimension b);
