\import \parent.\parent.Coordinates[I := I].Kronecker[] \as Kronecker;
\import \parent.\parent.Sums[I := I].Single[] \as Single;
\import \parent.\parent.Eigen[V := V, space := space] \as Eigen;
\definition naturalScalar: N.Nat^ -> K :=
  \induction (n: N.Nat^) \return K \with {
    | zero: zero
    | succ: \fun (n: N.Nat^) (value: K) => add one value
  };
\definition diagonalOne: \forall (b: Basis) (i: I) -> \In[I] (Sums.keys b.indices) i -> coordinates b (b.vectors i) i = one := \block {
  \fun (b: Basis) (i: I) (member: _) \then
  \let x: Coordinates.Vector := \fun (j: I) => Kronecker.delta i j \then
  \let coefficient: I -> K := \fun (j: I) => coordinates b (b.vectors i) j \then
  \return trans!{K} _ _ _ (sym!{K} _ _ (Single.extract b.indices b.distinct i member coefficient))
    (trans!{K} _ _ _ (b.dualReconstruction x i) (Kronecker.self i))
};
\definition sumOnes: \forall (indices: Lists.List[I]) -> Sums.sum indices (\fun (_: I) => one) = naturalScalar (Lists.length I indices) :=
  \induction (indices: Lists.List[I]) \return Sums.sum indices (\fun (_: I) => one) = naturalScalar (Lists.length I indices) \with {
    | nil: \refl(zero)
    | cons: \fun (i: I) (tail: Lists.List[I]) (ih: _) => congr!{K K} (add one) _ _ ih
  };
\definition identityTrace: \forall (b: Basis) -> trace b Eigen.identity = naturalScalar (dimension b) :=
  \fun (b: Basis) => trans!{K} _ _ _
    (SumLaws.congruentOnKeys b.indices (\fun (i: I) => coordinates b (b.vectors i) i) (\fun (_: I) => one) (diagonalOne b))
    (sumOnes b.indices);
\module Comparison(J: \Set) {
  \import \parent.\parent.Rebase[J := J] \as Rebase;
  \import \parent.\parent.\parent.Finite[V := V, I := J, space := space] \as Other;
  \import Other.Dimension[] \as OtherDimension;
  \definition equalScalarDimension: \forall (b: Basis) (c: Other.Basis) -> naturalScalar (dimension b) = OtherDimension.naturalScalar (Other.dimension c) :=
    \fun (b: Basis) (c: Other.Basis) => trans!{K} _ _ _ (sym!{K} _ _ (identityTrace b))
      (trans!{K} _ _ _ (Rebase.traceIndependent b c Eigen.identity) (OtherDimension.identityTrace c));
}
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition indicesExhaustive: \forall (b: Basis) (i: I) -> \In[I] (Sums.keys b.indices) i :=
  \fun (b: Basis) (i: I) => either!{{(Classical.excludedMiddle (\In[I] (Sums.keys b.indices) i))} {\In[I] (Sums.keys b.indices) i}
    {\fun (member: _) => member}
    {\fun (absent: Logic.Not (\In[I] (Sums.keys b.indices) i)) => Logic.falseElim (\In[I] (Sums.keys b.indices) i)
      (field.nontrivial (trans!{K} _ _ _ (sym!{K} _ _ (Single.absent b.indices i absent
          (\fun (j: I) => coordinates b (b.vectors i) j)))
        (trans!{K} _ _ _ (b.dualReconstruction (\fun (j: I) => Kronecker.delta i j) i) (Kronecker.self i))))}
  };
\definition biorthogonal: \forall (b: Basis) (i, j: I) -> coordinates b (b.vectors i) j = Kronecker.delta j i :=
  \fun (b: Basis) (i, j: I) => trans!{K} _ _ _
    (sym!{K} _ _ (Single.extract b.indices b.distinct j (indicesExhaustive b j) (\fun (k: I) => coordinates b (b.vectors i) k)))
    (b.dualReconstruction (\fun (k: I) => Kronecker.delta j k) i);
