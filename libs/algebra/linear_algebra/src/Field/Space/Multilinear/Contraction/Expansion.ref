\import \parent.\parent.\parent.Finite[V := V, I := I, space := space] \as Basis;
\import Basis.Prop[] \as Expansion;
\import \parent.\parent.\parent.Sums[I := I] \as Sums;
\definition law: \forall (f: Form (N.Nat^::succ k))(head: V)(arguments: Arguments k) ->
  value f head arguments = Sums.sum (#indices{b}) (\fun (i: I) => mul (Basis.coordinates b head i) (value f (#vectors{b} i) arguments)) :=
  \fun (f: Form (N.Nat^::succ k))(head: V)(arguments: Arguments k) => Expansion.functionalExpansion b (headMap f arguments) head;
