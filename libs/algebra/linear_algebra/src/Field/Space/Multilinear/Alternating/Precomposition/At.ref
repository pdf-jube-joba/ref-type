\import \parent.\parent.At[k := k] \as SourceForms;
\import AlternatingTarget.At[k := k] \as TargetForms;
\import \parent.\parent.\parent.\parent.Linear[V := AlternatingTarget.Form k, W := Form k,
  source := TargetForms.vectorSpace, target := SourceForms.vectorSpace] \as Maps;
\definition linear(f: Linear.Map): Maps.Map := Maps.Map {
  apply := precompose k f,
  preservesAdd := \fun (a, b: AlternatingTarget.Form k) => SourceForms.ext (precompose k f (TargetForms.plus a b)) (SourceForms.plus (precompose k f a) (precompose k f b))
    (\fun (v: Arguments k) => \refl(add (a (arguments k f v)) (b (arguments k f v)))),
  preservesScale := \fun (a: K)(omega: AlternatingTarget.Form k) => SourceForms.ext (precompose k f (TargetForms.scale a omega)) (SourceForms.scale a (precompose k f omega))
    (\fun (v: Arguments k) => \refl(mul a (omega (arguments k f v)))),
};
