\use std.Logic[].Equality[].eq_reason_in;
\import Fin.Tuples[A := V] \as Tuples;
\import N.Basic[].Prop[] \as NatLaws;
\import \parent.\parent.Contraction[k := k] \as Multilinear;
\definition multilinear[f: Form (N.Nat^::succ k)]: MultilinearForm (N.Nat^::succ k) :=
  \into[Function (N.Nat^::succ k)](f, { g: Function (N.Nat^::succ k) \where Laws[N.Nat^::succ k, g] }) \by {
    (\bysub(Function (N.Nat^::succ k), Form (N.Nat^::succ k), f)).linear
  };
\definition value[f: Form (N.Nat^::succ k)][head: V]: Function k := Multilinear.value (multilinear f) head;
\definition alternating: \forall (f: Form (N.Nat^::succ k))(head: V)(arguments: Arguments k)(i, j: Fin.Fin k) ->
  Logic.Not (i = j) -> arguments i = arguments j -> value f head arguments = zero :=
  \fun (f: Form (N.Nat^::succ k))(head: V)(arguments: Arguments k)(i, j: Fin.Fin k)(different: Logic.Not (i = j))(same: arguments i = arguments j) =>
    (\bysub(Function (N.Nat^::succ k), Form (N.Nat^::succ k), f)).alternating (Tuples.extend k head arguments) (Fin.succ k i) (Fin.succ k j)
      (\fun (equal: Fin.succ k i = Fin.succ k j) => different (NatLaws.succInjective (Fin.value k i) (Fin.value k j) equal))
      (eq_reason_in!{V _
        "=" _ "by" { Tuples.atSuccessor k head arguments i }
        "=" _ "by" same
        "=" _ "by" { sym!{V} _ _ (Tuples.atSuccessor k head arguments j) }
      });
\definition apply[f: Form (N.Nat^::succ k)][head: V]: Form k := \into[Function k](value f head, { g: Function k \where AlternatingLaws[k, g] }) \by {
  AlternatingLaws[k, value f head] {
    linear := \bysub(Function k, { g: Function k \where Laws[k, g] }, Multilinear.apply (multilinear f) head),
    alternating := alternating f head,
  }
};
\import \parent.\parent.Properties[] \as Updates;
\import \parent.At[k := k] \as Target;
\import \parent.At[k := N.Nat^::succ k] \as Source;
\definition addition: \forall (f, g: Form (N.Nat^::succ k))(head: V) -> apply (Source.plus f g) head = Target.plus (apply f head) (apply g head) :=
  \fun (f, g: Form (N.Nat^::succ k))(head: V) => Target.ext (apply (Source.plus f g) head) (Target.plus (apply f head) (apply g head)) (\fun (arguments: Arguments k) => \refl(add (f (Tuples.extend k head arguments)) (g (Tuples.extend k head arguments))));
\definition scalar: \forall (a: K)(f: Form (N.Nat^::succ k))(head: V) -> apply (Source.scale a f) head = Target.scale a (apply f head) :=
  \fun (a: K)(f: Form (N.Nat^::succ k))(head: V) => Target.ext (apply (Source.scale a f) head) (Target.scale a (apply f head)) (\fun (arguments: Arguments k) => \refl(mul a (f (Tuples.extend k head arguments))));
\definition headAddition: \forall (f: Form (N.Nat^::succ k))(x, y: V) -> apply f (space.add x y) = Target.plus (apply f x) (apply f y) :=
  \fun (f: Form (N.Nat^::succ k))(x, y: V) => Target.ext (apply f (space.add x y)) (Target.plus (apply f x) (apply f y)) (\fun (arguments: Arguments k) => eq_reason_in!{K _
    "=" _ "by" { congr!{{Arguments (N.Nat^::succ k)} K} f _ _ (sym!{{Arguments (N.Nat^::succ k)}} _ _ (Updates.extendHead k (space.zero) arguments (space.add x y))) }
    "=" _ "by" { ((\bysub(Function (N.Nat^::succ k), Form (N.Nat^::succ k), f)).linear).addition (Tuples.extend k (space.zero) arguments) (Fin.zero k) x y }
    "=" _ "by" { congr!{K K K} add _ _ _ _
        (congr!{{Arguments (N.Nat^::succ k)} K} f _ _ (Updates.extendHead k (space.zero) arguments x))
        (congr!{{Arguments (N.Nat^::succ k)} K} f _ _ (Updates.extendHead k (space.zero) arguments y)) }
  });
\definition headScalar: \forall (a: K)(f: Form (N.Nat^::succ k))(x: V) -> apply f (space.smul a x) = Target.scale a (apply f x) :=
  \fun (a: K)(f: Form (N.Nat^::succ k))(x: V) => Target.ext (apply f (space.smul a x)) (Target.scale a (apply f x)) (\fun (arguments: Arguments k) => eq_reason_in!{K _
    "=" _ "by" { congr!{{Arguments (N.Nat^::succ k)} K} f _ _ (sym!{{Arguments (N.Nat^::succ k)}} _ _ (Updates.extendHead k (space.zero) arguments (space.smul a x))) }
    "=" _ "by" { ((\bysub(Function (N.Nat^::succ k), Form (N.Nat^::succ k), f)).linear).scalar (Tuples.extend k (space.zero) arguments) (Fin.zero k) a x }
    "=" _ "by" { congr!{K K} (mul a) _ _ (congr!{{Arguments (N.Nat^::succ k)} K} f _ _ (Updates.extendHead k (space.zero) arguments x)) }
  });
\definition repeated: \forall (f: Form (N.Nat^::succ k))(head: V)(arguments: Arguments k)(i: Fin.Fin k) -> arguments i = head -> value f head arguments = zero :=
  \fun (f: Form (N.Nat^::succ k))(head: V)(arguments: Arguments k)(i: Fin.Fin k)(same: arguments i = head) =>
    (\bysub(Function (N.Nat^::succ k), Form (N.Nat^::succ k), f)).alternating (Tuples.extend k head arguments) (Fin.zero k) (Fin.succ k i)
      (\fun (equal: Fin.zero k = Fin.succ k i) => NatLaws.zeroNeSucc (Fin.value k i) equal)
      (eq_reason_in!{V _
        "=" _ "by" { Tuples.atZero k head arguments }
        "=" _ "by" { sym!{V} (arguments i) head same }
        "=" _ "by" { sym!{V} _ _ (Tuples.atSuccessor k head arguments i) }
      });
\module Square;
