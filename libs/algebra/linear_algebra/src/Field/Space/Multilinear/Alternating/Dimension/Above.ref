\import \parent.\parent.At[k := k] \as Forms;
\definition coefficientZero: \forall (f: Form k) -> NatLaws.Lt n k ->
  \forall (indices: Fin.Fin k -> Fin.Fin n) -> Coefficients.coefficients k f indices = zero := \block {
  \fun (f: Form k)(large: NatLaws.Lt n k)(indices: Fin.Fin k -> Fin.Fin n) \then
  \takefrom collision: Pigeonhole.Collision[k, n, indices] \by Pigeonhole.collisionExists k n indices large \then
  \return #alternating{(\bysub(Function k, Form k, f))}
    (\fun (j: Fin.Fin k) => #vectors{b} (indices j)) #first{collision} #second{collision} #different{collision}
      (congr!{{Fin.Fin n} V} (#vectors{b}) (indices #first{collision}) (indices #second{collision}) #same{collision})
};
\definition zeroAbove: \forall (f: Form k) -> NatLaws.Lt n k -> f = Forms.origin :=
  \fun (f: Form k)(large: NatLaws.Lt n k) => Coefficients.basisExt k f Forms.origin
    (\fun (indices: Fin.Fin k -> Fin.Fin n) => coefficientZero f large indices);
