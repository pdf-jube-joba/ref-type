\import Fin.Transposition[n := k, a := s.first, b := s.second] \as Swap;
\import \parent.\parent.TwoSlots[k := k, i := s.first, j := s.second] \as Slots;
\definition distinct: \forall (arguments: Arguments k) -> Logic.Not (s.first = s.second) -> transpose s arguments = Slots.swap arguments :=
  \fun (arguments: Arguments k)(different: Logic.Not (s.first = s.second)) => \axiom:funext(transpose s arguments, Slots.swap arguments,
    \fun (i: Fin.Fin k) => Bool.cases2
      (\fun (first, second: Bool.Bool^) => Nat.eqb i s.first = first -> Nat.eqb i s.second = second ->
        arguments (Bool.ite (Fin.Fin k) first s.second (Bool.ite (Fin.Fin k) second s.first i)) =
        Bool.ite V second (arguments s.first) (Bool.ite V first (arguments s.second) (arguments i)))
      (\fun (first: Nat.eqb i s.first = Bool.Bool^::false)(second: Nat.eqb i s.second = Bool.Bool^::false) => \refl(arguments i))
      (\fun (first: Nat.eqb i s.first = Bool.Bool^::false)(second: Nat.eqb i s.second = Bool.Bool^::true) => \refl(arguments s.first))
      (\fun (first: Nat.eqb i s.first = Bool.Bool^::true)(second: Nat.eqb i s.second = Bool.Bool^::false) => \refl(arguments s.second))
      (\fun (first: Nat.eqb i s.first = Bool.Bool^::true)(second: Nat.eqb i s.second = Bool.Bool^::true) =>
        Logic.falseElim (arguments s.second = arguments s.first)
          (different (trans!{{Fin.Fin k}} s.first i s.second
            (sym!{{Fin.Fin k}} i s.first (NatLaws.eqOfEqbTrue s.first i first)) (NatLaws.eqOfEqbTrue s.second i second))))
      (Nat.eqb i s.first) (Nat.eqb i s.second) (\refl(Nat.eqb i s.first)) (\refl(Nat.eqb i s.second)));
\definition repeated: \forall (arguments: Arguments k) -> s.first = s.second -> transpose s arguments = arguments :=
  \fun (arguments: Arguments k)(same: s.first = s.second) => \axiom:funext(transpose s arguments, arguments,
    \fun (i: Fin.Fin k) => Bool.cases2
      (\fun (first, second: Bool.Bool^) => Nat.eqb i s.first = first -> Nat.eqb i s.second = second ->
        arguments (Bool.ite (Fin.Fin k) first s.second (Bool.ite (Fin.Fin k) second s.first i)) = arguments i)
      (\fun (first: _)(second: _) => \refl(arguments i))
      (\fun (first: _)(second: _) => congr!{{Fin.Fin k} V} arguments s.first i
        (trans!{{Fin.Fin k}} s.first s.second i same (sym!{{Fin.Fin k}} i s.second (NatLaws.eqOfEqbTrue s.second i second))))
      (\fun (first: _)(second: _) => congr!{{Fin.Fin k} V} arguments s.second i
        (trans!{{Fin.Fin k}} s.second s.first i (sym!{{Fin.Fin k}} s.first s.second same)
          (sym!{{Fin.Fin k}} i s.first (NatLaws.eqOfEqbTrue s.first i first))))
      (\fun (first: _)(second: _) => congr!{{Fin.Fin k} V} arguments s.second i (sym!{{Fin.Fin k}} i s.second (NatLaws.eqOfEqbTrue s.second i second)))
      (Nat.eqb i s.first) (Nat.eqb i s.second) (\refl(Nat.eqb i s.first)) (\refl(Nat.eqb i s.second)));
\definition law: \forall (f: Form k)(arguments: Arguments k) -> f (transpose s arguments) = multiplier s (f arguments) :=
  \fun (f: Form k)(arguments: Arguments k) => Bool.cases
    (\fun (test: Bool.Bool^) => Nat.eqb s.first s.second = test -> f (transpose s arguments) = Bool.ite K test (f arguments) (neg (f arguments)))
    (\fun (testFalse: Nat.eqb s.first s.second = Bool.Bool^::false) => trans!{K} (f (transpose s arguments)) (f (Slots.swap arguments)) (neg (f arguments))
      (congr!{{Arguments k} K} f (transpose s arguments) (Slots.swap arguments)
        (distinct arguments (\fun (same: s.first = s.second) => BoolLaws.falseNeTrue
          (trans!{{Bool.Bool^}} Bool.Bool^::false (Nat.eqb s.first s.second) Bool.Bool^::true
            (sym!{{Bool.Bool^}} (Nat.eqb s.first s.second) Bool.Bool^::false testFalse) (NatLaws.eqbTrueOfEq s.first s.second same)))))
      (Slots.onSwap f arguments (\fun (same: s.first = s.second) => BoolLaws.falseNeTrue
        (trans!{{Bool.Bool^}} Bool.Bool^::false (Nat.eqb s.first s.second) Bool.Bool^::true
          (sym!{{Bool.Bool^}} (Nat.eqb s.first s.second) Bool.Bool^::false testFalse) (NatLaws.eqbTrueOfEq s.first s.second same)))))
    (\fun (testTrue: Nat.eqb s.first s.second = Bool.Bool^::true) => congr!{{Arguments k} K} f (transpose s arguments) arguments
      (repeated arguments (NatLaws.eqOfEqbTrue s.second s.first testTrue)))
    (Nat.eqb s.first s.second) (\refl(Nat.eqb s.first s.second));
