\structure AlternatingLaws[k: N.Nat^, f: Function k]: \Prop {
  linear: Laws[k, f],
  alternating: \forall (arguments: Arguments k)(i, j: Fin.Fin k) -> Logic.Not (i = j) -> arguments i = arguments j -> f arguments = zero,
}
\definition Form(k: N.Nat^): \Set := \Cast[Function k] ({ f: Function k \where AlternatingLaws[k, f] });
\definition asMultilinear(k: N.Nat^)(f: Form k): MultilinearForm k :=
  \into[Function k](f, { g: Function k \where Laws[k, g] }) \by {
    #linear{(\bysub(Function k, Form k, f))}
  };
\module At(k: N.Nat^);
\module Precomposition(W: \Set, target: VectorSpace W);
\module DegreeZero;
\module TwoSlots(k: N.Nat^, i, j: Fin.Fin k);
\module Contraction(k: N.Nat^);
\definition BasisType(I: \Set): \Set := \parent.\parent.Finite[V := V, I := I, space := space].Basis;
\module Finite(I: \Set, b: BasisType I);
\module Dimension(n: N.Nat^, b: BasisType (Fin.Fin n));
\module Permutations(k: N.Nat^);
\module PermutationRule(k: N.Nat^);
