\import module_theory.Module[].Over[R := K, ring := Ring.commutativeRingAsRing K (Fields.fieldAsCommutativeRing K field)] \as Modules;
\import Modules.Tensor[V := V, W := W, left := left, right := right] \as Shared;
\import \parent.Universal[U := Shared.Carrier, target := Shared.space] \as ForwardUniversal;
\import \parent.\parent.Linear[V := Carrier, W := Shared.Carrier, source := space, target := Shared.space] \as ForwardLinear;
\definition forwardLaws: BilinearLaws[Shared.Carrier, Shared.space, Shared.tensor] := BilinearLaws[Shared.Carrier, Shared.space, Shared.tensor] {
  addLeft := Shared.bilinear.addLeft, addRight := Shared.bilinear.addRight, scaleLeft := Shared.bilinear.scaleLeft, scaleRight := Shared.bilinear.scaleRight,
};
\definition forward: Modules.MapBetween (Modules.Bundle { Carrier := Carrier, space := space }) (Modules.Bundle { Carrier := Shared.Carrier, space := Shared.space }) :=
  ForwardLinear.asModuleMap (ForwardUniversal.map Shared.tensor forwardLaws);
\import Shared.Universal[U := Carrier, target := space] \as BackwardUniversal;
\definition backwardLaws: Shared.BilinearLaws[Carrier, space, tensor] := Shared.BilinearLaws[Carrier, space, tensor] {
  addLeft := bilinear.addLeft, addRight := bilinear.addRight, scaleLeft := bilinear.scaleLeft, scaleRight := bilinear.scaleRight,
};
\definition backward: Modules.MapBetween (Modules.Bundle { Carrier := Shared.Carrier, space := Shared.space }) (Modules.Bundle { Carrier := Carrier, space := space }) :=
  BackwardUniversal.map tensor backwardLaws;
\definition forwardOnTensor: \forall (x: V)(y: W) -> forward.apply (tensor x y) = Shared.tensor x y := ForwardUniversal.onTensor Shared.tensor forwardLaws;
\definition backwardOnTensor: \forall (x: V)(y: W) -> backward.apply (Shared.tensor x y) = tensor x y := BackwardUniversal.onTensor tensor backwardLaws;
\import Modules.Hom[V := Shared.Carrier, W := Carrier, source := Shared.space, target := space].Composition[U := Carrier, domain := space] \as OriginalComposition;
\definition originalComposite: Modules.MapBetween (Modules.Bundle { Carrier := Carrier, space := space }) (Modules.Bundle { Carrier := Carrier, space := space }) := OriginalComposition.compose backward forward;
\import \parent.\parent.Linear[V := Carrier, W := Carrier, source := space, target := space] \as OriginalLinear;
\import Modules.End[V := Carrier, space := space] \as OriginalEnd;
\import \parent.Universal[U := Carrier, target := space] \as OriginalUniversal;
\definition compositeOnTensor: \forall (x: V)(y: W) -> originalComposite.apply (tensor x y) = tensor x y :=
  \fun (x: V)(y: W) => trans!{Carrier} _ _ _
    (congr!{Shared.Carrier Carrier} (backward.apply) _ _ (forwardOnTensor x y)) (backwardOnTensor x y);
\definition originalFunctionIdentity: originalComposite.apply = OriginalEnd.identity.apply := trans!{{Carrier -> Carrier}} _ _ _
  (OriginalUniversal.unique tensor bilinear (OriginalLinear.fromModuleMap originalComposite) compositeOnTensor)
  (sym!{{Carrier -> Carrier}} _ _ (OriginalUniversal.unique tensor bilinear (OriginalLinear.fromModuleMap OriginalEnd.identity)
    (\fun (x: V)(y: W) => \refl(tensor x y))));
\definition leftInverse: \forall (x: Carrier) -> backward.apply (forward.apply x) = x :=
  \fun (x: Carrier) => congr!{{Carrier -> Carrier} Carrier} (\fun (f: Carrier -> Carrier) => f x) _ _ originalFunctionIdentity;
\import Modules.Hom[V := Carrier, W := Shared.Carrier, source := space, target := Shared.space].Composition[U := Shared.Carrier, domain := Shared.space] \as SharedComposition;
\import Modules.End[V := Shared.Carrier, space := Shared.space] \as SharedEnd;
\import Shared.Universal[U := Shared.Carrier, target := Shared.space] \as SharedEquality;
\definition sharedMapIdentity: SharedComposition.compose forward backward = SharedEnd.identity :=
  SharedEquality.ext (SharedComposition.compose forward backward) SharedEnd.identity
    (\fun (x: V)(y: W) => trans!{Shared.Carrier} _ _ _
      (congr!{Carrier Shared.Carrier} (forward.apply) _ _ (backwardOnTensor x y)) (forwardOnTensor x y));
\definition rightInverse: \forall (x: Shared.Carrier) -> forward.apply (backward.apply x) = x :=
  \fun (x: Shared.Carrier) => congr!{{Modules.Hom[V := Shared.Carrier, W := Shared.Carrier, source := Shared.space, target := Shared.space].Map} Shared.Carrier}
    (\fun (f: Modules.Hom[V := Shared.Carrier, W := Shared.Carrier, source := Shared.space, target := Shared.space].Map) => f.apply x) _ _ sharedMapIdentity;
\import Modules.Isomorphism[V := Carrier, W := Shared.Carrier, source := space, target := Shared.space] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism { forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse };
