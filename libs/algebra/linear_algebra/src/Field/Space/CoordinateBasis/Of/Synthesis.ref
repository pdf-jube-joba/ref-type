\definition sum: \forall (xs: Lists.List[Fin.Fin n]) ->
  Finite.vectorSum xs (\fun (i: Fin.Fin n) => space.smul (x i) (iso.backward.apply (Canonical.vectors i))) =
  iso.backward.apply (Target.vectorSum xs (\fun (i: Fin.Fin n) => Coordinates.space.smul (x i) (Canonical.vectors i))) :=
  \induction (xs: Lists.List[Fin.Fin n]) \return
    Finite.vectorSum xs (\fun (i: Fin.Fin n) => space.smul (x i) (iso.backward.apply (Canonical.vectors i))) =
    iso.backward.apply (Target.vectorSum xs (\fun (i: Fin.Fin n) => Coordinates.space.smul (x i) (Canonical.vectors i))) \with {
    | nil: sym!{V} _ _ iso.backward.preservesZero
    | cons: \fun (i: Fin.Fin n)(tail: Lists.List[Fin.Fin n])(previous: _) => trans!{V} _ _ _
      (congr2!{V V V} space.add _ _ _ _ (sym!{V} _ _ (iso.backward.preservesScale (x i) (Canonical.vectors i))) previous)
      (sym!{V} _ _ (iso.backward.preservesAdd (Coordinates.space.smul (x i) (Canonical.vectors i))
        (Target.vectorSum tail (\fun (j: Fin.Fin n) => Coordinates.space.smul (x j) (Canonical.vectors j)))))
  };
