\import Modules.FiniteCoordinates[n := n] \as Small;
\import Small.Split[] \as Split;
\import Modules.FiniteCoordinates[n := N.Nat^::succ n] \as Large;
\import Modules.Of[V := Small.Carrier, space := Small.space].Submodule[] \as SmallSubmodules;
\import Modules.Of[V := Large.Carrier, space := Large.space].Submodule[] \as LargeSubmodules;
\import \parent.Dimension[n := N.Nat^::succ n].Of[S := S] \as Included;
\definition Tail: SmallSubmodules.Submodule := SmallSubmodules.Submodule {
  carrier := { x: Small.Carrier \where LargeSubmodules.Member S (Split.zeroExtend x) },
  zero := \idelim Large.space.zero = Split.zeroExtend Small.space.zero \with x: Large.Carrier => LargeSubmodules.Member S x
    \by { base: S.zero, equality: sym!{Large.Carrier} _ _ Split.zeroZero },
  addition := \fun (x, y: Small.Carrier)(left: _)(right: _) =>
    \idelim Large.space.add (Split.zeroExtend x) (Split.zeroExtend y) = Split.zeroExtend (Small.space.add x y)
      \with z: Large.Carrier => LargeSubmodules.Member S z \by {
        base: S.addition (Split.zeroExtend x) (Split.zeroExtend y) left right,
        equality: sym!{Large.Carrier} _ _ (Split.zeroAddition x y)
      },
  scalar := \fun (a: K)(x: Small.Carrier)(member: _) =>
    \idelim Large.space.smul a (Split.zeroExtend x) = Split.zeroExtend (Small.space.smul a x)
      \with z: Large.Carrier => LargeSubmodules.Member S z \by {
        base: S.scalar a (Split.zeroExtend x) member, equality: sym!{Large.Carrier} _ _ (Split.zeroScalar a x)
      },
};
\import \parent.Dimension[n := n].Of[S := Tail] \as TailSpace;
\definition TailRetraction: \Set := TailSpace.Retraction;
\definition headZero: \Prop := \forall (x: Included.Carrier) -> Split.head x = ring.zero;
\definition Pivot: \Set := \Cast[Included.Carrier] ({ x: Included.Carrier \where Logic.Not (Split.head x = ring.zero) });
\definition headZeroOfNoPivot: Logic.Not (\exists Pivot) -> headZero :=
  \fun (none: Logic.Not (\exists Pivot))(x: Included.Carrier) =>
    either!{{(Classical.excludedMiddle (Split.head x = ring.zero))} {Split.head x = ring.zero}
      {\fun (zero: Split.head x = ring.zero) => zero}
      {\fun (nonzero: Logic.Not (Split.head x = ring.zero)) => Logic.falseElim (Split.head x = ring.zero)
        (none (\exact(\into[Included.Carrier](x, { x: Included.Carrier \where Logic.Not (Split.head x = ring.zero) }) \by { nonzero }, Pivot)))}
    };
\module Selected(r: TailRetraction);
\definition existence: (\forall (T: Submodule n) -> \exists Retraction n T) ->
  \exists Retraction (N.Nat^::succ n) S := \block {
  \fun (previous: \forall (T: Submodule n) -> \exists Retraction n T) \then
  \takefrom r: TailRetraction \by previous Tail \then
  \return Selected[r := r].existence
};
