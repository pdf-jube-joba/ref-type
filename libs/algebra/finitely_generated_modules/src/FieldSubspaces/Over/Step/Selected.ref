\definition splits: TailSpace.Splits r := \bysub(TailSpace.Map, { r: TailSpace.Map \where TailSpace.Splits r }, r);
\import Modules.Hom[V := TailSpace.Carrier, W := Included.Carrier, source := TailSpace.space, target := Included.space] \as Embeddings;
\definition embedding: Embeddings.Map := Embeddings.Map {
  apply := \fun (x: TailSpace.Carrier) => \into[Large.Carrier](Split.zeroExtend x, S.carrier) \by {
    \bysub(Small.Carrier, Tail.carrier, x)
  },
  addition := \fun (x, y: TailSpace.Carrier) => Split.zeroAddition x y,
  scalar := \fun (a: K)(x: TailSpace.Carrier) => Split.zeroScalar a x,
};
\definition recoverZero: \forall (x: Large.Carrier) -> Split.head x = ring.zero -> Split.zeroExtend (Split.tail x) = x :=
  \fun (x: Large.Carrier)(zero: Split.head x = ring.zero) => trans!{Large.Carrier} _ _ _
    (congr!{K Large.Carrier} (\fun (a: K) => Split.cons a (Split.tail x)) ring.zero (Split.head x) (sym!{K} _ _ zero)) (Split.recover x);
\definition tail(x: Included.Carrier)(zero: Split.head x = ring.zero): TailSpace.Carrier :=
  \into[Small.Carrier](Split.tail x, Tail.carrier) \by {
    \idelim x = Split.zeroExtend (Split.tail x) \with y: Large.Carrier => LargeSubmodules.Member S y \by {
      base: \bysub(Large.Carrier, S.carrier, x), equality: sym!{Large.Carrier} _ _ (recoverZero x zero)
    }
  };
\module Zero;
\module Nonzero(pivot: Pivot);
\definition existence: \exists Included.Retraction :=
  either!{{(Classical.excludedMiddle (\exists Pivot))} {\exists Included.Retraction}
    {\block {
      \fun (exists: \exists Pivot) \then
      \takefrom pivot: Pivot \by exists \then
      \return \exact(Nonzero[pivot := pivot].retraction, Included.Retraction)
    }}
    {\fun (none: Logic.Not (\exists Pivot)) => \exact(Zero[].retraction (headZeroOfNoPivot none), Included.Retraction)}
  };
