\import std.Logic[].Proposition[] \as Existential;
\import finitely_generated_modules.IntegerCyclic[d := Arithmetic.mul d k] \as Source;
\import Submodules.Quotient[S := Source.multiples] \as SourceQuotient;
\import SourceQuotient.To[W := Carrier, target := space] \as Descent;
\import I.Math[].Specification[].Prop[].Multiplication[] \as Product;
\definition vanishes: Descent.Vanishes projection := \fun (x: I.Int^)(member: _) =>
  Images.eliminate Source.multiplication x (class x = space.zero)
    (\fun (q: I.Int^)(represented: Arithmetic.mul (Arithmetic.mul d k) q = x) => trans!{Carrier} _ _ _
      (congr!{I.Int^ Carrier} class _ _ (sym!{I.Int^} _ _ represented))
      (trans!{Carrier} _ _ _ (congr!{I.Int^ Carrier} class _ _ (Product.mulAssoc d k q)) (classMultiple (Arithmetic.mul k q)))) member;
\definition map: Modules.Hom[V := Source.Carrier, W := Carrier, source := Source.space, target := space].Map := Descent.descend projection vanishes;
\definition onClass: \forall (x: I.Int^) -> map.apply (Source.class x) = class x := Descent.onClass projection vanishes;
\definition surjective: \forall (q: Carrier) -> \exists { x: Source.Carrier \where map.apply x = q } := \block {
  \fun (q: Carrier) \then
  \takefrom x: \Cast[I.Int^] ({ x: I.Int^ \where class x = q }) \by onto q \then
  \return Existential.existsIntro[Source.Carrier, { y: Source.Carrier \where map.apply y = q }] (Source.class x)
    (trans!{Carrier} _ _ _ (onClass x) (\bysub(I.Int^, { x: I.Int^ \where class x = q }, x)))
};
\module Modulo;
