\import Finite.Tail[n := n, start := rank] \as Indices;
\import Modules.FiniteCoordinates[n := Nat.sub n rank] \as Smaller;
\import Modules.Of[V := Vector, space := domain].Submodule[] \as Submodules;
\import Submodules.Kernel[W := Output, target := codomain] \as Kernels;
\definition submodule: Submodules.Submodule := Kernels.kernel (Base.linear (reflect a));
\import Submodules.Of[S := submodule] \as Included;
\definition Carrier: \Set := Included.Carrier;
\definition space: Modules.Space Carrier := Included.moduleSpace;
\import Tail.Laws[] \as ExtensionLaws;
\definition extension(v: Smaller.Carrier)(laws: Laws[a]): Carrier := \into[Vector](Tail.extension v, #carrier{submodule}) \by {
  earlyToKernel a (Tail.extension v) #columnRank{laws} #diagonal{laws} #trailing{laws}
    (\fun (i: Finite.Fin n)(early: _) => Tail.atEarly v i early)
};
\import Modules.Hom[V := Smaller.Carrier, W := Carrier, source := Smaller.space, target := space] \as Extensions;
\definition forward(laws: Laws[a]): Extensions.Map := Extensions.Map {
  apply := \fun (v: Smaller.Carrier) => extension v laws,
  addition := ExtensionLaws.extensionAddition,
  scalar := ExtensionLaws.extensionScalar,
};
\import Modules.Hom[V := Carrier, W := Smaller.Carrier, source := space, target := Smaller.space] \as Restrictions;
\definition backward(within: Bounds.Le rank n): Restrictions.Map := Restrictions.Map {
  apply := \fun (v: Carrier) => Tail.restriction within v,
  addition := \fun (v, w: Carrier) => \axiom:funext(Tail.restriction within (#add{space} v w), #add{Smaller.space} (Tail.restriction within v) (Tail.restriction within w),
    \fun (i: Smaller.Index) => \refl(Arithmetic.add (v (Indices.include within i)) (w (Indices.include within i)))),
  scalar := \fun (c: I.Int^)(v: Carrier) => \axiom:funext(Tail.restriction within (#smul{space} c v), #smul{Smaller.space} c (Tail.restriction within v),
    \fun (i: Smaller.Index) => \refl(Arithmetic.mul c (v (Indices.include within i)))),
};
\import Modules.Isomorphism[V := Smaller.Carrier, W := Carrier, source := Smaller.space, target := space] \as Iso;
\definition isoData(laws: Laws[a]): Iso.Data := Iso.Data { forward := forward laws, backward := backward #columnRank{laws} };
\definition isoLaws: \forall (laws: Laws[a]) -> Iso.Laws[isoData laws] :=
  \fun (laws: Laws[a]) => Iso.Laws[isoData laws] {
    leftInverse := Tail.restrictionExtension #columnRank{laws},
    rightInverse := \fun (v: Carrier) => Tail.recover #columnRank{laws} v
      (kernelToEarly a v #rowRank{laws} #diagonal{laws} #nonzero{laws} (\bysub(Vector, #carrier{submodule}, v))),
  };
\definition isomorphism(laws: Laws[a]): Iso.Isomorphism := \into[Iso.Data](isoData laws, { data: Iso.Data \where Iso.Laws[data] }) \by { isoLaws laws };
