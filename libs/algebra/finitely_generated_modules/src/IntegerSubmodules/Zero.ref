\import \parent.Dimension[n := N.Nat^::zero] \as Dimension;
\import N.Basic[].Prop[] \as Bounds;
\definition vectorZero: \forall (v: Dimension.Vector) -> v = Dimension.space.zero :=
  \fun (v: Dimension.Vector) => \axiom:funext(v, Dimension.space.zero,
    \fun (i: Finite.Fin N.Nat^::zero) => Logic.falseElim _ (Finite.zeroImpossible i (Finite.bound N.Nat^::zero i)));
\module On(S: Dimension.Submodule) {
  \import Dimension.Of[S := S] \as Inside;
  \import Modules.Hom[V := Dimension.Vector, W := Inside.Carrier, source := Dimension.space, target := Inside.moduleSpace] \as Maps;
  \definition map: Maps.Map := Maps.zeroMap;
  \definition onto: Inside.Onto map := \fun (y: Inside.Carrier) => Logic.existsIntro[Dimension.Vector, { x: Dimension.Vector \where map.apply x = y }] (Dimension.space.zero)
    (sym!{Dimension.Vector} _ _ (vectorZero y));
  \definition existence: Inside.Generated := \exact(\into[Inside.Map](map, { f: Inside.Map \where Inside.Onto f }) \by { onto }, Inside.Generator);
}
\definition existence: \forall (S: Dimension.Submodule) -> Dimension.Generated S := \fun (S: Dimension.Submodule) => On[S := S].existence;
