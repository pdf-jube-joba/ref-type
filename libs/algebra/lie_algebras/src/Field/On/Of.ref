\definition Carrier: \Set := \Cast[V] subalgebra.subspace.carrier;
\import Subspaces.Of[subspace := subalgebra.subspace] \as Subspace;
\definition vectorSpace: Linear.VectorSpace Carrier := Subspace.induced;
\definition product[x, y: Carrier]: Carrier := \into[V](bracket x y, subalgebra.subspace.carrier) \by {
  subalgebra.closedBracket x y (\bysub(V, subalgebra.subspace.carrier, x)) (\bysub(V, subalgebra.subspace.carrier, y))
};
\definition algebra: LieAlgebra Carrier vectorSpace := LieAlgebra[Carrier, vectorSpace] {
  bracket := product,
  addLeft := \fun (x, y, z: Carrier) => lie.addLeft x y z,
  addRight := \fun (x, y, z: Carrier) => lie.addRight x y z,
  scaleLeft := \fun (a: K)(x, y: Carrier) => lie.scaleLeft a x y,
  scaleRight := \fun (a: K)(x, y: Carrier) => lie.scaleRight a x y,
  alternating := \fun (x: Carrier) => lie.alternating x,
  jacobi := \fun (x, y, z: Carrier) => lie.jacobi x y z,
};
