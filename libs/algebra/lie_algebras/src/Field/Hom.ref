\import Linear.Linear[V := V, W := W, source := source, target := target] \as Maps;
\definition PreservesBracket[f: Maps.Map]: \Prop :=
  \forall (x, y: V) -> f.apply (left.bracket x y) = right.bracket (f.apply x) (f.apply y);
\definition Map: \Set := \Cast[Maps.Map] ({ f: Maps.Map \where PreservesBracket f });
\definition bracket: \forall (f: Map)(x, y: V) -> f.apply (left.bracket x y) = right.bracket (f.apply x) (f.apply y) :=
  \fun (f: Map) => \bysub(Maps.Map, { f: Maps.Map \where PreservesBracket f }, f);
