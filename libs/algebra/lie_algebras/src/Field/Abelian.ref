\import Linear.Laws[V := V, space := space] \as Vectors;
\definition lie: LieAlgebra V space := LieAlgebra[V, space] {
  bracket := \fun (x, y: V) => space.zero,
  addLeft := \fun (x, y, z: V) => sym!{V} _ _ (Vectors.zeroLeft space.zero),
  addRight := \fun (x, y, z: V) => sym!{V} _ _ (Vectors.zeroLeft space.zero),
  scaleLeft := \fun (a: K)(x, y: V) => sym!{V} _ _ (Vectors.scaleZero a),
  scaleRight := \fun (a: K)(x, y: V) => sym!{V} _ _ (Vectors.scaleZero a),
  alternating := \fun (x: V) => \refl(space.zero),
  jacobi := \fun (x, y, z: V) => sym!{V} _ _ (Vectors.zeroLeft space.zero),
};
