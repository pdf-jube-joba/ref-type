
\import std.Data[].Bool[] \as B;
\definition filter: Lists.List[A] -> Lists.List[A] := \induction (xs: Lists.List[A]) \return Lists.List[A] \with {
  | nil: Lists.List[A]::nil
  | cons: \fun (x: A)(tail: Lists.List[A])(previous: Lists.List[A]) => B.ite (Lists.List[A]) (test x) (Lists.List[A]::cons x previous) previous
};
\module Mapping(D: \Set, f: A -> D, targetTest: D -> B.Bool^);
