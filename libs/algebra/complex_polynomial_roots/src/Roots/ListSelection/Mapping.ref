
\import \root.Roots[].ListSelection[A := D, test := targetTest] \as Target;
\definition map: (\forall (x: A) -> targetTest (f x) = test x) -> \forall (xs: Lists.List[A]) ->
  Target.filter (Lists.map A D f xs) = Lists.map A D f (filter xs) :=
  \fun (compatible: _) => \induction (xs: Lists.List[A]) \return Target.filter (Lists.map A D f xs) = Lists.map A D f (filter xs) \with {
    | nil: \refl(Lists.List[D]::nil)
    | cons: \fun (x: A)(tail: Lists.List[A])(previous: _) => trans!{{Lists.List[D]}} _ _ _
      (congr!{B.Bool^ {Lists.List[D]}} (\fun (b: B.Bool^) => B.ite (Lists.List[D]) b (Lists.List[D]::cons (f x) (Target.filter (Lists.map A D f tail))) (Target.filter (Lists.map A D f tail))) _ _ (compatible x))
      ((\induction (b: B.Bool^) \return B.ite (Lists.List[D]) b (Lists.List[D]::cons (f x) (Target.filter (Lists.map A D f tail))) (Target.filter (Lists.map A D f tail)) =
        Lists.map A D f (B.ite (Lists.List[A]) b (Lists.List[A]::cons x (filter tail)) (filter tail)) \with {
          | false: previous
          | true: congr!{{Lists.List[D]} {Lists.List[D]}} (Lists.List[D]::cons (f x)) _ _ previous
        }) (test x))
  };
