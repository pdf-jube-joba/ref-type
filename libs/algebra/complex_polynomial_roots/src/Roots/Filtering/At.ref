
\import \root.Roots[].At[n := n] \as Roots;
\import Roots.Topological[] \as Topological;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin n] \as Coordinates;
\import topology.Topology[Carrier := Vector n] \as Space;
\import Fin.FromList[A := Fin.Fin n] \as IndexTuples;
\import IndexTuples.Mapping[B := C.Complex] \as IndexMapping;
\import Lists.Mapping[A := Fin.Fin n, B := C.Complex].Prop[] \as Mapping;
\definition indices: Lists.List[Fin.Fin n] := IndexTuples.list n (\fun (i: Fin.Fin n) => i);
\definition indexed: \forall (a: Vector n) -> Tuples.list n a = Lists.map (Fin.Fin n) C.Complex a indices := \fun (a: Vector n) => trans!{Coefficients} _ _ _
  (congr!{{Vector n} Coefficients} (Tuples.list n) a (\fun (i: Fin.Fin n) => a i) (\axiom:funext(a, (\fun (i: Fin.Fin n) => a i), \fun (i: Fin.Fin n) => \refl(a i))))
  (IndexMapping.listMap n a (\fun (i: Fin.Fin n) => i));
\module Around(a: Vector n);
\module Regions(U, V: \Pow C.Complex);
