\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import std.Data[].List[] \as Lists;
\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Basic[].Prop[] \as Nat;
\import std.Data[].Nat[].Basic[].Def[] \as NatOp;
\import std.Alg[].Ring[] \as Rings;
\import complex.Complex[] \as C;
\import C.Def[] \as Op;
\import C.Prop[] \as Complex;
\import C.Algebra[] \as ComplexAlgebra;
\import C.Absolute[] \as Absolute;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[] \as Estimates;
\import Real.Distance[] \as Distance;
\import Real.SquareRoot[] \as SquareRoot;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import algebra.Group[].Of[Carrier := C.Complex, group := ComplexAlgebra.additiveGroup] \as Sum;
\import algebra.Group[].Of[Carrier := Real.Real, group := Rings.additiveGroup Real.Real (Rings.commutativeRingAsRing Real.Real (std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field))] \as RealSum;
\import galois.Field[].Over[K := C.Complex, field := ComplexAlgebra.field] \as Field;
\import Field.Arithmetic[] \as Arithmetic;
\import Field.Polynomial[] \as Monic;
\import Monic.Raw[] \as Raw;
\import Monic.AbstractEvaluation[] \as Evaluation;
\import algebra.Polynomial[].Over[R := C.Complex, coefficients := std.Alg[].Field[].fieldAsCommutativeRing C.Complex ComplexAlgebra.field] \as Polynomial;
\definition Coefficients: \Set := Monic.Coefficients;

\import fundamental_algebra.Complex[] \as Fundamental;
\import Fundamental.Factorization[] \as Factorization;
\import Factorization.Families[] \as Families;
\import Factorization.Cancellation[] \as Cancellation;
\import Monic.RootProduct[] \as RootProduct;
\import Monic.Splitting[] \as Splitting;
\import Fundamental.Bounds[] \as Bounds;
\import std.Data[].FinSet[] \as Fin;
\import Fin.FromList[A := C.Complex] \as Tuples;
\import Fin.Tuples[A := C.Complex] \as Extend;
\import topological_algebra.Complex[] \as Plane;
\import topology.Topology[Carrier := C.Complex] \as Scalars;
\import topological_algebra.FinitePower[K := C.Complex] \as Powers;
\definition Vector[n: N.Nat^]: \Set := Fin.Fin n -> C.Complex;
\definition polynomial[n: N.Nat^][p: Vector n]: Polynomial.Carrier := Monic.asPolynomial (Tuples.list n p);
\definition product[n: N.Nat^][p: Vector n]: Polynomial.Carrier := Monic.factors (Tuples.list n p);
\module MonicCoordinates;
\module SymmetricCoefficients;
\module FiniteTopology(n: N.Nat^);
\module Selection;
\module ListSelection(A: \Set, test: A -> std.Data[].Bool[].Bool^);
\module Filtering(test: C.Complex -> std.Data[].Bool[].Bool^);
\module At(n: N.Nat^);

\module Separated(U, V: \Pow C.Complex);
\module Examples;
