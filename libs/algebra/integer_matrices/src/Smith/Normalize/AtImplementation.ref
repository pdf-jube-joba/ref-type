\definition T: \VType := \U(N.Nat -> Runtime -> History -> Attempt);
\definition program: T := \thunk (\cfun (k: N.Nat) => \return(\thunk (\cfun (a: Runtime) => \return(\thunk (\cfun (history: History) => \program {
  \bind row: \U(N.Nat -> I.Int) <- (\force a) k \then
  \bind pivot: I.Int <- (\force row) k \then
  \bind matrix: \U(Runtime -> History -> I.Int -> Attempt) <- (\force selectionProgram) k \then
  \bind histories: \U(History -> I.Int -> Attempt) <- (\force matrix) a \then
  \bind choose: \U(I.Int -> Attempt) <- (\force histories) history \then
  \bind result: Attempt <- (\force choose) pivot \then
  \return result
})))));
\definition matches: \forall (k: N.Nat^)(a: Runtime^)(history: History^) -> program^ k a history = at k a history :=
  \fun (k: N.Nat^)(a: Runtime^)(history: History^) =>
    congr!{Selection.T^ Attempt^} (\fun (f: Selection.T^) => f k a history (a k k)) selectionProgram^ select Selection.coherence;
\definition coherence: program^ = at := \axiom:funext(program^, at,
  \fun (k: N.Nat^) => \axiom:funext(program^ k, at k,
    \fun (a: Runtime^) => \axiom:funext(program^ k a, at k a, matches k a)));
