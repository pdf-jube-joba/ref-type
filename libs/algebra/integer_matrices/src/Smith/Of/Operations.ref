\import N.Basic[].Prop[] \as NaturalBounds;
\definition existence: \forall (operation: Operation^) -> Indices.OperationLaws m n operation -> \exists OperationFrame operation :=
  \induction (operation: Operation^) \return Indices.OperationLaws m n operation -> \exists OperationFrame operation \with {
    | identity: \fun (laws: Logic.True) => \exact(\into[Frame](identity, { frame: Frame \where Action Operation^::identity frame }) \by {
        \fun (a: Runtime^) => identityLaw (Matrices.reflect a)
      }, OperationFrame Operation^::identity)
    | rowSwap: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(laws: Indices.PairBounds[m, r, s]) \then
      \let first: Finite.Fin m := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #first{laws} } \then
      \let second: Finite.Fin m := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.RowFrames[r := first, s := second].exchange), { frame: Frame \where Action (Operation^::rowSwap r s) frame }) \by { \parent.RowFrames[r := first, s := second].exchangeLaw }, OperationFrame (Operation^::rowSwap r s))
    }
    | rowAdd: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^)(laws: Indices.ShearBounds[m, r, s]) \then
      \let first: Finite.Fin m := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #first{laws} } \then
      \let second: Finite.Fin m := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.RowFrames[r := first, s := second].addition c #distinct{laws}), { frame: Frame \where Action (Operation^::rowAdd r s c) frame }) \by { \parent.RowFrames[r := first, s := second].additionLaw c #distinct{laws} }, OperationFrame (Operation^::rowAdd r s c))
    }
    | rowNegate: \block {
      \fun (r: N.Nat^)(laws: NaturalBounds.Lt r m) \then
      \let first: Finite.Fin m := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { laws } \then
      \return \exact(\into[Frame]((\parent.RowFrames[r := first, s := first].negative), { frame: Frame \where Action (Operation^::rowNegate r) frame }) \by { \parent.RowFrames[r := first, s := first].negativeLaw }, OperationFrame (Operation^::rowNegate r))
    }
    | columnSwap: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(laws: Indices.PairBounds[n, r, s]) \then
      \let first: Finite.Fin n := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #first{laws} } \then
      \let second: Finite.Fin n := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.ColumnFrames[r := first, s := second].exchange), { frame: Frame \where Action (Operation^::columnSwap r s) frame }) \by { \parent.ColumnFrames[r := first, s := second].exchangeLaw }, OperationFrame (Operation^::columnSwap r s))
    }
    | columnAdd: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^)(laws: Indices.ShearBounds[n, r, s]) \then
      \let first: Finite.Fin n := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #first{laws} } \then
      \let second: Finite.Fin n := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.ColumnFrames[r := first, s := second].addition c #distinct{laws}), { frame: Frame \where Action (Operation^::columnAdd r s c) frame }) \by { \parent.ColumnFrames[r := first, s := second].additionLaw c #distinct{laws} }, OperationFrame (Operation^::columnAdd r s c))
    }
    | columnNegate: \block {
      \fun (r: N.Nat^)(laws: NaturalBounds.Lt r n) \then
      \let first: Finite.Fin n := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { laws } \then
      \return \exact(\into[Frame]((\parent.ColumnFrames[r := first, s := first].negative), { frame: Frame \where Action (Operation^::columnNegate r) frame }) \by { \parent.ColumnFrames[r := first, s := first].negativeLaw }, OperationFrame (Operation^::columnNegate r))
    }
  };
