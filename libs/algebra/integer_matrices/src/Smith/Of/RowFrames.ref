\use std.Logic[].Equality[].eq_reason_in;
\import LeftElementary.Swap[i := r, j := s] \as Exchange;
\import LeftElementary.Shear[i := r, j := s] \as Shear;
\import LeftElementary.Negate[i := r] \as Negative;
\import Matrices.RowOperations[].Typed[r := r, s := s] \as Typed;
\import Matrices.RowOperations[] \as Operations;
\definition exchange: Frame := Frame {
  left := Exchange.matrix, right := RightEnd.identity, leftInverse := Exchange.certificate, rightInverse := rightIdentityInverse,
};
\definition exchangeLaw: Action (Operation^::rowSwap r s) (exchange) :=
  \fun (a: Runtime^) => eq_reason_in!{Base.Matrix { change (exchange) (Matrices.reflect a) }
    "=" { Typed.swapped a } "by" { Base.End[].rightIdentity (Typed.swapped a) }
    "=" { Matrices.reflect (Operations.Swap.program^ a r s) } "by" { Typed.swapLaw a }
    "=" { Matrices.reflect (apply (Operation^::rowSwap r s) a) } "by" { congr!{Operations.Swap.T^ Base.Matrix} (\fun (f: Operations.Swap.T^) => Matrices.reflect (f a r s)) Operations.Swap.program^ Operations.swap Operations.Swap.coherence }
  };
\definition addition[c: I.Int^][distinct: Logic.Not (r = s)]: Frame := Frame {
  left := Shear.matrix c, right := RightEnd.identity, leftInverse := Shear.certificate c distinct, rightInverse := rightIdentityInverse,
};
\definition additionLaw: \forall (c: I.Int^)(distinct: Logic.Not (r = s)) -> Action (Operation^::rowAdd r s c) (addition c distinct) :=
  \fun (c: I.Int^)(distinct: Logic.Not (r = s)) => \fun (a: Runtime^) => eq_reason_in!{Base.Matrix { change (addition c distinct) (Matrices.reflect a) }
    "=" { Typed.added a c } "by" { Base.End[].rightIdentity (Typed.added a c) }
    "=" { Matrices.reflect (Operations.Add.program^ a r s c) } "by" { Typed.addLaw a c }
    "=" { Matrices.reflect (apply (Operation^::rowAdd r s c) a) } "by" { congr!{Operations.Add.T^ Base.Matrix} (\fun (f: Operations.Add.T^) => Matrices.reflect (f a r s c)) Operations.Add.program^ Operations.add Operations.Add.coherence }
  };
\definition negative: Frame := Frame {
  left := Negative.matrix, right := RightEnd.identity, leftInverse := Negative.certificate, rightInverse := rightIdentityInverse,
};
\definition negativeLaw: Action (Operation^::rowNegate r) (negative) :=
  \fun (a: Runtime^) => eq_reason_in!{Base.Matrix { change (negative) (Matrices.reflect a) }
    "=" { Typed.negated a } "by" { Base.End[].rightIdentity (Typed.negated a) }
    "=" { Matrices.reflect (Operations.Negate.program^ a r) } "by" { Typed.negateLaw a }
    "=" { Matrices.reflect (apply (Operation^::rowNegate r) a) } "by" { congr!{Operations.Negate.T^ Base.Matrix} (\fun (f: Operations.Negate.T^) => Matrices.reflect (f a r)) Operations.Negate.program^ Operations.negate Operations.Negate.coherence }
  };
