\import N.Basic[].Prop[] \as NaturalBounds;
\definition existence: \forall (operation: Operation^) -> Indices.OperationLaws m n operation -> \exists OperationFrame operation :=
  \induction (operation: Operation^) \return Indices.OperationLaws m n operation -> \exists OperationFrame operation \with {
    | identity: \fun (laws: Logic.True) => \exact(\into[Frame](identity, { frame: Frame \where OperationLaws[Operation^::identity, frame] }) \by {
        OperationLaws[Operation^::identity, identity] {
        action := \fun (a: Runtime^) => identityLaw (Matrices.reflect a),
        representation := identityMatches,
      }
      }, OperationFrame Operation^::identity)
    | rowSwap: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(laws: Indices.PairBounds[m, r, s]) \then
      \let first: Finite.Fin m := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #first{laws} } \then
      \let second: Finite.Fin m := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.\parent.RowFrames[r := first, s := second].exchange), { frame: Frame \where OperationLaws[Operation^::rowSwap r s, frame] }) \by { OperationLaws[Operation^::rowSwap r s, (\parent.\parent.RowFrames[r := first, s := second].exchange)] { action := \parent.\parent.RowFrames[r := first, s := second].exchangeLaw, representation := \parent.Row[r := first, s := second].swapMatches } }, OperationFrame (Operation^::rowSwap r s))
    }
    | rowAdd: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^)(laws: Indices.ShearBounds[m, r, s]) \then
      \let first: Finite.Fin m := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #first{laws} } \then
      \let second: Finite.Fin m := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.\parent.RowFrames[r := first, s := second].addition c #distinct{laws}), { frame: Frame \where OperationLaws[Operation^::rowAdd r s c, frame] }) \by { OperationLaws[Operation^::rowAdd r s c, (\parent.\parent.RowFrames[r := first, s := second].addition c #distinct{laws})] { action := \parent.\parent.RowFrames[r := first, s := second].additionLaw c #distinct{laws}, representation := \parent.Row[r := first, s := second].addMatches c #distinct{laws} } }, OperationFrame (Operation^::rowAdd r s c))
    }
    | rowNegate: \block {
      \fun (r: N.Nat^)(laws: NaturalBounds.Lt r m) \then
      \let first: Finite.Fin m := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index m }) \by { laws } \then
      \return \exact(\into[Frame]((\parent.\parent.RowFrames[r := first, s := first].negative), { frame: Frame \where OperationLaws[Operation^::rowNegate r, frame] }) \by { OperationLaws[Operation^::rowNegate r, (\parent.\parent.RowFrames[r := first, s := first].negative)] { action := \parent.\parent.RowFrames[r := first, s := first].negativeLaw, representation := \parent.Row[r := first, s := first].negateMatches } }, OperationFrame (Operation^::rowNegate r))
    }
    | columnSwap: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(laws: Indices.PairBounds[n, r, s]) \then
      \let first: Finite.Fin n := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #first{laws} } \then
      \let second: Finite.Fin n := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.\parent.ColumnFrames[r := first, s := second].exchange), { frame: Frame \where OperationLaws[Operation^::columnSwap r s, frame] }) \by { OperationLaws[Operation^::columnSwap r s, (\parent.\parent.ColumnFrames[r := first, s := second].exchange)] { action := \parent.\parent.ColumnFrames[r := first, s := second].exchangeLaw, representation := \parent.Column[r := first, s := second].swapMatches } }, OperationFrame (Operation^::columnSwap r s))
    }
    | columnAdd: \block {
      \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^)(laws: Indices.ShearBounds[n, r, s]) \then
      \let first: Finite.Fin n := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #first{laws} } \then
      \let second: Finite.Fin n := \into[N.Nat^](s, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { #second{laws} } \then
      \return \exact(\into[Frame]((\parent.\parent.ColumnFrames[r := first, s := second].addition c #distinct{laws}), { frame: Frame \where OperationLaws[Operation^::columnAdd r s c, frame] }) \by { OperationLaws[Operation^::columnAdd r s c, (\parent.\parent.ColumnFrames[r := first, s := second].addition c #distinct{laws})] { action := \parent.\parent.ColumnFrames[r := first, s := second].additionLaw c #distinct{laws}, representation := \parent.Column[r := first, s := second].addMatches c #distinct{laws} } }, OperationFrame (Operation^::columnAdd r s c))
    }
    | columnNegate: \block {
      \fun (r: N.Nat^)(laws: NaturalBounds.Lt r n) \then
      \let first: Finite.Fin n := \into[N.Nat^](r, { index: N.Nat^ \where NaturalBounds.Lt index n }) \by { laws } \then
      \return \exact(\into[Frame]((\parent.\parent.ColumnFrames[r := first, s := first].negative), { frame: Frame \where OperationLaws[Operation^::columnNegate r, frame] }) \by { OperationLaws[Operation^::columnNegate r, (\parent.\parent.ColumnFrames[r := first, s := first].negative)] { action := \parent.\parent.ColumnFrames[r := first, s := first].negativeLaw, representation := \parent.Column[r := first, s := first].negateMatches } }, OperationFrame (Operation^::columnNegate r))
    }
  };
