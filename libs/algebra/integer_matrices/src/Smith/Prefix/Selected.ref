\definition atIndex: \forall (index: N.Nat^)(divisor: I.Int^) ->
  Bounds.Lt k m -> Bounds.Lt k n -> Bounds.Lt index k -> Stage[index, divisor, a] ->
  Pivot.prepare m n k a history = Pivot.Selection^::ready current -> Stage[index, divisor, attemptMatrix current] :=
  \fun (index: N.Nat^)(divisor: I.Int^)(rowBound: _)(columnBound: _)(before: _)(law: _)(selected: _) =>
    \idelim Pivot.prepare m n k a history = Pivot.Selection^::ready current \with selection: Pivot.Selection^ =>
      \parent.Protected[index := index, divisor := divisor].SelectionProperty selection \by {
        base: \parent.Protected[index := index, divisor := divisor].prepared k a history rowBound columnBound before law, equality: selected
      };
\definition law: Bounds.Lt k m -> Bounds.Lt k n -> Holds k a -> Pivot.prepare m n k a history = Pivot.Selection^::ready current -> Holds k (attemptMatrix current) :=
  \fun (rowBound: _)(columnBound: _)(previous: _)(selected: _) =>
    preserve k a (attemptMatrix current) (\fun (index: N.Nat^)(divisor: I.Int^)(before: _)(law: _) => atIndex index divisor rowBound columnBound before law selected) previous;
