\definition leftInverseLaws: \forall (witness: Frames.Frame) -> Representation.Matches[witness, frame value] -> LeftInverse.Laws[LeftMatrices.reflect (left value), leftInverseData value] :=
  \fun (witness: Frames.Frame)(law: Representation.Matches[witness, frame value]) => LeftInverse.Laws[LeftMatrices.reflect (left value), leftInverseData value] {
    leftInverse := trans!{Left.Matrix} (LeftProduct.product (LeftMatrices.reflect (leftInverse value)) (LeftMatrices.reflect (left value))) (LeftProduct.product (witness.leftInverse.inverse) (witness.left)) LeftIdentity.identity
      (congr2!{Left.Matrix Left.Matrix Left.Matrix} LeftProduct.product (LeftMatrices.reflect (leftInverse value)) (witness.leftInverse.inverse) (LeftMatrices.reflect (left value)) (witness.left) law.leftInverse law.left)
      (\bysub(LeftInverse.Data, { data: LeftInverse.Data \where LeftInverse.Laws[witness.left, data] }, witness.leftInverse)).leftInverse,
    rightInverse := trans!{Left.Matrix} (LeftProduct.product (LeftMatrices.reflect (left value)) (LeftMatrices.reflect (leftInverse value))) (LeftProduct.product (witness.left) (witness.leftInverse.inverse)) LeftIdentity.identity
      (congr2!{Left.Matrix Left.Matrix Left.Matrix} LeftProduct.product (LeftMatrices.reflect (left value)) (witness.left) (LeftMatrices.reflect (leftInverse value)) (witness.leftInverse.inverse) law.left law.leftInverse)
      (\bysub(LeftInverse.Data, { data: LeftInverse.Data \where LeftInverse.Laws[witness.left, data] }, witness.leftInverse)).rightInverse,
  };
\definition rightInverseLaws: \forall (witness: Frames.Frame) -> Representation.Matches[witness, frame value] -> RightInverse.Laws[RightMatrices.reflect (right value), rightInverseData value] :=
  \fun (witness: Frames.Frame)(law: Representation.Matches[witness, frame value]) => RightInverse.Laws[RightMatrices.reflect (right value), rightInverseData value] {
    leftInverse := trans!{Right.Matrix} (RightProduct.product (RightMatrices.reflect (rightInverse value)) (RightMatrices.reflect (right value))) (RightProduct.product (witness.rightInverse.inverse) (witness.right)) RightIdentity.identity
      (congr2!{Right.Matrix Right.Matrix Right.Matrix} RightProduct.product (RightMatrices.reflect (rightInverse value)) (witness.rightInverse.inverse) (RightMatrices.reflect (right value)) (witness.right) law.rightInverse law.right)
      (\bysub(RightInverse.Data, { data: RightInverse.Data \where RightInverse.Laws[witness.right, data] }, witness.rightInverse)).leftInverse,
    rightInverse := trans!{Right.Matrix} (RightProduct.product (RightMatrices.reflect (right value)) (RightMatrices.reflect (rightInverse value))) (RightProduct.product (witness.right) (witness.rightInverse.inverse)) RightIdentity.identity
      (congr2!{Right.Matrix Right.Matrix Right.Matrix} RightProduct.product (RightMatrices.reflect (right value)) (witness.right) (RightMatrices.reflect (rightInverse value)) (witness.rightInverse.inverse) law.right law.rightInverse)
      (\bysub(RightInverse.Data, { data: RightInverse.Data \where RightInverse.Laws[witness.right, data] }, witness.rightInverse)).rightInverse,
  };
\definition change: \forall (witness: Frames.Frame) -> Representation.Matches[witness, frame value] ->
  ActRight.product (ActLeft.product (LeftMatrices.reflect (left value)) (Matrices.reflect original)) (RightMatrices.reflect (right value)) = Frames.change witness (Matrices.reflect original) :=
  \fun (witness: Frames.Frame)(law: Representation.Matches[witness, frame value]) =>
    congr2!{Matrices.Matrix Right.Matrix Matrices.Matrix} ActRight.product
      _ _ _ _
      (congr!{Left.Matrix Matrices.Matrix} (\fun (matrix: Left.Matrix) => ActLeft.product matrix (Matrices.reflect original)) (LeftMatrices.reflect (left value)) witness.left law.left) law.right;
