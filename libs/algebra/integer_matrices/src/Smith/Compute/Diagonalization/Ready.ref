\definition output: Attempt^ := Round.round m n k (attemptMatrix current) (attemptHistory current);
\definition final: Pivot.Ready[m, n, k, a, history, current] -> attemptReduced output = B.Bool^::false -> Prefix.FinalAt[k, attemptMatrix output] :=
  \fun (prepared: Pivot.Ready[m, n, k, a, history, current])(unchanged: _) => Prefix.FinalAt[k, attemptMatrix output] {
    nonzero := Round.nonzero m n k (attemptMatrix current) (attemptHistory current) prepared.nonzero,
    row := ((Round.complete m n k (attemptMatrix current) (attemptHistory current) unchanged).settled).row,
    column := ((Round.complete m n k (attemptMatrix current) (attemptHistory current) unchanged).settled).column,
    divides := (Round.complete m n k (attemptMatrix current) (attemptHistory current) unchanged).divides,
  };
\definition law: Bounds.Lt k m -> Bounds.Lt k n -> StateLaw[k, a, history] -> Pivot.Ready[m, n, k, a, history, current] ->
  Pivot.prepare m n k a history = Pivot.Selection^::ready current -> Results.Post (selected m n k a history (Pivot.Selection^::ready current)) :=
  \fun (rowBound: _)(columnBound: _)(law: StateLaw[k, a, history])(prepared: Pivot.Ready[m, n, k, a, history, current])(selected: _) =>
    after k output rowBound columnBound
      (Round.bounded m n k (attemptMatrix current) (attemptHistory current) rowBound columnBound (prepared.bounded (law.computation).bounded))
      (Round.traced m n k original (attemptMatrix current) (attemptHistory current) (prepared.traced original (law.computation).traced))
      (Prefix.round k (attemptMatrix current) (attemptHistory current) rowBound columnBound (Prefix.readyPreserves k a history current rowBound columnBound law.prefix selected))
      (final prepared);
