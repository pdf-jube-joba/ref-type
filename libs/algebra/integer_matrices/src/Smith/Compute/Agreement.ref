\definition transport: \forall (transition: Step.T^) -> step = transition -> \forall (proof: Programs.Terminates State^ Output^ transition state) ->
  \run[State^, Output^](transition, state) \by { proof } = execute state :=
  \fun (transition: Step.T^)(equal: step = transition) => \idelim step = transition \with action: Step.T^ =>
    \forall (proof: Programs.Terminates State^ Output^ action state) -> \run[State^, Output^](action, state) \by { proof } = execute state \by {
    base: \fun (proof: Programs.Terminates State^ Output^ step state) => \refl(execute state), equality: equal
  };
\definition law: Evaluate.run^ state = execute state := transport Step.program^ (sym!{Step.T^} Step.program^ step Step.coherence) (certificate state);
