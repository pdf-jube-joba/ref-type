\import N.Basic[].Program[] \as NatPrograms;
\import N.Basic[].ProgramProp[] \as NatCorrespondence;
\definition T: \VType := \U(N.Nat -> Runtime -> N.Nat -> N.Nat -> B.Bool);
\definition program: T := \thunk (\cfun (k: N.Nat) => \return(\thunk (\cfun (a: Runtime) => \return(\thunk (\cfun (i: N.Nat) => \return(\thunk (\cfun (j: N.Nat) => \program {
  \bind lowerBound: \U(N.Nat -> B.Bool) <- (\force NatPrograms.leb) k \then
  \bind rowHit: B.Bool <- (\force lowerBound) i \then
  \bind columnHit: B.Bool <- (\force lowerBound) j \then
  \bind row: \U(N.Nat -> I.Int) <- (\force a) i \then
  \bind value: I.Int <- (\force row) j \then
  \bind zero: B.Bool <- (\force I.IsZero.program) value \then
  \bind nonzero: B.Bool <- (\force B.Neg.program) zero \then
  \bind columnAnd: \U(B.Bool -> B.Bool) <- (\force B.And.program) columnHit \then
  \bind withinColumn: B.Bool <- (\force columnAnd) nonzero \then
  \bind rowAnd: \U(B.Bool -> B.Bool) <- (\force B.And.program) rowHit \then
  \bind withinRow: B.Bool <- (\force rowAnd) withinColumn \then
  \return withinRow
})))))));
\definition withOperations(and: B.And.T^)(neg: B.Neg.T^)(isZero: I.IsZero.T^)(less: NatCorrespondence.Leb.T^)(k: N.Nat^)(a: Runtime^)(i, j: N.Nat^): B.Bool^ :=
  and (less k i) (and (less k j) (neg (isZero (a i j))));
\definition stage1(k: N.Nat^)(a: Runtime^)(i, j: N.Nat^): B.Bool^ := withOperations B.And.specification B.Neg.program^ I.IsZero.program^ NatPrograms.leb^ k a i j;
\definition stage2(k: N.Nat^)(a: Runtime^)(i, j: N.Nat^): B.Bool^ := withOperations B.And.specification B.Neg.specification I.IsZero.program^ NatPrograms.leb^ k a i j;
\definition stage3(k: N.Nat^)(a: Runtime^)(i, j: N.Nat^): B.Bool^ := withOperations B.And.specification B.Neg.specification I.IsZero.specification NatPrograms.leb^ k a i j;
\definition matches: \forall (k: N.Nat^)(a: Runtime^)(i, j: N.Nat^) -> program^ k a i j = probe k a i j :=
  \fun (k: N.Nat^)(a: Runtime^)(i, j: N.Nat^) => trans!{B.Bool^} (program^ k a i j) (stage1 k a i j) (probe k a i j)
    (congr!{B.And.T^ B.Bool^} (\fun (f: B.And.T^) => withOperations f B.Neg.program^ I.IsZero.program^ NatPrograms.leb^ k a i j) B.And.program^ B.And.specification B.And.coherence)
    (trans!{B.Bool^} (stage1 k a i j) (stage2 k a i j) (probe k a i j)
    (congr!{B.Neg.T^ B.Bool^} (\fun (f: B.Neg.T^) => withOperations B.And.specification f I.IsZero.program^ NatPrograms.leb^ k a i j) B.Neg.program^ B.Neg.specification B.Neg.coherence)
    (trans!{B.Bool^} (stage2 k a i j) (stage3 k a i j) (probe k a i j)
    (congr!{I.IsZero.T^ B.Bool^} (\fun (f: I.IsZero.T^) => withOperations B.And.specification B.Neg.specification f NatPrograms.leb^ k a i j) I.IsZero.program^ I.IsZero.specification I.IsZero.coherence)
    ((congr!{NatCorrespondence.Leb.T^ B.Bool^} (\fun (f: NatCorrespondence.Leb.T^) => withOperations B.And.specification B.Neg.specification I.IsZero.specification f k a i j) NatPrograms.leb^ Nat.leb NatCorrespondence.Leb.coherence))));
\definition coherence: program^ = probe := \axiom:funext(program^, probe,
  \fun (k: N.Nat^) => \axiom:funext(program^ k, probe k,
    \fun (a: Runtime^) => \axiom:funext(program^ k a, probe k a,
      \fun (i: N.Nat^) => \axiom:funext(program^ k a i, probe k a i, \fun (j: N.Nat^) => matches k a i j))));
