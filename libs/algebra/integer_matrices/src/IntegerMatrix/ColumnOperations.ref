\import \parent.Transpose[] \as Transpose;
\import \parent.RowOperations[] \as Rows;
\definition swap(a: Runtime^)(r, s: N.Nat^): Runtime^ := Transpose.transpose (Rows.swap (Transpose.transpose a) r s);
\definition add(a: Runtime^)(r, s: N.Nat^)(c: I.Int^): Runtime^ := Transpose.transpose (Rows.add (Transpose.transpose a) r s c);
\definition negate(a: Runtime^)(r: N.Nat^): Runtime^ := Transpose.transpose (Rows.negate (Transpose.transpose a) r);
\module SwapImplementation;
\correspondence Swap: Programs.Correspondence := Programs.Correspondence {
  T := SwapImplementation[].T, program := SwapImplementation[].program, specification := swap, coherence := SwapImplementation[].coherence,
};
\module AddImplementation;
\correspondence Add: Programs.Correspondence := Programs.Correspondence {
  T := AddImplementation[].T, program := AddImplementation[].program, specification := add, coherence := AddImplementation[].coherence,
};
\module NegateImplementation;
\correspondence Negate: Programs.Correspondence := Programs.Correspondence {
  T := NegateImplementation[].T, program := NegateImplementation[].program, specification := negate, coherence := NegateImplementation[].coherence,
};

\module Typed(r, s: Finite.Fin n);
