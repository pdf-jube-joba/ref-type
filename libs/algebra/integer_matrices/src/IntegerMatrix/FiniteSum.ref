\import std.Arithmetic[].IntegerSum[] \as Numeric;
\module At(count: N.Nat^);
\definition sum(count: N.Nat^)(f: N.Nat^ -> I.Int^): I.Int^ := At[count := count].sum f;
\definition law: \forall (count: N.Nat^)(f: N.Nat^ -> I.Int^) -> sum count f = Numeric.sum count f :=
  \induction (count: N.Nat^) \return \forall (f: N.Nat^ -> I.Int^) -> sum count f = Numeric.sum count f \with {
    | zero: \fun (f: N.Nat^ -> I.Int^) => \refl(Arithmetic.zero)
    | succ: \fun (count: N.Nat^)(previous: _)(f: N.Nat^ -> I.Int^) => At[count := count].step previous f
  };
