\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import std.Alg[].Field[] \as Fields;
\import complex.Complex[] \as C;
\import C.Algebra[] \as Scalars;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex Scalars.field] \as Spaces;
\import polynomial_linear_algebra.Field[K := C.Complex, field := Scalars.field] \as Polynomials;
\import algebra.Polynomial[].Over[R := C.Complex, coefficients := Fields.fieldAsCommutativeRing C.Complex Scalars.field] \as P;
\import linear_algebra.Commutative[K := P.Carrier, scalarRing := P.ring] \as PolynomialSpaces;
\module Action(V: \Set, space: Spaces.VectorSpace V, T: Spaces.Linear[V := V, W := V, source := space, target := space].Map);
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar, topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\module At(n: N.Nat^);
\module Coprime;
\module Circle;
\import complex_polynomial_roots.Roots[] \as Roots;
\module Coefficients;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar] \as Geometry;
\module Intertwining(V, W: \Set, source: Spaces.VectorSpace V, destination: Spaces.VectorSpace W,
  S: Spaces.Linear[V := V, W := V, source := source, target := source].Map,
  T: Spaces.Linear[V := W, W := W, source := destination, target := destination].Map);
\module Comparison(n, m: N.Nat^,
  A: matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := n].Matrix,
  B: matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := m].Matrix,
  sourceOff: \root.Spectral[].At[n := n].Splitting[A := A].OffSpectrum,
  targetOff: \root.Spectral[].At[n := m].Splitting[A := B].OffSpectrum);
\module Idempotents(n: N.Nat^);
\module InFrame(V: \Set, space: Spaces.VectorSpace V,
  T: Spaces.Linear[V := V, W := V, source := space, target := space].Map, n: N.Nat^,
  frame: Spaces.Isomorphism[V := V, W := Fin.Fin n -> C.Complex, source := space, target := Spaces.Coordinates[I := Fin.Fin n].space].Isomorphism);
\module FiniteSpace(V: \Set, space: Spaces.VectorSpace V,
  T: Spaces.Linear[V := V, W := V, source := space, target := space].Map);

\import C.Absolute[] \as Absolute;
\import real.Analysis[] \as Real;
\definition NoUnitEigen[V: \Set][space: Spaces.VectorSpace V]
  [T: Spaces.Linear[V := V, W := V, source := space, target := space].Map]: \Prop :=
  \forall (z: C.Complex) -> Absolute.abs z = Real.one -> \forall (v: V) -> T.apply v = space.smul z v -> v = space.zero;

\module IntervalRelations(R: algebraic_topology.Interval[].Carrier -> algebraic_topology.Interval[].Carrier -> \Prop);

\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as BundleOperations;
\module BundleImage(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle,
  P: Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x].Map,
  idempotent: \forall (x: X)(v: F x) -> (P.fiber x).apply ((P.fiber x).apply v) = (P.fiber x).apply v);

\module BundleCoordinates(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle,
  T: Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x].Map,
  c: Bundles.Family[X := X, F := F].With[data := bundle].Chart);
\module BundleEndomorphism(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle,
  T: Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x].Map,
  gap: \forall (x: X) -> NoUnitEigen (F x) (bundle.space x) (T.fiber x));
