\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import std.Alg[].Field[] \as Fields;
\import complex.Complex[] \as C;
\import C.Algebra[] \as Scalars;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex Scalars.field] \as Spaces;
\import polynomial_linear_algebra.Field[K := C.Complex, field := Scalars.field] \as Polynomials;
\import algebra.Polynomial[].Over[R := C.Complex, coefficients := Fields.fieldAsCommutativeRing C.Complex Scalars.field] \as P;
\import linear_algebra.Commutative[K := P.Carrier, scalarRing := P.ring] \as PolynomialSpaces;
\module Action(V: \Set, space: Spaces.VectorSpace V, T: Spaces.Linear[V := V, W := V, source := space, target := space].Map);
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar, topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\module At(n: N.Nat^);
\module Coprime;
\module Circle;
\import complex_polynomial_roots.Roots[] \as Roots;
\module Coefficients;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar] \as Geometry;
\module Intertwining(V, W: \Set, source: Spaces.VectorSpace V, destination: Spaces.VectorSpace W,
  S: Spaces.Linear[V := V, W := V, source := source, target := source].Map,
  T: Spaces.Linear[V := W, W := W, source := destination, target := destination].Map);
\module Comparison(n, m: N.Nat^,
  A: matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := n].Matrix,
  B: matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := m].Matrix,
  sourceOff: \root.Spectral[].At[n := n].Splitting[A := A].OffSpectrum,
  targetOff: \root.Spectral[].At[n := m].Splitting[A := B].OffSpectrum);
\module Idempotents(n: N.Nat^);
