\definition inclusion[x: X]: Cylinder.CarrierSet := Pair.pair I.Carrier X t x;
\definition cylinderContinuous: topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace topology inclusion :=
  Cylinder.Universal[X := X].pairContinuous baseSpace I.topology baseSpace (\fun (_: X) => t) (\fun (x: X) => x)
    (topology.Maps[A := X, B := I.Carrier].constantContinuous baseSpace I.topology t) (topology.Maps[A := X, B := X].Identity[].continuous baseSpace);
\definition continuous: topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace originalBundle.baseSpace inclusion :=
  \idelim topology = originalBundle.baseSpace \with space: Space.Topology => topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace space inclusion \by {
    base: cylinderContinuous, equality: sym!{{Space.Topology}} _ _ sameBase
  };
\definition Fiber[x: X]: \Set := Image.Fiber (inclusion x);
\import Bundles.Family[X := Cylinder.CarrierSet, F := Image.Fiber].Of[bundle := Image.imageBundle].Pullback[Y := X, source := baseSpace, f := inclusion] \as Pulled;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Pulled.pulled continuous;
