\import vector_bundles.Bundles[] \as BundleFields;
\import std.Data[].Pair[] \as Pair;
\definition K: \Set := C.Complex;
\definition field: Fields.Field[K] := Scalars.field;
\definition conjugation: linear_algebra.Hermitian[].Scalar[K, field] := linear_algebra.Hermitian[].Complex[].scalar;
\definition scalar: BundleFields.Scalar[K, field, conjugation] := BundleFields.Complex[].scalar;
\import BundleFields.Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\definition Vector[k: N.Nat^]: \Set := Bundles.Vector k;
\definition coordinates[k: N.Nat^]: Spaces.VectorSpace (Vector k) := Bundles.coordinates k;
\definition coordinateTopology[k: N.Nat^]: topology.Topology[Carrier := Vector k].Topology := Bundles.coordinateTopology k;
\structure Projection: \Set := {
  map: Spaces.Linear[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n].Map,
  idempotent: \forall (v: Vector n) -> map.apply (map.apply v) = map.apply v,
};
\module With(P: Projection);
\module Image(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, P: X -> Projection,
  regular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map));
