\import algebra.Polynomial[].Over[R := C.Complex, coefficients := Fields.fieldAsCommutativeRing C.Complex Scalars.field] \as Polynomial;
\import galois.Field[].Over[K := C.Complex, field := Scalars.field].Polynomial[].AbstractEvaluation[] \as ScalarEvaluation;
\import Polynomial.Universal[K := C.Complex, target := Fields.fieldAsCommutativeRing C.Complex Scalars.field] \as ScalarUniversal;
\import Polynomials.Action[V := Vector, space := Coordinates.space].At[T := Matrices.linear matrix] \as Evaluation;
\import Polynomials.Primary[V := Vector, space := Evaluation.module] \as Primary;
\import PolynomialSpaces.Laws[V := Vector, space := Evaluation.module] \as PolynomialLaws;
\import \parent.\parent.Splitting[A := matrix] \as Source;
\import Source.Separated[off := off] \as Recovered;
\import \root.Spectral[].Circle[] \as Circle;
\import Circle.At[n := n] \as Roots;
\import std.Data[].Bool[] \as B;
\definition p: Polynomial.Carrier := Polynomial.X;
\definition q: Polynomial.Carrier := Polynomial.add Polynomial.X (Polynomial.constant (Spaces.neg two));
\definition pRoot[z: C.Complex]: ScalarEvaluation.apply z p = Spaces.zero -> z = Spaces.zero :=
  \fun (root: _) => trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (ScalarUniversal.variable ScalarEvaluation.identity z)) root;
\definition qEvaluation[z: C.Complex]: ScalarEvaluation.apply z q = Spaces.add z (Spaces.neg two) := trans!{{C.Complex}} _ _ _
  ((ScalarEvaluation.homomorphism z).add Polynomial.X (Polynomial.constant (Spaces.neg two)))
  (congr!{{C.Complex} {C.Complex} {C.Complex}} Spaces.add _ _ _ _
    (ScalarUniversal.variable ScalarEvaluation.identity z) (ScalarUniversal.constants ScalarEvaluation.identity z (Spaces.neg two)));
\definition qRoot[z: C.Complex]: ScalarEvaluation.apply z q = Spaces.zero -> z = two :=
  \fun (root: _) => subtractZero z two (trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (qEvaluation z)) root);
\definition pNonzero: Logic.Not (p = Polynomial.zero) := \fun (zero: _) => Scalars.field.nontrivial (eq_reason_in!{{C.Complex} Spaces.zero
  "=" { ScalarEvaluation.apply Spaces.one Polynomial.zero } "by" { sym!{{C.Complex}} _ _ (ScalarEvaluation.homomorphism Spaces.one).zero }
  "=" { ScalarEvaluation.apply Spaces.one p } "by" { congr!{{Polynomial.Carrier} {C.Complex}} (ScalarEvaluation.apply Spaces.one) _ _ (sym!{{Polynomial.Carrier}} _ _ zero) }
  "=" Spaces.one "by" { ScalarUniversal.variable ScalarEvaluation.identity Spaces.one }
});
\definition coprime: Polynomials.Coprime p q := \root.Spectral[].Coprime[].exists p q pNonzero
  (\fun (z: C.Complex)(pr: _)(qr: _) => twoNonzero (trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (qRoot z qr)) (pRoot z pr)));
\definition pInside[z: C.Complex]: ScalarEvaluation.apply z p = Spaces.zero -> D.Lt (Absolute.abs z) R.one :=
  \fun (root: _) => D.ltReplaceLeft R.zero (Absolute.abs z) R.one
    (sym!{R.Real} _ _ (trans!{R.Real} _ _ _ (congr!{{C.Complex} {R.Real}} Absolute.abs _ _ (pRoot z root)) Bounds.absZero)) Estimates.onePositive;
\definition qOutside[z: C.Complex]: ScalarEvaluation.apply z q = Spaces.zero -> D.Lt R.one (Absolute.abs z) :=
  \fun (root: _) => D.ltReplaceRight R.one (Absolute.abs two) (Absolute.abs z)
    (congr!{{C.Complex} {R.Real}} Absolute.abs _ _ (sym!{{C.Complex}} _ _ (qRoot z root))) twoOutside;
\definition crossLeft: Polynomials.Coprime Source.inside q := \root.Spectral[].Coprime[].exists Source.inside q
  (Roots.factorNonzero B.Bool^::true Source.coefficients)
  (\fun (z: C.Complex)(inside: _)(outside: _) => Circle.disjoint z
    (Roots.factorRoot B.Bool^::true Source.coefficients off z inside) (qOutside z outside));
\definition crossRight: Polynomials.Coprime Source.outside p := \root.Spectral[].Coprime[].exists Source.outside p
  (Roots.factorNonzero B.Bool^::false Source.coefficients)
  (\fun (z: C.Complex)(outside: _)(inside: _) => Circle.disjoint z
    (pInside z inside) (Roots.factorRoot B.Bool^::false Source.coefficients off z outside));
\definition variable[v: Vector]: Evaluation.apply p v = T.apply v := trans!{Vector} _ _ _ (Evaluation.variable v)
  (congr!{End.Map Vector} (\fun (f: End.Map) => f.apply v) _ _ linear);
\definition qAction[v: Vector]: Evaluation.apply q v = Coordinates.plus (T.apply v) (Coordinates.scale (Spaces.neg two) v) :=
  trans!{Vector} _ _ _ (Evaluation.addition Polynomial.X (Polynomial.constant (Spaces.neg two)) v)
    (congr!{Vector Vector Vector} Coordinates.plus _ _ _ _ (variable v) (Evaluation.constants (Spaces.neg two) v));
\definition pKernel[v: Vector]: Evaluation.apply p (P.apply v) = Coordinates.origin := trans!{Vector} _ _ _ (variable (P.apply v))
  (trans!{Vector} _ _ _ (congr!{Vector Vector} (Coordinates.scale two) _ _ (Complement.annihilatesRight v)) (Laws.scaleZero two));
\definition qKernel[v: Vector]: Evaluation.apply q (Complement.complementMap.apply v) = Coordinates.origin := eq_reason_in!{Vector _
  "=" { Coordinates.plus (T.apply (Complement.complementMap.apply v)) (Coordinates.scale (Spaces.neg two) (Complement.complementMap.apply v)) } "by" { qAction (Complement.complementMap.apply v) }
  "=" { Coordinates.plus (Coordinates.scale two (Complement.complementMap.apply v)) (Coordinates.scale (Spaces.neg two) (Complement.complementMap.apply v)) } "by" {
    congr!{Vector Vector} (\fun (w: Vector) => Coordinates.plus (Coordinates.scale two w) (Coordinates.scale (Spaces.neg two) (Complement.complementMap.apply v))) _ _ (Complement.complementIdempotent v)
  }
  "=" { Coordinates.scale (Spaces.add two (Spaces.neg two)) (Complement.complementMap.apply v) } "by" { sym!{Vector} _ _ (Coordinates.space.scalarAdd two (Spaces.neg two) (Complement.complementMap.apply v)) }
  "=" { Coordinates.scale Spaces.zero (Complement.complementMap.apply v) } "by" { congr!{{C.Complex} Vector} (\fun (a: C.Complex) => Coordinates.scale a (Complement.complementMap.apply v)) _ _ (Spaces.addNegRight two) }
  "=" _ "by" { Laws.zeroScale (Complement.complementMap.apply v) }
};
\definition annihilated[v: Vector]: Evaluation.apply (Polynomial.mul p q) v = Coordinates.origin := eq_reason_in!{Vector _
  "=" { Evaluation.apply (Polynomial.mul p q) (Coordinates.plus (P.apply v) (Complement.complementMap.apply v)) } "by" {
    congr!{Vector Vector} (Evaluation.apply (Polynomial.mul p q)) _ _ (sym!{Vector} _ _ (Complement.splitting v))
  }
  "=" { Coordinates.plus (Evaluation.apply (Polynomial.mul p q) (P.apply v)) (Evaluation.apply (Polynomial.mul p q) (Complement.complementMap.apply v)) } "by" { (Evaluation.evaluate (Polynomial.mul p q)).preservesAdd (P.apply v) (Complement.complementMap.apply v) }
  "=" { Coordinates.plus Coordinates.origin Coordinates.origin } "by" {
    congr!{Vector Vector Vector} Coordinates.plus _ _ _ _
      (trans!{Vector} _ _ _ (Evaluation.multiplication p q (P.apply v))
        (trans!{Vector} _ _ _ (PolynomialLaws.scaleComm p q (P.apply v))
          (trans!{Vector} _ _ _ (congr!{Vector Vector} (Evaluation.apply q) _ _ (pKernel v)) (Evaluation.evaluate q).preservesZero)))
      (trans!{Vector} _ _ _ (Evaluation.multiplication p q (Complement.complementMap.apply v))
        (trans!{Vector} _ _ _ (congr!{Vector Vector} (Evaluation.apply p) _ _ (qKernel v)) (Evaluation.evaluate p).preservesZero))
  }
  "=" _ "by" { Laws.zeroLeft Coordinates.origin }
};
\definition alternate[b: Polynomials.Bezout[p, q, Polynomial.one]][v: Vector]: Primary.projection p q b v = P.apply v :=
  sym!{Vector} _ _ (Primary.uniqueLeft p q b v (Primary.Split[p, q, v] {
    left := \into[Vector](P.apply v, Primary.Kernel p) \by { pKernel v },
    right := \into[Vector](Complement.complementMap.apply v, Primary.Kernel q) \by { qKernel v },
    reconstruction := Complement.splitting v,
  }));
\definition recovers[v: Vector]: Recovered.projection.apply v = P.apply v := \block {
  \takefrom source: Polynomials.Bezout[Source.inside, Source.outside, Polynomial.one] \by Roots.coprime Source.coefficients off \then
  \takefrom target: Polynomials.Bezout[p, q, Polynomial.one] \by coprime \then
  \takefrom pd: Polynomials.Bezout[Source.inside, q, Polynomial.one] \by crossLeft \then
  \takefrom qc: Polynomials.Bezout[Source.outside, p, Polynomial.one] \by crossRight \then
  \return eq_reason_in!{Vector _
    "=" _ "by" { Recovered.formula source v }
    "=" { Primary.projection p q target v } "by" {
      \root.Spectral[].Action[V := Vector, space := Coordinates.space, T := Matrices.linear matrix].Comparison[
        p := Source.inside, q := Source.outside, b := source, c := p, d := q, other := target].same pd qc v
        (\parent.\parent.On[A := matrix, factors := Source.factorization source].annihilated v) (annihilated v)
    }
    "=" _ "by" { alternate target v }
  }
};
