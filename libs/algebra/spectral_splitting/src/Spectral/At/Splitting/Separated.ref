\definition matrix: Inversion.Nonsingular := \into[Matrices.Matrix](Square.entries middle, Inversion.Nonsingular) \by { nonzero off };
\definition inverse: End.Map := Square.Inverse[A := matrix].value;
\definition projection: End.Map := Compose.compose (Evaluation.evaluate outside) inverse;
\import Matrices.Representation[] \as Representation;
\definition inverseRight: \forall (v: Vector) -> middle.apply (inverse.apply v) = v :=
  \fun (v: Vector) => trans!{Vector} _ _ _
    (sym!{Vector} _ _ (congr!{End.Map Vector} (\fun (f: End.Map) => f.apply (inverse.apply v)) _ _ (Representation.linearEntries middle)))
    (Square.Inverse[A := matrix].right v);
\module With(b: Polynomials.Bezout[inside, outside, P.one]);
\definition formula: \forall (b: Polynomials.Bezout[inside, outside, P.one])(v: Vector) -> projection.apply v =
  \root.Spectral[].Action[V := Vector, space := Coordinates.space, T := Matrices.linear A].With[p := inside, q := outside, b := b].projection.apply v :=
  \fun (b: Polynomials.Bezout[inside, outside, P.one]) => With[b := b].formula;
\definition idempotent: \forall (v: Vector) -> projection.apply (projection.apply v) = projection.apply v := \block {
  \takefrom b: Polynomials.Bezout[inside, outside, P.one] \by Roots.coprime coefficients off \then
  \return With[b := b].idempotent
};
\definition inKernel: \forall (v: Vector) -> Evaluation.apply inside (projection.apply v) = Coordinates.origin := \block {
  \takefrom b: Polynomials.Bezout[inside, outside, P.one] \by Roots.coprime coefficients off \then
  \return With[b := b].inKernel
};
