\definition increasing: Rigidity.Endomorphism n := \into[Fin.Fin n -> Fin.Fin n](\fun (i: Fin.Fin n) => indices (ordering.forward i), Rigidity.Endomorphism n) \by {
  \bysub(Ordering.PermutationType n, Ordering.Ordered n n indices, ordering)
};
\definition identity: (\fun (i: Fin.Fin n) => indices (ordering.forward i)) = (\fun (i: Fin.Fin n) => i) := Rigidity.rigid n increasing;
\definition scalarUnit: ScalarSigns.signed word (ScalarTerms.Weight indices) = Scalars.field.one := eq_reason_in!{{C.Complex} _
  "=" _ "by" { ScalarSigns.signValue word (ScalarTerms.Weight indices) }
  "=" { ScalarTop.volume (\fun (i: Fin.Fin n) => Spaces.FiniteCoordinates[n := n].vectors (indices (ordering.forward i))) } "by" {
    sym!{{C.Complex}} _ _ (ScalarSigns.transformation ordering word ScalarTop.volume (\fun (i: Fin.Fin n) => Spaces.FiniteCoordinates[n := n].vectors (indices i)) represents)
  }
  "=" _ "by" { congr!{{Fin.Fin n -> Fin.Fin n} {C.Complex}} ScalarTerms.Weight _ _ identity }
  "=" _ "by" { ScalarTop.normalized }
};
\definition polynomialUnit: PolynomialSigns.signed word (PolynomialTerms.Weight indices) = P.one := eq_reason_in!{{P.Carrier} _
  "=" _ "by" { PolynomialSigns.signValue word (PolynomialTerms.Weight indices) }
  "=" { PolynomialTop.volume (\fun (i: Fin.Fin n) => PolynomialSpaces.FiniteCoordinates[n := n].vectors (indices (ordering.forward i))) } "by" {
    sym!{{P.Carrier}} _ _ (PolynomialSigns.transformation ordering word PolynomialTop.volume (\fun (i: Fin.Fin n) => PolynomialSpaces.FiniteCoordinates[n := n].vectors (indices i)) represents)
  }
  "=" _ "by" { congr!{{Fin.Fin n -> Fin.Fin n} {P.Carrier}} PolynomialTerms.Weight _ _ identity }
  "=" _ "by" { PolynomialTop.normalized }
};
\definition natural: P.constant (ScalarTerms.Weight indices) = PolynomialTerms.Weight indices :=
  PolynomialSigns.signedInjective word _ _ (eq_reason_in!{{P.Carrier} _
    "=" _ "by" { sym!{{P.Carrier}} _ _ (signed word (ScalarTerms.Weight indices)) }
    "=" { P.constant Scalars.field.one } "by" { congr!{{C.Complex} {P.Carrier}} P.constant _ _ scalarUnit }
    "=" { P.one } "by" { Raw.coefficientLaws.one }
    "=" _ "by" { sym!{{P.Carrier}} _ _ polynomialUnit }
  });
