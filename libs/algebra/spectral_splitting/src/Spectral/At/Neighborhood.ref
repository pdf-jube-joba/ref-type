\import topology.Topology[Carrier := X] \as Source;
\import \root.Spectral[].Circle[].At[n := n] \as Roots;
\import \parent.Characteristic[].Families[X := X, source := source] \as Coefficients;
\definition domain: \Pow X := { x: X \where \parent.Splitting[A := A x].OffSpectrum };
\definition local[index: Roots.Index]: \Pow X := { x: X \where \In[complex_polynomial_roots.Roots[].Vector n] (Roots.Domain index) (\parent.Characteristic[].coefficients (A x)) };
\definition localOpen[index: Roots.Index]: Source.IsOpenIn source (local index) := Coefficients.continuous A regular (Roots.Domain index) (Roots.open index);
\definition open: Source.IsOpenIn source domain := Source.openOfNeighborhoods source domain \block {
  \fun (x: X)(off: \parent.Splitting[A := A x].OffSpectrum) \then
  \takefrom index: \Cast[Roots.Index] ({ index: Roots.Index \where Source.Member (local index) x })
    \by Roots.covers (\parent.Characteristic[].coefficients (A x)) off \then
  \return Logic.existsIntro[\Pow X, { U: \Pow X \where Source.OpenNeighborhood[source, x, domain, U] }] (local index)
    (Source.OpenNeighborhood[source, x, domain, local index] {
      open := localOpen index,
      contains := \bysub(Roots.Index, { index: Roots.Index \where Source.Member (local index) x }, index),
      within := \fun (y: X)(inside: Source.Member (local index) y) => Roots.domainOff index (\parent.Characteristic[].coefficients (A y)) inside,
    })
};
