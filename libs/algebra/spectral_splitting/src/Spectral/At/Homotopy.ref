\import algebraic_topology.Interval[] \as I;
\import topological_constructions.Product[A := I.Carrier, B := X] \as Cylinder;
\definition source: topology.Topology[Carrier := Cylinder.CarrierSet].Topology := Cylinder.topology I.topology baseSpace;
\import \parent.Continuous[X := Cylinder.CarrierSet, source := source, A := A, regular := regular, off := off] \as Continuous;
\import Continuous.Bundle[] \as Image;
\import \root.Spectral[].Idempotents[n := n].Homotopy[X := X, baseSpace := baseSpace, compact := compact,
  P := (\fun (p: Cylinder.CarrierSet) => Image.idempotent p), regular := Continuous.projectionRegular] \as Comparison;
\definition Isomorphism[s: I.Carrier][t: I.Carrier]: \Set := Comparison.Isomorphism s t;
\definition endpointIsomorphismExists: \exists Isomorphism I.start I.end := Comparison.endpointIsomorphismExists;
\module Endpoint(t: I.Carrier);
