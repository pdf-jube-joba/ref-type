\import \root.Spectral[].InFrame[V := V, space := space, T := T, n := witness.rank, frame := witness.frame].Separated[off := witness.off] \as Selected;
\definition value: End.Map := Selected.value;
\definition idempotent: \forall (v: V) -> value.apply (value.apply v) = value.apply v := Selected.idempotent;
\definition agrees: Agreement value := \fun (n: N.Nat^)
  (frame: Spaces.Isomorphism[V := V, W := Fin.Fin n -> C.Complex, source := space, target := Spaces.Coordinates[I := Fin.Fin n].space].Isomorphism)
  (off: \root.Spectral[].InFrame[V := V, space := space, T := T, n := n, frame := frame].OffSpectrum)(v: V) =>
    Selected.Comparison[m := n, other := frame, otherOff := off].same v;
