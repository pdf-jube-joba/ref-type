\definition exists: \exists Candidate := \block {
  \takefrom witness: Witness \by finite \then
  \return \exact(\into[End.Map](In[witness := witness].value, Candidate) \by { In[witness := witness].agrees }, Candidate)
};
\definition unique: \forall (p, q: Candidate) -> p = q := \block {
  \fun (p, q: Candidate) \then
  \takefrom witness: Witness \by finite \then
  \let left: Agreement p := \bysub(End.Map, Candidate, p) \then
  \let right: Agreement q := \bysub(End.Map, Candidate, q) \then
  \return End.ext p q (\axiom:funext(p.apply, q.apply, \fun (v: V) => trans!{V} _ _ _
    (left witness.rank witness.frame witness.off v) (sym!{V} _ _ (right witness.rank witness.frame witness.off v))))
};
\definition value: Candidate := \choice Candidate \by { existence: exists, uniqueness: unique };
\definition inFrame: Agreement value := \bysub(End.Map, Candidate, value);
\definition idempotent: \forall (v: V) -> value.apply (value.apply v) = value.apply v := \block {
  \fun (v: V) \then
  \takefrom witness: Witness \by finite \then
  \let selected: End.Map := In[witness := witness].value \then
  \return eq_reason_in!{V _
    "=" { selected.apply (value.apply v) } "by" { inFrame witness.rank witness.frame witness.off (value.apply v) }
    "=" { selected.apply (selected.apply v) } "by" { congr!{V V} selected.apply _ _ (inFrame witness.rank witness.frame witness.off v) }
    "=" _ "by" { In[witness := witness].idempotent v }
    "=" _ "by" { sym!{V} _ _ (inFrame witness.rank witness.frame witness.off v) }
  }
};
