\definition Agreement[p: End.Map]: \Prop := \forall (n: N.Nat^)
  (frame: Spaces.Isomorphism[V := V, W := Fin.Fin n -> C.Complex, source := space, target := Spaces.Coordinates[I := Fin.Fin n].space].Isomorphism)
  (off: \root.Spectral[].InFrame[V := V, space := space, T := T, n := n, frame := frame].OffSpectrum)(v: V) ->
  p.apply v = \root.Spectral[].InFrame[V := V, space := space, T := T, n := n, frame := frame].Separated[off := off].value.apply v;
\definition Candidate: \Set := \Cast[End.Map] ({ p: End.Map \where Agreement p });
\definition exists: \exists Candidate := \block {
  \takefrom witness: Witness \by finite \then
  \return \exact(\into[End.Map](\root.Spectral[].InFrame[V := V, space := space, T := T, n := witness.rank, frame := witness.frame].Separated[off := witness.off].value, Candidate) \by {
    \fun (n: N.Nat^)
      (frame: Spaces.Isomorphism[V := V, W := Fin.Fin n -> C.Complex, source := space, target := Spaces.Coordinates[I := Fin.Fin n].space].Isomorphism)
      (off: \root.Spectral[].InFrame[V := V, space := space, T := T, n := n, frame := frame].OffSpectrum)(v: V) =>
        \root.Spectral[].InFrame[V := V, space := space, T := T, n := witness.rank, frame := witness.frame].Separated[off := witness.off].Comparison[m := n, other := frame, otherOff := off].same v
  }, Candidate)
};
\definition unique: \forall (p, q: Candidate) -> p = q := \block {
  \fun (p, q: Candidate) \then
  \takefrom witness: Witness \by finite \then
  \let left: Agreement p := \bysub(End.Map, Candidate, p) \then
  \let right: Agreement q := \bysub(End.Map, Candidate, q) \then
  \return End.ext p q (\axiom:funext(p.apply, q.apply, \fun (v: V) => trans!{V} _ _ _
    (left witness.rank witness.frame witness.off v) (sym!{V} _ _ (right witness.rank witness.frame witness.off v))))
};
\definition value: Candidate := \choice Candidate \by { existence: exists, uniqueness: unique };
\definition inFrame: Agreement value := \bysub(End.Map, Candidate, value);
\definition idempotent: \forall (v: V) -> value.apply (value.apply v) = value.apply v := \block {
  \fun (v: V) \then
  \takefrom witness: Witness \by finite \then
  \return eq_reason_in!{V _
    "=" _ "by" { inFrame witness.rank witness.frame witness.off (value.apply v) }
    "=" _ "by" { congr!{V V} \root.Spectral[].InFrame[V := V, space := space, T := T, n := witness.rank, frame := witness.frame].Separated[off := witness.off].value.apply _ _ (inFrame witness.rank witness.frame witness.off v) }
    "=" _ "by" { \root.Spectral[].InFrame[V := V, space := space, T := T, n := witness.rank, frame := witness.frame].Separated[off := witness.off].idempotent v }
    "=" _ "by" { sym!{V} _ _ (inFrame witness.rank witness.frame witness.off v) }
  }
};
