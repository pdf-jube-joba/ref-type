\import \root.Spectral[].FiniteSpace[V := W, space := destination, T := U] \as Target;
\import Target.On[finite := targetFinite] \as TargetIntrinsic;
\import \root.Spectral[].FiniteSpace[V := V, space := space, T := T] \as Source;
\import Source.On[finite := finite] \as SourceIntrinsic;
\module Framed(first: Source.Witness, second: Target.Witness);
\definition natural: \forall (v: V) -> h.apply (value.apply v) = TargetIntrinsic.value.apply (h.apply v) := \block {
  \fun (v: V) \then
  \takefrom first: Source.Witness \by finite \then
  \takefrom second: Target.Witness \by targetFinite \then
  \return Framed[first := first, second := second].natural v
};
