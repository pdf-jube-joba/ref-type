\import Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x] \as Maps;
\definition point[y: Y]: Ambient.Point := Chart.Maps[Y := Y, source := source].point base vector y;
\definition pointContinuous: topology.Continuity[A := Y, B := Ambient.Point].Continuous source bundle.totalSpace point :=
  Chart.Maps[Y := Y, source := source].pointContinuous base vector baseRegular vectorRegular;
\definition target[y: Y]: Original.TotalPoint := \into[Ambient.Point](Maps.total T (point y), { p: Ambient.Point \where Base.Member c.domain p.base }) \by { \bysub(X, c.domain, base y) };
\definition continuous: topology.Continuity[A := Y, B := Vector].Continuous source coordinateTopology (\fun (y: Y) => (operator (base y)).apply (vector y)) :=
  Chart.Maps[Y := Y, source := source].vectorContinuous target
    (topology.Composition[A := Y, B := Ambient.Point, C := Ambient.Point].composeContinuous source bundle.totalSpace bundle.totalSpace point (Maps.total T) pointContinuous (Maps.continuous T));
