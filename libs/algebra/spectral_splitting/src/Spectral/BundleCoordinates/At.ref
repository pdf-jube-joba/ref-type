\import Spaces.Linear[V := F x, W := Vector, source := bundle.space x, target := coordinates].Composition[U := Vector, domain := coordinates] \as Forward;
\import Spaces.Linear[V := F x, W := F x, source := bundle.space x, target := bundle.space x].Composition[U := Vector, domain := coordinates] \as Backward;
\definition operator: End.Map := Forward.compose (c.frame x).forward (Backward.compose (T.fiber x) (c.frame x).backward);
\import Spaces.Isomorphism[V := F x, W := Vector, source := bundle.space x, target := coordinates] \as Frames;
\definition left: \forall (v: F x) -> (c.frame x).backward.apply ((c.frame x).forward.apply v) = v := (Frames.laws (c.frame x)).leftInverse;
\definition right: \forall (v: Vector) -> (c.frame x).forward.apply ((c.frame x).backward.apply v) = v := (Frames.laws (c.frame x)).rightInverse;
