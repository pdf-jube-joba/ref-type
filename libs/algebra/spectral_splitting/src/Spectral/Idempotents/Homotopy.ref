\import algebraic_topology.Interval[] \as I;
\import topology.Topology[Carrier := I.Carrier] \as Time;
\import topology.Topology[Carrier := X] \as Base;
\import topological_constructions.Product[A := I.Carrier, B := X] \as Cylinder;
\definition topology: topology.Topology[Carrier := Cylinder.CarrierSet].Topology := Cylinder.topology I.topology baseSpace;
\import Hermitian.At[n := n].Families[X := Cylinder.CarrierSet].Matrix[m := n] \as Maps;
\module Reindex(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> Cylinder.CarrierSet,
  continuous: topology.Continuity[A := Y, B := Cylinder.CarrierSet].Continuous source topology f);
\module Slice(t: I.Carrier);
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\definition Isomorphism[s: I.Carrier][t: I.Carrier]: \Set := Bundles.Isomorphisms[X := X,
  F := (\fun (x: X) => Slice[t := s].Fiber x), G := (\fun (x: X) => Slice[t := t].Fiber x), source := Slice[t := s].bundle, target := Slice[t := t].bundle].Isomorphism;
\definition Related[s: I.Carrier][t: I.Carrier]: \Prop := \exists Isomorphism s t;
\definition transitive: \forall (r, s, t: I.Carrier) -> Related r s -> Related s t -> Related r t := \block {
  \fun (r, s, t: I.Carrier)(first: _)(second: _) \then
  \takefrom a: Isomorphism r s \by first \then
  \takefrom b: Isomorphism s t \by second \then
  \return \exact(Operations.IsomorphismComposition[X := X, F := (\fun (x: X) => Slice[t := r].Fiber x), G := (\fun (x: X) => Slice[t := s].Fiber x), H := (\fun (x: X) => Slice[t := t].Fiber x),
    source := Slice[t := r].bundle, middle := Slice[t := s].bundle, target := Slice[t := t].bundle].compose a b, Isomorphism r t)
};
\import \root.Spectral[].IntervalRelations[R := Related] \as Relations;
\module Uniform;
\definition endpointIsomorphismExists: Related I.start I.end := Relations.endpoints transitive Uniform[].local;
