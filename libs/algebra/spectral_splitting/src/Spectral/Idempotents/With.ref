\import \root.Spectral[].At[n := n].Idempotent[P := P.map, idempotent := P.idempotent] \as Algebra;
\definition complement: Projection := Projection { map := Algebra.complementMap, idempotent := Algebra.complementIdempotent };
\definition splitting: \forall (v: Vector n) -> (coordinates n).add (P.map.apply v) (complement.map.apply v) = v := Algebra.splitting;
\definition annihilates: \forall (v: Vector n) -> P.map.apply (complement.map.apply v) = (coordinates n).zero := Algebra.annihilates;
\definition annihilatesRight: \forall (v: Vector n) -> complement.map.apply (P.map.apply v) = (coordinates n).zero := Algebra.annihilatesRight;
\definition Witness: \Set := Algebra.Witness;
\definition basisExists: \exists Witness := Algebra.exists;
\definition fixed: \forall (k: N.Nat^)(basis: Algebra.Basis[k])(v: Vector k) -> P.map.apply (basis.value.apply v) = basis.value.apply v := Algebra.fixed;
