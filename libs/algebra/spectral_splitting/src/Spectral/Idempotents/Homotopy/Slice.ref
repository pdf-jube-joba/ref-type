\definition inclusion[x: X]: Cylinder.CarrierSet := Pair.pair I.Carrier X t x;
\definition continuous: topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace topology inclusion :=
  Cylinder.Universal[X := X].pairContinuous baseSpace I.topology baseSpace (\fun (_: X) => t) (\fun (x: X) => x)
    (topology.Maps[A := X, B := I.Carrier].constantContinuous baseSpace I.topology t)
    (topology.Maps[A := X, B := X].Identity[].continuous baseSpace);
\definition projection[x: X]: Projection := P (inclusion x);
\definition regular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (projection x).map) :=
  \parent.Reindex[Y := X, source := baseSpace, f := inclusion, continuous := continuous].regular;
\import \root.Spectral[].Idempotents[n := n].Image[X := X, baseSpace := baseSpace, P := projection, regular := regular] \as Image;
\definition Fiber[x: X]: \Set := Image.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.bundle;
