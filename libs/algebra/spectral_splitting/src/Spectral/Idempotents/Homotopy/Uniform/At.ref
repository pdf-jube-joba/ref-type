\definition domain: \Pow I.Carrier := Time.Intersection rectangle.leftSet rectangle.rightSet;
\definition nonzero: \forall (s, r: I.Carrier) -> Time.Member domain s -> Time.Member domain r -> \forall (x: X) ->
  Inversion.Nonzero (Square.entries (\root.Spectral[].Idempotents[n := n].Between[P := Slice[t := s].projection x, Q := Slice[t := r].projection x].h)) :=
  \fun (s, r: I.Carrier)(insideS: _)(insideR: _)(x: X) => tube.within (Pair.pair I.Carrier I.Carrier s r)
    (rectangle.within (Pair.pair I.Carrier I.Carrier s r) (Logic.And[_, _]::# insideS.left insideR.right)) x (\refl(x));
\definition related: Relations.Good domain := \fun (s, r: I.Carrier)(insideS: _)(insideR: _) => \block {
  \let pair: X -> Projection := Slice[t := s].projection \then
  \let other: X -> Projection := Slice[t := r].projection \then
  \let firstRegular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (pair x).map) := Slice[t := s].regular \then
  \let secondRegular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (other x).map) := Slice[t := r].regular \then
  \return \exact(\root.Spectral[].Idempotents[n := n].Comparison[X := X, baseSpace := baseSpace, P := pair, Q := other,
    regularP := firstRegular, regularQ := secondRegular,
    H := \root.Spectral[].Idempotents[n := n].Gap[X := X, baseSpace := baseSpace, P := pair, Q := other, regularP := firstRegular, regularQ := secondRegular].h,
    regularH := \root.Spectral[].Idempotents[n := n].Gap[X := X, baseSpace := baseSpace, P := pair, Q := other, regularP := firstRegular, regularQ := secondRegular].regular,
    nonsingular := nonzero s r insideS insideR,
    intertwines := \root.Spectral[].Idempotents[n := n].Gap[X := X, baseSpace := baseSpace, P := pair, Q := other, regularP := firstRegular, regularQ := secondRegular].intertwines].isomorphism,
    Isomorphism s r)
};
\definition neighborhood: Relations.Neighborhood[t] := Relations.Neighborhood[t] {
  domain := domain,
  open := (Time.topologyLaws I.topology).intersectionOpen rectangle.leftSet rectangle.rightSet rectangle.leftOpen rectangle.rightOpen,
  contains := Logic.And[_, _]::# rectangle.leftContains rectangle.rightContains,
  related := related,
};
