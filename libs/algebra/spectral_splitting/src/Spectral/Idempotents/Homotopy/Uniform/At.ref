\definition domain: \Pow I.Carrier := Time.Intersection rectangle.leftSet rectangle.rightSet;
\definition nonzero: \forall (s, r: I.Carrier) -> Time.Member domain s -> Time.Member domain r -> \forall (x: X) ->
  Inversion.Nonzero (Square.entries (\root.Spectral[].Idempotents[n := n].Between[P := Motion.Slice[t := s].projection x, Q := Motion.Slice[t := r].projection x].h)) :=
  \fun (s, r: I.Carrier)(insideS: _)(insideR: _)(x: X) => tube.within (Pair.pair I.Carrier I.Carrier s r)
    (rectangle.within (Pair.pair I.Carrier I.Carrier s r) (Logic.And[_, _]::# insideS.left insideR.right)) x (\refl(x));
\module Close(s, r: I.Carrier, insideS: Time.Member domain s, insideR: Time.Member domain r);
\definition related: Relations.Good domain := \fun (s, r: I.Carrier)(insideS: Time.Member domain s)(insideR: Time.Member domain r) =>
  \exact(Close[s := s, r := r, insideS := insideS, insideR := insideR].isomorphism, Motion.Isomorphism s r);
\definition neighborhood: Relations.Neighborhood[t] := Relations.Neighborhood[t] {
  domain := domain,
  open := (Time.topologyLaws I.topology).intersectionOpen rectangle.leftSet rectangle.rightSet rectangle.leftOpen rectangle.rightOpen,
  contains := Logic.And[_, _]::# rectangle.leftContains rectangle.rightContains,
  related := related,
};
