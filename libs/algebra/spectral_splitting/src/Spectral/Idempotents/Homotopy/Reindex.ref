\import Hermitian.At[n := n].Families[X := Y].Matrix[m := n] \as Result;
\definition regular: Result.Regular source (\fun (y: Y) => (P (f y)).map) := \fun (v: Vector n)(i: Fin.Fin n) =>
  topology.Composition[A := Y, B := Cylinder.CarrierSet, C := K].composeContinuous source topology scalar.topological.space f
    (\fun (p: Cylinder.CarrierSet) => (P p).map.apply v i) continuous (regular v i);
