\definition killsFirst: \forall (v: Original.Fiber x) -> (Q x).map.apply v = (coordinates n).zero :=
  \fun (v: Original.Fiber x) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n}} (Q x).map.apply _ _ (sym!{{Vector n}} _ _ (\bysub(Vector n, Original.Image x, v))))
    (\root.Spectral[].Idempotents[n := n].With[P := P x].annihilatesRight v);
\definition killsSecond: \forall (w: ComplementFiber x) -> (P x).map.apply w = (coordinates n).zero :=
  \fun (w: ComplementFiber x) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n}} (P x).map.apply _ _ (sym!{{Vector n}} _ _ (\bysub(Vector n, Other.Image x, w))))
    (\root.Spectral[].Idempotents[n := n].With[P := P x].annihilates w);
\definition firstInverse: \forall (v: Original.Fiber x)(w: ComplementFiber x) -> (P x).map.apply ((coordinates n).add v w) = v :=
  \fun (v: Original.Fiber x)(w: ComplementFiber x) => trans!{{Vector n}} _ _ _ ((P x).map.preservesAdd v w)
    (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _ (\bysub(Vector n, Original.Image x, v)) (killsSecond w)) (Laws.zeroRight v));
\definition secondInverse: \forall (v: Original.Fiber x)(w: ComplementFiber x) -> (Q x).map.apply ((coordinates n).add v w) = w :=
  \fun (v: Original.Fiber x)(w: ComplementFiber x) => trans!{{Vector n}} _ _ _ ((Q x).map.preservesAdd v w)
    (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _ (killsFirst v) (\bysub(Vector n, Other.Image x, w))) (Laws.zeroLeft w));
\definition leftInverse: \forall (v: Sum.Fiber x) -> (backward.fiber x).apply ((forward.fiber x).apply v) = v :=
  \fun (v: Sum.Fiber x) => Pair.Prop[A := Original.Fiber x, B := ComplementFiber x].ext ((backward.fiber x).apply ((forward.fiber x).apply v)) v
    (firstInverse (Pair.first (Original.Fiber x) (ComplementFiber x) v) (Pair.second (Original.Fiber x) (ComplementFiber x) v))
    (secondInverse (Pair.first (Original.Fiber x) (ComplementFiber x) v) (Pair.second (Original.Fiber x) (ComplementFiber x) v));
