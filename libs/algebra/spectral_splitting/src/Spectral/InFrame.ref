\import Spaces.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Spaces.Linear[V := Coordinates.Vector, W := Coordinates.Vector, source := Coordinates.space, target := Coordinates.space] \as End;
\import Spaces.Isomorphism[V := V, W := Coordinates.Vector, source := space, target := Coordinates.space] \as Frames;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Dimension[V := V, space := space].At[n := n] \as Dimension;
\import Polynomials.Finite[n := n, V := V, space := space].On[b := Dimension.basis frame, T := T] \as Finite;
\import matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := n] \as Matrices;
\import Matrices.Representation[] \as Representation;
\definition matrix: Matrices.Matrix := Finite.matrix;
\definition left: \forall (v: V) -> frame.backward.apply (frame.forward.apply v) = v := (Frames.laws frame).leftInverse;
\definition right: \forall (v: Coordinates.Vector) -> frame.forward.apply (frame.backward.apply v) = v := (Frames.laws frame).rightInverse;
\definition operatorFormula: \forall (v: Coordinates.Vector) -> Finite.coordinateOperator.apply v = frame.forward.apply (T.apply (frame.backward.apply v)) :=
  \fun (v: Coordinates.Vector) => congr!{V Coordinates.Vector} (\fun (w: V) => frame.forward.apply (T.apply w)) _ _ (Dimension.synthesis frame v);
\definition matrixFormula: \forall (v: Coordinates.Vector) -> (Matrices.linear matrix).apply v = frame.forward.apply (T.apply (frame.backward.apply v)) :=
  \fun (v: Coordinates.Vector) => trans!{Coordinates.Vector} _ _ _
    (congr!{End.Map Coordinates.Vector} (\fun (f: End.Map) => f.apply v) _ _ (Representation.linearEntries Finite.coordinateOperator)) (operatorFormula v);
\definition OffSpectrum: \Prop := \parent.At[n := n].Splitting[A := matrix].OffSpectrum;
\module Separated(off: OffSpectrum);
