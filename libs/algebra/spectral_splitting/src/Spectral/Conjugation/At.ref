\import matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := n] \as M;
\import Spaces.Coordinates[I := Fin.Fin n] \as Coordinates;
\definition Vector: \Set := Coordinates.Vector;
\definition conjugate[v: Vector]: Vector := \fun (i: Fin.Fin n) => Complex.conj (v i);
\definition involution[v: Vector]: conjugate (conjugate v) = v := \axiom:funext(conjugate (conjugate v), v, \fun (i: Fin.Fin n) => ComplexLaws.conjConj (v i));
\module On(A: M.Matrix, off: \root.Spectral[].At[n := n].Splitting[A := A].OffSpectrum,
  real: \forall (v: Vector) -> conjugate ((M.linear A).apply v) = (M.linear A).apply (conjugate v));
