\import Polynomials.At[n := n] \as PolynomialMatrices;
\import matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := n] \as Matrices;
\import matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n] \as Inversion;
\import Spaces.Coordinates[I := Fin.Fin n] \as Coordinates;
\definition Vector: \Set := Coordinates.Vector;
\import Spaces.Linear[V := Vector, W := Vector, source := Coordinates.space, target := Coordinates.space] \as End;
\import End.Composition[U := Vector, domain := Coordinates.space] \as Compose;
\import Hermitian.At[n := n].Square[] \as Square;
\module Weights;
\module Characteristic;
\module Splitting(A: Matrices.Matrix);
\module Continuous(X: \Set, source: topology.Topology[Carrier := X].Topology, A: X -> Matrices.Matrix,
  regular: \root.Spectral[].At[n := n].Characteristic[].Families[X := X, source := source].Regular A,
  off: \forall (x: X) -> \root.Spectral[].At[n := n].Splitting[A := A x].OffSpectrum);
\module Idempotent(P: End.Map, idempotent: \forall (v: Vector) -> P.apply (P.apply v) = P.apply v);
\module Pencil(A: Matrices.Matrix, z: C.Complex);
\module Eigenvalues(A: Matrices.Matrix);
\module On(A: Matrices.Matrix, factors: Polynomials.Factorization (PolynomialMatrices.characteristic A));
\module Families(X: \Set, source: topology.Topology[Carrier := X].Topology, T: X -> End.Map,
  regularT: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular source T);

\module Homotopy(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact baseSpace,
  A: std.Data[].Pair[].Times^[algebraic_topology.Interval[].Carrier, X] -> Matrices.Matrix,
  regular: \root.Spectral[].At[n := n].Characteristic[].Families[X := std.Data[].Pair[].Times^[algebraic_topology.Interval[].Carrier, X],
    source := topological_constructions.Product[A := algebraic_topology.Interval[].Carrier, B := X].topology algebraic_topology.Interval[].topology baseSpace].Regular A,
  off: \forall (p: std.Data[].Pair[].Times^[algebraic_topology.Interval[].Carrier, X]) -> \root.Spectral[].At[n := n].Splitting[A := A p].OffSpectrum);
