\definition inclusion[x: X]: Cylinder.CarrierSet := Pair.pair I.Carrier X t x;
\definition cylinderContinuous: topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace topology inclusion :=
  Cylinder.Universal[X := X].pairContinuous baseSpace I.topology baseSpace (\fun (_: X) => t) (\fun (x: X) => x)
    (topology.Maps[A := X, B := I.Carrier].constantContinuous baseSpace I.topology t) (topology.Maps[A := X, B := X].Identity[].continuous baseSpace);
\definition continuous: topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace originalBundle.baseSpace inclusion :=
  \idelim topology = originalBundle.baseSpace \with space: topology.Topology[Carrier := Cylinder.CarrierSet].Topology =>
    topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace space inclusion \by {
      base: cylinderContinuous, equality: sym!{{topology.Topology[Carrier := Cylinder.CarrierSet].Topology}} _ _ sameBase
    };
\definition Fiber[x: X]: \Set := F (inclusion x);
\import Bundles.Family[X := Cylinder.CarrierSet, F := F].Of[bundle := originalBundle].Pullback[Y := X, source := baseSpace, f := inclusion] \as Pulled;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Pulled.pulled continuous;
\import Complements.Projection[X := Cylinder.CarrierSet, n := n, baseSpace := originalBundle.baseSpace, P := Image.projection, regular := Image.regular] \as Projected;
\import Projected.Pullback[Y := X, source := baseSpace, f := inclusion, regularBase := continuous] \as ProjectedPullback;
\import \root.Spectral[].PullbackIsomorphism[X := Cylinder.CarrierSet, F := F, G := Image.ImageFiber, first := originalBundle, second := Image.imageBundle,
  iso := Image.isomorphism, Y := X, source := baseSpace, f := inclusion, regularFirst := continuous, regularSecond := continuous] \as OriginalComparison;
\import Motion.Slice[t := t] \as Target;
\import BundleOperations.IsomorphismComposition[X := X, F := Fiber, G := (\fun (x: X) => Image.ImageFiber (inclusion x)), H := Target.Fiber,
  source := bundle, middle := OriginalComparison.secondBundle, target := Target.bundle] \as Composition;
\definition comparison: Bundles.Isomorphisms[X := X, F := Fiber, G := Target.Fiber, source := bundle, target := Target.bundle].Isomorphism :=
  Composition.compose OriginalComparison.isomorphism ProjectedPullback.isomorphism;
