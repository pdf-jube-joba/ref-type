\import \root.Spectral[].InFrame[V := V, space := space, T := T, n := m, frame := other] \as Other;
\definition otherOff: Other.OffSpectrum := Other.Eigenvalues[].off (\root.Spectral[].InFrame[V := V, space := space, T := T, n := n, frame := frame].Eigenvalues[].noUnitEigen off);
\definition same: \forall (v: V) -> value.apply v = Other.Separated[off := otherOff].value.apply v :=
  \parent.Comparison[m := m, other := other, otherOff := otherOff].same;
