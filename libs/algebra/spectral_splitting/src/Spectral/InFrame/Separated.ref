\import \root.Spectral[].At[n := n].Splitting[A := matrix].Separated[off := off] \as Projection;
\definition coordinateProjection: End.Map := Projection.projection;
\import End.Composition[U := V, domain := space] \as Into;
\import Spaces.Linear[V := Coordinates.Vector, W := V, source := Coordinates.space, target := space].Composition[U := V, domain := space] \as Return;
\definition value: Spaces.Linear[V := V, W := V, source := space, target := space].Map := Return.compose frame.backward (Into.compose Projection.projection frame.forward);
\definition idempotent: \forall (v: V) -> value.apply (value.apply v) = value.apply v :=
  \fun (v: V) => trans!{V} _ _ _
    (congr!{Coordinates.Vector V} (\fun (w: Coordinates.Vector) => frame.backward.apply (Projection.projection.apply w)) _ _
      (right (Projection.projection.apply (frame.forward.apply v))))
    (congr!{Coordinates.Vector V} frame.backward.apply _ _ (Projection.idempotent (frame.forward.apply v)));
\module Comparison(m: N.Nat^,
  other: Spaces.Isomorphism[V := V, W := Fin.Fin m -> C.Complex, source := space, target := Spaces.Coordinates[I := Fin.Fin m].space].Isomorphism,
  otherOff: \root.Spectral[].InFrame[V := V, space := space, T := T, n := m, frame := other].OffSpectrum);

\module ChangeFrame(m: N.Nat^,
  other: Spaces.Isomorphism[V := V, W := Fin.Fin m -> C.Complex, source := space, target := Spaces.Coordinates[I := Fin.Fin m].space].Isomorphism);
