\import std.Data[].Pair[] \as Pair;
\import algebraic_topology.Interval[] \as I;
\import topological_constructions.Product[A := I.Carrier, B := I.Carrier] \as Parameters;
\definition topology: topology.Topology[Carrier := Parameters.CarrierSet].Topology := Parameters.topology I.topology I.topology;
\definition parameter[p: Parameters.CarrierSet]: C.Complex := C.Def[].ofReal (Pair.first I.Carrier I.Carrier p);
\import topological_constructions.Product[A := Real.Real, B := Real.Real] \as PlaneProduct;
\definition parameterContinuous: topology.Continuity[A := Parameters.CarrierSet, B := C.Complex].Continuous topology Plane.topology parameter :=
  PlaneProduct.Universal[X := Parameters.CarrierSet].pairContinuous topology metric_spaces.RealLine[].topology metric_spaces.RealLine[].topology
    (\fun (p: Parameters.CarrierSet) => Pair.first I.Carrier I.Carrier p) (\fun (_: Parameters.CarrierSet) => Real.zero)
    (topology.Composition[A := Parameters.CarrierSet, B := I.Carrier, C := Real.Real].composeContinuous topology I.topology metric_spaces.RealLine[].topology
      (Pair.first I.Carrier I.Carrier) (\fun (t: I.Carrier) => t) (Parameters.Maps[].firstContinuous I.topology I.topology) I.inclusionContinuous)
    (topology.Maps[A := Parameters.CarrierSet, B := Real.Real].constantContinuous topology metric_spaces.RealLine[].topology Real.zero);
\definition matrixFamily[p: Parameters.CarrierSet]: Matrices.Matrix := matrix (parameter p);
\definition regularFamily: Model.Characteristic[].Families[X := Parameters.CarrierSet, source := topology].Regular matrixFamily :=
  \fun (i, j: Fin.Fin two) => topology.Composition[A := Parameters.CarrierSet, B := C.Complex, C := C.Complex].composeContinuous topology Plane.topology Plane.topology parameter
    (\fun (a: C.Complex) => matrix a i j) parameterContinuous (matrixRegular i j);
\import Model.Homotopy[X := I.Carrier, baseSpace := I.topology, compact := I.compact, A := matrixFamily, regular := regularFamily,
  off := (\fun (p: Parameters.CarrierSet) => gap (parameter p))] \as Comparison;
\definition endpointComparison: \exists Comparison.Isomorphism I.start I.end := Comparison.endpointIsomorphismExists;
