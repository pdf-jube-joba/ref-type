\import \root.Spectral[].At[n := N.Nat^::zero] \as Model;
\import matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].At[n := N.Nat^::zero] \as Matrices;
\definition matrix: Matrices.Matrix := \fun (i, j: Fin.Fin N.Nat^::zero) => Scalars.field.zero;
\definition absence: Model.Eigenvalues[A := matrix].NoUnitEigen := \fun (z: C.Complex)(_: _)(v: Fin.Fin N.Nat^::zero -> C.Complex)(_: _) =>
  Fin.Empty[A := C.Complex].unique v (\fun (_: Fin.Fin N.Nat^::zero) => Scalars.field.zero);
\definition gap: Model.Splitting[A := matrix].OffSpectrum := Model.Eigenvalues[A := matrix].off absence;
\definition projection: Spaces.Linear[V := Fin.Fin N.Nat^::zero -> C.Complex, W := Fin.Fin N.Nat^::zero -> C.Complex,
  source := Spaces.Coordinates[I := Fin.Fin N.Nat^::zero].space, target := Spaces.Coordinates[I := Fin.Fin N.Nat^::zero].space].Map := Model.Splitting[A := matrix].Separated[off := gap].projection;
\definition onEmpty: \forall (v: Fin.Fin N.Nat^::zero -> C.Complex) -> projection.apply v = v :=
  \fun (v: Fin.Fin N.Nat^::zero -> C.Complex) => Fin.Empty[A := C.Complex].unique (projection.apply v) v;
