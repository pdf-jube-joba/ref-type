\import std.Data[].Bool[] \as Bool;
\import algebraic_topology.Interval[] \as I;
\import topology.Topology[Carrier := Bool.Bool^] \as Base;
\import Complements.Examples[].FiniteBases[] \as FiniteBase;
\import Bundles.TwoRanks[n := N.Nat^::zero, m := N.Nat^::succ N.Nat^::zero] \as Mixed;
\import topological_constructions.Product[A := I.Carrier, B := Bool.Bool^] \as Cylinder;
\definition topology: topology.Topology[Carrier := Cylinder.CarrierSet].Topology := Cylinder.topology I.topology Base.Discrete;
\definition projection[p: Cylinder.CarrierSet]: Bool.Bool^ := Pair.second I.Carrier Bool.Bool^ p;
\definition projectionContinuous: topology.Continuity[A := Cylinder.CarrierSet, B := Bool.Bool^].Continuous topology Base.Discrete projection := Cylinder.Maps[].secondContinuous I.topology Base.Discrete;
\import Bundles.Family[X := Bool.Bool^, F := Mixed.Fiber].Of[bundle := Mixed.bundle].Pullback[Y := Cylinder.CarrierSet, source := topology, f := projection] \as Pulled;
\definition Fiber[p: Cylinder.CarrierSet]: \Set := Mixed.Fiber (projection p);
\definition bundle: Bundles.Family[X := Cylinder.CarrierSet, F := Fiber].Bundle := Pulled.pulled projectionContinuous;
\import BundleOperations.ZeroMap[X := Cylinder.CarrierSet, F := Fiber, G := Fiber, source := bundle, target := bundle, sameBase := \refl(topology)] \as Zero;
\definition gap: \forall (p: Cylinder.CarrierSet) -> \root.Spectral[].NoUnitEigen (Fiber p) (bundle.space p) (Zero.map.fiber p) :=
  \fun (p: Cylinder.CarrierSet) => \root.Spectral[].Nilpotent[V := Fiber p, space := bundle.space p, T := Zero.map.fiber p,
    squareZero := (\fun (v: Fiber p) => Zero.onFiber p ((Zero.map.fiber p).apply v))].noUnitEigen;
\import \root.Spectral[].BundleHomotopy[X := Bool.Bool^, baseSpace := Base.Discrete, compact := FiniteBase.compact, hausdorff := FiniteBase.hausdorff,
  F := Fiber, bundle := bundle, sameBase := \refl(topology), T := Zero.map, gap := gap] \as Comparison;
\definition endpointComparison: \exists Comparison.Isomorphism := Comparison.endpointIsomorphismExists;
