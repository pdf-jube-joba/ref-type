\import \root.Spectral[].Coefficients[].Sums[I := I] \as Sums;
\definition regular: \forall (k: N.Nat^)(xs: Lists.List[I])(f: I -> X -> Data[k]) ->
  (\forall (i: I) -> Regular[k, f i]) -> Regular[k, \fun (x: X) => Sums.sum k xs (\fun (i: I) => f i x)] :=
  \fun (k: N.Nat^) => \induction (xs: Lists.List[I]) \return \forall (f: I -> X -> Data[k]) ->
    (\forall (i: I) -> Regular[k, f i]) -> Regular[k, \fun (x: X) => Sums.sum k xs (\fun (i: I) => f i x)] \with {
    | nil: \fun (f: I -> X -> Data[k])(regular: _) => constant k (origin k)
    | cons: \fun (i: I)(xs: Lists.List[I])(previous: _)(f: I -> X -> Data[k])(regular: _) => addition k _ _ (regular i) (previous f regular)
  };
