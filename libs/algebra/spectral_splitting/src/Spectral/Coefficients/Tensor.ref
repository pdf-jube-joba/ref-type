\import Fin.Tuples[A := Fin.Fin n] \as Indices;
\import \parent.Sums[I := Fin.Fin n] \as Sums;
\import Spaces.Sums[I := Fin.Fin n] \as ScalarSums;
\import ScalarSums.Prop[] \as ScalarLaws;
\import PolynomialSpaces.Sums[I := Fin.Fin n] \as PolynomialSums;
\import PolynomialSums.Prop[] \as PolynomialLaws;
\import matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex Scalars.field].TensorSum[n := n] \as ScalarTensor;
\import matrix_invariants.Ring[K := P.Carrier, scalars := P.ring].TensorSum[n := n] \as PolynomialTensor;
\definition Tuple[r: N.Nat^]: \Set := Fin.Fin r -> Fin.Fin n;
\definition sum: \forall (r: N.Nat^) -> (Tuple r -> Data[k]) -> Data[k] :=
  \induction (r: N.Nat^) \return (Tuple r -> Data[k]) -> Data[k] \with {
    | zero: \fun (f: Tuple N.Nat^::zero -> Data[k]) => f Fin.Empty[A := Fin.Fin n].function
    | succ: \fun (r: N.Nat^)(previous: (Tuple r -> Data[k]) -> Data[k])(f: Tuple (N.Nat^::succ r) -> Data[k]) =>
      Sums.sum k (Fin.elements n) (\fun (i: Fin.Fin n) => previous (\fun (tail: Tuple r) => f (Indices.extend r i tail)))
  };
\definition polynomialLaw: \forall (r: N.Nat^)(f: Tuple r -> Data[k]) -> polynomial k (sum r f) = PolynomialTensor.sum r (\fun (t: Tuple r) => polynomial k (f t)) :=
  \induction (r: N.Nat^) \return \forall (f: Tuple r -> Data[k]) -> polynomial k (sum r f) = PolynomialTensor.sum r (\fun (t: Tuple r) => polynomial k (f t)) \with {
    | zero: \fun (f: Tuple N.Nat^::zero -> Data[k]) => \refl(polynomial k (f Fin.Empty[A := Fin.Fin n].function))
    | succ: \fun (r: N.Nat^)(previous: _)(f: Tuple (N.Nat^::succ r) -> Data[k]) => trans!{{P.Carrier}} _ _ _
      (Sums.polynomialLaw k (Fin.elements n) (\fun (i: Fin.Fin n) => sum r (\fun (tail: Tuple r) => f (Indices.extend r i tail))))
      (PolynomialLaws.congruent (Fin.elements n) _ _ (\fun (i: Fin.Fin n)(_: _) => previous (\fun (tail: Tuple r) => f (Indices.extend r i tail))))
  };
\definition leadingLaw: \forall (r: N.Nat^)(f: Tuple r -> Data[k]) -> (sum r f).top = ScalarTensor.sum r (\fun (t: Tuple r) => (f t).top) :=
  \induction (r: N.Nat^) \return \forall (f: Tuple r -> Data[k]) -> (sum r f).top = ScalarTensor.sum r (\fun (t: Tuple r) => (f t).top) \with {
    | zero: \fun (f: Tuple N.Nat^::zero -> Data[k]) => \refl((f Fin.Empty[A := Fin.Fin n].function).top)
    | succ: \fun (r: N.Nat^)(previous: _)(f: Tuple (N.Nat^::succ r) -> Data[k]) => trans!{{C.Complex}} _ _ _
      (Sums.leadingLaw k (Fin.elements n) (\fun (i: Fin.Fin n) => sum r (\fun (tail: Tuple r) => f (Indices.extend r i tail))))
      (ScalarLaws.congruent (Fin.elements n) _ _ (\fun (i: Fin.Fin n)(_: _) => previous (\fun (tail: Tuple r) => f (Indices.extend r i tail))))
  };
