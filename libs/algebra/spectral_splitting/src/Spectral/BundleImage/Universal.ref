\definition continuous: \forall (f: Y -> Family.Point) ->
  topology.Continuity[A := Y, B := Ambient.Point].Continuous source bundle.totalSpace (\fun (y: Y) => embedding (f y)) ->
  topology.Continuity[A := Y, B := Family.Point].Continuous source topology f :=
  \fun (f: _)(regular: _) => Induced.Universal[Z := Y].continuous source bundle.totalSpace embedding f regular;
