\import Spaces.Subspace[V := F x, space := bundle.space x] \as Subspaces;
\definition subspace: Subspaces.Subspace := Subspaces.Subspace {
  carrier := Image x,
  containsZero := (P.fiber x).preservesZero,
  closedAdd := \fun (v, w: F x)(fixedV: _)(fixedW: _) => trans!{{F x}} _ _ _ ((P.fiber x).preservesAdd v w)
    (congr!{{F x} {F x} {F x}} (bundle.space x).add _ _ _ _ fixedV fixedW),
  closedScale := \fun (a: C.Complex)(v: F x)(fixed: _) => trans!{{F x}} _ _ _ ((P.fiber x).preservesScale a v)
    (congr!{{F x} {F x}} ((bundle.space x).smul a) _ _ fixed)
};
\definition space: Spaces.VectorSpace (Fiber x) := Subspaces.Of[subspace := subspace].induced;
\definition inclusion: Spaces.Linear[V := Fiber x, W := F x, source := space, target := bundle.space x].Map := Subspaces.Of[subspace := subspace].inclusion;
\definition project: Spaces.Linear[V := F x, W := Fiber x, source := bundle.space x, target := space].Map := Spaces.Linear[V := F x, W := Fiber x, source := bundle.space x, target := space].Map {
  apply := \fun (v: F x) => \into[F x]((P.fiber x).apply v, Image x) \by { idempotent x v },
  preservesAdd := (P.fiber x).preservesAdd,
  preservesScale := (P.fiber x).preservesScale
};
