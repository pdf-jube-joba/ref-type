\import Spaces.Linear[V := Fiber x, W := Native.Fiber x, source := space x, target := Native.fiberSpace x] \as Forward;
\import Spaces.Linear[V := Native.Fiber x, W := Fiber x, source := Native.fiberSpace x, target := space x] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (v: Fiber x) => \into[Vector]((c.frame x).forward.apply v, Native.Image x) \by {
    trans!{Vector} _ _ _ (congr!{{F x} Vector} (\fun (w: F x) => (c.frame x).forward.apply ((P.fiber x).apply w)) _ _ (At[x := x].left v))
      (congr!{{F x} Vector} (c.frame x).forward.apply _ _ (\bysub(F x, Image x, v)))
  }, preservesAdd := (c.frame x).forward.preservesAdd, preservesScale := (c.frame x).forward.preservesScale,
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (v: Native.Fiber x) => \into[F x]((c.frame x).backward.apply v, Image x) \by {
    trans!{{F x}} _ _ _ (sym!{{F x}} _ _ (At[x := x].left ((P.fiber x).apply ((c.frame x).backward.apply v))))
      (congr!{Vector {F x}} (c.frame x).backward.apply _ _ (\bysub(Vector, Native.Image x, v)))
  }, preservesAdd := (c.frame x).backward.preservesAdd, preservesScale := (c.frame x).backward.preservesScale,
};
\import Spaces.Isomorphism[V := Fiber x, W := Native.Fiber x, source := space x, target := Native.fiberSpace x] \as Isomorphisms;
\definition frame: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (v: Fiber x) => At[x := x].left v,
  rightInverse := \fun (v: Native.Fiber x) => At[x := x].right v,
};
