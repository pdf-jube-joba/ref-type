\import \root.Spectral[].BundleImage[X := X, F := F, bundle := bundle, P := P, idempotent := idempotent] \as Original;
\import Ambient.Of[bundle := bundle].Pullback[Y := Y, source := source, f := f] \as AmbientPullback;
\definition ambientBundle: Bundles.Family[X := Y, F := \fun (y: Y) => F (f y)].Bundle := AmbientPullback.pulled regularBase;
\import Bundles.ArrowLaws[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x].Pullback[Z := Y, space := source, g := f].Of[a := P, regular := regularBase] \as PulledMap;
\import Bundles.Morphisms[X := Y, Y := Y, F := \fun (y: Y) => F (f y), G := \fun (y: Y) => F (f y), source := ambientBundle, target := ambientBundle, f := \fun (y: Y) => y] \as Endomorphisms;
\definition pulledP: Endomorphisms.Map := PulledMap.map;
\definition pulledIdempotent: \forall (y: Y)(v: F (f y)) -> (pulledP.fiber y).apply ((pulledP.fiber y).apply v) = (pulledP.fiber y).apply v := \fun (y: Y) => idempotent (f y);
\import \root.Spectral[].BundleImage[X := Y, F := (\fun (y: Y) => F (f y)), bundle := ambientBundle, P := pulledP, idempotent := pulledIdempotent] \as Other;
\import Family.Of[bundle := imageBundle].Pullback[Y := Y, source := source, f := f] \as Pulled;
\import Bundles.Family[X := Y, F := \fun (y: Y) => Fiber (f y)] \as PulledFamily;
\import Bundles.Family[X := Y, F := Other.Fiber] \as OtherFamily;
\import Bundles.Family[X := Y, F := \fun (y: Y) => F (f y)] \as PulledAmbient;
\definition firstBundle: PulledFamily.Bundle := Pulled.pulled regularBase;
\definition secondBundle: OtherFamily.Bundle := Other.imageBundle;
\import Bundles.Morphisms[X := Y, Y := Y, F := \fun (y: Y) => Fiber (f y), G := Other.Fiber, source := firstBundle, target := secondBundle, f := \fun (y: Y) => y] \as Forward;
\import Bundles.Morphisms[X := Y, Y := Y, F := Other.Fiber, G := \fun (y: Y) => Fiber (f y), source := secondBundle, target := firstBundle, f := \fun (y: Y) => y] \as Backward;
\definition forwardData: Forward.Data := Forward.Data { fiber := \fun (y: Y) => Spaces.Linear[V := Fiber (f y), W := Other.Fiber y, source := firstBundle.space y, target := secondBundle.space y].Map {
  apply := \fun (v: Fiber (f y)) => v, preservesAdd := \fun (v, w: Fiber (f y)) => \refl((firstBundle.space y).add v w), preservesScale := \fun (a: C.Complex)(v: Fiber (f y)) => \refl((firstBundle.space y).smul a v)
} };
\definition backwardData: Backward.Data := Backward.Data { fiber := \fun (y: Y) => Spaces.Linear[V := Other.Fiber y, W := Fiber (f y), source := secondBundle.space y, target := firstBundle.space y].Map {
  apply := \fun (v: Other.Fiber y) => v, preservesAdd := \fun (v, w: Other.Fiber y) => \refl((secondBundle.space y).add v w), preservesScale := \fun (a: C.Complex)(v: Other.Fiber y) => \refl((secondBundle.space y).smul a v)
} };
\definition forwardAmbient[p: PulledFamily.Point]: PulledAmbient.Point := PulledAmbient.include p.base p.vector;
\definition forwardAmbientContinuous: topology.Continuity[A := PulledFamily.Point, B := PulledAmbient.Point].Continuous Pulled.topology AmbientPullback.topology forwardAmbient :=
  AmbientPullback.Universal[Z := PulledFamily.Point].continuous Pulled.topology forwardAmbient Pulled.projectionContinuous
    (topology.Composition[A := PulledFamily.Point, B := Family.Point, C := Ambient.Point].composeContinuous Pulled.topology topology bundle.totalSpace Pulled.map embedding Pulled.mapContinuous inclusionContinuous);
\definition forward: Forward.Map := \into[Forward.Data](forwardData, Forward.Map) \by {
  Other.Universal[Y := PulledFamily.Point, source := Pulled.topology].continuous (Forward.total forwardData) forwardAmbientContinuous
};
\definition originalContinuous: topology.Continuity[A := OtherFamily.Point, B := Family.Point].Continuous Other.topology topology (\fun (p: OtherFamily.Point) => Family.include (f p.base) p.vector) :=
  Original.Universal[Y := OtherFamily.Point, source := Other.topology].continuous (\fun (p: OtherFamily.Point) => Family.include (f p.base) p.vector)
    (topology.Composition[A := OtherFamily.Point, B := PulledAmbient.Point, C := Ambient.Point].composeContinuous Other.topology AmbientPullback.topology bundle.totalSpace Other.embedding AmbientPullback.map Other.inclusionContinuous AmbientPullback.mapContinuous);
\definition backward: Backward.Map := \into[Backward.Data](backwardData, Backward.Map) \by {
  Pulled.Universal[Z := OtherFamily.Point].continuous Other.topology (Backward.total backwardData) Other.projectionContinuous originalContinuous
};
\import Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Fiber (f y), G := Other.Fiber, source := firstBundle, target := secondBundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward, leftInverse := \fun (y: Y)(v: Fiber (f y)) => \refl(v), rightInverse := \fun (y: Y)(v: Other.Fiber y) => \refl(v)
};
\definition projectNaturality: \forall (y: Y)(v: F (f y)) -> (Other.project.fiber y).apply v = (project.fiber (f y)).apply v := \fun (y: Y)(v: F (f y)) => \refl((project.fiber (f y)).apply v);
\definition inclusionNaturality: \forall (y: Y)(v: Fiber (f y)) -> (Other.inclusion.fiber y).apply v = (inclusion.fiber (f y)).apply v := \fun (y: Y)(v: Fiber (f y)) => \refl(v);
