\import AmbientCharts.In[c := c] \as Original;
\import Base.Subspace[S := c.domain] \as Subspace;
\definition baseSpace: topology.Topology[Carrier := Original.BasePoint].Topology := Subspace.topology bundle.baseSpace;
\definition Vector: \Set := Bundles.Vector c.dimension;
\definition coordinates: Spaces.VectorSpace Vector := Bundles.coordinates c.dimension;
\definition coordinateTopology: topology.Topology[Carrier := Vector].Topology := Bundles.coordinateTopology c.dimension;
\import Spaces.Linear[V := Vector, W := Vector, source := coordinates, target := coordinates] \as End;
\import BundleOperations.Chart[X := X, F := F, bundle := bundle, chart := c] \as Chart;
\module At(x: Original.BasePoint);
\import \root.Spectral[].BundleCoordinates[X := X, F := F, bundle := bundle, T := P, c := c] \as CoordinateOperator;
\definition operator[x: Original.BasePoint]: End.Map := CoordinateOperator.operator x;
\definition projection[x: Original.BasePoint]: \root.Spectral[].Idempotents[n := c.dimension].Projection :=
  \root.Spectral[].Idempotents[n := c.dimension].Projection { map := operator x, idempotent := At[x := x].idempotent };
\import Hermitian.At[n := c.dimension].Families[X := Original.BasePoint] \as Vectors;
\definition regular: Vectors.Matrix[m := c.dimension].Regular baseSpace operator := CoordinateOperator.regular;
\import \root.Spectral[].Idempotents[n := c.dimension].Image[X := Original.BasePoint, baseSpace := baseSpace, P := projection, regular := regular] \as Native;

\module Restricted(x: Original.BasePoint);
\import Bundles.Family[X := Original.BasePoint, F := Native.Fiber] \as NativeFamily;
\import NativeFamily.With[data := Native.bundle] \as NativeCharts;
\module Lift(d: NativeCharts.Chart, O: \Pow X, open: Base.IsOpenIn bundle.baseSpace O, same: d.domain = Subspace.Trace O);

\use Equality.transport;
\definition locallyTrivial: \forall (a: Original.BasePoint) -> \exists ( d: Charts.Chart \where Base.Member d.domain a ) := \block {
  \fun (a: Original.BasePoint) \then
  \takefrom d: \Cast[NativeCharts.Chart] ({ d: NativeCharts.Chart \where \In[Original.BasePoint] d.domain a }) \by NativeFamily.Of[bundle := Native.bundle].locallyTrivial a \then
  \takefrom O: \Cast[\Pow X] ({ O: \Pow X \where Logic.And[Base.IsOpenIn bundle.baseSpace O, d.domain = Subspace.Trace O] })
    \by Subspace.openRepresentation bundle.baseSpace d.domain (\bysub(NativeCharts.ChartData, NativeCharts.Chart, d)).baseOpen \then
  \let properties: Logic.And[Base.IsOpenIn bundle.baseSpace O, d.domain = Subspace.Trace O] :=
    \bysub(\Pow X, { O: \Pow X \where Logic.And[Base.IsOpenIn bundle.baseSpace O, d.domain = Subspace.Trace O] }, O) \then
  \return Logic.existsIntro[Charts.Chart, { e: Charts.Chart \where Base.Member e.domain a }]
    (Lift[d := d, O := O, open := properties.left, same := properties.right].trivialization)
    (Logic.And[_, _]::# (\bysub(X, c.domain, a))
      (transport!{\Pow Original.BasePoint} (\fun (U: \Pow Original.BasePoint) => \In[Original.BasePoint] U a) _ _ properties.right
        (\bysub(NativeCharts.Chart, { d: NativeCharts.Chart \where \In[Original.BasePoint] d.domain a }, d))))
};
