\import OppositeRegions.Cluster[k := k] \as Cluster;
\definition Base: \Set := Cluster.Base;
\definition topology: topology.Topology[Carrier := Base].Topology := Cluster.topology;
\definition coefficients[p: Base]: Roots.Vector k := Cluster.coefficients p;
\definition polynomial: \forall (p: Cluster.Base) -> Roots.polynomial k (Cluster.coefficients p) = right p := \block {
  \fun (p: Cluster.Base) \then
  \takefrom a: \Cast[Roots.Vector n] ({ a: Roots.Vector n \where Coefficients.coefficients a = p }) \by Coefficients.onto p \then
  \let at: Coefficients.coefficients a = p := \bysub(Roots.Vector n, { a: Roots.Vector n \where Coefficients.coefficients a = p }, a) \then
  \return trans!{{P.Carrier}} _ _ _ (Cluster.onRoots p a at)
    (sym!{{P.Carrier}} _ _ ((\bysub(P.Carrier, Factor B.Bool^::false p, factor B.Bool^::false p)) a at))
};
\definition continuous: topology.Continuity[A := Cluster.Base, B := Roots.Vector k].Continuous Cluster.topology
  (Roots.At[n := k].topology) (\fun (p: Cluster.Base) => Cluster.coefficients p) := Cluster.continuous oppositeLaws;
\module Families(X: \Set) {
  \import topology.Composition[A := X, B := Base, C := Roots.Vector k] \as Compose;
  \definition regular: \forall (source: topology.Topology[Carrier := X].Topology)(f: X -> Base) ->
    topology.Continuity[A := X, B := Base].Continuous source topology f ->
    topology.Continuity[A := X, B := Roots.Vector k].Continuous source (Roots.At[n := k].topology) (\fun (x: X) => coefficients (f x)) :=
    \fun (source: _)(f: _)(fc: _) => Compose.composeContinuous source topology (Roots.At[n := k].topology) f (\fun (p: Base) => coefficients p) fc continuous;
}
