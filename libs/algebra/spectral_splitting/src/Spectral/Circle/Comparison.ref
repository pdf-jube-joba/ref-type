\import \parent.At[n := n] \as Left;
\import \parent.At[n := m] \as Right;
\definition cross: \forall (p: Roots.Vector n)(q: Roots.Vector m) -> Left.OffSpectrum p -> Right.OffSpectrum q -> Polynomials.Coprime (Left.left p) (Right.right q) :=
  \fun (p: Roots.Vector n)(q: Roots.Vector m)(poff: _)(qoff: _) => Coprime.exists _ _ (Left.factorNonzero B.Bool^::true p)
    (\fun (z: C.Complex)(leftRoot: _)(rightRoot: _) => disjoint z
      (Left.factorRoot B.Bool^::true p poff z leftRoot) (Right.factorRoot B.Bool^::false q qoff z rightRoot));
