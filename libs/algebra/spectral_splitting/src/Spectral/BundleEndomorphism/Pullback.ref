\import \root.Spectral[].BundleEndomorphism[X := X, F := F, bundle := bundle, T := T, gap := gap] \as Original;
\import Family.Of[bundle := bundle].Pullback[Y := Y, source := source, f := f] \as AmbientPullback;
\definition ambientBundle: Bundles.Family[X := Y, F := \fun (y: Y) => F (f y)].Bundle := AmbientPullback.pulled regularBase;
\import Bundles.ArrowLaws[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x].Pullback[Z := Y, space := source, g := f].Of[a := T, regular := regularBase] \as MapPullback;
\definition pulledT: Bundles.Morphisms[X := Y, Y := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => F (f y)), source := ambientBundle, target := ambientBundle, f := \fun (y: Y) => y].Map := MapPullback.map;
\definition pulledGap: \forall (y: Y) -> \root.Spectral[].NoUnitEigen (F (f y)) (ambientBundle.space y) (pulledT.fiber y) := \fun (y: Y) => gap (f y);
\import \root.Spectral[].BundleEndomorphism[X := Y, F := (\fun (y: Y) => F (f y)), bundle := ambientBundle, T := pulledT, gap := pulledGap] \as Other;
\definition projectorNaturality: \forall (y: Y)(v: F (f y)) -> (Other.projector.fiber y).apply v = (Original.projector.fiber (f y)).apply v :=
  \fun (y: Y)(v: F (f y)) => \refl((Original.projector.fiber (f y)).apply v);
\import \root.Spectral[].BundleImage[X := X, F := F, bundle := bundle, P := Original.projector, idempotent := Original.idempotent].Pullback[Y := Y, source := source, f := f, regularBase := regularBase] \as ImagePullback;
\definition pulledImageBundle: Bundles.Family[X := Y, F := \fun (y: Y) => Original.Fiber (f y)].Bundle := ImagePullback.firstBundle;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => Original.Fiber (f y)), G := Other.Fiber, source := pulledImageBundle, target := Other.imageBundle].Isomorphism := ImagePullback.isomorphism;
\definition inclusionNaturality: \forall (y: Y)(v: Original.Fiber (f y)) -> (Other.inclusion.fiber y).apply ((isomorphism.forward.fiber y).apply v) = (Original.inclusion.fiber (f y)).apply v :=
  \fun (y: Y)(v: Original.Fiber (f y)) => \refl(v);
