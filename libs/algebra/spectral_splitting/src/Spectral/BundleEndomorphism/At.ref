\import \root.Spectral[].FiniteSpace[V := F x, space := bundle.space x, T := T.fiber x] \as Finite;
\definition finite: \exists Finite.Witness := \block {
  \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where Base.Member c.domain x }) \by Family.Of[bundle := bundle].locallyTrivial x \then
  \let a: \Cast[X] c.domain := \into[X](x, c.domain) \by { \bysub(Charts.Chart, { c: Charts.Chart \where Base.Member c.domain x }, c) } \then
  \return \exact(Finite.Witness {
    rank := c.dimension, frame := c.frame a,
    off := \root.Spectral[].InFrame[V := F x, space := bundle.space x, T := T.fiber x, n := c.dimension, frame := c.frame a].Eigenvalues[].off (gap x),
  }, Finite.Witness)
};
\import Finite.On[finite := finite] \as Intrinsic;
\definition projection: Spaces.Linear[V := F x, W := F x, source := bundle.space x, target := bundle.space x].Map := Intrinsic.value;
\definition inFrame: Finite.Agreement projection := Intrinsic.inFrame;
\definition idempotent: \forall (v: F x) -> projection.apply (projection.apply v) = projection.apply v := Intrinsic.idempotent;
