/* The universal property of the diagonal sign quotient. */
\import algebra.Quotient[A := Product.Pair, relation := Quotient.Equivalent].Lift[B := B] \as Mapping;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\definition onPair[p: Product.Pair]: B := values p.first p.second;
\definition respects: Mapping.Respects onPair := \fun (p, q: Product.Pair)(related: Quotient.Equivalent p q) => either!{related {onPair p = onPair q}
  {\fun (same: p = q) => congr!{{Product.Pair} B} onPair _ _ same}
  {\fun (same: ProductOperations.Diagonal[sign := diagonal].twist p = q) => trans!{B} _ _ _ (sym!{B} _ _ (invariant p.first p.second))
    (congr!{{Product.Pair} B} onPair _ _ same)}
};
\definition map[q: Carrier]: B := Mapping.apply Quotient.equivalence onPair respects q;
\definition onClass: \forall (g: G)(z: Circle.Circle) -> map (class g z) = values g z :=
  \fun (g: G)(z: Circle.Circle) => Mapping.onClass Quotient.equivalence onPair respects (Product.Pair::# g z);
