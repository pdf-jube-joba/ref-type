\import Operations.Product[H := Circle.Circle, other := Circle.group] \as Product;
\import algebra.Groups[].On[G := Product.Pair, group := Product.group] \as ProductOperations;
\definition diagonal: ProductOperations.CentralInvolution := ProductOperations.CentralInvolution {
  element := Product.Pair::# sign.element Circle.minusOne,
  central := \fun (p: Product.Pair) => Product.ext _ _ (sign.central p.first)
    (\root.Circle[].sign.central p.second),
  square := Product.ext _ _ sign.square (\root.Circle[].sign.square),
};
\import ProductOperations.Diagonal[sign := diagonal] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition group: std.Alg[].Alg[].Group[Carrier] := Quotient.group;
\definition class[g: G][z: Circle.Circle]: Carrier := Quotient.class (Product.Pair::# g z);
\definition multiplication: \forall (g, h: G)(z, w: Circle.Circle) -> group.op (class g z) (class h w) = class (Operations.mul g h) (Circle.product z w) :=
  \fun (g, h: G)(z, w: Circle.Circle) => Quotient.classMul (Product.Pair::# g z) (Product.Pair::# h w);
\definition identify: \forall (g: G)(z: Circle.Circle) -> class (Operations.mul sign.element g) (Circle.product Circle.minusOne z) = class g z :=
  \fun (g: G)(z: Circle.Circle) => Quotient.identifySign (Product.Pair::# g z);
