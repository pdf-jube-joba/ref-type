/* The twisted centralizer of the generating vectors consists of scalars. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import linear_algebra.Field[].Space[K := R.Real, field := Scalars.field] \as Spaces;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\module Dimension(n: N.Nat^);
\definition Law[n: N.Nat^]: \Prop := Dimension[n := n].Law;
\module Zero;
\module Step(n: N.Nat^);
\definition law: \forall (n: N.Nat^) -> Law n := \induction (n: N.Nat^) \return Law n \with {
  | zero: Zero[].law
  | succ: \fun (n: N.Nat^)(previous: Law n) => Step[n := n].On[previous := previous].law
};
