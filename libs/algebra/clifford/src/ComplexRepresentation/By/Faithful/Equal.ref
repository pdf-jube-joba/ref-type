\use std.Logic[].Equality[].eq_reason_in;
\definition coefficient: R.Real := dot z w;
\definition valueEquation: value g = Clifford.scale coefficient (value h) := eq_reason_in!{E.Carrier _
  "=" _ "by" { sym!{E.Carrier} _ _ (recover g z) }
  "=" _ "by" { congr!{CarrierPair E.Carrier} (projection z) _ _ same }
  "=" _ "by" { resolve z h w }
};
\definition ratio: G := Operations.mul g (Operations.inv h);
\definition ratioValue: value ratio = Clifford.scalar coefficient := eq_reason_in!{E.Carrier _
  "=" _ "by" { congr!{{Pins.Pin} E.Carrier} (\fun (k: Pins.Pin) => k.value) _ _ (embeddingProduct g (Operations.inv h)) }
  "=" _ "by" { congr!{{Pins.Pin} E.Carrier} (\fun (k: Pins.Pin) => Clifford.mul (value g) k.value) _ _ (embeddingInverse h) }
  "=" _ "by" { congr!{E.Carrier E.Carrier} (\fun (x: E.Carrier) => Clifford.mul x (embedding h).inverse) _ _ valueEquation }
  "=" _ "by" { scaleUnit coefficient (embedding h) }
};
\definition positive: coefficient = R.one -> g = h := \fun (one: _) => injective g h (Units.ext (embedding g) (embedding h)
  (eq_reason_in!{E.Carrier _
    "=" _ "by" valueEquation
    "=" _ "by" { congr!{R.Real E.Carrier} (\fun (a: R.Real) => Clifford.scale a (value h)) _ _ one }
    "=" _ "by" { Clifford.vectorSpace.scalarOne (value h) }
  }));
\definition negative: coefficient = R.neg R.one -> g = Operations.mul sign.element h := \fun (minus: _) => injective g (Operations.mul sign.element h)
  (Units.ext (embedding g) (embedding (Operations.mul sign.element h))
    (eq_reason_in!{E.Carrier _
      "=" _ "by" valueEquation
      "=" _ "by" { congr!{R.Real E.Carrier} (\fun (a: R.Real) => Clifford.scale a (value h)) _ _ minus }
      "=" _ "by" { Vectors.minusOneScale (value h) }
      "=" _ "by" { sym!{E.Carrier} _ _ (signedValue h) }
    }));
\definition equal: Extension.class g z = Extension.class h w := either!{{(\root.Euclidean[n := n].PinNorm[].scalarSign (embedding ratio) coefficient (sym!{E.Carrier} _ _ ratioValue))} {Extension.class g z = Extension.class h w}
  {\fun (one: coefficient = R.one) => \block {
    \let sameG: g = h := positive one \then
    \let samePhase: z = w := phaseInjective h z w (trans!{CarrierPair} _ _ _
      (congr!{G CarrierPair} (\fun (k: G) => raw k z) _ _ (sym!{G} _ _ sameG)) same) \then
    \return congr!{G {Circle.Circle} {Extension.Carrier}} Extension.class _ _ _ _ sameG samePhase
  }}
  {\fun (minus: coefficient = R.neg R.one) => \block {
    \let sameG: g = Operations.mul sign.element h := negative minus \then
    \let samePhase: Circle.negate z = w := phaseInjective h (Circle.negate z) w
      (eq_reason_in!{CarrierPair _
        "=" _ "by" { sym!{CarrierPair} _ _ (rawFlip h z) }
        "=" _ "by" { congr!{G CarrierPair} (\fun (k: G) => raw k z) _ _ (sym!{G} _ _ sameG) }
        "=" _ "by" same
      }) \then
    \return eq_reason_in!{{Extension.Carrier} _
      "=" _ "by" { congr!{G {Extension.Carrier}} (\fun (k: G) => Extension.class k z) _ _ sameG }
      "=" _ "by" { classFlip h z }
      "=" _ "by" { congr!{{Circle.Circle} {Extension.Carrier}} (Extension.class h) _ _ samePhase }
    }
  }}
};
