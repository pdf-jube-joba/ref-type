/* The real coefficient coordinates of the subgroup before complex extension. */
\definition Index: \Set := Coordinates.Index n;
\definition coefficient[i: Index][g: G]: R.Real := (Coordinates.coordinates n).read (value g) i;
\definition ext: \forall (g, h: G) -> (\forall (i: Index) -> coefficient i g = coefficient i h) -> g = h :=
  \fun (g, h: G)(same: _) => injective g h (Units.ext (embedding g) (embedding h)
    (Coordinates.injective n (value g) (value h) (\axiom:funext((Coordinates.coordinates n).read (value g), (Coordinates.coordinates n).read (value h), same))));
