\definition law: algebra.mul (iota (tail v)) (iota (tail v)) = algebra.smul (Clifford.quadratic (tail v)) algebra.one :=
  trans!{Carrier} _ _ _ (Clifford.cliffordRelation (tail v))
    (sym!{Carrier} _ _ (ring.semiring.multiplicative.rightIdentity (scalar (Clifford.quadratic (tail v)))));
\import Block.Square[a := iota (tail v), c := head v, q := Clifford.quadratic (tail v), law := law] \as Compute;
\definition square: Block.operatorRing.mul (vectors v) (vectors v) = Block.scalarMap (NextAlgebra.quadratic v) :=
  trans!{Block.Operator} _ _ _ Compute.square (congr!{R.Real Block.Operator} Block.scalarMap _ _
    (Arithmetic.addComm (Clifford.quadratic (tail v)) (R.mul (head v) (head v))));
