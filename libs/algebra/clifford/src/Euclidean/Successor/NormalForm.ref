/* Normal form j(a) + j(b)e_0 in the successor Clifford algebra. */
\use Equality.eq_reason;
\import \parent.Complement[] \as Coordinates;
\import \parent.Inclusion[] \as Inclusion;
\import \parent.Diagonal[] \as Diagonal;
\import Clifford.Grading[] \as Grade;
\import NextAlgebra.Grading[] \as NextGrade;
\import std.Alg[].Ring[] \as Ring;
\import algebra.Groups[].Units[A := Next.Carrier, ring := Next.ring] \as Units;
\import algebra.Group[].Of[Carrier := Next.Carrier, group := Ring.additiveGroup Next.Carrier Next.ring] \as Sum;
\import Spaces.Laws[V := Next.Carrier, space := NextAlgebra.vectorSpace] \as Vectors;
\definition gamma: Next.Carrier := Next.iota Coordinates.first;
\definition gammaSquare: NextAlgebra.mul gamma gamma = NextAlgebra.one := trans!{Next.Carrier} _ _ _
  (NextAlgebra.cliffordRelation Coordinates.first) (congr!{R.Real Next.Carrier} Next.scalar _ _ Coordinates.firstNorm);
\definition value[a, b: Carrier]: Next.Carrier := NextAlgebra.add (Inclusion.map a) (NextAlgebra.mul (Inclusion.map b) gamma);
\module Representation;
\module Commutation;
\module Operations;
\module Spanning;
\module Grading;
