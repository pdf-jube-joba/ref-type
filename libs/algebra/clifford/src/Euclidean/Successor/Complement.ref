/* Inclusion of the last n coordinates and the new first unit vector. */
\import Fin.Tuples[A := R.Real] \as Tuples;
\definition embed[v: Vector]: Next.Vector := Tuples.extend n R.zero v;
\definition first: Next.Vector := Tuples.extend n R.one space.zero;
\definition embedHead[v: Vector]: head (embed v) = R.zero := Tuples.atZero n R.zero v;
\definition embedTail[v: Vector]: tail (embed v) = v := \axiom:funext(tail (embed v), v,
  \fun (i: Fin.Fin n) => Tuples.atSuccessor n R.zero v i);
\definition firstHead: head first = R.one := Tuples.atZero n R.one space.zero;
\definition firstTail: tail first = space.zero := \axiom:funext(tail first, space.zero,
  \fun (i: Fin.Fin n) => Tuples.atSuccessor n R.one space.zero i);
\import Spaces.Linear[V := Vector, W := Next.Vector, source := space, target := Next.space] \as LinearMaps;
\definition linear: LinearMaps.Map := LinearMaps.Map {
  apply := embed,
  preservesAdd := \fun (v, w: Vector) => Tuples.extensionality n (embed (space.add v w)) (Next.space.add (embed v) (embed w))
    (trans!{R.Real} _ _ _ (embedHead (space.add v w))
      (sym!{R.Real} _ _ (trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.add _ _ _ _ (embedHead v) (embedHead w)) (Arithmetic.addZeroLeft R.zero))))
    (\fun (i: Fin.Fin n) => trans!{R.Real} _ _ _ (Tuples.atSuccessor n R.zero (space.add v w) i)
      (sym!{R.Real} _ _ (congr2!{R.Real R.Real R.Real} R.add _ _ _ _ (Tuples.atSuccessor n R.zero v i) (Tuples.atSuccessor n R.zero w i)))),
  preservesScale := \fun (a: R.Real)(v: Vector) => Tuples.extensionality n (embed (space.smul a v)) (Next.space.smul a (embed v))
    (trans!{R.Real} _ _ _ (embedHead (space.smul a v))
      (sym!{R.Real} _ _ (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.mul a) _ _ (embedHead v)) (Arithmetic.fieldMulZeroRight a))))
    (\fun (i: Fin.Fin n) => trans!{R.Real} _ _ _ (Tuples.atSuccessor n R.zero (space.smul a v) i)
      (sym!{R.Real} _ _ (congr!{R.Real R.Real} (R.mul a) _ _ (Tuples.atSuccessor n R.zero v i)))),
};
\definition embeddedDot: \forall (v, w: Vector) -> Next.dot (embed v) (embed w) = dot v w :=
  \fun (v, w: Vector) => trans!{R.Real} _ _ _
    (congr2!{R.Real R.Real R.Real} R.add _ _ _ _
      (trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.mul _ _ _ _ (embedHead v) (embedHead w)) (Arithmetic.fieldMulZeroLeft R.zero))
      (congr2!{Vector Vector R.Real} dot _ _ _ _ (embedTail v) (embedTail w))) (Arithmetic.addZeroLeft (dot v w));
\definition firstDot: \forall (v: Next.Vector) -> Next.dot first v = head v := \fun (v: Next.Vector) =>
  trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.add _ _ _ _
    (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (a: R.Real) => R.mul a (head v)) _ _ firstHead) (Arithmetic.fieldMulOneLeft (head v)))
    (trans!{R.Real} _ _ _ (congr!{Vector R.Real} (\fun (w: Vector) => dot w (tail v)) _ _ firstTail) (form.zeroLeft (tail v)))) (Arithmetic.addZeroRight (head v));
\definition firstNorm: Next.dot first first = R.one := trans!{R.Real} _ _ _ (firstDot first) firstHead;
\definition decompose[v: Next.Vector]: Next.space.add (embed (tail v)) (Next.space.smul (head v) first) = v :=
  Tuples.extensionality n (Next.space.add (embed (tail v)) (Next.space.smul (head v) first)) v
    (trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.add _ _ _ _ (embedHead (tail v))
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.mul (head v)) _ _ firstHead) (Scalars.mulOneRight (head v)))) (Arithmetic.addZeroLeft (head v)))
    (\fun (i: Fin.Fin n) => trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.add _ _ _ _
      (Tuples.atSuccessor n R.zero (tail v) i)
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.mul (head v)) _ _ (Tuples.atSuccessor n R.one space.zero i)) (Arithmetic.fieldMulZeroRight (head v)))) (Arithmetic.addZeroRight (v (Fin.succ n i))));
