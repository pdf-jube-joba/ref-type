\use std.Logic[].Equality[].eq_reason_in;
/* Grading in the complementary algebra agrees with the ambient grading. */
\import algebra.Hom[A := Carrier, B := Next.Carrier] \as Maps;
\import algebra.Hom[A := Next.Carrier, B := Next.Carrier] \as NextMaps;
\import algebra.Hom[A := Carrier, B := Carrier] \as LowerMaps;
\definition after: Maps.RingMap ring Next.ring := Maps.Composition[C := Next.Carrier].ring ring Next.ring Next.ring Inclusion.map NextGrade.map;
\definition before: Maps.RingMap ring Next.ring := LowerMaps.Composition[C := Next.Carrier].ring ring ring Next.ring Grade.map Inclusion.map;
\import Clifford.HomExt[A := Next.Carrier, target := Next.ring].Between[h := after, k := before] \as Ext;
\definition same: after = before := Ext.ext
  (\fun (a: R.Real) => eq_reason_in!{Next.Carrier _
    "=" _ "by" { congr!{Next.Carrier Next.Carrier} NextGrade.map _ _ (Inclusion.onScalar a) }
    "=" _ "by" { NextGrade.onScalar a }
    "=" _ "by" { sym!{Next.Carrier} _ _ (trans!{Next.Carrier} _ _ _ (congr!{Carrier Next.Carrier} Inclusion.map _ _ (Grade.onScalar a)) (Inclusion.onScalar a)) }
  })
  (\fun (v: Vector) => eq_reason_in!{Next.Carrier _
    "=" _ "by" { congr!{Next.Carrier Next.Carrier} NextGrade.map _ _ (Inclusion.onVector v) }
    "=" _ "by" { NextGrade.onVector (Coordinates.embed v) }
    "=" _ "by" { sym!{Next.Carrier} _ _ (eq_reason_in!{Next.Carrier _
      "=" _ "by" { congr!{Carrier Next.Carrier} Inclusion.map _ _ (Grade.onVector v) }
      "=" _ "by" { Inclusion.onNegative (iota v) }
      "=" _ "by" { congr!{Next.Carrier Next.Carrier} NextAlgebra.neg _ _ (Inclusion.onVector v) }
    }) }
  });
\definition onLower: \forall (a: Carrier) -> NextGrade.map (Inclusion.map a) = Inclusion.map (Grade.map a) :=
  \fun (a: Carrier) => congr!{{Maps.RingMap ring Next.ring} Next.Carrier} (\fun (h: Maps.RingMap ring Next.ring) => h a) _ _ same;
\definition onValue: \forall (a, b: Carrier) -> NextGrade.map (value a b) = value (Grade.map a) (Clifford.neg (Grade.map b)) :=
  \fun (a, b: Carrier) => trans!{Next.Carrier} _ _ _ (NextGrade.laws.add (Inclusion.map a) (NextAlgebra.mul (Inclusion.map b) gamma))
    (congr!{Next.Carrier Next.Carrier Next.Carrier} NextAlgebra.add _ _ _ _ (onLower a)
      (eq_reason_in!{Next.Carrier _
        "=" _ "by" { NextGrade.laws.mul (Inclusion.map b) gamma }
        "=" _ "by" { congr!{Next.Carrier Next.Carrier Next.Carrier} NextAlgebra.mul _ _ _ _ (onLower b) (NextGrade.onVector Coordinates.first) }
        "=" _ "by" { Units.mulNeg (Inclusion.map (Grade.map b)) gamma }
        "=" _ "by" { sym!{Next.Carrier} _ _ (Units.negMul (Inclusion.map (Grade.map b)) gamma) }
        "=" _ "by" { congr!{Next.Carrier Next.Carrier} (\fun (x: Next.Carrier) => NextAlgebra.mul x gamma) _ _ (sym!{Next.Carrier} _ _ (Inclusion.onNegative (Grade.map b))) }
      }));
