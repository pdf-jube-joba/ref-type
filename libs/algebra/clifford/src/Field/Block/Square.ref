\use std.Logic[].Equality[].eq_reason_in;
\import algebra.Groups[].Units[A := A, ring := sourceRing] \as Units;
\definition coefficient: K := Linear.add q (Linear.mul c c);
\definition leftTwice[x: A]: algebra.mul a (algebra.mul a x) = algebra.smul q x :=
  eq_reason_in!{A _
    "=" _ "by" { sym!{A} _ _ (Source.associative a a x) }
    "=" _ "by" { congr!{A A} (\fun (b: A) => algebra.mul b x) _ _ law }
    "=" _ "by" { sym!{A} _ _ (algebra.scalarMulLeft q algebra.one x) }
    "=" _ "by" { congr!{A A} (algebra.smul q) _ _ (sourceRing.semiring.multiplicative.leftIdentity x) }
  };
\definition firstExpansion[x, y: A]: algebra.mul a (algebra.add (algebra.mul a x) (algebra.smul c y)) =
  algebra.add (algebra.smul q x) (algebra.smul c (algebra.mul a y)) := trans!{A} _ _ _
    (sourceRing.semiring.leftDistributive a (algebra.mul a x) (algebra.smul c y))
    (congr!{A A A} algebra.add _ _ _ _ (leftTwice x) (sym!{A} _ _ (algebra.scalarMulRight c a y)));
\definition secondExpansion[x, y: A]: algebra.mul a (algebra.add (algebra.smul c x) (algebra.neg (algebra.mul a y))) =
  algebra.add (algebra.smul c (algebra.mul a x)) (algebra.neg (algebra.smul q y)) := trans!{A} _ _ _
    (sourceRing.semiring.leftDistributive a (algebra.smul c x) (algebra.neg (algebra.mul a y)))
    (congr!{A A A} algebra.add _ _ _ _ (sym!{A} _ _ (algebra.scalarMulRight c a x))
      (trans!{A} _ _ _ (Units.mulNeg a (algebra.mul a y)) (congr!{A A} algebra.neg _ _ (leftTwice y))));
\definition scalarExpansion[x, y: A]: algebra.smul c (algebra.add (algebra.smul c x) (algebra.neg (algebra.mul a y))) =
  algebra.add (algebra.smul (Linear.mul c c) x) (algebra.neg (algebra.smul c (algebra.mul a y))) :=
  trans!{A} _ _ _ (Source.space.vectorAdd c (algebra.smul c x) (algebra.neg (algebra.mul a y)))
    (congr!{A A A} algebra.add _ _ _ _ (sym!{A} _ _ (Source.space.scalarAssoc c c x)) (Vectors.scaleNegative c (algebra.mul a y)));
\definition firstSquare[p: Pair.Carrier]: Pair.first ((map a c).apply ((map a c).apply p)) = algebra.smul coefficient (Pair.first p) := \block {
  \let x: A := Pair.first p \then
  \let y: A := Pair.second p \then
  \let cross: A := algebra.smul c (algebra.mul a y) \then
  \return eq_reason!{
    {Pair.first ((map a c).apply ((map a c).apply p))}
    "=" {algebra.add (algebra.mul a (Pair.first ((map a c).apply p))) (algebra.smul c (Pair.second ((map a c).apply p)))}
    "by" {firstApply a c ((map a c).apply p)}
    "=" {algebra.add (algebra.mul a (algebra.add (algebra.mul a x) (algebra.smul c y))) (algebra.smul c (algebra.add (algebra.smul c x) (algebra.neg (algebra.mul a y))))}
    "by" {congr!{A A A} algebra.add _ _ _ _
      (congr!{A A} (algebra.mul a) _ _ (firstApply a c p)) (congr!{A A} (algebra.smul c) _ _ (secondApply a c p))}
    "=" {algebra.add (algebra.add (algebra.smul q x) cross) (algebra.add (algebra.smul (Linear.mul c c) x) (algebra.neg cross))}
    "by" {congr!{A A A} algebra.add _ _ _ _ (firstExpansion x y) (scalarExpansion x y)}
    "=" {algebra.add (algebra.add (algebra.smul q x) (algebra.smul (Linear.mul c c) x)) (algebra.add cross (algebra.neg cross))}
    "by" {Sum.four (algebra.smul q x) cross (algebra.smul (Linear.mul c c) x) (algebra.neg cross)}
    "=" {algebra.add (algebra.add (algebra.smul q x) (algebra.smul (Linear.mul c c) x)) algebra.zero}
    "by" {congr!{A A} (algebra.add (algebra.add (algebra.smul q x) (algebra.smul (Linear.mul c c) x))) _ _ (Sum.inverseRight cross)}
    "=" {algebra.add (algebra.smul q x) (algebra.smul (Linear.mul c c) x)}
    "by" {Vectors.zeroRight (algebra.add (algebra.smul q x) (algebra.smul (Linear.mul c c) x))}
    "=" {algebra.smul coefficient x} "by" {sym!{A} _ _ (Source.space.scalarAdd q (Linear.mul c c) x)}
  }
};
\definition secondSquare[p: Pair.Carrier]: Pair.second ((map a c).apply ((map a c).apply p)) = algebra.smul coefficient (Pair.second p) := \block {
  \let x: A := Pair.first p \then
  \let y: A := Pair.second p \then
  \let cross: A := algebra.smul c (algebra.mul a x) \then
  \return eq_reason!{
    {Pair.second ((map a c).apply ((map a c).apply p))}
    "=" {algebra.add (algebra.smul c (Pair.first ((map a c).apply p))) (algebra.neg (algebra.mul a (Pair.second ((map a c).apply p))))}
    "by" {secondApply a c ((map a c).apply p)}
    "=" {algebra.add (algebra.smul c (algebra.add (algebra.mul a x) (algebra.smul c y))) (algebra.neg (algebra.mul a (algebra.add (algebra.smul c x) (algebra.neg (algebra.mul a y)))))}
    "by" {congr!{A A A} algebra.add _ _ _ _
      (congr!{A A} (algebra.smul c) _ _ (firstApply a c p))
      (congr!{A A} (\fun (z: A) => algebra.neg (algebra.mul a z)) _ _ (secondApply a c p))}
    "=" {algebra.add (algebra.add cross (algebra.smul (Linear.mul c c) y)) (algebra.neg (algebra.add cross (algebra.neg (algebra.smul q y))))}
    "by" {congr!{A A A} algebra.add _ _ _ _
      (trans!{A} _ _ _ (Source.space.vectorAdd c (algebra.mul a x) (algebra.smul c y))
        (congr!{A A} (algebra.add cross) _ _ (sym!{A} _ _ (Source.space.scalarAssoc c c y))))
      (congr!{A A} algebra.neg _ _ (secondExpansion x y))}
    "=" {algebra.add (algebra.add cross (algebra.smul (Linear.mul c c) y)) (algebra.add (algebra.neg cross) (algebra.smul q y))}
    "by" {congr!{A A} (algebra.add (algebra.add cross (algebra.smul (Linear.mul c c) y))) _ _
      (trans!{A} _ _ _ (Sum.negAdd cross (algebra.neg (algebra.smul q y)))
        (congr!{A A} (algebra.add (algebra.neg cross)) _ _ (Sum.negNeg (algebra.smul q y))))}
    "=" {algebra.add (algebra.add cross (algebra.neg cross)) (algebra.add (algebra.smul (Linear.mul c c) y) (algebra.smul q y))}
    "by" {Sum.four cross (algebra.smul (Linear.mul c c) y) (algebra.neg cross) (algebra.smul q y)}
    "=" {algebra.add algebra.zero (algebra.add (algebra.smul (Linear.mul c c) y) (algebra.smul q y))}
    "by" {congr!{A A} (\fun (z: A) => algebra.add z (algebra.add (algebra.smul (Linear.mul c c) y) (algebra.smul q y))) _ _ (Sum.inverseRight cross)}
    "=" {algebra.add (algebra.smul (Linear.mul c c) y) (algebra.smul q y)}
    "by" {Vectors.zeroLeft (algebra.add (algebra.smul (Linear.mul c c) y) (algebra.smul q y))}
    "=" {algebra.add (algebra.smul q y) (algebra.smul (Linear.mul c c) y)}
    "by" {Vectors.comm (algebra.smul (Linear.mul c c) y) (algebra.smul q y)}
    "=" {algebra.smul coefficient y} "by" {sym!{A} _ _ (Source.space.scalarAdd q (Linear.mul c c) y)}
  }
};
\definition square: End.mul (map a c) (map a c) = End.scalar coefficient := End.ext (End.mul (map a c) (map a c)) (End.scalar coefficient)
  (\fun (p: Pair.Carrier) => Pairs.ext _ _ (firstSquare p) (secondSquare p));
