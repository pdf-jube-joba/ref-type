\definition value[w: V]: V := space.add w (space.smul (Relations.polar v w) v);
\definition image: \forall (w: V) -> iota (value w) = add (iota w) (scale (Relations.polar v w) (iota v)) :=
  \fun (w: V) => trans!{Carrier} _ _ _ (injection.preservesAdd w (space.smul (Relations.polar v w) v))
    (congr!{Carrier Carrier} (add (iota w)) _ _ (injection.preservesScale (Relations.polar v w) v));
\definition action: \forall (w: V) -> Grade.action (negative v) (iota w) = iota (value w) := \block {
  \fun (w: V) \then
  \let squareValue: scale (quadratic v) (iota w) = neg (iota w) := trans!{Carrier} _ _ _
    (congr!{K Carrier} (\fun (a: K) => scale a (iota w)) _ _ (\bysub(V, { v: V \where quadratic v = Linear.neg Linear.one }, v))) (Vectors.minusOneScale (iota w)) \then
  \return trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (\fun (x: Carrier) => mul (mul x (iota w)) (neg (iota v))) _ _ (Grade.onVector v))
    (trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (\fun (x: Carrier) => mul x (neg (iota v))) _ _ (Units.negMul (iota v) (iota w)))
      (trans!{Carrier} _ _ _ (Units.negNegMul (mul (iota v) (iota w)) (iota v))
        (trans!{Carrier} _ _ _ (Relations.triple v w)
          (trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (\fun (x: Carrier) => Sum.difference (scale (Relations.polar v w) (iota v)) x) _ _ squareValue)
            (trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (add (scale (Relations.polar v w) (iota v))) _ _ (Sum.negNeg (iota w)))
              (trans!{Carrier} _ _ _ (Sum.comm (scale (Relations.polar v w) (iota v)) (iota w)) (sym!{Carrier} _ _ (image w))))))))
};
