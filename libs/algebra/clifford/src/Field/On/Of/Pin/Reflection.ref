\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Grading[] \as Grade;
\import \parent.\parent.Relations[] \as Relations;
\import Maps.Operations[] \as LinearMaps;
\import Linear.Laws[V := Carrier, space := vectorSpace] \as Vectors;
\definition negativeDifference[a, b: Carrier]: neg (Sum.difference a b) = Sum.difference b a := eq_reason_in!{Carrier _
  "=" _ "by" { Sum.negAdd a (neg b) }
  "=" _ "by" { congr!{Carrier Carrier} (add (neg a)) _ _ (Sum.negNeg b) }
  "=" _ "by" { Sum.comm (neg a) b }
};
\module Positive(v: Positive);
\module Negative(v: Negative);
