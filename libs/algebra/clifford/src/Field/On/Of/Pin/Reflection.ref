\import Maps.Operations[] \as LinearMaps;
\import Linear.Laws[V := Carrier, space := vectorSpace] \as Vectors;
\definition negativeDifference[a, b: Carrier]: neg (Sum.difference a b) = Sum.difference b a := trans!{Carrier} _ _ _
  (Sum.negAdd a (neg b)) (trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (add (neg a)) _ _ (Sum.negNeg b)) (Sum.comm (neg a) b));
\module Positive(v: Positive);
\module Negative(v: Negative);
