\use std.Logic[].Equality[].eq_reason_in;
/* Faithful complex coefficient representations of diagonal Pin extensions. */
\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import complex.Complex[] \as C;
\import C.Def[] \as Complex;
\import C.Prop[] \as ComplexLaws;
\import \root.Euclidean[n := n] \as E;
\import \root.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Clifford;
\import Clifford.Pin[] \as Pins;
\import Clifford.Relations[] \as Relations;
\import Pins.Grading[] \as PinGrading;
\import \root.Circle[] \as Circle;
\import \root.EuclideanFaithfulness[] \as Faithfulness;
\import \root.EuclideanCoordinates[] \as Coordinates;
\import algebra.Groups[].Units[A := E.Carrier, ring := E.ring] \as Units;
\import algebra.Groups[].On[G := Pins.Pin, group := Pins.group] \as PinOperations;
\import std.Alg[].Ring[] \as Ring;
\import algebra.Group[].Of[Carrier := E.Carrier, group := Ring.additiveGroup E.Carrier E.ring] \as Sum;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (Scalars.field)].Laws[V := E.Carrier, space := Clifford.vectorSpace] \as Vectors;
\import std.Data[].Pair[] \as Pair;
\import Pair.Prop[A := E.Carrier, B := E.Carrier] \as Pairs;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\use Logic.either;
\definition CarrierPair: \Set := Pair.Times^[E.Carrier, E.Carrier];
\definition pair: E.Carrier -> E.Carrier -> CarrierPair := Pair.pair E.Carrier E.Carrier;
\definition first: CarrierPair -> E.Carrier := Pair.first E.Carrier E.Carrier;
\definition second: CarrierPair -> E.Carrier := Pair.second E.Carrier E.Carrier;
\definition negativeScalar: \forall (a: R.Real)(x: E.Carrier) -> Clifford.scale (R.neg a) x = Clifford.neg (Clifford.scale a x) :=
  \fun (a: R.Real)(x: E.Carrier) => trans!{E.Carrier} _ _ _
    (congr!{E.Carrier E.Carrier} (\fun (y: E.Carrier) => Clifford.mul y x) _ _ (Relations.scalarNeg a)) (Units.negMul (Clifford.scalar a) x);
\definition bothNegative: \forall (a: R.Real)(x: E.Carrier) -> Clifford.scale (R.neg a) (Clifford.neg x) = Clifford.scale a x :=
  \fun (a: R.Real)(x: E.Carrier) => eq_reason_in!{E.Carrier _
    "=" _ "by" { negativeScalar a (Clifford.neg x) }
    "=" _ "by" { congr!{E.Carrier E.Carrier} Clifford.neg _ _ (Vectors.scaleNegative a x) }
    "=" _ "by" { Sum.negNeg (Clifford.scale a x) }
  };
\definition scaleUnit: \forall (a: R.Real)(g: Pins.Pin) -> Clifford.mul (Clifford.scale a g.value) g.inverse = Clifford.scalar a :=
  \fun (a: R.Real)(g: Pins.Pin) => eq_reason_in!{E.Carrier _
    "=" _ "by" { sym!{E.Carrier} _ _ (Clifford.algebra.scalarMulLeft a g.value g.inverse) }
    "=" _ "by" { congr!{E.Carrier E.Carrier} (Clifford.scale a) _ _ g.right }
    "=" _ "by" { E.ring.semiring.multiplicative.rightIdentity (Clifford.scalar a) }
  };
\definition scaleInjective: \forall (g: Pins.Pin)(a, b: R.Real) -> Clifford.scale a g.value = Clifford.scale b g.value -> a = b :=
  \fun (g: Pins.Pin)(a, b: R.Real)(same: _) => (Faithfulness.faithful n).scalarInjective a b
    (eq_reason_in!{E.Carrier _
      "=" _ "by" { sym!{E.Carrier} _ _ (scaleUnit a g) }
      "=" _ "by" { congr!{E.Carrier E.Carrier} (\fun (x: E.Carrier) => Clifford.mul x g.inverse) _ _ same }
      "=" _ "by" { scaleUnit b g }
    });
\module By(G: \Set, group: std.Alg[].Alg[].Group[G],
  embedding: algebra.Hom[A := G, B := Pins.Pin].GroupMap group Pins.group,
  injective: \forall (g, h: G) -> embedding g = embedding h -> g = h,
  sign: algebra.Groups[].On[G := G, group := group].CentralInvolution,
  compatible: embedding sign.element = Pins.sign);
