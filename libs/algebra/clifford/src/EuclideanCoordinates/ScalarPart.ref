/* A fixed scalar coordinate which recovers scalar multiples of the unit. */
\definition first: \forall (n: N.Nat^) -> Index n := \induction (n: N.Nat^) \return Index n \with {
  | zero: Fin.zero N.Nat^::zero
  | succ: \fun (n: N.Nat^)(previous: Index n) => Fin.Sum[m := dimension n, n := dimension n].left previous
};
\definition read[n: N.Nat^][x: \root.Euclidean[n := n].Carrier]: R.Real := (coordinates n).read x (first n);
\definition Law[n: N.Nat^]: \Prop := \forall (a: R.Real) -> read n (\root.Euclidean[n := n].scalar a) = a;
\module Step(n: N.Nat^);
\definition onScalar: \forall (n: N.Nat^) -> Law n := \induction (n: N.Nat^) \return Law n \with {
  | zero: \parent.Zero[].onScalar
  | succ: \fun (n: N.Nat^)(previous: Law n) => Step[n := n].law previous
};
