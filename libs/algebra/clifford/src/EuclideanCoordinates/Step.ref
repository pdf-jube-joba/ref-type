\use std.Logic[].Equality[].eq_reason_in;
\import \root.Euclidean[n := n] \as E;
\import \root.Euclidean[n := N.Nat^::succ n] \as Next;
\import E.Successor[].NormalForm[] \as Normal;
\import Normal.Representation[] \as Recovery;
\import Normal.Spanning[] \as Spanning;
\import Fin.Sum[m := dimension n, n := dimension n] \as Indices;
\import Indices.Tuples[A := R.Real] \as Tuples;
\module On(previous: Data[n]) {
  \definition coefficient[x: Next.Carrier]: Index (N.Nat^::succ n) -> R.Real := Tuples.join (previous.read (Recovery.left x)) (previous.read (Recovery.right x));
  \definition coordinates: Data[N.Nat^::succ n] := Data[N.Nat^::succ n] { read := coefficient };
  \definition atLeft: \forall (x: Next.Carrier)(i: Index n) -> coefficient x (Indices.left i) = previous.read (Recovery.left x) i :=
    \fun (x: Next.Carrier)(i: Index n) => Tuples.atLeft (previous.read (Recovery.left x)) (previous.read (Recovery.right x)) i;
  \definition atRight: \forall (x: Next.Carrier)(i: Index n) -> coefficient x (Indices.right i) = previous.read (Recovery.right x) i :=
    \fun (x: Next.Carrier)(i: Index n) => Tuples.atRight (previous.read (Recovery.left x)) (previous.read (Recovery.right x)) i;
  \definition injective: (\forall (x, y: E.Carrier) -> previous.read x = previous.read y -> x = y) ->
    \forall (x, y: Next.Carrier) -> coefficient x = coefficient y -> x = y := \block {
    \fun (injective: _)(x, y: Next.Carrier)(same: _) \then
    \let left: Recovery.left x = Recovery.left y := injective (Recovery.left x) (Recovery.left y)
      (\axiom:funext(previous.read (Recovery.left x), previous.read (Recovery.left y), \fun (i: Index n) =>
        eq_reason_in!{R.Real _
          "=" _ "by" { sym!{R.Real} _ _ (atLeft x i) }
          "=" _ "by" { congr!{{Index (N.Nat^::succ n) -> R.Real} R.Real} (\fun (f: Index (N.Nat^::succ n) -> R.Real) => f (Indices.left i)) _ _ same }
          "=" _ "by" { atLeft y i }
        })) \then
    \let right: Recovery.right x = Recovery.right y := injective (Recovery.right x) (Recovery.right y)
      (\axiom:funext(previous.read (Recovery.right x), previous.read (Recovery.right y), \fun (i: Index n) =>
        eq_reason_in!{R.Real _
          "=" _ "by" { sym!{R.Real} _ _ (atRight x i) }
          "=" _ "by" { congr!{{Index (N.Nat^::succ n) -> R.Real} R.Real} (\fun (f: Index (N.Nat^::succ n) -> R.Real) => f (Indices.right i)) _ _ same }
          "=" _ "by" { atRight y i }
        })) \then
    \return eq_reason_in!{Next.Carrier _
      "=" _ "by" { sym!{Next.Carrier} _ _ (Spanning.recover x) }
      "=" _ "by" { congr!{E.Carrier E.Carrier Next.Carrier} Normal.value _ _ _ _ left right }
      "=" _ "by" { Spanning.recover y }
    }
  };
}
