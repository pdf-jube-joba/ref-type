\use std.Logic[].Equality[].eq_reason_in;
\import \root.Euclidean[n := N.Nat^::zero] \as E;
\import \root.EuclideanFaithfulness[] \as Faithfulness;
\import \root.EuclideanCenter[].Zero[] \as ScalarsOnly;
\import \root.EuclideanCenter[].Dimension[n := N.Nat^::zero] \as Center;
\import \root.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form].Universal[A := R.Real, target := Spaces.ring] \as Universal;
\definition read: E.Carrier -> R.Real := Universal.extension Faithfulness.representation;
\definition onScalar: \forall (a: R.Real) -> read (E.scalar a) = a := Universal.onScalar Faithfulness.representation;
\definition recover: \forall (x: E.Carrier) -> E.scalar (read x) = x := \block {
  \fun (x: E.Carrier) \then
  \takefrom a: Center.Scalar x \by ScalarsOnly.all x \then
  \let same: E.scalar a = x := \bysub(R.Real, { a: R.Real \where E.scalar a = x }, a) \then
  \let evaluation: read x = a := trans!{R.Real} _ _ _ (congr!{E.Carrier R.Real} read _ _ (sym!{E.Carrier} _ _ same)) (onScalar a) \then
  \return trans!{E.Carrier} _ _ _ (congr!{R.Real E.Carrier} E.scalar _ _ evaluation) same
};
\definition coefficient[x: E.Carrier][i: Index N.Nat^::zero]: R.Real := read x;
\definition coordinates: Data[N.Nat^::zero] := Data[N.Nat^::zero] { read := coefficient };
\definition injective: \forall (x, y: E.Carrier) -> coefficient x = coefficient y -> x = y :=
  \fun (x, y: E.Carrier)(same: _) => eq_reason_in!{E.Carrier _
    "=" _ "by" { sym!{E.Carrier} _ _ (recover x) }
    "=" _ "by" { congr!{R.Real E.Carrier} E.scalar _ _
      (congr!{{Index N.Nat^::zero -> R.Real} R.Real} (\fun (f: Index N.Nat^::zero -> R.Real) => f (Fin.zero N.Nat^::zero)) _ _ same) }
    "=" _ "by" { recover y }
  };
