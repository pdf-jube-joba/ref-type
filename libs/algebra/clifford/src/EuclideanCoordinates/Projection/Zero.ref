\import \root.Euclidean[n := N.Nat^::zero] \as E;
\definition value: Data[N.Nat^::zero] := Data[N.Nat^::zero] {
  read := \fun (x: E.Carrier) => E.space.zero,
  onVector := \fun (v: E.Vector) => \axiom:funext(E.space.zero, v, \fun (i: Fin.Fin N.Nat^::zero) =>
    Logic.falseElim (E.space.zero i = v i) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i))),
};
