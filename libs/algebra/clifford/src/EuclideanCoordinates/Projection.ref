/* A linear-coordinate retraction of the generating vector inclusion. */
\import \parent.ScalarPart[] \as ScalarPart;
\structure Data[n: N.Nat^]: \Set := {
  read: \root.Euclidean[n := n].Carrier -> \root.Euclidean[n := n].Vector,
  onVector: \forall (v: \root.Euclidean[n := n].Vector) -> read (\root.Euclidean[n := n].iota v) = v,
};
\module Zero;
\module Step(n: N.Nat^);
\definition value: \forall (n: N.Nat^) -> Data[n] := \induction (n: N.Nat^) \return Data[n] \with {
  | zero: Zero[].value
  | succ: \fun (n: N.Nat^)(previous: Data[n]) => Step[n := n].On[previous := previous].value
};
