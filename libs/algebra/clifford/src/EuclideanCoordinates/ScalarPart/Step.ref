\use std.Logic[].Equality[].eq_reason_in;
\import \root.Euclidean[n := n] \as E;
\import \root.Euclidean[n := N.Nat^::succ n] \as Next;
\import E.Successor[].NormalForm[] \as Normal;
\import Normal.Representation[] \as Recovery;
\import Normal.Operations[] \as Operations;
\import \parent.\parent.Step[n := n].On[previous := coordinates n] \as Coefficients;
\import \root.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Algebra;
\definition leftScalar: \forall (a: R.Real) -> Recovery.left (Next.scalar a) = E.scalar a := \fun (a: R.Real) =>
  trans!{E.Carrier} _ _ _ (congr!{Next.Carrier E.Carrier} Recovery.left _ _ (sym!{Next.Carrier} _ _ (Operations.scalar a)))
    (Recovery.leftValue (E.scalar a) Algebra.zero);
\definition law: Law n -> Law (N.Nat^::succ n) := \fun (previous: Law n)(a: R.Real) =>
  eq_reason_in!{R.Real _
    "=" _ "by" { Coefficients.atLeft (Next.scalar a) (first n) }
    "=" _ "by" { congr!{E.Carrier R.Real} (\fun (x: E.Carrier) => (coordinates n).read x (first n)) _ _ (leftScalar a) }
    "=" _ "by" { previous a }
  };
