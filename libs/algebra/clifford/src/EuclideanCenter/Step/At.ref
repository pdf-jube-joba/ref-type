\use std.Logic[].Equality[].eq_reason_in;
\definition a: E.Carrier := Recovery.left x;
\definition b: E.Carrier := Recovery.right x;
\definition form: Normal.value a b = x := Spanning.recover x;
\definition equation: Normal.value (Algebra.neg (Grade.map b)) (Grade.map a) = Normal.value (Grade.map b) (Grade.map a) :=
  eq_reason_in!{Next.Carrier _
    "=" _ "by" { sym!{Next.Carrier} _ _ (Operations.rightGamma (Grade.map a) (Algebra.neg (Grade.map b))) }
    "=" _ "by" { congr!{Next.Carrier Next.Carrier} (\fun (y: Next.Carrier) => NextAlgebra.mul y Normal.gamma) _ _ (sym!{Next.Carrier} _ _ (Grading.onValue a b)) }
    "=" _ "by" { congr!{Next.Carrier Next.Carrier} (\fun (y: Next.Carrier) => NextAlgebra.mul (NextGrade.map y) Normal.gamma) _ _ form }
    "=" _ "by" { central Coordinates.first }
    "=" _ "by" { congr!{Next.Carrier Next.Carrier} (NextAlgebra.mul Normal.gamma) _ _ (sym!{Next.Carrier} _ _ form) }
    "=" _ "by" { Operations.leftGamma a b }
  };
\definition opposite: Algebra.neg (Grade.map b) = Grade.map b :=
  eq_reason_in!{E.Carrier _
    "=" _ "by" { sym!{E.Carrier} _ _ (Recovery.leftValue (Algebra.neg (Grade.map b)) (Grade.map a)) }
    "=" _ "by" { congr!{Next.Carrier E.Carrier} Recovery.left _ _ equation }
    "=" _ "by" { Recovery.leftValue (Grade.map b) (Grade.map a) }
  };
\definition bZero: b = Algebra.zero := Grade.injective b Algebra.zero
  (trans!{E.Carrier} _ _ _ (Vectors.oppositeSelfZero R.half (Grade.map b) R.Estimates[].halfDouble (sym!{E.Carrier} _ _ opposite))
    (sym!{E.Carrier} _ _ Grade.laws.zero));
\definition lowerForm: Inclusion.map a = x := eq_reason_in!{Next.Carrier _
  "=" _ "by" { sym!{Next.Carrier} _ _ (Operations.lower a) }
  "=" _ "by" { congr!{E.Carrier Next.Carrier} (Normal.value a) _ _ (sym!{E.Carrier} _ _ bZero) }
  "=" _ "by" form
};
\definition lowerCentral: Lower.Twisted a := \fun (v: E.Vector) => inclusionInjective
  (Algebra.mul (Grade.map a) (E.iota v)) (Algebra.mul (E.iota v) a)
  (eq_reason_in!{Next.Carrier _
    "=" _ "by" { Inclusion.laws.mul (Grade.map a) (E.iota v) }
    "=" _ "by" { congr!{Next.Carrier Next.Carrier Next.Carrier} NextAlgebra.mul _ _ _ _
      (sym!{Next.Carrier} _ _ (Grading.onLower a)) (Inclusion.onVector v) }
    "=" _ "by" { congr!{Next.Carrier Next.Carrier} (\fun (y: Next.Carrier) => NextAlgebra.mul (NextGrade.map y) (Next.iota (Coordinates.embed v))) _ _ lowerForm }
    "=" _ "by" { central (Coordinates.embed v) }
    "=" _ "by" { congr!{Next.Carrier Next.Carrier Next.Carrier} NextAlgebra.mul _ _ _ _
            (sym!{Next.Carrier} _ _ (Inclusion.onVector v)) (sym!{Next.Carrier} _ _ lowerForm) }
    "=" _ "by" { sym!{Next.Carrier} _ _ (Inclusion.laws.mul (E.iota v) a) }
  });
