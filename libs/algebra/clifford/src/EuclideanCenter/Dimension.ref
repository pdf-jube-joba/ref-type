\import \root.Euclidean[n := n] \as E;
\import \root.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Algebra;
\import Algebra.Grading[] \as Grade;
\definition Twisted[x: E.Carrier]: \Prop := \forall (v: E.Vector) -> Algebra.mul (Grade.map x) (E.iota v) = Algebra.mul (E.iota v) x;
\definition Scalar[x: E.Carrier]: \Set := \Cast[R.Real] ({ a: R.Real \where E.scalar a = x });
\definition Law: \Prop := \forall (x: E.Carrier) -> Twisted x -> \exists Scalar x;
