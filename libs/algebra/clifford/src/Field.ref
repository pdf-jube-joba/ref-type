\import linear_algebra.Field[].Space[K := K, field := field] \as Linear;
\import std.Alg[].Ring[] \as Ring;
\import std.Alg[].Field[] \as Fields;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\definition coefficients: Ring.CommutativeRing[K] := Fields.fieldAsCommutativeRing K field;
\module On(V: \Set, space: Linear.VectorSpace V);
\module Block(A: \Set, algebra: Ring.RingAlgebra[K, A, coefficients]);
