\definition leftIdentity: \forall (x: B) -> multiply unit x = x := \fun (x: B) => trans!{B} _ _ _
  (congr!{A B} (\fun (a: A) => forward (Source.mul a (backward x))) _ _ (laws.left Source.one))
  (trans!{B} _ _ _ (congr!{A B} forward _ _ (Source.leftIdentity (backward x))) (laws.right x));
\definition rightIdentity: \forall (x: B) -> multiply x unit = x := \fun (x: B) => trans!{B} _ _ _
  (congr!{A B} (\fun (a: A) => forward (Source.mul (backward x) a)) _ _ (laws.left Source.one))
  (trans!{B} _ _ _ (congr!{A B} forward _ _ (Source.rightIdentity (backward x))) (laws.right x));
\definition associative: \forall (x, y, z: B) -> multiply (multiply x y) z = multiply x (multiply y z) :=
  \fun (x, y, z: B) => trans!{B} _ _ _
    (congr!{A B} (\fun (a: A) => forward (Source.mul a (backward z))) _ _ (laws.left (Source.mul (backward x) (backward y))))
    (trans!{B} _ _ _ (congr!{A B} forward _ _ (Source.associative (backward x) (backward y) (backward z)))
      (congr!{A B} (\fun (a: A) => forward (Source.mul (backward x) a)) _ _ (sym!{A} _ _ (laws.left (Source.mul (backward y) (backward z))))));
\definition leftInverse: \forall (x: B) -> multiply (inverse x) x = unit := \fun (x: B) => trans!{B} _ _ _
  (congr!{A B} (\fun (a: A) => forward (Source.mul a (backward x))) _ _ (laws.left (Source.inv (backward x))))
  (congr!{A B} forward _ _ (Source.leftInverse (backward x)));
\definition rightInverse: \forall (x: B) -> multiply x (inverse x) = unit := \fun (x: B) => trans!{B} _ _ _
  (congr!{A B} (\fun (a: A) => forward (Source.mul (backward x) a)) _ _ (laws.left (Source.inv (backward x))))
  (congr!{A B} forward _ _ (Source.rightInverse (backward x)));
\definition groupLaws: Alg.GroupLaws[B, data] := Alg.GroupLaws[B, data] {
  monoid := Monoid.MonoidLaws[B, Monoid.MonoidData[B]::# unit multiply] { leftIdentity := leftIdentity, rightIdentity := rightIdentity, associative := associative },
  leftInverse := leftInverse, rightInverse := rightInverse,
};
