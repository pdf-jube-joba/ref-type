\import \root.Noncommutative[G := A, group := group] \as Source;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Monoid[] \as Monoid;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason;
\structure Inverses: \Prop := {
  left: \forall (a: A) -> backward (forward a) = a,
  right: \forall (b: B) -> forward (backward b) = b,
};
\definition unit: B := forward Source.one;
\definition multiply[x, y: B]: B := forward (Source.mul (backward x) (backward y));
\definition inverse[x: B]: B := forward (Source.inv (backward x));
\definition data: Alg.GroupData[B] := Alg.GroupData[B]::# unit multiply inverse;
\module With(laws: Inverses);
\definition groupLaws: \forall (laws: Inverses) -> Alg.GroupLaws[B, data] := \fun (laws: _) => With[laws := laws].groupLaws;
\definition transported[laws: Inverses]: Alg.Group[B] := \into[Alg.GroupData[B]](data, Alg.Group[B]) \by { groupLaws laws };
