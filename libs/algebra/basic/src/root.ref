\module Monoid;
\module Group;
\module Hom(A, B: \Set);
\module Quotient(A: \Set, relation: A -> A -> \Prop);
\module GroupCompletion;
\module Exact(A, B: \Set);
\module FreeCommutativeRing;
\module Polynomial;
\module LaurentPolynomial;
\module Noncommutative(G: \Set, group: std.Alg[].Alg[].Group[G]);
\module AmalgamatedProduct(C, A, B, P: \Set, c: std.Alg[].Alg[].Group[C], a: std.Alg[].Alg[].Group[A], b: std.Alg[].Alg[].Group[B], p: std.Alg[].Alg[].Group[P],
  intoLeft: \root.Hom[A := C, B := A].GroupMap c a, intoRight: \root.Hom[A := C, B := B].GroupMap c b,
  fromLeft: \root.Hom[A := A, B := P].GroupMap a p, fromRight: \root.Hom[A := B, B := P].GroupMap b p);
\module GroupTransport(A, B: \Set, group: std.Alg[].Alg[].Group[A], forward: A -> B, backward: B -> A);
