\definition Carrier: \Set := \Cast[G] S;
\definition unit: Carrier := \into[G](one, S) \by { closed.one };
\definition product[x, y: Carrier]: Carrier := \into[G](mul x y, S) \by { closed.mul x y (\bysub(G, S, x)) (\bysub(G, S, y)) };
\definition inverse[x: Carrier]: Carrier := \into[G](inv x, S) \by { closed.inv x (\bysub(G, S, x)) };
\definition group: Alg.Group[Carrier] := Alg.Group[Carrier] {
  unit := unit, op := product, inv := inverse,
  monoid := Monoid.MonoidLaws[Carrier, Monoid.MonoidData[Carrier]::# unit product] {
    leftIdentity := \fun (x: Carrier) => oneLeft x,
    rightIdentity := \fun (x: Carrier) => oneRight x,
    associative := \fun (x, y, z: Carrier) => assoc x y z,
  },
  leftInverse := \fun (x: Carrier) => invLeft x,
  rightInverse := \fun (x: Carrier) => invRight x,
};
