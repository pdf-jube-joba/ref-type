\use std.Logic[].Equality[].eq_reason_in;
\import algebra.Groups[].On[G := H, group := other] \as Right;
\structure Pair: \Set := {
  first: G,
  second: H,
};
\definition eta: \forall (p: Pair) -> Pair::# p.first p.second = p :=
  \induction (p: Pair) \return Pair::# p.first p.second = p \with {
    | # : \fun (x: G)(y: H) => \refl(Pair::# x y)
  };
\definition ext: \forall (p, q: Pair) -> p.first = q.first -> p.second = q.second -> p = q :=
  \fun (p, q: Pair)(first: _)(second: _) => eq_reason_in!{Pair _
    "=" _ "by" { sym!{Pair} _ _ (eta p) }
    "=" _ "by" { congr!{G H Pair} Pair::# _ _ _ _ first second }
    "=" _ "by" { eta q }
  };
\definition unit: Pair := Pair::# one Right.one;
\definition product[p, q: Pair]: Pair := Pair::# (mul p.first q.first) (Right.mul p.second q.second);
\definition inverse[p: Pair]: Pair := Pair::# (inv p.first) (Right.inv p.second);
\definition group: Alg.Group[Pair] := Alg.Group[Pair] {
  unit := unit, op := product, inv := inverse,
  monoid := Monoid.MonoidLaws[Pair, Monoid.MonoidData[Pair]::# unit product] {
    leftIdentity := \fun (p: Pair) => ext (product unit p) p (oneLeft p.first) (Right.oneLeft p.second),
    rightIdentity := \fun (p: Pair) => ext (product p unit) p (oneRight p.first) (Right.oneRight p.second),
    associative := \fun (p, q, r: Pair) => ext (product (product p q) r) (product p (product q r))
      (assoc p.first q.first r.first) (Right.assoc p.second q.second r.second),
  },
  leftInverse := \fun (p: Pair) => ext (product (inverse p) p) unit (invLeft p.first) (Right.invLeft p.second),
  rightInverse := \fun (p: Pair) => ext (product p (inverse p)) unit (invRight p.first) (Right.invRight p.second),
};
