\import algebra.Hom[A := M, B := K] \as InputHom;
\import algebra.Hom[A := Carrier, B := K] \as OutputHom;
\definition targetGroup: Alg.CommutativeGroup[K] := Ring.additiveGroup K target;
\import algebra.Group[].Of[Carrier := K, group := targetGroup] \as H;
\import C.Universal[K := K, target := targetGroup] \as Extension;
\definition InputMap: \Set := InputHom.SemiringMap semiring (Ring.ringAsSemiring K target);
\definition additiveInput[f: InputMap]: Extension.Map :=
  \into[M -> K](f, Extension.Map) \by {
    InputHom.MonoidLaws[Extension.domain, Extension.codomain, f] {
      unit := (InputHom.semiringLaws semiring (Ring.ringAsSemiring K target) f).zero,
      operation := (InputHom.semiringLaws semiring (Ring.ringAsSemiring K target) f).add,
    }
  };
\definition extend[f: InputMap]: Carrier -> K := Extension.extend (additiveInput f);
\definition includes: \forall (f: InputMap) (a: M) -> extend f (include a) = f a :=
  \fun (f: _) => Extension.extendIncludes (additiveInput f);
\definition additiveMap[f: InputMap]: OutputHom.MonoidMap C.asMonoid Extension.codomain := Extension.extension (additiveInput f);
\definition composeBefore[h: OutputHom.MonoidMap C.asMonoid Extension.codomain] [g: Endomorphism]:
  OutputHom.MonoidMap C.asMonoid Extension.codomain :=
  \into[Carrier -> K](\fun (x: _) => h (g x), OutputHom.MonoidMap C.asMonoid Extension.codomain) \by {
    OutputHom.MonoidLaws[C.asMonoid, Extension.codomain, (\fun (x: _) => h (g x))] {
      unit := trans!{K} _ _ _ (congr!{Carrier K} h _ _ ((Output.monoidLaws C.asMonoid Universal.codomain g).unit))
        ((OutputHom.monoidLaws C.asMonoid Extension.codomain h).unit),
      operation := \fun (x, y: _) => trans!{K} _ _ _ (congr!{Carrier K} h _ _ ((Output.monoidLaws C.asMonoid Universal.codomain g).operation x y))
        ((OutputHom.monoidLaws C.asMonoid Extension.codomain h).operation (g x) (g y)),
    }
  };
\definition targetMultiply[h: OutputHom.MonoidMap C.asMonoid Extension.codomain] [a: K]:
  OutputHom.MonoidMap C.asMonoid Extension.codomain :=
  \into[Carrier -> K](\fun (x: _) => target.mul a (h x), OutputHom.MonoidMap C.asMonoid Extension.codomain) \by {
    OutputHom.MonoidLaws[C.asMonoid, Extension.codomain, (\fun (x: _) => target.mul a (h x))] {
      unit := trans!{K} _ _ _ (congr!{K K} (target.mul a) _ _ ((OutputHom.monoidLaws C.asMonoid Extension.codomain h).unit))
        ((target.semiring).zeroAbsorbsRight a),
      operation := \fun (x, y: _) => trans!{K} _ _ _
        (congr!{K K} (target.mul a) _ _ ((OutputHom.monoidLaws C.asMonoid Extension.codomain h).operation x y))
        ((target.semiring).leftDistributive a (h x) (h y)),
    }
  };
\definition targetMultiplyRight[h: OutputHom.MonoidMap C.asMonoid Extension.codomain] [a: K]:
  OutputHom.MonoidMap C.asMonoid Extension.codomain :=
  \into[Carrier -> K](\fun (x: _) => target.mul (h x) a, OutputHom.MonoidMap C.asMonoid Extension.codomain) \by {
    OutputHom.MonoidLaws[C.asMonoid, Extension.codomain, (\fun (x: _) => target.mul (h x) a)] {
      unit := trans!{K} _ _ _ (congr!{K K} (\fun (x: _) => target.mul x a) _ _ ((OutputHom.monoidLaws C.asMonoid Extension.codomain h).unit))
        ((target.semiring).zeroAbsorbsLeft a),
      operation := \fun (x, y: _) => trans!{K} _ _ _
        (congr!{K K} (\fun (x: _) => target.mul x a) _ _ ((OutputHom.monoidLaws C.asMonoid Extension.codomain h).operation x y))
        ((target.semiring).rightDistributive (h x) (h y) a),
    }
  };
\definition scalar: \forall (f: InputMap) (a: M) (x: Carrier) -> extend f (scale a x) = target.mul (f a) (extend f x) :=
  \fun (f: _) (a: _) (x: _) => congr!{{Carrier -> K} K} (\fun (g: _) => g x) _ _
    (Extension.ext (composeBefore (additiveMap f) (scaleMap a)) (targetMultiply (additiveMap f) (f a))
      (\fun (b: _) => eq_reason!{{extend f (scale a (include b))}
        "=" {extend f (include (semiring.mul a b))} "by" {congr!{Carrier K} (extend f) _ _ (scaleIncludes a b)}
        "=" {f (semiring.mul a b)} "by" {includes f (semiring.mul a b)}
        "=" {target.mul (f a) (f b)} "by" {(InputHom.semiringLaws semiring (Ring.ringAsSemiring K target) f).mul a b}
        "=" {target.mul (f a) (extend f (include b))} "by" {congr!{K K} (target.mul (f a)) _ _ (sym!{K} _ _ (includes f b))}}));
\definition multiplication: \forall (f: InputMap) (x, y: Carrier) ->
  extend f (mul x y) = target.mul (extend f x) (extend f y) :=
  \fun (f: _) (x, y: _) => congr!{{Carrier -> K} K} (\fun (g: _) => g x) _ _
    (Extension.ext (composeBefore (additiveMap f) (leftMultiply y)) (targetMultiplyRight (additiveMap f) (extend f y))
      (\fun (a: _) => eq_reason!{{extend f (mul (include a) y)}
        "=" {extend f (scale a y)} "by" {congr!{Carrier K} (extend f) _ _ (mulIncludes a y)}
        "=" {target.mul (f a) (extend f y)} "by" {scalar f a y}
        "=" {target.mul (extend f (include a)) (extend f y)}
        "by" {congr!{K K} (\fun (b: _) => target.mul b (extend f y)) _ _ (sym!{K} _ _ (includes f a))}}));
\definition extension[f: InputMap]: OutputHom.RingMap ring target :=
  \into[Carrier -> K](extend f, OutputHom.RingMap ring target) \by {
    OutputHom.SemiringLaws[Ring.ringAsSemiring Carrier ring, Ring.ringAsSemiring K target, extend f] {
      zero := (OutputHom.monoidLaws C.asMonoid Extension.codomain (additiveMap f)).unit,
      one := trans!{K} _ _ _ (includes f (semiring.one)) ((InputHom.semiringLaws semiring (Ring.ringAsSemiring K target) f).one),
      add := Extension.extendAdd (additiveInput f), mul := multiplication f,
    }
  };
\definition unique: \forall (f: InputMap) (h: OutputHom.RingMap ring target) ->
  (\forall (a: M) -> h (include a) = f a) -> h = extend f := \block {
  \fun (f: InputMap) (h: OutputHom.RingMap ring target) (agrees: \forall (a: M) -> h (include a) = f a) \then
  \let additive: OutputHom.MonoidMap C.asMonoid Extension.codomain :=
    \into[Carrier -> K](h, OutputHom.MonoidMap C.asMonoid Extension.codomain) \by {
      OutputHom.MonoidLaws[C.asMonoid, Extension.codomain, h] {
        unit := (OutputHom.semiringLaws (Ring.ringAsSemiring Carrier ring) (Ring.ringAsSemiring K target) h).zero,
        operation := (OutputHom.semiringLaws (Ring.ringAsSemiring Carrier ring) (Ring.ringAsSemiring K target) h).add,
      }
    } \then
  \return Extension.unique (additiveInput f) additive agrees
};
