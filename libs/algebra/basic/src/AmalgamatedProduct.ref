\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\module To(T: \Set, target: std.Alg[].Alg[].Group[T], left: \root.Hom[A := A, B := T].GroupMap a target, right: \root.Hom[A := B, B := T].GroupMap b target);
\structure Universal: \Prop := {
  commutes: \forall (x: C) -> fromLeft (intoLeft x) = fromRight (intoRight x),
  exists: \forall (T: \Set)(target: std.Alg[].Alg[].Group[T])(left: \root.Hom[A := A, B := T].GroupMap a target)(right: \root.Hom[A := B, B := T].GroupMap b target) ->
    To[T := T, target := target, left := left, right := right].Compatible -> \exists To[T := T, target := target, left := left, right := right].Extension,
  unique: \forall (T: \Set)(target: std.Alg[].Alg[].Group[T])(left: \root.Hom[A := A, B := T].GroupMap a target)(right: \root.Hom[A := B, B := T].GroupMap b target) ->
    \forall (f, g: To[T := T, target := target, left := left, right := right].Extension) -> f = g,
};
\module Other(Q: \Set, q: std.Alg[].Alg[].Group[Q], left: \root.Hom[A := A, B := Q].GroupMap a q, right: \root.Hom[A := B, B := Q].GroupMap b q);
