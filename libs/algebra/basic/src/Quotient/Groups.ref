\import \parent.Operations[] \as Operations;
\structure Congruence[group: Alg.CommutativeGroup[A]]: \Prop := {
  equivalence: Q.EquivalenceLaws,
  addition: Q.BinaryRespects ((group.base).op),
  inverse: Q.UnaryRespects ((group.base).inv),
};
\definition add[group: Alg.CommutativeGroup[A]] [congruence: Congruence[group]]: Carrier -> Carrier -> Carrier :=
  Operations.binary (congruence.equivalence) ((group.base).op) (congruence.addition);
\definition neg[group: Alg.CommutativeGroup[A]] [congruence: Congruence[group]]: Carrier -> Carrier :=
  Operations.unary (congruence.equivalence) ((group.base).inv) (congruence.inverse);
\definition related[laws: Q.EquivalenceLaws] [x, y: A]: x = y -> relation x y :=
  \fun (equal: _) => \idelim x = y \with z: A => relation x z \by { base: laws.refl x, equality: equal };
\definition commutative: \forall (group: Alg.CommutativeGroup[A]) (congruence: Congruence[group]) (x, y: Carrier) ->
  add group congruence x y = add group congruence y x :=
  \fun (group: _) (congruence: _) => Operations.commutative (congruence.equivalence) ((group.base).op) (congruence.addition)
    (\fun (x, y: A) => related (congruence.equivalence) _ _ (group.commutative x y));
\definition quotient[group: Alg.CommutativeGroup[A]] [congruence: Congruence[group]]: Alg.CommutativeGroup[Carrier] :=
  Alg.CommutativeGroup[Carrier] {
    base := Alg.GroupData[Carrier]::# (class ((group.base).unit)) (add group congruence) (neg group congruence),
    group := Alg.GroupLaws[Carrier, (Alg.GroupData[Carrier]::# (class ((group.base).unit)) (add group congruence) (neg group congruence))] {
      monoid := Monoid.MonoidLaws[Carrier, (Monoid.MonoidData[Carrier]::# (class ((group.base).unit)) (add group congruence))] {
        leftIdentity := Operations.leftIdentity (congruence.equivalence) ((group.base).op) (congruence.addition) ((group.base).unit)
          (\fun (x: A) => related (congruence.equivalence) _ _ (((group.group).monoid).leftIdentity x)),
        rightIdentity := Operations.rightIdentity (congruence.equivalence) ((group.base).op) (congruence.addition) ((group.base).unit)
          (\fun (x: A) => related (congruence.equivalence) _ _ (((group.group).monoid).rightIdentity x)),
        associative := Operations.associative (congruence.equivalence) ((group.base).op) (congruence.addition)
          (\fun (x, y, z: A) => related (congruence.equivalence) _ _ (((group.group).monoid).associative x y z)),
      },
      leftInverse := Operations.inverseLeft (congruence.equivalence) ((group.base).op) (congruence.addition) ((group.base).inv) (congruence.inverse) ((group.base).unit)
        (\fun (x: A) => related (congruence.equivalence) _ _ ((group.group).leftInverse x)),
      rightInverse := \fun (x: Carrier) => trans!{Carrier} _ _ _ (commutative group congruence x (neg group congruence x))
        (Operations.inverseLeft (congruence.equivalence) ((group.base).op) (congruence.addition) ((group.base).inv) (congruence.inverse) ((group.base).unit)
          (\fun (x: A) => related (congruence.equivalence) _ _ ((group.group).leftInverse x)) x),
    },
    commutative := commutative group congruence,
  };
