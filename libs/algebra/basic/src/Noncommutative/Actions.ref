\structure Laws[act: G -> S -> S]: \Prop := {
  identity: \forall (s: S) -> act one s = s,
  compose: \forall (a, b: G)(s: S) -> act (mul a b) s = act b (act a s),
};
\definition Action: \Set := \Cast[G -> S -> S] ({ act: G -> S -> S \where Laws[act] });
\definition laws[act: Action]: Laws[act] := \bysub(G -> S -> S, Action, act);
\definition inverse: \forall (act: Action)(a: G)(s: S) -> act (inv a) (act a s) = s :=
  \fun (act: Action)(a: G)(s: S) => trans!{S} _ _ _ (sym!{S} _ _ ((laws act).compose a (inv a) s))
    (trans!{S} _ _ _ (congr!{G S} (\fun (g: G) => act g s) _ _ (rightInverse a)) ((laws act).identity s));
\definition Stabilizer[act: Action][s: S]: \Pow G := { a: G \where act a s = s };
\definition stabilizerLaws: \forall (act: Action)(s: S) -> SubgroupLaws[Stabilizer act s] :=
  \fun (act: Action)(s: S) => SubgroupLaws[Stabilizer act s] {
    one := (laws act).identity s,
    multiply := \fun (a, b: G)(ha: _)(hb: _) => trans!{S} _ _ _ ((laws act).compose a b s)
      (trans!{S} _ _ _ (congr!{S S} (act b) _ _ ha) hb),
    inverse := \fun (a: G)(ha: _) => trans!{S} _ _ _ (congr!{S S} (act (inv a)) _ _ (sym!{S} _ _ ha)) (inverse act a s),
  };
\definition stabilizer[act: Action][s: S]: Subgroup := \into[\Pow G](Stabilizer act s, Subgroup) \by { stabilizerLaws act s };
\definition Transitive[act: Action]: \Prop := \forall (s, t: S) -> \exists ( a: G \where act a s = t );
\module At(act: Action, point: S);
