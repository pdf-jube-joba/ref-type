\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Monoid[] \as Monoid;
\definition Equivalent(x, y: Expression): \Prop :=
  \forall (candidate: Expression -> Expression -> \Prop) -> Rules[candidate] ->
  (\forall (x, y: Expression) -> relations x y -> candidate x y) -> candidate x y;
\definition equivalence: Relation.Equivalence[Expression, Equivalent] := Relation.Equivalence[Expression, Equivalent] {
  refl := \fun (x: _) (candidate: _) (rules: Rules[candidate]) (_: _) => (rules.equivalence).refl x,
  sym := \fun (x, y: _) (xy: _) (candidate: _) (rules: Rules[candidate]) (accepts: _) =>
    (rules.equivalence).sym x y (xy candidate rules accepts),
  trans := \fun (x, y, z: _) (xy: _) (yz: _) (candidate: _) (rules: Rules[candidate]) (accepts: _) =>
    (rules.equivalence).trans x y z (xy candidate rules accepts) (yz candidate rules accepts),
};
\definition rules: Rules[Equivalent] := Rules[Equivalent] {
  equivalence := equivalence,
  addCong := \fun (x, y, u, v: Expression) (xy: Equivalent x y) (uv: Equivalent u v) (candidate: _) (laws: Rules[candidate]) (accepts: _) => laws.addCong x y u v (xy candidate laws accepts) (uv candidate laws accepts),
  negCong := \fun (x, y: Expression) (xy: Equivalent x y) (candidate: _) (laws: Rules[candidate]) (accepts: _) => laws.negCong x y (xy candidate laws accepts),
  mulCong := \fun (x, y, u, v: Expression) (xy: Equivalent x y) (uv: Equivalent u v) (candidate: _) (laws: Rules[candidate]) (accepts: _) => laws.mulCong x y u v (xy candidate laws accepts) (uv candidate laws accepts),
  zeroLeft := \fun (x: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.zeroLeft x,
  addAssoc := \fun (x, y, z: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.addAssoc x y z,
  addComm := \fun (x, y: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.addComm x y,
  inverse := \fun (x: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.inverse x,
  oneLeft := \fun (x: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.oneLeft x,
  mulAssoc := \fun (x, y, z: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.mulAssoc x y z,
  mulComm := \fun (x, y: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.mulComm x y,
  distributive := \fun (x, y, z: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.distributive x y z,
  absorbs := \fun (x: Expression) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.absorbs x,
  constantAdd := \fun (a, b: R) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.constantAdd a b,
  constantMul := \fun (a, b: R) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.constantMul a b,
  constantNeg := \fun (a: R) (candidate: _) (laws: Rules[candidate]) (_: _) => laws.constantNeg a,
};
\definition relationIncluded: \forall (x, y: Expression) -> relations x y -> Equivalent x y :=
  \fun (x, y: _) (related: _) (candidate: _) (_: Rules[candidate]) (accepts: _) => accepts x y related;
\import std.Set[].Quotient[A := Expression, Equivalent := Equivalent] \as Q;
\import algebra.Quotient[A := Expression, relation := Equivalent] \as Quotient;
\import Quotient.Operations[] \as Operations;
\definition Carrier: \Set := Q.Carrier;
\definition class: Expression -> Carrier := Q.class;
\definition zero: Carrier := class zeroExpr;
\definition one: Carrier := class oneExpr;
\definition add: Carrier -> Carrier -> Carrier := Operations.binary equivalence Expression::sum (rules.addCong);
\definition neg: Carrier -> Carrier := Operations.unary equivalence Expression::negative (rules.negCong);
\definition mul: Carrier -> Carrier -> Carrier := Operations.binary equivalence Expression::product (rules.mulCong);
\definition constant(a: R): Carrier := class (Expression::constant a);
\definition variable(a: Variables): Carrier := class (Expression::variable a);
\definition addClass: \forall (x, y: Expression) -> add (class x) (class y) = class (Expression::sum x y) := Operations.binaryClass equivalence Expression::sum (rules.addCong);
\definition negClass: \forall (x: Expression) -> neg (class x) = class (Expression::negative x) := Operations.unaryClass equivalence Expression::negative (rules.negCong);
\definition mulClass: \forall (x, y: Expression) -> mul (class x) (class y) = class (Expression::product x y) := Operations.binaryClass equivalence Expression::product (rules.mulCong);
\definition zeroLeft: \forall (x: Carrier) -> add zero x = x := Operations.leftIdentity equivalence Expression::sum (rules.addCong) zeroExpr (rules.zeroLeft);
\definition addComm: \forall (x, y: Carrier) -> add x y = add y x := Operations.commutative equivalence Expression::sum (rules.addCong) (rules.addComm);
\definition addAssoc: \forall (x, y, z: Carrier) -> add (add x y) z = add x (add y z) := Operations.associative equivalence Expression::sum (rules.addCong) (rules.addAssoc);
\definition inverseLeft: \forall (x: Carrier) -> add (neg x) x = zero := Operations.inverseLeft equivalence Expression::sum (rules.addCong) Expression::negative (rules.negCong) zeroExpr (rules.inverse);
\definition oneLeft: \forall (x: Carrier) -> mul one x = x := Operations.leftIdentity equivalence Expression::product (rules.mulCong) oneExpr (rules.oneLeft);
\definition mulComm: \forall (x, y: Carrier) -> mul x y = mul y x := Operations.commutative equivalence Expression::product (rules.mulCong) (rules.mulComm);
\definition mulAssoc: \forall (x, y, z: Carrier) -> mul (mul x y) z = mul x (mul y z) := Operations.associative equivalence Expression::product (rules.mulCong) (rules.mulAssoc);
\definition mulAdd: \forall (x, y, z: Carrier) -> mul x (add y z) = add (mul x y) (mul x z) := Operations.distributiveLeft equivalence Expression::product Expression::sum (rules.mulCong) (rules.addCong) (rules.distributive);
\definition absorbsLeft: \forall (x: Carrier) -> mul zero x = zero := Operations.absorbsLeft equivalence Expression::product (rules.mulCong) zeroExpr (rules.absorbs);
\definition ring: Ring.CommutativeRing[Carrier] := Ring.CommutativeRing[Carrier] {
  base := Ring.RingData[Carrier]::# zero one add neg mul,
  ring := Ring.RingLaws[Carrier, (Ring.RingData[Carrier]::# zero one add neg mul)] {
    semiring := Alg.SemiringLaws[Carrier, (Alg.SemiringData[Carrier]::# zero one add mul)] {
      additive := Monoid.CommutativeMonoidLaws[Carrier, (Monoid.CommutativeMonoidData[Carrier]::# (Monoid.MonoidData[Carrier]::# zero add))] {
        monoid := Monoid.MonoidLaws[Carrier, (Monoid.MonoidData[Carrier]::# zero add)] {
          leftIdentity := zeroLeft, rightIdentity := \fun (x: _) => trans!{Carrier} _ _ _ (addComm x zero) (zeroLeft x), associative := addAssoc,
        }, commutative := addComm,
      },
      multiplicative := Monoid.MonoidLaws[Carrier, (Monoid.MonoidData[Carrier]::# one mul)] {
        leftIdentity := oneLeft, rightIdentity := \fun (x: _) => trans!{Carrier} _ _ _ (mulComm x one) (oneLeft x), associative := mulAssoc,
      },
      leftDistributive := mulAdd,
      rightDistributive := \fun (x, y, z: _) => eq_reason!{{mul (add x y) z}
        "=" {mul z (add x y)} "by" {mulComm (add x y) z}
        "=" {add (mul z x) (mul z y)} "by" {mulAdd z x y}
        "=" {add (mul x z) (mul y z)} "by" {congr2!{Carrier Carrier Carrier} add _ _ _ _ (mulComm z x) (mulComm z y)}},
      zeroAbsorbsLeft := absorbsLeft, zeroAbsorbsRight := \fun (x: _) => trans!{Carrier} _ _ _ (mulComm x zero) (absorbsLeft x),
    }, additiveInverse := inverseLeft,
  }, mulCommutative := mulComm,
};
\module Universal(K: \Set, target: Ring.CommutativeRing[K]);
\import algebra.Hom[A := R, B := Carrier] \as Coefficients;
\definition coefficientMap: Coefficients.RingMap coefficientRing (Ring.commutativeRingAsRing Carrier ring) :=
  \into[R -> Carrier](constant, Coefficients.RingMap coefficientRing (Ring.commutativeRingAsRing Carrier ring)) \by {
    Coefficients.SemiringLaws[Ring.ringAsSemiring R coefficientRing, Ring.ringAsSemiring Carrier (Ring.commutativeRingAsRing Carrier ring), constant] {
      zero := \refl(zero), one := \refl(one),
      add := \fun (a, b: _) => trans!{Carrier} _ _ _
        (Quotient.classRelated equivalence (Expression::constant (coefficientRing.add a b))
          (Expression::sum (Expression::constant a) (Expression::constant b)) (rules.constantAdd a b))
        (sym!{Carrier} _ _ (addClass (Expression::constant a) (Expression::constant b))),
      mul := \fun (a, b: _) => trans!{Carrier} _ _ _
        (Quotient.classRelated equivalence (Expression::constant (coefficientRing.mul a b))
          (Expression::product (Expression::constant a) (Expression::constant b)) (rules.constantMul a b))
        (sym!{Carrier} _ _ (mulClass (Expression::constant a) (Expression::constant b))),
    }
  };
