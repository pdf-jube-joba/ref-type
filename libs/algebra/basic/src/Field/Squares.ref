\use std.Logic[].Equality[].eq_reason_in;
\definition a: K := mul x y;
\definition b: K := mul y y;
\definition cross: mul (neg y) x = neg a := trans!{K} _ _ _ (Products.negMul y x)
  (congr!{K K} neg _ _ (commutativeRing.mulCommutative y x));
\definition productZero: mul (add x (neg y)) (add x y) = zero :=
  eq_reason_in!{K _
    "=" _ "by" { ring.semiring.rightDistributive x (neg y) (add x y) }
    "=" _ "by" { congr!{K K K} add _ _ _ _ (ring.semiring.leftDistributive x x y) (ring.semiring.leftDistributive (neg y) x y) }
    "=" _ "by" { congr!{K K K} add _ _ _ _
        (congr!{K K} (\fun (c: K) => add c a) _ _ same)
        (congr!{K K K} add _ _ _ _ cross (Products.negMul y y)) }
    "=" _ "by" { congr!{K K K} add _ _ _ _ (Sum.comm b a) (sym!{K} _ _ (Sum.negAdd a b)) }
    "=" _ "by" { Sum.inverseRight (add a b) }
  };
\definition roots: Logic.Or[x = y, x = neg y] := either!{{(zeroProduct (add x (neg y)) (add x y) productZero)} {Logic.Or[x = y, x = neg y]}
  {\fun (difference: add x (neg y) = zero) => Logic.Or[_, _]::left
    (Sum.cancelRight (neg y) x y (trans!{K} _ _ _ difference (sym!{K} _ _ (Sum.inverseRight y))))}
  {\fun (sum: add x y = zero) => Logic.Or[_, _]::right (Sum.inverseUnique y x sum)}
};
