/* A ring homomorphism also acts between the opposite rings. */
\import \root.OppositeRing[A := B, ring := target] \as Other;
\import algebra.Hom[A := A, B := B] \as Hom;
\definition laws: Hom.SemiringLaws[Ring.ringAsSemiring A ring, Ring.ringAsSemiring B target, f] :=
  Hom.semiringLaws (Ring.ringAsSemiring A ring) (Ring.ringAsSemiring B target) f;
\definition map: Hom.RingMap value Other.value := \into[A -> B](f, Hom.RingMap value Other.value) \by {
  Hom.SemiringLaws[Ring.ringAsSemiring A value, Ring.ringAsSemiring B Other.value, f] {
    zero := laws.zero, one := laws.one, add := laws.add, mul := \fun (x, y: A) => laws.mul y x
  }
};
