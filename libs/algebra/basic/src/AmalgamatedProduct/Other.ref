\import \root.AmalgamatedProduct[C := C, A := A, B := B, P := Q, c := c, a := a, b := b, p := q,
  intoLeft := intoLeft, intoRight := intoRight, fromLeft := left, fromRight := right] \as Other;
\import \root.AmalgamatedProduct[C := C, A := A, B := B, P := P, c := c, a := a, b := b, p := p,
  intoLeft := intoLeft, intoRight := intoRight, fromLeft := fromLeft, fromRight := fromRight] \as Current;
\structure Isomorphism: \Set := {
  forward: \root.Hom[A := P, B := Q].GroupMap p q,
  backward: \root.Hom[A := Q, B := P].GroupMap q p,
  leftInverse: \forall (x: P) -> backward (forward x) = x,
  rightInverse: \forall (x: Q) -> forward (backward x) = x,
  left: \forall (x: A) -> forward (fromLeft x) = left x,
  right: \forall (x: B) -> forward (fromRight x) = right x,
};
\module With(current: Current.Universal, other: Other.Universal);
\definition canonicalIsomorphism: Current.Universal -> Other.Universal -> \exists Isomorphism :=
  \fun (current: _)(other: _) => \exact(With[current := current, other := other].isomorphism, Isomorphism);
