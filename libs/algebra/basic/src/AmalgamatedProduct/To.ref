\import \root.Hom[A := P, B := T] \as Hom;
\definition Compatible: \Prop := \forall (x: C) -> left (intoLeft x) = right (intoRight x);
\structure Extends[f: Hom.GroupMap p target]: \Prop := {
  left: \forall (x: A) -> f (fromLeft x) = left x,
  right: \forall (x: B) -> f (fromRight x) = right x,
};
\definition Extension: \Set := \Cast[Hom.GroupMap p target] ({ f: Hom.GroupMap p target \where Extends[f] });
