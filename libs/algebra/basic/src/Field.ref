/* Elementary cancellation and roots of quadratic equations over a field. */
\import std.Alg[].Field[] \as Fields;
\import std.Alg[].Ring[] \as Rings;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Logic.either;
\definition commutativeRing: Rings.CommutativeRing[K] := Fields.fieldAsCommutativeRing K field;
\definition ring: Rings.Ring[K] := Rings.commutativeRingAsRing K commutativeRing;
\definition zero: K := ring.zero;
\definition one: K := ring.one;
\definition add: K -> K -> K := ring.add;
\definition neg: K -> K := ring.neg;
\definition mul: K -> K -> K := ring.mul;
\import algebra.Group[].Of[Carrier := K, group := Rings.additiveGroup K ring] \as Sum;
\import algebra.Groups[].Units[A := K, ring := ring] \as Products;
\definition zeroProduct: \forall (x, y: K) -> mul x y = zero -> Logic.Or[x = zero, y = zero] :=
  \fun (x, y: K)(equal: _) => either!{{(Classical.excludedMiddle (x = zero))} {Logic.Or[x = zero, y = zero]}
    {\fun (zero: _) => Logic.Or[_, _]::left zero}
    {\fun (nonzero: Logic.Not (x = zero)) => Logic.Or[_, _]::right
      (trans!{K} _ _ _ (sym!{K} _ _ (ring.semiring.multiplicative.leftIdentity y))
        (trans!{K} _ _ _ (congr!{K K} (\fun (a: K) => mul a y) _ _ (sym!{K} _ _ (field.inverse x nonzero)))
          (trans!{K} _ _ _ (ring.semiring.multiplicative.associative (field.inv x) x y)
            (trans!{K} _ _ _ (congr!{K K} (mul (field.inv x)) _ _ equal) (ring.semiring.zeroAbsorbsRight (field.inv x))))))}
  };
\module Squares(x, y: K, same: mul x x = mul y y);
\definition sameSquares: \forall (x, y: K) -> mul x x = mul y y -> Logic.Or[x = y, x = neg y] :=
  \fun (x, y: K)(same: _) => Squares[x := x, y := y, same := same].roots;
