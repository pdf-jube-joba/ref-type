\import galois.Field[].Over[K := L, field := target].Morphism[L := M, target := output] \as After;
\import \parent.\parent.Morphism[L := M, target := output] \as Result;
\definition compose[f: Map][g: After.Map]: Result.Map := Result.Map {
  apply := \fun (x: K) => g.apply (f.apply x),
  preservesZero := trans!{M} _ _ _ (congr!{L M} g.apply _ _ f.preservesZero) g.preservesZero,
  preservesOne := trans!{M} _ _ _ (congr!{L M} g.apply _ _ f.preservesOne) g.preservesOne,
  preservesAdd := \fun (x, y: K) => trans!{M} _ _ _
    (congr!{L M} g.apply _ _ (f.preservesAdd x y)) (g.preservesAdd (f.apply x) (f.apply y)),
  preservesNeg := \fun (x: K) => trans!{M} _ _ _
    (congr!{L M} g.apply _ _ (f.preservesNeg x)) (g.preservesNeg (f.apply x)),
  preservesMul := \fun (x, y: K) => trans!{M} _ _ _
    (congr!{L M} g.apply _ _ (f.preservesMul x y)) (g.preservesMul (f.apply x) (f.apply y)),
  preservesInv := \fun (x: K) => trans!{M} _ _ _
    (congr!{L M} g.apply _ _ (f.preservesInv x)) (g.preservesInv (f.apply x)),
};
\definition composeEmbedding[f: Embedding][g: After.Embedding]: Result.Embedding := Result.Embedding {
  map := compose f.map g.map,
  injective := \fun (x, y: K)(same: _) => f.injective x y (g.injective (f.map.apply x) (f.map.apply y) same),
};
