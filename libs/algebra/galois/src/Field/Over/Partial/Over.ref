\import Subfields.Of[S := p.domain] \as Base;
\import galois.Field[].Over[K := Base.Carrier, field := Base.subfield] \as BaseField;
\import BaseField.Morphism[L := K, target := field] \as Maps;
\definition baseForward: Maps.Map := Maps.Map {
  apply := \fun (x: Base.Carrier) => p.forward x,
  preservesZero := p.hom.zero, preservesOne := p.hom.one,
  preservesAdd := \fun (x, y: Base.Carrier) => p.hom.add x y (Base.member x) (Base.member y),
  preservesNeg := \fun (x: Base.Carrier) => p.hom.neg x (Base.member x),
  preservesMul := \fun (x, y: Base.Carrier) => p.hom.mul x y (Base.member x) (Base.member y),
  preservesInv := \fun (x: Base.Carrier) => trans!{K} _ _ _
    (congr!{K K} p.forward _ _ (Base.normalizedInverse x)) (p.hom.inv x (Base.member x)),
};
\import BaseField.Polynomial[] \as BasePolynomials;
\import galois.Field[].Over[K := K, field := field].Polynomial[] \as Polynomials;
\import std.Set[].Infinite[A := Base.Carrier] \as Infinite;
\module At(a: K);
