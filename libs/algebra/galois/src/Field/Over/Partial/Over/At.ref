\import BasePolynomials.Extension[L := K, target := field].At[embedding := Base.inclusion, x := a].Comparison[M := K, output := field] \as Comparison;
\import Comparison.For[otherEmbedding := baseForward] \as Extensions;
\module Chosen(extension: Extensions.Extension);
\import Base.Polynomial[] \as BasePolynomial;
\structure Enlargement: \Set := {
  isomorphism: Isomorphism,
  extends: Extends[p, isomorphism],
  contains: Subfields.Member isomorphism.domain a,
};
\definition exists: Polynomials.AlgebraicallyClosed (\fun (x: K) => Logic.True) -> Infinite.Infinite ->
  Polynomials.Algebraic (Subfields.Member p.domain) a -> \exists Enlargement := \block {
  \fun (closed: Polynomials.AlgebraicallyClosed (\fun (x: K) => Logic.True))(infinite: Infinite.Infinite)(algebraic: _) \then
  \takefrom extension: Extensions.Extension \by Extensions.exists closed infinite (BasePolynomial.algebraic a algebraic) \then
  \return \exact(Enlargement {
    isomorphism := Chosen[extension := extension].asIsomorphism,
    extends := Chosen[extension := extension].extends,
    contains := Chosen[extension := extension].contains,
  }, Enlargement)
};
