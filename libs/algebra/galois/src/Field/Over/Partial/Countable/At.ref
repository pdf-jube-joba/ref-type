\import Subfields.Of[S := state.isomorphism.domain] \as Domain;
\import Subfields.Of[S := state.isomorphism.range] \as Range;
\import std.Set[].Infinite[A := Domain.Carrier] \as DomainInfinite;
\import std.Set[].Infinite[A := Range.Carrier] \as RangeInfinite;
\definition sourceInfinite: Conditions -> DomainInfinite.Infinite :=
  \fun (conditions: Conditions) => DomainInfinite.ofNatInjection
    (\fun (n: N.Nat^) => \into[K](index n, state.isomorphism.domain) \by { state.extends.domain (index n) (conditions.domainIndex n) })
    (\fun (n, m: N.Nat^)(same: _) => conditions.injective n m (congr!{Domain.Carrier K} Domain.forget _ _ same));
\definition rangeInfinite: Conditions -> RangeInfinite.Infinite :=
  \fun (conditions: Conditions) => RangeInfinite.ofNatInjection
    (\fun (n: N.Nat^) => \into[K](index n, state.isomorphism.range) \by { state.extends.range (index n) (conditions.rangeIndex n) })
    (\fun (n, m: N.Nat^)(same: _) => conditions.injective n m (congr!{Range.Carrier K} Range.forget _ _ same));
\definition sourceAlgebraic: Conditions -> \forall (x: K) -> Polynomials.Algebraic (Subfields.Member state.isomorphism.domain) x :=
  \fun (conditions: Conditions)(x: K) => Polynomials.algebraicMonotone (Subfields.Member initial.domain) (Subfields.Member state.isomorphism.domain) state.extends.domain x (conditions.domainAlgebraic x);
\definition rangeAlgebraic: Conditions -> \forall (x: K) -> Polynomials.Algebraic (Subfields.Member state.isomorphism.range) x :=
  \fun (conditions: Conditions)(x: K) => Polynomials.algebraicMonotone (Subfields.Member initial.range) (Subfields.Member state.isomorphism.range) state.extends.range x (conditions.rangeAlgebraic x);
