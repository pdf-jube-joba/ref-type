/* Finite straightedge-and-compass arithmetic: field operations and square roots. */
\inductive Expression: \Set :=
  | zero: Expression
  | one: Expression
  | constant: K -> Expression
  | sum: Expression -> Expression -> Expression
  | negative: Expression -> Expression
  | product: Expression -> Expression -> Expression
  | reciprocal: Expression -> Expression
  | squareRoot: K -> Expression -> Expression;
\definition evaluate: Expression -> K := \induction (e: Expression) \return K \with {
  | zero: zero
  | one: one
  | constant: \fun (x: K) => x
  | sum: \fun (left: Expression)(x: K)(right: Expression)(y: K) => add x y
  | negative: \fun (child: Expression)(x: K) => neg x
  | product: \fun (left: Expression)(x: K)(right: Expression)(y: K) => mul x y
  | reciprocal: \fun (child: Expression)(x: K) => inv x
  | squareRoot: \fun (root: K)(radicand: Expression)(x: K) => root
};
\definition Valid[S: K -> \Prop]: Expression -> \Prop := \induction (e: Expression) \return \Prop \with {
  | zero: Logic.True
  | one: Logic.True
  | constant: \fun (x: K) => S x
  | sum: \fun (left: Expression)(hx: \Prop)(right: Expression)(hy: \Prop) => Logic.And[hx, hy]
  | negative: \fun (child: Expression)(hx: \Prop) => hx
  | product: \fun (left: Expression)(hx: \Prop)(right: Expression)(hy: \Prop) => Logic.And[hx, hy]
  | reciprocal: \fun (child: Expression)(hx: \Prop) => hx
  | squareRoot: \fun (root: K)(radicand: Expression)(hx: \Prop) => Logic.And[hx, square root = evaluate radicand]
};
\structure Representation[S: K -> \Prop, x: K] := {
  expression: Expression,
  valid: Valid S expression,
  value: evaluate expression = x,
};
\definition Representable[S: K -> \Prop][x: K]: \Prop := \exists Representation[S, x];
\definition sound: \forall (S: K -> \Prop)(e: Expression) -> Valid S e -> Constructible S (evaluate e) :=
  \fun (S: _) => \induction (e: Expression) \return Valid S e -> Constructible S (evaluate e) \with {
    | zero: \fun (valid: _) => (Subfields.laws (constructibleSubfield S)).zero
    | one: \fun (valid: _) => (Subfields.laws (constructibleSubfield S)).one
    | constant: \fun (x: K)(valid: _) => constructibleContains S x valid
    | sum: \fun (left: Expression)(hl: _)(right: Expression)(hr: _)(valid: Logic.And[Valid S left, Valid S right]) =>
      (Subfields.laws (constructibleSubfield S)).add _ _ (hl valid.left) (hr valid.right)
    | negative: \fun (child: Expression)(previous: _)(valid: _) => (Subfields.laws (constructibleSubfield S)).neg _ (previous valid)
    | product: \fun (left: Expression)(hl: _)(right: Expression)(hr: _)(valid: Logic.And[Valid S left, Valid S right]) =>
      (Subfields.laws (constructibleSubfield S)).mul _ _ (hl valid.left) (hr valid.right)
    | reciprocal: \fun (child: Expression)(previous: _)(valid: _) => (Subfields.laws (constructibleSubfield S)).inv _ (previous valid)
    | squareRoot: \fun (root: K)(radicand: Expression)(previous: _)(valid: Logic.And[Valid S radicand, square root = evaluate radicand]) => constructibleRoot S root
      (\idelim evaluate radicand = square root \with x: K => Constructible S x
        \by { base: previous valid.left, equality: sym!{K} _ _ valid.right })
  };
\definition representableClosed: \forall (S: K -> \Prop) -> QuadraticClosed[Representable S] :=
  \fun (S: _) => QuadraticClosed[Representable S] {
    subfield := Subfields.Closed[Representable S] {
      zero := \exact(Representation[S, zero] {
        expression := Expression::zero, valid := Logic.True::intro, value := \refl(zero),
      }, Representation[S, zero]),
      one := \exact(Representation[S, one] {
        expression := Expression::one, valid := Logic.True::intro, value := \refl(one),
      }, Representation[S, one]),
      add := \block {
        \fun (x, y: K)(hx: _)(hy: _) \then
        \takefrom left: Representation[S, x] \by hx \then
        \takefrom right: Representation[S, y] \by hy \then
        \return \exact(Representation[S, add x y] {
          expression := Expression::sum left.expression right.expression,
          valid := Logic.And[_, _]::# left.valid right.valid,
          value := congr!{K K K} add _ _ _ _ left.value right.value,
        }, Representation[S, add x y])
      },
      neg := \block {
        \fun (x: K)(hx: _) \then
        \takefrom child: Representation[S, x] \by hx \then
        \return \exact(Representation[S, neg x] {
          expression := Expression::negative child.expression, valid := child.valid,
          value := congr!{K K} neg _ _ child.value,
        }, Representation[S, neg x])
      },
      mul := \block {
        \fun (x, y: K)(hx: _)(hy: _) \then
        \takefrom left: Representation[S, x] \by hx \then
        \takefrom right: Representation[S, y] \by hy \then
        \return \exact(Representation[S, mul x y] {
          expression := Expression::product left.expression right.expression,
          valid := Logic.And[_, _]::# left.valid right.valid,
          value := congr!{K K K} mul _ _ _ _ left.value right.value,
        }, Representation[S, mul x y])
      },
      inv := \block {
        \fun (x: K)(hx: _) \then
        \takefrom child: Representation[S, x] \by hx \then
        \return \exact(Representation[S, inv x] {
          expression := Expression::reciprocal child.expression, valid := child.valid,
          value := congr!{K K} inv _ _ child.value,
        }, Representation[S, inv x])
      },
    },
    root := \block {
      \fun (x: K)(hx: _) \then
      \takefrom radicand: Representation[S, square x] \by hx \then
      \return \exact(Representation[S, x] {
        expression := Expression::squareRoot x radicand.expression,
        valid := Logic.And[_, _]::# radicand.valid (sym!{K} _ _ radicand.value),
        value := \refl(x),
      }, Representation[S, x])
    },
  };
\definition complete: \forall (S: K -> \Prop)(x: K) -> Constructible S x -> Representable S x :=
  \fun (S: _)(x: K)(constructible: _) => constructible (Representable S) (representableClosed S)
    (\fun (a: K)(ha: _) => \exact(Representation[S, a] {
      expression := Expression::constant a, valid := ha, value := \refl(a),
    }, Representation[S, a]));
\definition characterization: \forall (S: K -> \Prop)(x: K) -> Logic.PropEquiv[Constructible S x, Representable S x] :=
  \fun (S: _)(x: K) => Logic.PropEquiv[_, _] {
    ltr := complete S x,
    rtl := \block {
      \fun (representable: _) \then
      \takefrom witness: Representation[S, x] \by representable \then
      \return \idelim evaluate witness.expression = x \with y: K => Constructible S y
        \by { base: sound S witness.expression witness.valid, equality: witness.value }
    },
  };
