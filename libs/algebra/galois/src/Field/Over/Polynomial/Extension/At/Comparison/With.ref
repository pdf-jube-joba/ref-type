\use std.Logic[].Equality[].eq_reason_in;
\import galois.Field[].Over[K := K, field := field].Polynomial[].Extension[L := M, target := output].At[embedding := otherEmbedding, x := y] \as Other;
\import OutputInto.At[coefficients := OutputMaps.ringMap otherEmbedding, x := y] \as OtherEvaluation;
\definition evaluateFactor: \forall (p, q, r: Coefficients) ->
  Raw.asPolynomial p = Abstract.mul (asPolynomial q) (Raw.asPolynomial r) ->
  value p = Target.mul (monicValue q) (value r) :=
  \fun (p, q, r: Coefficients)(equation: _) => eq_reason!{{value p}
    "=" {Evaluation.apply (Raw.asPolynomial p)} "by" {sym!{L} _ _ (Evaluation.rawAgrees p)}
    "=" {Evaluation.apply (Abstract.mul (asPolynomial q) (Raw.asPolynomial r))}
    "by" {congr!{Abstract.Carrier L} Evaluation.apply _ _ equation}
    "=" {Target.mul (Evaluation.apply (asPolynomial q)) (Evaluation.apply (Raw.asPolynomial r))}
    "by" {Evaluation.laws.mul (asPolynomial q) (Raw.asPolynomial r)}
    "=" {Target.mul (monicValue q) (value r)}
    "by" {congr!{L L L} Target.mul _ _ _ _ (Evaluation.monicAgrees q) (Evaluation.rawAgrees r)}};
\definition otherEvaluateFactor: \forall (p, q, r: Coefficients) ->
  Raw.asPolynomial p = Abstract.mul (asPolynomial q) (Raw.asPolynomial r) ->
  Other.value p = Output.mul (Other.monicValue q) (Other.value r) :=
  \fun (p, q, r: Coefficients)(equation: _) => eq_reason!{{Other.value p}
    "=" {OtherEvaluation.apply (Raw.asPolynomial p)} "by" {sym!{M} _ _ (OtherEvaluation.rawAgrees p)}
    "=" {OtherEvaluation.apply (Abstract.mul (asPolynomial q) (Raw.asPolynomial r))}
    "by" {congr!{Abstract.Carrier M} OtherEvaluation.apply _ _ equation}
    "=" {Output.mul (OtherEvaluation.apply (asPolynomial q)) (OtherEvaluation.apply (Raw.asPolynomial r))}
    "by" {OtherEvaluation.laws.mul (asPolynomial q) (Raw.asPolynomial r)}
    "=" {Output.mul (Other.monicValue q) (Other.value r)}
    "by" {congr!{M M M} Output.mul _ _ _ _ (OtherEvaluation.monicAgrees q) (OtherEvaluation.rawAgrees r)}};
\definition forward: \forall (minimal: Minimal) -> Other.monicValue minimal.polynomial.coefficients = Output.zero ->
  \forall (p: Coefficients) -> value p = Target.zero -> Other.value p = Output.zero := \block {
  \fun (minimal: Minimal)(root: _)(p: Coefficients)(vanishes: _) \then
  \takefrom quotient: Divides[minimal, p] \by divides minimal p vanishes \then
  \return eq_reason_in!{M _
    "=" _ "by" { otherEvaluateFactor p minimal.polynomial.coefficients quotient.quotient quotient.equation }
    "=" _ "by" { congr!{M M} (\fun (a: M) => Output.mul a (Other.value quotient.quotient)) _ _ root }
    "=" _ "by" { output.ring.ring.semiring.zeroAbsorbsLeft (Other.value quotient.quotient) }
  }
};
\definition monicRawValue: \forall (p: Coefficients) -> value (Raw.monic p) = monicValue p :=
  \fun (p: Coefficients) => eq_reason_in!{L _
    "=" _ "by" { sym!{L} _ _ (Evaluation.rawAgrees (Raw.monic p)) }
    "=" _ "by" { congr!{Abstract.Carrier L} Evaluation.apply _ _ (Raw.monicLaw p) }
    "=" _ "by" { Evaluation.monicAgrees p }
  };
\definition otherMonicRawValue: \forall (p: Coefficients) -> Other.value (Raw.monic p) = Other.monicValue p :=
  \fun (p: Coefficients) => eq_reason_in!{M _
    "=" _ "by" { sym!{M} _ _ (OtherEvaluation.rawAgrees (Raw.monic p)) }
    "=" _ "by" { congr!{Abstract.Carrier M} OtherEvaluation.apply _ _ (Raw.monicLaw p) }
    "=" _ "by" { OtherEvaluation.monicAgrees p }
  };
\structure Matching: \Set := {
  polynomial: Other.Minimal,
  sourceRoot: monicValue polynomial.polynomial.coefficients = Target.zero,
};
\definition matchingExists: Infinite.Infinite -> \forall (minimal: Minimal) ->
  Other.monicValue minimal.polynomial.coefficients = Output.zero -> \exists Matching := \block {
  \fun (infinite: Infinite.Infinite)(minimal: Minimal)(root: _) \then
  \takefrom other: Other.Minimal \by Other.minimalExists (\exact(Other.Root {
    coefficients := minimal.polynomial.coefficients, positive := minimal.polynomial.positive, root := root,
  }, Other.Root)) \then
  \takefrom quotient: Other.Divides[other, Raw.monic minimal.polynomial.coefficients] \by
    Other.divides other (Raw.monic minimal.polynomial.coefficients)
      (trans!{M} _ _ _ (otherMonicRawValue minimal.polynomial.coefficients) root) \then
  \let bound: Nat.Le (Lists.length K quotient.quotient) (degree minimal.polynomial.coefficients) :=
    Nat.leTrans _ _ _ quotient.bound
      (\idelim N.Nat^::succ (degree minimal.polynomial.coefficients) = Lists.length K (Raw.monic minimal.polynomial.coefficients)
        \with n: N.Nat^ => Nat.Le (NatOp.sub n (degree other.polynomial.coefficients)) (degree minimal.polynomial.coefficients) \by {
          base: DegreeArithmetic.subPositive (degree other.polynomial.coefficients) (degree minimal.polynomial.coefficients) other.polynomial.positive,
          equality: sym!{N.Nat^} _ _ (Operations.monicLength minimal.polynomial.coefficients)
        }) \then
  \let productZero: Target.mul (monicValue other.polynomial.coefficients) (value quotient.quotient) = Target.zero :=
    eq_reason!{{Target.mul (monicValue other.polynomial.coefficients) (value quotient.quotient)}
      "=" {value (Raw.monic minimal.polynomial.coefficients)}
      "by" {sym!{L} _ _ (evaluateFactor (Raw.monic minimal.polynomial.coefficients) other.polynomial.coefficients quotient.quotient quotient.equation)}
      "=" {monicValue minimal.polynomial.coefficients} "by" {monicRawValue minimal.polynomial.coefficients}
      "=" {Target.zero} "by" {minimal.polynomial.root}} \then
  \return Logic.orElim (monicValue other.polynomial.coefficients = Target.zero) (value quotient.quotient = Target.zero) (\exists Matching)
    (TargetArithmetic.zeroProduct _ _ productZero)
    (\fun (sourceRoot: _) => \exact(Matching { polynomial := other, sourceRoot := sourceRoot }, Matching))
    (\fun (quotientRoot: _) => Logic.falseElim (\exists Matching)
      (RootCover.monicNonzero infinite minimal.polynomial.coefficients
        (eq_reason!{{asPolynomial minimal.polynomial.coefficients}
          "=" {Raw.asPolynomial (Raw.monic minimal.polynomial.coefficients)} "by" {sym!{Abstract.Carrier} _ _ (Raw.monicLaw minimal.polynomial.coefficients)}
          "=" {Abstract.mul (asPolynomial other.polynomial.coefficients) (Raw.asPolynomial quotient.quotient)} "by" {quotient.equation}
          "=" {Abstract.mul (asPolynomial other.polynomial.coefficients) Abstract.zero}
          "by" {congr!{Abstract.Carrier Abstract.Carrier} (Abstract.mul (asPolynomial other.polynomial.coefficients)) _ _
            (Normalization.zeroLaw quotient.quotient (smallKernel minimal quotient.quotient bound quotientRoot))}
          "=" {Abstract.zero} "by" {Raw.ring.semiring.zeroAbsorbsRight (asPolynomial other.polynomial.coefficients)}})))
};
\definition backward: \forall (matching: Matching)(p: Coefficients) -> Other.value p = Output.zero -> value p = Target.zero := \block {
  \fun (matching: Matching)(p: Coefficients)(root: _) \then
  \takefrom quotient: Other.Divides[matching.polynomial, p] \by Other.divides matching.polynomial p root \then
  \return eq_reason_in!{L _
    "=" _ "by" { evaluateFactor p matching.polynomial.polynomial.coefficients quotient.quotient quotient.equation }
    "=" _ "by" { congr!{L L} (\fun (a: L) => Target.mul a (value quotient.quotient)) _ _ matching.sourceRoot }
    "=" _ "by" { target.ring.ring.semiring.zeroAbsorbsLeft (value quotient.quotient) }
  }
};
\definition EquivalentKernels: \Prop := \forall (p: Coefficients) -> Logic.PropEquiv[value p = Target.zero, Other.value p = Output.zero];
\definition kernelEquivalence: Infinite.Infinite -> \forall (minimal: Minimal) ->
  Other.monicValue minimal.polynomial.coefficients = Output.zero -> EquivalentKernels := \block {
  \fun (infinite: Infinite.Infinite)(minimal: Minimal)(root: _) \then
  \takefrom matching: Matching \by matchingExists infinite minimal root \then
  \return \fun (p: Coefficients) => Logic.PropEquiv[_, _] {
    ltr := forward minimal root p, rtl := backward matching p,
  }
};
\module Fractions;
\module Isomorphism;
