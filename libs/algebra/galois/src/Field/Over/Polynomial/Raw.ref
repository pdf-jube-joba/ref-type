\import galois.Field[].Over[K := K, field := field].Polynomial[] \as Monic;
\definition asPolynomial[p: Coefficients]: Abstract.Carrier :=
  Lists.foldr K Abstract.Carrier
    (\fun (a: K)(tail: Abstract.Carrier) => Abstract.add (Abstract.constant a) (Abstract.mul Abstract.X tail)) Abstract.zero p;
\definition plus: Coefficients -> Coefficients -> Coefficients :=
  \induction (p: Coefficients) \return Coefficients -> Coefficients \with {
    | nil: \fun (q: Coefficients) => q
    | cons: \fun (a: K)(tail: Coefficients)(previous: Coefficients -> Coefficients) =>
      \induction (q: Coefficients) \return Coefficients \with {
        | nil: Lists.List[K]::cons a tail
        | cons: \fun (b: K)(other: Coefficients)(unused: Coefficients) => Lists.List[K]::cons (add a b) (previous other)
      }
  };
\definition scale[a: K][p: Coefficients]: Coefficients := Lists.map K K (mul a) p;
\definition times[p: Coefficients][q: Coefficients]: Coefficients :=
  \induction (p: Coefficients) \return Coefficients \with {
    | nil: Lists.List[K]::nil
    | cons: \fun (a: K)(tail: Coefficients)(previous: Coefficients) => plus (scale a q) (Lists.List[K]::cons zero previous)
  } p;
\import std.Alg[].Alg[] \as Algebra;
\import std.Alg[].Monoid[] \as Monoids;
\definition ring: Rings.Ring[Abstract.Carrier] := Rings.commutativeRingAsRing Abstract.Carrier Abstract.ring;
\import algebra.Group[].Of[Carrier := Abstract.Carrier, group := Rings.additiveGroup Abstract.Carrier ring] \as Sum;
\definition multiplicative: Monoids.CommutativeMonoid[Abstract.Carrier] := Monoids.CommutativeMonoid[Abstract.Carrier] {
  base := Monoids.MonoidData[Abstract.Carrier]::# Abstract.one Abstract.mul,
  monoid := ring.semiring.multiplicative, commutative := Abstract.ring.mulCommutative,
};
\import algebra.Monoid[].Of[Carrier := Abstract.Carrier, monoid := multiplicative] \as Product;
\import algebra.Hom[A := K, B := Abstract.Carrier] \as Hom;
\definition coefficientLaws: Hom.SemiringLaws[
  Rings.ringAsSemiring K (Rings.commutativeRingAsRing K coefficientRing), Rings.ringAsSemiring Abstract.Carrier ring, Abstract.constant] :=
  Hom.semiringLaws _ _ Abstract.coefficientMap;
\definition shift[p: Coefficients]: asPolynomial (Lists.List[K]::cons zero p) = Abstract.mul Abstract.X (asPolynomial p) :=
  Sum.zeroLeft (Abstract.mul Abstract.X (asPolynomial p));
\definition plusLaw: \forall (p, q: Coefficients) -> asPolynomial (plus p q) = Abstract.add (asPolynomial p) (asPolynomial q) :=
  \induction (p: Coefficients) \return \forall (q: Coefficients) -> asPolynomial (plus p q) = Abstract.add (asPolynomial p) (asPolynomial q) \with {
    | nil: \fun (q: Coefficients) => sym!{Abstract.Carrier} _ _ (Sum.zeroLeft (asPolynomial q))
    | cons: \fun (a: K)(tail: Coefficients)(previous: _) =>
      \induction (q: Coefficients) \return asPolynomial (plus (Lists.List[K]::cons a tail) q) = Abstract.add (asPolynomial (Lists.List[K]::cons a tail)) (asPolynomial q) \with {
        | nil: sym!{Abstract.Carrier} _ _ (Sum.zeroRight (asPolynomial (Lists.List[K]::cons a tail)))
        | cons: \fun (b: K)(other: Coefficients)(unused: _) =>
          eq_reason!{{asPolynomial (plus (Lists.List[K]::cons a tail) (Lists.List[K]::cons b other))}
            "=" {Abstract.add (Abstract.add (Abstract.constant a) (Abstract.constant b))
              (Abstract.mul Abstract.X (Abstract.add (asPolynomial tail) (asPolynomial other)))}
            "by" {congr2!{Abstract.Carrier Abstract.Carrier Abstract.Carrier} Abstract.add _ _ _ _
              (coefficientLaws.add a b) (congr!{Abstract.Carrier Abstract.Carrier} (Abstract.mul Abstract.X) _ _ (previous other))}
            "=" {Abstract.add (Abstract.add (Abstract.constant a) (Abstract.constant b))
              (Abstract.add (Abstract.mul Abstract.X (asPolynomial tail)) (Abstract.mul Abstract.X (asPolynomial other)))}
            "by" {congr!{Abstract.Carrier Abstract.Carrier} (Abstract.add (Abstract.add (Abstract.constant a) (Abstract.constant b))) _ _
              (ring.semiring.leftDistributive Abstract.X (asPolynomial tail) (asPolynomial other))}
            "=" {Abstract.add (asPolynomial (Lists.List[K]::cons a tail)) (asPolynomial (Lists.List[K]::cons b other))}
            "by" {Sum.four (Abstract.constant a) (Abstract.constant b) (Abstract.mul Abstract.X (asPolynomial tail)) (Abstract.mul Abstract.X (asPolynomial other))}}
      }
  };
\definition scaleLaw: \forall (a: K)(p: Coefficients) -> asPolynomial (scale a p) = Abstract.mul (Abstract.constant a) (asPolynomial p) :=
  \fun (a: K) => \induction (p: Coefficients) \return asPolynomial (scale a p) = Abstract.mul (Abstract.constant a) (asPolynomial p) \with {
    | nil: sym!{Abstract.Carrier} _ _ (ring.semiring.zeroAbsorbsRight (Abstract.constant a))
    | cons: \fun (b: K)(tail: Coefficients)(previous: _) =>
      eq_reason!{{asPolynomial (scale a (Lists.List[K]::cons b tail))}
        "=" {Abstract.add (Abstract.mul (Abstract.constant a) (Abstract.constant b)) (Abstract.mul Abstract.X (Abstract.mul (Abstract.constant a) (asPolynomial tail)))}
        "by" {congr2!{Abstract.Carrier Abstract.Carrier Abstract.Carrier} Abstract.add _ _ _ _
          (coefficientLaws.mul a b) (congr!{Abstract.Carrier Abstract.Carrier} (Abstract.mul Abstract.X) _ _ previous)}
        "=" {Abstract.add (Abstract.mul (Abstract.constant a) (Abstract.constant b)) (Abstract.mul (Abstract.constant a) (Abstract.mul Abstract.X (asPolynomial tail)))}
        "by" {congr!{Abstract.Carrier Abstract.Carrier} (Abstract.add (Abstract.mul (Abstract.constant a) (Abstract.constant b))) _ _
          (Product.swap Abstract.X (Abstract.constant a) (asPolynomial tail))}
        "=" {Abstract.mul (Abstract.constant a) (asPolynomial (Lists.List[K]::cons b tail))}
        "by" {sym!{Abstract.Carrier} _ _ (ring.semiring.leftDistributive (Abstract.constant a) (Abstract.constant b) (Abstract.mul Abstract.X (asPolynomial tail)))}}
  };
\definition timesLaw: \forall (p, q: Coefficients) -> asPolynomial (times p q) = Abstract.mul (asPolynomial p) (asPolynomial q) :=
  \fun (p, q: Coefficients) => (\induction (p: Coefficients) \return asPolynomial (times p q) = Abstract.mul (asPolynomial p) (asPolynomial q) \with {
    | nil: sym!{Abstract.Carrier} _ _ (ring.semiring.zeroAbsorbsLeft (asPolynomial q))
    | cons: \fun (a: K)(tail: Coefficients)(previous: _) =>
      eq_reason!{{asPolynomial (times (Lists.List[K]::cons a tail) q)}
        "=" {Abstract.add (asPolynomial (scale a q)) (asPolynomial (Lists.List[K]::cons zero (times tail q)))}
        "by" {plusLaw (scale a q) (Lists.List[K]::cons zero (times tail q))}
        "=" {Abstract.add (Abstract.mul (Abstract.constant a) (asPolynomial q)) (Abstract.mul Abstract.X (asPolynomial (times tail q)))}
        "by" {congr2!{Abstract.Carrier Abstract.Carrier Abstract.Carrier} Abstract.add _ _ _ _ (scaleLaw a q) (shift (times tail q))}
        "=" {Abstract.add (Abstract.mul (Abstract.constant a) (asPolynomial q)) (Abstract.mul (Abstract.mul Abstract.X (asPolynomial tail)) (asPolynomial q))}
        "by" {congr!{Abstract.Carrier Abstract.Carrier} (Abstract.add (Abstract.mul (Abstract.constant a) (asPolynomial q))) _ _
          (trans!{Abstract.Carrier} _ _ _ (congr!{Abstract.Carrier Abstract.Carrier} (Abstract.mul Abstract.X) _ _ previous)
            (sym!{Abstract.Carrier} _ _ (Product.assoc Abstract.X (asPolynomial tail) (asPolynomial q))))}
        "=" {Abstract.mul (asPolynomial (Lists.List[K]::cons a tail)) (asPolynomial q)}
        "by" {sym!{Abstract.Carrier} _ _ (ring.semiring.rightDistributive (Abstract.constant a) (Abstract.mul Abstract.X (asPolynomial tail)) (asPolynomial q))}}
  }) p;
\definition monic[p: Coefficients]: Coefficients := Lists.append K p (Lists.List[K]::cons one Lists.List[K]::nil);
\definition monicLaw: \forall (p: Coefficients) -> asPolynomial (monic p) = Monic.asPolynomial p :=
  \induction (p: Coefficients) \return asPolynomial (monic p) = Monic.asPolynomial p \with {
    | nil: trans!{Abstract.Carrier} _ _ _ (congr!{Abstract.Carrier Abstract.Carrier} (Abstract.add Abstract.one) _ _
        (ring.semiring.zeroAbsorbsRight Abstract.X)) (Sum.zeroRight Abstract.one)
    | cons: \fun (a: K)(tail: Coefficients)(previous: _) => congr!{Abstract.Carrier Abstract.Carrier}
      (\fun (u: Abstract.Carrier) => Abstract.add (Abstract.constant a) (Abstract.mul Abstract.X u)) _ _ previous
  };
\module Normalization;
\module In(L: \Set, target: Rings.CommutativeRing[L]);
\module Laws;
\module Deflation;
\module Difference;
\module Operations;
\module Division;
