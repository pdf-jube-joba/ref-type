\import galois.Field[].Over[K := K, field := field].Polynomial[] \as Monic;
\import algebra.Polynomial[].Over[R := K, coefficients := coefficientRing].Finite[] \as Finite;
\definition asPolynomial: Coefficients -> Abstract.Carrier := Finite.asPolynomial;
\definition plus: Coefficients -> Coefficients -> Coefficients := Finite.plus;
\definition scale: K -> Coefficients -> Coefficients := Finite.scale;
\definition times: Coefficients -> Coefficients -> Coefficients := Finite.times;
\import std.Alg[].Alg[] \as Algebra;
\import std.Alg[].Monoid[] \as Monoids;
\definition ring: Rings.Ring[Abstract.Carrier] := Rings.commutativeRingAsRing Abstract.Carrier Abstract.ring;
\import algebra.Group[].Of[Carrier := Abstract.Carrier, group := Rings.additiveGroup Abstract.Carrier ring] \as Sum;
\definition multiplicative: Monoids.CommutativeMonoid[Abstract.Carrier] := Monoids.CommutativeMonoid[Abstract.Carrier] {
  base := Monoids.MonoidData[Abstract.Carrier]::# Abstract.one Abstract.mul,
  monoid := ring.semiring.multiplicative, commutative := Abstract.ring.mulCommutative,
};
\import algebra.Monoid[].Of[Carrier := Abstract.Carrier, monoid := multiplicative] \as Product;
\import algebra.Hom[A := K, B := Abstract.Carrier] \as Hom;
\definition coefficientLaws: Hom.SemiringLaws[
  Rings.ringAsSemiring K (Rings.commutativeRingAsRing K coefficientRing), Rings.ringAsSemiring Abstract.Carrier ring, Abstract.constant] :=
  Hom.semiringLaws _ _ Abstract.coefficientMap;
\definition shift: \forall (p: Coefficients) -> asPolynomial (Lists.List[K]::cons zero p) = Abstract.mul Abstract.X (asPolynomial p) := Finite.shift;
\definition plusLaw: \forall (p, q: Coefficients) -> asPolynomial (plus p q) = Abstract.add (asPolynomial p) (asPolynomial q) := Finite.plusLaw;
\definition scaleLaw: \forall (a: K)(p: Coefficients) -> asPolynomial (scale a p) = Abstract.mul (Abstract.constant a) (asPolynomial p) := Finite.scaleLaw;
\definition timesLaw: \forall (p, q: Coefficients) -> asPolynomial (times p q) = Abstract.mul (asPolynomial p) (asPolynomial q) := Finite.timesLaw;
\definition monic[p: Coefficients]: Coefficients := Lists.append K p (Lists.List[K]::cons one Lists.List[K]::nil);
\definition monicLaw: \forall (p: Coefficients) -> asPolynomial (monic p) = Monic.asPolynomial p :=
  \induction (p: Coefficients) \return asPolynomial (monic p) = Monic.asPolynomial p \with {
    | nil: trans!{Abstract.Carrier} _ _ _ (congr!{Abstract.Carrier Abstract.Carrier} (Abstract.add Abstract.one) _ _
        (ring.semiring.zeroAbsorbsRight Abstract.X)) (Sum.zeroRight Abstract.one)
    | cons: \fun (a: K)(tail: Coefficients)(previous: _) => congr!{Abstract.Carrier Abstract.Carrier}
      (\fun (u: Abstract.Carrier) => Abstract.add (Abstract.constant a) (Abstract.mul Abstract.X u)) _ _ previous
  };
\module Normalization;
\module In(L: \Set, target: Rings.CommutativeRing[L]);
\module Laws;
\module Deflation;
\module Difference;
\module Operations;
\module Division;
