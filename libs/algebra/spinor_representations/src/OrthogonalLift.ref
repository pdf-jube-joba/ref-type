/* Smooth Pin lifts of the local coordinate parametrizations of orthogonal groups. */
\import std.Data[].Nat[] \as N;
\module Dimension(n: N.Nat^);
\module Zero;
\module Step(n: N.Nat^);
\definition all: \forall (n: N.Nat^) -> Dimension[n := n].Law := \induction (n: N.Nat^) \return Dimension[n := n].Law \with {
  | zero: Zero[].value
  | succ: \fun (n: N.Nat^)(previous: Dimension[n := n].Law) => Step[n := n].law previous
};
