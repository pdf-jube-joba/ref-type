\import std.Data[].Nat[] \as N;
\import Algebra.Exterior[V := V, space := space] \as Exterior;
\import Exterior.Degrees[p := N.Nat^::succ N.Nat^::zero, q := N.Nat^::succ N.Nat^::zero] \as Product;
\import Exterior.GradedCommutativity[p := N.Nat^::succ N.Nat^::zero, q := N.Nat^::succ N.Nat^::zero] \as Commutativity;
\import Exterior.Components[k := N.Nat^::succ (N.Nat^::succ N.Nat^::zero)] \as Components;
\import Alternating.At[k := N.Nat^::succ (N.Nat^::succ N.Nat^::zero)] \as Forms;
\import Algebra.Laws[V := Alternating.Form (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)), space := Forms.vectorSpace] \as Laws;
\import Algebra.Laws[V := K, space := Algebra.scalarSpace] \as Scalars;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\definition opposite: \forall (alpha: Alternating.Form (N.Nat^::succ N.Nat^::zero)) -> Product.wedge alpha alpha = Forms.vectorSpace.neg (Product.wedge alpha alpha) :=
  \fun (alpha: _) => Components.ext (Product.wedge alpha alpha) (Forms.vectorSpace.neg (Product.wedge alpha alpha))
    (trans!{{Exterior.Series}} _ _ _ (Commutativity.law alpha alpha)
      (\axiom:funext((\fun (xs: Lists.List[V]) => Algebra.mul (Algebra.neg Algebra.one) (Exterior.component (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) (Product.wedge alpha alpha) xs)), Exterior.component (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) (Forms.vectorSpace.neg (Product.wedge alpha alpha)), \fun (xs: Lists.List[V]) => trans!{K} _ _ _
        (Scalars.minusOneScale (Exterior.component (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) (Product.wedge alpha alpha) xs))
        (sym!{K} _ _ (Components.negative (Product.wedge alpha alpha) xs)))));
\definition law: \forall (half: K) -> Algebra.add half half = Algebra.one -> \forall (alpha: Alternating.Form (N.Nat^::succ N.Nat^::zero)) ->
  Product.wedge alpha alpha = Forms.origin :=
  \fun (half: K)(halfLaw: Algebra.add half half = Algebra.one)(alpha: _) => Laws.oppositeSelfZero half (Product.wedge alpha alpha) halfLaw (opposite alpha);
