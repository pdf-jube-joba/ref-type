\import std.Data[].Nat[].Basic[].Prop[] \as NatLaws;
\import Alternating.Dimension[n := n, b := b] \as Dimension;
\definition zeroAbove: \forall (f: Carrier)(k: N.Nat^) -> NatLaws.Lt n k -> f k = (Alternating.At[k := k].vectorSpace).zero :=
  \fun (f: Carrier)(k: N.Nat^)(large: NatLaws.Lt n k) => Dimension.Above[k := k].zeroAbove (f k) large;
