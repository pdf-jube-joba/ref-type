\import Algebra.Laws[V := V, space := space] \as VectorLaws;
\use std.Logic[].Equality[].eq_reason_in;
\definition law: \forall (f: Carrier) -> annihilate space.zero f = zero :=
  \fun (f: Carrier) => \axiom:funext(annihilate space.zero f, zero, \fun (k: N.Nat^) => eq_reason_in!{{Alternating.Form k} _
    "=" _ "by" { congr!{V {Alternating.Form k}} (\fun (x: V) => (\parent.\parent.Contraction[k := k].operator x).apply (f (N.Nat^::succ k))) _ _ (sym!{V} _ _ (VectorLaws.zeroScale space.zero)) }
    "=" _ "by" { \parent.\parent.Contraction[k := k].parameterScale Algebra.zero space.zero (f (N.Nat^::succ k)) }
    "=" _ "by" { Algebra.Laws[V := Alternating.Form k, space := Alternating.At[k := k].vectorSpace].zeroScale _ }
  });
