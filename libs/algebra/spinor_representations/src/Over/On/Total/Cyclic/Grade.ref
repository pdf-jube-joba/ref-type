\import ExteriorBasis.At[k := k] \as At;
\import \parent.Span[k := k] \as Span;
\import Algebra.Sums[I := At.Tuple].Vector[V := Carrier, space := totalSpace] \as Sums;
\definition addition: \forall (f, g: Carrier) -> Span.assemble xs (totalSpace.add f g k) = totalSpace.add (Span.assemble xs (f k)) (Span.assemble xs (g k)) :=
  \fun (f, g: Carrier) => trans!{Carrier} _ _ _
    (Sums.congruent xs _ _ (\fun (i: At.Tuple) => totalSpace.scalarAdd (At.coefficient (f k) i) (At.coefficient (g k) i) (state k i)))
    (Sums.addition xs (\fun (i: At.Tuple) => totalSpace.smul (At.coefficient (f k) i) (state k i)) (\fun (i: At.Tuple) => totalSpace.smul (At.coefficient (g k) i) (state k i)));
\definition scalar: \forall (a: K)(f: Carrier) -> Span.assemble xs (totalSpace.smul a f k) = totalSpace.smul a (Span.assemble xs (f k)) :=
  \fun (a: K)(f: Carrier) => trans!{Carrier} _ _ _
    (Sums.congruent xs _ _ (\fun (i: At.Tuple) => totalSpace.scalarAssoc a (At.coefficient (f k) i) (state k i)))
    (Sums.scalar xs a (\fun (i: At.Tuple) => totalSpace.smul (At.coefficient (f k) i) (state k i)));
