\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import Algebra.DirectSum[V := V, W := W, left := left, right := right] \as Sum;
\import Algebra.Multilinear[V := V, space := left].Alternating[] \as Left;
\import Algebra.Multilinear[V := W, space := right].Alternating[] \as Right;
\import Algebra.Multilinear[V := Sum.Carrier, space := Sum.space].Alternating[] \as Result;
\import Algebra.Linear[V := Sum.Carrier, W := V, source := Sum.space, target := left] \as LeftMaps;
\import Algebra.Linear[V := Sum.Carrier, W := W, source := Sum.space, target := right] \as RightMaps;
\definition leftProjection: LeftMaps.Map := LeftMaps.Map {
  apply := Sum.first,
  preservesAdd := \fun (x, y: Sum.Carrier) => \refl(left.add (Sum.first x) (Sum.first y)),
  preservesScale := \fun (a: K)(x: Sum.Carrier) => \refl(left.smul a (Sum.first x)),
};
\definition rightProjection: RightMaps.Map := RightMaps.Map {
  apply := Sum.second,
  preservesAdd := \fun (x, y: Sum.Carrier) => \refl(right.add (Sum.second x) (Sum.second y)),
  preservesScale := \fun (a: K)(x: Sum.Carrier) => \refl(right.smul a (Sum.second x)),
};
\import Result.Precomposition[W := V, target := left] \as PullLeft;
\import Result.Precomposition[W := W, target := right] \as PullRight;
\import Algebra.Exterior[V := Sum.Carrier, space := Sum.space] \as Exterior;
\module At(p, q: N.Nat^);
