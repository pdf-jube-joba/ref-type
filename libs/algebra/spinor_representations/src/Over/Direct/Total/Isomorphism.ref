\import Algebra.FiniteExterior[V := W, space := right, n := rn, b := rb] \as RightExterior;
\import \root.Over[K := K, scalarRing := scalarRing].Direct[V := V, W := W, left := left, right := right].Total[].Coefficient[].Sequences[].Evaluation[].Maps[].Extract[].Finite[n := rn, b := rb] \as RightFinite;
\import \root.Over[K := K, scalarRing := scalarRing].Direct[V := V, W := W, left := left, right := right].Total[].Image[].Finite[n := sn, b := sb] \as ImageFinite;
\import Algebra.Linear[V := Tensor.Carrier, W := ResultTotal.Carrier, source := Tensor.space, target := ResultTotal.totalSpace] \as Maps;
\import Algebra.Isomorphism[V := Tensor.Carrier, W := ResultTotal.Carrier, source := Tensor.space, target := ResultTotal.totalSpace] \as Iso;
\import Iso.OfBijective[f := comparison] \as Bijection;
\definition Enumerations: \Set := \forall (k: N.Nat^) -> RightExterior.At[k := k].Enumeration;
\definition enumerationsExist: \exists Enumerations := \axiom:classicalIndefiniteChoice(N.Nat^, (\fun (k: N.Nat^) => RightExterior.At[k := k].Enumeration), (\fun (k: N.Nat^) => RightExterior.At[k := k].existsEnumeration));
\definition kernelZero: \forall (t: Tensor.Carrier) -> comparison.apply t = ResultTotal.totalSpace.zero -> t = Tensor.space.zero := \block {
  \fun (t: Tensor.Carrier)(killed: comparison.apply t = ResultTotal.totalSpace.zero) \then
  \takefrom enums: Enumerations \by enumerationsExist \then
  \return RightFinite.Injective[enums := enums].kernelZero t killed
};
\definition injective: Bijection.Injective := Maps.injectiveOfZeroKernel comparison kernelZero;
\definition onto: Bijection.Onto := ImageFinite.surjective;
\definition isomorphism: Iso.Isomorphism := Bijection.isomorphism injective onto;
\definition forward: isomorphism.forward = comparison := \refl(comparison);
\definition leftInverse: \forall (t: Tensor.Carrier) -> isomorphism.backward.apply (comparison.apply t) = t := (Iso.laws isomorphism).leftInverse;
\definition rightInverse: \forall (f: ResultTotal.Carrier) -> comparison.apply (isomorphism.backward.apply f) = f := (Iso.laws isomorphism).rightInverse;
