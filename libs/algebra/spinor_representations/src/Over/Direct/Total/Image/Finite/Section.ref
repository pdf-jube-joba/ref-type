\import Algebra.FiniteExterior[V := Sum.Carrier, space := Sum.space, n := n, b := b] \as ExteriorBasis;
\import Algebra.Linear[V := ResultTotal.Carrier, W := Tensor.Carrier, source := ResultTotal.totalSpace, target := Tensor.space] \as Maps;
\definition Enumerations: \Set := \forall (k: N.Nat^) -> ExteriorBasis.At[k := k].Enumeration;
\definition enumerationsExist: \exists Enumerations := \axiom:classicalIndefiniteChoice(N.Nat^, (\fun (k: N.Nat^) => ExteriorBasis.At[k := k].Enumeration), (\fun (k: N.Nat^) => ExteriorBasis.At[k := k].existsEnumeration));
\import \root.Over[K := K, scalarRing := scalarRing].Direct[V := V, W := W, left := left, right := right].Total[].Image[].Lift[].Fock[n := n, b := b] \as Fock;
\structure Split: \Set := {
  map: Maps.Map,
  rightInverse: \forall (f: ResultTotal.Carrier) -> comparison.apply (map.apply f) = f,
};
\definition exists: \exists Split := \block {
  \takefrom enumerations: Enumerations \by enumerationsExist \then
  \return \exact(Split { map := Fock.Section[enums := enumerations].section (N.Nat^::succ n), rightInverse := Fock.Section[enums := enumerations].rightInverse }, Split)
};
