\import \parent.Dimension[n := N.Nat^::zero] \as D;
\import lie_groups.Euclidean[n := N.Nat^::zero] \as E;
\import E.Atlas[] \as Atlas;
\import E.PinRepresentation[] \as Projection;
\import E.PinPlots[d := Atlas.dimension] \as Plots;
\import calculus.Real[].Multivariable[n := Atlas.dimension].Open[] \as Open;
\import manifolds.ParametrizedAtlas[n := Atlas.dimension, A := E.O] \as Coordinates;
\import algebra.Groups[].On[G := E.Pin, group := E.pinGroup] \as Pin;
\import lie_groups.OrthogonalAtlas[].Zero[] \as Orthogonal;
\use std.Logic[].Equality[].trans;
\definition value: D.Law := \fun (i: N.Nat^) => \exact(D.Witness[i] {
  value := \fun (x: Open.Carrier (D.patch i).image) => Pin.one,
  plot := Plots.constant (D.patch i).image Pin.one,
  projection := \fun (x: Open.Carrier (D.patch i).image) => trans!{E.O} _ _ _ Projection.atOne (Orthogonal.unique E.orthogonalGroup.unit (Coordinates.value (D.patch i) x))
}, D.Witness[i]);
