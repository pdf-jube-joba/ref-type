\import lie_groups.Euclidean[n := n] \as E;
\import E.Atlas[] \as Atlas;
\import lie_groups.OrthogonalAtlas[] \as Standard;
\import manifolds.ParametrizedAtlas[n := Atlas.dimension, A := E.O] \as Coordinates;
\import calculus.Real[].Multivariable[n := Atlas.dimension].Open[] \as Open;
\import E.PinPlots[d := Atlas.dimension] \as Plots;
\import E.PinRepresentation[] \as Projection;
\definition data: Atlas.Data := Standard.atlasData n;
\definition patch[i: N.Nat^]: Coordinates.Patch := data.family.patch i;
\structure Witness[i: N.Nat^]: \Set := {
  value: Open.Carrier (patch i).image -> E.Pin,
  plot: Plots.Plot (patch i).image value,
  projection: \forall (x: Open.Carrier (patch i).image) -> Projection.map (value x) = Coordinates.value (patch i) x,
};
\definition Law: \Prop := \forall (i: N.Nat^) -> \exists Witness[i];
