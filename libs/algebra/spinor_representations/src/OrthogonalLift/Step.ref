\import \parent.Dimension[n := n] \as Lower;
\import \parent.Dimension[n := N.Nat^::succ n] \as Upper;
\import N.Pair[].Def[] \as Pair;
\import N.Pair[].Enumeration[] \as Pairs;
\definition lowerIndex[i: N.Nat^]: N.Nat^ := Pair.natPairSecond (Pairs.enumerate i);
\module At(i: N.Nat^, witness: Lower.Witness[lowerIndex i]);
\definition law: Lower.Law -> Upper.Law := \fun (previous: Lower.Law)(i: N.Nat^) => \block {
  \takefrom witness: Lower.Witness[lowerIndex i] \by previous (lowerIndex i) \then
  \return \exact(At[i := i, witness := witness].value, Upper.Witness[i])
};
