\import clifford.Euclidean[n := n] \as E;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Clifford;
\import Linear.Linear[V := E.Carrier, W := R.Real, source := Clifford.vectorSpace, target := Linear.scalarSpace] \as Functional;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import lie_groups.CliffordPlots[d := d].Dimension[n := n] \as Plots;
\definition Law: \Prop := \forall (U: Open.OpenSet)(f: Open.Carrier U -> E.Carrier) -> Plots.Plot U f ->
  \forall (l: Functional.Map) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => l.apply (f x));
