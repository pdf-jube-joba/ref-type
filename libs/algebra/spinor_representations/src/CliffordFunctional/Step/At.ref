\import Calculus.Step[n := n].Components[U := U, f := f] \as Components;
\definition leftF[x: Open.Carrier U]: E.Carrier := Recovery.left (f x);
\definition rightF[x: Open.Carrier U]: E.Carrier := Recovery.right (f x);
\definition law: Lower.Law -> UpperPlots.Plot U f -> \forall (l: UpperFunctional.Map) -> Open.Smooth[].SmoothOn U (\fun (x: Open.Carrier U) => l.apply (f x)) :=
  \fun (previous: Lower.Law)(regular: UpperPlots.Plot U f)(l: UpperFunctional.Map) =>
  Calculus.smoothEqual U (\fun (x: Open.Carrier U) => R.add ((left l).apply (leftF x)) ((right l).apply (rightF x))) (\fun (x: Open.Carrier U) => l.apply (f x))
    (\fun (x: Open.Carrier U) => trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (l.preservesAdd (Inclusion.map (leftF x)) (B.mul (Inclusion.map (rightF x)) Normal.gamma))) (congr!{Next.Carrier R.Real} l.apply _ _ (Spanning.recover (f x))))
    (Operations.addSmooth U (\fun (x: Open.Carrier U) => (left l).apply (leftF x)) (\fun (x: Open.Carrier U) => (right l).apply (rightF x))
      (previous U leftF (Components.leftPlot regular) (left l)) (previous U rightF (Components.rightPlot regular) (right l)));
