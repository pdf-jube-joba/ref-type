\import linear_algebra.Commutative[K := K, scalarRing := scalarRing] \as Algebra;
\module On(V: \Set, space: Algebra.VectorSpace V);
\module Direct(V, W: \Set, left: Algebra.VectorSpace V, right: Algebra.VectorSpace W);
\module TensorOperators(V, W: \Set, left: Algebra.VectorSpace V, right: Algebra.VectorSpace W);
\module Pullback(V, W: \Set, source: Algebra.VectorSpace V, target: Algebra.VectorSpace W);
