\import D.UnitaryOrthogonal[].Smooth[d := d] \as Families;
\import Families.FromManifold[].On[M := M] \as Lifting;
\import calculus.Real[].Multivariable[n := d].Open[].Smooth[].Operations[] \as Functions;
\import std.Logic[].Proposition[] \as Logic;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Complex.ring].FiniteCoordinates[n := N.Nat^::succ N.Nat^::zero] \as Basis;
\import lie_groups.SpinC[n := Fin.Sum[m := N.Nat^::succ N.Nat^::zero, n := N.Nat^::succ N.Nat^::zero].total] \as Target;
\import lie_groups.Smooth[n := d, m := Target.dimension].Between[M := M, N := Target.manifold] \as Regularity;
\definition unit[x: M.Point]: Unitary.Carrier := Unitary.identity;
\definition unitRegular: Lifting.MatrixCondition unit := \fun (chart: Lifting.Chart)(j, i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Logic.And[_, _]::#
  (Functions.constantSmooth chart.image (C.re (Unitary.identity.forward.apply (Basis.vectors j) i)))
  (Functions.constantSmooth chart.image (C.im (Unitary.identity.forward.apply (Basis.vectors j) i)));
\definition liftedIdentitySmooth: Regularity.IsSmooth (\fun (x: M.Point) => Lift.lift (unit x)) := Lifting.smoothEntries unit unitRegular;
