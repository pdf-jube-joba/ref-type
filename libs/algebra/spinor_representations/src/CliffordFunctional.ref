/* Smoothness of real-linear functionals in Clifford coefficient plots. */
\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real Scalars.field] \as Linear;
\module Dimension(n, d: N.Nat^);
\module Zero(d: N.Nat^);
\module Step(n, d: N.Nat^);
\definition all: \forall (n, d: N.Nat^) -> Dimension[n := n, d := d].Law := \fun (n, d: N.Nat^) =>
  \induction (k: N.Nat^) \return Dimension[n := k, d := d].Law \with {
    | zero: Zero[d := d].law
    | succ: \fun (k: N.Nat^)(previous: Dimension[n := k, d := d].Law) => Step[n := k, d := d].law previous
  } n;
