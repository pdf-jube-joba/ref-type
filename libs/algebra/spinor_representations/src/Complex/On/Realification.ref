\import std.Alg[].Ring[] \as Rings;
\import std.Alg[].Field[] \as Fields;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition realRing: Rings.CommutativeRing[R.Real] := Fields.fieldAsCommutativeRing R.Real R.Algebra[].field;
\import linear_algebra.Commutative[K := R.Real, scalarRing := realRing] \as RealAlgebra;
\definition spaceReal: RealAlgebra.VectorSpace V := Rings.RingModule[R.Real, V, RealAlgebra.ring] {
  zero := space.zero, add := space.add, neg := space.neg,
  smul := \fun (a: R.Real)(v: V) => space.smul (Def.ofReal a) v,
  additive := space.additive,
  scalarOne := space.scalarOne,
  scalarAssoc := \fun (a, b: R.Real)(v: V) => trans!{V} _ _ _
    (congr!{C.Complex V} (\fun (c: C.Complex) => space.smul c v) _ _ (sym!{C.Complex} _ _ (Laws.ofRealMul a b)))
    (space.scalarAssoc (Def.ofReal a) (Def.ofReal b) v),
  scalarAdd := \fun (a, b: R.Real)(v: V) => trans!{V} _ _ _
    (congr!{C.Complex V} (\fun (c: C.Complex) => space.smul c v) _ _ (Laws.ofRealAdd a b))
    (space.scalarAdd (Def.ofReal a) (Def.ofReal b) v),
  vectorAdd := \fun (a: R.Real)(v, w: V) => space.vectorAdd (Def.ofReal a) v w,
};
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Field.field, scalar := linear_algebra.Hermitian[].Complex[].scalar].Inner[V := V, space := space] \as Inner;
\module With(h: Inner.Form);
