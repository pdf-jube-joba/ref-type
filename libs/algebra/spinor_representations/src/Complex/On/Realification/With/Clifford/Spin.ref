\import Source.Pin[] \as Pin;
\import algebra.Groups[].Units[A := Source.Carrier, ring := Source.ring] \as SourceUnits;
\import algebra.Groups[].Units[A := Endomorphisms.Carrier, ring := Endomorphisms.ring] \as TargetUnits;
\import SourceUnits.Mapping[B := Endomorphisms.Carrier, target := Endomorphisms.ring, f := extension] \as Mapping;
\import algebra.Hom[A := Pin.Spin, B := TargetUnits.Unit] \as Groups;
\definition action[g: Pin.Spin]: TargetUnits.Unit := Mapping.apply g;
\definition homomorphism: Groups.GroupMap Pin.spinGroup TargetUnits.group := \into[Pin.Spin -> TargetUnits.Unit](action, Groups.GroupMap Pin.spinGroup TargetUnits.group) \by {
  Groups.MonoidLaws[_, _, action] {
    unit := Mapping.atOne,
    operation := \fun (g, h: Pin.Spin) => Mapping.preservesProduct g h,
  }
};
\definition onValue: \forall (g: Pin.Spin) -> (action g).value = extension g.value := \fun (g: Pin.Spin) => \refl(extension g.value);
\module Phase;
