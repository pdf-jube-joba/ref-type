\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\import C.Prop[] \as ComplexLaws;
\definition conjugateNegative: \forall (z: C.Complex) -> Def.conj (Algebra.neg z) = Algebra.neg (Def.conj z) :=
  \fun (z: C.Complex) => ComplexLaws.ext _ _ (\refl(R.neg (C.re z))) (\refl(R.neg (R.neg (C.im z))));
\definition Property[k: N.Nat^]: \Prop := \forall (r: Fin.Fin n)(f: Forms.Form k)(g: Forms.Form (N.Nat^::succ k)) ->
  \parent.\parent.Inner[k := N.Nat^::succ k].Canonical[].dot (Operations.LeftCreation[k := k].apply (Metric.form (Finite.basis r)) f) g =
  \parent.\parent.Inner[k := k].Canonical[].dot f ((Operations.Contraction[k := k].operator (Finite.basis r)).apply g);
\module Zero;
\module Step(k: N.Nat^);
\definition all: \forall (k: N.Nat^) -> Property k := \induction (k: N.Nat^) \return Property k \with {
  | zero: Zero[].law
  | succ: \fun (k: N.Nat^)(previous: Property k) => Step[k := k].law previous
};
