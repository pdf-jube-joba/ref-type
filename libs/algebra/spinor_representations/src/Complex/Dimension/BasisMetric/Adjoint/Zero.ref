\import Algebra.FiniteExterior[V := Finite.Vector, space := Finite.space, n := n, b := Standard.basis].At[k := N.Nat^::succ N.Nat^::zero] \as ExteriorAt;
\import \parent.\parent.Extension[k := N.Nat^::zero] \as Extension;
\import \parent.\parent.HeadCase[k := N.Nat^::zero] \as HeadCase;
\import \parent.\parent.HeadAdjoint[k := N.Nat^::zero] \as Head;
\import \parent.\parent.Absent[k := N.Nat^::zero] \as Absent;
\import Algebra.Multilinear[V := Finite.Vector, space := Finite.space].Alternating[].Dimension[n := n, b := Standard.basis].Increasing[k := N.Nat^::succ N.Nat^::zero] \as Index;
\definition law: Property N.Nat^::zero := \fun (r: Fin.Fin n)(f: Forms.Form N.Nat^::zero)(g: Forms.Form (N.Nat^::succ N.Nat^::zero)) =>
  Extension.onBasis r f (\fun (j: Index.Index) => either!{{(Classical.excludedMiddle (r = Head.head j))} {(Extension.left r f).apply (ExteriorAt.word j) = (Extension.right r f).apply (ExteriorAt.word j)}
    {\fun (same: r = Head.head j) => \idelim Head.head j = r \with s: Fin.Fin n => (Extension.left s f).apply (ExteriorAt.word j) = (Extension.right s f).apply (ExteriorAt.word j) \by {
      base: HeadCase.adjoint j f, equality: sym!{{Fin.Fin n}} _ _ same
    }}
    {\fun (different: Logic.Not (r = Head.head j)) => Absent.adjoint r j f (\fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) =>
      \fun (equal: r = j i) => different (trans!{{Fin.Fin n}} _ _ _ equal (congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} {Fin.Fin n}} j _ _ (Metric.unique i))))}
  }) g;
