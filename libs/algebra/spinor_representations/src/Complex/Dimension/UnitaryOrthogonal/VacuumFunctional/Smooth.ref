\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import lie_groups.CliffordPlots[d := d] \as Calculus;
\import Calculus.Dimension[n := Fin.Sum[m := n, n := n].total] \as Plots;
\definition real: \forall (U: Open.OpenSet)(f: Open.Carrier U -> Source.Carrier) -> Plots.Plot U f ->
  Smooth.SmoothOn U (\fun (x: Open.Carrier U) => C.re (coeff (f x))) :=
  \fun (U: Open.OpenSet)(f: Open.Carrier U -> Source.Carrier)(regular: Plots.Plot U f) => SmoothFunctional.all (Fin.Sum[m := n, n := n].total) d U f regular realFunctional;
\definition imaginary: \forall (U: Open.OpenSet)(f: Open.Carrier U -> Source.Carrier) -> Plots.Plot U f ->
  Smooth.SmoothOn U (\fun (x: Open.Carrier U) => C.im (coeff (f x))) :=
  \fun (U: Open.OpenSet)(f: Open.Carrier U -> Source.Carrier)(regular: Plots.Plot U f) => SmoothFunctional.all (Fin.Sum[m := n, n := n].total) d U f regular imaginaryFunctional;
