\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import lie_groups.Euclidean[n := Fin.Sum[m := n, n := n].total] \as Geo;
\import Geo.PinRepresentation[] \as Projection;
\import lie_groups.CliffordPlots[d := d].Dimension[n := Fin.Sum[m := n, n := n].total] \as CPlots;
\module On(U: Open.OpenSet, u: Open.Carrier U -> Unitary.Carrier, p: Open.Carrier U -> Geo.Pin,
  image: \forall (x: Open.Carrier U) -> Projection.map (p x) = map (u x),
  regular: CPlots.Plot U (\fun (x: Open.Carrier U) => (p x).value));
