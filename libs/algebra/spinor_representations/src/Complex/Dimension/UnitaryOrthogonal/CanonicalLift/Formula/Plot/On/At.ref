\import calculus.Maps[n := d, m := Atlas.dimension] \as Maps;
\import Precompose.On[U := read.domain, V := (family.patch i).image, f := localLift.value, h := read.lift, regular := localLift.plot] \as Pulled;
\definition unitary[x: Open.Carrier read.domain]: Unitary.Carrier := u (Open.inclusion read.domain U read.included x);
\use std.Logic[].Equality[].trans;
\definition projects: \forall (x: Open.Carrier read.domain) -> Geo.PinRepresentation[].map (Pulled.value x) = map (unitary x) := \fun (x: Open.Carrier read.domain) =>
  trans!{Geo.O} _ _ _ (localLift.projection (Maps.apply read.domain (family.patch i).image read.lift x)) (read.agrees x);
\import \parent.\parent.\parent.LocalPlot[d := d].On[U := read.domain, u := unitary, p := Pulled.value, image := projects, regular := Pulled.plot] \as Normalized;
\module AtCoefficient(j: Coefficients.Index) {
  \import Open.LocalSmooth[U := U, f := (\fun (x: Open.Carrier U) => Coefficients.coefficient j (function x))] \as Local;
  \definition patch: Local.Patch := Local.Patch { domain := read.domain, included := read.included, smooth := Normalized.plot j };
}
