\import Open.LocalSmooth[U := U, f := (\fun (x: Open.Carrier U) => Coefficients.coefficient j (function x))] \as Local;
\definition smooth: Open.Smooth[].SmoothOn U (\fun (x: Open.Carrier U) => Coefficients.coefficient j (function x)) := Local.smooth (\block {
  \fun (a: Open.Carrier U) \then
  \takefrom i: \Cast[N.Nat^] ({ i: N.Nat^ \where \In[Geo.O] ((family.patch i).domain) (map (u a)) }) \by family.covers (map (u a)) \then
  \let inside: \In[Geo.O] ((family.patch i).domain) (map (u a)) := \bysub(N.Nat^, { i: N.Nat^ \where \In[Geo.O] ((family.patch i).domain) (map (u a)) }, i) \then
  \takefrom read: Coordinates.Read[d := d].On[p := family.patch i, U := U, f := (\fun (x: Open.Carrier U) => map (u x)), a := a].Witness \by (Standard.atlasData (Fin.Sum[m := n, n := n].total)).readings d U (\fun (x: Open.Carrier U) => map (u x)) regular i a inside \then
  \takefrom localLift: Lifts.Witness[i] \by \root.OrthogonalLift[].all (Fin.Sum[m := n, n := n].total) i \then
  \return \exact(\into[Local.Patch](\parent.At[i := i, a := a, read := read, localLift := localLift].AtCoefficient[j := j].patch, Local.Patches a) \by { read.contains }, \Cast[Local.Patch] (Local.Patches a))
});
