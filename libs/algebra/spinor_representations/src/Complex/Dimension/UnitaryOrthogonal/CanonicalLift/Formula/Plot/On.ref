\import Geo.Atlas[] \as Atlas;
\import lie_groups.OrthogonalAtlas[] \as Standard;
\import \root.OrthogonalLift[].Dimension[n := Fin.Sum[m := n, n := n].total] \as Lifts;
\import manifolds.ParametrizedAtlas[n := Atlas.dimension, A := Geo.O] \as Coordinates;
\import Geo.PinPlots[d := Atlas.dimension].Precomposition[e := d] \as Precompose;
\import lie_groups.SpinGroup[n := Fin.Sum[m := n, n := n].total] \as Base;
\import clifford.ComplexRepresentation[n := Fin.Sum[m := n, n := n].total] \as Representation;
\import Representation.By[G := Pin.Spin, group := Pin.spinGroup, embedding := Base.embedding, injective := Base.embeddingInjective, sign := Pin.spinInvolution, compatible := Base.compatible].Coefficients[] \as Coefficients;
\import lie_groups.ComplexGroup[n := Fin.Sum[m := n, n := n].total].Over[G := Pin.Spin, group := Pin.spinGroup, embedding := Base.embedding, injective := Base.embeddingInjective, sign := Pin.spinInvolution, compatible := Base.compatible].Plots[d := d] \as Target;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\definition family: Coordinates.Family := (Standard.atlasData (Fin.Sum[m := n, n := n].total)).family;
\definition function[x: Open.Carrier U]: SpinC.Carrier := lift (u x);
\module At(i: N.Nat^, a: Open.Carrier U, read: Coordinates.Read[d := d].On[p := family.patch i, U := U, f := (\fun (x: Open.Carrier U) => map (u x)), a := a].Witness, localLift: Lifts.Witness[i]);
\module Local(j: Coefficients.Index);
\definition plot: Target.Plot U function := \fun (j: Coefficients.Index) => Local[j := j].smooth;
