\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import lie_groups.Euclidean[n := Fin.Sum[m := n, n := n].total] \as Geo;
\import Geo.Plots[d := d] \as OrthogonalPlots;
\module On(U: Open.OpenSet, u: Open.Carrier U -> Unitary.Carrier, regular: OrthogonalPlots.Plot U (\fun (x: Open.Carrier U) => map (u x)));
