\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Field.field, scalar := Hermitian.scalar, topological := FramesComplex.topological].At[n := n].Families[X := Open.Carrier U].Matrix[m := n] \as Matrices;
\import Algebra.FiniteCoordinates[n := n] \as Basis;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Field.field, scalar := Hermitian.scalar].Sums[] \as ComplexSums;
\import R.FiniteSums[] \as RealSums;
\import Open.Smooth[].Operations[] \as Operations;
\import Open.Smooth[].Sums[] \as Sums;
\import std.Data[].Nat[] \as N;
\use std.Logic[].Equality[].trans;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\definition imaginarySum: \forall (m: N.Nat^)(f: Fin.Fin m -> C.Complex) -> C.im (ComplexSums.sum m f) = RealSums.sum m (\fun (i: Fin.Fin m) => C.im (f i)) :=
  \induction (m: N.Nat^) \return \forall (f: Fin.Fin m -> C.Complex) -> C.im (ComplexSums.sum m f) = RealSums.sum m (\fun (i: Fin.Fin m) => C.im (f i)) \with {
    | zero: \fun (f: _) => \refl(R.zero)
    | succ: \fun (m: N.Nat^)(previous: _)(f: _) => congr!{R.Real R.Real} (R.add (C.im (f (Fin.zero m)))) _ _ (previous (\fun (i: Fin.Fin m) => f (Fin.succ m i)))
  };
\module At(v: Finite.Vector, i: Fin.Fin n);
\definition regular: Regular U u := \fun (v: Finite.Vector)(i: Fin.Fin n) => Logic.And[_, _]::# At[v := v, i := i].real At[v := v, i := i].imaginary;
