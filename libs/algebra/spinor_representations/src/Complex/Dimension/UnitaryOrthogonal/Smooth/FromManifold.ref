/* Smooth families on any source manifold induce smooth Spin-c-valued maps. */
\import manifolds.Dimension[n := d].Smooth[] \as Source;
\import clifford.ComplexRepresentation[n := Indices.total] \as Representation;
\import clifford.ComplexExtension[G := Pin.Spin, group := Pin.spinGroup].By[sign := Pin.spinInvolution] \as SpinC;
\import lie_groups.ComplexGroup[n := Indices.total].Over[G := Pin.Spin, group := Pin.spinGroup, embedding := Base.embedding, injective := Base.embeddingInjective, sign := Pin.spinInvolution, compatible := Base.compatible] \as Geometry;
\import lie_groups.SpinC[n := Indices.total] \as TargetDimension;
\module On(M: Source.Manifold);
