\import \root.Over[K := C.Complex, scalarRing := ring].On[V := Finite.Vector, space := Finite.space].Total[].Vacuum[] \as Vacuum;
\import Forms.DegreeZero[] \as Zero;
\import C.Prop[] \as ComplexLaws;
\import std.Logic[].Proposition[] \as Logic;
\definition nonzero: Logic.Not (Vacuum.state = Total.zero) := \fun (same: Vacuum.state = Total.zero) => ComplexLaws.zeroNeOne
  (sym!{C.Complex} _ _ (congr!{{Total.Carrier} C.Complex} (\fun (f: Total.Carrier) => f N.Nat^::zero Zero.emptyArguments) _ _ same));
\definition positiveNorm: Order.Lt R.zero (C.re (dot Vacuum.state Vacuum.state)) := InnerLaws.positiveNorm positive Vacuum.state nonzero;
