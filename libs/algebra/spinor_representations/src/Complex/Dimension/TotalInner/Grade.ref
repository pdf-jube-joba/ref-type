\import \parent.\parent.Inner[k := k].Canonical[] \as GradeInner;
\import Forms.At[k := k] \as FormsAt;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Field.field, scalar := Hermitian.scalar].Inner[V := Forms.Form k, space := FormsAt.vectorSpace].Of[h := GradeInner.form] \as Laws;
\definition zeroOfReal: \forall (f: Forms.Form k) -> C.re (GradeInner.dot f f) = R.zero -> f = FormsAt.origin :=
  \fun (f: Forms.Form k) => Laws.squaredDefinite GradeInner.positive f;
