\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].List[] \as Lists;
\import Total.Series[] \as Series;
\import topology.Topology[Carrier := Total.Carrier] \as Space;
\import topology.Topology[Carrier := C.Complex] \as Scalars;
\import topology.Maps[A := Total.Carrier, B := C.Complex] \as Pullback;
\definition Basis: \Pow (\Pow Total.Carrier) :=
  { W: \Pow Total.Carrier \where \exists (xs: Lists.List[Finite.Vector] \where
    \exists (O: \Pow C.Complex \where Logic.And[Scalars.IsOpenIn FramesComplex.topological.space O, W = Pullback.Preimage (\fun (f: Total.Carrier) => Series.value f xs) O])) };
\definition topology: Space.Topology := Space.generated Basis;
