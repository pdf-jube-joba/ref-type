\import \root.Over[K := C.Complex, scalarRing := ring].On[V := V, space := space].OneSquare[] \as Square;
\import Algebra.Multilinear[V := V, space := space].Alternating[] \as Alternating;
\import std.Data[].Nat[] \as N;
\import Algebra.Exterior[V := V, space := space].Degrees[p := N.Nat^::succ N.Nat^::zero, q := N.Nat^::succ N.Nat^::zero] \as Wedge;
\import Alternating.At[k := N.Nat^::succ (N.Nat^::succ N.Nat^::zero)] \as Target;
\definition square: \forall (alpha: Alternating.Form (N.Nat^::succ N.Nat^::zero)) -> Wedge.wedge alpha alpha = Target.origin :=
  \fun (alpha: _) => Square.law half halfDouble alpha;
\module CreationSquare(k: N.Nat^);
\import \root.Over[K := C.Complex, scalarRing := ring].On[V := V, space := space].Total[] \as Total;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition creationSquare: \forall (alpha: Alternating.Form (N.Nat^::succ N.Nat^::zero))(f: Total.Carrier) ->
  Total.createLeft alpha (Total.createLeft alpha f) = Total.zero :=
  \fun (alpha: _)(f: _) => \axiom:funext(Total.createLeft alpha (Total.createLeft alpha f), Total.zero,
    \induction (k: N.Nat^) \return Total.createLeft alpha (Total.createLeft alpha f) k = Total.zero k \with {
      | zero: \refl(Alternating.At[k := N.Nat^::zero].origin)
      | succ: \fun (k: N.Nat^)(unused: _) =>
        (\induction (k: N.Nat^) \return Total.createLeft alpha (Total.createLeft alpha f) (N.Nat^::succ k) = Total.zero (N.Nat^::succ k) \with {
          | zero: (\root.Over[K := C.Complex, scalarRing := ring].On[V := V, space := space].LeftCreation[k := N.Nat^::zero].operator alpha).preservesZero
          | succ: \fun (k: N.Nat^)(unused: _) => CreationSquare[k := k].law alpha (f k)
        }) k
    });
\module Operators;
\module Realification;
