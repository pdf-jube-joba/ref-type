\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as R;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module Dimension(d: N.Nat^);
\module Zero;
\module Step(n: N.Nat^);
\definition positiveSign: \forall (d: N.Nat^) -> Dimension[d := d].PositiveSign :=
  \induction (d: N.Nat^) \return Dimension[d := d].PositiveSign \with {
    | zero: Zero[].law
    | succ: \fun (n: N.Nat^)(unused: Dimension[d := n].PositiveSign) => Step[n := n].law
  };
