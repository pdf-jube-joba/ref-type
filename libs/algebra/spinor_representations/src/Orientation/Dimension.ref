\import lie_groups.Euclidean[n := d] \as E;
\import clifford.Field[K := R.Real, field := R.Algebra[].field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Clifford;
\import Clifford.Pin[] \as Pin;
\import E.PinRepresentation[] \as Projection;
\import E.Orientation[] \as Orientation;
\import algebra.Groups[].Units[A := E.CliffordAlgebra, ring := Clifford.ring] \as Units;
\definition element[v: Pin.Positive]: E.Pin := \into[Units.Unit](Pin.positive v, Pin.predicate) \by {
  Pin.vectorInPin (Pin.positive v) (Pin.VectorGenerator::positive v)
};
\definition PositiveSign: \Prop := \forall (v: Pin.Positive) -> Orientation.determinant (Projection.map (element v)) = R.neg R.one;
\module Even;
