\import \parent.Dimension[d := N.Nat^::zero] \as D;
\import lie_groups.Euclidean[n := N.Nat^::zero] \as E;
\import clifford.Field[K := R.Real, field := R.Algebra[].field].On[V := E.Vector, space := E.space].Of[form := E.form] \as C;
\import C.Pin[] \as Pin;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Arithmetic;
\import std.Logic[].Proposition[] \as Logic;
\definition law: D.PositiveSign := \fun (v: Pin.Positive) => Logic.falseElim _ (Arithmetic.zeroNeOne (\bysub(E.Vector, { w: E.Vector \where C.quadratic w = R.one }, v)));
