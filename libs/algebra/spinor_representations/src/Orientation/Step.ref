\import \parent.Dimension[d := N.Nat^::succ n] \as D;
\import lie_groups.Euclidean[n := N.Nat^::succ n] \as E;
\import lie_groups.Euclidean[n := n].SuccessorGeometry[] \as Geometry;
\import clifford.Field[K := R.Real, field := R.Algebra[].field].On[V := E.Vector, space := E.space].Of[form := E.form] \as C;
\import C.Pin[] \as Pin;
\import E.PinRepresentation[] \as Projection;
\import E.Orientation[] \as Orientation;
\definition sphere[v: Pin.Positive]: Geometry.Sphere := \into[E.Vector](v, Geometry.Sphere) \by { \bysub(E.Vector, { w: E.Vector \where C.quadratic w = R.one }, v) };
\definition law: D.PositiveSign := \fun (v: Pin.Positive) => trans!{R.Real} _ _ _
  (congr!{E.O R.Real} Orientation.determinant _ _ (Projection.PositiveLift[v := v].image))
  (lie_groups.OrthogonalOrientation[].Step[n := n].Reflection[v := sphere v].determinant);
