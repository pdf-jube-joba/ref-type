\import complex.Complex[] \as C;
\import C.Def[] \as Def;
\import C.Prop[] \as Laws;
\import C.Algebra[] \as Field;
\import real.Analysis[] \as R;
\import R.Algebra[] \as RealLaws;
\import R.Estimates[] \as Estimates;
\import std.Alg[].Field[] \as Fields;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition ring: std.Alg[].Ring[].CommutativeRing[C.Complex] := Fields.fieldAsCommutativeRing C.Complex Field.field;
\definition half: C.Complex := Def.ofReal R.half;
\definition halfDouble: Def.add half half = Def.one := trans!{C.Complex} _ _ _
  (sym!{C.Complex} _ _ (Laws.ofRealAdd R.half R.half))
  (congr!{R.Real C.Complex} Def.ofReal _ _ (trans!{R.Real} _ _ _
    (sym!{R.Real} _ _ (congr!{R.Real R.Real R.Real} R.add _ _ _ _ (RealLaws.mulOneRight R.half) (RealLaws.mulOneRight R.half)))
    (Estimates.halfTwice R.one)));
\import linear_algebra.Commutative[K := C.Complex, scalarRing := ring] \as Algebra;
\module On(V: \Set, space: Algebra.VectorSpace V);
