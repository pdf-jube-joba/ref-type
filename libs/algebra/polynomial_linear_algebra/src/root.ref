\module Field(K: \Set, field: std.Alg[].Field[].Field[K]);
\module Evaluation(K: \Set, coefficients: std.Alg[].Ring[].CommutativeRing[K], A: \Set, target: std.Alg[].Ring[].Ring[A],
  f: algebra.Hom[A := K, B := A].RingMap (std.Alg[].Ring[].commutativeRingAsRing K coefficients) target,
  central: \forall (a: K)(y: A) -> target.mul (f a) y = target.mul y (f a), T: A);
\module Examples;
