\import std.Data[].FinSet[] \as Fin;
\import matrix_invariants.Ring[K := K, scalars := std.Alg[].Field[].fieldAsCommutativeRing K field].At[n := n] \as Mat;
\import matrix_invariants.Ring[K := Polynomial, scalars := P.ring].At[n := n] \as Polynomials;
\import Polynomials.Rows[] \as Rows;
\import linear_algebra.Commutative[K := K, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing K field] \as Linear;
\import Linear.FiniteCoordinates[n := n] \as Coordinates;
\import Linear.Coordinates[I := Fin.Fin n] \as Vectors;
\import Vectors.Kronecker[] \as Delta;
\definition Index: \Set := Fin.Fin n;
\definition Vector: \Set := Vectors.Vector;
\definition Matrix: \Set := Mat.Matrix;
\definition pencil[A: Matrix]: Polynomials.Matrix := \fun (i, j: Index) =>
  P.add (P.mul P.X (P.constant (Delta.delta j i))) (P.neg (P.constant (A i j)));
\definition characteristic[A: Matrix]: Polynomial := Polynomials.determinant (pencil A);
\module On(A: Matrix);
\definition cayleyHamilton: \forall (A: Matrix)(v: Vector) ->
  \parent.Action[V := Vector, space := Vectors.space].At[T := Mat.linear A].apply (characteristic A) v = Vectors.origin :=
  \fun (A: Matrix) => On[A := A].annihilates;
