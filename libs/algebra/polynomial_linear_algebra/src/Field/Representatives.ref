\definition Of[p: Polynomial]: \Set := \Cast[Coefficients] ({ r: Coefficients \where Raw.asPolynomial r = p });
\definition singleton[a: K]: Coefficients := Lists.List[K]::cons a Lists.List[K]::nil;
\definition singletonLaw: \forall (a: K) -> Raw.asPolynomial (singleton a) = P.constant a :=
  \fun (a: K) => trans!{Polynomial} _ _ _
    (congr!{Polynomial Polynomial} (P.add (P.constant a)) _ _ (Raw.ring.semiring.zeroAbsorbsRight P.X)) (Sum.zeroRight (P.constant a));
\definition exists: \forall (p: Polynomial) -> \exists Of p := \parent.PolynomialInduction[].induction
  (\fun (p: Polynomial) => \exists Of p)
  (\fun (a: K) => \exact(\into[Coefficients](singleton a, Of (P.constant a)) \by { singletonLaw a }, Of (P.constant a)))
  (\exact(\into[Coefficients](Lists.List[K]::cons Scalars.zero (singleton Scalars.one), Of P.X) \by {
    trans!{Polynomial} _ _ _ (Raw.shift (singleton Scalars.one))
      (trans!{Polynomial} _ _ _ (congr!{Polynomial Polynomial} (P.mul P.X) _ _ (singletonLaw Scalars.one)) (Product.zeroRight P.X))
  }, Of P.X))
  (\block {
    \fun (p, q: Polynomial)(hp: _)(hq: _) \then
    \takefrom a: Of p \by hp \then
    \takefrom b: Of q \by hq \then
    \return \exact(\into[Coefficients](Raw.plus a b, Of (P.add p q)) \by {
      trans!{Polynomial} _ _ _ (Raw.plusLaw a b)
        (congr!{Polynomial Polynomial Polynomial} P.add _ _ _ _ (\bysub(Coefficients, Of p, a)) (\bysub(Coefficients, Of q, b)))
    }, Of (P.add p q))
  })
  (\block {
    \fun (p: Polynomial)(hp: _) \then
    \takefrom a: Of p \by hp \then
    \return \exact(\into[Coefficients](Raw.scale (Scalars.neg Scalars.one) a, Of (P.neg p)) \by {
      eq_reason_in!{Polynomial _
        "=" _ "by" { Raw.scaleLaw (Scalars.neg Scalars.one) a }
        "=" { P.mul (P.neg P.one) p } "by" { congr!{Polynomial Polynomial Polynomial} P.mul _ _ _ _ (Raw.Laws[].constantNeg Scalars.one) (\bysub(Coefficients, Of p, a)) }
        "=" _ "by" { PolynomialLaws.minusOneScale p }
      }
    }, Of (P.neg p))
  })
  (\block {
    \fun (p, q: Polynomial)(hp: _)(hq: _) \then
    \takefrom a: Of p \by hp \then
    \takefrom b: Of q \by hq \then
    \return \exact(\into[Coefficients](Raw.times a b, Of (P.mul p q)) \by {
      trans!{Polynomial} _ _ _ (Raw.timesLaw a b)
        (congr!{Polynomial Polynomial Polynomial} P.mul _ _ _ _ (\bysub(Coefficients, Of p, a)) (\bysub(Coefficients, Of q, b)))
    }, Of (P.mul p q))
  });
\definition gcdExists: \forall (p, q: Polynomial) -> \exists Gcd[p, q] := \block {
  \fun (p, q: Polynomial) \then
  \takefrom a: Of p \by exists p \then
  \takefrom b: Of q \by exists q \then
  \return \idelim Raw.asPolynomial a = p \with x: Polynomial => \exists Gcd[x, q] \by {
    base: \idelim Raw.asPolynomial b = q \with y: Polynomial => \exists Gcd[Raw.asPolynomial a, y] \by {
      base: \parent.Euclid[].exists a b, equality: \bysub(Coefficients, Of q, b)
    }, equality: \bysub(Coefficients, Of p, a)
  }
};
\structure PresentedDivision[p, q: Polynomial]: \Set := {
  dividend: Of p,
  divisor: Of q,
  result: DivisionResult[dividend, divisor],
};
\definition divisionExists: \forall (p, q: Polynomial) -> Logic.Not (q = P.zero) -> \exists PresentedDivision[p, q] := \block {
  \fun (p, q: Polynomial)(nonzero: _) \then
  \takefrom a: Of p \by exists p \then
  \takefrom b: Of q \by exists q \then
  \takefrom result: DivisionResult[a, b] \by \parent.Euclid[].divide a b
    (\fun (zero: Raw.asPolynomial b = P.zero) => nonzero (trans!{Polynomial} _ _ _ (sym!{Polynomial} _ _ (\bysub(Coefficients, Of q, b))) zero)) \then
  \return \exact(PresentedDivision[p, q] { dividend := a, divisor := b, result := result }, PresentedDivision[p, q])
};
