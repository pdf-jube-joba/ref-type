\import std.Alg[].Ring[] \as Ring;
\import std.Alg[].Alg[] \as Alg;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;
\definition ordinaryRing: Ring.Ring[R] := Ring.commutativeRingAsRing R ring;
\import module_theory.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
\module HomSpace(V, W: \Set, source: Modules.Space V, target: Modules.Space W);
\module FreeHom(Generators, W: \Set, target: Modules.Space W);
\module FiniteHom(n: std.Data[].Nat[].Nat^, W: \Set, target: Modules.Space W);
\module Tensor(V, W: \Set, left: Modules.Space V, right: Modules.Space W);
\module FreeTensor(Generators, W: \Set, target: Modules.Space W);
\module ShortExactDual(A, B, C, N: Modules.Bundle);
\module Matrix(m, n: std.Data[].Nat[].Nat^);
\module Elementary(n: std.Data[].Nat[].Nat^);
\module ScalarHom(N: Modules.Bundle);
\module ScalarTensor(N: Modules.Bundle);
\module ProjectiveHomShortExact(P, A, B, C: Modules.Bundle);

\module FreeTensorMapping(Generators: \Set, A, B: Modules.Bundle);

\module ProjectiveTensor(P, A, B: Modules.Bundle);

\module ProjectiveTensorShortExact(P, A, B, C: Modules.Bundle);
\module TensorProjective(P, Q: Modules.Bundle);
\module Bilinear(A, B, C: Modules.Bundle);
