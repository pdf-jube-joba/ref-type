\import \parent.\parent.FreeTensorMapping[Generators := P.Carrier, A := A, B := B].On[f := f] \as FreeAction;
\definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Coefficients.map End.identity f;
\import Modules.Tensor[V := Free.Carrier, W := A.Carrier, left := Free.space, right := A.space] \as FreeSource;
\import Modules.Tensor[V := Free.Carrier, W := B.Carrier, left := Free.space, right := B.space] \as FreeTarget;
\import Modules.Hom[V := P.Carrier, W := Free.Carrier, source := P.space, target := Free.space] \as Sections;
\module Chosen(section: Sections.Map);
\definition injective: Modules.Projective P -> Modules.Injective A B f -> \forall (x, y: Source.Carrier) -> #apply{map} x = #apply{map} y -> x = y := \block {
  \fun (projective: Modules.Projective P)(injection: Modules.Injective A B f)(x, y: Source.Carrier)(equal: #apply{map} x = #apply{map} y) \then
  \takefrom section: \Cast[Sections.Map] ({ section: Sections.Map \where \forall (p: P.Carrier) -> #apply{Canonical.augmentation} (#apply{section} p) = p })
    \by projective Canonical.Carrier Canonical.space P.Carrier P.space Canonical.augmentation Canonical.onto End.identity \then
  \return Chosen[section := section].injective
    (\bysub(Sections.Map, { section: Sections.Map \where \forall (p: P.Carrier) -> #apply{Canonical.augmentation} (#apply{section} p) = p }, section)) injection x y equal
};
