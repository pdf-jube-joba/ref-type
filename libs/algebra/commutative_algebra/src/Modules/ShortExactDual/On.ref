\import \parent.\parent.HomSpace[V := A.Carrier, W := N.Carrier, source := A.space, target := N.space] \as HA;
\import \parent.\parent.HomSpace[V := B.Carrier, W := N.Carrier, source := B.space, target := N.space] \as HB;
\import \parent.\parent.HomSpace[V := C.Carrier, W := N.Carrier, source := C.space, target := N.space] \as HC;
\definition left: Modules.Bundle := Modules.Bundle { Carrier := HC.Carrier, space := HC.space };
\definition middle: Modules.Bundle := Modules.Bundle { Carrier := HB.Carrier, space := HB.space };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := HA.Carrier, space := HA.space };
\import Modules.ShortExact[A := left, B := middle, C := right] \as Dual;
\import Modules.Hom[V := C.Carrier, W := N.Carrier, source := C.space, target := N.space].Composition[U := B.Carrier, domain := B.space] \as PreProjection;
\import Modules.Hom[V := A.Carrier, W := N.Carrier, source := A.space, target := N.space] \as LeftMaps;
\import Modules.Hom[V := B.Carrier, W := N.Carrier, source := B.space, target := N.space] \as MiddleMaps;
\import Modules.Hom[V := C.Carrier, W := N.Carrier, source := C.space, target := N.space] \as RightMaps;
\import Modules.Hom[V := B.Carrier, W := N.Carrier, source := B.space, target := N.space].Composition[U := A.Carrier, domain := A.space] \as PreInclusion;
\import Modules.Hom[V := HC.Carrier, W := HB.Carrier, source := HC.space, target := HB.space] \as DualInclusion;
\definition inclusion: DualInclusion.Map := DualInclusion.Map {
  apply := \fun (f: HC.Carrier) => PreProjection.compose f sequence.projection,
  addition := \fun (f, g: HC.Carrier) => MiddleMaps.ext (PreProjection.compose (HC.space.add f g) sequence.projection) (HB.space.add (PreProjection.compose f sequence.projection) (PreProjection.compose g sequence.projection)) (\fun (x: B.Carrier) => \refl(N.space.add (f.apply (sequence.projection.apply x)) (g.apply (sequence.projection.apply x)))),
  scalar := \fun (a: R)(f: HC.Carrier) => MiddleMaps.ext (PreProjection.compose (HC.space.smul a f) sequence.projection) (HB.space.smul a (PreProjection.compose f sequence.projection)) (\fun (x: B.Carrier) => \refl(N.space.smul a (f.apply (sequence.projection.apply x)))),
};
\import Modules.Hom[V := HB.Carrier, W := HA.Carrier, source := HB.space, target := HA.space] \as DualProjection;
\definition projection: DualProjection.Map := DualProjection.Map {
  apply := \fun (f: HB.Carrier) => PreInclusion.compose f sequence.inclusion,
  addition := \fun (f, g: HB.Carrier) => LeftMaps.ext (PreInclusion.compose (HB.space.add f g) sequence.inclusion) (HA.space.add (PreInclusion.compose f sequence.inclusion) (PreInclusion.compose g sequence.inclusion)) (\fun (x: A.Carrier) => \refl(N.space.add (f.apply (sequence.inclusion.apply x)) (g.apply (sequence.inclusion.apply x)))),
  scalar := \fun (a: R)(f: HB.Carrier) => LeftMaps.ext (PreInclusion.compose (HB.space.smul a f) sequence.inclusion) (HA.space.smul a (PreInclusion.compose f sequence.inclusion)) (\fun (x: A.Carrier) => \refl(N.space.smul a (f.apply (sequence.inclusion.apply x)))),
};
\definition injective: \forall (f, g: HC.Carrier) -> inclusion.apply f = inclusion.apply g -> f = g :=
  \fun (f, g: HC.Carrier)(equal: _) => RightMaps.ext f g (\block {
    \fun (c: C.Carrier) \then
    \takefrom b: \Cast[B.Carrier] ({ b: B.Carrier \where sequence.projection.apply b = c }) \by sequence.onto c \then
    \let projected: sequence.projection.apply b = c := \bysub(B.Carrier, { b: B.Carrier \where sequence.projection.apply b = c }, b) \then
    \return trans!{N.Carrier} _ _ _ (sym!{N.Carrier} _ _ (congr!{C.Carrier N.Carrier} (f.apply) _ _ projected))
      (trans!{N.Carrier} _ _ _ (congr!{HB.Carrier N.Carrier} (\fun (h: HB.Carrier) => h.apply b) _ _ equal)
        (congr!{C.Carrier N.Carrier} (g.apply) _ _ projected))
  });
\definition compositeZero: \forall (f: HC.Carrier) -> projection.apply (inclusion.apply f) = HA.space.zero :=
  \fun (f: HC.Carrier) => LeftMaps.ext _ _ (\fun (x: A.Carrier) => trans!{N.Carrier} _ _ _
    (congr!{C.Carrier N.Carrier} (f.apply) _ _ (sequence.zero x)) (RightMaps.zeroPreserved f));
\import Modules.ShortExact[A := A, B := B, C := C].Splitting[sequence := sequence] \as Splitting;
\import Splitting.With[s := s] \as Split;
\definition Section: \Prop := Splitting.Section s;
\import Modules.Biproduct[V := A.Carrier, W := C.Carrier, left := A.space, right := C.space] \as Sum;
\import Modules.Hom[V := Sum.Carrier, W := A.Carrier, source := Sum.space, target := A.space].Composition[U := B.Carrier, domain := B.space] \as RetractionComposition;
\import Modules.Hom[V := B.Carrier, W := A.Carrier, source := B.space, target := A.space] \as Retractions;
\definition retraction(section: Section): Retractions.Map := RetractionComposition.compose Sum.firstProjection ((Split.isomorphism section).backward);
\import Modules.Laws[V := B.Carrier, space := B.space] \as Middle;
\import algebra.Group[].Of[Carrier := B.Carrier, group := Middle.additive] \as MiddleGroup;
\definition forwardInjection: \forall (a: A.Carrier) -> (Splitting.forward s).apply (Sum.make a C.space.zero) = sequence.inclusion.apply a :=
  \fun (a: A.Carrier) => trans!{B.Carrier} _ _ _
    (congr!{B.Carrier B.Carrier} (Middle.add (sequence.inclusion.apply a)) _ _ (Sections.zeroPreserved s))
    (MiddleGroup.zeroRight (sequence.inclusion.apply a));
\definition retractionLaw: \forall (section: Section)(a: A.Carrier) -> (retraction section).apply (sequence.inclusion.apply a) = a :=
  \fun (section: Section)(a: A.Carrier) => trans!{A.Carrier} _ _ _
    (congr!{B.Carrier A.Carrier} ((retraction section).apply) _ _ (sym!{B.Carrier} _ _ (forwardInjection a)))
    (congr!{Sum.Carrier A.Carrier} Sum.first _ _ ((Split.isomorphism section).leftInverse (Sum.make a C.space.zero)));
\import Modules.Hom[V := A.Carrier, W := N.Carrier, source := A.space, target := N.space].Composition[U := B.Carrier, domain := B.space] \as Extend;
\definition onto: Section -> \forall (f: HA.Carrier) -> \exists { g: HB.Carrier \where projection.apply g = f } :=
  \fun (section: Section)(f: HA.Carrier) => Logic.existsIntro[HB.Carrier, { g: HB.Carrier \where projection.apply g = f }] (Extend.compose f (retraction section))
    (LeftMaps.ext _ f (\fun (a: A.Carrier) => congr!{A.Carrier N.Carrier} (f.apply) _ _ (retractionLaw section a)));
\import Modules.Hom[V := B.Carrier, W := N.Carrier, source := B.space, target := N.space].Composition[U := C.Carrier, domain := C.space] \as Restrict;
\import Modules.Laws[V := N.Carrier, space := N.space] \as Coefficient;
\import algebra.Group[].Of[Carrier := N.Carrier, group := Coefficient.additive] \as NGroup;
\definition kernelImage: Section -> \forall (f: HB.Carrier) -> projection.apply f = HA.space.zero ->
  \exists { g: HC.Carrier \where inclusion.apply g = f } := \block {
  \fun (section: Section)(f: HB.Carrier)(killed: _) \then
  \let g: HC.Carrier := Restrict.compose f s \then
  \return Logic.existsIntro[HC.Carrier, { g: HC.Carrier \where inclusion.apply g = f }] g
    (MiddleMaps.ext _ f (\block {
      \fun (b: B.Carrier) \then
      \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where sequence.inclusion.apply a = Splitting.remainder s b })
        \by sequence.kernelImage (Splitting.remainder s b) (Splitting.remainderClosed s section b) \then
      \let represented: sequence.inclusion.apply a = Splitting.remainder s b :=
        \bysub(A.Carrier, { a: A.Carrier \where sequence.inclusion.apply a = Splitting.remainder s b }, a) \then
      \let vanished: f.apply (Splitting.remainder s b) = N.space.zero := trans!{N.Carrier} _ _ _
        (sym!{N.Carrier} _ _ (congr!{B.Carrier N.Carrier} (f.apply) _ _ represented))
        (congr!{HA.Carrier N.Carrier} (\fun (h: HA.Carrier) => h.apply a) _ _ killed) \then
      \return trans!{N.Carrier} _ _ _
        (sym!{N.Carrier} _ _ (NGroup.zeroLeft (f.apply (s.apply (sequence.projection.apply b)))))
        (trans!{N.Carrier} _ _ _ (congr!{N.Carrier N.Carrier} (\fun (x: N.Carrier) => N.space.add x (f.apply (s.apply (sequence.projection.apply b)))) _ _ (sym!{N.Carrier} _ _ vanished))
          (trans!{N.Carrier} _ _ _ (sym!{N.Carrier} _ _ (f.addition (Splitting.remainder s b) (s.apply (sequence.projection.apply b))))
            (congr!{B.Carrier N.Carrier} (f.apply) _ _ (Splitting.reconstruct s b))))
    }))
};
\definition shortExact(section: Section): Dual.Sequence := Dual.Sequence {
  inclusion := inclusion, projection := projection, injective := injective, onto := onto section,
  zero := compositeZero, kernelImage := kernelImage section,
};
\definition existence: Section -> \exists Dual.Sequence := \fun (section: Section) => \exact(shortExact section, Dual.Sequence);
