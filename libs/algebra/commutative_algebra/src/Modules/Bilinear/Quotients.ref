\import LeftSubmodules.Quotient[S := S] \as Left;
\import RightSubmodules.Quotient[S := T] \as Right;
\definition left: Modules.Bundle := Modules.Bundle { Carrier := Left.Carrier, space := Left.moduleSpace };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := Right.Carrier, space := Right.moduleSpace };
\import \parent.\parent.Bilinear[A := left, B := right, C := C] \as Result;
\definition QuotientMap: \Set := Result.Map;
\definition VanishesLeft[f: Map]: \Prop := \forall (x: A.Carrier)(y: B.Carrier) -> LeftSubmodules.Member S x -> (f).apply x y = (C.space).zero;
\definition VanishesRight[f: Map]: \Prop := \forall (x: A.Carrier)(y: B.Carrier) -> RightSubmodules.Member T y -> (f).apply x y = (C.space).zero;
\module On(f: Map);
\definition descend[f: Map][leftZero: VanishesLeft f][rightZero: VanishesRight f]: QuotientMap := On[f := f].map leftZero rightZero;
\definition onClasses: \forall (f: Map)(leftZero: VanishesLeft f)(rightZero: VanishesRight f)(x: A.Carrier)(y: B.Carrier) ->
  (descend f leftZero rightZero).apply (Left.class x) (Right.class y) = (f).apply x y :=
  \fun (f: Map)(leftZero: VanishesLeft f)(rightZero: VanishesRight f) => On[f := f].onClasses leftZero rightZero;
