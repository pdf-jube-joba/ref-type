\use std.Logic[].Equality[].eq_reason_in;
\definition map[leftZero: VanishesLeft f]: RightMaps.Map := RightMaps.Map {
  apply := leftDescend leftZero,
  addition := \fun (y, z: B.Carrier) => LeftQuotientMaps.ext
    (leftDescend leftZero ((B.space).add y z))
    (Functions.add (leftDescend leftZero y) (leftDescend leftZero z))
    (Left.induction (\fun (x: Left.Carrier) =>
      (leftDescend leftZero ((B.space).add y z)).apply x =
        (C.space).add ((leftDescend leftZero y).apply x) ((leftDescend leftZero z).apply x))
      (\fun (x: A.Carrier) => eq_reason_in!{C.Carrier _
        "=" _ "by" { leftOnClass leftZero x ((B.space).add y z) }
        "=" _ "by" { (laws f).addRight x y z }
        "=" _ "by" { sym!{C.Carrier} _ _ (congr!{C.Carrier C.Carrier C.Carrier} ((C.space).add) _ _ _ _
            (leftOnClass leftZero x y) (leftOnClass leftZero x z)) }
      })),
  scalar := \fun (a: R)(y: B.Carrier) => LeftQuotientMaps.ext
    (leftDescend leftZero ((B.space).smul a y))
    (Functions.scale a (leftDescend leftZero y))
    (Left.induction (\fun (x: Left.Carrier) =>
      (leftDescend leftZero ((B.space).smul a y)).apply x =
        (C.space).smul a ((leftDescend leftZero y).apply x))
      (\fun (x: A.Carrier) => eq_reason_in!{C.Carrier _
        "=" _ "by" { leftOnClass leftZero x ((B.space).smul a y) }
        "=" _ "by" { (laws f).scaleRight a x y }
        "=" _ "by" { sym!{C.Carrier} _ _ (congr!{C.Carrier C.Carrier} ((C.space).smul a) _ _ (leftOnClass leftZero x y)) }
      })),
};
\definition vanishes: \forall (leftZero: VanishesLeft f)(rightZero: VanishesRight f) -> RightDescent.Vanishes (map leftZero) :=
  \fun (leftZero: VanishesLeft f)(rightZero: VanishesRight f)(y: B.Carrier)(member: RightSubmodules.Member T y) =>
    LeftQuotientMaps.ext (leftDescend leftZero y) Functions.zero
      (Left.induction (\fun (x: Left.Carrier) => (leftDescend leftZero y).apply x = (C.space).zero)
        (\fun (x: A.Carrier) => trans!{C.Carrier} _ _ _ (leftOnClass leftZero x y) (rightZero x y member)));
