\definition map(leftZero: VanishesLeft f): RightMaps.Map := RightMaps.Map {
  apply := leftDescend leftZero,
  addition := \fun (y, z: B.Carrier) => LeftQuotientMaps.ext
    (leftDescend leftZero (#add{B.space} y z))
    (Functions.add (leftDescend leftZero y) (leftDescend leftZero z))
    (Left.induction (\fun (x: Left.Carrier) =>
      #apply{(leftDescend leftZero (#add{B.space} y z))} x =
        #add{C.space} (#apply{(leftDescend leftZero y)} x) (#apply{(leftDescend leftZero z)} x))
      (\fun (x: A.Carrier) => trans!{C.Carrier} _ _ _ (leftOnClass leftZero x (#add{B.space} y z))
        (trans!{C.Carrier} _ _ _ (#addRight{(laws f)} x y z)
          (sym!{C.Carrier} _ _ (congr2!{C.Carrier C.Carrier C.Carrier} (#add{C.space}) _ _ _ _
            (leftOnClass leftZero x y) (leftOnClass leftZero x z)))))),
  scalar := \fun (a: R)(y: B.Carrier) => LeftQuotientMaps.ext
    (leftDescend leftZero (#smul{B.space} a y))
    (Functions.scale a (leftDescend leftZero y))
    (Left.induction (\fun (x: Left.Carrier) =>
      #apply{(leftDescend leftZero (#smul{B.space} a y))} x =
        #smul{C.space} a (#apply{(leftDescend leftZero y)} x))
      (\fun (x: A.Carrier) => trans!{C.Carrier} _ _ _ (leftOnClass leftZero x (#smul{B.space} a y))
        (trans!{C.Carrier} _ _ _ (#scaleRight{(laws f)} a x y)
          (sym!{C.Carrier} _ _ (congr!{C.Carrier C.Carrier} (#smul{C.space} a) _ _ (leftOnClass leftZero x y)))))),
};
\definition vanishes: \forall (leftZero: VanishesLeft f)(rightZero: VanishesRight f) -> RightDescent.Vanishes (map leftZero) :=
  \fun (leftZero: VanishesLeft f)(rightZero: VanishesRight f)(y: B.Carrier)(member: RightSubmodules.Member T y) =>
    LeftQuotientMaps.ext (leftDescend leftZero y) Functions.zero
      (Left.induction (\fun (x: Left.Carrier) => #apply{(leftDescend leftZero y)} x = #zero{C.space})
        (\fun (x: A.Carrier) => trans!{C.Carrier} _ _ _ (leftOnClass leftZero x y) (rightZero x y member)));
