\import Modules.Hom[V := D.Carrier, W := A.Carrier, source := D.space, target := A.space] \as Left;
\import Modules.Hom[V := E.Carrier, W := B.Carrier, source := E.space, target := B.space] \as Right;
\import \parent.\parent.Bilinear[A := D, B := E, C := C] \as Result;
\definition apply(f: Map)(u: Left.Map)(v: Right.Map): Result.Map := Result.Map {
  apply := \fun (x: D.Carrier)(y: E.Carrier) => #apply{f} (#apply{u} x) (#apply{v} y),
  addLeft := \fun (x, y: D.Carrier)(z: E.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{A.Carrier C.Carrier} (\fun (a: A.Carrier) => #apply{f} a (#apply{v} z)) _ _ (#addition{u} x y))
    (#addLeft{(laws f)} (#apply{u} x) (#apply{u} y) (#apply{v} z)),
  addRight := \fun (x: D.Carrier)(y, z: E.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{B.Carrier C.Carrier} (#apply{f} (#apply{u} x)) _ _ (#addition{v} y z))
    (#addRight{(laws f)} (#apply{u} x) (#apply{v} y) (#apply{v} z)),
  scaleLeft := \fun (a: R)(x: D.Carrier)(y: E.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{A.Carrier C.Carrier} (\fun (z: A.Carrier) => #apply{f} z (#apply{v} y)) _ _ (#scalar{u} a x))
    (#scaleLeft{(laws f)} a (#apply{u} x) (#apply{v} y)),
  scaleRight := \fun (a: R)(x: D.Carrier)(y: E.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{B.Carrier C.Carrier} (#apply{f} (#apply{u} x)) _ _ (#scalar{v} a y))
    (#scaleRight{(laws f)} a (#apply{u} x) (#apply{v} y)),
};
