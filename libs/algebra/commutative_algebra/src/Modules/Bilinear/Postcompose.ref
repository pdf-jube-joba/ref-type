\import Modules.Hom[V := C.Carrier, W := D.Carrier, source := C.space, target := D.space] \as Maps;
\import \parent.\parent.Bilinear[A := A, B := B, C := D] \as Result;
\definition apply[f: Map][u: Maps.Map]: Result.Map := Result.Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => (u).apply ((f).apply x y),
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => trans!{D.Carrier} _ _ _
    (congr!{C.Carrier D.Carrier} ((u).apply) _ _ ((laws f).addLeft x y z))
    ((u).addition ((f).apply x z) ((f).apply y z)),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => trans!{D.Carrier} _ _ _
    (congr!{C.Carrier D.Carrier} ((u).apply) _ _ ((laws f).addRight x y z))
    ((u).addition ((f).apply x y) ((f).apply x z)),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{D.Carrier} _ _ _
    (congr!{C.Carrier D.Carrier} ((u).apply) _ _ ((laws f).scaleLeft a x y)) ((u).scalar a ((f).apply x y)),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{D.Carrier} _ _ _
    (congr!{C.Carrier D.Carrier} ((u).apply) _ _ ((laws f).scaleRight a x y)) ((u).scalar a ((f).apply x y)),
};
