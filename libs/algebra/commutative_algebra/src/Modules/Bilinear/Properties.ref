\definition leftZero(f: Map)(y: B.Carrier): #apply{f} #zero{A.space} y = #zero{C.space} :=
  LeftMaps.zeroPreserved (leftAt f y);
\definition rightZero(f: Map)(x: A.Carrier): #apply{f} x #zero{B.space} = #zero{C.space} :=
  RightMaps.zeroPreserved (rightAt f x);
\definition leftNegative(f: Map)(x: A.Carrier)(y: B.Carrier):
  #apply{f} (#neg{A.space} x) y = #neg{C.space} (#apply{f} x y) := LeftMaps.negativePreserved (leftAt f y) x;
\definition rightNegative(f: Map)(x: A.Carrier)(y: B.Carrier):
  #apply{f} x (#neg{B.space} y) = #neg{C.space} (#apply{f} x y) := RightMaps.negativePreserved (rightAt f x) y;
