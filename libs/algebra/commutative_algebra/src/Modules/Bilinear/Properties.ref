\definition leftZero[f: Map][y: B.Carrier]: (f).apply (A.space).zero y = (C.space).zero :=
  LeftMaps.zeroPreserved (leftAt f y);
\definition rightZero[f: Map][x: A.Carrier]: (f).apply x (B.space).zero = (C.space).zero :=
  RightMaps.zeroPreserved (rightAt f x);
\definition leftNegative[f: Map][x: A.Carrier][y: B.Carrier]:
  (f).apply ((A.space).neg x) y = (C.space).neg ((f).apply x y) := LeftMaps.negativePreserved (leftAt f y) x;
\definition rightNegative[f: Map][x: A.Carrier][y: B.Carrier]:
  (f).apply x ((B.space).neg y) = (C.space).neg ((f).apply x y) := RightMaps.negativePreserved (rightAt f x) y;
