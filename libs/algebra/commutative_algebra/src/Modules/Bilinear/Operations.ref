\import Modules.Laws[V := C.Carrier, space := C.space] \as Target;
\import algebra.Group[].Of[Carrier := C.Carrier, group := Target.additive] \as Group;
\definition zero: Map := Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => (C.space).zero,
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => sym!{C.Carrier} _ _ (Group.zeroLeft (C.space).zero),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => sym!{C.Carrier} _ _ (Group.zeroLeft (C.space).zero),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => sym!{C.Carrier} _ _ (Target.scaleZero a),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => sym!{C.Carrier} _ _ (Target.scaleZero a),
};
\definition plus[f, g: Map]: Map := Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => (C.space).add ((f).apply x y) ((g).apply x y),
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} ((C.space).add) _ _ _ _ ((laws f).addLeft x y z) ((laws g).addLeft x y z))
    (Group.four ((f).apply x z) ((f).apply y z) ((g).apply x z) ((g).apply y z)),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} ((C.space).add) _ _ _ _ ((laws f).addRight x y z) ((laws g).addRight x y z))
    (Group.four ((f).apply x y) ((f).apply x z) ((g).apply x y) ((g).apply x z)),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} ((C.space).add) _ _ _ _ ((laws f).scaleLeft a x y) ((laws g).scaleLeft a x y))
    (sym!{C.Carrier} _ _ ((C.space).vectorAdd a ((f).apply x y) ((g).apply x y))),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} ((C.space).add) _ _ _ _ ((laws f).scaleRight a x y) ((laws g).scaleRight a x y))
    (sym!{C.Carrier} _ _ ((C.space).vectorAdd a ((f).apply x y) ((g).apply x y))),
};
\definition negative[f: Map]: Map := Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => (C.space).neg ((f).apply x y),
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} ((C.space).neg) _ _ ((laws f).addLeft x y z)) (Group.negAdd ((f).apply x z) ((f).apply y z)),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} ((C.space).neg) _ _ ((laws f).addRight x y z)) (Group.negAdd ((f).apply x y) ((f).apply x z)),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} ((C.space).neg) _ _ ((laws f).scaleLeft a x y)) (sym!{C.Carrier} _ _ (Target.scaleNeg a ((f).apply x y))),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} ((C.space).neg) _ _ ((laws f).scaleRight a x y)) (sym!{C.Carrier} _ _ (Target.scaleNeg a ((f).apply x y))),
};
\import std.Data[].Nat[] \as N;
\import Modules.Alternating[V := C.Carrier, space := C.space].Concatenation[] \as Signs;
\definition sign: N.Nat^ -> Map -> Map := \induction (n: N.Nat^) \return Map -> Map \with {
  | zero: \fun (f: Map) => f
  | succ: \fun (n: N.Nat^)(previous: Map -> Map)(f: Map) => negative (previous f)
};
\definition onSign: \forall (n: N.Nat^)(f: Map)(x: A.Carrier)(y: B.Carrier) -> (sign n f).apply x y = Signs.twist n ((f).apply x y) :=
  \induction (n: N.Nat^) \return \forall (f: Map)(x: A.Carrier)(y: B.Carrier) -> (sign n f).apply x y = Signs.twist n ((f).apply x y) \with {
    | zero: \fun (f: Map)(x: A.Carrier)(y: B.Carrier) => \refl((f).apply x y)
    | succ: \fun (n: N.Nat^)(previous: _)(f: Map)(x: A.Carrier)(y: B.Carrier) => congr!{C.Carrier C.Carrier} ((C.space).neg) _ _ (previous f x y)
  };
