\import Modules.Laws[V := C.Carrier, space := C.space] \as Target;
\import algebra.Group[].Of[Carrier := C.Carrier, group := Target.additive] \as Group;
\definition zero: Map := Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => #zero{C.space},
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => sym!{C.Carrier} _ _ (Group.zeroLeft #zero{C.space}),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => sym!{C.Carrier} _ _ (Group.zeroLeft #zero{C.space}),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => sym!{C.Carrier} _ _ (Target.scaleZero a),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => sym!{C.Carrier} _ _ (Target.scaleZero a),
};
\definition plus(f, g: Map): Map := Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => #add{C.space} (#apply{f} x y) (#apply{g} x y),
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} (#add{C.space}) _ _ _ _ (#addLeft{(laws f)} x y z) (#addLeft{(laws g)} x y z))
    (Group.four (#apply{f} x z) (#apply{f} y z) (#apply{g} x z) (#apply{g} y z)),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} (#add{C.space}) _ _ _ _ (#addRight{(laws f)} x y z) (#addRight{(laws g)} x y z))
    (Group.four (#apply{f} x y) (#apply{f} x z) (#apply{g} x y) (#apply{g} x z)),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} (#add{C.space}) _ _ _ _ (#scaleLeft{(laws f)} a x y) (#scaleLeft{(laws g)} a x y))
    (sym!{C.Carrier} _ _ (#vectorAdd{C.space} a (#apply{f} x y) (#apply{g} x y))),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr2!{C.Carrier C.Carrier C.Carrier} (#add{C.space}) _ _ _ _ (#scaleRight{(laws f)} a x y) (#scaleRight{(laws g)} a x y))
    (sym!{C.Carrier} _ _ (#vectorAdd{C.space} a (#apply{f} x y) (#apply{g} x y))),
};
\definition negative(f: Map): Map := Map {
  apply := \fun (x: A.Carrier)(y: B.Carrier) => #neg{C.space} (#apply{f} x y),
  addLeft := \fun (x, y: A.Carrier)(z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} (#neg{C.space}) _ _ (#addLeft{(laws f)} x y z)) (Group.negAdd (#apply{f} x z) (#apply{f} y z)),
  addRight := \fun (x: A.Carrier)(y, z: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} (#neg{C.space}) _ _ (#addRight{(laws f)} x y z)) (Group.negAdd (#apply{f} x y) (#apply{f} x z)),
  scaleLeft := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} (#neg{C.space}) _ _ (#scaleLeft{(laws f)} a x y)) (sym!{C.Carrier} _ _ (Target.scaleNeg a (#apply{f} x y))),
  scaleRight := \fun (a: R)(x: A.Carrier)(y: B.Carrier) => trans!{C.Carrier} _ _ _
    (congr!{C.Carrier C.Carrier} (#neg{C.space}) _ _ (#scaleRight{(laws f)} a x y)) (sym!{C.Carrier} _ _ (Target.scaleNeg a (#apply{f} x y))),
};
\import std.Data[].Nat[] \as N;
\import Modules.Alternating[V := C.Carrier, space := C.space].Concatenation[] \as Signs;
\definition sign: N.Nat^ -> Map -> Map := \induction (n: N.Nat^) \return Map -> Map \with {
  | zero: \fun (f: Map) => f
  | succ: \fun (n: N.Nat^)(previous: Map -> Map)(f: Map) => negative (previous f)
};
\definition onSign: \forall (n: N.Nat^)(f: Map)(x: A.Carrier)(y: B.Carrier) -> #apply{(sign n f)} x y = Signs.twist n (#apply{f} x y) :=
  \induction (n: N.Nat^) \return \forall (f: Map)(x: A.Carrier)(y: B.Carrier) -> #apply{(sign n f)} x y = Signs.twist n (#apply{f} x y) \with {
    | zero: \fun (f: Map)(x: A.Carrier)(y: B.Carrier) => \refl(#apply{f} x y)
    | succ: \fun (n: N.Nat^)(previous: _)(f: Map)(x: A.Carrier)(y: B.Carrier) => congr!{C.Carrier C.Carrier} (#neg{C.space}) _ _ (previous f x y)
  };
