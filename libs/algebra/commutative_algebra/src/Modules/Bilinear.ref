\structure Data: \Set := { apply: A.Carrier -> B.Carrier -> C.Carrier };
\structure Laws[f: Data]: \Prop := {
  addLeft: \forall (x, y: A.Carrier)(z: B.Carrier) -> (f).apply ((A.space).add x y) z = (C.space).add ((f).apply x z) ((f).apply y z),
  addRight: \forall (x: A.Carrier)(y, z: B.Carrier) -> (f).apply x ((B.space).add y z) = (C.space).add ((f).apply x y) ((f).apply x z),
  scaleLeft: \forall (a: R)(x: A.Carrier)(y: B.Carrier) -> (f).apply ((A.space).smul a x) y = (C.space).smul a ((f).apply x y),
  scaleRight: \forall (a: R)(x: A.Carrier)(y: B.Carrier) -> (f).apply x ((B.space).smul a y) = (C.space).smul a ((f).apply x y),
};
\definition Map: \Set := \Cast[Data] ({ f: Data \where Laws[f] });
\definition laws[f: Map]: Laws[f] := \bysub(Data, { g: Data \where Laws[g] }, f);
\definition dataExt: \forall (f, g: Data) -> (f).apply = (g).apply -> f = g :=
  \induction (f: Data) \return \forall (g: Data) -> (f).apply = (g).apply -> f = g \with {
    | # : \fun (f: A.Carrier -> B.Carrier -> C.Carrier) =>
      \induction (g: Data) \return f = (g).apply -> Data::# f = g \with {
        | # : \fun (g: A.Carrier -> B.Carrier -> C.Carrier)(same: f = g) =>
          congr!{{A.Carrier -> B.Carrier -> C.Carrier} Data} (\fun (h: A.Carrier -> B.Carrier -> C.Carrier) => Data::# h) _ _ same
      }
  };
\definition ext: \forall (f, g: Map) -> (\forall (x: A.Carrier)(y: B.Carrier) -> (f).apply x y = (g).apply x y) -> f = g :=
  \fun (f, g: Map)(same: _) => dataExt f g
    (\axiom:funext((f).apply, (g).apply, \fun (x: A.Carrier) => \axiom:funext((f).apply x, (g).apply x, same x)));
\import Modules.Hom[V := A.Carrier, W := C.Carrier, source := A.space, target := C.space] \as LeftMaps;
\import Modules.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as RightMaps;
\definition leftAt[f: Map][y: B.Carrier]: LeftMaps.Map := LeftMaps.Map {
  apply := \fun (x: A.Carrier) => (f).apply x y,
  addition := \fun (x, z: A.Carrier) => (laws f).addLeft x z y,
  scalar := \fun (a: R)(x: A.Carrier) => (laws f).scaleLeft a x y,
};
\definition rightAt[f: Map][x: A.Carrier]: RightMaps.Map := RightMaps.Map {
  apply := (f).apply x,
  addition := (laws f).addRight x,
  scalar := \fun (a: R)(y: B.Carrier) => (laws f).scaleRight a x y,
};
\import Modules.Of[V := A.Carrier, space := A.space].Submodule[] \as LeftSubmodules;
\import Modules.Of[V := B.Carrier, space := B.space].Submodule[] \as RightSubmodules;
\module Quotients(S: LeftSubmodules.Submodule, T: RightSubmodules.Submodule);
\module Operations;
\module Precompose(D, E: Modules.Bundle);
\module Postcompose(D: Modules.Bundle);
\module Properties;
