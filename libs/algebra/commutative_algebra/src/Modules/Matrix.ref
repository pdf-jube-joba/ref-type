\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Finite;
\import std.Data[].List[] \as Lists;
\import Modules.FiniteCoordinates[n := n] \as Domain;
\import Modules.FiniteCoordinates[n := m] \as Codomain;
\definition Matrix: \Set := Finite.Fin m -> Finite.Fin n -> R;
\definition add(a, b: Matrix): Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin n) => ordinaryRing.add (a i j) (b i j);
\definition zero: Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin n) => ordinaryRing.zero;
\definition negate(a: Matrix): Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin n) => ordinaryRing.neg (a i j);
\import Modules.Sums[I := Finite.Fin n] \as Sums;
\import Sums.Prop[] \as SumLaws;
\definition apply(a: Matrix)(v: Domain.Carrier): Codomain.Carrier :=
  \fun (i: Finite.Fin m) => Sums.sum (Finite.elements n) (\fun (j: Finite.Fin n) => ordinaryRing.mul (a i j) (v j));
\import Modules.Hom[V := Domain.Carrier, W := Codomain.Carrier, source := Domain.space, target := Codomain.space] \as Maps;
\definition scalarComm: \forall (a, b, c: R) -> ordinaryRing.mul a (ordinaryRing.mul b c) = ordinaryRing.mul b (ordinaryRing.mul a c) :=
  \fun (a, b, c: R) => trans!{R} _ _ _
    (sym!{R} _ _ (((ordinaryRing.semiring).multiplicative).associative a b c))
    (trans!{R} _ _ _ (congr!{R R} (\fun (r: R) => ordinaryRing.mul r c) _ _ (ring.mulCommutative a b))
      (((ordinaryRing.semiring).multiplicative).associative b a c));
\definition linear(a: Matrix): Maps.Map := Maps.Map {
  apply := apply a,
  addition := \fun (v, w: Domain.Carrier) => \axiom:funext(apply a (Domain.space.add v w), Codomain.space.add (apply a v) (apply a w),
    \fun (i: Finite.Fin m) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements n) (\fun (j: Finite.Fin n) => ordinaryRing.mul (a i j) (ordinaryRing.add (v j) (w j)))
        (\fun (j: Finite.Fin n) => ordinaryRing.add (ordinaryRing.mul (a i j) (v j)) (ordinaryRing.mul (a i j) (w j)))
        (\fun (j: Finite.Fin n) => (ordinaryRing.semiring).leftDistributive (a i j) (v j) (w j)))
      (SumLaws.additive (Finite.elements n) (\fun (j: Finite.Fin n) => ordinaryRing.mul (a i j) (v j)) (\fun (j: Finite.Fin n) => ordinaryRing.mul (a i j) (w j)))),
  scalar := \fun (b: R)(v: Domain.Carrier) => \axiom:funext(apply a (Domain.space.smul b v), Codomain.space.smul b (apply a v),
    \fun (i: Finite.Fin m) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements n) (\fun (j: Finite.Fin n) => ordinaryRing.mul (a i j) (ordinaryRing.mul b (v j)))
        (\fun (j: Finite.Fin n) => ordinaryRing.mul b (ordinaryRing.mul (a i j) (v j))) (\fun (j: Finite.Fin n) => scalarComm (a i j) b (v j)))
      (SumLaws.multiplyLeft (Finite.elements n) b (\fun (j: Finite.Fin n) => ordinaryRing.mul (a i j) (v j)))),
};
\definition zeroAction: \forall (v: Domain.Carrier) -> apply zero v = Codomain.space.zero :=
  \fun (v: Domain.Carrier) => \axiom:funext(apply zero v, Codomain.space.zero,
    \fun (i: Finite.Fin m) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements n) (\fun (j: Finite.Fin n) => ordinaryRing.mul ordinaryRing.zero (v j))
        (\fun (j: Finite.Fin n) => ordinaryRing.zero)
        (\fun (j: Finite.Fin n) => (ordinaryRing.semiring).zeroAbsorbsLeft (v j)))
      (SumLaws.zeroSum (Finite.elements n)));
\definition entries(f: Maps.Map): Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin n) => f.apply (Domain.basis j) i;
\module Representation;
\module Dual;
\module Composition(k: N.Nat^);
\module Transpose;
\module End;
\module Invertible;
\module WithBases(V, W: \Set, source: Modules.Space V, target: Modules.Space W,
  basisSource: Modules.Isomorphism[V := V, W := Domain.Carrier, source := source, target := Domain.space].Isomorphism,
  basisTarget: Modules.Isomorphism[V := W, W := Codomain.Carrier, source := target, target := Codomain.space].Isomorphism);
