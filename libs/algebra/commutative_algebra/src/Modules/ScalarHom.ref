\use std.Logic[].Equality[].eq_reason_in;
\import \parent.HomSpace[V := R, W := N.Carrier, source := Modules.scalarModule, target := N.space] \as Hom;
\import Modules.Hom[V := R, W := N.Carrier, source := Modules.scalarModule, target := N.space] \as Maps;
\definition value[a: N.Carrier]: Maps.Map := Maps.Map {
  apply := \fun (r: R) => N.space.smul r a,
  addition := \fun (r, s: R) => N.space.scalarAdd r s a,
  scalar := \fun (r, s: R) => N.space.scalarAssoc r s a,
};
\import Modules.Hom[V := Hom.Carrier, W := N.Carrier, source := Hom.space, target := N.space] \as Forward;
\import Modules.Hom[V := N.Carrier, W := Hom.Carrier, source := N.space, target := Hom.space] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (f: Hom.Carrier) => f.apply ((Ring.commutativeRingAsRing R ring).one),
  addition := \fun (f, g: Hom.Carrier) => \refl(N.space.add (f.apply ((Ring.commutativeRingAsRing R ring).one)) (g.apply ((Ring.commutativeRingAsRing R ring).one))),
  scalar := \fun (a: R)(f: Hom.Carrier) => \refl(N.space.smul a (f.apply ((Ring.commutativeRingAsRing R ring).one))),
};
\definition backward: Backward.Map := Backward.Map {
  apply := value,
  addition := \fun (a, b: N.Carrier) => Maps.ext (value (N.space.add a b)) (Hom.space.add (value a) (value b))
    (\fun (r: R) => N.space.vectorAdd r a b),
  scalar := \fun (a: R)(x: N.Carrier) => Maps.ext (value (N.space.smul a x)) (Hom.space.smul a (value x))
    (\fun (r: R) => eq_reason_in!{N.Carrier _
      "=" _ "by" { sym!{N.Carrier} _ _ (N.space.scalarAssoc r a x) }
      "=" _ "by" { congr!{R N.Carrier} (\fun (s: R) => N.space.smul s x) _ _ (ring.mulCommutative r a) }
      "=" _ "by" { N.space.scalarAssoc a r x }
    }),
};
\definition leftInverse: \forall (f: Hom.Carrier) -> backward.apply (forward.apply f) = f :=
  \fun (f: Hom.Carrier) => Maps.ext (value (f.apply ((Ring.commutativeRingAsRing R ring).one))) f (\fun (r: R) =>
    trans!{N.Carrier} _ _ _ (sym!{N.Carrier} _ _ (f.scalar r ((Ring.commutativeRingAsRing R ring).one)))
      (congr!{R N.Carrier} (f.apply) _ _ ((((Ring.commutativeRingAsRing R ring).semiring).multiplicative).rightIdentity r)));
\definition rightInverse: \forall (a: N.Carrier) -> forward.apply (backward.apply a) = a := N.space.scalarOne;
\import Modules.Isomorphism[V := Hom.Carrier, W := N.Carrier, source := Hom.space, target := N.space] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
