\import \parent.\parent.\parent.Matrix[m := k, n := l] \as Last;
\import \parent.\parent.\parent.Matrix[m := n, n := l] \as Middle;
\import \parent.\parent.\parent.Matrix[m := m, n := l] \as All;
\import Result.Composition[k := l] \as Outer;
\import Before.Composition[k := l] \as Inner;
\import \parent.\parent.Composition[k := l] \as Left;
\import Modules.FiniteCoordinates[n := l] \as Start;
\import Modules.Hom[V := Start.Carrier, W := Codomain.Carrier, source := Start.space, target := Codomain.space] \as AllMaps;
\definition left(a: Matrix)(b: Before.Matrix)(c: Last.Matrix): All.Matrix := Outer.product (product a b) c;
\definition right(a: Matrix)(b: Before.Matrix)(c: Last.Matrix): All.Matrix := Left.product a (Inner.product b c);
\definition value(a: Matrix)(b: Before.Matrix)(c: Last.Matrix)(v: Start.Carrier): Codomain.Carrier := apply a (Before.apply b (Last.apply c v));
\definition leftValue: \forall (a: Matrix)(b: Before.Matrix)(c: Last.Matrix)(v: Start.Carrier) -> All.apply (left a b c) v = value a b c v :=
  \fun (a: Matrix)(b: Before.Matrix)(c: Last.Matrix)(v: Start.Carrier) => trans!{Codomain.Carrier}
    (All.apply (left a b c) v) (Result.apply (product a b) (Last.apply c v)) (value a b c v)
    (Outer.point (product a b) c v) (point a b (Last.apply c v));
\definition rightValue: \forall (a: Matrix)(b: Before.Matrix)(c: Last.Matrix)(v: Start.Carrier) -> All.apply (right a b c) v = value a b c v :=
  \fun (a: Matrix)(b: Before.Matrix)(c: Last.Matrix)(v: Start.Carrier) => trans!{Codomain.Carrier}
    (All.apply (right a b c) v) (apply a (Middle.apply (Inner.product b c) v)) (value a b c v)
    (Left.point a (Inner.product b c) v)
    (congr!{Domain.Carrier Codomain.Carrier} (apply a)
      (Middle.apply (Inner.product b c) v) (Before.apply b (Last.apply c v)) (Inner.point b c v));
\definition associative: \forall (a: Matrix)(b: Before.Matrix)(c: Last.Matrix) -> left a b c = right a b c :=
  \fun (a: Matrix)(b: Before.Matrix)(c: Last.Matrix) => All.Representation[].injective (left a b c) (right a b c)
    (AllMaps.ext (All.linear (left a b c)) (All.linear (right a b c))
      (\fun (v: Start.Carrier) => trans!{Codomain.Carrier} (All.apply (left a b c) v) (value a b c v) (All.apply (right a b c) v)
        (leftValue a b c v) (sym!{Codomain.Carrier} (All.apply (right a b c) v) (value a b c v) (rightValue a b c v))));
