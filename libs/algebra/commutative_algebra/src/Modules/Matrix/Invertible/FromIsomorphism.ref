\import \parent.\parent.Representation[] \as ForwardRepresentation;
\import Backward.Representation[] \as BackwardRepresentation;
\import DomainSquare.Representation[] \as DomainRepresentation;
\import CodomainSquare.Representation[] \as CodomainRepresentation;
\import Modules.Hom[V := Codomain.Carrier, W := Domain.Carrier, source := Codomain.space, target := Domain.space] \as BackMaps;
\import BackMaps.Composition[U := Domain.Carrier, domain := Domain.space] \as BackCompose;
\import Maps.Composition[U := Codomain.Carrier, domain := Codomain.space] \as ForwardCompose;
\definition forwardApplication: \forall (v: Domain.Carrier) -> apply (entries e.forward) v = (e.forward).apply v :=
  \fun (v: Domain.Carrier) => congr!{Maps.Map Codomain.Carrier} (\fun (f: Maps.Map) => f.apply v) _ _ (ForwardRepresentation.mapRoundtrip e.forward);
\definition backApplication: \forall (v: Codomain.Carrier) -> Backward.apply (Backward.entries e.backward) v = (e.backward).apply v :=
  \fun (v: Codomain.Carrier) => congr!{BackMaps.Map Domain.Carrier} (\fun (f: BackMaps.Map) => f.apply v) _ _ (BackwardRepresentation.mapRoundtrip e.backward);
\definition data: Data := Data { inverse := Backward.entries e.backward };
\definition left: BackwardComposition.product data.inverse (entries e.forward) = Identity.identity :=
  DomainRepresentation.injective _ Identity.identity (trans!{DomainMaps.Map} _ _ _
    (BackwardComposition.law data.inverse (entries e.forward))
    (DomainMaps.ext (BackCompose.compose (Backward.linear data.inverse) (linear (entries e.forward))) (DomainSquare.linear Identity.identity)
      (\fun (v: Domain.Carrier) => trans!{Domain.Carrier} _ _ _
        (congr!{Codomain.Carrier Domain.Carrier} (Backward.apply data.inverse) _ _ (forwardApplication v))
        (trans!{Domain.Carrier} _ _ _ (backApplication ((e.forward).apply v))
          (trans!{Domain.Carrier} _ _ _ (e.leftInverse v)
            (sym!{Domain.Carrier} _ _ (congr!{DomainMaps.Map Domain.Carrier} (\fun (f: DomainMaps.Map) => f.apply v) _ _ Identity.identityLaw)))))));
\definition right: ForwardComposition.product (entries e.forward) data.inverse = Identity.targetIdentity :=
  CodomainRepresentation.injective _ Identity.targetIdentity (trans!{CodomainMaps.Map} _ _ _
    (ForwardComposition.law (entries e.forward) data.inverse)
    (CodomainMaps.ext (ForwardCompose.compose (linear (entries e.forward)) (Backward.linear data.inverse)) (CodomainSquare.linear Identity.targetIdentity)
      (\fun (v: Codomain.Carrier) => trans!{Codomain.Carrier} _ _ _
        (congr!{Domain.Carrier Codomain.Carrier} (apply (entries e.forward)) _ _ (backApplication v))
        (trans!{Codomain.Carrier} _ _ _ (forwardApplication ((e.backward).apply v))
          (trans!{Codomain.Carrier} _ _ _ (e.rightInverse v)
            (sym!{Codomain.Carrier} _ _ (congr!{CodomainMaps.Map Codomain.Carrier} (\fun (f: CodomainMaps.Map) => f.apply v) _ _ Identity.targetIdentityLaw)))))));
\definition laws: Laws[entries e.forward, data] := Laws[entries e.forward, data] { leftInverse := left, rightInverse := right };
\definition inverse: Inverse (entries e.forward) := \into[Data](data, { data: Data \where Laws[entries e.forward, data] }) \by { laws };
