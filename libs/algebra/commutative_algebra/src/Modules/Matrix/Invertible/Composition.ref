\import \parent.\parent.Composition[k := k] \as Multiply;
\import \parent.\parent.\parent.Matrix[m := n, n := k] \as Before;
\import Before.Invertible[] \as BeforeInvertible;
\import \parent.\parent.\parent.Matrix[m := m, n := k] \as Result;
\import Result.Invertible[] \as ResultInvertible;
\import Modules.FiniteCoordinates[n := k] \as Input;
\import Modules.Isomorphism[V := Input.Carrier, W := Domain.Carrier, source := Input.space, target := Domain.space].Composition[U := Codomain.Carrier, final := Codomain.space] \as Compose;
\import Modules.Hom[V := Domain.Carrier, W := Codomain.Carrier, source := Domain.space, target := Codomain.space].Composition[U := Input.Carrier, domain := Input.space] \as MapsComposition;
\definition composed(a: Matrix)(b: Before.Matrix)(ca: Inverse a)(cb: BeforeInvertible.Inverse b):
  Modules.Isomorphism[V := Input.Carrier, W := Codomain.Carrier, source := Input.space, target := Codomain.space].Isomorphism :=
  Compose.compose (isomorphism a ca) (BeforeInvertible.isomorphism b cb);
\definition certificate(a: Matrix)(b: Before.Matrix)(ca: Inverse a)(cb: BeforeInvertible.Inverse b): ResultInvertible.Inverse (Multiply.product a b) :=
  ResultInvertible.transport
    (Result.entries (MapsComposition.compose (linear a) (Before.linear b))) (Multiply.product a b) (Multiply.entriesCompose a b)
    (ResultInvertible.fromIsomorphism (composed a b ca cb));
\definition existence: \forall (a: Matrix)(b: Before.Matrix) -> (\exists Inverse a) -> (\exists BeforeInvertible.Inverse b) -> \exists ResultInvertible.Inverse (Multiply.product a b) := \block {
  \fun (a: Matrix)(b: Before.Matrix)(aExists: \exists Inverse a)(bExists: \exists BeforeInvertible.Inverse b) \then
  \takefrom ca: Inverse a \by aExists \then
  \takefrom cb: BeforeInvertible.Inverse b \by bExists \then
  \return \exact(certificate a b ca cb, ResultInvertible.Inverse (Multiply.product a b))
};
\import \parent.\parent.\parent.Matrix[m := k, n := n].Composition[k := m] \as ReverseMultiply;
\definition inverseValue: \forall (a: Matrix)(b: Before.Matrix)(ca: Inverse a)(cb: BeforeInvertible.Inverse b) ->
  #inverse{(certificate a b ca cb)} = ReverseMultiply.product #inverse{cb} #inverse{ca} :=
  \fun (a: Matrix)(b: Before.Matrix)(ca: Inverse a)(cb: BeforeInvertible.Inverse b) =>
    ReverseMultiply.entriesCompose #inverse{cb} #inverse{ca};
