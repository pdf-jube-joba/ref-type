\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Transpose[] \as ForwardTranspose;
\import Backward.Transpose[] \as BackwardTranspose;
\import Backward.Invertible[] \as ReversedInvertible;
\import Backward.End[] \as ReversedIdentity;
\import ForwardTranspose.Composition[k := m] \as ForwardProduct;
\import BackwardTranspose.Composition[k := n] \as BackwardProduct;
\import CodomainSquare.Transpose[] \as CodomainTranspose;
\import DomainSquare.Transpose[] \as DomainTranspose;
\import ForwardTranspose.Identity[k := m] \as CodomainIdentity;
\import ForwardTranspose.Identity[k := n] \as DomainIdentity;
\import Backward.Composition[k := n] \as NewForward;
\import \parent.\parent.Composition[k := m] \as NewBackward;
\definition oldLaws: Laws[a, certificate] := \bysub(Data, { data: Data \where Laws[a, data] }, certificate);
\definition data: ReversedInvertible.Data := ReversedInvertible.Data { inverse := BackwardTranspose.transpose certificate.inverse };
\definition laws: ReversedInvertible.Laws[ForwardTranspose.transpose a, data] := ReversedInvertible.Laws[ForwardTranspose.transpose a, data] {
  leftInverse := eq_reason_in!{CodomainSquare.Matrix { NewBackward.product data.inverse (ForwardTranspose.transpose a) }
    "=" { CodomainTranspose.transpose (ForwardComposition.product a certificate.inverse) } "by" { sym!{CodomainSquare.Matrix} (CodomainTranspose.transpose (ForwardComposition.product a certificate.inverse)) (NewBackward.product data.inverse (ForwardTranspose.transpose a)) (ForwardProduct.product a certificate.inverse) }
    "=" { CodomainTranspose.transpose Identity.targetIdentity } "by" { congr!{CodomainSquare.Matrix CodomainSquare.Matrix} CodomainTranspose.transpose (ForwardComposition.product a certificate.inverse) Identity.targetIdentity oldLaws.rightInverse }
    "=" ReversedIdentity.identity "by" CodomainIdentity.law
  },
  rightInverse := eq_reason_in!{DomainSquare.Matrix { NewForward.product (ForwardTranspose.transpose a) data.inverse }
    "=" { DomainTranspose.transpose (BackwardComposition.product certificate.inverse a) } "by" { sym!{DomainSquare.Matrix} (DomainTranspose.transpose (BackwardComposition.product certificate.inverse a)) (NewForward.product (ForwardTranspose.transpose a) data.inverse) (BackwardProduct.product certificate.inverse a) }
    "=" { DomainTranspose.transpose Identity.identity } "by" { congr!{DomainSquare.Matrix DomainSquare.Matrix} DomainTranspose.transpose (BackwardComposition.product certificate.inverse a) Identity.identity oldLaws.leftInverse }
    "=" ReversedIdentity.targetIdentity "by" DomainIdentity.law
  },
};
\definition inverse: ReversedInvertible.Inverse (ForwardTranspose.transpose a) :=
  \into[ReversedInvertible.Data](data, { d: ReversedInvertible.Data \where ReversedInvertible.Laws[ForwardTranspose.transpose a, d] }) \by { laws };
