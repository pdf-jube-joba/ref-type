\use std.Logic[].Equality[].eq_reason_in;
\definition rightSequence: RightExact.Sequence := RightExact.Sequence {
  inclusion := sequence.inclusion, projection := sequence.projection,
  onto := sequence.onto, zero := sequence.zero, kernelImage := sequence.kernelImage,
};
\import Reverse.On[sequence := rightSequence] \as Original;
\definition originalPair: OriginalPair.Sequence := OriginalPair.Sequence {
  first := Original.inclusion, last := Original.projection, zero := Original.zero, kernelImage := Original.kernelImage,
};
\definition inclusion: Modules.MapBetween leftBundle middleBundle := Inclusion.map Identity.identity sequence.inclusion;
\definition projection: Modules.MapBetween middleBundle rightBundle := Projection.map Identity.identity sequence.projection;
\import OriginalPair.Transport[A1 := leftBundle, B1 := middleBundle, C1 := rightBundle, sequence := originalPair,
  f := inclusion, g := projection, a := LeftSwap.isomorphism, b := MiddleSwap.isomorphism, c := RightSwap.isomorphism] \as Transport;
\definition firstCommutes: Transport.FirstCommutes := InclusionSwap.commutes sequence.inclusion Identity.identity;
\definition lastCommutes: Transport.LastCommutes := ProjectionSwap.commutes sequence.projection Identity.identity;
\definition zero: \forall (x: Left.Carrier) -> projection.apply (inclusion.apply x) = Right.space.zero := Transport.zero firstCommutes lastCommutes;
\definition kernelImage: \forall (x: Middle.Carrier) -> projection.apply x = Right.space.zero ->
  \exists ( y: Left.Carrier \where inclusion.apply y = x ) := Transport.kernelImage firstCommutes lastCommutes;
\definition onto: \forall (q: Right.Carrier) -> \exists ( y: Middle.Carrier \where projection.apply y = q ) := \block {
  \fun (q: Right.Carrier) \then
  \takefrom y: \Cast[ReverseMiddle.Carrier] ({ y: ReverseMiddle.Carrier \where Original.projection.apply y = RightSwap.backward.apply q })
    \by Original.onto (RightSwap.backward.apply q) \then
  \return Logic.existsIntro[Middle.Carrier, { y: Middle.Carrier \where projection.apply y = q }] (MiddleSwap.forward.apply y)
    (eq_reason_in!{Right.Carrier _
      "=" _ "by" { sym!{Right.Carrier} _ _ (lastCommutes y) }
      "=" _ "by" { congr!{ReverseRight.Carrier Right.Carrier} (RightSwap.forward.apply) _ _
          (\bysub(ReverseMiddle.Carrier, { y: ReverseMiddle.Carrier \where Original.projection.apply y = RightSwap.backward.apply q }, y)) }
      "=" _ "by" { RightSwap.rightInverse q }
    })
};
\import \parent.\parent.ProjectiveTensor[P := P, A := A, B := B].On[f := sequence.inclusion] \as Injectivity;
\definition injective: Modules.Projective P -> \forall (x, y: Left.Carrier) -> inclusion.apply x = inclusion.apply y -> x = y :=
  \fun (projective: Modules.Projective P) => Injectivity.injective projective (sequence.injective);
\definition data: Result.Data := Result.Data { inclusion := inclusion, projection := projection };
\definition laws: Modules.Projective P -> Result.Laws[data] := \fun (projective: Modules.Projective P) => Result.Laws[data] {
  injective := injective projective, onto := onto, zero := zero, kernelImage := kernelImage,
};
\definition sequence[projective: Modules.Projective P]: Result.Sequence := \into[Result.Data](data, { data: Result.Data \where Result.Laws[data] }) \by { laws projective };
