\definition T: \VType := \U(Input ~> \F(\RunStep[Input, Calculation]));
\definition program: T := \thunk (\cfun (input: Input) => \program {
  \bind value: Calculation <- (\force calculateProgram) input \then
  \return(\finish[Input, Calculation](value))
});
\definition matches: \forall (input: Input^) -> program^ input = step input :=
  \fun (input: Input^) => congr!{Calculation^ {\RunStep[Input^, Calculation^]}}
    (\fun (value: Calculation^) => \finish[Input^, Calculation^](value))
    (Calculate.program^ input) (mathematical input) (\parent.Implementation[].matches input);
\definition coherence: program^ = step := \axiom:funext(program^, step, matches);
