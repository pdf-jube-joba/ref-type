\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Of[V := Source.Cycle, space := Source.cycleSpace].Submodule[] \as SourceSub;
\import SourceSub.Image[U := SourceUpper.Carrier, source := SourceUpper.space] \as SourceImage;
\import Modules.Of[V := Target.Cycle, space := Target.cycleSpace].Submodule[] \as TargetSub;
\import TargetSub.Image[U := TargetUpper.Carrier, source := TargetUpper.space] \as TargetImage;
\import Modules.QuotientMapping[A := sourceBundle, B := targetBundle].On[S := Source.image, T := Target.image, f := cycles f] \as Descent;
\definition compatible: Descent.Compatible := \fun (x: Source.Cycle)(member: SourceSub.Member Source.image x) =>
  SourceImage.eliminate Source.boundary x (TargetSub.Member Target.image ((cycles f).apply x))
    (\fun (y: SourceUpper.Carrier)(equal: Source.boundary.apply y = x) =>
      TargetImage.introduce Target.boundary ((cycles f).apply x) ((upper f).apply y)
        (trans!{Target.Cycle} (Target.boundary.apply ((upper f).apply y)) ((cycles f).apply (Source.boundary.apply y)) ((cycles f).apply x)
          (sym!{Target.Cycle} ((cycles f).apply (Source.boundary.apply y)) (Target.boundary.apply ((upper f).apply y))
            ((\bysub(Data, { data: Data \where Laws[data] }, f)).incoming y))
          (congr!{Source.Cycle Target.Cycle} ((cycles f).apply) (Source.boundary.apply y) x equal))) member;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as HomologyMaps;
\definition induced: HomologyMaps.Map := Descent.map compatible;
\definition onClass: \forall (x: Source.Cycle) -> induced.apply (Source.class x) = Target.class ((cycles f).apply x) := Descent.onClass compatible;
\import HomologyMaps.Composition[U := Source.FactorHomology, domain := Source.factorSpace] \as Before;
\definition onSourceFactors: Modules.Hom[V := Source.FactorHomology, W := Target.Homology, source := Source.factorSpace, target := Target.homologySpace].Map :=
  Before.compose induced Source.factorIsomorphism.backward;
\import Modules.Hom[V := Target.Homology, W := Target.FactorHomology, source := Target.homologySpace, target := Target.factorSpace].Composition[U := Source.FactorHomology, domain := Source.factorSpace] \as After;
\import Modules.Hom[V := Source.FactorHomology, W := Target.FactorHomology, source := Source.factorSpace, target := Target.factorSpace] \as FactorMaps;
\definition factors: FactorMaps.Map := After.compose Target.factorIsomorphism.forward onSourceFactors;
\definition intertwines: \forall (q: Source.Homology) ->
  factors.apply (Source.factorIsomorphism.forward.apply q) = Target.factorIsomorphism.forward.apply (induced.apply q) :=
  \fun (q: Source.Homology) => congr!{Source.Homology Target.FactorHomology}
    (\fun (x: Source.Homology) => Target.factorIsomorphism.forward.apply (induced.apply x))
    (Source.factorIsomorphism.backward.apply (Source.factorIsomorphism.forward.apply q)) q (Source.factorIsomorphism.leftInverse q);
\import \parent.\parent.Compute[] \as Computation;
\import integer_matrices.IntegerMatrix[m := Target.nullity, n := s].Product[k := n] \as FirstProduct;
\import integer_matrices.IntegerMatrix[m := Target.nullity, n := n].Product[k := Source.nullity] \as SecondProduct;
\definition firstRuntime: Runtime^ := FirstProduct.Multiply.program^ s (Computation.inverseCoordinates Target.computed) f.middle;
\definition coordinateRuntime: Runtime^ := SecondProduct.Multiply.program^ n firstRuntime (Computation.generators Source.computed);
\import Commutative.Matrix[m := Target.nullity, n := Source.nullity] \as Coefficients;
\import Commutative.Matrix[m := Target.nullity, n := s] \as TargetInverse;
\import Commutative.Matrix[m := n, n := Source.nullity] \as SourceGenerators;
\import TargetInverse.Composition[k := n] \as FirstMultiply;
\import Commutative.Matrix[m := Target.nullity, n := n].Composition[k := Source.nullity] \as SecondMultiply;
\definition firstMatrix: Commutative.Matrix[m := Target.nullity, n := n].Matrix :=
  \fun (i: Indices.Fin Target.nullity)(j: Indices.Fin n) => firstRuntime i j;
\definition coordinateMatrix: Coefficients.Matrix :=
  \fun (i: Indices.Fin Target.nullity)(j: Indices.Fin Source.nullity) => coordinateRuntime i j;
\definition firstCorrespondence: firstMatrix = FirstMultiply.product Target.computedInverseMatrix
  (\fun (i: Indices.Fin s)(j: Indices.Fin n) => f.middle i j) :=
  FirstProduct.correspondence (Computation.inverseCoordinates Target.computed) f.middle;
\definition correspondence: coordinateMatrix = SecondMultiply.product
  (FirstMultiply.product Target.computedInverseMatrix (\fun (i: Indices.Fin s)(j: Indices.Fin n) => f.middle i j))
  Source.computedGeneratorMatrix := trans!{Coefficients.Matrix} _ _ _
    (SecondProduct.correspondence firstRuntime (Computation.generators Source.computed))
    (congr!{{Commutative.Matrix[m := Target.nullity, n := n].Matrix} Coefficients.Matrix}
      (\fun (a: Commutative.Matrix[m := Target.nullity, n := n].Matrix) => SecondMultiply.product a Source.computedGeneratorMatrix)
      firstMatrix (FirstMultiply.product Target.computedInverseMatrix (\fun (i: Indices.Fin s)(j: Indices.Fin n) => f.middle i j)) firstCorrespondence);
\import Modules.FiniteCoordinates[n := Source.nullity] \as SourceCoefficients;
\import Modules.FiniteCoordinates[n := Target.nullity] \as TargetCoefficients;
\definition action: \forall (v: SourceCoefficients.Carrier) ->
  Coefficients.apply coordinateMatrix v = TargetInverse.apply Target.computedInverseMatrix ((middle f).apply (Source.generatorCycle v)) :=
  \fun (v: SourceCoefficients.Carrier) => eq_reason_in!{TargetCoefficients.Carrier _
    "=" _ "by" { congr!{Coefficients.Matrix TargetCoefficients.Carrier} (\fun (a: Coefficients.Matrix) => Coefficients.apply a v) _ _ correspondence }
    "=" _ "by" { SecondMultiply.point (FirstMultiply.product Target.computedInverseMatrix (\fun (i: Indices.Fin s)(j: Indices.Fin n) => f.middle i j)) Source.computedGeneratorMatrix v }
    "=" _ "by" { FirstMultiply.point Target.computedInverseMatrix (\fun (i: Indices.Fin s)(j: Indices.Fin n) => f.middle i j) (SourceGenerators.apply Source.computedGeneratorMatrix v) }
    "=" _ "by" { congr!{SourceMiddle.Carrier TargetCoefficients.Carrier}
          (\fun (x: SourceMiddle.Carrier) => TargetInverse.apply Target.computedInverseMatrix ((middle f).apply x))
          (SourceGenerators.apply Source.computedGeneratorMatrix v) (Source.generatorCycle v) (Source.computedGeneratorAction v) }
  };
\definition onFactorClasses: \forall (v: SourceCoefficients.Carrier) ->
  factors.apply (Source.factorClasses v) = Target.factorClasses (Coefficients.apply coordinateMatrix v) :=
  \fun (v: SourceCoefficients.Carrier) => eq_reason_in!{Target.FactorHomology _
    "=" _ "by" { congr!{Source.Homology Target.FactorHomology}
      (\fun (q: Source.Homology) => Target.factorIsomorphism.forward.apply (induced.apply q))
      (Source.factorIsomorphism.backward.apply (Source.factorClasses v)) (Source.generatorClass v) (Source.inverseOnFactors v) }
    "=" _ "by" { congr!{Target.Homology Target.FactorHomology} (Target.factorIsomorphism.forward.apply)
        (induced.apply (Source.generatorClass v)) (Target.class ((cycles f).apply (Source.generatorCycle v))) (onClass (Source.generatorCycle v)) }
    "=" _ "by" { Target.computedForwardOnClass ((cycles f).apply (Source.generatorCycle v)) }
    "=" _ "by" { congr!{TargetCoefficients.Carrier Target.FactorHomology} Target.factorClasses _ _
          (sym!{TargetCoefficients.Carrier} _ _ (action v)) }
  };
