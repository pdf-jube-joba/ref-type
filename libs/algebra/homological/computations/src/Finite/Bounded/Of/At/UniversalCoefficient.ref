\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Existential;
\import finitely_generated_modules.IntegerKernel[m := C.ranks (previous z), n := C.ranks z, original := C.boundary z] \as Kernel;
\import Kernel.Splitting[] \as Decomposition;
\import Kernel.Image[] \as Image;
\import Modules.Biproduct[V := Homology.Cycle, W := Image.Carrier, left := Homology.cycleSpace, right := Image.space] \as Sum;
\import Modules.Hom[V := Sum.Carrier, W := Homology.Cycle, source := Sum.space, target := Homology.cycleSpace].Composition[U := Carrier C z, domain := space C z] \as Retractions;
\definition retraction: Modules.Hom[V := Carrier C z, W := Homology.Cycle, source := space C z, target := Homology.cycleSpace].Map :=
  Retractions.compose Sum.firstProjection Decomposition.isomorphism.backward;
\import Modules.Hom[V := Image.Carrier, W := Carrier C z, source := Image.space, target := space C z] \as Sections;
\import Modules.Laws[V := Carrier C z, space := space C z] \as Current;
\import algebra.Group[].Of[Carrier := Carrier C z, group := Current.additive] \as CurrentGroup;
\definition forwardCycle: \forall (x: Homology.Cycle) -> Decomposition.isomorphism.forward.apply (Sum.make x Image.space.zero) = x :=
  \fun (x: Homology.Cycle) => trans!{{Carrier C z}} _ _ _
    (congr!{{Carrier C z} {Carrier C z}} ((space C z).add x) _ _ (Sections.zeroPreserved Decomposition.section)) (CurrentGroup.zeroRight x);
\definition retractCycle: \forall (x: Homology.Cycle) -> retraction.apply x = x :=
  \fun (x: Homology.Cycle) => trans!{Homology.Cycle} _ _ _
    (sym!{Homology.Cycle} _ _ (congr!{{Carrier C z} Homology.Cycle} (retraction.apply) _ _ (forwardCycle x)))
    (congr!{Sum.Carrier Homology.Cycle} Sum.first _ _ (Decomposition.isomorphism.leftInverse (Sum.make x Image.space.zero)));
\import derived_functors.UniversalCoefficient[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].On[C := chain, A := A].At[z := z] \as Evaluation;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].Integer[P := chain, N := A] \as Hom;
\import Hom.Cohomology[z := z] \as Cohomology;
\import Modules.Hom[V := Homology.Homology, W := A.Carrier, source := Homology.homologySpace, target := A.space] \as Values;
\import Values.Composition[U := Homology.Cycle, domain := Homology.cycleSpace] \as FromCycles;
\import Modules.Hom[V := Homology.Cycle, W := A.Carrier, source := Homology.cycleSpace, target := A.space].Composition[U := Carrier C z, domain := space C z] \as FromChains;
\definition extend[f: Values.Map]: Hom.Carrier z := FromChains.compose (FromCycles.compose f Homology.classLinear) retraction;
\definition onCycle: \forall (f: Values.Map)(x: Homology.Cycle) -> (extend f).apply x = f.apply (Homology.classOf x) :=
  \fun (f: Values.Map)(x: Homology.Cycle) => congr!{Homology.Cycle A.Carrier} (\fun (y: Homology.Cycle) => f.apply (Homology.classOf y)) _ _ (retractCycle x);
\import Modules.Hom[V := Carrier C (next z), W := A.Carrier, source := space C (next z), target := A.space] \as Differentials;
\definition closed: \forall (f: Values.Map) -> Hom.apply z (extend f) = (Hom.space (next z)).zero :=
  \fun (f: Values.Map) => Differentials.ext (Hom.apply z (extend f)) ((Hom.space (next z)).zero)
    (\fun (x: Carrier C (next z)) => eq_reason_in!{A.Carrier _
      "=" _ "by" { onCycle f (Homology.cycle (Homology.prior.apply x) (Prior.squareZero z x)) }
      "=" _ "by" { congr!{Homology.Homology A.Carrier} (f.apply) _ _ (Homology.boundaryClassZero
          (Homology.cycle (Homology.prior.apply x) (Prior.squareZero z x)) (AmbientImages.member Homology.prior x)) }
      "=" _ "by" { Values.zeroPreserved f }
    });
\definition cocycle[f: Values.Map]: Cohomology.Closed := \into[Hom.Carrier z](extend f,
  { g: Hom.Carrier z \where Hom.apply z g = (Hom.space (next z)).zero }) \by { closed f };
\definition lift[f: Values.Map]: Evaluation.CohomologyCarrier := Cohomology.classOf (cocycle f);
\definition rightInverse: \forall (f: Values.Map) -> Evaluation.map.apply (lift f) = f :=
  \fun (f: Values.Map) => Values.ext (Evaluation.map.apply (lift f)) f
    (Homology.classInduction (\fun (x: Homology.Homology) => (Evaluation.map.apply (lift f)).apply x = f.apply x)
      (\fun (x: Homology.Cycle) => eq_reason_in!{A.Carrier _
        "=" _ "by" { congr!{Values.Map A.Carrier} (\fun (g: Values.Map) => g.apply (Homology.classOf x)) _ _ (Evaluation.onCohomologyClass (cocycle f)) }
        "=" _ "by" { Evaluation.onClass (cocycle f) x }
        "=" _ "by" { onCycle f x }
      }));
\definition onto: \forall (f: Values.Map) -> \exists ( q: Evaluation.CohomologyCarrier \where Evaluation.map.apply q = f ) :=
  \fun (f: Values.Map) => Existential.existsIntro[Evaluation.CohomologyCarrier, { q: Evaluation.CohomologyCarrier \where Evaluation.map.apply q = f }] (lift f)
    (rightInverse f);
\module Boundary;
\module CohomologyKernel;
\module Incoming;
\module Tensor;
\module Abstract;
