\import derived_functors.UniversalCoefficient[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].Projective[C := chain, A := A].At[z := z] \as General;
\import Modules.Hom[V := Carrier C z, W := Homology.Cycle, source := space C z, target := Homology.cycleSpace] \as Retractions;
\definition current: General.Retraction := \into[Retractions.Map](retraction,
  { r: Retractions.Map \where \forall (x: Homology.Cycle) -> #apply{r} x = x }) \by { retractCycle };
\import \root.Finite[].Bounded[].Of[C := C].At[z := previous z].UniversalCoefficient[A := A] \as Previous;
\import Chains.At[C := chain, z := previous z] \as PreviousHomology;
\import Modules.Hom[V := Carrier C (previous z), W := PreviousHomology.Cycle, source := space C (previous z), target := PreviousHomology.cycleSpace] \as PreviousRetractions;
\definition prior: General.PreviousRetraction := \into[PreviousRetractions.Map](Previous.retraction,
  { r: PreviousRetractions.Map \where \forall (x: PreviousHomology.Cycle) -> #apply{r} x = x }) \by { Previous.retractCycle };
\import General.Selected[r := current, rprev := prior].CohomologyKernel[] \as Abstract;
\import \parent.CohomologyKernel[] \as Concrete;
\definition cohomologySequence: Abstract.sequence = Concrete.sequence := \refl(Concrete.sequence);
\import \parent.Boundary[] \as CurrentBoundary;
\import Previous.Boundary[] \as PreviousBoundary;
\import \root.Finite[].Bounded[].Of[C := C].At[z := previous z].Presentation[] \as PreviousPresentation;
\definition hypotheses: General.Hypotheses := General.Hypotheses {
  currentBoundary := CurrentBoundary.projective,
  previousBoundary := PreviousBoundary.projective,
  previousCycles := PreviousPresentation.cyclesProjective,
};
\import General.Selected[r := current, rprev := prior].Tensor[].Projection[].Exactness[].Derived[] \as AbstractTensor;
\import \parent.Tensor[].Projection[].Exactness[].Derived[] \as ConcreteTensor;
\definition tensorSequence: AbstractTensor.sequence = ConcreteTensor.sequence := \refl(ConcreteTensor.sequence);
