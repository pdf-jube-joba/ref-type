\import std.Data[].Nat[] \as Natural;
\import derived_functors.Tor[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].ProjectiveSecond[
  M := Presentation.homologyBundle, N := A, P := Tor.complex].Positive[n := Natural.Nat^::zero] \as Vanishing;
\definition onto: Modules.Projective A -> \forall (q: TensorHomology.Homology) ->
  \exists { h: HomologyTensor.Carrier \where #apply{Boundaries.map} h = q } :=
  \fun (projective: Modules.Projective A)(q: TensorHomology.Homology) => kernelImage q
    (Vanishing.vanishing projective resolution (#apply{projection} q));
\import Modules.Isomorphism[V := HomologyTensor.Carrier, W := TensorHomology.Homology,
  source := HomologyTensor.space, target := TensorHomology.homologySpace].OfBijective[f := Boundaries.map] \as Inverse;
\definition isomorphism(projective: Modules.Projective A): Modules.Isomorphism[V := HomologyTensor.Carrier, W := TensorHomology.Homology,
  source := HomologyTensor.space, target := TensorHomology.homologySpace].Isomorphism := Inverse.isomorphism Injection.injective (onto projective);
\import CycleTensor.Mapping[U := Homology.Homology, Z := A.Carrier, targetLeft := Homology.homologySpace, targetRight := A.space] \as HomologyProjection;
\definition onPure: \forall (projective: Modules.Projective A)(x: Homology.Cycle)(a: A.Carrier) ->
  #apply{#forward{(isomorphism projective)}} (HomologyTensor.tensor (Homology.classOf x) a) =
    TensorHomology.classOf (cycle (CycleTensor.tensor x a)) :=
  \fun (projective: Modules.Projective A)(x: Homology.Cycle)(a: A.Carrier) => trans!{TensorHomology.Homology} _ _ _
    (sym!{TensorHomology.Homology} _ _
      (congr!{HomologyTensor.Carrier TensorHomology.Homology} (#apply{Boundaries.map}) _ _
        (HomologyProjection.onTensor Homology.classLinear Coefficient.identity x a)))
    (Boundaries.onCycles (CycleTensor.tensor x a));
