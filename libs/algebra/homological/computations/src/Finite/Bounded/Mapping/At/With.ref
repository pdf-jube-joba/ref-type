\use std.Logic[].Equality[].eq_reason_in;
\import \root.Finite[].Pair[m := C.ranks (previous z), n := C.ranks z, p := C.ranks (next z)].Of[C := SourceResult.complex] \as SourcePair;
\import \root.Finite[].Pair[m := D.ranks (previous z), n := D.ranks z, p := D.ranks (next z)].Of[C := TargetResult.complex] \as TargetPair;
\import Local.With[f := local f] \as Computed;
\import Maps.At[k := z] \as Induced;
\import Chains.At[C := Source.chain, z := z] \as SourceHomology;
\import Chains.At[C := Target.chain, z := z] \as TargetHomology;
\definition coordinateRuntime: Runtime^ := Computed.coordinateRuntime;
\definition coordinateMatrix: Commutative.Matrix[m := TargetPair.nullity, n := SourcePair.nullity].Matrix := Computed.coordinateMatrix;
\definition induced: Modules.Hom[V := SourceHomology.Homology, W := TargetHomology.Homology,
  source := SourceHomology.homologySpace, target := TargetHomology.homologySpace].Map := Induced.induced (chainMap f);
\definition factors: Modules.Hom[V := SourcePair.FactorHomology, W := TargetPair.FactorHomology,
  source := SourcePair.factorSpace, target := TargetPair.factorSpace].Map := Computed.factors;
\definition pairNaturality: \forall (q: SourceHomology.Homology) ->
  TargetResult.pairIsomorphism.forward.apply (induced.apply q) =
  Computed.induced.apply (SourceResult.pairIsomorphism.forward.apply q) :=
  SourceHomology.classInduction (\fun (q: SourceHomology.Homology) =>
    TargetResult.pairIsomorphism.forward.apply (induced.apply q) =
      Computed.induced.apply (SourceResult.pairIsomorphism.forward.apply q))
    (\fun (x: SourceHomology.Cycle) => eq_reason_in!{TargetPair.Homology _
      "=" _ "by" { congr!{TargetHomology.Homology TargetPair.Homology} (TargetResult.pairIsomorphism.forward.apply) _ _
        (Induced.onClass (chainMap f) x) }
      "=" _ "by" { TargetResult.pairOnClass ((Induced.cyclesMap (chainMap f)).apply x) }
      "=" _ "by" { sym!{TargetPair.Homology} _ _
          (trans!{TargetPair.Homology} _ _ _
            (congr!{SourcePair.Homology TargetPair.Homology} (Computed.induced.apply) _ _
              (SourceResult.pairOnClass x))
            (Computed.onClass x)) }
    });
\definition intertwines: \forall (q: SourceHomology.Homology) ->
  factors.apply (SourceResult.factorIsomorphism.forward.apply q) =
  TargetResult.factorIsomorphism.forward.apply (induced.apply q) :=
  \fun (q: SourceHomology.Homology) => trans!{TargetPair.FactorHomology} _ _ _
    (Computed.intertwines (SourceResult.pairIsomorphism.forward.apply q))
    (congr!{TargetPair.Homology TargetPair.FactorHomology} (TargetPair.factorIsomorphism.forward.apply) _ _
      (sym!{TargetPair.Homology} _ _ (pairNaturality q)));
\definition onFactorClasses: \forall (v: Modules.FiniteCoordinates[n := SourcePair.nullity].Carrier) ->
  factors.apply (SourcePair.factorClasses v) =
    TargetPair.factorClasses (Commutative.Matrix[m := TargetPair.nullity, n := SourcePair.nullity].apply coordinateMatrix v) :=
  Computed.onFactorClasses;
\module UniversalCoefficient(A, B: Modules.Bundle);
\module TensorUniversalCoefficient(A, B: Modules.Bundle);
\definition onComputedGenerator: \forall (v: Modules.FiniteCoordinates[n := SourcePair.nullity].Carrier) ->
  induced.apply (SourceResult.factorIsomorphism.backward.apply (SourcePair.factorClasses v)) =
    TargetResult.factorIsomorphism.backward.apply
      (TargetPair.factorClasses (Commutative.Matrix[m := TargetPair.nullity, n := SourcePair.nullity].apply coordinateMatrix v)) :=
  \fun (v: Modules.FiniteCoordinates[n := SourcePair.nullity].Carrier) => trans!{TargetHomology.Homology} _ _ _
    (sym!{TargetHomology.Homology} _ _ (TargetResult.factorIsomorphism.leftInverse
      (induced.apply (SourceResult.factorIsomorphism.backward.apply (SourcePair.factorClasses v)))))
    (congr!{TargetPair.FactorHomology TargetHomology.Homology} (TargetResult.factorIsomorphism.backward.apply) _ _
      (eq_reason_in!{TargetPair.FactorHomology _
        "=" _ "by" { sym!{TargetPair.FactorHomology} _ _ (intertwines (SourceResult.factorIsomorphism.backward.apply (SourcePair.factorClasses v))) }
        "=" _ "by" { congr!{SourcePair.FactorHomology TargetPair.FactorHomology} (factors.apply) _ _ (SourceResult.factorIsomorphism.rightInverse (SourcePair.factorClasses v)) }
        "=" _ "by" { onFactorClasses v }
      }));
\module ResolutionComparison;
