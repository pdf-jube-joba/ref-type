\import \parent.Degreewise[k := z] \as CurrentDegree;
\import Maps.At[k := previous z] \as Previous;
\import Modules.End[V := B.Carrier, space := B.space] \as CoefficientB;
\import std.Data[].Nat[] \as ResolutionNaturals;
\definition resolutionOne: ResolutionNaturals.Nat^ := ResolutionNaturals.Nat^::succ ResolutionNaturals.Nat^::zero;
\import \root.Finite[].Bounded[].Mapping[C := C, D := D].At[z := z].With[f := f].ResolutionComparison[] \as Comparison;
\import \root.Finite[].Bounded[].Of[C := C].At[z := previous z].Presentation[] \as P;
\import \root.Finite[].Bounded[].Of[C := D].At[z := previous z].Presentation[] \as Q;
\import derived_functors.Tor[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].LengthOne[K := P.boundaryBundle, L := P.cyclesBundle, M := P.homologyBundle, N := A].With[sequence := P.sequence] \as Ctor;
\import derived_functors.Tor[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].LengthOne[K := Q.boundaryBundle, L := Q.cyclesBundle, M := Q.homologyBundle, N := B].With[sequence := Q.sequence] \as Dtor;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing] \as Tensor;
\import Tensor.On[P := Ctor.complex, N := A] \as SourceTensor;
\import Tensor.On[P := Dtor.complex, N := B] \as TargetTensor;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Ring.commutativeRingAsRing I.Int^ IntegerRing.commutativeRing].Map[C := Ctor.complex, D := Dtor.complex] \as ResolutionMaps;
\definition resolutionMap: ResolutionMaps.Map := ResolutionMaps.Map {
  apply := \fun (n: ResolutionNaturals.Nat^)(x: Ctor.family.Carrier n) => #apply{Comparison.map} n x,
  addition := \fun (n: ResolutionNaturals.Nat^) => #addition{Comparison.map} n,
  scalar := \fun (n: ResolutionNaturals.Nat^) => #scalar{Comparison.map} n,
  commutes := \fun (n: ResolutionNaturals.Nat^) => #commutes{Comparison.map} n,
};
\import Tensor.Mapping[P := Ctor.complex, Q := Dtor.complex, N := A, L := B].On[f := resolutionMap, u := u] \as Mapping;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Ring.commutativeRingAsRing I.Int^ IntegerRing.commutativeRing] \as Nonnegative;
\import Nonnegative.Map[C := SourceTensor.complex, D := TargetTensor.complex].Positive[n := ResolutionNaturals.Nat^::zero] \as Induced;
\definition map: _ := Induced.induced Mapping.map;
\import S.Projection[] \as CP;
\import T.Projection[] \as DP;
\import Modules.Tensor[V := P.boundaryBundle.Carrier, W := A.Carrier, left := P.boundaryBundle.space, right := A.space] \as CK;
\import Modules.Tensor[V := Q.boundaryBundle.Carrier, W := B.Carrier, left := Q.boundaryBundle.space, right := B.space] \as DK;
\import \root.Finite[].Bounded[].Of[C := C].At[z := z].UniversalCoefficient[A := A].Boundary[] \as CB;
\import \root.Finite[].Bounded[].Of[C := D].At[z := z].UniversalCoefficient[A := B].Boundary[] \as DB;
\import Modules.Tensor[V := Carrier C z, W := A.Carrier, left := space C z, right := A.space].Mapping[U := P.boundaryBundle.Carrier, Z := A.Carrier, targetLeft := P.boundaryBundle.space, targetRight := A.space] \as CProjection;
\import Modules.Tensor[V := Carrier D z, W := B.Carrier, left := space D z, right := B.space].Mapping[U := Q.boundaryBundle.Carrier, Z := B.Carrier, targetLeft := Q.boundaryBundle.space, targetRight := B.space] \as DProjection;
\import Modules.Hom[V := SN.Carrier z, W := DK.Carrier, source := SN.space z, target := DK.space] \as SquareMaps;
\import Modules.Hom[V := TN.Carrier z, W := DK.Carrier, source := TN.space z, target := DK.space].Composition[U := SN.Carrier z, domain := SN.space z] \as LeftSquare;
\import Modules.Hom[V := CK.Carrier, W := DK.Carrier, source := CK.space, target := DK.space].Composition[U := SN.Carrier z, domain := SN.space z] \as RightSquare;
\import Modules.Tensor[V := Carrier C z, W := A.Carrier, left := space C z, right := A.space].Universal[U := DK.Carrier, target := DK.space] \as Universal;
\definition square: LeftSquare.compose T.projection CurrentDegree.map = RightSquare.compose Mapping.At[n := resolutionOne].map S.projection :=
  Universal.ext (LeftSquare.compose T.projection CurrentDegree.map) (RightSquare.compose Mapping.At[n := resolutionOne].map S.projection)
    (\fun (x: Carrier C z)(a: A.Carrier) => trans!{DK.Carrier} _ _ _
      (congr!{{TN.Carrier z} DK.Carrier} (#apply{T.projection}) _ _ (CurrentDegree.onTensor x a))
      (trans!{DK.Carrier} _ _ _ (DProjection.onTensor DB.map CoefficientB.identity (#apply{(linear f z)} x) (#apply{u} a))
        (trans!{DK.Carrier} _ _ _
          (\block {
            \let left: Q.boundaryBundle.Carrier := DB.value (#apply{(chainMap f)} z x) \then
            \let right: Q.boundaryBundle.Carrier := #apply{Comparison.boundaries} (CB.value x) \then
            \let same: left = right := #commutes{(chainMap f)} z x \then
            \return congr!{Q.boundaryBundle.Carrier DK.Carrier} (\fun (y: Q.boundaryBundle.Carrier) => DK.tensor y (#apply{u} a)) left right same
          })
          (sym!{DK.Carrier} _ _ (trans!{DK.Carrier} _ _ _
            (congr!{CK.Carrier DK.Carrier} (#apply{Mapping.At[n := resolutionOne].map}) _ _ (CProjection.onTensor CB.map CA.identity x a))
            (Mapping.At[n := resolutionOne].onTensor (CB.value x) a))))));
\definition onCycle: \forall (x: SH.Cycle) ->
  #apply{(Induced.cyclesMap Mapping.map)} (CP.kernel x) = DP.kernel (#apply{(TensorHomology.cyclesMap tensorMap)} x) :=
  \fun (x: SH.Cycle) => sym!{DK.Carrier} _ _
    (congr!{SquareMaps.Map DK.Carrier} (\fun (g: SquareMaps.Map) => #apply{g} x) _ _ square);
\definition sourceOnClass: \forall (x: SH.Cycle) -> #apply{SD.projection} (SH.classOf x) =
  #apply{#backward{Ctor.isomorphism}} (CP.kernel x) :=
  \fun (x: SH.Cycle) => congr!{Ctor.Kernel Ctor.Carrier} (#apply{#backward{Ctor.isomorphism}}) _ _ (CP.onClass x);
\definition targetOnClass: \forall (x: TH.Cycle) -> #apply{TD.projection} (TH.classOf x) =
  #apply{#backward{Dtor.isomorphism}} (DP.kernel x) :=
  \fun (x: TH.Cycle) => congr!{Dtor.Kernel Dtor.Carrier} (#apply{#backward{Dtor.isomorphism}}) _ _ (DP.onClass x);
\definition projectionNaturality: \forall (q: SH.Homology) ->
  #apply{map} (#apply{SD.projection} q) = #apply{TD.projection} (#apply{middle} q) :=
  SH.classInduction (\fun (q: SH.Homology) => #apply{map} (#apply{SD.projection} q) = #apply{TD.projection} (#apply{middle} q))
    (\fun (x: SH.Cycle) => trans!{Dtor.Carrier} _ _ _
      (congr!{Ctor.Carrier Dtor.Carrier} (#apply{map}) _ _ (sourceOnClass x))
      (trans!{Dtor.Carrier} _ _ _ (Induced.onClass Mapping.map (CP.kernel x))
        (trans!{Dtor.Carrier} _ _ _
          (congr!{Dtor.Kernel Dtor.Carrier} (#apply{#backward{Dtor.isomorphism}}) _ _ (onCycle x))
          (sym!{Dtor.Carrier} _ _ (trans!{Dtor.Carrier} _ _ _
            (congr!{TH.Homology Dtor.Carrier} (#apply{TD.projection}) _ _ (TensorHomology.onClass tensorMap x))
            (targetOnClass (#apply{(TensorHomology.cyclesMap tensorMap)} x)))))));
\definition agrees: map = tor := torUnique map projectionNaturality;
\import Tensor.On[P := Dtor.complex, N := A] \as Intermediate;
\import Nonnegative.Positive[C := SourceTensor.complex, n := ResolutionNaturals.Nat^::zero] \as IH;
\import Nonnegative.Positive[C := Intermediate.complex, n := ResolutionNaturals.Nat^::zero] \as MH;
\import Nonnegative.Positive[C := TargetTensor.complex, n := ResolutionNaturals.Nat^::zero] \as OH;
\import Tensor.Mapping[P := Ctor.complex, Q := Dtor.complex, N := A, L := A].On[f := resolutionMap, u := CA.identity] \as RawFirst;
\import Nonnegative.Map[C := SourceTensor.complex, D := Intermediate.complex].Positive[n := ResolutionNaturals.Nat^::zero] \as RawFirstInduced;
\import derived_functors.Tor[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].First[M := P.homologyBundle, L := Q.homologyBundle, N := A, P := Ctor.complex, Q := Dtor.complex].Positive[n := ResolutionNaturals.Nat^::zero].With[
  p := Ctor.resolution P.boundaryProjective P.cyclesProjective, q := Dtor.resolution Q.boundaryProjective Q.cyclesProjective,
  f := Previous.induced (chainMap f)] \as First;
\definition firstAgreement: First.map = RawFirstInduced.induced RawFirst.map :=
  First.onComparison resolutionMap (\fun (x: P.cyclesBundle.Carrier) => sym!{Q.homologyBundle.Carrier} _ _ (Previous.onClass (chainMap f) x));
\import derived_functors.Tor[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].Second[M := Q.homologyBundle, N := A, L := B, P := Dtor.complex].Positive[n := ResolutionNaturals.Nat^::zero] \as Second;
\import Modules.Hom[V := MH.Homology, W := OH.Homology, source := MH.homologySpace, target := OH.homologySpace].Composition[U := IH.Homology, domain := IH.homologySpace] \as Composition;
\definition functorMap: _ := Composition.compose (Second.map u) First.map;
\import Nonnegative.End[C := Dtor.complex] \as Identity;
\import Tensor.Mapping[P := Dtor.complex, Q := Dtor.complex, N := A, L := B].On[f := Identity.identity, u := u] \as RawSecond;
\import Nonnegative.Map[C := Intermediate.complex, D := TargetTensor.complex].Positive[n := ResolutionNaturals.Nat^::zero] \as RawSecondInduced;
\import Modules.Hom[V := Intermediate.Carrier resolutionOne, W := TargetTensor.Carrier resolutionOne, source := Intermediate.space resolutionOne, target := TargetTensor.space resolutionOne].Composition[U := SourceTensor.Carrier resolutionOne, domain := SourceTensor.space resolutionOne] \as TermComposition;
\import Modules.Hom[V := SourceTensor.Carrier resolutionOne, W := TargetTensor.Carrier resolutionOne, source := SourceTensor.space resolutionOne, target := TargetTensor.space resolutionOne] \as TermMaps;
\import CK.Universal[U := DK.Carrier, target := DK.space] \as TermUniversal;
\definition terms: TermComposition.compose RawSecond.At[n := resolutionOne].map RawFirst.At[n := resolutionOne].map = Mapping.At[n := resolutionOne].map :=
  TermUniversal.ext (TermComposition.compose RawSecond.At[n := resolutionOne].map RawFirst.At[n := resolutionOne].map) Mapping.At[n := resolutionOne].map
    (\fun (x: P.boundaryBundle.Carrier)(a: A.Carrier) => trans!{DK.Carrier} _ _ _
      (congr!{{Intermediate.Carrier resolutionOne} DK.Carrier} (#apply{RawSecond.At[n := resolutionOne].map}) _ _ (RawFirst.At[n := resolutionOne].onTensor x a))
      (trans!{DK.Carrier} _ _ _ (RawSecond.At[n := resolutionOne].onTensor (#apply{Comparison.boundaries} x) a)
        (sym!{DK.Carrier} _ _ (Mapping.At[n := resolutionOne].onTensor x a))));
\definition representatives: \forall (x: IH.Cycle) ->
  #apply{(RawSecondInduced.cyclesMap RawSecond.map)} (#apply{(RawFirstInduced.cyclesMap RawFirst.map)} x) = #apply{(Induced.cyclesMap Mapping.map)} x :=
  \fun (x: IH.Cycle) => congr!{TermMaps.Map DK.Carrier} (\fun (g: TermMaps.Map) => #apply{g} x) _ _ terms;
\definition functorOnClass: \forall (x: IH.Cycle) -> #apply{functorMap} (IH.classOf x) = #apply{map} (IH.classOf x) :=
  \fun (x: IH.Cycle) => trans!{OH.Homology} _ _ _
    (congr!{Modules.Hom[V := IH.Homology, W := MH.Homology, source := IH.homologySpace, target := MH.homologySpace].Map OH.Homology}
      (\fun (g: Modules.Hom[V := IH.Homology, W := MH.Homology, source := IH.homologySpace, target := MH.homologySpace].Map) => #apply{(Second.map u)} (#apply{g} (IH.classOf x))) _ _ firstAgreement)
    (trans!{OH.Homology} _ _ _
      (congr!{MH.Homology OH.Homology} (#apply{(Second.map u)}) _ _ (RawFirstInduced.onClass RawFirst.map x))
      (trans!{OH.Homology} _ _ _ (Second.onClass u (#apply{(RawFirstInduced.cyclesMap RawFirst.map)} x))
        (trans!{OH.Homology} _ _ _ (congr!{OH.Cycle OH.Homology} OH.classOf _ _ (representatives x))
          (sym!{OH.Homology} _ _ (Induced.onClass Mapping.map x)))));
\import Modules.Hom[V := Ctor.Carrier, W := Dtor.Carrier, source := Ctor.space, target := Dtor.space] \as TorMaps;
\definition functorAgreement: functorMap = tor := trans!{TorMaps.Map} _ _ _
  (TorMaps.ext functorMap map (IH.classInduction (\fun (x: IH.Homology) => #apply{functorMap} x = #apply{map} x) functorOnClass)) agrees;
\definition onKernelGenerator: \forall (x: Ctor.Kernel) ->
  #apply{tor} (#apply{#backward{Ctor.isomorphism}} x) =
    #apply{#backward{Dtor.isomorphism}} (#apply{(Induced.cyclesMap Mapping.map)} x) :=
  \fun (x: Ctor.Kernel) => trans!{Dtor.Carrier} _ _ _
    (congr!{TorMaps.Map Dtor.Carrier} (\fun (h: TorMaps.Map) => #apply{h} (#apply{#backward{Ctor.isomorphism}} x)) _ _ (sym!{TorMaps.Map} _ _ agrees))
    (Induced.onClass Mapping.map x);
\definition kernelNaturality: \forall (x: Ctor.Kernel) ->
  #apply{#forward{Dtor.isomorphism}} (#apply{tor} (#apply{#backward{Ctor.isomorphism}} x)) =
    #apply{(Induced.cyclesMap Mapping.map)} x :=
  \fun (x: Ctor.Kernel) => trans!{Dtor.Kernel} _ _ _
    (congr!{Dtor.Carrier Dtor.Kernel} (#apply{#forward{Dtor.isomorphism}}) _ _ (onKernelGenerator x))
    (#rightInverse{Dtor.isomorphism} (#apply{(Induced.cyclesMap Mapping.map)} x));
\definition kernelMap: Modules.Hom[V := Ctor.Kernel, W := Dtor.Kernel, source := Ctor.kernelSpace, target := Dtor.kernelSpace].Map := Induced.cyclesMap Mapping.map;
