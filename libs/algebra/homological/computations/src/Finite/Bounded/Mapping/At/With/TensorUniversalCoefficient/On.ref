\import resolutions.TensorComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].Integer[P := Source.chain, N := A] \as SN;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].Integer[P := Target.chain, N := B] \as TN;
\import Chains.At[C := S.tensorComplex, z := z] \as SH;
\import Chains.At[C := T.tensorComplex, z := z] \as TH;
\import Modules.Tensor[V := SourceHomology.Cycle, W := A.Carrier, left := SourceHomology.cycleSpace, right := A.space] \as SC;
\import Modules.Tensor[V := TargetHomology.Cycle, W := B.Carrier, left := TargetHomology.cycleSpace, right := B.space] \as TC;
\import Modules.Tensor[V := SourceHomology.Homology, W := A.Carrier, left := SourceHomology.homologySpace, right := A.space] \as SA;
\import Modules.Tensor[V := TargetHomology.Homology, W := B.Carrier, left := TargetHomology.homologySpace, right := B.space] \as TA;
\import Modules.End[V := A.Carrier, space := A.space] \as CA;
\import Modules.End[V := B.Carrier, space := B.space] \as CB;
\import Modules.Of[V := Carrier C z, space := space C z].Submodule[].Of[S := SourceHomology.cycles] \as SourceCycles;
\import Modules.Of[V := Carrier D z, space := space D z].Submodule[].Of[S := TargetHomology.cycles] \as TargetCycles;
\import SC.Mapping[U := Carrier C z, Z := A.Carrier, targetLeft := space C z, targetRight := A.space] \as SI;
\import TC.Mapping[U := Carrier D z, Z := B.Carrier, targetLeft := space D z, targetRight := B.space] \as TI;
\import SC.Mapping[U := SourceHomology.Homology, Z := A.Carrier, targetLeft := SourceHomology.homologySpace, targetRight := A.space] \as SP;
\import TC.Mapping[U := TargetHomology.Homology, Z := B.Carrier, targetLeft := TargetHomology.homologySpace, targetRight := B.space] \as TP;
\definition sourceLeft: Modules.Bundle := Modules.Bundle { Carrier := SA.Carrier, space := SA.space };
\definition targetLeft: Modules.Bundle := Modules.Bundle { Carrier := TA.Carrier, space := TA.space };
\definition sourceMiddle: Modules.Bundle := Modules.Bundle { Carrier := SH.Homology, space := SH.homologySpace };
\definition targetMiddle: Modules.Bundle := Modules.Bundle { Carrier := TH.Homology, space := TH.homologySpace };
\import Modules.Biproduct[V := SA.Carrier, W := SD.torBundle.Carrier, left := SA.space, right := SD.torBundle.space] \as SS;
\import Modules.Biproduct[V := TA.Carrier, W := TD.torBundle.Carrier, left := TA.space, right := TD.torBundle.space] \as TS;
\module Degreewise(k: Degree) {
  \import Modules.Tensor[V := Carrier C k, W := A.Carrier, left := space C k, right := A.space] \as SourceTensor;
  \import Modules.Tensor[V := Carrier D k, W := B.Carrier, left := space D k, right := B.space] \as TargetTensor;
  \import SourceTensor.Mapping[U := Carrier D k, Z := B.Carrier, targetLeft := space D k, targetRight := B.space] \as Mapping;
  \definition map: _ := Mapping.map (linear f k) u;
  \definition onTensor: \forall (x: Carrier C k)(a: A.Carrier) ->
    map.apply (SourceTensor.tensor x a) = TargetTensor.tensor ((linear f k).apply x) (u.apply a) := Mapping.onTensor (linear f k) u;
}
\module Differential(k: Degree) {
  \import \parent.Degreewise[k := k] \as Current;
  \import \parent.Degreewise[k := previous k] \as Lower;
  \import SN.Step[z := k] \as SourceTensor;
  \import TN.Step[z := k] \as TargetTensor;
  \import Modules.Hom[V := T.tensorCarrier k, W := T.tensorCarrier (previous k), source := T.tensorSpace k, target := T.tensorSpace (previous k)].Composition[U := S.tensorCarrier k, domain := S.tensorSpace k] \as Left;
  \import Modules.Hom[V := S.tensorCarrier (previous k), W := T.tensorCarrier (previous k), source := S.tensorSpace (previous k), target := T.tensorSpace (previous k)].Composition[U := S.tensorCarrier k, domain := S.tensorSpace k] \as Right;
  \import Modules.Tensor[V := Carrier C k, W := A.Carrier, left := space C k, right := A.space].Universal[U := TN.Carrier (previous k), target := TN.space (previous k)] \as Equality;
  \definition equal: Left.compose TargetTensor.differential Current.map = Right.compose Lower.map SourceTensor.differential :=
    Equality.ext (Left.compose TargetTensor.differential Current.map) (Right.compose Lower.map SourceTensor.differential)
      (\fun (x: Carrier C k)(a: A.Carrier) => trans!{{TN.Carrier (previous k)}} _ _ _
        (congr!{{TN.Carrier k} {TN.Carrier (previous k)}} (TargetTensor.differential.apply) _ _ (Current.onTensor x a))
        (trans!{{TN.Carrier (previous k)}} _ _ _ (TargetTensor.onTensor ((linear f k).apply x) (u.apply a))
          (trans!{{TN.Carrier (previous k)}} _ _ _
            (congr!{{Carrier D (previous k)} {TN.Carrier (previous k)}} (\fun (y: Carrier D (previous k)) => TN.At[z := previous k].tensor y (u.apply a)) _ _
              ((chainMap f).commutes k x))
            (sym!{{TN.Carrier (previous k)}} _ _ (trans!{{TN.Carrier (previous k)}} _ _ _
              (congr!{{SN.Carrier (previous k)} {TN.Carrier (previous k)}} (Lower.map.apply) _ _ (SourceTensor.onTensor x a))
              (Lower.onTensor (Source.chain.differential.apply k x) a))))));
  \definition commutes: \forall (x: S.tensorCarrier k) ->
    TargetTensor.differential.apply (Current.map.apply x) = Lower.map.apply (SourceTensor.differential.apply x) :=
    \fun (x: S.tensorCarrier k) => congr!{Modules.Hom[V := S.tensorCarrier k, W := T.tensorCarrier (previous k), source := S.tensorSpace k, target := T.tensorSpace (previous k)].Map {T.tensorCarrier (previous k)}}
      (\fun (g: Modules.Hom[V := S.tensorCarrier k, W := T.tensorCarrier (previous k), source := S.tensorSpace k, target := T.tensorSpace (previous k)].Map) => g.apply x) _ _ equal;
}
\import Chains.Map[C := S.tensorComplex, D := T.tensorComplex] \as TensorMaps;
\definition tensorMap: TensorMaps.Map := TensorMaps.Map {
  apply := \fun (k: Degree) => (Degreewise[k := k].map).apply,
  addition := \fun (k: Degree) => (Degreewise[k := k].map).addition,
  scalar := \fun (k: Degree) => (Degreewise[k := k].map).scalar,
  commutes := \fun (k: Degree) => Differential[k := k].commutes,
};
\import TensorMaps.At[k := z] \as TensorHomology;
\definition middle: _ := TensorHomology.induced tensorMap;
\import SA.Mapping[U := TargetHomology.Homology, Z := B.Carrier, targetLeft := TargetHomology.homologySpace, targetRight := B.space] \as LeftMapping;
\definition left: _ := LeftMapping.map induced u;
\definition sourcePure: \forall (x: SourceHomology.Cycle)(a: A.Carrier) ->
  SB.map.apply (SA.tensor (SourceHomology.classOf x) a) = SH.classOf (S.cycle (SC.tensor x a)) :=
  \fun (x: SourceHomology.Cycle)(a: A.Carrier) => trans!{SH.Homology} _ _ _
    (sym!{SH.Homology} _ _ (congr!{SA.Carrier SH.Homology} (SB.map.apply) _ _
      (SP.onTensor SourceHomology.classLinear CA.identity x a)))
    (SB.onCycles (SC.tensor x a));
\definition targetPure: \forall (x: TargetHomology.Cycle)(a: B.Carrier) ->
  TB.map.apply (TA.tensor (TargetHomology.classOf x) a) = TH.classOf (T.cycle (TC.tensor x a)) :=
  \fun (x: TargetHomology.Cycle)(a: B.Carrier) => trans!{TH.Homology} _ _ _
    (sym!{TH.Homology} _ _ (congr!{TA.Carrier TH.Homology} (TB.map.apply) _ _
      (TP.onTensor TargetHomology.classLinear CB.identity x a)))
    (TB.onCycles (TC.tensor x a));
\definition cycleNaturality: \forall (x: SourceHomology.Cycle)(a: A.Carrier) ->
  (TensorHomology.cyclesMap tensorMap).apply (S.cycle (SC.tensor x a)) =
    T.cycle (TC.tensor ((Induced.cyclesMap (chainMap f)).apply x) (u.apply a)) :=
  \fun (x: SourceHomology.Cycle)(a: A.Carrier) => trans!{{TN.Carrier z}} _ _ _
    (congr!{{SN.Carrier z} {TN.Carrier z}} ((Degreewise[k := z].map).apply) _ _
      (SI.onTensor SourceCycles.inclusion CA.identity x a))
    (trans!{{TN.Carrier z}} _ _ _ (Degreewise[k := z].onTensor x a)
      (sym!{{TN.Carrier z}} _ _
        (TI.onTensor TargetCycles.inclusion CB.identity ((Induced.cyclesMap (chainMap f)).apply x) (u.apply a))));
\definition pureNaturality: \forall (x: SourceHomology.Cycle)(a: A.Carrier) ->
  middle.apply (SB.map.apply (SA.tensor (SourceHomology.classOf x) a)) =
    TB.map.apply (left.apply (SA.tensor (SourceHomology.classOf x) a)) :=
  \fun (x: SourceHomology.Cycle)(a: A.Carrier) => trans!{TH.Homology} _ _ _
    (congr!{SH.Homology TH.Homology} (middle.apply) _ _ (sourcePure x a))
    (trans!{TH.Homology} _ _ _ (TensorHomology.onClass tensorMap (S.cycle (SC.tensor x a)))
      (trans!{TH.Homology} _ _ _
        (congr!{TH.Cycle TH.Homology} TH.classOf _ _ (cycleNaturality x a))
        (sym!{TH.Homology} _ _ (trans!{TH.Homology} _ _ _
          (congr!{TA.Carrier TH.Homology} (TB.map.apply) _ _
            (LeftMapping.onTensor induced u (SourceHomology.classOf x) a))
          (trans!{TH.Homology} _ _ _
            (congr!{TargetHomology.Homology TH.Homology}
              (\fun (q: TargetHomology.Homology) => TB.map.apply (TA.tensor q (u.apply a))) _ _
              (Induced.onClass (chainMap f) x))
            (targetPure ((Induced.cyclesMap (chainMap f)).apply x) (u.apply a)))))));
\import Modules.Hom[V := SH.Homology, W := TH.Homology, source := SH.homologySpace, target := TH.homologySpace].Composition[U := SA.Carrier, domain := SA.space] \as LeftSquare;
\import Modules.Hom[V := TA.Carrier, W := TH.Homology, source := TA.space, target := TH.homologySpace].Composition[U := SA.Carrier, domain := SA.space] \as RightSquare;
\import SA.Universal[U := TH.Homology, target := TH.homologySpace] \as TensorEquality;
\definition square: LeftSquare.compose middle SB.map = RightSquare.compose TB.map left :=
  TensorEquality.ext (LeftSquare.compose middle SB.map) (RightSquare.compose TB.map left)
    (SourceHomology.classInduction (\fun (q: SourceHomology.Homology) => \forall (a: A.Carrier) ->
      middle.apply (SB.map.apply (SA.tensor q a)) = TB.map.apply (left.apply (SA.tensor q a))) pureNaturality);
\definition inclusionNaturality: \forall (q: SA.Carrier) ->
  middle.apply (SB.map.apply q) = TB.map.apply (left.apply q) :=
  \fun (q: SA.Carrier) => congr!{Modules.Hom[V := SA.Carrier, W := TH.Homology, source := SA.space, target := TH.homologySpace].Map TH.Homology}
    (\fun (g: Modules.Hom[V := SA.Carrier, W := TH.Homology, source := SA.space, target := TH.homologySpace].Map) => g.apply q) _ _ square;
\import derived_functors.UniversalCoefficient[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].ExactNaturality[
  L := sourceLeft, M := sourceMiddle, N := SD.torBundle,
  L1 := targetLeft, M1 := targetMiddle, N1 := TD.torBundle] \as Natural;
\import Natural.Cokernel[s := SD.sequence, t := TD.sequence, a := left, b := middle] \as Cokernel;
\definition tor: _ := Cokernel.map inclusionNaturality;
\definition projectionNaturality: \forall (q: SH.Homology) ->
  tor.apply (SD.projection.apply q) = TD.projection.apply (middle.apply q) := Cokernel.naturality inclusionNaturality;
\definition diagram: _ := Cokernel.diagram inclusionNaturality;
\definition torUnique: \forall (v: Modules.Hom[V := SD.torBundle.Carrier, W := TD.torBundle.Carrier, source := SD.torBundle.space, target := TD.torBundle.space].Map) ->
  (\forall (q: SH.Homology) -> v.apply (SD.projection.apply q) = TD.projection.apply (middle.apply q)) -> v = tor := Cokernel.unique inclusionNaturality;

\import Modules.Hom[V := SH.Homology, W := TH.Homology,
  source := SH.homologySpace, target := TH.homologySpace].Composition[U := SS.Carrier, domain := SS.space] \as FromCoordinates;
\import Modules.Hom[V := TH.Homology, W := TS.Carrier,
  source := TH.homologySpace, target := TS.space].Composition[U := SS.Carrier, domain := SS.space] \as ToCoordinates;
\definition smithCoordinates: _ := ToCoordinates.compose TD.isomorphism.backward
  (FromCoordinates.compose middle SD.isomorphism.forward);
\definition smithNaturality: \forall (x: SS.Carrier) ->
  TD.isomorphism.forward.apply (smithCoordinates.apply x) = middle.apply (SD.isomorphism.forward.apply x) :=
  \fun (x: SS.Carrier) => TD.isomorphism.rightInverse (middle.apply (SD.isomorphism.forward.apply x));
\module Derived;
\definition leftOnComputedGenerators: \forall (v: Modules.FiniteCoordinates[n := SourcePair.nullity].Carrier)(a: A.Carrier) ->
  left.apply (SA.tensor (SourceResult.factorIsomorphism.backward.apply (SourcePair.factorClasses v)) a) =
    TA.tensor (TargetResult.factorIsomorphism.backward.apply
      (TargetPair.factorClasses (Commutative.Matrix[m := TargetPair.nullity, n := SourcePair.nullity].apply coordinateMatrix v))) (u.apply a) :=
  \fun (v: Modules.FiniteCoordinates[n := SourcePair.nullity].Carrier)(a: A.Carrier) => trans!{TA.Carrier} _ _ _
    (LeftMapping.onTensor induced u (SourceResult.factorIsomorphism.backward.apply (SourcePair.factorClasses v)) a)
    (congr!{TargetHomology.Homology TA.Carrier} (\fun (q: TargetHomology.Homology) => TA.tensor q (u.apply a)) _ _ (onComputedGenerator v));
