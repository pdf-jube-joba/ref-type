\import std.Data[].Nat[] \as ResolutionNaturals;
\import \root.Finite[].Bounded[].Of[C := C].At[z := previous z].Presentation[] \as P;
\import \root.Finite[].Bounded[].Of[C := D].At[z := previous z].Presentation[] \as Q;
\import Chains.At[C := Source.chain, z := previous z] \as HC;
\import Chains.At[C := Target.chain, z := previous z] \as HD;
\import Maps.At[k := previous z] \as Previous;
\import Modules.Hom[V := P.boundaryBundle.Carrier, W := Q.boundaryBundle.Carrier, source := P.boundaryBundle.space, target := Q.boundaryBundle.space] \as BoundaryMaps;
\definition boundaries: BoundaryMaps.Map := BoundaryMaps.Map {
  apply := \fun (x: P.boundaryBundle.Carrier) => \into[HD.Cycle](#apply{(Previous.cyclesMap (chainMap f))} x, #carrier{HD.boundariesInside}) \by {
    Previous.preservesBoundaries (chainMap f) x (\bysub(HC.Cycle, #carrier{HC.boundariesInside}, x))
  },
  addition := \fun (x, y: P.boundaryBundle.Carrier) => #addition{(chainMap f)} (previous z) x y,
  scalar := \fun (a: I.Int^)(x: P.boundaryBundle.Carrier) => #scalar{(chainMap f)} (previous z) a x,
};
\import derived_functors.UniversalCoefficient[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].LengthOneMapping[K := P.boundaryBundle, L := P.cyclesBundle, M := P.homologyBundle,
  K1 := Q.boundaryBundle, L1 := Q.cyclesBundle, M1 := Q.homologyBundle].On[s := P.sequence, t := Q.sequence,
  a := boundaries, b := Previous.cyclesMap (chainMap f), c := Previous.induced (chainMap f)] \as LengthOne;
\definition square: LengthOne.Commutes := \fun (x: P.boundaryBundle.Carrier) => \refl(#apply{(chainMap f)} (previous z) x);
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Ring.commutativeRingAsRing I.Int^ IntegerRing.commutativeRing].Map[C := P.complex, D := Q.complex] \as Native;
\definition map: Native.Map := Native.Map {
  apply := \fun (n: ResolutionNaturals.Nat^)(x: P.family.Carrier n) => #apply{(LengthOne.map square)} n x,
  addition := \fun (n: ResolutionNaturals.Nat^) => #addition{(LengthOne.map square)} n,
  scalar := \fun (n: ResolutionNaturals.Nat^) => #scalar{(LengthOne.map square)} n,
  commutes := \fun (n: ResolutionNaturals.Nat^) => #commutes{(LengthOne.map square)} n,
};
