\import \parent.Of[C := C] \as Source;
\import \parent.Of[C := D] \as Target;
\structure Data: \Set { entries: Degree -> Runtime^ }
\definition linear(data: Data)(z: Degree): Modules.Hom[V := Carrier C z, W := Carrier D z, source := space C z, target := space D z].Map :=
  Commutative.Matrix[m := D.ranks z, n := C.ranks z].linear
    (\fun (i: Indices.Fin (D.ranks z))(j: Indices.Fin (C.ranks z)) => data.entries z i j);
\structure Laws[data: Data]: \Prop {
  commutes: \forall (z: Degree)(v: Carrier C z) ->
    apply D z ((linear data z).apply v) = (linear data (previous z)).apply (apply C z v),
}
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\import Chains.Map[C := Source.chain, D := Target.chain] \as Maps;
\definition chainMap(f: Map): Maps.Map := Maps.Map {
  apply := \fun (z: Degree) => (linear f z).apply,
  addition := \fun (z: Degree) => (linear f z).addition,
  scalar := \fun (z: Degree) => (linear f z).scalar,
  commutes := (\bysub(Data, { data: Data \where Laws[data] }, f)).commutes,
};
\module At(z: Degree);
