\use std.Logic[].Equality[].eq_reason_in;
\import Modules.ShortExact[A := A, B := B, C := C] \as Source;
\import Modules.ShortExact[A := L, B := B, C := R] \as Target;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Composition[U := L.Carrier, domain := L.space] \as LeftComposition;
\import Modules.Hom[V := C.Carrier, W := R.Carrier, source := C.space, target := R.space].Composition[U := B.Carrier, domain := B.space] \as RightComposition;
\import Modules.Hom[V := C.Carrier, W := R.Carrier, source := C.space, target := R.space] \as RightMaps;
\import std.Logic[].Proposition[] \as Logic;
\definition inclusion: Modules.MapBetween L B := LeftComposition.compose s.inclusion leftIso.forward;
\definition projection: Modules.MapBetween B R := RightComposition.compose rightIso.forward s.projection;
\definition injective: Modules.Injective L B inclusion :=
  \fun (x, y: L.Carrier)(equal: inclusion.apply x = inclusion.apply y) =>
    eq_reason_in!{L.Carrier _
      "=" _ "by" { sym!{L.Carrier} _ _ (leftIso.leftInverse x) }
      "=" _ "by" { congr!{A.Carrier L.Carrier} (leftIso.backward.apply) _ _ (s.injective _ _ equal) }
      "=" _ "by" { leftIso.leftInverse y }
    };
\definition onto: Modules.Surjective B R projection := \block {
  \fun (z: R.Carrier) \then
  \takefrom y: \Cast[B.Carrier] ({ y: B.Carrier \where s.projection.apply y = rightIso.backward.apply z })
    \by s.onto (rightIso.backward.apply z) \then
  \return Logic.existsIntro[B.Carrier, { y: B.Carrier \where projection.apply y = z }] y
    (trans!{R.Carrier} _ _ _
      (congr!{C.Carrier R.Carrier} (rightIso.forward.apply) _ _
        (\bysub(B.Carrier, { y: B.Carrier \where s.projection.apply y = rightIso.backward.apply z }, y)))
      (rightIso.rightInverse z))
};
\definition zero: \forall (x: L.Carrier) -> projection.apply (inclusion.apply x) = R.space.zero :=
  \fun (x: L.Carrier) => trans!{R.Carrier} _ _ _
    (congr!{C.Carrier R.Carrier} (rightIso.forward.apply) _ _ (s.zero (leftIso.forward.apply x)))
    (RightMaps.zeroPreserved rightIso.forward);
\definition originalKernel: \forall (y: B.Carrier) -> projection.apply y = R.space.zero -> s.projection.apply y = C.space.zero :=
  \fun (y: B.Carrier)(equal: projection.apply y = R.space.zero) =>
    eq_reason_in!{C.Carrier _
      "=" _ "by" { sym!{C.Carrier} _ _ (rightIso.leftInverse (s.projection.apply y)) }
      "=" _ "by" { congr!{R.Carrier C.Carrier} (rightIso.backward.apply) _ _ equal }
      "=" _ "by" { Modules.Hom[V := R.Carrier, W := C.Carrier, source := R.space, target := C.space].zeroPreserved rightIso.backward }
    };
\definition kernelImage: \forall (y: B.Carrier) -> projection.apply y = R.space.zero ->
  \exists ( x: L.Carrier \where inclusion.apply x = y ) := \block {
  \fun (y: B.Carrier)(equal: projection.apply y = R.space.zero) \then
  \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where s.inclusion.apply x = y })
    \by s.kernelImage y (originalKernel y equal) \then
  \return Logic.existsIntro[L.Carrier, { x: L.Carrier \where inclusion.apply x = y }] (leftIso.backward.apply x)
    (trans!{B.Carrier} _ _ _
      (congr!{A.Carrier B.Carrier} (s.inclusion.apply) _ _ (leftIso.rightInverse x))
      (\bysub(A.Carrier, { x: A.Carrier \where s.inclusion.apply x = y }, x)))
};
\definition data: Target.Data := Target.Data { inclusion := inclusion, projection := projection };
\definition laws: Target.Laws[data] := Target.Laws[data] {
  injective := injective, onto := onto, zero := zero, kernelImage := kernelImage,
};
\definition sequence: Target.Sequence := \into[Target.Data](data, { value: Target.Data \where Target.Laws[value] }) \by { laws };
