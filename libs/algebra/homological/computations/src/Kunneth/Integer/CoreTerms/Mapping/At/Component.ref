\import SourceTerms.Component[p := p] \as SourceComponent;
\import TargetTerms.Component[p := p] \as TargetComponent;
\import Chains.Map[C := LeftSource.chain, D := LeftTarget.chain].At[k := p] \as LeftAt;
\import Chains.Map[C := RightSource.chain, D := RightTarget.chain].At[k := complement n p] \as RightAt;
\import Modules.Tensor[V := SourceComponent.leftBundle.Carrier, W := SourceComponent.rightBundle.Carrier, left := SourceComponent.leftBundle.space, right := SourceComponent.rightBundle.space] \as SourceTensor;
\import SourceTensor.Mapping[U := TargetComponent.leftBundle.Carrier, Z := TargetComponent.rightBundle.Carrier,
  targetLeft := TargetComponent.leftBundle.space, targetRight := TargetComponent.rightBundle.space] \as TensorMaps;
\definition tensorMap(f: LeftMaps.Map)(g: RightMaps.Map): Modules.Hom[V := SourceComponent.tensorCarrier, W := TargetComponent.tensorCarrier,
  source := SourceComponent.tensorSpace, target := TargetComponent.tensorSpace].Map :=
  TensorMaps.map (LeftAt.induced (LeftMaps.chainMap f)) (RightAt.induced (RightMaps.chainMap g));
\definition onTensor: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(x: SourceComponent.leftBundle.Carrier)(y: SourceComponent.rightBundle.Carrier) ->
  #apply{(tensorMap f g)} (SourceComponent.tensor x y) =
  TargetComponent.tensor (#apply{(LeftAt.induced (LeftMaps.chainMap f))} x) (#apply{(RightAt.induced (RightMaps.chainMap g))} y) :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map) => TensorMaps.onTensor (LeftAt.induced (LeftMaps.chainMap f)) (RightAt.induced (RightMaps.chainMap g));
