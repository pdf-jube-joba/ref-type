\import \parent.Component[i := i] \as Native;
\import Modules.Hom[V := Target.Carrier, W := Quotient.Carrier, source := Target.space, target := Quotient.moduleSpace].Composition[
  U := target.Carrier i, domain := target.space i] \as Compose;
\definition onChains: Modules.Hom[V := target.Carrier i, W := Quotient.Carrier, source := target.space i, target := Quotient.moduleSpace].Map :=
  Compose.compose Quotient.projection Target.Injection[i := i].map;
\import Modules.Of[V := target.Carrier i, space := target.space i].Submodule[].Quotient[S := Native.image].To[
  W := Quotient.Carrier, target := Quotient.moduleSpace] \as Descent;
\import Modules.Of[V := target.Carrier i, space := target.space i].Submodule[].Image[U := source.Carrier i, source := source.space i] \as NativeImages;
\definition killsGenerator: \forall (x: source.Carrier i) -> onChains.apply ((maps i).apply x) = Quotient.moduleSpace.zero :=
  \fun (x: source.Carrier i) => Quotient.classZero ((Target.Injection[i := i].map).apply ((maps i).apply x))
    (Images.introduce Action.map ((Target.Injection[i := i].map).apply ((maps i).apply x)) ((Source.Injection[i := i].map).apply x) (Action.onInjection i x));
\definition vanishes: Descent.Vanishes onChains := \fun (x: target.Carrier i)(member: _) =>
  NativeImages.eliminate (maps i) x (onChains.apply x = Quotient.moduleSpace.zero)
    (\fun (a: source.Carrier i)(equal: (maps i).apply a = x) => trans!{Quotient.Carrier} _ _ _
      (congr!{{target.Carrier i} Quotient.Carrier} (onChains.apply) _ _ (sym!{{target.Carrier i}} _ _ equal)) (killsGenerator a)) member;
\definition map: Modules.Hom[V := Native.Carrier, W := Quotient.Carrier, source := Native.space, target := Quotient.moduleSpace].Map := Descent.descend onChains vanishes;
\definition onClass: \forall (x: target.Carrier i) -> map.apply (Native.classOf x) = Quotient.class ((Target.Injection[i := i].map).apply x) := Descent.onClass onChains vanishes;
