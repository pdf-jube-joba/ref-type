\import Modules.Of[V := target.Carrier i, space := target.space i].Submodule[] \as Ambient;
\import Ambient.Image[U := source.Carrier i, source := source.space i] \as Images;
\definition image: Ambient.Submodule := Images.image (maps i);
\import Ambient.Quotient[S := image] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition space: Modules.Space Carrier := Quotient.moduleSpace;
\definition classOf: target.Carrier i -> Carrier := Quotient.class;
\definition classLinear: Modules.Hom[V := target.Carrier i, W := Carrier, source := target.space i, target := space].Map := Quotient.projection;
\definition induction: \forall (P: Carrier -> \Prop) -> (\forall (x: target.Carrier i) -> P (classOf x)) -> \forall (q: Carrier) -> P q := Quotient.induction;
\definition zero: \forall (x: source.Carrier i) -> classOf ((maps i).apply x) = space.zero :=
  \fun (x: source.Carrier i) => Quotient.classZero ((maps i).apply x) (Images.member (maps i) x);
