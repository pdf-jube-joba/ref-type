\import LeftTotal.Term[n := n] \as L;
\import MiddleTotal.Term[n := n] \as M;
\import RightTotal.Term[n := n] \as Q;
\import \parent.\parent.SplitDiagonal[Index := LeftTotal.Index n, left := L.family, middle := M.family, right := Q.family] \as Diagonal;
\module Component(j: LeftTotal.Index n);
\definition inclusions: Diagonal.InclusionComponents := \fun (j: LeftTotal.Index n) => Component[j := j].inclusion;
\definition projections: Diagonal.ProjectionComponents := \fun (j: LeftTotal.Index n) => Component[j := j].projection;
\definition retractions: Diagonal.RetractionComponents := \fun (j: LeftTotal.Index n) => Component[j := j].retraction;
\definition sections: Diagonal.SectionComponents := \fun (j: LeftTotal.Index n) => Component[j := j].section;
\import Diagonal.With[i := inclusions, p := projections, r := retractions, s := sections] \as Split;
\definition splitting: Split.Laws := Split.Laws {
  retracts := \fun (j: LeftTotal.Index n) => Component[j := j].retracts,
  section := \fun (j: LeftTotal.Index n) => Component[j := j].sectionLaw,
  zero := \fun (j: LeftTotal.Index n) => Component[j := j].zero,
  decomposition := \fun (j: LeftTotal.Index n) => Component[j := j].decomposition,
};
\definition injective: \forall (x, y: L.Carrier) ->
  #apply{Inclusion.total} n x = #apply{Inclusion.total} n y -> x = y := Split.injective splitting;
\definition onto: \forall (x: Q.Carrier) -> \exists { y: M.Carrier \where #apply{Projection.total} n y = x } := Split.onto splitting;
\definition zero: \forall (x: L.Carrier) -> #apply{Projection.total} n (#apply{Inclusion.total} n x) = #zero{Q.space} := Split.zero splitting;
\definition kernelImage: \forall (x: M.Carrier) -> #apply{Projection.total} n x = #zero{Q.space} ->
  \exists { y: L.Carrier \where #apply{Inclusion.total} n y = x } := Split.kernelImage splitting;
