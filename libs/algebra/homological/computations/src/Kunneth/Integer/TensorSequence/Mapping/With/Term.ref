\import Decomposition.Term[p := p] \as Source;
\import TargetDecomposition.Term[p := p] \as Target;
\import NativeLeft.At[k := p] \as Native;
\definition cycles: Modules.MapBetween Source.cycleBundle Target.cycleBundle := Native.cyclesMap leftChainMap;
\import Modules.Hom[V := Source.cycleCarrier, W := Target.cycleCarrier, source := Source.cycleSpace, target := Target.cycleSpace] \as CycleMaps;
\definition cyclesZero: cycles.apply Source.cycleSpace.zero = Target.cycleSpace.zero := CycleMaps.zeroPreserved cycles;
\import LeftMaps.At[z := p].With[f := f].ResolutionComparison[] \as NativeBoundary;
\definition boundaries: Modules.MapBetween Source.boundaryBundle Target.boundaryBundle := NativeBoundary.boundaries;
\import Modules.Hom[V := Source.boundaryCarrier, W := Target.boundaryCarrier, source := Source.boundarySpace, target := Target.boundarySpace] \as BoundaryMaps;
\definition boundariesZero: boundaries.apply Source.boundarySpace.zero = Target.boundarySpace.zero := BoundaryMaps.zeroPreserved boundaries;
\definition inclusionSquare: \forall (x: Source.cycleCarrier) ->
  leftChainMap.apply p (Source.inclusion.apply x) = Target.inclusion.apply (cycles.apply x) :=
  \fun (x: Source.cycleCarrier) => \refl(leftChainMap.apply p x);
\definition projectionSquare: \forall (x: Left.chain.family.Carrier p) ->
  boundaries.apply (Source.projection.apply x) = Target.projection.apply (leftChainMap.apply p x) :=
  \fun (x: Left.chain.family.Carrier p) => sym!{{TargetLeft.chain.family.Carrier (Bounded.previous p)}} _ _ (leftChainMap.commutes p x);
