\import Bounded.Mapping[C := C, D := E] \as LeftMaps;
\import Bounded.Mapping[C := D, D := F] \as RightMaps;
\import \parent.\parent.CycleBoundary[C := E] \as TargetDecomposition;
\import \parent.\parent.TensorSequence[C := E, D := F] \as TargetSequence;
\import Bounded.Of[C := E] \as TargetLeft;
\import Bounded.Of[C := F] \as TargetRight;
\import Tensors.Tensor[C := TargetDecomposition.cyclesComplex, D := TargetRight.chain] \as TargetLeftProduct;
\import Tensors.Total[C := TargetLeftProduct.complex] \as TargetLeftTotal;
\import Tensors.Tensor[C := TargetLeft.chain, D := TargetRight.chain] \as TargetMiddleProduct;
\import Tensors.Total[C := TargetMiddleProduct.complex] \as TargetMiddleTotal;
\import Tensors.Tensor[C := TargetDecomposition.boundariesComplex, D := TargetRight.chain] \as TargetRightProduct;
\import Tensors.Total[C := TargetRightProduct.complex] \as TargetRightTotal;
\module With(f: LeftMaps.Map, g: RightMaps.Map);
