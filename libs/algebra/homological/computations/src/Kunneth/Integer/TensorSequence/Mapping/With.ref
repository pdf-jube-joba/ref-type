\import Chains.Map[C := Left.chain, D := TargetLeft.chain] \as NativeLeft;
\definition leftChainMap: NativeLeft.Map := LeftMaps.chainMap f;
\definition rightChainMap: Chains.Map[C := Right.chain, D := TargetRight.chain].Map := RightMaps.chainMap g;
\module Term(p: Degree);
\import Chains.Map[C := Decomposition.cyclesComplex, D := TargetDecomposition.cyclesComplex] \as Cycles;
\definition cycles: Cycles.Map := Cycles.Map {
  apply := \fun (p: Degree) => #apply{Term[p := p].cycles},
  addition := \fun (p: Degree) => #addition{Term[p := p].cycles},
  scalar := \fun (p: Degree) => #scalar{Term[p := p].cycles},
  commutes := \fun (p: Degree)(x: Decomposition.Term[p := p].cycleCarrier) =>
    sym!{{TargetDecomposition.Term[p := Bounded.previous p].cycleCarrier}} _ _ (Term[p := Bounded.previous p].cyclesZero),
};
\import Chains.Map[C := Decomposition.boundariesComplex, D := TargetDecomposition.boundariesComplex] \as Boundaries;
\definition boundaries: Boundaries.Map := Boundaries.Map {
  apply := \fun (p: Degree) => #apply{Term[p := p].boundaries},
  addition := \fun (p: Degree) => #addition{Term[p := p].boundaries},
  scalar := \fun (p: Degree) => #scalar{Term[p := p].boundaries},
  commutes := \fun (p: Degree)(x: Decomposition.Term[p := p].boundaryCarrier) =>
    sym!{{TargetDecomposition.Term[p := Bounded.previous p].boundaryCarrier}} _ _ (Term[p := Bounded.previous p].boundariesZero),
};
\import Tensors.TensorMapping[C := Decomposition.cyclesComplex, D := TargetDecomposition.cyclesComplex, E := Right.chain, F := TargetRight.chain].With[
  f := cycles, g := rightChainMap] \as LeftTotalMap;
\import Tensors.TensorMapping[C := Left.chain, D := TargetLeft.chain, E := Right.chain, F := TargetRight.chain].With[
  f := leftChainMap, g := rightChainMap] \as MiddleTotalMap;
\import Tensors.TensorMapping[C := Decomposition.boundariesComplex, D := TargetDecomposition.boundariesComplex, E := Right.chain, F := TargetRight.chain].With[
  f := boundaries, g := rightChainMap] \as RightTotalMap;
\definition left: Chains.Map[C := LeftTotal.complex, D := TargetLeftTotal.complex].Map := LeftTotalMap.total;
\definition middle: Chains.Map[C := MiddleTotal.complex, D := TargetMiddleTotal.complex].Map := MiddleTotalMap.total;
\definition right: Chains.Map[C := RightTotal.complex, D := TargetRightTotal.complex].Map := RightTotalMap.total;
\import Tensors.TensorSquare[A := Decomposition.cyclesComplex, B := Left.chain, C := TargetDecomposition.cyclesComplex,
  D := Right.chain, E := TargetLeft.chain, F := TargetRight.chain].With[
  a0 := Decomposition.inclusion, a1 := leftChainMap, b0 := cycles, b1 := TargetDecomposition.inclusion, g := rightChainMap] \as LeftSquare;
\definition leftSquare: LeftSquare.Commutes := \fun (p: Degree) => Term[p := p].inclusionSquare;
\import Tensors.TensorSquare[A := Left.chain, B := Decomposition.boundariesComplex, C := TargetLeft.chain,
  D := Right.chain, E := TargetDecomposition.boundariesComplex, F := TargetRight.chain].With[
  a0 := Decomposition.projection, a1 := boundaries, b0 := leftChainMap, b1 := TargetDecomposition.projection, g := rightChainMap] \as RightSquare;
\definition rightSquare: RightSquare.Commutes := \fun (p: Degree) => Term[p := p].projectionSquare;
\import Sequences.Morphism[A1 := TargetSequence.left, B1 := TargetSequence.middle, C1 := TargetSequence.right].Diagram[
  s := sequence, t := TargetSequence.sequence, a := left, b := middle, c := right] \as Diagram;
\definition diagram: Diagram.Commutative := Diagram.Commutative {
  left := \fun (n: Degree)(x: LeftTotal.Term[n := n].Carrier) => LeftSquare.square leftSquare n x,
  right := \fun (n: Degree)(x: MiddleTotal.Term[n := n].Carrier) =>
    sym!{{TargetRightTotal.Term[n := n].Carrier}} _ _ (RightSquare.square rightSquare n x),
};
