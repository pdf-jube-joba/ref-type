\definition p: Degree := i.first;
\definition q: Degree := i.second;
\definition lowerIndex: Grading.Index (Bounded.previous n) := Grading.horizontal n i;
\import Decomposition.Term[p := p] \as Current;
\import Chains.At[C := Right.chain, z := q] \as RightHomology;
\import Chains.At[C := Decomposition.boundariesComplex, z := p] \as SourceFactor;
\import Chains.At[C := Decomposition.cyclesComplex, z := Bounded.previous p] \as LowerFactor;
\definition boundaryCycle(b: Current.boundaryCarrier): SourceFactor.Cycle :=
  SourceFactor.cycle b (\refl((Decomposition.boundariesComplex.family.space (Bounded.previous p)).zero));
\definition lowerCycle(b: Current.boundaryCarrier): LowerFactor.Cycle :=
  LowerFactor.cycle (Current.boundaryAsCycle b) (\refl((Decomposition.cyclesComplex.family.space (Bounded.previous (Bounded.previous p))).zero));
\import Tensors.IndexedCycleProduct[C := Decomposition.boundariesComplex, D := Right.chain, n := n].At[i := i] \as SourceCycle;
\import Tensors.IndexedCycleProduct[C := Decomposition.cyclesComplex, D := Right.chain, n := Bounded.previous n].At[i := lowerIndex] \as LowerCycle;
\import MiddleProduct.Term[p := p, q := q] \as MiddleTerm;
\import MiddleProduct.Term[p := Bounded.previous p, q := q] \as HorizontalTerm;
\import MiddleProduct.Term[p := p, q := Bounded.previous q] \as VerticalTerm;
\import MiddleProduct.At[p := p, q := q] \as Differential;
\import MiddleTotal.Term[n := n] \as MiddleCurrent;
\import MiddleTotal.Term[n := Bounded.previous n] \as MiddleLower;
\import MiddleTotal.Step[n := n] \as Step;
\import MiddleCurrent.Component[i := i] \as Injection;
\import MiddleLower.Component[i := lowerIndex] \as HorizontalInjection;
\import MiddleLower.Component[i := Grading.vertical n i] \as VerticalInjection;
\definition lift(b: Current.boundaryCarrier)(y: RightHomology.Cycle): MiddleCurrent.Carrier :=
  Injection.injection.apply (MiddleTerm.tensor (Current.section.apply b) y);
\import Tensors.Map[C := MiddleProduct.complex, D := RightProduct.complex].Total[f := Projection.map].Term[n := n] \as ProjectionTotal;
\import Projection.Term[p := p, q := q] \as ProjectionTerm;
\import RightTotal.Term[n := n].Component[i := i] \as RightInjection;
\import RightProduct.Term[p := p, q := q] \as RightTerm;
\definition lifted: \forall (b: Current.boundaryCarrier)(y: RightHomology.Cycle) ->
  Projection.total.apply n (lift b y) = SourceCycle.value (boundaryCycle b) y :=
  \fun (b: Current.boundaryCarrier)(y: RightHomology.Cycle) => trans!{{RightTotal.Term[n := n].Carrier}} _ _ _
    (ProjectionTotal.onInjection i (MiddleTerm.tensor (Current.section.apply b) y))
    (trans!{{RightTotal.Term[n := n].Carrier}} _ _ _
      (congr!{RightTerm.Carrier {RightTotal.Term[n := n].Carrier}} (RightInjection.injection.apply) _ _ (ProjectionTerm.onTensor (Current.section.apply b) y))
      (congr!{Current.boundaryCarrier {RightTotal.Term[n := n].Carrier}} (\fun (c: Current.boundaryCarrier) => RightInjection.injection.apply (RightTerm.tensor c y)) _ _ (Current.sectionLaw b)));
\definition horizontal: \forall (b: Current.boundaryCarrier)(y: RightHomology.Cycle) ->
  Step.horizontal.apply (lift b y) = HorizontalInjection.injection.apply (HorizontalTerm.tensor (Current.boundaryAsCycle b) y) :=
  \fun (b: Current.boundaryCarrier)(y: RightHomology.Cycle) => trans!{MiddleLower.Carrier} _ _ _
    (Step.horizontalOnInjection i (MiddleTerm.tensor (Current.section.apply b) y))
    (trans!{MiddleLower.Carrier} _ _ _
      (congr!{HorizontalTerm.Carrier MiddleLower.Carrier} (HorizontalInjection.injection.apply) _ _ (Differential.horizontalOnTensor (Current.section.apply b) y))
      (congr!{{Left.chain.family.Carrier (Bounded.previous p)} MiddleLower.Carrier} (\fun (x: Left.chain.family.Carrier (Bounded.previous p)) => HorizontalInjection.injection.apply (HorizontalTerm.tensor x y)) _ _ (Current.sectionLaw b)));
\import Tensors.Sign[V := VerticalTerm.Carrier, space := VerticalTerm.space] \as Sign;
\import Modules.Hom[V := VerticalTerm.Carrier, W := VerticalTerm.Carrier, source := VerticalTerm.space, target := VerticalTerm.space] \as Signs;
\import Modules.Hom[V := VerticalTerm.Carrier, W := MiddleLower.Carrier, source := VerticalTerm.space, target := MiddleLower.space] \as VerticalMaps;
\definition vertical: \forall (b: Current.boundaryCarrier)(y: RightHomology.Cycle) -> Step.vertical.apply (lift b y) = MiddleLower.space.zero :=
  \fun (b: Current.boundaryCarrier)(y: RightHomology.Cycle) => trans!{MiddleLower.Carrier} _ _ _
    (Step.verticalOnInjection i (MiddleTerm.tensor (Current.section.apply b) y))
    (trans!{MiddleLower.Carrier} _ _ _
      (congr!{VerticalTerm.Carrier MiddleLower.Carrier} (\fun (v: VerticalTerm.Carrier) => VerticalInjection.injection.apply ((Sign.map p).apply v)) _ _ (Differential.verticalOnTensor (Current.section.apply b) y))
      (trans!{MiddleLower.Carrier} _ _ _
        (congr!{VerticalTerm.Carrier MiddleLower.Carrier} (\fun (v: VerticalTerm.Carrier) => VerticalInjection.injection.apply ((Sign.map p).apply v)) _ _
          (trans!{VerticalTerm.Carrier} _ _ _
            (congr!{{Right.chain.family.Carrier (Bounded.previous q)} VerticalTerm.Carrier} (VerticalTerm.tensor (Current.section.apply b)) _ _
              (\bysub(Right.chain.family.Carrier q, RightHomology.cycles.carrier, y)))
            (VerticalTerm.zeroRight (Current.section.apply b))))
        (trans!{MiddleLower.Carrier} _ _ _
          (congr!{VerticalTerm.Carrier MiddleLower.Carrier} (VerticalInjection.injection.apply) _ _ (Signs.zeroPreserved (Sign.map p)))
          (VerticalMaps.zeroPreserved VerticalInjection.injection))));
\import Tensors.Map[C := LeftProduct.complex, D := MiddleProduct.complex].Total[f := Inclusion.map].Term[n := Bounded.previous n] \as InclusionTotal;
\import Inclusion.Term[p := Bounded.previous p, q := q] \as InclusionTerm;
\import LeftProduct.Term[p := Bounded.previous p, q := q] \as LeftTerm;
\definition included: \forall (b: Current.boundaryCarrier)(y: RightHomology.Cycle) ->
  Inclusion.total.apply (Bounded.previous n) (LowerCycle.value (lowerCycle b) y) =
  HorizontalInjection.injection.apply (HorizontalTerm.tensor (Current.boundaryAsCycle b) y) :=
  \fun (b: Current.boundaryCarrier)(y: RightHomology.Cycle) => trans!{MiddleLower.Carrier} _ _ _
    (InclusionTotal.onInjection lowerIndex (LeftTerm.tensor (Current.boundaryAsCycle b) y))
    (congr!{HorizontalTerm.Carrier MiddleLower.Carrier} (HorizontalInjection.injection.apply) _ _
      (InclusionTerm.onTensor (Current.boundaryAsCycle b) y));
\import Modules.Laws[V := MiddleLower.Carrier, space := MiddleLower.space] \as Laws;
\import algebra.Group[].Of[Carrier := MiddleLower.Carrier, group := Laws.additive] \as Group;
\definition differential: \forall (b: Current.boundaryCarrier)(y: RightHomology.Cycle) ->
  Inclusion.total.apply (Bounded.previous n) (LowerCycle.value (lowerCycle b) y) = middle.differential.apply n (lift b y) :=
  \fun (b: Current.boundaryCarrier)(y: RightHomology.Cycle) => trans!{MiddleLower.Carrier} _ _ _ (included b y)
    (sym!{MiddleLower.Carrier} _ _
      (trans!{MiddleLower.Carrier} _ _ _
        (congr2!{MiddleLower.Carrier MiddleLower.Carrier MiddleLower.Carrier} (MiddleLower.space.add) _ _ _ _ (horizontal b y) (vertical b y))
        (Group.zeroRight (HorizontalInjection.injection.apply (HorizontalTerm.tensor (Current.boundaryAsCycle b) y)))));
\definition onClass: \forall (b: Current.boundaryCarrier)(y: RightHomology.Cycle) ->
  Connecting.connecting.apply (SourceCycle.classOf (boundaryCycle b) y) = LowerCycle.classOf (lowerCycle b) y :=
  \fun (b: Current.boundaryCarrier)(y: RightHomology.Cycle) => trans!{{Chains.At[C := left, z := Bounded.previous n].Homology}} _ _ _
    (Connecting.onClass (SourceCycle.cycle (boundaryCycle b) y))
    (Connecting.onLift (SourceCycle.cycle (boundaryCycle b) y) (lift b y) (LowerCycle.value (lowerCycle b) y)
      (lifted b y) (differential b y) (LowerCycle.closed (lowerCycle b) y));
