\import Modules.Of[V := source.Carrier i, space := source.space i].Submodule[] \as Ambient;
\import Ambient.Kernel[W := target.Carrier i, target := target.space i] \as Kernels;
\definition kernel: Ambient.Submodule := Kernels.kernel (maps i);
\import Ambient.Of[S := kernel] \as Native;
\definition Carrier: \Set := Native.Carrier;
\definition space: Modules.Space Carrier := Native.moduleSpace;
\definition inclusion: Modules.Hom[V := Carrier, W := source.Carrier i, source := space, target := source.space i].Map := Native.inclusion;
\definition make(x: source.Carrier i)(closed: #apply{(maps i)} x = #zero{(target.space i)}): Carrier :=
  \into[source.Carrier i](x, #carrier{kernel}) \by { closed };
\definition closed: \forall (x: Carrier) -> #apply{(maps i)} (#apply{inclusion} x) = #zero{(target.space i)} :=
  \fun (x: Carrier) => \bysub(source.Carrier i, #carrier{kernel}, x);
