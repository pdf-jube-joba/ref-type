\import \parent.CoreTerms[C := C, D := D] \as Data;
\import \parent.TensorSequence[C := C, D := D] \as TensorSequence;
\import chain_complexes.Chain[] \as DegreeLaws;
\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\module SequenceAt(n: Degree);
\definition Sequences[n: Degree]: \Set := SequenceAt[n := n].Sequence;
\module Projection(n: Degree);
\structure Result[n: Degree]: \Set := {
  sequence: Sequences n,
  inclusionEq: sequence.inclusion = SequenceAt[n := n].exterior,
  projectionEq: sequence.projection = Projection[n := n].map,
};
\definition results[n: Degree]: \Set := Result[n];
\module Previous(k: Degree);
\module ExactAt(n: Degree);
\module At(n: Degree);

\module Mapping(E, F: Bounded.Complex);
