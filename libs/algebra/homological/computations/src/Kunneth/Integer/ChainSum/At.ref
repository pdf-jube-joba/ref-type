\import Chains.At[C := complex, z := z] \as TotalHomology;
\module Component(i: Index) {
  \import Chains.At[C := terms i, z := z] \as Native;
  \definition Carrier: \Set := Native.Homology;
  \definition space: Modules.Space Carrier := Native.homologySpace;
  \definition Cycle: \Set := Native.Cycle;
  \definition cycleSpace: Modules.Space Cycle := Native.cycleSpace;
  \definition classLinear: Modules.Hom[V := Cycle, W := Carrier, source := cycleSpace, target := space].Map := Native.classLinear;
}
\definition homologyFamily: Modules.Family[Index] := Modules.Family[Index] {
  Carrier := \fun (i: Index) => Component[i := i].Carrier,
  space := \fun (i: Index) => Component[i := i].space,
};
\definition cyclesFamily: Modules.Family[Index] := Modules.Family[Index] {
  Carrier := \fun (i: Index) => Component[i := i].Cycle,
  space := \fun (i: Index) => Component[i := i].cycleSpace,
};
\import Modules.DirectSum[Index := Index, family := homologyFamily] \as HomologySum;
\import Modules.DirectSum[Index := Index, family := cyclesFamily] \as CyclesSum;
\module Cycles;
\module Homology;
