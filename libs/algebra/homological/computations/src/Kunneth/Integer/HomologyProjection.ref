\import Bounded.Of[C := C] \as Original;
\import \parent.CycleBoundary[C := C] \as Decomposition;
\module Term(z: Degree);
\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (z: Degree) => Term[z := z].Carrier,
  space := \fun (z: Degree) => Term[z := z].space,
};
\import Chains.ZeroDifferential[family := family] \as Zero;
\definition complex: Chains.Complex := Zero.complex;
\import Chains.Map[C := Original.chain, D := complex] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (z: Degree) => #apply{Term[z := z].map},
  addition := \fun (z: Degree) => #addition{Term[z := z].map},
  scalar := \fun (z: Degree) => #scalar{Term[z := z].map},
  commutes := \fun (z: Degree) => Term[z := z].commutes,
};
