\import \parent.CycleBoundary[C := C] \as Decomposition;
\import Bounded.Of[C := C] \as Left;
\import Bounded.Of[C := D] \as Right;
\import tensor_chains.TensorChain[].Over[R := Integers.Int^, ring := IntegerRing.commutativeRing] \as Tensors;
\import Tensors.Tensor[C := Decomposition.cyclesComplex, D := Right.chain] \as LeftProduct;
\import Tensors.Tensor[C := Left.chain, D := Right.chain] \as MiddleProduct;
\import Tensors.Tensor[C := Decomposition.boundariesComplex, D := Right.chain] \as RightProduct;
\import Tensors.Total[C := LeftProduct.complex] \as LeftTotal;
\import Tensors.Total[C := MiddleProduct.complex] \as MiddleTotal;
\import Tensors.Total[C := RightProduct.complex] \as RightTotal;
\import Chains.End[C := Right.chain] \as Identity;
\import Tensors.TensorMapping[C := Decomposition.cyclesComplex, D := Left.chain, E := Right.chain, F := Right.chain].With[
  f := Decomposition.inclusion, g := Identity.identity] \as Inclusion;
\import Tensors.TensorMapping[C := Left.chain, D := Decomposition.boundariesComplex, E := Right.chain, F := Right.chain].With[
  f := Decomposition.projection, g := Identity.identity] \as Projection;
\definition left: Chains.Complex := LeftTotal.complex;
\definition middle: Chains.Complex := MiddleTotal.complex;
\definition right: Chains.Complex := RightTotal.complex;
\module At(n: Degree);
\import Chains.ShortExact[A := left, B := middle, C := right] \as Sequences;
\definition data: Sequences.Data := Sequences.Data { inclusion := Inclusion.total, projection := Projection.total };
\definition laws: Sequences.Laws[data] := Sequences.Laws[data] {
  injective := \fun (n: Degree) => At[n := n].injective,
  onto := \fun (n: Degree) => At[n := n].onto,
  zero := \fun (n: Degree) => At[n := n].zero,
  kernelImage := \fun (n: Degree) => At[n := n].kernelImage,
};
\definition sequence: Sequences.Sequence := \into[Sequences.Data](data, { data: Sequences.Data \where Sequences.Laws[data] }) \by { laws };

\module LongExact(k: Degree);

\module Connecting(n: Degree);

\module Mapping(E, F: Bounded.Complex);
\definition inclusionMap: Chains.Map[C := left, D := middle].Map := Inclusion.total;
\definition projectionMap: Chains.Map[C := middle, D := right].Map := Projection.total;
