\import Original.At[n := n] \as Result;
\import \parent.Term[n := n] \as Evaluation;
\import Chains.At[C := Original.tensorComplex, z := n] \as Homology;
\import Zero.At[k := n] \as ZeroHomology;
\import Chains.At[C := Zero.complex, z := n] \as ZeroClasses;
\import Chains.Map[C := Original.tensorComplex, D := Zero.complex].At[k := n] \as Induced;
\import Modules.Hom[V := ZeroClasses.Homology, W := Result.tensorBundle.Carrier,
  source := ZeroClasses.homologySpace, target := Result.tensorBundle.space].Composition[
  U := Homology.Homology, domain := Homology.homologySpace] \as Compose;
\definition retraction: Modules.MapBetween Result.homologyBundle Result.tensorBundle := Compose.compose ZeroHomology.backward (Induced.induced map);
\definition onClass: \forall (x: Homology.Cycle) -> retraction.apply (Homology.classOf x) = Evaluation.map.apply x :=
  \fun (x: Homology.Cycle) => trans!{{Result.tensorBundle.Carrier}} _ _ _
    (congr!{{ZeroClasses.Homology} {Result.tensorBundle.Carrier}} (ZeroHomology.backward.apply) _ _ (Induced.onClass map x))
    (ZeroHomology.leftInverse (Evaluation.map.apply x));
\import Modules.DirectSum[Index := Degree, family := Result.tensorFamily] \as TensorSum;
\module Component(p: Degree);
\import Modules.Hom[V := Result.homologyBundle.Carrier, W := Result.tensorBundle.Carrier,
  source := Result.homologyBundle.space, target := Result.tensorBundle.space].Composition[
  U := Result.tensorBundle.Carrier, domain := Result.tensorBundle.space] \as RetractionCompose;
\import TensorSum.To[W := TensorSum.Carrier, target := TensorSum.space] \as Universal;
\import Modules.End[V := TensorSum.Carrier, space := TensorSum.space] \as Identity;
\definition equality: RetractionCompose.compose retraction Result.exterior = Identity.identity :=
  Universal.ext (RetractionCompose.compose retraction Result.exterior) Identity.identity
    (\fun (p: Degree)(x: Result.Component[p := p].tensorCarrier) => trans!{TensorSum.Carrier} _ _ _
      (congr!{Homology.Homology TensorSum.Carrier} (retraction.apply) _ _ (Result.exteriorOnInjection p x))
      (Component[p := p].point x));
\definition retracts: \forall (x: Result.tensorBundle.Carrier) -> retraction.apply (Result.exterior.apply x) = x :=
  \fun (x: Result.tensorBundle.Carrier) => congr!{{Modules.Hom[V := TensorSum.Carrier, W := TensorSum.Carrier, source := TensorSum.space, target := TensorSum.space].Map} TensorSum.Carrier}
    (\fun (f: Modules.Hom[V := TensorSum.Carrier, W := TensorSum.Carrier, source := TensorSum.space, target := TensorSum.space].Map) => f.apply x) _ _ equality;
