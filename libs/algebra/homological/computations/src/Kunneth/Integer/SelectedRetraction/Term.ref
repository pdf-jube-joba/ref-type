\import Original.At[n := n] \as Result;
\import Total.Term[n := n] \as Source;
\import Modules.DirectSum[Index := Degree, family := Result.tensorFamily] \as TargetSum;
\module Factor(p: Degree);
\module At(i: Grading.Index n);
\import Modules.DirectSum[Index := Grading.Index n, family := Source.family].To[W := TargetSum.Carrier, target := TargetSum.space] \as Universal;
\definition components: Universal.Components := \fun (i: Grading.Index n) => At[i := i].map;
\definition map: Modules.Hom[V := Source.Carrier, W := TargetSum.Carrier, source := Source.space, target := TargetSum.space].Map := Universal.extension components;
\definition onInjection: \forall (i: Grading.Index n)(x: Product.Term[p := i.first, q := i.second].Carrier) ->
  map.apply ((Source.Component[i := i].injection).apply x) = (At[i := i].map).apply x := Universal.onInjection components;
\module Canonical(p: Degree);
