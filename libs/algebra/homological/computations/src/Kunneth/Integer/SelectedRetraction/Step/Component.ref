\use std.Logic[].Equality[].eq_reason_in;
\definition p: Degree := i.first;
\definition q: Degree := i.second;
\import Product.Term[p := p, q := q] \as Tensor;
\import Product.Term[p := Bounded.previous p, q := q] \as HTensor;
\import Product.Term[p := p, q := Bounded.previous q] \as VTensor;
\import Projected.Term[p := Bounded.previous p, q := q] \as HProjected;
\import Projected.Term[p := p, q := Bounded.previous q] \as VProjected;
\import Product.At[p := p, q := q] \as ProductDifferential;
\import Lower.At[i := Total.upHorizontal n i] \as HProjection;
\import Lower.At[i := Total.upVertical n i] \as VProjection;
\definition horizontalBoundary: \forall (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) ->
  HProjection.map.apply (HTensor.tensor (Left.chain.differential.apply p x) y) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) => eq_reason_in!{{family.Carrier (Bounded.previous n)} _
    "=" _ "by" { HProjection.onTensor (Left.chain.differential.apply p x) y }
    "=" _ "by" { congr!{HProjected.Carrier {family.Carrier (Bounded.previous n)}} (HProjection.tail.apply) _ _
        (trans!{HProjected.Carrier} _ _ _
          (congr!{{LeftProjection.Term[z := Bounded.previous p].Carrier} HProjected.Carrier}
            (\fun (a: LeftProjection.Term[z := Bounded.previous p].Carrier) => HProjected.tensor a (RightProjection.map.apply q y)) _ _
            (LeftProjection.Term[z := p].killsBoundary x))
          (HProjected.zeroLeft (RightProjection.map.apply q y))) }
    "=" _ "by" HProjection.tailZero
  };
\definition verticalBoundary: \forall (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) ->
  VProjection.map.apply (VTensor.tensor x (Right.chain.differential.apply q y)) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) => eq_reason_in!{{family.Carrier (Bounded.previous n)} _
    "=" _ "by" { VProjection.onTensor x (Right.chain.differential.apply q y) }
    "=" _ "by" { congr!{VProjected.Carrier {family.Carrier (Bounded.previous n)}} (VProjection.tail.apply) _ _
        (trans!{VProjected.Carrier} _ _ _
          (congr!{{RightProjection.Term[z := Bounded.previous q].Carrier} VProjected.Carrier}
            (VProjected.tensor (LeftProjection.map.apply p x)) _ _ (RightProjection.Term[z := q].killsBoundary y))
          (VProjected.zeroRight (LeftProjection.map.apply p x))) }
    "=" _ "by" VProjection.tailZero
  };
\definition horizontal: \forall (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) ->
  Lower.map.apply (Differential.horizontal.apply ((Source.Component[i := i].injection).apply (Tensor.tensor x y))) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) => eq_reason_in!{{family.Carrier (Bounded.previous n)} _
    "=" _ "by" { congr!{Target.Carrier {family.Carrier (Bounded.previous n)}} (Lower.map.apply) _ _ (Differential.horizontalOnInjection i (Tensor.tensor x y)) }
    "=" _ "by" { congr!{HTensor.Carrier {family.Carrier (Bounded.previous n)}}
        (\fun (a: HTensor.Carrier) => Lower.map.apply ((Target.Component[i := Total.upHorizontal n i].injection).apply a)) _ _
        (ProductDifferential.horizontalOnTensor x y) }
    "=" _ "by" { Lower.onInjection (Total.upHorizontal n i) (HTensor.tensor (Left.chain.differential.apply p x) y) }
    "=" _ "by" { horizontalBoundary x y }
  };
\import Tensors.Sign[V := VTensor.Carrier, space := VTensor.space] \as Sign;
\import Sign.Mapping[W := family.Carrier (Bounded.previous n), target := family.space (Bounded.previous n)] \as NaturalSign;
\import Tensors.Sign[V := family.Carrier (Bounded.previous n), space := family.space (Bounded.previous n)] \as TargetSign;
\import Modules.Hom[V := family.Carrier (Bounded.previous n), W := family.Carrier (Bounded.previous n), source := family.space (Bounded.previous n), target := family.space (Bounded.previous n)] \as Signs;
\definition vertical: \forall (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) ->
  Lower.map.apply (Differential.vertical.apply ((Source.Component[i := i].injection).apply (Tensor.tensor x y))) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) => eq_reason_in!{{family.Carrier (Bounded.previous n)} _
    "=" _ "by" { congr!{Target.Carrier {family.Carrier (Bounded.previous n)}} (Lower.map.apply) _ _ (Differential.verticalOnInjection i (Tensor.tensor x y)) }
    "=" _ "by" { congr!{VTensor.Carrier {family.Carrier (Bounded.previous n)}}
        (\fun (a: VTensor.Carrier) => Lower.map.apply ((Target.Component[i := Total.upVertical n i].injection).apply ((Sign.map p).apply a))) _ _
        (ProductDifferential.verticalOnTensor x y) }
    "=" _ "by" { Lower.onInjection (Total.upVertical n i) ((Sign.map p).apply (VTensor.tensor x (Right.chain.differential.apply q y))) }
    "=" _ "by" { NaturalSign.naturality VProjection.map p (VTensor.tensor x (Right.chain.differential.apply q y)) }
    "=" _ "by" { congr!{{family.Carrier (Bounded.previous n)} {family.Carrier (Bounded.previous n)}} ((TargetSign.map p).apply) _ _ (verticalBoundary x y) }
    "=" _ "by" { Signs.zeroPreserved (TargetSign.map p) }
  };
\import Modules.Laws[V := family.Carrier (Bounded.previous n), space := family.space (Bounded.previous n)] \as Vectors;
\import algebra.Group[].Of[Carrier := family.Carrier (Bounded.previous n), group := Vectors.additive] \as Group;
\definition onTensor: \forall (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) ->
  composite.apply ((Source.Component[i := i].injection).apply (Tensor.tensor x y)) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Left.chain.family.Carrier p)(y: Right.chain.family.Carrier q) => eq_reason_in!{{family.Carrier (Bounded.previous n)} _
    "=" _ "by" { Lower.map.addition (Differential.horizontal.apply ((Source.Component[i := i].injection).apply (Tensor.tensor x y)))
      (Differential.vertical.apply ((Source.Component[i := i].injection).apply (Tensor.tensor x y))) }
    "=" _ "by" { congr!{{family.Carrier (Bounded.previous n)} {family.Carrier (Bounded.previous n)} {family.Carrier (Bounded.previous n)}}
        ((family.space (Bounded.previous n)).add) _ _ _ _ (horizontal x y) (vertical x y) }
    "=" _ "by" { Group.zeroLeft (family.space (Bounded.previous n)).zero }
  };
\import Modules.Hom[V := Source.Carrier, W := family.Carrier (Bounded.previous n), source := Source.space, target := family.space (Bounded.previous n)].Composition[
  U := Tensor.Carrier, domain := Tensor.space] \as Compose;
\definition component: Modules.Hom[V := Tensor.Carrier, W := family.Carrier (Bounded.previous n), source := Tensor.space, target := family.space (Bounded.previous n)].Map :=
  Compose.compose composite Source.Component[i := i].injection;
\import Modules.Hom[V := Tensor.Carrier, W := family.Carrier (Bounded.previous n), source := Tensor.space, target := family.space (Bounded.previous n)] \as Maps;
\import Modules.Tensor[V := Left.chain.family.Carrier p, W := Right.chain.family.Carrier q, left := Left.chain.family.space p, right := Right.chain.family.space q].Universal[
  U := family.Carrier (Bounded.previous n), target := family.space (Bounded.previous n)] \as Universal;
\definition equality: component = Maps.zeroMap := Universal.ext component Maps.zeroMap onTensor;
\definition point: \forall (x: Tensor.Carrier) -> composite.apply ((Source.Component[i := i].injection).apply x) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Tensor.Carrier) => congr!{Maps.Map {family.Carrier (Bounded.previous n)}} (\fun (f: Maps.Map) => f.apply x) _ _ equality;
