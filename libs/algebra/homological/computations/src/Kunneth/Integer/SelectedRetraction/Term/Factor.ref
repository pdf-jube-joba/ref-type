\import Result.Component[p := p] \as Target;
\definition Maps(q: Degree): \Set := Modules.Hom[V := Projected.Term[p := p, q := q].Carrier, W := Target.tensorCarrier,
  source := Projected.Term[p := p, q := q].space, target := Target.tensorSpace].Map;
\definition identity: Maps (complement n p) := Modules.End[V := Target.tensorCarrier, space := Target.tensorSpace].identity;
\definition reindex(q: Degree)(same: complement n p = q): Maps q :=
  Transport.cast Maps (complement n p) q same identity;
\definition canonical: \forall (same: complement n p = complement n p)(x: Target.tensorCarrier) -> (reindex (complement n p) same).apply x = x :=
  \fun (same: complement n p = complement n p)(x: Target.tensorCarrier) =>
    congr!{{Maps (complement n p)} Target.tensorCarrier} (\fun (f: Maps (complement n p)) => f.apply x) _ _
      (Transport.castRefl Maps (complement n p) identity);
