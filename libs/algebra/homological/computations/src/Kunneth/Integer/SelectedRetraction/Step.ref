\import \parent.Term[n := Bounded.previous n] \as Lower;
\import Total.Term[n := n] \as Source;
\import Total.Term[n := Bounded.previous n] \as Target;
\import Total.Step[n := n] \as Differential;
\import Modules.Hom[V := Target.Carrier, W := family.Carrier (Bounded.previous n), source := Target.space, target := family.space (Bounded.previous n)].Composition[
  U := Source.Carrier, domain := Source.space] \as Compose;
\import Modules.Hom[V := Source.Carrier, W := family.Carrier (Bounded.previous n), source := Source.space, target := family.space (Bounded.previous n)] \as Maps;
\definition composite: Maps.Map := Compose.compose Lower.map Differential.differential;
\module Component(i: Grading.Index n);
\import Modules.DirectSum[Index := Grading.Index n, family := Source.family].To[W := family.Carrier (Bounded.previous n), target := family.space (Bounded.previous n)] \as Universal;
\definition equality: composite = Maps.zeroMap := Universal.ext composite Maps.zeroMap (\fun (i: Grading.Index n) => Component[i := i].point);
\definition killed: \forall (x: Source.Carrier) -> Lower.map.apply (Total.differential.apply n x) = (family.space (Bounded.previous n)).zero :=
  \fun (x: Source.Carrier) => congr!{Maps.Map {family.Carrier (Bounded.previous n)}} (\fun (f: Maps.Map) => f.apply x) _ _ equality;
