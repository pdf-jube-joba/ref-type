\definition n: Degree := Bounded.previous k;
\import Data.At[n := n] \as Terms;
\import TensorSequence.LongExact[k := k] \as Native;
\import \parent.\parent.ConnectingModel[C := C, D := D, k := k].Transport[] \as Left;
\import Modules.Isomorphism[V := Left.nativeCokernelBundle.Carrier, W := Terms.tensorBundle.Carrier,
  source := Left.nativeCokernelBundle.space, target := Terms.tensorBundle.space].Inverse[] \as LeftInverse;
\import \parent.\parent.TorDiagonal[C := C, D := D, n := n].Endpoint[] \as Right;
\import \parent.\parent.EndsTransport[A := Native.leftBundle, B := Native.homologyBundle, C := Native.rightBundle,
  L := Terms.tensorBundle, R := Terms.torBundle, s := Native.shortExact,
  leftIso := LeftInverse.inverse Left.tensorIsomorphism, rightIso := Right.isomorphism] \as Ends;
\definition sequence: Sequences n := Ends.sequence;

\module Inclusion;

\definition result: Result[n] := Result[n] { sequence := sequence, inclusionEq := Inclusion[].equality, projectionEq := \refl(sequence.projection) };
