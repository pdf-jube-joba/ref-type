\import Data.At[n := n] \as Terms;
\import \parent.\parent.KernelModel[C := C, D := D, n := n] \as Native;
\import \parent.\parent.TorDiagonal[C := C, D := D, n := n].Endpoint[] \as Endpoint;
\definition nativeKernelBundle: Modules.Bundle := Native.nativeKernelBundle;
\definition nativeMap: Modules.MapBetween Native.homologyBundle nativeKernelBundle := Native.nativeMap;
\import Modules.Hom[V := nativeKernelBundle.Carrier, W := Terms.torBundle.Carrier,
  source := nativeKernelBundle.space, target := Terms.torBundle.space].Composition[
  U := Terms.homologyBundle.Carrier, domain := Terms.homologyBundle.space] \as Composition;
\definition map: Modules.MapBetween Terms.homologyBundle Terms.torBundle := Composition.compose #forward{Endpoint.isomorphism} nativeMap;
