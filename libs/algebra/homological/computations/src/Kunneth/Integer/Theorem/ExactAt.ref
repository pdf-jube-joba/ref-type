\import Data.At[n := n] \as Terms;
\definition result: Result[n] := Transport.cast results (Bounded.previous (Bounded.next n)) n (DegreeLaws.previousNext n)
  \parent.Previous[k := Bounded.next n].result;
\definition sequence: Sequences n := result.sequence;
\definition inclusionEq: sequence.inclusion = Terms.exterior := result.inclusionEq;
\definition projectionEq: sequence.projection = \parent.Projection[n := n].map := result.projectionEq;
