\import \parent.\parent.\parent.SelectedRetraction[C := C, D := D].At[n := n] \as Retraction;
\import Modules.ShortExact[A := Terms.tensorBundle, B := Terms.homologyBundle, C := Terms.torBundle].Splitting[sequence := sequence] \as Split;
\import Split.FromRetraction[r := Retraction.retraction] \as Selected;
\definition retracts: Selected.Retracts := \fun (x: Terms.tensorBundle.Carrier) =>
  trans!{{Terms.tensorBundle.Carrier}} _ _ _
    (congr!{{Modules.MapBetween Terms.tensorBundle Terms.homologyBundle} {Terms.tensorBundle.Carrier}}
      (\fun (f: Modules.MapBetween Terms.tensorBundle Terms.homologyBundle) => Retraction.retraction.apply (f.apply x)) _ _ inclusionEq)
    (Retraction.retracts x);
\definition section: Modules.MapBetween Terms.torBundle Terms.homologyBundle := Selected.section retracts;
\definition rightInverse: \forall (x: Terms.torBundle.Carrier) -> sequence.projection.apply (section.apply x) = x := Selected.rightInverse retracts;
\import Modules.Biproduct[V := Terms.tensorBundle.Carrier, W := Terms.torBundle.Carrier, left := Terms.tensorBundle.space, right := Terms.torBundle.space] \as Sum;
\definition isomorphism: Modules.Isomorphism[V := Sum.Carrier, W := Terms.homologyBundle.Carrier, source := Sum.space, target := Terms.homologyBundle.space].Isomorphism := Selected.isomorphism retracts;
