\import Data.At[n := n] \as Terms;
\import \parent.ExactAt[n := n] \as Exact;
\definition result: Result[n] := Exact.result;
\definition sequence: Sequences n := Exact.sequence;
\definition inclusionEq: sequence.inclusion = Terms.exterior := Exact.inclusionEq;
\definition projectionEq: sequence.projection = \parent.Projection[n := n].map := Exact.projectionEq;
\module Selected;
\import Selected[] \as SelectedProof;
\import Modules.Biproduct[V := Terms.tensorBundle.Carrier, W := Terms.torBundle.Carrier, left := Terms.tensorBundle.space, right := Terms.torBundle.space] \as DirectSum;
\definition selectedSplitting: Modules.Isomorphism[V := DirectSum.Carrier, W := Terms.homologyBundle.Carrier, source := DirectSum.space, target := Terms.homologyBundle.space].Isomorphism := SelectedProof.isomorphism;
\import \parent.\parent.Of[C := C, D := D].At[n := n] \as SmithTerms;
\module Smith;
\import Smith[] \as SmithProof;
\import Modules.Biproduct[V := SmithTerms.smithBundle.Carrier, W := Terms.torBundle.Carrier, left := SmithTerms.smithBundle.space, right := Terms.torBundle.space] \as SmithSum;
\definition smithSplitting: Modules.Isomorphism[V := SmithSum.Carrier, W := Terms.homologyBundle.Carrier, source := SmithSum.space, target := Terms.homologyBundle.space].Isomorphism := SmithProof.isomorphism;
