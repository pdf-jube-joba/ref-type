\import TensorSequence.Mapping[E := E, F := F].With[f := f, g := g] \as ChainMaps;
\import Chains.ShortExact[A := TensorSequence.left, B := TensorSequence.middle, C := TensorSequence.right] \as SourceSequences;
\import SourceSequences.Morphism[A1 := TargetSequence.left, B1 := TargetSequence.middle, C1 := TargetSequence.right].Diagram[
  s := TensorSequence.sequence, t := TargetSequence.sequence, a := ChainMaps.left, b := ChainMaps.middle, c := ChainMaps.right] \as ChainDiagram;
\definition commutes: ChainDiagram.Commutative := ChainMaps.diagram;
\module Native(n: Degree);
\module At(n: Degree);
