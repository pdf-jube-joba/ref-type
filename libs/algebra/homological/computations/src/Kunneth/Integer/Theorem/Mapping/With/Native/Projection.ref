\definition square: \forall (x: SM.Homology) ->
  #apply{TargetProjection.nativeMap} (#apply{middleMap} x) = #apply{kernelMap} (#apply{SourceProjection.nativeMap} x) :=
  \fun (x: SM.Homology) => \block {
    \let l: TargetProjection.nativeKernelBundle.Carrier := #apply{TargetProjection.nativeMap} (#apply{middleMap} x) \then
    \let r: TargetProjection.nativeKernelBundle.Carrier := #apply{kernelMap} (#apply{SourceProjection.nativeMap} x) \then
    \let equal: l = r := Connecting.projectionNaturality commutes x \then
    \return equal
  };
