\definition square: \forall (x: SM.Homology) ->
  TargetProjection.nativeMap.apply (middleMap.apply x) = kernelMap.apply (SourceProjection.nativeMap.apply x) :=
  \fun (x: SM.Homology) => \block {
    \let l: TargetProjection.nativeKernelBundle.Carrier := TargetProjection.nativeMap.apply (middleMap.apply x) \then
    \let r: TargetProjection.nativeKernelBundle.Carrier := kernelMap.apply (SourceProjection.nativeMap.apply x) \then
    \let equal: l = r := Connecting.projectionNaturality commutes x \then
    \return equal
  };
