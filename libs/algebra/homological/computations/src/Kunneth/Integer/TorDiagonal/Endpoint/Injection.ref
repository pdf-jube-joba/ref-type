\import Construction.Injection[p := p] \as ModelInjection;
\import Connecting.Point[p := p] \as ReindexPoint;
\import Modules.DirectSum[Index := Degree, family := Terms.torFamily] \as TorSum;
\import \parent.\parent.\parent.CycleBoundary[C := C] \as Decomposition;
\import \parent.\parent.\parent.ZeroTensor[Z := Decomposition.boundariesFamily, D := D].At[n := n] \as Boundaries;
\import Modules.DirectSum[Index := Degree, family := Boundaries.inputFamily] \as BoundarySum;
\import \parent.\parent.\parent.HomologyDiagonal[C := C, D := D, n := Bounded.previous n] \as Model;
\import Modules.DirectSum[Index := Degree, family := Model.source] \as ModelSource;
\import \parent.\parent.\parent.TensorSequence[C := C, D := D] \as Sequence;
\import Chains.At[C := Sequence.right, z := n] \as H;
\definition onValue: \forall (h: Terms.Component[p := p].torCarrier) ->
  #apply{#forward{forwardIsomorphism}} (#apply{TorSum.Injection[i := p].map} h) =
    #apply{#forward{Connecting.rightIsomorphism}}
      (#apply{BoundarySum.Injection[i := p].map} (#apply{#forward{Terms.Component[p := p].torKernelIsomorphism}} h)) :=
  \fun (h: Terms.Component[p := p].torCarrier) => trans!{H.Homology} _ _ _
    (congr!{ModelSource.Carrier H.Homology} (#apply{#forward{Bridge.domainIsomorphism}}) _ _ (ModelInjection.onValue h))
    (trans!{H.Homology} _ _ _
      (congr!{ModelSource.Carrier H.Homology} (#apply{#forward{Bridge.domainIsomorphism}}) _ _
        (sym!{ModelSource.Carrier} _ _
          (ReindexPoint.reindexOnValue (#apply{#forward{Terms.Component[p := p].torKernelIsomorphism}} h))))
      (congr!{BoundarySum.Carrier H.Homology} (#apply{#forward{Connecting.rightIsomorphism}}) _ _
        (#leftInverse{Connecting.sourceReindex}
          (#apply{BoundarySum.Injection[i := p].map} (#apply{#forward{Terms.Component[p := p].torKernelIsomorphism}} h)))));
