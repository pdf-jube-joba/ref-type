\import \parent.\parent.HomologyDiagonal[C := C, D := D, n := Bounded.previous n] \as Model;
\import \parent.\parent.DiagonalKernel[Index := Degree, source := Model.source, target := Model.target, maps := Model.maps] \as Kernel;
\import \parent.\parent.ShiftSum[family := Kernel.family] \as Shift;
\definition components: \forall (p: Degree) -> Modules.Isomorphism[V := Terms.torFamily.Carrier p,
  W := Shift.shifted.Carrier p, source := Terms.torFamily.space p, target := Shift.shifted.space p].Isomorphism :=
  \fun (p: Degree) => \parent.Component[p := p].isomorphism;
\import \parent.\parent.SumIsomorphism[Index := Degree, source := Terms.torFamily, target := Shift.shifted, isos := components] \as Pointwise;
\import Modules.DirectSum[Index := Degree, family := Shift.shifted] \as Intermediate;
\import Modules.DirectSum[Index := Degree, family := Kernel.family] \as KernelSum;
\import Modules.Isomorphism[V := Terms.torBundle.Carrier, W := Intermediate.Carrier,
  source := Terms.torBundle.space, target := Intermediate.space].Composition[
  U := KernelSum.Carrier, final := KernelSum.space] \as ShiftComposition;
\definition shifted: Modules.Isomorphism[V := Terms.torBundle.Carrier, W := KernelSum.Carrier,
  source := Terms.torBundle.space, target := KernelSum.space].Isomorphism := ShiftComposition.compose Shift.isomorphism Pointwise.isomorphism;
\import Modules.Isomorphism[V := Terms.torBundle.Carrier, W := KernelSum.Carrier,
  source := Terms.torBundle.space, target := KernelSum.space].Composition[
  U := Kernel.bundle.Carrier, final := Kernel.bundle.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Terms.torBundle.Carrier, W := Kernel.bundle.Carrier,
  source := Terms.torBundle.space, target := Kernel.bundle.space].Isomorphism := Composition.compose Kernel.isomorphism shifted;
\definition diagonalIsomorphism: Modules.Isomorphism[V := Terms.torBundle.Carrier, W := Kernel.bundle.Carrier,
  source := Terms.torBundle.space, target := Kernel.bundle.space].Isomorphism := isomorphism;
\definition kernelBundle: Modules.Bundle := Kernel.bundle;
\module Injection(p: Degree);
