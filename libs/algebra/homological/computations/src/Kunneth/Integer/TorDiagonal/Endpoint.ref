\import \parent.Construction[] \as Construction;
\import \parent.\parent.ConnectingModel[C := C, D := D, k := n] \as Connecting;
\import Connecting.Transport[] \as Bridge;
\import Modules.Isomorphism[V := Terms.torBundle.Carrier, W := Construction.kernelBundle.Carrier,
  source := Terms.torBundle.space, target := Construction.kernelBundle.space].Composition[
  U := Bridge.nativeKernelBundle.Carrier, final := Bridge.nativeKernelBundle.space] \as Forward;
\definition forwardIsomorphism: Modules.Isomorphism[V := Terms.torBundle.Carrier, W := Bridge.nativeKernelBundle.Carrier,
  source := Terms.torBundle.space, target := Bridge.nativeKernelBundle.space].Isomorphism :=
  Forward.compose Bridge.kernelIsomorphism Construction.diagonalIsomorphism;
\import Modules.Isomorphism[V := Terms.torBundle.Carrier, W := Bridge.nativeKernelBundle.Carrier,
  source := Terms.torBundle.space, target := Bridge.nativeKernelBundle.space].Inverse[] \as Reverse;
\definition isomorphism: Modules.Isomorphism[V := Bridge.nativeKernelBundle.Carrier, W := Terms.torBundle.Carrier,
  source := Bridge.nativeKernelBundle.space, target := Terms.torBundle.space].Isomorphism := Reverse.inverse forwardIsomorphism;
\module Injection(p: Degree);
