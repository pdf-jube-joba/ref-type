\import Bounded.Mapping[C := C, D := E] \as LeftMaps;
\import Bounded.Mapping[C := D, D := F] \as RightMaps;
\import \parent.\parent.TorTerms[C := E, D := F, n := n] \as TargetTerms;
\import \parent.\parent.TorTerms[C := C, D := D, n := n].Mapping[E := E, F := F] \as Maps;
\import \parent.\parent.TensorSequence[C := C, D := D] \as SourceSequence;
\import \parent.\parent.TensorSequence[C := E, D := F] \as TargetSequence;
\import \parent.\parent.KernelModel[C := C, D := D, n := n] \as SourceBridge;
\import \parent.\parent.KernelModel[C := E, D := F, n := n] \as TargetBridge;
\import Modules.DirectSum[Index := Degree, family := Terms.torFamily] \as SourceTorSum;
\import Modules.DirectSum[Index := Degree, family := TargetTerms.torFamily] \as TargetTorSum;
\import Chains.At[C := SourceSequence.right, z := n] \as SourceRight;
\import Chains.At[C := TargetSequence.right, z := n] \as TargetRight;
\import Chains.At[C := SourceSequence.left, z := Bounded.previous n] \as SourceLeft;
\import Chains.At[C := TargetSequence.left, z := Bounded.previous n] \as TargetLeft;
\import Chains.ShortExact[A := SourceSequence.left, B := SourceSequence.middle, C := SourceSequence.right].At[s := SourceSequence.sequence, k := n] \as SourceDelta;
\import Chains.ShortExact[A := TargetSequence.left, B := TargetSequence.middle, C := TargetSequence.right].At[s := TargetSequence.sequence, k := n] \as TargetDelta;
\module With(f: LeftMaps.Map, g: RightMaps.Map);
