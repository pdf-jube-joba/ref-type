\use std.Logic[].Equality[].eq_reason_in;
\import Modules.DirectSum[Index := Degree, family := Terms.torFamily] \as Source;
\import Modules.DirectSum[Index := Degree, family := Model.source] \as ModelSource;
\import Modules.DirectSumMapping[Index := Degree, sourceFamily := Kernel.family, targetFamily := Model.source].On[f := Kernel.inclusions] \as Inclusions;
\import \parent.\parent.Component[p := p] \as Point;
\definition onValue: \forall (h: Terms.Component[p := p].torCarrier) ->
  diagonalIsomorphism.forward.apply ((Source.Injection[i := p].map).apply h) =
    (ModelSource.Injection[i := Bounded.previous p].map).apply
      (Point.sourceIsomorphism.forward.apply (((Terms.Component[p := p].torKernelIsomorphism).forward).apply h)) :=
  \fun (h: Terms.Component[p := p].torCarrier) => eq_reason_in!{ModelSource.Carrier _
    "=" _ "by" { congr!{Intermediate.Carrier ModelSource.Carrier}
      (\fun (x: Intermediate.Carrier) => Inclusions.map.apply (Shift.isomorphism.forward.apply x)) _ _
      (Pointwise.smithOnInjection p h) }
    "=" _ "by" { congr!{KernelSum.Carrier ModelSource.Carrier} (Inclusions.map.apply) _ _
        (Shift.onInjection p (Point.isomorphism.forward.apply h)) }
    "=" _ "by" { Inclusions.onInjection (Bounded.previous p) (Point.isomorphism.forward.apply h) }
  };
