\import Modules.DirectSum[Index := Degree, family := Terms.torFamily] \as Source;
\import Modules.DirectSum[Index := Degree, family := Model.source] \as ModelSource;
\import Modules.DirectSumMapping[Index := Degree, sourceFamily := Kernel.family, targetFamily := Model.source].On[f := Kernel.inclusions] \as Inclusions;
\import \parent.\parent.Component[p := p] \as Point;
\definition onValue: \forall (h: Terms.Component[p := p].torCarrier) ->
  #apply{#forward{diagonalIsomorphism}} (#apply{Source.Injection[i := p].map} h) =
    #apply{ModelSource.Injection[i := Bounded.previous p].map}
      (#apply{#forward{Point.sourceIsomorphism}} (#apply{#forward{Terms.Component[p := p].torKernelIsomorphism}} h)) :=
  \fun (h: Terms.Component[p := p].torCarrier) => trans!{ModelSource.Carrier} _ _ _
    (congr!{Intermediate.Carrier ModelSource.Carrier}
      (\fun (x: Intermediate.Carrier) => #apply{Inclusions.map} (#apply{#forward{Shift.isomorphism}} x)) _ _
      (Pointwise.smithOnInjection p h))
    (trans!{ModelSource.Carrier} _ _ _
      (congr!{KernelSum.Carrier ModelSource.Carrier} (#apply{Inclusions.map}) _ _
        (Shift.onInjection p (#apply{#forward{Point.isomorphism}} h)))
      (Inclusions.onInjection (Bounded.previous p) (#apply{#forward{Point.isomorphism}} h)));
