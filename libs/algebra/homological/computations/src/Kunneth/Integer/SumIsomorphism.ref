\use std.Logic[].Equality[].eq_reason_in;
\import Modules.DirectSum[Index := Index, family := source] \as Source;
\import Modules.DirectSum[Index := Index, family := target] \as Target;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := source, targetFamily := target] \as ToSmith;
\definition smithComponents: ToSmith.Components := \fun (p: Index) => (isos p).forward;
\import ToSmith.On[f := smithComponents] \as SmithForward;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := target, targetFamily := source] \as FromSmith;
\definition homologyComponents: FromSmith.Components := \fun (p: Index) => (isos p).backward;
\import FromSmith.On[f := homologyComponents] \as SmithBackward;
\import Modules.Hom[V := Target.Carrier, W := Source.Carrier, source := Target.space, target := Source.space].Composition[
  U := Source.Carrier, domain := Source.space] \as LeftComposition;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Composition[
  U := Target.Carrier, domain := Target.space] \as RightComposition;
\import Modules.End[V := Source.Carrier, space := Source.space] \as TensorEnd;
\import Modules.End[V := Target.Carrier, space := Target.space] \as SmithEnd;
\import Source.To[W := Source.Carrier, target := Source.space] \as TensorUniversal;
\import Target.To[W := Target.Carrier, target := Target.space] \as SmithUniversal;
\definition smithLeft: LeftComposition.compose SmithBackward.map SmithForward.map = TensorEnd.identity :=
  TensorUniversal.ext _ _ (\fun (p: Index)(x: source.Carrier p) =>
    eq_reason_in!{Source.Carrier _
      "=" _ "by" { congr!{Target.Carrier Source.Carrier} (SmithBackward.map.apply) _ _ (SmithForward.onInjection p x) }
      "=" _ "by" { SmithBackward.onInjection p (((isos p).forward).apply x) }
      "=" _ "by" { congr!{{source.Carrier p} Source.Carrier} ((Source.Injection[i := p].map).apply) _ _
          ((isos p).leftInverse x) }
    });
\definition smithRight: RightComposition.compose SmithForward.map SmithBackward.map = SmithEnd.identity :=
  SmithUniversal.ext _ _ (\fun (p: Index)(x: target.Carrier p) =>
    eq_reason_in!{Target.Carrier _
      "=" _ "by" { congr!{Source.Carrier Target.Carrier} (SmithForward.map.apply) _ _ (SmithBackward.onInjection p x) }
      "=" _ "by" { SmithForward.onInjection p (((isos p).backward).apply x) }
      "=" _ "by" { congr!{{target.Carrier p} Target.Carrier} ((Target.Injection[i := p].map).apply) _ _
          ((isos p).rightInverse x) }
    });
\import Modules.Hom[V := Source.Carrier, W := Source.Carrier, source := Source.space, target := Source.space] \as TensorEndMaps;
\import Modules.Hom[V := Target.Carrier, W := Target.Carrier, source := Target.space, target := Target.space] \as SmithEndMaps;
\definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier,
  source := Source.space, target := Target.space].Isomorphism :=
  Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism {
    forward := SmithForward.map, backward := SmithBackward.map,
    leftInverse := \fun (x: Source.Carrier) => congr!{TensorEndMaps.Map Source.Carrier} (\fun (f: TensorEndMaps.Map) => f.apply x) _ _ smithLeft,
    rightInverse := \fun (x: Target.Carrier) => congr!{SmithEndMaps.Map Target.Carrier} (\fun (f: SmithEndMaps.Map) => f.apply x) _ _ smithRight,
  };
\definition smithOnInjection: \forall (p: Index)(x: source.Carrier p) ->
  isomorphism.forward.apply ((Source.Injection[i := p].map).apply x) =
  (Target.Injection[i := p].map).apply (((isos p).forward).apply x) := SmithForward.onInjection;
\definition onInjection: \forall (p: Index)(x: source.Carrier p) ->
  isomorphism.forward.apply ((Source.Injection[i := p].map).apply x) =
  (Target.Injection[i := p].map).apply (((isos p).forward).apply x) := SmithForward.onInjection;
