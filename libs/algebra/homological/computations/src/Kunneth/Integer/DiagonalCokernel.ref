\import Modules.DirectSum[Index := Index, family := source] \as Source;
\import Modules.DirectSum[Index := Index, family := target] \as Target;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := source, targetFamily := target].On[f := maps] \as Action;
\import Modules.Of[V := Target.Carrier, space := Target.space].Submodule[] \as Ambient;
\import Ambient.Image[U := Source.Carrier, source := Source.space] \as Images;
\definition image: Ambient.Submodule := Images.image Action.map;
\import Ambient.Quotient[S := image] \as Quotient;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Quotient.Carrier, space := Quotient.moduleSpace };
\module Component(i: Index);
\definition family: Modules.Family[Index] := Modules.Family[Index] {
  Carrier := \fun (i: Index) => Component[i := i].Carrier,
  space := \fun (i: Index) => Component[i := i].space,
};
\import Modules.DirectSum[Index := Index, family := family] \as Sum;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := target, targetFamily := family] \as Classes;
\definition classes: Classes.Components := \fun (i: Index) => Component[i := i].classLinear;
\import Classes.On[f := classes] \as ClassMap;
\import Modules.Hom[V := Target.Carrier, W := Sum.Carrier, source := Target.space, target := Sum.space].Composition[
  U := Source.Carrier, domain := Source.space] \as Compose;
\import Modules.Hom[V := Source.Carrier, W := Sum.Carrier, source := Source.space, target := Sum.space] \as ZeroMaps;
\import Source.To[W := Sum.Carrier, target := Sum.space] \as SourceUniversal;
\module Zero(i: Index) {
  \import Modules.Hom[V := \parent.Component[i := i].Carrier, W := Sum.Carrier,
    source := \parent.Component[i := i].space, target := Sum.space] \as Maps;
  \definition preserved: (Sum.Injection[i := i].map).apply (\parent.Component[i := i].space).zero = Sum.space.zero := Maps.zeroPreserved Sum.Injection[i := i].map;
}
\definition zeroMap: Compose.compose ClassMap.map Action.map = ZeroMaps.zeroMap :=
  SourceUniversal.ext _ _ (\fun (i: Index)(x: source.Carrier i) => trans!{Sum.Carrier} _ _ _
    (congr!{Target.Carrier Sum.Carrier} (ClassMap.map.apply) _ _ (Action.onInjection i x))
    (trans!{Sum.Carrier} _ _ _ (ClassMap.onInjection i ((maps i).apply x))
      (trans!{Sum.Carrier} _ _ _
        (congr!{{Component[i := i].Carrier} Sum.Carrier} ((Sum.Injection[i := i].map).apply) _ _ (Component[i := i].zero x))
        Zero[i := i].preserved)));
\definition compositeZero: \forall (x: Source.Carrier) -> ClassMap.map.apply (Action.map.apply x) = Sum.space.zero :=
  \fun (x: Source.Carrier) => congr!{ZeroMaps.Map Sum.Carrier} (\fun (f: ZeroMaps.Map) => f.apply x) _ _ zeroMap;
\import Quotient.To[W := Sum.Carrier, target := Sum.space] \as Descent;
\definition vanishes: Descent.Vanishes ClassMap.map := \fun (x: Target.Carrier)(member: _) =>
  Images.eliminate Action.map x (ClassMap.map.apply x = Sum.space.zero)
    (\fun (a: Source.Carrier)(equal: Action.map.apply a = x) => trans!{Sum.Carrier} _ _ _
      (congr!{Target.Carrier Sum.Carrier} (ClassMap.map.apply) _ _ (sym!{Target.Carrier} _ _ equal)) (compositeZero a)) member;
\definition forward: Modules.Hom[V := Quotient.Carrier, W := Sum.Carrier, source := Quotient.moduleSpace, target := Sum.space].Map :=
  Descent.descend ClassMap.map vanishes;
\definition onClass: \forall (x: Target.Carrier) -> forward.apply (Quotient.class x) = ClassMap.map.apply x := Descent.onClass ClassMap.map vanishes;
\module BackwardComponent(i: Index);
\import Sum.To[W := Quotient.Carrier, target := Quotient.moduleSpace] \as BackwardUniversal;
\definition backwards: BackwardUniversal.Components := \fun (i: Index) => BackwardComponent[i := i].map;
\definition backward: Modules.Hom[V := Sum.Carrier, W := Quotient.Carrier, source := Sum.space, target := Quotient.moduleSpace].Map :=
  BackwardUniversal.extension backwards;
\import Modules.Hom[V := Sum.Carrier, W := Quotient.Carrier, source := Sum.space, target := Quotient.moduleSpace].Composition[
  U := Target.Carrier, domain := Target.space] \as AfterClasses;
\import Target.To[W := Quotient.Carrier, target := Quotient.moduleSpace] \as TargetUniversal;
\definition backwardOnClasses: AfterClasses.compose backward ClassMap.map = Quotient.projection :=
  TargetUniversal.ext _ _ (\fun (i: Index)(x: target.Carrier i) => trans!{Quotient.Carrier} _ _ _
    (congr!{Sum.Carrier Quotient.Carrier} (backward.apply) _ _ (ClassMap.onInjection i x))
    (trans!{Quotient.Carrier} _ _ _ (BackwardUniversal.onInjection backwards i (Component[i := i].classOf x))
      (BackwardComponent[i := i].onClass x)));
\import Modules.Hom[V := Target.Carrier, W := Quotient.Carrier, source := Target.space, target := Quotient.moduleSpace] \as TargetMaps;
\definition leftInverse: \forall (x: Quotient.Carrier) -> backward.apply (forward.apply x) = x :=
  Quotient.induction (\fun (x: Quotient.Carrier) => backward.apply (forward.apply x) = x)
    (\fun (x: Target.Carrier) => trans!{Quotient.Carrier} _ _ _
      (congr!{Sum.Carrier Quotient.Carrier} (backward.apply) _ _ (onClass x))
      (congr!{TargetMaps.Map Quotient.Carrier} (\fun (f: TargetMaps.Map) => f.apply x) _ _ backwardOnClasses));
\import Modules.Hom[V := Quotient.Carrier, W := Sum.Carrier, source := Quotient.moduleSpace, target := Sum.space].Composition[
  U := Sum.Carrier, domain := Sum.space] \as RightCompose;
\import Modules.End[V := Sum.Carrier, space := Sum.space] \as Identity;
\import Sum.To[W := Sum.Carrier, target := Sum.space] \as RightUniversal;
\definition rightLaw: RightCompose.compose forward backward = Identity.identity := RightUniversal.ext _ _
  (\fun (i: Index) => Component[i := i].induction (\fun (x: Component[i := i].Carrier) =>
    forward.apply (backward.apply ((Sum.Injection[i := i].map).apply x)) = (Sum.Injection[i := i].map).apply x)
    (\fun (x: target.Carrier i) => trans!{Sum.Carrier} _ _ _
      (congr!{Quotient.Carrier Sum.Carrier} (forward.apply) _ _ (BackwardUniversal.onInjection backwards i (Component[i := i].classOf x)))
      (trans!{Sum.Carrier} _ _ _
        (congr!{Quotient.Carrier Sum.Carrier} (forward.apply) _ _ (BackwardComponent[i := i].onClass x))
        (trans!{Sum.Carrier} _ _ _ (onClass ((Target.Injection[i := i].map).apply x)) (ClassMap.onInjection i x)))));
\import Modules.Hom[V := Sum.Carrier, W := Sum.Carrier, source := Sum.space, target := Sum.space] \as SumMaps;
\definition rightInverse: \forall (x: Sum.Carrier) -> forward.apply (backward.apply x) = x :=
  \fun (x: Sum.Carrier) => congr!{SumMaps.Map Sum.Carrier} (\fun (f: SumMaps.Map) => f.apply x) _ _ rightLaw;
\definition isomorphism: Modules.Isomorphism[V := Quotient.Carrier, W := Sum.Carrier, source := Quotient.moduleSpace, target := Sum.space].Isomorphism :=
  Modules.Isomorphism[V := Quotient.Carrier, W := Sum.Carrier, source := Quotient.moduleSpace, target := Sum.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  };
\definition classOf: Target.Carrier -> bundle.Carrier := Quotient.class;
