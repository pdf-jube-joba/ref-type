\import \parent.\parent.Component[p := p] \as SourceComponent;
\import Target.Component[p := p] \as TargetComponent;
\import RightMaps.At[z := complement n p] \as RightAt;
\module On(f: LeftMaps.Map, g: RightMaps.Map);
\definition torMap(f: LeftMaps.Map)(g: RightMaps.Map): Modules.Hom[V := SourceComponent.torCarrier, W := TargetComponent.torCarrier,
  source := SourceComponent.torSpace, target := TargetComponent.torSpace].Map := On[f := f, g := g].map;
\definition torKernelMap(f: LeftMaps.Map)(g: RightMaps.Map): Modules.Hom[V := SourceComponent.torKernelCarrier, W := TargetComponent.torKernelCarrier,
  source := SourceComponent.torKernelSpace, target := TargetComponent.torKernelSpace].Map := On[f := f, g := g].kernelMap;
\definition torOnKernel: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(x: SourceComponent.torCarrier) ->
  #apply{#forward{TargetComponent.torKernelIsomorphism}} (#apply{(torMap f g)} x) =
    #apply{(torKernelMap f g)} (#apply{#forward{SourceComponent.torKernelIsomorphism}} x) :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map) => On[f := f, g := g].onKernel;
