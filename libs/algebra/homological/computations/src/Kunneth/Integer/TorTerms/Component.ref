\import Left.At[z := Bounded.previous p].Presentation[] \as Presentation;
\import Chains.At[C := Right.chain, z := complement n p] \as H;
\definition coefficient: Modules.Bundle := Modules.Bundle { Carrier := H.Homology, space := H.homologySpace };
\import Presentation.Tor[A := coefficient] \as Tor;
\definition torCarrier: \Set := Tor.Carrier;
\definition torSpace: Modules.Space torCarrier := Tor.space;
\definition torKernelCarrier: \Set := Tor.Kernel;
\definition torKernelSpace: Modules.Space torKernelCarrier := Tor.kernelSpace;
\definition torKernelIsomorphism: Modules.Isomorphism[V := torCarrier, W := torKernelCarrier,
  source := torSpace, target := torKernelSpace].Isomorphism := Tor.isomorphism;
