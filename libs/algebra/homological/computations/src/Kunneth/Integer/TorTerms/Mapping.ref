\import \parent.\parent.TorTerms[C := E, D := F, n := n] \as Target;
\import Bounded.Mapping[C := C, D := E] \as LeftMaps;
\import Bounded.Mapping[C := D, D := F] \as RightMaps;
\module Component(p: Degree);
\import Modules.DirectSumMapping[Index := Degree, sourceFamily := torFamily, targetFamily := Target.torFamily] \as SumMaps;
\definition torComponents[f: LeftMaps.Map][g: RightMaps.Map]: SumMaps.Components :=
  \fun (p: Degree) => Component[p := p].torMap f g;
\definition torMap[f: LeftMaps.Map][g: RightMaps.Map]: Modules.MapBetween torBundle Target.torBundle :=
  SumMaps.On[f := torComponents f g].map;
