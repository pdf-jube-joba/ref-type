\use std.Logic[].Equality[].eq_reason_in;
\import Bounded.Mapping[C := C, D := E].At[z := p].With[f := f].TensorUniversalCoefficient[
  A := SourceComponent.coefficient, B := TargetComponent.coefficient].On[u := RightAt.With[f := g].induced] \as Uct;
\import Uct.Derived[] \as Native;
\import Modules.Hom[V := SourceComponent.torCarrier, W := TargetComponent.torCarrier,
  source := SourceComponent.torSpace, target := TargetComponent.torSpace] \as Maps;
\definition map: Maps.Map := Native.functorMap;
\definition agreement: map = Uct.tor := Native.functorAgreement;
\definition kernelMap: Modules.Hom[V := SourceComponent.torKernelCarrier, W := TargetComponent.torKernelCarrier,
  source := SourceComponent.torKernelSpace, target := TargetComponent.torKernelSpace].Map := Native.kernelMap;
\definition onKernel: \forall (x: SourceComponent.torCarrier) ->
  TargetComponent.torKernelIsomorphism.forward.apply (map.apply x) =
    kernelMap.apply (SourceComponent.torKernelIsomorphism.forward.apply x) :=
  \fun (x: SourceComponent.torCarrier) => eq_reason_in!{TargetComponent.torKernelCarrier _
    "=" _ "by" { congr!{Maps.Map TargetComponent.torKernelCarrier}
      (\fun (h: Maps.Map) => TargetComponent.torKernelIsomorphism.forward.apply (h.apply x)) _ _ agreement }
    "=" _ "by" { congr!{SourceComponent.torCarrier TargetComponent.torKernelCarrier}
        (\fun (y: SourceComponent.torCarrier) => TargetComponent.torKernelIsomorphism.forward.apply (Uct.tor.apply y)) _ _
        (sym!{SourceComponent.torCarrier} _ _ (SourceComponent.torKernelIsomorphism.leftInverse x)) }
    "=" _ "by" { Native.kernelNaturality (SourceComponent.torKernelIsomorphism.forward.apply x) }
  };
