\import Chains.ZeroDifferential[family := W] \as TargetZero;
\import Bounded.Of[C := E] \as TargetOriginal;
\import \parent.\parent.ZeroTensor[Z := W, D := E] \as Target;
\definition Components: \Set := \forall (p: Degree) -> Modules.Hom[V := Z.Carrier p, W := W.Carrier p, source := Z.space p, target := W.space p].Map;
\import Chains.Map[C := Original.chain, D := TargetOriginal.chain] \as RightMaps;
\module With(f: Components, g: RightMaps.Map);
