\module DegreeMap(p: Degree) {
  \import Modules.Hom[V := Z.Carrier p, W := W.Carrier p, source := Z.space p, target := W.space p] \as Native;
  \definition zero: (f p).apply (Z.space p).zero = (W.space p).zero := Native.zeroPreserved (f p);
}
\import Chains.Map[C := Zero.complex, D := TargetZero.complex] \as LeftMaps;
\definition left: LeftMaps.Map := LeftMaps.Map {
  apply := \fun (p: Degree) => (f p).apply,
  addition := \fun (p: Degree) => (f p).addition,
  scalar := \fun (p: Degree) => (f p).scalar,
  commutes := \fun (p: Degree)(x: Z.Carrier p) => sym!{{W.Carrier (Bounded.previous p)}} _ _ (DegreeMap[p := Bounded.previous p].zero),
};
\import Tensors.TensorMapping[C := Zero.complex, D := TargetZero.complex, E := Original.chain, F := TargetOriginal.chain].With[f := left, g := g] \as TensorMap;
\import Tensors.Tensor[C := TargetZero.complex, D := TargetOriginal.chain] \as TargetProduct;
\import Tensors.Total[C := TargetProduct.complex] \as TargetTotal;
\import Tensors.Map[C := Product.complex, D := TargetProduct.complex].Total[f := TensorMap.map] \as TotalMapping;
\import Chains.Map[C := Total.complex, D := TargetTotal.complex] \as TotalMaps;
\module At(n: Degree);
