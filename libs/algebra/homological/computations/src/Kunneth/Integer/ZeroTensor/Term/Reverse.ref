\definition p: Degree := i.first;
\definition q: Degree := i.second;
\definition r: Degree := Grading.complement n p;
\definition same: q = r := sym!{Degree} _ _ (Grading.complementUnique n p q (Grading.degree n i));
\import \parent.\parent.Coefficient[p := p] \as Coefficient;
\import resolutions.TensorComplex[].Over[R := Integers.Int^, ring := IntegerRing.commutativeRing].Integer[P := Original.chain, N := Coefficient.bundle] \as Tensor;
\import Chains.FamilyTransport[F := Tensor.family] \as Reindex;
\import Modules.Tensor[V := Original.chain.family.Carrier q, W := Z.Carrier p,
  left := Original.chain.family.space q, right := Z.space p].Symmetry[] \as Swap;
\import Modules.Hom[V := Tensor.Carrier r, W := Source.Carrier, source := Tensor.space r, target := Source.space].Composition[
  U := Tensor.Carrier q, domain := Tensor.space q] \as TransportCompose;
\definition transported: Modules.Hom[V := Tensor.Carrier q, W := Source.Carrier, source := Tensor.space q, target := Source.space].Map :=
  TransportCompose.compose (Source.Component[i := p].injection) (Reindex.forward q r same);
\import Modules.Hom[V := Tensor.Carrier q, W := Source.Carrier, source := Tensor.space q, target := Source.space].Composition[
  U := tensorCarrier p q, domain := tensorSpace p q] \as Compose;
\definition map: Modules.Hom[V := tensorCarrier p q, W := Source.Carrier, source := tensorSpace p q, target := Source.space].Map :=
  Compose.compose transported Swap.backward;
