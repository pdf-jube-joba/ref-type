\definition q: Degree := Grading.complement n p;
\import \parent.\parent.Component[p := p] \as Component;
\import SourceDegree.Component[p := p] \as SourceComponent;
\import TargetDegree.Component[p := p] \as TargetComponent;
\import Chains.At[C := Original.chain, z := q] \as SH;
\import Chains.At[C := TargetOriginal.chain, z := q] \as TH;
\import RightMaps.At[k := q] \as HMap;
\import SourceSelected.Generator[p := p] \as SourceGenerator;
\import TargetSelected.Generator[p := p] \as TargetGenerator;
\import Zero.At[k := p] \as SourceConstant;
\import TargetZero.At[k := p] \as TargetConstant;
\import Tensors.IndexedCycleProduct[C := Zero.complex, D := Original.chain, n := n].At[i := SourceGenerator.index] \as SourceExterior;
\import Tensors.IndexedCycleProduct[C := TargetZero.complex, D := TargetOriginal.chain, n := n].At[i := SourceGenerator.index] \as TargetExterior;
\import TensorMap.Term[p := p, q := q] \as TensorPoint;
\import TotalMapping.Term[n := n] \as TotalPoint;
\import Product.Term[p := p, q := q] \as SourceTerm;
\import TargetProduct.Term[p := p, q := q] \as TargetTerm;
\import TargetTotal.Term[n := n].Component[i := SourceGenerator.index] \as TargetInjection;
\definition exteriorNaturality: \forall (z: Z.Carrier p)(x: SH.Cycle) ->
  #apply{middle} (SourceExterior.classOf (#apply{SourceConstant.cycles} z) x) =
    TargetExterior.classOf (#apply{TargetConstant.cycles} (#apply{(f p)} z)) (#apply{(HMap.cyclesMap g)} x) :=
  \fun (z: Z.Carrier p)(x: SH.Cycle) => trans!{TargetH.Homology} _ _ _
    (HomologyMap.onClass TensorMap.total (SourceExterior.cycle (#apply{SourceConstant.cycles} z) x))
    (TargetExterior.equalClass
      (#apply{(HomologyMap.cyclesMap TensorMap.total)} (SourceExterior.cycle (#apply{SourceConstant.cycles} z) x))
      (TargetExterior.cycle (#apply{TargetConstant.cycles} (#apply{(f p)} z)) (#apply{(HMap.cyclesMap g)} x))
      (trans!{{TargetTotal.complex.family.Carrier n}} _ _ _
        (TotalPoint.onInjection SourceGenerator.index (SourceTerm.tensor z x))
        (congr!{TargetTerm.Carrier {TargetTotal.complex.family.Carrier n}} (#apply{TargetInjection.injection}) _ _ (TensorPoint.onTensor z x))));
\definition leftOnClass: \forall (z: Z.Carrier p)(x: SH.Cycle) ->
  #apply{throughMiddle} (#apply{SourceSum.Injection[i := p].map} (SourceComponent.tensor z (SH.classOf x))) =
    TargetExterior.classOf (#apply{TargetConstant.cycles} (#apply{(f p)} z)) (#apply{(HMap.cyclesMap g)} x) :=
  \fun (z: Z.Carrier p)(x: SH.Cycle) => trans!{TargetH.Homology} _ _ _
    (congr!{SourceH.Homology TargetH.Homology} (#apply{middle}) _ _ (SourceGenerator.classEquation z x)) (exteriorNaturality z x);
\definition rightOnClass: \forall (z: Z.Carrier p)(x: SH.Cycle) ->
  #apply{throughDiagonal} (#apply{SourceSum.Injection[i := p].map} (SourceComponent.tensor z (SH.classOf x))) =
    TargetExterior.classOf (#apply{TargetConstant.cycles} (#apply{(f p)} z)) (#apply{(HMap.cyclesMap g)} x) :=
  \fun (z: Z.Carrier p)(x: SH.Cycle) => trans!{TargetH.Homology} _ _ _
    (congr!{TargetSum.Carrier TargetH.Homology} (#apply{#forward{TargetSelected.isomorphism}}) _ _ (SumMap.onInjection p (SourceComponent.tensor z (SH.classOf x))))
    (trans!{TargetH.Homology} _ _ _
      (congr!{TargetComponent.Carrier TargetH.Homology}
        (\fun (h: TargetComponent.Carrier) => #apply{#forward{TargetSelected.isomorphism}} (#apply{TargetSum.Injection[i := p].map} h)) _ _ (Component.onTensor z (SH.classOf x)))
      (trans!{TargetH.Homology} _ _ _
        (congr!{TH.Homology TargetH.Homology}
          (\fun (h: TH.Homology) => #apply{#forward{TargetSelected.isomorphism}} (#apply{TargetSum.Injection[i := p].map} (TargetComponent.tensor (#apply{(f p)} z) h))) _ _ (HMap.onClass g x))
        (TargetGenerator.classEquation (#apply{(f p)} z) (#apply{(HMap.cyclesMap g)} x))));
\import Modules.Hom[V := SourceSum.Carrier, W := TargetH.Homology, source := SourceSum.space, target := TargetH.homologySpace].Composition[
  U := SourceComponent.Carrier, domain := SourceComponent.space] \as OnInjection;
\import Modules.Tensor[V := Z.Carrier p, W := SH.Homology, left := Z.space p, right := SH.homologySpace].Universal[
  U := TargetH.Homology, target := TargetH.homologySpace] \as TensorUniversal;
\definition componentSquare: OnInjection.compose throughMiddle SourceSum.Injection[i := p].map = OnInjection.compose throughDiagonal SourceSum.Injection[i := p].map :=
  TensorUniversal.ext (OnInjection.compose throughMiddle SourceSum.Injection[i := p].map) (OnInjection.compose throughDiagonal SourceSum.Injection[i := p].map)
    (\fun (z: Z.Carrier p) => SH.classInduction
      (\fun (h: SH.Homology) => #apply{throughMiddle} (#apply{SourceSum.Injection[i := p].map} (SourceComponent.tensor z h)) =
        #apply{throughDiagonal} (#apply{SourceSum.Injection[i := p].map} (SourceComponent.tensor z h)))
      (\fun (x: SH.Cycle) => trans!{TargetH.Homology} _ _ _ (leftOnClass z x) (sym!{TargetH.Homology} _ _ (rightOnClass z x))));
\definition equality: \forall (x: SourceComponent.Carrier) ->
  #apply{throughMiddle} (#apply{SourceSum.Injection[i := p].map} x) = #apply{throughDiagonal} (#apply{SourceSum.Injection[i := p].map} x) :=
  \fun (x: SourceComponent.Carrier) => congr!{{Modules.Hom[V := SourceComponent.Carrier, W := TargetH.Homology, source := SourceComponent.space, target := TargetH.homologySpace].Map} TargetH.Homology}
    (\fun (h: Modules.Hom[V := SourceComponent.Carrier, W := TargetH.Homology, source := SourceComponent.space, target := TargetH.homologySpace].Map) => #apply{h} x) _ _ componentSquare;
