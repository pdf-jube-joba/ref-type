\use std.Logic[].Equality[].eq_reason_in;
\definition q: Degree := Grading.complement n p;
\definition r: Degree := Grading.complement (Bounded.previous n) p;
\definition e: Bounded.previous q = r := sym!{Degree} _ _ (Grading.previousComplement n p);
\definition closed: Grading.add p (Bounded.previous q) = Bounded.previous n :=
  trans!{Degree} _ _ _ (Grading.previousRight p q) (congr!{Degree Degree} Bounded.previous _ _ (Grading.complementSum n p));
\import \parent.\parent.Coefficient[p := p] \as Coefficient;
\import resolutions.TensorComplex[].Over[R := Integers.Int^, ring := IntegerRing.commutativeRing].Integer[P := Original.chain, N := Coefficient.bundle] \as Tensor;
\import Tensors.Row[E := Tensor.complex, p := p] \as Row;
\import Row.At[n := n] \as RowStep;
\import Current.Injection[p := p] \as I;
\import After.Injection[p := p] \as J;
\definition index: Grading.Index n := I.index q (Grading.complementSum n p);
\import Modules.Tensor[V := Original.chain.family.Carrier q, W := Z.Carrier p,
  left := Original.chain.family.space q, right := Z.space p] \as Pure;
\import Pure.Symmetry[] \as Swap;
\import Product.At[p := p, q := q] \as Differential;
\import Product.Term[p := Bounded.previous p, q := q] \as HT;
\import Product.Term[p := p, q := Bounded.previous q] \as VT;
\import TargetAfter.Component[i := Total.upHorizontal n index] \as HI;
\import TargetAfter.Component[i := Total.upVertical n index] \as VI;
\import Modules.Hom[V := HT.Carrier, W := TargetAfter.Carrier, source := HT.space, target := TargetAfter.space] \as HMaps;
\import Modules.Hom[V := VT.Carrier, W := TargetAfter.Carrier, source := VT.space, target := TargetAfter.space] \as VMaps;
\import Tensors.Sign[V := VT.Carrier, space := VT.space] \as VSign;
\import VSign.Mapping[W := TargetAfter.Carrier, target := TargetAfter.space] \as VSignMapping;
\import Tensors.Sign[V := Tensor.Carrier r, space := Tensor.space r] \as RSign;
\import RSign.Mapping[W := TargetAfter.Carrier, target := TargetAfter.space] \as RSignMapping;
\import Tensors.Sign[V := TargetAfter.Carrier, space := TargetAfter.space] \as TotalSign;
\definition signed: \forall (v: Tensor.Carrier (Bounded.previous q)) ->
  J.map.apply ((RSign.map p).apply (Transport.cast Tensor.Carrier (Bounded.previous q) r e v)) =
    (TotalSign.map p).apply ((J.At[q := Bounded.previous q, closed := closed].map).apply v) :=
  \fun (v: Tensor.Carrier (Bounded.previous q)) => trans!{TargetAfter.Carrier} _ _ _
    (RSignMapping.naturality J.map p (Transport.cast Tensor.Carrier (Bounded.previous q) r e v))
    (congr!{TargetAfter.Carrier TargetAfter.Carrier} ((TotalSign.map p).apply) _ _
      (J.natural (Bounded.previous q) r closed e v));
\definition horizontalPure: \forall (x: Original.chain.family.Carrier q)(z: Z.Carrier p) ->
  TargetStep.horizontal.apply (I.map.apply (Pure.tensor x z)) = TargetAfter.space.zero :=
  \fun (x: Original.chain.family.Carrier q)(z: Z.Carrier p) => eq_reason_in!{TargetAfter.Carrier _
    "=" _ "by" { congr!{Target.Carrier TargetAfter.Carrier} (TargetStep.horizontal.apply) _ _ (I.At[q := q, closed := Grading.complementSum n p].onTensor x z) }
    "=" _ "by" { TargetStep.horizontalOnInjection index (Product.Term[p := p, q := q].tensor z x) }
    "=" _ "by" { congr!{HT.Carrier TargetAfter.Carrier} (HI.injection.apply) _ _
          (trans!{HT.Carrier} _ _ _ (Differential.horizontalOnTensor z x) (HT.zeroLeft x)) }
    "=" _ "by" { HMaps.zeroPreserved HI.injection }
  };
\definition verticalPure: \forall (x: Original.chain.family.Carrier q)(z: Z.Carrier p) ->
  TargetStep.vertical.apply (I.map.apply (Pure.tensor x z)) = J.map.apply (RowStep.differential.apply (Pure.tensor x z)) :=
  \fun (x: Original.chain.family.Carrier q)(z: Z.Carrier p) => eq_reason_in!{TargetAfter.Carrier _
    "=" _ "by" { congr!{Target.Carrier TargetAfter.Carrier} (TargetStep.vertical.apply) _ _ (I.At[q := q, closed := Grading.complementSum n p].onTensor x z) }
    "=" _ "by" { TargetStep.verticalOnInjection index (Product.Term[p := p, q := q].tensor z x) }
    "=" _ "by" { congr!{VT.Carrier TargetAfter.Carrier} (\fun (v: VT.Carrier) => VI.injection.apply ((VSign.map p).apply v)) _ _ (Differential.verticalOnTensor z x) }
    "=" _ "by" { VSignMapping.naturality VI.injection p (VT.tensor z (Original.chain.differential.apply q x)) }
    "=" _ "by" { sym!{TargetAfter.Carrier} _ _
            (eq_reason_in!{TargetAfter.Carrier _
              "=" _ "by" { congr!{{Tensor.Carrier (Bounded.previous q)} TargetAfter.Carrier}
                (\fun (v: Tensor.Carrier (Bounded.previous q)) => J.map.apply ((RSign.map p).apply (Transport.cast Tensor.Carrier (Bounded.previous q) r e v))) _ _
                (Tensor.Step[z := q].onTensor x z) }
              "=" _ "by" { signed (Tensor.At[z := Bounded.previous q].tensor (Original.chain.differential.apply q x) z) }
              "=" _ "by" { congr!{TargetAfter.Carrier TargetAfter.Carrier} ((TotalSign.map p).apply) _ _
                  (J.At[q := Bounded.previous q, closed := closed].onTensor (Original.chain.differential.apply q x) z) }
            }) }
  };
\import Modules.Hom[V := Target.Carrier, W := TargetAfter.Carrier, source := Target.space, target := TargetAfter.space].Composition[
  U := Pure.Carrier, domain := Pure.space] \as TargetCompose;
\import Modules.Hom[V := Tensor.Carrier r, W := TargetAfter.Carrier, source := Tensor.space r, target := TargetAfter.space].Composition[
  U := Pure.Carrier, domain := Pure.space] \as SourceCompose;
\import Pure.Universal[U := TargetAfter.Carrier, target := TargetAfter.space] \as Universal;
\import Modules.Hom[V := Pure.Carrier, W := TargetAfter.Carrier, source := Pure.space, target := TargetAfter.space] \as Maps;
\definition horizontalZero: TargetCompose.compose TargetStep.horizontal I.map = Maps.zeroMap := Universal.ext _ _ horizontalPure;
\definition verticalEquality: TargetCompose.compose TargetStep.vertical I.map = SourceCompose.compose J.map RowStep.differential := Universal.ext _ _ verticalPure;
\import Modules.Laws[V := TargetAfter.Carrier, space := TargetAfter.space] \as Vector;
\import algebra.Group[].Of[Carrier := TargetAfter.Carrier, group := Vector.additive] \as Group;
\definition onRow: \forall (v: Pure.Carrier) -> TargetStep.differential.apply (I.map.apply v) = J.map.apply (RowStep.differential.apply v) :=
  \fun (v: Pure.Carrier) => trans!{TargetAfter.Carrier} _ _ _
    (congr!{TargetAfter.Carrier TargetAfter.Carrier TargetAfter.Carrier} (TargetAfter.space.add) _ _ _ _
      (congr!{Maps.Map TargetAfter.Carrier} (\fun (f: Maps.Map) => f.apply v) _ _ horizontalZero)
      (congr!{Maps.Map TargetAfter.Carrier} (\fun (f: Maps.Map) => f.apply v) _ _ verticalEquality))
    (Group.zeroLeft (J.map.apply (RowStep.differential.apply v)));
\definition commutes: \forall (v: Pure.Carrier) ->
  TargetStep.differential.apply (Current.forward.apply ((Source.Component[i := p].injection).apply v)) =
  After.forward.apply (SourceStep.map.apply ((Source.Component[i := p].injection).apply v)) :=
  \fun (v: Pure.Carrier) => eq_reason_in!{TargetAfter.Carrier _
    "=" _ "by" { congr!{Target.Carrier TargetAfter.Carrier} (TargetStep.differential.apply) _ _ (Current.forwardOnInjection p v) }
    "=" _ "by" { onRow v }
    "=" _ "by" { sym!{TargetAfter.Carrier} _ _
        (trans!{TargetAfter.Carrier} _ _ _
          (congr!{SourceAfter.Carrier TargetAfter.Carrier} (After.forward.apply) _ _ (SourceStep.onInjection p v))
          (After.forwardOnInjection p (RowStep.differential.apply v))) }
  };
