\module Component(p: Degree);
\definition inputFamily: Modules.Family[Degree] := Modules.Family[Degree] {
  Carrier := \fun (p: Degree) => Component[p := p].Carrier,
  space := \fun (p: Degree) => Component[p := p].space,
};
\import Modules.DirectSum[Index := Degree, family := inputFamily] \as Input;
\import Sum.At[z := n] \as Rows;
\import Rows.Homology[] \as HomologySum;
\import Modules.DirectSum[Index := Degree, family := Rows.homologyFamily] \as Output;
\definition Projective: \Prop := \forall (p: Degree) -> Modules.Projective (Modules.Bundle { Carrier := Z.Carrier p, space := Z.space p });
\module With(projective: Projective);
\import Chains.At[C := Total.complex, z := n] \as TotalHomology;
\definition isomorphism[projective: Projective]: Modules.Isomorphism[V := Input.Carrier, W := TotalHomology.Homology,
  source := Input.space, target := TotalHomology.homologySpace].Isomorphism := With[projective := projective].isomorphism;
