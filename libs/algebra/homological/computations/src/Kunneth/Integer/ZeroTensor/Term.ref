\import Sum.Term[z := n] \as Source;
\import Total.Term[n := n] \as Target;
\module Injection(p: Degree);
\module Reverse(i: Grading.Index n);
\import Modules.DirectSum[Index := Degree, family := Source.family].To[W := Target.Carrier, target := Target.space] \as ToTotal;
\definition forwardComponents: ToTotal.Components := \fun (p: Degree) => Injection[p := p].map;
\definition forward: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := ToTotal.extension forwardComponents;
\definition forwardOnInjection: \forall (p: Degree)(x: Source.family.Carrier p) ->
  forward.apply ((Source.Component[i := p].injection).apply x) = (Injection[p := p].map).apply x := ToTotal.onInjection forwardComponents;
\import Modules.DirectSum[Index := Grading.Index n, family := Target.family].To[W := Source.Carrier, target := Source.space] \as ToSum;
\definition backwardComponents: ToSum.Components := \fun (i: Grading.Index n) => Reverse[i := i].map;
\definition backward: Modules.Hom[V := Target.Carrier, W := Source.Carrier, source := Target.space, target := Source.space].Map := ToSum.extension backwardComponents;
\definition backwardOnInjection: \forall (i: Grading.Index n)(x: tensorCarrier i.first i.second) ->
  backward.apply ((Target.Component[i := i].injection).apply x) = (Reverse[i := i].map).apply x := ToSum.onInjection backwardComponents;
\module Inverses;
\definition leftInverse: \forall (x: Source.Carrier) -> backward.apply (forward.apply x) = x := Inverses[].leftInverse;
\definition rightInverse: \forall (x: Target.Carrier) -> forward.apply (backward.apply x) = x := Inverses[].rightInverse;
