\definition q: Degree := Grading.complement n p;
\import \parent.\parent.Component[p := p] \as C;
\import \parent.\parent.\parent.Term[n := n] \as Term;
\import Term.Injection[p := p] \as I;
\definition index: Grading.Index n := I.index q (Grading.complementSum n p);
\import Chains.At[C := Original.chain, z := q] \as H;
\import \parent.\parent.\parent.Coefficient[p := p] \as Coefficient;
\import resolutions.TensorComplex[].Over[R := Integers.Int^, ring := IntegerRing.commutativeRing].Integer[P := Original.chain, N := Coefficient.bundle] \as Tensor;
\import Tensors.Row[E := Tensor.complex, p := p] \as Row;
\import Chains.At[C := Row.complex, z := n] \as HR;
\import Sum.Injection[i := p] \as Injection;
\import Chains.Map[C := rowComplex p, D := Sum.complex].At[k := n] \as Injected;
\import Forward.At[k := n] \as ForwardMap;
\import Sum.At[z := n].Homology[].Point[i := p] \as SumPoint;
\import Zero.At[k := p] \as Constant;
\import Tensors.IndexedCycleProduct[C := Zero.complex, D := Original.chain, n := n].At[i := index] \as Exterior;
\import Tensors.HomologyEquality[C := Total.complex, z := n] \as EqualityOnH;
\import Modules.Tensor[V := Z.Carrier p, W := H.Homology, left := Z.space p, right := H.homologySpace] \as SourceTensor;
\import Sum.At[z := n].Cycles[] \as CycleComparison;
\definition sumClassEquation: \forall (x: HR.Cycle) ->
  HomologySum.forward.apply ((Output.Injection[i := p].map).apply (HR.classOf x)) =
  SumH.classOf ((Injected.cyclesMap Injection.map).apply x) :=
  \fun (x: HR.Cycle) => trans!{SumH.Homology} _ _ _ (SumPoint.onClass x)
    (congr!{SumH.Cycle SumH.Homology} SumH.classOf _ _ (CycleComparison.onInjection p x));
\definition classEquation: \forall (z: Z.Carrier p)(x: H.Cycle) ->
  isomorphism.forward.apply ((Input.Injection[i := p].map).apply (SourceTensor.tensor z (H.classOf x))) =
    Exterior.classOf (Constant.cycles.apply z) x :=
  \fun (z: Z.Carrier p)(x: H.Cycle) => trans!{TotalH.Homology} _ _ _
    (onInjection p (SourceTensor.tensor z (H.classOf x)))
    (trans!{TotalH.Homology} _ _ _
      (congr!{HR.Homology TotalH.Homology}
        (\fun (h: HR.Homology) => ((Induced.isomorphism chainIsomorphism).forward).apply
          (HomologySum.forward.apply ((Output.Injection[i := p].map).apply h))) _ _
        (C.onClass (projective p) z x))
      (trans!{TotalH.Homology} _ _ _
        (congr!{SumH.Homology TotalH.Homology} (((Induced.isomorphism chainIsomorphism).forward).apply) _ _
          (sumClassEquation (C.rowCycle x z)))
        (trans!{TotalH.Homology} _ _ _ (ForwardMap.onClass forward ((Injected.cyclesMap Injection.map).apply (C.rowCycle x z)))
          (EqualityOnH.equalClass
            ((ForwardMap.cyclesMap forward).apply ((Injected.cyclesMap Injection.map).apply (C.rowCycle x z)))
            (Exterior.cycle (Constant.cycles.apply z) x)
            (trans!{{Total.complex.family.Carrier n}} _ _ _ (Term.forwardOnInjection p (C.rowCycle x z))
              (trans!{{Total.complex.family.Carrier n}} _ _ _
                (congr!{{Tensor.Carrier q} {Total.complex.family.Carrier n}} (I.map.apply) _ _ (C.pureValue x z))
                (I.At[q := q, closed := Grading.complementSum n p].onTensor x z)))))));
\import Tensors.ExteriorTransport[C := Zero.complex, D := Original.chain, p := p, q := q] \as ExteriorTransport;
\import Tensors.CycleProduct[C := Zero.complex, D := Original.chain, p := p, q := q] \as NativeExterior;
\definition transportedClassEquation: \forall (z: Z.Carrier p)(x: H.Cycle) ->
  isomorphism.forward.apply ((Input.Injection[i := p].map).apply (SourceTensor.tensor z (H.classOf x))) =
    Transport.cast ExteriorTransport.Carrier (Grading.add p q) n (Grading.complementSum n p)
      (NativeExterior.classOf (Constant.cycles.apply z) x) :=
  \fun (z: Z.Carrier p)(x: H.Cycle) => trans!{TotalH.Homology} _ _ _ (classEquation z x)
    (sym!{TotalH.Homology} _ _ (ExteriorTransport.onClass n (Grading.complementSum n p) (Constant.cycles.apply z) x));

\module Arbitrary(r: Degree, closed: Grading.add p r = n) {
  \import Chains.At[C := Original.chain, z := r] \as R;
  \definition index: Grading.Index n := I.index r closed;
  \import Tensors.IndexedCycleProduct[C := Zero.complex, D := Original.chain, n := n].At[i := index] \as Native;
  \definition value[z: Z.Carrier p][x: R.Cycle]: TotalH.Homology := Native.classOf (Constant.cycles.apply z) x;
}
\module HomologyPoint(r: Degree) {
  \import Chains.At[C := Original.chain, z := r] \as R;
  \definition Carrier: \Set := R.Homology;
}
\definition homologyCarrier[r: Degree]: \Set := HomologyPoint[r := r].Carrier;
\definition arbitraryClassEquation: \forall (r: Degree)(closed: Grading.add p r = n)(z: Z.Carrier p)
  (x: Chains.At[C := Original.chain, z := r].Cycle) ->
  isomorphism.forward.apply ((Input.Injection[i := p].map).apply
    (SourceTensor.tensor z (Transport.cast homologyCarrier r q
      (sym!{Degree} _ _ (Grading.complementUnique n p r closed)) (Chains.At[C := Original.chain, z := r].classOf x)))) =
  Arbitrary[r := r, closed := closed].value z x :=
  \fun (r: Degree)(closed: Grading.add p r = n) =>
    (\idelim q = r \with k: Degree => \forall (same: Grading.add p k = n)(z: Z.Carrier p)
      (x: Chains.At[C := Original.chain, z := k].Cycle) ->
      isomorphism.forward.apply ((Input.Injection[i := p].map).apply
        (SourceTensor.tensor z (Transport.cast homologyCarrier k q
          (sym!{Degree} _ _ (Grading.complementUnique n p k same)) (Chains.At[C := Original.chain, z := k].classOf x)))) =
      Arbitrary[r := k, closed := same].value z x \by {
      base: \fun (same: Grading.add p q = n)(z: Z.Carrier p)(x: H.Cycle) => trans!{TotalH.Homology} _ _ _
        (congr!{H.Homology TotalH.Homology}
          (\fun (h: H.Homology) => isomorphism.forward.apply ((Input.Injection[i := p].map).apply (SourceTensor.tensor z h))) _ _
          (Transport.castRefl homologyCarrier q (H.classOf x)))
        (classEquation z x),
      equality: Grading.complementUnique n p r closed
    }) closed;
