\definition q: Degree := Grading.complement n p;
\import \parent.\parent.Coefficient[p := p] \as Coefficient;
\import resolutions.TensorComplex[].Over[R := Integers.Int^, ring := IntegerRing.commutativeRing].Integer[P := Original.chain, N := Coefficient.bundle] \as Tensor;
\import Tensors.Row[E := Tensor.complex, p := p] \as Row;
\import Row.Homology[n := n] \as Shift;
\import Chains.At[C := Original.chain, z := q] \as H;
\import Chains.At[C := Tensor.complex, z := q] \as HT;
\import Chains.At[C := Row.complex, z := n] \as HR;
\import Modules.Tensor[V := Z.Carrier p, W := H.Homology, left := Z.space p, right := H.homologySpace] \as Input;
\definition Carrier: \Set := Input.Carrier;
\definition space: Modules.Space Carrier := Input.space;
\definition tensor: Z.Carrier p -> H.Homology -> Carrier := Input.tensor;
\import \parent.\parent.\parent.ProjectiveTensorRow[D := D, A := Coefficient.bundle, p := p, n := n] \as Native;
\definition uct(projective: Modules.Projective Coefficient.bundle): Modules.Isomorphism[V := Carrier, W := HT.Homology,
  source := space, target := HT.homologySpace].Isomorphism := Native.uct projective;
\definition isomorphism(projective: Modules.Projective Coefficient.bundle): Modules.Isomorphism[V := Carrier, W := HR.Homology,
  source := space, target := HR.homologySpace].Isomorphism := Native.isomorphism projective;
\import \root.Finite[].Bounded[].Of[C := D].At[z := q].UniversalCoefficient[A := Coefficient.bundle].Tensor[] \as UCT;
\import Modules.Tensor[V := H.Cycle, W := Z.Carrier p, left := H.cycleSpace, right := Z.space p] \as Cycles;
\definition pure(x: H.Cycle)(z: Z.Carrier p): HT.Cycle := Native.pure x z;
\definition rowCycle(x: H.Cycle)(z: Z.Carrier p): HR.Cycle := Native.rowCycle x z;
\definition onClass: \forall (projective: Modules.Projective Coefficient.bundle)(z: Z.Carrier p)(x: H.Cycle) ->
  ((isomorphism projective).forward).apply (tensor z (H.classOf x)) = HR.classOf (rowCycle x z) := Native.onClass;
\definition pureValue: \forall (x: H.Cycle)(z: Z.Carrier p) ->
  UCT.inclusion.apply (Cycles.tensor x z) = Tensor.At[z := q].tensor x z := Native.pureValue;
