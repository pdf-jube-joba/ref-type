\import \parent.\parent.Of[C := C, D := D].At[n := n] \as Terms;
\import \parent.\parent.Theorem[C := C, D := D].At[n := n] \as Theorem;
\import Modules.Biproduct[V := Terms.tensorBundle.Carrier, W := Terms.torBundle.Carrier,
  left := Terms.tensorBundle.space, right := Terms.torBundle.space] \as Sum;
\definition Splitting: \Set := Modules.Isomorphism[V := Sum.Carrier, W := Terms.homologyBundle.Carrier,
  source := Sum.space, target := Terms.homologyBundle.space].Isomorphism;
\definition selected: Splitting := Theorem.selectedSplitting;
\import Modules.Biproduct[V := Terms.smithBundle.Carrier, W := Terms.torBundle.Carrier,
  left := Terms.smithBundle.space, right := Terms.torBundle.space] \as SmithSum;
\definition SmithSplitting: \Set := Modules.Isomorphism[V := SmithSum.Carrier, W := Terms.homologyBundle.Carrier,
  source := SmithSum.space, target := Terms.homologyBundle.space].Isomorphism;
\definition smithSelected: SmithSplitting := Theorem.smithSplitting;
