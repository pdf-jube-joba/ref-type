\import \parent.\parent.CoreTerms[C := C, D := D].At[n := n] \as Terms;
\import \parent.\parent.Theorem[C := C, D := D].ExactAt[n := n] \as Theorem;
\import Modules.ShortExact[A := Terms.tensorBundle, B := Terms.homologyBundle, C := Terms.torBundle] \as Sequences;
\definition Statement: \Prop := \exists { s: Sequences.Sequence \where #inclusion{s} = Terms.exterior };
\definition proof: Statement := Logic.existsIntro[Sequences.Sequence,
  { s: Sequences.Sequence \where #inclusion{s} = Terms.exterior }] Theorem.sequence Theorem.inclusionEq;
