\definition q: Degree := complement k p;
\definition lowerQ: Degree := complement (Bounded.previous k) (Bounded.previous p);
\definition same: q = lowerQ := sym!{Degree} _ _ (Grading.complementUnique (Bounded.previous k) (Bounded.previous p) q
  (trans!{Degree} _ _ _ (Grading.previousLeft p q) (congr!{Degree Degree} Bounded.previous _ _ (Grading.complementSum k p))));
\import Decomposition.Term[p := p] \as Term;
\import Modules.Tensor[V := Term.boundaryCarrier, W := homologyFamily.Carrier q,
  left := Term.boundarySpace, right := homologyFamily.space q] \as Tensor;
\import Modules.End[V := Term.boundaryCarrier, space := Term.boundarySpace] \as Identity;
\import Modules.Isomorphism[V := Term.boundaryCarrier, W := Term.boundaryCarrier, source := Term.boundarySpace, target := Term.boundarySpace] \as IdentityIso;
\definition identity: IdentityIso.Isomorphism := IdentityIso.Isomorphism {
  forward := Identity.identity, backward := Identity.identity,
  leftInverse := \fun (x: Term.boundaryCarrier) => \refl(x),
  rightInverse := \fun (x: Term.boundaryCarrier) => \refl(x),
};
\import Tensor.Mapping[U := Term.boundaryCarrier, Z := homologyFamily.Carrier lowerQ,
  targetLeft := Term.boundarySpace, targetRight := homologyFamily.space lowerQ].Isomorphism[
  leftIso := identity, rightIso := HTransport.isomorphism q lowerQ same] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := Boundaries.inputFamily.Carrier p, W := Shift.shifted.Carrier p,
  source := Boundaries.inputFamily.space p, target := Shift.shifted.space p].Isomorphism := Comparison.isomorphism;
