\import \parent.Component[p := p] \as Data;
\definition q: Degree := Data.q;
\definition lowerQ: Degree := Data.lowerQ;
\definition same: q = lowerQ := Data.same;
\import Decomposition.Term[p := p] \as Term;
\import Modules.Tensor[V := Term.boundaryCarrier, W := homologyFamily.Carrier q,
  left := Term.boundarySpace, right := homologyFamily.space q] \as Tensor;
\import Modules.End[V := Term.boundaryCarrier, space := Term.boundarySpace] \as Identity;
\definition isomorphism: Modules.Isomorphism[V := Boundaries.inputFamily.Carrier p, W := Shift.shifted.Carrier p,
  source := Boundaries.inputFamily.space p, target := Shift.shifted.space p].Isomorphism := Data.isomorphism;
\import Chains.At[C := Right.chain, z := q] \as H;
\definition index: Grading.Index k := \into[Grading.Pair](Grading.Pair { first := p, second := q },
  { i: Grading.Pair \where Grading.add #first{i} #second{i} = k }) \by { Grading.complementSum k p };
\import Sequence.Connecting[n := k].Component[i := index] \as Connecting;
\import Model.Component[p := Bounded.previous p] \as M;
\import Tensor.Mapping[U := Term.boundaryCarrier, Z := homologyFamily.Carrier lowerQ,
  targetLeft := Term.boundarySpace, targetRight := homologyFamily.space lowerQ] \as TransportTensor;
\definition transported(b: Term.boundaryCarrier)(y: H.Homology): Model.source.Carrier (Bounded.previous p) :=
  M.sourceTensor b (#apply{HTransport.forward q lowerQ same} y);
\definition onTensor: \forall (b: Term.boundaryCarrier)(y: H.Homology) ->
  #apply{#forward{isomorphism}} (Tensor.tensor b y) = transported b y :=
  TransportTensor.onTensor Identity.identity (HTransport.forward q lowerQ same);
\definition reindexOnValue: \forall (t: Tensor.Carrier) ->
  #apply{#forward{sourceReindex}} (#apply{Source.Injection[i := p].map} t) =
    #apply{ModelSource.Injection[i := Bounded.previous p].map} (#apply{#forward{isomorphism}} t) :=
  \fun (t: Tensor.Carrier) => trans!{ModelSource.Carrier} _ _ _
    (congr!{Middle.Carrier ModelSource.Carrier} (#apply{#forward{Shift.isomorphism}}) _ _ (Reindex.smithOnInjection p t))
    (Shift.onInjection p (#apply{#forward{isomorphism}} t));
\definition reindexOnTensor: \forall (b: Term.boundaryCarrier)(y: H.Homology) ->
  #apply{#forward{sourceReindex}} (#apply{Source.Injection[i := p].map} (Tensor.tensor b y)) =
    #apply{ModelSource.Injection[i := Bounded.previous p].map} (transported b y) :=
  \fun (b: Term.boundaryCarrier)(y: H.Homology) => trans!{ModelSource.Carrier} _ _ _
    (congr!{Middle.Carrier ModelSource.Carrier} (#apply{#forward{Shift.isomorphism}}) _ _ (Reindex.smithOnInjection p (Tensor.tensor b y)))
    (trans!{ModelSource.Carrier} _ _ _ (Shift.onInjection p (#apply{#forward{isomorphism}} (Tensor.tensor b y)))
      (congr!{{Model.source.Carrier (Bounded.previous p)} ModelSource.Carrier}
        (#apply{ModelSource.Injection[i := Bounded.previous p].map}) _ _ (onTensor b y)));
\definition modelOnTensor: \forall (b: Term.boundaryCarrier)(y: H.Homology) ->
  #apply{Model.map} (#apply{#forward{sourceReindex}} (#apply{Source.Injection[i := p].map} (Tensor.tensor b y))) =
    #apply{ModelTarget.Injection[i := Bounded.previous p].map} (M.targetTensor b (#apply{HTransport.forward q lowerQ same} y)) :=
  \fun (b: Term.boundaryCarrier)(y: H.Homology) => trans!{ModelTarget.Carrier} _ _ _
    (congr!{ModelSource.Carrier ModelTarget.Carrier} (#apply{Model.map}) _ _ (reindexOnTensor b y))
    (trans!{ModelTarget.Carrier} _ _ _ (Model.onInjection (Bounded.previous p) (transported b y))
      (congr!{{Model.target.Carrier (Bounded.previous p)} ModelTarget.Carrier}
        (#apply{ModelTarget.Injection[i := Bounded.previous p].map}) _ _ (M.onTensor b (#apply{HTransport.forward q lowerQ same} y))));
\definition lowerDegree: Grading.add (Bounded.previous p) q = Bounded.previous k :=
  trans!{Degree} _ _ _ (Grading.previousLeft p q) (congr!{Degree Degree} Bounded.previous _ _ (Grading.complementSum k p));
\definition onClass: \forall (b: Term.boundaryCarrier)(y: H.Cycle) ->
  #apply{Delta.connecting} (#apply{#forward{rightIsomorphism}} (#apply{Source.Injection[i := p].map} (Tensor.tensor b (H.classOf y)))) =
  #apply{#forward{leftIsomorphism}} (#apply{Model.map} (#apply{#forward{sourceReindex}} (#apply{Source.Injection[i := p].map} (Tensor.tensor b (H.classOf y))))) :=
  \fun (b: Term.boundaryCarrier)(y: H.Cycle) => trans!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}} _ _ _
    (congr!{{Chains.At[C := Sequence.right, z := k].Homology} {Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}}
      (#apply{Delta.connecting}) _ _ (SourceIso.Generator[p := p].classEquation b y))
    (trans!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}} _ _ _ (Connecting.onClass b y)
      (sym!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}} _ _
        (trans!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}} _ _ _
          (congr!{ModelTarget.Carrier {Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}}
            (#apply{#forward{leftIsomorphism}}) _ _ (modelOnTensor b (H.classOf y)))
          (TargetIso.Generator[p := Bounded.previous p].arbitraryClassEquation q lowerDegree (Term.boundaryAsCycle b) y))));
\import Modules.Hom[V := Source.Carrier, W := LH.Homology, source := Source.space, target := LH.homologySpace].Composition[
  U := Tensor.Carrier, domain := Tensor.space] \as Restrict;
\import Tensor.Universal[U := LH.Homology, target := LH.homologySpace] \as Universal;
\import Modules.Hom[V := Tensor.Carrier, W := LH.Homology, source := Tensor.space, target := LH.homologySpace] \as ResultMaps;
\definition square: \forall (x: Tensor.Carrier) ->
  #apply{after} (#apply{Source.Injection[i := p].map} x) = #apply{before} (#apply{Source.Injection[i := p].map} x) :=
  \fun (x: Tensor.Carrier) => congr!{{ResultMaps.Map} LH.Homology} (\fun (f: ResultMaps.Map) => #apply{f} x) _ _
    (Universal.ext (Restrict.compose after Source.Injection[i := p].map) (Restrict.compose before Source.Injection[i := p].map)
      (\fun (b: Term.boundaryCarrier) => H.classInduction
        (\fun (h: H.Homology) => #apply{after} (#apply{Source.Injection[i := p].map} (Tensor.tensor b h)) =
          #apply{before} (#apply{Source.Injection[i := p].map} (Tensor.tensor b h)))
        (onClass b)));
