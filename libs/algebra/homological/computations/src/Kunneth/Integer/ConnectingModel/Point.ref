\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Component[p := p] \as Data;
\definition q: Degree := Data.q;
\definition lowerQ: Degree := Data.lowerQ;
\definition same: q = lowerQ := Data.same;
\import Decomposition.Term[p := p] \as Term;
\import Modules.Tensor[V := Term.boundaryCarrier, W := homologyFamily.Carrier q,
  left := Term.boundarySpace, right := homologyFamily.space q] \as Tensor;
\import Modules.End[V := Term.boundaryCarrier, space := Term.boundarySpace] \as Identity;
\definition isomorphism: Modules.Isomorphism[V := Boundaries.inputFamily.Carrier p, W := Shift.shifted.Carrier p,
  source := Boundaries.inputFamily.space p, target := Shift.shifted.space p].Isomorphism := Data.isomorphism;
\import Chains.At[C := Right.chain, z := q] \as H;
\definition index: Grading.Index k := \into[Grading.Pair](Grading.Pair { first := p, second := q },
  { i: Grading.Pair \where Grading.add i.first i.second = k }) \by { Grading.complementSum k p };
\import Sequence.Connecting[n := k].Component[i := index] \as Connecting;
\import Model.Component[p := Bounded.previous p] \as M;
\import Tensor.Mapping[U := Term.boundaryCarrier, Z := homologyFamily.Carrier lowerQ,
  targetLeft := Term.boundarySpace, targetRight := homologyFamily.space lowerQ] \as TransportTensor;
\definition transported[b: Term.boundaryCarrier][y: H.Homology]: Model.source.Carrier (Bounded.previous p) :=
  M.sourceTensor b ((HTransport.forward q lowerQ same).apply y);
\definition onTensor: \forall (b: Term.boundaryCarrier)(y: H.Homology) ->
  isomorphism.forward.apply (Tensor.tensor b y) = transported b y :=
  TransportTensor.onTensor Identity.identity (HTransport.forward q lowerQ same);
\definition reindexOnValue: \forall (t: Tensor.Carrier) ->
  sourceReindex.forward.apply ((Source.Injection[i := p].map).apply t) =
    (ModelSource.Injection[i := Bounded.previous p].map).apply (isomorphism.forward.apply t) :=
  \fun (t: Tensor.Carrier) => trans!{ModelSource.Carrier} _ _ _
    (congr!{Middle.Carrier ModelSource.Carrier} (Shift.isomorphism.forward.apply) _ _ (Reindex.smithOnInjection p t))
    (Shift.onInjection p (isomorphism.forward.apply t));
\definition reindexOnTensor: \forall (b: Term.boundaryCarrier)(y: H.Homology) ->
  sourceReindex.forward.apply ((Source.Injection[i := p].map).apply (Tensor.tensor b y)) =
    (ModelSource.Injection[i := Bounded.previous p].map).apply (transported b y) :=
  \fun (b: Term.boundaryCarrier)(y: H.Homology) => eq_reason_in!{ModelSource.Carrier _
    "=" _ "by" { congr!{Middle.Carrier ModelSource.Carrier} (Shift.isomorphism.forward.apply) _ _ (Reindex.smithOnInjection p (Tensor.tensor b y)) }
    "=" _ "by" { Shift.onInjection p (isomorphism.forward.apply (Tensor.tensor b y)) }
    "=" _ "by" { congr!{{Model.source.Carrier (Bounded.previous p)} ModelSource.Carrier}
        ((ModelSource.Injection[i := Bounded.previous p].map).apply) _ _ (onTensor b y) }
  };
\definition modelOnTensor: \forall (b: Term.boundaryCarrier)(y: H.Homology) ->
  Model.map.apply (sourceReindex.forward.apply ((Source.Injection[i := p].map).apply (Tensor.tensor b y))) =
    (ModelTarget.Injection[i := Bounded.previous p].map).apply (M.targetTensor b ((HTransport.forward q lowerQ same).apply y)) :=
  \fun (b: Term.boundaryCarrier)(y: H.Homology) => eq_reason_in!{ModelTarget.Carrier _
    "=" _ "by" { congr!{ModelSource.Carrier ModelTarget.Carrier} (Model.map.apply) _ _ (reindexOnTensor b y) }
    "=" _ "by" { Model.onInjection (Bounded.previous p) (transported b y) }
    "=" _ "by" { congr!{{Model.target.Carrier (Bounded.previous p)} ModelTarget.Carrier}
        ((ModelTarget.Injection[i := Bounded.previous p].map).apply) _ _ (M.onTensor b ((HTransport.forward q lowerQ same).apply y)) }
  };
\definition lowerDegree: Grading.add (Bounded.previous p) q = Bounded.previous k :=
  trans!{Degree} _ _ _ (Grading.previousLeft p q) (congr!{Degree Degree} Bounded.previous _ _ (Grading.complementSum k p));
\definition onClass: \forall (b: Term.boundaryCarrier)(y: H.Cycle) ->
  Delta.connecting.apply (rightIsomorphism.forward.apply ((Source.Injection[i := p].map).apply (Tensor.tensor b (H.classOf y)))) =
  leftIsomorphism.forward.apply (Model.map.apply (sourceReindex.forward.apply ((Source.Injection[i := p].map).apply (Tensor.tensor b (H.classOf y))))) :=
  \fun (b: Term.boundaryCarrier)(y: H.Cycle) => eq_reason_in!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology} _
    "=" _ "by" { congr!{{Chains.At[C := Sequence.right, z := k].Homology} {Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}}
      (Delta.connecting.apply) _ _ (SourceIso.Generator[p := p].classEquation b y) }
    "=" _ "by" { Connecting.onClass b y }
    "=" _ "by" { sym!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}} _ _
        (trans!{{Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}} _ _ _
          (congr!{ModelTarget.Carrier {Chains.At[C := Sequence.left, z := Bounded.previous k].Homology}}
            (leftIsomorphism.forward.apply) _ _ (modelOnTensor b (H.classOf y)))
          (TargetIso.Generator[p := Bounded.previous p].arbitraryClassEquation q lowerDegree (Term.boundaryAsCycle b) y)) }
  };
\import Modules.Hom[V := Source.Carrier, W := LH.Homology, source := Source.space, target := LH.homologySpace].Composition[
  U := Tensor.Carrier, domain := Tensor.space] \as Restrict;
\import Tensor.Universal[U := LH.Homology, target := LH.homologySpace] \as Universal;
\import Modules.Hom[V := Tensor.Carrier, W := LH.Homology, source := Tensor.space, target := LH.homologySpace] \as ResultMaps;
\definition square: \forall (x: Tensor.Carrier) ->
  after.apply ((Source.Injection[i := p].map).apply x) = before.apply ((Source.Injection[i := p].map).apply x) :=
  \fun (x: Tensor.Carrier) => congr!{{ResultMaps.Map} LH.Homology} (\fun (f: ResultMaps.Map) => f.apply x) _ _
    (Universal.ext (Restrict.compose after Source.Injection[i := p].map) (Restrict.compose before Source.Injection[i := p].map)
      (\fun (b: Term.boundaryCarrier) => H.classInduction
        (\fun (h: H.Homology) => after.apply ((Source.Injection[i := p].map).apply (Tensor.tensor b h)) =
          before.apply ((Source.Injection[i := p].map).apply (Tensor.tensor b h)))
        (onClass b)));
