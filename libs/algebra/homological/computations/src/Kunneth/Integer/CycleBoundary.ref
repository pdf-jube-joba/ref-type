\import Bounded.Of[C := C] \as Original;
\import Modules.Zero[] \as Zero;
\definition zeroBundle: Modules.Bundle := Modules.Bundle { Carrier := Zero.Carrier, space := Zero.moduleSpace };
\module Term(p: Degree);
\definition cyclesFamily: Chains.Family := Chains.Family {
  Carrier := \fun (p: Degree) => Term[p := p].cycleCarrier,
  space := \fun (p: Degree) => Term[p := p].cycleSpace,
};
\definition boundariesFamily: Chains.Family := Chains.Family {
  Carrier := \fun (p: Degree) => Term[p := p].boundaryCarrier,
  space := \fun (p: Degree) => Term[p := p].boundarySpace,
};
\import Chains.ZeroDifferential[family := cyclesFamily] \as Cycles;
\import Chains.ZeroDifferential[family := boundariesFamily] \as Boundaries;
\definition cyclesComplex: Chains.Complex := Cycles.complex;
\definition boundariesComplex: Chains.Complex := Boundaries.complex;
\import Chains.Map[C := cyclesComplex, D := Original.chain] \as Inclusions;
\definition inclusion: Inclusions.Map := Inclusions.Map {
  apply := \fun (p: Degree) => (Term[p := p].inclusion).apply,
  addition := \fun (p: Degree) => (Term[p := p].inclusion).addition,
  scalar := \fun (p: Degree) => (Term[p := p].inclusion).scalar,
  commutes := \fun (p: Degree) => Term[p := p].inclusionCommutes,
};
\import Chains.Map[C := Original.chain, D := boundariesComplex] \as Projections;
\definition projection: Projections.Map := Projections.Map {
  apply := \fun (p: Degree) => (Term[p := p].projection).apply,
  addition := \fun (p: Degree) => (Term[p := p].projection).addition,
  scalar := \fun (p: Degree) => (Term[p := p].projection).scalar,
  commutes := \fun (p: Degree) => Term[p := p].projectionCommutes,
};
\import Chains.ShortExact[A := cyclesComplex, B := Original.chain, C := boundariesComplex] \as Sequences;
\definition data: Sequences.Data := Sequences.Data { inclusion := inclusion, projection := projection };
\definition laws: Sequences.Laws[data] := Sequences.Laws[data] {
  injective := \fun (p: Degree) => Term[p := p].injective,
  onto := \fun (p: Degree) => Term[p := p].onto,
  zero := \fun (p: Degree) => Term[p := p].zero,
  kernelImage := \fun (p: Degree) => Term[p := p].kernelImage,
};
\definition sequence: Sequences.Sequence := \into[Sequences.Data](data, { data: Sequences.Data \where Sequences.Laws[data] }) \by { laws };
