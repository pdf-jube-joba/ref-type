\import Source.At[n := n] \as SourceTerms;
\import Target.At[n := n] \as TargetTerms;
\module Component(p: Degree);
\import Modules.DirectSumMapping[Index := Degree, sourceFamily := SourceTerms.tensorFamily, targetFamily := TargetTerms.tensorFamily] \as TensorMaps;
\definition tensorComponents(f: LeftMaps.Map)(g: RightMaps.Map): TensorMaps.Components :=
  \fun (p: Degree) => Component[p := p].tensorMap f g;
\definition tensorMap(f: LeftMaps.Map)(g: RightMaps.Map): Modules.MapBetween SourceTerms.tensorBundle TargetTerms.tensorBundle :=
  TensorMaps.On[f := tensorComponents f g].map;
\import Modules.DirectSumMapping[Index := Degree, sourceFamily := SourceTerms.smithFamily, targetFamily := TargetTerms.smithFamily] \as SmithMaps;
\definition smithComponents(f: LeftMaps.Map)(g: RightMaps.Map): SmithMaps.Components :=
  \fun (p: Degree) => Component[p := p].smithMap f g;
\definition smithMap(f: LeftMaps.Map)(g: RightMaps.Map): Modules.MapBetween SourceTerms.smithBundle TargetTerms.smithBundle :=
  SmithMaps.On[f := smithComponents f g].map;
\import Modules.DirectSumMapping[Index := Degree, sourceFamily := SourceTerms.torFamily, targetFamily := TargetTerms.torFamily] \as TorMaps;
\definition torComponents(f: LeftMaps.Map)(g: RightMaps.Map): TorMaps.Components :=
  \fun (p: Degree) => Component[p := p].torMap f g;
\definition torMap(f: LeftMaps.Map)(g: RightMaps.Map): Modules.MapBetween SourceTerms.torBundle TargetTerms.torBundle :=
  TorMaps.On[f := torComponents f g].map;
\module Naturality(f: LeftMaps.Map, g: RightMaps.Map);
\module Exterior(f: LeftMaps.Map, g: RightMaps.Map);
