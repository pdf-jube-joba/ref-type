\import Bounded.Of[C := C] \as Left;
\import Bounded.Of[C := D] \as Right;
\module Component(p: Degree);
\definition torFamily: Modules.Family[Degree] := Modules.Family[Degree] {
  Carrier := \fun (p: Degree) => Component[p := p].torCarrier,
  space := \fun (p: Degree) => Component[p := p].torSpace,
};
\import Modules.DirectSum[Index := Degree, family := torFamily] \as Sum;
\definition torBundle: Modules.Bundle := Sum.bundle;

\module Mapping(E, F: Bounded.Complex);
