\import \root.Finite[] \as Finite;
\import Finite.Bounded[] \as Bounded;
\import std.Data[].Nat[] \as Nat;
\import std.Arithmetic[].Int[] \as Integers;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import module_theory.Module[].Over[R := Integers.Int^, ring := IntegerRing.ring] \as Modules;
\import chain_complexes.Chain[].Over[R := Integers.Int^, ring := IntegerRing.ring] \as Chains;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition Degree: \Set := Bounded.Degree;
\definition complement(n, p: Degree): Degree := #add{IntegerRing.ring} n (#neg{IntegerRing.ring} p);
\module Of(C, D: Bounded.Complex);
\module Mapping(C, D, E, F: Bounded.Complex);

\module CycleBoundary(C: Bounded.Complex);

\module SplitDiagonal(Index: \Set, left, middle, right: Modules.Family[Index]);

\module TensorSequence(C, D: Bounded.Complex);

\module KernelModel(C, D: Bounded.Complex, n: Degree);

\module ChainSum(Index: \Set, terms: Index -> Chains.Complex);

\module ExactFiveFactor(A, B, C, D, E: Modules.Bundle);

\module ZeroTensor(Z: Chains.Family, D: Bounded.Complex);

\module HomologyProjection(C: Bounded.Complex);

\module DiagonalKernel(Index: \Set, source, target: Modules.Family[Index], maps: Modules.DirectSumMapping[Index := Index, sourceFamily := source, targetFamily := target].Components);

\module DiagonalCokernel(Index: \Set, source, target: Modules.Family[Index], maps: Modules.DirectSumMapping[Index := Index, sourceFamily := source, targetFamily := target].Components);

\module ProjectiveTensorRow(D: Bounded.Complex, A: Modules.Bundle, p, n: Degree);

\module SelectedRetraction(C, D: Bounded.Complex);

\module ShiftSum(family: Modules.Family[Degree]);

\module SumIsomorphism(Index: \Set, source, target: Modules.Family[Index], isos: \forall (i: Index) -> Modules.Isomorphism[V := source.Carrier i, W := target.Carrier i, source := source.space i, target := target.space i].Isomorphism);

\module HomologyDiagonal(C, D: Bounded.Complex, n: Degree);

\module ConnectingModel(C, D: Bounded.Complex, k: Degree);
\module TorTerms(C, D: Bounded.Complex, n: Degree);
\module TorDiagonal(C, D: Bounded.Complex, n: Degree);

\module EndsTransport(A, B, C, L, R: Modules.Bundle, s: Modules.ShortExact[A := A, B := B, C := C].Sequence, leftIso: Modules.Isomorphism[V := L.Carrier, W := A.Carrier, source := L.space, target := A.space].Isomorphism, rightIso: Modules.Isomorphism[V := C.Carrier, W := R.Carrier, source := C.space, target := R.space].Isomorphism);
\module CoreTerms(C, D: Bounded.Complex);
\module Theorem(C, D: Bounded.Complex);
\module Assertions;

\module ExteriorModel(C, D: Bounded.Complex, n: Degree);
