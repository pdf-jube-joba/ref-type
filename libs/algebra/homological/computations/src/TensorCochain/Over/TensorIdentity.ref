\import \parent.Tensor[C := C, D := D] \as Tensor;
\import \parent.Total[C := Tensor.complex] \as Total;
\import \parent.TensorMapping[C := C, D := C, E := D, F := D] \as Mapping;
\definition c: Cochains.Map[C := C, D := C].Map := Cochains.End[C := C].identity;
\definition d: Cochains.Map[C := D, D := D].Map := Cochains.End[C := D].identity;
\import Mapping.With[f := c, g := d] \as Induced;
\import \parent.Map[C := Tensor.complex, D := Tensor.complex].Total[f := Induced.map] \as InducedTotal;
\module Degree(n: Nat.Nat^);
\import Cochains.Map[C := Total.complex, D := Total.complex] \as Maps;
\definition map: Maps.Map := Induced.total;
\definition equality: Induced.total = Cochains.End[C := Total.complex].identity := Maps.ext Induced.total (Cochains.End[C := Total.complex].identity)
  (\fun (n: Nat.Nat^) => Degree[n := n].point);
