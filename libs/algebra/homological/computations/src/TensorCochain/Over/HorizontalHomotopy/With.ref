\import \parent.\parent.Total[C := C] \as Source;
\import \parent.\parent.Total[C := D] \as Target;
\import Maps.Total[f := f] \as Forward;
\import Maps.Total[f := g] \as Backward;
\import Cochains.Homotopy[C := Source.complex, D := Target.complex] \as Result;
\definition laws: Laws[f, g, h] := \bysub(Data, { h: Data \where Laws[f, g, h] }, h);
\module Term(p, q: Nat.Nat^) {
  \definition map: Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) q, W := D.family.Carrier p q,
    source := C.family.space (Nat.Nat^::succ p) q, target := D.family.space p q].Map := h p q;
}
\module Degree(n: Nat.Nat^);
\definition data: Result.Data := \fun (n: Nat.Nat^) => Degree[n := n].map;
\module Step(n: Nat.Nat^);
\module Zero;
\definition homotopy: Result.Homotopy Forward.map Backward.map :=
  \into[Result.Data](data, { h: Result.Data \where Result.Laws[Forward.map, Backward.map, h] }) \by {
    Result.Laws[Forward.map, Backward.map, data] {
      degreeZero := Zero[].equality,
      positive := \fun (n: Nat.Nat^) => Step[n := n].equality,
    }
  };
