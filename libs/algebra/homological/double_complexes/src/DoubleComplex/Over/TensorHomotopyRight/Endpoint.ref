\import LeftMapping.With[f := f, g := identity] \as Left;
\import RightMapping.With[f := identity, g := f] \as Right;
\definition map: Output.Map := After.compose TargetSwap.forward (Before.compose Left.total SourceSwap.forward);
\import SourceSwap.Mapping[E := E, F := D].On[f := identity, g := f] \as Naturality;
\import Chains.Map[C := Source.complex, D := ReverseTarget.complex] \as MiddleMaps;
\definition law[n: Nat.Nat^][x: Source.Carrier n]: (map).apply n x = (Right.total).apply n x :=
  trans!{{Target.Carrier n}} _ _ _
    (congr!{{ReverseTarget.Carrier n} {Target.Carrier n}} ((TargetSwap.forward).apply n) _ _
      (congr!{MiddleMaps.Map {ReverseTarget.Carrier n}} (\fun (h: MiddleMaps.Map) => (h).apply n x) _ _ Naturality.square))
    (OtherTargetSwap.Involution[].twice n ((Right.total).apply n x));
\definition equality: map = Right.total := Output.ext map Right.total law;
