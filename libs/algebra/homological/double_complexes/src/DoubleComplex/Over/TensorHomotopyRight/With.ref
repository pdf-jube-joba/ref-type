\import \parent.Endpoint[f := f] \as SourceEndpoint;
\import \parent.Endpoint[f := g] \as TargetEndpoint;
\import LeftMapping.With[f := f, g := identity] \as LeftForward;
\import LeftMapping.With[f := g, g := identity] \as LeftBackward;
\import RightMapping.With[f := identity, g := f] \as RightForward;
\import RightMapping.With[f := identity, g := g] \as RightBackward;
\import \parent.\parent.TensorHomotopyLeft[C := C, D := D, E := E].With[f := f, g := g, h := h] \as LeftHomotopy;
\import Chains.Homotopy[C := ReverseSource.complex, D := ReverseTarget.complex].Precompose[B := Source.complex].With[f := LeftForward.total, g := LeftBackward.total, h := LeftHomotopy.homotopy, k := SourceSwap.forward] \as Pre;
\import Chains.Homotopy[C := Source.complex, D := ReverseTarget.complex].Postcompose[E := Target.complex].With[f := Before.compose LeftForward.total SourceSwap.forward, g := Before.compose LeftBackward.total SourceSwap.forward, h := Pre.homotopy, k := TargetSwap.forward] \as Post;
\import Chains.Homotopy[C := Source.complex, D := Target.complex] \as Result;
\definition homotopy: Result.Homotopy RightForward.total RightBackward.total := \into[Result.Data](Post.data, Result.Homotopy RightForward.total RightBackward.total) \by {
  Result.replacementLaws SourceEndpoint.map TargetEndpoint.map RightForward.total RightBackward.total Post.data SourceEndpoint.equality TargetEndpoint.equality
    (\bysub(Result.Data, Result.Homotopy SourceEndpoint.map TargetEndpoint.map, Post.homotopy))
};
