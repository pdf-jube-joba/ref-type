\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Conjugate[] \as SignChange;
\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as TD;
\import Middle.Degree[n := n] \as MD;
\import Permutation.Degree[n := n] \as PermuteDegree;
\import \parent.\parent.Map[C := Signed.complex, D := Transposed.complex].Total[f := SignChange.map].Degree[n := n] \as Last;
\module At(i: Index n) {
  \import \parent.\parent.\parent.Sign[V := C.family.Carrier i.first i.second, space := C.family.space i.first i.second] \as Sign;
  \definition point: \forall (x: C.family.Carrier i.first i.second) ->
    forward.apply n ((SD.Component[i := i].injection).apply x) =
      (TD.Component[i := index n i].injection).apply ((Sign.map (Arithmetic.mul i.first i.second)).apply x) :=
    \fun (x: C.family.Carrier i.first i.second) => eq_reason_in!{TD.Carrier _
      "=" _ "by" { congr!{MD.Carrier TD.Carrier} ((SignChange.forward).apply n) _ _ (PermuteDegree.onInjection i x) }
      "=" _ "by" { Last.onInjection (index n i) x }
      "=" _ "by" { congr!{{C.family.Carrier i.first i.second} TD.Carrier} ((TD.Component[i := index n i].injection).apply) _ _
          (congr!{Nat.Nat^ {C.family.Carrier i.first i.second}} (\fun (k: Nat.Nat^) => (Sign.map k).apply x) _ _
            (Natural.mulComm i.second i.first)) }
    };
}
