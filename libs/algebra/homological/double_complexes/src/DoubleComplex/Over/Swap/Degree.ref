\import \parent.Conjugate[] \as SignChange;
\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as TD;
\import Middle.Degree[n := n] \as MD;
\import Permutation.Degree[n := n] \as PermuteDegree;
\import \parent.\parent.Map[C := Signed.complex, D := Transposed.complex].Total[f := SignChange.map].Degree[n := n] \as Last;
\module At(i: Index n) {
  \import \parent.\parent.\parent.Sign[V := C.family.Carrier #first{i} #second{i}, space := C.family.space #first{i} #second{i}] \as Sign;
  \definition point: \forall (x: C.family.Carrier #first{i} #second{i}) ->
    #apply{forward} n (#apply{(SD.Component[i := i].injection)} x) =
      #apply{(TD.Component[i := index n i].injection)} (#apply{(Sign.map (Arithmetic.mul #first{i} #second{i}))} x) :=
    \fun (x: C.family.Carrier #first{i} #second{i}) => trans!{TD.Carrier} _ _ _
      (congr!{MD.Carrier TD.Carrier} (#apply{(SignChange.forward)} n) _ _ (PermuteDegree.onInjection i x))
      (trans!{TD.Carrier} _ _ _ (Last.onInjection (index n i) x)
        (congr!{{C.family.Carrier #first{i} #second{i}} TD.Carrier} (#apply{(TD.Component[i := index n i].injection)}) _ _
          (congr!{Nat.Nat^ {C.family.Carrier #first{i} #second{i}}} (\fun (k: Nat.Nat^) => #apply{(Sign.map k)} x) _ _
            (Natural.mulComm #second{i} #first{i}))));
}
