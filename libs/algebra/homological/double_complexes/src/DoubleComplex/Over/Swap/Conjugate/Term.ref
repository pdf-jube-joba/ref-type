\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.Sign[V := C.family.Carrier q p, space := C.family.space q p] \as Sign;
\definition map: Modules.Hom[V := C.family.Carrier q p, W := C.family.Carrier q p,
  source := C.family.space q p, target := C.family.space q p].Map := Sign.map (Arithmetic.mul p q);
\definition involutive: \forall (x: C.family.Carrier q p) -> map.apply (map.apply x) = x := Sign.involutive (Arithmetic.mul p q);
\import \parent.\parent.\parent.Sign[V := C.family.Carrier q (Nat.Nat^::succ p), space := C.family.space q (Nat.Nat^::succ p)].Mapping[
  W := C.family.Carrier q p, target := C.family.space q p] \as Horizontal;
\import \parent.\parent.\parent.Sign[V := C.family.Carrier (Nat.Nat^::succ q) p, space := C.family.space (Nat.Nat^::succ q) p].Mapping[
  W := C.family.Carrier q p, target := C.family.space q p] \as Vertical;
\definition horizontalDegree: Arithmetic.mul (Nat.Nat^::succ p) q = Arithmetic.add (Arithmetic.mul p q) q :=
  trans!{Nat.Nat^} _ _ _ (Natural.mulSuccLeft p q) (Natural.addComm q (Arithmetic.mul p q));
\definition verticalDegree: Arithmetic.mul p (Nat.Nat^::succ q) = Arithmetic.add (Arithmetic.mul p q) p :=
  Natural.addComm p (Arithmetic.mul p q);
\definition horizontal: \forall (x: C.family.Carrier q (Nat.Nat^::succ p)) ->
  (Transposed.differential.horizontal p q).apply ((\parent.Term[p := Nat.Nat^::succ p, q := q].map).apply x) =
    map.apply ((Signed.differential.horizontal p q).apply x) :=
  \fun (x: C.family.Carrier q (Nat.Nat^::succ p)) => eq_reason_in!{{C.family.Carrier q p} _
    "=" _ "by" { Horizontal.naturality (C.differential.vertical q p) (Arithmetic.mul (Nat.Nat^::succ p) q) x }
    "=" _ "by" { congr!{Nat.Nat^ {C.family.Carrier q p}} (\fun (k: Nat.Nat^) => (Sign.map k).apply ((C.differential.vertical q p).apply x)) _ _ horizontalDegree }
    "=" _ "by" { Sign.addition (Arithmetic.mul p q) q ((C.differential.vertical q p).apply x) }
  };
\definition vertical: \forall (x: C.family.Carrier (Nat.Nat^::succ q) p) ->
  (Transposed.differential.vertical p q).apply ((\parent.Term[p := p, q := Nat.Nat^::succ q].map).apply x) =
    map.apply ((Signed.differential.vertical p q).apply x) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ q) p) => eq_reason_in!{{C.family.Carrier q p} _
    "=" _ "by" { Vertical.naturality (C.differential.horizontal q p) (Arithmetic.mul p (Nat.Nat^::succ q)) x }
    "=" _ "by" { congr!{Nat.Nat^ {C.family.Carrier q p}} (\fun (k: Nat.Nat^) => (Sign.map k).apply ((C.differential.horizontal q p).apply x)) _ _ verticalDegree }
    "=" _ "by" { Sign.addition (Arithmetic.mul p q) p ((C.differential.horizontal q p).apply x) }
  };
