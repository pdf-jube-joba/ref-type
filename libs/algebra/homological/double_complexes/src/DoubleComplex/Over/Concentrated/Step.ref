\import Total.Degree[n := n] \as Current;
\import Total.Degree[n := Nat.Nat^::succ n] \as Next;
\import Total.Step[n := n] \as TotalStep;
\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := Nat.Nat^::succ n] \as Upper;
\import Modules.Laws[V := Current.Carrier, space := Current.space] \as Laws;
\import algebra.Group[].Of[Carrier := Current.Carrier, group := Laws.additive] \as Group;
\definition backward: \forall (x: C.family.Carrier (Nat.Nat^::succ n) Nat.Nat^::zero) ->
  Total.differential.apply n (Upper.backward.apply x) =
  Lower.backward.apply ((C.differential.horizontal n Nat.Nat^::zero).apply x) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ n) Nat.Nat^::zero) => trans!{Current.Carrier} _ _ _
    (TotalStep.onComponent (point (Nat.Nat^::succ n)) x)
    (Group.zeroRight (Lower.backward.apply ((C.differential.horizontal n Nat.Nat^::zero).apply x)));
\definition forward: Vanishes -> \forall (x: Next.Carrier) ->
  (C.differential.horizontal n Nat.Nat^::zero).apply (Upper.forward.apply x) =
  Lower.forward.apply (Total.differential.apply n x) :=
  \fun (vanishes: Vanishes)(x: Next.Carrier) => trans!{{C.family.Carrier n Nat.Nat^::zero}} _ _ _
    (sym!{{C.family.Carrier n Nat.Nat^::zero}} _ _
      (trans!{{C.family.Carrier n Nat.Nat^::zero}} _ _ _
        (congr!{Current.Carrier {C.family.Carrier n Nat.Nat^::zero}} (Lower.forward.apply) _ _ (backward (Upper.forward.apply x)))
        (Lower.rightInverse ((C.differential.horizontal n Nat.Nat^::zero).apply (Upper.forward.apply x)))))
    (congr!{Next.Carrier {C.family.Carrier n Nat.Nat^::zero}}
      (\fun (y: Next.Carrier) => Lower.forward.apply (Total.differential.apply n y)) _ _ (Upper.leftInverse vanishes x));
