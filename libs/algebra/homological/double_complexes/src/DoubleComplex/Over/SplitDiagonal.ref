\import Modules.DirectSum[Index := Index, family := left] \as Left;
\import Modules.DirectSum[Index := Index, family := middle] \as Middle;
\import Modules.DirectSum[Index := Index, family := right] \as Right;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := left, targetFamily := middle] \as Inclusions;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := middle, targetFamily := right] \as Projections;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := middle, targetFamily := left] \as Retractions;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := right, targetFamily := middle] \as Sections;
\definition InclusionComponents: \Set := Inclusions.Components;
\definition ProjectionComponents: \Set := Projections.Components;
\definition RetractionComponents: \Set := Retractions.Components;
\definition SectionComponents: \Set := Sections.Components;
\module With(i: Inclusions.Components, p: Projections.Components, r: Retractions.Components, s: Sections.Components);
