\definition Carrier[n: Nat.Nat^][z: Degree]: \Set := model.family.Carrier n z;
\definition space[n: Nat.Nat^][z: Degree]: Modules.Space (Carrier n z) := model.family.space n z;
\module At(n: Nat.Nat^) {
  \import Modules.Laws[V := Carrier n (degree n), space := space n (degree n)] \as Values;
  \import algebra.Group[].Of[Carrier := Carrier n (degree n), group := Values.additive] \as Group;
  \definition difference: Carrier n (degree n) -> Carrier n (degree n) -> Carrier n (degree n) := Group.difference;
  \definition self: \forall (x: Carrier n (degree n)) -> difference x x = (space n (degree n)).zero := Group.inverseRight;
}
\definition value: \forall (n: Nat.Nat^) -> Carrier n (degree (Nat.Nat^::succ n)) :=
  \induction (n: Nat.Nat^) \return Carrier n (degree (Nat.Nat^::succ n)) \with {
    | zero: (fillings.operator Nat.Nat^::zero).apply (At[n := Nat.Nat^::zero].difference (cells.value Nat.Nat^::zero) (space Nat.Nat^::zero (degree Nat.Nat^::zero)).zero)
    | succ: \fun (n: Nat.Nat^)(previous: Carrier n (degree (Nat.Nat^::succ n))) =>
      (fillings.operator (Nat.Nat^::succ n)).apply (At[n := Nat.Nat^::succ n].difference (cells.value (Nat.Nat^::succ n)) ((model.operators.transition n (degree (Nat.Nat^::succ n))).apply previous))
  };
\definition preceding: \forall (n: Nat.Nat^) -> Carrier n (degree n) :=
  \induction (n: Nat.Nat^) \return Carrier n (degree n) \with {
    | zero: (space Nat.Nat^::zero (degree Nat.Nat^::zero)).zero
    | succ: \fun (n: Nat.Nat^)(unused: Carrier n (degree n)) => (model.operators.transition n (degree (Nat.Nat^::succ n))).apply (value n)
  };
\definition obstruction[n: Nat.Nat^]: Carrier n (degree n) := At[n := n].difference (cells.value n) (preceding n);
\definition recursion: \forall (n: Nat.Nat^) -> value n = (fillings.operator n).apply (obstruction n) :=
  \induction (n: Nat.Nat^) \return value n = (fillings.operator n).apply (obstruction n) \with {
    | zero: \refl(value Nat.Nat^::zero)
    | succ: \fun (n: Nat.Nat^)(unused: value n = (fillings.operator n).apply (obstruction n)) => \refl(value (Nat.Nat^::succ n))
  };
\definition Property[n: Nat.Nat^]: \Prop := (model.operators.boundary n (degree (Nat.Nat^::succ n))).apply (value n) = obstruction n;
\module Preceding(n: Nat.Nat^);
\module Zero;
\module Step(n: Nat.Nat^);
\definition boundary: \forall (n: Nat.Nat^) -> Property n := \induction (n: Nat.Nat^) \return Property n \with {
  | zero: Zero[].law
  | succ: \fun (n: Nat.Nat^)(previous: Property n) => Step[n := n].law previous
};
