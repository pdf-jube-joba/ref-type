\definition n: Nat.Nat^ := Nat.Nat^::zero;
\definition target: Degree := Degrees.previous (degree n);
\import Modules.Hom[V := Carrier n (degree n), W := Carrier n target, source := space n (degree n), target := space n target] \as Differential;
\import Modules.Laws[V := Carrier n target, space := space n target] \as Values;
\import algebra.Group[].Of[Carrier := Carrier n target, group := Values.additive] \as Group;
\definition closed: #apply{(model.operators.boundary n (degree n))} (obstruction n) = #zero{(space n target)} :=
  trans!{{Carrier n target}} _ _ _ (Differential.differencePreserved (model.operators.boundary n (degree n)) (cells.value n) #zero{(space n (degree n))})
    (trans!{{Carrier n target}} _ _ _
      (congr2!{{Carrier n target} {Carrier n target} {Carrier n target}} Group.difference _ _ _ _ cells.zero (Differential.zeroPreserved (model.operators.boundary n (degree n))))
      (Group.inverseRight #zero{(space n target)}));
\definition law: Property n := trans!{{Carrier n (degree n)}} _ _ _
  (congr!{{Carrier n (degree (Nat.Nat^::succ n))} {Carrier n (degree n)}} (#apply{(model.operators.boundary n (degree (Nat.Nat^::succ n)))}) _ _ (recursion n))
  (fillings.boundary n (obstruction n) closed);
