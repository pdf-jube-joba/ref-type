\use std.Logic[].Equality[].eq_reason_in;
\definition n: Nat.Nat^ := Nat.Nat^::zero;
\definition target: Degree := Degrees.previous (degree n);
\import Modules.Hom[V := Carrier n (degree n), W := Carrier n target, source := space n (degree n), target := space n target] \as Differential;
\import Modules.Laws[V := Carrier n target, space := space n target] \as Values;
\import algebra.Group[].Of[Carrier := Carrier n target, group := Values.additive] \as Group;
\definition closed: (model.operators.boundary n (degree n)).apply (obstruction n) = (space n target).zero :=
  eq_reason_in!{{Carrier n target} _
    "=" _ "by" { Differential.differencePreserved (model.operators.boundary n (degree n)) (cells.value n) (space n (degree n)).zero }
    "=" _ "by" { congr!{{Carrier n target} {Carrier n target} {Carrier n target}} Group.difference _ _ _ _ cells.zero (Differential.zeroPreserved (model.operators.boundary n (degree n))) }
    "=" _ "by" { Group.inverseRight (space n target).zero }
  };
\definition law: Property n := trans!{{Carrier n (degree n)}} _ _ _
  (congr!{{Carrier n (degree (Nat.Nat^::succ n))} {Carrier n (degree n)}} ((model.operators.boundary n (degree (Nat.Nat^::succ n))).apply) _ _ (recursion n))
  (fillings.boundary n (obstruction n) closed);
