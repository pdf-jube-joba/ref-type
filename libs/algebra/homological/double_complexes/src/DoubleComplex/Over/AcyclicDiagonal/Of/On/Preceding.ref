\definition Property(k: Nat.Nat^): \Prop := #apply{(model.operators.transition k (degree k))} (preceding k) = #zero{(space (Nat.Nat^::succ k) (degree k))};
\definition all: \forall (k: Nat.Nat^) -> Property k := \induction (k: Nat.Nat^) \return Property k \with {
  | zero: Modules.Hom[V := Carrier Nat.Nat^::zero (degree Nat.Nat^::zero), W := Carrier (Nat.Nat^::succ Nat.Nat^::zero) (degree Nat.Nat^::zero), source := space Nat.Nat^::zero (degree Nat.Nat^::zero), target := space (Nat.Nat^::succ Nat.Nat^::zero) (degree Nat.Nat^::zero)].zeroPreserved (model.operators.transition Nat.Nat^::zero (degree Nat.Nat^::zero))
  | succ: \fun (k: Nat.Nat^)(unused: Property k) => #transitionSquare{model.laws} k (degree (Nat.Nat^::succ k)) (value k)
};
\definition law: Property n := all n;
