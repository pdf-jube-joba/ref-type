\structure Fillings: \Set := {
  operator: \forall (n: Nat.Nat^) -> Modules.Hom[V := model.family.Carrier n (degree n), W := model.family.Carrier n (degree (Nat.Nat^::succ n)), source := model.family.space n (degree n), target := model.family.space n (degree (Nat.Nat^::succ n))].Map,
  boundary: \forall (n: Nat.Nat^)(x: model.family.Carrier n (degree n)) -> (model.operators.boundary n (degree n)).apply x = (model.family.space n (Degrees.previous (degree n))).zero ->
    (model.operators.boundary n (degree (Nat.Nat^::succ n))).apply ((operator n).apply x) = x,
};
\structure ClosedDiagonal: \Set := {
  value: \forall (n: Nat.Nat^) -> model.family.Carrier n (degree n),
  zero: (model.operators.boundary Nat.Nat^::zero (degree Nat.Nat^::zero)).apply (value Nat.Nat^::zero) = (model.family.space Nat.Nat^::zero (Degrees.previous (degree Nat.Nat^::zero))).zero,
  successor: \forall (n: Nat.Nat^) -> (model.operators.boundary (Nat.Nat^::succ n) (degree (Nat.Nat^::succ n))).apply (value (Nat.Nat^::succ n)) = (model.operators.transition n (degree n)).apply (value n),
};
\module On(fillings: Fillings, cells: ClosedDiagonal);
\structure PositiveFillings: \Set := {
  operator: \forall (n: Nat.Nat^) -> Modules.Hom[V := model.family.Carrier (Nat.Nat^::succ n) (degree (Nat.Nat^::succ n)), W := model.family.Carrier (Nat.Nat^::succ n) (degree (Nat.Nat^::succ (Nat.Nat^::succ n))), source := model.family.space (Nat.Nat^::succ n) (degree (Nat.Nat^::succ n)), target := model.family.space (Nat.Nat^::succ n) (degree (Nat.Nat^::succ (Nat.Nat^::succ n)))].Map,
  boundary: \forall (n: Nat.Nat^)(x: model.family.Carrier (Nat.Nat^::succ n) (degree (Nat.Nat^::succ n))) ->
    (model.operators.boundary (Nat.Nat^::succ n) (degree (Nat.Nat^::succ n))).apply x = (model.family.space (Nat.Nat^::succ n) (degree n)).zero ->
    (model.operators.boundary (Nat.Nat^::succ n) (degree (Nat.Nat^::succ (Nat.Nat^::succ n)))).apply ((operator n).apply x) = x,
};
\module Positive(fillings: PositiveFillings, cells: ClosedDiagonal);
