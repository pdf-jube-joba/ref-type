\structure Fillings: \Set {
  operator: \forall (n: Nat.Nat^) -> Modules.Hom[V := model.family.Carrier n (degree n), W := model.family.Carrier n (degree (Nat.Nat^::succ n)), source := model.family.space n (degree n), target := model.family.space n (degree (Nat.Nat^::succ n))].Map,
  boundary: \forall (n: Nat.Nat^)(x: model.family.Carrier n (degree n)) -> #apply{(model.operators.boundary n (degree n))} x = #zero{(model.family.space n (Degrees.previous (degree n)))} ->
    #apply{(model.operators.boundary n (degree (Nat.Nat^::succ n)))} (#apply{(operator n)} x) = x,
}
\structure ClosedDiagonal: \Set {
  value: \forall (n: Nat.Nat^) -> model.family.Carrier n (degree n),
  zero: #apply{(model.operators.boundary Nat.Nat^::zero (degree Nat.Nat^::zero))} (value Nat.Nat^::zero) = #zero{(model.family.space Nat.Nat^::zero (Degrees.previous (degree Nat.Nat^::zero)))},
  successor: \forall (n: Nat.Nat^) -> #apply{(model.operators.boundary (Nat.Nat^::succ n) (degree (Nat.Nat^::succ n)))} (value (Nat.Nat^::succ n)) = #apply{(model.operators.transition n (degree n))} (value n),
}
\module On(fillings: Fillings, cells: ClosedDiagonal);
