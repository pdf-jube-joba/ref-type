\definition k: Nat.Nat^ := Nat.Nat^::succ n;
\definition z: Degree := degree n;
\import \parent.Preceding[n := n] \as Earlier;
\import Modules.Laws[V := Carrier k z, space := space k z] \as Values;
\import algebra.Group[].Of[Carrier := Carrier k z, group := Values.additive] \as Group;
\import Modules.Hom[V := Carrier n z, W := Carrier k z, source := space n z, target := space k z] \as Transition;
\import Modules.Hom[V := Carrier k (degree k), W := Carrier k z, source := space k (degree k), target := space k z] \as Differential;
\definition minusZero(x: Carrier k z): Group.difference x #zero{(space k z)} = x :=
  trans!{{Carrier k z}} _ _ _ (congr!{{Carrier k z} {Carrier k z}} (Values.add x) _ _ Group.negZero) (Group.zeroRight x);
\definition remainder: #apply{(model.operators.transition n z)} (obstruction n) = #apply{(model.operators.transition n z)} (cells.value n) :=
  trans!{{Carrier k z}} _ _ _ (Transition.differencePreserved (model.operators.transition n z) (cells.value n) (preceding n))
    (trans!{{Carrier k z}} _ _ _
      (congr!{{Carrier k z} {Carrier k z}} (Group.difference (#apply{(model.operators.transition n z)} (cells.value n))) _ _ Earlier.law)
      (minusZero (#apply{(model.operators.transition n z)} (cells.value n))));
\definition precedingBoundary: Property n -> #apply{(model.operators.boundary k (degree k))} (preceding k) = #apply{(model.operators.transition n z)} (cells.value n) :=
  \fun (previous: Property n) => trans!{{Carrier k z}} _ _ _
    (#commutes{model.laws} n (degree k) (value n))
    (trans!{{Carrier k z}} _ _ _
      (congr!{{Carrier n z} {Carrier k z}} (#apply{(model.operators.transition n z)}) _ _ previous) remainder);
\definition closed: Property n -> #apply{(model.operators.boundary k (degree k))} (obstruction k) = #zero{(space k z)} :=
  \fun (previous: Property n) => trans!{{Carrier k z}} _ _ _
    (Differential.differencePreserved (model.operators.boundary k (degree k)) (cells.value k) (preceding k))
    (trans!{{Carrier k z}} _ _ _
      (congr2!{{Carrier k z} {Carrier k z} {Carrier k z}} Group.difference _ _ _ _ (cells.successor n) (precedingBoundary previous))
      (Group.inverseRight (#apply{(model.operators.transition n z)} (cells.value n))));
\definition law: Property n -> Property k := \fun (previous: Property n) => trans!{{Carrier k (degree k)}} _ _ _
  (congr!{{Carrier k (degree (Nat.Nat^::succ k))} {Carrier k (degree k)}} (#apply{(model.operators.boundary k (degree (Nat.Nat^::succ k)))}) _ _ (recursion n))
  (fillings.boundary n (obstruction k) (closed previous));
