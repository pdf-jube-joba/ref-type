\import \parent.Map[C := C, D := D] \as Maps;
\import \parent.Total[C := C] \as Total;
\import \parent.Total[C := D] \as Target;
\import \parent.SignedTranspose[C := C] \as TransposedSource;
\import \parent.SignedTranspose[C := D] \as TransposedTarget;
\import \parent.Total[C := TransposedSource.complex] \as SourceTransposeTotal;
\import \parent.Total[C := TransposedTarget.complex] \as TargetTransposeTotal;
\import \parent.Collapse[C := TransposedSource.complex, D := TransposedTarget.complex] \as VerticalCollapse;
\import \parent.ConcentratedFirst[C := D] \as Concentrated;
\structure RowsExact[f: Maps.Map]: \Prop {
  augmentation: \forall (q: Nat.Nat^)(x: C.family.Carrier Nat.Nat^::zero q) ->
    #apply{(f Nat.Nat^::zero q)} x = #zero{(D.family.space Nat.Nat^::zero q)} ->
    \exists { y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) q \where #apply{(C.differential.horizontal Nat.Nat^::zero q)} y = x },
  positive: \forall (p, q: Nat.Nat^)(x: C.family.Carrier (Nat.Nat^::succ p) q) ->
    #apply{(C.differential.horizontal p q)} x = #zero{(C.family.space p q)} ->
    \exists { y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ p)) q \where #apply{(C.differential.horizontal (Nat.Nat^::succ p) q)} y = x },
}
\module Differential(p, q: Nat.Nat^);
\module On(f: Maps.Map);
