\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as RD;
\import MappedTotal.Degree[n := n] \as MD;
\import FinalTotal.Degree[n := n] \as FD;
\import \parent.\parent.\parent.Degree[n := n] \as OriginalSwapDegree;
\import TargetSwap.Degree[n := n] \as TargetSwapDegree;
\import \parent.\parent.\parent.\parent.Map[C := Original.complex, D := Mapped.complex].Total[f := OriginalMapping.map].Degree[n := n] \as MappingDegree;
\import \parent.\parent.\parent.\parent.Map[C := Opposite.complex, D := Final.complex].Total[f := ReverseMapping.map].Degree[n := n] \as ReverseDegree;
\import Chains.Map[C := Source.complex, D := FinalTotal.complex].At[n := n] \as LinearMaps;
\import Modules.Hom[V := SD.Carrier, W := FD.Carrier, source := SD.space, target := FD.space] \as Linear;
\definition afterLinear: Linear.Map := LinearMaps.linear after;
\definition beforeLinear: Linear.Map := LinearMaps.linear before;
\module Component(i: Index n);
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := FD.Carrier, target := FD.space] \as Universal;
\definition equality: afterLinear = beforeLinear := Universal.ext afterLinear beforeLinear
  (\fun (i: Index n) => Component[i := i].point);
\definition point: \forall (x: SD.Carrier) -> after.apply n x = before.apply n x :=
  \fun (x: SD.Carrier) => congr!{{Linear.Map} FD.Carrier} (\fun (m: Linear.Map) => m.apply x) _ _ equality;
