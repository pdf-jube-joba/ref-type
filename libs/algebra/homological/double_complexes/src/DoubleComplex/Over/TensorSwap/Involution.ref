\import \parent.\parent.TensorSwap[C := D, D := C] \as Reverse;
\module Degree(n: Nat.Nat^);
\definition twice: \forall (n: Nat.Nat^)(x: Source.Carrier n) -> #apply{Reverse.forward} n (#apply{forward} n x) = x :=
  \fun (n: Nat.Nat^) => Degree[n := n].point;
\import Chains.Map[C := Target.complex, D := Source.complex].Composition[B := Source.complex] \as Compose;
\definition equality: Compose.compose Reverse.forward forward = Chains.End[C := Source.complex].identity :=
  Chains.Map[C := Source.complex, D := Source.complex].ext (Compose.compose Reverse.forward forward)
    Chains.End[C := Source.complex].identity twice;
