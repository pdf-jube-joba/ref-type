\use std.Logic[].Equality[].eq_reason_in;
\import Original.Term[p := i.first, q := i.second] \as Tensor;
\import OriginalMapping.Degree[p := i.first, q := i.second] \as MappingTerm;
\import ReverseMapping.Degree[p := i.second, q := i.first] \as ReverseTerm;
\import \parent.\parent.\parent.\parent.\parent.Sign[V := Opposite.Carrier i.second i.first, space := Opposite.space i.second i.first].Mapping[
  W := Final.Carrier i.second i.first, target := Final.space i.second i.first] \as NaturalSign;
\import \parent.\parent.\parent.\parent.\parent.Sign[V := Final.Carrier i.second i.first, space := Final.space i.second i.first] \as Sign;
\definition afterOnTensor: \forall (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) ->
  after.apply n ((SD.Component[i := i].injection).apply (Tensor.tensor x y)) =
    (FD.Component[i := index n i].injection).apply
      ((Sign.map (Arithmetic.mul i.first i.second)).apply
        (Final.Term[p := i.second, q := i.first].tensor (g.apply i.second y) (f.apply i.first x))) :=
  \fun (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) => eq_reason_in!{FD.Carrier _
    "=" _ "by" { congr!{RD.Carrier FD.Carrier} (ReverseMapping.total.apply n) _ _ (OriginalSwapDegree.At[i := i].onTensor x y) }
    "=" _ "by" { ReverseDegree.onInjection (index n i)
        ((\parent.\parent.\parent.\parent.\parent.Sign[V := Opposite.Carrier i.second i.first, space := Opposite.space i.second i.first].map
          (Arithmetic.mul i.first i.second)).apply (Opposite.Term[p := i.second, q := i.first].tensor y x)) }
    "=" _ "by" { congr!{{Final.Carrier i.second i.first} FD.Carrier} ((FD.Component[i := index n i].injection).apply) _ _
        (trans!{{Final.Carrier i.second i.first}} _ _ _
          (NaturalSign.naturality ReverseTerm.map (Arithmetic.mul i.first i.second) (Opposite.Term[p := i.second, q := i.first].tensor y x))
          (congr!{{Final.Carrier i.second i.first} {Final.Carrier i.second i.first}} ((Sign.map (Arithmetic.mul i.first i.second)).apply) _ _
            (ReverseTerm.onTensor y x))) }
  };
\definition beforeOnTensor: \forall (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) ->
  before.apply n ((SD.Component[i := i].injection).apply (Tensor.tensor x y)) =
    (FD.Component[i := index n i].injection).apply
      ((Sign.map (Arithmetic.mul i.first i.second)).apply
        (Final.Term[p := i.second, q := i.first].tensor (g.apply i.second y) (f.apply i.first x))) :=
  \fun (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) => eq_reason_in!{FD.Carrier _
    "=" _ "by" { congr!{MD.Carrier FD.Carrier} (TargetSwap.forward.apply n) _ _ (MappingDegree.onInjection i (Tensor.tensor x y)) }
    "=" _ "by" { congr!{{Mapped.Carrier i.first i.second} FD.Carrier}
        (\fun (z: Mapped.Carrier i.first i.second) => TargetSwap.forward.apply n ((MD.Component[i := i].injection).apply z)) _ _
        (MappingTerm.onTensor x y) }
    "=" _ "by" { TargetSwapDegree.At[i := i].onTensor (f.apply i.first x) (g.apply i.second y) }
  };
\import Modules.Hom[V := SD.Carrier, W := FD.Carrier, source := SD.space, target := FD.space].Composition[
  U := Tensor.Carrier, domain := Tensor.space] \as Compose;
\definition afterComponent: Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map := Compose.compose afterLinear SD.Component[i := i].injection;
\definition beforeComponent: Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map := Compose.compose beforeLinear SD.Component[i := i].injection;
\import Modules.Tensor[V := C.family.Carrier i.first, W := D.family.Carrier i.second, left := C.family.space i.first, right := D.family.space i.second].Universal[U := FD.Carrier, target := FD.space] \as Universal;
\definition equality: afterComponent = beforeComponent := Universal.ext afterComponent beforeComponent
  (\fun (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) => trans!{FD.Carrier} _ _ _ (afterOnTensor x y) (sym!{FD.Carrier} _ _ (beforeOnTensor x y)));
\definition point: \forall (x: Tensor.Carrier) -> afterLinear.apply ((SD.Component[i := i].injection).apply x) = beforeLinear.apply ((SD.Component[i := i].injection).apply x) :=
  \fun (x: Tensor.Carrier) => congr!{{Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map} FD.Carrier}
    (\fun (m: Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map) => m.apply x) _ _ equality;
