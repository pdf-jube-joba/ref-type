\import Original.Term[p := #first{i}, q := #second{i}] \as Tensor;
\import OriginalMapping.Degree[p := #first{i}, q := #second{i}] \as MappingTerm;
\import ReverseMapping.Degree[p := #second{i}, q := #first{i}] \as ReverseTerm;
\import \parent.\parent.\parent.\parent.\parent.Sign[V := Opposite.Carrier #second{i} #first{i}, space := Opposite.space #second{i} #first{i}].Mapping[
  W := Final.Carrier #second{i} #first{i}, target := Final.space #second{i} #first{i}] \as NaturalSign;
\import \parent.\parent.\parent.\parent.\parent.Sign[V := Final.Carrier #second{i} #first{i}, space := Final.space #second{i} #first{i}] \as Sign;
\definition afterOnTensor: \forall (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) ->
  #apply{after} n (#apply{(SD.Component[i := i].injection)} (Tensor.tensor x y)) =
    #apply{(FD.Component[i := index n i].injection)}
      (#apply{(Sign.map (Arithmetic.mul #first{i} #second{i}))}
        (Final.Term[p := #second{i}, q := #first{i}].tensor (#apply{g} #second{i} y) (#apply{f} #first{i} x))) :=
  \fun (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) => trans!{FD.Carrier} _ _ _
    (congr!{RD.Carrier FD.Carrier} (#apply{ReverseMapping.total} n) _ _ (OriginalSwapDegree.At[i := i].onTensor x y))
    (trans!{FD.Carrier} _ _ _
      (ReverseDegree.onInjection (index n i)
        (#apply{(\parent.\parent.\parent.\parent.\parent.Sign[V := Opposite.Carrier #second{i} #first{i}, space := Opposite.space #second{i} #first{i}].map
          (Arithmetic.mul #first{i} #second{i}))} (Opposite.Term[p := #second{i}, q := #first{i}].tensor y x)))
      (congr!{{Final.Carrier #second{i} #first{i}} FD.Carrier} (#apply{(FD.Component[i := index n i].injection)}) _ _
        (trans!{{Final.Carrier #second{i} #first{i}}} _ _ _
          (NaturalSign.naturality ReverseTerm.map (Arithmetic.mul #first{i} #second{i}) (Opposite.Term[p := #second{i}, q := #first{i}].tensor y x))
          (congr!{{Final.Carrier #second{i} #first{i}} {Final.Carrier #second{i} #first{i}}} (#apply{(Sign.map (Arithmetic.mul #first{i} #second{i}))}) _ _
            (ReverseTerm.onTensor y x)))));
\definition beforeOnTensor: \forall (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) ->
  #apply{before} n (#apply{(SD.Component[i := i].injection)} (Tensor.tensor x y)) =
    #apply{(FD.Component[i := index n i].injection)}
      (#apply{(Sign.map (Arithmetic.mul #first{i} #second{i}))}
        (Final.Term[p := #second{i}, q := #first{i}].tensor (#apply{g} #second{i} y) (#apply{f} #first{i} x))) :=
  \fun (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) => trans!{FD.Carrier} _ _ _
    (congr!{MD.Carrier FD.Carrier} (#apply{TargetSwap.forward} n) _ _ (MappingDegree.onInjection i (Tensor.tensor x y)))
    (trans!{FD.Carrier} _ _ _
      (congr!{{Mapped.Carrier #first{i} #second{i}} FD.Carrier}
        (\fun (z: Mapped.Carrier #first{i} #second{i}) => #apply{TargetSwap.forward} n (#apply{(MD.Component[i := i].injection)} z)) _ _
        (MappingTerm.onTensor x y))
      (TargetSwapDegree.At[i := i].onTensor (#apply{f} #first{i} x) (#apply{g} #second{i} y)));
\import Modules.Hom[V := SD.Carrier, W := FD.Carrier, source := SD.space, target := FD.space].Composition[
  U := Tensor.Carrier, domain := Tensor.space] \as Compose;
\definition afterComponent: Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map := Compose.compose afterLinear SD.Component[i := i].injection;
\definition beforeComponent: Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map := Compose.compose beforeLinear SD.Component[i := i].injection;
\import Modules.Tensor[V := C.family.Carrier #first{i}, W := D.family.Carrier #second{i}, left := C.family.space #first{i}, right := D.family.space #second{i}].Universal[U := FD.Carrier, target := FD.space] \as Universal;
\definition equality: afterComponent = beforeComponent := Universal.ext afterComponent beforeComponent
  (\fun (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) => trans!{FD.Carrier} _ _ _ (afterOnTensor x y) (sym!{FD.Carrier} _ _ (beforeOnTensor x y)));
\definition point: \forall (x: Tensor.Carrier) -> #apply{afterLinear} (#apply{(SD.Component[i := i].injection)} x) = #apply{beforeLinear} (#apply{(SD.Component[i := i].injection)} x) :=
  \fun (x: Tensor.Carrier) => congr!{{Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map} FD.Carrier}
    (\fun (m: Modules.Hom[V := Tensor.Carrier, W := FD.Carrier, source := Tensor.space, target := FD.space].Map) => #apply{m} x) _ _ equality;
