\import \parent.\parent.\parent.Tensor[C := E, D := F] \as Mapped;
\import \parent.\parent.\parent.Tensor[C := F, D := E] \as Final;
\import \parent.\parent.\parent.TensorSwap[C := E, D := F] \as TargetSwap;
\import \parent.\parent.\parent.TensorMapping[C := C, D := E, E := D, F := F].With[f := f, g := g] \as OriginalMapping;
\import \parent.\parent.\parent.TensorMapping[C := D, D := F, E := C, F := E].With[f := g, g := f] \as ReverseMapping;
\import \parent.\parent.\parent.Total[C := Mapped.complex] \as MappedTotal;
\import \parent.\parent.\parent.Total[C := Final.complex] \as FinalTotal;
\import Chains.Map[C := Target.complex, D := FinalTotal.complex].Composition[B := Source.complex] \as LeftCompose;
\import Chains.Map[C := MappedTotal.complex, D := FinalTotal.complex].Composition[B := Source.complex] \as RightCompose;
\definition after: Chains.Map[C := Source.complex, D := FinalTotal.complex].Map := LeftCompose.compose ReverseMapping.total forward;
\definition before: Chains.Map[C := Source.complex, D := FinalTotal.complex].Map := RightCompose.compose TargetSwap.forward OriginalMapping.total;
\module Degree(n: Nat.Nat^);
\definition square: after = before := Chains.Map[C := Source.complex, D := FinalTotal.complex].ext after before
  (\fun (n: Nat.Nat^) => Degree[n := n].point);
