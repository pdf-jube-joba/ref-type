\use std.Logic[].Equality[].eq_reason_in;
\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as TD;
\import \parent.\parent.Degree[n := n] \as OriginalDegree;
\import Reverse.Degree[n := n] \as ReverseDegree;
\import Modules.Hom[V := Source.Carrier n, W := Source.Carrier n, source := Source.space n, target := Source.space n] \as Linear;
\definition composite: Linear.Map := Linear.Map {
  apply := \fun (x: SD.Carrier) => Reverse.forward.apply n (forward.apply n x),
  addition := \fun (x, y: SD.Carrier) => trans!{SD.Carrier} _ _ _
    (congr!{TD.Carrier SD.Carrier} (Reverse.forward.apply n) _ _ (forward.addition n x y))
    (Reverse.forward.addition n (forward.apply n x) (forward.apply n y)),
  scalar := \fun (a: R)(x: SD.Carrier) => trans!{SD.Carrier} _ _ _
    (congr!{TD.Carrier SD.Carrier} (Reverse.forward.apply n) _ _ (forward.scalar n a x))
    (Reverse.forward.scalar n a (forward.apply n x)),
};
\definition topIndex[i: Pair][closed: Arithmetic.add i.first i.second = n]: Index n :=
  \into[Pair](i, { j: Pair \where Arithmetic.add j.first j.second = n }) \by { closed };
\module PairWitness(p, q: Nat.Nat^) {
  \import \parent.\parent.\parent.Term[p := p, q := q] \as SignedTerm;
  \definition i[closed: Arithmetic.add p q = n]: Index n := topIndex (Pair::# p q) closed;
  \definition point: \forall (closed: Arithmetic.add p q = n)(x: Original.Carrier p q) ->
    composite.apply ((SD.Component[i := i closed].injection).apply x) = (SD.Component[i := i closed].injection).apply x :=
    \fun (closed: Arithmetic.add p q = n)(x: Original.Carrier p q) => eq_reason_in!{SD.Carrier _
      "=" _ "by" { congr!{TD.Carrier SD.Carrier} (Reverse.forward.apply n) _ _ (OriginalDegree.At[i := i closed].onInjection x) }
      "=" _ "by" { ReverseDegree.At[i := index n (i closed)].onInjection (SignedTerm.map.apply x) }
      "=" _ "by" { congr!{{Original.Carrier p q} SD.Carrier} ((SD.Component[i := i closed].injection).apply) _ _ (SignedTerm.twice x) }
    };
}
\definition onPair: \forall (i: Pair)(closed: Arithmetic.add i.first i.second = n)(x: Original.Carrier i.first i.second) ->
  composite.apply ((SD.Component[i := topIndex i closed].injection).apply x) = (SD.Component[i := topIndex i closed].injection).apply x :=
  \induction (i: Pair) \return \forall (closed: Arithmetic.add i.first i.second = n)(x: Original.Carrier i.first i.second) ->
    composite.apply ((SD.Component[i := topIndex i closed].injection).apply x) = (SD.Component[i := topIndex i closed].injection).apply x \with {
      | # : \fun (p, q: Nat.Nat^)(closed: Arithmetic.add p q = n) => PairWitness[p := p, q := q].point closed
    };
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := SD.Carrier, target := SD.space] \as Universal;
\import Modules.End[V := SD.Carrier, space := SD.space] \as Identity;
\definition equality: composite = Identity.identity := Universal.ext composite Identity.identity
  (\fun (i: Index n) => onPair i (degree n i));
\definition point: \forall (x: SD.Carrier) -> Reverse.forward.apply n (forward.apply n x) = x :=
  \fun (x: SD.Carrier) => congr!{Linear.Map SD.Carrier} (\fun (f: Linear.Map) => f.apply x) _ _ equality;
