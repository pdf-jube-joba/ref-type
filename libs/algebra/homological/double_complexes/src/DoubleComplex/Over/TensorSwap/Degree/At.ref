\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.Sign[V := Opposite.Carrier i.second i.first, space := Opposite.space i.second i.first] \as TargetSign;
\import \parent.\parent.Term[p := i.first, q := i.second] \as SignedSymmetry;
\import \parent.\parent.\parent.Sign[V := Original.Carrier i.first i.second, space := Original.space i.first i.second] \as SourceSign;
\definition onInjection: \forall (x: Original.Carrier i.first i.second) ->
  forward.apply n ((SD.Component[i := i].injection).apply x) =
    (TD.Component[i := index n i].injection).apply (SignedSymmetry.map.apply x) :=
  \fun (x: Original.Carrier i.first i.second) => eq_reason_in!{TD.Carrier _
    "=" _ "by" { congr!{MD.Carrier TD.Carrier} (Symmetry.totalForward.apply n) _ _ (KoszulDegree.At[i := i].point x) }
    "=" _ "by" { SymmetryDegree.onInjection (index n i) ((SourceSign.map (Arithmetic.mul i.first i.second)).apply x) }
    "=" _ "by" { congr!{{Opposite.Carrier i.second i.first} TD.Carrier} ((TD.Component[i := index n i].injection).apply) _ _
        (SignedSymmetry.naturality x) }
  };
\definition onTensor: \forall (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) ->
  forward.apply n ((SD.Component[i := i].injection).apply (Original.Term[p := i.first, q := i.second].tensor x y)) =
    (TD.Component[i := index n i].injection).apply
      ((TargetSign.map (Arithmetic.mul i.first i.second)).apply (Opposite.Term[p := i.second, q := i.first].tensor y x)) :=
  \fun (x: C.family.Carrier i.first)(y: D.family.Carrier i.second) => trans!{TD.Carrier} _ _ _
    (onInjection (Original.Term[p := i.first, q := i.second].tensor x y))
    (congr!{{Opposite.Carrier i.second i.first} TD.Carrier} ((TD.Component[i := index n i].injection).apply) _ _
      (SignedSymmetry.onTensor x y));
