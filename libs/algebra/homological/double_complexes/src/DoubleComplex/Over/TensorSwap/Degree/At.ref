\import \parent.\parent.\parent.Sign[V := Opposite.Carrier #second{i} #first{i}, space := Opposite.space #second{i} #first{i}] \as TargetSign;
\import \parent.\parent.Term[p := #first{i}, q := #second{i}] \as SignedSymmetry;
\import \parent.\parent.\parent.Sign[V := Original.Carrier #first{i} #second{i}, space := Original.space #first{i} #second{i}] \as SourceSign;
\definition onInjection: \forall (x: Original.Carrier #first{i} #second{i}) ->
  #apply{forward} n (#apply{(SD.Component[i := i].injection)} x) =
    #apply{(TD.Component[i := index n i].injection)} (#apply{SignedSymmetry.map} x) :=
  \fun (x: Original.Carrier #first{i} #second{i}) => trans!{TD.Carrier} _ _ _
    (congr!{MD.Carrier TD.Carrier} (#apply{Symmetry.totalForward} n) _ _ (KoszulDegree.At[i := i].point x))
    (trans!{TD.Carrier} _ _ _
      (SymmetryDegree.onInjection (index n i) (#apply{(SourceSign.map (Arithmetic.mul #first{i} #second{i}))} x))
      (congr!{{Opposite.Carrier #second{i} #first{i}} TD.Carrier} (#apply{(TD.Component[i := index n i].injection)}) _ _
        (SignedSymmetry.naturality x)));
\definition onTensor: \forall (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) ->
  #apply{forward} n (#apply{(SD.Component[i := i].injection)} (Original.Term[p := #first{i}, q := #second{i}].tensor x y)) =
    #apply{(TD.Component[i := index n i].injection)}
      (#apply{(TargetSign.map (Arithmetic.mul #first{i} #second{i}))} (Opposite.Term[p := #second{i}, q := #first{i}].tensor y x)) :=
  \fun (x: C.family.Carrier #first{i})(y: D.family.Carrier #second{i}) => trans!{TD.Carrier} _ _ _
    (onInjection (Original.Term[p := #first{i}, q := #second{i}].tensor x y))
    (congr!{{Opposite.Carrier #second{i} #first{i}} TD.Carrier} (#apply{(TD.Component[i := index n i].injection)}) _ _
      (SignedSymmetry.onTensor x y));
