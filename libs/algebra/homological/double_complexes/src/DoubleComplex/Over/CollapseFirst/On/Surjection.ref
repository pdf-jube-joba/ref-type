\definition RowsOnto: \Prop := \forall (q: Nat.Nat^)(x: D.family.Carrier Nat.Nat^::zero q) ->
  \exists { y: C.family.Carrier Nat.Nat^::zero q \where #apply{(f Nat.Nat^::zero q)} y = x };
\definition onto: Concentrated.Vanishes -> RowsOnto -> Result.Onto := \block {
  \fun (vanishes: Concentrated.Vanishes)(rows: RowsOnto)(n: Nat.Nat^)(x: Target.Carrier n) \then
  \takefrom y: \Cast[SourceTransposeTotal.Carrier n] ({ y: SourceTransposeTotal.Carrier n \where #apply{TransposedInduced.map} n y = #apply{TargetPermutation.forward} n x })
    \by Collapse.Surjection[].onto vanishes rows n (#apply{TargetPermutation.forward} n x) \then
  \return Logic.existsIntro[Total.Carrier n, { a: Total.Carrier n \where #apply{Induced.map} n a = x }]
    (#apply{SourcePermutation.backward} n y)
    (trans!{{Target.Carrier n}} _ _ _ (Transposed.Degree[n := n].backwardNaturality y)
      (trans!{{Target.Carrier n}} _ _ _
        (congr!{{TargetTransposeTotal.Carrier n} {Target.Carrier n}} (#apply{TargetPermutation.backward} n) _ _
          (\bysub(SourceTransposeTotal.Carrier n, { y: SourceTransposeTotal.Carrier n \where #apply{TransposedInduced.map} n y = #apply{TargetPermutation.forward} n x }, y)))
        (TargetPermutation.Degree[n := n].leftInverse x)))
};
