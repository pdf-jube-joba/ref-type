\definition RowsOnto: \Prop := \forall (q: Nat.Nat^)(x: D.family.Carrier Nat.Nat^::zero q) ->
  \exists { y: C.family.Carrier Nat.Nat^::zero q \where (f Nat.Nat^::zero q).apply y = x };
\definition onto: Concentrated.Vanishes -> RowsOnto -> Result.Onto := \block {
  \fun (vanishes: Concentrated.Vanishes)(rows: RowsOnto)(n: Nat.Nat^)(x: Target.Carrier n) \then
  \takefrom y: \Cast[SourceTransposeTotal.Carrier n] ({ y: SourceTransposeTotal.Carrier n \where TransposedInduced.map.apply n y = TargetPermutation.forward.apply n x })
    \by Collapse.Surjection[].onto vanishes rows n (TargetPermutation.forward.apply n x) \then
  \return Logic.existsIntro[Total.Carrier n, { a: Total.Carrier n \where Induced.map.apply n a = x }]
    (SourcePermutation.backward.apply n y)
    (trans!{{Target.Carrier n}} _ _ _ (Transposed.Degree[n := n].backwardNaturality y)
      (trans!{{Target.Carrier n}} _ _ _
        (congr!{{TargetTransposeTotal.Carrier n} {Target.Carrier n}} (TargetPermutation.backward.apply n) _ _
          (\bysub(SourceTransposeTotal.Carrier n, { y: SourceTransposeTotal.Carrier n \where TransposedInduced.map.apply n y = TargetPermutation.forward.apply n x }, y)))
        (TargetPermutation.Degree[n := n].leftInverse x)))
};
