\import \parent.\parent.Sign[V := C.family.Carrier p q, space := C.family.space p q] \as Sign;
\import \parent.\parent.Sign[V := C.family.Carrier (Nat.Nat^::succ p) q, space := C.family.space (Nat.Nat^::succ p) q] \as SourceSign;
\import SourceSign.Mapping[W := C.family.Carrier p q, target := C.family.space p q] \as Naturality;
\import Modules.Hom[V := C.family.Carrier p q, W := C.family.Carrier p q, source := C.family.space p q, target := C.family.space p q] \as Maps;
\definition zero: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  #apply{(Sign.map q)} (#apply{(C.differential.horizontal p q)} x) = #zero{(C.family.space p q)} ->
  #apply{(C.differential.horizontal p q)} x = #zero{(C.family.space p q)} :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q)(zero: _) => trans!{{C.family.Carrier p q}} _ _ _
    (sym!{{C.family.Carrier p q}} _ _ (Sign.involutive q (#apply{(C.differential.horizontal p q)} x)))
    (trans!{{C.family.Carrier p q}} _ _ _
      (congr!{{C.family.Carrier p q} {C.family.Carrier p q}} (#apply{(Sign.map q)}) _ _ zero)
      (Maps.zeroPreserved (Sign.map q)));
\definition lift(y: C.family.Carrier (Nat.Nat^::succ p) q): C.family.Carrier (Nat.Nat^::succ p) q := #apply{(SourceSign.map q)} y;
\definition boundary: \forall (x: C.family.Carrier p q)(y: C.family.Carrier (Nat.Nat^::succ p) q) ->
  #apply{(C.differential.horizontal p q)} y = x ->
  #apply{(TransposedSource.differential.vertical q p)} (lift y) = x :=
  \fun (x: C.family.Carrier p q)(y: C.family.Carrier (Nat.Nat^::succ p) q)(preimage: _) =>
    trans!{{C.family.Carrier p q}} _ _ _
      (congr!{{C.family.Carrier p q} {C.family.Carrier p q}} (#apply{(Sign.map q)}) _ _ (Naturality.naturality (C.differential.horizontal p q) q y))
      (trans!{{C.family.Carrier p q}} _ _ _ (Sign.involutive q (#apply{(C.differential.horizontal p q)} y)) preimage);
