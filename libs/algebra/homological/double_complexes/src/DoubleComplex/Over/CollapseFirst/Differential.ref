\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Sign[V := C.family.Carrier p q, space := C.family.space p q] \as Sign;
\import \parent.\parent.Sign[V := C.family.Carrier (Nat.Nat^::succ p) q, space := C.family.space (Nat.Nat^::succ p) q] \as SourceSign;
\import SourceSign.Mapping[W := C.family.Carrier p q, target := C.family.space p q] \as Naturality;
\import Modules.Hom[V := C.family.Carrier p q, W := C.family.Carrier p q, source := C.family.space p q, target := C.family.space p q] \as Maps;
\definition zero: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  (Sign.map q).apply ((C.differential.horizontal p q).apply x) = (C.family.space p q).zero ->
  (C.differential.horizontal p q).apply x = (C.family.space p q).zero :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q)(zero: _) => eq_reason_in!{{C.family.Carrier p q} _
    "=" _ "by" { sym!{{C.family.Carrier p q}} _ _ (Sign.involutive q ((C.differential.horizontal p q).apply x)) }
    "=" _ "by" { congr!{{C.family.Carrier p q} {C.family.Carrier p q}} ((Sign.map q).apply) _ _ zero }
    "=" _ "by" { Maps.zeroPreserved (Sign.map q) }
  };
\definition lift[y: C.family.Carrier (Nat.Nat^::succ p) q]: C.family.Carrier (Nat.Nat^::succ p) q := (SourceSign.map q).apply y;
\definition boundary: \forall (x: C.family.Carrier p q)(y: C.family.Carrier (Nat.Nat^::succ p) q) ->
  (C.differential.horizontal p q).apply y = x ->
  (TransposedSource.differential.vertical q p).apply (lift y) = x :=
  \fun (x: C.family.Carrier p q)(y: C.family.Carrier (Nat.Nat^::succ p) q)(preimage: _) =>
    eq_reason_in!{{C.family.Carrier p q} _
      "=" _ "by" { congr!{{C.family.Carrier p q} {C.family.Carrier p q}} ((Sign.map q).apply) _ _ (Naturality.naturality (C.differential.horizontal p q) q y) }
      "=" _ "by" { Sign.involutive q ((C.differential.horizontal p q).apply y) }
      "=" _ "by" preimage
    };
