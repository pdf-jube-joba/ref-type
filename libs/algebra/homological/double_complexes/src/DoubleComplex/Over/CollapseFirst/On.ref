\import Maps.Total[f := f] \as Induced;
\import TransposedSource.Mapping[D := D].On[f := f] \as Transposed;
\import TransposedSource.Permutation[] \as SourcePermutation;
\import TransposedTarget.Permutation[] \as TargetPermutation;
\import \parent.\parent.Map[C := TransposedSource.complex, D := TransposedTarget.complex].Total[f := Transposed.map] \as TransposedInduced;
\import VerticalCollapse.On[f := Transposed.map] \as Collapse;
\import Chains.Map[C := Total.complex, D := Target.complex].SurjectiveQuasi[f := Induced.map] \as Result;
\import Chains.Map[C := SourceTransposeTotal.complex, D := TargetTransposeTotal.complex].SurjectiveQuasi[f := TransposedInduced.map] \as TransposedResult;
\module Row(p: Nat.Nat^) {
  \import \parent.\parent.Differential[p := Nat.Nat^::zero, q := p] \as Initial;
  \definition augmentation: RowsExact[f] -> \forall (x: C.family.Carrier Nat.Nat^::zero p) ->
    #apply{(Transposed.map p Nat.Nat^::zero)} x = #zero{(D.family.space Nat.Nat^::zero p)} ->
    \exists { y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where #apply{(TransposedSource.differential.vertical p Nat.Nat^::zero)} y = x } := \block {
    \fun (rows: RowsExact[f])(x: C.family.Carrier Nat.Nat^::zero p)(killed: _) \then
    \takefrom y: \Cast[C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p] ({ y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where #apply{(C.differential.horizontal Nat.Nat^::zero p)} y = x }) \by #augmentation{rows} p x killed \then
    \return Logic.existsIntro[C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p, { z: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where #apply{(TransposedSource.differential.vertical p Nat.Nat^::zero)} z = x }]
      (Initial.lift y) (Initial.boundary x y (\bysub(C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p, { y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where #apply{(C.differential.horizontal Nat.Nat^::zero p)} y = x }, y)))
  };
  \module Positive(q: Nat.Nat^) {
    \import \parent.\parent.\parent.Differential[p := q, q := p] \as Current;
    \import \parent.\parent.\parent.Differential[p := Nat.Nat^::succ q, q := p] \as Next;
    \definition exact: RowsExact[f] -> \forall (x: C.family.Carrier (Nat.Nat^::succ q) p) ->
      #apply{(TransposedSource.differential.vertical p q)} x = #zero{(C.family.space q p)} ->
      \exists { y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where #apply{(TransposedSource.differential.vertical p (Nat.Nat^::succ q))} y = x } := \block {
      \fun (rows: RowsExact[f])(x: C.family.Carrier (Nat.Nat^::succ q) p)(closed: _) \then
      \takefrom y: \Cast[C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p] ({ y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where #apply{(C.differential.horizontal (Nat.Nat^::succ q) p)} y = x }) \by #positive{rows} q p x (Current.zero x closed) \then
      \return Logic.existsIntro[C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p, { z: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where #apply{(TransposedSource.differential.vertical p (Nat.Nat^::succ q))} z = x }]
        (Next.lift y) (Next.boundary x y (\bysub(C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p, { y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where #apply{(C.differential.horizontal (Nat.Nat^::succ q) p)} y = x }, y)))
    };
  }
}
\definition rows(rows: RowsExact[f]): VerticalCollapse.RowsExact[Transposed.map] := VerticalCollapse.RowsExact[Transposed.map] {
  augmentation := \fun (p: Nat.Nat^) => Row[p := p].augmentation rows,
  positive := \fun (p, q: Nat.Nat^) => Row[p := p].Positive[q := q].exact rows,
};
\module Positive(n: Nat.Nat^) {
  \definition closed: \forall (x: Total.Carrier (Nat.Nat^::succ n)) -> Result.Closed (Nat.Nat^::succ n) x ->
    TransposedResult.Closed (Nat.Nat^::succ n) (#apply{SourcePermutation.forward} (Nat.Nat^::succ n) x) :=
    \fun (x: Total.Carrier (Nat.Nat^::succ n))(closed: Result.Closed (Nat.Nat^::succ n) x) =>
      trans!{{SourceTransposeTotal.Carrier n}} _ _ _ (#commutes{SourcePermutation.forward} n x)
        (trans!{{SourceTransposeTotal.Carrier n}} _ _ _
          (congr!{{Total.Carrier n} {SourceTransposeTotal.Carrier n}} (#apply{SourcePermutation.forward} n) _ _ closed)
          (Chains.Map[C := Total.complex, D := SourceTransposeTotal.complex].At[n := n].zeroPreserved SourcePermutation.forward));
}
\definition closedMapped: \forall (n: Nat.Nat^)(x: Total.Carrier n) -> Result.Closed n x -> TransposedResult.Closed n (#apply{SourcePermutation.forward} n x) :=
  \induction (n: Nat.Nat^) \return \forall (x: Total.Carrier n) -> Result.Closed n x -> TransposedResult.Closed n (#apply{SourcePermutation.forward} n x) \with {
    | zero: \fun (x: Total.Carrier Nat.Nat^::zero)(closed: Result.Closed Nat.Nat^::zero x) => Logic.True::intro
    | succ: \fun (n: Nat.Nat^)(previous: \forall (x: Total.Carrier n) -> Result.Closed n x -> TransposedResult.Closed n (#apply{SourcePermutation.forward} n x)) => Positive[n := n].closed
  };
\definition killedMapped: \forall (n: Nat.Nat^)(x: Total.Carrier n) ->
  #apply{Induced.map} n x = #zero{(Target.space n)} ->
  #apply{TransposedInduced.map} n (#apply{SourcePermutation.forward} n x) = #zero{(TargetTransposeTotal.space n)} :=
  \fun (n: Nat.Nat^)(x: Total.Carrier n)(killed: _) => trans!{{TargetTransposeTotal.Carrier n}} _ _ _
    (sym!{{TargetTransposeTotal.Carrier n}} _ _ (Transposed.Degree[n := n].naturality x))
    (trans!{{TargetTransposeTotal.Carrier n}} _ _ _
      (congr!{{Target.Carrier n} {TargetTransposeTotal.Carrier n}} (#apply{TargetPermutation.forward} n) _ _ killed)
      (Chains.Map[C := Target.complex, D := TargetTransposeTotal.complex].At[n := n].zeroPreserved TargetPermutation.forward));
\definition killedBackward: \forall (n: Nat.Nat^)(y: SourceTransposeTotal.Carrier n) ->
  #apply{TransposedInduced.map} n y = #zero{(TargetTransposeTotal.space n)} ->
  #apply{Induced.map} n (#apply{SourcePermutation.backward} n y) = #zero{(Target.space n)} :=
  \fun (n: Nat.Nat^)(y: SourceTransposeTotal.Carrier n)(killed: _) => trans!{{Target.Carrier n}} _ _ _
    (Transposed.Degree[n := n].backwardNaturality y)
    (trans!{{Target.Carrier n}} _ _ _
      (congr!{{TargetTransposeTotal.Carrier n} {Target.Carrier n}} (#apply{TargetPermutation.backward} n) _ _ killed)
      (Chains.Map[C := TargetTransposeTotal.complex, D := Target.complex].At[n := n].zeroPreserved TargetPermutation.backward));
\module Exact;
\module Surjection;
