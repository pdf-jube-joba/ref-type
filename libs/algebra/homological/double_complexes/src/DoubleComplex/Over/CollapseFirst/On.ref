\import Maps.Total[f := f] \as Induced;
\import TransposedSource.Mapping[D := D].On[f := f] \as Transposed;
\import TransposedSource.Permutation[] \as SourcePermutation;
\import TransposedTarget.Permutation[] \as TargetPermutation;
\import \parent.\parent.Map[C := TransposedSource.complex, D := TransposedTarget.complex].Total[f := Transposed.map] \as TransposedInduced;
\import VerticalCollapse.On[f := Transposed.map] \as Collapse;
\import Chains.Map[C := Total.complex, D := Target.complex].SurjectiveQuasi[f := Induced.map] \as Result;
\import Chains.Map[C := SourceTransposeTotal.complex, D := TargetTransposeTotal.complex].SurjectiveQuasi[f := TransposedInduced.map] \as TransposedResult;
\module Row(p: Nat.Nat^) {
  \import \parent.\parent.Differential[p := Nat.Nat^::zero, q := p] \as Initial;
  \definition augmentation: RowsExact[f] -> \forall (x: C.family.Carrier Nat.Nat^::zero p) ->
    (Transposed.map p Nat.Nat^::zero).apply x = (D.family.space Nat.Nat^::zero p).zero ->
    \exists ( y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where (TransposedSource.differential.vertical p Nat.Nat^::zero).apply y = x ) := \block {
    \fun (rows: RowsExact[f])(x: C.family.Carrier Nat.Nat^::zero p)(killed: _) \then
    \takefrom y: \Cast[C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p] ({ y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where (C.differential.horizontal Nat.Nat^::zero p).apply y = x }) \by rows.augmentation p x killed \then
    \return Logic.existsIntro[C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p, { z: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where (TransposedSource.differential.vertical p Nat.Nat^::zero).apply z = x }]
      (Initial.lift y) (Initial.boundary x y (\bysub(C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p, { y: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) p \where (C.differential.horizontal Nat.Nat^::zero p).apply y = x }, y)))
  };
  \module Positive(q: Nat.Nat^) {
    \import \parent.\parent.\parent.Differential[p := q, q := p] \as Current;
    \import \parent.\parent.\parent.Differential[p := Nat.Nat^::succ q, q := p] \as Next;
    \definition exact: RowsExact[f] -> \forall (x: C.family.Carrier (Nat.Nat^::succ q) p) ->
      (TransposedSource.differential.vertical p q).apply x = (C.family.space q p).zero ->
      \exists ( y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where (TransposedSource.differential.vertical p (Nat.Nat^::succ q)).apply y = x ) := \block {
      \fun (rows: RowsExact[f])(x: C.family.Carrier (Nat.Nat^::succ q) p)(closed: _) \then
      \takefrom y: \Cast[C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p] ({ y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where (C.differential.horizontal (Nat.Nat^::succ q) p).apply y = x }) \by rows.positive q p x (Current.zero x closed) \then
      \return Logic.existsIntro[C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p, { z: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where (TransposedSource.differential.vertical p (Nat.Nat^::succ q)).apply z = x }]
        (Next.lift y) (Next.boundary x y (\bysub(C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p, { y: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p \where (C.differential.horizontal (Nat.Nat^::succ q) p).apply y = x }, y)))
    };
  }
}
\definition rows[rows: RowsExact[f]]: VerticalCollapse.RowsExact[Transposed.map] := VerticalCollapse.RowsExact[Transposed.map] {
  augmentation := \fun (p: Nat.Nat^) => Row[p := p].augmentation rows,
  positive := \fun (p, q: Nat.Nat^) => Row[p := p].Positive[q := q].exact rows,
};
\module Positive(n: Nat.Nat^) {
  \definition closed: \forall (x: Total.Carrier (Nat.Nat^::succ n)) -> Result.Closed (Nat.Nat^::succ n) x ->
    TransposedResult.Closed (Nat.Nat^::succ n) (SourcePermutation.forward.apply (Nat.Nat^::succ n) x) :=
    \fun (x: Total.Carrier (Nat.Nat^::succ n))(closed: Result.Closed (Nat.Nat^::succ n) x) =>
      trans!{{SourceTransposeTotal.Carrier n}} _ _ _ (SourcePermutation.forward.commutes n x)
        (trans!{{SourceTransposeTotal.Carrier n}} _ _ _
          (congr!{{Total.Carrier n} {SourceTransposeTotal.Carrier n}} (SourcePermutation.forward.apply n) _ _ closed)
          (Chains.Map[C := Total.complex, D := SourceTransposeTotal.complex].At[n := n].zeroPreserved SourcePermutation.forward));
}
\definition closedMapped: \forall (n: Nat.Nat^)(x: Total.Carrier n) -> Result.Closed n x -> TransposedResult.Closed n (SourcePermutation.forward.apply n x) :=
  \induction (n: Nat.Nat^) \return \forall (x: Total.Carrier n) -> Result.Closed n x -> TransposedResult.Closed n (SourcePermutation.forward.apply n x) \with {
    | zero: \fun (x: Total.Carrier Nat.Nat^::zero)(closed: Result.Closed Nat.Nat^::zero x) => Logic.True::intro
    | succ: \fun (n: Nat.Nat^)(previous: \forall (x: Total.Carrier n) -> Result.Closed n x -> TransposedResult.Closed n (SourcePermutation.forward.apply n x)) => Positive[n := n].closed
  };
\definition killedMapped: \forall (n: Nat.Nat^)(x: Total.Carrier n) ->
  Induced.map.apply n x = (Target.space n).zero ->
  TransposedInduced.map.apply n (SourcePermutation.forward.apply n x) = (TargetTransposeTotal.space n).zero :=
  \fun (n: Nat.Nat^)(x: Total.Carrier n)(killed: _) => trans!{{TargetTransposeTotal.Carrier n}} _ _ _
    (sym!{{TargetTransposeTotal.Carrier n}} _ _ (Transposed.Degree[n := n].naturality x))
    (trans!{{TargetTransposeTotal.Carrier n}} _ _ _
      (congr!{{Target.Carrier n} {TargetTransposeTotal.Carrier n}} (TargetPermutation.forward.apply n) _ _ killed)
      (Chains.Map[C := Target.complex, D := TargetTransposeTotal.complex].At[n := n].zeroPreserved TargetPermutation.forward));
\definition killedBackward: \forall (n: Nat.Nat^)(y: SourceTransposeTotal.Carrier n) ->
  TransposedInduced.map.apply n y = (TargetTransposeTotal.space n).zero ->
  Induced.map.apply n (SourcePermutation.backward.apply n y) = (Target.space n).zero :=
  \fun (n: Nat.Nat^)(y: SourceTransposeTotal.Carrier n)(killed: _) => trans!{{Target.Carrier n}} _ _ _
    (Transposed.Degree[n := n].backwardNaturality y)
    (trans!{{Target.Carrier n}} _ _ _
      (congr!{{TargetTransposeTotal.Carrier n} {Target.Carrier n}} (TargetPermutation.backward.apply n) _ _ killed)
      (Chains.Map[C := TargetTransposeTotal.complex, D := Target.complex].At[n := n].zeroPreserved TargetPermutation.backward));
\module Exact;
\module Surjection;
