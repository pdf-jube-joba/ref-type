\definition exact: RowsExact[f] -> Concentrated.Vanishes -> Result.ExactCycles := \block {
  \fun (hypotheses: RowsExact[f])(vanishes: Concentrated.Vanishes)(n: Nat.Nat^)(x: Total.Carrier n)(closed: Result.Closed n x)(killed: _) \then
  \takefrom y: TransposedResult.BoundaryAt[n, #apply{SourcePermutation.forward} n x]
    \by Collapse.Exact[].exact (rows hypotheses) vanishes n (#apply{SourcePermutation.forward} n x) (closedMapped n x closed) (killedMapped n x killed) \then
  \return \exact(Result.BoundaryAt[n, x] {
    value := #apply{SourcePermutation.backward} (Nat.Nat^::succ n) #value{y},
    killed := killedBackward (Nat.Nat^::succ n) #value{y} #killed{y},
    boundary := trans!{{Total.Carrier n}} _ _ _ (#commutes{SourcePermutation.backward} n #value{y})
      (trans!{{Total.Carrier n}} _ _ _
        (congr!{{SourceTransposeTotal.Carrier n} {Total.Carrier n}} (#apply{SourcePermutation.backward} n) _ _ #boundary{y})
        (SourcePermutation.Degree[n := n].leftInverse x)),
  }, Result.BoundaryAt[n, x])
};
