\definition exact: RowsExact[f] -> Concentrated.Vanishes -> Result.ExactCycles := \block {
  \fun (hypotheses: RowsExact[f])(vanishes: Concentrated.Vanishes)(n: Nat.Nat^)(x: Total.Carrier n)(closed: Result.Closed n x)(killed: _) \then
  \takefrom y: TransposedResult.BoundaryAt[n, SourcePermutation.forward.apply n x]
    \by Collapse.Exact[].exact (rows hypotheses) vanishes n (SourcePermutation.forward.apply n x) (closedMapped n x closed) (killedMapped n x killed) \then
  \return \exact(Result.BoundaryAt[n, x] {
    value := SourcePermutation.backward.apply (Nat.Nat^::succ n) y.value,
    killed := killedBackward (Nat.Nat^::succ n) y.value y.killed,
    boundary := trans!{{Total.Carrier n}} _ _ _ (SourcePermutation.backward.commutes n y.value)
      (trans!{{Total.Carrier n}} _ _ _
        (congr!{{SourceTransposeTotal.Carrier n} {Total.Carrier n}} (SourcePermutation.backward.apply n) _ _ y.boundary)
        (SourcePermutation.Degree[n := n].leftInverse x)),
  }, Result.BoundaryAt[n, x])
};
