\module Term(p, q: Nat.Nat^) {
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q] \as Native;
  \definition Carrier: \Set := Native.Carrier;
  \definition space: Modules.Space Carrier := Native.space;
  \definition tensor: C.family.Carrier p -> D.family.Carrier q -> Carrier := Native.tensor;
  \definition zeroLeft: \forall (y: D.family.Carrier q) -> tensor #zero{(C.family.space p)} y = #zero{space} := Native.tensorZeroLeft;
  \definition zeroRight: \forall (x: C.family.Carrier p) -> tensor x #zero{(D.family.space q)} = #zero{space} := Native.tensorZeroRight;
}
\module At(p, q: Nat.Nat^);
\definition Carrier(p, q: Nat.Nat^): \Set := Term[p := p, q := q].Carrier;
\definition space(p, q: Nat.Nat^): Modules.Space (Carrier p q) := Term[p := p, q := q].space;
\definition family: Family := Family { Carrier := Carrier, space := space };
\definition differential: DifferentialData[family] := DifferentialData[family] {
  horizontal := \fun (p, q: Nat.Nat^) => At[p := p, q := q].horizontal,
  vertical := \fun (p, q: Nat.Nat^) => At[p := p, q := q].vertical,
};
\module Square(p, q: Nat.Nat^);
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    horizontalZero := \fun (p, q: Nat.Nat^) => Square[p := p, q := q].horizontalZero,
    verticalZero := \fun (p, q: Nat.Nat^) => Square[p := p, q := q].verticalZero,
    commute := \fun (p, q: Nat.Nat^) => Square[p := p, q := q].commute,
  },
};
