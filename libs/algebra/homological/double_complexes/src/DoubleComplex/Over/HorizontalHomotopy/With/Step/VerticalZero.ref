\definition q: Nat.Nat^ := Nat.Nat^::zero;
\definition qBound: Second current p := \into[Nat.Nat^](q, Second current p) \by { firstDegree current q p };
\import \parent.At[p := p, q := qBound] \as Component;
\import Modules.Hom[V := SP.Carrier, W := TD.Carrier, source := SP.space, target := TD.space] \as PriorLinear;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as Vector;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := Vector.additive] \as Group;
\definition after[x: C.family.Carrier p q]: (verticalAfter).apply ((SD.Component[i := Component.i].injection).apply x) = (TD.space).zero := Component.verticalAfterOnInjection x;
\definition before[x: C.family.Carrier p q]: (verticalBefore).apply ((SD.Component[i := Component.i].injection).apply x) = (TD.space).zero := trans!{TD.Carrier} _ _ _ (Component.verticalBeforeOnInjection x) (PriorLinear.zeroPreserved PreviousH.map);
\definition law[x: C.family.Carrier p q]: (verticalBefore).apply ((SD.Component[i := Component.i].injection).apply x) = (TD.space).neg ((verticalAfter).apply ((SD.Component[i := Component.i].injection).apply x)) :=
  trans!{TD.Carrier} _ _ _ (before x)
    (sym!{TD.Carrier} _ _ (trans!{TD.Carrier} _ _ _ (congr!{TD.Carrier TD.Carrier} ((TD.space).neg) _ _ (after x)) Group.negZero));
