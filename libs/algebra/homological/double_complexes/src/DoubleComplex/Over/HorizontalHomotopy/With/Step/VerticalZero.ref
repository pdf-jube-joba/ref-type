\definition q: Nat.Nat^ := Nat.Nat^::zero;
\definition qBound: Second current p := \into[Nat.Nat^](q, Second current p) \by { firstDegree current q p };
\import \parent.At[p := p, q := qBound] \as Component;
\import Modules.Hom[V := SP.Carrier, W := TD.Carrier, source := SP.space, target := TD.space] \as PriorLinear;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as Vector;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := Vector.additive] \as Group;
\definition after(x: C.family.Carrier p q): #apply{verticalAfter} (#apply{SD.Component[i := Component.i].injection} x) = #zero{TD.space} := Component.verticalAfterOnInjection x;
\definition before(x: C.family.Carrier p q): #apply{verticalBefore} (#apply{SD.Component[i := Component.i].injection} x) = #zero{TD.space} := trans!{TD.Carrier} _ _ _ (Component.verticalBeforeOnInjection x) (PriorLinear.zeroPreserved PreviousH.map);
\definition law(x: C.family.Carrier p q): #apply{verticalBefore} (#apply{SD.Component[i := Component.i].injection} x) = #neg{TD.space} (#apply{verticalAfter} (#apply{SD.Component[i := Component.i].injection} x)) :=
  trans!{TD.Carrier} _ _ _ (before x)
    (sym!{TD.Carrier} _ _ (trans!{TD.Carrier} _ _ _ (congr!{TD.Carrier TD.Carrier} (#neg{TD.space}) _ _ (after x)) Group.negZero));
