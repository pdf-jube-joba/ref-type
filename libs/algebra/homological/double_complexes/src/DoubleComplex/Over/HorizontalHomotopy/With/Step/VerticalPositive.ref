\definition higher: Nat.Nat^ := Nat.Nat^::succ q;
\definition qBound: Second current p := \into[Nat.Nat^](higher, Second current p) \by { firstDegree current higher p };
\import \parent.At[p := p, q := qBound] \as Component;
\definition pBound: First current higher := p;
\definition lowerIndex: Index n := \root.DoubleComplex[].Over[R := R, ring := ring].reverseIndex n q (SS.lowerFirst q pBound);
\definition targetIndex: Index current := PreviousH.Component[i := lowerIndex].raised;
\definition inject: Modules.Hom[V := D.family.Carrier (Nat.Nat^::succ p) q, W := TD.Carrier, source := D.family.space (Nat.Nat^::succ p) q, target := TD.space].Map := TD.Component[i := targetIndex].injection;
\import \parent.\parent.\parent.\parent.Sign[V := C.family.Carrier p q, space := C.family.space p q] \as SourceSign;
\import \parent.\parent.\parent.\parent.Sign[V := D.family.Carrier (Nat.Nat^::succ p) q, space := D.family.space (Nat.Nat^::succ p) q] \as TargetSign;
\import SourceSign.Mapping[W := D.family.Carrier (Nat.Nat^::succ p) q, target := D.family.space (Nat.Nat^::succ p) q] \as Signs;
\import Modules.Hom[V := D.family.Carrier (Nat.Nat^::succ p) q, W := TD.Carrier, source := D.family.space (Nat.Nat^::succ p) q, target := TD.space] \as Injection;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as Vector;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := Vector.additive] \as Group;
\definition common(x: C.family.Carrier p higher): TD.Carrier := #apply{inject} (#apply{(TargetSign.map p)} (#apply{(h p q)} (#apply{(C.differential.vertical p q)} x)));
\definition before(x: C.family.Carrier p higher): #apply{verticalBefore} (#apply{SD.Component[i := Component.i].injection} x) = common x :=
  trans!{TD.Carrier} _ _ _ (Component.verticalBeforeOnInjection x)
    (trans!{TD.Carrier} _ _ _ (PreviousH.onInjection lowerIndex (#apply{(SourceSign.map p)} (#apply{(C.differential.vertical p q)} x)))
      (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} TD.Carrier} (#apply{inject}) _ _ (Signs.naturality (h p q) p (#apply{(C.differential.vertical p q)} x))));
\definition after(x: C.family.Carrier p higher): #apply{verticalAfter} (#apply{SD.Component[i := Component.i].injection} x) = #neg{TD.space} (common x) :=
  trans!{TD.Carrier} _ _ _ (Component.verticalAfterOnInjection x)
    (trans!{TD.Carrier} _ _ _
      (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} TD.Carrier} (#apply{inject}) _ _
        (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} {D.family.Carrier (Nat.Nat^::succ p) q}} (#apply{(TargetSign.map (Nat.Nat^::succ p))}) _ _ (#vertical{laws} p q x)))
      (Injection.negativePreserved inject (#apply{(TargetSign.map p)} (#apply{(h p q)} (#apply{(C.differential.vertical p q)} x)))));
\definition law(x: C.family.Carrier p higher): #apply{verticalBefore} (#apply{SD.Component[i := Component.i].injection} x) = #neg{TD.space} (#apply{verticalAfter} (#apply{SD.Component[i := Component.i].injection} x)) :=
  trans!{TD.Carrier} _ _ _ (before x)
    (sym!{TD.Carrier} _ _ (trans!{TD.Carrier} _ _ _ (congr!{TD.Carrier TD.Carrier} (#neg{TD.space}) _ _ (after x)) (Group.negNeg (common x))));
