\import \parent.\parent.Total[C := C] \as Source;
\import \parent.\parent.Total[C := D] \as Target;
\import \parent.\parent.Coordinates[C := C] \as SourceCoordinates;
\import \parent.\parent.Coordinates[C := D] \as TargetCoordinates;
\import \parent.\parent.Map[C := C, D := D].Total[f := f] \as Forward;
\import \parent.\parent.Map[C := C, D := D].Total[f := g] \as Backward;
\module Degree(n: Nat.Nat^);
\definition laws: Laws[f, g, h] := \bysub(Data, { h: Data \where Laws[f, g, h] }, h);
\import double_complexes.NonnegativeChain[].Over[R := R, ring := ring].Homotopy[C := Source.complex, D := Target.complex] \as Homotopies;
\definition data: Homotopies.LinearData := \into[Homotopies.Data](Homotopies.Data { apply := \fun (n: Nat.Nat^) => (Degree[n := n].map).apply }, { h: Homotopies.Data \where Homotopies.LinearLaws[h] }) \by {
  Homotopies.LinearLaws[Homotopies.Data { apply := \fun (n: Nat.Nat^) => (Degree[n := n].map).apply }] {
    addition := \fun (n: Nat.Nat^) => (Degree[n := n].map).addition,
    scalar := \fun (n: Nat.Nat^) => (Degree[n := n].map).scalar,
  }
};
\import Homotopies.Boundary[h := data] \as Boundaries;
\module Step(n: Nat.Nat^);
\module Zero;
\definition homotopy: Homotopies.Homotopy Forward.map Backward.map := \into[Homotopies.Data](data, Homotopies.Homotopy Forward.map Backward.map) \by {
  Homotopies.Laws[Forward.map, Backward.map, data] {
    addition := (data).addition, scalar := (data).scalar,
    zeroEquation := Zero[].law,
    successorEquation := \fun (n: Nat.Nat^) => Step[n := n].equality,
  }
};
