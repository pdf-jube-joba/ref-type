\definition p: Nat.Nat^ := Nat.Nat^::zero;
\import \parent.At[p := p, q := q] \as Component;
\import Modules.Hom[V := SP.Carrier, W := TD.Carrier, source := SP.space, target := TD.space] \as PriorLinear;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as Vector;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := Vector.additive] \as Group;
\definition common(x: C.family.Carrier p q): TD.Carrier := #apply{Component.inject} (#apply{(D.differential.horizontal p q)} (#apply{(h p q)} x));
\definition left(x: C.family.Carrier p q): #apply{difference} (#apply{SD.Component[i := Component.i].injection} x) = common x :=
  trans!{TD.Carrier} _ _ _ (Component.differenceOnInjection x)
    (congr!{{D.family.Carrier p q} TD.Carrier} (#apply{Component.inject}) _ _ (#zero{laws} q x));
\definition before(x: C.family.Carrier p q): #apply{horizontalBefore} (#apply{SD.Component[i := Component.i].injection} x) = #zero{TD.space} :=
  trans!{TD.Carrier} _ _ _ (Component.horizontalBeforeOnInjection x) (PriorLinear.zeroPreserved PreviousH.map);
\definition right(x: C.family.Carrier p q): #add{TD.space} (#apply{horizontalAfter} (#apply{SD.Component[i := Component.i].injection} x)) (#apply{horizontalBefore} (#apply{SD.Component[i := Component.i].injection} x)) = common x :=
  trans!{TD.Carrier} _ _ _ (congr2!{TD.Carrier TD.Carrier TD.Carrier} (#add{TD.space}) _ _ _ _ (Component.horizontalAfterOnInjection x) (before x)) (Group.zeroRight (common x));
\definition law(x: C.family.Carrier p q): #apply{difference} (#apply{SD.Component[i := Component.i].injection} x) = #add{TD.space} (#apply{horizontalAfter} (#apply{SD.Component[i := Component.i].injection} x)) (#apply{horizontalBefore} (#apply{SD.Component[i := Component.i].injection} x)) := trans!{TD.Carrier} _ _ _ (left x) (sym!{TD.Carrier} _ _ (right x));
