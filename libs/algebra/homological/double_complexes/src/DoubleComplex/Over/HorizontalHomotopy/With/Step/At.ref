\definition closed: Arithmetic.add p q = current := secondDegree current p q;
\definition i: Index current := index p q closed;
\import Modules.Hom[V := D.family.Carrier p q, W := TD.Carrier, source := D.family.space p q, target := TD.space] \as Injection;
\definition inject: Injection.Map := TD.Component[i := i].injection;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as TargetValues;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := TargetValues.additive] \as TargetGroup;
\import Modules.Laws[V := D.family.Carrier p q, space := D.family.space p q] \as TermValues;
\import algebra.Group[].Of[Carrier := D.family.Carrier p q, group := TermValues.additive] \as TermGroup;
\definition differenceOnInjection(x: C.family.Carrier p q): #apply{difference} (#apply{SD.Component[i := i].injection} x) = #apply{inject} (TermGroup.difference (#apply{(f p q)} x) (#apply{(g p q)} x)) :=
  trans!{TD.Carrier} _ _ _
    (congr2!{TD.Carrier TD.Carrier TD.Carrier} TargetGroup.difference _ _ _ _ (F.onInjection i x) (G.onInjection i x))
    (sym!{TD.Carrier} _ _ (Injection.differencePreserved inject (#apply{(f p q)} x) (#apply{(g p q)} x)));
\definition horizontalAfterOnInjection(x: C.family.Carrier p q): #apply{horizontalAfter} (#apply{SD.Component[i := i].injection} x) = #apply{inject} (#apply{(D.differential.horizontal p q)} (#apply{(h p q)} x)) :=
  trans!{TD.Carrier} _ _ _
    (congr!{TN.Carrier TD.Carrier} (#apply{TS.horizontalTotal}) _ _ (NextH.onInjection i x))
    (TS.horizontalOnInjection (NextH.Component[i := i].raised) (#apply{(h p q)} x));
\definition horizontalBeforeOnInjection(x: C.family.Carrier p q): #apply{horizontalBefore} (#apply{SD.Component[i := i].injection} x) = #apply{PreviousH.map} (#apply{(SS.horizontalComponents i)} x) :=
  congr!{SP.Carrier TD.Carrier} (#apply{PreviousH.map}) _ _ (SS.horizontalOnInjection i x);
\definition verticalAfterOnInjection(x: C.family.Carrier p q): #apply{verticalAfter} (#apply{SD.Component[i := i].injection} x) = #apply{(TS.verticalComponents (NextH.Component[i := i].raised))} (#apply{(h p q)} x) :=
  trans!{TD.Carrier} _ _ _
    (congr!{TN.Carrier TD.Carrier} (#apply{TS.verticalTotal}) _ _ (NextH.onInjection i x))
    (TS.verticalOnInjection (NextH.Component[i := i].raised) (#apply{(h p q)} x));
\definition verticalBeforeOnInjection(x: C.family.Carrier p q): #apply{verticalBefore} (#apply{SD.Component[i := i].injection} x) = #apply{PreviousH.map} (#apply{(SS.verticalComponents i)} x) :=
  congr!{SP.Carrier TD.Carrier} (#apply{PreviousH.map}) _ _ (SS.verticalOnInjection i x);
