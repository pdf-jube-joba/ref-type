\definition closed: Arithmetic.add p q = current := secondDegree current p q;
\definition i: Index current := index p q closed;
\import Modules.Hom[V := D.family.Carrier p q, W := TD.Carrier, source := D.family.space p q, target := TD.space] \as Injection;
\definition inject: Injection.Map := TD.Component[i := i].injection;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as TargetValues;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := TargetValues.additive] \as TargetGroup;
\import Modules.Laws[V := D.family.Carrier p q, space := D.family.space p q] \as TermValues;
\import algebra.Group[].Of[Carrier := D.family.Carrier p q, group := TermValues.additive] \as TermGroup;
\definition differenceOnInjection[x: C.family.Carrier p q]: (difference).apply ((SD.Component[i := i].injection).apply x) = (inject).apply (TermGroup.difference ((f p q).apply x) ((g p q).apply x)) :=
  trans!{TD.Carrier} _ _ _
    (congr!{TD.Carrier TD.Carrier TD.Carrier} TargetGroup.difference _ _ _ _ (F.onInjection i x) (G.onInjection i x))
    (sym!{TD.Carrier} _ _ (Injection.differencePreserved inject ((f p q).apply x) ((g p q).apply x)));
\definition horizontalAfterOnInjection[x: C.family.Carrier p q]: (horizontalAfter).apply ((SD.Component[i := i].injection).apply x) = (inject).apply ((D.differential.horizontal p q).apply ((h p q).apply x)) :=
  trans!{TD.Carrier} _ _ _
    (congr!{TN.Carrier TD.Carrier} ((TS.horizontalTotal).apply) _ _ (NextH.onInjection i x))
    (TS.horizontalOnInjection (NextH.Component[i := i].raised) ((h p q).apply x));
\definition horizontalBeforeOnInjection[x: C.family.Carrier p q]: (horizontalBefore).apply ((SD.Component[i := i].injection).apply x) = (PreviousH.map).apply ((SS.horizontalComponents i).apply x) :=
  congr!{SP.Carrier TD.Carrier} ((PreviousH.map).apply) _ _ (SS.horizontalOnInjection i x);
\definition verticalAfterOnInjection[x: C.family.Carrier p q]: (verticalAfter).apply ((SD.Component[i := i].injection).apply x) = (TS.verticalComponents (NextH.Component[i := i].raised)).apply ((h p q).apply x) :=
  trans!{TD.Carrier} _ _ _
    (congr!{TN.Carrier TD.Carrier} ((TS.verticalTotal).apply) _ _ (NextH.onInjection i x))
    (TS.verticalOnInjection (NextH.Component[i := i].raised) ((h p q).apply x));
\definition verticalBeforeOnInjection[x: C.family.Carrier p q]: (verticalBefore).apply ((SD.Component[i := i].injection).apply x) = (PreviousH.map).apply ((SS.verticalComponents i).apply x) :=
  congr!{SP.Carrier TD.Carrier} ((PreviousH.map).apply) _ _ (SS.verticalOnInjection i x);
