\definition higher: Nat.Nat^ := Nat.Nat^::succ p;
\import \parent.At[p := higher, q := q] \as Component;
\definition qBound: Second current higher := q;
\definition lowerIndex: Index n := \root.DoubleComplex[].Over[R := R, ring := ring].index n p (SS.lowerSecond p qBound);
\definition previous(x: C.family.Carrier higher q): D.family.Carrier higher q := #apply{(h p q)} (#apply{(C.differential.horizontal p q)} x);
\definition before(x: C.family.Carrier higher q): #apply{horizontalBefore} (#apply{SD.Component[i := Component.i].injection} x) = #apply{Component.inject} (previous x) :=
  trans!{TD.Carrier} _ _ _ (Component.horizontalBeforeOnInjection x)
    (PreviousH.onInjection lowerIndex (#apply{(C.differential.horizontal p q)} x));
\definition common(x: C.family.Carrier higher q): TD.Carrier := #apply{Component.inject} (#add{(D.family.space higher q)} (#apply{(D.differential.horizontal higher q)} (#apply{(h higher q)} x)) (previous x));
\definition left(x: C.family.Carrier higher q): #apply{difference} (#apply{SD.Component[i := Component.i].injection} x) = common x :=
  trans!{TD.Carrier} _ _ _ (Component.differenceOnInjection x)
    (congr!{{D.family.Carrier higher q} TD.Carrier} (#apply{Component.inject}) _ _ (#positive{laws} p q x));
\definition right(x: C.family.Carrier higher q): #add{TD.space} (#apply{horizontalAfter} (#apply{SD.Component[i := Component.i].injection} x)) (#apply{horizontalBefore} (#apply{SD.Component[i := Component.i].injection} x)) = common x :=
  trans!{TD.Carrier} _ _ _
    (congr2!{TD.Carrier TD.Carrier TD.Carrier} (#add{TD.space}) _ _ _ _ (Component.horizontalAfterOnInjection x) (before x))
    (sym!{TD.Carrier} _ _ (#addition{Component.inject} (#apply{(D.differential.horizontal higher q)} (#apply{(h higher q)} x)) (previous x)));
\definition law(x: C.family.Carrier higher q): #apply{difference} (#apply{SD.Component[i := Component.i].injection} x) = #add{TD.space} (#apply{horizontalAfter} (#apply{SD.Component[i := Component.i].injection} x)) (#apply{horizontalBefore} (#apply{SD.Component[i := Component.i].injection} x)) := trans!{TD.Carrier} _ _ _ (left x) (sym!{TD.Carrier} _ _ (right x));
