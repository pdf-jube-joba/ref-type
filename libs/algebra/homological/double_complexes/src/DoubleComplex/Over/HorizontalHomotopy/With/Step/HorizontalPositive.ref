\definition higher: Nat.Nat^ := Nat.Nat^::succ p;
\import \parent.At[p := higher, q := q] \as Component;
\definition qBound: Second current higher := q;
\definition lowerIndex: Index n := \root.DoubleComplex[].Over[R := R, ring := ring].index n p (SS.lowerSecond p qBound);
\definition previous[x: C.family.Carrier higher q]: D.family.Carrier higher q := (h p q).apply ((C.differential.horizontal p q).apply x);
\definition before[x: C.family.Carrier higher q]: (horizontalBefore).apply ((SD.Component[i := Component.i].injection).apply x) = (Component.inject).apply (previous x) :=
  trans!{TD.Carrier} _ _ _ (Component.horizontalBeforeOnInjection x)
    (PreviousH.onInjection lowerIndex ((C.differential.horizontal p q).apply x));
\definition common[x: C.family.Carrier higher q]: TD.Carrier := (Component.inject).apply ((D.family.space higher q).add ((D.differential.horizontal higher q).apply ((h higher q).apply x)) (previous x));
\definition left[x: C.family.Carrier higher q]: (difference).apply ((SD.Component[i := Component.i].injection).apply x) = common x :=
  trans!{TD.Carrier} _ _ _ (Component.differenceOnInjection x)
    (congr!{{D.family.Carrier higher q} TD.Carrier} ((Component.inject).apply) _ _ ((laws).positive p q x));
\definition right[x: C.family.Carrier higher q]: (TD.space).add ((horizontalAfter).apply ((SD.Component[i := Component.i].injection).apply x)) ((horizontalBefore).apply ((SD.Component[i := Component.i].injection).apply x)) = common x :=
  trans!{TD.Carrier} _ _ _
    (congr!{TD.Carrier TD.Carrier TD.Carrier} ((TD.space).add) _ _ _ _ (Component.horizontalAfterOnInjection x) (before x))
    (sym!{TD.Carrier} _ _ ((Component.inject).addition ((D.differential.horizontal higher q).apply ((h higher q).apply x)) (previous x)));
\definition law[x: C.family.Carrier higher q]: (difference).apply ((SD.Component[i := Component.i].injection).apply x) = (TD.space).add ((horizontalAfter).apply ((SD.Component[i := Component.i].injection).apply x)) ((horizontalBefore).apply ((SD.Component[i := Component.i].injection).apply x)) := trans!{TD.Carrier} _ _ _ (left x) (sym!{TD.Carrier} _ _ (right x));
