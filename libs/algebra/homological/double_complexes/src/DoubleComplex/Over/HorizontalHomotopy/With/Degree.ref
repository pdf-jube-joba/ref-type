\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := Nat.Nat^::succ n] \as TD;
\module Component(i: Index n) {
  \definition raised: Index (Nat.Nat^::succ n) := TargetCoordinates.raiseHorizontalIndex n i;
  \import Modules.Hom[V := D.family.Carrier (Nat.Nat^::succ #first{i}) #second{i}, W := TD.Carrier, source := D.family.space (Nat.Nat^::succ #first{i}) #second{i}, target := TD.space].Composition[U := C.family.Carrier #first{i} #second{i}, domain := C.family.space #first{i} #second{i}] \as Compose;
  \definition map: Modules.Hom[V := C.family.Carrier #first{i} #second{i}, W := TD.Carrier, source := C.family.space #first{i} #second{i}, target := TD.space].Map := Compose.compose (TD.Component[i := raised].injection) (h #first{i} #second{i});
}
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\definition components: Universal.Components := \fun (i: Index n) => Component[i := i].map;
\definition map: Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map := Universal.extension components;
\definition onInjection: \forall (i: Index n)(x: C.family.Carrier #first{i} #second{i}) -> #apply{map} (#apply{SD.Component[i := i].injection} x) = #apply{Component[i := i].map} x := Universal.onInjection components;
