\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := Nat.Nat^::succ n] \as TD;
\module Component(i: Index n) {
  \definition raised: Index (Nat.Nat^::succ n) := TargetCoordinates.raiseHorizontalIndex n i;
  \import Modules.Hom[V := D.family.Carrier (Nat.Nat^::succ (i).first) (i).second, W := TD.Carrier, source := D.family.space (Nat.Nat^::succ (i).first) (i).second, target := TD.space].Composition[U := C.family.Carrier (i).first (i).second, domain := C.family.space (i).first (i).second] \as Compose;
  \definition map: Modules.Hom[V := C.family.Carrier (i).first (i).second, W := TD.Carrier, source := C.family.space (i).first (i).second, target := TD.space].Map := Compose.compose (TD.Component[i := raised].injection) (h (i).first (i).second);
}
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\definition components: Universal.Components := \fun (i: Index n) => Component[i := i].map;
\definition map: Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map := Universal.extension components;
\definition onInjection: \forall (i: Index n)(x: C.family.Carrier (i).first (i).second) -> (map).apply ((SD.Component[i := i].injection).apply x) = (Component[i := i].map).apply x := Universal.onInjection components;
