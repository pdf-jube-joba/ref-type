\use std.Logic[].Equality[].eq_reason_in;
\definition n: Nat.Nat^ := Nat.Nat^::zero;
\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as TD;
\import Target.Degree[n := Nat.Nat^::succ n] \as TN;
\import SourceCoordinates.Zero[] \as SourceSingle;
\import TargetCoordinates.Zero[] \as TargetSingle;
\import \parent.Degree[n := n] \as H;
\import Target.Step[n := n] \as Differential;
\import Forward.Degree[n := n] \as F;
\import Backward.Degree[n := n] \as G;
\import Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space] \as Linear;
\import Modules.Hom[V := TN.Carrier, W := TD.Carrier, source := TN.space, target := TD.space].Composition[U := SD.Carrier, domain := SD.space] \as Compose;
\definition lhs: Linear.Map := Linear.plus F.map (Linear.negative G.map);
\definition rhs: Linear.Map := Compose.compose Differential.differential H.map;
\import Modules.Hom[V := D.family.Carrier n n, W := TD.Carrier, source := D.family.space n n, target := TD.space] \as Injection;
\import Modules.Laws[V := TD.Carrier, space := TD.space] \as Values;
\import algebra.Group[].Of[Carrier := TD.Carrier, group := Values.additive] \as Group;
\definition common[x: C.family.Carrier n n]: TD.Carrier := (TargetSingle.inject).apply ((D.differential.horizontal n n).apply ((h n n).apply x));
\definition left[x: C.family.Carrier n n]: (lhs).apply ((SourceSingle.inject).apply x) = common x :=
  eq_reason_in!{TD.Carrier _
    "=" _ "by" { congr!{TD.Carrier TD.Carrier TD.Carrier} Group.difference _ _ _ _ (F.onInjection SourceSingle.index x) (G.onInjection SourceSingle.index x) }
    "=" _ "by" { sym!{TD.Carrier} _ _ (Injection.differencePreserved TargetSingle.inject ((f n n).apply x) ((g n n).apply x)) }
    "=" _ "by" { congr!{{D.family.Carrier n n} TD.Carrier} ((TargetSingle.inject).apply) _ _ ((laws).zero n x) }
  };
\definition right[x: C.family.Carrier n n]: (rhs).apply ((SourceSingle.inject).apply x) = common x :=
  eq_reason_in!{TD.Carrier _
    "=" _ "by" { congr!{TN.Carrier TD.Carrier} ((Differential.differential).apply) _ _ (H.onInjection SourceSingle.index x) }
    "=" _ "by" { Differential.onComponent (H.Component[i := SourceSingle.index].raised) ((h n n).apply x) }
    "=" _ "by" { Group.zeroRight (common x) }
  };
\definition onComponent[x: C.family.Carrier n n]: (lhs).apply ((SourceSingle.inject).apply x) = (rhs).apply ((SourceSingle.inject).apply x) := trans!{TD.Carrier} _ _ _ (left x) (sym!{TD.Carrier} _ _ (right x));
\definition Statement[i: Index n]: \Prop := \forall (x: C.family.Carrier (i).first (i).second) -> (lhs).apply ((SD.Component[i := i].injection).apply x) = (rhs).apply ((SD.Component[i := i].injection).apply x);
\definition onInjection[i: Index n]: Statement i := \idelim SourceSingle.index = i \with j: Index n => Statement j \by { base: onComponent, equality: sym!{{Index n}} _ _ (SourceSingle.unique i) };
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\definition equation: lhs = rhs := Universal.ext lhs rhs onInjection;
\definition law[x: SD.Carrier]: (lhs).apply x = (rhs).apply x := congr!{Linear.Map TD.Carrier} (\fun (m: Linear.Map) => (m).apply x) _ _ equation;
