\import Chains.Map[C := C, D := D] \as Maps;
\import Chains.Homotopy[C := C, D := D] \as Homotopies;
\definition identity: Chains.Map[C := E, D := E].Map := Chains.End[C := E].identity;
\import \parent.Tensor[C := E, D := C] \as SourceTensor;
\import \parent.Tensor[C := C, D := E] \as ReverseSourceTensor;
\import \parent.Tensor[C := D, D := E] \as ReverseTargetTensor;
\import \parent.Tensor[C := E, D := D] \as TargetTensor;
\import \parent.Total[C := SourceTensor.complex] \as Source;
\import \parent.Total[C := ReverseSourceTensor.complex] \as ReverseSource;
\import \parent.Total[C := ReverseTargetTensor.complex] \as ReverseTarget;
\import \parent.Total[C := TargetTensor.complex] \as Target;
\import \parent.TensorSwap[C := E, D := C] \as SourceSwap;
\import \parent.TensorSwap[C := D, D := E] \as TargetSwap;
\import \parent.TensorSwap[C := E, D := D] \as OtherTargetSwap;
\import \parent.TensorMapping[C := C, D := D, E := E, F := E] \as LeftMapping;
\import \parent.TensorMapping[C := E, D := E, E := C, F := D] \as RightMapping;
\import Chains.Map[C := ReverseSource.complex, D := ReverseTarget.complex].Composition[B := Source.complex] \as Before;
\import Chains.Map[C := ReverseTarget.complex, D := Target.complex].Composition[B := Source.complex] \as After;
\import Chains.Map[C := Source.complex, D := Target.complex] \as Output;
\module Endpoint(f: Maps.Map);
\module With(f, g: Maps.Map, h: Homotopies.Homotopy f g);
