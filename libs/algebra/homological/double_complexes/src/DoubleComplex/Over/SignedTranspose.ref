\definition family: Family := Family {
  Carrier := \fun (p, q: Nat.Nat^) => C.family.Carrier q p,
  space := \fun (p, q: Nat.Nat^) => C.family.space q p,
};
\module Term(p, q: Nat.Nat^);
\definition differential: DifferentialData[family] := DifferentialData[family] {
  horizontal := \fun (p, q: Nat.Nat^) => Term[p := p, q := q].horizontal,
  vertical := \fun (p, q: Nat.Nat^) => Term[p := p, q := q].vertical,
};
\module Laws(p, q: Nat.Nat^);
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    horizontalZero := \fun (p, q: Nat.Nat^) => Laws[p := p, q := q].horizontalZero,
    verticalZero := \fun (p, q: Nat.Nat^) => Laws[p := p, q := q].verticalZero,
    commute := \fun (p, q: Nat.Nat^) => Laws[p := p, q := q].commute,
  },
};
\module Permutation;
\module Mapping(D: Complex);
