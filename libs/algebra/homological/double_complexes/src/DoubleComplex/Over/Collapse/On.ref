\import Maps.Total[f := f] \as Induced;

\definition Killed(n: Nat.Nat^)(x: Total.Carrier n): \Prop :=
  #apply{Induced.map} n x = #zero{(Target.space n)};
\module Degree(n: Nat.Nat^);
\definition RowClosed(p: Nat.Nat^): \forall (q: Nat.Nat^) -> C.family.Carrier p q -> \Prop :=
  \induction (q: Nat.Nat^) \return C.family.Carrier p q -> \Prop \with {
    | zero: \fun (x: C.family.Carrier p Nat.Nat^::zero) =>
      #apply{(f p Nat.Nat^::zero)} x = #zero{(D.family.space p Nat.Nat^::zero)}
    | succ: \fun (q: Nat.Nat^)(previous: _) => \fun (x: C.family.Carrier p (Nat.Nat^::succ q)) =>
      #apply{(C.differential.vertical p q)} x = #zero{(C.family.space p q)}
  };
\definition exact: \forall (rows: RowsExact[f])(p, q: Nat.Nat^)(x: C.family.Carrier p q) -> RowClosed p q x ->
  \exists { y: C.family.Carrier p (Nat.Nat^::succ q) \where #apply{(C.differential.vertical p q)} y = x } :=
  \fun (rows: RowsExact[f])(p: Nat.Nat^) => \induction (q: Nat.Nat^) \return
    \forall (x: C.family.Carrier p q) -> RowClosed p q x ->
      \exists { y: C.family.Carrier p (Nat.Nat^::succ q) \where #apply{(C.differential.vertical p q)} y = x } \with {
    | zero: #augmentation{rows} p
    | succ: \fun (q: Nat.Nat^)(previous: _) => #positive{rows} p q
  };
\module PositiveTop(p, q: Nat.Nat^);
\module Top(p, q: Nat.Nat^);
\module Properties;

\module Surjection;

\structure Stage[n, k: Nat.Nat^, x: Total.Carrier n]: \Prop {
  cycle: Closed n x,
  kernel: Killed n x,
  support: Above n k x,
}
\module Boundary(n: Nat.Nat^);
\definition ReductionAt(n, p: Nat.Nat^): \Prop :=
  \forall (rows: RowsExact[f])(vanishes: Concentrated.Vanishes)(x: Total.Carrier n) -> Stage[n, Nat.Nat^::succ p, x] ->
    \exists { y: Degree[n := Nat.Nat^::succ n].KernelCarrier \where
      Stage[n, p, Boundary[n := n].remainder x y] };
\module Reduction(p, q: Nat.Nat^);

\module Filtration(n: Nat.Nat^);
\module Exact;
