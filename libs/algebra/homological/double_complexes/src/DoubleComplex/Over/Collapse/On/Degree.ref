\use std.Logic[].Equality[].eq_reason_in;
\import Total.Degree[n := n] \as Term;
\import Target.Degree[n := n] \as TargetTerm;
\import Coordinates.Degree[n := n] \as SourceCoordinates;
\import TargetCoordinates.Degree[n := n] \as DestinationCoordinates;
\import Induced.Degree[n := n] \as Projection;
\module At(i: Index n) {
  \import Modules.Hom[V := Term.Carrier, W := D.family.Carrier i.first i.second, source := Term.space, target := D.family.space i.first i.second] \as Linear;
  \import Modules.Hom[V := TargetTerm.Carrier, W := D.family.Carrier i.first i.second, source := TargetTerm.space, target := D.family.space i.first i.second].Composition[U := Term.Carrier, domain := Term.space] \as After;
  \import Modules.Hom[V := C.family.Carrier i.first i.second, W := D.family.Carrier i.first i.second, source := C.family.space i.first i.second, target := D.family.space i.first i.second].Composition[U := Term.Carrier, domain := Term.space] \as Before;
  \definition after: Linear.Map := After.compose DestinationCoordinates.At[i := i].map Projection.map;
  \definition before: Linear.Map := Before.compose (f i.first i.second) SourceCoordinates.At[i := i].map;
  \definition own: \forall (x: C.family.Carrier i.first i.second) ->
    after.apply ((Term.Component[i := i].injection).apply x) = before.apply ((Term.Component[i := i].injection).apply x) :=
    \fun (x: C.family.Carrier i.first i.second) => eq_reason_in!{{D.family.Carrier i.first i.second} _
      "=" _ "by" { congr!{TargetTerm.Carrier {D.family.Carrier i.first i.second}} (DestinationCoordinates.coordinate i) _ _ (Projection.onInjection i x) }
      "=" _ "by" { DestinationCoordinates.own i ((f i.first i.second).apply x) }
      "=" _ "by" { sym!{{D.family.Carrier i.first i.second}} _ _
          (congr!{{C.family.Carrier i.first i.second} {D.family.Carrier i.first i.second}} ((f i.first i.second).apply) _ _ (SourceCoordinates.own i x)) }
    };
  \definition other: \forall (j: Index n) -> Logic.Not (j = i) ->
    \forall (x: C.family.Carrier j.first j.second) ->
    after.apply ((Term.Component[i := j].injection).apply x) = before.apply ((Term.Component[i := j].injection).apply x) :=
    \fun (j: Index n)(ne: Logic.Not (j = i))(x: C.family.Carrier j.first j.second) =>
      eq_reason_in!{{ D.family.Carrier i.first i.second } _
        "=" _ "by" { congr!{TargetTerm.Carrier {D.family.Carrier i.first i.second}} (DestinationCoordinates.coordinate i) _ _ (Projection.onInjection j x) }
        "=" _ "by" { DestinationCoordinates.other j i ((f j.first j.second).apply x) ne }
        "=" _ "by" { sym!{{D.family.Carrier i.first i.second}} _ _
          (trans!{{D.family.Carrier i.first i.second}} _ _ _
            (congr!{{C.family.Carrier i.first i.second} {D.family.Carrier i.first i.second}} ((f i.first i.second).apply) _ _ (SourceCoordinates.other j i x ne))
            (Modules.Hom[V := C.family.Carrier i.first i.second, W := D.family.Carrier i.first i.second, source := C.family.space i.first i.second, target := D.family.space i.first i.second].zeroPreserved (f i.first i.second))) }
      };
  \definition onInjection: \forall (j: Index n)(x: C.family.Carrier j.first j.second) ->
    after.apply ((Term.Component[i := j].injection).apply x) = before.apply ((Term.Component[i := j].injection).apply x) :=
    \fun (j: Index n) => either!{{(Classical.excludedMiddle (j = i))} {
      \forall (x: C.family.Carrier j.first j.second) -> after.apply ((Term.Component[i := j].injection).apply x) = before.apply ((Term.Component[i := j].injection).apply x)}
      {\fun (equal: j = i) => \idelim i = j \with k: Index n =>
        \forall (x: C.family.Carrier (Pair::first k) (Pair::second k)) -> after.apply ((Term.Component[i := k].injection).apply x) = before.apply ((Term.Component[i := k].injection).apply x)
        \by { base: own, equality: sym!{Pair} _ _ equal }}
      {other j}};
  \import Modules.DirectSum[Index := Index n, family := Term.family].To[W := D.family.Carrier i.first i.second, target := D.family.space i.first i.second] \as Universal;
  \definition equality: after = before := Universal.ext after before onInjection;
  \definition naturality: \forall (x: Term.Carrier) ->
    DestinationCoordinates.coordinate i (Induced.map.apply n x) = (f i.first i.second).apply (SourceCoordinates.coordinate i x) :=
    \fun (x: Term.Carrier) => congr!{Linear.Map {D.family.Carrier i.first i.second}} (\fun (g: Linear.Map) => g.apply x) _ _ equality;
  \definition kernel: \forall (x: Term.Carrier) -> Induced.map.apply n x = TargetTerm.space.zero ->
    (f i.first i.second).apply (SourceCoordinates.coordinate i x) = (D.family.space i.first i.second).zero :=
    \fun (x: Term.Carrier)(killed: _) => eq_reason_in!{{D.family.Carrier i.first i.second} _
      "=" _ "by" { sym!{{D.family.Carrier i.first i.second}} _ _ (naturality x) }
      "=" _ "by" { congr!{TargetTerm.Carrier {D.family.Carrier i.first i.second}} (DestinationCoordinates.coordinate i) _ _ killed }
      "=" _ "by" { DestinationCoordinates.At[i := i].zero }
    };
}
\import Modules.Of[V := Term.Carrier, space := Term.space].Submodule[] \as Submodules;
\import Submodules.Kernel[W := TargetTerm.Carrier, target := TargetTerm.space] \as Kernels;
\definition kernel: Submodules.Submodule := Kernels.kernel Projection.map;
\import Submodules.Of[S := kernel] \as Kernel;
\definition KernelCarrier: \Set := Kernel.Carrier;
\definition kernelSpace: Modules.Space KernelCarrier := Kernel.moduleSpace;
\definition kernelElement[x: Term.Carrier][killed: Killed n x]: Kernel.Carrier :=
  \into[Term.Carrier](x, kernel.carrier) \by { killed };
\definition killed: \forall (x: Kernel.Carrier) -> Killed n x :=
  \fun (x: Kernel.Carrier) => \bysub(Term.Carrier, kernel.carrier, x);
