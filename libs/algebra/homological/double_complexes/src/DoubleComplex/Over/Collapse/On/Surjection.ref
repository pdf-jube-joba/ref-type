\definition RowsOnto: \Prop := \forall (p: Nat.Nat^)(x: D.family.Carrier p Nat.Nat^::zero) ->
  \exists { y: C.family.Carrier p Nat.Nat^::zero \where #apply{(f p Nat.Nat^::zero)} y = x };
\import \parent.\parent.\parent.Concentrated[C := D] \as Concentration;
\import Chains.Map[C := Total.complex, D := Target.complex].SurjectiveQuasi[f := Induced.map] \as Quasi;
\definition onto: Concentration.Vanishes -> RowsOnto -> Quasi.Onto := \block {
  \fun (vanishes: Concentration.Vanishes)(rows: RowsOnto)(n: Nat.Nat^)(x: Target.Carrier n) \then
  \let value: D.family.Carrier n Nat.Nat^::zero := #apply{(Concentration.Degree[n := n].forward)} x \then
  \takefrom y: \Cast[C.family.Carrier n Nat.Nat^::zero] ({ y: C.family.Carrier n Nat.Nat^::zero \where #apply{(f n Nat.Nat^::zero)} y = value }) \by rows n value \then
  \let lift: Total.Carrier n := #apply{(Total.Degree[n := n].Component[i := Concentration.point n].injection)} y \then
  \return Logic.existsIntro[Total.Carrier n, { z: Total.Carrier n \where #apply{Induced.map} n z = x }] lift
    (trans!{{Target.Carrier n}} _ _ _ (Induced.Degree[n := n].onInjection (Concentration.point n) y)
      (trans!{{Target.Carrier n}} _ _ _
        (congr!{{D.family.Carrier n Nat.Nat^::zero} {Target.Carrier n}} (#apply{(Concentration.Degree[n := n].backward)}) _ _
          (\bysub(C.family.Carrier n Nat.Nat^::zero, { y: C.family.Carrier n Nat.Nat^::zero \where #apply{(f n Nat.Nat^::zero)} y = value }, y)))
        (Concentration.Degree[n := n].leftInverse vanishes x)))
};
