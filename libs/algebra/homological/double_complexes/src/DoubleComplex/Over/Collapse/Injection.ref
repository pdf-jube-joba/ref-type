\use std.Logic[].Equality[].eq_reason_in;
\definition n: Nat.Nat^ := Arithmetic.add p q;
\import Coordinates.Step[p := p, q := q] \as Step;
\import Coordinates.Degree[n := n] \as Current;
\import Coordinates.Degree[n := Nat.Nat^::succ n] \as Source;
\import Total.Degree[n := Nat.Nat^::succ n] \as SourceTerm;
\import \parent.Vertical[p := p, q := q] \as Vertical;
\import \parent.\parent.Sign[V := C.family.Carrier p q, space := C.family.space p q] \as TargetSign;
\import \parent.\parent.Sign[V := C.family.Carrier p (Nat.Nat^::succ q), space := C.family.space p (Nat.Nat^::succ q)] \as Sign;
\definition element[y: C.family.Carrier p (Nat.Nat^::succ q)]: Total.Carrier (Nat.Nat^::succ n) :=
  (SourceTerm.Component[i := Step.verticalIndex].injection).apply ((Sign.map p).apply y);
\definition boundary[y: C.family.Carrier p (Nat.Nat^::succ q)]: Total.Carrier n :=
  Total.differential.apply n (element y);
\definition firstDifferent: Logic.Not (Step.verticalIndex = Step.horizontalIndex) :=
  \fun (equal: Step.verticalIndex = Step.horizontalIndex) =>
    (Natural.ltNe p (Nat.Nat^::succ p) (Natural.ltOfSuccLe (Nat.Nat^::succ p) p (Natural.leRefl (Nat.Nat^::succ p))))
      (congr!{Pair Nat.Nat^} (\fun (i: Pair) => i.first) _ _ equal);
\import Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) q, W := C.family.Carrier p q, source := C.family.space (Nat.Nat^::succ p) q, target := C.family.space p q] \as Horizontal;
\import Modules.Laws[V := C.family.Carrier p q, space := C.family.space p q] \as Vectors;
\import algebra.Group[].Of[Carrier := C.family.Carrier p q, group := Vectors.additive] \as Group;
\definition atTop: \forall (x: C.family.Carrier p q)(y: C.family.Carrier p (Nat.Nat^::succ q)) ->
  (C.differential.vertical p q).apply y = x -> Current.coordinate Step.targetIndex (boundary y) = x :=
  \fun (x: C.family.Carrier p q)(y: C.family.Carrier p (Nat.Nat^::succ q))(preimage: _) =>
    eq_reason_in!{{C.family.Carrier p q} _
      "=" _ "by" { Step.differential (element y) }
      "=" _ "by" { congr!{{C.family.Carrier p q} {C.family.Carrier p q} {C.family.Carrier p q}} ((C.family.space p q).add) _ _ _ _
          (trans!{{C.family.Carrier p q}} _ _ _
            (congr!{{C.family.Carrier (Nat.Nat^::succ p) q} {C.family.Carrier p q}} ((C.differential.horizontal p q).apply) _ _
              (Source.other Step.verticalIndex Step.horizontalIndex ((Sign.map p).apply y) firstDifferent))
            (Horizontal.zeroPreserved (C.differential.horizontal p q)))
          (trans!{{C.family.Carrier p q}} _ _ _
            (congr!{{C.family.Carrier p (Nat.Nat^::succ q)} {C.family.Carrier p q}}
              (\fun (a: C.family.Carrier p (Nat.Nat^::succ q)) =>
                (TargetSign.map p).apply ((C.differential.vertical p q).apply a)) _ _
              (Source.own Step.verticalIndex ((Sign.map p).apply y)))
            (Vertical.signedPreimage x y preimage)) }
      "=" _ "by" { Group.zeroLeft x }
    };
\module At(i: Index n) {
  \import Coordinates.StepAt[n := n, i := i] \as Differential;
  \import \parent.\parent.\parent.Sign[V := C.family.Carrier i.first i.second, space := C.family.space i.first i.second] \as TargetSign;
  \import Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ i.first) i.second, W := C.family.Carrier i.first i.second,
    source := C.family.space (Nat.Nat^::succ i.first) i.second, target := C.family.space i.first i.second] \as Horizontal;
  \import Modules.Hom[V := C.family.Carrier i.first (Nat.Nat^::succ i.second), W := C.family.Carrier i.first i.second,
    source := C.family.space i.first (Nat.Nat^::succ i.second), target := C.family.space i.first i.second] \as Vertical;
  \import Modules.Hom[V := C.family.Carrier i.first i.second, W := C.family.Carrier i.first i.second,
    source := C.family.space i.first i.second, target := C.family.space i.first i.second] \as Signed;
  \import Modules.Laws[V := C.family.Carrier i.first i.second, space := C.family.space i.first i.second] \as Vectors;
  \import algebra.Group[].Of[Carrier := C.family.Carrier i.first i.second, group := Vectors.additive] \as Group;
  \definition differentVertical: Natural.Le (Nat.Nat^::succ p) i.first -> Logic.Not (Step.verticalIndex = Differential.verticalIndex) :=
    \fun (above: Natural.Le (Nat.Nat^::succ p) i.first)(equal: Step.verticalIndex = Differential.verticalIndex) =>
      (Natural.ltNe p i.first (Natural.ltOfSuccLe i.first p above))
        (congr!{Pair Nat.Nat^} (\fun (i: Pair) => i.first) _ _ equal);
  \definition differentHorizontal: Natural.Le (Nat.Nat^::succ p) i.first -> Logic.Not (Step.verticalIndex = Differential.horizontalIndex) :=
    \fun (above: Natural.Le (Nat.Nat^::succ p) i.first)(equal: Step.verticalIndex = Differential.horizontalIndex) =>
      (Natural.ltNe p (Nat.Nat^::succ i.first)
        (Natural.ltLeTrans p i.first (Nat.Nat^::succ i.first)
          (Natural.ltOfSuccLe i.first p above) (Natural.leSelfSucc i.first)))
        (congr!{Pair Nat.Nat^} (\fun (i: Pair) => i.first) _ _ equal);
  \definition zero: \forall (y: C.family.Carrier p (Nat.Nat^::succ q)) -> Natural.Le (Nat.Nat^::succ p) i.first ->
    Current.coordinate i (boundary y) = (C.family.space i.first i.second).zero :=
    \fun (y: C.family.Carrier p (Nat.Nat^::succ q))(above: Natural.Le (Nat.Nat^::succ p) i.first) =>
      eq_reason_in!{{C.family.Carrier i.first i.second} _
        "=" _ "by" { Differential.differential (element y) }
        "=" _ "by" { congr!{{C.family.Carrier i.first i.second} {C.family.Carrier i.first i.second} {C.family.Carrier i.first i.second}}
            ((C.family.space i.first i.second).add) _ _ _ _
            (trans!{{C.family.Carrier i.first i.second}} _ _ _
              (congr!{{C.family.Carrier (Nat.Nat^::succ i.first) i.second} {C.family.Carrier i.first i.second}}
                ((C.differential.horizontal i.first i.second).apply) _ _
                (Source.other Step.verticalIndex Differential.horizontalIndex ((Sign.map p).apply y) (differentHorizontal above)))
              (Horizontal.zeroPreserved (C.differential.horizontal i.first i.second)))
            (eq_reason_in!{{ C.family.Carrier i.first i.second } _
              "=" _ "by" { congr!{{C.family.Carrier i.first (Nat.Nat^::succ i.second)} {C.family.Carrier i.first i.second}}
                (\fun (a: C.family.Carrier i.first (Nat.Nat^::succ i.second)) =>
                  (TargetSign.map i.first).apply ((C.differential.vertical i.first i.second).apply a)) _ _
                (Source.other Step.verticalIndex Differential.verticalIndex ((Sign.map p).apply y) (differentVertical above)) }
              "=" _ "by" { congr!{{C.family.Carrier i.first i.second} {C.family.Carrier i.first i.second}} ((TargetSign.map i.first).apply) _ _
                  (Vertical.zeroPreserved (C.differential.vertical i.first i.second)) }
              "=" _ "by" { Signed.zeroPreserved (TargetSign.map i.first) }
            }) }
        "=" _ "by" { Group.zeroLeft (C.family.space i.first i.second).zero }
      };
}
\definition above: \forall (y: C.family.Carrier p (Nat.Nat^::succ q)) -> Above n (Nat.Nat^::succ p) (boundary y) :=
  \fun (y: C.family.Carrier p (Nat.Nat^::succ q))(i: Index n) => At[i := i].zero y;
