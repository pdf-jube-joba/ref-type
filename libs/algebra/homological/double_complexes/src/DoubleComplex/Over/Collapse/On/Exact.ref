\import Chains.Map[C := Total.complex, D := Target.complex].SurjectiveQuasi[f := Induced.map] \as Result;
\module At(n: Nat.Nat^) {
  \import \parent.\parent.Filtration[n := n] \as Filtration;
  \import \parent.\parent.Boundary[n := n] \as Boundary;
  \import \parent.\parent.Degree[n := Nat.Nat^::succ n] \as Next;
  \definition exact: \forall (rows: RowsExact[f])(vanishes: Concentrated.Vanishes)(x: Total.Carrier n) -> Closed n x -> Killed n x ->
    \exists Result.BoundaryAt[n, x] := \block {
    \fun (rows: RowsExact[f])(vanishes: Concentrated.Vanishes)(x: Total.Carrier n)(closed: Closed n x)(killed: Killed n x) \then
    \takefrom y: \Cast[Next.KernelCarrier] ({ y: Next.KernelCarrier \where #apply{Total.differential} n y = x })
      \by Filtration.exact rows vanishes x closed killed \then
    \return \exact(Result.BoundaryAt[n, x] {
        value := y,
        killed := Next.killed y,
        boundary := \bysub(Next.KernelCarrier, { y: Next.KernelCarrier \where #apply{Total.differential} n y = x }, y),
      }, Result.BoundaryAt[n, x])
  };
}
\definition exact: RowsExact[f] -> Concentrated.Vanishes -> Result.ExactCycles :=
  \fun (rows: RowsExact[f])(vanishes: Concentrated.Vanishes)(n: Nat.Nat^) => At[n := n].exact rows vanishes;
