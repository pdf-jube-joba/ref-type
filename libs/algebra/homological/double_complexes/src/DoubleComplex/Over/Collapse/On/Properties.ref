\use std.Logic[].Equality[].eq_reason_in;
\definition difference[n: Nat.Nat^][x, y: Total.Carrier n]: Total.Carrier n :=
  (Total.space n).add x ((Total.space n).neg y);
\definition boundaryClosed: \forall (n: Nat.Nat^)(y: Total.Carrier (Nat.Nat^::succ n)) -> Closed n (Total.differential.apply n y) :=
  \induction (n: Nat.Nat^) \return \forall (y: Total.Carrier (Nat.Nat^::succ n)) -> Closed n (Total.differential.apply n y) \with {
    | zero: \fun (y: Total.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => Logic.True::intro
    | succ: \fun (n: Nat.Nat^)(previous: _)(y: Total.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => Total.squareZero n y
  };
\module Successor(n: Nat.Nat^) {
  \import Total.Step[n := n] \as Boundary;
  \import Modules.Hom[V := Total.Carrier (Nat.Nat^::succ n), W := Total.Carrier n, source := Total.space (Nat.Nat^::succ n), target := Total.space n] \as Maps;
  \import Modules.Laws[V := Total.Carrier n, space := Total.space n] \as Laws;
  \import algebra.Group[].Of[Carrier := Total.Carrier n, group := Laws.additive] \as Group;
  \definition closedDifference: \forall (x, y: Total.Carrier (Nat.Nat^::succ n)) -> Closed (Nat.Nat^::succ n) x -> Closed (Nat.Nat^::succ n) y ->
    Closed (Nat.Nat^::succ n) (difference (Nat.Nat^::succ n) x y) :=
    \fun (x, y: Total.Carrier (Nat.Nat^::succ n))(left: Closed (Nat.Nat^::succ n) x)(right: Closed (Nat.Nat^::succ n) y) =>
      eq_reason_in!{{Total.Carrier n} _
        "=" _ "by" { Maps.differencePreserved Boundary.differential x y }
        "=" _ "by" { congr!{{Total.Carrier n} {Total.Carrier n} {Total.Carrier n}} Group.difference _ _ _ _ left right }
        "=" _ "by" { Group.inverseRight (Total.space n).zero }
      };
}
\definition differenceClosed: \forall (n: Nat.Nat^)(x, y: Total.Carrier n) -> Closed n x -> Closed n y -> Closed n (difference n x y) :=
  \induction (n: Nat.Nat^) \return \forall (x, y: Total.Carrier n) -> Closed n x -> Closed n y -> Closed n (difference n x y) \with {
    | zero: \fun (x, y: Total.Carrier Nat.Nat^::zero)(left: Closed Nat.Nat^::zero x)(right: Closed Nat.Nat^::zero y) => Logic.True::intro
    | succ: \fun (n: Nat.Nat^)(previous: _) => Successor[n := n].closedDifference
  };
\module Degree(n: Nat.Nat^) {
  \import Induced.Degree[n := n] \as Projection;
  \import Modules.Hom[V := Total.Carrier n, W := Target.Carrier n, source := Total.space n, target := Target.space n] \as Maps;
  \import Modules.Laws[V := Target.Carrier n, space := Target.space n] \as Laws;
  \import algebra.Group[].Of[Carrier := Target.Carrier n, group := Laws.additive] \as Group;
  \definition differenceKilled: \forall (x, y: Total.Carrier n) -> Killed n x -> Killed n y -> Killed n (difference n x y) :=
    \fun (x, y: Total.Carrier n)(left: Killed n x)(right: Killed n y) =>
      eq_reason_in!{{Target.Carrier n} _
        "=" _ "by" { Maps.differencePreserved Projection.map x y }
        "=" _ "by" { congr!{{Target.Carrier n} {Target.Carrier n} {Target.Carrier n}} Group.difference _ _ _ _ left right }
        "=" _ "by" { Group.inverseRight (Target.space n).zero }
      };
}
\definition differenceKilled: \forall (n: Nat.Nat^)(x, y: Total.Carrier n) -> Killed n x -> Killed n y -> Killed n (difference n x y) :=
  \fun (n: Nat.Nat^) => Degree[n := n].differenceKilled;
\module Boundary(n: Nat.Nat^) {
  \import Target.Step[n := n] \as Boundary;
  \import Modules.Hom[V := Target.Carrier (Nat.Nat^::succ n), W := Target.Carrier n, source := Target.space (Nat.Nat^::succ n), target := Target.space n] \as Maps;
  \definition killed: \forall (y: Total.Carrier (Nat.Nat^::succ n)) -> Killed (Nat.Nat^::succ n) y -> Killed n (Total.differential.apply n y) :=
    \fun (y: Total.Carrier (Nat.Nat^::succ n))(zero: Killed (Nat.Nat^::succ n) y) => eq_reason_in!{{Target.Carrier n} _
      "=" _ "by" { sym!{{Target.Carrier n}} _ _ (Induced.map.commutes n y) }
      "=" _ "by" { congr!{{Target.Carrier (Nat.Nat^::succ n)} {Target.Carrier n}} (Target.differential.apply n) _ _ zero }
      "=" _ "by" { Maps.zeroPreserved Boundary.differential }
    };
}
\definition boundaryKilled: \forall (n: Nat.Nat^)(y: Total.Carrier (Nat.Nat^::succ n)) -> Killed (Nat.Nat^::succ n) y -> Killed n (Total.differential.apply n y) :=
  \fun (n: Nat.Nat^) => Boundary[n := n].killed;
\definition remainderClosed: \forall (n: Nat.Nat^)(x: Total.Carrier n)(y: Total.Carrier (Nat.Nat^::succ n)) -> Closed n x -> Closed n (difference n x (Total.differential.apply n y)) :=
  \fun (n: Nat.Nat^)(x: Total.Carrier n)(y: Total.Carrier (Nat.Nat^::succ n))(closed: Closed n x) =>
    differenceClosed n x (Total.differential.apply n y) closed (boundaryClosed n y);
\definition remainderKilled: \forall (n: Nat.Nat^)(x: Total.Carrier n)(y: Total.Carrier (Nat.Nat^::succ n)) -> Killed n x -> Killed (Nat.Nat^::succ n) y ->
  Killed n (difference n x (Total.differential.apply n y)) :=
  \fun (n: Nat.Nat^)(x: Total.Carrier n)(y: Total.Carrier (Nat.Nat^::succ n))(killed: Killed n x)(zero: Killed (Nat.Nat^::succ n) y) =>
    differenceKilled n x (Total.differential.apply n y) killed (boundaryKilled n y zero);
