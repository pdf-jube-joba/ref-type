\import \parent.Total[C := C] \as Total;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\module Degree(n: Nat.Nat^) {
  \import Total.Degree[n := n] \as Term;
  \import Modules.DirectSum[Index := Index n, family := Term.family].FiniteSupport[] \as Native;
  \definition coordinate(i: Index n)(x: Term.Carrier): C.family.Carrier #first{i} #second{i} := (#apply{Native.forward} x) i;
  \module At(i: Index n) {
    \import Native.At[i := i] \as Evaluation;
    \import Modules.Hom[V := Term.Carrier, W := C.family.Carrier #first{i} #second{i},
      source := Term.space, target := C.family.space #first{i} #second{i}] \as Maps;
    \definition map: Maps.Map := Evaluation.evaluate;
    \definition zero: coordinate i #zero{Term.space} = #zero{(C.family.space #first{i} #second{i})} := Maps.zeroPreserved map;
  }
  \definition own: \forall (i: Index n)(x: C.family.Carrier #first{i} #second{i}) ->
    coordinate i (#apply{(Term.Component[i := i].injection)} x) = x := Native.atOwn;
  \definition other: \forall (i, j: Index n)(x: C.family.Carrier #first{i} #second{i}) -> Logic.Not (i = j) ->
    coordinate j (#apply{(Term.Component[i := i].injection)} x) = #zero{(C.family.space #first{j} #second{j})} := Native.atOther;
  \definition ext: \forall (x, y: Term.Carrier) -> (\forall (i: Index n) -> coordinate i x = coordinate i y) -> x = y :=
    \fun (x, y: Term.Carrier)(same: \forall (i: Index n) -> coordinate i x = coordinate i y) =>
      Native.injective x y (\axiom:funext(#apply{Native.forward} x, #apply{Native.forward} y, same));
  \definition zero: \forall (x: Term.Carrier) -> (\forall (i: Index n) -> coordinate i x = #zero{(C.family.space #first{i} #second{i})}) -> x = #zero{Term.space} :=
    \fun (x: Term.Carrier)(vanishes: \forall (i: Index n) -> coordinate i x = #zero{(C.family.space #first{i} #second{i})}) =>
      ext x #zero{Term.space} (\fun (i: Index n) => trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _ (vanishes i) (sym!{{C.family.Carrier #first{i} #second{i}}} _ _ At[i := i].zero));
}
\definition raiseHorizontal(i: Pair): Pair := Pair { first := Nat.Nat^::succ #first{i}, second := #second{i} };
\definition raiseVertical(i: Pair): Pair := Pair { first := #first{i}, second := Nat.Nat^::succ #second{i} };
\module Step(p, q: Nat.Nat^);

\definition raiseHorizontalIndex(n: Nat.Nat^)(i: Index n): Index (Nat.Nat^::succ n) :=
  \into[Pair](raiseHorizontal i, { j: Pair \where Arithmetic.add #first{j} #second{j} = Nat.Nat^::succ n }) \by {
    trans!{Nat.Nat^} _ _ _ (Natural.addSuccLeft #first{i} #second{i})
      (congr!{Nat.Nat^ Nat.Nat^} Nat.Nat^::succ _ _ (degree n i))
  };
\definition raiseVerticalIndex(n: Nat.Nat^)(i: Index n): Index (Nat.Nat^::succ n) :=
  \into[Pair](raiseVertical i, { j: Pair \where Arithmetic.add #first{j} #second{j} = Nat.Nat^::succ n }) \by {
    congr!{Nat.Nat^ Nat.Nat^} Nat.Nat^::succ _ _ (degree n i)
  };
\definition Formula(n: Nat.Nat^)(i: Index n): \Prop := \forall (x: Total.Carrier (Nat.Nat^::succ n)) ->
  Degree[n := n].coordinate i (#apply{Total.differential} n x) =
  #add{(C.family.space #first{i} #second{i})}
    (#apply{(C.differential.horizontal #first{i} #second{i})} (Degree[n := Nat.Nat^::succ n].coordinate (raiseHorizontalIndex n i) x))
    (#apply{(\parent.Sign[V := C.family.Carrier #first{i} #second{i}, space := C.family.space #first{i} #second{i}].map #first{i})}
      (#apply{(C.differential.vertical #first{i} #second{i})} (Degree[n := Nat.Nat^::succ n].coordinate (raiseVerticalIndex n i) x)));
\definition diagonal(n, p, q: Nat.Nat^)(same: Arithmetic.add p q = n): Index n :=
  \into[Pair](Pair { first := p, second := q }, { i: Pair \where Arithmetic.add #first{i} #second{i} = n }) \by { same };
\module Transported(p, q: Nat.Nat^);
\module StepAt(n: Nat.Nat^, i: Index n);
