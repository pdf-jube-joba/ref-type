\import \parent.Total[C := C] \as Total;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\module Degree(n: Nat.Nat^) {
  \import Total.Degree[n := n] \as Term;
  \import Modules.DirectSum[Index := Index n, family := Term.family].FiniteSupport[] \as Native;
  \definition coordinate[i: Index n][x: Term.Carrier]: C.family.Carrier i.first i.second := (Native.forward.apply x) i;
  \module At(i: Index n) {
    \import Native.At[i := i] \as Evaluation;
    \import Modules.Hom[V := Term.Carrier, W := C.family.Carrier i.first i.second,
      source := Term.space, target := C.family.space i.first i.second] \as Maps;
    \definition map: Maps.Map := Evaluation.evaluate;
    \definition zero: coordinate i Term.space.zero = (C.family.space i.first i.second).zero := Maps.zeroPreserved map;
  }
  \definition own: \forall (i: Index n)(x: C.family.Carrier i.first i.second) ->
    coordinate i ((Term.Component[i := i].injection).apply x) = x := Native.atOwn;
  \definition other: \forall (i, j: Index n)(x: C.family.Carrier i.first i.second) -> Logic.Not (i = j) ->
    coordinate j ((Term.Component[i := i].injection).apply x) = (C.family.space j.first j.second).zero := Native.atOther;
  \definition ext: \forall (x, y: Term.Carrier) -> (\forall (i: Index n) -> coordinate i x = coordinate i y) -> x = y :=
    \fun (x, y: Term.Carrier)(same: \forall (i: Index n) -> coordinate i x = coordinate i y) =>
      Native.injective x y (\axiom:funext(Native.forward.apply x, Native.forward.apply y, same));
  \definition zero: \forall (x: Term.Carrier) -> (\forall (i: Index n) -> coordinate i x = (C.family.space i.first i.second).zero) -> x = Term.space.zero :=
    \fun (x: Term.Carrier)(vanishes: \forall (i: Index n) -> coordinate i x = (C.family.space i.first i.second).zero) =>
      ext x Term.space.zero (\fun (i: Index n) => trans!{{C.family.Carrier i.first i.second}} _ _ _ (vanishes i) (sym!{{C.family.Carrier i.first i.second}} _ _ At[i := i].zero));
}
\definition raiseHorizontal[i: Pair]: Pair := Pair { first := Nat.Nat^::succ i.first, second := i.second };
\definition raiseVertical[i: Pair]: Pair := Pair { first := i.first, second := Nat.Nat^::succ i.second };
\module Step(p, q: Nat.Nat^);

\definition raiseHorizontalIndex[n: Nat.Nat^][i: Index n]: Index (Nat.Nat^::succ n) :=
  \into[Pair](raiseHorizontal i, { j: Pair \where Arithmetic.add j.first j.second = Nat.Nat^::succ n }) \by {
    trans!{Nat.Nat^} _ _ _ (Natural.addSuccLeft i.first i.second)
      (congr!{Nat.Nat^ Nat.Nat^} Nat.Nat^::succ _ _ (degree n i))
  };
\definition raiseVerticalIndex[n: Nat.Nat^][i: Index n]: Index (Nat.Nat^::succ n) :=
  \into[Pair](raiseVertical i, { j: Pair \where Arithmetic.add j.first j.second = Nat.Nat^::succ n }) \by {
    congr!{Nat.Nat^ Nat.Nat^} Nat.Nat^::succ _ _ (degree n i)
  };
\definition Formula[n: Nat.Nat^][i: Index n]: \Prop := \forall (x: Total.Carrier (Nat.Nat^::succ n)) ->
  Degree[n := n].coordinate i (Total.differential.apply n x) =
  (C.family.space i.first i.second).add
    ((C.differential.horizontal i.first i.second).apply (Degree[n := Nat.Nat^::succ n].coordinate (raiseHorizontalIndex n i) x))
    ((\parent.Sign[V := C.family.Carrier i.first i.second, space := C.family.space i.first i.second].map i.first).apply
      ((C.differential.vertical i.first i.second).apply (Degree[n := Nat.Nat^::succ n].coordinate (raiseVerticalIndex n i) x)));
\definition diagonal[n, p, q: Nat.Nat^][same: Arithmetic.add p q = n]: Index n :=
  \into[Pair](Pair { first := p, second := q }, { i: Pair \where Arithmetic.add i.first i.second = n }) \by { same };
\module Transported(p, q: Nat.Nat^);
\module StepAt(n: Nat.Nat^, i: Index n);
\module Product(n: Nat.Nat^);
\module Zero;
