\structure Laws: \Prop {
  retracts: \forall (j: Index)(x: left.Carrier j) -> (r j).apply ((i j).apply x) = x,
  section: \forall (j: Index)(x: right.Carrier j) -> (p j).apply ((s j).apply x) = x,
  zero: \forall (j: Index)(x: left.Carrier j) -> (p j).apply ((i j).apply x) = (right.space j).zero,
  decomposition: \forall (j: Index)(x: middle.Carrier j) ->
    (middle.space j).add ((i j).apply ((r j).apply x)) ((s j).apply ((p j).apply x)) = x,
}
\import Inclusions.On[f := i] \as Inclusion;
\import Projections.On[f := p] \as Projection;
\import Retractions.On[f := r] \as Retraction;
\import Sections.On[f := s] \as Section;
\definition inclusion: Modules.MapBetween Left.bundle Middle.bundle := Inclusion.map;
\definition projection: Modules.MapBetween Middle.bundle Right.bundle := Projection.map;
\definition retraction: Modules.MapBetween Middle.bundle Left.bundle := Retraction.map;
\definition section: Modules.MapBetween Right.bundle Middle.bundle := Section.map;
\import Left.FiniteSupport[] \as L;
\import Middle.FiniteSupport[] \as M;
\import Right.FiniteSupport[] \as Q;
\definition retracts: Laws -> \forall (x: Left.Carrier) -> retraction.apply (inclusion.apply x) = x :=
  \fun (laws: Laws)(x: Left.Carrier) => L.injective (retraction.apply (inclusion.apply x)) x (\axiom:funext(L.coordinates (retraction.apply (inclusion.apply x)), L.coordinates x, \fun (j: Index) =>
    trans!{{left.Carrier j}} _ _ _ (Retraction.coordinatesNatural (inclusion.apply x) j)
      (trans!{{left.Carrier j}} _ _ _
        (congr!{{middle.Carrier j} {left.Carrier j}} ((r j).apply) _ _ (Inclusion.coordinatesNatural x j))
        (laws.retracts j (L.coordinates x j)))));
\definition sectionLaw: Laws -> \forall (x: Right.Carrier) -> projection.apply (section.apply x) = x :=
  \fun (laws: Laws)(x: Right.Carrier) => Q.injective (projection.apply (section.apply x)) x (\axiom:funext(Q.coordinates (projection.apply (section.apply x)), Q.coordinates x, \fun (j: Index) =>
    trans!{{right.Carrier j}} _ _ _ (Projection.coordinatesNatural (section.apply x) j)
      (trans!{{right.Carrier j}} _ _ _
        (congr!{{middle.Carrier j} {right.Carrier j}} ((p j).apply) _ _ (Section.coordinatesNatural x j))
        (laws.section j (Q.coordinates x j)))));
\import Modules.Product[Index := Index, family := right] \as RightProduct;
\definition zero: Laws -> \forall (x: Left.Carrier) -> projection.apply (inclusion.apply x) = Right.space.zero :=
  \fun (laws: Laws)(x: Left.Carrier) => Q.injective (projection.apply (inclusion.apply x)) Right.space.zero (\axiom:funext(Q.coordinates (projection.apply (inclusion.apply x)), Q.coordinates Right.space.zero, \fun (j: Index) =>
    trans!{{right.Carrier j}} _ _ _ (Projection.coordinatesNatural (inclusion.apply x) j)
      (trans!{{right.Carrier j}} _ _ _
        (congr!{{middle.Carrier j} {right.Carrier j}} ((p j).apply) _ _ (Inclusion.coordinatesNatural x j))
        (trans!{{right.Carrier j}} _ _ _ (laws.zero j (L.coordinates x j))
          (sym!{{right.Carrier j}} _ _ (congr!{RightProduct.Carrier {right.Carrier j}} (\fun (v: RightProduct.Carrier) => v j) _ _ Q.coordinatesZero))))));
\import Modules.Product[Index := Index, family := middle] \as MiddleProduct;
\definition decomposition: Laws -> \forall (x: Middle.Carrier) ->
  Middle.space.add (inclusion.apply (retraction.apply x)) (section.apply (projection.apply x)) = x :=
  \fun (laws: Laws)(x: Middle.Carrier) => M.injective (Middle.space.add (inclusion.apply (retraction.apply x)) (section.apply (projection.apply x))) x (\axiom:funext(M.coordinates (Middle.space.add (inclusion.apply (retraction.apply x)) (section.apply (projection.apply x))), M.coordinates x, \fun (j: Index) =>
    trans!{{middle.Carrier j}} _ _ _
      (congr!{MiddleProduct.Carrier {middle.Carrier j}} (\fun (v: MiddleProduct.Carrier) => v j) _ _
        (M.coordinatesAddition (inclusion.apply (retraction.apply x)) (section.apply (projection.apply x))))
      (trans!{{middle.Carrier j}} _ _ _
        (congr2!{{middle.Carrier j} {middle.Carrier j} {middle.Carrier j}} ((middle.space j).add) _ _ _ _
          (trans!{{middle.Carrier j}} _ _ _ (Inclusion.coordinatesNatural (retraction.apply x) j)
            (congr!{{left.Carrier j} {middle.Carrier j}} ((i j).apply) _ _ (Retraction.coordinatesNatural x j)))
          (trans!{{middle.Carrier j}} _ _ _ (Section.coordinatesNatural (projection.apply x) j)
            (congr!{{right.Carrier j} {middle.Carrier j}} ((s j).apply) _ _ (Projection.coordinatesNatural x j))))
        (laws.decomposition j (M.coordinates x j)))));
\definition injective: Laws -> Modules.Injective Left.bundle Middle.bundle inclusion :=
  \fun (laws: Laws)(x, y: Left.Carrier)(equal: inclusion.apply x = inclusion.apply y) =>
    trans!{Left.Carrier} _ _ _ (sym!{Left.Carrier} _ _ (retracts laws x))
      (trans!{Left.Carrier} _ _ _ (congr!{Middle.Carrier Left.Carrier} (retraction.apply) _ _ equal) (retracts laws y));
\import std.Logic[].Proposition[] \as Existential;
\definition onto: Laws -> Modules.Surjective Middle.bundle Right.bundle projection :=
  \fun (laws: Laws)(x: Right.Carrier) => Existential.existsIntro[Middle.Carrier,
    { y: Middle.Carrier \where projection.apply y = x }] (section.apply x) (sectionLaw laws x);
\import Modules.Hom[V := Right.Carrier, W := Middle.Carrier, source := Right.space, target := Middle.space] \as SectionMaps;
\import Modules.Laws[V := Middle.Carrier, space := Middle.space] \as MiddleLaws;
\import algebra.Group[].Of[Carrier := Middle.Carrier, group := MiddleLaws.additive] \as MiddleGroup;
\definition kernelImage: Laws -> \forall (x: Middle.Carrier) -> projection.apply x = Right.space.zero ->
  \exists { y: Left.Carrier \where inclusion.apply y = x } :=
  \fun (laws: Laws)(x: Middle.Carrier)(closed: projection.apply x = Right.space.zero) =>
    Existential.existsIntro[Left.Carrier, { y: Left.Carrier \where inclusion.apply y = x }] (retraction.apply x)
      (trans!{Middle.Carrier} _ _ _
        (sym!{Middle.Carrier} _ _ (MiddleGroup.zeroRight (inclusion.apply (retraction.apply x))))
        (trans!{Middle.Carrier} _ _ _
          (congr!{Middle.Carrier Middle.Carrier} (Middle.space.add (inclusion.apply (retraction.apply x))) _ _
            (sym!{Middle.Carrier} _ _ (trans!{Middle.Carrier} _ _ _
              (congr!{Right.Carrier Middle.Carrier} (section.apply) _ _ closed) (SectionMaps.zeroPreserved section))))
          (decomposition laws x)));
\import Modules.ShortExact[A := Left.bundle, B := Middle.bundle, C := Right.bundle] \as Short;
\definition sequence(laws: Laws): Short.Sequence := Short.Sequence {
  inclusion := inclusion, projection := projection, injective := injective laws,
  onto := onto laws, zero := zero laws, kernelImage := kernelImage laws,
};
