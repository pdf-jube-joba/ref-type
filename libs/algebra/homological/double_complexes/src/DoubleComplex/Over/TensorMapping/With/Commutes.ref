\use std.Logic[].Equality[].eq_reason_in;
\import Source.Term[p := p, q := q] \as S;
\import Target.Term[p := p, q := q] \as T;
\import Source.At[p := p, q := q] \as SD;
\import Target.At[p := p, q := q] \as TD;
\import \parent.Degree[p := p, q := q] \as Current;
\module Horizontal {
  \import Source.Term[p := Nat.Nat^::succ p, q := q] \as SN;
  \import Target.Term[p := Nat.Nat^::succ p, q := q] \as TN;
  \import \parent.\parent.Degree[p := Nat.Nat^::succ p, q := q] \as Next;
  \import Modules.Hom[V := TN.Carrier, W := T.Carrier, source := TN.space, target := T.space].Composition[U := SN.Carrier, domain := SN.space] \as After;
  \import Modules.Hom[V := S.Carrier, W := T.Carrier, source := S.space, target := T.space].Composition[U := SN.Carrier, domain := SN.space] \as Before;
  \import Modules.Hom[V := SN.Carrier, W := T.Carrier, source := SN.space, target := T.space] \as Maps;
  \import Modules.Tensor[V := C.family.Carrier (Nat.Nat^::succ p), W := E.family.Carrier q, left := C.family.space (Nat.Nat^::succ p), right := E.family.space q].Universal[U := T.Carrier, target := T.space] \as Universal;
  \definition equality: After.compose TD.horizontal Next.map = Before.compose Current.map SD.horizontal :=
    Universal.ext (After.compose TD.horizontal Next.map) (Before.compose Current.map SD.horizontal)
      (\fun (x: C.family.Carrier (Nat.Nat^::succ p))(y: E.family.Carrier q) => eq_reason_in!{T.Carrier _
        "=" _ "by" { congr!{TN.Carrier T.Carrier} (TD.horizontal.apply) _ _ (Next.onTensor x y) }
        "=" _ "by" { TD.horizontalOnTensor (f.apply (Nat.Nat^::succ p) x) (g.apply q y) }
        "=" _ "by" { congr!{{D.family.Carrier p} T.Carrier} (\fun (z: D.family.Carrier p) => T.tensor z (g.apply q y)) _ _ (f.commutes p x) }
        "=" _ "by" { sym!{T.Carrier} _ _ (trans!{T.Carrier} _ _ _
              (congr!{S.Carrier T.Carrier} (Current.map.apply) _ _ (SD.horizontalOnTensor x y))
              (Current.onTensor (C.differential.apply p x) (y))) }
      });
  \definition point: \forall (x: SN.Carrier) -> TD.horizontal.apply (Next.map.apply x) = Current.map.apply (SD.horizontal.apply x) :=
    \fun (x: SN.Carrier) => congr!{Maps.Map T.Carrier} (\fun (h: Maps.Map) => h.apply x) _ _ equality;
}
\definition horizontal: \forall (x: Source.Term[p := Nat.Nat^::succ p, q := q].Carrier) ->
  TD.horizontal.apply ((\parent.Degree[p := Nat.Nat^::succ p, q := q].map).apply x) = Current.map.apply (SD.horizontal.apply x) := Horizontal[].point;
\module Vertical {
  \import Source.Term[p := p, q := Nat.Nat^::succ q] \as SN;
  \import Target.Term[p := p, q := Nat.Nat^::succ q] \as TN;
  \import \parent.\parent.Degree[p := p, q := Nat.Nat^::succ q] \as Next;
  \import Modules.Hom[V := TN.Carrier, W := T.Carrier, source := TN.space, target := T.space].Composition[U := SN.Carrier, domain := SN.space] \as After;
  \import Modules.Hom[V := S.Carrier, W := T.Carrier, source := S.space, target := T.space].Composition[U := SN.Carrier, domain := SN.space] \as Before;
  \import Modules.Hom[V := SN.Carrier, W := T.Carrier, source := SN.space, target := T.space] \as Maps;
  \import Modules.Tensor[V := C.family.Carrier p, W := E.family.Carrier (Nat.Nat^::succ q), left := C.family.space p, right := E.family.space (Nat.Nat^::succ q)].Universal[U := T.Carrier, target := T.space] \as Universal;
  \definition equality: After.compose TD.vertical Next.map = Before.compose Current.map SD.vertical :=
    Universal.ext (After.compose TD.vertical Next.map) (Before.compose Current.map SD.vertical)
      (\fun (x: C.family.Carrier p)(y: E.family.Carrier (Nat.Nat^::succ q)) => eq_reason_in!{T.Carrier _
        "=" _ "by" { congr!{TN.Carrier T.Carrier} (TD.vertical.apply) _ _ (Next.onTensor x y) }
        "=" _ "by" { TD.verticalOnTensor (f.apply p x) (g.apply (Nat.Nat^::succ q) y) }
        "=" _ "by" { congr!{{F.family.Carrier q} T.Carrier} (T.tensor (f.apply p x)) _ _ (g.commutes q y) }
        "=" _ "by" { sym!{T.Carrier} _ _ (trans!{T.Carrier} _ _ _
              (congr!{S.Carrier T.Carrier} (Current.map.apply) _ _ (SD.verticalOnTensor x y))
              (Current.onTensor (x) (E.differential.apply q y))) }
      });
  \definition point: \forall (x: SN.Carrier) -> TD.vertical.apply (Next.map.apply x) = Current.map.apply (SD.vertical.apply x) :=
    \fun (x: SN.Carrier) => congr!{Maps.Map T.Carrier} (\fun (h: Maps.Map) => h.apply x) _ _ equality;
}
\definition vertical: \forall (x: Source.Term[p := p, q := Nat.Nat^::succ q].Carrier) ->
  TD.vertical.apply ((\parent.Degree[p := p, q := Nat.Nat^::succ q].map).apply x) = Current.map.apply (SD.vertical.apply x) := Vertical[].point;
