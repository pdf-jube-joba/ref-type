\use std.Logic[].Equality[].eq_reason_in;
\definition n: Nat.Nat^ := Arithmetic.add p q;
\definition targetIndex: Index n := \into[Pair](Pair { first := p, second := q }, { i: Pair \where Arithmetic.add i.first i.second = n }) \by { \refl(n) };
\definition horizontalIndex: Index (Nat.Nat^::succ n) := \into[Pair](Pair { first := Nat.Nat^::succ p, second := q },
  { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ n }) \by { Natural.addSuccLeft p q };
\definition verticalIndex: Index (Nat.Nat^::succ n) := \into[Pair](Pair { first := p, second := Nat.Nat^::succ q },
  { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ n }) \by { \refl(Nat.Nat^::succ n) };
\import Total.Degree[n := n] \as Target;
\import Total.Degree[n := Nat.Nat^::succ n] \as Source;
\import Total.Step[n := n] \as Differential;
\import \parent.Degree[n := n] \as TC;
\import \parent.Degree[n := Nat.Nat^::succ n] \as SC;
\import TC.At[i := targetIndex] \as Evaluation;
\import SC.At[i := horizontalIndex] \as HorizontalEvaluation;
\import SC.At[i := verticalIndex] \as VerticalEvaluation;
\import Modules.Hom[V := Source.Carrier, W := C.family.Carrier p q, source := Source.space, target := C.family.space p q] \as Maps;
\import Modules.Laws[V := C.family.Carrier p q, space := C.family.space p q] \as TargetLaws;
\module Horizontal;
\module Vertical;
\definition differential: \forall (x: Source.Carrier) ->
  TC.coordinate targetIndex (Total.differential.apply n x) =
  (C.family.space p q).add
    ((C.differential.horizontal p q).apply (SC.coordinate horizontalIndex x))
    ((\parent.\parent.Sign[V := C.family.Carrier p q, space := C.family.space p q].map p).apply
      ((C.differential.vertical p q).apply (SC.coordinate verticalIndex x))) :=
  \fun (x: Source.Carrier) => eq_reason_in!{{C.family.Carrier p q} _
    "=" _ "by" { congr!{Target.Carrier {C.family.Carrier p q}} (TC.coordinate targetIndex) _ _
      (congr!{{Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map} Target.Carrier}
        (\fun (f: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map) => f.apply x) _ _ Differential.asSum) }
    "=" _ "by" { Evaluation.map.addition (Differential.horizontalTotal.apply x) (Differential.verticalTotal.apply x) }
    "=" _ "by" { congr!{{C.family.Carrier p q} {C.family.Carrier p q} {C.family.Carrier p q}} ((C.family.space p q).add) _ _ _ _
        (Horizontal[].point x) (Vertical[].point x) }
  };
