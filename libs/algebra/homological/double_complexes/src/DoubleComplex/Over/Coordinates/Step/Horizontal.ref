\definition original: Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) q, W := C.family.Carrier p q,
  source := C.family.space (Nat.Nat^::succ p) q, target := C.family.space p q].Map := C.differential.horizontal p q;
\import Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) q, W := C.family.Carrier p q, source := C.family.space (Nat.Nat^::succ p) q, target := C.family.space p q] \as OriginalMaps;
\import Modules.Hom[V := Target.Carrier, W := C.family.Carrier p q, source := Target.space, target := C.family.space p q].Composition[U := Source.Carrier, domain := Source.space] \as After;
\import OriginalMaps.Composition[U := Source.Carrier, domain := Source.space] \as Before;
\definition after: Maps.Map := After.compose Evaluation.map Differential.horizontalTotal;
\definition before: Maps.Map := Before.compose original HorizontalEvaluation.map;
\definition own: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  after.apply ((Source.Component[i := horizontalIndex].injection).apply x) = before.apply ((Source.Component[i := horizontalIndex].injection).apply x) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{{C.family.Carrier p q}} _ _ _
    (congr!{Target.Carrier {C.family.Carrier p q}} (TC.coordinate targetIndex) _ _ (Differential.horizontalOnInjection horizontalIndex x))
    (trans!{{C.family.Carrier p q}} _ _ _ (TC.own targetIndex (original.apply x))
      (sym!{{C.family.Carrier p q}} _ _ (congr!{{C.family.Carrier (Nat.Nat^::succ p) q} {C.family.Carrier p q}} (original.apply) _ _ (SC.own horizontalIndex x))));
\definition Off[a: Nat.Nat^]: \Prop := \forall (b: Second (Nat.Nat^::succ n) a) ->
  Logic.Not (index (Nat.Nat^::succ n) a b = horizontalIndex) ->
  \forall (x: C.family.Carrier a b) -> TC.coordinate targetIndex ((Differential.horizontal a b).apply x) = (C.family.space p q).zero;
\module Positive(a: Nat.Nat^, b: Second (Nat.Nat^::succ n) (Nat.Nat^::succ a)) {
  \definition lowerIndex: Index n := index n a (Differential.lowerSecond a b);
  \definition sourceIndex: Index (Nat.Nat^::succ n) := index (Nat.Nat^::succ n) (Nat.Nat^::succ a) b;
  \definition different: Logic.Not (sourceIndex = horizontalIndex) -> Logic.Not (lowerIndex = targetIndex) :=
    \fun (ne: Logic.Not (sourceIndex = horizontalIndex))(equal: lowerIndex = targetIndex) =>
      ne (congr!{Pair Pair} raiseHorizontal lowerIndex targetIndex equal);
  \definition zero: Logic.Not (sourceIndex = horizontalIndex) ->
    \forall (x: C.family.Carrier (Nat.Nat^::succ a) b) ->
      TC.coordinate targetIndex ((Differential.horizontal (Nat.Nat^::succ a) b).apply x) = (C.family.space p q).zero :=
    \fun (ne: Logic.Not (sourceIndex = horizontalIndex))(x: C.family.Carrier (Nat.Nat^::succ a) b) =>
      TC.other lowerIndex targetIndex ((C.differential.horizontal a b).apply x) (different ne);
}
\definition off: \forall (a: Nat.Nat^) -> Off a :=
  \induction (a: Nat.Nat^) \return Off a \with {
    | zero: \fun (b: Second (Nat.Nat^::succ n) Nat.Nat^::zero)(ne: Logic.Not (index (Nat.Nat^::succ n) Nat.Nat^::zero b = horizontalIndex))
        (x: C.family.Carrier Nat.Nat^::zero b) => Modules.Hom[V := Target.Carrier, W := C.family.Carrier p q, source := Target.space, target := C.family.space p q].zeroPreserved Evaluation.map
    | succ: \fun (a: Nat.Nat^)(previous: Off a)(b: Second (Nat.Nat^::succ n) (Nat.Nat^::succ a)) => Positive[a := a, b := b].zero
  };
\definition different: \forall (i: Index (Nat.Nat^::succ n)) -> Logic.Not (i = horizontalIndex) ->
  \forall (x: C.family.Carrier i.first i.second) ->
    after.apply ((Source.Component[i := i].injection).apply x) = before.apply ((Source.Component[i := i].injection).apply x) :=
  \fun (i: Index (Nat.Nat^::succ n))(ne: Logic.Not (i = horizontalIndex))(x: C.family.Carrier i.first i.second) =>
    trans!{{C.family.Carrier p q}} _ _ _
      (trans!{{C.family.Carrier p q}} _ _ _
        (congr!{Target.Carrier {C.family.Carrier p q}} (TC.coordinate targetIndex) _ _ (Differential.horizontalOnInjection i x))
        (off i.first (Differential.Component[i := i].q)
          (\fun (equal: index (Nat.Nat^::succ n) i.first (Differential.Component[i := i].q) = horizontalIndex) =>
            ne (trans!{Pair} _ _ _ (sym!{Pair} _ _ (pairRebuild i)) equal)) x))
      (sym!{{C.family.Carrier p q}} _ _ (trans!{{C.family.Carrier p q}} _ _ _
        (congr!{{C.family.Carrier (Nat.Nat^::succ p) q} {C.family.Carrier p q}} (original.apply) _ _ (SC.other i horizontalIndex x ne))
        (OriginalMaps.zeroPreserved original)));
\definition onInjection: \forall (i: Index (Nat.Nat^::succ n))(x: C.family.Carrier i.first i.second) ->
  after.apply ((Source.Component[i := i].injection).apply x) = before.apply ((Source.Component[i := i].injection).apply x) :=
  \fun (i: Index (Nat.Nat^::succ n)) => either!{{(Classical.excludedMiddle (i = horizontalIndex))} {
    \forall (x: C.family.Carrier i.first i.second) -> after.apply ((Source.Component[i := i].injection).apply x) = before.apply ((Source.Component[i := i].injection).apply x)
  }
    {\fun (equal: i = horizontalIndex) => \idelim horizontalIndex = i \with j: Index (Nat.Nat^::succ n) =>
      \forall (x: C.family.Carrier (Pair::first j) (Pair::second j)) -> after.apply ((Source.Component[i := j].injection).apply x) = before.apply ((Source.Component[i := j].injection).apply x) \by {
        base: own, equality: sym!{Pair} _ _ equal
      }}
    {different i}
  };
\import Modules.DirectSum[Index := Index (Nat.Nat^::succ n), family := Source.family].To[W := C.family.Carrier p q, target := C.family.space p q] \as Universal;
\definition equality: after = before := Universal.ext after before onInjection;
\definition point: \forall (x: Source.Carrier) -> after.apply x = before.apply x :=
  \fun (x: Source.Carrier) => congr!{Maps.Map {C.family.Carrier p q}} (\fun (f: Maps.Map) => f.apply x) _ _ equality;
