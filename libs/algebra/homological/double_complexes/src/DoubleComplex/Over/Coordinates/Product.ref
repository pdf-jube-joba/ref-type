\import Total.Degree[n := n] \as Term;
\import \parent.Degree[n := n] \as Coordinates;
\import Modules.Product[Index := Index n, family := Term.family] \as Product;
\import Modules.FinitelySupported[Index := Index n, family := Term.family] \as Supported;
\import Modules.DirectSum[Index := Index n, family := Term.family].FiniteSupport[] \as Native;
\import std.Data[].List[] \as Lists;
\import Finite.FromList[A := Index n] \as Enumeration;
\import Lists.Membership[A := Index n] \as Membership;
\definition indices: Lists.List[Index n] := Enumeration.list (Nat.Nat^::succ n) (fromFinite n);
\definition covers[i: Index n]: Membership.Occurs i indices :=
  \idelim fromFinite n (finiteIndex n i) = i \with j: Index n => Membership.Occurs j indices \by {
    base: Enumeration.occurs (Nat.Nat^::succ n) (fromFinite n) (finiteIndex n i),
    equality: finiteIndexLeftInverse n i
  };
\definition supported[v: Product.Carrier]: Supported.Finite v :=
  Logic.existsIntro[Lists.List[Index n], { xs: Lists.List[Index n] \where Supported.Supports xs v }] indices
    (\fun (i: Index n)(outside: Logic.Not (Membership.Occurs i indices)) => Logic.falseElim (v i = (C.family.space (i).first (i).second).zero) (outside (covers i)));
\definition lift[v: Product.Carrier]: Supported.Carrier := \into[Product.Carrier](v, Supported.Carrier) \by { supported v };
\import Modules.Hom[V := Product.Carrier, W := Supported.Carrier, source := Product.space, target := Supported.space] \as Lifts;
\definition inclusion: Lifts.Map := Lifts.Map {
  apply := lift,
  addition := \fun (v, w: Product.Carrier) => \refl(lift (Product.add v w)),
  scalar := \fun (a: R)(v: Product.Carrier) => \refl(lift (Product.scale a v)),
};
\import Modules.Hom[V := Supported.Carrier, W := Term.Carrier, source := Supported.space, target := Term.space].Composition[U := Product.Carrier, domain := Product.space] \as After;
\definition fromProduct: Modules.Hom[V := Product.Carrier, W := Term.Carrier, source := Product.space, target := Term.space].Map :=
  After.compose (Native.isomorphism).backward inclusion;
\definition coordinate: \forall (v: Product.Carrier)(i: Index n) -> Coordinates.coordinate i ((fromProduct).apply v) = v i :=
  \fun (v: Product.Carrier)(i: Index n) =>
    congr!{Supported.Carrier {C.family.Carrier (i).first (i).second}} (\fun (w: Supported.Carrier) => w i) _ _ ((Native.isomorphism).rightInverse (lift v));
