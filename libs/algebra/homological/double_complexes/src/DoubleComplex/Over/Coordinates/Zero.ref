\definition n: Nat.Nat^ := Nat.Nat^::zero;
\definition index: Index n := fromFinite n (Finite.zero n);
\definition unique[i: Index n]: i = index :=
  trans!{Pair} _ _ _ (sym!{Pair} _ _ (pairRebuild i))
    (congr!{Nat.Nat^ Nat.Nat^ Pair} (\fun (p, q: Nat.Nat^) => Pair { first := p, second := q }) _ _ _ _
      (Natural.leZeroEq (i).first (firstBound n i))
      (Natural.leZeroEq (i).second (secondBound n i)));
\import Total.Degree[n := n] \as Sum;
\import \parent.Degree[n := n] \as Values;
\definition inject: Modules.Hom[V := C.family.Carrier n n, W := Sum.Carrier, source := C.family.space n n, target := Sum.space].Map := Sum.Component[i := index].injection;
\definition coordinate[x: Sum.Carrier]: C.family.Carrier n n := Values.coordinate index x;
\definition reconstruct[x: Sum.Carrier]: x = (inject).apply (coordinate x) :=
  Values.ext x ((inject).apply (coordinate x)) (\fun (i: Index n) =>
    \idelim index = i \with j: Index n => Values.coordinate j x = Values.coordinate j ((inject).apply (coordinate x)) \by {
      base: sym!{{C.family.Carrier n n}} _ _ (Values.own index (coordinate x)),
      equality: sym!{{Index n}} _ _ (unique i)
    });
