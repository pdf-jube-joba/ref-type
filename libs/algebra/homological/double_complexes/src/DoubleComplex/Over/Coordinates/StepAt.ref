\definition targetIndex: Index n := i;
\definition horizontalIndex: Index (Nat.Nat^::succ n) := raiseHorizontalIndex n i;
\definition verticalIndex: Index (Nat.Nat^::succ n) := raiseVerticalIndex n i;
\import \parent.Transported[p := i.first, q := i.second] \as Transported;
\definition differential: Formula n i :=
  \idelim diagonal n i.first i.second (degree n i) = i
    \with j: Index n => Formula n j \by {
      base: Transported.holds n (degree n i), equality: pairRebuild i
    };
