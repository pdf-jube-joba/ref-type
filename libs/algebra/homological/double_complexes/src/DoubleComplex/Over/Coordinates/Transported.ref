\import \parent.Step[p := p, q := q] \as Initial;
\definition holds: \forall (n: Nat.Nat^)(same: Arithmetic.add p q = n) -> Formula n (diagonal n p q same) :=
  \fun (n: Nat.Nat^)(same: Arithmetic.add p q = n) =>
    (\idelim Arithmetic.add p q = n \with k: Nat.Nat^ =>
      \forall (equal: Arithmetic.add p q = k) -> Formula k (diagonal k p q equal) \by {
        base: \fun (equal: Arithmetic.add p q = Arithmetic.add p q) => Initial.differential,
        equality: same
      }) same;
