\import SourceTensor.Term[p := p, q := q] \as Source;
\import MiddleTensor.Term[p := p, q := q] \as Middle;
\import TargetTensor.Term[p := p, q := q] \as Target;
\import Before.Degree[p := p, q := q] \as Initial;
\import After.Degree[p := p, q := q] \as Last;
\import Composite.Degree[p := p, q := q] \as Result;
\import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Composition;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Linear;
\import Modules.Tensor[V := A.family.Carrier p, W := D.family.Carrier q, left := A.family.space p, right := D.family.space q].Universal[U := Target.Carrier, target := Target.space] \as Universal;
\definition equality: Composition.compose Last.map Initial.map = Result.map := Universal.ext (Composition.compose Last.map Initial.map) Result.map (\fun (x: A.family.Carrier p)(y: D.family.Carrier q) =>
  trans!{Target.Carrier} _ _ _ (congr!{Middle.Carrier Target.Carrier} ((Last.map).apply) _ _ (Initial.onTensor x y))
    (trans!{Target.Carrier} _ _ _ (Last.onTensor ((f).apply p x) ((u).apply q y)) (sym!{Target.Carrier} _ _ (Result.onTensor x y))));
\definition law[x: Source.Carrier]: (Last.map).apply ((Initial.map).apply x) = (Result.map).apply x := congr!{Linear.Map Target.Carrier} (\fun (h: Linear.Map) => (h).apply x) _ _ equality;
