\import \parent.Sign[V := V, space := space] \as Sign;
\import Modules.Alternating[V := V, space := space].Concatenation[] \as Alternating;
\definition law: \forall (n: Nat.Nat^)(x: V) -> (Sign.map n).apply x = Alternating.twist n x :=
  \induction (n: Nat.Nat^) \return \forall (x: V) -> (Sign.map n).apply x = Alternating.twist n x \with {
    | zero: \fun (x: V) => \refl(x)
    | succ: \fun (n: Nat.Nat^)(previous: \forall (x: V) -> (Sign.map n).apply x = Alternating.twist n x)(x: V) =>
      congr!{V V} ((space).neg) _ _ (previous x)
  };
