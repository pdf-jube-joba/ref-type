\import \parent.Degree[n := n] \as Current;
\import \parent.Degree[n := Nat.Nat^::succ n] \as Middle;
\import \parent.Degree[n := Nat.Nat^::succ (Nat.Nat^::succ n)] \as Earlier;
\import \parent.Step[n := n] \as NextStep;
\import \parent.Step[n := Nat.Nat^::succ n] \as PriorStep;
\import Modules.Hom[V := Middle.Carrier, W := Current.Carrier, source := Middle.space, target := Current.space] \as FirstMaps;
\definition horizontalZeroColumn: \forall (q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero)(x: C.family.Carrier Nat.Nat^::zero q) ->
  NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply ((Earlier.Component[i := index (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero q].injection).apply x)) = Current.space.zero :=
  \fun (q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero)(x: C.family.Carrier Nat.Nat^::zero q) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (NextStep.horizontalTotal.apply) _ _ (PriorStep.horizontalOnInjection (index (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero q) x))
    (FirstMaps.zeroPreserved NextStep.horizontalTotal);
\definition horizontalOneColumn: \forall (q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero))(x: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) q) ->
  NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply ((Earlier.Component[i := index (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero) q].injection).apply x)) = Current.space.zero :=
  \fun (q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero))(x: C.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) q) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (NextStep.horizontalTotal.apply) _ _ (PriorStep.horizontalOnInjection (index (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero) q) x))
    (NextStep.horizontalOnInjection (index (Nat.Nat^::succ n) Nat.Nat^::zero (PriorStep.lowerSecond Nat.Nat^::zero q)) ((C.differential.horizontal Nat.Nat^::zero q).apply x));
\module Horizontal(p: Nat.Nat^, q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ (Nat.Nat^::succ p)));
\definition horizontalOnBasis: \forall (p: Nat.Nat^)(q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) p)(x: C.family.Carrier p q) ->
  NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply ((Earlier.Component[i := index (Nat.Nat^::succ (Nat.Nat^::succ n)) p q].injection).apply x)) = Current.space.zero :=
  \induction (p: Nat.Nat^) \return \forall (q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) p)(x: C.family.Carrier p q) ->
    NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply ((Earlier.Component[i := index (Nat.Nat^::succ (Nat.Nat^::succ n)) p q].injection).apply x)) = Current.space.zero \with {
      | zero: horizontalZeroColumn
      | succ: \fun (p: Nat.Nat^)(unused: _) => (\induction (p: Nat.Nat^) \return \forall (q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ p))(x: C.family.Carrier (Nat.Nat^::succ p) q) ->
          NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply ((Earlier.Component[i := index (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ p) q].injection).apply x)) = Current.space.zero \with {
            | zero: horizontalOneColumn
            | succ: \fun (p: Nat.Nat^)(unused: _)(q: Second (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ (Nat.Nat^::succ p))) => Horizontal[p := p, q := q].zero
          }) p
    };

\definition horizontalOnPair: \forall (i: Pair)(closed: Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n))(x: C.family.Carrier i.first i.second) ->
  NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply
    ((Earlier.Component[i := \into[Pair](i, { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed }].injection).apply x)) = Current.space.zero :=
  \induction (i: Pair) \return \forall (closed: Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n))(x: C.family.Carrier i.first i.second) ->
    NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply
      ((Earlier.Component[i := \into[Pair](i, { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed }].injection).apply x)) = Current.space.zero \with {
      | # : \fun (p, q: Nat.Nat^)(closed: Arithmetic.add p q = Nat.Nat^::succ (Nat.Nat^::succ n)) =>
        horizontalOnBasis p (\into[Nat.Nat^](q, { q: Nat.Nat^ \where Arithmetic.add p q = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed })
    };
\import Modules.Hom[V := Middle.Carrier, W := Current.Carrier, source := Middle.space, target := Current.space].Composition[U := Earlier.Carrier, domain := Earlier.space] \as Composition;
\import Modules.Hom[V := Earlier.Carrier, W := Current.Carrier, source := Earlier.space, target := Current.space] \as Maps;
\import Modules.DirectSum[Index := Index (Nat.Nat^::succ (Nat.Nat^::succ n)), family := Earlier.family].To[W := Current.Carrier, target := Current.space] \as Universal;
\definition horizontalSquareMapZero: Composition.compose NextStep.horizontalTotal PriorStep.horizontalTotal = Maps.zeroMap :=
  Universal.ext (Composition.compose NextStep.horizontalTotal PriorStep.horizontalTotal) Maps.zeroMap
    (\fun (i: Index (Nat.Nat^::succ (Nat.Nat^::succ n))) => horizontalOnPair i (degree (Nat.Nat^::succ (Nat.Nat^::succ n)) i));
\definition horizontalSquareZero: \forall (x: Earlier.Carrier) -> NextStep.horizontalTotal.apply (PriorStep.horizontalTotal.apply x) = Current.space.zero :=
  \fun (x: Earlier.Carrier) => congr!{Maps.Map Current.Carrier} (\fun (f: Maps.Map) => f.apply x) _ _ horizontalSquareMapZero;

\definition verticalZeroRow: \forall (p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero)(x: C.family.Carrier p Nat.Nat^::zero) ->
  NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply ((Earlier.Component[i := reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero p].injection).apply x)) = Current.space.zero :=
  \fun (p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero)(x: C.family.Carrier p Nat.Nat^::zero) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (NextStep.verticalTotal.apply) _ _ (PriorStep.verticalOnInjection (reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero p) x))
    (FirstMaps.zeroPreserved NextStep.verticalTotal);
\module VerticalOne(p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero)) {
  \import \parent.\parent.\parent.Sign[V := C.family.Carrier p Nat.Nat^::zero, space := C.family.space p Nat.Nat^::zero] \as Sign;
  \definition zero: \forall (x: C.family.Carrier p (Nat.Nat^::succ Nat.Nat^::zero)) ->
    NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply ((Earlier.Component[i := reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero) p].injection).apply x)) = Current.space.zero :=
    \fun (x: C.family.Carrier p (Nat.Nat^::succ Nat.Nat^::zero)) => trans!{Current.Carrier} _ _ _
      (congr!{Middle.Carrier Current.Carrier} (NextStep.verticalTotal.apply) _ _ (PriorStep.verticalOnInjection (reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero) p) x))
      (NextStep.verticalOnInjection (reverseIndex (Nat.Nat^::succ n) Nat.Nat^::zero (PriorStep.lowerFirst Nat.Nat^::zero p)) ((Sign.map p).apply ((C.differential.vertical p Nat.Nat^::zero).apply x)));
}
\module Vertical(q: Nat.Nat^, p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ (Nat.Nat^::succ q)));
\definition verticalOnBasis: \forall (q: Nat.Nat^)(p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) q)(x: C.family.Carrier p q) ->
  NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply ((Earlier.Component[i := reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) q p].injection).apply x)) = Current.space.zero :=
  \induction (q: Nat.Nat^) \return \forall (p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) q)(x: C.family.Carrier p q) ->
    NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply ((Earlier.Component[i := reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) q p].injection).apply x)) = Current.space.zero \with {
      | zero: verticalZeroRow
      | succ: \fun (q: Nat.Nat^)(unused: _) => (\induction (q: Nat.Nat^) \return \forall (p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ q))(x: C.family.Carrier p (Nat.Nat^::succ q)) ->
          NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply ((Earlier.Component[i := reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ q) p].injection).apply x)) = Current.space.zero \with {
            | zero: \fun (p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ Nat.Nat^::zero)) => VerticalOne[p := p].zero
            | succ: \fun (q: Nat.Nat^)(unused: _)(p: First (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ (Nat.Nat^::succ q))) => Vertical[q := q, p := p].zero
          }) q
    };
\definition verticalOnPair: \forall (i: Pair)(closed: Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n))(x: C.family.Carrier i.first i.second) ->
  NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply
    ((Earlier.Component[i := \into[Pair](i, { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed }].injection).apply x)) = Current.space.zero :=
  \induction (i: Pair) \return \forall (closed: Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n))(x: C.family.Carrier i.first i.second) ->
    NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply
      ((Earlier.Component[i := \into[Pair](i, { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed }].injection).apply x)) = Current.space.zero \with {
      | # : \fun (p, q: Nat.Nat^)(closed: Arithmetic.add p q = Nat.Nat^::succ (Nat.Nat^::succ n)) =>
        verticalOnBasis q (\into[Nat.Nat^](p, { p: Nat.Nat^ \where Arithmetic.add p q = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed })
    };
\definition verticalSquareMapZero: Composition.compose NextStep.verticalTotal PriorStep.verticalTotal = Maps.zeroMap :=
  Universal.ext (Composition.compose NextStep.verticalTotal PriorStep.verticalTotal) Maps.zeroMap
    (\fun (i: Index (Nat.Nat^::succ (Nat.Nat^::succ n))) => verticalOnPair i (degree (Nat.Nat^::succ (Nat.Nat^::succ n)) i));
\definition verticalSquareZero: \forall (x: Earlier.Carrier) -> NextStep.verticalTotal.apply (PriorStep.verticalTotal.apply x) = Current.space.zero :=
  \fun (x: Earlier.Carrier) => congr!{Maps.Map Current.Carrier} (\fun (f: Maps.Map) => f.apply x) _ _ verticalSquareMapZero;
\module Cross(p: Nat.Nat^, q: Second n p);

\import Modules.Laws[V := Current.Carrier, space := Current.space] \as Vector;
\import algebra.Group[].Of[Carrier := Current.Carrier, group := Vector.additive] \as Additive;
\definition negativeZeros: \forall (x, y: Current.Carrier) -> x = Current.space.zero -> y = Current.space.zero -> x = Current.space.neg y :=
  \fun (x, y: Current.Carrier)(left: x = Current.space.zero)(right: y = Current.space.zero) => trans!{Current.Carrier} x (Current.space.zero) (Current.space.neg y) left
    (trans!{Current.Carrier} (Current.space.zero) (Current.space.neg Current.space.zero) (Current.space.neg y)
      (sym!{Current.Carrier} _ _ Additive.negZero) (congr!{Current.Carrier Current.Carrier} (Current.space.neg) _ _ (sym!{Current.Carrier} _ _ right)));
\module CrossZeroColumn(q: Nat.Nat^);
\module CrossZeroRow(p: Nat.Nat^);

\definition topIndex(i: Pair)(closed: Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n)): Index (Nat.Nat^::succ (Nat.Nat^::succ n)) :=
  \into[Pair](i, { i: Pair \where Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed };
\definition horizontalVertical: Maps.Map := Composition.compose NextStep.horizontalTotal PriorStep.verticalTotal;
\definition verticalHorizontal: Maps.Map := Composition.compose NextStep.verticalTotal PriorStep.horizontalTotal;
\definition CrossLaw(i: Pair): \Prop := \forall (closed: Arithmetic.add i.first i.second = Nat.Nat^::succ (Nat.Nat^::succ n))(x: C.family.Carrier i.first i.second) ->
  horizontalVertical.apply ((Earlier.Component[i := topIndex i closed].injection).apply x) =
  Current.space.neg (verticalHorizontal.apply ((Earlier.Component[i := topIndex i closed].injection).apply x));
\definition zeroZeroCross: CrossLaw (Pair { first := Nat.Nat^::zero, second := Nat.Nat^::zero }) :=
  \fun (closed: Arithmetic.add Nat.Nat^::zero Nat.Nat^::zero = Nat.Nat^::succ (Nat.Nat^::succ n))(x: C.family.Carrier Nat.Nat^::zero Nat.Nat^::zero) => Logic.falseElim _ (Natural.zeroNeSucc (Nat.Nat^::succ n) closed);
\definition lowerDiagonal(p, q: Nat.Nat^)(closed: Arithmetic.add (Nat.Nat^::succ p) (Nat.Nat^::succ q) = Nat.Nat^::succ (Nat.Nat^::succ n)): Second n p :=
  \into[Nat.Nat^](q, { q: Nat.Nat^ \where Arithmetic.add p q = n }) \by {
    Natural.succInjective (Arithmetic.add p q) n
      (Natural.succInjective (Nat.Nat^::succ (Arithmetic.add p q)) (Nat.Nat^::succ n)
        (trans!{Nat.Nat^} (Nat.Nat^::succ (Nat.Nat^::succ (Arithmetic.add p q))) (Arithmetic.add (Nat.Nat^::succ p) (Nat.Nat^::succ q)) (Nat.Nat^::succ (Nat.Nat^::succ n))
          (sym!{Nat.Nat^} _ _ (Natural.addSuccLeft p (Nat.Nat^::succ q))) closed))
  };
\definition crossOnCoordinates: \forall (p, q: Nat.Nat^) -> CrossLaw (Pair { first := p, second := q }) :=
  \induction (p: Nat.Nat^) \return \forall (q: Nat.Nat^) -> CrossLaw (Pair { first := p, second := q }) \with {
    | zero: \induction (q: Nat.Nat^) \return CrossLaw (Pair { first := Nat.Nat^::zero, second := q }) \with {
        | zero: zeroZeroCross
        | succ: \fun (q: Nat.Nat^)(unused: _) => CrossZeroColumn[q := q].antiCommutes
      }
    | succ: \fun (p: Nat.Nat^)(unused: _) => \induction (q: Nat.Nat^) \return CrossLaw (Pair { first := Nat.Nat^::succ p, second := q }) \with {
        | zero: CrossZeroRow[p := p].antiCommutes
        | succ: \fun (q: Nat.Nat^)(unused: _)(closed: Arithmetic.add (Nat.Nat^::succ p) (Nat.Nat^::succ q) = Nat.Nat^::succ (Nat.Nat^::succ n)) => Cross[p := p, q := lowerDiagonal p q closed].antiCommutes
      }
  };
\definition crossOnPair: \forall (i: Pair) -> CrossLaw i :=
  \induction (i: Pair) \return CrossLaw i \with {
    | # : \fun (p, q: Nat.Nat^) => crossOnCoordinates p q
  };
\definition crossMapAntiCommutes: horizontalVertical = Maps.negative verticalHorizontal :=
  Universal.ext horizontalVertical (Maps.negative verticalHorizontal)
    (\fun (i: Index (Nat.Nat^::succ (Nat.Nat^::succ n))) => crossOnPair i (degree (Nat.Nat^::succ (Nat.Nat^::succ n)) i));
\definition crossAntiCommutes: \forall (x: Earlier.Carrier) -> NextStep.horizontalTotal.apply (PriorStep.verticalTotal.apply x) = Current.space.neg (NextStep.verticalTotal.apply (PriorStep.horizontalTotal.apply x)) :=
  \fun (x: Earlier.Carrier) => congr!{Maps.Map Current.Carrier} (\fun (f: Maps.Map) => f.apply x) _ _ crossMapAntiCommutes;

\definition nextApply: \forall (x: Middle.Carrier) -> NextStep.differential.apply x = Current.space.add (NextStep.horizontalTotal.apply x) (NextStep.verticalTotal.apply x) :=
  \fun (x: Middle.Carrier) => congr!{FirstMaps.Map Current.Carrier} (\fun (f: FirstMaps.Map) => f.apply x) _ _ NextStep.asSum;
\import Modules.Hom[V := Earlier.Carrier, W := Middle.Carrier, source := Earlier.space, target := Middle.space] \as PriorMaps;
\definition priorApply: \forall (x: Earlier.Carrier) -> PriorStep.differential.apply x = Middle.space.add (PriorStep.horizontalTotal.apply x) (PriorStep.verticalTotal.apply x) :=
  \fun (x: Earlier.Carrier) => congr!{PriorMaps.Map Middle.Carrier} (\fun (f: PriorMaps.Map) => f.apply x) _ _ PriorStep.asSum;
\definition zero: \forall (x: Earlier.Carrier) -> NextStep.differential.apply (PriorStep.differential.apply x) = Current.space.zero :=
  \fun (x: Earlier.Carrier) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (NextStep.differential.apply) _ _ (priorApply x))
    (trans!{Current.Carrier} _ _ _
      (NextStep.differential.addition (PriorStep.horizontalTotal.apply x) (PriorStep.verticalTotal.apply x))
      (trans!{Current.Carrier} _ _ _
        (congr2!{Current.Carrier Current.Carrier Current.Carrier} (Current.space.add) _ _ _ _
          (nextApply (PriorStep.horizontalTotal.apply x)) (nextApply (PriorStep.verticalTotal.apply x)))
        (trans!{Current.Carrier} _ _ _
          (congr2!{Current.Carrier Current.Carrier Current.Carrier} (Current.space.add) _ _ _ _
            (congr!{Current.Carrier Current.Carrier} (\fun (y: Current.Carrier) => Current.space.add y (NextStep.verticalTotal.apply (PriorStep.horizontalTotal.apply x))) _ _ (horizontalSquareZero x))
            (congr!{Current.Carrier Current.Carrier} (Current.space.add (NextStep.horizontalTotal.apply (PriorStep.verticalTotal.apply x))) _ _ (verticalSquareZero x)))
          (trans!{Current.Carrier} _ _ _
            (congr2!{Current.Carrier Current.Carrier Current.Carrier} (Current.space.add) _ _ _ _
              (Additive.zeroLeft (NextStep.verticalTotal.apply (PriorStep.horizontalTotal.apply x)))
              (Additive.zeroRight (NextStep.horizontalTotal.apply (PriorStep.verticalTotal.apply x))))
            (trans!{Current.Carrier} _ _ _
              (congr!{Current.Carrier Current.Carrier} (Current.space.add (NextStep.verticalTotal.apply (PriorStep.horizontalTotal.apply x))) _ _ (crossAntiCommutes x))
              (Additive.inverseRight (NextStep.verticalTotal.apply (PriorStep.horizontalTotal.apply x))))))));
