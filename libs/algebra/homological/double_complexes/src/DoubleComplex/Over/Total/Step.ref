\import \parent.Degree[n := n] \as Target;
\import \parent.Degree[n := Nat.Nat^::succ n] \as Source;
\definition lowerSecond(p: Nat.Nat^)(q: Second (Nat.Nat^::succ n) (Nat.Nat^::succ p)): Second n p :=
  \into[Nat.Nat^](q, { q: Nat.Nat^ \where Arithmetic.add p q = n }) \by {
    Natural.succInjective (Arithmetic.add p q) n
      (trans!{Nat.Nat^} (Nat.Nat^::succ (Arithmetic.add p q)) (Arithmetic.add (Nat.Nat^::succ p) q) (Nat.Nat^::succ n)
        (sym!{Nat.Nat^} _ _ (Natural.addSuccLeft p q)) (secondDegree (Nat.Nat^::succ n) (Nat.Nat^::succ p) q))
  };
\module Horizontal(p: Nat.Nat^, q: Second (Nat.Nat^::succ n) (Nat.Nat^::succ p)) {
  \import Modules.Hom[V := C.family.Carrier p q, W := Target.Carrier, source := C.family.space p q, target := Target.space].Composition[U := C.family.Carrier (Nat.Nat^::succ p) q, domain := C.family.space (Nat.Nat^::succ p) q] \as Compose;
  \definition map: Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) q, W := Target.Carrier, source := C.family.space (Nat.Nat^::succ p) q, target := Target.space].Map :=
    Compose.compose (Target.Component[i := index n p (lowerSecond p q)].injection) (C.differential.horizontal p q);
}
\definition horizontal: \forall (p: Nat.Nat^)(q: Second (Nat.Nat^::succ n) p) -> Modules.Hom[V := C.family.Carrier p q, W := Target.Carrier, source := C.family.space p q, target := Target.space].Map :=
  \induction (p: Nat.Nat^) \return \forall (q: Second (Nat.Nat^::succ n) p) -> Modules.Hom[V := C.family.Carrier p q, W := Target.Carrier, source := C.family.space p q, target := Target.space].Map \with {
    | zero: \fun (q: Second (Nat.Nat^::succ n) Nat.Nat^::zero) => Modules.Hom[V := C.family.Carrier Nat.Nat^::zero q, W := Target.Carrier, source := C.family.space Nat.Nat^::zero q, target := Target.space].zeroMap
    | succ: \fun (p: Nat.Nat^)(previous: _)(q: Second (Nat.Nat^::succ n) (Nat.Nat^::succ p)) => Horizontal[p := p, q := q].map
  };
\definition lowerFirst(q: Nat.Nat^)(p: First (Nat.Nat^::succ n) (Nat.Nat^::succ q)): First n q :=
  \into[Nat.Nat^](p, { p: Nat.Nat^ \where Arithmetic.add p q = n }) \by { Natural.succInjective (Arithmetic.add p q) n (firstDegree (Nat.Nat^::succ n) (Nat.Nat^::succ q) p) };
\module Vertical(q: Nat.Nat^, p: First (Nat.Nat^::succ n) (Nat.Nat^::succ q)) {
  \import Modules.Hom[V := C.family.Carrier p q, W := Target.Carrier, source := C.family.space p q, target := Target.space].Composition[U := C.family.Carrier p (Nat.Nat^::succ q), domain := C.family.space p (Nat.Nat^::succ q)] \as Compose;
  \import \parent.\parent.\parent.Sign[V := C.family.Carrier p q, space := C.family.space p q] \as Sign;
  \import Modules.Hom[V := C.family.Carrier p q, W := C.family.Carrier p q, source := C.family.space p q, target := C.family.space p q].Composition[U := C.family.Carrier p (Nat.Nat^::succ q), domain := C.family.space p (Nat.Nat^::succ q)] \as Signed;
  \definition map: Modules.Hom[V := C.family.Carrier p (Nat.Nat^::succ q), W := Target.Carrier, source := C.family.space p (Nat.Nat^::succ q), target := Target.space].Map :=
    Compose.compose (Target.Component[i := reverseIndex n q (lowerFirst q p)].injection) (Signed.compose (Sign.map p) (C.differential.vertical p q));
}
\definition vertical: \forall (q: Nat.Nat^)(p: First (Nat.Nat^::succ n) q) -> Modules.Hom[V := C.family.Carrier p q, W := Target.Carrier, source := C.family.space p q, target := Target.space].Map :=
  \induction (q: Nat.Nat^) \return \forall (p: First (Nat.Nat^::succ n) q) -> Modules.Hom[V := C.family.Carrier p q, W := Target.Carrier, source := C.family.space p q, target := Target.space].Map \with {
    | zero: \fun (p: First (Nat.Nat^::succ n) Nat.Nat^::zero) => Modules.Hom[V := C.family.Carrier p Nat.Nat^::zero, W := Target.Carrier, source := C.family.space p Nat.Nat^::zero, target := Target.space].zeroMap
    | succ: \fun (q: Nat.Nat^)(previous: _)(p: First (Nat.Nat^::succ n) (Nat.Nat^::succ q)) => Vertical[q := q, p := p].map
  };
\module Component(i: Index (Nat.Nat^::succ n)) {
  \definition q: Second (Nat.Nat^::succ n) #first{i} := \into[Nat.Nat^](#second{i}, { q: Nat.Nat^ \where Arithmetic.add #first{i} q = Nat.Nat^::succ n }) \by { degree (Nat.Nat^::succ n) i };
  \definition p: First (Nat.Nat^::succ n) #second{i} := \into[Nat.Nat^](#first{i}, { p: Nat.Nat^ \where Arithmetic.add p #second{i} = Nat.Nat^::succ n }) \by { degree (Nat.Nat^::succ n) i };
  \import Modules.Hom[V := C.family.Carrier #first{i} #second{i}, W := Target.Carrier, source := C.family.space #first{i} #second{i}, target := Target.space] \as Maps;
  \definition map: Maps.Map := Maps.plus (horizontal #first{i} q) (vertical #second{i} p);
}
\import Modules.DirectSum[Index := Index (Nat.Nat^::succ n), family := Source.family].To[W := Target.Carrier, target := Target.space] \as Universal;
\definition components: Universal.Components := \fun (i: Index (Nat.Nat^::succ n)) => Component[i := i].map;
\definition differential: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Universal.extension components;
\definition onInjection: \forall (i: Index (Nat.Nat^::succ n))(x: C.family.Carrier #first{i} #second{i}) ->
  #apply{differential} (#apply{(Source.Component[i := i].injection)} x) = #apply{(Component[i := i].map)} x := Universal.onInjection components;
\definition onComponent: \forall (i: Index (Nat.Nat^::succ n))(x: C.family.Carrier #first{i} #second{i}) ->
  #apply{differential} (#apply{(Source.Component[i := i].injection)} x) = #add{Target.space}
    (#apply{(horizontal #first{i} (Component[i := i].q))} x) (#apply{(vertical #second{i} (Component[i := i].p))} x) := onInjection;

\definition horizontalComponents: Universal.Components := \fun (i: Index (Nat.Nat^::succ n)) => horizontal #first{i} (Component[i := i].q);
\definition verticalComponents: Universal.Components := \fun (i: Index (Nat.Nat^::succ n)) => vertical #second{i} (Component[i := i].p);
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
\definition horizontalTotal: Maps.Map := Universal.extension horizontalComponents;
\definition verticalTotal: Maps.Map := Universal.extension verticalComponents;
\definition horizontalOnInjection: \forall (i: Index (Nat.Nat^::succ n))(x: C.family.Carrier #first{i} #second{i}) ->
  #apply{horizontalTotal} (#apply{(Source.Component[i := i].injection)} x) = #apply{(horizontalComponents i)} x := Universal.onInjection horizontalComponents;
\definition verticalOnInjection: \forall (i: Index (Nat.Nat^::succ n))(x: C.family.Carrier #first{i} #second{i}) ->
  #apply{verticalTotal} (#apply{(Source.Component[i := i].injection)} x) = #apply{(verticalComponents i)} x := Universal.onInjection verticalComponents;
\definition asSum: differential = Maps.plus horizontalTotal verticalTotal :=
  Universal.ext differential (Maps.plus horizontalTotal verticalTotal)
    (\fun (i: Index (Nat.Nat^::succ n))(x: C.family.Carrier #first{i} #second{i}) => trans!{Target.Carrier} _ _ _
      (onComponent i x)
      (congr2!{Target.Carrier Target.Carrier Target.Carrier} (#add{Target.space}) _ _ _ _
        (sym!{Target.Carrier} _ _ (horizontalOnInjection i x)) (sym!{Target.Carrier} _ _ (verticalOnInjection i x))));
