\module At(n: Nat.Nat^);
\import Chains.ShortExact[A := left, B := middle, C := right] \as Sequences;
\definition data: Sequences.Data := Sequences.Data { inclusion := Inclusion.total, projection := Projection.total };
\definition laws: Sequences.Laws[data] := Sequences.Laws[data] {
  injective := \fun (n: Nat.Nat^) => At[n := n].injective,
  onto := \fun (n: Nat.Nat^) => At[n := n].onto,
  zero := \fun (n: Nat.Nat^) => At[n := n].zero,
  kernelImage := \fun (n: Nat.Nat^) => At[n := n].kernelImage,
};
\definition sequence: Sequences.Sequence := \into[Sequences.Data](data, { data: Sequences.Data \where Sequences.Laws[data] }) \by { laws };
