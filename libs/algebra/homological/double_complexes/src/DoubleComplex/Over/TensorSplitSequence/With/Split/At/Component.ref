\use std.Logic[].Equality[].eq_reason_in;
\definition originalLeft: Modules.Bundle := Modules.Bundle { Carrier := C.family.Carrier j.first, space := C.family.space j.first };
\definition originalMiddle: Modules.Bundle := Modules.Bundle { Carrier := E.family.Carrier j.first, space := E.family.space j.first };
\definition originalRight: Modules.Bundle := Modules.Bundle { Carrier := F.family.Carrier j.first, space := F.family.space j.first };
\definition coefficient: Modules.Bundle := Modules.Bundle { Carrier := D.family.Carrier j.second, space := D.family.space j.second };
\import Modules.ShortExact[A := originalLeft, B := originalMiddle, C := originalRight] \as Original;
\definition originalSequence: Original.Sequence := Original.Sequence {
  inclusion := Modules.Hom[V := C.family.Carrier j.first, W := E.family.Carrier j.first, source := C.family.space j.first, target := E.family.space j.first].Map {
    apply := input.inclusion.apply j.first, addition := input.inclusion.addition j.first, scalar := input.inclusion.scalar j.first },
  projection := Modules.Hom[V := E.family.Carrier j.first, W := F.family.Carrier j.first, source := E.family.space j.first, target := F.family.space j.first].Map {
    apply := input.projection.apply j.first, addition := input.projection.addition j.first, scalar := input.projection.scalar j.first },
  injective := input.injective j.first, onto := input.onto j.first,
  zero := input.zero j.first, kernelImage := input.kernelImage j.first,
};
\import Modules.TensorSplitShortExact[A := originalLeft, B := originalMiddle, C := originalRight, N := coefficient].On[
  sequence := originalSequence, r := (r.apply j.first)] \as Tensor;
\import LeftProduct.Term[p := j.first, q := j.second] \as LeftTerm;
\import MiddleProduct.Term[p := j.first, q := j.second] \as MiddleTerm;
\import RightProduct.Term[p := j.first, q := j.second] \as RightTerm;
\definition leftBundle: Modules.Bundle := Modules.Bundle { Carrier := LeftTerm.Carrier, space := LeftTerm.space };
\definition middleBundle: Modules.Bundle := Modules.Bundle { Carrier := MiddleTerm.Carrier, space := MiddleTerm.space };
\definition rightBundle: Modules.Bundle := Modules.Bundle { Carrier := RightTerm.Carrier, space := RightTerm.space };
\import Modules.ShortExact[A := leftBundle, B := middleBundle, C := rightBundle] \as Short;
\definition termSequence: Short.Sequence := Tensor.shortExact (r.retracts j.first);
\definition inclusion: Modules.MapBetween leftBundle middleBundle := termSequence.inclusion;
\definition projection: Modules.MapBetween middleBundle rightBundle := termSequence.projection;
\definition retraction: Modules.MapBetween middleBundle leftBundle := Tensor.retraction;
\definition retracts: \forall (x: LeftTerm.Carrier) -> retraction.apply (inclusion.apply x) = x := Tensor.roundtripPoint (r.retracts j.first);
\import Short.Splitting[sequence := termSequence].FromRetraction[r := retraction] \as Smith;
\definition section: Modules.MapBetween rightBundle middleBundle := Smith.section retracts;
\definition sectionLaw: \forall (x: RightTerm.Carrier) -> projection.apply (section.apply x) = x := Smith.rightInverse retracts;
\definition zero: \forall (x: LeftTerm.Carrier) -> projection.apply (inclusion.apply x) = RightTerm.space.zero := termSequence.zero;
\import Modules.Laws[V := MiddleTerm.Carrier, space := MiddleTerm.space] \as Laws;
\import algebra.Group[].Of[Carrier := MiddleTerm.Carrier, group := Laws.additive] \as Group;
\definition decomposition: \forall (x: MiddleTerm.Carrier) ->
  MiddleTerm.space.add (inclusion.apply (retraction.apply x)) (section.apply (projection.apply x)) = x :=
  \fun (x: MiddleTerm.Carrier) => eq_reason_in!{MiddleTerm.Carrier _
    "=" _ "by" { congr!{MiddleTerm.Carrier MiddleTerm.Carrier} (MiddleTerm.space.add (inclusion.apply (retraction.apply x))) _ _
      (Smith.onImage retracts x) }
    "=" _ "by" { Group.comm (inclusion.apply (retraction.apply x)) (Group.difference x (inclusion.apply (retraction.apply x))) }
    "=" _ "by" { Group.addDifference x (inclusion.apply (retraction.apply x)) }
  };
