\import LeftTotal.Degree[n := n] \as L;
\import MiddleTotal.Degree[n := n] \as M;
\import RightTotal.Degree[n := n] \as Q;
\import \parent.\parent.\parent.\parent.SplitDiagonal[Index := Index n, left := L.family, middle := M.family, right := Q.family] \as Diagonal;
\module Component(j: Index n);
\definition inclusions: Diagonal.InclusionComponents := \fun (j: Index n) => Component[j := j].inclusion;
\definition projections: Diagonal.ProjectionComponents := \fun (j: Index n) => Component[j := j].projection;
\definition retractions: Diagonal.RetractionComponents := \fun (j: Index n) => Component[j := j].retraction;
\definition sections: Diagonal.SectionComponents := \fun (j: Index n) => Component[j := j].section;
\import Diagonal.With[i := inclusions, p := projections, r := retractions, s := sections] \as Split;
\definition splitting: Split.Laws := Split.Laws {
  retracts := \fun (j: Index n) => Component[j := j].retracts,
  section := \fun (j: Index n) => Component[j := j].sectionLaw,
  zero := \fun (j: Index n) => Component[j := j].zero,
  decomposition := \fun (j: Index n) => Component[j := j].decomposition,
};
\definition injective: \forall (x, y: L.Carrier) ->
  Inclusion.total.apply n x = Inclusion.total.apply n y -> x = y := Split.injective splitting;
\definition onto: \forall (x: Q.Carrier) -> \exists ( y: M.Carrier \where Projection.total.apply n y = x ) := Split.onto splitting;
\definition zero: \forall (x: L.Carrier) -> Projection.total.apply n (Inclusion.total.apply n x) = Q.space.zero := Split.zero splitting;
\definition kernelImage: \forall (x: M.Carrier) -> Projection.total.apply n x = Q.space.zero ->
  \exists ( y: L.Carrier \where Inclusion.total.apply n y = x ) := Split.kernelImage splitting;
