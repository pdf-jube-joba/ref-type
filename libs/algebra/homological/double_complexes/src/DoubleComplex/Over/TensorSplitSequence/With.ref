\definition input: Given.Sequence := sequence;
\structure Retraction: \Set {
  apply: \forall (n: Nat.Nat^) -> Modules.Hom[V := E.family.Carrier n, W := C.family.Carrier n, source := E.family.space n, target := C.family.space n].Map,
  retracts: \forall (n: Nat.Nat^)(x: C.family.Carrier n) -> #apply{(apply n)} (#apply{input.inclusion} n x) = x,
}
\import \parent.\parent.TensorMapping[C := C, D := E, E := D, F := D].With[f := input.inclusion, g := Identity.identity] \as Inclusion;
\import \parent.\parent.TensorMapping[C := E, D := F, E := D, F := D].With[f := input.projection, g := Identity.identity] \as Projection;
\definition left: Chains.Complex := LeftTotal.complex;
\definition middle: Chains.Complex := MiddleTotal.complex;
\definition right: Chains.Complex := RightTotal.complex;
\module Split(r: Retraction);
