\module Degree(n: Nat.Nat^) {
  \definition family: Modules.Family[Index n] := Modules.Family[Index n] {
    Carrier := \fun (i: Index n) => C.family.Carrier i.first i.second,
    space := \fun (i: Index n) => C.family.space i.first i.second,
  };
  \import Modules.DirectSum[Index := Index n, family := family] \as Sum;
  \definition Carrier: \Set := Sum.Carrier;
  \definition space: Modules.Space Carrier := Sum.space;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
  \module Component(i: Index n) {
    \definition injection: Modules.Hom[V := C.family.Carrier i.first i.second, W := Carrier, source := C.family.space i.first i.second, target := space].Map := Sum.Injection[i := i].map;
  }
}
\module Step(n: Nat.Nat^);
\import double_complexes.NonnegativeChain[].Over[R := R, ring := ring] \as Nonnegative;
\definition Carrier[n: Nat.Nat^]: \Set := Degree[n := n].Carrier;
\definition space[n: Nat.Nat^]: Modules.Space (Carrier n) := Degree[n := n].space;
\definition family: Nonnegative.Family := Nonnegative.Family { Carrier := Carrier, space := space };
\definition differential: Nonnegative.DifferentialData[family] := Nonnegative.DifferentialData[family] {
  apply := \fun (n: Nat.Nat^) => (Step[n := n].differential).apply,
};
\definition addition: \forall (n: Nat.Nat^)(x, y: Carrier (Nat.Nat^::succ n)) ->
  differential.apply n ((space (Nat.Nat^::succ n)).add x y) = (space n).add (differential.apply n x) (differential.apply n y) :=
  \fun (n: Nat.Nat^) => (Step[n := n].differential).addition;
\definition scalar: \forall (n: Nat.Nat^)(r: R)(x: Carrier (Nat.Nat^::succ n)) ->
  differential.apply n ((space (Nat.Nat^::succ n)).smul r x) = (space n).smul r (differential.apply n x) :=
  \fun (n: Nat.Nat^) => (Step[n := n].differential).scalar;
\module Square(n: Nat.Nat^);
\definition squareZero: \forall (n: Nat.Nat^)(x: Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> differential.apply n (differential.apply (Nat.Nat^::succ n) x) = (space n).zero :=
  \fun (n: Nat.Nat^) => Square[n := n].zero;
\definition complex: Nonnegative.Complex := Nonnegative.Complex {
  family := family, differential := differential,
  laws := Nonnegative.DifferentialLaws[family, differential] { addition := addition, scalar := scalar, squareZero := squareZero },
};
