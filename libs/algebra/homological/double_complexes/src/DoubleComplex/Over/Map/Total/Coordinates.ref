\import \parent.Degree[n := n] \as Current;
\import Source.Degree[n := n] \as SourceTerm;
\import Target.Degree[n := n] \as TargetTerm;
\import \parent.\parent.\parent.Coordinates[C := C].Degree[n := n] \as SourceCoordinates;
\import \parent.\parent.\parent.Coordinates[C := D].Degree[n := n] \as TargetCoordinates;
\import std.Logic[].Classical[] \as Classical;
\module At(i: Index n);
\definition law: \forall (i: Index n)(x: SourceTerm.Carrier) ->
  TargetCoordinates.coordinate i ((Current.map).apply x) = (f (i).first (i).second).apply (SourceCoordinates.coordinate i x) :=
  \fun (i: Index n) => At[i := i].law;
