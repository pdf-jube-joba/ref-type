\definition U: \Set := D.family.Carrier (i).first (i).second;
\definition targetSpace: Modules.Space U := D.family.space (i).first (i).second;
\import Modules.Hom[V := SourceTerm.Carrier, W := U, source := SourceTerm.space, target := targetSpace] \as Maps;
\import Modules.Hom[V := TargetTerm.Carrier, W := U, source := TargetTerm.space, target := targetSpace].Composition[U := SourceTerm.Carrier, domain := SourceTerm.space] \as AfterTotal;
\import Modules.Hom[V := C.family.Carrier (i).first (i).second, W := U, source := C.family.space (i).first (i).second, target := targetSpace].Composition[U := SourceTerm.Carrier, domain := SourceTerm.space] \as AfterCoordinate;
\import Modules.Hom[V := C.family.Carrier (i).first (i).second, W := U, source := C.family.space (i).first (i).second, target := targetSpace] \as ComponentMaps;
\definition lhs: Maps.Map := AfterTotal.compose TargetCoordinates.At[i := i].map Current.map;
\definition rhs: Maps.Map := AfterCoordinate.compose (f (i).first (i).second) SourceCoordinates.At[i := i].map;
\definition Property[j: Index n]: \Prop := \forall (x: C.family.Carrier (j).first (j).second) ->
  (lhs).apply ((SourceTerm.Component[i := j].injection).apply x) = (rhs).apply ((SourceTerm.Component[i := j].injection).apply x);
\definition own: Property i := \fun (x: C.family.Carrier (i).first (i).second) => trans!{U} _ _ _
  (congr!{TargetTerm.Carrier U} (TargetCoordinates.coordinate i) _ _ (Current.onInjection i x))
  (trans!{U} _ _ _ (TargetCoordinates.own i ((f (i).first (i).second).apply x))
    (sym!{U} _ _ (congr!{{C.family.Carrier (i).first (i).second} U} ((f (i).first (i).second).apply) _ _ (SourceCoordinates.own i x))));
\definition other: \forall (j: Index n) -> Logic.Not (j = i) -> Property j :=
  \fun (j: Index n)(different: Logic.Not (j = i))(x: C.family.Carrier (j).first (j).second) => trans!{U} _ _ _
    (trans!{U} _ _ _ (congr!{TargetTerm.Carrier U} (TargetCoordinates.coordinate i) _ _ (Current.onInjection j x))
      (TargetCoordinates.other j i ((f (j).first (j).second).apply x) different))
    (sym!{U} _ _ (trans!{U} _ _ _
      (congr!{{C.family.Carrier (i).first (i).second} U} ((f (i).first (i).second).apply) _ _ (SourceCoordinates.other j i x different))
      (ComponentMaps.zeroPreserved (f (i).first (i).second))));
\definition onInjection: \forall (j: Index n) -> Property j := \fun (j: Index n) => Logic.orElim (j = i) (Logic.Not (j = i)) (Property j) (Classical.excludedMiddle (j = i))
  (\fun (same: j = i) => \idelim i = j \with k: Index n => Property k \by { base: own, equality: sym!{{Index n}} _ _ same })
  (other j);
\import Modules.DirectSum[Index := Index n, family := SourceTerm.family].To[W := U, target := targetSpace] \as Extension;
\definition equation: lhs = rhs := Extension.ext lhs rhs onInjection;
\definition law[x: SourceTerm.Carrier]: (lhs).apply x = (rhs).apply x := congr!{Maps.Map U} (\fun (h: Maps.Map) => (h).apply x) _ _ equation;
