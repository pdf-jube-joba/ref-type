\import Chains.ShortExact[A := C, B := E, C := F] \as Given;
\import \parent.Tensor[C := C, D := D] \as LeftProduct;
\import \parent.Tensor[C := E, D := D] \as MiddleProduct;
\import \parent.Tensor[C := F, D := D] \as RightProduct;
\import \parent.Total[C := LeftProduct.complex] \as LeftTotal;
\import \parent.Total[C := MiddleProduct.complex] \as MiddleTotal;
\import \parent.Total[C := RightProduct.complex] \as RightTotal;
\import Chains.End[C := D] \as Identity;
\module With(sequence: Given.Sequence);
