\use std.Logic[].Equality[].eq_reason_in;
\definition next: Nat.Nat^ := Nat.Nat^::succ p;
\import SourceTensor.Term[p := next, q := q] \as Source;
\import SourceTensor.Term[p := p, q := q] \as BeforeTarget;
\import TargetTensor.Term[p := Nat.Nat^::succ next, q := q] \as AfterSource;
\import TargetTensor.Term[p := next, q := q] \as Target;
\import SourceTensor.At[p := p, q := q] \as SD;
\import TargetTensor.At[p := next, q := q] \as TD;
\import \parent.Term[p := p, q := q] \as BeforeH;
\import \parent.Term[p := next, q := q] \as AfterH;
\import Forward.Degree[p := next, q := q] \as F;
\import Backward.Degree[p := next, q := q] \as G;
\import Modules.Tensor[V := D.family.Carrier next, W := E.family.Carrier q, left := D.family.space next, right := E.family.space q] \as TensorModule;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Linear;
\import Modules.Hom[V := AfterSource.Carrier, W := Target.Carrier, source := AfterSource.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as DH;
\import Modules.Hom[V := BeforeTarget.Carrier, W := Target.Carrier, source := BeforeTarget.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as HD;
\definition after[x: C.family.Carrier next][y: E.family.Carrier q]: (TD.horizontal).apply ((AfterH.map).apply (Source.tensor x y)) = Target.tensor ((D.differential).apply next ((h).apply next x)) y :=
  trans!{Target.Carrier} _ _ _ (congr!{AfterSource.Carrier Target.Carrier} ((TD.horizontal).apply) _ _ (AfterH.onTensor x y)) (TD.horizontalOnTensor ((h).apply next x) y);
\definition before[x: C.family.Carrier next][y: E.family.Carrier q]: (BeforeH.map).apply ((SD.horizontal).apply (Source.tensor x y)) = Target.tensor ((h).apply p ((C.differential).apply p x)) y :=
  trans!{Target.Carrier} _ _ _ (congr!{BeforeTarget.Carrier Target.Carrier} ((BeforeH.map).apply) _ _ (SD.horizontalOnTensor x y)) (BeforeH.onTensor ((C.differential).apply p x) y);
\import Modules.Tensor[V := C.family.Carrier next, W := E.family.Carrier q, left := C.family.space next, right := E.family.space q].Universal[U := Target.Carrier, target := Target.space] \as Universal;
\definition equality: Linear.plus F.map (Linear.negative G.map) = Linear.plus (DH.compose TD.horizontal AfterH.map) (HD.compose BeforeH.map SD.horizontal) := Universal.ext _ _
  (\fun (x: C.family.Carrier next)(y: E.family.Carrier q) => eq_reason_in!{Target.Carrier _
    "=" _ "by" { congr!{Target.Carrier Target.Carrier Target.Carrier} (\fun (a, b: Target.Carrier) => (Target.space).add a ((Target.space).neg b)) _ _ _ _ (F.onTensor x y) (G.onTensor x y) }
    "=" _ "by" { sym!{Target.Carrier} _ _ (TensorModule.tensorDifferenceLeft ((f).apply next x) ((g).apply next x) y) }
    "=" _ "by" { congr!{{D.family.Carrier next} Target.Carrier} (\fun (z: D.family.Carrier next) => Target.tensor z y) _ _ ((h).successorEquation p x) }
    "=" _ "by" { (TensorModule.bilinear).addLeft ((D.differential).apply next ((h).apply next x)) ((h).apply p ((C.differential).apply p x)) y }
    "=" _ "by" { congr!{Target.Carrier Target.Carrier Target.Carrier} ((Target.space).add) _ _ _ _ (sym!{Target.Carrier} _ _ (after x y)) (sym!{Target.Carrier} _ _ (before x y)) }
  });
\definition point[x: Source.Carrier]: (Target.space).add ((F.map).apply x) ((Target.space).neg ((G.map).apply x)) = (Target.space).add ((TD.horizontal).apply ((AfterH.map).apply x)) ((BeforeH.map).apply ((SD.horizontal).apply x)) := congr!{Linear.Map Target.Carrier} (\fun (m: Linear.Map) => (m).apply x) _ _ equality;
