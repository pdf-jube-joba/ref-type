\definition p: Nat.Nat^ := Nat.Nat^::zero;
\import SourceTensor.Term[p := p, q := q] \as Source;
\import TargetTensor.Term[p := Nat.Nat^::succ p, q := q] \as Middle;
\import TargetTensor.Term[p := p, q := q] \as Target;
\import TargetTensor.At[p := p, q := q] \as Differential;
\import \parent.Term[p := p, q := q] \as H;
\import Forward.Degree[p := p, q := q] \as F;
\import Backward.Degree[p := p, q := q] \as G;
\import Modules.Tensor[V := D.family.Carrier p, W := E.family.Carrier q, left := D.family.space p, right := E.family.space q] \as TensorModule;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Linear;
\import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Compose;
\import Modules.Tensor[V := C.family.Carrier p, W := E.family.Carrier q, left := C.family.space p, right := E.family.space q].Universal[U := Target.Carrier, target := Target.space] \as Universal;
\definition equality: Linear.plus F.map (Linear.negative G.map) = Compose.compose Differential.horizontal H.map := Universal.ext _ _
  (\fun (x: C.family.Carrier p)(y: E.family.Carrier q) => trans!{Target.Carrier} _ _ _
    (congr2!{Target.Carrier Target.Carrier Target.Carrier} (\fun (a, b: Target.Carrier) => (Target.space).add a ((Target.space).neg b)) _ _ _ _ (F.onTensor x y) (G.onTensor x y))
    (trans!{Target.Carrier} _ _ _ (sym!{Target.Carrier} _ _ (TensorModule.tensorDifferenceLeft ((f).apply p x) ((g).apply p x) y))
      (trans!{Target.Carrier} _ _ _ (congr!{{D.family.Carrier p} Target.Carrier} (\fun (z: D.family.Carrier p) => Target.tensor z y) _ _ ((h).zeroEquation x))
        (sym!{Target.Carrier} _ _ (trans!{Target.Carrier} _ _ _ (congr!{Middle.Carrier Target.Carrier} ((Differential.horizontal).apply) _ _ (H.onTensor x y)) (Differential.horizontalOnTensor ((h).apply p x) y))))));
\definition point[x: Source.Carrier]: (Target.space).add ((F.map).apply x) ((Target.space).neg ((G.map).apply x)) = (Differential.horizontal).apply ((H.map).apply x) := congr!{Linear.Map Target.Carrier} (\fun (m: Linear.Map) => (m).apply x) _ _ equality;
