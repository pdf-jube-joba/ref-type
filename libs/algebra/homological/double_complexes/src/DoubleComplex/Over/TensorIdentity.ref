\import \parent.Tensor[C := C, D := D] \as Tensor;
\import \parent.Total[C := Tensor.complex] \as Total;
\import \parent.TensorMapping[C := C, D := C, E := D, F := D].With[f := Chains.End[C := C].identity, g := Chains.End[C := D].identity] \as Mapping;
\import \parent.End[C := Tensor.complex] \as End;
\import \parent.Map[C := Tensor.complex, D := Tensor.complex] \as Maps;
\module Degree(p, q: Nat.Nat^);
\definition components: Mapping.map = End.identity := Maps.ext Mapping.map End.identity (\fun (p, q: Nat.Nat^) => Degree[p := p, q := q].law);
\import Chains.Map[C := Total.complex, D := Total.complex] \as TotalMaps;
\definition induced[f: Maps.Map]: TotalMaps.Map := Maps.Total[f := f].map;
\definition equality: Mapping.total = Chains.End[C := Total.complex].identity :=
  trans!{TotalMaps.Map} _ _ _ (congr!{Maps.Map TotalMaps.Map} induced _ _ components) End.Total[].equality;
