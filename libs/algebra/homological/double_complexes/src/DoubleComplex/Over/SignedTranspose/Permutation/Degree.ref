\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as TD;
\import SourceCoordinates.Degree[n := n] \as SC;
\import TargetCoordinates.Degree[n := n] \as TC;
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\import Modules.DirectSum[Index := Index n, family := TD.family].To[W := SD.Carrier, target := SD.space] \as InverseUniversal;
\definition components: Universal.Components := \fun (i: Index n) => TD.Component[i := index n i].injection;
\definition inverseComponents: InverseUniversal.Components := \fun (i: Index n) => SD.Component[i := index n i].injection;
\definition forward: Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map := Universal.extension components;
\definition backward: Modules.Hom[V := TD.Carrier, W := SD.Carrier, source := TD.space, target := SD.space].Map := InverseUniversal.extension inverseComponents;
\definition onInjection: \forall (i: Index n)(x: C.family.Carrier i.first i.second) ->
  forward.apply ((SD.Component[i := i].injection).apply x) = (TD.Component[i := index n i].injection).apply x := Universal.onInjection components;
\definition inverseOnInjection: \forall (i: Index n)(x: C.family.Carrier i.second i.first) ->
  backward.apply ((TD.Component[i := i].injection).apply x) = (SD.Component[i := index n i].injection).apply x := InverseUniversal.onInjection inverseComponents;
\import Modules.Hom[V := TD.Carrier, W := SD.Carrier, source := TD.space, target := SD.space].Composition[U := SD.Carrier, domain := SD.space] \as Left;
\import Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Composition[U := TD.Carrier, domain := TD.space] \as Right;
\import Modules.End[V := SD.Carrier, space := SD.space] \as SourceEnd;
\import Modules.End[V := TD.Carrier, space := TD.space] \as TargetEnd;
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := SD.Carrier, target := SD.space] \as LeftEquality;
\import Modules.DirectSum[Index := Index n, family := TD.family].To[W := TD.Carrier, target := TD.space] \as RightEquality;
\definition topIndex[i: Pair][closed: Arithmetic.add i.first i.second = n]: Index n :=
  \into[Pair](i, { j: Pair \where Arithmetic.add j.first j.second = n }) \by { closed };
\module PairWitness(p, q: Nat.Nat^) {
  \definition i[closed: Arithmetic.add p q = n]: Index n := topIndex (Pair::# p q) closed;
  \definition left: \forall (closed: Arithmetic.add p q = n)(x: C.family.Carrier p q) ->
    backward.apply (forward.apply ((SD.Component[i := i closed].injection).apply x)) = (SD.Component[i := i closed].injection).apply x :=
    \fun (closed: Arithmetic.add p q = n)(x: C.family.Carrier p q) => trans!{SD.Carrier} _ _ _
      (congr!{TD.Carrier SD.Carrier} (backward.apply) _ _ (onInjection (i closed) x))
      (inverseOnInjection (index n (i closed)) x);
  \definition right: \forall (closed: Arithmetic.add p q = n)(x: C.family.Carrier q p) ->
    forward.apply (backward.apply ((TD.Component[i := i closed].injection).apply x)) = (TD.Component[i := i closed].injection).apply x :=
    \fun (closed: Arithmetic.add p q = n)(x: C.family.Carrier q p) => trans!{TD.Carrier} _ _ _
      (congr!{SD.Carrier TD.Carrier} (forward.apply) _ _ (inverseOnInjection (i closed) x))
      (onInjection (index n (i closed)) x);
}
\definition leftOnPair: \forall (i: Pair)(closed: Arithmetic.add i.first i.second = n)(x: C.family.Carrier i.first i.second) ->
  backward.apply (forward.apply ((SD.Component[i := topIndex i closed].injection).apply x)) = (SD.Component[i := topIndex i closed].injection).apply x :=
  \induction (i: Pair) \return \forall (closed: Arithmetic.add i.first i.second = n)(x: C.family.Carrier i.first i.second) ->
    backward.apply (forward.apply ((SD.Component[i := topIndex i closed].injection).apply x)) = (SD.Component[i := topIndex i closed].injection).apply x \with {
      | # : \fun (p, q: Nat.Nat^)(closed: Arithmetic.add p q = n) => PairWitness[p := p, q := q].left closed
    };
\definition rightOnPair: \forall (i: Pair)(closed: Arithmetic.add i.first i.second = n)(x: C.family.Carrier i.second i.first) ->
  forward.apply (backward.apply ((TD.Component[i := topIndex i closed].injection).apply x)) = (TD.Component[i := topIndex i closed].injection).apply x :=
  \induction (i: Pair) \return \forall (closed: Arithmetic.add i.first i.second = n)(x: C.family.Carrier i.second i.first) ->
    forward.apply (backward.apply ((TD.Component[i := topIndex i closed].injection).apply x)) = (TD.Component[i := topIndex i closed].injection).apply x \with {
      | # : \fun (p, q: Nat.Nat^)(closed: Arithmetic.add p q = n) => PairWitness[p := p, q := q].right closed
    };
\definition leftEquality: Left.compose backward forward = SourceEnd.identity := LeftEquality.ext (Left.compose backward forward) SourceEnd.identity
  (\fun (i: Index n) => leftOnPair i (degree n i));
\definition rightEquality: Right.compose forward backward = TargetEnd.identity := RightEquality.ext (Right.compose forward backward) TargetEnd.identity
  (\fun (i: Index n) => rightOnPair i (degree n i));
\definition leftInverse: \forall (x: SD.Carrier) -> backward.apply (forward.apply x) = x :=
  \fun (x: SD.Carrier) => congr!{{Modules.Hom[V := SD.Carrier, W := SD.Carrier, source := SD.space, target := SD.space].Map} SD.Carrier}
    (\fun (f: Modules.Hom[V := SD.Carrier, W := SD.Carrier, source := SD.space, target := SD.space].Map) => f.apply x) _ _ leftEquality;
\definition rightInverse: \forall (x: TD.Carrier) -> forward.apply (backward.apply x) = x :=
  \fun (x: TD.Carrier) => congr!{{Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map} TD.Carrier}
    (\fun (f: Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map) => f.apply x) _ _ rightEquality;
\module Coordinate(i: Index n);
