\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := SD.Carrier, W := C.family.Carrier i.first i.second, source := SD.space, target := C.family.space i.first i.second] \as Maps;
\import Modules.Hom[V := TD.Carrier, W := C.family.Carrier i.first i.second, source := TD.space, target := C.family.space i.first i.second].Composition[U := SD.Carrier, domain := SD.space] \as Compose;
\definition after: Maps.Map := Compose.compose TC.At[i := index n i].map forward;
\definition before: Maps.Map := SC.At[i := i].map;
\definition own: \forall (x: C.family.Carrier i.first i.second) ->
  after.apply ((SD.Component[i := i].injection).apply x) = before.apply ((SD.Component[i := i].injection).apply x) :=
  \fun (x: C.family.Carrier i.first i.second) => eq_reason_in!{{C.family.Carrier i.first i.second} _
    "=" _ "by" { congr!{TD.Carrier {C.family.Carrier i.first i.second}} (TC.coordinate (index n i)) _ _ (onInjection i x) }
    "=" _ "by" { TC.own (index n i) x }
    "=" _ "by" { sym!{{C.family.Carrier i.first i.second}} _ _ (SC.own i x) }
  };
\definition other: \forall (j: Index n) -> Logic.Not (j = i) -> \forall (x: C.family.Carrier j.first j.second) ->
  after.apply ((SD.Component[i := j].injection).apply x) = before.apply ((SD.Component[i := j].injection).apply x) :=
  \fun (j: Index n)(ne: Logic.Not (j = i))(x: C.family.Carrier j.first j.second) => eq_reason_in!{{C.family.Carrier i.first i.second} _
    "=" _ "by" { congr!{TD.Carrier {C.family.Carrier i.first i.second}} (TC.coordinate (index n i)) _ _ (onInjection j x) }
    "=" _ "by" { TC.other (index n j) (index n i) x (\fun (equal: index n j = index n i) => ne (indexInjective n j i equal)) }
    "=" _ "by" { sym!{{C.family.Carrier i.first i.second}} _ _ (SC.other j i x ne) }
  };
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition agreement: \forall (j: Index n)(x: C.family.Carrier j.first j.second) ->
  after.apply ((SD.Component[i := j].injection).apply x) = before.apply ((SD.Component[i := j].injection).apply x) :=
  \fun (j: Index n) => either!{{(Classical.excludedMiddle (j = i))} {
    \forall (x: C.family.Carrier j.first j.second) -> after.apply ((SD.Component[i := j].injection).apply x) = before.apply ((SD.Component[i := j].injection).apply x)}
    {\fun (equal: j = i) => \idelim i = j \with k: Index n =>
      \forall (x: C.family.Carrier (Pair::first k) (Pair::second k)) -> after.apply ((SD.Component[i := k].injection).apply x) = before.apply ((SD.Component[i := k].injection).apply x)
      \by { base: own, equality: sym!{Pair} _ _ equal }}
    {other j}};
\import Modules.DirectSum[Index := Index n, family := SD.family].To[W := C.family.Carrier i.first i.second, target := C.family.space i.first i.second] \as Equality;
\definition equality: after = before := Equality.ext after before agreement;
\definition formula: \forall (x: SD.Carrier) -> TC.coordinate (index n i) (forward.apply x) = SC.coordinate i x :=
  \fun (x: SD.Carrier) => congr!{Maps.Map {C.family.Carrier i.first i.second}} (\fun (f: Maps.Map) => f.apply x) _ _ equality;
