\import \parent.\parent.Sign[V := C.family.Carrier q p, space := C.family.space q p] \as Sign;
\import Modules.Hom[V := C.family.Carrier q p, W := C.family.Carrier q p, source := C.family.space q p, target := C.family.space q p].Composition[
  U := C.family.Carrier q (Nat.Nat^::succ p), domain := C.family.space q (Nat.Nat^::succ p)] \as Horizontal;
\import Modules.Hom[V := C.family.Carrier q p, W := C.family.Carrier q p, source := C.family.space q p, target := C.family.space q p].Composition[
  U := C.family.Carrier (Nat.Nat^::succ q) p, domain := C.family.space (Nat.Nat^::succ q) p] \as Vertical;
\definition horizontal: Modules.Hom[V := C.family.Carrier q (Nat.Nat^::succ p), W := C.family.Carrier q p,
  source := C.family.space q (Nat.Nat^::succ p), target := C.family.space q p].Map := Horizontal.compose (Sign.map q) (C.differential.vertical q p);
\definition vertical: Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ q) p, W := C.family.Carrier q p,
  source := C.family.space (Nat.Nat^::succ q) p, target := C.family.space q p].Map := Vertical.compose (Sign.map p) (C.differential.horizontal q p);
