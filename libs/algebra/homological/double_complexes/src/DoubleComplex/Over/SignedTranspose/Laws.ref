\import \parent.\parent.Sign[V := C.family.Carrier q p, space := C.family.space q p] \as Sign;
\import \parent.\parent.Sign[V := C.family.Carrier q (Nat.Nat^::succ p), space := C.family.space q (Nat.Nat^::succ p)].Mapping[
  W := C.family.Carrier q p, target := C.family.space q p] \as HorizontalNatural;
\import \parent.\parent.Sign[V := C.family.Carrier (Nat.Nat^::succ q) p, space := C.family.space (Nat.Nat^::succ q) p].Mapping[
  W := C.family.Carrier q p, target := C.family.space q p] \as VerticalNatural;
\definition horizontalZero: \forall (x: C.family.Carrier q (Nat.Nat^::succ (Nat.Nat^::succ p))) ->
  #apply{(differential.horizontal p q)} (#apply{(differential.horizontal (Nat.Nat^::succ p) q)} x) = #zero{(C.family.space q p)} :=
  \fun (x: C.family.Carrier q (Nat.Nat^::succ (Nat.Nat^::succ p))) => trans!{{C.family.Carrier q p}} _ _ _
    (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} (#apply{(Sign.map q)}) _ _
      (HorizontalNatural.naturality (C.differential.vertical q p) q (#apply{(C.differential.vertical q (Nat.Nat^::succ p))} x)))
    (trans!{{C.family.Carrier q p}} _ _ _
      (Sign.involutive q (#apply{(C.differential.vertical q p)} (#apply{(C.differential.vertical q (Nat.Nat^::succ p))} x)))
      (#verticalZero{C.laws} q p x));
\definition verticalZero: \forall (x: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p) ->
  #apply{(differential.vertical p q)} (#apply{(differential.vertical p (Nat.Nat^::succ q))} x) = #zero{(C.family.space q p)} :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p) => trans!{{C.family.Carrier q p}} _ _ _
    (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} (#apply{(Sign.map p)}) _ _
      (VerticalNatural.naturality (C.differential.horizontal q p) p (#apply{(C.differential.horizontal (Nat.Nat^::succ q) p)} x)))
    (trans!{{C.family.Carrier q p}} _ _ _
      (Sign.involutive p (#apply{(C.differential.horizontal q p)} (#apply{(C.differential.horizontal (Nat.Nat^::succ q) p)} x)))
      (#horizontalZero{C.laws} q p x));
\definition signDegree: Arithmetic.add q (Nat.Nat^::succ p) = Arithmetic.add p (Nat.Nat^::succ q) :=
  congr!{Nat.Nat^ Nat.Nat^} Nat.Nat^::succ _ _ (Natural.addComm q p);
\definition commute: \forall (x: C.family.Carrier (Nat.Nat^::succ q) (Nat.Nat^::succ p)) ->
  #apply{(differential.horizontal p q)} (#apply{(differential.vertical (Nat.Nat^::succ p) q)} x) =
  #apply{(differential.vertical p q)} (#apply{(differential.horizontal p (Nat.Nat^::succ q))} x) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ q) (Nat.Nat^::succ p)) => trans!{{C.family.Carrier q p}} _ _ _
    (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} (#apply{(Sign.map q)}) _ _
      (HorizontalNatural.naturality (C.differential.vertical q p) (Nat.Nat^::succ p) (#apply{(C.differential.horizontal q (Nat.Nat^::succ p))} x)))
    (trans!{{C.family.Carrier q p}} _ _ _
      (sym!{{C.family.Carrier q p}} _ _ (Sign.addition q (Nat.Nat^::succ p) (#apply{(C.differential.vertical q p)} (#apply{(C.differential.horizontal q (Nat.Nat^::succ p))} x))))
      (trans!{{C.family.Carrier q p}} _ _ _
        (congr!{Nat.Nat^ {C.family.Carrier q p}} (\fun (a: Nat.Nat^) => #apply{(Sign.map a)} (#apply{(C.differential.vertical q p)} (#apply{(C.differential.horizontal q (Nat.Nat^::succ p))} x))) _ _ signDegree)
        (trans!{{C.family.Carrier q p}} _ _ _
          (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} (#apply{(Sign.map (Arithmetic.add p (Nat.Nat^::succ q)))}) _ _ (sym!{{C.family.Carrier q p}} _ _ (#commute{C.laws} q p x)))
          (trans!{{C.family.Carrier q p}} _ _ _
            (Sign.addition p (Nat.Nat^::succ q) (#apply{(C.differential.horizontal q p)} (#apply{(C.differential.vertical (Nat.Nat^::succ q) p)} x)))
            (sym!{{C.family.Carrier q p}} _ _
              (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} (#apply{(Sign.map p)}) _ _
                (VerticalNatural.naturality (C.differential.horizontal q p) (Nat.Nat^::succ q) (#apply{(C.differential.vertical (Nat.Nat^::succ q) p)} x))))))));
