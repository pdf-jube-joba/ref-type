\import \parent.\parent.Sign[V := C.family.Carrier q p, space := C.family.space q p] \as Sign;
\import \parent.\parent.Sign[V := C.family.Carrier q (Nat.Nat^::succ p), space := C.family.space q (Nat.Nat^::succ p)].Mapping[
  W := C.family.Carrier q p, target := C.family.space q p] \as HorizontalNatural;
\import \parent.\parent.Sign[V := C.family.Carrier (Nat.Nat^::succ q) p, space := C.family.space (Nat.Nat^::succ q) p].Mapping[
  W := C.family.Carrier q p, target := C.family.space q p] \as VerticalNatural;
\definition horizontalZero: \forall (x: C.family.Carrier q (Nat.Nat^::succ (Nat.Nat^::succ p))) ->
  (differential.horizontal p q).apply ((differential.horizontal (Nat.Nat^::succ p) q).apply x) = (C.family.space q p).zero :=
  \fun (x: C.family.Carrier q (Nat.Nat^::succ (Nat.Nat^::succ p))) => trans!{{C.family.Carrier q p}} _ _ _
    (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} ((Sign.map q).apply) _ _
      (HorizontalNatural.naturality (C.differential.vertical q p) q ((C.differential.vertical q (Nat.Nat^::succ p)).apply x)))
    (trans!{{C.family.Carrier q p}} _ _ _
      (Sign.involutive q ((C.differential.vertical q p).apply ((C.differential.vertical q (Nat.Nat^::succ p)).apply x)))
      (C.laws.verticalZero q p x));
\definition verticalZero: \forall (x: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p) ->
  (differential.vertical p q).apply ((differential.vertical p (Nat.Nat^::succ q)).apply x) = (C.family.space q p).zero :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ q)) p) => trans!{{C.family.Carrier q p}} _ _ _
    (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} ((Sign.map p).apply) _ _
      (VerticalNatural.naturality (C.differential.horizontal q p) p ((C.differential.horizontal (Nat.Nat^::succ q) p).apply x)))
    (trans!{{C.family.Carrier q p}} _ _ _
      (Sign.involutive p ((C.differential.horizontal q p).apply ((C.differential.horizontal (Nat.Nat^::succ q) p).apply x)))
      (C.laws.horizontalZero q p x));
\definition signDegree: Arithmetic.add q (Nat.Nat^::succ p) = Arithmetic.add p (Nat.Nat^::succ q) :=
  congr!{Nat.Nat^ Nat.Nat^} Nat.Nat^::succ _ _ (Natural.addComm q p);
\definition commute: \forall (x: C.family.Carrier (Nat.Nat^::succ q) (Nat.Nat^::succ p)) ->
  (differential.horizontal p q).apply ((differential.vertical (Nat.Nat^::succ p) q).apply x) =
  (differential.vertical p q).apply ((differential.horizontal p (Nat.Nat^::succ q)).apply x) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ q) (Nat.Nat^::succ p)) => trans!{{C.family.Carrier q p}} _ _ _
    (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} ((Sign.map q).apply) _ _
      (HorizontalNatural.naturality (C.differential.vertical q p) (Nat.Nat^::succ p) ((C.differential.horizontal q (Nat.Nat^::succ p)).apply x)))
    (trans!{{C.family.Carrier q p}} _ _ _
      (sym!{{C.family.Carrier q p}} _ _ (Sign.addition q (Nat.Nat^::succ p) ((C.differential.vertical q p).apply ((C.differential.horizontal q (Nat.Nat^::succ p)).apply x))))
      (trans!{{C.family.Carrier q p}} _ _ _
        (congr!{Nat.Nat^ {C.family.Carrier q p}} (\fun (a: Nat.Nat^) => (Sign.map a).apply ((C.differential.vertical q p).apply ((C.differential.horizontal q (Nat.Nat^::succ p)).apply x))) _ _ signDegree)
        (trans!{{C.family.Carrier q p}} _ _ _
          (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} ((Sign.map (Arithmetic.add p (Nat.Nat^::succ q))).apply) _ _ (sym!{{C.family.Carrier q p}} _ _ (C.laws.commute q p x)))
          (trans!{{C.family.Carrier q p}} _ _ _
            (Sign.addition p (Nat.Nat^::succ q) ((C.differential.horizontal q p).apply ((C.differential.vertical (Nat.Nat^::succ q) p).apply x)))
            (sym!{{C.family.Carrier q p}} _ _
              (congr!{{C.family.Carrier q p} {C.family.Carrier q p}} ((Sign.map p).apply) _ _
                (VerticalNatural.naturality (C.differential.horizontal q p) (Nat.Nat^::succ q) ((C.differential.vertical (Nat.Nat^::succ q) p).apply x))))))));
