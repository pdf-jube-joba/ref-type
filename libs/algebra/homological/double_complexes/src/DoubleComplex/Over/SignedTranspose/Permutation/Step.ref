\import \parent.Degree[n := n] \as Current;
\import \parent.Degree[n := Nat.Nat^::succ n] \as Upper;
\import SourceCoordinates.Degree[n := n] \as SC;
\import TargetCoordinates.Degree[n := n] \as TC;
\module Component(i: Index n) {
  \import SourceCoordinates.StepAt[n := n, i := i] \as CS;
  \import TargetCoordinates.StepAt[n := n, i := index n i] \as ES;
  \import Current.Coordinate[i := i] \as Coordinate;
  \import Upper.Coordinate[i := CS.horizontalIndex] \as HorizontalCoordinate;
  \import Upper.Coordinate[i := CS.verticalIndex] \as VerticalCoordinate;
  \import \parent.\parent.\parent.\parent.Sign[V := C.family.Carrier #first{i} #second{i}, space := C.family.space #first{i} #second{i}] \as Sign;
  \import Modules.Laws[V := C.family.Carrier #first{i} #second{i}, space := C.family.space #first{i} #second{i}] \as Laws;
  \import algebra.Group[].Of[Carrier := C.family.Carrier #first{i} #second{i}, group := Laws.additive] \as Group;
  \definition horizontal(x: Source.Carrier (Nat.Nat^::succ n)): C.family.Carrier #first{i} #second{i} :=
    #apply{(C.differential.horizontal #first{i} #second{i})} (SourceCoordinates.Degree[n := Nat.Nat^::succ n].coordinate CS.horizontalIndex x);
  \definition vertical(x: Source.Carrier (Nat.Nat^::succ n)): C.family.Carrier #first{i} #second{i} :=
    #apply{(C.differential.vertical #first{i} #second{i})} (SourceCoordinates.Degree[n := Nat.Nat^::succ n].coordinate CS.verticalIndex x);
  \definition raw: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
    TC.coordinate (index n i) (#apply{Target.differential} n (#apply{Upper.forward} x)) =
      #add{(C.family.space #first{i} #second{i})} (#apply{(Sign.map #first{i})} (vertical x)) (horizontal x) :=
    \fun (x: Source.Carrier (Nat.Nat^::succ n)) => trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _
      (ES.differential (#apply{Upper.forward} x))
      (congr2!{{C.family.Carrier #first{i} #second{i}} {C.family.Carrier #first{i} #second{i}} {C.family.Carrier #first{i} #second{i}}}
        (#add{(C.family.space #first{i} #second{i})}) _ _ _ _
        (congr!{{C.family.Carrier #first{i} (Nat.Nat^::succ #second{i})} {C.family.Carrier #first{i} #second{i}}}
          (\fun (z: C.family.Carrier #first{i} (Nat.Nat^::succ #second{i})) => #apply{(Sign.map #first{i})} (#apply{(C.differential.vertical #first{i} #second{i})} z)) _ _ (VerticalCoordinate.formula x))
        (trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _
          (congr!{{C.family.Carrier (Nat.Nat^::succ #first{i}) #second{i}} {C.family.Carrier #first{i} #second{i}}}
            (\fun (z: C.family.Carrier (Nat.Nat^::succ #first{i}) #second{i}) =>
              #apply{(Sign.map #second{i})} (#apply{(Sign.map #second{i})} (#apply{(C.differential.horizontal #first{i} #second{i})} z))) _ _ (HorizontalCoordinate.formula x))
          (Sign.involutive #second{i} (horizontal x))));
  \definition point: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
    TC.coordinate (index n i) (#apply{Target.differential} n (#apply{Upper.forward} x)) =
    TC.coordinate (index n i) (#apply{Current.forward} (#apply{Source.differential} n x)) :=
    \fun (x: Source.Carrier (Nat.Nat^::succ n)) => trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _
      (raw x)
      (trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _ (Group.comm (#apply{(Sign.map #first{i})} (vertical x)) (horizontal x))
        (trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _ (sym!{{C.family.Carrier #first{i} #second{i}}} _ _ (CS.differential x))
          (sym!{{C.family.Carrier #first{i} #second{i}}} _ _ (Coordinate.formula (#apply{Source.differential} n x)))));
}
\definition commutes: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
  #apply{Target.differential} n (#apply{Upper.forward} x) = #apply{Current.forward} (#apply{Source.differential} n x) :=
  \fun (x: Source.Carrier (Nat.Nat^::succ n)) => TC.ext _ _ (\fun (j: Index n) =>
    \idelim index n (index n j) = j \with k: Index n =>
      TC.coordinate k (#apply{Target.differential} n (#apply{Upper.forward} x)) = TC.coordinate k (#apply{Current.forward} (#apply{Source.differential} n x))
      \by { base: Component[i := index n j].point x, equality: twice n j });
\definition backwardCommutes: \forall (y: Target.Carrier (Nat.Nat^::succ n)) ->
  #apply{Source.differential} n (#apply{Upper.backward} y) = #apply{Current.backward} (#apply{Target.differential} n y) :=
  \fun (y: Target.Carrier (Nat.Nat^::succ n)) => trans!{{Source.Carrier n}} _ _ _
    (sym!{{Source.Carrier n}} _ _ (Current.leftInverse (#apply{Source.differential} n (#apply{Upper.backward} y))))
    (trans!{{Source.Carrier n}} _ _ _
      (congr!{{Target.Carrier n} {Source.Carrier n}} (#apply{Current.backward}) _ _ (sym!{{Target.Carrier n}} _ _ (commutes (#apply{Upper.backward} y))))
      (congr!{{Target.Carrier (Nat.Nat^::succ n)} {Source.Carrier n}}
        (\fun (z: Target.Carrier (Nat.Nat^::succ n)) => #apply{Current.backward} (#apply{Target.differential} n z)) _ _ (Upper.rightInverse y)));
