\import \parent.Degree[n := n] \as Current;
\import \parent.Degree[n := Nat.Nat^::succ n] \as Upper;
\import SourceCoordinates.Degree[n := n] \as SC;
\import TargetCoordinates.Degree[n := n] \as TC;
\module Component(i: Index n) {
  \import SourceCoordinates.StepAt[n := n, i := i] \as CS;
  \import TargetCoordinates.StepAt[n := n, i := index n i] \as ES;
  \import Current.Coordinate[i := i] \as Coordinate;
  \import Upper.Coordinate[i := CS.horizontalIndex] \as HorizontalCoordinate;
  \import Upper.Coordinate[i := CS.verticalIndex] \as VerticalCoordinate;
  \import \parent.\parent.\parent.\parent.Sign[V := C.family.Carrier i.first i.second, space := C.family.space i.first i.second] \as Sign;
  \import Modules.Laws[V := C.family.Carrier i.first i.second, space := C.family.space i.first i.second] \as Laws;
  \import algebra.Group[].Of[Carrier := C.family.Carrier i.first i.second, group := Laws.additive] \as Group;
  \definition horizontal[x: Source.Carrier (Nat.Nat^::succ n)]: C.family.Carrier i.first i.second :=
    (C.differential.horizontal i.first i.second).apply (SourceCoordinates.Degree[n := Nat.Nat^::succ n].coordinate CS.horizontalIndex x);
  \definition vertical[x: Source.Carrier (Nat.Nat^::succ n)]: C.family.Carrier i.first i.second :=
    (C.differential.vertical i.first i.second).apply (SourceCoordinates.Degree[n := Nat.Nat^::succ n].coordinate CS.verticalIndex x);
  \definition raw: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
    TC.coordinate (index n i) (Target.differential.apply n (Upper.forward.apply x)) =
      (C.family.space i.first i.second).add ((Sign.map i.first).apply (vertical x)) (horizontal x) :=
    \fun (x: Source.Carrier (Nat.Nat^::succ n)) => trans!{{C.family.Carrier i.first i.second}} _ _ _
      (ES.differential (Upper.forward.apply x))
      (congr2!{{C.family.Carrier i.first i.second} {C.family.Carrier i.first i.second} {C.family.Carrier i.first i.second}}
        ((C.family.space i.first i.second).add) _ _ _ _
        (congr!{{C.family.Carrier i.first (Nat.Nat^::succ i.second)} {C.family.Carrier i.first i.second}}
          (\fun (z: C.family.Carrier i.first (Nat.Nat^::succ i.second)) => (Sign.map i.first).apply ((C.differential.vertical i.first i.second).apply z)) _ _ (VerticalCoordinate.formula x))
        (trans!{{C.family.Carrier i.first i.second}} _ _ _
          (congr!{{C.family.Carrier (Nat.Nat^::succ i.first) i.second} {C.family.Carrier i.first i.second}}
            (\fun (z: C.family.Carrier (Nat.Nat^::succ i.first) i.second) =>
              (Sign.map i.second).apply ((Sign.map i.second).apply ((C.differential.horizontal i.first i.second).apply z))) _ _ (HorizontalCoordinate.formula x))
          (Sign.involutive i.second (horizontal x))));
  \definition point: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
    TC.coordinate (index n i) (Target.differential.apply n (Upper.forward.apply x)) =
    TC.coordinate (index n i) (Current.forward.apply (Source.differential.apply n x)) :=
    \fun (x: Source.Carrier (Nat.Nat^::succ n)) => trans!{{C.family.Carrier i.first i.second}} _ _ _
      (raw x)
      (trans!{{C.family.Carrier i.first i.second}} _ _ _ (Group.comm ((Sign.map i.first).apply (vertical x)) (horizontal x))
        (trans!{{C.family.Carrier i.first i.second}} _ _ _ (sym!{{C.family.Carrier i.first i.second}} _ _ (CS.differential x))
          (sym!{{C.family.Carrier i.first i.second}} _ _ (Coordinate.formula (Source.differential.apply n x)))));
}
\definition commutes: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
  Target.differential.apply n (Upper.forward.apply x) = Current.forward.apply (Source.differential.apply n x) :=
  \fun (x: Source.Carrier (Nat.Nat^::succ n)) => TC.ext _ _ (\fun (j: Index n) =>
    \idelim index n (index n j) = j \with k: Index n =>
      TC.coordinate k (Target.differential.apply n (Upper.forward.apply x)) = TC.coordinate k (Current.forward.apply (Source.differential.apply n x))
      \by { base: Component[i := index n j].point x, equality: twice n j });
\definition backwardCommutes: \forall (y: Target.Carrier (Nat.Nat^::succ n)) ->
  Source.differential.apply n (Upper.backward.apply y) = Current.backward.apply (Target.differential.apply n y) :=
  \fun (y: Target.Carrier (Nat.Nat^::succ n)) => trans!{{Source.Carrier n}} _ _ _
    (sym!{{Source.Carrier n}} _ _ (Current.leftInverse (Source.differential.apply n (Upper.backward.apply y))))
    (trans!{{Source.Carrier n}} _ _ _
      (congr!{{Target.Carrier n} {Source.Carrier n}} (Current.backward.apply) _ _ (sym!{{Target.Carrier n}} _ _ (commutes (Upper.backward.apply y))))
      (congr!{{Target.Carrier (Nat.Nat^::succ n)} {Source.Carrier n}}
        (\fun (z: Target.Carrier (Nat.Nat^::succ n)) => Current.backward.apply (Target.differential.apply n z)) _ _ (Upper.rightInverse y)));
