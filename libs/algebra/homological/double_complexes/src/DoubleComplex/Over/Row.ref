\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: Nat.Nat^) => C.family.Carrier p n,
  space := \fun (n: Nat.Nat^) => C.family.space p n,
};
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: Nat.Nat^) => (C.differential.vertical p n).apply,
};
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: Nat.Nat^) => (C.differential.vertical p n).addition,
    scalar := \fun (n: Nat.Nat^) => (C.differential.vertical p n).scalar,
    squareZero := \fun (n: Nat.Nat^) => C.laws.verticalZero p n,
  },
};
