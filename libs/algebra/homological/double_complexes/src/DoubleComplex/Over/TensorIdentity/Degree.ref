\import Tensor.Term[p := p, q := q] \as Term;
\import Mapping.Degree[p := p, q := q] \as Map;
\import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q].Universal[U := Term.Carrier, target := Term.space] \as Universal;
\import Modules.End[V := Term.Carrier, space := Term.space] \as Identity;
\import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Linear;
\definition equality: Map.map = Identity.identity := Universal.ext Map.map Identity.identity Map.onTensor;
\definition law[x: Term.Carrier]: (Map.map).apply x = x := congr!{Linear.Map Term.Carrier} (\fun (h: Linear.Map) => (h).apply x) _ _ equality;
