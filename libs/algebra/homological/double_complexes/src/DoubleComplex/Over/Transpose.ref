\definition family: Family := Family {
  Carrier := \fun (p, q: Nat.Nat^) => C.family.Carrier q p,
  space := \fun (p, q: Nat.Nat^) => C.family.space q p,
};
\definition differential: DifferentialData[family] := DifferentialData[family] {
  horizontal := \fun (p, q: Nat.Nat^) => C.differential.vertical q p,
  vertical := \fun (p, q: Nat.Nat^) => C.differential.horizontal q p,
};
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    horizontalZero := \fun (p, q: Nat.Nat^) => C.laws.verticalZero q p,
    verticalZero := \fun (p, q: Nat.Nat^) => C.laws.horizontalZero q p,
    commute := \fun (p, q: Nat.Nat^)(x: C.family.Carrier (Nat.Nat^::succ q) (Nat.Nat^::succ p)) =>
      sym!{{C.family.Carrier q p}} _ _ (C.laws.commute q p x),
  },
};
