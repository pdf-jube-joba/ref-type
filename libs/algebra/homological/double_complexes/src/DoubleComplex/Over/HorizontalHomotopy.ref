\import \parent.Map[C := C, D := D] \as Maps;
\definition Data: \Set := \forall (p, q: Nat.Nat^) -> Modules.Hom[V := C.family.Carrier p q, W := D.family.Carrier (Nat.Nat^::succ p) q, source := C.family.space p q, target := D.family.space (Nat.Nat^::succ p) q].Map;
\structure Laws[f, g: Maps.Map, h: Data]: \Prop := {
  zero: \forall (q: Nat.Nat^)(x: C.family.Carrier Nat.Nat^::zero q) ->
    (D.family.space Nat.Nat^::zero q).add ((f Nat.Nat^::zero q).apply x) ((D.family.space Nat.Nat^::zero q).neg ((g Nat.Nat^::zero q).apply x)) = (D.differential.horizontal Nat.Nat^::zero q).apply ((h Nat.Nat^::zero q).apply x),
  positive: \forall (p, q: Nat.Nat^)(x: C.family.Carrier (Nat.Nat^::succ p) q) ->
    (D.family.space (Nat.Nat^::succ p) q).add ((f (Nat.Nat^::succ p) q).apply x) ((D.family.space (Nat.Nat^::succ p) q).neg ((g (Nat.Nat^::succ p) q).apply x)) =
    (D.family.space (Nat.Nat^::succ p) q).add ((D.differential.horizontal (Nat.Nat^::succ p) q).apply ((h (Nat.Nat^::succ p) q).apply x)) ((h p q).apply ((C.differential.horizontal p q).apply x)),
  vertical: \forall (p, q: Nat.Nat^)(x: C.family.Carrier p (Nat.Nat^::succ q)) ->
    (D.differential.vertical (Nat.Nat^::succ p) q).apply ((h p (Nat.Nat^::succ q)).apply x) = (h p q).apply ((C.differential.vertical p q).apply x),
};
\definition Homotopy[f, g: Maps.Map]: \Set := \Cast[Data] ({ h: Data \where Laws[f, g, h] });
\module With(f, g: Maps.Map, h: Homotopy f g);
