\import Chains.Map[C := C, D := C] \as LeftMaps;
\import Chains.Map[C := D, D := D] \as RightMaps;
\import Chains.Homotopy[C := C, D := C] \as LeftHomotopies;
\import Chains.Homotopy[C := D, D := D] \as RightHomotopies;
\definition identityLeft: LeftMaps.Map := Chains.End[C := C].identity;
\definition identityRight: RightMaps.Map := Chains.End[C := D].identity;
\import \parent.Tensor[C := C, D := D] \as Tensor;
\import \parent.Total[C := Tensor.complex] \as Total;
\import Chains.Map[C := Total.complex, D := Total.complex] \as Maps;
\import Chains.End[C := Total.complex] \as End;
\import Chains.Homotopy[C := Total.complex, D := Total.complex] \as Homotopies;
\definition tensor[f: LeftMaps.Map][g: RightMaps.Map]: Maps.Map := \parent.TensorMapping[C := C, D := C, E := D, F := D].With[f := f, g := g].total;
\module With(p: LeftMaps.Map, q: RightMaps.Map, left: LeftHomotopies.Homotopy identityLeft p, right: RightHomotopies.Homotopy identityRight q);
