\import \parent.Index[z := Signed.Int^::ofNat n] \as Source;
\import \parent.Index[z := Signed.Int^::ofNat (N.Nat^::succ n)] \as Domain;
\definition intro[x: C.family.Carrier n]: Carrier (Signed.Int^::ofNat n) :=
  \into[C.family.Carrier n](x, Source.submodule.carrier) \by { Logic.Or[_, _]::left Logic.True::intro };
\definition apply[x: Carrier (Signed.Int^::ofNat (N.Nat^::succ n))]: Carrier (Signed.Int^::ofNat n) :=
  \into[C.family.Carrier n](C.differential.apply n x, Source.submodule.carrier) \by { Logic.Or[_, _]::left Logic.True::intro };
\definition addition: \forall (x, y: Carrier (Signed.Int^::ofNat (N.Nat^::succ n))) ->
  apply ((space (Signed.Int^::ofNat (N.Nat^::succ n))).add x y) = (space (Signed.Int^::ofNat n)).add (apply x) (apply y) :=
  \fun (x, y: Carrier (Signed.Int^::ofNat (N.Nat^::succ n))) => C.laws.addition n x y;
\definition scalar: \forall (a: R)(x: Carrier (Signed.Int^::ofNat (N.Nat^::succ n))) ->
  apply ((space (Signed.Int^::ofNat (N.Nat^::succ n))).smul a x) = (space (Signed.Int^::ofNat n)).smul a (apply x) :=
  \fun (a: R)(x: Carrier (Signed.Int^::ofNat (N.Nat^::succ n))) => C.laws.scalar n a x;
\import Modules.Hom[V := C.family.Carrier n, W := Carrier (Signed.Int^::ofNat n), source := C.family.space n, target := space (Signed.Int^::ofNat n)] \as Forward;
\import Modules.Hom[V := Carrier (Signed.Int^::ofNat n), W := C.family.Carrier n, source := space (Signed.Int^::ofNat n), target := C.family.space n] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := intro,
  addition := \fun (x, y: C.family.Carrier n) => \refl((C.family.space n).add x y),
  scalar := \fun (a: R)(x: C.family.Carrier n) => \refl((C.family.space n).smul a x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (x: Carrier (Signed.Int^::ofNat n)) => x,
  addition := \fun (x, y: Carrier (Signed.Int^::ofNat n)) => \refl((C.family.space n).add x y),
  scalar := \fun (a: R)(x: Carrier (Signed.Int^::ofNat n)) => \refl((C.family.space n).smul a x),
};
\import Modules.Isomorphism[V := C.family.Carrier n, W := Carrier (Signed.Int^::ofNat n), source := C.family.space n, target := space (Signed.Int^::ofNat n)] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: C.family.Carrier n) => \refl(x),
  rightInverse := \fun (x: Carrier (Signed.Int^::ofNat n)) => \refl(x),
};
