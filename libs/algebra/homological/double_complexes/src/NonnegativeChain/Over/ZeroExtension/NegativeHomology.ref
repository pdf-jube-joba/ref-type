\import \parent.Negative[n := n] \as Term;
\import Internal.At[C := complex, z := Signed.Int^::negSucc n] \as Homology;
\import Modules.Zero[] \as Zero;
\definition isomorphism: Modules.Isomorphism[V := Homology.Homology, W := Zero.Carrier,
  source := Homology.homologySpace, target := Zero.moduleSpace].Isomorphism :=
  Homology.Vanishing[].isomorphism Term.zero;
\definition vanishes: \forall (q: Homology.Homology) -> q = Homology.zeroClass :=
  Homology.Vanishing[].zero Term.zero;
