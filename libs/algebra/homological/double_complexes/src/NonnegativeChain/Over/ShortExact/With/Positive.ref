\definition index: Signed.Int^ := Signed.Int^::ofNat n;
\definition injective: \forall (x, y: Left.Carrier index) -> #apply{data.inclusion} index x = #apply{data.inclusion} index y -> x = y :=
  \fun (x, y: Left.Carrier index)(equal: _) => #injective{s} n x y equal;
\definition onto: \forall (q: Right.Carrier index) -> \exists { y: Middle.Carrier index \where #apply{data.projection} index y = q } := \block {
  \fun (q: Right.Carrier index) \then
  \takefrom y: \Cast[B.family.Carrier n] ({ y: B.family.Carrier n \where #apply{s.projection} n y = q }) \by #onto{s} n q \then
  \return Logic.existsIntro[Middle.Carrier index, { y: Middle.Carrier index \where #apply{data.projection} index y = q }] (Middle.Positive[n := n].intro y)
    (\bysub(B.family.Carrier n, { y: B.family.Carrier n \where #apply{s.projection} n y = q }, y))
};
\definition kernelImage: \forall (y: Middle.Carrier index) -> #apply{data.projection} index y = #zero{(Right.space index)} ->
  \exists { x: Left.Carrier index \where #apply{data.inclusion} index x = y } := \block {
  \fun (y: Middle.Carrier index)(killed: _) \then
  \takefrom x: \Cast[A.family.Carrier n] ({ x: A.family.Carrier n \where #apply{s.inclusion} n x = y }) \by #kernelImage{s} n y killed \then
  \return Logic.existsIntro[Left.Carrier index, { x: Left.Carrier index \where #apply{data.inclusion} index x = y }] (Left.Positive[n := n].intro x)
    (\bysub(A.family.Carrier n, { x: A.family.Carrier n \where #apply{s.inclusion} n x = y }, x))
};
