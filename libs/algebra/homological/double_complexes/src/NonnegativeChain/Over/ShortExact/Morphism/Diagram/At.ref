\definition higher: N.Nat^ := N.Nat^::succ n;
\definition index: Signed.Int^ := Signed.Int^::ofNat higher;
\import SourceSequence.At[n := n] \as Source;
\import TargetSequence.At[n := n] \as TargetConnecting;
\import IntegerDiagram.At[k := index] \as IntegerNaturality;
\import RightMap.HomologyNaturality[f := c].At[n := higher] \as RightNaturality;
\import LeftMap.HomologyNaturality[f := a].At[n := n] \as LeftNaturality;
\import \parent.\parent.\parent.\parent.IntegerComparison[C := C].At[n := higher] \as SourceComparison;
\import \parent.\parent.\parent.\parent.IntegerComparison[C := A1].At[n := n] \as TargetLower;
\import \parent.\parent.\parent.\parent.Homology[C := C].At[n := higher] \as HC;
\import \parent.\parent.\parent.\parent.Homology[C := A1].At[n := n] \as HA;
\import RightMap.HomologyAt[n := higher] \as Right;
\import LeftMap.HomologyAt[n := n] \as Left;
\import Internal.ShortExact[A := AL.complex, B := BL.complex, C := CL.complex].At[s := SourceSequence.sequence, k := index] \as IntegerSource;
\import Internal.ShortExact[A := AR.complex, B := BR.complex, C := CR.complex].At[s := TargetSequence.sequence, k := index] \as IntegerTarget;
\import Internal.At[C := CR.complex, z := index] \as HCR;
\import Internal.At[C := AR.complex, z := Integers.previous index] \as HAR;
\definition naturality: Commutative -> \forall (q: HC.Carrier) ->
  TargetConnecting.connecting.apply ((Right.induced c).apply q) = (Left.induced a).apply (Source.connecting.apply q) :=
  \fun (diagram: Commutative)(q: HC.Carrier) => trans!{HA.Carrier} _ _ _
    (congr!{HCR.Homology HA.Carrier} (\fun (u: HCR.Homology) => TargetLower.isomorphism.backward.apply (IntegerTarget.connecting.apply u)) _ _
      (RightNaturality.commutes q))
    (trans!{HA.Carrier} _ _ _
      (congr!{HAR.Homology HA.Carrier} (TargetLower.isomorphism.backward.apply) _ _
        (IntegerNaturality.naturality (integerCommutative diagram) (SourceComparison.isomorphism.forward.apply q)))
      (LeftNaturality.inverseCommutes (IntegerSource.connecting.apply (SourceComparison.isomorphism.forward.apply q))));
