\import Modules.ExactPair[A := ia, B := ib, C := ic] \as MiddlePair;
\import Modules.ExactPair[A := ib, B := ic, C := id] \as RightPair;
\import Modules.ExactPair[A := ic, B := id, C := ie] \as NextPair;
\definition middleSource: MiddlePair.Sequence := MiddlePair.Sequence {
  first := InclusionInteger.induced ExtendedInclusion.map, last := ProjectionInteger.induced ExtendedProjection.map,
  zero := Exact.Exactness[].inclusionProjectionZero, kernelImage := Exact.Exactness[].exactAtB,
};
\definition rightSource: RightPair.Sequence := RightPair.Sequence {
  first := ProjectionInteger.induced ExtendedProjection.map, last := Exact.connecting,
  zero := Exact.Exactness[].projectionConnectingZero, kernelImage := Exact.Exactness[].exactAtC,
};
\definition nextSource: NextPair.Sequence := NextPair.Sequence {
  first := Exact.connecting, last := InclusionLowerInteger.induced ExtendedInclusion.map,
  zero := Exact.Exactness[].connectingInclusionZero, kernelImage := Exact.Exactness[].exactAtALower,
};
\import MiddlePair.Transport[A1 := a, B1 := b, C1 := c, sequence := middleSource,
  f := InclusionNatural.induced s.inclusion, g := ProjectionNatural.induced s.projection,
  a := aIsomorphism, b := bIsomorphism, c := cIsomorphism] \as MiddleTransport;
\import RightPair.Transport[A1 := b, B1 := c, C1 := d, sequence := rightSource,
  f := ProjectionNatural.induced s.projection, g := connecting,
  a := bIsomorphism, b := cIsomorphism, c := dIsomorphism] \as RightTransport;
\import NextPair.Transport[A1 := c, B1 := d, C1 := e, sequence := nextSource,
  f := connecting, g := InclusionLowerNatural.induced s.inclusion,
  a := cIsomorphism, b := dIsomorphism, c := eIsomorphism] \as NextTransport;
\import Inclusion.HomologyNaturality[f := s.inclusion].At[n := higher] \as InclusionNaturality;
\import Projection.HomologyNaturality[f := s.projection].At[n := higher] \as ProjectionNaturality;
\import Inclusion.HomologyNaturality[f := s.inclusion].At[n := n] \as LowerNaturality;
\definition middleLaws: Modules.ExactPair[A := a, B := b, C := c].Laws[MiddleTransport.data] := MiddleTransport.laws InclusionNaturality.inverseCommutes ProjectionNaturality.inverseCommutes;
\definition rightLaws: Modules.ExactPair[A := b, B := c, C := d].Laws[RightTransport.data] := RightTransport.laws ProjectionNaturality.inverseCommutes connectingCommutes;
\definition nextLaws: Modules.ExactPair[A := c, B := d, C := e].Laws[NextTransport.data] := NextTransport.laws connectingCommutes LowerNaturality.inverseCommutes;
\definition inclusionProjectionZero: \forall (h: a.Carrier) -> (ProjectionNatural.induced s.projection).apply ((InclusionNatural.induced s.inclusion).apply h) = c.space.zero := middleLaws.zero;
\definition projectionConnectingZero: \forall (h: b.Carrier) -> connecting.apply ((ProjectionNatural.induced s.projection).apply h) = d.space.zero := rightLaws.zero;
\definition connectingInclusionZero: \forall (h: c.Carrier) -> (InclusionLowerNatural.induced s.inclusion).apply (connecting.apply h) = e.space.zero := nextLaws.zero;
\definition exactAtB: \forall (h: b.Carrier) -> (ProjectionNatural.induced s.projection).apply h = c.space.zero -> \exists ( x: a.Carrier \where (InclusionNatural.induced s.inclusion).apply x = h ) := middleLaws.kernelImage;
\definition exactAtC: \forall (h: c.Carrier) -> connecting.apply h = d.space.zero -> \exists ( x: b.Carrier \where (ProjectionNatural.induced s.projection).apply x = h ) := rightLaws.kernelImage;
\definition exactAtALower: \forall (h: d.Carrier) -> (InclusionLowerNatural.induced s.inclusion).apply h = e.space.zero -> \exists ( x: c.Carrier \where connecting.apply x = h ) := nextLaws.kernelImage;
