\import Modules.Hom[V := B1.family.Carrier N.Nat^::zero, W := M.Carrier, source := B1.family.space N.Nat^::zero, target := M.space] \as Maps;
\import Modules.Laws[V := M.Carrier, space := M.space] \as Target;
\import algebra.Group[].Of[Carrier := M.Carrier, group := Target.additive] \as Group;
\definition Killed: \Prop := \forall (x: B1.family.Carrier (N.Nat^::succ N.Nat^::zero)) ->
  augmentation.apply (B1.differential.apply N.Nat^::zero x) = M.space.zero;
\definition preserved: Killed -> \forall (x: B.family.Carrier N.Nat^::zero) ->
  augmentation.apply (middle.apply N.Nat^::zero x) = augmentation.apply (b.apply N.Nat^::zero x) :=
  \fun (killed: Killed)(x: B.family.Carrier N.Nat^::zero) => trans!{M.Carrier} _ _ _
    (Maps.differencePreserved augmentation (b.apply N.Nat^::zero x) (LiftedBoundary.map.apply N.Nat^::zero x))
    (trans!{M.Carrier} _ _ _
      (congr!{M.Carrier M.Carrier} (\fun (v: M.Carrier) => M.space.add (augmentation.apply (b.apply N.Nat^::zero x)) (M.space.neg v)) _ _
        (killed (lifted.apply N.Nat^::zero x)))
      (trans!{M.Carrier} _ _ _
        (congr!{M.Carrier M.Carrier} (M.space.add (augmentation.apply (b.apply N.Nat^::zero x))) _ _ Group.negZero)
        (Group.zeroRight (augmentation.apply (b.apply N.Nat^::zero x)))));
