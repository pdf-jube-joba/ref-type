\definition index: Signed.Int^ := Signed.Int^::negSucc n;
\definition injective: \forall (x, y: Left.Carrier index) -> #apply{data.inclusion} index x = #apply{data.inclusion} index y -> x = y :=
  \fun (x, y: Left.Carrier index)(equal: _) => trans!{{Left.Carrier index}} x #zero{(Left.space index)} y (Left.Negative[n := n].zero x) (sym!{{Left.Carrier index}} _ _ (Left.Negative[n := n].zero y));
\definition onto: \forall (q: Right.Carrier index) -> \exists { y: Middle.Carrier index \where #apply{data.projection} index y = q } :=
  \fun (q: Right.Carrier index) => Logic.existsIntro[Middle.Carrier index, { y: Middle.Carrier index \where #apply{data.projection} index y = q }] (#zero{(Middle.space index)})
    (sym!{{Right.Carrier index}} _ _ (Right.Negative[n := n].zero q));
\definition kernelImage: \forall (y: Middle.Carrier index) -> #apply{data.projection} index y = #zero{(Right.space index)} ->
  \exists { x: Left.Carrier index \where #apply{data.inclusion} index x = y } :=
  \fun (y: Middle.Carrier index)(killed: _) => Logic.existsIntro[Left.Carrier index, { x: Left.Carrier index \where #apply{data.inclusion} index x = y }] (#zero{(Left.space index)})
    (sym!{{Middle.Carrier index}} _ _ (Middle.Negative[n := n].zero y));
