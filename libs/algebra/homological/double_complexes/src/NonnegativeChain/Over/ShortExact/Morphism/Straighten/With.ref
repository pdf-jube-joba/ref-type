\use std.Logic[].Equality[].eq_reason_in;
\definition Splits: \Prop := \forall (n: N.Nat^)(x: C1.family.Carrier n) -> t.projection.apply n ((sections n).apply x) = x;
\import Chains.Homotopy[C := B, D := B1] \as MiddleHomotopies;
\definition lifted: MiddleHomotopies.LinearData := MiddleHomotopies.LinearData {
  apply := \fun (n: N.Nat^)(x: B.family.Carrier n) => (sections (N.Nat^::succ n)).apply (h.apply n x),
  addition := \fun (n: N.Nat^)(x, y: B.family.Carrier n) => trans!{{B1.family.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{C1.family.Carrier (N.Nat^::succ n)} {B1.family.Carrier (N.Nat^::succ n)}} ((sections (N.Nat^::succ n)).apply) _ _ (h.addition n x y))
    ((sections (N.Nat^::succ n)).addition (h.apply n x) (h.apply n y)),
  scalar := \fun (n: N.Nat^)(a: R)(x: B.family.Carrier n) => trans!{{B1.family.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{C1.family.Carrier (N.Nat^::succ n)} {B1.family.Carrier (N.Nat^::succ n)}} ((sections (N.Nat^::succ n)).apply) _ _ (h.scalar n a x))
    ((sections (N.Nat^::succ n)).scalar a (h.apply n x)),
};
\import MiddleHomotopies.Boundary[h := lifted] \as LiftedBoundary;
\import LiftedBoundary.Correct[f := b] \as Corrected;
\import RightHomotopies.Boundary[h := RightHomotopies.linear first last h] \as RightBoundary;
\definition middle: MiddleMap.Map := Corrected.map;
\definition homotopy: MiddleHomotopies.Homotopy b middle := Corrected.homotopy;
\definition horizontal: Splits -> \forall (n: N.Nat^)(x: B.family.Carrier n) ->
  t.projection.apply n (B1.differential.apply n (lifted.apply n x)) = C1.differential.apply n (h.apply n x) :=
  \fun (splits: Splits)(n: N.Nat^)(x: B.family.Carrier n) => trans!{{C1.family.Carrier n}} _ _ _
    (sym!{{C1.family.Carrier n}} _ _ (t.projection.commutes n (lifted.apply n x)))
    (congr!{{C1.family.Carrier (N.Nat^::succ n)} {C1.family.Carrier n}} (C1.differential.apply n) _ _ (splits (N.Nat^::succ n) (h.apply n x)));
\definition projectedBoundary: Splits -> \forall (n: N.Nat^)(x: B.family.Carrier n) ->
  t.projection.apply n (LiftedBoundary.map.apply n x) = RightBoundary.map.apply n x :=
  \fun (splits: Splits) => \induction (n: N.Nat^) \return \forall (x: B.family.Carrier n) ->
    t.projection.apply n (LiftedBoundary.map.apply n x) = RightBoundary.map.apply n x \with {
      | zero: horizontal splits N.Nat^::zero
      | succ: \fun (n: N.Nat^)(unused: _)(x: B.family.Carrier (N.Nat^::succ n)) => trans!{{C1.family.Carrier (N.Nat^::succ n)}} _ _ _
        (t.projection.addition (N.Nat^::succ n) (B1.differential.apply (N.Nat^::succ n) (lifted.apply (N.Nat^::succ n) x)) (lifted.apply n (B.differential.apply n x)))
        (congr!{{C1.family.Carrier (N.Nat^::succ n)} {C1.family.Carrier (N.Nat^::succ n)} {C1.family.Carrier (N.Nat^::succ n)}} ((C1.family.space (N.Nat^::succ n)).add) _ _ _ _
          (horizontal splits (N.Nat^::succ n) x) (splits (N.Nat^::succ n) (h.apply n (B.differential.apply n x))))
    };
\definition boundaryEquation: \forall (n: N.Nat^)(x: B.family.Carrier n) ->
  (C1.family.space n).add (first.apply n x) ((C1.family.space n).neg (last.apply n x)) = RightBoundary.map.apply n x :=
  \induction (n: N.Nat^) \return \forall (x: B.family.Carrier n) ->
    (C1.family.space n).add (first.apply n x) ((C1.family.space n).neg (last.apply n x)) = RightBoundary.map.apply n x \with {
      | zero: h.zeroEquation
      | succ: \fun (n: N.Nat^)(unused: _) => h.successorEquation n
    };
\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := B1.family.Carrier n, W := C1.family.Carrier n, source := B1.family.space n, target := C1.family.space n] \as Projection;
  \definition differencePreserved: \forall (x, y: B1.family.Carrier n) ->
    t.projection.apply n ((B1.family.space n).add x ((B1.family.space n).neg y)) =
      (C1.family.space n).add (t.projection.apply n x) ((C1.family.space n).neg (t.projection.apply n y)) :=
    Projection.differencePreserved (TargetProjection.At[n := n].linear t.projection);
}
\definition commutes: Splits -> \forall (n: N.Nat^)(x: B.family.Carrier n) ->
  t.projection.apply n (middle.apply n x) = c.apply n (s.projection.apply n x) := \block {
  \fun (splits: Splits)(n: N.Nat^)(x: B.family.Carrier n) \then
  \let firstStep: t.projection.apply n (middle.apply n x) =
    (C1.family.space n).add (first.apply n x) ((C1.family.space n).neg (t.projection.apply n (LiftedBoundary.map.apply n x))) :=
    Degree[n := n].differencePreserved (b.apply n x) (LiftedBoundary.map.apply n x) \then
  \let secondStep: (C1.family.space n).add (first.apply n x) ((C1.family.space n).neg (t.projection.apply n (LiftedBoundary.map.apply n x))) =
    (C1.family.space n).add (first.apply n x) ((C1.family.space n).neg ((C1.family.space n).add (first.apply n x) ((C1.family.space n).neg (last.apply n x)))) :=
    congr!{{C1.family.Carrier n} {C1.family.Carrier n}}
      (\fun (v: C1.family.Carrier n) => (C1.family.space n).add (first.apply n x) ((C1.family.space n).neg v)) _ _
      (trans!{{C1.family.Carrier n}} _ _ _ (projectedBoundary splits n x) (sym!{{C1.family.Carrier n}} _ _ (boundaryEquation n x))) \then
  \return eq_reason_in!{{C1.family.Carrier n} _
    "=" _ "by" firstStep
    "=" _ "by" secondStep
    "=" _ "by" { RightBoundary.Degree[n := n].subtractDifference (first.apply n x) (last.apply n x) }
  }
};
\import double_complexes.NonnegativeChain[].Over[R := R, ring := ring].ShortExact[A := A, B := B, C := C].Morphism[A1 := A1, B1 := B1, C1 := C1] \as Morphism;
\import Morphism.Factor[s := s, t := t, b := middle, c := c] \as Factor;
\definition left[splits: Splits]: LeftMap.Map := Factor.map (commutes splits);
\definition diagram: \forall (splits: Splits) -> Morphism.Diagram[s := s, t := t, a := left splits, b := middle, c := c].Commutative :=
  \fun (splits: Splits) => Factor.diagram (commutes splits);
\module Augmentation(M: Modules.Bundle, augmentation: Modules.Hom[V := B1.family.Carrier N.Nat^::zero, W := M.Carrier, source := B1.family.space N.Nat^::zero, target := M.space].Map);
