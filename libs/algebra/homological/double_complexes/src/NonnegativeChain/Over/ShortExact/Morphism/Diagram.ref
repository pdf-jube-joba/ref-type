\import chain_complexes.Chain[].Over[R := R, ring := ring] \as Internal;
\structure Commutative: \Prop {
  left: \forall (n: N.Nat^)(x: A.family.Carrier n) -> b.apply n (s.inclusion.apply n x) = t.inclusion.apply n (a.apply n x),
  right: \forall (n: N.Nat^)(x: B.family.Carrier n) -> t.projection.apply n (b.apply n x) = c.apply n (s.projection.apply n x),
}
\import \parent.\parent.With[s := s] \as SourceSequence;
\import Target.With[s := t] \as TargetSequence;
\import LeftMap.ZeroExtension[f := a] \as ExtendedLeft;
\import MiddleMap.ZeroExtension[f := b] \as ExtendedMiddle;
\import RightMap.ZeroExtension[f := c] \as ExtendedRight;
\import \parent.\parent.\parent.ZeroExtension[C := A] \as AL;
\import \parent.\parent.\parent.ZeroExtension[C := B] \as BL;
\import \parent.\parent.\parent.ZeroExtension[C := C] \as CL;
\import \parent.\parent.\parent.ZeroExtension[C := A1] \as AR;
\import \parent.\parent.\parent.ZeroExtension[C := B1] \as BR;
\import \parent.\parent.\parent.ZeroExtension[C := C1] \as CR;
\import Internal.ShortExact[A := AL.complex, B := BL.complex, C := CL.complex].Morphism[A1 := AR.complex, B1 := BR.complex, C1 := CR.complex].Diagram[s := SourceSequence.sequence, t := TargetSequence.sequence, a := ExtendedLeft.map, b := ExtendedMiddle.map, c := ExtendedRight.map] \as IntegerDiagram;
\definition integerCommutative: Commutative -> IntegerDiagram.Commutative := \fun (diagram: Commutative) => IntegerDiagram.Commutative {
  left := \induction (z: Signed.Int^) \return \forall (x: AL.Carrier z) -> ExtendedMiddle.map.apply z (SourceSequence.sequence.inclusion.apply z x) = TargetSequence.sequence.inclusion.apply z (ExtendedLeft.map.apply z x) \with {
    | ofNat: \fun (n: N.Nat^)(x: AL.Carrier (Signed.Int^::ofNat n)) => diagram.left n x
    | negSucc: \fun (n: N.Nat^)(x: AL.Carrier (Signed.Int^::negSucc n)) => \refl((BR.space (Signed.Int^::negSucc n)).zero)
  },
  right := \induction (z: Signed.Int^) \return \forall (x: BL.Carrier z) -> TargetSequence.sequence.projection.apply z (ExtendedMiddle.map.apply z x) = ExtendedRight.map.apply z (SourceSequence.sequence.projection.apply z x) \with {
    | ofNat: \fun (n: N.Nat^)(x: BL.Carrier (Signed.Int^::ofNat n)) => diagram.right n x
    | negSucc: \fun (n: N.Nat^)(x: BL.Carrier (Signed.Int^::negSucc n)) => \refl((CR.space (Signed.Int^::negSucc n)).zero)
  },
};
\module At(n: N.Nat^);
