\import std.Arithmetic[].Int[] \as Signed;
\import \parent.\parent.\parent.ZeroExtension[C := B] \as Source;
\import \parent.\parent.\parent.ZeroExtension[C := C] \as Middle;
\import \parent.\parent.\parent.ZeroExtension[C := D] \as Target;
\import \parent.\parent.ZeroExtension[f := f] \as After;
\import Before.ZeroExtension[f := g] \as BeforeMap;
\import Result.ZeroExtension[f := compose f g] \as Composite;
\import chain_complexes.Chain[].Over[R := R, ring := ring].Map[C := Middle.complex, D := Target.complex].Composition[B := Source.complex] \as Composition;
\import chain_complexes.Chain[].Over[R := R, ring := ring].Map[C := Source.complex, D := Target.complex] \as ResultMaps;
\definition law: Composite.map = Composition.compose After.map BeforeMap.map := ResultMaps.ext _ _
  (\induction (z: Signed.Int^) \return \forall (x: Source.Carrier z) ->
    #apply{Composite.map} z x = #apply{(Composition.compose After.map BeforeMap.map)} z x \with {
      | ofNat: \fun (n: N.Nat^)(x: Source.Carrier (Signed.Int^::ofNat n)) => \refl(#apply{Composite.map} (Signed.Int^::ofNat n) x)
      | negSucc: \fun (n: N.Nat^)(x: Source.Carrier (Signed.Int^::negSucc n)) => \refl(#zero{(Target.space (Signed.Int^::negSucc n))})
    });
