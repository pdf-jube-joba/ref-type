\definition apply(x: Source.Carrier (Signed.Int^::ofNat n)): Target.Carrier (Signed.Int^::ofNat n) := Target.Positive[n := n].intro (#apply{f} n x);
\definition addition: \forall (x, y: Source.Carrier (Signed.Int^::ofNat n)) ->
  apply (#add{(Source.space (Signed.Int^::ofNat n))} x y) = #add{(Target.space (Signed.Int^::ofNat n))} (apply x) (apply y) :=
  \fun (x, y: Source.Carrier (Signed.Int^::ofNat n)) => #addition{f} n x y;
\definition scalar: \forall (a: R)(x: Source.Carrier (Signed.Int^::ofNat n)) ->
  apply (#smul{(Source.space (Signed.Int^::ofNat n))} a x) = #smul{(Target.space (Signed.Int^::ofNat n))} a (apply x) :=
  \fun (a: R)(x: Source.Carrier (Signed.Int^::ofNat n)) => #scalar{f} n a x;
