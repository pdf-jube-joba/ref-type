\import Source.PositiveHomology[n := n] \as SourceComparison;
\import Target.PositiveHomology[n := n] \as TargetComparison;
\import \parent.\parent.Positive[n := n] \as NaturalMap;
\import \parent.\parent.\parent.Positive[C := C, n := n] \as H;
\definition index: Signed.Int^ := Signed.Int^::ofNat (N.Nat^::succ n);
\import Internal.Map[C := Source.complex, D := Target.complex].At[k := index] \as IntegerMap;
\import Internal.At[C := Target.complex, z := index] \as IntegerH;
\import Internal.At[C := Source.complex, z := index] \as IntegerSource;
\import \parent.\parent.\parent.Positive[C := D, n := n] \as NaturalH;
\definition onClassCommutes: \forall (x: H.Cycle) -> TargetComparison.homologyIsomorphism.forward.apply ((NaturalMap.induced f).apply (H.classOf x)) = (IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply (H.classOf x)) :=
  \fun (x: H.Cycle) => trans!{IntegerH.Homology} (TargetComparison.homologyIsomorphism.forward.apply ((NaturalMap.induced f).apply (H.classOf x))) (TargetComparison.homologyIsomorphism.forward.apply (NaturalH.classOf ((NaturalMap.cyclesMap f).apply x))) ((IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply (H.classOf x)))
    (congr!{NaturalH.Homology IntegerH.Homology} (TargetComparison.homologyIsomorphism.forward.apply) ((NaturalMap.induced f).apply (H.classOf x)) (NaturalH.classOf ((NaturalMap.cyclesMap f).apply x)) (NaturalMap.onClass f x))
    (trans!{IntegerH.Homology} (TargetComparison.homologyIsomorphism.forward.apply (NaturalH.classOf ((NaturalMap.cyclesMap f).apply x))) (IntegerH.classOf (TargetComparison.cycleIsomorphism.forward.apply ((NaturalMap.cyclesMap f).apply x))) ((IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply (H.classOf x))) (TargetComparison.onClass ((NaturalMap.cyclesMap f).apply x))
      (trans!{IntegerH.Homology} (IntegerH.classOf (TargetComparison.cycleIsomorphism.forward.apply ((NaturalMap.cyclesMap f).apply x))) ((IntegerMap.induced map).apply (IntegerSource.classOf (SourceComparison.cycleIsomorphism.forward.apply x))) ((IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply (H.classOf x)))
        (sym!{IntegerH.Homology} ((IntegerMap.induced map).apply (IntegerSource.classOf (SourceComparison.cycleIsomorphism.forward.apply x))) (IntegerH.classOf (TargetComparison.cycleIsomorphism.forward.apply ((NaturalMap.cyclesMap f).apply x))) (IntegerMap.onClass map (SourceComparison.cycleIsomorphism.forward.apply x)))
        (congr!{IntegerSource.Homology IntegerH.Homology} ((IntegerMap.induced map).apply) (IntegerSource.classOf (SourceComparison.cycleIsomorphism.forward.apply x)) (SourceComparison.homologyIsomorphism.forward.apply (H.classOf x))
          (sym!{IntegerSource.Homology} (SourceComparison.homologyIsomorphism.forward.apply (H.classOf x)) (IntegerSource.classOf (SourceComparison.cycleIsomorphism.forward.apply x)) (SourceComparison.onClass x)))));
\definition commutes: \forall (q: H.Homology) -> TargetComparison.homologyIsomorphism.forward.apply ((NaturalMap.induced f).apply q) = (IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply q) :=
  H.classInduction (\fun (q: H.Homology) => TargetComparison.homologyIsomorphism.forward.apply ((NaturalMap.induced f).apply q) = (IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply q)) onClassCommutes;
\import \parent.\parent.HomologyAt[n := N.Nat^::succ n] \as Uniform;
\definition agrees: \forall (q: H.Homology) -> (Uniform.induced f).apply q = (NaturalMap.induced f).apply q :=
  \fun (q: H.Homology) => trans!{NaturalH.Homology}
    _ _ _
    (congr!{IntegerH.Homology NaturalH.Homology} (TargetComparison.homologyIsomorphism.backward.apply)
      _ _
      (sym!{IntegerH.Homology} (TargetComparison.homologyIsomorphism.forward.apply ((NaturalMap.induced f).apply q)) ((IntegerMap.induced map).apply (SourceComparison.homologyIsomorphism.forward.apply q)) (commutes q)))
    (TargetComparison.homologyIsomorphism.leftInverse ((NaturalMap.induced f).apply q));
