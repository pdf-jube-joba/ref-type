\use std.Logic[].Equality[].eq_reason_in;
\import std.Arithmetic[].Int[] \as Signed;
\import chain_complexes.Chain[].Over[R := R, ring := ring] \as Internal;
\import \parent.\parent.ZeroExtension[C := C] \as Source;
\import \parent.\parent.ZeroExtension[C := D] \as Target;
\import \parent.ZeroExtension[f := f] \as Extension;
\definition map: Internal.Map[C := Source.complex, D := Target.complex].Map := Extension.map;
\import \parent.\parent.Homology[C := C] \as NaturalSource;
\import \parent.\parent.Homology[C := D] \as NaturalTarget;
\module DegreeZero;
\module Positive(n: N.Nat^);
\module At(n: N.Nat^) {
  \import \parent.\parent.\parent.IntegerComparison[C := C].At[n := n] \as SourceComparison;
  \import \parent.\parent.\parent.IntegerComparison[C := D].At[n := n] \as TargetComparison;
  \import \parent.\parent.HomologyAt[n := n] \as NaturalMap;
  \import Internal.Map[C := Source.complex, D := Target.complex].At[k := Signed.Int^::ofNat n] \as IntegerMap;
  \import Internal.At[C := Target.complex, z := Signed.Int^::ofNat n] \as IntegerTarget;
  \import Internal.At[C := Source.complex, z := Signed.Int^::ofNat n] \as IntegerSource;
  \definition commutes: \forall (q: NaturalSource.At[n := n].Carrier) ->
    TargetComparison.isomorphism.forward.apply ((NaturalMap.induced f).apply q) =
    (IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply q) :=
    \fun (q: NaturalSource.At[n := n].Carrier) => TargetComparison.isomorphism.rightInverse ((IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply q));
  \definition inverseCommutes: \forall (q: IntegerSource.Homology) ->
    TargetComparison.isomorphism.backward.apply ((IntegerMap.induced map).apply q) =
    (NaturalMap.induced f).apply (SourceComparison.isomorphism.backward.apply q) :=
    \fun (q: IntegerSource.Homology) => eq_reason_in!{{NaturalTarget.At[n := n].Carrier} _
      "=" _ "by" { congr!{IntegerSource.Homology {NaturalTarget.At[n := n].Carrier}} (\fun (x: IntegerSource.Homology) => TargetComparison.isomorphism.backward.apply ((IntegerMap.induced map).apply x)) q (SourceComparison.isomorphism.forward.apply (SourceComparison.isomorphism.backward.apply q))
        (sym!{IntegerSource.Homology} (SourceComparison.isomorphism.forward.apply (SourceComparison.isomorphism.backward.apply q)) q (SourceComparison.isomorphism.rightInverse q)) }
      "=" _ "by" { congr!{IntegerTarget.Homology {NaturalTarget.At[n := n].Carrier}} (TargetComparison.isomorphism.backward.apply)
          _ _
          (sym!{IntegerTarget.Homology} _ _ (commutes (SourceComparison.isomorphism.backward.apply q))) }
      "=" _ "by" { TargetComparison.isomorphism.leftInverse ((NaturalMap.induced f).apply (SourceComparison.isomorphism.backward.apply q)) }
    };
}
