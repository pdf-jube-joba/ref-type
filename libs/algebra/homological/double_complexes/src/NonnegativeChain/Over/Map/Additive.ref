\import double_complexes.NonnegativeChain[].Over[R := R, ring := ring].Map[C := C, D := D] \as Maps;
\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier n, source := C.family.space n, target := D.family.space n] \as Linear;
  \definition zero: Linear.Map := Linear.zeroMap;
  \definition plus[f, g: Maps.Map]: Linear.Map := Linear.plus (Maps.At[n := n].linear f) (Maps.At[n := n].linear g);
  \definition negative[f: Maps.Map]: Linear.Map := Linear.negative (Maps.At[n := n].linear f);
  \import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n] \as After;
  \definition differential: After.Map := After.Map {
    apply := D.differential.apply n, addition := D.laws.addition n, scalar := D.laws.scalar n,
  };
  \definition differentialZero: D.differential.apply n (D.family.space (N.Nat^::succ n)).zero = (D.family.space n).zero := After.zeroPreserved differential;
  \definition differentialNegative: \forall (x: D.family.Carrier (N.Nat^::succ n)) ->
    D.differential.apply n ((D.family.space (N.Nat^::succ n)).neg x) = (D.family.space n).neg (D.differential.apply n x) := After.negativePreserved differential;
}
\definition zero: Maps.Map := Maps.Map {
  apply := \fun (n: N.Nat^) => (Degree[n := n].zero).apply,
  addition := \fun (n: N.Nat^) => (Degree[n := n].zero).addition,
  scalar := \fun (n: N.Nat^) => (Degree[n := n].zero).scalar,
  commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => Degree[n := n].differentialZero,
};
\definition plus[f, g: Maps.Map]: Maps.Map := Maps.Map {
  apply := \fun (n: N.Nat^) => (Degree[n := n].plus f g).apply,
  addition := \fun (n: N.Nat^) => (Degree[n := n].plus f g).addition,
  scalar := \fun (n: N.Nat^) => (Degree[n := n].plus f g).scalar,
  commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => trans!{{D.family.Carrier n}} _ _ _
    (D.laws.addition n (f.apply (N.Nat^::succ n) x) (g.apply (N.Nat^::succ n) x))
    (congr2!{{D.family.Carrier n} {D.family.Carrier n} {D.family.Carrier n}} ((D.family.space n).add) _ _ _ _
      (f.commutes n x) (g.commutes n x)),
};
\definition negative[f: Maps.Map]: Maps.Map := Maps.Map {
  apply := \fun (n: N.Nat^) => (Degree[n := n].negative f).apply,
  addition := \fun (n: N.Nat^) => (Degree[n := n].negative f).addition,
  scalar := \fun (n: N.Nat^) => (Degree[n := n].negative f).scalar,
  commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => trans!{{D.family.Carrier n}} _ _ _
    (Degree[n := n].differentialNegative (f.apply (N.Nat^::succ n) x))
    (congr!{{D.family.Carrier n} {D.family.Carrier n}} ((D.family.space n).neg) _ _ (f.commutes n x)),
};
\definition difference[f, g: Maps.Map]: Maps.Map := plus f (negative g);
