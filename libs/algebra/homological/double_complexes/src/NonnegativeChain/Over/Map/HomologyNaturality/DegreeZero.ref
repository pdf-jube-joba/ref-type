\import Source.DegreeZeroHomology[] \as SourceComparison;
\import Target.DegreeZeroHomology[] \as TargetComparison;
\import \parent.\parent.DegreeZero[] \as NaturalMap;
\import \parent.\parent.\parent.DegreeZero[C := C] \as H;
\import Internal.Map[C := Source.complex, D := Target.complex].At[k := Signed.Int^::ofNat N.Nat^::zero] \as IntegerMap;
\import Internal.At[C := Target.complex, z := Signed.Int^::ofNat N.Nat^::zero] \as IntegerH;
\import \parent.\parent.\parent.DegreeZero[C := D] \as NaturalH;
\import Internal.At[C := Source.complex, z := Signed.Int^::ofNat N.Nat^::zero] \as IntegerSource;
\definition onClassCommutes: \forall (x: C.family.Carrier N.Nat^::zero) -> TargetComparison.isomorphism.forward.apply ((NaturalMap.induced f).apply (H.classOf x)) = (IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply (H.classOf x)) :=
  \fun (x: C.family.Carrier N.Nat^::zero) => trans!{IntegerH.Homology} (TargetComparison.isomorphism.forward.apply ((NaturalMap.induced f).apply (H.classOf x))) (TargetComparison.isomorphism.forward.apply (NaturalH.classOf (f.apply N.Nat^::zero x))) ((IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply (H.classOf x)))
    (congr!{NaturalH.Homology IntegerH.Homology} (TargetComparison.isomorphism.forward.apply) ((NaturalMap.induced f).apply (H.classOf x)) (NaturalH.classOf (f.apply N.Nat^::zero x)) (NaturalMap.onClass f x))
    (trans!{IntegerH.Homology} (TargetComparison.isomorphism.forward.apply (NaturalH.classOf (f.apply N.Nat^::zero x))) (IntegerH.classOf (TargetComparison.into (f.apply N.Nat^::zero x))) ((IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply (H.classOf x))) (TargetComparison.onClass (f.apply N.Nat^::zero x))
      (trans!{IntegerH.Homology} (IntegerH.classOf (TargetComparison.into (f.apply N.Nat^::zero x))) ((IntegerMap.induced map).apply (IntegerSource.classOf (SourceComparison.into x))) ((IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply (H.classOf x)))
        (sym!{IntegerH.Homology} ((IntegerMap.induced map).apply (IntegerSource.classOf (SourceComparison.into x))) (IntegerH.classOf (TargetComparison.into (f.apply N.Nat^::zero x))) (IntegerMap.onClass map (SourceComparison.into x)))
        (congr!{IntegerSource.Homology IntegerH.Homology} ((IntegerMap.induced map).apply) (IntegerSource.classOf (SourceComparison.into x)) (SourceComparison.isomorphism.forward.apply (H.classOf x))
          (sym!{IntegerSource.Homology} (SourceComparison.isomorphism.forward.apply (H.classOf x)) (IntegerSource.classOf (SourceComparison.into x)) (SourceComparison.onClass x)))));
\definition commutes: \forall (q: H.Homology) -> TargetComparison.isomorphism.forward.apply ((NaturalMap.induced f).apply q) = (IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply q) :=
  H.classInduction (\fun (q: H.Homology) => TargetComparison.isomorphism.forward.apply ((NaturalMap.induced f).apply q) = (IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply q)) onClassCommutes;
\import \parent.\parent.HomologyAt[n := N.Nat^::zero] \as Uniform;
\definition agrees: \forall (q: H.Homology) -> (Uniform.induced f).apply q = (NaturalMap.induced f).apply q :=
  \fun (q: H.Homology) => trans!{NaturalH.Homology}
    _ _ _
    (congr!{IntegerH.Homology NaturalH.Homology} (TargetComparison.isomorphism.backward.apply)
      _ _
      (sym!{IntegerH.Homology} (TargetComparison.isomorphism.forward.apply ((NaturalMap.induced f).apply q)) ((IntegerMap.induced map).apply (SourceComparison.isomorphism.forward.apply q)) (commutes q)))
    (TargetComparison.isomorphism.leftInverse ((NaturalMap.induced f).apply q));
