\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Map[C := C, D := D] \as Maps;
\structure Data: \Set := {
  inclusion: Maps.Map,
  retraction: \forall (n: N.Nat^) -> Modules.Hom[V := D.family.Carrier n, W := C.family.Carrier n, source := D.family.space n, target := C.family.space n].Map,
};
\structure Laws[data: Data]: \Prop := {
  leftInverse: \forall (n: N.Nat^)(x: C.family.Carrier n) -> (data.retraction n).apply ((data.inclusion).apply n x) = x,
};
\definition SplitInjection: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition laws[pair: SplitInjection]: Laws[pair] := \bysub(Data, { data: Data \where Laws[data] }, pair);
\definition injective: \forall (pair: SplitInjection)(n: N.Nat^)(x, y: C.family.Carrier n) -> (pair.inclusion).apply n x = (pair.inclusion).apply n y -> x = y :=
  \fun (pair: SplitInjection)(n: N.Nat^)(x, y: C.family.Carrier n)(same: (pair.inclusion).apply n x = (pair.inclusion).apply n y) =>
    eq_reason_in!{{C.family.Carrier n} _
      "=" _ "by" { sym!{{C.family.Carrier n}} _ _ ((laws pair).leftInverse n x) }
      "=" _ "by" { congr!{{D.family.Carrier n} {C.family.Carrier n}} ((pair.retraction n).apply) _ _ same }
      "=" _ "by" { (laws pair).leftInverse n y }
    };
\module On(pair: SplitInjection);
