\module Degree(n: N.Nat^) {
  \import Modules.Biproduct[V := C.family.Carrier n, W := D.family.Carrier n, left := C.family.space n, right := D.family.space n].Copair[U := E.family.Carrier n, target := E.family.space n] \as Pair;
  \definition map: Modules.Hom[V := Carrier n, W := E.family.Carrier n, source := space n, target := E.family.space n].Map :=
    Pair.copair (First.At[n := n].linear f) (Second.At[n := n].linear g);
}
\definition map: \parent.\parent.\parent.Map[C := complex, D := E].Map := \parent.\parent.\parent.Map[C := complex, D := E].Map {
  apply := \fun (n: N.Nat^) => #apply{Degree[n := n].map},
  addition := \fun (n: N.Nat^) => #addition{Degree[n := n].map},
  scalar := \fun (n: N.Nat^) => #scalar{Degree[n := n].map},
  commutes := \fun (n: N.Nat^)(x: Carrier (N.Nat^::succ n)) => trans!{{E.family.Carrier n}} _ _ _
    (#addition{E.laws} n (#apply{f} (N.Nat^::succ n) (\parent.\parent.At[n := N.Nat^::succ n].first x)) (#apply{g} (N.Nat^::succ n) (\parent.\parent.At[n := N.Nat^::succ n].second x)))
    (congr2!{{E.family.Carrier n} {E.family.Carrier n} {E.family.Carrier n}} (#add{(E.family.space n)}) _ _ _ _
      (#commutes{f} n (\parent.\parent.At[n := N.Nat^::succ n].first x)) (#commutes{g} n (\parent.\parent.At[n := N.Nat^::succ n].second x))),
};
