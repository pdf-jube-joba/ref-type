\import std.Arithmetic[].Int[] \as I;
\import chain_complexes.Chain[].Over[R := R, ring := ring] \as Chains;
\import \root.NonnegativeChain[].Over[R := R, ring := ring] \as Native;
\import Native.ZeroExtension[C := C] \as Left;
\import Native.ZeroExtension[C := D] \as Right;
\import Native.ZeroExtension[C := complex] \as Sum;
\import Native.Map[C := complex, D := C].ZeroExtension[f := firstProjection] \as FirstProjection;
\import Native.Map[C := complex, D := D].ZeroExtension[f := secondProjection] \as SecondProjection;
\import Native.Map[C := C, D := complex].ZeroExtension[f := firstInjection] \as FirstInjection;
\import Native.Map[C := D, D := complex].ZeroExtension[f := secondInjection] \as SecondInjection;
\definition firstRoundtrip: \forall (z: I.Int^)(x: Left.Carrier z) -> (FirstProjection.map).apply z ((FirstInjection.map).apply z x) = x :=
  \induction (z: I.Int^) \return \forall (x: Left.Carrier z) -> (FirstProjection.map).apply z ((FirstInjection.map).apply z x) = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Left.Carrier (I.Int^::ofNat n)) => \refl(x)
    | negSucc: \fun (n: N.Nat^)(x: Left.Carrier (I.Int^::negSucc n)) => trans!{{Left.Carrier (I.Int^::negSucc n)}} _ _ _ (Left.Negative[n := n].zero ((FirstProjection.map).apply (I.Int^::negSucc n) ((FirstInjection.map).apply (I.Int^::negSucc n) x))) (sym!{{Left.Carrier (I.Int^::negSucc n)}} _ _ (Left.Negative[n := n].zero x))
  };
\definition secondRoundtrip: \forall (z: I.Int^)(x: Right.Carrier z) -> (SecondProjection.map).apply z ((SecondInjection.map).apply z x) = x :=
  \induction (z: I.Int^) \return \forall (x: Right.Carrier z) -> (SecondProjection.map).apply z ((SecondInjection.map).apply z x) = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Right.Carrier (I.Int^::ofNat n)) => \refl(x)
    | negSucc: \fun (n: N.Nat^)(x: Right.Carrier (I.Int^::negSucc n)) => trans!{{Right.Carrier (I.Int^::negSucc n)}} _ _ _ (Right.Negative[n := n].zero ((SecondProjection.map).apply (I.Int^::negSucc n) ((SecondInjection.map).apply (I.Int^::negSucc n) x))) (sym!{{Right.Carrier (I.Int^::negSucc n)}} _ _ (Right.Negative[n := n].zero x))
  };
\definition firstCross: \forall (z: I.Int^)(x: Right.Carrier z) -> (FirstProjection.map).apply z ((SecondInjection.map).apply z x) = (Left.space z).zero :=
  \induction (z: I.Int^) \return \forall (x: Right.Carrier z) -> (FirstProjection.map).apply z ((SecondInjection.map).apply z x) = (Left.space z).zero \with {
    | ofNat: \fun (n: N.Nat^)(x: Right.Carrier (I.Int^::ofNat n)) => \refl((Left.space (I.Int^::ofNat n)).zero)
    | negSucc: \fun (n: N.Nat^)(x: Right.Carrier (I.Int^::negSucc n)) => Left.Negative[n := n].zero ((FirstProjection.map).apply (I.Int^::negSucc n) ((SecondInjection.map).apply (I.Int^::negSucc n) x))
  };
\definition secondCross: \forall (z: I.Int^)(x: Left.Carrier z) -> (SecondProjection.map).apply z ((FirstInjection.map).apply z x) = (Right.space z).zero :=
  \induction (z: I.Int^) \return \forall (x: Left.Carrier z) -> (SecondProjection.map).apply z ((FirstInjection.map).apply z x) = (Right.space z).zero \with {
    | ofNat: \fun (n: N.Nat^)(x: Left.Carrier (I.Int^::ofNat n)) => \refl((Right.space (I.Int^::ofNat n)).zero)
    | negSucc: \fun (n: N.Nat^)(x: Left.Carrier (I.Int^::negSucc n)) => Right.Negative[n := n].zero ((SecondProjection.map).apply (I.Int^::negSucc n) ((FirstInjection.map).apply (I.Int^::negSucc n) x))
  };
\definition reconstructed[z: I.Int^][x: Sum.Carrier z]: Sum.Carrier z :=
  (Sum.space z).add ((FirstInjection.map).apply z ((FirstProjection.map).apply z x)) ((SecondInjection.map).apply z ((SecondProjection.map).apply z x));
\module Positive(n: N.Nat^);
\definition reconstruction: \forall (z: I.Int^)(x: Sum.Carrier z) -> reconstructed z x = x :=
  \induction (z: I.Int^) \return \forall (x: Sum.Carrier z) -> reconstructed z x = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Sum.Carrier (I.Int^::ofNat n)) =>
        Positive[n := n].law x
    | negSucc: \fun (n: N.Nat^)(x: Sum.Carrier (I.Int^::negSucc n)) => trans!{{Sum.Carrier (I.Int^::negSucc n)}} _ _ _
        (Sum.Negative[n := n].zero (reconstructed (I.Int^::negSucc n) x)) (sym!{{Sum.Carrier (I.Int^::negSucc n)}} _ _ (Sum.Negative[n := n].zero x))
  };
\module Homology(z: I.Int^);
