\import \parent.At[n := n] \as Target;
\import \parent.At[n := N.Nat^::succ n] \as Source;
\import std.Data[].Pair[].Prop[A := C.family.Carrier n, B := D.family.Carrier n] \as Pairs;
\definition left: Modules.Hom[V := C.family.Carrier (N.Nat^::succ n), W := C.family.Carrier n, source := C.family.space (N.Nat^::succ n), target := C.family.space n].Map :=
  Modules.Hom[V := C.family.Carrier (N.Nat^::succ n), W := C.family.Carrier n, source := C.family.space (N.Nat^::succ n), target := C.family.space n].Map {
    apply := (C.differential).apply n, addition := (C.laws).addition n, scalar := (C.laws).scalar n,
  };
\definition right: Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n].Map :=
  Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n].Map {
    apply := (D.differential).apply n, addition := (D.laws).addition n, scalar := (D.laws).scalar n,
  };
\definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map {
  apply := \fun (x: Source.Carrier) => Target.make ((C.differential).apply n (Source.first x)) ((D.differential).apply n (Source.second x)),
  addition := \fun (x, y: Source.Carrier) => Pairs.ext _ _ ((C.laws).addition n (Source.first x) (Source.first y)) ((D.laws).addition n (Source.second x) (Source.second y)),
  scalar := \fun (a: R)(x: Source.Carrier) => Pairs.ext _ _ ((C.laws).scalar n a (Source.first x)) ((D.laws).scalar n a (Source.second x)),
};
\import \parent.Differential[n := N.Nat^::succ n] \as Higher;
\definition squareZero: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) -> (map).apply ((Higher.map).apply x) = (Target.space).zero :=
  \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => Pairs.ext _ _
    ((C.laws).squareZero n (\parent.At[n := N.Nat^::succ (N.Nat^::succ n)].first x)) ((D.laws).squareZero n (\parent.At[n := N.Nat^::succ (N.Nat^::succ n)].second x));
