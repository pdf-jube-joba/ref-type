\import \parent.\parent.At[n := n] \as Pair;
\definition lift[x: Pair.Carrier]: Sum.Carrier (I.Int^::ofNat n) := Sum.Positive[n := n].intro x;
\definition law: \forall (x: Sum.Carrier (I.Int^::ofNat n)) -> reconstructed (I.Int^::ofNat n) x = x :=
  \fun (x: Sum.Carrier (I.Int^::ofNat n)) => congr!{Pair.Carrier {Sum.Carrier (I.Int^::ofNat n)}} lift _ _ (Pair.reconstruction x);
