\definition map: \parent.\parent.\parent.Map[C := E, D := complex].Map := \parent.\parent.\parent.Map[C := E, D := complex].Map {
  apply := \fun (n: N.Nat^)(x: E.family.Carrier n) => \parent.\parent.At[n := n].make (#apply{f} n x) (#apply{g} n x),
  addition := \fun (n: N.Nat^)(x, y: E.family.Carrier n) => \parent.\parent.At[n := n].ext _ _ (#addition{f} n x y) (#addition{g} n x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: E.family.Carrier n) => \parent.\parent.At[n := n].ext _ _ (#scalar{f} n a x) (#scalar{g} n a x),
  commutes := \fun (n: N.Nat^)(x: E.family.Carrier (N.Nat^::succ n)) => \parent.\parent.At[n := n].ext _ _ (#commutes{f} n x) (#commutes{g} n x),
};
