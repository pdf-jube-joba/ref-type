\definition map: \parent.\parent.\parent.Map[C := E, D := complex].Map := \parent.\parent.\parent.Map[C := E, D := complex].Map {
  apply := \fun (n: N.Nat^)(x: E.family.Carrier n) => \parent.\parent.At[n := n].make ((f).apply n x) ((g).apply n x),
  addition := \fun (n: N.Nat^)(x, y: E.family.Carrier n) => \parent.\parent.At[n := n].ext _ _ ((f).addition n x y) ((g).addition n x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: E.family.Carrier n) => \parent.\parent.At[n := n].ext _ _ ((f).scalar n a x) ((g).scalar n a x),
  commutes := \fun (n: N.Nat^)(x: E.family.Carrier (N.Nat^::succ n)) => \parent.\parent.At[n := n].ext _ _ ((f).commutes n x) ((g).commutes n x),
};
