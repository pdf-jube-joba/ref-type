\import \parent.At[n := n] \as Target;
\import \parent.At[n := N.Nat^::succ n] \as Source;
\import std.Data[].Pair[].Prop[A := C.family.Carrier n, B := D.family.Carrier n] \as Pairs;
\import Modules.Hom[V := C.family.Carrier (N.Nat^::succ n), W := C.family.Carrier n, source := C.family.space (N.Nat^::succ n), target := C.family.space n] \as Left;
\import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n] \as Right;
\definition first: \forall (x: C.family.Carrier (N.Nat^::succ n)) ->
  (differential).apply n ((Source.firstInjection).apply x) = (Target.firstInjection).apply ((C.differential).apply n x) :=
  \fun (x: C.family.Carrier (N.Nat^::succ n)) => Pairs.ext _ _ (\refl((C.differential).apply n x)) (Right.zeroPreserved (\parent.Differential[n := n].right));
\definition second: \forall (x: D.family.Carrier (N.Nat^::succ n)) ->
  (differential).apply n ((Source.secondInjection).apply x) = (Target.secondInjection).apply ((D.differential).apply n x) :=
  \fun (x: D.family.Carrier (N.Nat^::succ n)) => Pairs.ext _ _ (Left.zeroPreserved (\parent.Differential[n := n].left)) (\refl((D.differential).apply n x));
