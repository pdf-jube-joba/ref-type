\structure Data: \Set := { apply: \forall (n: N.Nat^) -> C.family.Carrier n -> D.family.Carrier n };
\structure Laws[data: Data]: \Prop := {
  addition: \forall (n: N.Nat^)(x, y: C.family.Carrier n) ->
    data.apply n ((C.family.space n).add x y) = (D.family.space n).add (data.apply n x) (data.apply n y),
  scalar: \forall (n: N.Nat^)(a: R)(x: C.family.Carrier n) ->
    data.apply n ((C.family.space n).smul a x) = (D.family.space n).smul a (data.apply n x),
  commutes: \forall (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) ->
    D.differential.apply n (data.apply (N.Nat^::succ n) x) = data.apply n (C.differential.apply n x),
};
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition dataExt: \forall (f, g: Data) -> f.apply = g.apply -> f = g :=
  \induction (f: Data) \return \forall (g: Data) -> f.apply = g.apply -> f = g \with {
    | # : \fun (f: \forall (k: N.Nat^) -> C.family.Carrier k -> D.family.Carrier k) =>
      \induction (g: Data) \return f = g.apply -> Data::# f = g \with {
        | # : \fun (g: \forall (k: N.Nat^) -> C.family.Carrier k -> D.family.Carrier k)(equal: f = g) =>
          congr!{{\forall (k: N.Nat^) -> C.family.Carrier k -> D.family.Carrier k} Data} (\fun (h: \forall (k: N.Nat^) -> C.family.Carrier k -> D.family.Carrier k) => Data::# h) f g equal
      }
  };
\definition ext: \forall (f, g: Map) -> (\forall (k: N.Nat^)(x: C.family.Carrier k) -> f.apply k x = g.apply k x) -> f = g :=
  \fun (f, g: Map)(same: \forall (k: N.Nat^)(x: C.family.Carrier k) -> f.apply k x = g.apply k x) =>
    dataExt f g (\axiom:funext(f.apply, g.apply, \fun (k: N.Nat^) => \axiom:funext(f.apply k, g.apply k, same k)));
\module At(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier n, source := C.family.space n, target := D.family.space n] \as Maps;
  \definition linear[f: Map]: Maps.Map := Maps.Map { apply := f.apply n, addition := f.addition n, scalar := f.scalar n };
  \definition zeroPreserved: \forall (f: Map) -> f.apply n (C.family.space n).zero = (D.family.space n).zero :=
    \fun (f: Map) => Maps.zeroPreserved (linear f);
}
\module Composition(B: Complex) {
  \import \parent.\parent.Map[C := B, D := C] \as Before;
  \import \parent.\parent.Map[C := B, D := D] \as Result;
  \definition compose[f: Map][g: Before.Map]: Result.Map := Result.Map {
    apply := \fun (n: N.Nat^)(x: B.family.Carrier n) => f.apply n (g.apply n x),
    addition := \fun (n: N.Nat^)(x, y: B.family.Carrier n) => trans!{{D.family.Carrier n}} _ _ _
      (congr!{{C.family.Carrier n} {D.family.Carrier n}} (f.apply n) _ _ (g.addition n x y))
      (f.addition n (g.apply n x) (g.apply n y)),
    scalar := \fun (n: N.Nat^)(a: R)(x: B.family.Carrier n) => trans!{{D.family.Carrier n}} _ _ _
      (congr!{{C.family.Carrier n} {D.family.Carrier n}} (f.apply n) _ _ (g.scalar n a x)) (f.scalar n a (g.apply n x)),
    commutes := \fun (n: N.Nat^)(x: B.family.Carrier (N.Nat^::succ n)) => trans!{{D.family.Carrier n}} _ _ _
      (f.commutes n (g.apply (N.Nat^::succ n) x))
      (congr!{{C.family.Carrier n} {D.family.Carrier n}} (f.apply n) _ _ (g.commutes n x)),
  };

  \module Positive(n: N.Nat^) {
    \import \parent.\parent.\parent.Positive[C := B, n := n] \as Source;
    \import \parent.\parent.\parent.Positive[C := C, n := n] \as Middle;
    \import \parent.\parent.\parent.Positive[C := D, n := n] \as Target;
    \import \parent.\parent.Positive[n := n] \as After;
    \import Before.Positive[n := n] \as BeforeMap;
    \import Result.Positive[n := n] \as ResultMap;
    \definition compositionOnHomology: \forall (f: Map)(g: Before.Map)(q: Source.Homology) ->
      (ResultMap.induced (compose f g)).apply q = (After.induced f).apply ((BeforeMap.induced g).apply q) :=
      \fun (f: Map)(g: Before.Map) => Source.classInduction
        (\fun (q: Source.Homology) => (ResultMap.induced (compose f g)).apply q = (After.induced f).apply ((BeforeMap.induced g).apply q))
        (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (ResultMap.onClass (compose f g) x)
          (trans!{Target.Homology} _ _ _ (sym!{Target.Homology} _ _ (After.onClass f ((BeforeMap.cyclesMap g).apply x)))
            (congr!{Middle.Homology Target.Homology} ((After.induced f).apply) _ _ (sym!{Middle.Homology} _ _ (BeforeMap.onClass g x)))));
  }
  \module DegreeZero {
    \import \parent.\parent.\parent.DegreeZero[C := B] \as Source;
    \import \parent.\parent.\parent.DegreeZero[C := C] \as Middle;
    \import \parent.\parent.\parent.DegreeZero[C := D] \as Target;
    \import \parent.\parent.DegreeZero[] \as After;
    \import Before.DegreeZero[] \as BeforeMap;
    \import Result.DegreeZero[] \as ResultMap;
    \definition compositionOnHomology: \forall (f: Map)(g: Before.Map)(q: Source.Homology) ->
      (ResultMap.induced (compose f g)).apply q = (After.induced f).apply ((BeforeMap.induced g).apply q) :=
      \fun (f: Map)(g: Before.Map) => Source.classInduction
        (\fun (q: Source.Homology) => (ResultMap.induced (compose f g)).apply q = (After.induced f).apply ((BeforeMap.induced g).apply q))
        (\fun (x: B.family.Carrier N.Nat^::zero) => trans!{Target.Homology} _ _ _ (ResultMap.onClass (compose f g) x)
          (trans!{Target.Homology} _ _ _ (sym!{Target.Homology} _ _ (After.onClass f (g.apply N.Nat^::zero x)))
            (congr!{Middle.Homology Target.Homology} ((After.induced f).apply) _ _ (sym!{Middle.Homology} _ _ (BeforeMap.onClass g x)))));
  }

  \module HomologyAt(n: N.Nat^);
}

\module Positive(n: N.Nat^);
\module DegreeZero;

\module ZeroExtension(f: Map);
\module HomologyAt(n: N.Nat^);
\module HomologyNaturality(f: Map);
\module Additive;

\module SurjectiveQuasi(f: Map);
