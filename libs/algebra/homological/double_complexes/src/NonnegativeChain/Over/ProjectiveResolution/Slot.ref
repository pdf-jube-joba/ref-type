\import Modules.Of[V := M.Carrier, space := M.space] \as Base;
\import Base.Submodule[] \as Submodules;
\import algebra.Group[].Of[Carrier := M.Carrier, group := Base.additive] \as Group;
\import Modules.Laws[V := M.Carrier, space := M.space] \as ModuleLaws;
\definition zero: \forall (k: N.Nat^) -> Eligible k M.space.zero :=
  \induction (k: N.Nat^) \return Eligible k M.space.zero \with {
    | zero: Logic.True::intro
    | succ: \fun (k: N.Nat^)(before: Eligible k M.space.zero) => \refl(M.space.zero)
  };
\definition addition: \forall (k: N.Nat^)(x, y: M.Carrier) -> Eligible k x -> Eligible k y -> Eligible k (M.space.add x y) :=
  \induction (k: N.Nat^) \return \forall (x, y: M.Carrier) -> Eligible k x -> Eligible k y -> Eligible k (M.space.add x y) \with {
    | zero: \fun (x, y: M.Carrier)(left, right: Logic.True) => Logic.True::intro
    | succ: \fun (k: N.Nat^)(before: \forall (x, y: M.Carrier) -> Eligible k x -> Eligible k y -> Eligible k (M.space.add x y))
        (x, y: M.Carrier)(left: x = M.space.zero)(right: y = M.space.zero) =>
      trans!{M.Carrier} _ _ _ (congr!{M.Carrier M.Carrier M.Carrier} (M.space.add) _ _ _ _ left right) (Group.zeroLeft M.space.zero)
  };
\definition scalar: \forall (k: N.Nat^)(a: R)(x: M.Carrier) -> Eligible k x -> Eligible k (M.space.smul a x) :=
  \induction (k: N.Nat^) \return \forall (a: R)(x: M.Carrier) -> Eligible k x -> Eligible k (M.space.smul a x) \with {
    | zero: \fun (a: R)(x: M.Carrier)(member: Logic.True) => Logic.True::intro
    | succ: \fun (k: N.Nat^)(before: \forall (a: R)(x: M.Carrier) -> Eligible k x -> Eligible k (M.space.smul a x))
        (a: R)(x: M.Carrier)(member: x = M.space.zero) =>
      trans!{M.Carrier} _ _ _ (congr!{M.Carrier M.Carrier} (M.space.smul a) _ _ member) (ModuleLaws.scaleZero a)
  };
\definition submodule: Submodules.Submodule := Submodules.Submodule {
  carrier := { x: M.Carrier \where Eligible n x }, zero := zero n, addition := addition n, scalar := scalar n,
};
\import Submodules.Of[S := submodule] \as Induced;
\definition Carrier: \Set := Induced.Carrier;
\definition space: Modules.Space Carrier := Induced.moduleSpace;
