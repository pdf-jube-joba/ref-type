\import Modules.Of[V := C.family.Carrier N.Nat^::zero, space := C.family.space N.Nat^::zero].Submodule[] \as Submodules;
\import Modules.Hom[V := C.family.Carrier (N.Nat^::succ N.Nat^::zero), W := C.family.Carrier N.Nat^::zero, source := C.family.space (N.Nat^::succ N.Nat^::zero), target := C.family.space N.Nat^::zero] \as Before;
\definition prior: Before.Map := Before.Map {
  apply := #apply{C.differential} N.Nat^::zero, addition := #addition{C.laws} N.Nat^::zero, scalar := #scalar{C.laws} N.Nat^::zero,
};
\import Submodules.Image[U := C.family.Carrier (N.Nat^::succ N.Nat^::zero), source := C.family.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\definition boundaries: Submodules.Submodule := Images.image prior;
\import Submodules.Quotient[S := boundaries] \as Quotient;
\definition Homology: \Set := Quotient.Carrier;
\definition homologySpace: Modules.Space Homology := Quotient.moduleSpace;
\definition classOf(x: C.family.Carrier N.Nat^::zero): Homology := Quotient.class x;
\definition classLinear: Modules.MapBetween (Modules.Bundle { Carrier := C.family.Carrier N.Nat^::zero, space := C.family.space N.Nat^::zero }) (Modules.Bundle { Carrier := Homology, space := homologySpace }) := Quotient.projection;
\definition classInduction(P: Homology -> \Prop): (\forall (x: C.family.Carrier N.Nat^::zero) -> P (classOf x)) -> \forall (x: Homology) -> P x := Quotient.induction P;
