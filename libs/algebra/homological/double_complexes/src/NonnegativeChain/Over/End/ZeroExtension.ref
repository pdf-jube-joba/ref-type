\import std.Arithmetic[].Int[] \as Signed;
\import \parent.\parent.ZeroExtension[C := C] \as Extension;
\import Maps.ZeroExtension[f := identity] \as Map;
\import chain_complexes.Chain[].Over[R := R, ring := ring].End[C := Extension.complex] \as End;
\import chain_complexes.Chain[].Over[R := R, ring := ring].Map[C := Extension.complex, D := Extension.complex] \as IntegerMaps;
\definition law: Map.map = End.identity := IntegerMaps.ext _ _
  (\induction (z: Signed.Int^) \return \forall (x: Extension.Carrier z) -> (Map.map).apply z x = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Extension.Carrier (Signed.Int^::ofNat n)) => \refl(x)
    | negSucc: \fun (n: N.Nat^)(x: Extension.Carrier (Signed.Int^::negSucc n)) => sym!{{Extension.Carrier (Signed.Int^::negSucc n)}} _ _ (Extension.Negative[n := n].zero x)
  });
