\import std.Arithmetic[].Int[] \as Signed;
\import \parent.\parent.ZeroExtension[C := C] \as Source;
\import \parent.\parent.ZeroExtension[C := D] \as Target;
\import Forward.ZeroExtension[f := #forward{e}] \as ForwardExtension;
\import Backward.ZeroExtension[f := #backward{e}] \as BackwardExtension;
\import chain_complexes.Chain[].Over[R := R, ring := ring] \as Integer;
\import Integer.Isomorphism[C := Source.complex, D := Target.complex] \as IntegerIso;
\definition integerLeftInverse: \forall (k: Signed.Int^)(x: Source.Carrier k) ->
  #apply{BackwardExtension.map} k (#apply{ForwardExtension.map} k x) = x :=
  \induction (k: Signed.Int^) \return \forall (x: Source.Carrier k) -> #apply{BackwardExtension.map} k (#apply{ForwardExtension.map} k x) = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Source.Carrier (Signed.Int^::ofNat n)) => #leftInverse{e} n x
    | negSucc: \fun (n: N.Nat^)(x: Source.Carrier (Signed.Int^::negSucc n)) => sym!{{Source.Carrier (Signed.Int^::negSucc n)}} _ _ (Source.Negative[n := n].zero x)
  };
\definition integerRightInverse: \forall (k: Signed.Int^)(x: Target.Carrier k) ->
  #apply{ForwardExtension.map} k (#apply{BackwardExtension.map} k x) = x :=
  \induction (k: Signed.Int^) \return \forall (x: Target.Carrier k) -> #apply{ForwardExtension.map} k (#apply{BackwardExtension.map} k x) = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Target.Carrier (Signed.Int^::ofNat n)) => #rightInverse{e} n x
    | negSucc: \fun (n: N.Nat^)(x: Target.Carrier (Signed.Int^::negSucc n)) => sym!{{Target.Carrier (Signed.Int^::negSucc n)}} _ _ (Target.Negative[n := n].zero x)
  };
\definition integerIsomorphism: IntegerIso.Isomorphism := IntegerIso.Isomorphism {
  forward := ForwardExtension.map, backward := BackwardExtension.map,
  leftInverse := integerLeftInverse, rightInverse := integerRightInverse,
};
\module At(n: N.Nat^) {
  \definition index: Signed.Int^ := Signed.Int^::ofNat n;
  \import \parent.\parent.\parent.Homology[C := C].At[n := n] \as HSource;
  \import \parent.\parent.\parent.Homology[C := D].At[n := n] \as HTarget;
  \import Integer.At[C := Source.complex, z := index] \as ISource;
  \import Integer.At[C := Target.complex, z := index] \as ITarget;
  \import \parent.\parent.\parent.IntegerComparison[C := C].At[n := n] \as SourceComparison;
  \import \parent.\parent.\parent.IntegerComparison[C := D].At[n := n] \as TargetComparison;
  \import Modules.Isomorphism[V := HTarget.Carrier, W := ITarget.Homology, source := HTarget.space, target := ITarget.homologySpace].Inverse[] \as ReverseTarget;
  \import Modules.Isomorphism[V := HSource.Carrier, W := ISource.Homology, source := HSource.space, target := ISource.homologySpace].Composition[
    U := ITarget.Homology, final := ITarget.homologySpace] \as First;
  \definition middle: Modules.Isomorphism[V := HSource.Carrier, W := ITarget.Homology, source := HSource.space, target := ITarget.homologySpace].Isomorphism :=
    First.compose (IntegerIso.At[z := index].isomorphism integerIsomorphism) SourceComparison.isomorphism;
  \import Modules.Isomorphism[V := HSource.Carrier, W := ITarget.Homology, source := HSource.space, target := ITarget.homologySpace].Composition[
    U := HTarget.Carrier, final := HTarget.space] \as Last;
  \definition isomorphism: Modules.Isomorphism[V := HSource.Carrier, W := HTarget.Carrier, source := HSource.space, target := HTarget.space].Isomorphism :=
    Last.compose (ReverseTarget.inverse TargetComparison.isomorphism) middle;
  \import Forward.HomologyAt[n := n] \as Natural;
  \definition forward: \forall (x: HSource.Carrier) -> #apply{#forward{isomorphism}} x = #apply{(Natural.induced #forward{e})} x :=
    \fun (x: HSource.Carrier) => \refl(#apply{(Natural.induced #forward{e})} x);
}
