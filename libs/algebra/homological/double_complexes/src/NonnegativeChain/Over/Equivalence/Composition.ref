\import \parent.\parent.Equivalence[C := D, D := E] \as Next;
\import \parent.\parent.Equivalence[C := C, D := E] \as Result;
\import \parent.\parent.Map[C := D, D := E] \as AfterForward;
\import \parent.\parent.Map[C := E, D := D] \as AfterBackward;
\import AfterForward.Composition[B := C] \as ForwardComposition;
\import Backward.Composition[B := E] \as BackwardComposition;
\import AfterBackward.Composition[B := D] \as MiddleLeft;
\import AfterForward.Composition[B := E] \as FinalRight;
\import \parent.\parent.Map[C := D, D := D].Composition[B := C] \as BeforeLeft;
\import \parent.\parent.Map[C := D, D := D].Composition[B := E] \as BeforeRight;
\import \parent.\parent.Map[C := E, D := C].Composition[B := C] \as ResultLeft;
\import \parent.\parent.Map[C := C, D := E].Composition[B := E] \as ResultRight;
\import \parent.\parent.End[C := D] \as MiddleEnd;
\import \parent.\parent.End[C := E] \as FinalEnd;
\import \parent.\parent.Homotopy[C := E, D := E] \as FinalHomotopy;
\module With(e: Equivalence, f: Next.Equivalence);
\definition compose[e: Equivalence][f: Next.Equivalence]: Result.Equivalence := With[e := e, f := f].equivalence;
