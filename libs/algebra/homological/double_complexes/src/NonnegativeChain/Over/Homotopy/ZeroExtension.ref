\import std.Arithmetic[].Int[] \as Signed;
\import chain_complexes.Integer[] \as Degrees;
\import chain_complexes.Chain[].Over[R := R, ring := ring] \as Internal;
\import \parent.\parent.ZeroExtension[C := C] \as Source;
\import \parent.\parent.ZeroExtension[C := D] \as Target;
\import Maps.ZeroExtension[f := f] \as First;
\import Maps.ZeroExtension[f := g] \as Second;
\import Internal.Homotopy[C := Source.complex, D := Target.complex] \as Homotopies;
\import Internal.Prior[C := Target.complex] \as TargetPrior;
\import std.Logic[].Equality[].Transport[A := Signed.Int^] \as Transport;
\definition apply: \forall (k: Signed.Int^) -> Source.Carrier k -> Target.Carrier (Degrees.next k) :=
  \induction (k: Signed.Int^) \return Source.Carrier k -> Target.Carrier (Degrees.next k) \with {
    | ofNat: \fun (n: N.Nat^)(x: Source.Carrier (Signed.Int^::ofNat n)) => Target.Positive[n := N.Nat^::succ n].intro (#apply{h} n x)
    | negSucc: \fun (n: N.Nat^)(x: Source.Carrier (Signed.Int^::negSucc n)) => #zero{(Target.space (Degrees.next (Signed.Int^::negSucc n)))}
  };
\definition data: Homotopies.Data := Homotopies.Data { apply := apply };
\definition Equation(k: Signed.Int^): \Prop := \forall (x: Source.Carrier k) ->
  #add{(Target.space k)} (#apply{First.map} k x) (#neg{(Target.space k)} (#apply{Second.map} k x)) =
    #add{(Target.space k)} (TargetPrior.value k (apply k x)) (Homotopies.shifted data k (#apply{Source.complex.differential} k x));
\module Term(n: N.Nat^);
\module Negative(n: N.Nat^);
\module Zero;
\module Positive(n: N.Nat^);
\definition addition: \forall (k: Signed.Int^)(x, y: Source.Carrier k) ->
  apply k (#add{(Source.space k)} x y) = #add{(Target.space (Degrees.next k))} (apply k x) (apply k y) :=
  \induction (k: Signed.Int^) \return \forall (x, y: Source.Carrier k) ->
    apply k (#add{(Source.space k)} x y) = #add{(Target.space (Degrees.next k))} (apply k x) (apply k y) \with {
      | ofNat: \fun (n: N.Nat^) => Term[n := n].addition
      | negSucc: \fun (n: N.Nat^) => Negative[n := n].addition
    };
\definition scalar: \forall (k: Signed.Int^)(a: R)(x: Source.Carrier k) ->
  apply k (#smul{(Source.space k)} a x) = #smul{(Target.space (Degrees.next k))} a (apply k x) :=
  \induction (k: Signed.Int^) \return \forall (a: R)(x: Source.Carrier k) ->
    apply k (#smul{(Source.space k)} a x) = #smul{(Target.space (Degrees.next k))} a (apply k x) \with {
      | ofNat: \fun (n: N.Nat^) => Term[n := n].scalar
      | negSucc: \fun (n: N.Nat^) => Negative[n := n].scalar
    };
\definition equation: \forall (k: Signed.Int^) -> Equation k := \induction (k: Signed.Int^) \return Equation k \with {
  | ofNat: \induction (n: N.Nat^) \return Equation (Signed.Int^::ofNat n) \with {
      | zero: Zero[].law
      | succ: \fun (n: N.Nat^)(before: Equation (Signed.Int^::ofNat n)) => Positive[n := n].law
    }
  | negSucc: \fun (n: N.Nat^) => Negative[n := n].law
};
\definition laws: Homotopies.Laws[First.map, Second.map, data] :=
  Homotopies.Laws[First.map, Second.map, data] { addition := addition, scalar := scalar, equation := equation };
\definition homotopy: Homotopies.Homotopy First.map Second.map := \into[Homotopies.Data](data, Homotopies.Homotopy First.map Second.map) \by { laws };
