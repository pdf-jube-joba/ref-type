\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := D.family.space (N.Nat^::succ n)] \as Shift;
  \definition shift: Shift.Map := Shift.Map { apply := (h).apply n, addition := (h).addition n, scalar := (h).scalar n };
  \import Before.At[n := n] \as BeforeDegree;
  \import Shift.Composition[U := B.family.Carrier n, domain := B.family.space n] \as Compose;
  \definition map: Modules.Hom[V := B.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := B.family.space n, target := D.family.space (N.Nat^::succ n)].Map := Compose.compose shift (BeforeDegree.linear k);
}
\definition data: Result.Data := Result.Data { apply := \fun (n: N.Nat^) => (Degree[n := n].map).apply };
\definition positive[n: N.Nat^][x: B.family.Carrier (N.Nat^::succ n)]:
  (D.family.space (N.Nat^::succ n)).add ((f).apply (N.Nat^::succ n) ((k).apply (N.Nat^::succ n) x)) ((D.family.space (N.Nat^::succ n)).neg ((g).apply (N.Nat^::succ n) ((k).apply (N.Nat^::succ n) x))) =
  (D.family.space (N.Nat^::succ n)).add ((D.differential).apply (N.Nat^::succ n) ((h).apply (N.Nat^::succ n) ((k).apply (N.Nat^::succ n) x))) ((h).apply n ((k).apply n ((B.differential).apply n x))) :=
  trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _ ((h).successorEquation n ((k).apply (N.Nat^::succ n) x))
    (congr!{{C.family.Carrier n} {D.family.Carrier (N.Nat^::succ n)}} (\fun (y: C.family.Carrier n) => (D.family.space (N.Nat^::succ n)).add ((D.differential).apply (N.Nat^::succ n) ((h).apply (N.Nat^::succ n) ((k).apply (N.Nat^::succ n) x))) ((h).apply n y)) _ _ ((k).commutes n x));
\definition homotopy: Result.Homotopy (Composition.compose f k) (Composition.compose g k) := \into[Result.Data](data, Result.Homotopy (Composition.compose f k) (Composition.compose g k)) \by {
  Result.Laws[Composition.compose f k, Composition.compose g k, data] {
    addition := \fun (n: N.Nat^) => (Degree[n := n].map).addition,
    scalar := \fun (n: N.Nat^) => (Degree[n := n].map).scalar,
    zeroEquation := \fun (x: B.family.Carrier N.Nat^::zero) => (h).zeroEquation ((k).apply N.Nat^::zero x),
    successorEquation := positive,
  }
};
