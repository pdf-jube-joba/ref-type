\definition boundary: Maps.Map := map;
\import double_complexes.NonnegativeChain[].Over[R := R, ring := ring].Homotopy[C := C, D := D].Boundary[h := h] \as Boundaries;
\definition map: Maps.Map := Additive.difference f boundary;
\definition homotopy: Homotopy f map := \into[Data](h, { data: Data \where Laws[f, map, data] }) \by {
  Laws[f, map, h] {
    addition := h.addition, scalar := h.scalar,
    zeroEquation := \fun (x: C.family.Carrier N.Nat^::zero) =>
      Boundaries.Degree[n := N.Nat^::zero].subtractDifference (f.apply N.Nat^::zero x) (boundary.apply N.Nat^::zero x),
    successorEquation := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) =>
      Boundaries.Degree[n := N.Nat^::succ n].subtractDifference (f.apply (N.Nat^::succ n) x) (boundary.apply (N.Nat^::succ n) x),
  }
};
