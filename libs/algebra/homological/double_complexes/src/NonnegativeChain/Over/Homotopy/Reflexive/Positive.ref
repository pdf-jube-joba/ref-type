\import \parent.At[n := N.Nat^::succ n] \as Degree;
\import Modules.Laws[V := D.family.Carrier (N.Nat^::succ n), space := D.family.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := D.family.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\definition rightZero: Values.add (#apply{D.differential} (N.Nat^::succ n) #zero{(D.family.space (N.Nat^::succ (N.Nat^::succ n)))}) Values.zero = Values.zero :=
  trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)}} (\fun (x: D.family.Carrier (N.Nat^::succ n)) => Values.add x Values.zero) _ _ Degree.boundaryZero) (Group.zeroLeft Values.zero);
\definition law: \forall (f: Maps.Map)(x: C.family.Carrier (N.Nat^::succ n)) -> Group.difference (#apply{f} (N.Nat^::succ n) x) (#apply{f} (N.Nat^::succ n) x) = Values.add (#apply{D.differential} (N.Nat^::succ n) #zero{(D.family.space (N.Nat^::succ (N.Nat^::succ n)))}) Values.zero :=
  \fun (f: Maps.Map)(x: C.family.Carrier (N.Nat^::succ n)) => trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _ (Group.inverseRight (#apply{f} (N.Nat^::succ n) x)) (sym!{{D.family.Carrier (N.Nat^::succ n)}} _ _ rightZero);
