\use std.Logic[].Equality[].eq_reason_in;
\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := D.family.space (N.Nat^::succ n)] \as Shift;
  \definition firstMap: Shift.Map := Shift.Map { apply := (first).apply n, addition := (first).addition n, scalar := (first).scalar n };
  \definition secondMap: Shift.Map := Shift.Map { apply := (second).apply n, addition := (second).addition n, scalar := (second).scalar n };
  \definition map: Shift.Map := Shift.plus firstMap (Shift.negative secondMap);
  \import Modules.Laws[V := D.family.Carrier n, space := D.family.space n] \as Values;
  \import algebra.Group[].Of[Carrier := D.family.Carrier n, group := Values.additive] \as Group;
  \definition difference: D.family.Carrier n -> D.family.Carrier n -> D.family.Carrier n := Group.difference;
  \definition cancel[a, b, c: D.family.Carrier n]: difference b c = difference (difference a c) (difference a b) := sym!{{D.family.Carrier n}} _ _ (Group.differenceCommonLeft a b c);
  \definition differenceAdd[a, b, c, d: D.family.Carrier n]: difference ((D.family.space n).add a b) ((D.family.space n).add c d) = (D.family.space n).add (difference a c) (difference b d) := Group.differenceAdd a b c d;
  \import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n] \as Boundary;
  \definition boundary: Boundary.Map := Boundary.Map { apply := (D.differential).apply n, addition := (D.laws).addition n, scalar := (D.laws).scalar n };
  \definition boundaryDifference[a, b: D.family.Carrier (N.Nat^::succ n)]: (D.differential).apply n ((D.family.space (N.Nat^::succ n)).add a ((D.family.space (N.Nat^::succ n)).neg b)) = difference ((D.differential).apply n a) ((D.differential).apply n b) := Boundary.differencePreserved boundary a b;
}
\definition data: Data := Data { apply := \fun (n: N.Nat^) => (Degree[n := n].map).apply };
\definition zero[x: C.family.Carrier N.Nat^::zero]: (D.family.space N.Nat^::zero).add ((u).apply N.Nat^::zero x) ((D.family.space N.Nat^::zero).neg ((g).apply N.Nat^::zero x)) = (D.differential).apply N.Nat^::zero ((data).apply N.Nat^::zero x) :=
  eq_reason_in!{{D.family.Carrier N.Nat^::zero} _
    "=" _ "by" { Degree[n := N.Nat^::zero].cancel ((f).apply N.Nat^::zero x) ((u).apply N.Nat^::zero x) ((g).apply N.Nat^::zero x) }
    "=" _ "by" { congr!{{D.family.Carrier N.Nat^::zero} {D.family.Carrier N.Nat^::zero} {D.family.Carrier N.Nat^::zero}} (Degree[n := N.Nat^::zero].difference) _ _ _ _ ((first).zeroEquation x) ((second).zeroEquation x) }
    "=" _ "by" { sym!{{D.family.Carrier N.Nat^::zero}} _ _ (Degree[n := N.Nat^::zero].boundaryDifference ((first).apply N.Nat^::zero x) ((second).apply N.Nat^::zero x)) }
  };
\definition positive[n: N.Nat^][x: C.family.Carrier (N.Nat^::succ n)]:
  (D.family.space (N.Nat^::succ n)).add ((u).apply (N.Nat^::succ n) x) ((D.family.space (N.Nat^::succ n)).neg ((g).apply (N.Nat^::succ n) x)) =
  (D.family.space (N.Nat^::succ n)).add ((D.differential).apply (N.Nat^::succ n) ((data).apply (N.Nat^::succ n) x)) ((data).apply n ((C.differential).apply n x)) :=
  eq_reason_in!{{D.family.Carrier (N.Nat^::succ n)} _
    "=" _ "by" { Degree[n := N.Nat^::succ n].cancel ((f).apply (N.Nat^::succ n) x) ((u).apply (N.Nat^::succ n) x) ((g).apply (N.Nat^::succ n) x) }
    "=" _ "by" { congr!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)}} (Degree[n := N.Nat^::succ n].difference) _ _ _ _ ((first).successorEquation n x) ((second).successorEquation n x) }
    "=" _ "by" { Degree[n := N.Nat^::succ n].differenceAdd
          ((D.differential).apply (N.Nat^::succ n) ((first).apply (N.Nat^::succ n) x)) ((first).apply n ((C.differential).apply n x))
          ((D.differential).apply (N.Nat^::succ n) ((second).apply (N.Nat^::succ n) x)) ((second).apply n ((C.differential).apply n x)) }
    "=" _ "by" { congr!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)}}
          (\fun (y: D.family.Carrier (N.Nat^::succ n)) => (D.family.space (N.Nat^::succ n)).add y ((data).apply n ((C.differential).apply n x))) _ _
          (sym!{{D.family.Carrier (N.Nat^::succ n)}} _ _ (Degree[n := N.Nat^::succ n].boundaryDifference ((first).apply (N.Nat^::succ n) x) ((second).apply (N.Nat^::succ n) x))) }
  };
\definition homotopy: Homotopy u g := \into[Data](data, Homotopy u g) \by {
  Laws[u, g, data] {
    addition := \fun (n: N.Nat^) => (Degree[n := n].map).addition,
    scalar := \fun (n: N.Nat^) => (Degree[n := n].map).scalar,
    zeroEquation := zero, successorEquation := positive,
  }
};
