\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := D.family.space (N.Nat^::succ n)] \as Shift;
  \definition firstMap: Shift.Map := Shift.Map { apply := #apply{first} n, addition := #addition{first} n, scalar := #scalar{first} n };
  \definition secondMap: Shift.Map := Shift.Map { apply := #apply{second} n, addition := #addition{second} n, scalar := #scalar{second} n };
  \definition map: Shift.Map := Shift.plus firstMap (Shift.negative secondMap);
  \import Modules.Laws[V := D.family.Carrier n, space := D.family.space n] \as Values;
  \import algebra.Group[].Of[Carrier := D.family.Carrier n, group := Values.additive] \as Group;
  \definition difference: D.family.Carrier n -> D.family.Carrier n -> D.family.Carrier n := Group.difference;
  \definition cancel(a, b, c: D.family.Carrier n): difference b c = difference (difference a c) (difference a b) := sym!{{D.family.Carrier n}} _ _ (Group.differenceCommonLeft a b c);
  \definition differenceAdd(a, b, c, d: D.family.Carrier n): difference (#add{(D.family.space n)} a b) (#add{(D.family.space n)} c d) = #add{(D.family.space n)} (difference a c) (difference b d) := Group.differenceAdd a b c d;
  \import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n] \as Boundary;
  \definition boundary: Boundary.Map := Boundary.Map { apply := #apply{D.differential} n, addition := #addition{D.laws} n, scalar := #scalar{D.laws} n };
  \definition boundaryDifference(a, b: D.family.Carrier (N.Nat^::succ n)): #apply{D.differential} n (#add{(D.family.space (N.Nat^::succ n))} a (#neg{(D.family.space (N.Nat^::succ n))} b)) = difference (#apply{D.differential} n a) (#apply{D.differential} n b) := Boundary.differencePreserved boundary a b;
}
\definition data: Data := Data { apply := \fun (n: N.Nat^) => #apply{Degree[n := n].map} };
\definition zero(x: C.family.Carrier N.Nat^::zero): #add{(D.family.space N.Nat^::zero)} (#apply{u} N.Nat^::zero x) (#neg{(D.family.space N.Nat^::zero)} (#apply{g} N.Nat^::zero x)) = #apply{D.differential} N.Nat^::zero (#apply{data} N.Nat^::zero x) :=
  trans!{{D.family.Carrier N.Nat^::zero}} _ _ _ (Degree[n := N.Nat^::zero].cancel (#apply{f} N.Nat^::zero x) (#apply{u} N.Nat^::zero x) (#apply{g} N.Nat^::zero x))
    (trans!{{D.family.Carrier N.Nat^::zero}} _ _ _
      (congr2!{{D.family.Carrier N.Nat^::zero} {D.family.Carrier N.Nat^::zero} {D.family.Carrier N.Nat^::zero}} (Degree[n := N.Nat^::zero].difference) _ _ _ _ (#zeroEquation{first} x) (#zeroEquation{second} x))
      (sym!{{D.family.Carrier N.Nat^::zero}} _ _ (Degree[n := N.Nat^::zero].boundaryDifference (#apply{first} N.Nat^::zero x) (#apply{second} N.Nat^::zero x))));
\definition positive(n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)):
  #add{(D.family.space (N.Nat^::succ n))} (#apply{u} (N.Nat^::succ n) x) (#neg{(D.family.space (N.Nat^::succ n))} (#apply{g} (N.Nat^::succ n) x)) =
  #add{(D.family.space (N.Nat^::succ n))} (#apply{D.differential} (N.Nat^::succ n) (#apply{data} (N.Nat^::succ n) x)) (#apply{data} n (#apply{C.differential} n x)) :=
  trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _ (Degree[n := N.Nat^::succ n].cancel (#apply{f} (N.Nat^::succ n) x) (#apply{u} (N.Nat^::succ n) x) (#apply{g} (N.Nat^::succ n) x))
    (trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _
      (congr2!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)}} (Degree[n := N.Nat^::succ n].difference) _ _ _ _ (#successorEquation{first} n x) (#successorEquation{second} n x))
      (trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _
        (Degree[n := N.Nat^::succ n].differenceAdd
          (#apply{D.differential} (N.Nat^::succ n) (#apply{first} (N.Nat^::succ n) x)) (#apply{first} n (#apply{C.differential} n x))
          (#apply{D.differential} (N.Nat^::succ n) (#apply{second} (N.Nat^::succ n) x)) (#apply{second} n (#apply{C.differential} n x)))
        (congr!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)}}
          (\fun (y: D.family.Carrier (N.Nat^::succ n)) => #add{(D.family.space (N.Nat^::succ n))} y (#apply{data} n (#apply{C.differential} n x))) _ _
          (sym!{{D.family.Carrier (N.Nat^::succ n)}} _ _ (Degree[n := N.Nat^::succ n].boundaryDifference (#apply{first} (N.Nat^::succ n) x) (#apply{second} (N.Nat^::succ n) x))))));
\definition homotopy: Homotopy u g := \into[Data](data, Homotopy u g) \by {
  Laws[u, g, data] {
    addition := \fun (n: N.Nat^) => #addition{Degree[n := n].map},
    scalar := \fun (n: N.Nat^) => #scalar{Degree[n := n].map},
    zeroEquation := zero, successorEquation := positive,
  }
};
