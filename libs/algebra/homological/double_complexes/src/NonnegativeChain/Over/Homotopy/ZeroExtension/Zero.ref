\definition index: Signed.Int^ := Signed.Int^::ofNat N.Nat^::zero;
\import Modules.Laws[V := Target.Carrier index, space := Target.space index] \as Values;
\definition prior: \forall (x: Source.Carrier index) -> TargetPrior.value index (apply index x) =
  Target.Positive[n := N.Nat^::zero].intro (#apply{D.differential} N.Nat^::zero (#apply{h} N.Nat^::zero x)) :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition shifted: \forall (x: Source.Carrier index) -> Homotopies.shifted data index (#apply{Source.complex.differential} index x) = #zero{(Target.space index)} :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition law: Equation index := \fun (x: Source.Carrier index) => trans!{{Target.Carrier index}} _ _ _
  (congr!{{D.family.Carrier N.Nat^::zero} {Target.Carrier index}} Target.Positive[n := N.Nat^::zero].intro _ _ (#zeroEquation{h} x))
  (trans!{{Target.Carrier index}} _ _ _ (sym!{{Target.Carrier index}} _ _ (Values.zeroRight (Target.Positive[n := N.Nat^::zero].intro (#apply{D.differential} N.Nat^::zero (#apply{h} N.Nat^::zero x)))))
    (congr2!{{Target.Carrier index} {Target.Carrier index} {Target.Carrier index}} (#add{(Target.space index)}) _ _ _ _
      (sym!{{Target.Carrier index}} _ _ (prior x)) (sym!{{Target.Carrier index}} _ _ (shifted x))));
