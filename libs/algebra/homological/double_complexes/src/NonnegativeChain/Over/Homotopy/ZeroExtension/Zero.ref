\use std.Logic[].Equality[].eq_reason_in;
\definition index: Signed.Int^ := Signed.Int^::ofNat N.Nat^::zero;
\import Modules.Laws[V := Target.Carrier index, space := Target.space index] \as Values;
\definition prior: \forall (x: Source.Carrier index) -> TargetPrior.value index (apply index x) =
  Target.Positive[n := N.Nat^::zero].intro ((D.differential).apply N.Nat^::zero ((h).apply N.Nat^::zero x)) :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition shifted: \forall (x: Source.Carrier index) -> Homotopies.shifted data index ((Source.complex.differential).apply index x) = (Target.space index).zero :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition law: Equation index := \fun (x: Source.Carrier index) => eq_reason_in!{{Target.Carrier index} _
  "=" _ "by" { congr!{{D.family.Carrier N.Nat^::zero} {Target.Carrier index}} Target.Positive[n := N.Nat^::zero].intro _ _ ((h).zeroEquation x) }
  "=" _ "by" { sym!{{Target.Carrier index}} _ _ (Values.zeroRight (Target.Positive[n := N.Nat^::zero].intro ((D.differential).apply N.Nat^::zero ((h).apply N.Nat^::zero x)))) }
  "=" _ "by" { congr!{{Target.Carrier index} {Target.Carrier index} {Target.Carrier index}} ((Target.space index).add) _ _ _ _
      (sym!{{Target.Carrier index}} _ _ (prior x)) (sym!{{Target.Carrier index}} _ _ (shifted x)) }
};
