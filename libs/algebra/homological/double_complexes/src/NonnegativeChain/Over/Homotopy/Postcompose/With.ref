\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := D.family.space (N.Nat^::succ n)] \as Shift;
  \definition shift: Shift.Map := Shift.Map { apply := #apply{h} n, addition := #addition{h} n, scalar := #scalar{h} n };
  \import After.At[n := N.Nat^::succ n] \as AfterDegree;
  \import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := E.family.Carrier (N.Nat^::succ n), source := D.family.space (N.Nat^::succ n), target := E.family.space (N.Nat^::succ n)].Composition[U := C.family.Carrier n, domain := C.family.space n] \as Compose;
  \definition map: Modules.Hom[V := C.family.Carrier n, W := E.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := E.family.space (N.Nat^::succ n)].Map := Compose.compose (AfterDegree.linear k) shift;
  \import Modules.Hom[V := D.family.Carrier n, W := E.family.Carrier n, source := D.family.space n, target := E.family.space n] \as Output;
  \import After.At[n := n] \as Current;
  \definition difference(x, y: D.family.Carrier n): #apply{k} n (#add{(D.family.space n)} x (#neg{(D.family.space n)} y)) = #add{(E.family.space n)} (#apply{k} n x) (#neg{(E.family.space n)} (#apply{k} n y)) := Output.differencePreserved (Current.linear k) x y;
}
\definition data: Result.Data := Result.Data { apply := \fun (n: N.Nat^) => #apply{Degree[n := n].map} };
\definition zero(x: C.family.Carrier N.Nat^::zero):
  #add{(E.family.space N.Nat^::zero)} (#apply{k} N.Nat^::zero (#apply{f} N.Nat^::zero x)) (#neg{(E.family.space N.Nat^::zero)} (#apply{k} N.Nat^::zero (#apply{g} N.Nat^::zero x))) = #apply{E.differential} N.Nat^::zero (#apply{k} (N.Nat^::succ N.Nat^::zero) (#apply{h} N.Nat^::zero x)) :=
  trans!{{E.family.Carrier N.Nat^::zero}} _ _ _ (sym!{{E.family.Carrier N.Nat^::zero}} _ _ (Degree[n := N.Nat^::zero].difference (#apply{f} N.Nat^::zero x) (#apply{g} N.Nat^::zero x)))
    (trans!{{E.family.Carrier N.Nat^::zero}} _ _ _
      (congr!{{D.family.Carrier N.Nat^::zero} {E.family.Carrier N.Nat^::zero}} (#apply{k} N.Nat^::zero) _ _ (#zeroEquation{h} x))
      (sym!{{E.family.Carrier N.Nat^::zero}} _ _ (#commutes{k} N.Nat^::zero (#apply{h} N.Nat^::zero x))));
\definition positive(n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)):
  #add{(E.family.space (N.Nat^::succ n))} (#apply{k} (N.Nat^::succ n) (#apply{f} (N.Nat^::succ n) x)) (#neg{(E.family.space (N.Nat^::succ n))} (#apply{k} (N.Nat^::succ n) (#apply{g} (N.Nat^::succ n) x))) =
  #add{(E.family.space (N.Nat^::succ n))} (#apply{E.differential} (N.Nat^::succ n) (#apply{k} (N.Nat^::succ (N.Nat^::succ n)) (#apply{h} (N.Nat^::succ n) x))) (#apply{k} (N.Nat^::succ n) (#apply{h} n (#apply{C.differential} n x))) :=
  trans!{{E.family.Carrier (N.Nat^::succ n)}} _ _ _ (sym!{{E.family.Carrier (N.Nat^::succ n)}} _ _ (Degree[n := N.Nat^::succ n].difference (#apply{f} (N.Nat^::succ n) x) (#apply{g} (N.Nat^::succ n) x)))
    (trans!{{E.family.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{D.family.Carrier (N.Nat^::succ n)} {E.family.Carrier (N.Nat^::succ n)}} (#apply{k} (N.Nat^::succ n)) _ _ (#successorEquation{h} n x))
      (trans!{{E.family.Carrier (N.Nat^::succ n)}} _ _ _
        (#addition{k} (N.Nat^::succ n) (#apply{D.differential} (N.Nat^::succ n) (#apply{h} (N.Nat^::succ n) x)) (#apply{h} n (#apply{C.differential} n x)))
        (congr!{{E.family.Carrier (N.Nat^::succ n)} {E.family.Carrier (N.Nat^::succ n)}} (\fun (y: E.family.Carrier (N.Nat^::succ n)) => #add{(E.family.space (N.Nat^::succ n))} y (#apply{k} (N.Nat^::succ n) (#apply{h} n (#apply{C.differential} n x)))) _ _
          (sym!{{E.family.Carrier (N.Nat^::succ n)}} _ _ (#commutes{k} (N.Nat^::succ n) (#apply{h} (N.Nat^::succ n) x))))));
\definition homotopy: Result.Homotopy (Composition.compose k f) (Composition.compose k g) := \into[Result.Data](data, Result.Homotopy (Composition.compose k f) (Composition.compose k g)) \by {
  Result.Laws[Composition.compose k f, Composition.compose k g, data] {
    addition := \fun (n: N.Nat^) => #addition{Degree[n := n].map},
    scalar := \fun (n: N.Nat^) => #scalar{Degree[n := n].map},
    zeroEquation := zero, successorEquation := positive,
  }
};
