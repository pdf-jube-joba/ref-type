\use std.Logic[].Equality[].eq_reason_in;
\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := D.family.space (N.Nat^::succ n)] \as Shift;
  \definition shift: Shift.Map := Shift.Map { apply := (h).apply n, addition := (h).addition n, scalar := (h).scalar n };
  \import After.At[n := N.Nat^::succ n] \as AfterDegree;
  \import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := E.family.Carrier (N.Nat^::succ n), source := D.family.space (N.Nat^::succ n), target := E.family.space (N.Nat^::succ n)].Composition[U := C.family.Carrier n, domain := C.family.space n] \as Compose;
  \definition map: Modules.Hom[V := C.family.Carrier n, W := E.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := E.family.space (N.Nat^::succ n)].Map := Compose.compose (AfterDegree.linear k) shift;
  \import Modules.Hom[V := D.family.Carrier n, W := E.family.Carrier n, source := D.family.space n, target := E.family.space n] \as Output;
  \import After.At[n := n] \as Current;
  \definition difference[x, y: D.family.Carrier n]: (k).apply n ((D.family.space n).add x ((D.family.space n).neg y)) = (E.family.space n).add ((k).apply n x) ((E.family.space n).neg ((k).apply n y)) := Output.differencePreserved (Current.linear k) x y;
}
\definition data: Result.Data := Result.Data { apply := \fun (n: N.Nat^) => (Degree[n := n].map).apply };
\definition zero[x: C.family.Carrier N.Nat^::zero]:
  (E.family.space N.Nat^::zero).add ((k).apply N.Nat^::zero ((f).apply N.Nat^::zero x)) ((E.family.space N.Nat^::zero).neg ((k).apply N.Nat^::zero ((g).apply N.Nat^::zero x))) = (E.differential).apply N.Nat^::zero ((k).apply (N.Nat^::succ N.Nat^::zero) ((h).apply N.Nat^::zero x)) :=
  eq_reason_in!{{E.family.Carrier N.Nat^::zero} _
    "=" _ "by" { sym!{{E.family.Carrier N.Nat^::zero}} _ _ (Degree[n := N.Nat^::zero].difference ((f).apply N.Nat^::zero x) ((g).apply N.Nat^::zero x)) }
    "=" _ "by" { congr!{{D.family.Carrier N.Nat^::zero} {E.family.Carrier N.Nat^::zero}} ((k).apply N.Nat^::zero) _ _ ((h).zeroEquation x) }
    "=" _ "by" { sym!{{E.family.Carrier N.Nat^::zero}} _ _ ((k).commutes N.Nat^::zero ((h).apply N.Nat^::zero x)) }
  };
\definition positive[n: N.Nat^][x: C.family.Carrier (N.Nat^::succ n)]:
  (E.family.space (N.Nat^::succ n)).add ((k).apply (N.Nat^::succ n) ((f).apply (N.Nat^::succ n) x)) ((E.family.space (N.Nat^::succ n)).neg ((k).apply (N.Nat^::succ n) ((g).apply (N.Nat^::succ n) x))) =
  (E.family.space (N.Nat^::succ n)).add ((E.differential).apply (N.Nat^::succ n) ((k).apply (N.Nat^::succ (N.Nat^::succ n)) ((h).apply (N.Nat^::succ n) x))) ((k).apply (N.Nat^::succ n) ((h).apply n ((C.differential).apply n x))) :=
  eq_reason_in!{{E.family.Carrier (N.Nat^::succ n)} _
    "=" _ "by" { sym!{{E.family.Carrier (N.Nat^::succ n)}} _ _ (Degree[n := N.Nat^::succ n].difference ((f).apply (N.Nat^::succ n) x) ((g).apply (N.Nat^::succ n) x)) }
    "=" _ "by" { congr!{{D.family.Carrier (N.Nat^::succ n)} {E.family.Carrier (N.Nat^::succ n)}} ((k).apply (N.Nat^::succ n)) _ _ ((h).successorEquation n x) }
    "=" _ "by" { (k).addition (N.Nat^::succ n) ((D.differential).apply (N.Nat^::succ n) ((h).apply (N.Nat^::succ n) x)) ((h).apply n ((C.differential).apply n x)) }
    "=" _ "by" { congr!{{E.family.Carrier (N.Nat^::succ n)} {E.family.Carrier (N.Nat^::succ n)}} (\fun (y: E.family.Carrier (N.Nat^::succ n)) => (E.family.space (N.Nat^::succ n)).add y ((k).apply (N.Nat^::succ n) ((h).apply n ((C.differential).apply n x)))) _ _
          (sym!{{E.family.Carrier (N.Nat^::succ n)}} _ _ ((k).commutes (N.Nat^::succ n) ((h).apply (N.Nat^::succ n) x))) }
  };
\definition homotopy: Result.Homotopy (Composition.compose k f) (Composition.compose k g) := \into[Result.Data](data, Result.Homotopy (Composition.compose k f) (Composition.compose k g)) \by {
  Result.Laws[Composition.compose k f, Composition.compose k g, data] {
    addition := \fun (n: N.Nat^) => (Degree[n := n].map).addition,
    scalar := \fun (n: N.Nat^) => (Degree[n := n].map).scalar,
    zeroEquation := zero, successorEquation := positive,
  }
};
