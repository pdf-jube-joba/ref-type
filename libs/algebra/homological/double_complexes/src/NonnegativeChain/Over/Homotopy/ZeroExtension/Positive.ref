\definition index: Signed.Int^ := Signed.Int^::ofNat (N.Nat^::succ n);
\definition prior: \forall (x: Source.Carrier index) -> TargetPrior.value index (apply index x) =
  Target.Positive[n := N.Nat^::succ n].intro (#apply{D.differential} (N.Nat^::succ n) (#apply{h} (N.Nat^::succ n) x)) :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition shifted: \forall (x: Source.Carrier index) -> Homotopies.shifted data index (#apply{Source.complex.differential} index x) =
  Target.Positive[n := N.Nat^::succ n].intro (#apply{h} n (#apply{C.differential} n x)) :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition law: Equation index := \fun (x: Source.Carrier index) => trans!{{Target.Carrier index}} _ _ _
  (congr!{{D.family.Carrier (N.Nat^::succ n)} {Target.Carrier index}} Target.Positive[n := N.Nat^::succ n].intro _ _ (#successorEquation{h} n x))
  (congr2!{{Target.Carrier index} {Target.Carrier index} {Target.Carrier index}} (#add{(Target.space index)}) _ _ _ _
    (sym!{{Target.Carrier index}} _ _ (prior x)) (sym!{{Target.Carrier index}} _ _ (shifted x)));
