\definition index: Signed.Int^ := Signed.Int^::ofNat (N.Nat^::succ n);
\definition prior: \forall (x: Source.Carrier index) -> TargetPrior.value index (apply index x) =
  Target.Positive[n := N.Nat^::succ n].intro ((D.differential).apply (N.Nat^::succ n) ((h).apply (N.Nat^::succ n) x)) :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition shifted: \forall (x: Source.Carrier index) -> Homotopies.shifted data index ((Source.complex.differential).apply index x) =
  Target.Positive[n := N.Nat^::succ n].intro ((h).apply n ((C.differential).apply n x)) :=
  \fun (x: Source.Carrier index) => Transport.castRefl Target.Carrier index _;
\definition law: Equation index := \fun (x: Source.Carrier index) => trans!{{Target.Carrier index}} _ _ _
  (congr!{{D.family.Carrier (N.Nat^::succ n)} {Target.Carrier index}} Target.Positive[n := N.Nat^::succ n].intro _ _ ((h).successorEquation n x))
  (congr2!{{Target.Carrier index} {Target.Carrier index} {Target.Carrier index}} ((Target.space index).add) _ _ _ _
    (sym!{{Target.Carrier index}} _ _ (prior x)) (sym!{{Target.Carrier index}} _ _ (shifted x)));
