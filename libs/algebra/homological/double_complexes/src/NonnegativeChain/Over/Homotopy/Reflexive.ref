\module At(n: N.Nat^);
\definition data: Data := Data { apply := \fun (n: N.Nat^) => (At[n := n].zero).apply };
\module Zero;
\module Positive(n: N.Nat^);
\definition laws[f: Maps.Map]: Laws[f, f, data] := Laws[f, f, data] {
  addition := \fun (n: N.Nat^) => (At[n := n].zero).addition,
  scalar := \fun (n: N.Nat^) => (At[n := n].zero).scalar,
  zeroEquation := Zero[].law f,
  successorEquation := \fun (n: N.Nat^) => Positive[n := n].law f,
};
\definition homotopy[f: Maps.Map]: Homotopy f f := \into[Data](data, Homotopy f f) \by { laws f };
