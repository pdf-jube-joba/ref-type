\import \parent.\parent.Positive[C := C, n := n] \as Source;
\import \parent.\parent.Positive[C := D, n := n] \as Target;
\import Maps.Positive[n := n] \as Induced;
\import Modules.Laws[V := D.family.Carrier (N.Nat^::succ n), space := D.family.space (N.Nat^::succ n)] \as TargetLaws;
\import algebra.Group[].Of[Carrier := D.family.Carrier (N.Nat^::succ n), group := TargetLaws.additive] \as Group;
\import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier (N.Nat^::succ n), source := C.family.space n, target := D.family.space (N.Nat^::succ n)] \as ShiftMaps;
\definition linear(f, g: Maps.Map)(h: Homotopy f g): ShiftMaps.Map := ShiftMaps.Map {
  apply := #apply{h} n, addition := #addition{h} n, scalar := #scalar{h} n,
};
\definition onCycle: \forall (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) ->
  Group.difference (#apply{f} (N.Nat^::succ n) x) (#apply{g} (N.Nat^::succ n) x) =
    #apply{Target.prior} (#apply{h} (N.Nat^::succ n) x) :=
  \fun (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) => trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _ (#successorEquation{h} n x)
    (trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier (N.Nat^::succ n)}}
        (Group.add (#apply{Target.prior} (#apply{h} (N.Nat^::succ n) x))) _ _
        (trans!{{D.family.Carrier (N.Nat^::succ n)}} _ _ _
          (congr!{{C.family.Carrier n} {D.family.Carrier (N.Nat^::succ n)}} (#apply{h} n) _ _
            (\bysub(C.family.Carrier (N.Nat^::succ n), #carrier{Source.cycles}, x))) (ShiftMaps.zeroPreserved (linear f g h))))
      (Group.zeroRight (#apply{Target.prior} (#apply{h} (N.Nat^::succ n) x))));
\import Modules.Of[V := D.family.Carrier (N.Nat^::succ n), space := D.family.space (N.Nat^::succ n)].Submodule[] \as Submodules;
\import Submodules.Image[U := D.family.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := D.family.space (N.Nat^::succ (N.Nat^::succ n))] \as Images;
\definition differenceBoundary: \forall (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) ->
  Submodules.Member Target.boundaries (Group.difference (#apply{f} (N.Nat^::succ n) x) (#apply{g} (N.Nat^::succ n) x)) :=
  \fun (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) => Images.introduce Target.prior
    (Group.difference (#apply{f} (N.Nat^::succ n) x) (#apply{g} (N.Nat^::succ n) x)) (#apply{h} (N.Nat^::succ n) x)
    (sym!{{D.family.Carrier (N.Nat^::succ n)}} _ _ (onCycle f g h x));
\definition onHomology: \forall (f, g: Maps.Map)(h: Homotopy f g)(q: Source.Homology) ->
  #apply{(Induced.induced f)} q = #apply{(Induced.induced g)} q :=
  \fun (f, g: Maps.Map)(h: Homotopy f g) => Source.classInduction
    (\fun (q: Source.Homology) => #apply{(Induced.induced f)} q = #apply{(Induced.induced g)} q)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Induced.onClass f x)
      (trans!{Target.Homology} _ _ _
        (Target.classEqual (#apply{(Induced.cyclesMap f)} x) (#apply{(Induced.cyclesMap g)} x) (differenceBoundary f g h x))
        (sym!{Target.Homology} _ _ (Induced.onClass g x))));
