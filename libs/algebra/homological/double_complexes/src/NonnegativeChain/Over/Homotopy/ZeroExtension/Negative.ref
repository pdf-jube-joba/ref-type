\definition index: Signed.Int^ := Signed.Int^::negSucc n;
\import Modules.Laws[V := Target.Carrier (Degrees.next index), space := Target.space (Degrees.next index)] \as Values;
\definition addition: \forall (x, y: Source.Carrier index) ->
  apply index (#add{(Source.space index)} x y) = #add{(Target.space (Degrees.next index))} (apply index x) (apply index y) :=
  \fun (x, y: Source.Carrier index) => sym!{{Target.Carrier (Degrees.next index)}} _ _ (Values.zeroLeft #zero{(Target.space (Degrees.next index))});
\definition scalar: \forall (a: R)(x: Source.Carrier index) ->
  apply index (#smul{(Source.space index)} a x) = #smul{(Target.space (Degrees.next index))} a (apply index x) :=
  \fun (a: R)(x: Source.Carrier index) => sym!{{Target.Carrier (Degrees.next index)}} _ _ (Values.scaleZero a);
\definition law: Equation index := \fun (x: Source.Carrier index) => trans!{{Target.Carrier index}} _ _ _
  (Target.Negative[n := n].zero _) (sym!{{Target.Carrier index}} _ _ (Target.Negative[n := n].zero _));
