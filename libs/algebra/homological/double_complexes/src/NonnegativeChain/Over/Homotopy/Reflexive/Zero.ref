\import \parent.At[n := N.Nat^::zero] \as Degree;
\import Modules.Laws[V := D.family.Carrier N.Nat^::zero, space := D.family.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := D.family.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\definition law: \forall (f: Maps.Map)(x: C.family.Carrier N.Nat^::zero) -> Group.difference (#apply{f} N.Nat^::zero x) (#apply{f} N.Nat^::zero x) = #apply{D.differential} N.Nat^::zero #zero{(D.family.space (N.Nat^::succ N.Nat^::zero))} :=
  \fun (f: Maps.Map)(x: C.family.Carrier N.Nat^::zero) => trans!{{D.family.Carrier N.Nat^::zero}} _ _ _ (Group.inverseRight (#apply{f} N.Nat^::zero x)) (sym!{{D.family.Carrier N.Nat^::zero}} _ _ Degree.boundaryZero);
