\import \parent.\parent.DegreeZero[C := C] \as Source;
\import \parent.\parent.DegreeZero[C := D] \as Target;
\import Maps.DegreeZero[] \as Induced;
\import Modules.Of[V := D.family.Carrier N.Nat^::zero, space := D.family.space N.Nat^::zero].Submodule[] \as Submodules;
\import Submodules.Image[U := D.family.Carrier (N.Nat^::succ N.Nat^::zero), source := D.family.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\import Submodules.Quotient[S := Target.boundaries] \as Quotient;
\definition onHomology: \forall (f, g: Maps.Map)(h: Homotopy f g)(q: Source.Homology) ->
  (Induced.induced f).apply q = (Induced.induced g).apply q :=
  \fun (f, g: Maps.Map)(h: Homotopy f g) => Source.classInduction
    (\fun (q: Source.Homology) => (Induced.induced f).apply q = (Induced.induced g).apply q)
    (\fun (x: C.family.Carrier N.Nat^::zero) => trans!{Target.Homology} _ _ _ (Induced.onClass f x)
      (trans!{Target.Homology} _ _ _
        (Quotient.classRelated (f.apply N.Nat^::zero x) (g.apply N.Nat^::zero x)
          (Images.introduce Target.prior ((D.family.space N.Nat^::zero).add (f.apply N.Nat^::zero x) ((D.family.space N.Nat^::zero).neg (g.apply N.Nat^::zero x)))
            (h.apply N.Nat^::zero x) (sym!{{D.family.Carrier N.Nat^::zero}} _ _ (h.zeroEquation x))))
        (sym!{Target.Homology} _ _ (Induced.onClass g x))));
