\definition index: Signed.Int^ := Signed.Int^::ofNat n;
\import Maps.At[n := n] \as RawMap;
\definition rawMap: Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier n, source := C.family.space n, target := D.family.space n].Map := RawMap.linear pair.inclusion;
\import Modules.Of[V := D.family.Carrier n, space := D.family.space n].Submodule[] \as RawSub;
\import RawSub.Image[U := C.family.Carrier n, source := C.family.space n] \as Images;
\definition image: RawSub.Submodule := Images.image rawMap;
\import RawSub.Quotient[S := image] \as Raw;
\definition Carrier: \Set := Raw.Carrier;
\definition space: Modules.Space Carrier := Raw.moduleSpace;
\definition class: D.family.Carrier n -> Carrier := Raw.class;
\import SubspaceExtension.Positive[n := n] \as SourceIndex;
\import WholeExtension.Positive[n := n] \as TargetIndex;
\import Inclusions.At[k := index] \as ExtendedMap;
\import Modules.KernelTransport[V := C.family.Carrier n, W := D.family.Carrier n,
  X := SubspaceExtension.Carrier index, Y := WholeExtension.Carrier index,
  vSpace := C.family.space n, wSpace := D.family.space n,
  xSpace := SubspaceExtension.space index, ySpace := WholeExtension.space index,
  f := rawMap, g := ExtendedMap.linear inclusion, domainIso := SourceIndex.isomorphism, codomainIso := TargetIndex.isomorphism] \as Comparison;
\definition commutes: Comparison.Commutes := \fun (x: C.family.Carrier n) => \refl(TargetIndex.intro (#apply{rawMap} x));
\import Comparison.Cokernel[] \as Cokernels;
\definition isomorphism: Modules.Isomorphism[V := Carrier, W := Quotient.Carrier index, source := space, target := Quotient.space index].Isomorphism := Cokernels.isomorphism commutes;
\definition onClass: \forall (x: D.family.Carrier n) -> #apply{#forward{isomorphism}} (class x) = Quotient.At[k := index].class (TargetIndex.intro x) := Cokernels.onClass commutes;
\definition backOnClass: \forall (x: WholeExtension.Carrier index) -> #apply{#backward{isomorphism}} (Quotient.At[k := index].class x) = class x := Cokernels.backOnClass commutes;
