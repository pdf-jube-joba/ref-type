\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\structure Family {
  Carrier: N.Nat^ -> \Set,
  space: \forall (n: N.Nat^) -> Modules.Space (Carrier n),
}
\structure DifferentialData[F: Family]: \Set {
  apply: \forall (n: N.Nat^) -> F.Carrier (N.Nat^::succ n) -> F.Carrier n,
}
\structure DifferentialLaws[F: Family, d: DifferentialData[F]]: \Prop {
  addition: \forall (n: N.Nat^)(x, y: F.Carrier (N.Nat^::succ n)) ->
    d.apply n ((F.space (N.Nat^::succ n)).add x y) = (F.space n).add (d.apply n x) (d.apply n y),
  scalar: \forall (n: N.Nat^)(a: R)(x: F.Carrier (N.Nat^::succ n)) ->
    d.apply n ((F.space (N.Nat^::succ n)).smul a x) = (F.space n).smul a (d.apply n x),
  squareZero: \forall (n: N.Nat^)(x: F.Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
    d.apply n (d.apply (N.Nat^::succ n) x) = (F.space n).zero,
}
\structure Complex {
  family: Family,
  differential: DifferentialData[family],
  laws: DifferentialLaws[family, differential],
}
\module ZeroExtension(C: Complex);
\module CanonicalResolution(M: Modules.Bundle);
\module ProjectiveResolution(M: Modules.Bundle);
\module Map(C, D: Complex);
\module Homotopy(C, D: Complex);
\module End(C: Complex) {
  \import \parent.Map[C := C, D := C] \as Maps;
  \definition identity: Maps.Map := Maps.Map {
    apply := \fun (n: N.Nat^)(x: C.family.Carrier n) => x,
    addition := \fun (n: N.Nat^)(x, y: C.family.Carrier n) => \refl((C.family.space n).add x y),
    scalar := \fun (n: N.Nat^)(a: R)(x: C.family.Carrier n) => \refl((C.family.space n).smul a x),
    commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => \refl(C.differential.apply n x),
  };

  \module Positive(n: N.Nat^) {
    \import \parent.\parent.Positive[C := C, n := n] \as Homology;
    \import Maps.Positive[n := n] \as Map;
    \definition identityOnHomology: \forall (q: Homology.Homology) -> (Map.induced identity).apply q = q :=
      Homology.classInduction (\fun (q: Homology.Homology) => (Map.induced identity).apply q = q)
        (\fun (x: Homology.Cycle) => Map.onClass identity x);
  }
  \module DegreeZero {
    \import \parent.\parent.DegreeZero[C := C] \as Homology;
    \import Maps.DegreeZero[] \as Map;
    \definition identityOnHomology: \forall (q: Homology.Homology) -> (Map.induced identity).apply q = q :=
      Homology.classInduction (\fun (q: Homology.Homology) => (Map.induced identity).apply q = q)
        (\fun (x: C.family.Carrier N.Nat^::zero) => Map.onClass identity x);
  }

}

\module Positive(C: Complex, n: N.Nat^);
\module DegreeZero(C: Complex);

\module Equivalence(C, D: Complex);

\module Homology(C: Complex);
\module IntegerComparison(C: Complex);
\module ShortExact(A, B, C: Complex);

\module Isomorphism(C, D: Complex);
