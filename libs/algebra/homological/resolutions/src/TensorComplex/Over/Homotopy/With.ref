\module At(n: Nat.Nat^);
\module Zero;
\module Positive(n: Nat.Nat^);
\definition data: Homotopies.Data := Homotopies.Data { apply := \fun (n: Nat.Nat^) => (At[n := n].map).apply };
\definition laws: Homotopies.Laws[Actions.On[f := f, u := Coefficients.identity].map, Actions.On[f := g, u := Coefficients.identity].map, data] :=
  Homotopies.Laws[Actions.On[f := f, u := Coefficients.identity].map, Actions.On[f := g, u := Coefficients.identity].map, data] {
    addition := \fun (n: Nat.Nat^) => (At[n := n].map).addition, scalar := \fun (n: Nat.Nat^) => (At[n := n].map).scalar,
    zeroEquation := Zero[].pointwise,
    successorEquation := \fun (n: Nat.Nat^) => Positive[n := n].pointwise,
  };
\definition homotopy: Homotopies.Homotopy (Actions.On[f := f, u := Coefficients.identity].map) (Actions.On[f := g, u := Coefficients.identity].map) :=
  \into[Homotopies.Data](data, { data: Homotopies.Data \where Homotopies.Laws[Actions.On[f := f, u := Coefficients.identity].map, Actions.On[f := g, u := Coefficients.identity].map, data] }) \by { laws };
