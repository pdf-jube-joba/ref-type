\module At(n: Nat.Nat^);
\module Differential(n: Nat.Nat^) {
  \import Modules.Tensor[V := P.family.Carrier (Nat.Nat^::succ n), W := N.Carrier, left := P.family.space (Nat.Nat^::succ n), right := N.space] \as Generators;
  \import Modules.Tensor[V := Q.family.Carrier n, W := L.Carrier, left := Q.family.space n, right := L.space] \as Result;
  \import Generators.Universal[U := Result.Carrier, target := Result.space] \as Equality;
  \import Modules.Hom[V := Target.Carrier (Nat.Nat^::succ n), W := Target.Carrier n, source := Target.space (Nat.Nat^::succ n), target := Target.space n].Composition[U := Source.Carrier (Nat.Nat^::succ n), domain := Source.space (Nat.Nat^::succ n)] \as Left;
  \import Modules.Hom[V := Source.Carrier n, W := Target.Carrier n, source := Source.space n, target := Target.space n].Composition[U := Source.Carrier (Nat.Nat^::succ n), domain := Source.space (Nat.Nat^::succ n)] \as Right;
  \definition mapsCommute: Left.compose (Target.At[n := n].differential) (\parent.At[n := Nat.Nat^::succ n].map) =
    Right.compose (\parent.At[n := n].map) (Source.At[n := n].differential) :=
    Equality.ext (Left.compose (Target.At[n := n].differential) (\parent.At[n := Nat.Nat^::succ n].map))
      (Right.compose (\parent.At[n := n].map) (Source.At[n := n].differential))
      (\fun (x: P.family.Carrier (Nat.Nat^::succ n))(y: N.Carrier) => trans!{Result.Carrier} _ _ _
        (congr!{{Target.Carrier (Nat.Nat^::succ n)} Result.Carrier} ((Target.At[n := n].differential).apply) _ _ (\parent.At[n := Nat.Nat^::succ n].onTensor x y))
        (trans!{Result.Carrier} _ _ _ (Target.At[n := n].onTensor (f.apply (Nat.Nat^::succ n) x) (u.apply y))
          (trans!{Result.Carrier} _ _ _
            (congr!{{Q.family.Carrier n} Result.Carrier} (\fun (z: Q.family.Carrier n) => Result.tensor z (u.apply y)) _ _ (f.commutes n x))
            (sym!{Result.Carrier} _ _ (trans!{Result.Carrier} _ _ _
              (congr!{{Source.Carrier n} Result.Carrier} ((\parent.At[n := n].map).apply) _ _ (Source.At[n := n].onTensor x y))
              (\parent.At[n := n].onTensor (P.differential.apply n x) y))))));
  \import Modules.Hom[V := Source.Carrier (Nat.Nat^::succ n), W := Target.Carrier n, source := Source.space (Nat.Nat^::succ n), target := Target.space n] \as Linear;
  \definition commutes: \forall (x: Source.Carrier (Nat.Nat^::succ n)) ->
    Target.differential.apply n ((\parent.At[n := Nat.Nat^::succ n].map).apply x) = (\parent.At[n := n].map).apply (Source.differential.apply n x) :=
    \fun (x: Source.Carrier (Nat.Nat^::succ n)) => congr!{Linear.Map {Target.Carrier n}} (\fun (h: Linear.Map) => h.apply x) _ _ mapsCommute;
}
\definition map: Maps.Map := Maps.Map {
  apply := \fun (n: Nat.Nat^) => (At[n := n].map).apply,
  addition := \fun (n: Nat.Nat^) => (At[n := n].map).addition,
  scalar := \fun (n: Nat.Nat^) => (At[n := n].map).scalar,
  commutes := \fun (n: Nat.Nat^) => Differential[n := n].commutes,
};
