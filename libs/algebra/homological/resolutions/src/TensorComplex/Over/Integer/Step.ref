\import Modules.Tensor[V := P.family.Carrier z, W := N.Carrier, left := P.family.space z, right := N.space] \as Current;
\import Modules.Tensor[V := P.family.Carrier (previous z), W := N.Carrier, left := P.family.space (previous z), right := N.space] \as Lower;
\import Modules.Tensor[V := P.family.Carrier (previous (previous z)), W := N.Carrier, left := P.family.space (previous (previous z)), right := N.space] \as Twice;
\import Modules.Hom[V := P.family.Carrier z, W := P.family.Carrier (previous z), source := P.family.space z, target := P.family.space (previous z)] \as Original;
\definition original: Original.Map := Original.Map { apply := #apply{P.differential} z, addition := #addition{P.laws} z, scalar := #scalar{P.laws} z };
\import Current.Mapping[U := P.family.Carrier (previous z), Z := N.Carrier, targetLeft := P.family.space (previous z), targetRight := N.space] \as Mapping;
\import Modules.Hom[V := Current.Carrier, W := Lower.Carrier, source := Current.space, target := Lower.space] \as Maps;
\definition differential: Maps.Map := Mapping.map original Coefficient.identity;
\definition onTensor: \forall (x: P.family.Carrier z)(y: N.Carrier) -> #apply{differential} (Current.tensor x y) = Lower.tensor (#apply{P.differential} z x) y := Mapping.onTensor original Coefficient.identity;
\import Modules.Hom[V := P.family.Carrier (previous z), W := P.family.Carrier (previous (previous z)), source := P.family.space (previous z), target := P.family.space (previous (previous z))] \as BeforeOriginal;
\definition beforeOriginal: BeforeOriginal.Map := BeforeOriginal.Map { apply := #apply{P.differential} (previous z), addition := #addition{P.laws} (previous z), scalar := #scalar{P.laws} (previous z) };
\import Lower.Mapping[U := P.family.Carrier (previous (previous z)), Z := N.Carrier, targetLeft := P.family.space (previous (previous z)), targetRight := N.space] \as BeforeMapping;
\import Modules.Hom[V := Lower.Carrier, W := Twice.Carrier, source := Lower.space, target := Twice.space] \as BeforeMaps;
\definition beforeDifferential: BeforeMaps.Map := BeforeMapping.map beforeOriginal Coefficient.identity;
\import BeforeMaps.Composition[U := Current.Carrier, domain := Current.space] \as Composition;
\import Current.Universal[U := Twice.Carrier, target := Twice.space] \as Universal;
\import Modules.Hom[V := Current.Carrier, W := Twice.Carrier, source := Current.space, target := Twice.space] \as SquareMaps;
\definition squareMapZero: Composition.compose beforeDifferential differential = SquareMaps.zeroMap :=
  Universal.ext (Composition.compose beforeDifferential differential) SquareMaps.zeroMap
    (\fun (x: P.family.Carrier z)(y: N.Carrier) => trans!{Twice.Carrier} _ _ _
      (congr!{Lower.Carrier Twice.Carrier} (#apply{beforeDifferential}) _ _ (onTensor x y))
      (trans!{Twice.Carrier} _ _ _ (BeforeMapping.onTensor beforeOriginal Coefficient.identity (#apply{P.differential} z x) y)
        (trans!{Twice.Carrier} _ _ _
          (congr!{{P.family.Carrier (previous (previous z))} Twice.Carrier} (\fun (v: P.family.Carrier (previous (previous z))) => Twice.tensor v y) _ _ (#squareZero{P.laws} z x))
          (Twice.tensorZeroLeft y))));
\definition squareZero: \forall (x: Current.Carrier) -> #apply{beforeDifferential} (#apply{differential} x) = #zero{Twice.space} :=
  \fun (x: Current.Carrier) => congr!{SquareMaps.Map Twice.Carrier} (\fun (f: SquareMaps.Map) => #apply{f} x) _ _ squareMapZero;
