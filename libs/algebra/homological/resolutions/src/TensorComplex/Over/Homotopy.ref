\import \parent.On[P := P, N := N] \as Source;
\import \parent.On[P := Q, N := N] \as Target;
\import Chains.Map[C := P, D := Q] \as ChainMaps;
\import Chains.Homotopy[C := P, D := Q] \as ChainHomotopies;
\import \parent.Mapping[P := P, Q := Q, N := N, L := N] \as Actions;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import Chains.Homotopy[C := Source.complex, D := Target.complex] \as Homotopies;
\module With(f, g: ChainMaps.Map, h: ChainHomotopies.Homotopy f g);
\definition existence: \forall (f, g: ChainMaps.Map)(h: ChainHomotopies.Homotopy f g) ->
  \exists Homotopies.Homotopy (Actions.On[f := f, u := Coefficients.identity].map) (Actions.On[f := g, u := Coefficients.identity].map) :=
  \fun (f, g: ChainMaps.Map)(h: ChainHomotopies.Homotopy f g) =>
    \exact(With[f := f, g := g, h := h].homotopy,
      Homotopies.Homotopy (Actions.On[f := f, u := Coefficients.identity].map) (Actions.On[f := g, u := Coefficients.identity].map));
