\import \parent.Of[M := M, P := P] \as Source;
\import \parent.Of[M := N, P := Q] \as Target;
\import Chains.Map[C := P, D := Q] \as Maps;
\import Chains.Homotopy[C := P, D := Q] \as Homotopies;
\definition agreement(p: Source.Resolution)(q: Target.Resolution)(f, g: Maps.Map): \Prop :=
  \forall (x: P.family.Carrier Nat.Nat^::zero) ->
    q.augmentation.apply (f.apply Nat.Nat^::zero x) = q.augmentation.apply (g.apply Nat.Nat^::zero x);
\module With(p: Source.Resolution, q: Target.Resolution, f, g: Maps.Map);
\definition existence: \forall (p: Source.Resolution)(q: Target.Resolution)(f, g: Maps.Map) -> agreement p q f g ->
  \exists Homotopies.Homotopy f g :=
  \fun (p: Source.Resolution)(q: Target.Resolution)(f, g: Maps.Map) => With[p := p, q := q, f := f, g := g].existence;
