\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), W := P.family.Carrier (Nat.Nat^::succ n),
  source := P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n)), target := P.family.space (Nat.Nat^::succ n)] \as Maps;
\definition original: Maps.Map := Maps.Map {
  apply := P.differential.apply (Nat.Nat^::succ n), addition := P.laws.addition (Nat.Nat^::succ n), scalar := P.laws.scalar (Nat.Nat^::succ n),
};
\definition negative: Maps.Map := Maps.negative original;
\definition addition: \forall (x, y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) ->
  negative.apply ((P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n))).add x y) =
  (P.family.space (Nat.Nat^::succ n)).add (negative.apply x) (negative.apply y) := negative.addition;
\definition scalar: \forall (a: R)(x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) ->
  negative.apply ((P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n))).smul a x) =
  (P.family.space (Nat.Nat^::succ n)).smul a (negative.apply x) := negative.scalar;
\import Modules.Laws[V := P.family.Carrier (Nat.Nat^::succ n), space := P.family.space (Nat.Nat^::succ n)] \as Laws;
\import algebra.Group[].Of[Carrier := P.family.Carrier (Nat.Nat^::succ n), group := Laws.additive] \as Group;
\definition squareZero: \forall (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n)))) ->
  negative.apply ((P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n))).neg (P.differential.apply (Nat.Nat^::succ (Nat.Nat^::succ n)) x)) = (P.family.space (Nat.Nat^::succ n)).zero :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n)))) => eq_reason_in!{{P.family.Carrier (Nat.Nat^::succ n)} _
    "=" _ "by" { congr!{{P.family.Carrier (Nat.Nat^::succ n)} {P.family.Carrier (Nat.Nat^::succ n)}} ((P.family.space (Nat.Nat^::succ n)).neg) _ _
      (Maps.negativePreserved original (P.differential.apply (Nat.Nat^::succ (Nat.Nat^::succ n)) x)) }
    "=" _ "by" { Group.negNeg (P.differential.apply (Nat.Nat^::succ n) (P.differential.apply (Nat.Nat^::succ (Nat.Nat^::succ n)) x)) }
    "=" _ "by" { P.laws.squareZero (Nat.Nat^::succ n) x }
  };
\definition liftNegative: \forall (y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) ->
  negative.apply ((P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n))).neg y) = original.apply y :=
  \fun (y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => trans!{{P.family.Carrier (Nat.Nat^::succ n)}} _ _ _
    (congr!{{P.family.Carrier (Nat.Nat^::succ n)} {P.family.Carrier (Nat.Nat^::succ n)}} ((P.family.space (Nat.Nat^::succ n)).neg) _ _ (Maps.negativePreserved original y))
    (Group.negNeg (original.apply y));
\definition originalClosed: \forall (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> negative.apply x = (P.family.space (Nat.Nat^::succ n)).zero ->
  original.apply x = (P.family.space (Nat.Nat^::succ n)).zero :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)))(closed: _) =>
    eq_reason_in!{{P.family.Carrier (Nat.Nat^::succ n)} _
      "=" _ "by" { sym!{{P.family.Carrier (Nat.Nat^::succ n)}} _ _ (Group.negNeg (original.apply x)) }
      "=" _ "by" { congr!{{P.family.Carrier (Nat.Nat^::succ n)} {P.family.Carrier (Nat.Nat^::succ n)}} ((P.family.space (Nat.Nat^::succ n)).neg) _ _ closed }
      "=" _ "by" Group.negZero
    };
