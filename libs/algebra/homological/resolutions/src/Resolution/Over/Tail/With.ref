\use std.Logic[].Equality[].eq_reason_in;
\import Original.Syzygy[n := Nat.Nat^::zero, resolution := resolution] \as Syzygy;
\definition bundle: Modules.Bundle := Syzygy.bundle;
\import \parent.\parent.Of[M := bundle, P := complex] \as Resolutions;
\definition augmentation: Resolutions.Data := Resolutions.Data { augmentation := Syzygy.projection };
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero), W := P.family.Carrier Nat.Nat^::zero,
  source := P.family.space (Nat.Nat^::succ Nat.Nat^::zero), target := P.family.space Nat.Nat^::zero] \as AugmentationMaps;
\definition originalDifferential: AugmentationMaps.Map := AugmentationMaps.Map {
  apply := P.differential.apply Nat.Nat^::zero, addition := P.laws.addition Nat.Nat^::zero, scalar := P.laws.scalar Nat.Nat^::zero,
};
\import Modules.Laws[V := P.family.Carrier Nat.Nat^::zero, space := P.family.space Nat.Nat^::zero] \as ZeroLaws;
\import algebra.Group[].Of[Carrier := P.family.Carrier Nat.Nat^::zero, group := ZeroLaws.additive] \as ZeroGroup;
\definition killed: \forall (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))) ->
  Syzygy.projection.apply (differential.apply Nat.Nat^::zero x) = Syzygy.space.zero :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))) =>
    eq_reason_in!{{P.family.Carrier Nat.Nat^::zero} _
      "=" _ "by" { AugmentationMaps.negativePreserved originalDifferential (P.differential.apply (Nat.Nat^::succ Nat.Nat^::zero) x) }
      "=" _ "by" { congr!{{P.family.Carrier Nat.Nat^::zero} {P.family.Carrier Nat.Nat^::zero}} ((P.family.space Nat.Nat^::zero).neg) _ _ (P.laws.squareZero Nat.Nat^::zero x) }
      "=" _ "by" ZeroGroup.negZero
    };
\definition augmentationExact: \forall (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) -> Syzygy.projection.apply x = Syzygy.space.zero ->
  \exists ( y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where differential.apply Nat.Nat^::zero y = x ) := \block {
  \fun (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero))(closed: _) \then
  \takefrom y: \Cast[P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))]
    ({ y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where P.differential.apply (Nat.Nat^::succ Nat.Nat^::zero) y = x }) \by resolution.exact Nat.Nat^::zero x closed \then
  \return Logic.existsIntro[P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)), { y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where differential.apply Nat.Nat^::zero y = x }] ((P.family.space (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))).neg y)
    (trans!{{P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)}} _ _ _ (\parent.At[n := Nat.Nat^::zero].liftNegative y)
        (\bysub(P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)), { y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where P.differential.apply (Nat.Nat^::succ Nat.Nat^::zero) y = x }, y)))
};
\definition exact: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ n)) -> differential.apply n x = (family.space n).zero ->
  \exists ( y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where differential.apply (Nat.Nat^::succ n) y = x ) := \block {
  \fun (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ n))(closed: _) \then
  \takefrom y: \Cast[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))]
    ({ y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where P.differential.apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x })
      \by resolution.exact (Nat.Nat^::succ n) x (\parent.At[n := n].originalClosed x closed) \then
  \return Logic.existsIntro[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where differential.apply (Nat.Nat^::succ n) y = x }] ((family.space (Nat.Nat^::succ (Nat.Nat^::succ n))).neg y)
    (trans!{{family.Carrier (Nat.Nat^::succ n)}} _ _ _ (\parent.At[n := Nat.Nat^::succ n].liftNegative y)
        (\bysub(family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where P.differential.apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x }, y)))
};
\definition data: Resolutions.Data := augmentation;
\definition laws: Resolutions.Laws[data] := Resolutions.Laws[data] {
  projective := \fun (n: Nat.Nat^) => resolution.projective (Nat.Nat^::succ n),
  onto := Syzygy.onto, killed := killed, augmentationExact := augmentationExact, exact := exact,
};
\definition tailResolution: Resolutions.Resolution := \into[Resolutions.Data](data, { data: Resolutions.Data \where Resolutions.Laws[data] }) \by { laws };
