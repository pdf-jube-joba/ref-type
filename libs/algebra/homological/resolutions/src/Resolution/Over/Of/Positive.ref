\import Chains.Positive[C := P, n := n] \as Homology;
\import Modules.Of[V := P.family.Carrier (Nat.Nat^::succ n), space := P.family.space (Nat.Nat^::succ n)].Submodule[] \as Submodules;
\import Submodules.Image[U := P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), source := P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n))] \as Images;
\definition vanishes: \forall (resolution: Resolution)(q: Homology.Homology) -> q = Homology.homologySpace.zero := \block {
  \fun (resolution: Resolution) \then
  \return Homology.classInduction (\fun (q: Homology.Homology) => q = Homology.homologySpace.zero) (\block {
    \fun (x: Homology.Cycle) \then
    \takefrom y: \Cast[P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))] ({ y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where P.differential.apply (Nat.Nat^::succ n) y = x })
      \by resolution.exact n x (\bysub(P.family.Carrier (Nat.Nat^::succ n), Homology.cycles.carrier, x)) \then
    \return Homology.boundaryClassZero x (Images.introduce Homology.prior x y
      (\bysub(P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), { y: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where P.differential.apply (Nat.Nat^::succ n) y = x }, y)))
  })
};
