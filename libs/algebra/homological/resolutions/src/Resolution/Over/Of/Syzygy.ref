\import Modules.Of[V := P.family.Carrier n, space := P.family.space n].Submodule[] \as Submodules;
\import Submodules.Of[S := kernel resolution n] \as Cycles;
\definition Carrier: \Set := Cycles.Carrier;
\definition space: Modules.Space Carrier := Cycles.moduleSpace;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := Carrier, source := P.family.space (Nat.Nat^::succ n), target := space] \as Maps;
\definition projection: Maps.Map := Maps.Map {
  apply := \fun (x: P.family.Carrier (Nat.Nat^::succ n)) => \into[P.family.Carrier n](P.differential.apply n x, (kernel resolution n).carrier) \by { kernelKilled resolution n x },
  addition := P.laws.addition n, scalar := P.laws.scalar n,
};
\definition onto: Modules.Surjective (term (Nat.Nat^::succ n)) bundle projection := \block {
  \fun (x: Carrier) \then
  \takefrom y: \Cast[P.family.Carrier (Nat.Nat^::succ n)] ({ y: P.family.Carrier (Nat.Nat^::succ n) \where P.differential.apply n y = x })
    \by kernelExact resolution n x (\bysub(P.family.Carrier n, (kernel resolution n).carrier, x)) \then
  \return Logic.existsIntro[P.family.Carrier (Nat.Nat^::succ n), { y: P.family.Carrier (Nat.Nat^::succ n) \where projection.apply y = x }] y
    (\bysub(P.family.Carrier (Nat.Nat^::succ n), { y: P.family.Carrier (Nat.Nat^::succ n) \where P.differential.apply n y = x }, y))
};
\module ShortExact {
  \import Modules.Of[V := P.family.Carrier (Nat.Nat^::succ n), space := P.family.space (Nat.Nat^::succ n)].Submodule[] \as UpperSubmodules;
  \import UpperSubmodules.Of[S := kernel resolution (Nat.Nat^::succ n)] \as Upper;
  \definition left: Modules.Bundle := Modules.Bundle { Carrier := Upper.Carrier, space := Upper.moduleSpace };
  \definition middle: Modules.Bundle := term (Nat.Nat^::succ n);
  \import Modules.ShortExact[A := left, B := middle, C := bundle] \as Sequences;
  \definition ambient(x: Carrier): P.family.Carrier n := x;
  \definition zero: \forall (x: Upper.Carrier) -> projection.apply (Upper.inclusion.apply x) = space.zero :=
    \fun (x: Upper.Carrier) => \bysub(P.family.Carrier (Nat.Nat^::succ n),
      (kernel resolution (Nat.Nat^::succ n)).carrier, x);
  \definition kernelImage: \forall (x: P.family.Carrier (Nat.Nat^::succ n)) -> projection.apply x = space.zero ->
    \exists { y: Upper.Carrier \where Upper.inclusion.apply y = x } :=
    \fun (x: P.family.Carrier (Nat.Nat^::succ n))(closed: projection.apply x = space.zero) =>
      Logic.existsIntro[Upper.Carrier, { y: Upper.Carrier \where Upper.inclusion.apply y = x }] (\into[P.family.Carrier (Nat.Nat^::succ n)](x, (kernel resolution (Nat.Nat^::succ n)).carrier) \by {
          congr!{Carrier {P.family.Carrier n}} ambient (projection.apply x) space.zero closed
        })
      (\refl(x));
  \definition sequence: Sequences.Sequence := Sequences.Sequence {
    inclusion := Upper.inclusion, projection := projection,
    injective := \fun (x, y: Upper.Carrier)(equal: _) => equal,
    onto := onto, zero := zero, kernelImage := kernelImage,
  };
}
