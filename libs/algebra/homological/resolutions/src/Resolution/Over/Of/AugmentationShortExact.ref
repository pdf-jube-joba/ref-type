\import \parent.Syzygy[n := Nat.Nat^::zero, resolution := resolution] \as Kernel;
\import Modules.Of[V := P.family.Carrier Nat.Nat^::zero, space := P.family.space Nat.Nat^::zero].Submodule[].Of[
  S := augmentationKernel resolution] \as Inclusion;
\import Modules.ShortExact[A := Kernel.bundle, B := term Nat.Nat^::zero, C := M] \as Sequences;
\definition kernelImage: \forall (x: P.family.Carrier Nat.Nat^::zero) ->
  resolution.augmentation.apply x = M.space.zero ->
  \exists { y: Kernel.Carrier \where Inclusion.inclusion.apply y = x } :=
  \fun (x: P.family.Carrier Nat.Nat^::zero)(closed: _) => Logic.existsIntro[Kernel.Carrier, { y: Kernel.Carrier \where Inclusion.inclusion.apply y = x }] (\into[P.family.Carrier Nat.Nat^::zero](x, (augmentationKernel resolution).carrier) \by { closed })
    (\refl(x));
\definition sequence: Sequences.Sequence := Sequences.Sequence {
  inclusion := Inclusion.inclusion, projection := resolution.augmentation,
  injective := \fun (x, y: Kernel.Carrier)(equal: _) => equal,
  onto := resolution.onto,
  zero := \fun (x: Kernel.Carrier) => \bysub(P.family.Carrier Nat.Nat^::zero,
    (augmentationKernel resolution).carrier, x),
  kernelImage := kernelImage,
};
