\import Chains.ProjectiveResolution[M := M] \as Target;
\import Chains.Map[C := P, D := Target.complex] \as Maps;
\module Degree(n: Nat.Nat^) {
  \import Modules.Hom[V := P.family.Carrier n, W := Target.Carrier n, source := P.family.space n, target := Target.space n] \as Linear;
  \definition Map: \Set := Linear.Map;
  \definition zero: Map := Linear.zeroMap;
}
\import Modules.Hom[V := M.Carrier, W := Target.Carrier Nat.Nat^::zero, source := M.space, target := Target.space Nat.Nat^::zero].Composition[
  U := P.family.Carrier Nat.Nat^::zero, domain := P.family.space Nat.Nat^::zero] \as Compose;
\definition linear: \forall (n: Nat.Nat^) -> Degree[n := n].Map :=
  \induction (n: Nat.Nat^) \return Degree[n := n].Map \with {
    | zero: Compose.compose Target.section (#augmentation{resolution})
    | succ: \fun (n: Nat.Nat^)(previous: Degree[n := n].Map) => Degree[n := Nat.Nat^::succ n].zero
  };
\definition commutes: \forall (n: Nat.Nat^)(x: P.family.Carrier (Nat.Nat^::succ n)) ->
  #apply{Target.differential} n (#apply{(linear (Nat.Nat^::succ n))} x) = #apply{(linear n)} (#apply{P.differential} n x) :=
  \induction (n: Nat.Nat^) \return \forall (x: P.family.Carrier (Nat.Nat^::succ n)) ->
    #apply{Target.differential} n (#apply{(linear (Nat.Nat^::succ n))} x) = #apply{(linear n)} (#apply{P.differential} n x) \with {
    | zero: \fun (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) =>
      sym!{{Target.Carrier Nat.Nat^::zero}} _ _
        (trans!{{Target.Carrier Nat.Nat^::zero}} _ _ _
          (congr!{M.Carrier {Target.Carrier Nat.Nat^::zero}} (#apply{Target.section}) _ _ (#killed{resolution} x))
          (Modules.Hom[V := M.Carrier, W := Target.Carrier Nat.Nat^::zero, source := M.space, target := Target.space Nat.Nat^::zero].zeroPreserved Target.section))
    | succ: \fun (n: Nat.Nat^)(previous: _)(x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) =>
        \refl(#zero{(Target.space (Nat.Nat^::succ n))})
  };
\definition map: Maps.Map := Maps.Map {
  apply := \fun (n: Nat.Nat^) => #apply{(linear n)},
  addition := \fun (n: Nat.Nat^) => #addition{(linear n)},
  scalar := \fun (n: Nat.Nat^) => #scalar{(linear n)},
  commutes := commutes,
};
\definition onDegreeZero: \forall (x: P.family.Carrier Nat.Nat^::zero) ->
  #apply{Target.augmentation} (#apply{map} Nat.Nat^::zero x) = #apply{#augmentation{resolution}} x :=
  \fun (x: P.family.Carrier Nat.Nat^::zero) => \refl(#apply{#augmentation{resolution}} x);
