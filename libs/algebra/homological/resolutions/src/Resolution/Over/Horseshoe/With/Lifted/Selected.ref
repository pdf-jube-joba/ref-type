\import \parent.\parent.\parent.Twisted[t := t] \as Middle;
\import \parent.\parent.\parent.\parent.Of[M := B, P := Middle.complex] \as Resolutions;
\definition twistLaw: Comparison.Augmented TailResolution.tailResolution p t :=
  \bysub(Twists.Map, { t: Twists.Map \where Comparison.Augmented TailResolution.tailResolution p t }, t);

\import Modules.Biproduct[V := P.family.Carrier Nat.Nat^::zero, W := Q.family.Carrier Nat.Nat^::zero, left := P.family.space Nat.Nat^::zero, right := Q.family.space Nat.Nat^::zero] \as ZeroSum;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as InclusionMaps;
\import InclusionMaps.Composition[U := P.family.Carrier Nat.Nat^::zero, domain := P.family.space Nat.Nat^::zero] \as LeftAugmentation;
\import ZeroSum.Copair[U := B.Carrier, target := B.space] \as Copair;
\definition leftAugmentation: Modules.Hom[V := P.family.Carrier Nat.Nat^::zero, W := B.Carrier, source := P.family.space Nat.Nat^::zero, target := B.space].Map :=
  LeftAugmentation.compose sequence.inclusion (p.augmentation);
\definition augmentation: Resolutions.Data := Resolutions.Data { augmentation := Copair.copair leftAugmentation s };
\module At(n: Nat.Nat^) {
  \import Modules.ProjectiveLaws[].Biproduct[P := LeftResolution.term n, Q := RightResolution.term n] \as Projectivity;
  \definition projective: Modules.Projective (Resolutions.term n) := Projectivity.projective (p.projective n) (q.projective n);
}
\import Modules.Hom[V := ZeroSum.Carrier, W := B.Carrier, source := ZeroSum.space, target := B.space] \as AugmentationMaps;
\import Modules.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as ProjectionMaps;
\import Modules.Laws[V := B.Carrier, space := B.space] \as MiddleLaws;
\import algebra.Group[].Of[Carrier := B.Carrier, group := MiddleLaws.additive] \as MiddleGroup;
\import Modules.Laws[V := C.Carrier, space := C.space] \as LastLaws;
\import algebra.Group[].Of[Carrier := C.Carrier, group := LastLaws.additive] \as LastGroup;
\definition projectionAugmentation: \forall (x: ZeroSum.Carrier) ->
  sequence.projection.apply (augmentation.augmentation.apply x) = q.augmentation.apply (ZeroSum.second x) :=
  \fun (x: ZeroSum.Carrier) => trans!{C.Carrier} _ _ _
    (sequence.projection.addition (sequence.inclusion.apply (p.augmentation.apply (ZeroSum.first x))) (s.apply (ZeroSum.second x)))
    (trans!{C.Carrier} _ _ _
      (congr2!{C.Carrier C.Carrier C.Carrier} (C.space.add) _ _ _ _ (sequence.zero (p.augmentation.apply (ZeroSum.first x))) (liftLaw (ZeroSum.second x)))
      (LastGroup.zeroLeft (q.augmentation.apply (ZeroSum.second x))));
\definition onto: Modules.Surjective (Resolutions.term Nat.Nat^::zero) B (augmentation.augmentation) := \block {
  \fun (b: B.Carrier) \then
  \takefrom y: \Cast[Q.family.Carrier Nat.Nat^::zero] ({ y: Q.family.Carrier Nat.Nat^::zero \where q.augmentation.apply y = sequence.projection.apply b }) \by q.onto (sequence.projection.apply b) \then
  \let killed: sequence.projection.apply (MiddleGroup.difference b (s.apply y)) = C.space.zero :=
    trans!{C.Carrier} _ _ _ (ProjectionMaps.differencePreserved sequence.projection b (s.apply y))
      (trans!{C.Carrier} _ _ _
        (congr!{C.Carrier C.Carrier} (LastGroup.difference (sequence.projection.apply b)) _ _
          (trans!{C.Carrier} _ _ _ (liftLaw y) (\bysub(Q.family.Carrier Nat.Nat^::zero, { y: Q.family.Carrier Nat.Nat^::zero \where q.augmentation.apply y = sequence.projection.apply b }, y))))
        (LastGroup.inverseRight (sequence.projection.apply b))) \then
  \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where sequence.inclusion.apply a = MiddleGroup.difference b (s.apply y) }) \by sequence.kernelImage (MiddleGroup.difference b (s.apply y)) killed \then
  \takefrom x: \Cast[P.family.Carrier Nat.Nat^::zero] ({ x: P.family.Carrier Nat.Nat^::zero \where p.augmentation.apply x = a }) \by p.onto a \then
  \return Logic.existsIntro[ZeroSum.Carrier, { z: ZeroSum.Carrier \where augmentation.augmentation.apply z = b }] (ZeroSum.make x y)
    (trans!{B.Carrier} _ _ _
      (congr!{B.Carrier B.Carrier} (\fun (v: B.Carrier) => B.space.add v (s.apply y)) _ _
        (trans!{B.Carrier} _ _ _
          (congr!{A.Carrier B.Carrier} (sequence.inclusion.apply) _ _ (\bysub(P.family.Carrier Nat.Nat^::zero, { x: P.family.Carrier Nat.Nat^::zero \where p.augmentation.apply x = a }, x)))
          (\bysub(A.Carrier, { a: A.Carrier \where sequence.inclusion.apply a = MiddleGroup.difference b (s.apply y) }, a))))
      (MiddleGroup.addDifference b (s.apply y)))
};

\import Modules.Hom[V := P.family.Carrier Nat.Nat^::zero, W := B.Carrier, source := P.family.space Nat.Nat^::zero, target := B.space] \as LeftAugmentationMaps;
\import Modules.Laws[V := P.family.Carrier Nat.Nat^::zero, space := P.family.space Nat.Nat^::zero] \as FirstLaws;
\import algebra.Group[].Of[Carrier := P.family.Carrier Nat.Nat^::zero, group := FirstLaws.additive] \as FirstGroup;
\definition twistAugmentation: \forall (y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) ->
  leftAugmentation.apply (t.apply Nat.Nat^::zero y) = B.space.neg (s.apply (Q.differential.apply Nat.Nat^::zero y)) :=
  \fun (y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => trans!{B.Carrier} _ _ _
    (congr!{A.Carrier B.Carrier} (sequence.inclusion.apply) _ _ (twistLaw y))
    (trans!{B.Carrier} _ _ _ (InclusionMaps.negativePreserved sequence.inclusion (coefficient.apply (Syzygy.projection.apply y)))
      (congr!{B.Carrier B.Carrier} (B.space.neg) _ _ (coefficientLaw (Syzygy.projection.apply y))));
\definition leftKilled: \forall (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) ->
  leftAugmentation.apply (P.differential.apply Nat.Nat^::zero x) = B.space.zero :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => trans!{B.Carrier} _ _ _
    (congr!{A.Carrier B.Carrier} (sequence.inclusion.apply) _ _ (p.killed x)) (InclusionMaps.zeroPreserved sequence.inclusion);
\definition differentialAugmentation: \forall (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero))(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) ->
  leftAugmentation.apply ((P.family.space Nat.Nat^::zero).add (P.differential.apply Nat.Nat^::zero x) (t.apply Nat.Nat^::zero y)) =
    B.space.neg (s.apply (Q.differential.apply Nat.Nat^::zero y)) :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero))(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) =>
    trans!{B.Carrier} _ _ _ (leftAugmentation.addition (P.differential.apply Nat.Nat^::zero x) (t.apply Nat.Nat^::zero y))
      (trans!{B.Carrier} _ _ _
        (congr2!{B.Carrier B.Carrier B.Carrier} (B.space.add) _ _ _ _ (leftKilled x) (twistAugmentation y))
        (MiddleGroup.zeroLeft (B.space.neg (s.apply (Q.differential.apply Nat.Nat^::zero y)))));
\import Modules.Biproduct[V := P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero), W := Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero), left := P.family.space (Nat.Nat^::succ Nat.Nat^::zero), right := Q.family.space (Nat.Nat^::succ Nat.Nat^::zero)] \as OneSum;
\definition killed: \forall (z: OneSum.Carrier) ->
  augmentation.augmentation.apply (Middle.complex.differential.apply Nat.Nat^::zero z) = B.space.zero :=
  \fun (z: OneSum.Carrier) => trans!{B.Carrier} _ _ _
    (congr!{B.Carrier B.Carrier} (\fun (v: B.Carrier) => B.space.add v (s.apply (Q.differential.apply Nat.Nat^::zero (OneSum.second z)))) _ _
      (differentialAugmentation (OneSum.first z) (OneSum.second z)))
    (MiddleGroup.inverseLeft (s.apply (Q.differential.apply Nat.Nat^::zero (OneSum.second z))));
\definition correctionAugmentation: \forall (x: P.family.Carrier Nat.Nat^::zero)(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) ->
  leftAugmentation.apply (FirstGroup.difference x (t.apply Nat.Nat^::zero y)) = B.space.add (leftAugmentation.apply x) (s.apply (Q.differential.apply Nat.Nat^::zero y)) :=
  \fun (x: P.family.Carrier Nat.Nat^::zero)(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => trans!{B.Carrier} _ _ _
    (LeftAugmentationMaps.differencePreserved leftAugmentation x (t.apply Nat.Nat^::zero y))
    (trans!{B.Carrier} _ _ _
      (congr!{B.Carrier B.Carrier} (MiddleGroup.difference (leftAugmentation.apply x)) _ _ (twistAugmentation y))
      (congr!{B.Carrier B.Carrier} (B.space.add (leftAugmentation.apply x)) _ _ (MiddleGroup.negNeg (s.apply (Q.differential.apply Nat.Nat^::zero y)))));
\definition correctionClosed: \forall (z: ZeroSum.Carrier)(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) ->
  augmentation.augmentation.apply z = B.space.zero -> Q.differential.apply Nat.Nat^::zero y = ZeroSum.second z ->
  p.augmentation.apply (FirstGroup.difference (ZeroSum.first z) (t.apply Nat.Nat^::zero y)) = A.space.zero :=
  \fun (z: ZeroSum.Carrier)(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero))(closed: _)(boundary: _) =>
    sequence.injective (p.augmentation.apply (FirstGroup.difference (ZeroSum.first z) (t.apply Nat.Nat^::zero y))) (A.space.zero)
      (trans!{B.Carrier} _ _ _ (correctionAugmentation (ZeroSum.first z) y)
        (trans!{B.Carrier} _ _ _
          (congr!{B.Carrier B.Carrier} (B.space.add (leftAugmentation.apply (ZeroSum.first z))) _ _
            (congr!{{Q.family.Carrier Nat.Nat^::zero} B.Carrier} (s.apply) _ _ boundary))
          (trans!{B.Carrier} _ _ _ closed (sym!{B.Carrier} _ _ (InclusionMaps.zeroPreserved sequence.inclusion)))));
\import std.Data[].Pair[].Prop[A := P.family.Carrier Nat.Nat^::zero, B := Q.family.Carrier Nat.Nat^::zero] \as ZeroPairs;
\definition augmentationExact: \forall (z: ZeroSum.Carrier) -> augmentation.augmentation.apply z = B.space.zero ->
  \exists { w: OneSum.Carrier \where Middle.complex.differential.apply Nat.Nat^::zero w = z } := \block {
  \fun (z: ZeroSum.Carrier)(closed: _) \then
  \let rightClosed: q.augmentation.apply (ZeroSum.second z) = C.space.zero :=
    trans!{C.Carrier} _ _ _ (sym!{C.Carrier} _ _ (projectionAugmentation z))
      (trans!{C.Carrier} _ _ _ (congr!{B.Carrier C.Carrier} (sequence.projection.apply) _ _ closed) (ProjectionMaps.zeroPreserved sequence.projection)) \then
  \takefrom y: \Cast[Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)] ({ y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where Q.differential.apply Nat.Nat^::zero y = ZeroSum.second z }) \by q.augmentationExact (ZeroSum.second z) rightClosed \then
  \let boundary: Q.differential.apply Nat.Nat^::zero y = ZeroSum.second z :=
    \bysub(Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero), { y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where Q.differential.apply Nat.Nat^::zero y = ZeroSum.second z }, y) \then
  \takefrom x: \Cast[P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)] ({ x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where P.differential.apply Nat.Nat^::zero x = FirstGroup.difference (ZeroSum.first z) (t.apply Nat.Nat^::zero y) })
    \by p.augmentationExact (FirstGroup.difference (ZeroSum.first z) (t.apply Nat.Nat^::zero y)) (correctionClosed z y closed boundary) \then
  \return Logic.existsIntro[OneSum.Carrier, { w: OneSum.Carrier \where Middle.complex.differential.apply Nat.Nat^::zero w = z }] (OneSum.make x y)
    (ZeroPairs.ext (Middle.complex.differential.apply Nat.Nat^::zero (OneSum.make x y)) z
      (trans!{{P.family.Carrier Nat.Nat^::zero}} _ _ _
        (congr!{{P.family.Carrier Nat.Nat^::zero} {P.family.Carrier Nat.Nat^::zero}}
          (\fun (v: P.family.Carrier Nat.Nat^::zero) => (P.family.space Nat.Nat^::zero).add v (t.apply Nat.Nat^::zero y)) _ _
          (\bysub(P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero), { x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where P.differential.apply Nat.Nat^::zero x = FirstGroup.difference (ZeroSum.first z) (t.apply Nat.Nat^::zero y) }, x)))
        (FirstGroup.addDifference (ZeroSum.first z) (t.apply Nat.Nat^::zero y))) boundary)
};
\module Exact(n: Nat.Nat^);

\definition laws: Resolutions.Laws[augmentation] := Resolutions.Laws[augmentation] {
  projective := \fun (n: Nat.Nat^) => At[n := n].projective,
  onto := onto, killed := killed, augmentationExact := augmentationExact,
  exact := \fun (n: Nat.Nat^) => Exact[n := n].exact,
};
\definition complex: Chains.Complex := Middle.complex;
\definition resolution: Resolutions.Resolution := \into[Resolutions.Data](augmentation, { data: Resolutions.Data \where Resolutions.Laws[data] }) \by { laws };
\definition inclusion: Chains.Map[C := P, D := complex].Map := Middle.inclusion;
\definition projection: Chains.Map[C := complex, D := Q].Map := Middle.projection;
\definition degreeSequence(n: Nat.Nat^): Modules.ShortExact[A := LeftResolution.term n, B := Resolutions.term n, C := RightResolution.term n].Sequence := Middle.At[n := n].sequence;
\definition section: \forall (n: Nat.Nat^) -> Modules.MapBetween (RightResolution.term n) (Resolutions.term n) :=
  \fun (n: Nat.Nat^) => Middle.At[n := n].section;
\definition splits: \forall (n: Nat.Nat^)(x: Q.family.Carrier n) -> projection.apply n ((section n).apply x) = x :=
  \fun (n: Nat.Nat^) => Middle.At[n := n].splitting;
\definition inclusionAugmented: \forall (x: P.family.Carrier Nat.Nat^::zero) ->
  resolution.augmentation.apply (inclusion.apply Nat.Nat^::zero x) = sequence.inclusion.apply (p.augmentation.apply x) :=
  Copair.onLeft leftAugmentation s;
\definition projectionAugmented: \forall (x: family.Carrier Nat.Nat^::zero) ->
  q.augmentation.apply (projection.apply Nat.Nat^::zero x) = sequence.projection.apply (resolution.augmentation.apply x) :=
  \fun (x: family.Carrier Nat.Nat^::zero) => sym!{C.Carrier} _ _ (projectionAugmentation x);
