\import Modules.Biproduct[V := P.family.Carrier (Nat.Nat^::succ n), W := Q.family.Carrier (Nat.Nat^::succ n), left := P.family.space (Nat.Nat^::succ n), right := Q.family.space (Nat.Nat^::succ n)] \as Source;
\import Modules.Biproduct[V := P.family.Carrier n, W := Q.family.Carrier n, left := P.family.space n, right := Q.family.space n] \as Target;
\import Modules.Biproduct[V := P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), W := Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), left := P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n)), right := Q.family.space (Nat.Nat^::succ (Nat.Nat^::succ n))] \as Before;
\import std.Data[].Pair[].Prop[A := P.family.Carrier (Nat.Nat^::succ n), B := Q.family.Carrier (Nat.Nat^::succ n)] \as Pairs;
\import Modules.Laws[V := P.family.Carrier (Nat.Nat^::succ n), space := P.family.space (Nat.Nat^::succ n)] \as Left;
\import algebra.Group[].Of[Carrier := P.family.Carrier (Nat.Nat^::succ n), group := Left.additive] \as LeftGroup;
\import Modules.Laws[V := P.family.Carrier n, space := P.family.space n] \as AfterLeft;
\import algebra.Group[].Of[Carrier := P.family.Carrier n, group := AfterLeft.additive] \as AfterGroup;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := P.family.Carrier n, source := P.family.space (Nat.Nat^::succ n), target := P.family.space n] \as Maps;
\definition original: Maps.Map := Maps.Map {
  apply := P.differential.apply n, addition := P.laws.addition n, scalar := P.laws.scalar n,
};
\definition correctionDifferential: \forall (x: P.family.Carrier (Nat.Nat^::succ n))(y: Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) ->
  P.differential.apply n (LeftGroup.difference x (t.apply (Nat.Nat^::succ n) y)) =
  (P.family.space n).add (P.differential.apply n x) (t.apply n (Q.differential.apply (Nat.Nat^::succ n) y)) :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ n))(y: Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => trans!{{P.family.Carrier n}} _ _ _
    (Maps.differencePreserved original x (t.apply (Nat.Nat^::succ n) y))
    (trans!{{P.family.Carrier n}} _ _ _
      (congr!{{P.family.Carrier n} {P.family.Carrier n}} (AfterGroup.difference (P.differential.apply n x)) _ _ (Middle.At[n := n].anticommuting y))
      (congr!{{P.family.Carrier n} {P.family.Carrier n}} ((P.family.space n).add (P.differential.apply n x)) _ _
        (AfterGroup.negNeg (t.apply n (Q.differential.apply (Nat.Nat^::succ n) y)))));
\definition correctionClosed: \forall (z: Source.Carrier)(y: Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) ->
  Middle.complex.differential.apply n z = Target.space.zero -> Q.differential.apply (Nat.Nat^::succ n) y = Source.second z ->
  P.differential.apply n (LeftGroup.difference (Source.first z) (t.apply (Nat.Nat^::succ n) y)) = (P.family.space n).zero :=
  \fun (z: Source.Carrier)(y: Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)))(closed: _)(boundary: _) => trans!{{P.family.Carrier n}} _ _ _
    (correctionDifferential (Source.first z) y)
    (trans!{{P.family.Carrier n}} _ _ _
      (congr!{{P.family.Carrier n} {P.family.Carrier n}} ((P.family.space n).add (P.differential.apply n (Source.first z))) _ _
        (congr!{{Q.family.Carrier (Nat.Nat^::succ n)} {P.family.Carrier n}} (t.apply n) _ _ boundary))
      (congr!{Target.Carrier {P.family.Carrier n}} Target.first _ _ closed));
\definition exact: \forall (z: Source.Carrier) -> Middle.complex.differential.apply n z = Target.space.zero ->
  \exists { w: Before.Carrier \where Middle.complex.differential.apply (Nat.Nat^::succ n) w = z } := \block {
  \fun (z: Source.Carrier)(closed: _) \then
  \let rightClosed: Q.differential.apply n (Source.second z) = (Q.family.space n).zero :=
    congr!{Target.Carrier {Q.family.Carrier n}} Target.second _ _ closed \then
  \takefrom y: \Cast[Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))]
    ({ y: Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where Q.differential.apply (Nat.Nat^::succ n) y = Source.second z }) \by q.exact n (Source.second z) rightClosed \then
  \let boundary: Q.differential.apply (Nat.Nat^::succ n) y = Source.second z :=
    \bysub(Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), { y: Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where Q.differential.apply (Nat.Nat^::succ n) y = Source.second z }, y) \then
  \takefrom x: \Cast[P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))]
    ({ x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where P.differential.apply (Nat.Nat^::succ n) x = LeftGroup.difference (Source.first z) (t.apply (Nat.Nat^::succ n) y) })
    \by p.exact n (LeftGroup.difference (Source.first z) (t.apply (Nat.Nat^::succ n) y)) (correctionClosed z y closed boundary) \then
  \return Logic.existsIntro[Before.Carrier, { w: Before.Carrier \where Middle.complex.differential.apply (Nat.Nat^::succ n) w = z }] (Before.make x y)
    (Pairs.ext (Middle.complex.differential.apply (Nat.Nat^::succ n) (Before.make x y)) z
      (trans!{{P.family.Carrier (Nat.Nat^::succ n)}} _ _ _
        (congr!{{P.family.Carrier (Nat.Nat^::succ n)} {P.family.Carrier (Nat.Nat^::succ n)}}
          (\fun (v: P.family.Carrier (Nat.Nat^::succ n)) => (P.family.space (Nat.Nat^::succ n)).add v (t.apply (Nat.Nat^::succ n) y)) _ _
          (\bysub(P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), { x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where P.differential.apply (Nat.Nat^::succ n) x = LeftGroup.difference (Source.first z) (t.apply (Nat.Nat^::succ n) y) }, x)))
        (LeftGroup.addDifference (Source.first z) (t.apply (Nat.Nat^::succ n) y))) boundary)
};
