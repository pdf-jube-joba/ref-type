\import \parent.Lifted[s := construction.lift].Selected[t := construction.twist] \as Selected;
\module Term(n: Nat.Nat^) {
  \import Modules.Biproduct[V := P.family.Carrier n, W := Q.family.Carrier n, left := P.family.space n, right := Q.family.space n] \as Sum;
  \definition space: Modules.Space (std.Data[].Pair[].Times^[P.family.Carrier n, Q.family.Carrier n]) := Sum.space;
}
\definition chosenFamily: Chains.Family := Chains.Family {
  Carrier := \fun (n: Nat.Nat^) => std.Data[].Pair[].Times^[P.family.Carrier n, Q.family.Carrier n],
  space := \fun (n: Nat.Nat^) => Term[n := n].space,
};
\definition chosenDifferential: Chains.DifferentialData[chosenFamily] := Chains.DifferentialData[chosenFamily] {
  apply := \fun (n: Nat.Nat^)(x: chosenFamily.Carrier (Nat.Nat^::succ n)) => Selected.complex.differential.apply n x,
};
\definition complex: Chains.Complex := Chains.Complex {
  family := chosenFamily, differential := chosenDifferential,
  laws := Chains.DifferentialLaws[chosenFamily, chosenDifferential] {
    addition := \fun (n: Nat.Nat^)(x, y: chosenFamily.Carrier (Nat.Nat^::succ n)) => Selected.complex.laws.addition n x y,
    scalar := \fun (n: Nat.Nat^)(a: R)(x: chosenFamily.Carrier (Nat.Nat^::succ n)) => Selected.complex.laws.scalar n a x,
    squareZero := \fun (n: Nat.Nat^)(x: chosenFamily.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => Selected.complex.laws.squareZero n x,
  },
};
\import \parent.\parent.\parent.Of[M := B, P := complex] \as MiddleResolution;
\definition resolution: MiddleResolution.Resolution := Selected.resolution;
\definition inclusion: Chains.Map[C := P, D := complex].Map := Selected.inclusion;
\definition projection: Chains.Map[C := complex, D := Q].Map := Selected.projection;
\definition degreeSequence(n: Nat.Nat^): Modules.ShortExact[A := LeftResolution.term n, B := MiddleResolution.term n, C := RightResolution.term n].Sequence := Selected.degreeSequence n;
\definition section: \forall (n: Nat.Nat^) -> Modules.MapBetween (RightResolution.term n) (MiddleResolution.term n) := Selected.section;
\definition splits: \forall (n: Nat.Nat^)(x: Q.family.Carrier n) -> projection.apply n ((section n).apply x) = x := Selected.splits;
\definition inclusionAugmented: \forall (x: P.family.Carrier Nat.Nat^::zero) ->
  resolution.augmentation.apply (inclusion.apply Nat.Nat^::zero x) = sequence.inclusion.apply (p.augmentation.apply x) := Selected.inclusionAugmented;
\definition projectionAugmented: \forall (x: family.Carrier Nat.Nat^::zero) ->
  q.augmentation.apply (projection.apply Nat.Nat^::zero x) = sequence.projection.apply (resolution.augmentation.apply x) := Selected.projectionAugmented;

\definition apply: \forall (n: Nat.Nat^) -> std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ n), Q.family.Carrier (Nat.Nat^::succ n)] -> std.Data[].Pair[].Times^[P.family.Carrier n, Q.family.Carrier n] :=
  \fun (n: Nat.Nat^)(x: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ n), Q.family.Carrier (Nat.Nat^::succ n)]) => Selected.complex.differential.apply n x;
\definition addition: \forall (n: Nat.Nat^)(x, y: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ n), Q.family.Carrier (Nat.Nat^::succ n)]) ->
  apply n ((Term[n := Nat.Nat^::succ n].space).add x y) = (Term[n := n].space).add (apply n x) (apply n y) :=
  \fun (n: Nat.Nat^)(x, y: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ n), Q.family.Carrier (Nat.Nat^::succ n)]) => Selected.complex.laws.addition n x y;
\definition scalar: \forall (n: Nat.Nat^)(a: R)(x: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ n), Q.family.Carrier (Nat.Nat^::succ n)]) ->
  apply n ((Term[n := Nat.Nat^::succ n].space).smul a x) = (Term[n := n].space).smul a (apply n x) :=
  \fun (n: Nat.Nat^)(a: R)(x: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ n), Q.family.Carrier (Nat.Nat^::succ n)]) => Selected.complex.laws.scalar n a x;
\import Chains.ShortExact[A := P, B := complex, C := Q] \as ChainSequences;
\definition chainSequence: ChainSequences.Sequence := ChainSequences.Sequence {
  inclusion := inclusion, projection := projection,
  injective := \fun (n: Nat.Nat^) => (degreeSequence n).injective,
  onto := \fun (n: Nat.Nat^) => (degreeSequence n).onto,
  zero := \fun (n: Nat.Nat^) => (degreeSequence n).zero,
  kernelImage := \fun (n: Nat.Nat^) => (degreeSequence n).kernelImage,
};
\import resolutions.Resolution[].Over[R := R, ring := ring].ShortExact[] \as Resolved;
\definition resolvedSequence: Resolved.Sequence := Resolved.Sequence {
  left := A, middle := B, right := C,
  leftComplex := P, middleComplex := complex, rightComplex := Q,
  leftResolution := p, middleResolution := resolution, rightResolution := q,
  sequence := sequence, chainSequence := chainSequence,
  leftAugmented := inclusionAugmented, rightAugmented := projectionAugmented,
};
\definition squareZero: \forall (n: Nat.Nat^)(x: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))]) ->
  apply n (apply (Nat.Nat^::succ n) x) = (Term[n := n].space).zero :=
  \fun (n: Nat.Nat^)(x: std.Data[].Pair[].Times^[P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))]) => Selected.complex.laws.squareZero n x;
