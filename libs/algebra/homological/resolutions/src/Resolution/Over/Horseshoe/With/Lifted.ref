\definition liftLaw: Initial s := \bysub(Lifts.Map, { s: Lifts.Map \where Initial s }, s);
\import Modules.Hom[V := Syzygy.Carrier, W := MiddleKernel.Carrier, source := Syzygy.space, target := MiddleKernel.space] \as KernelMaps;
\definition intoKernel: KernelMaps.Map := KernelMaps.Map {
  apply := \fun (x: Syzygy.Carrier) => \into[B.Carrier](#apply{s} x, #carrier{MiddleKernel.kernel}) \by {
    trans!{C.Carrier} _ _ _ (liftLaw x)
      (\bysub(Q.family.Carrier Nat.Nat^::zero, #carrier{(RightResolution.kernel q Nat.Nat^::zero)}, x))
  },
  addition := \fun (x, y: Syzygy.Carrier) => #addition{s} x y,
  scalar := \fun (a: R)(x: Syzygy.Carrier) => #scalar{s} a x,
};
\import Modules.Hom[V := MiddleKernel.Carrier, W := A.Carrier, source := MiddleKernel.space, target := A.space].Composition[U := Syzygy.Carrier, domain := Syzygy.space] \as Compose;
\import Modules.Hom[V := Syzygy.Carrier, W := A.Carrier, source := Syzygy.space, target := A.space] \as Coefficient;
\definition coefficient: Coefficient.Map := Compose.compose MiddleKernel.backward intoKernel;
\definition coefficientLaw: \forall (x: Syzygy.Carrier) -> #apply{sequence.inclusion} (#apply{coefficient} x) = #apply{s} x :=
  \fun (x: Syzygy.Carrier) => MiddleKernel.onKernel (#apply{intoKernel} x);
\definition negativeCoefficient: Coefficient.Map := Coefficient.negative coefficient;
\import \parent.\parent.\parent.Comparison[M := Syzygy.bundle, N := A, P := RightTail.complex, Q := P, f := negativeCoefficient] \as Comparison;
\definition Twist: \Set := \Cast[Twists.Map] ({ t: Twists.Map \where Comparison.Augmented TailResolution.tailResolution p t });
\definition twistExistence: \exists Twist := Comparison.existence TailResolution.tailResolution p;
\module Selected(t: Twist);
