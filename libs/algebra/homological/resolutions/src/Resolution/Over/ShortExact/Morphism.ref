\import Modules.Hom[V := source.left.Carrier, W := target.left.Carrier, source := source.left.space, target := target.left.space] \as Left;
\import Modules.Hom[V := source.middle.Carrier, W := target.middle.Carrier, source := source.middle.space, target := target.middle.space] \as Middle;
\import Modules.Hom[V := source.right.Carrier, W := target.right.Carrier, source := source.right.space, target := target.right.space] \as Right;
\structure Data: \Set := { left: Left.Map, middle: Middle.Map, right: Right.Map };
\structure Laws[f: Data]: \Prop := {
  left: \forall (x: source.left.Carrier) -> f.middle.apply (source.sequence.inclusion.apply x) = target.sequence.inclusion.apply (f.left.apply x),
  right: \forall (x: source.middle.Carrier) -> target.sequence.projection.apply (f.middle.apply x) = f.right.apply (source.sequence.projection.apply x),
};
\definition Diagram: \Set := \Cast[Data] ({ f: Data \where Laws[f] });
\module With(f: Diagram);
