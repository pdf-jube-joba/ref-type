\import \parent.Of[M := M, P := P] \as Source;
\import \parent.Of[M := N, P := Q] \as Target;
\import Chains.Map[C := P, D := Q] \as Maps;
\import Modules.Hom[V := M.Carrier, W := N.Carrier, source := M.space, target := N.space] \as Coefficient;
\definition Augmented[p: Source.Resolution][q: Target.Resolution][g: Maps.Map]: \Prop :=
  \forall (x: P.family.Carrier Nat.Nat^::zero) -> q.augmentation.apply (g.apply Nat.Nat^::zero x) = f.apply (p.augmentation.apply x);
\module With(p: Source.Resolution, q: Target.Resolution);
\definition existence: \forall (p: Source.Resolution)(q: Target.Resolution) -> \exists ( g: Maps.Map \where Augmented p q g ) :=
  \fun (p: Source.Resolution)(q: Target.Resolution) => With[p := p, q := q].existence;
