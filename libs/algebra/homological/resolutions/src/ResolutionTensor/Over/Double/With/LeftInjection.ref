\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Left[] \as Normalization;
\import std.Data[].Nat[].Basic[].Def[] \as Arithmetic;
\import Doubles.Map[C := Tensor.complex, D := LeftTensor.complex].Total[f := LeftComparison.map] \as TotalComparison;
\import Doubles.Concentrated[C := LeftTensor.complex] \as Concentration;
\module Zero(n: Nat.Nat^) {
  \definition point: Doubles.Index n := Concentration.point n;
  \definition injection: Modules.Hom[V := Tensor.Carrier n Nat.Nat^::zero, W := Total.Carrier n,
    source := Tensor.space n Nat.Nat^::zero, target := Total.space n].Map := Total.Degree[n := n].Component[i := point].injection;
  \definition onInjection: \forall (x: Tensor.Carrier n Nat.Nat^::zero) ->
    standardLeft.apply n (injection.apply x) =
    (Normalization.Degree[n := n].forward).apply ((LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply x) :=
    \fun (x: Tensor.Carrier n Nat.Nat^::zero) => trans!{{StandardLeft.Carrier n}} _ _ _
      (congr!{{LeftTotal.Carrier n} {StandardLeft.Carrier n}} (Normalization.standardForward.apply n) _ _ (TotalComparison.Degree[n := n].onInjection point x))
      (congr!{{LeftTensor.Carrier n Nat.Nat^::zero} {StandardLeft.Carrier n}} ((Normalization.Degree[n := n].forward).apply) _ _
        (Concentration.rightInverse Normalization.vanishes n ((LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply x)));
  \import Modules.Tensor[V := P.family.Carrier n, W := Q.family.Carrier Nat.Nat^::zero, left := P.family.space n, right := Q.family.space Nat.Nat^::zero] \as Source;
  \import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as Target;
  \import Modules.Tensor[V := P.family.Carrier n, W := RightModule.Carrier Nat.Nat^::zero, left := P.family.space n, right := RightModule.space Nat.Nat^::zero].Mapping[
    U := P.family.Carrier n, Z := N.Carrier, targetLeft := P.family.space n, targetRight := N.space] \as Projection;
  \import Modules.End[V := P.family.Carrier n, space := P.family.space n] \as Identity;
  \definition onTensor: \forall (x: P.family.Carrier n)(y: Q.family.Carrier Nat.Nat^::zero) ->
    standardLeft.apply n (injection.apply (Source.tensor x y)) = Target.tensor x (q.augmentation.apply y) :=
    \fun (x: P.family.Carrier n)(y: Q.family.Carrier Nat.Nat^::zero) => eq_reason_in!{Target.Carrier _
      "=" _ "by" { onInjection (Source.tensor x y) }
      "=" _ "by" { congr!{{LeftTensor.Carrier n Nat.Nat^::zero} Target.Carrier} ((Normalization.Degree[n := n].forward).apply) _ _ (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].onTensor x y) }
      "=" _ "by" { Projection.onTensor Identity.identity RightModule.augmentation x (RightAugmentation.map.apply Nat.Nat^::zero y) }
    };
}
\module Positive(p, q: Nat.Nat^) {
  \definition degree: Nat.Nat^ := Arithmetic.add p (Nat.Nat^::succ q);
  \definition point: Doubles.Index degree := \into[Doubles.Pair](Doubles.Pair { first := p, second := Nat.Nat^::succ q },
    { i: Doubles.Pair \where Arithmetic.add i.first i.second = degree }) \by { \refl(degree) };
  \import Modules.Tensor[V := P.family.Carrier p, W := Q.family.Carrier (Nat.Nat^::succ q), left := P.family.space p, right := Q.family.space (Nat.Nat^::succ q)] \as Source;
  \import Modules.Tensor[V := P.family.Carrier p, W := RightModule.Carrier (Nat.Nat^::succ q), left := P.family.space p, right := RightModule.space (Nat.Nat^::succ q)] \as Target;
  \import Source.Universal[U := Target.Carrier, target := Target.space] \as Universal;
  \import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
  \definition mapZero: LeftComparison.Degree[p := p, q := Nat.Nat^::succ q].map = Maps.zeroMap :=
    Universal.ext (LeftComparison.Degree[p := p, q := Nat.Nat^::succ q].map) Maps.zeroMap
      (\fun (x: P.family.Carrier p)(y: Q.family.Carrier (Nat.Nat^::succ q)) => trans!{Target.Carrier} _ _ _
        (LeftComparison.Degree[p := p, q := Nat.Nat^::succ q].onTensor x y) (Target.tensorZeroRight x));
  \definition pointZero: \forall (x: Source.Carrier) -> (LeftComparison.Degree[p := p, q := Nat.Nat^::succ q].map).apply x = Target.space.zero :=
    \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => f.apply x) _ _ mapZero;
  \import Modules.Hom[V := Target.Carrier, W := LeftTotal.Carrier degree, source := Target.space, target := LeftTotal.space degree] \as Injections;
  \definition leftZero: \forall (x: Source.Carrier) -> left.apply degree ((Total.Degree[n := degree].Component[i := point].injection).apply x) = (LeftTotal.space degree).zero :=
    \fun (x: Source.Carrier) => eq_reason_in!{{LeftTotal.Carrier degree} _
      "=" _ "by" { TotalComparison.Degree[n := degree].onInjection point x }
      "=" _ "by" { congr!{Target.Carrier {LeftTotal.Carrier degree}} ((LeftTotal.Degree[n := degree].Component[i := point].injection).apply) _ _ (pointZero x) }
      "=" _ "by" { Injections.zeroPreserved (LeftTotal.Degree[n := degree].Component[i := point].injection) }
    };
  \definition zero: \forall (x: Source.Carrier) -> standardLeft.apply degree ((Total.Degree[n := degree].Component[i := point].injection).apply x) = (StandardLeft.space degree).zero :=
    \fun (x: Source.Carrier) => trans!{{StandardLeft.Carrier degree}} _ _ _
      (congr!{{LeftTotal.Carrier degree} {StandardLeft.Carrier degree}} (Normalization.standardForward.apply degree) _ _ (leftZero x))
      (Chains.Map[C := LeftTotal.complex, D := StandardLeft.complex].At[n := degree].zeroPreserved Normalization.standardForward);
}
