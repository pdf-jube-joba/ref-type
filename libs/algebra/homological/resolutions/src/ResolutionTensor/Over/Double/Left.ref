\import Doubles.Concentrated[C := LeftTensor.complex] \as Concentration;
\module Term(p, q: Nat.Nat^) {
  \import Modules.Tensor[V := P.family.Carrier p, W := RightModule.Carrier (Nat.Nat^::succ q),
    left := P.family.space p, right := RightModule.space (Nat.Nat^::succ q)] \as Tensor;
  \import Modules.End[V := Tensor.Carrier, space := Tensor.space] \as Identity;
  \import Modules.Hom[V := Tensor.Carrier, W := Tensor.Carrier, source := Tensor.space, target := Tensor.space] \as Maps;
  \import Tensor.Universal[U := Tensor.Carrier, target := Tensor.space] \as Universal;
  \definition identityZero: Identity.identity = Maps.zeroMap := Universal.ext Identity.identity Maps.zeroMap
    (\fun (x: P.family.Carrier p)(y: RightModule.Carrier (Nat.Nat^::succ q)) =>
      trans!{Tensor.Carrier} _ _ _
        (congr!{{RightModule.Carrier (Nat.Nat^::succ q)} Tensor.Carrier} (Tensor.tensor x) _ _ (RightModule.Positive[n := q].trivial y))
        (Tensor.tensorZeroRight x));
  \definition trivial: \forall (x: Tensor.Carrier) -> x = Tensor.space.zero :=
    \fun (x: Tensor.Carrier) => congr!{Maps.Map Tensor.Carrier} (\fun (f: Maps.Map) => f.apply x) _ _ identityZero;
}
\definition vanishes: Concentration.Vanishes := \fun (p, q: Nat.Nat^) => Term[p := p, q := q].trivial;
\import Doubles.Column[C := LeftTensor.complex, q := Nat.Nat^::zero] \as Column;
\definition forward: Chains.Map[C := LeftTotal.complex, D := Column.complex].Map := Concentration.forward vanishes;
\definition backward: Chains.Map[C := Column.complex, D := LeftTotal.complex].Map := Concentration.backward;
\definition leftInverse: \forall (n: Nat.Nat^)(x: LeftTotal.Carrier n) -> backward.apply n (forward.apply n x) = x :=
  Concentration.leftInverse vanishes;
\definition rightInverse: \forall (n: Nat.Nat^)(x: LeftTensor.Carrier n Nat.Nat^::zero) -> forward.apply n (backward.apply n x) = x :=
  Concentration.rightInverse vanishes;
\definition coefficient: Modules.Bundle := RightModule.term Nat.Nat^::zero;
\import \root.TensorComplex[].Over[R := R, ring := ring] \as TensorComplex;
\import TensorComplex.On[P := P, N := coefficient] \as ColumnTensor;
\import TensorComplex.On[P := P, N := N] \as Standard;
\import Chains.End[C := P] \as Identity;
\import TensorComplex.Mapping[P := P, Q := P, N := coefficient, L := N].On[f := Identity.identity, u := RightModule.augmentation] \as Projection;
\import TensorComplex.Mapping[P := P, Q := P, N := N, L := coefficient].On[f := Identity.identity, u := RightModule.section] \as Inclusion;
\definition columnToTensor: Chains.Map[C := Column.complex, D := ColumnTensor.complex].Map := Chains.Map[C := Column.complex, D := ColumnTensor.complex].Map {
  apply := \fun (n: Nat.Nat^)(x: LeftTensor.Carrier n Nat.Nat^::zero) => x,
  addition := \fun (n: Nat.Nat^)(x, y: LeftTensor.Carrier n Nat.Nat^::zero) => \refl((ColumnTensor.space n).add x y),
  scalar := \fun (n: Nat.Nat^)(a: R)(x: LeftTensor.Carrier n Nat.Nat^::zero) => \refl((ColumnTensor.space n).smul a x),
  commutes := \fun (n: Nat.Nat^)(x: LeftTensor.Carrier (Nat.Nat^::succ n) Nat.Nat^::zero) => \refl(ColumnTensor.differential.apply n x),
};
\definition tensorToColumn: Chains.Map[C := ColumnTensor.complex, D := Column.complex].Map := Chains.Map[C := ColumnTensor.complex, D := Column.complex].Map {
  apply := \fun (n: Nat.Nat^)(x: ColumnTensor.Carrier n) => x,
  addition := \fun (n: Nat.Nat^)(x, y: ColumnTensor.Carrier n) => \refl((ColumnTensor.space n).add x y),
  scalar := \fun (n: Nat.Nat^)(a: R)(x: ColumnTensor.Carrier n) => \refl((ColumnTensor.space n).smul a x),
  commutes := \fun (n: Nat.Nat^)(x: ColumnTensor.Carrier (Nat.Nat^::succ n)) => \refl(ColumnTensor.differential.apply n x),
};
\definition tensorForward: Chains.Map[C := LeftTotal.complex, D := ColumnTensor.complex].Map :=
  Chains.Map[C := Column.complex, D := ColumnTensor.complex].Composition[B := LeftTotal.complex].compose columnToTensor forward;
\definition tensorBackward: Chains.Map[C := ColumnTensor.complex, D := LeftTotal.complex].Map :=
  Chains.Map[C := Column.complex, D := LeftTotal.complex].Composition[B := ColumnTensor.complex].compose backward tensorToColumn;
\import Chains.Map[C := ColumnTensor.complex, D := Standard.complex].Composition[B := LeftTotal.complex] \as ForwardComposition;
\import Chains.Map[C := ColumnTensor.complex, D := LeftTotal.complex].Composition[B := Standard.complex] \as BackwardComposition;
\definition standardForward: Chains.Map[C := LeftTotal.complex, D := Standard.complex].Map := ForwardComposition.compose Projection.map tensorForward;
\definition standardBackward: Chains.Map[C := Standard.complex, D := LeftTotal.complex].Map := Chains.Map[C := ColumnTensor.complex, D := LeftTotal.complex].Composition[B := Standard.complex].compose tensorBackward Inclusion.map;
\module Degree(n: Nat.Nat^) {
  \import Modules.Tensor[V := P.family.Carrier n, W := coefficient.Carrier, left := P.family.space n, right := coefficient.space] \as Before;
  \import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as After;
  \import Modules.End[V := P.family.Carrier n, space := P.family.space n] \as TermIdentity;
  \import Modules.Isomorphism[V := P.family.Carrier n, W := P.family.Carrier n, source := P.family.space n, target := P.family.space n] \as TermIso;
  \definition termIso: TermIso.Isomorphism := TermIso.Isomorphism {
    forward := TermIdentity.identity, backward := TermIdentity.identity,
    leftInverse := \fun (x: P.family.Carrier n) => \refl(x),
    rightInverse := \fun (x: P.family.Carrier n) => \refl(x),
  };
  \import Modules.Isomorphism[V := coefficient.Carrier, W := N.Carrier, source := coefficient.space, target := N.space] \as CoefficientIso;
  \definition coefficientIso: CoefficientIso.Isomorphism := CoefficientIso.Isomorphism {
    forward := RightModule.augmentation, backward := RightModule.section,
    leftInverse := \fun (x: coefficient.Carrier) => \refl(x),
    rightInverse := \fun (x: N.Carrier) => \refl(x),
  };
  \import Before.Mapping[U := P.family.Carrier n, Z := N.Carrier, targetLeft := P.family.space n, targetRight := N.space].Isomorphism[
    leftIso := termIso, rightIso := coefficientIso] \as TensorIso;
  \definition forward: Modules.Hom[V := Before.Carrier, W := After.Carrier, source := Before.space, target := After.space].Map := Projection.At[n := n].map;
  \definition backward: Modules.Hom[V := After.Carrier, W := Before.Carrier, source := After.space, target := Before.space].Map := Inclusion.At[n := n].map;
  \definition leftInverse: \forall (x: Before.Carrier) -> Inclusion.map.apply n (Projection.map.apply n x) = x := TensorIso.leftInverse;
  \definition rightInverse: \forall (x: After.Carrier) -> Projection.map.apply n (Inclusion.map.apply n x) = x := TensorIso.rightInverse;
}
\definition standardLeftInverse: \forall (n: Nat.Nat^)(x: LeftTotal.Carrier n) -> standardBackward.apply n (standardForward.apply n x) = x :=
  \fun (n: Nat.Nat^)(x: LeftTotal.Carrier n) => trans!{{LeftTotal.Carrier n}} _ _ _
    (congr!{{ColumnTensor.Carrier n} {LeftTotal.Carrier n}} (backward.apply n) _ _ (Degree[n := n].leftInverse (forward.apply n x)))
    (leftInverse n x);
\definition standardRightInverse: \forall (n: Nat.Nat^)(x: Standard.Carrier n) -> standardForward.apply n (standardBackward.apply n x) = x :=
  \fun (n: Nat.Nat^)(x: Standard.Carrier n) => trans!{{Standard.Carrier n}} _ _ _
    (congr!{{ColumnTensor.Carrier n} {Standard.Carrier n}} (Projection.map.apply n) _ _ (rightInverse n (Inclusion.map.apply n x)))
    (Degree[n := n].rightInverse x);

\import Chains.Isomorphism[C := LeftTotal.complex, D := Standard.complex] \as StandardIso;
\definition isomorphism: StandardIso.Isomorphism := StandardIso.Isomorphism {
  forward := standardForward, backward := standardBackward,
  leftInverse := standardLeftInverse, rightInverse := standardRightInverse,
};
\definition chainIsomorphism: StandardIso.Isomorphism := isomorphism;
\module Homology(n: Nat.Nat^) {
  \import StandardIso.With[e := chainIsomorphism].At[n := n] \as Induced;
  \import Chains.Homology[C := LeftTotal.complex].At[n := n] \as Source;
  \import Chains.Homology[C := Standard.complex].At[n := n] \as Target;
  \definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism := Induced.isomorphism;
  \definition forward: \forall (x: Source.Carrier) -> isomorphism.forward.apply x =
    (Chains.Map[C := LeftTotal.complex, D := Standard.complex].HomologyAt[n := n].induced standardForward).apply x :=
    \fun (x: Source.Carrier) => \refl((Chains.Map[C := LeftTotal.complex, D := Standard.complex].HomologyAt[n := n].induced standardForward).apply x);
}
