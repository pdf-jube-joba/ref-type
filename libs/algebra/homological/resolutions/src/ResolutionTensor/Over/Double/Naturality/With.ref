\import \parent.\parent.With[p := p, q := q] \as Source;
\import TargetModel.With[p := s, q := t] \as Target;
\import Doubles.TensorMapping[C := P, D := S, E := Q, F := T].With[f := f, g := g] \as Mapping;
\import Doubles.Map[C := Tensor.complex, D := TargetTensor.complex].Total[f := Mapping.map] \as TotalMap;
\import Native.Mapping[P := P, Q := S, N := N, L := K].On[f := f, u := v] \as LeftAction;
\import Native.Mapping[P := Q, Q := T, N := M, L := L].On[f := g, u := u] \as RightAction;
\definition total: Chains.Map[C := complex, D := TargetTotal.complex].Map := Mapping.total;
\definition leftAction: Chains.Map[C := SourceLeft.complex, D := TargetLeft.complex].Map := LeftAction.map;
\definition rightAction: Chains.Map[C := SourceRight.complex, D := TargetRight.complex].Map := RightAction.map;
\import Resolutions.Comparison[M := N, N := K, P := Q, Q := T, f := v] \as RightComparison;
\definition RightAugmented: \Prop := RightComparison.Augmented q t g;
\import Resolutions.Comparison[M := M, N := L, P := P, Q := S, f := u] \as LeftComparison;
\definition LeftAugmented: \Prop := LeftComparison.Augmented p s f;
\import std.Data[].Nat[].Basic[].Def[] \as Arithmetic;
\import std.Data[].Nat[].Basic[].Prop[] \as Natural;
\definition diagonal[n, a, b: Nat.Nat^][same: Arithmetic.add a b = n]: Doubles.Index n :=
  \into[Doubles.Pair](Doubles.Pair { first := a, second := b }, { i: Doubles.Pair \where Arithmetic.add i.first i.second = n }) \by { same };
\module Left;

\module Right;
