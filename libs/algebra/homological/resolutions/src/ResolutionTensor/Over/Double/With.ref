\import LeftResolution.Augmentation[resolution := p] \as LeftAugmentation;
\import RightResolution.Augmentation[resolution := q] \as RightAugmentation;
\import Chains.End[C := P] \as LeftIdentity;
\import Chains.End[C := Q] \as RightIdentity;
\import Doubles.TensorMapping[C := P, D := P, E := Q, F := RightModule.complex].With[
  f := LeftIdentity.identity, g := RightAugmentation.map] \as LeftComparison;
\import Doubles.TensorMapping[C := P, D := LeftModule.complex, E := Q, F := Q].With[
  f := LeftAugmentation.map, g := RightIdentity.identity] \as RightComparison;
\definition left: Chains.Map[C := complex, D := LeftTotal.complex].Map := LeftComparison.total;
\definition right: Chains.Map[C := complex, D := RightTotal.complex].Map := RightComparison.total;
\import Chains.Map[C := complex, D := LeftTotal.complex].ZeroExtension[f := left] \as LeftInteger;
\import Chains.Map[C := complex, D := RightTotal.complex].ZeroExtension[f := right] \as RightInteger;
\definition integerLeft: IntegerChains.Map[C := Integer.complex, D := LeftExtension.complex].Map := LeftInteger.map;
\definition integerRight: IntegerChains.Map[C := Integer.complex, D := RightExtension.complex].Map := RightInteger.map;
\module Row(n: Nat.Nat^) {
  \definition term: Modules.Bundle := LeftResolution.term n;
  \import \root.ResolutionTensor[].Over[R := R, ring := ring].Of[P := term, N := N, Q := Q] \as TensorRow;
  \import TensorRow.With[q := q] \as TensorResolution;
  \import Resolutions.Of[M := TensorRow.target, P := TensorRow.complex] \as Result;
  \definition resolution: Result.Resolution := TensorResolution.resolution (p.projective n);
}
\module Column(n: Nat.Nat^) {
  \definition term: Modules.Bundle := RightResolution.term n;
  \import \root.ResolutionTensor[].Over[R := R, ring := ring].Of[P := term, N := M, Q := P] \as TensorColumn;
  \import TensorColumn.With[q := p] \as TensorResolution;
  \import Resolutions.Of[M := TensorColumn.target, P := TensorColumn.complex] \as Result;
  \definition resolution: Result.Resolution := TensorResolution.resolution (q.projective n);
}
\import \parent.Left[] \as LeftNormalization;
\import \root.TensorComplex[].Over[R := R, ring := ring].On[P := P, N := N] \as StandardLeft;
\definition standardLeft: Chains.Map[C := complex, D := StandardLeft.complex].Map :=
  Chains.Map[C := LeftTotal.complex, D := StandardLeft.complex].Composition[B := complex].compose LeftNormalization.standardForward left;
\import \parent.Right[] \as RightNormalization;
\import \root.TensorComplex[].Over[R := R, ring := ring].On[P := Q, N := M] \as StandardRight;
\definition standardRight: Chains.Map[C := complex, D := StandardRight.complex].Map :=
  Chains.Map[C := RightTotal.complex, D := StandardRight.complex].Composition[B := complex].compose RightNormalization.standardForward right;

\module LeftQuasi;

\module RightQuasi;

\module LeftInjection;
\module RightInjection;
\module Swap;
