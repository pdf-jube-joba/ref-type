\import \parent.\parent.Right[] \as Normalization;
\import std.Data[].Nat[].Basic[].Def[] \as Arithmetic;
\import Doubles.Map[C := Tensor.complex, D := RightTensor.complex].Total[f := RightComparison.map] \as TotalComparison;
\import Doubles.ConcentratedFirst[C := RightTensor.complex] \as Concentration;
\module Zero(n: Nat.Nat^) {
  \definition point: Doubles.Index n := Concentration.point n;
  \definition injection: Modules.Hom[V := Tensor.Carrier Nat.Nat^::zero n, W := Total.Carrier n,
    source := Tensor.space Nat.Nat^::zero n, target := Total.space n].Map := Total.Degree[n := n].Component[i := point].injection;
  \definition onInjection: \forall (x: Tensor.Carrier Nat.Nat^::zero n) ->
    #apply{standardRight} n (#apply{injection} x) =
    #apply{Normalization.rowForward} n (#apply{(RightComparison.Degree[p := Nat.Nat^::zero, q := n].map)} x) :=
    \fun (x: Tensor.Carrier Nat.Nat^::zero n) => trans!{{StandardRight.Carrier n}} _ _ _
      (congr!{{RightTotal.Carrier n} {StandardRight.Carrier n}} (#apply{Normalization.standardForward} n) _ _ (TotalComparison.Degree[n := n].onInjection point x))
      (congr!{{RightTensor.Carrier Nat.Nat^::zero n} {StandardRight.Carrier n}} (#apply{Normalization.rowForward} n) _ _
        (Concentration.rightInverse Normalization.vanishes n (#apply{(RightComparison.Degree[p := Nat.Nat^::zero, q := n].map)} x)));
  \import Modules.Tensor[V := P.family.Carrier Nat.Nat^::zero, W := Q.family.Carrier n, left := P.family.space Nat.Nat^::zero, right := Q.family.space n] \as Source;
  \import Modules.Tensor[V := Q.family.Carrier n, W := M.Carrier, left := Q.family.space n, right := M.space] \as Target;
  \import \parent.\parent.RightQuasi[].Column[n := n] \as Column;
  \definition onTensor: \forall (x: P.family.Carrier Nat.Nat^::zero)(y: Q.family.Carrier n) ->
    #apply{standardRight} n (#apply{injection} (Source.tensor x y)) = Target.tensor y (#apply{#augmentation{p}} x) :=
    \fun (x: P.family.Carrier Nat.Nat^::zero)(y: Q.family.Carrier n) => trans!{Target.Carrier} _ _ _ (onInjection (Source.tensor x y))
      (trans!{Target.Carrier} _ _ _
        (congr!{{RightTensor.Carrier Nat.Nat^::zero n} Target.Carrier} (#apply{Normalization.rowForward} n) _ _ (RightComparison.Degree[p := Nat.Nat^::zero, q := n].onTensor x y))
        (Column.normalizationOnTensor (#apply{LeftAugmentation.map} Nat.Nat^::zero x) y));
}
\module Positive(p, q: Nat.Nat^) {
  \definition degree: Nat.Nat^ := Arithmetic.add (Nat.Nat^::succ p) q;
  \definition point: Doubles.Index degree := \into[Doubles.Pair](Doubles.Pair { first := Nat.Nat^::succ p, second := q },
    { i: Doubles.Pair \where Arithmetic.add #first{i} #second{i} = degree }) \by { \refl(degree) };
  \import Modules.Tensor[V := P.family.Carrier (Nat.Nat^::succ p), W := Q.family.Carrier q, left := P.family.space (Nat.Nat^::succ p), right := Q.family.space q] \as Source;
  \import Modules.Tensor[V := LeftModule.Carrier (Nat.Nat^::succ p), W := Q.family.Carrier q, left := LeftModule.space (Nat.Nat^::succ p), right := Q.family.space q] \as Target;
  \import Source.Universal[U := Target.Carrier, target := Target.space] \as Universal;
  \import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
  \definition mapZero: RightComparison.Degree[p := Nat.Nat^::succ p, q := q].map = Maps.zeroMap :=
    Universal.ext (RightComparison.Degree[p := Nat.Nat^::succ p, q := q].map) Maps.zeroMap
      (\fun (x: P.family.Carrier (Nat.Nat^::succ p))(y: Q.family.Carrier q) => trans!{Target.Carrier} _ _ _
        (RightComparison.Degree[p := Nat.Nat^::succ p, q := q].onTensor x y) (Target.tensorZeroLeft y));
  \definition pointZero: \forall (x: Source.Carrier) -> #apply{(RightComparison.Degree[p := Nat.Nat^::succ p, q := q].map)} x = #zero{Target.space} :=
    \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => #apply{f} x) _ _ mapZero;
  \import Modules.Hom[V := Target.Carrier, W := RightTotal.Carrier degree, source := Target.space, target := RightTotal.space degree] \as Injections;
  \definition rightZero: \forall (x: Source.Carrier) -> #apply{right} degree (#apply{(Total.Degree[n := degree].Component[i := point].injection)} x) = #zero{(RightTotal.space degree)} :=
    \fun (x: Source.Carrier) => trans!{{RightTotal.Carrier degree}} _ _ _ (TotalComparison.Degree[n := degree].onInjection point x)
      (trans!{{RightTotal.Carrier degree}} _ _ _
        (congr!{Target.Carrier {RightTotal.Carrier degree}} (#apply{(RightTotal.Degree[n := degree].Component[i := point].injection)}) _ _ (pointZero x))
        (Injections.zeroPreserved (RightTotal.Degree[n := degree].Component[i := point].injection)));
  \definition zero: \forall (x: Source.Carrier) -> #apply{standardRight} degree (#apply{(Total.Degree[n := degree].Component[i := point].injection)} x) = #zero{(StandardRight.space degree)} :=
    \fun (x: Source.Carrier) => trans!{{StandardRight.Carrier degree}} _ _ _
      (congr!{{RightTotal.Carrier degree} {StandardRight.Carrier degree}} (#apply{Normalization.standardForward} degree) _ _ (rightZero x))
      (Chains.Map[C := RightTotal.complex, D := StandardRight.complex].At[n := degree].zeroPreserved Normalization.standardForward);
}
