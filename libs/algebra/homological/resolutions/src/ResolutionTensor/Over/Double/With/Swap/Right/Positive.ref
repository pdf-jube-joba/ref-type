\definition degree: Nat.Nat^ := Arithmetic.add (Nat.Nat^::succ a) b;
\definition reverseDegree: Nat.Nat^ := Arithmetic.add b (Nat.Nat^::succ a);
\definition rightZero: \forall (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier (Nat.Nat^::succ a) b) ->
  standardRight.apply n ((Total.Degree[n := n].Component[i := diagonal n (Nat.Nat^::succ a) b same].injection).apply x) = (StandardRight.space n).zero :=
  \fun (n: Nat.Nat^)(same: degree = n) =>
    (\idelim degree = n \with k: Nat.Nat^ => \forall (equal: degree = k)(x: Tensor.Carrier (Nat.Nat^::succ a) b) ->
      standardRight.apply k ((Total.Degree[n := k].Component[i := diagonal k (Nat.Nat^::succ a) b equal].injection).apply x) = (StandardRight.space k).zero \by {
        base: \fun (equal: degree = degree) => OriginalRight.Positive[p := a, q := b].zero,
        equality: same
      }) same;
\definition leftZero: \forall (n: Nat.Nat^)(same: reverseDegree = n)(x: SwappedTensor.Carrier b (Nat.Nat^::succ a)) ->
  Swapped.standardLeft.apply n ((SwappedTotal.Degree[n := n].Component[i := diagonal n b (Nat.Nat^::succ a) same].injection).apply x) = (StandardRight.space n).zero :=
  \fun (n: Nat.Nat^)(same: reverseDegree = n) =>
    (\idelim reverseDegree = n \with k: Nat.Nat^ => \forall (equal: reverseDegree = k)(x: SwappedTensor.Carrier b (Nat.Nat^::succ a)) ->
      Swapped.standardLeft.apply k ((SwappedTotal.Degree[n := k].Component[i := diagonal k b (Nat.Nat^::succ a) equal].injection).apply x) = (StandardRight.space k).zero \by {
        base: \fun (equal: reverseDegree = reverseDegree) => SwappedLeft.Positive[p := b, q := a].zero,
        equality: same
      }) same;
\definition afterZero: \forall (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier (Nat.Nat^::succ a) b) ->
  after.apply n ((Total.Degree[n := n].Component[i := diagonal n (Nat.Nat^::succ a) b same].injection).apply x) = (StandardRight.space n).zero :=
  \fun (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier (Nat.Nat^::succ a) b) => trans!{{StandardRight.Carrier n}} _ _ _
    (congr!{{SwappedTotal.Carrier n} {StandardRight.Carrier n}} (Swapped.standardLeft.apply n) _ _
      (Exchange.Degree[n := n].At[i := diagonal n (Nat.Nat^::succ a) b same].onInjection x))
    (leftZero n (trans!{Nat.Nat^} _ _ _ (Natural.addComm b (Nat.Nat^::succ a)) same)
      ((Exchange.Term[p := Nat.Nat^::succ a, q := b].map).apply x));
\definition point: \forall (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier (Nat.Nat^::succ a) b) ->
  after.apply n ((Total.Degree[n := n].Component[i := diagonal n (Nat.Nat^::succ a) b same].injection).apply x) =
  standardRight.apply n ((Total.Degree[n := n].Component[i := diagonal n (Nat.Nat^::succ a) b same].injection).apply x) :=
  \fun (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier (Nat.Nat^::succ a) b) => trans!{{StandardRight.Carrier n}} _ _ _
    (afterZero n same x) (sym!{{StandardRight.Carrier n}} _ _ (rightZero n same x));
