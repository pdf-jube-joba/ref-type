\import Chains.Map[C := SwappedTotal.complex, D := StandardRight.complex].Composition[B := complex] \as Compose;
\definition after: Chains.Map[C := complex, D := StandardRight.complex].Map := Compose.compose Swapped.standardLeft Exchange.forward;
\module Zero(n: Nat.Nat^);
\module Positive(a, b: Nat.Nat^);
\module Degree(n: Nat.Nat^);
\definition point: \forall (n: Nat.Nat^)(x: Total.Carrier n) -> after.apply n x = standardRight.apply n x :=
  \fun (n: Nat.Nat^) => Degree[n := n].point;
\definition square: after = standardRight := Chains.Map[C := complex, D := StandardRight.complex].ext after standardRight point;
