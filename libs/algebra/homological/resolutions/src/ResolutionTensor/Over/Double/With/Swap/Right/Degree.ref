\import Total.Degree[n := n] \as SD;
\import Modules.Hom[V := SD.Carrier, W := StandardRight.Carrier n, source := SD.space, target := StandardRight.space n] \as Maps;
\import Chains.Map[C := complex, D := StandardRight.complex].At[n := n] \as Linear;
\definition topIndex(i: Doubles.Pair)(closed: Arithmetic.add #first{i} #second{i} = n): Doubles.Index n :=
  \into[Doubles.Pair](i, { j: Doubles.Pair \where Arithmetic.add #first{j} #second{j} = n }) \by { closed };
\definition AtFirst(a: Nat.Nat^): \Prop := \forall (b: Nat.Nat^)(same: Arithmetic.add a b = n)(x: Tensor.Carrier a b) ->
  #apply{after} n (#apply{(SD.Component[i := diagonal n a b same].injection)} x) =
  #apply{standardRight} n (#apply{(SD.Component[i := diagonal n a b same].injection)} x);
\definition onFirst: \forall (a: Nat.Nat^) -> AtFirst a := \induction (a: Nat.Nat^) \return AtFirst a \with {
  | zero: \fun (b: Nat.Nat^)(same: Arithmetic.add Nat.Nat^::zero b = n) =>
    \parent.Zero[n := b].transported n (trans!{Nat.Nat^} _ _ _ (sym!{Nat.Nat^} _ _ (Natural.addZeroLeft b)) same)
  | succ: \fun (a: Nat.Nat^)(previous: AtFirst a)(b: Nat.Nat^)(same: Arithmetic.add (Nat.Nat^::succ a) b = n) =>
    \parent.Positive[a := a, b := b].point n same
};
\definition onPair: \forall (i: Doubles.Pair)(same: Arithmetic.add #first{i} #second{i} = n)(x: Tensor.Carrier #first{i} #second{i}) ->
  #apply{after} n (#apply{(SD.Component[i := topIndex i same].injection)} x) =
  #apply{standardRight} n (#apply{(SD.Component[i := topIndex i same].injection)} x) :=
  \induction (i: Doubles.Pair) \return \forall (same: Arithmetic.add #first{i} #second{i} = n)(x: Tensor.Carrier #first{i} #second{i}) ->
    #apply{after} n (#apply{(SD.Component[i := topIndex i same].injection)} x) =
    #apply{standardRight} n (#apply{(SD.Component[i := topIndex i same].injection)} x) \with {
      | # : \fun (a, b: Nat.Nat^)(same: Arithmetic.add a b = n) => onFirst a b same
    };
\import Modules.DirectSum[Index := Doubles.Index n, family := SD.family].To[W := StandardRight.Carrier n, target := StandardRight.space n] \as Universal;
\definition equality: Linear.linear after = Linear.linear standardRight := Universal.ext (Linear.linear after) (Linear.linear standardRight)
  (\fun (i: Doubles.Index n) => onPair i (Doubles.degree n i));
\definition point: \forall (x: SD.Carrier) -> #apply{after} n x = #apply{standardRight} n x :=
  \fun (x: SD.Carrier) => congr!{Maps.Map {StandardRight.Carrier n}} (\fun (m: Maps.Map) => #apply{m} x) _ _ equality;
