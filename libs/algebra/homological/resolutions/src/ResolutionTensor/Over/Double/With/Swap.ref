\import std.Data[].Nat[].Basic[].Def[] \as Arithmetic;
\import std.Data[].Nat[].Basic[].Prop[] \as Natural;
\import \root.ResolutionTensor[].Over[R := R, ring := ring].Double[M := N, N := M, P := Q, Q := P].With[p := q, q := p] \as Swapped;
\import Doubles.Tensor[C := Q, D := P] \as SwappedTensor;
\import Doubles.Total[C := SwappedTensor.complex] \as SwappedTotal;
\import Doubles.TensorSwap[C := P, D := Q] \as Exchange;
\import \parent.RightInjection[] \as OriginalRight;
\import Swapped.LeftInjection[] \as SwappedLeft;
\definition diagonal[n, a, b: Nat.Nat^][same: Arithmetic.add a b = n]: Doubles.Index n :=
  \into[Doubles.Pair](Doubles.Pair { first := a, second := b }, { i: Doubles.Pair \where Arithmetic.add i.first i.second = n }) \by { same };
\module Right;
\definition rightSquare: standardRight = Chains.Map[C := SwappedTotal.complex, D := StandardRight.complex].Composition[B := complex].compose Swapped.standardLeft Exchange.forward :=
  sym!{{Chains.Map[C := complex, D := StandardRight.complex].Map}} _ _ Right[].square;
\import Swapped.Swap[].Right[] \as ReverseSquare;
\import Chains.Map[C := SwappedTotal.complex, D := StandardLeft.complex].Composition[B := complex] \as LeftCompose;
\definition leftPoint: \forall (n: Nat.Nat^)(x: Total.Carrier n) ->
  standardLeft.apply n x = Swapped.standardRight.apply n (Exchange.forward.apply n x) :=
  \fun (n: Nat.Nat^)(x: Total.Carrier n) => sym!{{StandardLeft.Carrier n}} _ _
    (trans!{{StandardLeft.Carrier n}} _ _ _
      (sym!{{StandardLeft.Carrier n}} _ _ (ReverseSquare.point n (Exchange.forward.apply n x)))
      (congr!{{Total.Carrier n} {StandardLeft.Carrier n}} (standardLeft.apply n) _ _ (Exchange.Involution[].twice n x)));
\definition leftSquare: standardLeft = LeftCompose.compose Swapped.standardRight Exchange.forward :=
  Chains.Map[C := complex, D := StandardLeft.complex].ext standardLeft (LeftCompose.compose Swapped.standardRight Exchange.forward) leftPoint;
