\import Resolutions.Of[M := L, P := S] \as LeftTarget;
\import Resolutions.Of[M := K, P := T] \as RightTarget;
\import Chains.Map[C := P, D := S] \as LeftMaps;
\import Chains.Map[C := Q, D := T] \as RightMaps;
\import \root.ResolutionTensor[].Over[R := R, ring := ring].Double[M := L, N := K, P := S, Q := T] \as TargetModel;
\import Doubles.Tensor[C := S, D := T] \as TargetTensor;
\import Doubles.Total[C := TargetTensor.complex] \as TargetTotal;
\import \root.TensorComplex[].Over[R := R, ring := ring] \as Native;
\import Native.On[P := P, N := N] \as SourceLeft;
\import Native.On[P := S, N := K] \as TargetLeft;
\import Native.On[P := Q, N := M] \as SourceRight;
\import Native.On[P := T, N := L] \as TargetRight;
\module With(p: LeftResolution.Resolution, q: RightResolution.Resolution,
  s: LeftTarget.Resolution, t: RightTarget.Resolution,
  u: Modules.MapBetween M L, v: Modules.MapBetween N K, f: LeftMaps.Map, g: RightMaps.Map);
