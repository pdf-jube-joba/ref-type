\import Chains.Map[C := TargetTotal.complex, D := TargetLeft.complex].Composition[B := complex] \as After;
\import Chains.Map[C := SourceLeft.complex, D := TargetLeft.complex].Composition[B := complex] \as Before;
\definition after: Chains.Map[C := complex, D := TargetLeft.complex].Map := After.compose Target.standardLeft Mapping.total;
\definition before: Chains.Map[C := complex, D := TargetLeft.complex].Map := Before.compose LeftAction.map Source.standardLeft;
\import Source.LeftInjection[] \as SourceProjection;
\import Target.LeftInjection[] \as TargetProjection;
\module Zero(n: Nat.Nat^);
\module Positive(a, b: Nat.Nat^);
\module Degree(n: Nat.Nat^);
\definition point: RightAugmented -> \forall (n: Nat.Nat^)(x: Total.Carrier n) -> #apply{after} n x = #apply{before} n x :=
  \fun (augmented: RightAugmented)(n: Nat.Nat^) => Degree[n := n].point augmented;
\definition square: RightAugmented -> after = before :=
  \fun (augmented: RightAugmented) => Chains.Map[C := complex, D := TargetLeft.complex].ext after before (point augmented);
