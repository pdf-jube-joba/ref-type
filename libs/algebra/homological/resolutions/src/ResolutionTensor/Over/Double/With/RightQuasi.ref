\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Right[] \as Normalization;
\module Column(n: Nat.Nat^) {
  \import \parent.\parent.Column[n := n] \as Resolution;
  \import Modules.End[V := Q.family.Carrier n, space := Q.family.space n] \as Identity;
  \module Term(k: Nat.Nat^) {
    \import Modules.Tensor[V := P.family.Carrier k, W := Q.family.Carrier n, left := P.family.space k, right := Q.family.space n] \as Original;
    \import Modules.Tensor[V := Q.family.Carrier n, W := P.family.Carrier k, left := Q.family.space n, right := P.family.space k] \as Reverse;
    \import Original.Symmetry[] \as Swap;
    \definition Carrier: \Set := Original.Carrier;
    \definition space: Modules.Space Carrier := Original.space;
    \definition ReverseCarrier: \Set := Reverse.Carrier;
    \definition reverseSpace: Modules.Space ReverseCarrier := Reverse.space;
    \definition tensor: P.family.Carrier k -> Q.family.Carrier n -> Carrier := Original.tensor;
    \definition reverseTensor: Q.family.Carrier n -> P.family.Carrier k -> ReverseCarrier := Reverse.tensor;
    \definition forward: Modules.Hom[V := Carrier, W := ReverseCarrier, source := space, target := reverseSpace].Map := Swap.forward;
    \definition backward: Modules.Hom[V := ReverseCarrier, W := Carrier, source := reverseSpace, target := space].Map := Swap.backward;
    \definition leftInverse: \forall (x: Carrier) -> backward.apply (forward.apply x) = x := Swap.leftInverse;
    \definition rightInverse: \forall (x: ReverseCarrier) -> forward.apply (backward.apply x) = x := Swap.rightInverse;
    \definition onTensor: \forall (x: P.family.Carrier k)(y: Q.family.Carrier n) -> forward.apply (tensor x y) = reverseTensor y x := Swap.onTensor;
  }
  \module Step(k: Nat.Nat^) {
    \import \parent.Term[k := k] \as Current;
    \import \parent.Term[k := Nat.Nat^::succ k] \as Next;
    \import Tensor.At[p := k, q := n] \as Original;
    \import Modules.Tensor[V := P.family.Carrier (Nat.Nat^::succ k), W := Q.family.Carrier n, left := P.family.space (Nat.Nat^::succ k), right := Q.family.space n].Symmetry[].Mapping[
      U := P.family.Carrier k, Z := Q.family.Carrier n, targetLeft := P.family.space k, targetRight := Q.family.space n] \as Naturality;
    \import Modules.Tensor[V := Q.family.Carrier n, W := P.family.Carrier (Nat.Nat^::succ k), left := Q.family.space n, right := P.family.space (Nat.Nat^::succ k)].Mapping[
      U := Q.family.Carrier n, Z := P.family.Carrier k, targetLeft := Q.family.space n, targetRight := P.family.space k] \as Reverse;
    \definition differential: Modules.Hom[V := Next.ReverseCarrier, W := Current.ReverseCarrier, source := Next.reverseSpace, target := Current.reverseSpace].Map := Reverse.map Identity.identity Original.dh;
    \definition forward: \forall (x: Next.Carrier) -> differential.apply (Next.forward.apply x) = Current.forward.apply (Original.horizontal.apply x) :=
      \fun (x: Next.Carrier) => sym!{Current.ReverseCarrier} _ _ (Naturality.commutes Original.dh Identity.identity x);
    \definition backward: \forall (x: Next.ReverseCarrier) -> Original.horizontal.apply (Next.backward.apply x) = Current.backward.apply (differential.apply x) :=
      \fun (x: Next.ReverseCarrier) => trans!{Current.Carrier} _ _ _
        (sym!{Current.Carrier} _ _ (Current.leftInverse (Original.horizontal.apply (Next.backward.apply x))))
        (congr!{Current.ReverseCarrier Current.Carrier} (Current.backward.apply) _ _
          (trans!{Current.ReverseCarrier} _ _ _ (sym!{Current.ReverseCarrier} _ _ (forward (Next.backward.apply x)))
            (congr!{Next.ReverseCarrier Current.ReverseCarrier} (differential.apply) _ _ (Next.rightInverse x))));
  }
  \module Positive(k: Nat.Nat^) {
    \import \parent.Term[k := k] \as Lower;
    \import \parent.Term[k := Nat.Nat^::succ k] \as Current;
    \import \parent.Term[k := Nat.Nat^::succ (Nat.Nat^::succ k)] \as Next;
    \import \parent.Step[k := k] \as CurrentStep;
    \import \parent.Step[k := Nat.Nat^::succ k] \as NextStep;
    \import Modules.Hom[V := Current.Carrier, W := Lower.ReverseCarrier, source := Current.space, target := Lower.reverseSpace] \as CurrentMaps;
    \import Modules.Hom[V := Lower.Carrier, W := Lower.ReverseCarrier, source := Lower.space, target := Lower.reverseSpace] \as SwapMaps;
    \definition exact: \forall (x: Current.Carrier) -> (Tensor.complex.differential.horizontal k n).apply x = (Tensor.space k n).zero ->
      \exists ( y: Next.Carrier \where (Tensor.complex.differential.horizontal (Nat.Nat^::succ k) n).apply y = x ) := \block {
      \fun (x: Current.Carrier)(closed: _) \then
      \let cycle: CurrentStep.differential.apply (Current.forward.apply x) = (Lower.reverseSpace).zero :=
        eq_reason_in!{{Lower.ReverseCarrier} _
          "=" _ "by" { CurrentStep.forward x }
          "=" _ "by" { congr!{{Lower.Carrier} {Lower.ReverseCarrier}} ((Lower.forward).apply) _ _ closed }
          "=" _ "by" { SwapMaps.zeroPreserved (Lower.forward) }
        } \then
      \takefrom y: \Cast[Next.ReverseCarrier] ({ y: Next.ReverseCarrier \where NextStep.differential.apply y = Current.forward.apply x }) \by Resolution.resolution.exact k (Current.forward.apply x) cycle \then
      \return Logic.existsIntro[Next.Carrier, { y: Next.Carrier \where (Tensor.complex.differential.horizontal (Nat.Nat^::succ k) n).apply y = x }] (Next.backward.apply y)
        (eq_reason_in!{Current.Carrier _
          "=" _ "by" { NextStep.backward y }
          "=" _ "by" { congr!{Current.ReverseCarrier Current.Carrier} (Current.backward.apply) _ _
              (\bysub(Next.ReverseCarrier, { y: Next.ReverseCarrier \where NextStep.differential.apply y = Current.forward.apply x }, y)) }
          "=" _ "by" { Current.leftInverse x }
        })
    };
  }
  \import Term[k := Nat.Nat^::zero] \as First;
  \import Term[k := Nat.Nat^::succ Nat.Nat^::zero] \as Second;
  \import Modules.Tensor[V := Q.family.Carrier n, W := M.Carrier, left := Q.family.space n, right := M.space] \as Target;
  \import Modules.Tensor[V := LeftModule.Carrier Nat.Nat^::zero, W := Q.family.Carrier n, left := LeftModule.space Nat.Nat^::zero, right := Q.family.space n] \as Middle;
  \import Modules.Tensor[V := Q.family.Carrier n, W := LeftModule.Carrier Nat.Nat^::zero, left := Q.family.space n, right := LeftModule.space Nat.Nat^::zero] \as SwappedMiddle;
  \import Modules.Tensor[V := Q.family.Carrier n, W := P.family.Carrier Nat.Nat^::zero, left := Q.family.space n, right := P.family.space Nat.Nat^::zero].Mapping[
    U := Q.family.Carrier n, Z := M.Carrier, targetLeft := Q.family.space n, targetRight := M.space] \as Augmentation;
  \definition augmentation: Modules.Hom[V := First.ReverseCarrier, W := Target.Carrier, source := First.reverseSpace, target := Target.space].Map := Augmentation.map Identity.identity (p.augmentation);
  \import SwappedMiddle.Mapping[U := Q.family.Carrier n, Z := M.Carrier, targetLeft := Q.family.space n, targetRight := M.space] \as Projection;
  \definition normalization: Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Map := Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Map {
    apply := Normalization.rowForward.apply n,
    addition := Normalization.rowForward.addition n,
    scalar := Normalization.rowForward.scalar n,
  };
  \definition normalizationOnTensor: \forall (a: LeftModule.Carrier Nat.Nat^::zero)(b: Q.family.Carrier n) ->
    normalization.apply (Middle.tensor a b) = Target.tensor b (LeftModule.augmentation.apply a) :=
    \fun (a: LeftModule.Carrier Nat.Nat^::zero)(b: Q.family.Carrier n) => trans!{Target.Carrier} _ _ _
      (congr!{SwappedMiddle.Carrier Target.Carrier} ((Normalization.Degree[n := n].forward).apply) _ _ (Normalization.Swap[].Degree[n := n].onTensor a b))
      (Projection.onTensor Identity.identity LeftModule.augmentation b a);
  \import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := First.Carrier, domain := First.space] \as OriginalComposition;
  \import Modules.Hom[V := First.ReverseCarrier, W := Target.Carrier, source := First.reverseSpace, target := Target.space].Composition[U := First.Carrier, domain := First.space] \as ReverseComposition;
  \import Modules.Tensor[V := P.family.Carrier Nat.Nat^::zero, W := Q.family.Carrier n, left := P.family.space Nat.Nat^::zero, right := Q.family.space n].Universal[U := Target.Carrier, target := Target.space] \as Universal;
  \definition factorMaps: OriginalComposition.compose normalization (RightComparison.Degree[p := Nat.Nat^::zero, q := n].map) = ReverseComposition.compose augmentation First.forward :=
    Universal.ext (OriginalComposition.compose normalization (RightComparison.Degree[p := Nat.Nat^::zero, q := n].map)) (ReverseComposition.compose augmentation First.forward)
      (\fun (x: P.family.Carrier Nat.Nat^::zero)(y: Q.family.Carrier n) => eq_reason_in!{Target.Carrier _
        "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (normalization.apply) _ _ (RightComparison.Degree[p := Nat.Nat^::zero, q := n].onTensor x y) }
        "=" _ "by" { normalizationOnTensor (LeftAugmentation.map.apply Nat.Nat^::zero x) y }
        "=" _ "by" { sym!{Target.Carrier} _ _ (trans!{Target.Carrier} _ _ _
            (congr!{First.ReverseCarrier Target.Carrier} (augmentation.apply) _ _ (First.onTensor x y))
            (Augmentation.onTensor Identity.identity (p.augmentation) y x)) }
      });
  \definition factor: \forall (x: First.Carrier) -> normalization.apply ((RightComparison.Degree[p := Nat.Nat^::zero, q := n].map).apply x) = augmentation.apply (First.forward.apply x) :=
    \fun (x: First.Carrier) => congr!{{Modules.Hom[V := First.Carrier, W := Target.Carrier, source := First.space, target := Target.space].Map} Target.Carrier}
      (\fun (g: Modules.Hom[V := First.Carrier, W := Target.Carrier, source := First.space, target := Target.space].Map) => g.apply x) _ _ factorMaps;
  \import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space] \as NormalizationMaps;
  \definition exact: \forall (x: First.Carrier) -> (RightComparison.Degree[p := Nat.Nat^::zero, q := n].map).apply x = Middle.space.zero ->
    \exists ( y: Second.Carrier \where (Tensor.complex.differential.horizontal Nat.Nat^::zero n).apply y = x ) := \block {
    \fun (x: First.Carrier)(killed: _) \then
    \let zero: augmentation.apply (First.forward.apply x) = Target.space.zero := eq_reason_in!{Target.Carrier _
      "=" _ "by" { sym!{Target.Carrier} _ _ (factor x) }
      "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (normalization.apply) _ _ killed }
      "=" _ "by" { NormalizationMaps.zeroPreserved normalization }
    } \then
    \takefrom y: \Cast[Second.ReverseCarrier] ({ y: Second.ReverseCarrier \where (Step[k := Nat.Nat^::zero].differential).apply y = First.forward.apply x }) \by Resolution.resolution.augmentationExact (First.forward.apply x) zero \then
    \return Logic.existsIntro[Second.Carrier, { y: Second.Carrier \where (Tensor.complex.differential.horizontal Nat.Nat^::zero n).apply y = x }] (Second.backward.apply y)
      (eq_reason_in!{First.Carrier _
        "=" _ "by" { Step[k := Nat.Nat^::zero].backward y }
        "=" _ "by" { congr!{First.ReverseCarrier First.Carrier} (First.backward.apply) _ _
          (\bysub(Second.ReverseCarrier, { y: Second.ReverseCarrier \where (Step[k := Nat.Nat^::zero].differential).apply y = First.forward.apply x }, y)) }
        "=" _ "by" { First.leftInverse x }
      })
  };
  \definition onto: \forall (x: Middle.Carrier) -> \exists ( y: First.Carrier \where (RightComparison.Degree[p := Nat.Nat^::zero, q := n].map).apply y = x ) := \block {
    \fun (x: Middle.Carrier) \then
    \takefrom z: \Cast[First.ReverseCarrier] ({ z: First.ReverseCarrier \where augmentation.apply z = normalization.apply x }) \by Resolution.resolution.onto (normalization.apply x) \then
    \let y: First.Carrier := First.backward.apply z \then
    \return Logic.existsIntro[First.Carrier, { y: First.Carrier \where (RightComparison.Degree[p := Nat.Nat^::zero, q := n].map).apply y = x }] y
      (eq_reason_in!{Middle.Carrier _
        "=" _ "by" { sym!{Middle.Carrier} _ _ (Normalization.rowLeftInverse n ((RightComparison.Degree[p := Nat.Nat^::zero, q := n].map).apply y)) }
        "=" _ "by" { congr!{Target.Carrier Middle.Carrier} (Normalization.rowBackward.apply n) _ _
            (eq_reason_in!{Target.Carrier _
              "=" _ "by" { factor y }
              "=" _ "by" { congr!{First.ReverseCarrier Target.Carrier} (augmentation.apply) _ _ (First.rightInverse z) }
              "=" _ "by" { \bysub(First.ReverseCarrier, { z: First.ReverseCarrier \where augmentation.apply z = normalization.apply x }, z) }
            }) }
        "=" _ "by" { Normalization.rowLeftInverse n x }
      })
  };
}
\import Doubles.CollapseFirst[C := Tensor.complex, D := RightTensor.complex] \as Collapse;
\import Collapse.On[f := RightComparison.map] \as Result;
\import Chains.Map[C := complex, D := RightTotal.complex].SurjectiveQuasi[f := right] \as Quasi;
\definition rows: Collapse.RowsExact[RightComparison.map] := Collapse.RowsExact[RightComparison.map] {
  augmentation := \fun (n: Nat.Nat^) => Column[n := n].exact,
  positive := \fun (k, n: Nat.Nat^) => Column[n := n].Positive[k := k].exact,
};
\definition onto: Quasi.Onto := Result.Surjection[].onto Normalization.vanishes (\fun (n: Nat.Nat^) => Column[n := n].onto);
\definition exact: Quasi.ExactCycles := Result.Exact[].exact rows Normalization.vanishes;
\definition quasiIsomorphism: IntegerChains.Map[C := Integer.complex, D := RightExtension.complex].QuasiIsomorphism integerRight := Quasi.quasiIsomorphism onto exact;
\module At(n: Nat.Nat^) {
  \import Chains.Homology[C := complex].At[n := n] \as Source;
  \import Chains.Homology[C := RightTotal.complex].At[n := n] \as Target;
  \definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism :=
    Quasi.At[n := n].isomorphism onto exact;
  \definition forward: \forall (x: Source.Carrier) -> isomorphism.forward.apply x =
    (Chains.Map[C := complex, D := RightTotal.complex].HomologyAt[n := n].induced right).apply x :=
    Quasi.At[n := n].forward onto exact;
}
