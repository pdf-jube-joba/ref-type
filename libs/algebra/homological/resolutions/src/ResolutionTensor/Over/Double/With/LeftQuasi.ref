\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Left[] \as Normalization;
\import Doubles.Collapse[C := Tensor.complex, D := LeftTensor.complex] \as Collapse;
\import Collapse.On[f := LeftComparison.map] \as Result;
\import Chains.Map[C := complex, D := LeftTotal.complex].SurjectiveQuasi[f := left] \as Quasi;
\module Row(n: Nat.Nat^) {
  \import \parent.\parent.Row[n := n] \as Resolution;
  \import Modules.Tensor[V := P.family.Carrier n, W := Q.family.Carrier Nat.Nat^::zero, left := P.family.space n, right := Q.family.space Nat.Nat^::zero] \as Source;
  \import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as Target;
  \import Modules.Tensor[V := P.family.Carrier n, W := RightModule.Carrier Nat.Nat^::zero, left := P.family.space n, right := RightModule.space Nat.Nat^::zero] \as Middle;
  \import Modules.End[V := P.family.Carrier n, space := P.family.space n] \as Identity;
  \import Source.Mapping[U := P.family.Carrier n, Z := N.Carrier, targetLeft := P.family.space n, targetRight := N.space] \as Augmentation;
  \import Middle.Mapping[U := P.family.Carrier n, Z := N.Carrier, targetLeft := P.family.space n, targetRight := N.space] \as Projection;
  \definition augmentation: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Augmentation.map Identity.identity (q.augmentation);
  \definition projection: Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Map := Normalization.Degree[n := n].forward;
  \import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Composition;
  \import Source.Universal[U := Target.Carrier, target := Target.space] \as Universal;
  \definition composite: Composition.compose projection (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map) = augmentation :=
    Universal.ext (Composition.compose projection (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map)) augmentation
      (\fun (x: P.family.Carrier n)(y: Q.family.Carrier Nat.Nat^::zero) => eq_reason_in!{Target.Carrier _
        "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (projection.apply) _ _ (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].onTensor x y) }
        "=" _ "by" { Projection.onTensor Identity.identity RightModule.augmentation x (RightAugmentation.map.apply Nat.Nat^::zero y) }
        "=" _ "by" { sym!{Target.Carrier} _ _ (Augmentation.onTensor Identity.identity (q.augmentation) x y) }
      });
  \definition factor: \forall (x: Source.Carrier) -> projection.apply ((LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply x) = augmentation.apply x :=
    \fun (x: Source.Carrier) => congr!{{Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map} Target.Carrier}
      (\fun (g: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map) => g.apply x) _ _ composite;
  \import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space] \as ProjectionMaps;
  \definition exact: \forall (x: Source.Carrier) -> (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply x = Middle.space.zero ->
    \exists ( y: Tensor.Carrier n (Nat.Nat^::succ Nat.Nat^::zero) \where (Tensor.complex.differential.vertical n Nat.Nat^::zero).apply y = x ) :=
    \fun (x: Source.Carrier)(killed: _) => Resolution.resolution.augmentationExact x
      (eq_reason_in!{Target.Carrier _
        "=" _ "by" { sym!{Target.Carrier} _ _ (factor x) }
        "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (projection.apply) _ _ killed }
        "=" _ "by" { ProjectionMaps.zeroPreserved projection }
      });
  \definition onto: \forall (x: Middle.Carrier) -> \exists ( y: Source.Carrier \where (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply y = x ) := \block {
    \fun (x: Middle.Carrier) \then
    \takefrom y: \Cast[Source.Carrier] ({ y: Source.Carrier \where augmentation.apply y = projection.apply x }) \by Resolution.resolution.onto (projection.apply x) \then
    \return Logic.existsIntro[Source.Carrier, { y: Source.Carrier \where (LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply y = x }] y
      (eq_reason_in!{Middle.Carrier _
        "=" _ "by" { sym!{Middle.Carrier} _ _ (Normalization.Degree[n := n].leftInverse ((LeftComparison.Degree[p := n, q := Nat.Nat^::zero].map).apply y)) }
        "=" _ "by" { congr!{Target.Carrier Middle.Carrier} ((Normalization.Degree[n := n].backward).apply) _ _ (factor y) }
        "=" _ "by" { congr!{Target.Carrier Middle.Carrier} ((Normalization.Degree[n := n].backward).apply) _ _
              (\bysub(Source.Carrier, { y: Source.Carrier \where augmentation.apply y = projection.apply x }, y)) }
        "=" _ "by" { Normalization.Degree[n := n].leftInverse x }
      })
  };
}
\definition rows: Collapse.RowsExact[LeftComparison.map] := Collapse.RowsExact[LeftComparison.map] {
  augmentation := \fun (n: Nat.Nat^) => Row[n := n].exact,
  positive := \fun (n: Nat.Nat^) => (\parent.Row[n := n].resolution).exact,
};
\definition onto: Quasi.Onto := Result.Surjection[].onto Normalization.vanishes (\fun (n: Nat.Nat^) => Row[n := n].onto);
\definition exact: Quasi.ExactCycles := Result.Exact[].exact rows Normalization.vanishes;
\definition quasiIsomorphism: IntegerChains.Map[C := Integer.complex, D := LeftExtension.complex].QuasiIsomorphism integerLeft := Quasi.quasiIsomorphism onto exact;
\module At(n: Nat.Nat^) {
  \import Chains.Homology[C := complex].At[n := n] \as Source;
  \import Chains.Homology[C := LeftTotal.complex].At[n := n] \as Target;
  \definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism :=
    Quasi.At[n := n].isomorphism onto exact;
  \definition forward: \forall (x: Source.Carrier) -> isomorphism.forward.apply x =
    (Chains.Map[C := complex, D := LeftTotal.complex].HomologyAt[n := n].induced left).apply x :=
    Quasi.At[n := n].forward onto exact;
}
