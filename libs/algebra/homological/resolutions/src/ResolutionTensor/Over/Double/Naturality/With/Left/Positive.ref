\use std.Logic[].Equality[].eq_reason_in;
\definition degree: Nat.Nat^ := Arithmetic.add a (Nat.Nat^::succ b);
\definition sourceZero: \forall (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier a (Nat.Nat^::succ b)) ->
  Source.standardLeft.apply n ((Total.Degree[n := n].Component[i := diagonal n a (Nat.Nat^::succ b) same].injection).apply x) = (SourceLeft.space n).zero :=
  \fun (n: Nat.Nat^)(same: degree = n) =>
    (\idelim degree = n \with k: Nat.Nat^ => \forall (equal: degree = k)(x: Tensor.Carrier a (Nat.Nat^::succ b)) ->
      Source.standardLeft.apply k ((Total.Degree[n := k].Component[i := diagonal k a (Nat.Nat^::succ b) equal].injection).apply x) = (SourceLeft.space k).zero \by {
        base: \fun (equal: degree = degree) => SourceProjection.Positive[p := a, q := b].zero,
        equality: same
      }) same;
\definition targetZero: \forall (n: Nat.Nat^)(same: degree = n)(x: TargetTensor.Carrier a (Nat.Nat^::succ b)) ->
  Target.standardLeft.apply n ((TargetTotal.Degree[n := n].Component[i := diagonal n a (Nat.Nat^::succ b) same].injection).apply x) = (TargetLeft.space n).zero :=
  \fun (n: Nat.Nat^)(same: degree = n) =>
    (\idelim degree = n \with k: Nat.Nat^ => \forall (equal: degree = k)(x: TargetTensor.Carrier a (Nat.Nat^::succ b)) ->
      Target.standardLeft.apply k ((TargetTotal.Degree[n := k].Component[i := diagonal k a (Nat.Nat^::succ b) equal].injection).apply x) = (TargetLeft.space k).zero \by {
        base: \fun (equal: degree = degree) => TargetProjection.Positive[p := a, q := b].zero,
        equality: same
      }) same;
\definition point: \forall (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier a (Nat.Nat^::succ b)) ->
  after.apply n ((Total.Degree[n := n].Component[i := diagonal n a (Nat.Nat^::succ b) same].injection).apply x) =
  before.apply n ((Total.Degree[n := n].Component[i := diagonal n a (Nat.Nat^::succ b) same].injection).apply x) :=
  \fun (n: Nat.Nat^)(same: degree = n)(x: Tensor.Carrier a (Nat.Nat^::succ b)) => eq_reason_in!{{TargetLeft.Carrier n} _
    "=" _ "by" { congr!{{TargetTotal.Carrier n} {TargetLeft.Carrier n}} (Target.standardLeft.apply n) _ _ (TotalMap.Degree[n := n].onInjection (diagonal n a (Nat.Nat^::succ b) same) x) }
    "=" _ "by" { targetZero n same ((Mapping.Degree[p := a, q := Nat.Nat^::succ b].map).apply x) }
    "=" _ "by" { sym!{{TargetLeft.Carrier n}} _ _ (trans!{{TargetLeft.Carrier n}} _ _ _
      (congr!{{SourceLeft.Carrier n} {TargetLeft.Carrier n}} (LeftAction.map.apply n) _ _ (sourceZero n same x))
      (Chains.Map[C := SourceLeft.complex, D := TargetLeft.complex].At[n := n].zeroPreserved LeftAction.map)) }
  };
