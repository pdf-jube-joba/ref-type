\import Total.Degree[n := n] \as SD;
\import Modules.Hom[V := SD.Carrier, W := TargetLeft.Carrier n, source := SD.space, target := TargetLeft.space n] \as Maps;
\import Chains.Map[C := complex, D := TargetLeft.complex].At[n := n] \as Linear;
\definition topIndex(i: Doubles.Pair)(closed: Arithmetic.add i.first i.second = n): Doubles.Index n :=
  \into[Doubles.Pair](i, { j: Doubles.Pair \where Arithmetic.add j.first j.second = n }) \by { closed };
\definition AtSecond(b: Nat.Nat^): \Prop := \forall (a: Nat.Nat^)(same: Arithmetic.add a b = n)(x: Tensor.Carrier a b) ->
  after.apply n ((SD.Component[i := diagonal n a b same].injection).apply x) =
  before.apply n ((SD.Component[i := diagonal n a b same].injection).apply x);
\definition onSecond: RightAugmented -> \forall (b: Nat.Nat^) -> AtSecond b := \fun (augmented: RightAugmented) => \induction (b: Nat.Nat^) \return AtSecond b \with {
  | zero: \fun (a: Nat.Nat^)(same: Arithmetic.add a Nat.Nat^::zero = n) => \parent.Zero[n := a].transported augmented n same
  | succ: \fun (b: Nat.Nat^)(previous: AtSecond b)(a: Nat.Nat^)(same: Arithmetic.add a (Nat.Nat^::succ b) = n) => \parent.Positive[a := a, b := b].point n same
};
\definition onPair: RightAugmented -> \forall (i: Doubles.Pair)(same: Arithmetic.add i.first i.second = n)(x: Tensor.Carrier i.first i.second) ->
  after.apply n ((SD.Component[i := topIndex i same].injection).apply x) =
  before.apply n ((SD.Component[i := topIndex i same].injection).apply x) :=
  \fun (augmented: RightAugmented) => \induction (i: Doubles.Pair) \return \forall (same: Arithmetic.add i.first i.second = n)(x: Tensor.Carrier i.first i.second) ->
    after.apply n ((SD.Component[i := topIndex i same].injection).apply x) =
    before.apply n ((SD.Component[i := topIndex i same].injection).apply x) \with {
      | # : \fun (a, b: Nat.Nat^)(same: Arithmetic.add a b = n) => onSecond augmented b a same
    };
\import Modules.DirectSum[Index := Doubles.Index n, family := SD.family].To[W := TargetLeft.Carrier n, target := TargetLeft.space n] \as Universal;
\definition equality: RightAugmented -> Linear.linear after = Linear.linear before := \fun (augmented: RightAugmented) => Universal.ext (Linear.linear after) (Linear.linear before)
  (\fun (i: Doubles.Index n) => onPair augmented i (Doubles.degree n i));
\definition point: RightAugmented -> \forall (x: SD.Carrier) -> after.apply n x = before.apply n x :=
  \fun (augmented: RightAugmented)(x: SD.Carrier) => congr!{Maps.Map {TargetLeft.Carrier n}} (\fun (m: Maps.Map) => m.apply x) _ _ (equality augmented);
