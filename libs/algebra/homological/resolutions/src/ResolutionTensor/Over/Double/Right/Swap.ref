\module Degree(n: Nat.Nat^) {
  \import Modules.Tensor[V := coefficient.Carrier, W := Q.family.Carrier n, left := coefficient.space, right := Q.family.space n].Symmetry[] \as Symmetry;
  \definition forward: Modules.Hom[V := RightTensor.Carrier Nat.Nat^::zero n, W := Swapped.Carrier n,
    source := RightTensor.space Nat.Nat^::zero n, target := Swapped.space n].Map := Symmetry.forward;
  \definition backward: Modules.Hom[V := Swapped.Carrier n, W := RightTensor.Carrier Nat.Nat^::zero n,
    source := Swapped.space n, target := RightTensor.space Nat.Nat^::zero n].Map := Symmetry.backward;
  \definition onTensor: \forall (x: coefficient.Carrier)(y: Q.family.Carrier n) -> forward.apply (RightTensor.Term[p := Nat.Nat^::zero, q := n].tensor x y) =
    Modules.Tensor[V := Q.family.Carrier n, W := coefficient.Carrier, left := Q.family.space n, right := coefficient.space].tensor y x := Symmetry.onTensor;
  \definition leftInverse: \forall (x: RightTensor.Carrier Nat.Nat^::zero n) -> backward.apply (forward.apply x) = x := Symmetry.leftInverse;
  \definition rightInverse: \forall (x: Swapped.Carrier n) -> forward.apply (backward.apply x) = x := Symmetry.rightInverse;
}
\module Step(n: Nat.Nat^) {
  \import Modules.Tensor[V := coefficient.Carrier, W := Q.family.Carrier (Nat.Nat^::succ n), left := coefficient.space, right := Q.family.space (Nat.Nat^::succ n)].Symmetry[].Mapping[
    U := coefficient.Carrier, Z := Q.family.Carrier n, targetLeft := coefficient.space, targetRight := Q.family.space n] \as Naturality;
  \import Modules.End[V := coefficient.Carrier, space := coefficient.space] \as Identity;
  \import Doubles.Tensor[C := LeftModule.complex, D := Q].At[p := Nat.Nat^::zero, q := n] \as Differential;
  \definition forward: \forall (x: RightTensor.Carrier Nat.Nat^::zero (Nat.Nat^::succ n)) ->
    Swapped.differential.apply n ((\parent.Degree[n := Nat.Nat^::succ n].forward).apply x) =
    (\parent.Degree[n := n].forward).apply (Row.differential.apply n x) :=
    \fun (x: RightTensor.Carrier Nat.Nat^::zero (Nat.Nat^::succ n)) => sym!{{Swapped.Carrier n}} _ _
      (Naturality.commutes Identity.identity Differential.dv x);
  \definition backward: \forall (x: Swapped.Carrier (Nat.Nat^::succ n)) ->
    Row.differential.apply n ((\parent.Degree[n := Nat.Nat^::succ n].backward).apply x) =
    (\parent.Degree[n := n].backward).apply (Swapped.differential.apply n x) :=
    \fun (x: Swapped.Carrier (Nat.Nat^::succ n)) => trans!{{RightTensor.Carrier Nat.Nat^::zero n}} _ _ _
      (sym!{{RightTensor.Carrier Nat.Nat^::zero n}} _ _ (\parent.Degree[n := n].leftInverse (Row.differential.apply n ((\parent.Degree[n := Nat.Nat^::succ n].backward).apply x))))
      (congr!{{Swapped.Carrier n} {RightTensor.Carrier Nat.Nat^::zero n}} ((\parent.Degree[n := n].backward).apply) _ _
        (trans!{{Swapped.Carrier n}} _ _ _ (sym!{{Swapped.Carrier n}} _ _ (forward ((\parent.Degree[n := Nat.Nat^::succ n].backward).apply x)))
          (congr!{{Swapped.Carrier (Nat.Nat^::succ n)} {Swapped.Carrier n}} (Swapped.differential.apply n) _ _ (\parent.Degree[n := Nat.Nat^::succ n].rightInverse x))));
}
\definition forward: Chains.Map[C := Row.complex, D := Swapped.complex].Map := Chains.Map[C := Row.complex, D := Swapped.complex].Map {
  apply := \fun (n: Nat.Nat^) => (Degree[n := n].forward).apply,
  addition := \fun (n: Nat.Nat^) => (Degree[n := n].forward).addition,
  scalar := \fun (n: Nat.Nat^) => (Degree[n := n].forward).scalar,
  commutes := \fun (n: Nat.Nat^) => Step[n := n].forward,
};
\definition backward: Chains.Map[C := Swapped.complex, D := Row.complex].Map := Chains.Map[C := Swapped.complex, D := Row.complex].Map {
  apply := \fun (n: Nat.Nat^) => (Degree[n := n].backward).apply,
  addition := \fun (n: Nat.Nat^) => (Degree[n := n].backward).addition,
  scalar := \fun (n: Nat.Nat^) => (Degree[n := n].backward).scalar,
  commutes := \fun (n: Nat.Nat^) => Step[n := n].backward,
};
