\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Term[n := Nat.Nat^::succ Nat.Nat^::zero] \as Source;
\import \parent.\parent.Term[n := Nat.Nat^::zero] \as Middle;
\import Product.At[p := Nat.Nat^::zero, q := Nat.Nat^::zero] \as Differential;
\import Modules.Tensor[V := P.Carrier, W := Q.family.Carrier Nat.Nat^::zero, left := P.space, right := Q.family.space Nat.Nat^::zero].Mapping[
  U := P.Carrier, Z := N.Carrier, targetLeft := P.space, targetRight := N.space] \as Mapping;
\import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[
  U := Source.Carrier, domain := Source.space] \as Composition;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
\import Modules.Tensor[V := P.Carrier, W := Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero),
  left := P.space, right := Q.family.space (Nat.Nat^::succ Nat.Nat^::zero)].Universal[
  U := Target.Carrier, target := Target.space] \as Universal;
\definition equality: Composition.compose augmentation Differential.vertical = Maps.zeroMap :=
  Universal.ext (Composition.compose augmentation Differential.vertical) Maps.zeroMap
    (\fun (x: P.Carrier)(y: Q.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => eq_reason_in!{Target.Carrier _
      "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (augmentation.apply) _ _ (Differential.verticalOnTensor x y) }
      "=" _ "by" { Mapping.onTensor Identity.identity (q.augmentation) x (Q.differential.apply Nat.Nat^::zero y) }
      "=" _ "by" { congr!{N.Carrier Target.Carrier} (Target.tensor x) _ _ (q.killed y) }
      "=" _ "by" { Target.tensorZeroRight x }
    });
\definition zero: \forall (x: Source.Carrier) -> augmentation.apply (complex.differential.apply Nat.Nat^::zero x) = Target.space.zero :=
  \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => f.apply x)
    (Composition.compose augmentation Differential.vertical) Maps.zeroMap equality;
