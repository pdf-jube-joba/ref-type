\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Surjection[n := n] \as Lift;
\import \parent.Surjection[n := Nat.Nat^::succ n] \as NextLift;
\import \parent.Factor[n := n] \as Factor;
\import \parent.Factor[n := Nat.Nat^::succ n] \as NextFactor;
\import \parent.Kernel[n := n] \as CurrentKernel;
\import \parent.Kernel[n := Nat.Nat^::succ n] \as NextKernel;
\import \parent.\parent.Term[n := Nat.Nat^::succ n] \as Source;
\import \parent.\parent.Term[n := n] \as Target;
\import \parent.\parent.Term[n := Nat.Nat^::succ (Nat.Nat^::succ n)] \as Before;
\import Original.Syzygy[n := n, resolution := q].ShortExact[] \as Sequence;
\import Original.Syzygy[n := n, resolution := q] \as Syzygy;
\import Algebra.ProjectiveTensorShortExact[P := P, A := Sequence.left, B := Sequence.middle, C := Syzygy.bundle].On[
  sequence := Sequence.sequence] \as Exact;
\definition projection: Modules.MapBetween Source.bundle CurrentKernel.bundle := Lift.map;
\definition onto: Modules.Surjective Source.bundle CurrentKernel.bundle projection := Lift.onto;
\definition factorPoint: \forall (x: Source.Carrier) ->
  CurrentKernel.inclusion.apply (projection.apply x) = complex.differential.apply n x := Factor.point;
\definition exact: Modules.Projective P -> \forall (x: Source.Carrier) -> complex.differential.apply n x = Target.space.zero ->
  \exists ( y: Before.Carrier \where complex.differential.apply (Nat.Nat^::succ n) y = x ) := \block {
  \fun (projective: Modules.Projective P)(x: Source.Carrier)(closed: _) \then
  \let kernel: projection.apply x = CurrentKernel.space.zero := CurrentKernel.injective projective
    (projection.apply x) CurrentKernel.space.zero
    (eq_reason_in!{Target.Carrier _
      "=" _ "by" { factorPoint x }
      "=" _ "by" closed
      "=" _ "by" { sym!{Target.Carrier} _ _ CurrentKernel.zero }
    }) \then
  \takefrom a: \Cast[NextKernel.Carrier] ({ a: NextKernel.Carrier \where NextKernel.inclusion.apply a = x })
    \by Exact.kernelImage x kernel \then
  \takefrom y: \Cast[Before.Carrier] ({ y: Before.Carrier \where NextLift.map.apply y = a }) \by NextLift.onto a \then
  \return Existential.existsIntro[Before.Carrier, { y: Before.Carrier \where complex.differential.apply (Nat.Nat^::succ n) y = x }] y
    (eq_reason_in!{Source.Carrier _
      "=" _ "by" { sym!{Source.Carrier}
        _ _ (NextFactor.point y) }
      "=" _ "by" { congr!{NextKernel.Carrier Source.Carrier} (NextKernel.inclusion.apply) (NextLift.map.apply y) a
          (\bysub(Before.Carrier, { y: Before.Carrier \where NextLift.map.apply y = a }, y)) }
      "=" _ "by" { \bysub(NextKernel.Carrier, { a: NextKernel.Carrier \where NextKernel.inclusion.apply a = x }, a) }
    })
};
