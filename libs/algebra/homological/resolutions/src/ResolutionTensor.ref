\import std.Logic[].Proposition[] \as Logic;
\import std.Alg[].Ring[] \as Ring;
\import std.Data[].Nat[] \as Nat;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\module Over(R: \Set, ring: Ring.CommutativeRing[R]) {
  \definition ordinaryRing: Ring.Ring[R] := Ring.commutativeRingAsRing R ring;
  \import module_theory.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
  \import commutative_algebra.Modules[R := R, ring := ring] \as Algebra;
  \import double_complexes.NonnegativeChain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
  \import resolutions.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Resolutions;
  \import double_complexes.DoubleComplex[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Doubles;
  \module Of(P, N: Modules.Bundle, Q: Chains.Complex);
  \module Double(M, N: Modules.Bundle, P, Q: Chains.Complex);
}
