\import \parent.Integer[P := Q, N := N] \as Source;
\import \parent.Integer[P := P, N := N] \as Target;
\import chain_complexes.Chain[] \as Degrees;
\import std.Logic[].Proposition[] \as Logic;
\import IntegerChains.Map[C := P, D := Q] \as ChainMaps;
\import IntegerChains.Homotopy[C := P, D := Q] \as Homotopies;
\import IntegerChains.Prior[C := Q] \as QPrior;
\import chain_complexes.Integer[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import \parent.IntegerMapping[P := P, Q := Q, N := N, L := N] \as Actions;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import Cochains.Map[C := Source.complex, D := Target.complex] \as Maps;
\definition map[f: ChainMaps.Map]: Maps.Map := Actions.On[f := f, u := Coefficients.identity].map;
\module At(z: Degrees.Degree);
\definition onCohomology: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(z: Degrees.Degree)
  (q: Cochains.At[C := Source.complex, z := z].Cohomology) ->
  (Maps.At[k := z].induced (map f)).apply q = (Maps.At[k := z].induced (map g)).apply q :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(z: Degrees.Degree) => At[z := z].onCohomology f g h;
