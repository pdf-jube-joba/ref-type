\import std.Arithmetic[].Int[] \as I;
\import chain_complexes.Integer[] \as Degrees;
\import Degrees.Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as IntegerCochains;
\import \parent.On[P := P, N := N] \as Natural;
\import Chains.ZeroExtension[C := P] \as ChainExtension;
\import Cochains.ZeroExtension[C := Natural.complex] \as Source;
\import \parent.Integer[P := ChainExtension.complex, N := N] \as Target;
\definition DegreeIso(z: Degrees.Degree): \Set := Modules.Isomorphism[V := Source.Carrier z, W := Target.Carrier z, source := Source.space z, target := Target.space z].Isomorphism;
\module Positive(n: Nat.Nat^);
\module Negative(n: Nat.Nat^);
\definition isomorphisms: \forall (z: Degrees.Degree) -> DegreeIso z := \induction (z: I.Int^) \return DegreeIso z \with {
  | ofNat: \fun (n: Nat.Nat^) => Positive[n := n].isomorphism
  | negSucc: \fun (n: Nat.Nat^) => Negative[n := n].isomorphism
};
\import IntegerCochains.Isomorphism[C := Source.complex, D := Target.complex].Degreewise[isomorphisms := isomorphisms] \as Degreewise;
\module PositiveCommutes(n: Nat.Nat^);
\module NegativeCommutes(n: Nat.Nat^);
\definition commutes: Degreewise.Commutes := \induction (z: I.Int^) \return \forall (h: Source.Carrier z) ->
  Target.apply z (#apply{#forward{(isomorphisms z)}} h) = #apply{#forward{(isomorphisms (Degrees.next z))}} (Source.apply z h) \with {
    | ofNat: \fun (n: Nat.Nat^) => PositiveCommutes[n := n].law
    | negSucc: \fun (n: Nat.Nat^) => NegativeCommutes[n := n].law
  };
\definition isomorphism: IntegerCochains.Isomorphism[C := Source.complex, D := Target.complex].Isomorphism := Degreewise.isomorphism commutes;
\definition cochainIsomorphism: IntegerCochains.Isomorphism[C := Source.complex, D := Target.complex].Isomorphism := isomorphism;
\module Cohomology(n: Nat.Nat^);
