\definition degree: I.Int^ := I.Int^::negSucc n;
\import Modules.Hom[V := Source.Carrier degree, W := Target.Carrier degree, source := Source.space degree, target := Target.space degree] \as Forward;
\import Modules.Hom[V := Target.Carrier degree, W := Source.Carrier degree, source := Target.space degree, target := Source.space degree] \as Backward;
\definition zero: \forall (h: Target.Carrier degree) -> h = #zero{(Target.space degree)} :=
  \fun (h: Target.Carrier degree) => Target.At[z := degree].ext h #zero{(Target.space degree)}
    (\fun (x: ChainExtension.Carrier degree) => trans!{N.Carrier} _ _ _
      (congr!{{ChainExtension.Carrier degree} N.Carrier} (#apply{h}) _ _ (ChainExtension.Negative[n := n].zero x))
      (Target.At[z := degree].zeroPreserved h));
\definition isomorphism: DegreeIso degree := Modules.Isomorphism[V := Source.Carrier degree, W := Target.Carrier degree, source := Source.space degree, target := Target.space degree].Isomorphism {
  forward := Forward.zeroMap, backward := Backward.zeroMap,
  leftInverse := \fun (h: Source.Carrier degree) => sym!{{Source.Carrier degree}} _ _ (Source.Negative[n := n].zero h),
  rightInverse := \fun (h: Target.Carrier degree) => sym!{{Target.Carrier degree}} _ _ (zero h),
};
