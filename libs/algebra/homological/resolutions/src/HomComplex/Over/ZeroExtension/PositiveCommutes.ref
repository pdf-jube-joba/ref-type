\definition degree: I.Int^ := I.Int^::ofNat n;
\import std.Logic[].Equality[].Transport[A := Degrees.Degree] \as Transport;
\import IntegerChains.Prior[C := ChainExtension.complex] \as ChainPrior;
\definition prior: \forall (x: ChainExtension.Carrier (Degrees.next degree)) ->
  ChainPrior.value degree x = ChainExtension.Positive[n := n].intro ((P.differential).apply n x) :=
  \fun (x: ChainExtension.Carrier (Degrees.next degree)) =>
    Transport.castRefl ChainExtension.complex.family.Carrier degree (ChainExtension.Positive[n := n].intro ((P.differential).apply n x));
\definition law: \forall (h: Source.Carrier degree) -> Target.apply degree (((isomorphisms degree).forward).apply h) =
  ((isomorphisms (Degrees.next degree)).forward).apply (Source.apply degree h) :=
  \fun (h: Source.Carrier degree) => Target.At[z := Degrees.next degree].ext
    (Target.apply degree (((isomorphisms degree).forward).apply h)) (((isomorphisms (Degrees.next degree)).forward).apply (Source.apply degree h))
    (\fun (x: _) => congr!{{ChainExtension.Carrier degree} N.Carrier} ((\parent.Positive[n := n].to h).apply)
      (ChainPrior.value degree x) (ChainExtension.Positive[n := n].intro ((P.differential).apply n x)) (prior x));
