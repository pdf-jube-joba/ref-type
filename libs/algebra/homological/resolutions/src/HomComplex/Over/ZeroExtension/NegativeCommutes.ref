\definition degree: I.Int^ := I.Int^::negSucc n;
\import IntegerCochains.At[C := Target.complex, z := degree] \as Differential;
\import Modules.Hom[V := Target.Carrier degree, W := Target.Carrier (Degrees.next degree), source := Target.space degree, target := Target.space (Degrees.next degree)] \as Maps;
\import Modules.Hom[V := Source.Carrier (Degrees.next degree), W := Target.Carrier (Degrees.next degree), source := Source.space (Degrees.next degree), target := Target.space (Degrees.next degree)] \as Next;
\definition law: \forall (h: Source.Carrier degree) -> Target.apply degree (#apply{#forward{(isomorphisms degree)}} h) =
  #apply{#forward{(isomorphisms (Degrees.next degree))}} (Source.apply degree h) :=
  \fun (h: Source.Carrier degree) => trans!{{Target.Carrier (Degrees.next degree)}} _ _ _
    (Maps.zeroPreserved Differential.differential)
    (sym!{{Target.Carrier (Degrees.next degree)}} _ _ (Next.zeroPreserved #forward{(isomorphisms (Degrees.next degree))}));
