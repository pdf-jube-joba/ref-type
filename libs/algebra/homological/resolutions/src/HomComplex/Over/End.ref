\import \parent.On[P := P, N := N] \as Hom;
\import Chains.End[C := P] \as ChainIdentity;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import \parent.Mapping[P := P, Q := P, N := N, L := N] \as Actions;
\import Cochains.Map[C := Hom.complex, D := Hom.complex] \as Maps;
\import Cochains.End[C := Hom.complex] \as Identity;
\definition map: Maps.Map := Actions.On[f := ChainIdentity.identity, u := Coefficients.identity].map;
\definition law: map = Identity.identity := Maps.ext map Identity.identity
  (\fun (k: Nat.Nat^)(h: Hom.Carrier k) => Hom.At[n := k].ext (map.apply k h) h (\fun (x: P.family.Carrier k) => \refl(h.apply x)));
\module At(k: Nat.Nat^) {
  \import Cochains.At[C := Hom.complex, k := k] \as H;
  \definition onCohomology: \forall (q: H.Cohomology) -> (Maps.At[k := k].induced map).apply q = q :=
    \fun (q: H.Cohomology) => trans!{H.Cohomology} _ _ _
      (congr!{Maps.Map H.Cohomology} (\fun (f: Maps.Map) => (Maps.At[k := k].induced f).apply q) _ _ law) (Identity.At[k := k].identityOnCohomology q);
}
