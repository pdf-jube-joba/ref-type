\import chain_complexes.Chain[] \as Degrees;
\import chain_complexes.Integer[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import \parent.Integer[P := T, N := N] \as Source;
\import \parent.Integer[P := Q, N := N] \as Middle;
\import \parent.Integer[P := P, N := N] \as Target;
\import IntegerChains.Map[C := P, D := Q] \as Before;
\import IntegerChains.Map[C := Q, D := T] \as After;
\import After.Composition[B := P] \as ChainComposition;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import \parent.IntegerMapping[P := Q, Q := T, N := N, L := N] \as First;
\import \parent.IntegerMapping[P := P, Q := Q, N := N, L := N] \as Second;
\import \parent.IntegerMapping[P := P, Q := T, N := N, L := N] \as Direct;
\import Cochains.Map[C := Middle.complex, D := Target.complex].Composition[B := Source.complex] \as Composition;
\import Cochains.Map[C := Source.complex, D := Target.complex] \as Maps;
\definition first[g: After.Map]: Cochains.Map[C := Source.complex, D := Middle.complex].Map := First.On[f := g, u := Coefficients.identity].map;
\definition second[f: Before.Map]: Cochains.Map[C := Middle.complex, D := Target.complex].Map := Second.On[f := f, u := Coefficients.identity].map;
\definition direct[f: Before.Map][g: After.Map]: Maps.Map := Direct.On[f := ChainComposition.compose g f, u := Coefficients.identity].map;
\definition law: \forall (f: Before.Map)(g: After.Map) -> direct f g = Composition.compose (second f) (first g) :=
  \fun (f: Before.Map)(g: After.Map) => Maps.ext (direct f g) (Composition.compose (second f) (first g))
    (\fun (k: Degrees.Degree)(h: Source.Carrier k) => Target.At[z := k].ext
      ((direct f g).apply k h) ((Composition.compose (second f) (first g)).apply k h)
      (\fun (x: P.family.Carrier k) => \refl((h).apply ((g).apply k ((f).apply k x)))));
\module At(k: Degrees.Degree);
