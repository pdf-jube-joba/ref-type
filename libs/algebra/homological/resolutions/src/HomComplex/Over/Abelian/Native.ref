\import HomZ.On[P := P, N := Target.coefficients] \as Underlying;
\import chain_complexes.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as CochainsZ;
\module At(n: Nat.Nat^) {
  \import Target.From[V := P.family.Carrier n, domain := P.family.space n] \as Native;
  \definition Carrier: \Set := Native.Carrier;
  \definition space: Modules.Space Carrier := Native.space;
  \definition ext: \forall (f, g: Carrier) -> (\forall (x: P.family.Carrier n) -> #apply{f} x = #apply{g} x) -> f = g := Native.ext;
}
\definition Carrier(n: Nat.Nat^): \Set := At[n := n].Carrier;
\definition space(n: Nat.Nat^): Modules.Space (Carrier n) := At[n := n].space;
\definition family: Cochains.Family := Cochains.Family { Carrier := Carrier, space := space };
\definition apply(n: Nat.Nat^): Carrier n -> Carrier (Nat.Nat^::succ n) := Underlying.apply n;
\definition scalar: \forall (n: Nat.Nat^)(a: R)(h: Carrier n) -> apply n (#smul{(space n)} a h) = #smul{(space (Nat.Nat^::succ n))} a (apply n h) :=
  \fun (n: Nat.Nat^)(a: R)(h: Carrier n) => At[n := Nat.Nat^::succ n].ext (apply n (#smul{(space n)} a h)) (#smul{(space (Nat.Nat^::succ n))} a (apply n h))
    (\fun (x: P.family.Carrier (Nat.Nat^::succ n)) => \refl(#smul{N.space} a (#apply{h} (#apply{P.differential} n x))));
\definition differential: Cochains.DifferentialData[family] := Cochains.DifferentialData[family] { apply := apply };
\definition complex: Cochains.Complex := Cochains.Complex {
  family := family, differential := differential,
  laws := Cochains.DifferentialLaws[family, differential] {
    addition := Underlying.addition, scalar := scalar, squareZero := Underlying.squareZero,
  }
};
\module Cohomology(n: Nat.Nat^) {
  \import Cochains.At[C := complex, k := n] \as Native;
  \import CochainsZ.At[C := Underlying.complex, k := n] \as Original;
  \definition Carrier: \Set := Native.Cohomology;
  \definition space: Modules.Space Carrier := Native.cohomologySpace;
  \definition ordinarySpace: Modules.Space Original.Cohomology := Native.cohomologySpace;
}
