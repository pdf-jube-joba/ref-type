\import ChainsZ.Prior[C := P] \as Prior;
\import HomZ.Integer[P := P, N := Target.coefficients] \as Underlying;
\module At(z: Degrees.Degree) {
  \import Target.From[V := P.family.Carrier z, domain := P.family.space z] \as Native;
  \definition Carrier: \Set := Native.Carrier;
  \definition space: Modules.Space Carrier := Native.space;
  \definition ext: \forall (f, g: Carrier) -> (\forall (x: P.family.Carrier z) -> #apply{f} x = #apply{g} x) -> f = g := Native.ext;
}
\definition Carrier(z: Degrees.Degree): \Set := At[z := z].Carrier;
\definition space(z: Degrees.Degree): Modules.Space (Carrier z) := At[z := z].space;
\definition family: CochainsR.Family := CochainsR.Family { Carrier := Carrier, space := space };
\definition apply(z: Degrees.Degree): Carrier z -> Carrier (Degrees.next z) := Underlying.apply z;
\definition scalar: \forall (z: Degrees.Degree)(a: R)(h: Carrier z) ->
  apply z (#smul{(space z)} a h) = #smul{(space (Degrees.next z))} a (apply z h) :=
  \fun (z: Degrees.Degree)(a: R)(h: Carrier z) => At[z := Degrees.next z].ext (apply z (#smul{(space z)} a h)) (#smul{(space (Degrees.next z))} a (apply z h))
    (\fun (x: P.family.Carrier (Degrees.next z)) => \refl(#smul{N.space} a (#apply{h} (Prior.value z x))));
\definition differential: CochainsR.DifferentialData[family] := CochainsR.DifferentialData[family] { apply := apply };
\definition complex: CochainsR.Complex := CochainsR.Complex {
  family := family, differential := differential,
  laws := CochainsR.DifferentialLaws[family, differential] {
    addition := Underlying.addition, scalar := scalar, squareZero := Underlying.squareZero,
  }
};
\module Cohomology(z: Degrees.Degree) {
  \import CochainsR.At[C := complex, z := z] \as Native;
  \definition Carrier: \Set := Native.Cohomology;
  \definition space: Modules.Space Carrier := Native.cohomologySpace;
  \definition ordinarySpace: Modules.Space (Underlying.Cohomology[z := z].Cohomology) := Native.cohomologySpace;
}
