\import \parent.\parent.On[P := Q] \as Source;
\import \root.HomComplex[].Over[R := R, ring := ring].Abelian[N := L] \as TargetCoefficients;
\import TargetCoefficients.On[P := P] \as Target;
\import Modules.AbelianHom[N := N].Mapping[L := L].On[u := u] \as Coefficients;
\import HomZ.IntegerMapping[P := P, Q := Q, N := coefficients, L := TargetCoefficients.coefficients].On[f := f, u := Coefficients.map] \as Underlying;
\import CochainsR.Map[C := Source.complex, D := Target.complex] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := (Underlying.map).apply, addition := (Underlying.map).addition, commutes := (Underlying.map).commutes,
  scalar := \fun (z: Degrees.Degree)(a: R)(h: Source.Carrier z) => Target.At[z := z].ext
    ((Underlying.map).apply z ((Source.space z).smul a h)) ((Target.space z).smul a ((Underlying.map).apply z h))
    (\fun (x: P.family.Carrier z) => (u).scalar a ((h).apply ((f).apply z x))),
};
\module At(z: Degrees.Degree) {
  \import Maps.At[k := z] \as Native;
  \definition induced: _ := Native.induced map;
}
