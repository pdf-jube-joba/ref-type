\import \root.HomComplex[].Over[R := R, ring := ring] \as HomComplex;
\import HomComplex.Integer[P := wholecomplex, N := coefficients] \as Whole;
\import HomComplex.Integer[P := subcomplex, N := coefficients] \as Sub;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import HomComplex.IntegerMapping[P := wholecomplex, Q := Quotient.complex, N := coefficients, L := coefficients]
  .On[f := Quotient.projection, u := Coefficients.identity] \as Inclusion;
\import HomComplex.IntegerMapping[P := subcomplex, Q := wholecomplex, N := coefficients, L := coefficients]
  .On[f := inclusionMap, u := Coefficients.identity] \as Restriction;
\import Cochains.Map[C := Hom.complex, D := Whole.complex] \as InclusionMaps;
\import Cochains.Map[C := Whole.complex, D := Sub.complex] \as RestrictionMaps;
\definition inclusion: InclusionMaps.Map := Inclusion.map;
\definition restriction: RestrictionMaps.Map := Restriction.map;
\import Cochains.ShortExact[A := Hom.complex, B := Whole.complex, C := Sub.complex] \as Exact;
\module At(z: Degrees.Degree);
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := inclusion, projection := restriction,
  injective := \fun (z: Degrees.Degree) => At[z := z].injective,
  onto := \fun (z: Degrees.Degree) => At[z := z].onto,
  zero := \fun (z: Degrees.Degree) => At[z := z].zero,
  kernelImage := \fun (z: Degrees.Degree) => At[z := z].kernelImage,
};
\module LongExact(z: Degrees.Degree) {
  \import Exact.At[s := sequence, k := z] \as Native;
  \definition connecting: _ := Native.connecting;
  \import Native.Exactness[] \as Exactness;
  \definition inclusionProjectionZero: _ := Exactness.inclusionProjectionZero;
  \definition projectionConnectingZero: _ := Exactness.projectionConnectingZero;
  \definition connectingInclusionZero: _ := Exactness.connectingInclusionZero;
  \definition exactAtSubspace: _ := Exactness.exactAtC;
  \definition exactAtRelative: _ := Exactness.exactAtALower;
  \definition exactAtSpace: _ := Exactness.exactAtB;
}
