\import \parent.\parent.Vanishing[z := z] \as Vanishing;
\import Quotient.At[k := z] \as Q;
\import Modules.Of[V := wholecomplex.family.Carrier z, space := wholecomplex.family.space z].Submodule[].Quotient[S := Q.image] \as ChainQuotient;
\import Modules.Hom[V := Q.Carrier, W := coefficients.Carrier, source := Q.space, target := coefficients.space] \as RelativeMaps;
\import Modules.Hom[V := wholecomplex.family.Carrier z, W := coefficients.Carrier, source := wholecomplex.family.space z, target := coefficients.space] \as WholeMaps;
\import Modules.Hom[V := subcomplex.family.Carrier z, W := coefficients.Carrier, source := subcomplex.family.space z, target := coefficients.space] \as SubMaps;
\import Modules.Hom[V := wholecomplex.family.Carrier z, W := coefficients.Carrier, source := wholecomplex.family.space z, target := coefficients.space]
  .Composition[U := subcomplex.family.Carrier z, domain := subcomplex.family.space z] \as Restrict;
\definition injective: \forall (h, k: Hom.Carrier z) -> (inclusion).apply z h = (inclusion).apply z k -> h = k :=
  \fun (h, k: Hom.Carrier z)(equal: _) => RelativeMaps.ext h k
    (ChainQuotient.induction (\fun (q: Q.Carrier) => (h).apply q = (k).apply q)
      (\fun (x: wholecomplex.family.Carrier z) => congr!{{Whole.Carrier z} coefficients.Carrier}
        (\fun (g: Whole.Carrier z) => (g).apply x) _ _ equal));
\definition zero: \forall (h: Hom.Carrier z) -> (restriction).apply z ((inclusion).apply z h) = (Sub.space z).zero :=
  \fun (h: Hom.Carrier z) => SubMaps.ext ((restriction).apply z ((inclusion).apply z h)) ((Sub.space z).zero)
    (\fun (x: subcomplex.family.Carrier z) => trans!{coefficients.Carrier} _ _ _
      (congr!{Q.Carrier coefficients.Carrier} ((h).apply) _ _ (Q.onImage x)) (RelativeMaps.zeroPreserved h));
\definition kernelImage: \forall (h: Whole.Carrier z) -> (restriction).apply z h = (Sub.space z).zero ->
  \exists ( k: Hom.Carrier z \where (inclusion).apply z k = h ) := \block {
  \fun (h: Whole.Carrier z)(killed: _) \then
  \let null: Vanishing.NullCochain := \into[Whole.Carrier z](h, (Vanishing.submodule).carrier) \by {
    \fun (x: subcomplex.family.Carrier z) => congr!{{Sub.Carrier z} coefficients.Carrier}
      (\fun (g: Sub.Carrier z) => (g).apply x) _ _ killed
  } \then
  \return Logic.existsIntro[Hom.Carrier z, { k: Hom.Carrier z \where (inclusion).apply z k = h }]
    (Vanishing.descend null) (Vanishing.rightInverse null)
};
\definition retraction: Modules.Hom[V := wholecomplex.family.Carrier z, W := subcomplex.family.Carrier z, source := wholecomplex.family.space z, target := subcomplex.family.space z].Map := (pair).retraction z;
\import Modules.Hom[V := subcomplex.family.Carrier z, W := coefficients.Carrier, source := subcomplex.family.space z, target := coefficients.space]
  .Composition[U := wholecomplex.family.Carrier z, domain := wholecomplex.family.space z] \as Extend;
\definition extend[h: Sub.Carrier z]: Whole.Carrier z := Extend.compose h retraction;
\definition extensionLaw: \forall (h: Sub.Carrier z) -> (restriction).apply z (extend h) = h :=
  \fun (h: Sub.Carrier z) => Sub.At[z := z].ext ((restriction).apply z (extend h)) h
    (\fun (x: subcomplex.family.Carrier z) => congr!{{subcomplex.family.Carrier z} coefficients.Carrier} ((h).apply)
      ((retraction).apply ((inclusionMap).apply z x)) x ((laws pair).leftInverse z x));
\definition onto: \forall (h: Sub.Carrier z) -> \exists ( k: Whole.Carrier z \where (restriction).apply z k = h ) :=
  \fun (h: Sub.Carrier z) => Logic.existsIntro[Whole.Carrier z, { k: Whole.Carrier z \where (restriction).apply z k = h }] (extend h) (extensionLaw h);
