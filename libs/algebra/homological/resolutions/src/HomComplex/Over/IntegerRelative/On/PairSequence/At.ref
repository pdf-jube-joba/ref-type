\import \parent.\parent.Vanishing[z := z] \as Vanishing;
\import Quotient.At[k := z] \as Q;
\import Modules.Of[V := wholecomplex.family.Carrier z, space := wholecomplex.family.space z].Submodule[].Quotient[S := Q.image] \as ChainQuotient;
\import Modules.Hom[V := Q.Carrier, W := coefficients.Carrier, source := Q.space, target := coefficients.space] \as RelativeMaps;
\import Modules.Hom[V := wholecomplex.family.Carrier z, W := coefficients.Carrier, source := wholecomplex.family.space z, target := coefficients.space] \as WholeMaps;
\import Modules.Hom[V := subcomplex.family.Carrier z, W := coefficients.Carrier, source := subcomplex.family.space z, target := coefficients.space] \as SubMaps;
\import Modules.Hom[V := wholecomplex.family.Carrier z, W := coefficients.Carrier, source := wholecomplex.family.space z, target := coefficients.space]
  .Composition[U := subcomplex.family.Carrier z, domain := subcomplex.family.space z] \as Restrict;
\definition injective: \forall (h, k: Hom.Carrier z) -> #apply{inclusion} z h = #apply{inclusion} z k -> h = k :=
  \fun (h, k: Hom.Carrier z)(equal: _) => RelativeMaps.ext h k
    (ChainQuotient.induction (\fun (q: Q.Carrier) => #apply{h} q = #apply{k} q)
      (\fun (x: wholecomplex.family.Carrier z) => congr!{{Whole.Carrier z} coefficients.Carrier}
        (\fun (g: Whole.Carrier z) => #apply{g} x) _ _ equal));
\definition zero: \forall (h: Hom.Carrier z) -> #apply{restriction} z (#apply{inclusion} z h) = #zero{(Sub.space z)} :=
  \fun (h: Hom.Carrier z) => SubMaps.ext (#apply{restriction} z (#apply{inclusion} z h)) (#zero{(Sub.space z)})
    (\fun (x: subcomplex.family.Carrier z) => trans!{coefficients.Carrier} _ _ _
      (congr!{Q.Carrier coefficients.Carrier} (#apply{h}) _ _ (Q.onImage x)) (RelativeMaps.zeroPreserved h));
\definition kernelImage: \forall (h: Whole.Carrier z) -> #apply{restriction} z h = #zero{(Sub.space z)} ->
  \exists { k: Hom.Carrier z \where #apply{inclusion} z k = h } := \block {
  \fun (h: Whole.Carrier z)(killed: _) \then
  \let null: Vanishing.NullCochain := \into[Whole.Carrier z](h, #carrier{Vanishing.submodule}) \by {
    \fun (x: subcomplex.family.Carrier z) => congr!{{Sub.Carrier z} coefficients.Carrier}
      (\fun (g: Sub.Carrier z) => #apply{g} x) _ _ killed
  } \then
  \return Logic.existsIntro[Hom.Carrier z, { k: Hom.Carrier z \where #apply{inclusion} z k = h }]
    (Vanishing.descend null) (Vanishing.rightInverse null)
};
\definition retraction: Modules.Hom[V := wholecomplex.family.Carrier z, W := subcomplex.family.Carrier z, source := wholecomplex.family.space z, target := subcomplex.family.space z].Map := #retraction{pair} z;
\import Modules.Hom[V := subcomplex.family.Carrier z, W := coefficients.Carrier, source := subcomplex.family.space z, target := coefficients.space]
  .Composition[U := wholecomplex.family.Carrier z, domain := wholecomplex.family.space z] \as Extend;
\definition extend(h: Sub.Carrier z): Whole.Carrier z := Extend.compose h retraction;
\definition extensionLaw: \forall (h: Sub.Carrier z) -> #apply{restriction} z (extend h) = h :=
  \fun (h: Sub.Carrier z) => Sub.At[z := z].ext (#apply{restriction} z (extend h)) h
    (\fun (x: subcomplex.family.Carrier z) => congr!{{subcomplex.family.Carrier z} coefficients.Carrier} (#apply{h})
      (#apply{retraction} (#apply{inclusionMap} z x)) x (#leftInverse{(laws pair)} z x));
\definition onto: \forall (h: Sub.Carrier z) -> \exists { k: Whole.Carrier z \where #apply{restriction} z k = h } :=
  \fun (h: Sub.Carrier z) => Logic.existsIntro[Whole.Carrier z, { k: Whole.Carrier z \where #apply{restriction} z k = h }] (extend h) (extensionLaw h);
