\import std.Logic[].Proposition[] \as Logic;
\definition inclusionMap: Inclusions.Map := #inclusion{pair};
\import IntegerChains.Quotient[C := subcomplex, D := wholecomplex].On[f := inclusionMap] \as Quotient;
\import \root.HomComplex[].Over[R := R, ring := ring].Integer[P := Quotient.complex, N := coefficients] \as Hom;
\import chain_complexes.Integer[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\definition complex: Cochains.Complex := Hom.complex;
\definition Carrier(z: Degrees.Degree): \Set := Hom.Carrier z;
\definition space(z: Degrees.Degree): Modules.Space (Carrier z) := Hom.space z;
\module Vanishing(z: Degrees.Degree);
\module PairSequence;
