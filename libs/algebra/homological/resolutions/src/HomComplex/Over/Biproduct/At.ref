\use std.Logic[].Equality[].eq_reason_in;
\import Cochains.At[C := Left.complex, z := z] \as LeftH;
\import Cochains.At[C := Right.complex, z := z] \as RightH;
\import Cochains.At[C := Sum.complex, z := z] \as SumH;
\import Cochains.Map[C := Sum.complex, D := Left.complex].At[k := z] \as ProjectionLeft;
\import Cochains.Map[C := Sum.complex, D := Right.complex].At[k := z] \as ProjectionRight;
\import Cochains.Map[C := Left.complex, D := Sum.complex].At[k := z] \as InjectionLeft;
\import Cochains.Map[C := Right.complex, D := Sum.complex].At[k := z] \as InjectionRight;
\import Modules.Biproduct[V := LeftH.Cohomology, W := RightH.Cohomology, left := LeftH.cohomologySpace, right := RightH.cohomologySpace] \as Pair;
\import std.Data[].Pair[].Prop[A := LeftH.Cohomology, B := RightH.Cohomology] \as Pairs;
\definition Carrier: \Set := Pair.Carrier;
\definition space: Modules.Space Carrier := Pair.space;
\definition forward: Modules.Hom[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Map :=
  Pair.Universal[U := SumH.Cohomology, domain := SumH.cohomologySpace].pair (ProjectionLeft.induced firstProjection) (ProjectionRight.induced secondProjection);
\definition backward: Modules.Hom[V := Pair.Carrier, W := SumH.Cohomology, source := Pair.space, target := SumH.cohomologySpace].Map :=
  Pair.Copair[U := SumH.Cohomology, target := SumH.cohomologySpace].copair (InjectionLeft.induced firstInjection) (InjectionRight.induced secondInjection);
\definition cycles[x: LeftH.Closed][y: RightH.Closed]: SumH.Closed :=
  (SumH.cycleSpace).add ((InjectionLeft.cyclesMap firstInjection).apply x) ((InjectionRight.cyclesMap secondInjection).apply y);
\definition forwardOnClass: \forall (x: SumH.Closed) -> (forward).apply (SumH.classOf x) =
  Pair.make (LeftH.classOf ((ProjectionLeft.cyclesMap firstProjection).apply x)) (RightH.classOf ((ProjectionRight.cyclesMap secondProjection).apply x)) :=
  \fun (x: SumH.Closed) => Pairs.ext _ _ (ProjectionLeft.onClass firstProjection x) (ProjectionRight.onClass secondProjection x);
\definition backwardOnClasses: \forall (x: LeftH.Closed)(y: RightH.Closed) ->
  (backward).apply (Pair.make (LeftH.classOf x) (RightH.classOf y)) = SumH.classOf (cycles x y) :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => trans!{SumH.Cohomology} _ _ _
    (congr!{SumH.Cohomology SumH.Cohomology SumH.Cohomology} ((SumH.cohomologySpace).add) _ _ _ _ (InjectionLeft.onClass firstInjection x) (InjectionRight.onClass secondInjection y))
    (sym!{SumH.Cohomology} _ _ ((SumH.classLinear).addition ((InjectionLeft.cyclesMap firstInjection).apply x) ((InjectionRight.cyclesMap secondInjection).apply y)));
\definition leftInverse: \forall (q: SumH.Cohomology) -> (backward).apply ((forward).apply q) = q :=
  SumH.classInduction (\fun (q: SumH.Cohomology) => (backward).apply ((forward).apply q) = q)
    (\fun (x: SumH.Closed) => eq_reason_in!{SumH.Cohomology _
      "=" _ "by" { congr!{Pair.Carrier SumH.Cohomology} ((backward).apply) _ _ (forwardOnClass x) }
      "=" _ "by" { backwardOnClasses ((ProjectionLeft.cyclesMap firstProjection).apply x) ((ProjectionRight.cyclesMap secondProjection).apply x) }
      "=" _ "by" { congr!{SumH.Closed SumH.Cohomology} SumH.classOf (cycles ((ProjectionLeft.cyclesMap firstProjection).apply x) ((ProjectionRight.cyclesMap secondProjection).apply x)) x (reconstruction z x) }
    });
\import Modules.Laws[V := Left.Carrier z, space := Left.space z] \as LeftLaws;
\import algebra.Group[].Of[Carrier := Left.Carrier z, group := LeftLaws.additive] \as LeftGroup;
\import Modules.Laws[V := Right.Carrier z, space := Right.space z] \as RightLaws;
\import algebra.Group[].Of[Carrier := Right.Carrier z, group := RightLaws.additive] \as RightGroup;
\definition firstSum: \forall (x: LeftH.Closed)(y: RightH.Closed) -> (firstProjection).apply z (cycles x y) = x :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => eq_reason_in!{{Left.Carrier z} _
    "=" _ "by" { (firstProjection).addition z ((firstInjection).apply z x) ((secondInjection).apply z y) }
    "=" _ "by" { congr!{{Left.Carrier z} {Left.Carrier z} {Left.Carrier z}} LeftGroup.add _ _ _ _ (firstRoundtrip z x) (firstCross z y) }
    "=" _ "by" { LeftGroup.zeroRight x }
  };
\definition secondSum: \forall (x: LeftH.Closed)(y: RightH.Closed) -> (secondProjection).apply z (cycles x y) = y :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => eq_reason_in!{{Right.Carrier z} _
    "=" _ "by" { (secondProjection).addition z ((firstInjection).apply z x) ((secondInjection).apply z y) }
    "=" _ "by" { congr!{{Right.Carrier z} {Right.Carrier z} {Right.Carrier z}} RightGroup.add _ _ _ _ (secondCross z x) (secondRoundtrip z y) }
    "=" _ "by" { RightGroup.zeroLeft y }
  };
\definition rightOnClasses: \forall (x: LeftH.Closed)(y: RightH.Closed) ->
  (forward).apply ((backward).apply (Pair.make (LeftH.classOf x) (RightH.classOf y))) = Pair.make (LeftH.classOf x) (RightH.classOf y) :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => eq_reason_in!{Pair.Carrier _
    "=" _ "by" { congr!{SumH.Cohomology Pair.Carrier} ((forward).apply) _ _ (backwardOnClasses x y) }
    "=" _ "by" { forwardOnClass (cycles x y) }
    "=" _ "by" { Pairs.ext _ _ (congr!{LeftH.Closed LeftH.Cohomology} LeftH.classOf ((ProjectionLeft.cyclesMap firstProjection).apply (cycles x y)) x (firstSum x y)) (congr!{RightH.Closed RightH.Cohomology} RightH.classOf ((ProjectionRight.cyclesMap secondProjection).apply (cycles x y)) y (secondSum x y)) }
  };
\definition rightOnPair: \forall (a: LeftH.Cohomology)(b: RightH.Cohomology) -> (forward).apply ((backward).apply (Pair.make a b)) = Pair.make a b :=
  LeftH.classInduction (\fun (a: LeftH.Cohomology) => \forall (b: RightH.Cohomology) -> (forward).apply ((backward).apply (Pair.make a b)) = Pair.make a b)
    (\fun (x: LeftH.Closed) => RightH.classInduction (\fun (b: RightH.Cohomology) => (forward).apply ((backward).apply (Pair.make (LeftH.classOf x) b)) = Pair.make (LeftH.classOf x) b) (rightOnClasses x));
\definition rightInverse: \forall (q: Pair.Carrier) -> (forward).apply ((backward).apply q) = q :=
  \fun (q: Pair.Carrier) => \idelim Pair.make (Pair.first q) (Pair.second q) = q \with y: Pair.Carrier => (forward).apply ((backward).apply y) = y \by {
    base: rightOnPair (Pair.first q) (Pair.second q), equality: Pairs.eta q
  };
\definition isomorphism: Modules.Isomorphism[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Isomorphism :=
  Modules.Isomorphism[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  };
