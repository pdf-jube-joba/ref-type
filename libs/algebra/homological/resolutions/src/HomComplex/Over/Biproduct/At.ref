\import Cochains.At[C := Left.complex, z := z] \as LeftH;
\import Cochains.At[C := Right.complex, z := z] \as RightH;
\import Cochains.At[C := Sum.complex, z := z] \as SumH;
\import Cochains.Map[C := Sum.complex, D := Left.complex].At[k := z] \as ProjectionLeft;
\import Cochains.Map[C := Sum.complex, D := Right.complex].At[k := z] \as ProjectionRight;
\import Cochains.Map[C := Left.complex, D := Sum.complex].At[k := z] \as InjectionLeft;
\import Cochains.Map[C := Right.complex, D := Sum.complex].At[k := z] \as InjectionRight;
\import Modules.Biproduct[V := LeftH.Cohomology, W := RightH.Cohomology, left := LeftH.cohomologySpace, right := RightH.cohomologySpace] \as Pair;
\import std.Data[].Pair[].Prop[A := LeftH.Cohomology, B := RightH.Cohomology] \as Pairs;
\definition Carrier: \Set := Pair.Carrier;
\definition space: Modules.Space Carrier := Pair.space;
\definition forward: Modules.Hom[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Map :=
  Pair.Universal[U := SumH.Cohomology, domain := SumH.cohomologySpace].pair (ProjectionLeft.induced firstProjection) (ProjectionRight.induced secondProjection);
\definition backward: Modules.Hom[V := Pair.Carrier, W := SumH.Cohomology, source := Pair.space, target := SumH.cohomologySpace].Map :=
  Pair.Copair[U := SumH.Cohomology, target := SumH.cohomologySpace].copair (InjectionLeft.induced firstInjection) (InjectionRight.induced secondInjection);
\definition cycles(x: LeftH.Closed)(y: RightH.Closed): SumH.Closed :=
  #add{SumH.cycleSpace} (#apply{(InjectionLeft.cyclesMap firstInjection)} x) (#apply{(InjectionRight.cyclesMap secondInjection)} y);
\definition forwardOnClass: \forall (x: SumH.Closed) -> #apply{forward} (SumH.classOf x) =
  Pair.make (LeftH.classOf (#apply{(ProjectionLeft.cyclesMap firstProjection)} x)) (RightH.classOf (#apply{(ProjectionRight.cyclesMap secondProjection)} x)) :=
  \fun (x: SumH.Closed) => Pairs.ext _ _ (ProjectionLeft.onClass firstProjection x) (ProjectionRight.onClass secondProjection x);
\definition backwardOnClasses: \forall (x: LeftH.Closed)(y: RightH.Closed) ->
  #apply{backward} (Pair.make (LeftH.classOf x) (RightH.classOf y)) = SumH.classOf (cycles x y) :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => trans!{SumH.Cohomology} _ _ _
    (congr2!{SumH.Cohomology SumH.Cohomology SumH.Cohomology} (#add{SumH.cohomologySpace}) _ _ _ _ (InjectionLeft.onClass firstInjection x) (InjectionRight.onClass secondInjection y))
    (sym!{SumH.Cohomology} _ _ (#addition{SumH.classLinear} (#apply{(InjectionLeft.cyclesMap firstInjection)} x) (#apply{(InjectionRight.cyclesMap secondInjection)} y)));
\definition leftInverse: \forall (q: SumH.Cohomology) -> #apply{backward} (#apply{forward} q) = q :=
  SumH.classInduction (\fun (q: SumH.Cohomology) => #apply{backward} (#apply{forward} q) = q)
    (\fun (x: SumH.Closed) => trans!{SumH.Cohomology} _ _ _
      (congr!{Pair.Carrier SumH.Cohomology} (#apply{backward}) _ _ (forwardOnClass x))
      (trans!{SumH.Cohomology} _ _ _ (backwardOnClasses (#apply{(ProjectionLeft.cyclesMap firstProjection)} x) (#apply{(ProjectionRight.cyclesMap secondProjection)} x))
        (congr!{SumH.Closed SumH.Cohomology} SumH.classOf (cycles (#apply{(ProjectionLeft.cyclesMap firstProjection)} x) (#apply{(ProjectionRight.cyclesMap secondProjection)} x)) x (reconstruction z x))));
\import Modules.Laws[V := Left.Carrier z, space := Left.space z] \as LeftLaws;
\import algebra.Group[].Of[Carrier := Left.Carrier z, group := LeftLaws.additive] \as LeftGroup;
\import Modules.Laws[V := Right.Carrier z, space := Right.space z] \as RightLaws;
\import algebra.Group[].Of[Carrier := Right.Carrier z, group := RightLaws.additive] \as RightGroup;
\definition firstSum: \forall (x: LeftH.Closed)(y: RightH.Closed) -> #apply{firstProjection} z (cycles x y) = x :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => trans!{{Left.Carrier z}} _ _ _
    (#addition{firstProjection} z (#apply{firstInjection} z x) (#apply{secondInjection} z y))
    (trans!{{Left.Carrier z}} _ _ _
      (congr2!{{Left.Carrier z} {Left.Carrier z} {Left.Carrier z}} LeftGroup.add _ _ _ _ (firstRoundtrip z x) (firstCross z y)) (LeftGroup.zeroRight x));
\definition secondSum: \forall (x: LeftH.Closed)(y: RightH.Closed) -> #apply{secondProjection} z (cycles x y) = y :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => trans!{{Right.Carrier z}} _ _ _
    (#addition{secondProjection} z (#apply{firstInjection} z x) (#apply{secondInjection} z y))
    (trans!{{Right.Carrier z}} _ _ _
      (congr2!{{Right.Carrier z} {Right.Carrier z} {Right.Carrier z}} RightGroup.add _ _ _ _ (secondCross z x) (secondRoundtrip z y)) (RightGroup.zeroLeft y));
\definition rightOnClasses: \forall (x: LeftH.Closed)(y: RightH.Closed) ->
  #apply{forward} (#apply{backward} (Pair.make (LeftH.classOf x) (RightH.classOf y))) = Pair.make (LeftH.classOf x) (RightH.classOf y) :=
  \fun (x: LeftH.Closed)(y: RightH.Closed) => trans!{Pair.Carrier} _ _ _
    (congr!{SumH.Cohomology Pair.Carrier} (#apply{forward}) _ _ (backwardOnClasses x y))
    (trans!{Pair.Carrier} _ _ _ (forwardOnClass (cycles x y))
      (Pairs.ext _ _ (congr!{LeftH.Closed LeftH.Cohomology} LeftH.classOf (#apply{(ProjectionLeft.cyclesMap firstProjection)} (cycles x y)) x (firstSum x y)) (congr!{RightH.Closed RightH.Cohomology} RightH.classOf (#apply{(ProjectionRight.cyclesMap secondProjection)} (cycles x y)) y (secondSum x y))));
\definition rightOnPair: \forall (a: LeftH.Cohomology)(b: RightH.Cohomology) -> #apply{forward} (#apply{backward} (Pair.make a b)) = Pair.make a b :=
  LeftH.classInduction (\fun (a: LeftH.Cohomology) => \forall (b: RightH.Cohomology) -> #apply{forward} (#apply{backward} (Pair.make a b)) = Pair.make a b)
    (\fun (x: LeftH.Closed) => RightH.classInduction (\fun (b: RightH.Cohomology) => #apply{forward} (#apply{backward} (Pair.make (LeftH.classOf x) b)) = Pair.make (LeftH.classOf x) b) (rightOnClasses x));
\definition rightInverse: \forall (q: Pair.Carrier) -> #apply{forward} (#apply{backward} q) = q :=
  \fun (q: Pair.Carrier) => \idelim Pair.make (Pair.first q) (Pair.second q) = q \with y: Pair.Carrier => #apply{forward} (#apply{backward} y) = y \by {
    base: rightOnPair (Pair.first q) (Pair.second q), equality: Pairs.eta q
  };
\definition isomorphism: Modules.Isomorphism[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Isomorphism :=
  Modules.Isomorphism[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  };
