\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := IntegerRing.ring] \as ChainsZ;
\import chain_complexes.Integer[] \as Degrees;
\import Degrees.Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as CochainsR;
\import \root.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing] \as HomZ;
\import Modules.AbelianHom[N := N] \as Target;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as IntegerModules;
\definition coefficients: IntegerModules.Bundle := Target.coefficients;
\module On(P: ChainsZ.Complex);
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := IntegerRing.ring] \as NonnegativeChains;
\module Native(P: NonnegativeChains.Complex);
\module Mapping(P, Q: ChainsZ.Complex, L: Modules.Bundle) {
  \import ChainsZ.Map[C := P, D := Q] \as ChainMaps;
  \import Modules.Hom[V := N.Carrier, W := L.Carrier, source := N.space, target := L.space] \as CoefficientMaps;
  \module On(f: ChainMaps.Map, u: CoefficientMaps.Map);
}
\module NativeMapping(P, Q: NonnegativeChains.Complex, L: Modules.Bundle) {
  \import NonnegativeChains.Map[C := P, D := Q] \as ChainMaps;
  \import Modules.Hom[V := N.Carrier, W := L.Carrier, source := N.space, target := L.space] \as CoefficientMaps;
  \module On(f: ChainMaps.Map, u: CoefficientMaps.Map);
}
