\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Existential;
\import \parent.At[k := Nat.Nat^::succ n] \as Current;
\import Cochains.At[C := Source.complex, k := Nat.Nat^::succ n] \as SourceH;
\import Cochains.At[C := Target.complex, k := Nat.Nat^::succ n] \as TargetH;
\import Modules.Hom[V := P.family.Carrier n, W := Q.family.Carrier (Nat.Nat^::succ n), source := P.family.space n, target := Q.family.space (Nat.Nat^::succ n)] \as HomotopyMaps;
\import Modules.Hom[V := Q.family.Carrier (Nat.Nat^::succ n), W := N.Carrier, source := Q.family.space (Nat.Nat^::succ n), target := N.space].Composition[U := P.family.Carrier n, domain := P.family.space n] \as Composition;
\import algebra.Group[].Of[Carrier := N.Carrier, group := Modules.Laws[V := N.Carrier, space := N.space].additive] \as Group;
\definition witness[f, g: ChainMaps.Map][h: Homotopies.Homotopy f g][x: SourceH.CycleCarrier]: Target.Carrier n :=
  Composition.compose x (HomotopyMaps.Map { apply := h.apply n, addition := h.addition n, scalar := h.scalar n });
\definition lift: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: SourceH.CycleCarrier) ->
  Target.apply n (witness f g h x) = Current.difference f g x :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: SourceH.CycleCarrier) => Target.At[n := Nat.Nat^::succ n].ext
    (Target.apply n (witness f g h x)) (Current.difference f g x)
    (\fun (y: P.family.Carrier (Nat.Nat^::succ n)) => sym!{N.Carrier} _ _ (eq_reason_in!{N.Carrier _
      "=" _ "by" { Current.evaluateDifference f g x y }
      "=" _ "by" { congr!{{Q.family.Carrier (Nat.Nat^::succ n)} N.Carrier} (x.apply) _ _ (h.successorEquation n y) }
      "=" _ "by" { x.addition (Q.differential.apply (Nat.Nat^::succ n) (h.apply (Nat.Nat^::succ n) y)) (h.apply n (P.differential.apply n y)) }
      "=" _ "by" { congr!{N.Carrier N.Carrier} (\fun (z: N.Carrier) => Group.add z (x.apply (h.apply n (P.differential.apply n y)))) _ _
              (Current.closedEvaluation x (h.apply (Nat.Nat^::succ n) y)) }
      "=" _ "by" { Group.zeroLeft (x.apply (h.apply n (P.differential.apply n y))) }
    }));
\definition boundary: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: SourceH.CycleCarrier) ->
  \In[Target.Carrier (Nat.Nat^::succ n)] (TargetH.Boundaries (Nat.Nat^::succ n)) (Current.difference f g x) :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: SourceH.CycleCarrier) =>
    Existential.existsIntro[Target.Carrier n, { y: Target.Carrier n \where Target.apply n y = Current.difference f g x }] (witness f g h x)
    (lift f g h x);
\definition onCohomology: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(q: SourceH.Cohomology) ->
  (Maps.At[k := Nat.Nat^::succ n].induced (map f)).apply q = (Maps.At[k := Nat.Nat^::succ n].induced (map g)).apply q :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g) => Current.equality f g (boundary f g h);
