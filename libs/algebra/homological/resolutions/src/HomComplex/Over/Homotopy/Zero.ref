\import \parent.At[k := Nat.Nat^::zero] \as Current;
\import Cochains.At[C := Source.complex, k := Nat.Nat^::zero] \as SourceH;
\import Cochains.At[C := Target.complex, k := Nat.Nat^::zero] \as TargetH;
\definition boundary: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: SourceH.CycleCarrier) ->
  \In[Target.Carrier Nat.Nat^::zero] (TargetH.Boundaries Nat.Nat^::zero) (Current.difference f g x) :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: SourceH.CycleCarrier) => Target.At[n := Nat.Nat^::zero].ext
    (Current.difference f g x) (Target.space Nat.Nat^::zero).zero
    (\fun (y: P.family.Carrier Nat.Nat^::zero) => trans!{N.Carrier} _ _ _ (Current.evaluateDifference f g x y)
      (trans!{N.Carrier} _ _ _
        (congr!{{Q.family.Carrier Nat.Nat^::zero} N.Carrier} (x.apply) _ _ (h.zeroEquation y))
        (Current.closedEvaluation x (h.apply Nat.Nat^::zero y))));
\definition onCohomology: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(q: SourceH.Cohomology) ->
  (Maps.At[k := Nat.Nat^::zero].induced (map f)).apply q = (Maps.At[k := Nat.Nat^::zero].induced (map g)).apply q :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g) => Current.equality f g (boundary f g h);
