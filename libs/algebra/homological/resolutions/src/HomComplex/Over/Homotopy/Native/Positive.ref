\import \parent.\parent.At[k := Nat.Nat^::succ n] \as Current;
\import \parent.At[n := n] \as Lower;
\import \parent.At[n := Nat.Nat^::succ n] \as Higher;
\import Modules.Laws[V := N.Carrier, space := N.space] \as Values;
\import algebra.Group[].Of[Carrier := N.Carrier, group := Values.additive] \as Group;
\definition law: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: Source.Carrier (Nat.Nat^::succ n)) -> Current.difference f g x =
  #add{(Target.space (Nat.Nat^::succ n))} (Target.apply n (#apply{(Lower.map f g h)} x)) (#apply{(Higher.map f g h)} (Source.apply (Nat.Nat^::succ n) x)) :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: Source.Carrier (Nat.Nat^::succ n)) => Target.At[n := Nat.Nat^::succ n].ext (Current.difference f g x)
    (#add{(Target.space (Nat.Nat^::succ n))} (Target.apply n (#apply{(Lower.map f g h)} x)) (#apply{(Higher.map f g h)} (Source.apply (Nat.Nat^::succ n) x)))
    (\fun (y: P.family.Carrier (Nat.Nat^::succ n)) => trans!{N.Carrier} _ _ _ (Current.evaluateDifference f g x y)
      (trans!{N.Carrier} _ _ _ (congr!{{Q.family.Carrier (Nat.Nat^::succ n)} N.Carrier} (#apply{x}) _ _ (#successorEquation{h} n y))
        (trans!{N.Carrier} _ _ _ (#addition{x} (#apply{Q.differential} (Nat.Nat^::succ n) (#apply{h} (Nat.Nat^::succ n) y)) (#apply{h} n (#apply{P.differential} n y)))
          (Group.comm (#apply{x} (#apply{Q.differential} (Nat.Nat^::succ n) (#apply{h} (Nat.Nat^::succ n) y))) (#apply{x} (#apply{h} n (#apply{P.differential} n y)))))));
