\import \parent.\parent.At[k := Nat.Nat^::zero] \as Current;
\import \parent.At[n := Nat.Nat^::zero] \as Term;
\definition law: \forall (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: Source.Carrier Nat.Nat^::zero) -> Current.difference f g x = #apply{(Term.map f g h)} (Source.apply Nat.Nat^::zero x) :=
  \fun (f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g)(x: Source.Carrier Nat.Nat^::zero) => Target.At[n := Nat.Nat^::zero].ext (Current.difference f g x) (#apply{(Term.map f g h)} (Source.apply Nat.Nat^::zero x))
    (\fun (y: P.family.Carrier Nat.Nat^::zero) => trans!{N.Carrier} _ _ _ (Current.evaluateDifference f g x y)
      (congr!{{Q.family.Carrier Nat.Nat^::zero} N.Carrier} (#apply{x}) _ _ (#zeroEquation{h} y)));
