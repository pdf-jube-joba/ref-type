\import Cochains.Homotopy[C := Source.complex, D := Target.complex] \as CochainHomotopy;
\module At(n: Nat.Nat^);
\definition data(f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g): CochainHomotopy.Data := \fun (n: Nat.Nat^) => At[n := n].map f g h;
\module Zero;
\module Positive(n: Nat.Nat^);
\definition laws(f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g): CochainHomotopy.Laws[map f, map g, data f g h] := CochainHomotopy.Laws[map f, map g, data f g h] {
  degreeZero := Zero[].law f g h,
  positive := \fun (n: Nat.Nat^) => Positive[n := n].law f g h,
};
\definition homotopy(f, g: ChainMaps.Map)(h: Homotopies.Homotopy f g): CochainHomotopy.Homotopy (map f) (map g) :=
  \into[CochainHomotopy.Data](data f g h, CochainHomotopy.Homotopy (map f) (map g)) \by { laws f g h };
