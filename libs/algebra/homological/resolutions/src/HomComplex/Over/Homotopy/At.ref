\import Cochains.At[C := Source.complex, k := k] \as SourceH;
\import Cochains.At[C := Target.complex, k := k] \as TargetH;
\import Maps.At[k := k] \as Induced;
\import Modules.Hom[V := Q.family.Carrier k, W := N.Carrier, source := Q.family.space k, target := N.space] \as CoefficientMaps;
\import Modules.Hom[V := P.family.Carrier k, W := N.Carrier, source := P.family.space k, target := N.space] \as Output;
\definition difference(f, g: ChainMaps.Map)(x: Source.Carrier k): Target.Carrier k :=
  Output.plus ((map f).apply k x) (Output.negative ((map g).apply k x));
\definition evaluateDifference: \forall (f, g: ChainMaps.Map)(x: Source.Carrier k)(y: P.family.Carrier k) ->
  (difference f g x).apply y = x.apply ((Q.family.space k).add (f.apply k y) ((Q.family.space k).neg (g.apply k y))) :=
  \fun (f, g: ChainMaps.Map)(x: Source.Carrier k)(y: P.family.Carrier k) => sym!{N.Carrier} _ _
    (CoefficientMaps.differencePreserved x (f.apply k y) (g.apply k y));
\definition closedEvaluation: \forall (x: SourceH.CycleCarrier)(y: Q.family.Carrier (Nat.Nat^::succ k)) ->
  x.apply (Q.differential.apply k y) = N.space.zero :=
  \fun (x: SourceH.CycleCarrier)(y: Q.family.Carrier (Nat.Nat^::succ k)) =>
    congr!{{Source.Carrier (Nat.Nat^::succ k)} N.Carrier} (\fun (v: Source.Carrier (Nat.Nat^::succ k)) => v.apply y) _ _
      (\bysub(Source.Carrier k, SourceH.cycles.carrier, x));
\definition equality: \forall (f, g: ChainMaps.Map) ->
  (\forall (x: SourceH.CycleCarrier) -> \In[Target.Carrier k] (TargetH.Boundaries k) (difference f g x)) ->
  \forall (q: SourceH.Cohomology) -> (Induced.induced (map f)).apply q = (Induced.induced (map g)).apply q :=
  \fun (f, g: ChainMaps.Map)(boundary: \forall (x: SourceH.CycleCarrier) -> \In[Target.Carrier k] (TargetH.Boundaries k) (difference f g x)) =>
    SourceH.classInduction (\fun (q: SourceH.Cohomology) => (Induced.induced (map f)).apply q = (Induced.induced (map g)).apply q)
      (\fun (x: SourceH.CycleCarrier) => trans!{TargetH.Cohomology} _ _ _ (Induced.onClass (map f) x)
        (trans!{TargetH.Cohomology} _ _ _ (TargetH.classEqual ((Induced.cyclesMap (map f)).apply x) ((Induced.cyclesMap (map g)).apply x) (boundary x))
          (sym!{TargetH.Cohomology} _ _ (Induced.onClass (map g) x))));
