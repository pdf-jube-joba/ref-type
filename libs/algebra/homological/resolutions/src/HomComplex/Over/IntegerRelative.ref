\import chain_complexes.Chain[] \as Degrees;
\import IntegerChains.Map[C := subcomplex, D := wholecomplex] \as Inclusions;
\structure Data: \Set {
  inclusion: Inclusions.Map,
  retraction: \forall (z: Degrees.Degree) -> Modules.Hom[V := wholecomplex.family.Carrier z, W := subcomplex.family.Carrier z, source := wholecomplex.family.space z, target := subcomplex.family.space z].Map,
}
\structure Laws[data: Data]: \Prop {
  leftInverse: \forall (z: Degrees.Degree)(x: subcomplex.family.Carrier z) -> #apply{(data.retraction z)} (#apply{data.inclusion} z x) = x,
}
\definition SplitInjection: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition laws(pair: SplitInjection): Laws[pair] := \bysub(Data, { data: Data \where Laws[data] }, pair);
\module On(pair: SplitInjection, coefficients: Modules.Bundle);
