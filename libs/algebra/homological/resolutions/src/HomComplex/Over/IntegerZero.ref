\import chain_complexes.Chain[] \as Degrees;
\import chain_complexes.Integer[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import \parent.Integer[P := P, N := N] \as Hom;
\import IntegerChains.End[C := P] \as ChainIdentity;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import \parent.IntegerMapping[P := P, Q := P, N := N, L := N] \as Actions;
\import Cochains.Map[C := Hom.complex, D := Hom.complex] \as Maps;
\import Cochains.End[C := Hom.complex] \as Identity;
\definition map: Maps.Map := Actions.On[f := ChainIdentity.zeroMap, u := Coefficients.identity].map;
\definition law: map = Identity.zeroMap := Maps.ext map Identity.zeroMap
  (\fun (k: Degrees.Degree)(h: Hom.Carrier k) => Hom.At[z := k].ext ((map).apply k h) ((Hom.space k).zero)
    (\fun (x: P.family.Carrier k) => Hom.At[z := k].zeroPreserved h));
\module At(k: Degrees.Degree) {
  \import Cochains.At[C := Hom.complex, z := k] \as H;
  \definition onCohomology: \forall (q: H.Cohomology) -> (Maps.At[k := k].induced map).apply q = (H.cohomologySpace).zero :=
    \fun (q: H.Cohomology) => trans!{H.Cohomology} _ _ _
      (congr!{Maps.Map H.Cohomology} (\fun (f: Maps.Map) => (Maps.At[k := k].induced f).apply q) _ _ law) (Identity.At[k := k].zeroOnCohomology q);
}
