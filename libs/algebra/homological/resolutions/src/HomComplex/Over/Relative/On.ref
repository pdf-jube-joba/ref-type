\import std.Arithmetic[].Int[] \as I;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import Chains.ZeroExtension[C := subcomplex] \as SubspaceExtension;
\import Chains.ZeroExtension[C := wholecomplex] \as WholeExtension;
\import Chains.Map[C := subcomplex, D := wholecomplex].ZeroExtension[f := pair.inclusion] \as Inclusion;
\import IntegerChains.Map[C := SubspaceExtension.complex, D := WholeExtension.complex] \as Inclusions;
\definition inclusionMap: Inclusions.Map := Inclusion.map;
\import IntegerChains.Quotient[C := SubspaceExtension.complex, D := WholeExtension.complex].On[f := inclusionMap] \as Quotient;
\import \root.HomComplex[].Over[R := R, ring := ring].Integer[P := Quotient.complex, N := coefficients] \as Hom;
\import chain_complexes.Integer[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\definition complex: Cochains.Complex := Hom.complex;
\definition Carrier(z: I.Int^): \Set := Hom.Carrier z;
\definition space(z: I.Int^): Modules.Space (Carrier z) := Hom.space z;
\module Vanishing(z: I.Int^);
\module PairSequence;
\module At(z: I.Int^) {
  \import Hom.Cohomology[z := z] \as Native;
  \definition Carrier: \Set := Native.Cohomology;
  \definition space: Modules.Space Carrier := Native.cohomologySpace;
  \definition classOf: Native.Closed -> Carrier := Native.classOf;
}
