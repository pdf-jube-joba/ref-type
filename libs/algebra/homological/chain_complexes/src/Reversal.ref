\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import chain_complexes.Integer[] \as Integers;
\definition Degree: \Set := Integers.Degree;
\definition next: Degree -> Degree := Integers.next;
\definition previous: Degree -> Degree := Integers.previous;
\module Over(R: \Set, ring: Ring.Ring[R]) {
  \import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
  \import chain_complexes.Integer[].Over[R := R, ring := ring] \as Cochains;
  \import chain_complexes.Chain[].Over[R := R, ring := ring] \as Chains;
  \module ToChain(C: Cochains.Complex);
}
