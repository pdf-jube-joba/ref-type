\definition sourceCarrier(k: Degree): \Set := C.family.Carrier k;
\definition targetCarrier(k: Degree): \Set := D.family.Carrier k;
\structure Data: \Set {
  apply: \forall (k: Degree) -> C.family.Carrier k -> D.family.Carrier k,
}
\structure Laws[data: Data]: \Prop {
  addition: \forall (k: Degree)(x, y: C.family.Carrier k) ->
    data.apply k ((C.family.space k).add x y) = (D.family.space k).add (data.apply k x) (data.apply k y),
  scalar: \forall (k: Degree)(a: R)(x: C.family.Carrier k) ->
    data.apply k ((C.family.space k).smul a x) = (D.family.space k).smul a (data.apply k x),
  commutes: \forall (k: Degree)(x: C.family.Carrier k) ->
    D.differential.apply k (data.apply k x) = data.apply (previous k) (C.differential.apply k x),
}
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\import \parent.Prior[C := C] \as SourcePrior;
\import \parent.Prior[C := D] \as TargetPrior;
\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\definition priorCommutes: \forall (z: Degree)(f: Map)(x: C.family.Carrier (next z)) ->
  TargetPrior.value z (f.apply (next z) x) = f.apply z (SourcePrior.value z x) :=
  \fun (z: Degree)(f: Map)(x: C.family.Carrier (next z)) => trans!{{D.family.Carrier z}} _ _ _
    (congr!{{D.family.Carrier (previous (next z))} {D.family.Carrier z}}
      (Transport.cast D.family.Carrier (previous (next z)) z (previousNext z)) _ _ (f.commutes (next z) x))
    (Transport.natural C.family.Carrier D.family.Carrier (f.apply) (previous (next z)) z (previousNext z)
      (C.differential.apply (next z) x));
\definition dataExt: \forall (f, g: Data) -> f.apply = g.apply -> f = g :=
  \induction (f: Data) \return \forall (g: Data) -> f.apply = g.apply -> f = g \with {
    | # : \fun (f: \forall (k: Degree) -> C.family.Carrier k -> D.family.Carrier k) =>
      \induction (g: Data) \return f = g.apply -> Data::# f = g \with {
        | # : \fun (g: \forall (k: Degree) -> C.family.Carrier k -> D.family.Carrier k)(equal: f = g) =>
          congr!{{\forall (k: Degree) -> C.family.Carrier k -> D.family.Carrier k} Data} (\fun (h: \forall (k: Degree) -> C.family.Carrier k -> D.family.Carrier k) => Data::# h) f g equal
      }
  };
\definition ext: \forall (f, g: Map) -> (\forall (k: Degree)(x: C.family.Carrier k) -> f.apply k x = g.apply k x) -> f = g :=
  \fun (f, g: Map)(same: \forall (k: Degree)(x: C.family.Carrier k) -> f.apply k x = g.apply k x) =>
    dataExt f g (\axiom:funext(f.apply, g.apply, \fun (k: Degree) => \axiom:funext(f.apply k, g.apply k, same k)));
\module At(k: Degree);
\definition QuasiIsomorphism(f: Map): \Prop := \forall (k: Degree) -> At[k := k].Bijective[f];
\module Composition(B: Complex) {
  \import \parent.\parent.Map[C := B, D := C] \as Before;
  \import \parent.\parent.Map[C := B, D := D] \as Result;
  \definition compose(f: Map)(g: Before.Map): Result.Map := Result.Map {
    apply := \fun (k: Degree)(x: B.family.Carrier k) => f.apply k (g.apply k x),
    addition := \fun (k: Degree)(x, y: B.family.Carrier k) => trans!{{D.family.Carrier k}}
      _ _ _
      (congr!{{C.family.Carrier k} {D.family.Carrier k}} (f.apply k)
        (g.apply k ((B.family.space k).add x y)) ((C.family.space k).add (g.apply k x) (g.apply k y)) (g.addition k x y))
      (f.addition k (g.apply k x) (g.apply k y)),
    scalar := \fun (k: Degree)(a: R)(x: B.family.Carrier k) => trans!{{D.family.Carrier k}}
      _ _ _
      (congr!{{C.family.Carrier k} {D.family.Carrier k}} (f.apply k)
        (g.apply k ((B.family.space k).smul a x)) ((C.family.space k).smul a (g.apply k x)) (g.scalar k a x))
      (f.scalar k a (g.apply k x)),
    commutes := \fun (k: Degree)(x: B.family.Carrier k) => trans!{{D.family.Carrier (previous k)}}
      _ _ _
      (f.commutes k (g.apply k x))
      (congr!{{C.family.Carrier (previous k)} {D.family.Carrier (previous k)}} (f.apply (previous k))
        (C.differential.apply k (g.apply k x)) (g.apply (previous k) (B.differential.apply k x)) (g.commutes k x)),
  };
  \module At(k: Degree) {
    \import \parent.\parent.\parent.At[C := B, z := k] \as Source;
    \import \parent.\parent.\parent.At[C := D, z := k] \as Target;
    \import \parent.\parent.\parent.At[C := C, z := k] \as Middle;
    \import \parent.\parent.At[k := k] \as After;
    \import Before.At[k := k] \as BeforeMap;
    \import Result.At[k := k] \as ResultMap;
    \definition compositionOnHomology: \forall (f: Map)(g: Before.Map)(h: Source.Homology) ->
      (ResultMap.induced (compose f g)).apply h = (After.induced f).apply ((BeforeMap.induced g).apply h) :=
      \fun (f: Map)(g: Before.Map) => Source.classInduction
        (\fun (h: Source.Homology) => (ResultMap.induced (compose f g)).apply h = (After.induced f).apply ((BeforeMap.induced g).apply h))
        (\fun (x: Source.Cycle) => eq_reason!{
          {(ResultMap.induced (compose f g)).apply (Source.classOf x)}
          "=" {Target.classOf ((ResultMap.cyclesMap (compose f g)).apply x)} "by" {ResultMap.onClass (compose f g) x}
          "=" {Target.classOf ((After.cyclesMap f).apply ((BeforeMap.cyclesMap g).apply x))}
          "by" {\refl(Target.classOf ((After.cyclesMap f).apply ((BeforeMap.cyclesMap g).apply x)))}
          "=" {(After.induced f).apply (Middle.classOf ((BeforeMap.cyclesMap g).apply x))}
          "by" {sym!{{Target.Homology}}
            _ _
            (After.onClass f ((BeforeMap.cyclesMap g).apply x))}
          "=" {(After.induced f).apply ((BeforeMap.induced g).apply (Source.classOf x))}
          "by" {congr!{{Middle.Homology} {Target.Homology}} ((After.induced f).apply)
            (Middle.classOf ((BeforeMap.cyclesMap g).apply x)) ((BeforeMap.induced g).apply (Source.classOf x))
            (sym!{{Middle.Homology}} _ _ (BeforeMap.onClass g x))}
        });
  }

}

\module Kernel(f: Map);
