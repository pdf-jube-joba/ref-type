\import \parent.\parent.\parent.Map[C := C, D := C] \as SourceMaps;
\import \parent.\parent.\parent.Map[C := D, D := D] \as TargetMaps;
\import SourceHomotopy.Reflexive[] \as SourceZero;
\import TargetHomotopy.Reflexive[] \as TargetZero;
\definition source: SourceMaps.Map := LeftComposition.compose e.backward e.forward;
\definition target: TargetMaps.Map := RightComposition.compose e.forward e.backward;
\definition leftInverse: source = SourceEnd.identity := SourceMaps.ext source SourceEnd.identity (e).leftInverse;
\definition rightInverse: target = TargetEnd.identity := TargetMaps.ext target TargetEnd.identity (e).rightInverse;
\definition data: Data := Data { forward := e.forward, backward := e.backward, left := SourceZero.data, right := TargetZero.data };
\definition equivalence: Equivalence := \into[Data](data, Equivalence) \by {
  Laws[data] {
    left := SourceHomotopy.replacementLaws source source source SourceEnd.identity SourceZero.data (\refl(source)) leftInverse (SourceZero.laws source),
    right := TargetHomotopy.replacementLaws target target target TargetEnd.identity TargetZero.data (\refl(target)) rightInverse (TargetZero.laws target),
  }
};
