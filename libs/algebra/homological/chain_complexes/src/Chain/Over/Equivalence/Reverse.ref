\import \parent.\parent.Equivalence[C := D, D := C] \as Opposite;
\definition data(e: Equivalence): Opposite.Data := Opposite.Data {
  forward := e.backward, backward := e.forward, left := e.right, right := e.left,
};
\definition laws(e: Equivalence): Laws[e] := \bysub(Data, { data: Data \where Laws[data] }, e);
\definition apply(e: Equivalence): Opposite.Equivalence := \into[Opposite.Data](data e, Opposite.Equivalence) \by {
  Opposite.Laws[data e] { left := #right{(laws e)}, right := #left{(laws e)} }
};
