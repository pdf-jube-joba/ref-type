\import MapsHomotopy.Postcompose[E := C].With[f := e.forward, g := f, h := h, k := e.backward] \as Left;
\import MapsHomotopy.Precompose[B := D].With[f := e.forward, g := f, h := h, k := e.backward] \as Right;
\definition left: SourceHomotopy.Homotopy (LeftComposition.compose e.backward f) SourceEnd.identity :=
  SourceHomotopy.Transitive[].homotopy (LeftComposition.compose e.backward f) (LeftComposition.compose e.backward e.forward) SourceEnd.identity
    (SourceHomotopy.Reverse[].homotopy (LeftComposition.compose e.backward e.forward) (LeftComposition.compose e.backward f) Left.homotopy)
    (leftHomotopy e);
\definition right: TargetHomotopy.Homotopy (RightComposition.compose f e.backward) TargetEnd.identity :=
  TargetHomotopy.Transitive[].homotopy (RightComposition.compose f e.backward) (RightComposition.compose e.forward e.backward) TargetEnd.identity
    (TargetHomotopy.Reverse[].homotopy (RightComposition.compose e.forward e.backward) (RightComposition.compose f e.backward) Right.homotopy)
    (rightHomotopy e);
\definition data: Data := Data { forward := f, backward := e.backward, left := left, right := right };
\definition equivalence: Equivalence := \into[Data](data, Equivalence) \by {
  Laws[data] {
    left := \bysub(SourceHomotopy.Data, { h: SourceHomotopy.Data \where SourceHomotopy.Laws[LeftComposition.compose e.backward f, SourceEnd.identity, h] }, left),
    right := \bysub(TargetHomotopy.Data, { h: TargetHomotopy.Data \where TargetHomotopy.Laws[RightComposition.compose f e.backward, TargetEnd.identity, h] }, right),
  }
};
