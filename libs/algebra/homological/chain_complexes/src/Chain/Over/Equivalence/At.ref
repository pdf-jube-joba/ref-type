\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.At[C := C, z := k] \as Source;
\import \parent.\parent.At[C := D, z := k] \as Target;
\import Forward.At[k := k] \as ForwardMap;
\import Backward.At[k := k] \as BackwardMap;
\import LeftComposition.At[k := k] \as LeftLaw;
\import RightComposition.At[k := k] \as RightLaw;
\import SourceHomotopy.At[k := k] \as SourceLaw;
\import TargetHomotopy.At[k := k] \as TargetLaw;
\import SourceEnd.At[k := k] \as SourceIdentity;
\import TargetEnd.At[k := k] \as TargetIdentity;
\import \parent.\parent.Map[C := C, D := C].At[k := k] \as SourceMaps;
\import \parent.\parent.Map[C := D, D := D].At[k := k] \as TargetMaps;
\definition leftInverse: \forall (e: Equivalence)(x: Source.Homology) ->
  (BackwardMap.induced e.backward).apply ((ForwardMap.induced e.forward).apply x) = x :=
  \fun (e: Equivalence)(x: Source.Homology) => eq_reason_in!{Source.Homology _
    "=" _ "by" { sym!{Source.Homology} _ _ (LeftLaw.compositionOnHomology e.backward e.forward x) }
    "=" _ "by" { SourceLaw.onHomology (LeftComposition.compose e.backward e.forward) SourceEnd.identity (leftHomotopy e) x }
    "=" _ "by" { SourceIdentity.identityOnHomology x }
  };
\definition rightInverse: \forall (e: Equivalence)(x: Target.Homology) ->
  (ForwardMap.induced e.forward).apply ((BackwardMap.induced e.backward).apply x) = x :=
  \fun (e: Equivalence)(x: Target.Homology) => eq_reason_in!{Target.Homology _
    "=" _ "by" { sym!{Target.Homology} _ _ (RightLaw.compositionOnHomology e.forward e.backward x) }
    "=" _ "by" { TargetLaw.onHomology (RightComposition.compose e.forward e.backward) TargetEnd.identity (rightHomotopy e) x }
    "=" _ "by" { TargetIdentity.identityOnHomology x }
  };
\import Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Iso;
\definition isomorphism[e: Equivalence]: Iso.Isomorphism := Iso.Isomorphism {
  forward := ForwardMap.induced e.forward, backward := BackwardMap.induced e.backward,
  leftInverse := leftInverse e, rightInverse := rightInverse e,
};
\definition bijective[e: Equivalence]: ForwardMap.Bijective[e.forward] := ForwardMap.Bijective[e.forward] {
  injective := \fun (x, y: Source.Homology)(same: (ForwardMap.induced e.forward).apply x = (ForwardMap.induced e.forward).apply y) => eq_reason_in!{Source.Homology _
    "=" _ "by" { sym!{Source.Homology} _ _ (leftInverse e x) }
    "=" _ "by" { congr!{Target.Homology Source.Homology} ((BackwardMap.induced e.backward).apply) _ _ same }
    "=" _ "by" { leftInverse e y }
  },
  onto := \fun (y: Target.Homology) => Logic.existsIntro[Source.Homology, { x: Source.Homology \where (ForwardMap.induced e.forward).apply x = y }]
    ((BackwardMap.induced e.backward).apply y) (rightInverse e y),
};
