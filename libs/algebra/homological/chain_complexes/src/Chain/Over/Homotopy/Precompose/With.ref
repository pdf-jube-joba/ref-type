\module Component(k0: Degree) {
  \import Modules.Hom[V := C.family.Carrier k0, W := D.family.Carrier (next k0), source := C.family.space k0, target := D.family.space (next k0)] \as Shift;
  \definition shift: Shift.Map := Shift.Map { apply := #apply{h} k0, addition := #addition{h} k0, scalar := #scalar{h} k0 };
  \import Before.At[k := k0] \as BeforeDegree;
  \import Shift.Composition[U := B.family.Carrier k0, domain := B.family.space k0] \as Compose;
  \definition map: Modules.Hom[V := B.family.Carrier k0, W := D.family.Carrier (next k0), source := B.family.space k0, target := D.family.space (next k0)].Map := Compose.compose shift (BeforeDegree.linear k);
}

\definition data: Result.Data := Result.Data { apply := \fun (k0: Degree) => #apply{Component[k0 := k0].map} };
\definition equation(k0: Degree)(x: B.family.Carrier k0):
  #add{(D.family.space k0)} (#apply{f} k0 (#apply{k} k0 x)) (#neg{(D.family.space k0)} (#apply{g} k0 (#apply{k} k0 x))) =
  #add{(D.family.space k0)} (TargetPrior.value k0 (#apply{data} k0 x)) (Result.shifted data k0 (#apply{B.differential} k0 x)) :=
  trans!{{D.family.Carrier k0}} _ _ _ (#equation{h} k0 (#apply{k} k0 x))
    (congr!{{C.family.Carrier (previous k0)} {D.family.Carrier k0}}
      (\fun (y: C.family.Carrier (previous k0)) => #add{(D.family.space k0)} (TargetPrior.value k0 (#apply{data} k0 x)) (shifted h k0 y))
      _ _ (#commutes{k} k0 x));
\definition homotopy: Result.Homotopy (Composition.compose f k) (Composition.compose g k) := \into[Result.Data](data, Result.Homotopy (Composition.compose f k) (Composition.compose g k)) \by {
  Result.Laws[Composition.compose f k, Composition.compose g k, data] {
    addition := \fun (k0: Degree) => #addition{Component[k0 := k0].map},
    scalar := \fun (k0: Degree) => #scalar{Component[k0 := k0].map},
    equation := equation,
  }
};
