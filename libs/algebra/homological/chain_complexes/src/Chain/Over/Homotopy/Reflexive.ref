\module At(k: Degree);
\definition data: Data := Data { apply := \fun (k: Degree) => #apply{At[k := k].zero} };
\definition shiftedZero(k: Degree)(x: C.family.Carrier (previous k)): shifted data k x = #zero{(D.family.space k)} :=
  Transport.pointNatural D.family.Carrier (\fun (i: Degree) => #zero{(D.family.space i)}) (next (previous k)) k (nextPrevious k);
\definition laws(f: Maps.Map): Laws[f, f, data] := Laws[f, f, data] {
  addition := \fun (k: Degree) => #addition{At[k := k].zero},
  scalar := \fun (k: Degree) => #scalar{At[k := k].zero},
  equation := \fun (k: Degree)(x: C.family.Carrier k) =>
    trans!{{D.family.Carrier k}} _ _ _ (At[k := k].inverse (#apply{f} k x))
      (sym!{{D.family.Carrier k}} _ _
        (trans!{{D.family.Carrier k}} _ _ _
          (congr2!{{D.family.Carrier k} {D.family.Carrier k} {D.family.Carrier k}} (#add{(D.family.space k)}) _ _ _ _
            (At[k := k].boundaryZero) (shiftedZero k (#apply{C.differential} k x)))
          (At[k := k].zeroAdd))),
};
\definition homotopy(f: Maps.Map): Homotopy f f := \into[Data](data, Homotopy f f) \by { laws f };
