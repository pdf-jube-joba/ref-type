\module At(k: Degree);
\definition data: Data := Data { apply := \fun (k: Degree) => (At[k := k].zero).apply };
\definition shiftedZero[k: Degree][x: C.family.Carrier (previous k)]: shifted data k x = (D.family.space k).zero :=
  Transport.pointNatural D.family.Carrier (\fun (i: Degree) => (D.family.space i).zero) (next (previous k)) k (nextPrevious k);
\definition laws[f: Maps.Map]: Laws[f, f, data] := Laws[f, f, data] {
  addition := \fun (k: Degree) => (At[k := k].zero).addition,
  scalar := \fun (k: Degree) => (At[k := k].zero).scalar,
  equation := \fun (k: Degree)(x: C.family.Carrier k) =>
    trans!{{D.family.Carrier k}} _ _ _ (At[k := k].inverse ((f).apply k x))
      (sym!{{D.family.Carrier k}} _ _
        (trans!{{D.family.Carrier k}} _ _ _
          (congr!{{D.family.Carrier k} {D.family.Carrier k} {D.family.Carrier k}} ((D.family.space k).add) _ _ _ _
            (At[k := k].boundaryZero) (shiftedZero k ((C.differential).apply k x)))
          (At[k := k].zeroAdd))),
};
\definition homotopy[f: Maps.Map]: Homotopy f f := \into[Data](data, Homotopy f f) \by { laws f };
