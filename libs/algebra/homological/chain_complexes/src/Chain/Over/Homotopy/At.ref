\import \parent.\parent.At[C := C, z := k] \as Source;
\import \parent.\parent.At[C := D, z := k] \as Target;
\import Maps.At[k := k] \as Induced;
\import Modules.Laws[V := D.family.Carrier k, space := D.family.space k] \as TargetLaws;
\import algebra.Group[].Of[Carrier := D.family.Carrier k, group := TargetLaws.additive] \as Group;
\import Modules.Hom[V := C.family.Carrier (previous k), W := D.family.Carrier (next (previous k)), source := C.family.space (previous k), target := D.family.space (next (previous k))] \as ShiftMaps;
\definition linear(f, g: Maps.Map)(h: Homotopy f g): ShiftMaps.Map := ShiftMaps.Map {
  apply := h.apply (previous k), addition := h.addition (previous k), scalar := h.scalar (previous k),
};
\definition shiftedZero: \forall (f, g: Maps.Map)(h: Homotopy f g) ->
  shifted h k ((C.family.space (previous k)).zero) = (D.family.space k).zero :=
  \fun (f, g: Maps.Map)(h: Homotopy f g) => trans!{{D.family.Carrier k}} _ _ _
    (congr!{{D.family.Carrier (next (previous k))} {D.family.Carrier k}}
      (Transport.cast D.family.Carrier (next (previous k)) k (nextPrevious k)) _ _ (ShiftMaps.zeroPreserved (linear f g h)))
    (Transport.pointNatural D.family.Carrier (\fun (z: Degree) => (D.family.space z).zero) (next (previous k)) k (nextPrevious k));
\definition onCycle: \forall (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) ->
  (D.family.space k).add (f.apply k x) ((D.family.space k).neg (g.apply k x)) = TargetPrior.value k (h.apply k x) :=
  \fun (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) => trans!{{D.family.Carrier k}} _ _ _ (h.equation k x)
    (trans!{{D.family.Carrier k}} _ _ _
      (congr!{{D.family.Carrier k} {D.family.Carrier k}} ((D.family.space k).add (TargetPrior.value k (h.apply k x))) _ _
        (trans!{{D.family.Carrier k}} _ _ _
          (congr!{{C.family.Carrier (previous k)} {D.family.Carrier k}} (shifted h k) _ _
            (\bysub(C.family.Carrier k, Source.cycles.carrier, x))) (shiftedZero f g h)))
      (Group.zeroRight (TargetPrior.value k (h.apply k x))));
\import Modules.Of[V := D.family.Carrier k, space := D.family.space k].Submodule[] \as Submodules;
\import Submodules.Image[U := D.family.Carrier (next k), source := D.family.space (next k)] \as Images;
\definition differenceBoundary: \forall (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) ->
  Submodules.Member Target.boundaries ((D.family.space k).add (f.apply k x) ((D.family.space k).neg (g.apply k x))) :=
  \fun (f, g: Maps.Map)(h: Homotopy f g)(x: Source.Cycle) =>
    \idelim Target.prior.apply (h.apply k x) = (D.family.space k).add (f.apply k x) ((D.family.space k).neg (g.apply k x))
      \with y: D.family.Carrier k => Submodules.Member Target.boundaries y \by {
        base: Images.member Target.prior (h.apply k x), equality: sym!{{D.family.Carrier k}} _ _ (onCycle f g h x)
      };
\definition onHomology: \forall (f, g: Maps.Map)(h: Homotopy f g)(q: Source.Homology) ->
  (Induced.induced f).apply q = (Induced.induced g).apply q :=
  \fun (f, g: Maps.Map)(h: Homotopy f g) => Source.classInduction
    (\fun (q: Source.Homology) => (Induced.induced f).apply q = (Induced.induced g).apply q)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Induced.onClass f x)
      (trans!{Target.Homology} _ _ _
        (Target.classEqual ((Induced.cyclesMap f).apply x) ((Induced.cyclesMap g).apply x) (differenceBoundary f g h x))
        (sym!{Target.Homology} _ _ (Induced.onClass g x))));
