\module Component(k0: Degree) {
  \import Modules.Hom[V := C.family.Carrier k0, W := D.family.Carrier (next k0), source := C.family.space k0, target := D.family.space (next k0)] \as Shift;
  \definition firstMap: Shift.Map := Shift.Map { apply := #apply{first} k0, addition := #addition{first} k0, scalar := #scalar{first} k0 };
  \definition secondMap: Shift.Map := Shift.Map { apply := #apply{second} k0, addition := #addition{second} k0, scalar := #scalar{second} k0 };
  \definition map: Shift.Map := Shift.plus firstMap (Shift.negative secondMap);
  \import Modules.Laws[V := D.family.Carrier k0, space := D.family.space k0] \as Values;
  \import algebra.Group[].Of[Carrier := D.family.Carrier k0, group := Values.additive] \as Group;
  \definition difference: D.family.Carrier k0 -> D.family.Carrier k0 -> D.family.Carrier k0 := Group.difference;
  \definition cancel(a, b, c: D.family.Carrier k0): difference b c = difference (difference a c) (difference a b) := sym!{{D.family.Carrier k0}} _ _ (Group.differenceCommonLeft a b c);
  \definition differenceAdd(a, b, c, d: D.family.Carrier k0): difference (#add{(D.family.space k0)} a b) (#add{(D.family.space k0)} c d) = #add{(D.family.space k0)} (difference a c) (difference b d) := Group.differenceAdd a b c d;
  \import Modules.Hom[V := D.family.Carrier (next k0), W := D.family.Carrier k0, source := D.family.space (next k0), target := D.family.space k0] \as Boundary;
  \definition boundary: Boundary.Map := Boundary.Map { apply := TargetPrior.value k0, addition := TargetPrior.addition k0, scalar := TargetPrior.scalar k0 };
  \definition boundaryDifference(a, b: D.family.Carrier (next k0)): TargetPrior.value k0 (#add{(D.family.space (next k0))} a (#neg{(D.family.space (next k0))} b)) = difference (TargetPrior.value k0 a) (TargetPrior.value k0 b) := Boundary.differencePreserved boundary a b;
}

\definition data: Data := Data { apply := \fun (k0: Degree) => #apply{Component[k0 := k0].map} };
\definition shiftedDifference(k0: Degree)(x: C.family.Carrier (previous k0)):
  shifted data k0 x = Component[k0 := k0].difference (shifted first k0 x) (shifted second k0 x) :=
  Transport.binaryNatural D.family.Carrier D.family.Carrier D.family.Carrier
    (\fun (i: Degree) => Component[k0 := i].difference)
    (next (previous k0)) k0 (nextPrevious k0) (#apply{first} (previous k0) x) (#apply{second} (previous k0) x);
\definition equation(k0: Degree)(x: C.family.Carrier k0):
  #add{(D.family.space k0)} (#apply{u} k0 x) (#neg{(D.family.space k0)} (#apply{g} k0 x)) =
  #add{(D.family.space k0)} (TargetPrior.value k0 (#apply{data} k0 x)) (shifted data k0 (#apply{C.differential} k0 x)) :=
  trans!{{D.family.Carrier k0}} _ _ _ (Component[k0 := k0].cancel (#apply{f} k0 x) (#apply{u} k0 x) (#apply{g} k0 x))
    (trans!{{D.family.Carrier k0}} _ _ _
      (congr2!{{D.family.Carrier k0} {D.family.Carrier k0} {D.family.Carrier k0}} (Component[k0 := k0].difference) _ _ _ _ (#equation{first} k0 x) (#equation{second} k0 x))
      (trans!{{D.family.Carrier k0}} _ _ _
        (Component[k0 := k0].differenceAdd
          (TargetPrior.value k0 (#apply{first} k0 x)) (shifted first k0 (#apply{C.differential} k0 x))
          (TargetPrior.value k0 (#apply{second} k0 x)) (shifted second k0 (#apply{C.differential} k0 x)))
        (congr2!{{D.family.Carrier k0} {D.family.Carrier k0} {D.family.Carrier k0}} (#add{(D.family.space k0)}) _ _ _ _
          (sym!{{D.family.Carrier k0}} _ _ (Component[k0 := k0].boundaryDifference (#apply{first} k0 x) (#apply{second} k0 x)))
          (sym!{{D.family.Carrier k0}} _ _ (shiftedDifference k0 (#apply{C.differential} k0 x))))));
\definition homotopy: Homotopy u g := \into[Data](data, Homotopy u g) \by {
  Laws[u, g, data] {
    addition := \fun (k0: Degree) => #addition{Component[k0 := k0].map},
    scalar := \fun (k0: Degree) => #scalar{Component[k0 := k0].map},
    equation := equation,
  }
};
