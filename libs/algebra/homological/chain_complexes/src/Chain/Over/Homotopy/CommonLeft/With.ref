\use std.Logic[].Equality[].eq_reason_in;
\module Component(k0: Degree) {
  \import Modules.Hom[V := C.family.Carrier k0, W := D.family.Carrier (next k0), source := C.family.space k0, target := D.family.space (next k0)] \as Shift;
  \definition firstMap: Shift.Map := Shift.Map { apply := (first).apply k0, addition := (first).addition k0, scalar := (first).scalar k0 };
  \definition secondMap: Shift.Map := Shift.Map { apply := (second).apply k0, addition := (second).addition k0, scalar := (second).scalar k0 };
  \definition map: Shift.Map := Shift.plus firstMap (Shift.negative secondMap);
  \import Modules.Laws[V := D.family.Carrier k0, space := D.family.space k0] \as Values;
  \import algebra.Group[].Of[Carrier := D.family.Carrier k0, group := Values.additive] \as Group;
  \definition difference: D.family.Carrier k0 -> D.family.Carrier k0 -> D.family.Carrier k0 := Group.difference;
  \definition cancel[a, b, c: D.family.Carrier k0]: difference b c = difference (difference a c) (difference a b) := sym!{{D.family.Carrier k0}} _ _ (Group.differenceCommonLeft a b c);
  \definition differenceAdd[a, b, c, d: D.family.Carrier k0]: difference ((D.family.space k0).add a b) ((D.family.space k0).add c d) = (D.family.space k0).add (difference a c) (difference b d) := Group.differenceAdd a b c d;
  \import Modules.Hom[V := D.family.Carrier (next k0), W := D.family.Carrier k0, source := D.family.space (next k0), target := D.family.space k0] \as Boundary;
  \definition boundary: Boundary.Map := Boundary.Map { apply := TargetPrior.value k0, addition := TargetPrior.addition k0, scalar := TargetPrior.scalar k0 };
  \definition boundaryDifference[a, b: D.family.Carrier (next k0)]: TargetPrior.value k0 ((D.family.space (next k0)).add a ((D.family.space (next k0)).neg b)) = difference (TargetPrior.value k0 a) (TargetPrior.value k0 b) := Boundary.differencePreserved boundary a b;
}

\definition data: Data := Data { apply := \fun (k0: Degree) => (Component[k0 := k0].map).apply };
\definition shiftedDifference[k0: Degree][x: C.family.Carrier (previous k0)]:
  shifted data k0 x = Component[k0 := k0].difference (shifted first k0 x) (shifted second k0 x) :=
  Transport.binaryNatural D.family.Carrier D.family.Carrier D.family.Carrier
    (\fun (i: Degree) => Component[k0 := i].difference)
    (next (previous k0)) k0 (nextPrevious k0) ((first).apply (previous k0) x) ((second).apply (previous k0) x);
\definition equation[k0: Degree][x: C.family.Carrier k0]:
  (D.family.space k0).add ((u).apply k0 x) ((D.family.space k0).neg ((g).apply k0 x)) =
  (D.family.space k0).add (TargetPrior.value k0 ((data).apply k0 x)) (shifted data k0 ((C.differential).apply k0 x)) :=
  eq_reason_in!{{D.family.Carrier k0} _
    "=" _ "by" { Component[k0 := k0].cancel ((f).apply k0 x) ((u).apply k0 x) ((g).apply k0 x) }
    "=" _ "by" { congr!{{D.family.Carrier k0} {D.family.Carrier k0} {D.family.Carrier k0}} (Component[k0 := k0].difference) _ _ _ _ ((first).equation k0 x) ((second).equation k0 x) }
    "=" _ "by" { Component[k0 := k0].differenceAdd
          (TargetPrior.value k0 ((first).apply k0 x)) (shifted first k0 ((C.differential).apply k0 x))
          (TargetPrior.value k0 ((second).apply k0 x)) (shifted second k0 ((C.differential).apply k0 x)) }
    "=" _ "by" { congr!{{D.family.Carrier k0} {D.family.Carrier k0} {D.family.Carrier k0}} ((D.family.space k0).add) _ _ _ _
          (sym!{{D.family.Carrier k0}} _ _ (Component[k0 := k0].boundaryDifference ((first).apply k0 x) ((second).apply k0 x)))
          (sym!{{D.family.Carrier k0}} _ _ (shiftedDifference k0 ((C.differential).apply k0 x))) }
  };
\definition homotopy: Homotopy u g := \into[Data](data, Homotopy u g) \by {
  Laws[u, g, data] {
    addition := \fun (k0: Degree) => (Component[k0 := k0].map).addition,
    scalar := \fun (k0: Degree) => (Component[k0 := k0].map).scalar,
    equation := equation,
  }
};
