\module Component(k0: Degree) {
  \import Modules.Hom[V := C.family.Carrier k0, W := D.family.Carrier (next k0), source := C.family.space k0, target := D.family.space (next k0)] \as Shift;
  \definition shift: Shift.Map := Shift.Map { apply := (h).apply k0, addition := (h).addition k0, scalar := (h).scalar k0 };
  \import After.At[k := next k0] \as AfterDegree;
  \import Modules.Hom[V := D.family.Carrier (next k0), W := E.family.Carrier (next k0), source := D.family.space (next k0), target := E.family.space (next k0)].Composition[U := C.family.Carrier k0, domain := C.family.space k0] \as Compose;
  \definition map: Modules.Hom[V := C.family.Carrier k0, W := E.family.Carrier (next k0), source := C.family.space k0, target := E.family.space (next k0)].Map := Compose.compose (AfterDegree.linear k) shift;
  \import Modules.Hom[V := D.family.Carrier k0, W := E.family.Carrier k0, source := D.family.space k0, target := E.family.space k0] \as Output;
  \import After.At[k := k0] \as Current;
  \definition difference[x, y: D.family.Carrier k0]: (k).apply k0 ((D.family.space k0).add x ((D.family.space k0).neg y)) = (E.family.space k0).add ((k).apply k0 x) ((E.family.space k0).neg ((k).apply k0 y)) := Output.differencePreserved (Current.linear k) x y;
}

\import \parent.\parent.\parent.Prior[C := E] \as FinalPrior;
\definition data: Result.Data := Result.Data { apply := \fun (k0: Degree) => (Component[k0 := k0].map).apply };
\definition shiftedLaw[k0: Degree][x: C.family.Carrier (previous k0)]:
  (k).apply k0 (shifted h k0 x) = Result.shifted data k0 x :=
  sym!{{E.family.Carrier k0}} _ _
    (Transport.natural D.family.Carrier E.family.Carrier ((k).apply) (next (previous k0)) k0 (nextPrevious k0) ((h).apply (previous k0) x));
\definition equation[k0: Degree][x: C.family.Carrier k0]:
  (E.family.space k0).add ((k).apply k0 ((f).apply k0 x)) ((E.family.space k0).neg ((k).apply k0 ((g).apply k0 x))) =
  (E.family.space k0).add (FinalPrior.value k0 ((data).apply k0 x)) (Result.shifted data k0 ((C.differential).apply k0 x)) :=
  trans!{{E.family.Carrier k0}} _ _ _ (sym!{{E.family.Carrier k0}} _ _ (Component[k0 := k0].difference ((f).apply k0 x) ((g).apply k0 x)))
    (trans!{{E.family.Carrier k0}} _ _ _
      (congr!{{D.family.Carrier k0} {E.family.Carrier k0}} ((k).apply k0) _ _ ((h).equation k0 x))
      (trans!{{E.family.Carrier k0}} _ _ _
        ((k).addition k0 (TargetPrior.value k0 ((h).apply k0 x)) (shifted h k0 ((C.differential).apply k0 x)))
        (congr2!{{E.family.Carrier k0} {E.family.Carrier k0} {E.family.Carrier k0}} ((E.family.space k0).add) _ _ _ _
          (sym!{{E.family.Carrier k0}} _ _ (After.priorCommutes k0 k ((h).apply k0 x)))
          (shiftedLaw k0 ((C.differential).apply k0 x)))));
\definition homotopy: Result.Homotopy (Composition.compose k f) (Composition.compose k g) := \into[Result.Data](data, Result.Homotopy (Composition.compose k f) (Composition.compose k g)) \by {
  Result.Laws[Composition.compose k f, Composition.compose k g, data] {
    addition := \fun (k0: Degree) => (Component[k0 := k0].map).addition,
    scalar := \fun (k0: Degree) => (Component[k0 := k0].map).scalar,
    equation := equation,
  }
};
