\import Modules.Hom[V := C.family.Carrier k, W := D.family.Carrier (next k), source := C.family.space k, target := D.family.space (next k)] \as Shift;
\import Modules.Hom[V := D.family.Carrier (next k), W := D.family.Carrier k, source := D.family.space (next k), target := D.family.space k] \as Boundary;
\import Modules.Laws[V := D.family.Carrier k, space := D.family.space k] \as Values;
\import algebra.Group[].Of[Carrier := D.family.Carrier k, group := Values.additive] \as Group;
\definition zero: Shift.Map := Shift.zeroMap;
\definition boundary: Boundary.Map := Boundary.Map { apply := TargetPrior.value k, addition := TargetPrior.addition k, scalar := TargetPrior.scalar k };
\definition boundaryZero: TargetPrior.value k (#zero{(D.family.space (next k))}) = #zero{(D.family.space k)} := Boundary.zeroPreserved boundary;
\definition inverse(x: D.family.Carrier k): #add{(D.family.space k)} x (#neg{(D.family.space k)} x) = #zero{(D.family.space k)} := Group.inverseRight x;
\definition zeroAdd: #add{(D.family.space k)} (#zero{(D.family.space k)}) (#zero{(D.family.space k)}) = #zero{(D.family.space k)} := Group.zeroLeft Values.zero;
