\definition apply(z: Degree)(x: C.family.Carrier z): C.family.Carrier (previous z) :=
  ((change (previous z)).forward).apply (C.differential.apply z (((change z).backward).apply x));
\definition linear(z: Degree): Modules.Hom[V := C.family.Carrier z, W := C.family.Carrier (previous z), source := C.family.space z, target := C.family.space (previous z)].Map :=
  Modules.Hom[V := C.family.Carrier (previous z), W := C.family.Carrier (previous z), source := C.family.space (previous z), target := C.family.space (previous z)].Composition[U := C.family.Carrier z, domain := C.family.space z].compose
    (change (previous z)).forward
    (Modules.Hom[V := C.family.Carrier z, W := C.family.Carrier (previous z), source := C.family.space z, target := C.family.space (previous z)].Composition[U := C.family.Carrier z, domain := C.family.space z].compose
      (\parent.\parent.At[C := C, z := z].differential) (change z).backward);
\definition squareZero: \forall (z: Degree)(x: C.family.Carrier z) ->
  apply (previous z) (apply z x) = (C.family.space (previous (previous z))).zero :=
  \fun (z: Degree)(x: C.family.Carrier z) => trans!{{C.family.Carrier (previous (previous z))}} _ _ _
    (congr!{{C.family.Carrier (previous z)} {C.family.Carrier (previous (previous z))}}
      (\fun (y: C.family.Carrier (previous z)) => ((change (previous (previous z))).forward).apply (C.differential.apply (previous z) y))
      _ _
      ((change (previous z)).leftInverse (C.differential.apply z (((change z).backward).apply x))))
    (trans!{{C.family.Carrier (previous (previous z))}} _ _ _
      (congr!{{C.family.Carrier (previous (previous z))} {C.family.Carrier (previous (previous z))}} (((change (previous (previous z))).forward).apply)
        _ _ (C.laws.squareZero z (((change z).backward).apply x)))
      (Modules.Hom[V := C.family.Carrier (previous (previous z)), W := C.family.Carrier (previous (previous z)), source := C.family.space (previous (previous z)), target := C.family.space (previous (previous z))].zeroPreserved (change (previous (previous z))).forward));
\definition differential: DifferentialData[C.family] := DifferentialData[C.family] { apply := apply };
\definition complex: Complex := Complex {
  family := C.family, differential := differential,
  laws := DifferentialLaws[C.family, differential] {
    addition := \fun (z: Degree) => (linear z).addition, scalar := \fun (z: Degree) => (linear z).scalar, squareZero := squareZero,
  },
};
\import \parent.\parent.Map[C := C, D := complex] \as Forward;
\import \parent.\parent.Map[C := complex, D := C] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (z: Degree) => ((change z).forward).apply,
  addition := \fun (z: Degree) => ((change z).forward).addition,
  scalar := \fun (z: Degree) => ((change z).forward).scalar,
  commutes := \fun (z: Degree)(x: C.family.Carrier z) => congr!{{C.family.Carrier z} {C.family.Carrier (previous z)}}
    (\fun (y: C.family.Carrier z) => ((change (previous z)).forward).apply (C.differential.apply z y))
    (((change z).backward).apply (((change z).forward).apply x)) x ((change z).leftInverse x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (z: Degree) => ((change z).backward).apply,
  addition := \fun (z: Degree) => ((change z).backward).addition,
  scalar := \fun (z: Degree) => ((change z).backward).scalar,
  commutes := \fun (z: Degree)(x: C.family.Carrier z) => sym!{{C.family.Carrier (previous z)}}
    _ _
    ((change (previous z)).leftInverse (C.differential.apply z (((change z).backward).apply x))),
};
\definition leftInverse: \forall (z: Degree)(x: C.family.Carrier z) -> backward.apply z (forward.apply z x) = x :=
  \fun (z: Degree) => (change z).leftInverse;
\definition rightInverse: \forall (z: Degree)(x: C.family.Carrier z) -> forward.apply z (backward.apply z x) = x :=
  \fun (z: Degree) => (change z).rightInverse;

\import \parent.\parent.Isomorphism[C := C, D := complex] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism { forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse };
