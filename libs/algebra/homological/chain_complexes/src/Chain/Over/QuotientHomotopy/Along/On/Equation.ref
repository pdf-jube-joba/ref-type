\import Source.At[k := k] \as SourceAt;
\import Target.At[k := k] \as TargetAt;
\import Chains.Prior[C := D1] \as AmbientPrior;
\import Chains.Prior[C := Target.complex] \as QuotientPrior;
\import Chains.Map[C := D1, D := Target.complex] \as Projection;
\import Modules.Hom[V := D1.family.Carrier k, W := Target.Carrier k, source := D1.family.space k, target := Target.space k] \as Linear;
\definition difference[q: Source.Carrier k]: Target.Carrier k :=
  (Target.space k).add ((left).apply k q) ((Target.space k).neg ((right).apply k q));
\definition originalDifference[x: D.family.Carrier k]: D1.family.Carrier k :=
  (D1.family.space k).add ((f).apply k x) ((D1.family.space k).neg ((g).apply k x));
\definition differenceOnClass: \forall (x: D.family.Carrier k) -> difference (SourceAt.class x) = TargetAt.class (originalDifference x) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr2!{{Target.Carrier k} {Target.Carrier k} {Target.Carrier k}} ((Target.space k).add) _ _ _ _
      (Left.At[k := k].onClass (h).left x)
      (congr!{{Target.Carrier k} {Target.Carrier k}} ((Target.space k).neg) _ _ (Right.At[k := k].onClass (h).right x)))
    (sym!{{Target.Carrier k}} _ _ (Linear.differencePreserved TargetAt.projection ((f).apply k x) ((g).apply k x)));
\definition sum[q: Source.Carrier k]: Target.Carrier k :=
  (Target.space k).add (QuotientPrior.value k ((data).apply k q)) (QuotientHomotopies.shifted data k ((Source.differential).apply k q));
\definition originalSum[x: D.family.Carrier k]: D1.family.Carrier k :=
  (D1.family.space k).add (AmbientPrior.value k ((ambient).apply k x)) (Homotopies.shifted ambient k ((D.differential).apply k x));
\definition priorOnClass: \forall (x: D.family.Carrier k) -> QuotientPrior.value k ((data).apply k (SourceAt.class x)) = TargetAt.class (AmbientPrior.value k ((ambient).apply k x)) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr!{{Target.Carrier (next k)} {Target.Carrier k}} (QuotientPrior.value k) _ _ (\parent.At[k := k].onClass x))
    (Projection.priorCommutes k Target.projection ((ambient).apply k x));
\definition shiftedOnClass: \forall (x: D.family.Carrier k) ->
  QuotientHomotopies.shifted data k ((Source.differential).apply k (SourceAt.class x)) = TargetAt.class (Homotopies.shifted ambient k ((D.differential).apply k x)) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr!{{Source.Carrier (previous k)} {Target.Carrier k}} (QuotientHomotopies.shifted data k) _ _ (SourceAt.onClass x))
    (\parent.Shifted[k := k].onClass ((D.differential).apply k x));
\definition sumOnClass: \forall (x: D.family.Carrier k) -> sum (SourceAt.class x) = TargetAt.class (originalSum x) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr2!{{Target.Carrier k} {Target.Carrier k} {Target.Carrier k}} ((Target.space k).add) _ _ _ _ (priorOnClass x) (shiftedOnClass x))
    (sym!{{Target.Carrier k}} _ _ ((TargetAt.projection).addition (AmbientPrior.value k ((ambient).apply k x)) (Homotopies.shifted ambient k ((D.differential).apply k x))));
\definition law: \forall (q: Source.Carrier k) -> difference q = sum q :=
  SourceAt.induction (\fun (q: Source.Carrier k) => difference q = sum q)
    (\fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _ (differenceOnClass x)
      (trans!{{Target.Carrier k}} _ _ _ (congr!{{D1.family.Carrier k} {Target.Carrier k}} TargetAt.class _ _ ((ambient).equation k x))
        (sym!{{Target.Carrier k}} _ _ (sumOnClass x))));
