\import Source.At[k := k] \as SourceAt;
\import Target.At[k := k] \as TargetAt;
\import Chains.Prior[C := D1] \as AmbientPrior;
\import Chains.Prior[C := Target.complex] \as QuotientPrior;
\import Chains.Map[C := D1, D := Target.complex] \as Projection;
\import Modules.Hom[V := D1.family.Carrier k, W := Target.Carrier k, source := D1.family.space k, target := Target.space k] \as Linear;
\definition difference(q: Source.Carrier k): Target.Carrier k :=
  #add{(Target.space k)} (#apply{left} k q) (#neg{(Target.space k)} (#apply{right} k q));
\definition originalDifference(x: D.family.Carrier k): D1.family.Carrier k :=
  #add{(D1.family.space k)} (#apply{f} k x) (#neg{(D1.family.space k)} (#apply{g} k x));
\definition differenceOnClass: \forall (x: D.family.Carrier k) -> difference (SourceAt.class x) = TargetAt.class (originalDifference x) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr2!{{Target.Carrier k} {Target.Carrier k} {Target.Carrier k}} (#add{(Target.space k)}) _ _ _ _
      (Left.At[k := k].onClass #left{h} x)
      (congr!{{Target.Carrier k} {Target.Carrier k}} (#neg{(Target.space k)}) _ _ (Right.At[k := k].onClass #right{h} x)))
    (sym!{{Target.Carrier k}} _ _ (Linear.differencePreserved TargetAt.projection (#apply{f} k x) (#apply{g} k x)));
\definition sum(q: Source.Carrier k): Target.Carrier k :=
  #add{(Target.space k)} (QuotientPrior.value k (#apply{data} k q)) (QuotientHomotopies.shifted data k (#apply{Source.differential} k q));
\definition originalSum(x: D.family.Carrier k): D1.family.Carrier k :=
  #add{(D1.family.space k)} (AmbientPrior.value k (#apply{ambient} k x)) (Homotopies.shifted ambient k (#apply{D.differential} k x));
\definition priorOnClass: \forall (x: D.family.Carrier k) -> QuotientPrior.value k (#apply{data} k (SourceAt.class x)) = TargetAt.class (AmbientPrior.value k (#apply{ambient} k x)) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr!{{Target.Carrier (next k)} {Target.Carrier k}} (QuotientPrior.value k) _ _ (\parent.At[k := k].onClass x))
    (Projection.priorCommutes k Target.projection (#apply{ambient} k x));
\definition shiftedOnClass: \forall (x: D.family.Carrier k) ->
  QuotientHomotopies.shifted data k (#apply{Source.differential} k (SourceAt.class x)) = TargetAt.class (Homotopies.shifted ambient k (#apply{D.differential} k x)) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr!{{Source.Carrier (previous k)} {Target.Carrier k}} (QuotientHomotopies.shifted data k) _ _ (SourceAt.onClass x))
    (\parent.Shifted[k := k].onClass (#apply{D.differential} k x));
\definition sumOnClass: \forall (x: D.family.Carrier k) -> sum (SourceAt.class x) = TargetAt.class (originalSum x) :=
  \fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _
    (congr2!{{Target.Carrier k} {Target.Carrier k} {Target.Carrier k}} (#add{(Target.space k)}) _ _ _ _ (priorOnClass x) (shiftedOnClass x))
    (sym!{{Target.Carrier k}} _ _ (#addition{TargetAt.projection} (AmbientPrior.value k (#apply{ambient} k x)) (Homotopies.shifted ambient k (#apply{D.differential} k x))));
\definition law: \forall (q: Source.Carrier k) -> difference q = sum q :=
  SourceAt.induction (\fun (q: Source.Carrier k) => difference q = sum q)
    (\fun (x: D.family.Carrier k) => trans!{{Target.Carrier k}} _ _ _ (differenceOnClass x)
      (trans!{{Target.Carrier k}} _ _ _ (congr!{{D1.family.Carrier k} {Target.Carrier k}} TargetAt.class _ _ (#equation{ambient} k x))
        (sym!{{Target.Carrier k}} _ _ (sumOnClass x))));
