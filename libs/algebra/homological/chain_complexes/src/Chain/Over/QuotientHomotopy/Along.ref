\import \root.Chain[].Over[R := R, ring := ring] \as Chains;
\import Chains.Quotient[C := C, D := D].On[f := a] \as Source;
\import Chains.Quotient[C := C1, D := D1].On[f := b] \as Target;
\import Chains.QuotientMapping[C := C, D := D, C1 := C1, D1 := D1].Image[f := a, g := b, b := f] \as Left;
\import Chains.QuotientMapping[C := C, D := D, C1 := C1, D1 := D1].Image[f := a, g := b, b := g] \as Right;
\import Chains.Homotopy[C := D, D := D1] \as Homotopies;
\definition Preserves[h: Homotopies.Homotopy f g]: \Prop := \forall (k: Degree)(x: D.family.Carrier k) ->
  Modules.Of[V := D.family.Carrier k, space := D.family.space k].Submodule[].Member Source.At[k := k].image x ->
  Modules.Of[V := D1.family.Carrier (next k), space := D1.family.space (next k)].Submodule[].Member Target.At[k := next k].image ((h).apply k x);
\structure SupportedHomotopy: \Set := {
  homotopy: Homotopies.Homotopy f g,
  left: Left.Compatible,
  right: Right.Compatible,
  preserves: Preserves homotopy,
};
\module On(h: SupportedHomotopy);
