\definition source: Modules.Bundle := Modules.Bundle { Carrier := D.family.Carrier k, space := D.family.space k };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := D1.family.Carrier (next k), space := D1.family.space (next k) };
\definition linear: Modules.Hom[V := source.Carrier, W := target.Carrier, source := source.space, target := target.space].Map :=
  Modules.Hom[V := source.Carrier, W := target.Carrier, source := source.space, target := target.space].Map {
    apply := #apply{ambient} k,
    addition := #addition{ambient} k,
    scalar := #scalar{ambient} k,
  };
\import Modules.QuotientMapping[A := source, B := target].On[S := Source.At[k := k].image, T := Target.At[k := next k].image, f := linear] \as Mapping;
\definition map: Modules.Hom[V := Source.Carrier k, W := Target.Carrier (next k), source := Source.space k, target := Target.space (next k)].Map := Mapping.map (#preserves{h} k);
\definition onClass: \forall (x: D.family.Carrier k) -> #apply{map} (Source.At[k := k].class x) = Target.At[k := next k].class (#apply{ambient} k x) := Mapping.onClass (#preserves{h} k);
