\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\definition onClass: \forall (x: D.family.Carrier (previous k)) ->
  QuotientHomotopies.shifted data k (Source.At[k := previous k].class x) = Target.At[k := k].class (Homotopies.shifted ambient k x) :=
  \fun (x: D.family.Carrier (previous k)) => trans!{{Target.Carrier k}} _ _ _
    (congr!{{Target.Carrier (next (previous k))} {Target.Carrier k}}
      (Transport.cast Target.family.Carrier (next (previous k)) k (nextPrevious k)) _ _ (\parent.At[k := previous k].onClass x))
    (Transport.natural D1.family.Carrier Target.family.Carrier ((Target.projection).apply) (next (previous k)) k (nextPrevious k) ((ambient).apply (previous k) x));
