\definition ambient: Homotopies.Homotopy f g := #homotopy{h};
\definition left: Chains.Map[C := Source.complex, D := Target.complex].Map := Left.map #left{h};
\definition right: Chains.Map[C := Source.complex, D := Target.complex].Map := Right.map #right{h};
\module At(k: Degree);
\import Chains.Homotopy[C := Source.complex, D := Target.complex] \as QuotientHomotopies;
\definition data: QuotientHomotopies.Data := QuotientHomotopies.Data { apply := \fun (k: Degree) => #apply{At[k := k].map} };
\module Shifted(k: Degree);
\module Equation(k: Degree);
\definition homotopy: QuotientHomotopies.Homotopy left right := \into[QuotientHomotopies.Data](data, QuotientHomotopies.Homotopy left right) \by {
  QuotientHomotopies.Laws[left, right, data] {
    addition := \fun (k: Degree) => #addition{At[k := k].map},
    scalar := \fun (k: Degree) => #scalar{At[k := k].map},
    equation := \fun (k: Degree) => Equation[k := k].law,
  }
};
\module Homology(k: Degree) {
  \import Chains.At[C := Source.complex, z := k] \as SourceH;
  \import Chains.At[C := Target.complex, z := k] \as TargetH;
  \import Chains.Map[C := Source.complex, D := Target.complex].At[k := k] \as Maps;
  \definition law: \forall (q: SourceH.Homology) -> #apply{(Maps.induced left)} q = #apply{(Maps.induced right)} q :=
    QuotientHomotopies.At[k := k].onHomology left right homotopy;
}
