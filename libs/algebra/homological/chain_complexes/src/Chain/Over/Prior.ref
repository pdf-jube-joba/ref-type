\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\definition value(z: Degree)(x: C.family.Carrier (next z)): C.family.Carrier z :=
  Transport.cast C.family.Carrier (previous (next z)) z (previousNext z) (C.differential.apply (next z) x);
\definition addition: \forall (z: Degree)(x, y: C.family.Carrier (next z)) ->
  value z ((C.family.space (next z)).add x y) = (C.family.space z).add (value z x) (value z y) :=
  \fun (z: Degree)(x, y: C.family.Carrier (next z)) => trans!{{C.family.Carrier z}} _ _ _
    (congr!{{C.family.Carrier (previous (next z))} {C.family.Carrier z}}
      (Transport.cast C.family.Carrier (previous (next z)) z (previousNext z)) _ _ (C.laws.addition (next z) x y))
    (Transport.binaryNatural C.family.Carrier C.family.Carrier C.family.Carrier (\fun (k: Degree) => (C.family.space k).add)
      (previous (next z)) z (previousNext z) (C.differential.apply (next z) x) (C.differential.apply (next z) y));
\definition scalar: \forall (z: Degree)(a: R)(x: C.family.Carrier (next z)) ->
  value z ((C.family.space (next z)).smul a x) = (C.family.space z).smul a (value z x) :=
  \fun (z: Degree)(a: R)(x: C.family.Carrier (next z)) => trans!{{C.family.Carrier z}} _ _ _
    (congr!{{C.family.Carrier (previous (next z))} {C.family.Carrier z}}
      (Transport.cast C.family.Carrier (previous (next z)) z (previousNext z)) _ _ (C.laws.scalar (next z) a x))
    (Transport.natural C.family.Carrier C.family.Carrier (\fun (k: Degree) => (C.family.space k).smul a)
      (previous (next z)) z (previousNext z) (C.differential.apply (next z) x));
\definition squareZero: \forall (z: Degree)(x: C.family.Carrier (next z)) ->
  C.differential.apply z (value z x) = (C.family.space (previous z)).zero :=
  \fun (z: Degree)(x: C.family.Carrier (next z)) => trans!{{C.family.Carrier (previous z)}} _ _ _
    (sym!{{C.family.Carrier (previous z)}} _ _
      (Transport.natural C.family.Carrier (\fun (k: Degree) => C.family.Carrier (previous k)) (C.differential.apply)
        (previous (next z)) z (previousNext z) (C.differential.apply (next z) x)))
    (trans!{{C.family.Carrier (previous z)}} _ _ _
      (congr!{{C.family.Carrier (previous (previous (next z)))} {C.family.Carrier (previous z)}}
        (Transport.cast (\fun (k: Degree) => C.family.Carrier (previous k)) (previous (next z)) z (previousNext z)) _ _ (C.laws.squareZero (next z) x))
      (Transport.pointNatural (\fun (k: Degree) => C.family.Carrier (previous k)) (\fun (k: Degree) => (C.family.space (previous k)).zero)
        (previous (next z)) z (previousNext z)));
\definition nextSquareZero: \forall (z: Degree)(x: C.family.Carrier (next (next z))) -> value z (value (next z) x) = (C.family.space z).zero :=
  \fun (z: Degree)(x: C.family.Carrier (next (next z))) => trans!{{C.family.Carrier z}} _ _ _
    (congr!{{C.family.Carrier (previous (next z))} {C.family.Carrier z}}
      (Transport.cast C.family.Carrier (previous (next z)) z (previousNext z)) _ _ (squareZero (next z) x))
    (Transport.pointNatural C.family.Carrier (\fun (k: Degree) => (C.family.space k).zero) (previous (next z)) z (previousNext z));
\definition previousValue: \forall (k: Degree)(x: C.family.Carrier k) ->
  value (previous k) (Transport.cast C.family.Carrier k (next (previous k)) (sym!{Degree} _ _ (nextPrevious k)) x) = C.differential.apply k x :=
  \fun (k: Degree)(x: C.family.Carrier k) => trans!{{C.family.Carrier (previous k)}} _ _ _
    (congr!{{C.family.Carrier (previous (next (previous k)))} {C.family.Carrier (previous k)}}
      (Transport.cast C.family.Carrier (previous (next (previous k))) (previous k) (previousNext (previous k))) _ _
      (sym!{{C.family.Carrier (previous (next (previous k)))}} _ _
        (Transport.natural C.family.Carrier (\fun (j: Degree) => C.family.Carrier (previous j)) (C.differential.apply)
          k (next (previous k)) (sym!{Degree} _ _ (nextPrevious k)) x)))
    (trans!{{C.family.Carrier (previous k)}} _ _ _
      (congr!{{C.family.Carrier (previous (next (previous k)))} {C.family.Carrier (previous k)}}
        (Transport.cast C.family.Carrier (previous (next (previous k))) (previous k) (previousNext (previous k))) _ _
        (Transport.reindex C.family.Carrier previous k (next (previous k)) (sym!{Degree} _ _ (nextPrevious k)) (C.differential.apply k x)))
      (Transport.castInverse C.family.Carrier (previous k) (previous (next (previous k)))
        (congr!{Degree Degree} previous k (next (previous k)) (sym!{Degree} _ _ (nextPrevious k))) (C.differential.apply k x)));
\definition previousInverse: \forall (k: Degree)(x: C.family.Carrier (next (previous k))) ->
  C.differential.apply k (Transport.cast C.family.Carrier (next (previous k)) k (nextPrevious k) x) = value (previous k) x :=
  \fun (k: Degree)(x: C.family.Carrier (next (previous k))) => trans!{{C.family.Carrier (previous k)}} _ _ _
    (sym!{{C.family.Carrier (previous k)}} _ _ (previousValue k (Transport.cast C.family.Carrier (next (previous k)) k (nextPrevious k) x)))
    (congr!{{C.family.Carrier (next (previous k))} {C.family.Carrier (previous k)}} (value (previous k)) _ _
      (Transport.castInverse C.family.Carrier (next (previous k)) k (nextPrevious k) x));
