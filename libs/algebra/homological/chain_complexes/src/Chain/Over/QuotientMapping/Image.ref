\import \root.Chain[].Over[R := R, ring := ring] \as Chains;
\import Chains.Quotient[C := C, D := D].On[f := f] \as Source;
\import Chains.Quotient[C := C1, D := D1].On[f := g] \as Target;
\definition Compatible: \Prop := \forall (k: Degree)(x: D.family.Carrier k) ->
  Modules.Of[V := D.family.Carrier k, space := D.family.space k].Submodule[].Member Source.At[k := k].image x ->
  Modules.Of[V := D1.family.Carrier k, space := D1.family.space k].Submodule[].Member Target.At[k := k].image ((b).apply k x);
\module At(k: Degree);
\definition map[compatible: Compatible]: Chains.Map[C := Source.complex, D := Target.complex].Map := Chains.Map[C := Source.complex, D := Target.complex].Map {
  apply := \fun (k: Degree) => (At[k := k].map compatible).apply,
  addition := \fun (k: Degree) => (At[k := k].map compatible).addition,
  scalar := \fun (k: Degree) => (At[k := k].map compatible).scalar,
  commutes := \fun (k: Degree) => At[k := k].commutes compatible,
};
