\import \parent.\parent.Reverse[C := D] \as Target;
\import \parent.\parent.Map[C := C, D := D] \as Original;
\import Cochains.Map[C := complex, D := Target.complex] \as Reversed;
\definition map(f: Original.Map): Reversed.Map := Reversed.Map {
  apply := \fun (k: Degree) => #apply{f} (Integers.reverse k),
  addition := \fun (k: Degree) => #addition{f} (Integers.reverse k),
  scalar := \fun (k: Degree) => #scalar{f} (Integers.reverse k),
  commutes := \fun (k: Degree)(x: Carrier k) => trans!{{D.family.Carrier (Integers.reverse (next k))}} _ _ _
    (congr!{{D.family.Carrier (previous (Integers.reverse k))} {D.family.Carrier (Integers.reverse (next k))}}
      (Transport.cast D.family.Carrier (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k)) _ _ (#commutes{f} (Integers.reverse k) x))
    (Transport.natural C.family.Carrier D.family.Carrier (#apply{f})
      (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k) (#apply{C.differential} (Integers.reverse k) x)),
};
