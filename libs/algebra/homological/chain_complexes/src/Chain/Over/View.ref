\definition Carrier[z: Degree]: \Set := C.family.Carrier z;
\definition space[z: Degree]: Modules.Space (Carrier z) := C.family.space z;
\definition apply[z: Degree][x: Carrier z]: Carrier (previous z) := C.differential.apply z x;
\definition squareZero: \forall (z: Degree)(x: Carrier z) -> apply (previous z) (apply z x) = (space (previous (previous z))).zero := C.laws.squareZero;
