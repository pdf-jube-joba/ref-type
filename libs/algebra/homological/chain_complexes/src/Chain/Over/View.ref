\definition Carrier(z: Degree): \Set := C.family.Carrier z;
\definition space(z: Degree): Modules.Space (Carrier z) := C.family.space z;
\definition apply(z: Degree)(x: Carrier z): Carrier (previous z) := #apply{C.differential} z x;
\definition squareZero: \forall (z: Degree)(x: Carrier z) -> apply (previous z) (apply z x) = #zero{(space (previous (previous z)))} := #squareZero{C.laws};
