\import \root.Chain[].Over[R := R, ring := ring] \as Chains;
\import Chains.ShortExact[A := A, B := B, C := C].At[s := s, k := k].FiveTerm[] \as Upper;
\import Chains.ShortExact[A := A1, B := B1, C := C1].At[s := t, k := k].FiveTerm[] \as Lower;
\import Modules.ExactFiveComparison[A := Upper.first, B := Upper.second, C := Upper.third, D := Upper.fourth, E := Upper.last,
  A1 := Lower.first, B1 := Lower.second, C1 := Lower.third, D1 := Lower.fourth, E1 := Lower.last] \as Five;
\import Chains.Map[C := A, D := A1].At[k := k] \as LeftUpper;
\import Chains.Map[C := B, D := B1].At[k := k] \as MiddleUpper;
\import Chains.Map[C := C, D := C1].At[k := k] \as Relative;
\import Chains.Map[C := A, D := A1].At[k := previous k] \as LeftLower;
\import Chains.Map[C := B, D := B1].At[k := previous k] \as MiddleLower;
\import Five.Diagram[s := Upper.sequence, t := Lower.sequence, a := LeftUpper.induced a, b := MiddleUpper.induced b,
  c := Relative.induced c, d := LeftLower.induced a, e := MiddleLower.induced b] \as Diagram;
\import \parent.\parent.Inclusion[k := k] \as UpperSquare;
\import \parent.\parent.Inclusion[k := previous k] \as LowerSquare;
\definition commutative[diagram: Commutative]: Diagram.Commutative := Diagram.Commutative {
  first := UpperSquare.naturality diagram,
  second := \fun (x: Upper.second.Carrier) => sym!{Lower.third.Carrier} _ _ (projectionNaturality diagram x),
  third := \fun (x: Upper.third.Carrier) => sym!{Lower.fourth.Carrier} _ _ (naturality diagram x),
  last := LowerSquare.naturality diagram,
};
\definition bijective: Commutative -> LeftUpper.Bijective[a] -> MiddleUpper.Bijective[b] -> LeftLower.Bijective[a] -> MiddleLower.Bijective[b] -> Relative.Bijective[c] :=
  \fun (diagram: Commutative)(left: LeftUpper.Bijective[a])(middle: MiddleUpper.Bijective[b])
    (leftLower: LeftLower.Bijective[a])(middleLower: MiddleLower.Bijective[b]) => Relative.Bijective[c] {
      injective := Diagram.Injection[].law (commutative diagram) left.onto middle.injective leftLower.injective,
      onto := Diagram.Surjection[].law (commutative diagram) middle.onto leftLower.onto middleLower.injective,
    };
\definition isomorphism[diagram: Commutative][left: LeftUpper.Bijective[a]][middle: MiddleUpper.Bijective[b]]
  [leftLower: LeftLower.Bijective[a]][middleLower: MiddleLower.Bijective[b]]:
  Modules.Isomorphism[V := Upper.third.Carrier, W := Lower.third.Carrier, source := Upper.third.space, target := Lower.third.space].Isomorphism :=
    Relative.Invert[f := c].isomorphism (bijective diagram left middle leftLower middleLower);
