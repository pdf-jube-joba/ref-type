\definition left: Modules.Bundle := Modules.Bundle { Carrier := A.family.Carrier k, space := A.family.space k };
\definition middle: Modules.Bundle := Modules.Bundle { Carrier := B.family.Carrier k, space := B.family.space k };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := C.family.Carrier k, space := C.family.space k };
\import \parent.\parent.\parent.Map[C := A, D := B].At[k := k] \as Inclusion;
\import \parent.\parent.\parent.Map[C := B, D := C].At[k := k] \as Projection;
\import Modules.RightExact[A := left, B := middle, C := right] \as Exact;
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := Inclusion.linear s.inclusion, projection := Projection.linear s.projection,
  onto := (s).onto k, zero := (s).zero k, kernelImage := (s).kernelImage k,
};
\import Exact.Cokernel[sequence := sequence] \as Native;
\definition forward: Modules.Hom[V := Quotient.Carrier k, W := C.family.Carrier k, source := Quotient.space k, target := C.family.space k].Map := Native.forward;
\definition onClass: \forall (x: B.family.Carrier k) -> (forward).apply (Quotient.At[k := k].class x) = (s.projection).apply k x := Native.onClass;
\definition injective: \forall (x, y: Quotient.Carrier k) -> (forward).apply x = (forward).apply y -> x = y := Native.injective;
\definition onto: \forall (x: C.family.Carrier k) -> \exists ( q: Quotient.Carrier k \where (forward).apply q = x ) := Native.onto;
\import \parent.At[k := previous k] \as Lower;
\definition commutes: \forall (q: Quotient.Carrier k) -> (C.differential).apply k ((forward).apply q) = (Lower.forward).apply ((Quotient.differential).apply k q) :=
  Quotient.At[k := k].induction (\fun (q: Quotient.Carrier k) => (C.differential).apply k ((forward).apply q) = (Lower.forward).apply ((Quotient.differential).apply k q))
    (\fun (x: B.family.Carrier k) => trans!{{C.family.Carrier (previous k)}} _ _ _
      (congr!{{C.family.Carrier k} {C.family.Carrier (previous k)}} ((C.differential).apply k) _ _ (onClass x))
      (trans!{{C.family.Carrier (previous k)}} _ _ _ ((s.projection).commutes k x)
        (sym!{{C.family.Carrier (previous k)}} _ _ (trans!{{C.family.Carrier (previous k)}} _ _ _
          (congr!{{Quotient.Carrier (previous k)} {C.family.Carrier (previous k)}} ((Lower.forward).apply) _ _ (Quotient.At[k := k].onClass x))
          (Lower.onClass ((B.differential).apply k x))))));
