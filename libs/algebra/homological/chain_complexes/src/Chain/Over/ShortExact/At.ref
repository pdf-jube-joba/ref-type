\import Modules.Hom[V := B.family.Carrier k, W := C.family.Carrier k, source := B.family.space k, target := C.family.space k] \as ProjectionLinear;
\import \parent.\parent.At[C := C, z := k] \as HC;
\import \parent.\parent.At[C := B, z := k] \as HB;
\import \parent.\parent.At[C := A, z := previous k] \as HA;
\import \parent.\parent.Prior[C := A] \as APrior;
\import \parent.\parent.Map[C := A, D := B].At[k := previous (previous k)] \as LowerInclusion;
\import \parent.\parent.Map[C := B, D := C].At[k := previous k] \as LowerProjection;
\import Modules.Hom[V := B.family.Carrier k, W := B.family.Carrier (previous k), source := B.family.space k, target := B.family.space (previous k)] \as DifferentialB;
\definition differentialB: DifferentialB.Map := DifferentialB.Map { apply := B.differential.apply k, addition := B.laws.addition k, scalar := B.laws.scalar k };
\import Modules.Laws[V := B.family.Carrier k, space := B.family.space k] \as Middle;
\import algebra.Group[].Of[Carrier := B.family.Carrier k, group := Middle.additive] \as MiddleGroup;
\import Modules.Laws[V := B.family.Carrier (previous k), space := B.family.space (previous k)] \as MiddleLower;
\import algebra.Group[].Of[Carrier := B.family.Carrier (previous k), group := MiddleLower.additive] \as MiddleLowerGroup;
\import Modules.Laws[V := C.family.Carrier k, space := C.family.space k] \as Right;
\import algebra.Group[].Of[Carrier := C.family.Carrier k, group := Right.additive] \as RightGroup;
\import Modules.Laws[V := A.family.Carrier (previous k), space := A.family.space (previous k)] \as Left;
\import algebra.Group[].Of[Carrier := A.family.Carrier (previous k), group := Left.additive] \as LeftGroup;
\import \parent.\parent.Map[C := B, D := C].At[k := k] \as ProjectionAt;
\import \parent.\parent.Map[C := A, D := B].At[k := previous k] \as InclusionAt;
\import \parent.\parent.Map[C := A, D := B].At[k := k] \as InclusionBefore;
\import Modules.Hom[V := A.family.Carrier (previous k), W := B.family.Carrier (previous k), source := A.family.space (previous k), target := B.family.space (previous k)] \as InclusionLinear;
\definition lowerClosed: \forall (lift: B.family.Carrier k)(lower: A.family.Carrier (previous k)) ->
  s.inclusion.apply (previous k) lower = B.differential.apply k lift -> A.differential.apply (previous k) lower = (A.family.space (previous (previous k))).zero :=
  \fun (lift: B.family.Carrier k)(lower: A.family.Carrier (previous k))(represented: _) => s.injective (previous (previous k)) _ _
    (trans!{{B.family.Carrier (previous (previous k))}} _ _ _ (sym!{{B.family.Carrier (previous (previous k))}} _ _ (s.inclusion.commutes (previous k) lower))
      (trans!{{B.family.Carrier (previous (previous k))}} _ _ _ (congr!{{B.family.Carrier (previous k)} {B.family.Carrier (previous (previous k))}} (B.differential.apply (previous k)) _ _ represented)
        (trans!{{B.family.Carrier (previous (previous k))}} _ _ _ (B.laws.squareZero k lift)
          (sym!{{B.family.Carrier (previous (previous k))}} _ _ (LowerInclusion.zeroPreserved s.inclusion)))));
\structure Witness: \Set := { lift: B.family.Carrier k, lower: HA.Cycle };
\structure WitnessLaws[x: HC.Cycle, q: HA.Homology, w: Witness]: \Prop := {
  lifted: s.projection.apply k w.lift = x,
  differential: s.inclusion.apply (previous k) w.lower = B.differential.apply k w.lift,
  classValue: HA.classOf w.lower = q,
};
\definition Values[x: HC.Cycle]: \Pow HA.Homology := { q: HA.Homology \where \exists ( w: Witness \where WitnessLaws[x, q, w] ) };
\definition Value[x: HC.Cycle]: \Set := \Cast[HA.Homology] (Values x);
\definition witness[x: HC.Cycle][lift: B.family.Carrier k][lower: A.family.Carrier (previous k)]
  [lifted: s.projection.apply k lift = x][differential: s.inclusion.apply (previous k) lower = B.differential.apply k lift]: Value x :=
  \into[HA.Homology](HA.classOf (HA.cycle lower (lowerClosed lift lower differential)), Values x) \by {
    Logic.existsIntro[Witness, { w: Witness \where WitnessLaws[x, HA.classOf (HA.cycle lower (lowerClosed lift lower differential)), w] }] (Witness { lift := lift, lower := HA.cycle lower (lowerClosed lift lower differential) })
    (WitnessLaws[x, HA.classOf (HA.cycle lower (lowerClosed lift lower differential)), Witness { lift := lift, lower := HA.cycle lower (lowerClosed lift lower differential) }] {
          lifted := lifted, differential := differential, classValue := \refl(HA.classOf (HA.cycle lower (lowerClosed lift lower differential))),
        })
  };
\definition existence: \forall (x: HC.Cycle) -> \exists Value x := \block {
  \fun (x: HC.Cycle) \then
  \takefrom lift: \Cast[B.family.Carrier k] ({ b: B.family.Carrier k \where s.projection.apply k b = x }) \by s.onto k x \then
  \let lifted: s.projection.apply k lift = x := \bysub(B.family.Carrier k, { b: B.family.Carrier k \where s.projection.apply k b = x }, lift) \then
  \let killed: s.projection.apply (previous k) (B.differential.apply k lift) = (C.family.space (previous k)).zero := trans!{{C.family.Carrier (previous k)}} _ _ _
    (sym!{{C.family.Carrier (previous k)}} _ _ (s.projection.commutes k lift))
    (trans!{{C.family.Carrier (previous k)}} _ _ _ (congr!{{C.family.Carrier k} {C.family.Carrier (previous k)}} (C.differential.apply k) _ _ lifted)
      (\bysub(C.family.Carrier k, HC.cycles.carrier, x))) \then
  \takefrom lower: \Cast[A.family.Carrier (previous k)] ({ a: A.family.Carrier (previous k) \where s.inclusion.apply (previous k) a = B.differential.apply k lift })
    \by s.kernelImage (previous k) (B.differential.apply k lift) killed \then
  \return \exact(witness x lift lower lifted (\bysub(A.family.Carrier (previous k), { a: A.family.Carrier (previous k) \where s.inclusion.apply (previous k) a = B.differential.apply k lift }, lower)), Value x)
};
\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\import Modules.Of[V := A.family.Carrier (previous k), space := A.family.space (previous k)].Submodule[] \as SubA;
\import SubA.Image[U := A.family.Carrier (next (previous k)), source := A.family.space (next (previous k))] \as ImagesA;
\definition boundaryDifferential: \forall (a: A.family.Carrier k) -> SubA.Member HA.boundaries (A.differential.apply k a) :=
  \fun (a: A.family.Carrier k) => \idelim APrior.value (previous k)
    (Transport.cast A.family.Carrier k (next (previous k)) (sym!{Degree} _ _ (nextPrevious k)) a) = A.differential.apply k a
    \with v: A.family.Carrier (previous k) => SubA.Member HA.boundaries v \by {
      base: ImagesA.member HA.prior (Transport.cast A.family.Carrier k (next (previous k)) (sym!{Degree} _ _ (nextPrevious k)) a),
      equality: APrior.previousValue k a
    };
\definition sameClass: \forall (x: HC.Cycle)(v, w: Witness) ->
  s.projection.apply k v.lift = x -> s.projection.apply k w.lift = x ->
  s.inclusion.apply (previous k) v.lower = B.differential.apply k v.lift ->
  s.inclusion.apply (previous k) w.lower = B.differential.apply k w.lift -> HA.classOf v.lower = HA.classOf w.lower := \block {
  \fun (x: HC.Cycle)(v, w: Witness)(vLift: _)(wLift: _)(vDiff: _)(wDiff: _) \then
  \let killed: s.projection.apply k (MiddleGroup.difference v.lift w.lift) = Right.zero :=
    trans!{{C.family.Carrier k}} _ _ _ (ProjectionLinear.differencePreserved (ProjectionAt.linear s.projection) v.lift w.lift)
      (trans!{{C.family.Carrier k}} _ _ _ (congr2!{{C.family.Carrier k} {C.family.Carrier k} {C.family.Carrier k}} RightGroup.difference _ _ _ _ vLift wLift) (RightGroup.inverseRight x)) \then
  \takefrom a: \Cast[A.family.Carrier k] ({ a: A.family.Carrier k \where s.inclusion.apply k a = MiddleGroup.difference v.lift w.lift })
    \by s.kernelImage k (MiddleGroup.difference v.lift w.lift) killed \then
  \let represented: s.inclusion.apply k a = MiddleGroup.difference v.lift w.lift :=
    \bysub(A.family.Carrier k, { a: A.family.Carrier k \where s.inclusion.apply k a = MiddleGroup.difference v.lift w.lift }, a) \then
  \let difference: LeftGroup.difference v.lower w.lower = A.differential.apply k a := s.injective (previous k) _ _
    (trans!{{B.family.Carrier (previous k)}} _ _ _ (InclusionLinear.differencePreserved (InclusionAt.linear s.inclusion) v.lower w.lower)
      (trans!{{B.family.Carrier (previous k)}} _ _ _ (congr2!{{B.family.Carrier (previous k)} {B.family.Carrier (previous k)} {B.family.Carrier (previous k)}} MiddleLowerGroup.difference _ _ _ _ vDiff wDiff)
        (trans!{{B.family.Carrier (previous k)}} _ _ _ (sym!{{B.family.Carrier (previous k)}} _ _ (DifferentialB.differencePreserved differentialB v.lift w.lift))
          (trans!{{B.family.Carrier (previous k)}} _ _ _ (congr!{{B.family.Carrier k} {B.family.Carrier (previous k)}} (B.differential.apply k) _ _ (sym!{{B.family.Carrier k}} _ _ represented))
            (s.inclusion.commutes k a))))) \then
  \return HA.classEqual v.lower w.lower (\idelim A.differential.apply k a = LeftGroup.difference v.lower w.lower
    \with y: A.family.Carrier (previous k) => SubA.Member HA.boundaries y \by {
      base: boundaryDifferential a, equality: sym!{{A.family.Carrier (previous k)}} _ _ difference
    })
};
\definition uniqueness: \forall (x: HC.Cycle)(v, w: Value x) -> v = w := \block {
  \fun (x: HC.Cycle)(v, w: Value x) \then
  \takefrom r: \Cast[Witness] ({ r: Witness \where WitnessLaws[x, v, r] }) \by \bysub(HA.Homology, Values x, v) \then
  \takefrom u: \Cast[Witness] ({ u: Witness \where WitnessLaws[x, w, u] }) \by \bysub(HA.Homology, Values x, w) \then
  \let rLaws: WitnessLaws[x, v, r] := \bysub(Witness, { r: Witness \where WitnessLaws[x, v, r] }, r) \then
  \let uLaws: WitnessLaws[x, w, u] := \bysub(Witness, { u: Witness \where WitnessLaws[x, w, u] }, u) \then
  \return trans!{HA.Homology} _ _ _ (sym!{HA.Homology} _ _ (rLaws.classValue))
    (trans!{HA.Homology} _ _ _ (sameClass x r u (rLaws.lifted) (uLaws.lifted) (rLaws.differential) (uLaws.differential)) (uLaws.classValue))
};
\definition delta[x: HC.Cycle]: Value x := \choice Value x \by { existence: existence x, uniqueness: uniqueness x };
\definition onLift: \forall (x: HC.Cycle)(lift: B.family.Carrier k)(lower: A.family.Carrier (previous k)) ->
  s.projection.apply k lift = x -> s.inclusion.apply (previous k) lower = B.differential.apply k lift ->
  \forall (closed: A.differential.apply (previous k) lower = (A.family.space (previous (previous k))).zero) -> delta x = HA.classOf (HA.cycle lower closed) :=
  \fun (x: HC.Cycle)(lift: B.family.Carrier k)(lower: A.family.Carrier (previous k))(lifted: _)(differential: _)(closed: _) => sym!{HA.Homology} _ _
    (\choiceeq witness x lift lower lifted differential \of Value x \by { existence: existence x, uniqueness: uniqueness x });
\definition addition: \forall (x, y: HC.Cycle) ->
  delta (HC.cycleSpace.add x y) = HA.homologySpace.add (delta x) (delta y) := \block {
  \fun (x, y: HC.Cycle) \then
  \takefrom r: \Cast[Witness] ({ r: Witness \where WitnessLaws[x, delta x, r] }) \by \bysub(HA.Homology, Values x, delta x) \then
  \takefrom u: \Cast[Witness] ({ u: Witness \where WitnessLaws[y, delta y, u] }) \by \bysub(HA.Homology, Values y, delta y) \then
  \let rLaws: WitnessLaws[x, delta x, r] := \bysub(Witness, { r: Witness \where WitnessLaws[x, delta x, r] }, r) \then
  \let uLaws: WitnessLaws[y, delta y, u] := \bysub(Witness, { u: Witness \where WitnessLaws[y, delta y, u] }, u) \then
  \let lifted: s.projection.apply k (Middle.add (r.lift) (u.lift)) = HC.cycleSpace.add x y := trans!{{C.family.Carrier k}} _ _ _ (s.projection.addition k (r.lift) (u.lift))
    (congr2!{{C.family.Carrier k} {C.family.Carrier k} {C.family.Carrier k}} Right.add _ _ _ _ (rLaws.lifted) (uLaws.lifted)) \then
  \let differential: s.inclusion.apply (previous k) (Left.add (r.lower) (u.lower)) = B.differential.apply k (Middle.add (r.lift) (u.lift)) :=
    trans!{{B.family.Carrier (previous k)}} _ _ _ (s.inclusion.addition (previous k) (r.lower) (u.lower))
      (trans!{{B.family.Carrier (previous k)}} _ _ _ (congr2!{{B.family.Carrier (previous k)} {B.family.Carrier (previous k)} {B.family.Carrier (previous k)}} MiddleLower.add _ _ _ _ (rLaws.differential) (uLaws.differential))
        (sym!{{B.family.Carrier (previous k)}} _ _ (B.laws.addition k (r.lift) (u.lift)))) \then
  \let lower: HA.Cycle := HA.cycleSpace.add (r.lower) (u.lower) \then
  \return trans!{HA.Homology} _ _ _ (onLift (HC.cycleSpace.add x y) (Middle.add (r.lift) (u.lift)) lower lifted differential
    (\bysub(A.family.Carrier (previous k), HA.cycles.carrier, lower)))
    (trans!{HA.Homology} _ _ _ (HA.classLinear.addition (r.lower) (u.lower))
      (congr2!{HA.Homology HA.Homology HA.Homology} (HA.homologySpace.add) _ _ _ _ (rLaws.classValue) (uLaws.classValue)))
};
\definition scalar: \forall (a: R)(x: HC.Cycle) ->
  delta (HC.cycleSpace.smul a x) = HA.homologySpace.smul a (delta x) := \block {
  \fun (a: R)(x: HC.Cycle) \then
  \takefrom r: \Cast[Witness] ({ r: Witness \where WitnessLaws[x, delta x, r] }) \by \bysub(HA.Homology, Values x, delta x) \then
  \let laws: WitnessLaws[x, delta x, r] := \bysub(Witness, { r: Witness \where WitnessLaws[x, delta x, r] }, r) \then
  \let lifted: s.projection.apply k (Middle.scale a (r.lift)) = HC.cycleSpace.smul a x := trans!{{C.family.Carrier k}} _ _ _ (s.projection.scalar k a (r.lift))
    (congr!{{C.family.Carrier k} {C.family.Carrier k}} (Right.scale a) _ _ (laws.lifted)) \then
  \let differential: s.inclusion.apply (previous k) (Left.scale a (r.lower)) = B.differential.apply k (Middle.scale a (r.lift)) :=
    trans!{{B.family.Carrier (previous k)}} _ _ _ (s.inclusion.scalar (previous k) a (r.lower))
      (trans!{{B.family.Carrier (previous k)}} _ _ _ (congr!{{B.family.Carrier (previous k)} {B.family.Carrier (previous k)}} (MiddleLower.scale a) _ _ (laws.differential))
        (sym!{{B.family.Carrier (previous k)}} _ _ (B.laws.scalar k a (r.lift)))) \then
  \let lower: HA.Cycle := HA.cycleSpace.smul a (r.lower) \then
  \return trans!{HA.Homology} _ _ _ (onLift (HC.cycleSpace.smul a x) (Middle.scale a (r.lift)) lower lifted differential
    (\bysub(A.family.Carrier (previous k), HA.cycles.carrier, lower)))
    (trans!{HA.Homology} _ _ _ (HA.classLinear.scalar a (r.lower))
      (congr!{HA.Homology HA.Homology} (HA.homologySpace.smul a) _ _ (laws.classValue)))
};
\import Modules.Hom[V := HC.Cycle, W := HA.Homology, source := HC.cycleSpace, target := HA.homologySpace] \as Raw;
\definition onCycles: Raw.Map := Raw.Map { apply := delta, addition := addition, scalar := scalar };
\import Modules.Of[V := HC.Cycle, space := HC.cycleSpace].Submodule[].Quotient[S := HC.boundariesInside].To[W := HA.Homology, target := HA.homologySpace] \as Descent;
\import Modules.Of[V := C.family.Carrier k, space := C.family.space k].Submodule[].Image[U := C.family.Carrier (next k), source := C.family.space (next k)] \as ImagesC;
\import \parent.\parent.Prior[C := B] \as BPrior;
\definition vanishes: Descent.Vanishes onCycles := \block {
  \fun (x: HC.Cycle)(boundary: _) \then
  \takefrom y: \Cast[C.family.Carrier (next k)] ({ y: C.family.Carrier (next k) \where HC.prior.apply y = x }) \by boundary \then
  \takefrom lift: \Cast[B.family.Carrier (next k)] ({ b: B.family.Carrier (next k) \where s.projection.apply (next k) b = y }) \by s.onto (next k) y \then
  \let represented: s.projection.apply k (BPrior.value k lift) = x := trans!{{C.family.Carrier k}} _ _ _
    (sym!{{C.family.Carrier k}} _ _ (Projection.priorCommutes k s.projection lift))
    (trans!{{C.family.Carrier k}} _ _ _ (congr!{{C.family.Carrier (next k)} {C.family.Carrier k}} (HC.prior.apply) _ _
      (\bysub(B.family.Carrier (next k), { b: B.family.Carrier (next k) \where s.projection.apply (next k) b = y }, lift)))
      (\bysub(C.family.Carrier (next k), { y: C.family.Carrier (next k) \where HC.prior.apply y = x }, y))) \then
  \return onLift x (BPrior.value k lift) Left.zero represented
    (trans!{{B.family.Carrier (previous k)}} _ _ _ (InclusionAt.zeroPreserved s.inclusion) (sym!{{B.family.Carrier (previous k)}} _ _ (BPrior.squareZero k lift)))
    (\bysub(A.family.Carrier (previous k), HA.cycles.carrier, HA.cycleSpace.zero))
};
\import Modules.Hom[V := HC.Homology, W := HA.Homology, source := HC.homologySpace, target := HA.homologySpace] \as Connecting;
\definition connecting: Connecting.Map := Descent.descend onCycles vanishes;
\definition onClass: \forall (x: HC.Cycle) -> connecting.apply (HC.classOf x) = delta x := Descent.onClass onCycles vanishes;
\module Exactness;
\module FiveTerm;
\module DimensionShift;
