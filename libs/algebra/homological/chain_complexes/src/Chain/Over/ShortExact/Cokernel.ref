\import \parent.\parent.Quotient[C := A, D := B].On[f := s.inclusion] \as Quotient;
\module At(k: Degree);
\import \parent.\parent.Map[C := Quotient.complex, D := C] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (k: Degree) => (At[k := k].forward).apply,
  addition := \fun (k: Degree) => (At[k := k].forward).addition,
  scalar := \fun (k: Degree) => (At[k := k].forward).scalar,
  commutes := \fun (k: Degree) => At[k := k].commutes,
};
\import Maps.Invert[f := map] \as Inverse;
\definition bijective: Inverse.Bijective := Inverse.Bijective {
  injective := \fun (k: Degree) => At[k := k].injective,
  onto := \fun (k: Degree) => At[k := k].onto,
};
\definition isomorphism: \parent.\parent.Isomorphism[C := Quotient.complex, D := C].Isomorphism := Inverse.isomorphism bijective;
