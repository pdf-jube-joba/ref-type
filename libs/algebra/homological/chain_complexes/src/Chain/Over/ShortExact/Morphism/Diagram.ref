\structure Commutative: \Prop {
  left: \forall (k: Degree)(x: A.family.Carrier k) -> #apply{b} k (#apply{s.inclusion} k x) = #apply{t.inclusion} k (#apply{a} k x),
  right: \forall (k: Degree)(x: B.family.Carrier k) -> #apply{t.projection} k (#apply{b} k x) = #apply{c} k (#apply{s.projection} k x),
}
\module Inclusion(k: Degree);
\module At(k: Degree);
\definition rightQuasiIsomorphism: Commutative -> LeftMap.QuasiIsomorphism a -> MiddleMap.QuasiIsomorphism b -> RightMap.QuasiIsomorphism c :=
  \fun (diagram: Commutative)(left: LeftMap.QuasiIsomorphism a)(middle: MiddleMap.QuasiIsomorphism b)(k: Degree) =>
    At[k := k].Comparison[].bijective diagram (left k) (middle k) (left (previous k)) (middle (previous k));
