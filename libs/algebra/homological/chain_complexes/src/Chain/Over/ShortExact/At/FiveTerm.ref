\import \parent.\parent.\parent.At[C := A, z := k] \as First;
\import \parent.\parent.\parent.At[C := B, z := k] \as Second;
\import \parent.\parent.\parent.At[C := C, z := k] \as Third;
\import \parent.\parent.\parent.At[C := A, z := previous k] \as Fourth;
\import \parent.\parent.\parent.At[C := B, z := previous k] \as Last;
\definition first: Modules.Bundle := Modules.Bundle { Carrier := First.Homology, space := First.homologySpace };
\definition second: Modules.Bundle := Modules.Bundle { Carrier := Second.Homology, space := Second.homologySpace };
\definition third: Modules.Bundle := Modules.Bundle { Carrier := Third.Homology, space := Third.homologySpace };
\definition fourth: Modules.Bundle := Modules.Bundle { Carrier := Fourth.Homology, space := Fourth.homologySpace };
\definition last: Modules.Bundle := Modules.Bundle { Carrier := Last.Homology, space := Last.homologySpace };
\import Modules.ExactFive[A := first, B := second, C := third, D := fourth, E := last] \as Five;
\import \parent.\parent.\parent.Map[C := A, D := B].At[k := k] \as FirstMap;
\import \parent.\parent.\parent.Map[C := B, D := C].At[k := k] \as SecondMap;
\import \parent.\parent.\parent.Map[C := A, D := B].At[k := previous k] \as LastMap;
\definition data: Five.Data := Five.Data {
  first := FirstMap.induced s.inclusion, second := SecondMap.induced s.projection,
  third := connecting, last := LastMap.induced s.inclusion,
};
\import \parent.Exactness[] \as E;
\definition sequence: Five.Sequence := \into[Five.Data](data, { d: Five.Data \where Five.Laws[d] }) \by {
  Five.Laws[data] {
    zeroB := E.inclusionProjectionZero, zeroC := E.projectionConnectingZero, zeroD := E.connectingInclusionZero,
    kernelB := E.exactAtB, kernelC := E.exactAtC, kernelD := E.exactAtALower,
  }
};
