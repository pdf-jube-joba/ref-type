\import \parent.Map[C := C, D := D] \as Forward;
\import \parent.Map[C := D, D := C] \as Backward;
\structure Data: \Set { forward: Forward.Map, backward: Backward.Map }
\structure Laws[data: Data]: \Prop {
  leftInverse: \forall (z: Degree)(x: C.family.Carrier z) -> data.backward.apply z (data.forward.apply z x) = x,
  rightInverse: \forall (z: Degree)(x: D.family.Carrier z) -> data.forward.apply z (data.backward.apply z x) = x,
}
\definition Isomorphism: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module At(z: Degree);
