\import chain_complexes.Integer[] \as Integers;
\import Integers.Over[R := R, ring := ring] \as Cochains;
\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\definition Carrier(k: Degree): \Set := C.family.Carrier (Integers.reverse k);
\definition space(k: Degree): Modules.Space (Carrier k) := C.family.space (Integers.reverse k);
\definition family: Cochains.Family := Cochains.Family { Carrier := Carrier, space := space };
\definition target(k: Degree): previous (Integers.reverse k) = Integers.reverse (next k) :=
  sym!{Degree} _ _ (Integers.reverseNext k);
\definition apply(k: Degree)(x: Carrier k): Carrier (next k) :=
  Transport.cast C.family.Carrier (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k)
    (C.differential.apply (Integers.reverse k) x);
\definition addition: \forall (k: Degree)(x, y: Carrier k) ->
  apply k ((space k).add x y) = (space (next k)).add (apply k x) (apply k y) :=
  \fun (k: Degree)(x, y: Carrier k) => trans!{{Carrier (next k)}} _ _ _
    (congr!{{C.family.Carrier (previous (Integers.reverse k))} {Carrier (next k)}}
      (Transport.cast C.family.Carrier (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k)) _ _
      (C.laws.addition (Integers.reverse k) x y))
    (Transport.binaryNatural C.family.Carrier C.family.Carrier C.family.Carrier (\fun (z: Degree) => (C.family.space z).add)
      (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k)
      (C.differential.apply (Integers.reverse k) x) (C.differential.apply (Integers.reverse k) y));
\definition scalar: \forall (k: Degree)(a: R)(x: Carrier k) ->
  apply k ((space k).smul a x) = (space (next k)).smul a (apply k x) :=
  \fun (k: Degree)(a: R)(x: Carrier k) => trans!{{Carrier (next k)}} _ _ _
    (congr!{{C.family.Carrier (previous (Integers.reverse k))} {Carrier (next k)}}
      (Transport.cast C.family.Carrier (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k)) _ _
      (C.laws.scalar (Integers.reverse k) a x))
    (Transport.natural C.family.Carrier C.family.Carrier (\fun (z: Degree) => (C.family.space z).smul a)
      (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k) (C.differential.apply (Integers.reverse k) x));
\definition squareZero: \forall (k: Degree)(x: Carrier k) -> apply (next k) (apply k x) = (space (next (next k))).zero :=
  \fun (k: Degree)(x: Carrier k) => trans!{{Carrier (next (next k))}} _ _ _
    (congr!{{C.family.Carrier (previous (Integers.reverse (next k)))} {Carrier (next (next k))}}
      (Transport.cast C.family.Carrier (previous (Integers.reverse (next k))) (Integers.reverse (next (next k))) (target (next k))) _ _
      (sym!{{C.family.Carrier (previous (Integers.reverse (next k)))}} _ _
        (Transport.natural C.family.Carrier (\fun (z: Degree) => C.family.Carrier (previous z)) (C.differential.apply)
          (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k) (C.differential.apply (Integers.reverse k) x))))
    (trans!{{Carrier (next (next k))}} _ _ _
      (congr!{{C.family.Carrier (previous (Integers.reverse (next k)))} {Carrier (next (next k))}}
        (Transport.cast C.family.Carrier (previous (Integers.reverse (next k))) (Integers.reverse (next (next k))) (target (next k))) _ _
        (trans!{{C.family.Carrier (previous (Integers.reverse (next k)))}} _ _ _
          (congr!{{C.family.Carrier (previous (previous (Integers.reverse k)))} {C.family.Carrier (previous (Integers.reverse (next k)))}}
            (Transport.cast (\fun (z: Degree) => C.family.Carrier (previous z)) (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k)) _ _
            (C.laws.squareZero (Integers.reverse k) x))
          (Transport.pointNatural (\fun (z: Degree) => C.family.Carrier (previous z)) (\fun (z: Degree) => (C.family.space (previous z)).zero)
            (previous (Integers.reverse k)) (Integers.reverse (next k)) (target k))))
      (Transport.pointNatural C.family.Carrier (\fun (z: Degree) => (C.family.space z).zero)
        (previous (Integers.reverse (next k))) (Integers.reverse (next (next k))) (target (next k))));
\definition complex: Cochains.Complex := Cochains.Complex {
  family := family, differential := Cochains.DifferentialData[family] { apply := apply },
  laws := Cochains.DifferentialLaws[family, Cochains.DifferentialData[family] { apply := apply }] {
    addition := addition, scalar := scalar, squareZero := squareZero,
  },
};

\module Mapping(D: Complex);

\module Homology(k: Degree);
