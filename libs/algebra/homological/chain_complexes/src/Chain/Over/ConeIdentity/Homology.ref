\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.At[C := Cone.complex, z := k] \as H;
\import Homotopies.At[k := k] \as Invariance;
\definition vanishes: \forall (q: H.Homology) -> q = H.zeroClass :=
  \fun (q: H.Homology) => eq_reason_in!{H.Homology _
    "=" _ "by" { sym!{H.Homology} _ _ (End.At[k := k].identityOnHomology q) }
    "=" _ "by" { Invariance.onHomology End.identity End.zeroMap homotopy q }
    "=" _ "by" { End.At[k := k].zeroOnHomology q }
  };
