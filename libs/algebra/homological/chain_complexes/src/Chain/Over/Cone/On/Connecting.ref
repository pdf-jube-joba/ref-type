\import \parent.\parent.\parent.At[C := C, z := previous k] \as Original;
\import \parent.\parent.\parent.At[C := D, z := previous k] \as Target;
\import \parent.\parent.\parent.Map[C := C, D := D].At[k := previous k] \as Given;
\import \parent.\parent.\parent.Shift[C := C].Homology[k := k] \as Shift;
\import \parent.\parent.\parent.At[C := Shifted.complex, z := k] \as ShiftHomology;
\import Exact.At[s := sequence, k := k] \as Connecting;
\import Modules.Biproduct[V := D.family.Carrier k, W := C.family.Carrier (previous k), left := D.family.space k, right := C.family.space (previous k)] \as Sum;
\import Modules.Biproduct[V := D.family.Carrier (previous k), W := C.family.Carrier (previous (previous k)), left := D.family.space (previous k), right := C.family.space (previous (previous k))] \as After;
\import std.Data[].Pair[].Prop[A := D.family.Carrier (previous k), B := C.family.Carrier (previous (previous k))] \as Pairs;
\import Modules.Hom[V := D.family.Carrier k, W := D.family.Carrier (previous k), source := D.family.space k, target := D.family.space (previous k)] \as Differential;
\import \parent.\parent.\parent.At[C := D, z := k] \as DCurrent;
\import Modules.Laws[V := D.family.Carrier (previous k), space := D.family.space (previous k)] \as Left;
\import algebra.Group[].Of[Carrier := D.family.Carrier (previous k), group := Left.additive] \as LeftGroup;
\import Modules.Laws[V := C.family.Carrier (previous (previous k)), space := C.family.space (previous (previous k))] \as Right;
\import algebra.Group[].Of[Carrier := C.family.Carrier (previous (previous k)), group := Right.additive] \as RightGroup;
\definition lift(x: Original.Cycle): Sum.Carrier := Sum.secondInjection.apply x;
\definition differential: \forall (x: Original.Cycle) ->
  inclusion.apply (previous k) ((Given.cyclesMap f).apply x) = complex.differential.apply k (lift x) :=
  \fun (x: Original.Cycle) => Pairs.ext _ _
    (sym!{{D.family.Carrier (previous k)}} _ _ (trans!{{D.family.Carrier (previous k)}} _ _ _
      (congr!{{D.family.Carrier (previous k)} {D.family.Carrier (previous k)}}
        (\fun (y: D.family.Carrier (previous k)) => (D.family.space (previous k)).add y (f.apply (previous k) x)) _ _
        (Differential.zeroPreserved DCurrent.differential)) (LeftGroup.zeroLeft (f.apply (previous k) x))))
    (sym!{{C.family.Carrier (previous (previous k))}} _ _ (trans!{{C.family.Carrier (previous (previous k))}} _ _ _
      (congr!{{C.family.Carrier (previous (previous k))} {C.family.Carrier (previous (previous k))}}
        ((C.family.space (previous (previous k))).neg) _ _ (\bysub(C.family.Carrier (previous k), Original.cycles.carrier, x))) RightGroup.negZero));
\definition onOriginalCycle: \forall (x: Original.Cycle) ->
  Connecting.connecting.apply (Shift.isomorphism.forward.apply (Original.classOf x)) = (Given.induced f).apply (Original.classOf x) :=
  \fun (x: Original.Cycle) => trans!{Target.Homology} _ _ _
    (congr!{{ShiftHomology.Homology} Target.Homology} (Connecting.connecting.apply) _ _ (Shift.onClass x))
    (trans!{Target.Homology} _ _ _ (Connecting.onClass (Shift.cycleIsomorphism.forward.apply x))
      (trans!{Target.Homology} _ _ _
        (Connecting.onLift (Shift.cycleIsomorphism.forward.apply x) (lift x) ((Given.cyclesMap f).apply x)
          (\refl(x)) (differential x) (Given.preservesCycle f x))
        (sym!{Target.Homology} _ _ (Given.onClass f x))));
\definition natural: \forall (q: Original.Homology) ->
  Connecting.connecting.apply (Shift.isomorphism.forward.apply q) = (Given.induced f).apply q :=
  Original.classInduction (\fun (q: Original.Homology) => Connecting.connecting.apply (Shift.isomorphism.forward.apply q) = (Given.induced f).apply q) onOriginalCycle;

\definition formula: \forall (q: ShiftHomology.Homology) ->
  Connecting.connecting.apply q = (Given.induced f).apply (Shift.isomorphism.backward.apply q) :=
  \fun (q: ShiftHomology.Homology) => trans!{Target.Homology} _ _ _
    (congr!{ShiftHomology.Homology Target.Homology} (Connecting.connecting.apply) _ _
      (sym!{ShiftHomology.Homology} _ _ (Shift.isomorphism.rightInverse q)))
    (natural (Shift.isomorphism.backward.apply q));
\definition injective: Given.Bijective[f] -> \forall (x, y: ShiftHomology.Homology) ->
  Connecting.connecting.apply x = Connecting.connecting.apply y -> x = y :=
  \fun (bijective: Given.Bijective[f])(x, y: ShiftHomology.Homology)(equal: _) =>
    trans!{ShiftHomology.Homology} x (Shift.isomorphism.forward.apply (Shift.isomorphism.backward.apply x)) y
      (sym!{ShiftHomology.Homology} _ _ (Shift.isomorphism.rightInverse x))
      (trans!{ShiftHomology.Homology} _ _ _
        (congr!{Original.Homology ShiftHomology.Homology} (Shift.isomorphism.forward.apply) _ _
          (bijective.injective _ _ (trans!{Target.Homology} _ _ _ (sym!{Target.Homology} _ _ (formula x))
            (trans!{Target.Homology} _ _ _ equal (formula y)))))
        (Shift.isomorphism.rightInverse y));
\definition onto: Given.Bijective[f] -> \forall (y: Target.Homology) ->
  \exists { x: ShiftHomology.Homology \where Connecting.connecting.apply x = y } := \block {
  \fun (bijective: Given.Bijective[f])(y: Target.Homology) \then
  \takefrom x: \Cast[Original.Homology] ({ x: Original.Homology \where (Given.induced f).apply x = y }) \by bijective.onto y \then
  \return Logic.existsIntro[ShiftHomology.Homology, { q: ShiftHomology.Homology \where Connecting.connecting.apply q = y }] (Shift.isomorphism.forward.apply x)
    (trans!{Target.Homology} _ _ _ (natural x)
        (\bysub(Original.Homology, { x: Original.Homology \where (Given.induced f).apply x = y }, x)))
};
\definition originalInjective:
  (\forall (x, y: ShiftHomology.Homology) -> Connecting.connecting.apply x = Connecting.connecting.apply y -> x = y) ->
  \forall (x, y: Original.Homology) -> (Given.induced f).apply x = (Given.induced f).apply y -> x = y :=
  \fun (injective: _)(x, y: Original.Homology)(equal: _) => trans!{Original.Homology} _ _ _
    (sym!{Original.Homology} _ _ (Shift.isomorphism.leftInverse x))
    (trans!{Original.Homology} _ _ _
      (congr!{ShiftHomology.Homology Original.Homology} (Shift.isomorphism.backward.apply) _ _
        (injective _ _ (trans!{Target.Homology} _ _ _ (natural x)
          (trans!{Target.Homology} _ _ _ equal (sym!{Target.Homology} _ _ (natural y))))))
      (Shift.isomorphism.leftInverse y));
\definition originalOnto:
  (\forall (y: Target.Homology) -> \exists { x: ShiftHomology.Homology \where Connecting.connecting.apply x = y }) ->
  \forall (y: Target.Homology) -> \exists { x: Original.Homology \where (Given.induced f).apply x = y } := \block {
  \fun (onto: _)(y: Target.Homology) \then
  \takefrom x: \Cast[ShiftHomology.Homology] ({ x: ShiftHomology.Homology \where Connecting.connecting.apply x = y }) \by onto y \then
  \return Logic.existsIntro[Original.Homology, { q: Original.Homology \where (Given.induced f).apply q = y }] (Shift.isomorphism.backward.apply x)
    (trans!{Target.Homology} _ _ _ (sym!{Target.Homology} _ _ (formula x))
        (\bysub(ShiftHomology.Homology, { x: ShiftHomology.Homology \where Connecting.connecting.apply x = y }, x)))
};
