\import \parent.\parent.At[C := C, z := previous k] \as Original;
\import \parent.\parent.At[C := C, z := previous (previous k)] \as After;
\import Modules.Hom[V := C.family.Carrier (previous k), W := C.family.Carrier (previous (previous k)), source := C.family.space (previous k), target := C.family.space (previous (previous k))] \as Maps;
\import Modules.Hom[V := C.family.Carrier (previous (previous k)), W := C.family.Carrier (previous (previous (previous k))), source := C.family.space (previous (previous k)), target := C.family.space (previous (previous (previous k)))] \as NextMaps;
\import Modules.Laws[V := C.family.Carrier (previous (previous (previous k))), space := C.family.space (previous (previous (previous k)))] \as Target;
\import algebra.Group[].Of[Carrier := C.family.Carrier (previous (previous (previous k))), group := Target.additive] \as Group;
\definition negative: Maps.Map := Maps.negative Original.differential;
\definition squareZero: \forall (x: C.family.Carrier (previous k)) ->
  (C.family.space (previous (previous (previous k)))).neg
    (C.differential.apply (previous (previous k)) (negative.apply x)) = (C.family.space (previous (previous (previous k)))).zero :=
  \fun (x: C.family.Carrier (previous k)) => trans!{{C.family.Carrier (previous (previous (previous k)))}} _ _ _
    (congr!{{C.family.Carrier (previous (previous (previous k)))} {C.family.Carrier (previous (previous (previous k)))}}
      ((C.family.space (previous (previous (previous k)))).neg) _ _
      (NextMaps.negativePreserved After.differential (Original.differential.apply x)))
    (trans!{{C.family.Carrier (previous (previous (previous k)))}} _ _ _
      (Group.negNeg (C.differential.apply (previous (previous k)) (C.differential.apply (previous k) x)))
      (C.laws.squareZero (previous k) x));
