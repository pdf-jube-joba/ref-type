\definition Base: \Set := M.Carrier;
\definition baseSpace: Modules.Space Base := M.space;
\import Modules.Of[V := Base, space := baseSpace] \as BaseModule;
\import BaseModule.Submodule[] \as Submodules;
\import algebra.Group[].Of[Carrier := Base, group := BaseModule.additive] \as Group;
\import Modules.Laws[V := Base, space := baseSpace] \as Laws;
\definition Eligible(x: Base): \Prop := Logic.Or[z = degree, x = baseSpace.zero];
\definition addition: \forall (x, y: Base) -> Eligible x -> Eligible y -> Eligible (baseSpace.add x y) :=
  \fun (x, y: Base)(left: Eligible x)(right: Eligible y) =>
    either!{left {Eligible (baseSpace.add x y)}
      {\fun (nonnegative: z = degree) => Logic.Or[_, _]::left nonnegative}
      {\fun (equalX: x = baseSpace.zero) => either!{right {Eligible (baseSpace.add x y)}
        {\fun (nonnegative: z = degree) => Logic.Or[_, _]::left nonnegative}
        {\fun (equalY: y = baseSpace.zero) => Logic.Or[_, _]::right (trans!{Base} (baseSpace.add x y) (baseSpace.add baseSpace.zero baseSpace.zero) baseSpace.zero
          (congr2!{Base Base Base} (baseSpace.add) x baseSpace.zero y baseSpace.zero equalX equalY) (Group.zeroLeft baseSpace.zero))}
      }}
    };
\definition scalar: \forall (a: R)(x: Base) -> Eligible x -> Eligible (baseSpace.smul a x) :=
  \fun (a: R)(x: Base)(member: Eligible x) => either!{member {Eligible (baseSpace.smul a x)}
    {\fun (nonnegative: z = degree) => Logic.Or[_, _]::left nonnegative}
    {\fun (equal: x = baseSpace.zero) => Logic.Or[_, _]::right (trans!{Base} (baseSpace.smul a x) (baseSpace.smul a baseSpace.zero) baseSpace.zero
      (congr!{Base Base} (baseSpace.smul a) x baseSpace.zero equal) (Laws.scaleZero a))}
  };
\definition submodule: Submodules.Submodule := Submodules.Submodule {
  carrier := { x: Base \where Eligible x }, zero := Logic.Or[_, _]::right (\refl(baseSpace.zero)), addition := addition, scalar := scalar,
};
\import Submodules.Of[S := submodule] \as Induced;
\definition Carrier: \Set := Induced.Carrier;
\definition space: Modules.Space Carrier := Induced.moduleSpace;
