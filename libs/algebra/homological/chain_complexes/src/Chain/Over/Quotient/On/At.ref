\import Maps.At[k := k] \as Map;
\import Modules.Of[V := D.family.Carrier k, space := D.family.space k].Submodule[] \as Sub;
\import Sub.Image[U := C.family.Carrier k, source := C.family.space k] \as Images;
\definition image: Sub.Submodule := Images.image (Map.linear f);
\import Sub.Quotient[S := image] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition space: Modules.Space Carrier := Quotient.moduleSpace;
\definition class: D.family.Carrier k -> Carrier := Quotient.class;
\definition projection: Modules.Hom[V := D.family.Carrier k, W := Carrier, source := D.family.space k, target := space].Map := Quotient.projection;
\import Modules.Of[V := D.family.Carrier (previous k), space := D.family.space (previous k)].Submodule[] \as LowerSub;
\import LowerSub.Image[U := C.family.Carrier (previous k), source := C.family.space (previous k)] \as LowerImage;
\import Maps.At[k := previous k] \as LowerMap;
\definition lowerImage: LowerSub.Submodule := LowerImage.image (LowerMap.linear f);
\import LowerSub.Quotient[S := lowerImage] \as Lower;
\import Modules.Hom[V := D.family.Carrier (previous k), W := Lower.Carrier, source := D.family.space (previous k), target := Lower.moduleSpace].Composition[U := D.family.Carrier k, domain := D.family.space k] \as Composition;
\import \parent.\parent.\parent.At[C := D, z := k] \as Original;
\definition raw: Modules.Hom[V := D.family.Carrier k, W := Lower.Carrier, source := D.family.space k, target := Lower.moduleSpace].Map :=
  Composition.compose Lower.projection Original.differential;
\import Quotient.To[W := Lower.Carrier, target := Lower.moduleSpace] \as Descent;
\definition vanishes: Descent.Vanishes raw :=
  \fun (x: D.family.Carrier k)(member: Sub.Member image x) => Images.eliminate (Map.linear f) x
    (raw.apply x = Lower.zeroClass)
    (\fun (y: C.family.Carrier k)(equal: f.apply k y = x) => Lower.classZero (D.differential.apply k x)
      (LowerImage.introduce (LowerMap.linear f) (D.differential.apply k x) (C.differential.apply k y)
        (trans!{{D.family.Carrier (previous k)}} _ _ _ (sym!{{D.family.Carrier (previous k)}} _ _ (f.commutes k y))
          (congr!{{D.family.Carrier k} {D.family.Carrier (previous k)}} (D.differential.apply k) _ _ equal)))) member;
\definition differential: Modules.Hom[V := Carrier, W := Lower.Carrier, source := space, target := Lower.moduleSpace].Map :=
  Descent.descend raw vanishes;
\definition onClass: \forall (x: D.family.Carrier k) -> differential.apply (class x) = Lower.class (D.differential.apply k x) :=
  Descent.onClass raw vanishes;
\module Square;
\definition squareZero: \forall (q: Carrier) ->
  (\parent.At[k := previous k].differential).apply (differential.apply q) =
    (\parent.At[k := previous (previous k)].space).zero := Square[].law;

\definition onto: \forall (q: Carrier) -> \exists { x: D.family.Carrier k \where class x = q } := Quotient.onto;
\definition onImage: \forall (x: C.family.Carrier k) -> class (f.apply k x) = space.zero :=
  \fun (x: C.family.Carrier k) => Quotient.classZero (f.apply k x) (Images.member (Map.linear f) x);
\definition zeroClassImage: \forall (x: D.family.Carrier k) -> class x = space.zero ->
  \exists { y: C.family.Carrier k \where f.apply k y = x } := Quotient.zeroClassMember;
