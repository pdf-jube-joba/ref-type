\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.At[k := previous k] \as After;
\import \parent.\parent.At[k := previous (previous k)] \as Last;
\definition law: \forall (q: Carrier) -> After.differential.apply (differential.apply q) = Last.space.zero :=
  Quotient.induction (\fun (q: Carrier) => After.differential.apply (differential.apply q) = Last.space.zero)
    (\fun (x: D.family.Carrier k) => eq_reason_in!{Last.Carrier _
      "=" _ "by" { congr!{After.Carrier Last.Carrier} (After.differential.apply) _ _ (onClass x) }
      "=" _ "by" { After.onClass (D.differential.apply k x) }
      "=" _ "by" { congr!{{D.family.Carrier (previous (previous k))} Last.Carrier} Last.class _ _ (D.laws.squareZero k x) }
    });
