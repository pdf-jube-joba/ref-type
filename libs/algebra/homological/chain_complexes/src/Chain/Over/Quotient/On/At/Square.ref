\import \parent.\parent.At[k := previous k] \as After;
\import \parent.\parent.At[k := previous (previous k)] \as Last;
\definition law: \forall (q: Carrier) -> After.differential.apply (differential.apply q) = Last.space.zero :=
  Quotient.induction (\fun (q: Carrier) => After.differential.apply (differential.apply q) = Last.space.zero)
    (\fun (x: D.family.Carrier k) => trans!{Last.Carrier} _ _ _
      (congr!{After.Carrier Last.Carrier} (After.differential.apply) _ _ (onClass x))
      (trans!{Last.Carrier} _ _ _ (After.onClass (D.differential.apply k x))
        (congr!{{D.family.Carrier (previous (previous k))} Last.Carrier} Last.class _ _ (D.laws.squareZero k x))));
