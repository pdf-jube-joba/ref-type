\import \parent.\parent.At[C := C, z := z] \as Source;
\import \parent.\parent.At[C := D, z := z] \as Target;
\import Forward.At[k := z] \as ForwardMap;
\import Backward.At[k := z] \as BackwardMap;
\import Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Iso;
\definition leftInverse: \forall (e: Isomorphism)(q: Source.Homology) ->
  (BackwardMap.induced e.backward).apply ((ForwardMap.induced e.forward).apply q) = q :=
  \fun (e: Isomorphism) => Source.classInduction
    (\fun (q: Source.Homology) => (BackwardMap.induced e.backward).apply ((ForwardMap.induced e.forward).apply q) = q)
    (\fun (x: Source.Cycle) => trans!{Source.Homology} _ _ _
      (congr!{Target.Homology Source.Homology} ((BackwardMap.induced e.backward).apply) _ _ (ForwardMap.onClass e.forward x))
      (trans!{Source.Homology} _ _ _ (BackwardMap.onClass e.backward ((ForwardMap.cyclesMap e.forward).apply x))
        (congr!{Source.Cycle Source.Homology} Source.classOf
          ((BackwardMap.cyclesMap e.backward).apply ((ForwardMap.cyclesMap e.forward).apply x)) x
          (e.leftInverse z x))));
\definition rightInverse: \forall (e: Isomorphism)(q: Target.Homology) ->
  (ForwardMap.induced e.forward).apply ((BackwardMap.induced e.backward).apply q) = q :=
  \fun (e: Isomorphism) => Target.classInduction
    (\fun (q: Target.Homology) => (ForwardMap.induced e.forward).apply ((BackwardMap.induced e.backward).apply q) = q)
    (\fun (x: Target.Cycle) => trans!{Target.Homology} _ _ _
      (congr!{Source.Homology Target.Homology} ((ForwardMap.induced e.forward).apply) _ _ (BackwardMap.onClass e.backward x))
      (trans!{Target.Homology} _ _ _ (ForwardMap.onClass e.forward ((BackwardMap.cyclesMap e.backward).apply x))
        (congr!{Target.Cycle Target.Homology} Target.classOf
          ((ForwardMap.cyclesMap e.forward).apply ((BackwardMap.cyclesMap e.backward).apply x)) x
          (e.rightInverse z x))));
\definition isomorphism(e: Isomorphism): Iso.Isomorphism := Iso.Isomorphism {
  forward := ForwardMap.induced e.forward, backward := BackwardMap.induced e.backward,
  leftInverse := leftInverse e, rightInverse := rightInverse e,
};
