\module At(k: Degree) {
  \import Modules.Of[V := C.family.Carrier k, space := C.family.space k].Submodule[] \as Submodules;
  \import Submodules.Kernel[W := D.family.Carrier k, target := D.family.space k] \as Kernel;
  \import \parent.\parent.At[k := k] \as Original;
  \definition submodule: Submodules.Submodule := Kernel.kernel (Original.linear f);
  \import Submodules.Of[S := submodule] \as Induced;
  \definition Carrier: \Set := Induced.Carrier;
  \definition space: Modules.Space Carrier := Induced.moduleSpace;
  \definition killed: \forall (x: Carrier) -> #apply{f} k x = #zero{(D.family.space k)} :=
    \fun (x: Carrier) => \bysub(C.family.Carrier k, #carrier{submodule}, x);
}
\definition family: Family := Family {
  Carrier := \fun (k: Degree) => At[k := k].Carrier,
  space := \fun (k: Degree) => At[k := k].space,
};
\module Differential(k: Degree) {
  \import \parent.At[k := k] \as Source;
  \import \parent.At[k := previous k] \as Target;
  \import \parent.\parent.At[k := previous k] \as Original;
  \import \parent.\parent.\parent.At[C := D, z := k] \as TargetDifferential;
  \import Modules.Hom[V := D.family.Carrier k, W := D.family.Carrier (previous k), source := D.family.space k, target := D.family.space (previous k)] \as Maps;
  \definition closed: \forall (x: Source.Carrier) -> #apply{f} (previous k) (#apply{C.differential} k x) = #zero{(D.family.space (previous k))} :=
    \fun (x: Source.Carrier) => trans!{{D.family.Carrier (previous k)}} _ _ _
      (sym!{{D.family.Carrier (previous k)}} _ _ (#commutes{f} k x))
      (trans!{{D.family.Carrier (previous k)}} _ _ _
        (congr!{{D.family.Carrier k} {D.family.Carrier (previous k)}} (#apply{D.differential} k) _ _ (Source.killed x))
        (Maps.zeroPreserved TargetDifferential.differential));
  \definition apply(x: Source.Carrier): Target.Carrier :=
    \into[C.family.Carrier (previous k)](#apply{C.differential} k x, #carrier{Target.submodule}) \by { closed x };
}
\definition differential: DifferentialData[family] := DifferentialData[family] {
  apply := \fun (k: Degree) => Differential[k := k].apply,
};
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    addition := \fun (k: Degree)(x, y: At[k := k].Carrier) => #addition{C.laws} k x y,
    scalar := \fun (k: Degree)(a: R)(x: At[k := k].Carrier) => #scalar{C.laws} k a x,
    squareZero := \fun (k: Degree)(x: At[k := k].Carrier) => #squareZero{C.laws} k x,
  },
};
\import \parent.\parent.Map[C := complex, D := C] \as Inclusion;
\definition inclusion: Inclusion.Map := Inclusion.Map {
  apply := \fun (k: Degree)(x: At[k := k].Carrier) => x,
  addition := \fun (k: Degree)(x, y: At[k := k].Carrier) => \refl(#add{(C.family.space k)} x y),
  scalar := \fun (k: Degree)(a: R)(x: At[k := k].Carrier) => \refl(#smul{(C.family.space k)} a x),
  commutes := \fun (k: Degree)(x: At[k := k].Carrier) => \refl(#apply{C.differential} k x),
};
\definition Onto: \Prop := \forall (k: Degree)(y: D.family.Carrier k) -> \exists { x: C.family.Carrier k \where #apply{f} k x = y };
\import \parent.\parent.ShortExact[A := complex, B := C, C := D] \as Exact;
\definition sequence(onto: Onto): Exact.Sequence := Exact.Sequence {
  inclusion := inclusion, projection := f,
  injective := \fun (k: Degree)(x, y: At[k := k].Carrier)(same: x = y) => same,
  onto := onto,
  zero := \fun (k: Degree) => At[k := k].killed,
  kernelImage := \fun (k: Degree)(x: C.family.Carrier k)(killed: #apply{f} k x = #zero{(D.family.space k)}) =>
    Logic.existsIntro[At[k := k].Carrier, { y: At[k := k].Carrier \where #apply{inclusion} k y = x }]
      (\into[C.family.Carrier k](x, #carrier{At[k := k].submodule}) \by { killed }) (\refl(x)),
};
\definition Acyclic: \Prop := \forall (k: Degree)(q: \parent.\parent.At[C := complex, z := k].Homology) -> q = \parent.\parent.At[C := complex, z := k].zeroClass;
\definition quasiIsomorphism: Onto -> Acyclic -> QuasiIsomorphism f :=
  \fun (onto: Onto)(acyclic: Acyclic) => Exact.quasiProjection (sequence onto) acyclic;
\import \parent.\parent.Prior[C := complex] \as Prior;
\definition ExactCycles: \Prop := \forall (k: Degree)(x: At[k := k].Carrier) ->
  #apply{differential} k x = #zero{(At[k := previous k].space)} ->
  \exists { y: At[k := next k].Carrier \where Prior.value k y = x };
\module Homology(k: Degree) {
  \import \parent.\parent.\parent.At[C := complex, z := k] \as H;
  \import Modules.Of[V := \parent.At[k := k].Carrier, space := \parent.At[k := k].space].Submodule[] \as Submodules;
  \import Submodules.Image[U := \parent.At[k := next k].Carrier, source := \parent.At[k := next k].space] \as Images;
  \definition cycleBoundary: ExactCycles -> \forall (x: H.Cycle) -> Submodules.Member H.boundaries x := \block {
    \fun (exact: ExactCycles)(x: H.Cycle) \then
    \takefrom y: \Cast[\parent.At[k := next k].Carrier] ({ y: \parent.At[k := next k].Carrier \where Prior.value k y = x }) \by
      exact k x (\bysub(\parent.At[k := k].Carrier, #carrier{H.cycles}, x)) \then
    \return \idelim Prior.value k y = x \with v: \parent.At[k := k].Carrier => Submodules.Member H.boundaries v \by {
      base: Images.member H.prior y,
      equality: \bysub(\parent.At[k := next k].Carrier, { y: \parent.At[k := next k].Carrier \where Prior.value k y = x }, y)
    }
  };
  \definition vanishes: ExactCycles -> \forall (q: H.Homology) -> q = H.zeroClass :=
    \fun (exact: ExactCycles) => H.classInduction (\fun (q: H.Homology) => q = H.zeroClass)
      (\fun (x: H.Cycle) => H.boundaryClassZero x (cycleBoundary exact x));
}
\definition acyclic: ExactCycles -> Acyclic := \fun (exact: ExactCycles)(k: Degree) => Homology[k := k].vanishes exact;
\definition quasiOfExactCycles: Onto -> ExactCycles -> QuasiIsomorphism f :=
  \fun (onto: Onto)(exact: ExactCycles) => quasiIsomorphism onto (acyclic exact);
\import \parent.\parent.Prior[C := C] \as OriginalPrior;
\structure BoundaryAt[k: Degree, x: C.family.Carrier k]: \Set {
  value: C.family.Carrier (next k),
  killed: #apply{f} (next k) value = #zero{(D.family.space (next k))},
  boundary: OriginalPrior.value k value = x,
}
\definition OriginalExactCycles: \Prop := \forall (k: Degree)(x: C.family.Carrier k) ->
  #apply{f} k x = #zero{(D.family.space k)} ->
  #apply{C.differential} k x = #zero{(C.family.space (previous k))} -> \exists BoundaryAt[k, x];
\definition exactCycles: OriginalExactCycles -> ExactCycles := \block {
  \fun (exact: OriginalExactCycles)(k: Degree)(x: At[k := k].Carrier)(closed: #apply{differential} k x = #zero{(At[k := previous k].space)}) \then
  \takefrom witness: BoundaryAt[k, x] \by exact k x (At[k := k].killed x) closed \then
  \let y: At[k := next k].Carrier := \into[C.family.Carrier (next k)](#value{witness}, #carrier{At[k := next k].submodule}) \by { #killed{witness} } \then
  \return Logic.existsIntro[At[k := next k].Carrier, { y: At[k := next k].Carrier \where Prior.value k y = x }] y
    (trans!{{C.family.Carrier k}} _ _ _
      (sym!{{C.family.Carrier k}} _ _ (Inclusion.priorCommutes k inclusion y)) (#boundary{witness}))
};
\definition quasiOfOriginalExactCycles: Onto -> OriginalExactCycles -> QuasiIsomorphism f :=
  \fun (onto: Onto)(exact: OriginalExactCycles) => quasiOfExactCycles onto (exactCycles exact);
