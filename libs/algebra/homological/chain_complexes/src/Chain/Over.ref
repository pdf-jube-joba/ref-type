\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\structure Family {
  Carrier: Degree -> \Set,
  space: \forall (z: Degree) -> Modules.Space (Carrier z),
}
\structure DifferentialData[F: Family]: \Set { apply: \forall (z: Degree) -> F.Carrier z -> F.Carrier (previous z) }
\structure DifferentialLaws[F: Family, d: DifferentialData[F]]: \Prop {
  addition: \forall (z: Degree)(x, y: F.Carrier z) -> d.apply z ((F.space z).add x y) = (F.space (previous z)).add (d.apply z x) (d.apply z y),
  scalar: \forall (z: Degree)(a: R)(x: F.Carrier z) -> d.apply z ((F.space z).smul a x) = (F.space (previous z)).smul a (d.apply z x),
  squareZero: \forall (z: Degree)(x: F.Carrier z) -> d.apply (previous z) (d.apply z x) = (F.space (previous (previous z))).zero,
}
\structure Complex {
  family: Family,
  differential: DifferentialData[family],
  laws: DifferentialLaws[family, differential],
}
\module FamilyTransport(F: Family);
\module Prior(C: Complex);
\module At(C: Complex, z: Degree);
\definition homology(C: Complex)(z: Degree): \Set := At[C := C, z := z].Homology;

\module Map(C, D: Complex);
\module End(C: Complex) {
  \import \parent.Map[C := C, D := C] \as Maps;
  \definition identity: Maps.Map := Maps.Map {
    apply := \fun (k: Degree)(x: C.family.Carrier k) => x,
    addition := \fun (k: Degree)(x, y: C.family.Carrier k) => \refl((C.family.space k).add x y),
    scalar := \fun (k: Degree)(a: R)(x: C.family.Carrier k) => \refl((C.family.space k).smul a x),
    commutes := \fun (k: Degree)(x: C.family.Carrier k) => \refl(C.differential.apply k x),
  };
  \module Point(k: Degree) {
    \import \parent.\parent.At[C := C, z := k] \as Differential;
    \definition commutes: \forall (x: C.family.Carrier k) ->
      C.differential.apply k ((C.family.space k).zero) = (C.family.space (previous k)).zero :=
      \fun (x: C.family.Carrier k) => Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier (previous k), source := C.family.space k, target := C.family.space (previous k)].zeroPreserved Differential.differential;
  }
  \definition zeroMap: Maps.Map := Maps.Map {
    apply := \fun (k: Degree)(x: C.family.Carrier k) => (C.family.space k).zero,
    addition := \fun (k: Degree) => (Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier k,
      source := C.family.space k, target := C.family.space k].zeroMap).addition,
    scalar := \fun (k: Degree) => (Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier k,
      source := C.family.space k, target := C.family.space k].zeroMap).scalar,
    commutes := \fun (k: Degree) => Point[k := k].commutes,
  };
  \module At(k: Degree) {
    \import \parent.\parent.At[C := C, z := k] \as Homology;
    \import Maps.At[k := k] \as Map;
    \definition zeroOnHomology: \forall (q: Homology.Homology) -> (Map.induced zeroMap).apply q = Homology.zeroClass :=
      Homology.classInduction (\fun (q: Homology.Homology) => (Map.induced zeroMap).apply q = Homology.zeroClass)
        (\fun (x: Homology.Cycle) => Map.onClass zeroMap x);
    \definition inducedIdentity(h: Homology.Homology): Homology.Homology := (Map.induced identity).apply h;
    \definition identityOnHomology: \forall (h: Homology.Homology) -> (Map.induced identity).apply h = h :=
      Homology.classInduction (\fun (h: Homology.Homology) => (Map.induced identity).apply h = h)
        (\fun (x: Homology.Cycle) => Map.onClass identity x);
  }
}
\module Homotopy(C, D: Complex);
\module ZeroDifferential(family: Family);
\module Equivalence(C, D: Complex);
\module Shift(C: Complex);
\module Reverse(C: Complex);
\module Cone(C, D: Complex);
\module ShortExact(A, B, C: Complex);
\module Isomorphism(C, D: Complex);
\module ChangeBasis(C: Complex);

\module Zero {
  \import Modules.Zero[] \as Point;
  \definition family: Family := Family {
    Carrier := \fun (z: Degree) => Point.Carrier,
    space := \fun (z: Degree) => Point.moduleSpace,
  };
  \import \parent.ZeroDifferential[family := family] \as Constant;
  \definition complex: Complex := Constant.complex;
  \module At(z: Degree) {
    \import \parent.\parent.At[C := complex, z := z] \as H;
    \import H.Vanishing[] \as Vanishing;
    \definition vanishes: \forall (q: H.Homology) -> q = H.zeroClass := Vanishing.zero (\fun (x: Point.Carrier) => Point.unique x Point.Carrier::zero);
    \definition isomorphism: Modules.Isomorphism[V := H.Homology, W := Point.Carrier, source := H.homologySpace, target := Point.moduleSpace].Isomorphism :=
      Vanishing.isomorphism (\fun (x: Point.Carrier) => Point.unique x Point.Carrier::zero);
  }
}

\module Concentrated(M: Modules.Bundle, degree: Degree);

\module ConeIdentity(C: Complex);

\module Quotient(C, D: Complex);

\module View(C: Complex);
