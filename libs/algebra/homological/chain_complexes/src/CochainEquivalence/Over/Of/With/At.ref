\use std.Logic[].Equality[].eq_reason_in;
\import Cochains.At[C := C, k := n] \as Source;
\import Cochains.At[C := D, k := n] \as Target;
\import Forward.At[k := n] \as F;
\import Backward.At[k := n] \as G;
\import SourceEnd.At[k := n] \as SourceIdentity;
\import TargetEnd.At[k := n] \as TargetIdentity;
\import LeftComposition.At[k := n] \as LeftLaw;
\import RightComposition.At[k := n] \as RightLaw;
\import Left.At[n := n] \as LH;
\import Right.At[n := n] \as RH;
\definition leftInverse: \forall (x: Source.Cohomology) -> (G.induced e.backward).apply ((F.induced e.forward).apply x) = x :=
  \fun (x: Source.Cohomology) => eq_reason_in!{Source.Cohomology _
    "=" _ "by" { sym!{Source.Cohomology} _ _ (LeftLaw.compositionOnCohomology e.backward e.forward x) }
    "=" _ "by" { sym!{Source.Cohomology} _ _ (LH.same x) }
    "=" _ "by" { SourceIdentity.identityOnCohomology x }
  };
\definition rightInverse: \forall (y: Target.Cohomology) -> (F.induced e.forward).apply ((G.induced e.backward).apply y) = y :=
  \fun (y: Target.Cohomology) => eq_reason_in!{Target.Cohomology _
    "=" _ "by" { sym!{Target.Cohomology} _ _ (RightLaw.compositionOnCohomology e.forward e.backward y) }
    "=" _ "by" { sym!{Target.Cohomology} _ _ (RH.same y) }
    "=" _ "by" { TargetIdentity.identityOnCohomology y }
  };
\import Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := F.induced e.forward, backward := G.induced e.backward,
  leftInverse := leftInverse, rightInverse := rightInverse,
};
