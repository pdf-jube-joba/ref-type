\definition index: Signed.Int^ := Signed.Int^::ofNat n;
\definition injective: \forall (x, y: Left.Carrier index) -> data.inclusion.apply index x = data.inclusion.apply index y -> x = y :=
  \fun (x, y: Left.Carrier index)(equal: _) => s.injective n x y equal;
\definition onto: \forall (q: Right.Carrier index) -> \exists { y: Middle.Carrier index \where data.projection.apply index y = q } := \block {
  \fun (q: Right.Carrier index) \then
  \takefrom y: \Cast[B.family.Carrier n] ({ y: B.family.Carrier n \where s.projection.apply n y = q }) \by s.onto n q \then
  \return Logic.existsIntro[Middle.Carrier index, { y: Middle.Carrier index \where data.projection.apply index y = q }] (Middle.Positive[n := n].intro y)
    (\bysub(B.family.Carrier n, { y: B.family.Carrier n \where s.projection.apply n y = q }, y))
};
\definition kernelImage: \forall (y: Middle.Carrier index) -> data.projection.apply index y = (Right.space index).zero ->
  \exists { x: Left.Carrier index \where data.inclusion.apply index x = y } := \block {
  \fun (y: Middle.Carrier index)(killed: _) \then
  \takefrom x: \Cast[A.family.Carrier n] ({ x: A.family.Carrier n \where s.inclusion.apply n x = y }) \by s.kernelImage n y killed \then
  \return Logic.existsIntro[Left.Carrier index, { x: Left.Carrier index \where data.inclusion.apply index x = y }] (Left.Positive[n := n].intro x)
    (\bysub(A.family.Carrier n, { x: A.family.Carrier n \where s.inclusion.apply n x = y }, x))
};
