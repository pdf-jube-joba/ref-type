\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.At[C := A, k := N.Nat^::zero] \as HA;
\import \parent.\parent.\parent.At[C := B, k := N.Nat^::zero] \as HB;
\import \parent.\parent.\parent.DegreeZero[C := B] \as ZeroB;
\import Inclusion.At[k := N.Nat^::zero] \as Map;
\definition cycleEqual: \forall (a, b: HA.CycleCarrier) -> (Map.induced s.inclusion).apply (HA.classOf a) = (Map.induced s.inclusion).apply (HA.classOf b) -> (Map.cyclesMap s.inclusion).apply a = (Map.cyclesMap s.inclusion).apply b :=
  \fun (a, b: HA.CycleCarrier)(equal: _) => eq_reason_in!{HB.CycleCarrier _
    "=" _ "by" { sym!{HB.CycleCarrier} _ _ (ZeroB.kernelIso.leftInverse ((Map.cyclesMap s.inclusion).apply a)) }
    "=" _ "by" { congr!{HB.Cohomology HB.CycleCarrier} (ZeroB.kernelIso.backward.apply) _ _
        (eq_reason_in!{HB.Cohomology _
          "=" _ "by" { sym!{HB.Cohomology} _ _ (Map.onClass s.inclusion a) }
          "=" _ "by" equal
          "=" _ "by" { Map.onClass s.inclusion b }
        }) }
    "=" _ "by" { ZeroB.kernelIso.leftInverse ((Map.cyclesMap s.inclusion).apply b) }
  };
\definition onCycles: \forall (a, b: HA.CycleCarrier) -> (Map.induced s.inclusion).apply (HA.classOf a) = (Map.induced s.inclusion).apply (HA.classOf b) -> HA.classOf a = HA.classOf b :=
  \fun (a, b: HA.CycleCarrier)(equal: _) => congr!{HA.CycleCarrier HA.Cohomology} HA.classOf a b
    (s.injective N.Nat^::zero a b (cycleEqual a b equal));
\definition injective: \forall (a, b: HA.Cohomology) -> (Map.induced s.inclusion).apply a = (Map.induced s.inclusion).apply b -> a = b :=
  HA.classInduction
    (\fun (a: HA.Cohomology) => \forall (b: HA.Cohomology) -> (Map.induced s.inclusion).apply a = (Map.induced s.inclusion).apply b -> a = b)
    (\fun (a: HA.CycleCarrier) => HA.classInduction
      (\fun (b: HA.Cohomology) => (Map.induced s.inclusion).apply (HA.classOf a) = (Map.induced s.inclusion).apply b -> HA.classOf a = b)
      (\fun (b: HA.CycleCarrier) => onCycles a b));
