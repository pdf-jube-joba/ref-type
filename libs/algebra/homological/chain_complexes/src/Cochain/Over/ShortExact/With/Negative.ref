\definition index: Signed.Int^ := Signed.Int^::negSucc n;
\definition injective: \forall (x, y: Left.Carrier index) -> data.inclusion.apply index x = data.inclusion.apply index y -> x = y :=
  \fun (x, y: Left.Carrier index)(equal: _) => trans!{{Left.Carrier index}} x (Left.space index).zero y (Left.Negative[n := n].zero x) (sym!{{Left.Carrier index}} _ _ (Left.Negative[n := n].zero y));
\definition onto: \forall (q: Right.Carrier index) -> \exists { y: Middle.Carrier index \where data.projection.apply index y = q } :=
  \fun (q: Right.Carrier index) => Logic.existsIntro[Middle.Carrier index, { y: Middle.Carrier index \where data.projection.apply index y = q }] ((Middle.space index).zero)
    (sym!{{Right.Carrier index}} _ _ (Right.Negative[n := n].zero q));
\definition kernelImage: \forall (y: Middle.Carrier index) -> data.projection.apply index y = (Right.space index).zero ->
  \exists { x: Left.Carrier index \where data.inclusion.apply index x = y } :=
  \fun (y: Middle.Carrier index)(killed: _) => Logic.existsIntro[Left.Carrier index, { x: Left.Carrier index \where data.inclusion.apply index x = y }] ((Left.space index).zero)
    (sym!{{Middle.Carrier index}} _ _ (Middle.Negative[n := n].zero y));
