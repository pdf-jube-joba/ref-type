\import \parent.\parent.At[C := C, k := n] \as Source;
\import \parent.\parent.At[C := restricted, k := n] \as Target;
\import Forward.At[k := n] \as ForwardMap;
\import Backward.At[k := n] \as BackwardMap;
\import Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace] \as Iso;
\definition left: \forall (h: Source.Cohomology) -> (BackwardMap.induced backward).apply ((ForwardMap.induced forward).apply h) = h :=
  Source.classInduction (\fun (h: Source.Cohomology) => (BackwardMap.induced backward).apply ((ForwardMap.induced forward).apply h) = h)
    (\fun (x: Source.CycleCarrier) => trans!{{Source.Cohomology}} _ _ _
      (congr!{{Target.Cohomology} {Source.Cohomology}} ((BackwardMap.induced backward).apply) _ _ (ForwardMap.onClass forward x))
      (BackwardMap.onClass backward ((ForwardMap.cyclesMap forward).apply x)));
\definition right: \forall (h: Target.Cohomology) -> (ForwardMap.induced forward).apply ((BackwardMap.induced backward).apply h) = h :=
  Target.classInduction (\fun (h: Target.Cohomology) => (ForwardMap.induced forward).apply ((BackwardMap.induced backward).apply h) = h)
    (\fun (x: Target.CycleCarrier) => trans!{{Target.Cohomology}} _ _ _
      (congr!{{Source.Cohomology} {Target.Cohomology}} ((ForwardMap.induced forward).apply) _ _ (BackwardMap.onClass backward x))
      (ForwardMap.onClass forward ((BackwardMap.cyclesMap backward).apply x)));
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := ForwardMap.induced forward, backward := BackwardMap.induced backward,
  leftInverse := left, rightInverse := right,
};
