\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\module Laws(k: N.Nat^) {
  \import Modules.Laws[V := family.Carrier (next k), space := family.space (next k)] \as Target;
  \import algebra.Group[].Of[Carrier := family.Carrier (next k), group := Target.additive] \as Group;
  \definition addition: \forall (x, y: family.Carrier k) ->
    (family.space (next k)).zero = (family.space (next k)).add (family.space (next k)).zero (family.space (next k)).zero :=
    \fun (x, y: family.Carrier k) => sym!{{family.Carrier (next k)}} _ _ (Group.zeroLeft (family.space (next k)).zero);
  \definition scalar: \forall (a: R)(x: family.Carrier k) ->
    (family.space (next k)).zero = (family.space (next k)).smul a (family.space (next k)).zero :=
    \fun (a: R)(x: family.Carrier k) => sym!{{family.Carrier (next k)}} _ _ (Target.scaleZero a);
}
\definition differential: DifferentialData[family] := DifferentialData[family] {
  apply := \fun (k: N.Nat^)(x: family.Carrier k) => (family.space (next k)).zero,
};
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    addition := \fun (k: N.Nat^) => Laws[k := k].addition,
    scalar := \fun (k: N.Nat^) => Laws[k := k].scalar,
    squareZero := \fun (k: N.Nat^)(x: family.Carrier k) => \refl((family.space (next (next k))).zero),
  },
};
\module At(k: N.Nat^);
