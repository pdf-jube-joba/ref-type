\import \parent.Index[z := Signed.Int^::negSucc n] \as Source;
\import Modules.Laws[V := Carrier (Integers.next (Signed.Int^::negSucc n)), space := space (Integers.next (Signed.Int^::negSucc n))] \as Target;
\import algebra.Group[].Of[Carrier := Carrier (Integers.next (Signed.Int^::negSucc n)), group := Target.additive] \as TargetGroup;
\definition apply(x: Carrier (Signed.Int^::negSucc n)): Carrier (Integers.next (Signed.Int^::negSucc n)) := (space (Integers.next (Signed.Int^::negSucc n))).zero;
\definition addition: \forall (x, y: Carrier (Signed.Int^::negSucc n)) -> apply ((space (Signed.Int^::negSucc n)).add x y) = (space (Integers.next (Signed.Int^::negSucc n))).add (apply x) (apply y) :=
  \fun (x, y: Carrier (Signed.Int^::negSucc n)) => sym!{{Carrier (Integers.next (Signed.Int^::negSucc n))}} _ _ (TargetGroup.zeroLeft (space (Integers.next (Signed.Int^::negSucc n))).zero);
\definition scalar: \forall (a: R)(x: Carrier (Signed.Int^::negSucc n)) -> apply ((space (Signed.Int^::negSucc n)).smul a x) = (space (Integers.next (Signed.Int^::negSucc n))).smul a (apply x) :=
  \fun (a: R)(x: Carrier (Signed.Int^::negSucc n)) => sym!{{Carrier (Integers.next (Signed.Int^::negSucc n))}} _ _ (Target.scaleZero a);
\definition zero: \forall (x: Carrier (Signed.Int^::negSucc n)) -> x = (space (Signed.Int^::negSucc n)).zero :=
  \fun (x: Carrier (Signed.Int^::negSucc n)) => either!{{(\bysub(C.family.Carrier (N.Nat^::succ n), Source.submodule.carrier, x))} {x = (space (Signed.Int^::negSucc n)).zero}
    {\fun (false: Logic.False) => Logic.falseElim _ false}
    {\fun (equal: x = (C.family.space (N.Nat^::succ n)).zero) => equal}
  };
\import Modules.Zero[] \as Zero;
\import Modules.Hom[V := Carrier (Signed.Int^::negSucc n), W := Zero.Carrier, source := space (Signed.Int^::negSucc n), target := Zero.moduleSpace] \as Forward;
\import Modules.Hom[V := Zero.Carrier, W := Carrier (Signed.Int^::negSucc n), source := Zero.moduleSpace, target := space (Signed.Int^::negSucc n)] \as Backward;
\import Modules.Isomorphism[V := Carrier (Signed.Int^::negSucc n), W := Zero.Carrier, source := space (Signed.Int^::negSucc n), target := Zero.moduleSpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.zeroMap, backward := Backward.zeroMap,
  leftInverse := \fun (x: Carrier (Signed.Int^::negSucc n)) => sym!{{Carrier (Signed.Int^::negSucc n)}} _ _ (zero x),
  rightInverse := \fun (x: Zero.Carrier) => Zero.unique Zero.Carrier::zero x,
};
