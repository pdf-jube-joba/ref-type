\definition index: Signed.Int^ := Signed.Int^::ofNat N.Nat^::zero;
\import Internal.At[C := complex, z := index] \as H;
\import Modules.Of[V := Carrier index, space := space index].Submodule[] \as Submodules;
\import Submodules.Image[U := Carrier (Signed.Int^::negSucc N.Nat^::zero), source := space (Signed.Int^::negSucc N.Nat^::zero)] \as Images;
\definition onlyZero: \forall (x: Carrier index) -> Submodules.Member H.boundaries x -> x = (space index).zero :=
  \fun (x: Carrier index)(boundary: Submodules.Member H.boundaries x) => Images.eliminate H.prior x (x = (space index).zero)
    (\fun (y: Carrier (Signed.Int^::negSucc N.Nat^::zero))(equal: H.prior.apply y = x) => sym!{{Carrier index}} ((space index).zero) x equal) boundary;
\definition zeroBoundary: \forall (x: Carrier index) -> x = (space index).zero -> Submodules.Member H.boundaries x :=
  \fun (x: Carrier index)(equal: x = (space index).zero) => \idelim (space index).zero = x
    \with y: Carrier index => Submodules.Member H.boundaries y \by { base: H.boundaries.zero, equality: sym!{{Carrier index}} x ((space index).zero) equal };
