\definition index: Signed.Int^ := Signed.Int^::ofNat n;
\import Internal.At[C := complex, z := index] \as H;
\import \parent.\parent.At[C := C, k := n] \as Natural;
\import \parent.Positive[n := n] \as Positive;
\definition toNatural(x: H.Closed): Natural.CycleCarrier := Natural.cycle x (\bysub(Carrier index, H.cycles.carrier, x));
\definition toInteger(x: Natural.CycleCarrier): H.Closed := H.cycle (Positive.intro x) (\bysub(C.family.Carrier n, Natural.cycles.carrier, x));
\import Modules.Hom[V := H.Closed, W := Natural.CycleCarrier, source := H.cycleSpace, target := Natural.cycleSpace] \as ForwardCycles;
\import Modules.Hom[V := Natural.CycleCarrier, W := H.Closed, source := Natural.cycleSpace, target := H.cycleSpace] \as BackwardCycles;
\definition forwardCycles: ForwardCycles.Map := ForwardCycles.Map {
  apply := toNatural,
  addition := \fun (x, y: H.Closed) => \refl(Natural.cycleSpace.add (toNatural x) (toNatural y)),
  scalar := \fun (a: R)(x: H.Closed) => \refl(Natural.cycleSpace.smul a (toNatural x)),
};
\definition backwardCycles: BackwardCycles.Map := BackwardCycles.Map {
  apply := toInteger,
  addition := \fun (x, y: Natural.CycleCarrier) => \refl(H.cycleSpace.add (toInteger x) (toInteger y)),
  scalar := \fun (a: R)(x: Natural.CycleCarrier) => \refl(H.cycleSpace.smul a (toInteger x)),
};
\import Modules.Of[V := H.Closed, space := H.cycleSpace].Submodule[].Quotient[S := H.boundariesInside] \as IntegerQuotient;
\import IntegerQuotient.To[W := Natural.Cohomology, target := Natural.cohomologySpace] \as Forward;
\import Modules.Of[V := Natural.CycleCarrier, space := Natural.cycleSpace].Submodule[].Quotient[S := Natural.boundariesInside] \as NaturalQuotient;
\import NaturalQuotient.To[W := H.Cohomology, target := H.cohomologySpace] \as Backward;
\import Modules.Hom[V := Natural.CycleCarrier, W := Natural.Cohomology, source := Natural.cycleSpace, target := Natural.cohomologySpace].Composition[U := H.Closed, domain := H.cycleSpace] \as ForwardCompose;
\import Modules.Hom[V := H.Closed, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace].Composition[U := Natural.CycleCarrier, domain := Natural.cycleSpace] \as BackwardCompose;
\definition forwardRaw: _ := ForwardCompose.compose Natural.classLinear forwardCycles;
\definition backwardRaw: _ := BackwardCompose.compose H.classLinear backwardCycles;
\definition forwardVanishes: Forward.Vanishes forwardRaw :=
  \fun (x: H.Closed)(boundary: \In[H.Closed] (H.boundariesInside.carrier) x) => Natural.boundaryClassZero (toNatural x) (boundaryForward n x boundary);
\definition backwardVanishes: Backward.Vanishes backwardRaw :=
  \fun (x: Natural.CycleCarrier)(boundary: \In[Natural.CycleCarrier] (Natural.boundariesInside.carrier) x) => H.boundaryClassZero (toInteger x) (boundaryBackward n (Positive.intro x) boundary);
\definition forward: _ := Forward.descend forwardRaw forwardVanishes;
\definition backward: _ := Backward.descend backwardRaw backwardVanishes;
\definition onIntegerClass: \forall (x: H.Closed) -> forward.apply (H.classOf x) = Natural.classOf (toNatural x) := Forward.onClass forwardRaw forwardVanishes;
\definition onNaturalClass: \forall (x: Natural.CycleCarrier) -> backward.apply (Natural.classOf x) = H.classOf (toInteger x) := Backward.onClass backwardRaw backwardVanishes;
\definition leftInverse: \forall (h: H.Cohomology) -> backward.apply (forward.apply h) = h :=
  H.classInduction (\fun (h: H.Cohomology) => backward.apply (forward.apply h) = h)
    (\fun (x: H.Closed) => trans!{{H.Cohomology}} _ _ _
      (congr!{{Natural.Cohomology} {H.Cohomology}} (backward.apply) _ _ (onIntegerClass x)) (onNaturalClass (toNatural x)));
\definition rightInverse: \forall (h: Natural.Cohomology) -> forward.apply (backward.apply h) = h :=
  Natural.classInduction (\fun (h: Natural.Cohomology) => forward.apply (backward.apply h) = h)
    (\fun (x: Natural.CycleCarrier) => trans!{{Natural.Cohomology}} _ _ _
      (congr!{{H.Cohomology} {Natural.Cohomology}} (forward.apply) _ _ (onNaturalClass x)) (onIntegerClass (toInteger x)));
\import Modules.Isomorphism[V := H.Cohomology, W := Natural.Cohomology, source := H.cohomologySpace, target := Natural.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
