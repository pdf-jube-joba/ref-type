\definition index: Signed.Int^ := Signed.Int^::ofNat n;
\import Internal.At[C := complex, z := index] \as H;
\import \parent.\parent.At[C := C, k := n] \as Natural;
\import Modules.Of[V := Carrier index, space := space index].Submodule[] \as Submodules;
\definition Forward: \Prop := \forall (x: Carrier index) -> Submodules.Member H.boundaries x -> \In[C.family.Carrier n] (Natural.Boundaries n) x;
\definition Backward: \Prop := \forall (x: Carrier index) -> \In[C.family.Carrier n] (Natural.Boundaries n) x -> Submodules.Member H.boundaries x;
