\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\import \parent.Map[C := A, D := B] \as Inclusion;
\import \parent.Map[C := B, D := C] \as Projection;
\structure Data: \Set := { inclusion: Inclusion.Map, projection: Projection.Map };
\structure Laws[data: Data]: \Prop := {
  injective: \forall (n: N.Nat^)(x, y: A.family.Carrier n) -> data.inclusion.apply n x = data.inclusion.apply n y -> x = y,
  onto: \forall (n: N.Nat^)(z: C.family.Carrier n) -> \exists ( y: B.family.Carrier n \where data.projection.apply n y = z ),
  zero: \forall (n: N.Nat^)(x: A.family.Carrier n) -> data.projection.apply n (data.inclusion.apply n x) = (C.family.space n).zero,
  kernelImage: \forall (n: N.Nat^)(y: B.family.Carrier n) -> data.projection.apply n y = (C.family.space n).zero ->
    \exists ( x: A.family.Carrier n \where data.inclusion.apply n x = y ),
};
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(s: Sequence);
\module Morphism(A1, B1, C1: Complex);
