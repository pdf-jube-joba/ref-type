\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\import \parent.Map[C := C, D := D] \as Maps;
\definition Data: \Set := \forall (n: N.Nat^) -> Modules.Hom[V := C.family.Carrier (next n), W := D.family.Carrier n,
  source := C.family.space (next n), target := D.family.space n].Map;
\structure Laws[f, g: Maps.Map, h: Data]: \Prop {
  degreeZero: \forall (x: C.family.Carrier N.Nat^::zero) ->
    (D.family.space N.Nat^::zero).add (f.apply N.Nat^::zero x) ((D.family.space N.Nat^::zero).neg (g.apply N.Nat^::zero x)) =
      (h N.Nat^::zero).apply (C.differential.apply N.Nat^::zero x),
  positive: \forall (n: N.Nat^)(x: C.family.Carrier (next n)) ->
    (D.family.space (next n)).add (f.apply (next n) x) ((D.family.space (next n)).neg (g.apply (next n) x)) =
      (D.family.space (next n)).add (D.differential.apply n ((h n).apply x))
        ((h (next n)).apply (C.differential.apply (next n) x)),
}
\definition Homotopy(f, g: Maps.Map): \Set := \Cast[Data] ({ h: Data \where Laws[f, g, h] });
\module With(f, g: Maps.Map, h: Homotopy f g);
\module Reflexive(f: Maps.Map);
