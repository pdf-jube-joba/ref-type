\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\import Modules.Of[V := C.family.Carrier k, space := C.family.space k] \as Current;
\import Current.Submodule[] \as Subspaces;
\import Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier (next k),
  source := C.family.space k, target := C.family.space (next k)] \as Maps;
\definition differential: Maps.Map := Maps.Map {
  apply := C.differential.apply k,
  addition := C.laws.addition k,
  scalar := C.laws.scalar k,
};
\import Subspaces.Kernel[W := C.family.Carrier (next k), target := C.family.space (next k)] \as Kernels;
\definition cycles: Subspaces.Submodule := Kernels.kernel differential;
\import Subspaces.Of[S := cycles] \as Cycles;

\import algebra.Group[].Of[Carrier := C.family.Carrier k, group := Current.additive] \as Group;
\import Modules.Laws[V := C.family.Carrier k, space := C.family.space k] \as ModuleLaws;
\definition zeroAddition: (C.family.space k).add ((C.family.space k).zero) ((C.family.space k).zero) = (C.family.space k).zero := Group.zeroLeft ((C.family.space k).zero);
\definition scaleZero: \forall (a: R) -> (C.family.space k).smul a ((C.family.space k).zero) = (C.family.space k).zero := ModuleLaws.scaleZero;
\definition differentialZero: C.differential.apply k ((C.family.space k).zero) = (C.family.space (next k)).zero :=
  Maps.zeroPreserved differential;

\definition Boundaries: \forall (j: N.Nat^) -> \Pow (C.family.Carrier j) :=
  \induction (j: N.Nat^) \return \Pow (C.family.Carrier j) \with {
    | zero: { x: C.family.Carrier N.Nat^::zero \where x = (C.family.space N.Nat^::zero).zero }
    | succ: \fun (j: N.Nat^)(previous: \Pow (C.family.Carrier j)) => { x: C.family.Carrier (next j) \where
      \exists { y: C.family.Carrier j \where C.differential.apply j y = x } }
  };
\definition boundaryCycle: \forall (j: N.Nat^)(x: C.family.Carrier j) ->
  \In[C.family.Carrier j] (Boundaries j) x -> C.differential.apply j x = (C.family.space (next j)).zero :=
  \induction (j: N.Nat^) \return \forall (x: C.family.Carrier j) ->
    \In[C.family.Carrier j] (Boundaries j) x -> C.differential.apply j x = (C.family.space (next j)).zero \with {
      | zero: \fun (x: C.family.Carrier N.Nat^::zero)(equal: x = (C.family.space N.Nat^::zero).zero) =>
        trans!{{C.family.Carrier (next N.Nat^::zero)}}
          _ _ _
          (congr!{{C.family.Carrier N.Nat^::zero} {C.family.Carrier (next N.Nat^::zero)}}
            (C.differential.apply N.Nat^::zero) x ((C.family.space N.Nat^::zero).zero) equal)
          (\parent.At[C := C, k := N.Nat^::zero].differentialZero)
      | succ: \block {
        \fun (j: N.Nat^)(previous: \forall (z: C.family.Carrier j) -> \In[C.family.Carrier j] (Boundaries j) z -> C.differential.apply j z = (C.family.space (next j)).zero)(x: C.family.Carrier (next j))(exists: \In[C.family.Carrier (next j)] (Boundaries (next j)) x) \then
        \takefrom y: \Cast[C.family.Carrier j] ({ y: C.family.Carrier j \where C.differential.apply j y = x }) \by exists \then
        \let equal: C.differential.apply j y = x := \bysub(C.family.Carrier j,
          { y: C.family.Carrier j \where C.differential.apply j y = x }, y) \then
        \let result: C.differential.apply (next j) x = (C.family.space (next (next j))).zero :=
          \idelim C.differential.apply j y = x \with z: C.family.Carrier (next j) =>
            C.differential.apply (next j) z = (C.family.space (next (next j))).zero \by {
              base: C.laws.squareZero j y, equality: equal
            } \then
        \return result
      }
    };

\definition boundaryZero: \forall (j: N.Nat^) ->
  \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).zero) :=
  \induction (j: N.Nat^) \return \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).zero) \with {
    | zero: \refl((C.family.space N.Nat^::zero).zero)
    | succ: \fun (j: N.Nat^)(previous: \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).zero)) => Logic.existsIntro[C.family.Carrier j, { y: C.family.Carrier j \where C.differential.apply j y = (C.family.space (next j)).zero }] ((C.family.space j).zero)
      (\parent.At[C := C, k := j].differentialZero)
  };

\definition boundaryAdd: \forall (j: N.Nat^)(x, y: C.family.Carrier j) ->
  \In[C.family.Carrier j] (Boundaries j) x -> \In[C.family.Carrier j] (Boundaries j) y ->
  \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).add x y) :=
  \induction (j: N.Nat^) \return \forall (x, y: C.family.Carrier j) ->
    \In[C.family.Carrier j] (Boundaries j) x -> \In[C.family.Carrier j] (Boundaries j) y ->
    \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).add x y) \with {
      | zero: \fun (x, y: C.family.Carrier N.Nat^::zero)(left: x = (C.family.space N.Nat^::zero).zero)(right: y = (C.family.space N.Nat^::zero).zero) =>
        trans!{{C.family.Carrier N.Nat^::zero}}
          _ _ _
          (congr2!{{C.family.Carrier N.Nat^::zero} {C.family.Carrier N.Nat^::zero} {C.family.Carrier N.Nat^::zero}}
            ((C.family.space N.Nat^::zero).add) x (C.family.space N.Nat^::zero).zero y (C.family.space N.Nat^::zero).zero left right)
          (\parent.At[C := C, k := N.Nat^::zero].zeroAddition)
      | succ: \block {
        \fun (j: N.Nat^)(previous: \forall (u, v: C.family.Carrier j) -> \In[C.family.Carrier j] (Boundaries j) u -> \In[C.family.Carrier j] (Boundaries j) v -> \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).add u v))(x, y: C.family.Carrier (next j))
          (left: \In[C.family.Carrier (next j)] (Boundaries (next j)) x)
          (right: \In[C.family.Carrier (next j)] (Boundaries (next j)) y) \then
        \takefrom u: \Cast[C.family.Carrier j] ({ u: C.family.Carrier j \where C.differential.apply j u = x }) \by left \then
        \takefrom v: \Cast[C.family.Carrier j] ({ v: C.family.Carrier j \where C.differential.apply j v = y }) \by right \then
        \let equal: C.differential.apply j ((C.family.space j).add u v) = (C.family.space (next j)).add x y :=
          trans!{{C.family.Carrier (next j)}}
            _ _ _ (C.laws.addition j u v)
            (congr2!{{C.family.Carrier (next j)} {C.family.Carrier (next j)} {C.family.Carrier (next j)}}
              ((C.family.space (next j)).add) (C.differential.apply j u) x (C.differential.apply j v) y
              (\bysub(C.family.Carrier j, { u: C.family.Carrier j \where C.differential.apply j u = x }, u))
              (\bysub(C.family.Carrier j, { v: C.family.Carrier j \where C.differential.apply j v = y }, v))) \then
        \return Logic.existsIntro[C.family.Carrier j, { z: C.family.Carrier j \where C.differential.apply j z = (C.family.space (next j)).add x y }] ((C.family.space j).add u v)
          equal
      }
    };

\definition boundaryScale: \forall (j: N.Nat^)(a: R)(x: C.family.Carrier j) ->
  \In[C.family.Carrier j] (Boundaries j) x ->
  \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).smul a x) :=
  \induction (j: N.Nat^) \return \forall (a: R)(x: C.family.Carrier j) ->
    \In[C.family.Carrier j] (Boundaries j) x ->
    \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).smul a x) \with {
      | zero: \fun (a: R)(x: C.family.Carrier N.Nat^::zero)(equal: x = (C.family.space N.Nat^::zero).zero) =>
        trans!{{C.family.Carrier N.Nat^::zero}}
          _ _ _
          (congr!{{C.family.Carrier N.Nat^::zero} {C.family.Carrier N.Nat^::zero}}
            ((C.family.space N.Nat^::zero).smul a) x (C.family.space N.Nat^::zero).zero equal)
          (\parent.At[C := C, k := N.Nat^::zero].scaleZero a)
      | succ: \block {
        \fun (j: N.Nat^)(previous: \forall (a: R)(u: C.family.Carrier j) -> \In[C.family.Carrier j] (Boundaries j) u -> \In[C.family.Carrier j] (Boundaries j) ((C.family.space j).smul a u))(a: R)(x: C.family.Carrier (next j))
          (exists: \In[C.family.Carrier (next j)] (Boundaries (next j)) x) \then
        \takefrom y: \Cast[C.family.Carrier j] ({ y: C.family.Carrier j \where C.differential.apply j y = x }) \by exists \then
        \let equal: C.differential.apply j ((C.family.space j).smul a y) = (C.family.space (next j)).smul a x :=
          trans!{{C.family.Carrier (next j)}}
            _ _ _ (C.laws.scalar j a y)
            (congr!{{C.family.Carrier (next j)} {C.family.Carrier (next j)}} ((C.family.space (next j)).smul a) (C.differential.apply j y) x
              (\bysub(C.family.Carrier j, { y: C.family.Carrier j \where C.differential.apply j y = x }, y))) \then
        \return Logic.existsIntro[C.family.Carrier j, { z: C.family.Carrier j \where C.differential.apply j z = (C.family.space (next j)).smul a x }] ((C.family.space j).smul a y)
          equal
      }
    };

\definition boundaries: Subspaces.Submodule := Subspaces.Submodule {
  carrier := Boundaries k,
  zero := boundaryZero k,
  addition := boundaryAdd k,
  scalar := boundaryScale k,
};
\import Subspaces.Inside[Z := cycles] \as Inside;
\import Modules.Submodule[V := Cycles.Carrier, space := Cycles.moduleSpace] \as CycleSubmodules;
\definition boundariesInside: CycleSubmodules.Submodule := Inside.inside boundaries (boundaryCycle k);
\import Modules.Of[V := Cycles.Carrier, space := Cycles.moduleSpace] \as CycleModule;
\import CycleModule.Submodule[] \as CycleSubspaces;
\import CycleSubspaces.Quotient[S := boundariesInside] \as Quotient;
\definition CycleCarrier: \Set := Cycles.Carrier;
\definition cycleSpace: Modules.Space CycleCarrier := Cycles.moduleSpace;
\definition Cohomology: \Set := Quotient.Carrier;
\definition cohomologySpace: Modules.Space Cohomology := Quotient.moduleSpace;
\definition classOf(x: Cycles.Carrier): Cohomology := Quotient.class x;
\definition cycle(x: C.family.Carrier k)(closed: C.differential.apply k x = (C.family.space (next k)).zero): Cycles.Carrier :=
  \into[C.family.Carrier k](x, cycles.carrier) \by { closed };
\definition boundaryClassZero: \forall (x: Cycles.Carrier) ->
  \In[C.family.Carrier k] (Boundaries k) x -> classOf x = Quotient.zeroClass := Quotient.classZero;
\definition zeroClassBoundary: \forall (x: Cycles.Carrier) ->
  classOf x = Quotient.zeroClass -> \In[C.family.Carrier k] (Boundaries k) x := Quotient.zeroClassMember;

\definition zeroClass: Cohomology := Quotient.zeroClass;
\definition classEqual: \forall (x, y: CycleCarrier) ->
  \In[C.family.Carrier k] (Boundaries k) ((C.family.space k).add x ((C.family.space k).neg y)) -> classOf x = classOf y := Quotient.classRelated;
\definition classRelated: \forall (x, y: CycleCarrier) -> classOf x = classOf y ->
  \In[C.family.Carrier k] (Boundaries k) ((C.family.space k).add x ((C.family.space k).neg y)) := Quotient.relatedOfClassEq;
\definition classInduction(P: Cohomology -> \Prop):
  (\forall (x: CycleCarrier) -> P (classOf x)) -> \forall (h: Cohomology) -> P h := Quotient.induction P;
\import Modules.Hom[V := CycleCarrier, W := Cohomology, source := cycleSpace, target := cohomologySpace] \as Classes;
\definition classLinear: Classes.Map := Quotient.projection;

\definition ambient(x: CycleCarrier): C.family.Carrier k := x;
\definition equalClass: \forall (x, y: CycleCarrier) -> ambient x = ambient y -> classOf x = classOf y :=
  \fun (x, y: CycleCarrier)(same: ambient x = ambient y) => classEqual x y
    (\idelim (C.family.space k).zero = (C.family.space k).add (ambient x) ((C.family.space k).neg (ambient y))
      \with z: C.family.Carrier k => \In[C.family.Carrier k] (Boundaries k) z \by {
        base: boundaryZero k,
        equality: sym!{{C.family.Carrier k}} _ _ (trans!{{C.family.Carrier k}} _ _ _
          (congr!{{C.family.Carrier k} {C.family.Carrier k}}
            (\fun (z: C.family.Carrier k) => (C.family.space k).add z ((C.family.space k).neg (ambient y))) _ _ same)
          (Group.inverseRight (ambient y)))
      });

\module Vanishing;
