\use std.Logic[].Equality[].eq_reason_in;
\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\import Source.PositiveCohomology[n := n] \as SourceComparison;
\import Target.PositiveCohomology[n := n] \as TargetComparison;
\import Internal.At[C := Source.complex, z := Signed.Int^::ofNat n] \as SourceInteger;
\import Internal.At[C := Target.complex, z := Signed.Int^::ofNat n] \as TargetInteger;
\import Internal.Map[C := Source.complex, D := Target.complex].At[k := Signed.Int^::ofNat n] \as IntegerMap;
\import \parent.\parent.At[k := n] \as NaturalMap;
\import \parent.\parent.\parent.At[C := D, k := n] \as TargetNatural;
\import \parent.\parent.\parent.At[C := C, k := n] \as SourceNatural;
\definition commutes: \forall (h: SourceInteger.Cohomology) ->
  TargetComparison.forward.apply ((IntegerMap.induced map).apply h) = (NaturalMap.induced f).apply (SourceComparison.forward.apply h) :=
  SourceInteger.classInduction
    (\fun (h: SourceInteger.Cohomology) => TargetComparison.forward.apply ((IntegerMap.induced map).apply h) = (NaturalMap.induced f).apply (SourceComparison.forward.apply h))
    (\fun (x: SourceInteger.Closed) => eq_reason_in!{TargetNatural.Cohomology _
      "=" _ "by" { congr!{TargetInteger.Cohomology TargetNatural.Cohomology} (TargetComparison.forward.apply) _ _ (IntegerMap.onClass map x) }
      "=" _ "by" { TargetComparison.onIntegerClass ((IntegerMap.cyclesMap map).apply x) }
      "=" _ "by" { sym!{TargetNatural.Cohomology} _ _ (NaturalMap.onClass f (SourceComparison.toNatural x)) }
      "=" _ "by" { congr!{SourceNatural.Cohomology TargetNatural.Cohomology} ((NaturalMap.induced f).apply) _ _ (sym!{SourceNatural.Cohomology} _ _ (SourceComparison.onIntegerClass x)) }
    });
\definition inverseCommutes: \forall (h: SourceNatural.Cohomology) ->
  (IntegerMap.induced map).apply (SourceComparison.backward.apply h) = TargetComparison.backward.apply ((NaturalMap.induced f).apply h) :=
  \fun (h: SourceNatural.Cohomology) => trans!{TargetInteger.Cohomology} _ _ _
    (sym!{TargetInteger.Cohomology} _ _ (TargetComparison.leftInverse ((IntegerMap.induced map).apply (SourceComparison.backward.apply h))))
    (congr!{TargetNatural.Cohomology TargetInteger.Cohomology} (TargetComparison.backward.apply) _ _
      (trans!{TargetNatural.Cohomology} _ _ _ (commutes (SourceComparison.backward.apply h))
        (congr!{SourceNatural.Cohomology TargetNatural.Cohomology} ((NaturalMap.induced f).apply) _ _ (SourceComparison.rightInverse h))));
