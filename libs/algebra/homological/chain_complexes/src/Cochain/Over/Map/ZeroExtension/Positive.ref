\definition apply[x: Source.Carrier (Signed.Int^::ofNat n)]: Target.Carrier (Signed.Int^::ofNat n) := Target.Positive[n := n].intro (f.apply n x);
\definition addition: \forall (x, y: Source.Carrier (Signed.Int^::ofNat n)) ->
  apply ((Source.space (Signed.Int^::ofNat n)).add x y) = (Target.space (Signed.Int^::ofNat n)).add (apply x) (apply y) :=
  \fun (x, y: Source.Carrier (Signed.Int^::ofNat n)) => f.addition n x y;
\definition scalar: \forall (a: R)(x: Source.Carrier (Signed.Int^::ofNat n)) ->
  apply ((Source.space (Signed.Int^::ofNat n)).smul a x) = (Target.space (Signed.Int^::ofNat n)).smul a (apply x) :=
  \fun (a: R)(x: Source.Carrier (Signed.Int^::ofNat n)) => f.scalar n a x;
