\definition index(n: N.Nat^): Integers.Degree := Signed.Int^::ofNat n;
\definition family: Family := Family {
  Carrier := \fun (n: N.Nat^) => C.family.Carrier (index n),
  space := \fun (n: N.Nat^) => C.family.space (index n),
};
\definition differential: DifferentialData[family] := DifferentialData[family] {
  apply := \fun (n: N.Nat^) => #apply{C.differential} (index n),
};
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => #addition{C.laws} (index n),
    scalar := \fun (n: N.Nat^) => #scalar{C.laws} (index n),
    squareZero := \fun (n: N.Nat^) => #squareZero{C.laws} (index n),
  },
};
