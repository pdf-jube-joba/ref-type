\import \parent.\parent.\parent.At[C := B, z := k] \as First;
\import \parent.\parent.\parent.At[C := C, z := k] \as Second;
\import \parent.\parent.\parent.At[C := A, z := next k] \as Third;
\import \parent.\parent.\parent.At[C := B, z := next k] \as Fourth;
\import \parent.\parent.\parent.At[C := C, z := next k] \as Last;
\definition first: Modules.Bundle := Modules.Bundle { Carrier := First.Cohomology, space := First.cohomologySpace };
\definition second: Modules.Bundle := Modules.Bundle { Carrier := Second.Cohomology, space := Second.cohomologySpace };
\definition third: Modules.Bundle := Modules.Bundle { Carrier := Third.Cohomology, space := Third.cohomologySpace };
\definition fourth: Modules.Bundle := Modules.Bundle { Carrier := Fourth.Cohomology, space := Fourth.cohomologySpace };
\definition last: Modules.Bundle := Modules.Bundle { Carrier := Last.Cohomology, space := Last.cohomologySpace };
\import Modules.ExactFive[A := first, B := second, C := third, D := fourth, E := last] \as Five;
\import \parent.\parent.\parent.Map[C := B, D := C].At[k := k] \as FirstMap;
\import \parent.\parent.\parent.Map[C := A, D := B].At[k := next k] \as ThirdMap;
\import \parent.\parent.\parent.Map[C := B, D := C].At[k := next k] \as LastMap;
\definition data: Five.Data := Five.Data {
  first := FirstMap.induced s.projection, second := connecting,
  third := ThirdMap.induced s.inclusion, last := LastMap.induced s.projection,
};
\import \parent.Exactness[] \as E;
\import \parent.\parent.At[s := s, k := next k].Exactness[] \as Next;
\definition sequence: Five.Sequence := \into[Five.Data](data, { d: Five.Data \where Five.Laws[d] }) \by {
  Five.Laws[data] {
    zeroB := E.projectionConnectingZero, zeroC := E.connectingInclusionZero, zeroD := Next.inclusionProjectionZero,
    kernelB := E.exactAtC, kernelC := E.exactAtALower, kernelD := Next.exactAtB,
  }
};
