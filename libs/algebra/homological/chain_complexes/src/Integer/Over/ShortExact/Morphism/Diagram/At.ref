\import \parent.\parent.\parent.At[s := s, k := k] \as Source;
\import \parent.\parent.\parent.\parent.ShortExact[A := A1, B := B1, C := C1].At[s := t, k := k] \as TargetConnecting;
\import \parent.\parent.\parent.\parent.At[C := C, z := k] \as HC;
\import \parent.\parent.\parent.\parent.At[C := C1, z := k] \as HC1;
\import \parent.\parent.\parent.\parent.At[C := A, z := next k] \as HA;
\import \parent.\parent.\parent.\parent.At[C := A1, z := next k] \as HA1;
\import \parent.\parent.\parent.\parent.Map[C := A, D := A1].At[k := next k] \as Left;
\import \parent.\parent.\parent.\parent.Map[C := C, D := C1].At[k := k] \as Right;
\definition onCycles: Commutative -> \forall (x: HC.Closed) ->
  TargetConnecting.delta (#apply{(Right.cyclesMap c)} x) = #apply{(Left.induced a)} (Source.delta x) := \block {
  \fun (diagram: Commutative)(x: HC.Closed) \then
  \takefrom w: \Cast[Source.Witness] ({ w: Source.Witness \where Source.WitnessLaws[x, Source.delta x, w] })
    \by \bysub(HA.Cohomology, Source.Values x, Source.delta x) \then
  \let laws: Source.WitnessLaws[x, Source.delta x, w] := \bysub(Source.Witness, { w: Source.Witness \where Source.WitnessLaws[x, Source.delta x, w] }, w) \then
  \let lift: B1.family.Carrier k := #apply{b} k (#lift{w}) \then
  \let lower: HA1.Closed := #apply{(Left.cyclesMap a)} (#lower{w}) \then
  \let lifted: #apply{t.projection} k lift = #apply{c} k x := trans!{{C1.family.Carrier k}} _ _ _ (#right{diagram} k (#lift{w}))
    (congr!{{C.family.Carrier k} {C1.family.Carrier k}} (#apply{c} k) _ _ (#lifted{laws})) \then
  \let differential: #apply{t.inclusion} (next k) lower = #apply{B1.differential} k lift := trans!{{B1.family.Carrier (next k)}} _ _ _
    (sym!{{B1.family.Carrier (next k)}} _ _ (#left{diagram} (next k) (#lower{w})))
    (trans!{{B1.family.Carrier (next k)}} _ _ _ (congr!{{B.family.Carrier (next k)} {B1.family.Carrier (next k)}} (#apply{b} (next k)) _ _ (#differential{laws}))
      (sym!{{B1.family.Carrier (next k)}} _ _ (#commutes{b} k (#lift{w})))) \then
  \return trans!{HA1.Cohomology} _ _ _ (TargetConnecting.onLift (#apply{(Right.cyclesMap c)} x) lift lower lifted differential
    (\bysub(A1.family.Carrier (next k), #carrier{HA1.cycles}, lower)))
    (trans!{HA1.Cohomology} _ _ _ (sym!{HA1.Cohomology} _ _ (Left.onClass a (#lower{w})))
      (congr!{HA.Cohomology HA1.Cohomology} (#apply{(Left.induced a)}) _ _ (#classValue{laws})))
};
\definition onClasses: Commutative -> \forall (x: HC.Closed) ->
  #apply{TargetConnecting.connecting} (#apply{(Right.induced c)} (HC.classOf x)) = #apply{(Left.induced a)} (#apply{Source.connecting} (HC.classOf x)) := \block {
  \fun (diagram: Commutative)(x: HC.Closed) \then
  \let rightClass: #apply{TargetConnecting.connecting} (#apply{(Right.induced c)} (HC.classOf x)) =
    #apply{TargetConnecting.connecting} (HC1.classOf (#apply{(Right.cyclesMap c)} x)) :=
    congr!{HC1.Cohomology HA1.Cohomology} (#apply{TargetConnecting.connecting})
      (#apply{(Right.induced c)} (HC.classOf x)) (HC1.classOf (#apply{(Right.cyclesMap c)} x)) (Right.onClass c x) \then
  \let targetClass: #apply{TargetConnecting.connecting} (HC1.classOf (#apply{(Right.cyclesMap c)} x)) =
    #apply{(Left.induced a)} (Source.delta x) := trans!{HA1.Cohomology}
      _ _ _
      (TargetConnecting.onClass (#apply{(Right.cyclesMap c)} x)) (onCycles diagram x) \then
  \let sourceClass: #apply{(Left.induced a)} (Source.delta x) = #apply{(Left.induced a)} (#apply{Source.connecting} (HC.classOf x)) :=
    congr!{HA.Cohomology HA1.Cohomology} (#apply{(Left.induced a)}) (Source.delta x) (#apply{Source.connecting} (HC.classOf x))
      (sym!{HA.Cohomology} _ _ (Source.onClass x)) \then
  \return trans!{HA1.Cohomology} _ _ _ rightClass (trans!{HA1.Cohomology} _ _ _ targetClass sourceClass)
};
\definition naturality: Commutative -> \forall (q: HC.Cohomology) ->
  #apply{TargetConnecting.connecting} (#apply{(Right.induced c)} q) = #apply{(Left.induced a)} (#apply{Source.connecting} q) :=
  \fun (diagram: Commutative) => HC.classInduction (\fun (q: HC.Cohomology) =>
    #apply{TargetConnecting.connecting} (#apply{(Right.induced c)} q) = #apply{(Left.induced a)} (#apply{Source.connecting} q)) (onClasses diagram);

\import \root.Integer[].Over[R := R, ring := ring].At[C := B, z := k] \as SourceMiddle;
\import \root.Integer[].Over[R := R, ring := ring].At[C := B1, z := k] \as TargetMiddle;
\import \root.Integer[].Over[R := R, ring := ring].Map[C := B, D := B1].At[k := k] \as MiddleMap;
\import \root.Integer[].Over[R := R, ring := ring].Map[C := B, D := C].At[k := k] \as SourceProjection;
\import \root.Integer[].Over[R := R, ring := ring].Map[C := B1, D := C1].At[k := k] \as TargetProjection;
\definition projectionOnClass: Commutative -> \forall (x: SourceMiddle.Closed) ->
  #apply{(TargetProjection.induced t.projection)} (#apply{(MiddleMap.induced b)} (SourceMiddle.classOf x)) =
  #apply{(Right.induced c)} (#apply{(SourceProjection.induced s.projection)} (SourceMiddle.classOf x)) :=
  \fun (diagram: Commutative)(x: SourceMiddle.Closed) => \block {
  \let l: HC1.Closed := #apply{(TargetProjection.cyclesMap t.projection)} (#apply{(MiddleMap.cyclesMap b)} x) \then
  \let r: HC1.Closed := #apply{(Right.cyclesMap c)} (#apply{(SourceProjection.cyclesMap s.projection)} x) \then
  \let equal: l = r := #right{diagram} k x \then
  \return trans!{HC1.Cohomology} _ _ _
    (congr!{TargetMiddle.Cohomology HC1.Cohomology} (#apply{(TargetProjection.induced t.projection)}) _ _ (MiddleMap.onClass b x))
    (trans!{HC1.Cohomology} _ _ _
      (TargetProjection.onClass t.projection (#apply{(MiddleMap.cyclesMap b)} x))
      (trans!{HC1.Cohomology} _ _ _
        (congr!{HC1.Closed HC1.Cohomology} HC1.classOf l r equal)
        (sym!{HC1.Cohomology} _ _ (trans!{HC1.Cohomology} _ _ _
          (congr!{HC.Cohomology HC1.Cohomology} (#apply{(Right.induced c)}) _ _ (SourceProjection.onClass s.projection x))
          (Right.onClass c (#apply{(SourceProjection.cyclesMap s.projection)} x))))))
};
\definition projectionNaturality: Commutative -> \forall (x: SourceMiddle.Cohomology) ->
  #apply{(TargetProjection.induced t.projection)} (#apply{(MiddleMap.induced b)} x) =
  #apply{(Right.induced c)} (#apply{(SourceProjection.induced s.projection)} x) :=
  \fun (diagram: Commutative) => SourceMiddle.classInduction (\fun (x: SourceMiddle.Cohomology) =>
    #apply{(TargetProjection.induced t.projection)} (#apply{(MiddleMap.induced b)} x) =
    #apply{(Right.induced c)} (#apply{(SourceProjection.induced s.projection)} x)) (projectionOnClass diagram);
\module Comparison;
