\import \parent.\parent.\parent.At[s := s, k := k] \as Source;
\import \parent.\parent.\parent.\parent.ShortExact[A := A1, B := B1, C := C1].At[s := t, k := k] \as TargetConnecting;
\import \parent.\parent.\parent.\parent.At[C := C, z := k] \as HC;
\import \parent.\parent.\parent.\parent.At[C := C1, z := k] \as HC1;
\import \parent.\parent.\parent.\parent.At[C := A, z := next k] \as HA;
\import \parent.\parent.\parent.\parent.At[C := A1, z := next k] \as HA1;
\import \parent.\parent.\parent.\parent.Map[C := A, D := A1].At[k := next k] \as Left;
\import \parent.\parent.\parent.\parent.Map[C := C, D := C1].At[k := k] \as Right;
\definition onCycles: Commutative -> \forall (x: HC.Closed) ->
  TargetConnecting.delta ((Right.cyclesMap c).apply x) = (Left.induced a).apply (Source.delta x) := \block {
  \fun (diagram: Commutative)(x: HC.Closed) \then
  \takefrom w: \Cast[Source.Witness] ({ w: Source.Witness \where Source.WitnessLaws[x, Source.delta x, w] })
    \by \bysub(HA.Cohomology, Source.Values x, Source.delta x) \then
  \let laws: Source.WitnessLaws[x, Source.delta x, w] := \bysub(Source.Witness, { w: Source.Witness \where Source.WitnessLaws[x, Source.delta x, w] }, w) \then
  \let lift: B1.family.Carrier k := b.apply k (w.lift) \then
  \let lower: HA1.Closed := (Left.cyclesMap a).apply (w.lower) \then
  \let lifted: t.projection.apply k lift = c.apply k x := trans!{{C1.family.Carrier k}} _ _ _ (diagram.right k (w.lift))
    (congr!{{C.family.Carrier k} {C1.family.Carrier k}} (c.apply k) _ _ (laws.lifted)) \then
  \let differential: t.inclusion.apply (next k) lower = B1.differential.apply k lift := trans!{{B1.family.Carrier (next k)}} _ _ _
    (sym!{{B1.family.Carrier (next k)}} _ _ (diagram.left (next k) (w.lower)))
    (trans!{{B1.family.Carrier (next k)}} _ _ _ (congr!{{B.family.Carrier (next k)} {B1.family.Carrier (next k)}} (b.apply (next k)) _ _ (laws.differential))
      (sym!{{B1.family.Carrier (next k)}} _ _ (b.commutes k (w.lift)))) \then
  \return trans!{HA1.Cohomology} _ _ _ (TargetConnecting.onLift ((Right.cyclesMap c).apply x) lift lower lifted differential
    (\bysub(A1.family.Carrier (next k), HA1.cycles.carrier, lower)))
    (trans!{HA1.Cohomology} _ _ _ (sym!{HA1.Cohomology} _ _ (Left.onClass a (w.lower)))
      (congr!{HA.Cohomology HA1.Cohomology} ((Left.induced a).apply) _ _ (laws.classValue)))
};
\definition onClasses: Commutative -> \forall (x: HC.Closed) ->
  TargetConnecting.connecting.apply ((Right.induced c).apply (HC.classOf x)) = (Left.induced a).apply (Source.connecting.apply (HC.classOf x)) := \block {
  \fun (diagram: Commutative)(x: HC.Closed) \then
  \let rightClass: TargetConnecting.connecting.apply ((Right.induced c).apply (HC.classOf x)) =
    TargetConnecting.connecting.apply (HC1.classOf ((Right.cyclesMap c).apply x)) :=
    congr!{HC1.Cohomology HA1.Cohomology} (TargetConnecting.connecting.apply)
      ((Right.induced c).apply (HC.classOf x)) (HC1.classOf ((Right.cyclesMap c).apply x)) (Right.onClass c x) \then
  \let targetClass: TargetConnecting.connecting.apply (HC1.classOf ((Right.cyclesMap c).apply x)) =
    (Left.induced a).apply (Source.delta x) := trans!{HA1.Cohomology}
      _ _ _
      (TargetConnecting.onClass ((Right.cyclesMap c).apply x)) (onCycles diagram x) \then
  \let sourceClass: (Left.induced a).apply (Source.delta x) = (Left.induced a).apply (Source.connecting.apply (HC.classOf x)) :=
    congr!{HA.Cohomology HA1.Cohomology} ((Left.induced a).apply) (Source.delta x) (Source.connecting.apply (HC.classOf x))
      (sym!{HA.Cohomology} _ _ (Source.onClass x)) \then
  \return trans!{HA1.Cohomology} _ _ _ rightClass (trans!{HA1.Cohomology} _ _ _ targetClass sourceClass)
};
\definition naturality: Commutative -> \forall (q: HC.Cohomology) ->
  TargetConnecting.connecting.apply ((Right.induced c).apply q) = (Left.induced a).apply (Source.connecting.apply q) :=
  \fun (diagram: Commutative) => HC.classInduction (\fun (q: HC.Cohomology) =>
    TargetConnecting.connecting.apply ((Right.induced c).apply q) = (Left.induced a).apply (Source.connecting.apply q)) (onClasses diagram);
