\definition Acyclic: \Prop := \forall (k: Degree)(q: \parent.\parent.At[C := C, z := k].Cohomology) ->
  q = \parent.\parent.At[C := C, z := k].zeroClass;
\definition Injective[k: Degree]: \Prop := \forall (x, y: \parent.\parent.At[C := A, z := k].Cohomology) ->
  (Inclusion.At[k := k].induced s.inclusion).apply x = (Inclusion.At[k := k].induced s.inclusion).apply y -> x = y;
\module At(k: Degree);
\definition injective: Acyclic -> \forall (k: Degree) -> Injective k :=
  \fun (acyclic: Acyclic)(k: Degree) => \idelim next (previous k) = k \with j: Degree => Injective j
    \by { base: At[k := previous k].injectiveNext acyclic, equality: nextPrevious k };
\definition quasiIsomorphism: Acyclic -> Inclusion.QuasiIsomorphism s.inclusion :=
  \fun (acyclic: Acyclic)(k: Degree) => Inclusion.At[k := k].Bijective[s.inclusion] {
    injective := injective acyclic k, onto := At[k := k].onto acyclic,
  };
