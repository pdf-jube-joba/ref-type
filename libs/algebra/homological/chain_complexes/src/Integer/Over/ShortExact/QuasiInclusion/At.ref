\import \parent.\parent.At[s := s, k := k] \as Exact;
\import \parent.\parent.\parent.At[C := A, z := k] \as HA;
\import \parent.\parent.\parent.At[C := B, z := k] \as HB;
\import \parent.\parent.\parent.At[C := C, z := k] \as HC;
\import \parent.\parent.\parent.At[C := A, z := next k] \as HAUpper;
\import \parent.\parent.\parent.At[C := B, z := next k] \as HBUpper;
\import Inclusion.At[k := k] \as InclusionAt;
\import Inclusion.At[k := next k] \as UpperInclusion;
\import Projection.At[k := k] \as ProjectionAt;
\import Modules.Hom[V := HC.Cohomology, W := HAUpper.Cohomology, source := HC.cohomologySpace, target := HAUpper.cohomologySpace] \as ConnectingMaps;
\import Modules.Hom[V := HAUpper.Cohomology, W := HBUpper.Cohomology, source := HAUpper.cohomologySpace, target := HBUpper.cohomologySpace] \as InclusionMaps;
\definition kernelZeroNext: Acyclic -> \forall (q: HAUpper.Cohomology) ->
  #apply{(UpperInclusion.induced s.inclusion)} q = HBUpper.zeroClass -> q = HAUpper.zeroClass := \block {
  \fun (acyclic: Acyclic)(q: HAUpper.Cohomology)(killed: _) \then
  \takefrom x: \Cast[HC.Cohomology] ({ x: HC.Cohomology \where #apply{Exact.connecting} x = q })
    \by Exact.Exactness[].exactAtALower q killed \then
  \return trans!{HAUpper.Cohomology} _ _ _
    (sym!{HAUpper.Cohomology} _ _ (\bysub(HC.Cohomology, { x: HC.Cohomology \where #apply{Exact.connecting} x = q }, x)))
    (trans!{HAUpper.Cohomology} _ _ _ (congr!{HC.Cohomology HAUpper.Cohomology} (#apply{Exact.connecting}) _ _ (acyclic k x))
      (ConnectingMaps.zeroPreserved Exact.connecting))
};
\definition injectiveNext: Acyclic -> Injective (next k) :=
  \fun (acyclic: Acyclic) => InclusionMaps.injectiveOfZeroKernel (UpperInclusion.induced s.inclusion) (kernelZeroNext acyclic);
\definition onto: Acyclic -> \forall (q: HB.Cohomology) -> \exists { x: HA.Cohomology \where #apply{(InclusionAt.induced s.inclusion)} x = q } :=
  \fun (acyclic: Acyclic)(q: HB.Cohomology) => Exact.Exactness[].exactAtB q (acyclic k (#apply{(ProjectionAt.induced s.projection)} q));
