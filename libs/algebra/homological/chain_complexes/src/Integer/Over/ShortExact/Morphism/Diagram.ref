\structure Commutative: \Prop {
  left: \forall (k: Degree)(x: A.family.Carrier k) -> #apply{b} k (#apply{s.inclusion} k x) = #apply{t.inclusion} k (#apply{a} k x),
  right: \forall (k: Degree)(x: B.family.Carrier k) -> #apply{t.projection} k (#apply{b} k x) = #apply{c} k (#apply{s.projection} k x),
}
\module At(k: Degree);
