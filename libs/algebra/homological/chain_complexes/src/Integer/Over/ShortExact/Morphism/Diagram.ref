\structure Commutative: \Prop := {
  left: \forall (k: Degree)(x: A.family.Carrier k) -> (b).apply k ((s.inclusion).apply k x) = (t.inclusion).apply k ((a).apply k x),
  right: \forall (k: Degree)(x: B.family.Carrier k) -> (t.projection).apply k ((b).apply k x) = (c).apply k ((s.projection).apply k x),
};
\module Inclusion(k: Degree);
\module At(k: Degree);
\definition leftQuasiIsomorphism: Commutative -> MiddleMap.QuasiIsomorphism b -> RightMap.QuasiIsomorphism c -> LeftMap.QuasiIsomorphism a :=
  \fun (diagram: Commutative)(middle: MiddleMap.QuasiIsomorphism b)(right: RightMap.QuasiIsomorphism c)(k: Degree) =>
    \idelim next (previous k) = k \with z: Degree => LeftMap.At[k := z].Bijective[a] \by {
      base: At[k := previous k].Comparison[].bijective diagram (middle (previous k)) (right (previous k)) (middle (next (previous k))) (right (next (previous k))),
      equality: nextPrevious k
    };
