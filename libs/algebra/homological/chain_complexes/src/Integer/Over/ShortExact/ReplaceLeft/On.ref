\import \root.Integer[].Over[R := R, ring := ring] \as Cochains;
\import Cochains.ShortExact[A := A1, B := B, C := C] \as New;
\import Cochains.Map[C := A, D := B].Composition[B := A1] \as Composition;
\definition inclusion: Cochains.Map[C := A1, D := B].Map := Composition.compose s.inclusion e.forward;
\definition injective: \forall (z: Degree)(x, y: A1.family.Carrier z) -> (inclusion).apply z x = (inclusion).apply z y -> x = y :=
  \fun (z: Degree)(x, y: A1.family.Carrier z)(same: _) => trans!{{A1.family.Carrier z}} _ _ _ (sym!{{A1.family.Carrier z}} _ _ ((e).leftInverse z x))
    (trans!{{A1.family.Carrier z}} _ _ _
      (congr!{{A.family.Carrier z} {A1.family.Carrier z}} ((e.backward).apply z) _ _ ((s).injective z ((e.forward).apply z x) ((e.forward).apply z y) same))
      ((e).leftInverse z y));
\definition kernelImage: \forall (z: Degree)(y: B.family.Carrier z) -> (s.projection).apply z y = (C.family.space z).zero ->
  \exists ( x: A1.family.Carrier z \where (inclusion).apply z x = y ) := \block {
  \fun (z: Degree)(y: B.family.Carrier z)(closed: (s.projection).apply z y = (C.family.space z).zero) \then
  \takefrom x: \Cast[A.family.Carrier z] ({ x: A.family.Carrier z \where (s.inclusion).apply z x = y }) \by (s).kernelImage z y closed \then
  \return Logic.existsIntro[A1.family.Carrier z, { w: A1.family.Carrier z \where (inclusion).apply z w = y }] ((e.backward).apply z x)
    (trans!{{B.family.Carrier z}} _ _ _ (congr!{{A.family.Carrier z} {B.family.Carrier z}} ((s.inclusion).apply z) _ _ ((e).rightInverse z x))
      (\bysub(A.family.Carrier z, { x: A.family.Carrier z \where (s.inclusion).apply z x = y }, x)))
};
\definition sequence: New.Sequence := New.Sequence {
  inclusion := inclusion, projection := s.projection, injective := injective, onto := (s).onto,
  zero := \fun (z: Degree)(x: A1.family.Carrier z) => (s).zero z ((e.forward).apply z x), kernelImage := kernelImage,
};
