\definition Commutes: \Prop := \forall (z: Degree)(x: C.family.Carrier z) ->
  D.differential.apply z (((isomorphisms z).forward).apply x) = ((isomorphisms (next z)).forward).apply (C.differential.apply z x);
\definition reverseCommutes: Commutes -> \forall (z: Degree)(y: D.family.Carrier z) ->
  C.differential.apply z (((isomorphisms z).backward).apply y) = ((isomorphisms (next z)).backward).apply (D.differential.apply z y) :=
    \fun (commutes: Commutes)(z: Degree)(y: D.family.Carrier z) => trans!{{C.family.Carrier (next z)}} _ _ _
      (sym!{{C.family.Carrier (next z)}} _ _ ((isomorphisms (next z)).leftInverse (C.differential.apply z (((isomorphisms z).backward).apply y))))
      (congr!{{D.family.Carrier (next z)} {C.family.Carrier (next z)}} (((isomorphisms (next z)).backward).apply) _ _
        (trans!{{D.family.Carrier (next z)}} _ _ _ (sym!{{D.family.Carrier (next z)}} _ _ (commutes z (((isomorphisms z).backward).apply y)))
          (congr!{{D.family.Carrier z} {D.family.Carrier (next z)}} (D.differential.apply z) _ _ ((isomorphisms z).rightInverse y))));
\definition forwardData: Forward.Data := Forward.Data { apply := \fun (z: Degree) => ((isomorphisms z).forward).apply };
\definition backwardData: Backward.Data := Backward.Data { apply := \fun (z: Degree) => ((isomorphisms z).backward).apply };
\definition forward[compatible: Commutes]: Forward.Map := \into[Forward.Data](forwardData, { data: Forward.Data \where Forward.Laws[data] }) \by {
  Forward.Laws[forwardData] {
    addition := \fun (z: Degree) => ((isomorphisms z).forward).addition,
    scalar := \fun (z: Degree) => ((isomorphisms z).forward).scalar, commutes := compatible,
  }
};
\definition backward[compatible: Commutes]: Backward.Map := \into[Backward.Data](backwardData, { data: Backward.Data \where Backward.Laws[data] }) \by {
  Backward.Laws[backwardData] {
    addition := \fun (z: Degree) => ((isomorphisms z).backward).addition,
    scalar := \fun (z: Degree) => ((isomorphisms z).backward).scalar, commutes := reverseCommutes compatible,
  }
};
\definition data[compatible: Commutes]: Data := Data { forward := forward compatible, backward := backward compatible };
\definition inverseLaws: \forall (compatible: Commutes) -> Laws[data compatible] := \fun (compatible: Commutes) => Laws[data compatible] {
  leftInverse := \fun (z: Degree) => (isomorphisms z).leftInverse,
  rightInverse := \fun (z: Degree) => (isomorphisms z).rightInverse,
};
\definition isomorphism[compatible: Commutes]: Isomorphism := \into[Data](data compatible, { data: Data \where Laws[data] }) \by { inverseLaws compatible };
