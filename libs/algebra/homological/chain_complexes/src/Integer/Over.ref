\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\structure Family := {
  Carrier: Degree -> \Set,
  space: \forall (z: Degree) -> Modules.Space (Carrier z),
};
\structure DifferentialData[F: Family]: \Set := { apply: \forall (z: Degree) -> F.Carrier z -> F.Carrier (next z) };
\structure DifferentialLaws[F: Family, d: DifferentialData[F]]: \Prop := {
  addition: \forall (z: Degree)(x, y: F.Carrier z) -> d.apply z ((F.space z).add x y) = (F.space (next z)).add (d.apply z x) (d.apply z y),
  scalar: \forall (z: Degree)(a: R)(x: F.Carrier z) -> d.apply z ((F.space z).smul a x) = (F.space (next z)).smul a (d.apply z x),
  squareZero: \forall (z: Degree)(x: F.Carrier z) -> d.apply (next z) (d.apply z x) = (F.space (next (next z))).zero,
};
\structure Complex := {
  family: Family,
  differential: DifferentialData[family],
  laws: DifferentialLaws[family, differential],
};
\module Prior(C: Complex);
\module At(C: Complex, z: Degree);
\definition cohomology[C: Complex][z: Degree]: \Set := At[C := C, z := z].Cohomology;

\module Map(C, D: Complex);
\module Isomorphism(C, D: Complex);
\module End(C: Complex) {
  \import \parent.Map[C := C, D := C] \as Maps;
  \definition identity: Maps.Map := Maps.Map {
    apply := \fun (k: Degree)(x: C.family.Carrier k) => x,
    addition := \fun (k: Degree)(x, y: C.family.Carrier k) => \refl((C.family.space k).add x y),
    scalar := \fun (k: Degree)(a: R)(x: C.family.Carrier k) => \refl((C.family.space k).smul a x),
    commutes := \fun (k: Degree)(x: C.family.Carrier k) => \refl((C.differential).apply k x),
  };
  \module Point(k: Degree) {
    \import \parent.\parent.At[C := C, z := k] \as Differential;
    \definition commutes: \forall (x: C.family.Carrier k) -> (C.differential).apply k (C.family.space k).zero = (C.family.space (next k)).zero :=
      \fun (x: C.family.Carrier k) => Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier (next k), source := C.family.space k, target := C.family.space (next k)].zeroPreserved Differential.differential;
  }
  \definition zeroMap: Maps.Map := Maps.Map {
    apply := \fun (k: Degree)(x: C.family.Carrier k) => (C.family.space k).zero,
    addition := \fun (k: Degree) => (Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier k, source := C.family.space k, target := C.family.space k].zeroMap).addition,
    scalar := \fun (k: Degree) => (Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier k, source := C.family.space k, target := C.family.space k].zeroMap).scalar,
    commutes := \fun (k: Degree) => Point[k := k].commutes,
  };
  \module At(k: Degree) {
    \import \parent.\parent.At[C := C, z := k] \as Cohomology;
    \import Maps.At[k := k] \as Map;
    \definition zeroOnCohomology: \forall (q: Cohomology.Cohomology) -> (Map.induced zeroMap).apply q = Cohomology.zeroClass :=
      Cohomology.classInduction (\fun (q: Cohomology.Cohomology) => (Map.induced zeroMap).apply q = Cohomology.zeroClass)
        (\fun (x: Cohomology.Closed) => Map.onClass zeroMap x);
    \definition inducedIdentity[h: Cohomology.Cohomology]: Cohomology.Cohomology := (Map.induced identity).apply h;
    \definition identityOnCohomology: \forall (h: Cohomology.Cohomology) -> (Map.induced identity).apply h = h :=
      Cohomology.classInduction (\fun (h: Cohomology.Cohomology) => (Map.induced identity).apply h = h)
        (\fun (x: Cohomology.Closed) => Map.onClass identity x);
  }
}


\module ShortExact(A, B, C: Complex);
