\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\structure Family {
  Carrier: Degree -> \Set,
  space: \forall (z: Degree) -> Modules.Space (Carrier z),
}
\structure DifferentialData[F: Family]: \Set { apply: \forall (z: Degree) -> F.Carrier z -> F.Carrier (next z) }
\structure DifferentialLaws[F: Family, d: DifferentialData[F]]: \Prop {
  addition: \forall (z: Degree)(x, y: F.Carrier z) -> d.apply z (#add{(F.space z)} x y) = #add{(F.space (next z))} (d.apply z x) (d.apply z y),
  scalar: \forall (z: Degree)(a: R)(x: F.Carrier z) -> d.apply z (#smul{(F.space z)} a x) = #smul{(F.space (next z))} a (d.apply z x),
  squareZero: \forall (z: Degree)(x: F.Carrier z) -> d.apply (next z) (d.apply z x) = #zero{(F.space (next (next z)))},
}
\structure Complex {
  family: Family,
  differential: DifferentialData[family],
  laws: DifferentialLaws[family, differential],
}
\module Prior(C: Complex);
\module At(C: Complex, z: Degree);
\definition cohomology(C: Complex)(z: Degree): \Set := At[C := C, z := z].Cohomology;

\module Map(C, D: Complex);
\module Isomorphism(C, D: Complex);
\module End(C: Complex) {
  \import \parent.Map[C := C, D := C] \as Maps;
  \definition identity: Maps.Map := Maps.Map {
    apply := \fun (k: Degree)(x: C.family.Carrier k) => x,
    addition := \fun (k: Degree)(x, y: C.family.Carrier k) => \refl(#add{(C.family.space k)} x y),
    scalar := \fun (k: Degree)(a: R)(x: C.family.Carrier k) => \refl(#smul{(C.family.space k)} a x),
    commutes := \fun (k: Degree)(x: C.family.Carrier k) => \refl(#apply{C.differential} k x),
  };
  \module Point(k: Degree) {
    \import \parent.\parent.At[C := C, z := k] \as Differential;
    \definition commutes: \forall (x: C.family.Carrier k) -> #apply{C.differential} k #zero{(C.family.space k)} = #zero{(C.family.space (next k))} :=
      \fun (x: C.family.Carrier k) => Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier (next k), source := C.family.space k, target := C.family.space (next k)].zeroPreserved Differential.differential;
  }
  \definition zeroMap: Maps.Map := Maps.Map {
    apply := \fun (k: Degree)(x: C.family.Carrier k) => #zero{(C.family.space k)},
    addition := \fun (k: Degree) => #addition{(Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier k, source := C.family.space k, target := C.family.space k].zeroMap)},
    scalar := \fun (k: Degree) => #scalar{(Modules.Hom[V := C.family.Carrier k, W := C.family.Carrier k, source := C.family.space k, target := C.family.space k].zeroMap)},
    commutes := \fun (k: Degree) => Point[k := k].commutes,
  };
  \module At(k: Degree) {
    \import \parent.\parent.At[C := C, z := k] \as Cohomology;
    \import Maps.At[k := k] \as Map;
    \definition zeroOnCohomology: \forall (q: Cohomology.Cohomology) -> #apply{(Map.induced zeroMap)} q = Cohomology.zeroClass :=
      Cohomology.classInduction (\fun (q: Cohomology.Cohomology) => #apply{(Map.induced zeroMap)} q = Cohomology.zeroClass)
        (\fun (x: Cohomology.Closed) => Map.onClass zeroMap x);
    \definition inducedIdentity(h: Cohomology.Cohomology): Cohomology.Cohomology := #apply{(Map.induced identity)} h;
    \definition identityOnCohomology: \forall (h: Cohomology.Cohomology) -> #apply{(Map.induced identity)} h = h :=
      Cohomology.classInduction (\fun (h: Cohomology.Cohomology) => #apply{(Map.induced identity)} h = h)
        (\fun (x: Cohomology.Closed) => Map.onClass identity x);
  }
}


\module ShortExact(A, B, C: Complex);
