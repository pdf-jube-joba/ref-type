\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\definition Carrier[k: Degree]: \Set := C.family.Carrier (Integers.reverse k);
\definition space[k: Degree]: Modules.Space (Carrier k) := C.family.space (Integers.reverse k);
\definition family: Chains.Family := Chains.Family { Carrier := Carrier, space := space };
\definition target[k: Degree]: next (Integers.reverse k) = Integers.reverse (previous k) :=
  sym!{Degree} _ _ (Integers.reversePrevious k);
\definition apply[k: Degree][x: Carrier k]: Carrier (previous k) :=
  Transport.cast C.family.Carrier (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k)
    (C.differential.apply (Integers.reverse k) x);
\definition addition: \forall (k: Degree)(x, y: Carrier k) ->
  apply k ((space k).add x y) = (space (previous k)).add (apply k x) (apply k y) :=
  \fun (k: Degree)(x, y: Carrier k) => trans!{{Carrier (previous k)}} _ _ _
    (congr!{{C.family.Carrier (next (Integers.reverse k))} {Carrier (previous k)}}
      (Transport.cast C.family.Carrier (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k)) _ _
      (C.laws.addition (Integers.reverse k) x y))
    (Transport.binaryNatural C.family.Carrier C.family.Carrier C.family.Carrier (\fun (z: Degree) => (C.family.space z).add)
      (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k)
      (C.differential.apply (Integers.reverse k) x) (C.differential.apply (Integers.reverse k) y));
\definition scalar: \forall (k: Degree)(a: R)(x: Carrier k) ->
  apply k ((space k).smul a x) = (space (previous k)).smul a (apply k x) :=
  \fun (k: Degree)(a: R)(x: Carrier k) => trans!{{Carrier (previous k)}} _ _ _
    (congr!{{C.family.Carrier (next (Integers.reverse k))} {Carrier (previous k)}}
      (Transport.cast C.family.Carrier (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k)) _ _
      (C.laws.scalar (Integers.reverse k) a x))
    (Transport.natural C.family.Carrier C.family.Carrier (\fun (z: Degree) => (C.family.space z).smul a)
      (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k) (C.differential.apply (Integers.reverse k) x));
\definition squareZero: \forall (k: Degree)(x: Carrier k) -> apply (previous k) (apply k x) = (space (previous (previous k))).zero :=
  \fun (k: Degree)(x: Carrier k) => eq_reason_in!{{Carrier (previous (previous k))} _
    "=" _ "by" { congr!{{C.family.Carrier (next (Integers.reverse (previous k)))} {Carrier (previous (previous k))}}
      (Transport.cast C.family.Carrier (next (Integers.reverse (previous k))) (Integers.reverse (previous (previous k))) (target (previous k))) _ _
      (sym!{{C.family.Carrier (next (Integers.reverse (previous k)))}} _ _
        (Transport.natural C.family.Carrier (\fun (z: Degree) => C.family.Carrier (next z)) (C.differential.apply)
          (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k) (C.differential.apply (Integers.reverse k) x))) }
    "=" _ "by" { congr!{{C.family.Carrier (next (Integers.reverse (previous k)))} {Carrier (previous (previous k))}}
        (Transport.cast C.family.Carrier (next (Integers.reverse (previous k))) (Integers.reverse (previous (previous k))) (target (previous k))) _ _
        (trans!{{C.family.Carrier (next (Integers.reverse (previous k)))}} _ _ _
          (congr!{{C.family.Carrier (next (next (Integers.reverse k)))} {C.family.Carrier (next (Integers.reverse (previous k)))}}
            (Transport.cast (\fun (z: Degree) => C.family.Carrier (next z)) (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k)) _ _
            (C.laws.squareZero (Integers.reverse k) x))
          (Transport.pointNatural (\fun (z: Degree) => C.family.Carrier (next z)) (\fun (z: Degree) => (C.family.space (next z)).zero)
            (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k))) }
    "=" _ "by" { Transport.pointNatural C.family.Carrier (\fun (z: Degree) => (C.family.space z).zero)
        (next (Integers.reverse (previous k))) (Integers.reverse (previous (previous k))) (target (previous k)) }
  };
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := Chains.DifferentialData[family] { apply := apply },
  laws := Chains.DifferentialLaws[family, Chains.DifferentialData[family] { apply := apply }] {
    addition := addition, scalar := scalar, squareZero := squareZero,
  },
};

\module Mapping(D: Cochains.Complex);
