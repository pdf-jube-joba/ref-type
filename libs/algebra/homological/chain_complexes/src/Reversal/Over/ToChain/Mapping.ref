\import \parent.\parent.ToChain[C := D] \as Target;
\import Cochains.Map[C := C, D := D] \as Original;
\import Chains.Map[C := complex, D := Target.complex] \as Reversed;
\definition map(f: Original.Map): Reversed.Map := Reversed.Map {
  apply := \fun (k: Degree) => f.apply (Integers.reverse k),
  addition := \fun (k: Degree) => f.addition (Integers.reverse k),
  scalar := \fun (k: Degree) => f.scalar (Integers.reverse k),
  commutes := \fun (k: Degree)(x: Carrier k) => trans!{{D.family.Carrier (Integers.reverse (previous k))}} _ _ _
    (congr!{{D.family.Carrier (next (Integers.reverse k))} {D.family.Carrier (Integers.reverse (previous k))}}
      (Transport.cast D.family.Carrier (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k)) _ _ (f.commutes (Integers.reverse k) x))
    (Transport.natural C.family.Carrier D.family.Carrier (f.apply)
      (next (Integers.reverse k)) (Integers.reverse (previous k)) (target k) (C.differential.apply (Integers.reverse k) x)),
};
