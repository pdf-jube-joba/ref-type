\import category.Additive[] \as Additive;
\import category.Abelian[] \as Abelian;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition categoryData: Cat.CategoryData[Index, Hom] := data;
\import Modules.Zero[] \as Zero;
\module Pair(x, y: Index) {
  \import Modules.Biproduct[V := family.Carrier x, W := family.Carrier y, left := family.space x, right := family.space y] \as Sum;
  \definition Carrier: \Set := Sum.Carrier;
  \definition space: Modules.Space Carrier := Sum.space;
}
\module Kernel(x, y: Index, f: Hom x y);
\module Cokernel(x, y: Index, f: Hom x y);
\structure Objects: \Set {
  zero: Index,
  pair: Index -> Index -> Index,
  kernel: \forall (x, y: Index) -> Hom x y -> Index,
  cokernel: \forall (x, y: Index) -> Hom x y -> Index,
}
\structure Representations[objects: Objects]: \Set {
  zero: Modules.Isomorphism[V := Zero.Carrier, W := family.Carrier objects.zero, source := Zero.moduleSpace, target := family.space objects.zero].Isomorphism,
  pair: \forall (x, y: Index) -> Modules.Isomorphism[V := Pair[x := x, y := y].Carrier, W := family.Carrier (objects.pair x y), source := Pair[x := x, y := y].space, target := family.space (objects.pair x y)].Isomorphism,
  kernel: \forall (x, y: Index)(f: Hom x y) -> Modules.Isomorphism[V := Kernel[x := x, y := y, f := f].Carrier, W := family.Carrier (objects.kernel x y f), source := Kernel[x := x, y := y, f := f].space, target := family.space (objects.kernel x y f)].Isomorphism,
  cokernel: \forall (x, y: Index)(f: Hom x y) -> Modules.Isomorphism[V := Cokernel[x := x, y := y, f := f].Carrier, W := family.Carrier (objects.cokernel x y f), source := Cokernel[x := x, y := y, f := f].space, target := family.space (objects.cokernel x y f)].Isomorphism,
}
\structure Data: \Set { objects: Objects, representations: Representations[objects] }
\module With(closure: Data);
