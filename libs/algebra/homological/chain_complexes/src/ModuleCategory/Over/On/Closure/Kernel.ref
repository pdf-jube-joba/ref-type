\import Modules.Of[V := family.Carrier x, space := family.space x].Submodule[] \as Sub;
\import Sub.Kernel[W := family.Carrier y, target := family.space y] \as Kernels;
\definition submodule: Sub.Submodule := Kernels.kernel f;
\import Sub.Of[S := submodule] \as Included;
\definition Carrier: \Set := Included.Carrier;
\definition space: Modules.Space Carrier := Included.moduleSpace;
\definition inclusion: Modules.Hom[V := Carrier, W := family.Carrier x, source := space, target := family.space x].Map := Included.inclusion;
