\definition trivial: \forall (u: family.Carrier zeroObject) -> u = (family.space zeroObject).zero :=
  \fun (u: family.Carrier zeroObject) => trans!{{family.Carrier zeroObject}} u (closure.representations.zero.forward.apply (closure.representations.zero.backward.apply u)) (family.space zeroObject).zero
    (sym!{{family.Carrier zeroObject}} _ _ (closure.representations.zero.rightInverse u))
    (trans!{{family.Carrier zeroObject}} _ _ _
      (congr!{Zero.Carrier {family.Carrier zeroObject}} (closure.representations.zero.forward.apply) _ _ (Zero.unique (closure.representations.zero.backward.apply u) Zero.Carrier::zero))
      (Modules.Hom[V := Zero.Carrier, W := family.Carrier zeroObject, source := Zero.moduleSpace, target := family.space zeroObject].zeroPreserved closure.representations.zero.forward));
\definition data: Additive.ZeroData[Index, Hom] := Additive.ZeroData[Index, Hom] { object := zeroObject, from := zero zeroObject, to := \fun (x: Index) => zero x zeroObject };
\definition fromUnique: \forall (x: Index)(f: Hom zeroObject x) -> f = zero zeroObject x :=
  \fun (x: Index)(f: Hom zeroObject x) => \parent.\parent.\parent.At[x := zeroObject, y := x].ext f (zero zeroObject x)
    (\fun (u: family.Carrier zeroObject) => trans!{{family.Carrier x}} _ _ _
      (congr!{{family.Carrier zeroObject} {family.Carrier x}} (f.apply) _ _ (trivial u))
      (Modules.Hom[V := family.Carrier zeroObject, W := family.Carrier x, source := family.space zeroObject, target := family.space x].zeroPreserved f));
\definition toUnique: \forall (x: Index)(f: Hom x zeroObject) -> f = zero x zeroObject :=
  \fun (x: Index)(f: Hom x zeroObject) => \parent.\parent.\parent.At[x := x, y := zeroObject].ext f (zero x zeroObject) (\fun (u: family.Carrier x) => trivial (f.apply u));
\definition laws: Additive.ZeroLaws[Index, Hom, data] := Additive.ZeroLaws[Index, Hom, data] { fromUnique := fromUnique, toUnique := toUnique };
\definition object: Additive.Zero[Index, Hom] := \into[Additive.ZeroData[Index, Hom]](data, { data: Additive.ZeroData[Index, Hom] \where Additive.ZeroLaws[Index, Hom, data] }) \by { laws };
