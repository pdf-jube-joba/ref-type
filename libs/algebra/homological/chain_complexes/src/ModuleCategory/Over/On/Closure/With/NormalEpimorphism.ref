\import std.Logic[].Proposition[] \as Existential;
\import \parent.Epimorphism[x := x, y := y, f := f] \as Epi;
\import \parent.Kernel[x := x, y := y, f := f] \as Kernel;
\import \parent.\parent.Kernel[x := x, y := y, f := f] \as Actual;
\definition source: Modules.Bundle := Modules.Bundle { Carrier := family.Carrier x, space := family.space x };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := family.Carrier y, space := family.space y };
\module Descend(z: Index, g: Hom x z) {
  \definition final: Modules.Bundle := Modules.Bundle { Carrier := family.Carrier z, space := family.space z };
  \import Modules.SurjectiveDescent[A := source, B := target, U := final].On[q := f, f := g] \as Descent;
  \definition Killed: \Prop := compose Kernel.point x z g Kernel.inclusion = zero Kernel.point z;
  \definition killsKernel: Killed -> Descent.KillsKernel := \block {
    \fun (killed: Killed)(u: family.Carrier x)(inKernel: f.apply u = (family.space y).zero) \then
    \let v: Actual.Carrier := \into[family.Carrier x](u, Actual.submodule.carrier) \by { inKernel } \then
    \let represented: family.Carrier Kernel.point := Kernel.isomorphism.forward.apply v \then
    \return trans!{{family.Carrier z}} (g.apply u) (g.apply (Kernel.inclusion.apply represented)) (family.space z).zero
      (congr!{{family.Carrier x} {family.Carrier z}} (g.apply) _ _
        (sym!{{family.Carrier x}} _ _ (congr!{Actual.Carrier {family.Carrier x}} (Actual.inclusion.apply) _ _ (Kernel.isomorphism.leftInverse v))))
      (congr!{{Hom Kernel.point z} {family.Carrier z}} (\fun (h: Hom Kernel.point z) => h.apply represented) (compose Kernel.point x z g Kernel.inclusion) (zero Kernel.point z) killed)
  };
  \definition existence: Epi.Epi -> Killed -> \exists ( h: Hom y z \where compose x y z h f = g ) :=
    \fun (epi: Epi.Epi)(killed: Killed) => Existential.existsIntro[Hom y z, { h: Hom y z \where compose x y z h f = g }] (Descent.map (Epi.onto epi) (killsKernel killed))
      (\parent.\parent.\parent.\parent.At[x := x, y := z].ext (compose x y z (Descent.map (Epi.onto epi) (killsKernel killed)) f) g
        (\fun (u: family.Carrier x) => Descent.onImage (Epi.onto epi) (killsKernel killed) u));
}
\definition normal: Epi.Epi -> Abelian.IsCokernel[Index, Hom, categoryData, zero, Kernel.point, x, y, Kernel.inclusion, f] :=
  \fun (epi: Epi.Epi) => Abelian.IsCokernel[Index, Hom, categoryData, zero, Kernel.point, x, y, Kernel.inclusion, f] {
    zero := Kernel.zeroLaw,
    factorization := \fun (z: Index)(g: Hom x z)(killed: compose Kernel.point x z g Kernel.inclusion = zero Kernel.point z) => Descend[z := z, g := g].existence epi killed,
    unique := epi,
  };
