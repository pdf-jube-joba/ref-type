\use std.Logic[].Equality[].eq_reason_in;
\definition leftCarrier[x: Index][k: Chain.Degree]: \Set := Chains.Map[C := A x, D := A x].sourceCarrier k;
\definition middleCarrier[x: Index][k: Chain.Degree]: \Set := Chains.Map[C := B x, D := B x].sourceCarrier k;
\definition rightCarrier[x: Index][k: Chain.Degree]: \Set := Chains.Map[C := C x, D := C x].sourceCarrier k;
\module At(x, y: Index) {
  \import Chains.Map[C := A x, D := A y] \as Left;
  \import Chains.Map[C := B x, D := B y] \as Middle;
  \import Chains.Map[C := C x, D := C y] \as Right;
  \structure Data: \Set := { left: Left.Map, middle: Middle.Map, right: Right.Map };
  \import Chains.ShortExact[A := A x, B := B x, C := C x].Morphism[A1 := A y, B1 := B y, C1 := C y] \as Morphism;
  \structure Laws[f: Data]: \Prop := {
    left: \forall (k: Chain.Degree)(u: leftCarrier x k) -> f.middle.apply k (((sequences x).inclusion).apply k u) = ((sequences y).inclusion).apply k (f.left.apply k u),
    right: \forall (k: Chain.Degree)(u: middleCarrier x k) -> ((sequences y).projection).apply k (f.middle.apply k u) = f.right.apply k (((sequences x).projection).apply k u),
  };
  \definition Hom: \Set := \Cast[Data] ({ f: Data \where Laws[f] });
  \definition dataExt: \forall (f, g: Data) -> f.left = g.left -> f.middle = g.middle -> f.right = g.right -> f = g :=
    \induction (f: Data) \return \forall (g: Data) -> f.left = g.left -> f.middle = g.middle -> f.right = g.right -> f = g \with {
      | # : \fun (a: Left.Map)(b: Middle.Map)(c: Right.Map) =>
        \induction (g: Data) \return a = g.left -> b = g.middle -> c = g.right -> Data::# a b c = g \with {
          | # : \fun (a1: Left.Map)(b1: Middle.Map)(c1: Right.Map)(ea: a = a1)(eb: b = b1)(ec: c = c1) =>
            eq_reason_in!{Data _
              "=" _ "by" { congr!{Left.Map Data} (\fun (u: Left.Map) => Data::# u b c) _ _ ea }
              "=" _ "by" { congr!{Middle.Map Data} (\fun (u: Middle.Map) => Data::# a1 u c) _ _ eb }
              "=" _ "by" { congr!{Right.Map Data} (\fun (u: Right.Map) => Data::# a1 b1 u) _ _ ec }
            }
        }
    };
  \definition ext: \forall (f, g: Hom) -> f.left = g.left -> f.middle = g.middle -> f.right = g.right -> f = g :=
    \fun (f, g: Hom) => dataExt f g;
  \definition leftExt: \forall (f, g: Hom) -> (\forall (k: Chain.Degree)(u: leftCarrier x k) -> f.left.apply k u = g.left.apply k u) -> f.left = g.left :=
    \fun (f, g: Hom) => Left.ext f.left g.left;
  \definition middleExt: \forall (f, g: Hom) -> (\forall (k: Chain.Degree)(u: middleCarrier x k) -> f.middle.apply k u = g.middle.apply k u) -> f.middle = g.middle :=
    \fun (f, g: Hom) => Middle.ext f.middle g.middle;
  \definition rightExt: \forall (f, g: Hom) -> (\forall (k: Chain.Degree)(u: rightCarrier x k) -> f.right.apply k u = g.right.apply k u) -> f.right = g.right :=
    \fun (f, g: Hom) => Right.ext f.right g.right;
  \definition commutative[f: Hom]: Laws[f] := \bysub(Data, { f: Data \where Laws[f] }, f);
  \definition diagram[f: Hom]: Morphism.Diagram[s := sequences x, t := sequences y, a := f.left, b := f.middle, c := f.right].Commutative :=
    Morphism.Diagram[s := sequences x, t := sequences y, a := f.left, b := f.middle, c := f.right].Commutative {
      left := (commutative f).left, right := (commutative f).right,
    };
}
\definition Hom[x, y: Index]: \Set := At[x := x, y := y].Hom;
\module Identity(x: Index) {
  \import \parent.At[x := x, y := x] \as Maps;
  \definition data: Maps.Data := Maps.Data {
    left := Chains.End[C := A x].identity, middle := Chains.End[C := B x].identity, right := Chains.End[C := C x].identity,
  };
  \definition laws: Maps.Laws[data] := Maps.Laws[data] {
    left := \fun (k: Chain.Degree)(u: leftCarrier x k) => \refl(((sequences x).inclusion).apply k u),
    right := \fun (k: Chain.Degree)(u: middleCarrier x k) => \refl(((sequences x).projection).apply k u),
  };
  \definition map: Hom x x := \into[Maps.Data](data, { f: Maps.Data \where Maps.Laws[f] }) \by { laws };
}
\definition identity[x: Index]: Hom x x := Identity[x := x].map;
\module Composition(x, y, z: Index) {
  \import \parent.At[x := x, y := z] \as Maps;
  \import \parent.At[x := x, y := y] \as Before;
  \import \parent.At[x := y, y := z] \as After;
  \definition data[g: Hom y z][f: Hom x y]: Maps.Data := Maps.Data {
    left := Chains.Map[C := A y, D := A z].Composition[B := A x].compose g.left f.left,
    middle := Chains.Map[C := B y, D := B z].Composition[B := B x].compose g.middle f.middle,
    right := Chains.Map[C := C y, D := C z].Composition[B := C x].compose g.right f.right,
  };
  \definition laws: \forall (g: Hom y z)(f: Hom x y) -> Maps.Laws[data g f] :=
    \fun (g: Hom y z)(f: Hom x y) => Maps.Laws[data g f] {
      left := \fun (k: Chain.Degree)(u: leftCarrier x k) => trans!{{middleCarrier z k}} _ _ _
        (congr!{{middleCarrier y k} {middleCarrier z k}} (g.middle.apply k) _ _ ((Before.diagram f).left k u))
        ((After.diagram g).left k (f.left.apply k u)),
      right := \fun (k: Chain.Degree)(u: middleCarrier x k) => trans!{{rightCarrier z k}} _ _ _
        ((After.diagram g).right k (f.middle.apply k u))
        (congr!{{rightCarrier y k} {rightCarrier z k}} (g.right.apply k) _ _ ((Before.diagram f).right k u)),
    };
  \definition map[g: Hom y z][f: Hom x y]: Hom x z := \into[Maps.Data](data g f, { f: Maps.Data \where Maps.Laws[f] }) \by { laws g f };
}
\definition compose[x, y, z: Index][g: Hom y z][f: Hom x y]: Hom x z := Composition[x := x, y := y, z := z].map g f;
\definition data: Cat.CategoryData[Index, Hom] := Cat.CategoryData[Index, Hom] { identity := identity, compose := compose };
\definition laws: Cat.CategoryLaws[Index, Hom, data] := Cat.CategoryLaws[Index, Hom, data] {
  leftIdentity := \fun (x, y: Index)(f: Hom x y) => At[x := x, y := y].ext (compose x y y (identity y) f) f
    (At[x := x, y := y].leftExt (compose x y y (identity y) f) f (\fun (k: Chain.Degree)(u: leftCarrier x k) => \refl(f.left.apply k u)))
    (At[x := x, y := y].middleExt (compose x y y (identity y) f) f (\fun (k: Chain.Degree)(u: middleCarrier x k) => \refl(f.middle.apply k u)))
    (At[x := x, y := y].rightExt (compose x y y (identity y) f) f (\fun (k: Chain.Degree)(u: rightCarrier x k) => \refl(f.right.apply k u))),
  rightIdentity := \fun (x, y: Index)(f: Hom x y) => At[x := x, y := y].ext (compose x x y f (identity x)) f
    (At[x := x, y := y].leftExt (compose x x y f (identity x)) f (\fun (k: Chain.Degree)(u: leftCarrier x k) => \refl(f.left.apply k u)))
    (At[x := x, y := y].middleExt (compose x x y f (identity x)) f (\fun (k: Chain.Degree)(u: middleCarrier x k) => \refl(f.middle.apply k u)))
    (At[x := x, y := y].rightExt (compose x x y f (identity x)) f (\fun (k: Chain.Degree)(u: rightCarrier x k) => \refl(f.right.apply k u))),
  associative := \fun (w, x, y, z: Index)(h: Hom y z)(g: Hom x y)(f: Hom w x) =>
    At[x := w, y := z].ext (compose w y z h (compose w x y g f)) (compose w x z (compose x y z h g) f)
      (At[x := w, y := z].leftExt (compose w y z h (compose w x y g f)) (compose w x z (compose x y z h g) f) (\fun (k: Chain.Degree)(u: leftCarrier w k) => \refl(h.left.apply k (g.left.apply k (f.left.apply k u)))))
      (At[x := w, y := z].middleExt (compose w y z h (compose w x y g f)) (compose w x z (compose x y z h g) f) (\fun (k: Chain.Degree)(u: middleCarrier w k) => \refl(h.middle.apply k (g.middle.apply k (f.middle.apply k u)))))
      (At[x := w, y := z].rightExt (compose w y z h (compose w x y g f)) (compose w x z (compose x y z h g) f) (\fun (k: Chain.Degree)(u: rightCarrier w k) => \refl(h.right.apply k (g.right.apply k (f.right.apply k u))))),
};
\definition category: Cat.Category := Cat.Category { Object := Index, Hom := Hom, structure := data, laws := laws };
\module Degree(k: Chain.Degree);
