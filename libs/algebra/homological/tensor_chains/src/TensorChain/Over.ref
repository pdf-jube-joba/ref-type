\import \parent.Grading[] \as Grading;
\import module_theory.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
\import chain_complexes.Chain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
\import std.Arithmetic[].Int[] \as Integers;
\module Sign(V: \Set, space: Modules.Space V);
\structure Family := {
  Carrier: Degree -> Degree -> \Set,
  space: \forall (p, q: Degree) -> Modules.Space (Carrier p q),
};
\structure DifferentialData[F: Family]: \Set := {
  horizontal: \forall (p, q: Degree) -> Modules.Hom[V := F.Carrier p q, W := F.Carrier (previous p) q,
    source := F.space p q, target := F.space (previous p) q].Map,
  vertical: \forall (p, q: Degree) -> Modules.Hom[V := F.Carrier p q, W := F.Carrier p (previous q),
    source := F.space p q, target := F.space p (previous q)].Map,
};
\structure DifferentialLaws[F: Family, d: DifferentialData[F]]: \Prop := {
  horizontalZero: \forall (p, q: Degree)(x: F.Carrier p q) ->
    (d.horizontal (previous p) q).apply ((d.horizontal p q).apply x) = (F.space (previous (previous p)) q).zero,
  verticalZero: \forall (p, q: Degree)(x: F.Carrier p q) ->
    (d.vertical p (previous q)).apply ((d.vertical p q).apply x) = (F.space p (previous (previous q))).zero,
  commute: \forall (p, q: Degree)(x: F.Carrier p q) ->
    (d.horizontal p (previous q)).apply ((d.vertical p q).apply x) =
    (d.vertical (previous p) q).apply ((d.horizontal p q).apply x),
};
\structure Complex := {
  family: Family,
  differential: DifferentialData[family],
  laws: DifferentialLaws[family, differential],
};
\module Tensor(C, D: Chains.Complex);
\module Total(C: Complex);
\module Map(C, D: Complex);
\module TensorMapping(C, D, E, F: Chains.Complex);
\module CycleProduct(C, D: Chains.Complex, p, q: Degree);
\module CycleProductNaturality(C, D, E, F: Chains.Complex, p, q: Degree);
\module IndexedCycleProduct(C, D: Chains.Complex, n: Degree);
\module RightBoundary(C, D: Chains.Complex, n: Degree, i: Grading.Index n);
\module RightVanishing(C, D: Chains.Complex, p: Degree);
\module LeftBoundary(C, D: Chains.Complex, n: Degree, i: Grading.Index n);
\module LeftVanishing(C, D: Chains.Complex, q: Degree);
\module CycleProductRightDescent(C, D: Chains.Complex, p, q: Degree);
\module Exterior(C, D: Chains.Complex, p, q: Degree);
\module HomologyEquality(C: Chains.Complex, z: Degree);
\module End(C: Complex);
\module TensorIdentity(C, D: Chains.Complex);
\module TensorComposition(A, B, C, E: Chains.Complex);

\module Row(E: Chains.Complex, p: Degree);

\module ExteriorTransport(C, D: Chains.Complex, p, q: Degree);

\module TensorSquare(A, B, C, D, E, F: Chains.Complex);
