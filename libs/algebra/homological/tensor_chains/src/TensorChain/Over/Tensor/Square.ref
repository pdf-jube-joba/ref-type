\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Term[p := p, q := q] \as Source;
\import \parent.At[p := p, q := q] \as Current;
\module Horizontal {
  \import \parent.\parent.Term[p := previous p, q := q] \as Middle;
  \import \parent.\parent.Term[p := previous (previous p), q := q] \as Target;
  \import \parent.\parent.At[p := previous p, q := q] \as After;
  \import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Compose;
  \import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q].Universal[U := Target.Carrier, target := Target.space] \as Universal;
  \definition mapZero: Compose.compose After.horizontal Current.horizontal = Maps.zeroMap :=
    Universal.ext (Compose.compose After.horizontal Current.horizontal) Maps.zeroMap
      (\fun (x: C.family.Carrier p)(y: D.family.Carrier q) => eq_reason_in!{Target.Carrier _
        "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (After.horizontal.apply) _ _ (Current.horizontalOnTensor x y) }
        "=" _ "by" { After.horizontalOnTensor (C.differential.apply p x) y }
        "=" _ "by" { congr!{{C.family.Carrier (previous (previous p))} Target.Carrier} (\fun (z: C.family.Carrier (previous (previous p))) => Target.tensor z y) _ _ (C.laws.squareZero p x) }
        "=" _ "by" { Target.zeroLeft y }
      });
  \definition zero: \forall (x: Source.Carrier) -> After.horizontal.apply (Current.horizontal.apply x) = Target.space.zero :=
    \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => f.apply x)
      (Compose.compose After.horizontal Current.horizontal) Maps.zeroMap mapZero;
}
\definition horizontalZero: \forall (x: Source.Carrier) ->
  (\parent.At[p := previous p, q := q].horizontal).apply (Current.horizontal.apply x) = (\parent.Term[p := previous (previous p), q := q].space).zero := Horizontal[].zero;
\module Vertical {
  \import \parent.\parent.Term[p := p, q := previous q] \as Middle;
  \import \parent.\parent.Term[p := p, q := previous (previous q)] \as Target;
  \import \parent.\parent.At[p := p, q := previous q] \as After;
  \import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Compose;
  \import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q].Universal[U := Target.Carrier, target := Target.space] \as Universal;
  \definition mapZero: Compose.compose After.vertical Current.vertical = Maps.zeroMap :=
    Universal.ext (Compose.compose After.vertical Current.vertical) Maps.zeroMap
      (\fun (x: C.family.Carrier p)(y: D.family.Carrier q) => eq_reason_in!{Target.Carrier _
        "=" _ "by" { congr!{Middle.Carrier Target.Carrier} (After.vertical.apply) _ _ (Current.verticalOnTensor x y) }
        "=" _ "by" { After.verticalOnTensor x (D.differential.apply q y) }
        "=" _ "by" { congr!{{D.family.Carrier (previous (previous q))} Target.Carrier} (Target.tensor x) _ _ (D.laws.squareZero q y) }
        "=" _ "by" { Target.zeroRight x }
      });
  \definition zero: \forall (x: Source.Carrier) -> After.vertical.apply (Current.vertical.apply x) = Target.space.zero :=
    \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => f.apply x)
      (Compose.compose After.vertical Current.vertical) Maps.zeroMap mapZero;
}
\definition verticalZero: \forall (x: Source.Carrier) ->
  (\parent.At[p := p, q := previous q].vertical).apply (Current.vertical.apply x) = (\parent.Term[p := p, q := previous (previous q)].space).zero := Vertical[].zero;
\import \parent.Term[p := previous p, q := q] \as HM;
\import \parent.Term[p := p, q := previous q] \as VM;
\import \parent.Term[p := previous p, q := previous q] \as Target;
\import \parent.At[p := previous p, q := q] \as AcrossHorizontal;
\import \parent.At[p := p, q := previous q] \as AcrossVertical;
\import Modules.Hom[V := VM.Carrier, W := Target.Carrier, source := VM.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as HV;
\import Modules.Hom[V := HM.Carrier, W := Target.Carrier, source := HM.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as VH;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
\import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q].Universal[U := Target.Carrier, target := Target.space] \as Universal;
\definition mapCommutes: HV.compose AcrossVertical.horizontal Current.vertical = VH.compose AcrossHorizontal.vertical Current.horizontal :=
  Universal.ext (HV.compose AcrossVertical.horizontal Current.vertical) (VH.compose AcrossHorizontal.vertical Current.horizontal)
    (\fun (x: C.family.Carrier p)(y: D.family.Carrier q) => eq_reason_in!{Target.Carrier _
      "=" _ "by" { congr!{VM.Carrier Target.Carrier} (AcrossVertical.horizontal.apply) _ _ (Current.verticalOnTensor x y) }
      "=" _ "by" { AcrossVertical.horizontalOnTensor x (D.differential.apply q y) }
      "=" _ "by" { sym!{Target.Carrier} _ _ (trans!{Target.Carrier} _ _ _
          (congr!{HM.Carrier Target.Carrier} (AcrossHorizontal.vertical.apply) _ _ (Current.horizontalOnTensor x y))
          (AcrossHorizontal.verticalOnTensor (C.differential.apply p x) y)) }
    });
\definition commute: \forall (x: Source.Carrier) ->
  AcrossVertical.horizontal.apply (Current.vertical.apply x) = AcrossHorizontal.vertical.apply (Current.horizontal.apply x) :=
  \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => f.apply x)
    (HV.compose AcrossVertical.horizontal Current.vertical) (VH.compose AcrossHorizontal.vertical Current.horizontal) mapCommutes;
