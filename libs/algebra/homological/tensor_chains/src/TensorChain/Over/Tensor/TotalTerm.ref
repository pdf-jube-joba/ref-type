\definition n: Degree := Grading.add p q;
\definition index: Grading.Index n := \into[Grading.Pair](Grading.Pair { first := p, second := q },
  { i: Grading.Pair \where Grading.add i.first i.second = n }) \by { \refl(n) };
\import \parent.\parent.Total[C := complex] \as Total;
\import Total.Term[n := n] \as Current;
\import Total.Term[n := previous n] \as Target;
\import Total.Step[n := n] \as Step;
\import Current.Component[i := index] \as Inclusion;
\import Target.Component[i := Total.upHorizontal n index] \as HI;
\import Target.Component[i := Total.upVertical n index] \as VI;
\import \parent.Term[p := p, q := q] \as Term;
\import \parent.Term[p := previous p, q := q] \as HT;
\import \parent.Term[p := p, q := previous q] \as VT;
\import \parent.At[p := p, q := q] \as Differential;
\import \root.TensorChain[].Over[R := R, ring := ring].Sign[V := VT.Carrier, space := VT.space] \as Sign;
\definition value[x: C.family.Carrier p][y: D.family.Carrier q]: Current.Carrier :=
  Inclusion.injection.apply (Term.tensor x y);
\definition horizontal[x: C.family.Carrier p][y: D.family.Carrier q]: Target.Carrier :=
  HI.injection.apply (HT.tensor (C.differential.apply p x) y);
\definition vertical[x: C.family.Carrier p][y: D.family.Carrier q]: Target.Carrier :=
  VI.injection.apply ((Sign.map p).apply (VT.tensor x (D.differential.apply q y)));
\definition differential: \forall (x: C.family.Carrier p)(y: D.family.Carrier q) ->
  Total.differential.apply n (value x y) = Target.space.add (horizontal x y) (vertical x y) :=
  \fun (x: C.family.Carrier p)(y: D.family.Carrier q) =>
    congr2!{Target.Carrier Target.Carrier Target.Carrier} (Target.space.add) _ _ _ _
      (trans!{Target.Carrier} _ _ _ (Step.horizontalOnInjection index (Term.tensor x y))
        (congr!{HT.Carrier Target.Carrier} (HI.injection.apply) _ _ (Differential.horizontalOnTensor x y)))
      (trans!{Target.Carrier} _ _ _ (Step.verticalOnInjection index (Term.tensor x y))
        (congr!{VT.Carrier Target.Carrier} (\fun (t: VT.Carrier) => VI.injection.apply ((Sign.map p).apply t)) _ _
          (Differential.verticalOnTensor x y)));
