\import \parent.\parent.Grading[] \as Grading;
\definition Index(n: Degree): \Set := Grading.Index n;
\module Term(n: Degree) {
  \definition family: Modules.Family[Index n] := Modules.Family[Index n] {
    Carrier := \fun (i: Index n) => C.family.Carrier #first{i} #second{i},
    space := \fun (i: Index n) => C.family.space #first{i} #second{i},
  };
  \import Modules.DirectSum[Index := Index n, family := family] \as Sum;
  \definition Carrier: \Set := Sum.Carrier;
  \definition space: Modules.Space Carrier := Sum.space;
  \module Component(i: Index n) {
    \definition injection: Modules.Hom[V := C.family.Carrier #first{i} #second{i}, W := Carrier,
      source := C.family.space #first{i} #second{i}, target := space].Map := Sum.Injection[i := i].map;
  }
}
\definition upHorizontal(n: Degree)(i: Index n): Index (previous n) := Grading.horizontal n i;
\definition upVertical(n: Degree)(i: Index n): Index (previous n) := Grading.vertical n i;
\module Step(n: Degree);
\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: Degree) => Term[n := n].Carrier,
  space := \fun (n: Degree) => Term[n := n].space,
};
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: Degree) => #apply{(Step[n := n].differential)},
};
\module Square(n: Degree);
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: Degree) => #addition{(Step[n := n].differential)},
    scalar := \fun (n: Degree) => #scalar{(Step[n := n].differential)},
    squareZero := \fun (n: Degree) => Square[n := n].zero,
  },
};
