\import std.Logic[].Proposition[] \as Existential;
\import Chains.At[C := C, z := z] \as H;
\import Modules.Laws[V := C.family.Carrier z, space := C.family.space z] \as Vector;
\import algebra.Group[].Of[Carrier := C.family.Carrier z, group := Vector.additive] \as Group;
\import Modules.Hom[V := C.family.Carrier (next z), W := C.family.Carrier z,
  source := C.family.space (next z), target := C.family.space z] \as PriorMaps;
\definition boundaryZero: \In[C.family.Carrier z] (H.boundaries.carrier) (C.family.space z).zero :=
  Existential.existsIntro[C.family.Carrier (next z),
    { x: C.family.Carrier (next z) \where H.prior.apply x = (C.family.space z).zero }]
    (C.family.space (next z)).zero (PriorMaps.zeroPreserved H.prior);
\definition ambient(x: H.Cycle): C.family.Carrier z := x;
\definition equalClass: \forall (x, y: H.Cycle) -> (ambient x) = (ambient y) -> H.classOf x = H.classOf y :=
  \fun (x, y: H.Cycle)(same: (ambient x) = (ambient y)) => H.classEqual x y
    (\idelim (C.family.space z).zero = (C.family.space z).add x ((C.family.space z).neg y)
      \with v: C.family.Carrier z => \In[C.family.Carrier z] (H.boundaries.carrier) v \by {
        base: boundaryZero,
        equality: sym!{{C.family.Carrier z}} _ _ (trans!{{C.family.Carrier z}} _ _ _
          (congr!{{C.family.Carrier z} {C.family.Carrier z}}
            (\fun (v: C.family.Carrier z) => (C.family.space z).add v ((C.family.space z).neg y)) _ _ same)
          (Group.inverseRight y))
      });
