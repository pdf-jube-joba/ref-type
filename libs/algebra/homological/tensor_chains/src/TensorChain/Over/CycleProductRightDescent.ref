\import std.Logic[].Proposition[] \as Existential;
\import Chains.At[C := C, z := p] \as Left;
\import Chains.At[C := D, z := q] \as Right;
\import \parent.CycleProduct[C := C, D := D, p := p, q := q] \as Exterior;
\import \parent.RightVanishing[C := C, D := D, p := p] \as Boundaries;
\import \parent.Tensor[C := C, D := D] \as Product;
\import \parent.Total[C := Product.complex] \as Total;
\import Chains.At[C := Total.complex, z := Grading.add p q] \as H;
\definition leftCycles: Modules.Bundle := Modules.Bundle { Carrier := Left.Cycle, space := Left.cycleSpace };
\definition rightCycles: Modules.Bundle := Modules.Bundle { Carrier := Right.Cycle, space := Right.cycleSpace };
\definition rightHomology: Modules.Bundle := Modules.Bundle { Carrier := Right.Homology, space := Right.homologySpace };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := H.Homology, space := H.homologySpace };
\import Modules.Tensor[V := Left.Cycle, W := Right.Cycle, left := Left.cycleSpace, right := Right.cycleSpace] \as Cycles;
\import Modules.Tensor[V := Right.Cycle, W := Left.Cycle, left := Right.cycleSpace, right := Left.cycleSpace] \as Reversed;
\import Reversed.Symmetry[] \as InputSwap;
\import Modules.Hom[V := Cycles.Carrier, W := H.Homology, source := Cycles.space, target := H.homologySpace].Composition[
  U := Reversed.Carrier, domain := Reversed.space] \as Input;
\definition input: Modules.Hom[V := Reversed.Carrier, W := H.Homology,
  source := Reversed.space, target := H.homologySpace].Map := Input.compose Exterior.map InputSwap.forward;
\definition onInput: \forall (y: Right.Cycle)(x: Left.Cycle) ->
  #apply{input} (Reversed.tensor y x) = Exterior.classOf x y :=
  \fun (y: Right.Cycle)(x: Left.Cycle) => trans!{H.Homology}
    (#apply{input} (Reversed.tensor y x)) (#apply{Exterior.map} (Cycles.tensor x y)) (Exterior.classOf x y)
    (congr!{Cycles.Carrier H.Homology} (#apply{Exterior.map}) _ _ (InputSwap.onTensor y x))
    (Exterior.onTensor x y);
\import Modules.TensorDescent[B := rightCycles, C := rightHomology, N := leftCycles, U := target].On[
  q := Right.classLinear, f := input] \as Descent;
\definition onto: Descent.Onto :=
  Right.classInduction
    (\fun (h: Right.Homology) => \exists { y: Right.Cycle \where Right.classOf y = h })
    (\fun (y: Right.Cycle) => Existential.existsIntro[Right.Cycle, { z: Right.Cycle \where Right.classOf z = Right.classOf y }] y
      (\refl(Right.classOf y)));
\definition kills: Descent.Kills :=
  \fun (y: Right.Cycle)(zero: Right.classOf y = #zero{Right.homologySpace})(x: Left.Cycle) =>
    trans!{H.Homology} (#apply{input} (Reversed.tensor y x)) (Exterior.classOf x y) #zero{H.homologySpace}
      (onInput y x) (Boundaries.vanishes (Grading.add p q) q (\refl(Grading.add p q)) x y (Right.zeroClassBoundary y zero));
\import Modules.Tensor[V := Right.Homology, W := Left.Cycle,
  left := Right.homologySpace, right := Left.cycleSpace] \as ReversedTarget;
\import Modules.Tensor[V := Left.Cycle, W := Right.Homology,
  left := Left.cycleSpace, right := Right.homologySpace] \as Source;
\import Source.Symmetry[] \as OutputSwap;
\import Modules.Hom[V := ReversedTarget.Carrier, W := H.Homology,
  source := ReversedTarget.space, target := H.homologySpace].Composition[
  U := Source.Carrier, domain := Source.space] \as Output;
\definition map: Modules.Hom[V := Source.Carrier, W := H.Homology,
  source := Source.space, target := H.homologySpace].Map := Output.compose (Descent.map onto kills) OutputSwap.forward;
\definition onTensor: \forall (x: Left.Cycle)(y: Right.Cycle) ->
  #apply{map} (Source.tensor x (Right.classOf y)) = Exterior.classOf x y :=
  \fun (x: Left.Cycle)(y: Right.Cycle) => trans!{H.Homology}
    _ _ _
    (congr!{ReversedTarget.Carrier H.Homology} (#apply{(Descent.map onto kills)}) _ _ (OutputSwap.onTensor x (Right.classOf y)))
    (trans!{H.Homology} _ _ _ (Descent.onTensor onto kills (Right.classOf y) x)
      (trans!{H.Homology} _ _ _ (Descent.At[y := x].onImage onto kills y) (onInput y x)));
