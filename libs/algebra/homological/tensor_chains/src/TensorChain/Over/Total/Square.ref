\import \parent.Term[n := n] \as Source;
\import \parent.Term[n := previous n] \as Middle;
\import \parent.Term[n := previous (previous n)] \as Target;
\import \parent.Step[n := n] \as First;
\import \parent.Step[n := previous n] \as Second;
\import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[
  U := Source.Carrier, domain := Source.space] \as Compose;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
\import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space] \as MiddleMaps;
\import Modules.DirectSum[Index := Index n, family := Source.family].To[W := Target.Carrier, target := Target.space] \as Universal;
\import Modules.Laws[V := Target.Carrier, space := Target.space] \as Vector;
\import algebra.Group[].Of[Carrier := Target.Carrier, group := Vector.additive] \as Additive;
\module Component(i: Index n);
\definition horizontalSquare: Compose.compose Second.horizontal First.horizontal = Maps.zeroMap :=
  Universal.ext (Compose.compose Second.horizontal First.horizontal) Maps.zeroMap
    (\fun (i: Index n) => Component[i := i].horizontalZero);
\definition verticalSquare: Compose.compose Second.vertical First.vertical = Maps.zeroMap :=
  Universal.ext (Compose.compose Second.vertical First.vertical) Maps.zeroMap
    (\fun (i: Index n) => Component[i := i].verticalZero);
\definition cross: Compose.compose Second.horizontal First.vertical = Maps.negative (Compose.compose Second.vertical First.horizontal) :=
  Universal.ext (Compose.compose Second.horizontal First.vertical) (Maps.negative (Compose.compose Second.vertical First.horizontal))
    (\fun (i: Index n) => Component[i := i].antiCommutes);
\definition zero: \forall (x: Source.Carrier) -> Second.differential.apply (First.differential.apply x) = Target.space.zero :=
  \fun (x: Source.Carrier) => trans!{Target.Carrier} _ _ _
    (Second.differential.addition (First.horizontal.apply x) (First.vertical.apply x))
    (trans!{Target.Carrier} _ _ _
      (congr2!{Target.Carrier Target.Carrier Target.Carrier} (Target.space.add) _ _ _ _
        (congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => Target.space.add (f.apply x) (Second.vertical.apply (First.horizontal.apply x))) _ _ horizontalSquare)
        (congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => Target.space.add (Second.horizontal.apply (First.vertical.apply x)) (f.apply x)) _ _ verticalSquare))
      (trans!{Target.Carrier} _ _ _
        (congr2!{Target.Carrier Target.Carrier Target.Carrier} (Target.space.add) _ _ _ _
          (Additive.zeroLeft (Second.vertical.apply (First.horizontal.apply x)))
          (Additive.zeroRight (Second.horizontal.apply (First.vertical.apply x))))
        (trans!{Target.Carrier} _ _ _
          (congr!{Maps.Map Target.Carrier} (\fun (f: Maps.Map) => Target.space.add (Second.vertical.apply (First.horizontal.apply x)) (f.apply x)) _ _ cross)
          (Additive.inverseRight (Second.vertical.apply (First.horizontal.apply x))))));
