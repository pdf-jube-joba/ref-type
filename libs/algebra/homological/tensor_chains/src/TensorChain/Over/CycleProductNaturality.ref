\import Chains.Map[C := C, D := D] \as LeftMaps;
\import Chains.Map[C := E, D := F] \as RightMaps;
\import LeftMaps.At[k := p] \as Left;
\import RightMaps.At[k := q] \as Right;
\import Chains.At[C := C, z := p] \as SC;
\import Chains.At[C := E, z := q] \as SE;
\import \parent.CycleProduct[C := C, D := E, p := p, q := q] \as Source;
\import \parent.CycleProduct[C := D, D := F, p := p, q := q] \as Target;
\import \parent.Tensor[C := C, D := E] \as SourceTensor;
\import \parent.Tensor[C := D, D := F] \as TargetTensor;
\import \parent.Total[C := SourceTensor.complex] \as SourceTotal;
\import \parent.Total[C := TargetTensor.complex] \as TargetTotal;
\definition n: Degree := Grading.add p q;
\import Chains.At[C := TargetTotal.complex, z := n] \as H;
\import TargetTotal.Term[n := n] \as Current;
\import SourceTensor.Term[p := p, q := q] \as STerm;
\import TargetTensor.Term[p := p, q := q] \as TTerm;
\import Current.Component[i := Target.index] \as Inclusion;
\import \parent.TensorMapping[C := C, D := D, E := E, F := F] \as Mapping;
\import \parent.Map[C := SourceTensor.complex, D := TargetTensor.complex] \as Native;
\import Chains.Map[C := SourceTotal.complex, D := TargetTotal.complex] \as Totals;
\import Totals.At[k := n] \as Induced;
\module With(f: LeftMaps.Map, g: RightMaps.Map);
