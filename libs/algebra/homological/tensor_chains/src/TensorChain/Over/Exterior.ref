\import std.Logic[].Proposition[] \as Existential;
\import Chains.At[C := C, z := p] \as Left;
\import Chains.At[C := D, z := q] \as Right;
\import \parent.Tensor[C := C, D := D] \as Product;
\import \parent.Total[C := Product.complex] \as Total;
\import Chains.At[C := Total.complex, z := Grading.add p q] \as H;
\import \parent.CycleProduct[C := C, D := D, p := p, q := q] \as Cycles;
\import \parent.CycleProductRightDescent[C := C, D := D, p := p, q := q] \as RightDescent;
\import \parent.LeftVanishing[C := C, D := D, q := q] \as Boundaries;
\definition leftCycles: Modules.Bundle := Modules.Bundle { Carrier := Left.Cycle, space := Left.cycleSpace };
\definition leftHomology: Modules.Bundle := Modules.Bundle { Carrier := Left.Homology, space := Left.homologySpace };
\definition rightHomology: Modules.Bundle := Modules.Bundle { Carrier := Right.Homology, space := Right.homologySpace };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := H.Homology, space := H.homologySpace };
\import Modules.TensorDescent[B := leftCycles, C := leftHomology, N := rightHomology, U := target].On[
  q := Left.classLinear, f := RightDescent.map] \as Descent;
\definition onto: Descent.Onto :=
  Left.classInduction
    (\fun (h: Left.Homology) => \exists ( x: Left.Cycle \where Left.classOf x = h ))
    (\fun (x: Left.Cycle) => Existential.existsIntro[Left.Cycle, { z: Left.Cycle \where Left.classOf z = Left.classOf x }] x
      (\refl(Left.classOf x)));
\import Modules.Tensor[V := Left.Cycle, W := Right.Homology,
  left := Left.cycleSpace, right := Right.homologySpace] \as Mixed;
\definition kills: Descent.Kills :=
  \fun (x: Left.Cycle)(zero: Left.classOf x = Left.homologySpace.zero) =>
    Right.classInduction
      (\fun (h: Right.Homology) => RightDescent.map.apply (Mixed.tensor x h) = H.homologySpace.zero)
      (\fun (y: Right.Cycle) => trans!{H.Homology} _ _ _ (RightDescent.onTensor x y)
        (Boundaries.vanishes (Grading.add p q) p (\refl(Grading.add p q)) y x (Left.zeroClassBoundary x zero)));
\import Modules.Tensor[V := Left.Homology, W := Right.Homology,
  left := Left.homologySpace, right := Right.homologySpace] \as Tensor;
\definition Carrier: \Set := Tensor.Carrier;
\definition space: Modules.Space Carrier := Tensor.space;
\definition tensor[x: Left.Homology][y: Right.Homology]: Carrier := Tensor.tensor x y;
\definition map: Modules.Hom[V := Carrier, W := H.Homology, source := space, target := H.homologySpace].Map :=
  Descent.map onto kills;
\definition onClass: \forall (x: Left.Cycle)(y: Right.Cycle) ->
  map.apply (tensor (Left.classOf x) (Right.classOf y)) = Cycles.classOf x y :=
  \fun (x: Left.Cycle)(y: Right.Cycle) => trans!{H.Homology} _ _ _
    (Descent.onTensor onto kills (Left.classOf x) (Right.classOf y))
    (trans!{H.Homology} _ _ _ (Descent.At[y := Right.classOf y].onImage onto kills x) (RightDescent.onTensor x y));
