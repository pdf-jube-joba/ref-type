\import \parent.\parent.Grading[] \as Grading;
\import \parent.Tensor[C := C, D := D] \as Product;
\import \parent.Total[C := Product.complex] \as Total;
\definition n: Degree := Grading.add p q;
\definition index: Total.Index n := \into[Grading.Pair](Grading.Pair { first := p, second := q },
  { i: Grading.Pair \where Grading.add #first{i} #second{i} = n }) \by { \refl(n) };
\import Chains.At[C := C, z := p] \as Left;
\import Chains.At[C := D, z := q] \as Right;
\import Chains.At[C := Total.complex, z := n] \as H;
\import Product.Term[p := p, q := q] \as Term;
\import Product.At[p := p, q := q] \as Differential;
\import Product.Term[p := previous p, q := q] \as HTerm;
\import Product.Term[p := p, q := previous q] \as VTerm;
\import Total.Term[n := n] \as Current;
\import Total.Term[n := previous n] \as Next;
\import Total.Step[n := n] \as Step;
\import Current.Component[i := index] \as Inclusion;
\import Next.Component[i := Total.upHorizontal n index] \as HInclusion;
\import Next.Component[i := Total.upVertical n index] \as VInclusion;
\import Modules.Hom[V := HTerm.Carrier, W := Next.Carrier, source := HTerm.space, target := Next.space] \as HMaps;
\import Modules.Hom[V := VTerm.Carrier, W := Next.Carrier, source := VTerm.space, target := Next.space] \as VMaps;
\import \root.TensorChain[].Over[R := R, ring := ring].Sign[V := VTerm.Carrier, space := VTerm.space] \as Sign;
\import Modules.Hom[V := VTerm.Carrier, W := VTerm.Carrier, source := VTerm.space, target := VTerm.space] \as Signs;
\definition value(x: Left.Cycle)(y: Right.Cycle): Current.Carrier := #apply{Inclusion.injection} (Term.tensor x y);
\definition horizontalClosed: \forall (x: Left.Cycle)(y: Right.Cycle) ->
  #apply{Step.horizontal} (value x y) = #zero{Next.space} :=
  \fun (x: Left.Cycle)(y: Right.Cycle) => trans!{Next.Carrier}
    _ _ _
    (trans!{Next.Carrier} _ _ _ (Step.horizontalOnInjection index (Term.tensor x y))
      (congr!{HTerm.Carrier Next.Carrier} (#apply{HInclusion.injection}) _ _ (Differential.horizontalOnTensor x y)))
    (trans!{Next.Carrier} _ _ _
      (congr!{HTerm.Carrier Next.Carrier} (#apply{HInclusion.injection}) _ _
        (trans!{HTerm.Carrier} _ _ _
          (congr!{{C.family.Carrier (previous p)} HTerm.Carrier}
            (\fun (v: C.family.Carrier (previous p)) => HTerm.tensor v y) _ _
            (\bysub(C.family.Carrier p, #carrier{Left.cycles}, x)))
          (HTerm.zeroLeft y)))
      (HMaps.zeroPreserved HInclusion.injection));
\definition verticalClosed: \forall (x: Left.Cycle)(y: Right.Cycle) ->
  #apply{Step.vertical} (value x y) = #zero{Next.space} :=
  \fun (x: Left.Cycle)(y: Right.Cycle) => trans!{Next.Carrier}
    _ _ _
    (trans!{Next.Carrier} _ _ _ (Step.verticalOnInjection index (Term.tensor x y))
      (congr!{VTerm.Carrier Next.Carrier} (\fun (v: VTerm.Carrier) => #apply{VInclusion.injection} (#apply{(Sign.map p)} v)) _ _
        (Differential.verticalOnTensor x y)))
    (trans!{Next.Carrier} _ _ _
      (congr!{VTerm.Carrier Next.Carrier} (\fun (v: VTerm.Carrier) => #apply{VInclusion.injection} (#apply{(Sign.map p)} v)) _ _
        (trans!{VTerm.Carrier} _ _ _
          (congr!{{D.family.Carrier (previous q)} VTerm.Carrier}
            (\fun (v: D.family.Carrier (previous q)) => VTerm.tensor x v) _ _
            (\bysub(D.family.Carrier q, #carrier{Right.cycles}, y)))
          (VTerm.zeroRight x)))
      (trans!{Next.Carrier} _ _ _
        (congr!{VTerm.Carrier Next.Carrier} (#apply{VInclusion.injection}) _ _ (Signs.zeroPreserved (Sign.map p)))
        (VMaps.zeroPreserved VInclusion.injection)));
\import Modules.Laws[V := Next.Carrier, space := Next.space] \as NextLaws;
\import algebra.Group[].Of[Carrier := Next.Carrier, group := NextLaws.additive] \as NextGroup;
\definition closed: \forall (x: Left.Cycle)(y: Right.Cycle) ->
  #apply{Total.differential} n (value x y) = #zero{Next.space} :=
  \fun (x: Left.Cycle)(y: Right.Cycle) => trans!{Next.Carrier}
    (#apply{Total.differential} n (value x y)) (#add{Next.space} #zero{Next.space} #zero{Next.space}) #zero{Next.space}
    (congr2!{Next.Carrier Next.Carrier Next.Carrier} (#add{Next.space})
      _ _ _ _ (horizontalClosed x y) (verticalClosed x y))
    (NextGroup.zeroLeft #zero{Next.space});
\definition cycle(x: Left.Cycle)(y: Right.Cycle): H.Cycle := H.cycle (value x y) (closed x y);
\definition classOf(x: Left.Cycle)(y: Right.Cycle): H.Homology := H.classOf (cycle x y);
\import \parent.HomologyEquality[C := Total.complex, z := n] \as ClassEquality;
\definition ambientLeft(x: Left.Cycle): C.family.Carrier p := x;
\definition ambientRight(y: Right.Cycle): D.family.Carrier q := y;
\definition equalClass: \forall (x, y: H.Cycle) -> ClassEquality.ambient x = ClassEquality.ambient y -> H.classOf x = H.classOf y := ClassEquality.equalClass;
\definition rightEqual: \forall (x: Left.Cycle)(y, z: Right.Cycle) -> ambientRight y = ambientRight z -> classOf x y = classOf x z :=
  \fun (x: Left.Cycle)(y, z: Right.Cycle)(same: ambientRight y = ambientRight z) => equalClass (cycle x y) (cycle x z)
    (congr!{{D.family.Carrier q} Current.Carrier} (\fun (a: D.family.Carrier q) => #apply{Inclusion.injection} (Term.tensor x a)) _ _ same);
\definition leftEqual: \forall (x, y: Left.Cycle)(z: Right.Cycle) -> ambientLeft x = ambientLeft y -> classOf x z = classOf y z :=
  \fun (x, y: Left.Cycle)(z: Right.Cycle)(same: ambientLeft x = ambientLeft y) => equalClass (cycle x z) (cycle y z)
    (congr!{{C.family.Carrier p} Current.Carrier} (\fun (a: C.family.Carrier p) => #apply{Inclusion.injection} (Term.tensor a z)) _ _ same);

\import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q,
  left := C.family.space p, right := D.family.space q] \as NativeTensor;
\definition addLeft: \forall (x, y: Left.Cycle)(z: Right.Cycle) ->
  classOf (#add{Left.cycleSpace} x y) z = #add{H.homologySpace} (classOf x z) (classOf y z) :=
  \fun (x, y: Left.Cycle)(z: Right.Cycle) => trans!{H.Homology}
    _ _ _
    (equalClass (cycle (#add{Left.cycleSpace} x y) z) (#add{H.cycleSpace} (cycle x z) (cycle y z))
      (trans!{Current.Carrier} _ _ _
        (congr!{Term.Carrier Current.Carrier} (#apply{Inclusion.injection}) _ _ (#addLeft{NativeTensor.bilinear} x y z))
        (#addition{Inclusion.injection} (Term.tensor x z) (Term.tensor y z))))
    (#addition{H.classLinear} (cycle x z) (cycle y z));
\definition addRight: \forall (x: Left.Cycle)(y, z: Right.Cycle) ->
  classOf x (#add{Right.cycleSpace} y z) = #add{H.homologySpace} (classOf x y) (classOf x z) :=
  \fun (x: Left.Cycle)(y, z: Right.Cycle) => trans!{H.Homology}
    _ _ _
    (equalClass (cycle x (#add{Right.cycleSpace} y z)) (#add{H.cycleSpace} (cycle x y) (cycle x z))
      (trans!{Current.Carrier} _ _ _
        (congr!{Term.Carrier Current.Carrier} (#apply{Inclusion.injection}) _ _ (#addRight{NativeTensor.bilinear} x y z))
        (#addition{Inclusion.injection} (Term.tensor x y) (Term.tensor x z))))
    (#addition{H.classLinear} (cycle x y) (cycle x z));
\definition scaleLeft: \forall (a: R)(x: Left.Cycle)(y: Right.Cycle) ->
  classOf (#smul{Left.cycleSpace} a x) y = #smul{H.homologySpace} a (classOf x y) :=
  \fun (a: R)(x: Left.Cycle)(y: Right.Cycle) => trans!{H.Homology}
    _ _ _
    (equalClass (cycle (#smul{Left.cycleSpace} a x) y) (#smul{H.cycleSpace} a (cycle x y))
      (trans!{Current.Carrier} _ _ _
        (congr!{Term.Carrier Current.Carrier} (#apply{Inclusion.injection}) _ _ (#scaleLeft{NativeTensor.bilinear} a x y))
        (#scalar{Inclusion.injection} a (Term.tensor x y))))
    (#scalar{H.classLinear} a (cycle x y));
\definition scaleRight: \forall (a: R)(x: Left.Cycle)(y: Right.Cycle) ->
  classOf x (#smul{Right.cycleSpace} a y) = #smul{H.homologySpace} a (classOf x y) :=
  \fun (a: R)(x: Left.Cycle)(y: Right.Cycle) => trans!{H.Homology}
    _ _ _
    (equalClass (cycle x (#smul{Right.cycleSpace} a y)) (#smul{H.cycleSpace} a (cycle x y))
      (trans!{Current.Carrier} _ _ _
        (congr!{Term.Carrier Current.Carrier} (#apply{Inclusion.injection}) _ _ (#scaleRight{NativeTensor.bilinear} a x y))
        (#scalar{Inclusion.injection} a (Term.tensor x y))))
    (#scalar{H.classLinear} a (cycle x y));
\import Modules.Tensor[V := Left.Cycle, W := Right.Cycle,
  left := Left.cycleSpace, right := Right.cycleSpace] \as Cycles;
\definition bilinear: Cycles.BilinearLaws[H.Homology, H.homologySpace, classOf] :=
  Cycles.BilinearLaws[H.Homology, H.homologySpace, classOf] {
    addLeft := addLeft, addRight := addRight, scaleLeft := scaleLeft, scaleRight := scaleRight,
  };
\import Cycles.Universal[U := H.Homology, target := H.homologySpace] \as Universal;
\definition map: Modules.Hom[V := Cycles.Carrier, W := H.Homology,
  source := Cycles.space, target := H.homologySpace].Map := Universal.map classOf bilinear;
\definition onTensor: \forall (x: Left.Cycle)(y: Right.Cycle) ->
  #apply{map} (Cycles.tensor x y) = classOf x y := Universal.onTensor classOf bilinear;
