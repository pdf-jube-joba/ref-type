\import \root.TensorChain[].Over[R := R, ring := ring].Sign[V := E.family.Carrier a, space := E.family.space a] \as Sign;
\import \root.TensorChain[].Over[R := R, ring := ring].Sign[V := E.family.Carrier upper, space := E.family.space upper] \as UpperSign;
\import UpperSign.Mapping[W := E.family.Carrier a, target := E.family.space a] \as SignMapping;
\definition signed(k: Degree)(x: E.family.Carrier k): E.family.Carrier k :=
  #apply{\root.TensorChain[].Over[R := R, ring := ring].Sign[V := E.family.Carrier k, space := E.family.space k].map p} x;
\definition t: Degree := previous (next n);
\definition e: previous b = degree t := sym!{Degree} _ _ (Grading.previousComplement (next n) p);
\definition r: degree t = a := congr!{Degree Degree} degree t n (Degrees.previousNext n);
\definition canonical(y: E.family.Carrier b): E.family.Carrier a :=
  Transport.cast E.family.Carrier (previous b) a (trans!{Degree} _ _ _ e r) (#apply{E.differential} b y);
\definition targetFormula: \forall (y: E.family.Carrier b) -> #apply{Target.prior} y = signed a (canonical y) :=
  \fun (y: E.family.Carrier b) => trans!{{E.family.Carrier a}} _ _ _
    (Transport.reindex E.family.Carrier degree t n (Degrees.previousNext n)
      (signed (degree t) (Transport.cast E.family.Carrier (previous b) (degree t) e (#apply{E.differential} b y))))
    (trans!{{E.family.Carrier a}} _ _ _
      (Transport.natural E.family.Carrier E.family.Carrier signed (degree t) a r
        (Transport.cast E.family.Carrier (previous b) (degree t) e (#apply{E.differential} b y)))
      (congr!{{E.family.Carrier a} {E.family.Carrier a}} (signed a) _ _
        (Transport.castComposition E.family.Carrier (previous b) (degree t) a e r (#apply{E.differential} b y))));
\definition sourceFormula: \forall (y: E.family.Carrier b) ->
  #apply{Source.prior} (Transport.cast E.family.Carrier b upper adjacent y) = canonical y :=
  \fun (y: E.family.Carrier b) => trans!{{E.family.Carrier a}} _ _ _
    (congr!{{E.family.Carrier (previous upper)} {E.family.Carrier a}}
      (Transport.cast E.family.Carrier (previous upper) a (Degrees.previousNext a)) _ _
      (sym!{{E.family.Carrier (previous upper)}} _ _
        (Transport.natural E.family.Carrier (\fun (k: Degree) => E.family.Carrier (previous k)) (#apply{E.differential}) b upper adjacent y)))
    (trans!{{E.family.Carrier a}} _ _ _
      (congr!{{E.family.Carrier (previous upper)} {E.family.Carrier a}}
        (Transport.cast E.family.Carrier (previous upper) a (Degrees.previousNext a)) _ _
        (Transport.reindex E.family.Carrier previous b upper adjacent (#apply{E.differential} b y)))
      (Transport.castComposition E.family.Carrier (previous b) (previous upper) a
        (congr!{Degree Degree} previous b upper adjacent) (Degrees.previousNext a) (#apply{E.differential} b y)));
\definition formula: \forall (y: E.family.Carrier b) ->
  #apply{Target.prior} y = #apply{(Sign.map p)} (#apply{Source.prior} (Transport.cast E.family.Carrier b upper adjacent y)) :=
  \fun (y: E.family.Carrier b) => trans!{{E.family.Carrier a}} _ _ _ (targetFormula y)
    (congr!{{E.family.Carrier a} {E.family.Carrier a}} (#apply{(Sign.map p)}) _ _ (sym!{{E.family.Carrier a}} _ _ (sourceFormula y)));
\definition toRow(y: E.family.Carrier upper): E.family.Carrier b :=
  Transport.cast E.family.Carrier upper b (sym!{Degree} _ _ adjacent) (#apply{(UpperSign.map p)} y);
\definition toOriginal(y: E.family.Carrier b): E.family.Carrier upper :=
  #apply{(UpperSign.map p)} (Transport.cast E.family.Carrier b upper adjacent y);
\definition forward: \forall (y: E.family.Carrier upper) -> #apply{Target.prior} (toRow y) = #apply{Source.prior} y :=
  \fun (y: E.family.Carrier upper) => trans!{{E.family.Carrier a}} _ _ _ (formula (toRow y))
    (trans!{{E.family.Carrier a}} _ _ _
      (congr!{{E.family.Carrier upper} {E.family.Carrier a}}
        (\fun (x: E.family.Carrier upper) => #apply{(Sign.map p)} (#apply{Source.prior} x)) _ _
        (Transport.castInverse E.family.Carrier upper b (sym!{Degree} _ _ adjacent) (#apply{(UpperSign.map p)} y)))
      (trans!{{E.family.Carrier a}} _ _ _
        (congr!{{E.family.Carrier a} {E.family.Carrier a}} (#apply{(Sign.map p)}) _ _ (SignMapping.naturality Source.prior p y))
        (Sign.involutive p (#apply{Source.prior} y))));
\definition backward: \forall (y: E.family.Carrier b) -> #apply{Source.prior} (toOriginal y) = #apply{Target.prior} y :=
  \fun (y: E.family.Carrier b) => trans!{{E.family.Carrier a}} _ _ _
    (SignMapping.naturality Source.prior p (Transport.cast E.family.Carrier b upper adjacent y))
    (sym!{{E.family.Carrier a}} _ _ (formula y));
