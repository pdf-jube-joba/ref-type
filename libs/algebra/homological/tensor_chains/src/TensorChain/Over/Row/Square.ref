\import \parent.At[n := n] \as Current;
\import \parent.At[n := previous n] \as After;
\definition unsignedZero: \forall (x: family.Carrier n) -> #apply{After.unsigned} (#apply{Current.unsigned} x) = #zero{(family.space (previous (previous n)))} :=
  \fun (x: family.Carrier n) => trans!{{family.Carrier (previous (previous n))}} _ _ _
    (congr!{{E.family.Carrier (previous (degree (previous n)))} {family.Carrier (previous (previous n))}}
      (#apply{After.transport}) _ _
      (sym!{{E.family.Carrier (previous (degree (previous n)))}} _ _
        (Transport.natural E.family.Carrier (\fun (k: Degree) => E.family.Carrier (previous k)) (#apply{E.differential})
          (previous (degree n)) (degree (previous n)) Current.equality (#apply{E.differential} (degree n) x))))
    (trans!{{family.Carrier (previous (previous n))}} _ _ _
      (congr!{{E.family.Carrier (previous (previous (degree n)))} {family.Carrier (previous (previous n))}}
        (\fun (v: E.family.Carrier (previous (previous (degree n)))) => #apply{After.transport}
          (Transport.cast (\fun (k: Degree) => E.family.Carrier (previous k))
            (previous (degree n)) (degree (previous n)) Current.equality v)) _ _ (#squareZero{E.laws} (degree n) x))
      (trans!{{family.Carrier (previous (previous n))}} _ _ _
        (congr!{{E.family.Carrier (previous (degree (previous n)))} {family.Carrier (previous (previous n))}}
          (#apply{After.transport}) _ _
          (Transport.pointNatural (\fun (k: Degree) => E.family.Carrier (previous k))
            (\fun (k: Degree) => #zero{(E.family.space (previous k))})
            (previous (degree n)) (degree (previous n)) Current.equality))
        (Modules.Hom[V := E.family.Carrier (previous (degree (previous n))), W := family.Carrier (previous (previous n)),
          source := E.family.space (previous (degree (previous n))), target := family.space (previous (previous n))].zeroPreserved After.transport)));
\import \parent.\parent.Sign[V := family.Carrier (previous n), space := family.space (previous n)] \as MiddleSign;
\import \parent.\parent.Sign[V := family.Carrier (previous (previous n)), space := family.space (previous (previous n))] \as TargetSign;
\import MiddleSign.Mapping[W := family.Carrier (previous (previous n)), target := family.space (previous (previous n))] \as Natural;
\definition zero: \forall (x: family.Carrier n) -> #apply{After.differential} (#apply{Current.differential} x) = #zero{(family.space (previous (previous n)))} :=
  \fun (x: family.Carrier n) => trans!{{family.Carrier (previous (previous n))}} _ _ _
    (congr!{{family.Carrier (previous (previous n))} {family.Carrier (previous (previous n))}} (#apply{(TargetSign.map p)}) _ _
      (Natural.naturality After.unsigned p (#apply{Current.unsigned} x)))
    (trans!{{family.Carrier (previous (previous n))}} _ _ _
      (TargetSign.involutive p (#apply{After.unsigned} (#apply{Current.unsigned} x))) (unsignedZero x));
