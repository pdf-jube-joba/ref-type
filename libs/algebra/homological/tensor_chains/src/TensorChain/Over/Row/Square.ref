\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[n := n] \as Current;
\import \parent.At[n := previous n] \as After;
\definition unsignedZero: \forall (x: family.Carrier n) -> After.unsigned.apply (Current.unsigned.apply x) = (family.space (previous (previous n))).zero :=
  \fun (x: family.Carrier n) => eq_reason_in!{{family.Carrier (previous (previous n))} _
    "=" _ "by" { congr!{{E.family.Carrier (previous (degree (previous n)))} {family.Carrier (previous (previous n))}}
      (After.transport.apply) _ _
      (sym!{{E.family.Carrier (previous (degree (previous n)))}} _ _
        (Transport.natural E.family.Carrier (\fun (k: Degree) => E.family.Carrier (previous k)) (E.differential.apply)
          (previous (degree n)) (degree (previous n)) Current.equality (E.differential.apply (degree n) x))) }
    "=" _ "by" { congr!{{E.family.Carrier (previous (previous (degree n)))} {family.Carrier (previous (previous n))}}
        (\fun (v: E.family.Carrier (previous (previous (degree n)))) => After.transport.apply
          (Transport.cast (\fun (k: Degree) => E.family.Carrier (previous k))
            (previous (degree n)) (degree (previous n)) Current.equality v)) _ _ (E.laws.squareZero (degree n) x) }
    "=" _ "by" { congr!{{E.family.Carrier (previous (degree (previous n)))} {family.Carrier (previous (previous n))}}
          (After.transport.apply) _ _
          (Transport.pointNatural (\fun (k: Degree) => E.family.Carrier (previous k))
            (\fun (k: Degree) => (E.family.space (previous k)).zero)
            (previous (degree n)) (degree (previous n)) Current.equality) }
    "=" _ "by" { Modules.Hom[V := E.family.Carrier (previous (degree (previous n))), W := family.Carrier (previous (previous n)),
          source := E.family.space (previous (degree (previous n))), target := family.space (previous (previous n))].zeroPreserved After.transport }
  };
\import \parent.\parent.Sign[V := family.Carrier (previous n), space := family.space (previous n)] \as MiddleSign;
\import \parent.\parent.Sign[V := family.Carrier (previous (previous n)), space := family.space (previous (previous n))] \as TargetSign;
\import MiddleSign.Mapping[W := family.Carrier (previous (previous n)), target := family.space (previous (previous n))] \as Natural;
\definition zero: \forall (x: family.Carrier n) -> After.differential.apply (Current.differential.apply x) = (family.space (previous (previous n))).zero :=
  \fun (x: family.Carrier n) => eq_reason_in!{{family.Carrier (previous (previous n))} _
    "=" _ "by" { congr!{{family.Carrier (previous (previous n))} {family.Carrier (previous (previous n))}} ((TargetSign.map p).apply) _ _
      (Natural.naturality After.unsigned p (Current.unsigned.apply x)) }
    "=" _ "by" { TargetSign.involutive p (After.unsigned.apply (Current.unsigned.apply x)) }
    "=" _ "by" { unsignedZero x }
  };
