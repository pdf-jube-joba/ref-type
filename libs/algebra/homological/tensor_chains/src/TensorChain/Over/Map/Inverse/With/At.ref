\import \root.TensorChain[].Over[R := R, ring := ring].HomologyEquality[C := Source.complex, z := n] \as SE;
\import \root.TensorChain[].Over[R := R, ring := ring].HomologyEquality[C := Target.complex, z := n] \as TE;
\import \parent.Term[n := n] \as Term;
\import Chains.At[C := Source.complex, z := n] \as SH;
\import Chains.At[C := Target.complex, z := n] \as TH;
\import Chains.Map[C := Source.complex, D := Target.complex].At[k := n] \as Forward;
\import Chains.Map[C := Target.complex, D := Source.complex].At[k := n] \as Backward;
\import Modules.Isomorphism[V := SH.Homology, W := TH.Homology, source := SH.homologySpace, target := TH.homologySpace] \as Iso;
\definition leftInverse: \forall (x: SH.Homology) -> #apply{(Backward.induced G.map)} (#apply{(Forward.induced F.map)} x) = x :=
  SH.classInduction (\fun (x: SH.Homology) => #apply{(Backward.induced G.map)} (#apply{(Forward.induced F.map)} x) = x)
    (\fun (x: SH.Cycle) => trans!{SH.Homology} _ _ _
      (congr!{TH.Homology SH.Homology} (#apply{(Backward.induced G.map)}) _ _ (Forward.onClass F.map x))
      (trans!{SH.Homology} _ _ _ (Backward.onClass G.map (#apply{(Forward.cyclesMap F.map)} x))
        (SE.equalClass (#apply{(Backward.cyclesMap G.map)} (#apply{(Forward.cyclesMap F.map)} x)) x (Term.leftInverse x))));
\definition rightInverse: \forall (y: TH.Homology) -> #apply{(Forward.induced F.map)} (#apply{(Backward.induced G.map)} y) = y :=
  TH.classInduction (\fun (y: TH.Homology) => #apply{(Forward.induced F.map)} (#apply{(Backward.induced G.map)} y) = y)
    (\fun (y: TH.Cycle) => trans!{TH.Homology} _ _ _
      (congr!{SH.Homology TH.Homology} (#apply{(Forward.induced F.map)}) _ _ (Backward.onClass G.map y))
      (trans!{TH.Homology} _ _ _ (Forward.onClass F.map (#apply{(Backward.cyclesMap G.map)} y))
        (TE.equalClass (#apply{(Forward.cyclesMap F.map)} (#apply{(Backward.cyclesMap G.map)} y)) y (Term.rightInverse y))));
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.induced F.map, backward := Backward.induced G.map, leftInverse := leftInverse, rightInverse := rightInverse,
};
