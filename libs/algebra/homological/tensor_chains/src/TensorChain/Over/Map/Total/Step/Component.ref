\use std.Logic[].Equality[].eq_reason_in;
\definition p: Degree := i.first;
\definition q: Degree := i.second;
\definition hi: Source.Index (previous n) := Source.upHorizontal n i;
\definition vi: Source.Index (previous n) := Source.upVertical n i;
\definition horizontal: \forall (x: C.family.Carrier p q) ->
  TS.horizontal.apply (Current.map.apply ((SD.Component[i := i].injection).apply x)) =
    Next.map.apply (SS.horizontal.apply ((SD.Component[i := i].injection).apply x)) :=
  \fun (x: C.family.Carrier p q) => eq_reason_in!{TN.Carrier _
    "=" _ "by" { congr!{TD.Carrier TN.Carrier} (TS.horizontal.apply) _ _ (Current.onInjection i x) }
    "=" _ "by" { TS.horizontalOnInjection i ((f p q).apply x) }
    "=" _ "by" { congr!{{D.family.Carrier (previous p) q} TN.Carrier} ((TN.Component[i := hi].injection).apply) _ _ ((laws f).horizontal p q x) }
    "=" _ "by" { sym!{TN.Carrier} _ _ (Next.onInjection hi ((C.differential.horizontal p q).apply x)) }
    "=" _ "by" { congr!{SN.Carrier TN.Carrier} (Next.map.apply) _ _ (sym!{SN.Carrier} _ _ (SS.horizontalOnInjection i x)) }
  };
\import \root.TensorChain[].Over[R := R, ring := ring].Sign[V := C.family.Carrier p (previous q), space := C.family.space p (previous q)] \as Sign;
\import \root.TensorChain[].Over[R := R, ring := ring].Sign[V := D.family.Carrier p (previous q), space := D.family.space p (previous q)] \as TargetSign;
\import Sign.Mapping[W := D.family.Carrier p (previous q), target := D.family.space p (previous q)] \as SignMapping;
\definition vertical: \forall (x: C.family.Carrier p q) ->
  TS.vertical.apply (Current.map.apply ((SD.Component[i := i].injection).apply x)) =
    Next.map.apply (SS.vertical.apply ((SD.Component[i := i].injection).apply x)) :=
  \fun (x: C.family.Carrier p q) => eq_reason_in!{TN.Carrier _
    "=" _ "by" { congr!{TD.Carrier TN.Carrier} (TS.vertical.apply) _ _ (Current.onInjection i x) }
    "=" _ "by" { TS.verticalOnInjection i ((f p q).apply x) }
    "=" _ "by" { congr!{{D.family.Carrier p (previous q)} TN.Carrier}
          (\fun (z: D.family.Carrier p (previous q)) => (TN.Component[i := vi].injection).apply ((TargetSign.map p).apply z)) _ _ ((laws f).vertical p q x) }
    "=" _ "by" { congr!{{D.family.Carrier p (previous q)} TN.Carrier} ((TN.Component[i := vi].injection).apply) _ _
            (sym!{{D.family.Carrier p (previous q)}} _ _ (SignMapping.naturality (f p (previous q)) p ((C.differential.vertical p q).apply x))) }
    "=" _ "by" { sym!{TN.Carrier} _ _ (Next.onInjection vi ((Sign.map p).apply ((C.differential.vertical p q).apply x))) }
    "=" _ "by" { congr!{SN.Carrier TN.Carrier} (Next.map.apply) _ _ (sym!{SN.Carrier} _ _ (SS.verticalOnInjection i x)) }
  };
