\import \parent.\parent.Total[C := C] \as Source;
\import \parent.\parent.Total[C := D] \as Target;
\module Term(n: Degree) {
  \import Source.Term[n := n] \as SD;
  \import Target.Term[n := n] \as TD;
  \import Modules.DirectSum[Index := Source.Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
  \module Component(i: Source.Index n) {
    \import Modules.Hom[V := D.family.Carrier #first{i} #second{i}, W := TD.Carrier,
      source := D.family.space #first{i} #second{i}, target := TD.space].Composition[
      U := C.family.Carrier #first{i} #second{i}, domain := C.family.space #first{i} #second{i}] \as Compose;
    \definition map: Universal.At[i := i].Map := Compose.compose (TD.Component[i := i].injection) (f #first{i} #second{i});
  }
  \definition components: Universal.Components := \fun (i: Source.Index n) => Component[i := i].map;
  \definition map: Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map := Universal.extension components;
  \definition onInjection: \forall (i: Source.Index n)(x: C.family.Carrier #first{i} #second{i}) ->
    #apply{map} (#apply{(SD.Component[i := i].injection)} x) =
      #apply{(TD.Component[i := i].injection)} (#apply{(f #first{i} #second{i})} x) := Universal.onInjection components;
}
\module Step(n: Degree);
\import Chains.Map[C := Source.complex, D := Target.complex] \as Native;
\definition map: Native.Map := Native.Map {
  apply := \fun (n: Degree) => #apply{(Term[n := n].map)},
  addition := \fun (n: Degree) => #addition{(Term[n := n].map)},
  scalar := \fun (n: Degree) => #scalar{(Term[n := n].map)},
  commutes := \fun (n: Degree) => Step[n := n].commutes,
};
