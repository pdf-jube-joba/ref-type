\definition Data: \Set := \forall (p, q: Degree) ->
  Modules.Hom[V := D.family.Carrier p q, W := C.family.Carrier p q, source := D.family.space p q, target := C.family.space p q].Map;
\structure Laws[data: Data]: \Prop := {
  left: \forall (p, q: Degree)(x: C.family.Carrier p q) -> (data p q).apply ((f p q).apply x) = x,
  right: \forall (p, q: Degree)(x: D.family.Carrier p q) -> (f p q).apply ((data p q).apply x) = x,
};
\definition Inverse: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(g: Inverse);
