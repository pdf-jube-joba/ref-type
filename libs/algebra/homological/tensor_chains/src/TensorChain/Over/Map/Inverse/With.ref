\use std.Logic[].Equality[].eq_reason_in;
\definition inverseLaws: Laws[g] := \bysub(Data, { data: Data \where Laws[data] }, g);
\import \parent.\parent.\parent.Map[C := D, D := C] \as Reverse;
\import \root.TensorChain[].Over[R := R, ring := ring].Map[C := C, D := D] \as Original;
\definition forwardLaws: Original.Laws[f] := Original.laws f;
\module Component(p, q: Degree) {
  \definition horizontal: \forall (y: D.family.Carrier p q) ->
    (C.differential.horizontal p q).apply ((g p q).apply y) =
      (g (previous p) q).apply ((D.differential.horizontal p q).apply y) :=
    \block {
      \fun (y: D.family.Carrier p q) \then
      \let x: C.family.Carrier p q := (g p q).apply y \then
      \let z: C.family.Carrier (previous p) q := (C.differential.horizontal p q).apply x \then
      \return eq_reason_in!{{C.family.Carrier (previous p) q} _
        "=" _ "by" { sym!{{C.family.Carrier (previous p) q}} ((g (previous p) q).apply ((f (previous p) q).apply z)) z (inverseLaws.left (previous p) q z) }
        "=" _ "by" { congr!{{D.family.Carrier (previous p) q} {C.family.Carrier (previous p) q}}
            ((g (previous p) q).apply) ((f (previous p) q).apply z) ((D.differential.horizontal p q).apply ((f p q).apply x))
            (sym!{{D.family.Carrier (previous p) q}} ((D.differential.horizontal p q).apply ((f p q).apply x)) ((f (previous p) q).apply z) (forwardLaws.horizontal p q x)) }
        "=" _ "by" { congr!{{D.family.Carrier p q} {C.family.Carrier (previous p) q}}
            (\fun (u: D.family.Carrier p q) => (g (previous p) q).apply ((D.differential.horizontal p q).apply u))
            ((f p q).apply x) y (inverseLaws.right p q y) }
      }
    };
  \definition vertical: \forall (y: D.family.Carrier p q) ->
    (C.differential.vertical p q).apply ((g p q).apply y) =
      (g p (previous q)).apply ((D.differential.vertical p q).apply y) :=
    \block {
      \fun (y: D.family.Carrier p q) \then
      \let x: C.family.Carrier p q := (g p q).apply y \then
      \let z: C.family.Carrier p (previous q) := (C.differential.vertical p q).apply x \then
      \return eq_reason_in!{{C.family.Carrier p (previous q)} _
        "=" _ "by" { sym!{{C.family.Carrier p (previous q)}} ((g p (previous q)).apply ((f p (previous q)).apply z)) z (inverseLaws.left p (previous q) z) }
        "=" _ "by" { congr!{{D.family.Carrier p (previous q)} {C.family.Carrier p (previous q)}}
            ((g p (previous q)).apply) ((f p (previous q)).apply z) ((D.differential.vertical p q).apply ((f p q).apply x))
            (sym!{{D.family.Carrier p (previous q)}} ((D.differential.vertical p q).apply ((f p q).apply x)) ((f p (previous q)).apply z) (forwardLaws.vertical p q x)) }
        "=" _ "by" { congr!{{D.family.Carrier p q} {C.family.Carrier p (previous q)}}
            (\fun (u: D.family.Carrier p q) => (g p (previous q)).apply ((D.differential.vertical p q).apply u))
            ((f p q).apply x) y (inverseLaws.right p q y) }
      }
    };
}
\definition backward: Reverse.Map := \into[Reverse.Data](g, { data: Reverse.Data \where Reverse.Laws[data] }) \by {
  Reverse.Laws[g] {
    horizontal := \fun (p, q: Degree) => Component[p := p, q := q].horizontal,
    vertical := \fun (p, q: Degree) => Component[p := p, q := q].vertical,
  }
};
\import \parent.\parent.Total[f := f] \as F;
\import Reverse.Total[f := backward] \as G;
\import \parent.\parent.\parent.Total[C := C] \as Source;
\import \parent.\parent.\parent.Total[C := D] \as Target;
\module Term(n: Degree);
\module At(n: Degree);
