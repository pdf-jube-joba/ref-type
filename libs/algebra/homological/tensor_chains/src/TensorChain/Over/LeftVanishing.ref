\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\import std.Logic[].Proposition[] \as Existential;
\import std.Arithmetic[].Int[] \as Integers;
\import \parent.Tensor[C := C, D := D] \as Product;
\import \parent.Total[C := Product.complex] \as Total;
\import Chains.At[C := D, z := q] \as Right;
\definition index(n, p: Degree)(closed: Grading.add p q = n): Grading.Index n :=
  \into[Grading.Pair](Grading.Pair { first := p, second := q },
    { i: Grading.Pair \where Grading.add #first{i} #second{i} = n }) \by { closed };
\definition sourceIndex(n, p: Degree)(closed: Grading.add p q = n): Grading.Index (next n) :=
  \into[Grading.Pair](Grading.Pair { first := next p, second := q },
    { i: Grading.Pair \where Grading.add #first{i} #second{i} = next n }) \by {
      trans!{Degree} _ _ _ (Grading.nextLeft p q) (congr!{Degree Degree} next _ _ closed)
    };
\module At(n, p: Degree, closed: Grading.add p q = n) {
  \import Chains.At[C := C, z := p] \as Left;
  \import Chains.At[C := Total.complex, z := n] \as H;
  \import \parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n p closed] \as Exterior;
  \import \parent.\parent.LeftBoundary[C := C, D := D, n := next n, i := sourceIndex n p closed] \as Boundary;
  \definition Vanishes: \Prop := \forall (x: Right.Cycle)(y: Left.Cycle) ->
    \In[C.family.Carrier p] (#carrier{Left.boundaries}) y -> Exterior.classOf y x = H.zeroClass;
}
\module PositivePositive(nn: Nat.Nat^, qq: Nat.Nat^) {
  \definition n: Degree := Integers.Int^::ofNat nn;
  \definition p: Degree := Integers.Int^::ofNat qq;
  \module With(closed: Grading.add p q = n) {
    \import \parent.\parent.At[n := n, p := p, closed := closed] \as Case;
    \import Chains.At[C := C, z := p] \as Left;
    \import Chains.At[C := Total.complex, z := n] \as H;
    \import \parent.\parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n p closed] \as Exterior;
    \import \parent.\parent.\parent.LeftBoundary[C := C, D := D, n := next n, i := sourceIndex n p closed] \as Boundary;
    \definition priorValue(a: C.family.Carrier (next p)): #apply{Left.prior} a = #apply{C.differential} (next p) a :=
      Transport.castRefl C.family.Carrier p (#apply{C.differential} (next p) a);
    \definition vanishes: Case.Vanishes := \block {
      \fun (x: Right.Cycle)(y: Left.Cycle)(boundary: \In[C.family.Carrier p] (#carrier{Left.boundaries}) y) \then
      \takefrom a: \Cast[C.family.Carrier (next p)] ({ a: C.family.Carrier (next p) \where #apply{Left.prior} a = y }) \by boundary \then
      \let equal: #apply{Left.prior} a = y := \bysub(C.family.Carrier (next p),
        { a: C.family.Carrier (next p) \where #apply{Left.prior} a = y }, a) \then
      \return trans!{H.Homology} _ _ _
        (Exterior.leftEqual y (Boundary.cycle a) x (trans!{{C.family.Carrier p}} y (#apply{Left.prior} a) (#apply{C.differential} (next p) a) (sym!{{C.family.Carrier p}} (#apply{Left.prior} a) y equal) (priorValue a)))
        (Boundary.vanishes a x)
    };
  }
}
