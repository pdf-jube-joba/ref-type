\definition vanishes: \forall (n, p: Degree)(closed: Grading.add p q = n) -> At[n := n, p := p, closed := closed].Vanishes :=
  \induction (n: Degree) \return \forall (p: Degree)(closed: Grading.add p q = n) -> At[n := n, p := p, closed := closed].Vanishes \with {
    | ofNat: \fun (nn: Nat.Nat^) =>     \induction (p: Degree) \return \forall (closed: Grading.add p q = Integers.Int^::ofNat nn) -> At[n := Integers.Int^::ofNat nn, p := p, closed := closed].Vanishes \with {
      | ofNat: \fun (qq: Nat.Nat^)(closed: _) => PositivePositive[nn := nn, qq := qq].With[closed := closed].vanishes
      | negSucc: \induction (qq: Nat.Nat^) \return \forall (closed: Grading.add (Integers.Int^::negSucc qq) q = Integers.Int^::ofNat nn) -> At[n := Integers.Int^::ofNat nn, p := Integers.Int^::negSucc qq, closed := closed].Vanishes \with {
        | zero: \fun (closed: _) => PositiveMinusOne[nn := nn].With[closed := closed].vanishes
        | succ: \fun (qq: Nat.Nat^)(unused: _)(closed: _) => PositiveNegative[nn := nn, qq := qq].With[closed := closed].vanishes
      }
    }
    | negSucc: \induction (nn: Nat.Nat^) \return \forall (p: Degree)(closed: Grading.add p q = Integers.Int^::negSucc nn) -> At[n := Integers.Int^::negSucc nn, p := p, closed := closed].Vanishes \with {
      | zero:     \induction (p: Degree) \return \forall (closed: Grading.add p q = Integers.Int^::negSucc Nat.Nat^::zero) -> At[n := Integers.Int^::negSucc Nat.Nat^::zero, p := p, closed := closed].Vanishes \with {
      | ofNat: \fun (qq: Nat.Nat^)(closed: _) => MinusOnePositive[qq := qq].With[closed := closed].vanishes
      | negSucc: \induction (qq: Nat.Nat^) \return \forall (closed: Grading.add (Integers.Int^::negSucc qq) q = Integers.Int^::negSucc Nat.Nat^::zero) -> At[n := Integers.Int^::negSucc Nat.Nat^::zero, p := Integers.Int^::negSucc qq, closed := closed].Vanishes \with {
        | zero: \fun (closed: _) => MinusOneMinusOne[].With[closed := closed].vanishes
        | succ: \fun (qq: Nat.Nat^)(unused: _)(closed: _) => MinusOneNegative[qq := qq].With[closed := closed].vanishes
      }
    }
      | succ: \fun (nn: Nat.Nat^)(unused: _) =>     \induction (p: Degree) \return \forall (closed: Grading.add p q = Integers.Int^::negSucc (Nat.Nat^::succ nn)) -> At[n := Integers.Int^::negSucc (Nat.Nat^::succ nn), p := p, closed := closed].Vanishes \with {
      | ofNat: \fun (qq: Nat.Nat^)(closed: _) => NegativePositive[nn := nn, qq := qq].With[closed := closed].vanishes
      | negSucc: \induction (qq: Nat.Nat^) \return \forall (closed: Grading.add (Integers.Int^::negSucc qq) q = Integers.Int^::negSucc (Nat.Nat^::succ nn)) -> At[n := Integers.Int^::negSucc (Nat.Nat^::succ nn), p := Integers.Int^::negSucc qq, closed := closed].Vanishes \with {
        | zero: \fun (closed: _) => NegativeMinusOne[nn := nn].With[closed := closed].vanishes
        | succ: \fun (qq: Nat.Nat^)(unused: _)(closed: _) => NegativeNegative[nn := nn, qq := qq].With[closed := closed].vanishes
      }
    }
    }
  };
