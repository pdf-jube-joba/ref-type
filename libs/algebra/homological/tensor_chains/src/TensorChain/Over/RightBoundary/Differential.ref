\definition horizontal: \forall (x: Left.Cycle)(a: D.family.Carrier q) ->
  Step.horizontal.apply (lift x a) = Current.space.zero :=
  \fun (x: Left.Cycle)(a: D.family.Carrier q) => trans!{Current.Carrier}
    (Step.horizontal.apply (lift x a)) (HInclusion.injection.apply HTerm.space.zero) Current.space.zero
    (trans!{Current.Carrier} _ _ _ (Step.horizontalOnInjection index ((Sign.map p).apply (Term.tensor x a)))
      (congr!{HTerm.Carrier Current.Carrier} (HInclusion.injection.apply) _ _
        (trans!{HTerm.Carrier} _ _ _ (HorizontalSign.naturality Differential.horizontal p (Term.tensor x a))
          (trans!{HTerm.Carrier} _ _ _
            (congr!{HTerm.Carrier HTerm.Carrier} ((HSign.map p).apply) _ _
              (trans!{HTerm.Carrier} _ _ _ (Differential.horizontalOnTensor x a)
                (trans!{HTerm.Carrier} _ _ _
                  (congr!{{C.family.Carrier (previous p)} HTerm.Carrier}
                    (\fun (v: C.family.Carrier (previous p)) => HTerm.tensor v a) _ _
                    (\bysub(C.family.Carrier p, Left.cycles.carrier, x)))
                  (HTerm.zeroLeft a))))
            (HSigns.zeroPreserved (HSign.map p))))))
    (HMaps.zeroPreserved HInclusion.injection);
\definition vertical: \forall (x: Left.Cycle)(a: D.family.Carrier q) ->
  Step.vertical.apply (lift x a) = VInclusion.injection.apply (VTerm.tensor x (D.differential.apply q a)) :=
  \fun (x: Left.Cycle)(a: D.family.Carrier q) => trans!{Current.Carrier} _ _ _
    (Step.verticalOnInjection index ((Sign.map p).apply (Term.tensor x a)))
    (congr!{VTerm.Carrier Current.Carrier} (VInclusion.injection.apply) _ _
      (trans!{VTerm.Carrier} _ _ _
        (congr!{VTerm.Carrier VTerm.Carrier} ((VSign.map p).apply) _ _
          (VerticalSign.naturality Differential.vertical p (Term.tensor x a)))
        (trans!{VTerm.Carrier} _ _ _ (VSign.involutive p (Differential.vertical.apply (Term.tensor x a)))
          (Differential.verticalOnTensor x a))));
\definition value: \forall (x: Left.Cycle)(a: D.family.Carrier q) ->
  Total.differential.apply n (lift x a) = VInclusion.injection.apply (VTerm.tensor x (D.differential.apply q a)) :=
  \fun (x: Left.Cycle)(a: D.family.Carrier q) => trans!{Current.Carrier}
    _ _ _
    (congr2!{Current.Carrier Current.Carrier Current.Carrier} (Current.space.add)
      _ _ _ _
      (horizontal x a) (vertical x a))
    (Group.zeroLeft (VInclusion.injection.apply (VTerm.tensor x (D.differential.apply q a))));
