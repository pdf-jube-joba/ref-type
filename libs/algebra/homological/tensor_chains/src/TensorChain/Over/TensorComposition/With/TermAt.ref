\import Source.Term[n := n] \as SD;
\import Middle.Term[n := n] \as MD;
\import Target.Term[n := n] \as TD;
\import FT.Term[n := n] \as FD;
\import GT.Term[n := n] \as GD;
\import HT.Term[n := n] \as HD;
\module Component(p, q: Degree) {
  \import Modules.Tensor[V := A.family.Carrier p, W := E.family.Carrier q, left := A.family.space p, right := E.family.space q] \as ST;
  \import Modules.Tensor[V := B.family.Carrier p, W := E.family.Carrier q, left := B.family.space p, right := E.family.space q] \as MT;
  \import Modules.Tensor[V := C.family.Carrier p, W := E.family.Carrier q, left := C.family.space p, right := E.family.space q] \as TT;
  \import F.Term[p := p, q := q] \as FM;
  \import G.Term[p := p, q := q] \as GM;
  \import H.Term[p := p, q := q] \as HM;
  \import Modules.Hom[V := MT.Carrier, W := TT.Carrier, source := MT.space, target := TT.space].Composition[U := ST.Carrier, domain := ST.space] \as Compose;
  \import ST.Universal[U := TT.Carrier, target := TT.space] \as Universal;
  \definition equality: Compose.compose GM.map FM.map = HM.map := Universal.ext (Compose.compose GM.map FM.map) HM.map
    (\fun (x: A.family.Carrier p)(y: E.family.Carrier q) => trans!{TT.Carrier} _ _ _
      (congr!{MT.Carrier TT.Carrier} (GM.map.apply) _ _ (FM.onTensor x y))
      (trans!{TT.Carrier} _ _ _ (GM.onTensor (f.apply p x) y) (sym!{TT.Carrier} _ _ (HM.onTensor x y))));
  \definition point: \forall (x: ST.Carrier) -> GM.map.apply (FM.map.apply x) = HM.map.apply x :=
    \fun (x: ST.Carrier) => congr!{{Modules.Hom[V := ST.Carrier, W := TT.Carrier, source := ST.space, target := TT.space].Map} TT.Carrier}
      (\fun (h: Modules.Hom[V := ST.Carrier, W := TT.Carrier, source := ST.space, target := TT.space].Map) => h.apply x) _ _ equality;
}
\import Modules.Hom[V := MD.Carrier, W := TD.Carrier, source := MD.space, target := TD.space].Composition[U := SD.Carrier, domain := SD.space] \as Compose;
\import Modules.DirectSum[Index := Grading.Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\definition equality: Compose.compose GD.map FD.map = HD.map := Universal.ext (Compose.compose GD.map FD.map) HD.map
  (\fun (i: Grading.Index n)(x: SourceTensor.family.Carrier i.first i.second) => trans!{TD.Carrier}
    _ _ _
    (congr!{MD.Carrier TD.Carrier} (GD.map.apply)
      _ _ (FD.onInjection i x))
    (trans!{TD.Carrier}
      _ _ _
      (GD.onInjection i ((F.data i.first i.second).apply x))
      (trans!{TD.Carrier}
        _ _ _
        (congr!{{TargetTensor.family.Carrier i.first i.second} TD.Carrier} ((TD.Component[i := i].injection).apply)
          _ _ (Component[p := i.first, q := i.second].point x))
        (sym!{TD.Carrier}
          _ _ (HD.onInjection i x)))));
\definition point: \forall (x: SD.Carrier) -> GD.map.apply (FD.map.apply x) = HD.map.apply x :=
  \fun (x: SD.Carrier) => congr!{{Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map} TD.Carrier}
    (\fun (h: Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map) => h.apply x) _ _ equality;
