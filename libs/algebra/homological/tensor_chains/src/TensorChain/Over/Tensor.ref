\module Term(p, q: Degree) {
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q] \as Tensor;
  \definition Carrier: \Set := Tensor.Carrier;
  \definition space: Modules.Space Carrier := Tensor.space;
  \definition tensor: C.family.Carrier p -> D.family.Carrier q -> Carrier := Tensor.tensor;
  \definition zeroLeft: \forall (y: D.family.Carrier q) -> tensor (C.family.space p).zero y = space.zero := Tensor.tensorZeroLeft;
  \definition zeroRight: \forall (x: C.family.Carrier p) -> tensor x (D.family.space q).zero = space.zero := Tensor.tensorZeroRight;
}
\module At(p, q: Degree);
\definition family: Family := Family {
  Carrier := \fun (p, q: Degree) => Term[p := p, q := q].Carrier,
  space := \fun (p, q: Degree) => Term[p := p, q := q].space,
};
\definition differential: DifferentialData[family] := DifferentialData[family] {
  horizontal := \fun (p, q: Degree) => At[p := p, q := q].horizontal,
  vertical := \fun (p, q: Degree) => At[p := p, q := q].vertical,
};
\module Square(p, q: Degree);
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    horizontalZero := \fun (p, q: Degree) => Square[p := p, q := q].horizontalZero,
    verticalZero := \fun (p, q: Degree) => Square[p := p, q := q].verticalZero,
    commute := \fun (p, q: Degree) => Square[p := p, q := q].commute,
  },
};

\module TotalTerm(p, q: Degree);
