\import \parent.Tensor[C := C, D := D] \as Tensor;
\import \parent.Total[C := Tensor.complex] \as Total;
\import \parent.TensorMapping[C := C, D := C, E := D, F := D] \as Mapping;
\definition c: Chains.Map[C := C, D := C].Map := Chains.End[C := C].identity;
\definition d: Chains.Map[C := D, D := D].Map := Chains.End[C := D].identity;
\import Mapping.With[f := c, g := d] \as Induced;
\import \parent.Map[C := Tensor.complex, D := Tensor.complex].Total[f := Induced.map] \as InducedTotal;
\module TermAt(n: Degree);
\import Chains.Map[C := Total.complex, D := Total.complex] \as Maps;
\definition map: Maps.Map := Induced.total;
\definition equality: Induced.total = Chains.End[C := Total.complex].identity := Maps.ext Induced.total (Chains.End[C := Total.complex].identity)
  (\fun (n: Degree) => TermAt[n := n].point);
