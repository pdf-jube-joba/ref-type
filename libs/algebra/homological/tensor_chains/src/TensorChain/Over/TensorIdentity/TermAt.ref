\import Total.Term[n := n] \as TD;
\import InducedTotal.Term[n := n] \as ID;
\module Component(p, q: Degree) {
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q] \as T;
  \import Induced.Term[p := p, q := q] \as Map;
  \import Modules.End[V := T.Carrier, space := T.space] \as End;
  \import T.Universal[U := T.Carrier, target := T.space] \as Equality;
  \definition equality: Map.map = End.identity := Equality.ext Map.map End.identity Map.onTensor;
  \definition point: \forall (x: T.Carrier) -> Map.map.apply x = x :=
    \fun (x: T.Carrier) => congr!{{Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space].Map} T.Carrier}
      (\fun (f: Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space].Map) => f.apply x) _ _ equality;
}
\import Modules.End[V := TD.Carrier, space := TD.space] \as End;
\import Modules.DirectSum[Index := Grading.Index n, family := TD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\definition equality: ID.map = End.identity := Universal.ext ID.map End.identity
  (\fun (i: Grading.Index n)(x: Tensor.family.Carrier i.first i.second) =>
    trans!{TD.Carrier}
      _ _ _
      (ID.onInjection i x)
      (congr!{{Tensor.family.Carrier i.first i.second} TD.Carrier}
        ((TD.Component[i := i].injection).apply) ((Induced.data i.first i.second).apply x) x
        (Component[p := i.first, q := i.second].point x)));
\definition point: \forall (x: TD.Carrier) -> ID.map.apply x = x :=
  \fun (x: TD.Carrier) => congr!{{Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map} TD.Carrier}
    (\fun (f: Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map) => f.apply x) _ _ equality;
