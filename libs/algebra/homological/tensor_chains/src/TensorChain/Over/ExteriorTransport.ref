\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\import \parent.Tensor[C := C, D := D] \as Product;
\import \parent.Total[C := Product.complex] \as Total;
\import \parent.CycleProduct[C := C, D := D, p := p, q := q] \as Exterior;
\import Chains.At[C := C, z := p] \as Left;
\import Chains.At[C := D, z := q] \as Right;
\definition sourceDegree: Degree := Grading.add p q;
\module Point(n: Degree) {
  \import Chains.At[C := Total.complex, z := n] \as H;
  \definition Carrier: \Set := H.Homology;
}
\definition Carrier(n: Degree): \Set := Point[n := n].Carrier;
\definition index(n: Degree)(closed: sourceDegree = n): Grading.Index n :=
  \into[Grading.Pair](Grading.Pair { first := p, second := q },
    { i: Grading.Pair \where Grading.add #first{i} #second{i} = n }) \by { closed };
\module At(n: Degree, closed: sourceDegree = n) {
  \import \parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n closed] \as Native;
  \definition classOf(x: Left.Cycle)(y: Right.Cycle): Carrier n := Native.classOf x y;
}
\definition onClass: \forall (n: Degree)(closed: sourceDegree = n)(x: Left.Cycle)(y: Right.Cycle) ->
  Transport.cast Carrier sourceDegree n closed (Exterior.classOf x y) = At[n := n, closed := closed].classOf x y :=
  \fun (n: Degree)(closed: sourceDegree = n) =>
    (\idelim sourceDegree = n \with k: Degree => \forall (same: sourceDegree = k)(x: Left.Cycle)(y: Right.Cycle) ->
      Transport.cast Carrier sourceDegree k same (Exterior.classOf x y) = At[n := k, closed := same].classOf x y \by {
      base: \fun (same: sourceDegree = sourceDegree)(x: Left.Cycle)(y: Right.Cycle) =>
        Transport.castRefl Carrier sourceDegree (Exterior.classOf x y),
      equality: closed
    }) closed;
