\import std.Logic[].Equality[].Transport[A := Degree] \as Transport;
\import std.Logic[].Proposition[] \as Existential;
\import std.Arithmetic[].Int[] \as Integers;
\import \parent.Tensor[C := C, D := D] \as Product;
\import \parent.Total[C := Product.complex] \as Total;
\import Chains.At[C := C, z := p] \as Left;
\definition index[n, q: Degree][closed: Grading.add p q = n]: Grading.Index n :=
  \into[Grading.Pair](Grading.Pair { first := p, second := q },
    { i: Grading.Pair \where Grading.add i.first i.second = n }) \by { closed };
\definition sourceIndex[n, q: Degree][closed: Grading.add p q = n]: Grading.Index (next n) :=
  \into[Grading.Pair](Grading.Pair { first := p, second := next q },
    { i: Grading.Pair \where Grading.add i.first i.second = next n }) \by {
      trans!{Degree} _ _ _ (Grading.nextRight p q) (congr!{Degree Degree} next _ _ closed)
    };
\module At(n, q: Degree, closed: Grading.add p q = n) {
  \import Chains.At[C := D, z := q] \as Right;
  \import Chains.At[C := Total.complex, z := n] \as H;
  \import \parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n q closed] \as Exterior;
  \import \parent.\parent.RightBoundary[C := C, D := D, n := next n, i := sourceIndex n q closed] \as Boundary;
  \definition Vanishes: \Prop := \forall (x: Left.Cycle)(y: Right.Cycle) ->
    \In[D.family.Carrier q] (Right.boundaries.carrier) y -> Exterior.classOf x y = H.zeroClass;
}
\module PositivePositive(nn: Nat.Nat^, qq: Nat.Nat^) {
  \definition n: Degree := Integers.Int^::ofNat nn;
  \definition q: Degree := Integers.Int^::ofNat qq;
  \module With(closed: Grading.add p q = n) {
    \import \parent.\parent.At[n := n, q := q, closed := closed] \as Case;
    \import Chains.At[C := D, z := q] \as Right;
    \import Chains.At[C := Total.complex, z := n] \as H;
    \import \parent.\parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n q closed] \as Exterior;
    \import \parent.\parent.\parent.RightBoundary[C := C, D := D, n := next n, i := sourceIndex n q closed] \as Boundary;
    \definition priorValue[a: D.family.Carrier (next q)]: Right.prior.apply a = D.differential.apply (next q) a :=
      Transport.castRefl D.family.Carrier q (D.differential.apply (next q) a);
    \definition liftClass[x: Left.Cycle][a: D.family.Carrier (next q)]:
      Exterior.classOf x (Boundary.cycle a) = H.zeroClass := Boundary.vanishes x a;
    \definition same[x: Left.Cycle][y: Right.Cycle][a: D.family.Carrier (next q)][equal: Right.prior.apply a = y]:
      Exterior.classOf x y = Exterior.classOf x (Boundary.cycle a) :=
      Exterior.rightEqual x y (Boundary.cycle a) (trans!{{D.family.Carrier q}} y (Right.prior.apply a) (D.differential.apply (next q) a) (sym!{{D.family.Carrier q}} (Right.prior.apply a) y equal) (priorValue a));
    \definition vanishes: Case.Vanishes := \block {
      \fun (x: Left.Cycle)(y: Right.Cycle)(boundary: \In[D.family.Carrier q] (Right.boundaries.carrier) y) \then
      \takefrom a: \Cast[D.family.Carrier (next q)] ({ a: D.family.Carrier (next q) \where Right.prior.apply a = y }) \by boundary \then
      \let equal: Right.prior.apply a = y := \bysub(D.family.Carrier (next q),
        { a: D.family.Carrier (next q) \where Right.prior.apply a = y }, a) \then
      \return trans!{H.Homology} _ _ _ (same x y a equal) (liftClass x a)
    };
  }
}
\module PositiveMinusOne(nn: Nat.Nat^) {
  \definition n: Degree := Integers.Int^::ofNat nn;
  \definition q: Degree := Integers.Int^::negSucc Nat.Nat^::zero;
  \module With(closed: Grading.add p q = n) {
    \import \parent.\parent.At[n := n, q := q, closed := closed] \as Case;
    \import Chains.At[C := D, z := q] \as Right;
    \import Chains.At[C := Total.complex, z := n] \as H;
    \import \parent.\parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n q closed] \as Exterior;
    \import \parent.\parent.\parent.RightBoundary[C := C, D := D, n := next n, i := sourceIndex n q closed] \as Boundary;
    \definition priorValue[a: D.family.Carrier (next q)]: Right.prior.apply a = D.differential.apply (next q) a :=
      Transport.castRefl D.family.Carrier q (D.differential.apply (next q) a);
    \definition vanishes: Case.Vanishes := \block {
      \fun (x: Left.Cycle)(y: Right.Cycle)(boundary: \In[D.family.Carrier q] (Right.boundaries.carrier) y) \then
      \takefrom a: \Cast[D.family.Carrier (next q)] ({ a: D.family.Carrier (next q) \where Right.prior.apply a = y }) \by boundary \then
      \let equal: Right.prior.apply a = y := \bysub(D.family.Carrier (next q),
        { a: D.family.Carrier (next q) \where Right.prior.apply a = y }, a) \then
      \return trans!{H.Homology} _ _ _
        (Exterior.rightEqual x y (Boundary.cycle a) (trans!{{D.family.Carrier q}} y (Right.prior.apply a) (D.differential.apply (next q) a) (sym!{{D.family.Carrier q}} (Right.prior.apply a) y equal) (priorValue a)))
        (Boundary.vanishes x a)
    };
  }
}
\module PositiveNegative(nn: Nat.Nat^, qq: Nat.Nat^) {
  \definition n: Degree := Integers.Int^::ofNat nn;
  \definition q: Degree := Integers.Int^::negSucc (Nat.Nat^::succ qq);
  \module With(closed: Grading.add p q = n) {
