\module NegativeNegative(nn: Nat.Nat^, qq: Nat.Nat^) {
  \definition n: Degree := Integers.Int^::negSucc (Nat.Nat^::succ nn);
  \definition q: Degree := Integers.Int^::negSucc (Nat.Nat^::succ qq);
  \module With(closed: Grading.add p q = n) {
    \import \parent.\parent.At[n := n, q := q, closed := closed] \as Case;
    \import Chains.At[C := D, z := q] \as Right;
    \import Chains.At[C := Total.complex, z := n] \as H;
    \import \parent.\parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := index n q closed] \as Exterior;
    \import \parent.\parent.\parent.RightBoundary[C := C, D := D, n := next n, i := sourceIndex n q closed] \as Boundary;
    \definition priorValue[a: D.family.Carrier (next q)]: Right.prior.apply a = D.differential.apply (next q) a :=
      Transport.castRefl D.family.Carrier q (D.differential.apply (next q) a);
    \definition vanishes: Case.Vanishes := \block {
      \fun (x: Left.Cycle)(y: Right.Cycle)(boundary: \In[D.family.Carrier q] (Right.boundaries.carrier) y) \then
      \takefrom a: \Cast[D.family.Carrier (next q)] ({ a: D.family.Carrier (next q) \where Right.prior.apply a = y }) \by boundary \then
      \let equal: Right.prior.apply a = y := \bysub(D.family.Carrier (next q),
        { a: D.family.Carrier (next q) \where Right.prior.apply a = y }, a) \then
      \return trans!{H.Homology} _ _ _
        (Exterior.rightEqual x y (Boundary.cycle a) (trans!{{D.family.Carrier q}} y (Right.prior.apply a) (D.differential.apply (next q) a) (sym!{{D.family.Carrier q}} (Right.prior.apply a) y equal) (priorValue a)))
        (Boundary.vanishes x a)
    };
  }
}
\definition vanishes: \forall (n, q: Degree)(closed: Grading.add p q = n) -> At[n := n, q := q, closed := closed].Vanishes :=
  \induction (n: Degree) \return \forall (q: Degree)(closed: Grading.add p q = n) -> At[n := n, q := q, closed := closed].Vanishes \with {
    | ofNat: \fun (nn: Nat.Nat^) =>     \induction (q: Degree) \return \forall (closed: Grading.add p q = Integers.Int^::ofNat nn) -> At[n := Integers.Int^::ofNat nn, q := q, closed := closed].Vanishes \with {
      | ofNat: \fun (qq: Nat.Nat^)(closed: _) => PositivePositive[nn := nn, qq := qq].With[closed := closed].vanishes
      | negSucc: \induction (qq: Nat.Nat^) \return \forall (closed: Grading.add p (Integers.Int^::negSucc qq) = Integers.Int^::ofNat nn) -> At[n := Integers.Int^::ofNat nn, q := Integers.Int^::negSucc qq, closed := closed].Vanishes \with {
        | zero: \fun (closed: _) => PositiveMinusOne[nn := nn].With[closed := closed].vanishes
        | succ: \fun (qq: Nat.Nat^)(unused: _)(closed: _) => PositiveNegative[nn := nn, qq := qq].With[closed := closed].vanishes
      }
    }
    | negSucc: \induction (nn: Nat.Nat^) \return \forall (q: Degree)(closed: Grading.add p q = Integers.Int^::negSucc nn) -> At[n := Integers.Int^::negSucc nn, q := q, closed := closed].Vanishes \with {
      | zero:     \induction (q: Degree) \return \forall (closed: Grading.add p q = Integers.Int^::negSucc Nat.Nat^::zero) -> At[n := Integers.Int^::negSucc Nat.Nat^::zero, q := q, closed := closed].Vanishes \with {
      | ofNat: \fun (qq: Nat.Nat^)(closed: _) => MinusOnePositive[qq := qq].With[closed := closed].vanishes
      | negSucc: \induction (qq: Nat.Nat^) \return \forall (closed: Grading.add p (Integers.Int^::negSucc qq) = Integers.Int^::negSucc Nat.Nat^::zero) -> At[n := Integers.Int^::negSucc Nat.Nat^::zero, q := Integers.Int^::negSucc qq, closed := closed].Vanishes \with {
        | zero: \fun (closed: _) => MinusOneMinusOne[].With[closed := closed].vanishes
        | succ: \fun (qq: Nat.Nat^)(unused: _)(closed: _) => MinusOneNegative[qq := qq].With[closed := closed].vanishes
      }
    }
      | succ: \fun (nn: Nat.Nat^)(unused: _) =>     \induction (q: Degree) \return \forall (closed: Grading.add p q = Integers.Int^::negSucc (Nat.Nat^::succ nn)) -> At[n := Integers.Int^::negSucc (Nat.Nat^::succ nn), q := q, closed := closed].Vanishes \with {
      | ofNat: \fun (qq: Nat.Nat^)(closed: _) => NegativePositive[nn := nn, qq := qq].With[closed := closed].vanishes
      | negSucc: \induction (qq: Nat.Nat^) \return \forall (closed: Grading.add p (Integers.Int^::negSucc qq) = Integers.Int^::negSucc (Nat.Nat^::succ nn)) -> At[n := Integers.Int^::negSucc (Nat.Nat^::succ nn), q := Integers.Int^::negSucc qq, closed := closed].Vanishes \with {
        | zero: \fun (closed: _) => NegativeMinusOne[nn := nn].With[closed := closed].vanishes
        | succ: \fun (qq: Nat.Nat^)(unused: _)(closed: _) => NegativeNegative[nn := nn, qq := qq].With[closed := closed].vanishes
      }
    }
    }
  };
