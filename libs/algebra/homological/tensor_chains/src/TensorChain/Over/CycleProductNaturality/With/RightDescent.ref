\import Chains.At[C := D, z := p] \as TC;
\import Chains.At[C := F, z := q] \as TF;
\import Chains.At[C := SourceTotal.complex, z := n] \as HS;
\import \parent.\parent.\parent.CycleProductRightDescent[C := C, D := E, p := p, q := q] \as SourceDescent;
\import \parent.\parent.\parent.CycleProductRightDescent[C := D, D := F, p := p, q := q] \as TargetDescent;
\import Modules.Tensor[V := SC.Cycle, W := SE.Homology,
  left := SC.cycleSpace, right := SE.homologySpace] \as S;
\import Modules.Tensor[V := TC.Cycle, W := TF.Homology,
  left := TC.cycleSpace, right := TF.homologySpace] \as T;
\import S.Mapping[U := TC.Cycle, Z := TF.Homology,
  targetLeft := TC.cycleSpace, targetRight := TF.homologySpace] \as Components;
\definition map: Modules.Hom[V := S.Carrier, W := T.Carrier, source := S.space, target := T.space].Map :=
  Components.map (Left.cyclesMap f) (Right.induced g);
\import Modules.Hom[V := HS.Homology, W := H.Homology,
  source := HS.homologySpace, target := H.homologySpace].Composition[
  U := S.Carrier, domain := S.space] \as After;
\import Modules.Hom[V := T.Carrier, W := H.Homology,
  source := T.space, target := H.homologySpace].Composition[
  U := S.Carrier, domain := S.space] \as Before;
\import Modules.Hom[V := S.Carrier, W := H.Homology,
  source := S.space, target := H.homologySpace] \as Maps;
\definition after: Maps.Map := After.compose (Induced.induced TensorMap.total) SourceDescent.map;
\definition before: Maps.Map := Before.compose TargetDescent.map map;
\definition afterOnClass: \forall (x: SC.Cycle)(y: SE.Cycle) ->
  after.apply (S.tensor x (SE.classOf y)) =
  Target.classOf ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y) :=
  \fun (x: SC.Cycle)(y: SE.Cycle) => trans!{H.Homology}
    _ _ _
    (congr!{HS.Homology H.Homology} ((Induced.induced TensorMap.total).apply) _ _ (SourceDescent.onTensor x y))
    (onClass x y);
\definition beforeOnClass: \forall (x: SC.Cycle)(y: SE.Cycle) ->
  before.apply (S.tensor x (SE.classOf y)) =
  Target.classOf ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y) :=
  \fun (x: SC.Cycle)(y: SE.Cycle) => trans!{H.Homology}
    _ _ _
    (congr!{T.Carrier H.Homology} (TargetDescent.map.apply) _ _
      (Components.onTensor (Left.cyclesMap f) (Right.induced g) x (SE.classOf y)))
    (trans!{H.Homology} _ _ _
      (congr!{TF.Homology H.Homology}
        (\fun (h: TF.Homology) => TargetDescent.map.apply (T.tensor ((Left.cyclesMap f).apply x) h)) _ _ (Right.onClass g y))
      (TargetDescent.onTensor ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y)));
\import S.Universal[U := H.Homology, target := H.homologySpace] \as Universal;
\definition naturality: after = before := Universal.ext after before
  (\fun (x: SC.Cycle) => SE.classInduction
    (\fun (h: SE.Homology) => after.apply (S.tensor x h) = before.apply (S.tensor x h))
    (\fun (y: SE.Cycle) => trans!{H.Homology}
      _ _ _
      (afterOnClass x y) (sym!{H.Homology} _ _ (beforeOnClass x y))));
