\import Mapping.With[f := f, g := g] \as TensorMap;
\import TensorMap.Term[p := p, q := q] \as TermMap;
\import Native.Total[f := TensorMap.map].Term[n := n] \as TotalMap;
\definition onClass: \forall (x: SC.Cycle)(y: SE.Cycle) ->
  #apply{(Induced.induced TensorMap.total)} (Source.classOf x y) =
  Target.classOf (#apply{(Left.cyclesMap f)} x) (#apply{(Right.cyclesMap g)} y) :=
  \fun (x: SC.Cycle)(y: SE.Cycle) => trans!{H.Homology}
    _ _ _
    (Induced.onClass TensorMap.total (Source.cycle x y))
    (Target.equalClass (#apply{(Induced.cyclesMap TensorMap.total)} (Source.cycle x y))
      (Target.cycle (#apply{(Left.cyclesMap f)} x) (#apply{(Right.cyclesMap g)} y))
      (trans!{Current.Carrier}
        _ _ _
        (TotalMap.onInjection Source.index (STerm.tensor x y))
        (congr!{TTerm.Carrier Current.Carrier} (#apply{Inclusion.injection}) _ _ (TermMap.onTensor x y))));
\module RightDescent;
\module Exterior;
