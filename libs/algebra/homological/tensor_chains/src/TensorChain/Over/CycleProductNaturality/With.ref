\import Mapping.With[f := f, g := g] \as TensorMap;
\import TensorMap.Term[p := p, q := q] \as TermMap;
\import Native.Total[f := TensorMap.map].Term[n := n] \as TotalMap;
\definition onClass: \forall (x: SC.Cycle)(y: SE.Cycle) ->
  (Induced.induced TensorMap.total).apply (Source.classOf x y) =
  Target.classOf ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y) :=
  \fun (x: SC.Cycle)(y: SE.Cycle) => trans!{H.Homology}
    _ _ _
    (Induced.onClass TensorMap.total (Source.cycle x y))
    (Target.equalClass ((Induced.cyclesMap TensorMap.total).apply (Source.cycle x y))
      (Target.cycle ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y))
      (trans!{Current.Carrier}
        _ _ _
        (TotalMap.onInjection Source.index (STerm.tensor x y))
        (congr!{TTerm.Carrier Current.Carrier} (Inclusion.injection.apply) _ _ (TermMap.onTensor x y))));
\module RightDescent;
\module Exterior;
