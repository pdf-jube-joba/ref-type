\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition commutativeRing: Rings.CommutativeRing[K] := Fields.fieldAsCommutativeRing K field;
\definition ring: Rings.Ring[K] := Rings.commutativeRingAsRing K commutativeRing;
\import \root.FieldFinite[].Over[K := K, field := field] \as Finite;
\import module_theory.Module[].Over[R := K, ring := ring] \as Modules;
\import chain_complexes.Cochain[].Over[R := K, ring := ring] \as Cochains;
\import \root.TensorCochain[].Over[R := K, ring := commutativeRing] \as Tensors;
\import double_complexes.DoubleComplex[].Over[R := K, ring := ring] \as Degrees;
\module Of(C, D: Finite.Complex);
\module Unit(C: Finite.Complex);
\module Assertions;
