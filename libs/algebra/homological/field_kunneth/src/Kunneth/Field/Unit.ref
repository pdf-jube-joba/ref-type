\import Finite.Of[C := C] \as Model;
\import Tensors.Unit[] \as U;
\import U.With[C := Model.complex] \as Comparison;
\module At(n: N.Nat^) {
  \import Comparison.Cohomology[n := n] \as Left;
  \import Comparison.RightCohomology[n := n] \as Right;
  \import Comparison.At[n := n] \as Degree;
  \import Tensors.IndexedExterior[C := U.complex, D := Model.complex, n := n].At[i := Degree.point] \as LeftExterior;
  \import Tensors.IndexedExterior[C := Model.complex, D := U.complex, n := n].At[i := Right.point] \as RightExterior;
  \definition unitClass: _ := Left.unitClass;
  \definition leftExterior: _ := LeftExterior.map;
  \definition rightExterior: _ := RightExterior.map;
  \definition leftIsomorphism: _ := Left.isomorphism;
  \definition rightIsomorphism: _ := Right.isomorphism;
  \definition leftCompatibility: _ := Left.exteriorUnit;
  \definition rightCompatibility: _ := Right.exteriorUnit;
}
