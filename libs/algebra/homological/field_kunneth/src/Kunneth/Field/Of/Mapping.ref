\import Finite.Of[C := E] \as TargetLeft;
\import Finite.Of[C := F] \as TargetRight;
\import \parent.\parent.Of[C := E, D := F] \as Target;
\import Cochains.Map[C := Left.complex, D := TargetLeft.complex] \as LeftMaps;
\import Cochains.Map[C := Right.complex, D := TargetRight.complex] \as RightMaps;
\module With(f: LeftMaps.Map, g: RightMaps.Map) {
  \import Tensors.TensorMapping[C := Left.complex, D := TargetLeft.complex,
    E := Right.complex, F := TargetRight.complex].With[f := f, g := g] \as TensorMap;
  \module At(n: N.Nat^) {
    \import \parent.\parent.\parent.Canonical[n := n] \as SourceExterior;
    \import Target.Canonical[n := n] \as TargetExterior;
    \import HomologyTotal.Degree[n := n] \as SD;
    \import Cochains.ZeroDifferential[family := TargetLeft.homologyFamily] \as TLH;
    \import Cochains.ZeroDifferential[family := TargetRight.homologyFamily] \as TRH;
    \import Tensors.Tensor[C := TLH.complex, D := TRH.complex] \as TargetHomologyTensor;
    \import Tensors.Total[C := TargetHomologyTensor.complex] \as TargetDiagonal;
    \import TargetDiagonal.Degree[n := n] \as TD;
    \import Cochains.At[C := Total.complex, k := n] \as SH;
    \import Tensors.Tensor[C := TargetLeft.complex, D := TargetRight.complex] \as TargetTensor;
    \import Tensors.Total[C := TargetTensor.complex] \as TT;
    \import Cochains.At[C := TT.complex, k := n] \as TH;
    \import Cochains.Map[C := Total.complex, D := TT.complex].At[k := n] \as Induced;
    \import Modules.DirectSum[Index := HomologyTotal.Index n, family := SD.family].To[
      W := TD.Carrier, target := TD.space] \as Diagonal;
    \module Component(i: HomologyTotal.Index n) {
      \import Tensors.IndexedExteriorNaturality[C := Left.complex, D := TargetLeft.complex,
        E := Right.complex, F := TargetRight.complex, p := #first{i}, q := #second{i}].With[f := f, g := g] \as Natural;
      \import Tensors.CycleProductNaturality[C := Left.complex, D := TargetLeft.complex,
        E := Right.complex, F := TargetRight.complex, p := #first{i}, q := #second{i}].With[f := f, g := g].Exterior[] \as Known;
      \import Natural.At[n := n] \as NAt;
      \import Modules.Hom[V := SD.family.Carrier i, W := TH.Cohomology,
        source := SD.family.space i, target := TH.cohomologySpace] \as ComponentMaps;
      \definition commutes: \forall (x: SD.family.Carrier i) ->
        #apply{(NAt.after (Degrees.degree n i))} x =
        #apply{(NAt.before (Degrees.degree n i))} x :=
        \fun (x: SD.family.Carrier i) => congr!{ComponentMaps.Map TH.Cohomology}
          (\fun (h: ComponentMaps.Map) => #apply{h} x) _ _ (Natural.naturality n (Degrees.degree n i));
      \import Modules.Hom[V := TD.family.Carrier i, W := TD.Carrier,
        source := TD.family.space i, target := TD.space].Composition[
        U := SD.family.Carrier i, domain := SD.family.space i] \as Compose;
      \definition tensorMap: _ := Known.map;
      \definition map: Diagonal.At[i := i].Map := Compose.compose (TD.Component[i := i].injection) Known.map;
    }
    \definition components: Diagonal.Components := \fun (i: HomologyTotal.Index n) => Component[i := i].map;
    \definition diagonal: Modules.Hom[V := SD.Carrier, W := TD.Carrier,
      source := SD.space, target := TD.space].Map := Diagonal.extension components;
    \definition diagonalOnInjection: \forall (i: HomologyTotal.Index n)(x: SD.family.Carrier i) ->
      #apply{diagonal} (#apply{(SD.Component[i := i].injection)} x) =
      #apply{(Component[i := i].map)} x := Diagonal.onInjection components;
    \import Modules.Hom[V := SH.Cohomology, W := TH.Cohomology,
      source := SH.cohomologySpace, target := TH.cohomologySpace].Composition[
      U := SD.Carrier, domain := SD.space] \as After;
    \import Modules.Hom[V := TD.Carrier, W := TH.Cohomology,
      source := TD.space, target := TH.cohomologySpace].Composition[
      U := SD.Carrier, domain := SD.space] \as Before;
    \definition after: _ := After.compose (Induced.induced TensorMap.total) SourceExterior.exterior;
    \definition before: _ := Before.compose TargetExterior.exterior diagonal;
    \import Modules.DirectSum[Index := HomologyTotal.Index n, family := SD.family].To[
      W := TH.Cohomology, target := TH.cohomologySpace] \as Equality;
    \definition naturality: after = before := Equality.ext after before
      (\fun (i: HomologyTotal.Index n)(x: SD.family.Carrier i) => \block {
        \let first: _ := congr!{SH.Cohomology TH.Cohomology} (#apply{(Induced.induced TensorMap.total)})
          _ _ (SourceExterior.onInjection i x) \then
        \let middle: _ := Component[i := i].commutes x \then
        \let last: _ := trans!{TH.Cohomology} _ _ _
          (congr!{TD.Carrier TH.Cohomology} (#apply{TargetExterior.exterior}) _ _ (diagonalOnInjection i x))
          (TargetExterior.onInjection i (#apply{(Component[i := i].tensorMap)} x)) \then
        \return trans!{TH.Cohomology} _ _ _ first
          (trans!{TH.Cohomology} _ _ _ middle (sym!{TH.Cohomology} _ _ last))
      });
    \import Modules.Hom[V := SD.Carrier, W := TD.Carrier,
      source := SD.space, target := TD.space].Composition[
      U := SH.Cohomology, domain := SH.cohomologySpace] \as BackAfter;
    \import Modules.Hom[V := TH.Cohomology, W := TD.Carrier,
      source := TH.cohomologySpace, target := TD.space].Composition[
      U := SH.Cohomology, domain := SH.cohomologySpace] \as BackBefore;
    \import Modules.Hom[V := SH.Cohomology, W := TD.Carrier,
      source := SH.cohomologySpace, target := TD.space] \as BackMaps;
    \import Modules.Hom[V := SD.Carrier, W := TH.Cohomology,
      source := SD.space, target := TH.cohomologySpace] \as ForwardMaps;
    \definition inverseAfter: BackMaps.Map := BackAfter.compose diagonal SourceExterior.inverse;
    \definition inverseBefore: BackMaps.Map := BackBefore.compose TargetExterior.inverse (Induced.induced TensorMap.total);
    \definition inverseNaturality: inverseAfter = inverseBefore := BackMaps.ext inverseAfter inverseBefore
      (\fun (h: SH.Cohomology) => \block {
        \let x: SD.Carrier := #apply{SourceExterior.inverse} h \then
        \let commute: #apply{(Induced.induced TensorMap.total)} (#apply{SourceExterior.exterior} x) =
          #apply{TargetExterior.exterior} (#apply{diagonal} x) :=
          congr!{ForwardMaps.Map TH.Cohomology} (\fun (f: ForwardMaps.Map) => #apply{f} x) _ _ naturality \then
        \return trans!{TD.Carrier} _ _ _
          (sym!{TD.Carrier} _ _ (TargetExterior.inverseOnExterior (#apply{diagonal} x)))
          (trans!{TD.Carrier} _ _ _
            (congr!{TH.Cohomology TD.Carrier} (#apply{TargetExterior.inverse}) _ _ (sym!{TH.Cohomology} _ _ commute))
            (congr!{SH.Cohomology TD.Carrier}
              (\fun (y: SH.Cohomology) => #apply{TargetExterior.inverse} (#apply{(Induced.induced TensorMap.total)} y))
              _ _ (SourceExterior.exteriorOnInverse h)))
      });
  }
}
