\import Left.Split[d := s.left].Equivalence[] \as LeftEquivalence;
\import Right.Split[d := s.right].Equivalence[] \as RightEquivalence;
\import Tensors.TensorEquivalence[C := Left.complex, D := LeftHomology.complex, E := Right.complex].With[
  e := LeftEquivalence.equivalence] \as First;
\import Tensors.TensorEquivalence[C := Right.complex, D := RightHomology.complex, E := LeftHomology.complex].With[
  e := RightEquivalence.equivalence] \as Second;
\import Tensors.TensorSymmetry[C := LeftHomology.complex, D := Right.complex] \as FirstSwap;
\import Tensors.TensorSymmetry[C := RightHomology.complex, D := LeftHomology.complex] \as SecondSwap;
\module At(n: N.Nat^);
