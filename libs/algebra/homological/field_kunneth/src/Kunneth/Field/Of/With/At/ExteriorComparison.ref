\import Left.Split[d := s.left] \as LS;
\import Right.Split[d := s.right] \as RS;
\import HomologyTotal.Degree[n := n] \as Diagonal;
\import std.Data[].Nat[].Basic[].Def[] \as Arithmetic;
\module Pair(p, q: N.Nat^, closed: Arithmetic.add p q = n);
\import Tensors.IndexedExterior[C := Left.complex, D := Right.complex, n := n] \as Exterior;
\import Modules.DirectSum[Index := HomologyTotal.Index n, family := Diagonal.family].To[
  W := H0.Cohomology, target := H0.cohomologySpace] \as Universal;
\definition components: Universal.Components := \fun (i: HomologyTotal.Index n) => Exterior.At[i := i].map;
\definition topIndex(i: Degrees.Pair)(closed: Arithmetic.add #first{i} #second{i} = n): Degrees.Index n :=
  \into[Degrees.Pair](i, { i: Degrees.Pair \where Arithmetic.add #first{i} #second{i} = n }) \by { closed };
\definition OnPair(i: Degrees.Pair): \Prop :=
  \forall (closed: Arithmetic.add #first{i} #second{i} = n)(x: Diagonal.family.Carrier (topIndex i closed)) ->
  #apply{#backward{isomorphism}} (#apply{(Diagonal.Component[i := topIndex i closed].injection)} x) =
  #apply{(Exterior.At[i := topIndex i closed].map)} x;
\module AtIndex(i: Degrees.Index n) {
  \import \parent.Pair[p := #first{i}, q := #second{i}, closed := Degrees.degree n i] \as Chosen;
  \definition onRebuilt: OnPair (Degrees.Pair { first := #first{i}, second := #second{i} }) :=
    \fun (closed: Arithmetic.add #first{i} #second{i} = n) => Chosen.onComponent;
  \definition result: OnPair i :=
    \idelim Degrees.Pair { first := #first{i}, second := #second{i} } = i \with j: Degrees.Pair => OnPair j \by {
      base: onRebuilt, equality: Degrees.pairRebuild i
    };
  \definition onComponent: \forall (x: Diagonal.family.Carrier i) ->
    #apply{#backward{isomorphism}} (#apply{(Diagonal.Component[i := i].injection)} x) =
    #apply{(Exterior.At[i := i].map)} x := result (Degrees.degree n i);
}
\definition backwardExterior: #backward{isomorphism} = Universal.extension components :=
  Universal.unique components #backward{isomorphism}
    (\fun (i: HomologyTotal.Index n) => AtIndex[i := i].onComponent);
