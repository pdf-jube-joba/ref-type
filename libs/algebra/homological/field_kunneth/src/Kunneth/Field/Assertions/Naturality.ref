\import \parent.\parent.Of[C := C, D := D].Mapping[E := E, F := F].With[f := f, g := g].At[n := n] \as Diagram;
\definition Commutes: \Prop := Diagram.after = Diagram.before;
\definition proof: Commutes := Diagram.naturality;
\definition InverseCommutes: \Prop := Diagram.inverseAfter = Diagram.inverseBefore;
\definition inverseProof: InverseCommutes := Diagram.inverseNaturality;
