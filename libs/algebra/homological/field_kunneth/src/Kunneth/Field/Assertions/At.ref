\import Finite.Of[C := C] \as Left;
\import Finite.Of[C := D] \as Right;
\import Cochains.ZeroDifferential[family := Left.homologyFamily] \as LH;
\import Cochains.ZeroDifferential[family := Right.homologyFamily] \as RH;
\import Tensors.Tensor[C := LH.complex, D := RH.complex] \as HomologyProduct;
\import Tensors.Total[C := HomologyProduct.complex] \as HomologyTotal;
\import HomologyTotal.Degree[n := n] \as Diagonal;
\import Tensors.Tensor[C := Left.complex, D := Right.complex] \as Product;
\import Tensors.Total[C := Product.complex] \as Total;
\import Cochains.At[C := Total.complex, k := n] \as H;
\import Modules.Isomorphism[V := Diagonal.Carrier, W := H.Cohomology,
  source := Diagonal.space, target := H.cohomologySpace] \as Iso;
\import \parent.\parent.Of[C := C, D := D].Canonical[n := n] \as Canonical;
\definition Isomorphism: \Set := Iso.Isomorphism;
\definition Standard(i: Isomorphism): \Prop := i.forward = Canonical.exterior;
\definition selected: Isomorphism := Canonical.isomorphism;
\definition agrees: Standard selected := \refl(Canonical.exterior);
