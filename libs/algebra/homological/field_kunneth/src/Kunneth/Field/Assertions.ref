\import std.Logic[].Proposition[] \as Logic;
\module At(C, D: Finite.Complex, n: N.Nat^);
\definition standardIsomorphism: \forall (C, D: Finite.Complex)(n: N.Nat^) ->
  \exists ( i: At[C := C, D := D, n := n].Isomorphism \where At[C := C, D := D, n := n].Standard i ) :=
  \fun (C, D: Finite.Complex)(n: N.Nat^) =>
    Logic.existsIntro[At[C := C, D := D, n := n].Isomorphism,
      { i: At[C := C, D := D, n := n].Isomorphism \where At[C := C, D := D, n := n].Standard i }]
      At[C := C, D := D, n := n].selected At[C := C, D := D, n := n].agrees;
\module Maps(C, E: Finite.Complex);
\module Naturality(C, D, E, F: Finite.Complex,
  f: \parent.Maps[C := C, E := E].Map,
  g: \parent.Maps[C := D, E := F].Map, n: N.Nat^);
\definition naturality: \forall (C, D, E, F: Finite.Complex)
  (f: Maps[C := C, E := E].Map)
  (g: Maps[C := D, E := F].Map)(n: N.Nat^) ->
  Naturality[C := C, D := D, E := E, F := F, f := f, g := g, n := n].Commutes :=
  \fun (C, D, E, F: Finite.Complex)
    (f: Maps[C := C, E := E].Map)
    (g: Maps[C := D, E := F].Map)(n: N.Nat^) =>
    Naturality[C := C, D := D, E := E, F := F, f := f, g := g, n := n].proof;
\definition inverseNaturality: \forall (C, D, E, F: Finite.Complex)
  (f: Maps[C := C, E := E].Map)
  (g: Maps[C := D, E := F].Map)(n: N.Nat^) ->
  Naturality[C := C, D := D, E := E, F := F, f := f, g := g, n := n].InverseCommutes :=
  \fun (C, D, E, F: Finite.Complex)
    (f: Maps[C := C, E := E].Map)
    (g: Maps[C := D, E := F].Map)(n: N.Nat^) =>
    Naturality[C := C, D := D, E := E, F := F, f := f, g := g, n := n].inverseProof;
