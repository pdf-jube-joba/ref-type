\import Cochains.At[C := C, k := p] \as Left;
\module At(q: Nat.Nat^) {
  \import Cochains.At[C := D, k := q] \as Right;
  \import \parent.\parent.CycleProduct[C := C, D := D, p := p, q := q] \as Product;
  \import \parent.\parent.Tensor[C := C, D := D] \as Tensor;
  \import \parent.\parent.Total[C := Tensor.complex] \as Total;
  \import Cochains.At[C := Total.complex, k := Arithmetic.add p q] \as H;
  \definition Vanishes: \Prop := \forall (x: Left.CycleCarrier)(y: Right.CycleCarrier) ->
    \In[D.family.Carrier q] (Right.Boundaries q) y -> Product.classOf x y = #zero{H.cohomologySpace};
}
\module Zero;
\module Degree(q: Nat.Nat^);
\definition vanishes: \forall (q: Nat.Nat^) -> At[q := q].Vanishes :=
  \induction (q: Nat.Nat^) \return At[q := q].Vanishes \with {
    | zero: Zero[].vanishes
    | succ: \fun (q: Nat.Nat^)(before: At[q := q].Vanishes) => Degree[q := q].vanishes
  };
