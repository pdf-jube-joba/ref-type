\import Source.Degree[n := n] \as SD;
\import Target.Degree[n := n] \as TD;
\import F.Degree[n := n] \as FD;
\import G.Degree[n := n] \as GD;
\import Modules.Hom[V := TD.Carrier, W := SD.Carrier, source := TD.space, target := SD.space].Composition[U := SD.Carrier, domain := SD.space] \as Left;
\import Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Composition[U := TD.Carrier, domain := TD.space] \as Right;
\import Modules.End[V := SD.Carrier, space := SD.space] \as SourceEnd;
\import Modules.End[V := TD.Carrier, space := TD.space] \as TargetEnd;
\import Modules.DirectSum[Index := Degrees.Index n, family := SD.family].To[W := SD.Carrier, target := SD.space] \as LeftEquality;
\import Modules.DirectSum[Index := Degrees.Index n, family := TD.family].To[W := TD.Carrier, target := TD.space] \as RightEquality;
\definition leftEquality: Left.compose GD.map FD.map = SourceEnd.identity :=
  LeftEquality.ext (Left.compose GD.map FD.map) SourceEnd.identity
    (\fun (i: Degrees.Index n)(x: C.family.Carrier i.first i.second) => trans!{SD.Carrier} _ _ _
      (congr!{TD.Carrier SD.Carrier} (GD.map.apply) _ _ (FD.onInjection i x))
      (trans!{SD.Carrier} _ _ _ (GD.onInjection i ((f i.first i.second).apply x))
        (congr!{{C.family.Carrier i.first i.second} SD.Carrier} ((SD.Component[i := i].injection).apply) _ _ (inverseLaws.left i.first i.second x))));
\definition rightEquality: Right.compose FD.map GD.map = TargetEnd.identity :=
  RightEquality.ext (Right.compose FD.map GD.map) TargetEnd.identity
    (\fun (i: Degrees.Index n)(x: D.family.Carrier i.first i.second) => trans!{TD.Carrier} _ _ _
      (congr!{SD.Carrier TD.Carrier} (FD.map.apply) _ _ (GD.onInjection i x))
      (trans!{TD.Carrier} _ _ _ (FD.onInjection i ((g i.first i.second).apply x))
        (congr!{{D.family.Carrier i.first i.second} TD.Carrier} ((TD.Component[i := i].injection).apply) _ _ (inverseLaws.right i.first i.second x))));
\definition leftInverse: \forall (x: SD.Carrier) -> GD.map.apply (FD.map.apply x) = x :=
  \fun (x: SD.Carrier) => congr!{{Modules.Hom[V := SD.Carrier, W := SD.Carrier, source := SD.space, target := SD.space].Map} SD.Carrier}
    (\fun (m: Modules.Hom[V := SD.Carrier, W := SD.Carrier, source := SD.space, target := SD.space].Map) => m.apply x) _ _ leftEquality;
\definition rightInverse: \forall (x: TD.Carrier) -> FD.map.apply (GD.map.apply x) = x :=
  \fun (x: TD.Carrier) => congr!{{Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map} TD.Carrier}
    (\fun (m: Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map) => m.apply x) _ _ rightEquality;
