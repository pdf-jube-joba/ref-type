\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := n] \as Term;
\import Cochains.At[C := Source.complex, k := n] \as SH;
\import Cochains.At[C := Target.complex, k := n] \as TH;
\import Cochains.Map[C := Source.complex, D := Target.complex].At[k := n] \as Forward;
\import Cochains.Map[C := Target.complex, D := Source.complex].At[k := n] \as Backward;
\import Modules.Isomorphism[V := SH.Cohomology, W := TH.Cohomology, source := SH.cohomologySpace, target := TH.cohomologySpace] \as Iso;
\definition leftInverse: \forall (x: SH.Cohomology) -> (Backward.induced G.map).apply ((Forward.induced F.map).apply x) = x :=
  SH.classInduction (\fun (x: SH.Cohomology) => (Backward.induced G.map).apply ((Forward.induced F.map).apply x) = x)
    (\fun (x: SH.CycleCarrier) => eq_reason_in!{SH.Cohomology _
      "=" _ "by" { congr!{TH.Cohomology SH.Cohomology} ((Backward.induced G.map).apply) _ _ (Forward.onClass F.map x) }
      "=" _ "by" { Backward.onClass G.map ((Forward.cyclesMap F.map).apply x) }
      "=" _ "by" { SH.equalClass ((Backward.cyclesMap G.map).apply ((Forward.cyclesMap F.map).apply x)) x (Term.leftInverse x) }
    });
\definition rightInverse: \forall (y: TH.Cohomology) -> (Forward.induced F.map).apply ((Backward.induced G.map).apply y) = y :=
  TH.classInduction (\fun (y: TH.Cohomology) => (Forward.induced F.map).apply ((Backward.induced G.map).apply y) = y)
    (\fun (y: TH.CycleCarrier) => eq_reason_in!{TH.Cohomology _
      "=" _ "by" { congr!{SH.Cohomology TH.Cohomology} ((Forward.induced F.map).apply) _ _ (Backward.onClass G.map y) }
      "=" _ "by" { Forward.onClass F.map ((Backward.cyclesMap G.map).apply y) }
      "=" _ "by" { TH.equalClass ((Forward.cyclesMap F.map).apply ((Backward.cyclesMap G.map).apply y)) y (Term.rightInverse y) }
    });
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.induced F.map, backward := Backward.induced G.map, leftInverse := leftInverse, rightInverse := rightInverse,
};
