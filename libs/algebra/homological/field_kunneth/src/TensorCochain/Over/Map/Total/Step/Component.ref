\definition p: Nat.Nat^ := #first{i};
\definition q: Nat.Nat^ := #second{i};
\definition hi: Source.Index (Nat.Nat^::succ n) := Source.upHorizontal n i;
\definition vi: Source.Index (Nat.Nat^::succ n) := Source.upVertical n i;
\definition horizontal: \forall (x: C.family.Carrier p q) ->
  #apply{TS.horizontal} (#apply{Current.map} (#apply{(SD.Component[i := i].injection)} x)) =
    #apply{Next.map} (#apply{SS.horizontal} (#apply{(SD.Component[i := i].injection)} x)) :=
  \fun (x: C.family.Carrier p q) => trans!{TN.Carrier} _ _ _
    (congr!{TD.Carrier TN.Carrier} (#apply{TS.horizontal}) _ _ (Current.onInjection i x))
    (trans!{TN.Carrier} _ _ _ (TS.horizontalOnInjection i (#apply{(f p q)} x))
      (trans!{TN.Carrier} _ _ _
        (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} TN.Carrier} (#apply{(TN.Component[i := hi].injection)}) _ _ (#horizontal{(laws f)} p q x))
        (trans!{TN.Carrier} _ _ _ (sym!{TN.Carrier} _ _ (Next.onInjection hi (#apply{(C.differential.horizontal p q)} x)))
          (congr!{SN.Carrier TN.Carrier} (#apply{Next.map}) _ _ (sym!{SN.Carrier} _ _ (SS.horizontalOnInjection i x))))));
\import Degrees.Sign[V := C.family.Carrier p (Nat.Nat^::succ q), space := C.family.space p (Nat.Nat^::succ q)] \as Sign;
\import Degrees.Sign[V := D.family.Carrier p (Nat.Nat^::succ q), space := D.family.space p (Nat.Nat^::succ q)] \as TargetSign;
\import Sign.Mapping[W := D.family.Carrier p (Nat.Nat^::succ q), target := D.family.space p (Nat.Nat^::succ q)] \as SignMapping;
\definition vertical: \forall (x: C.family.Carrier p q) ->
  #apply{TS.vertical} (#apply{Current.map} (#apply{(SD.Component[i := i].injection)} x)) =
    #apply{Next.map} (#apply{SS.vertical} (#apply{(SD.Component[i := i].injection)} x)) :=
  \fun (x: C.family.Carrier p q) => trans!{TN.Carrier} _ _ _
    (congr!{TD.Carrier TN.Carrier} (#apply{TS.vertical}) _ _ (Current.onInjection i x))
    (trans!{TN.Carrier} _ _ _ (TS.verticalOnInjection i (#apply{(f p q)} x))
      (trans!{TN.Carrier} _ _ _
        (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TN.Carrier}
          (\fun (z: D.family.Carrier p (Nat.Nat^::succ q)) => #apply{(TN.Component[i := vi].injection)} (#apply{(TargetSign.map p)} z)) _ _ (#vertical{(laws f)} p q x))
        (trans!{TN.Carrier} _ _ _
          (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TN.Carrier} (#apply{(TN.Component[i := vi].injection)}) _ _
            (sym!{{D.family.Carrier p (Nat.Nat^::succ q)}} _ _ (SignMapping.naturality (f p (Nat.Nat^::succ q)) p (#apply{(C.differential.vertical p q)} x))))
          (trans!{TN.Carrier} _ _ _
            (sym!{TN.Carrier} _ _ (Next.onInjection vi (#apply{(Sign.map p)} (#apply{(C.differential.vertical p q)} x))))
            (congr!{SN.Carrier TN.Carrier} (#apply{Next.map}) _ _ (sym!{SN.Carrier} _ _ (SS.verticalOnInjection i x)))))));
