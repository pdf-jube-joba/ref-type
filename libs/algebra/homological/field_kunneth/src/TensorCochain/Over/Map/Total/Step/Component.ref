\definition p: Nat.Nat^ := i.first;
\definition q: Nat.Nat^ := i.second;
\definition hi: Source.Index (Nat.Nat^::succ n) := Source.upHorizontal n i;
\definition vi: Source.Index (Nat.Nat^::succ n) := Source.upVertical n i;
\definition horizontal: \forall (x: C.family.Carrier p q) ->
  TS.horizontal.apply (Current.map.apply ((SD.Component[i := i].injection).apply x)) =
    Next.map.apply (SS.horizontal.apply ((SD.Component[i := i].injection).apply x)) :=
  \fun (x: C.family.Carrier p q) => trans!{TN.Carrier} _ _ _
    (congr!{TD.Carrier TN.Carrier} (TS.horizontal.apply) _ _ (Current.onInjection i x))
    (trans!{TN.Carrier} _ _ _ (TS.horizontalOnInjection i ((f p q).apply x))
      (trans!{TN.Carrier} _ _ _
        (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} TN.Carrier} ((TN.Component[i := hi].injection).apply) _ _ ((laws f).horizontal p q x))
        (trans!{TN.Carrier} _ _ _ (sym!{TN.Carrier} _ _ (Next.onInjection hi ((C.differential.horizontal p q).apply x)))
          (congr!{SN.Carrier TN.Carrier} (Next.map.apply) _ _ (sym!{SN.Carrier} _ _ (SS.horizontalOnInjection i x))))));
\import Degrees.Sign[V := C.family.Carrier p (Nat.Nat^::succ q), space := C.family.space p (Nat.Nat^::succ q)] \as Sign;
\import Degrees.Sign[V := D.family.Carrier p (Nat.Nat^::succ q), space := D.family.space p (Nat.Nat^::succ q)] \as TargetSign;
\import Sign.Mapping[W := D.family.Carrier p (Nat.Nat^::succ q), target := D.family.space p (Nat.Nat^::succ q)] \as SignMapping;
\definition vertical: \forall (x: C.family.Carrier p q) ->
  TS.vertical.apply (Current.map.apply ((SD.Component[i := i].injection).apply x)) =
    Next.map.apply (SS.vertical.apply ((SD.Component[i := i].injection).apply x)) :=
  \fun (x: C.family.Carrier p q) => trans!{TN.Carrier} _ _ _
    (congr!{TD.Carrier TN.Carrier} (TS.vertical.apply) _ _ (Current.onInjection i x))
    (trans!{TN.Carrier} _ _ _ (TS.verticalOnInjection i ((f p q).apply x))
      (trans!{TN.Carrier} _ _ _
        (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TN.Carrier}
          (\fun (z: D.family.Carrier p (Nat.Nat^::succ q)) => (TN.Component[i := vi].injection).apply ((TargetSign.map p).apply z)) _ _ ((laws f).vertical p q x))
        (trans!{TN.Carrier} _ _ _
          (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TN.Carrier} ((TN.Component[i := vi].injection).apply) _ _
            (sym!{{D.family.Carrier p (Nat.Nat^::succ q)}} _ _ (SignMapping.naturality (f p (Nat.Nat^::succ q)) p ((C.differential.vertical p q).apply x))))
          (trans!{TN.Carrier} _ _ _
            (sym!{TN.Carrier} _ _ (Next.onInjection vi ((Sign.map p).apply ((C.differential.vertical p q).apply x))))
            (congr!{SN.Carrier TN.Carrier} (Next.map.apply) _ _ (sym!{SN.Carrier} _ _ (SS.verticalOnInjection i x)))))));
