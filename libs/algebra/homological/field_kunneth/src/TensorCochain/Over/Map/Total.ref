\import \parent.\parent.Total[C := C] \as Source;
\import \parent.\parent.Total[C := D] \as Target;
\module Degree(n: Nat.Nat^) {
  \import Source.Degree[n := n] \as SD;
  \import Target.Degree[n := n] \as TD;
  \import Modules.DirectSum[Index := Source.Index n, family := SD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
  \module Component(i: Source.Index n) {
    \import Modules.Hom[V := D.family.Carrier i.first i.second, W := TD.Carrier,
      source := D.family.space i.first i.second, target := TD.space].Composition[
      U := C.family.Carrier i.first i.second, domain := C.family.space i.first i.second] \as Compose;
    \definition map: Universal.At[i := i].Map := Compose.compose (TD.Component[i := i].injection) (f i.first i.second);
  }
  \definition components: Universal.Components := \fun (i: Source.Index n) => Component[i := i].map;
  \definition map: Modules.Hom[V := SD.Carrier, W := TD.Carrier, source := SD.space, target := TD.space].Map := Universal.extension components;
  \definition onInjection: \forall (i: Source.Index n)(x: C.family.Carrier i.first i.second) ->
    map.apply ((SD.Component[i := i].injection).apply x) =
      (TD.Component[i := i].injection).apply ((f i.first i.second).apply x) := Universal.onInjection components;
}
\module Step(n: Nat.Nat^);
\import Cochains.Map[C := Source.complex, D := Target.complex] \as Native;
\definition map: Native.Map := Native.Map {
  apply := \fun (n: Nat.Nat^) => (Degree[n := n].map).apply,
  addition := \fun (n: Nat.Nat^) => (Degree[n := n].map).addition,
  scalar := \fun (n: Nat.Nat^) => (Degree[n := n].map).scalar,
  commutes := \fun (n: Nat.Nat^) => Step[n := n].commutes,
};
