\definition inverseLaws: Laws[g] := \bysub(Data, { data: Data \where Laws[data] }, g);
\import \parent.\parent.\parent.Map[C := D, D := C] \as Reverse;
\import \root.TensorCochain[].Over[R := R, ring := ring].Map[C := C, D := D] \as Original;
\definition forwardLaws: Original.Laws[f] := Original.laws f;
\module Component(p, q: Nat.Nat^) {
  \definition horizontal: \forall (y: D.family.Carrier p q) ->
    (C.differential.horizontal p q).apply ((g p q).apply y) =
      (g (Nat.Nat^::succ p) q).apply ((D.differential.horizontal p q).apply y) :=
    \block {
      \fun (y: D.family.Carrier p q) \then
      \let x: C.family.Carrier p q := (g p q).apply y \then
      \let z: C.family.Carrier (Nat.Nat^::succ p) q := (C.differential.horizontal p q).apply x \then
      \return trans!{{C.family.Carrier (Nat.Nat^::succ p) q}} _ _ _
        (sym!{{C.family.Carrier (Nat.Nat^::succ p) q}} ((g (Nat.Nat^::succ p) q).apply ((f (Nat.Nat^::succ p) q).apply z)) z (inverseLaws.left (Nat.Nat^::succ p) q z))
        (trans!{{C.family.Carrier (Nat.Nat^::succ p) q}}
          _ _ _
          (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} {C.family.Carrier (Nat.Nat^::succ p) q}}
            ((g (Nat.Nat^::succ p) q).apply) ((f (Nat.Nat^::succ p) q).apply z) ((D.differential.horizontal p q).apply ((f p q).apply x))
            (sym!{{D.family.Carrier (Nat.Nat^::succ p) q}} ((D.differential.horizontal p q).apply ((f p q).apply x)) ((f (Nat.Nat^::succ p) q).apply z) (forwardLaws.horizontal p q x)))
          (congr!{{D.family.Carrier p q} {C.family.Carrier (Nat.Nat^::succ p) q}}
            (\fun (u: D.family.Carrier p q) => (g (Nat.Nat^::succ p) q).apply ((D.differential.horizontal p q).apply u))
            ((f p q).apply x) y (inverseLaws.right p q y)))
    };
  \definition vertical: \forall (y: D.family.Carrier p q) ->
    (C.differential.vertical p q).apply ((g p q).apply y) =
      (g p (Nat.Nat^::succ q)).apply ((D.differential.vertical p q).apply y) :=
    \block {
      \fun (y: D.family.Carrier p q) \then
      \let x: C.family.Carrier p q := (g p q).apply y \then
      \let z: C.family.Carrier p (Nat.Nat^::succ q) := (C.differential.vertical p q).apply x \then
      \return trans!{{C.family.Carrier p (Nat.Nat^::succ q)}} _ _ _
        (sym!{{C.family.Carrier p (Nat.Nat^::succ q)}} ((g p (Nat.Nat^::succ q)).apply ((f p (Nat.Nat^::succ q)).apply z)) z (inverseLaws.left p (Nat.Nat^::succ q) z))
        (trans!{{C.family.Carrier p (Nat.Nat^::succ q)}}
          _ _ _
          (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} {C.family.Carrier p (Nat.Nat^::succ q)}}
            ((g p (Nat.Nat^::succ q)).apply) ((f p (Nat.Nat^::succ q)).apply z) ((D.differential.vertical p q).apply ((f p q).apply x))
            (sym!{{D.family.Carrier p (Nat.Nat^::succ q)}} ((D.differential.vertical p q).apply ((f p q).apply x)) ((f p (Nat.Nat^::succ q)).apply z) (forwardLaws.vertical p q x)))
          (congr!{{D.family.Carrier p q} {C.family.Carrier p (Nat.Nat^::succ q)}}
            (\fun (u: D.family.Carrier p q) => (g p (Nat.Nat^::succ q)).apply ((D.differential.vertical p q).apply u))
            ((f p q).apply x) y (inverseLaws.right p q y)))
    };
}
\definition backward: Reverse.Map := \into[Reverse.Data](g, { data: Reverse.Data \where Reverse.Laws[data] }) \by {
  Reverse.Laws[g] {
    horizontal := \fun (p, q: Nat.Nat^) => Component[p := p, q := q].horizontal,
    vertical := \fun (p, q: Nat.Nat^) => Component[p := p, q := q].vertical,
  }
};
\import \parent.\parent.Total[f := f] \as F;
\import Reverse.Total[f := backward] \as G;
\import \parent.\parent.\parent.Total[C := C] \as Source;
\import \parent.\parent.\parent.Total[C := D] \as Target;
\module Degree(n: Nat.Nat^);
\module At(n: Nat.Nat^);
