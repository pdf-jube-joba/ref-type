\definition p: Nat.Nat^ := i.first;
\definition q: Nat.Nat^ := i.second;
\import Cochains.At[C := C, k := p] \as LeftCycles;
\import Cochains.At[C := D, k := q] \as RightCycles;
\definition exponent: Nat.Nat^ := Arithmetic.mul p q;
\import \parent.\parent.\parent.Swap[C := Original.complex] \as Koszul;
\import Koszul.Degree[n := n] \as K;
\import Maps.Total[f := map] \as Termwise;
\import Termwise.Degree[n := n] \as T;
\import SourceTotal.Degree[n := n] \as SD;
\import MiddleTotal.Degree[n := n] \as MD;
\import TargetTotal.Degree[n := n] \as TD;
\import Original.Term[p := p, q := q] \as ST;
\import Target.Term[p := q, q := p] \as TT;
\import \parent.\parent.Term[p := q, q := p] \as SymmetryTerm;
\import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q,
  left := C.family.space p, right := D.family.space q].Symmetry[] \as TensorSwap;
\import Degrees.Sign[V := ST.Carrier, space := ST.space] \as STSign;
\import Degrees.Sign[V := TT.Carrier, space := TT.space] \as TTSign;
\import Degrees.Sign[V := TD.Carrier, space := TD.space] \as TotalSign;
\import STSign.Mapping[W := TT.Carrier, target := TT.space] \as SwapSign;
\import TTSign.Mapping[W := TD.Carrier, target := TD.space] \as InjectionSign;
\import \parent.\parent.\parent.IndexedCycleProduct[C := C, D := D, n := n].At[i := i] \as SourceProduct;
\import \parent.\parent.\parent.IndexedCycleProduct[C := D, D := C, n := n].At[
  i := Koszul.index n i] \as TargetProduct;
\definition onValue: \forall (x: LeftCycles.CycleCarrier)(y: RightCycles.CycleCarrier) ->
  Termwise.map.apply n (Koszul.forward.apply n (SourceProduct.value x y)) =
  (TotalSign.map exponent).apply (TargetProduct.value y x) :=
  \fun (x: LeftCycles.CycleCarrier)(y: RightCycles.CycleCarrier) => trans!{TD.Carrier} _ _ _
    (congr!{MD.Carrier TD.Carrier} (Termwise.map.apply n) _ _ (K.onInjection i (ST.tensor x y)))
    (trans!{TD.Carrier} _ _ _
      (T.onInjection (Koszul.index n i) ((STSign.map exponent).apply (ST.tensor x y)))
      (trans!{TD.Carrier} _ _ _
        (congr!{TT.Carrier TD.Carrier} ((TD.Component[i := Koszul.index n i].injection).apply) _ _
          (trans!{TT.Carrier} _ _ _ (SwapSign.naturality SymmetryTerm.forward exponent (ST.tensor x y))
            (congr!{TT.Carrier TT.Carrier} ((TTSign.map exponent).apply) _ _ (TensorSwap.onTensor x y))))
        (InjectionSign.naturality (TD.Component[i := Koszul.index n i].injection) exponent (TT.tensor y x))));
\import Cochains.Map[C := SourceTotal.complex, D := MiddleTotal.complex].At[k := n] \as First;
\import Cochains.Map[C := MiddleTotal.complex, D := TargetTotal.complex].At[k := n] \as Second;
\import Degrees.Sign[V := Final.CycleCarrier, space := Final.cycleSpace] \as CycleSign;
\import Degrees.Sign[V := Final.Cohomology, space := Final.cohomologySpace] \as HomologySign;
\import Modules.Hom[V := Final.CycleCarrier, W := TD.Carrier,
  source := Final.cycleSpace, target := TD.space] \as AmbientMaps;
\definition ambient: AmbientMaps.Map := AmbientMaps.Map {
  apply := \fun (x: Final.CycleCarrier) => x,
  addition := \fun (x, y: Final.CycleCarrier) => \refl(TD.space.add x y),
  scalar := \fun (a: R)(x: Final.CycleCarrier) => \refl(TD.space.smul a x),
};
\import CycleSign.Mapping[W := TD.Carrier, target := TD.space] \as AmbientSign;
\import CycleSign.Mapping[W := Final.Cohomology, target := Final.cohomologySpace] \as ClassSign;
\definition onClass: \forall (x: LeftCycles.CycleCarrier)(y: RightCycles.CycleCarrier) ->
  isomorphism.forward.apply (SourceProduct.classOf x y) =
  (HomologySign.map exponent).apply (TargetProduct.classOf y x) :=
  \fun (x: LeftCycles.CycleCarrier)(y: RightCycles.CycleCarrier) => trans!{Final.Cohomology} _ _ _
    (congr!{Middle.Cohomology Final.Cohomology} ((Second.induced Termwise.map).apply) _ _
      (First.onClass Koszul.forward (SourceProduct.cycle x y)))
    (trans!{Final.Cohomology} _ _ _
      (Second.onClass Termwise.map ((First.cyclesMap Koszul.forward).apply (SourceProduct.cycle x y)))
      (trans!{Final.Cohomology} _ _ _
        (Final.equalClass
          ((Second.cyclesMap Termwise.map).apply ((First.cyclesMap Koszul.forward).apply (SourceProduct.cycle x y)))
          ((CycleSign.map exponent).apply (TargetProduct.cycle y x))
          (trans!{TD.Carrier} _ _ _ (onValue x y)
            (sym!{TD.Carrier} _ _ (AmbientSign.naturality ambient exponent (TargetProduct.cycle y x)))))
        (ClassSign.naturality Final.classLinear exponent (TargetProduct.cycle y x))));
\import Degrees.Sign[V := Source.Cohomology, space := Source.cohomologySpace] \as SourceSign;
\import HomologySign.Mapping[W := Source.Cohomology, target := Source.cohomologySpace] \as BackwardSign;
\definition inverseOnClass: \forall (x: LeftCycles.CycleCarrier)(y: RightCycles.CycleCarrier) ->
  isomorphism.backward.apply (TargetProduct.classOf y x) =
  (SourceSign.map exponent).apply (SourceProduct.classOf x y) :=
  \fun (x: LeftCycles.CycleCarrier)(y: RightCycles.CycleCarrier) => trans!{Source.Cohomology} _ _ _
    (congr!{Final.Cohomology Source.Cohomology} (isomorphism.backward.apply) _ _
      (sym!{Final.Cohomology} _ _ (HomologySign.involutive exponent (TargetProduct.classOf y x))))
    (trans!{Source.Cohomology} _ _ _
      (congr!{Final.Cohomology Source.Cohomology}
        (\fun (h: Final.Cohomology) => isomorphism.backward.apply ((HomologySign.map exponent).apply h))
        _ _ (sym!{Final.Cohomology} _ _ (onClass x y)))
      (trans!{Source.Cohomology} _ _ _
        (BackwardSign.naturality isomorphism.backward exponent (isomorphism.forward.apply (SourceProduct.classOf x y)))
        (congr!{Source.Cohomology Source.Cohomology} ((SourceSign.map exponent).apply) _ _
          (isomorphism.leftInverse (SourceProduct.classOf x y)))));
