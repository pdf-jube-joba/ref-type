\import std.Logic[].Proposition[] \as Logic;
\import \parent.Total[C := C] \as Total;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\module Degree(n: Nat.Nat^) {
  \import Total.Degree[n := n] \as Term;
  \import Modules.DirectSum[Index := Degrees.Index n, family := Term.family].FiniteSupport[] \as Native;
  \definition coordinate[i: Degrees.Index n][x: Term.Carrier]: C.family.Carrier (i).first (i).second := ((Native.forward).apply x) i;
  \module At(i: Degrees.Index n) {
    \import Native.At[i := i] \as Evaluation;
    \import Modules.Hom[V := Term.Carrier, W := C.family.Carrier (i).first (i).second,
      source := Term.space, target := C.family.space (i).first (i).second] \as Maps;
    \definition map: Maps.Map := Evaluation.evaluate;
    \definition zero: coordinate i (Term.space).zero = (C.family.space (i).first (i).second).zero := Maps.zeroPreserved map;
  }
  \definition own: \forall (i: Degrees.Index n)(x: C.family.Carrier (i).first (i).second) ->
    coordinate i ((Term.Component[i := i].injection).apply x) = x := Native.atOwn;
  \definition other: \forall (i, j: Degrees.Index n)(x: C.family.Carrier (i).first (i).second) -> Logic.Not (i = j) ->
    coordinate j ((Term.Component[i := i].injection).apply x) = (C.family.space (j).first (j).second).zero := Native.atOther;
  \definition ext: \forall (x, y: Term.Carrier) -> (\forall (i: Degrees.Index n) -> coordinate i x = coordinate i y) -> x = y :=
    \fun (x, y: Term.Carrier)(same: \forall (i: Degrees.Index n) -> coordinate i x = coordinate i y) =>
      Native.injective x y (\axiom:funext((Native.forward).apply x, (Native.forward).apply y, same));
  \definition zero: \forall (x: Term.Carrier) -> (\forall (i: Degrees.Index n) -> coordinate i x = (C.family.space (i).first (i).second).zero) -> x = (Term.space).zero :=
    \fun (x: Term.Carrier)(vanishes: \forall (i: Degrees.Index n) -> coordinate i x = (C.family.space (i).first (i).second).zero) =>
      ext x (Term.space).zero (\fun (i: Degrees.Index n) => trans!{{C.family.Carrier (i).first (i).second}} _ _ _ (vanishes i) (sym!{{C.family.Carrier (i).first (i).second}} _ _ At[i := i].zero));
}
\module Step(n: Nat.Nat^, i: Degrees.Index n);
\module Axis(n: Nat.Nat^, j: Degrees.Index (Nat.Nat^::succ n));
