\import std.Logic[].Proposition[] \as Logic;
\import \parent.Total[C := C] \as Total;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\module Degree(n: Nat.Nat^) {
  \import Total.Degree[n := n] \as Term;
  \import Modules.DirectSum[Index := Degrees.Index n, family := Term.family].FiniteSupport[] \as Native;
  \definition coordinate(i: Degrees.Index n)(x: Term.Carrier): C.family.Carrier #first{i} #second{i} := (#apply{Native.forward} x) i;
  \module At(i: Degrees.Index n) {
    \import Native.At[i := i] \as Evaluation;
    \import Modules.Hom[V := Term.Carrier, W := C.family.Carrier #first{i} #second{i},
      source := Term.space, target := C.family.space #first{i} #second{i}] \as Maps;
    \definition map: Maps.Map := Evaluation.evaluate;
    \definition zero: coordinate i #zero{Term.space} = #zero{(C.family.space #first{i} #second{i})} := Maps.zeroPreserved map;
  }
  \definition own: \forall (i: Degrees.Index n)(x: C.family.Carrier #first{i} #second{i}) ->
    coordinate i (#apply{(Term.Component[i := i].injection)} x) = x := Native.atOwn;
  \definition other: \forall (i, j: Degrees.Index n)(x: C.family.Carrier #first{i} #second{i}) -> Logic.Not (i = j) ->
    coordinate j (#apply{(Term.Component[i := i].injection)} x) = #zero{(C.family.space #first{j} #second{j})} := Native.atOther;
  \definition ext: \forall (x, y: Term.Carrier) -> (\forall (i: Degrees.Index n) -> coordinate i x = coordinate i y) -> x = y :=
    \fun (x, y: Term.Carrier)(same: \forall (i: Degrees.Index n) -> coordinate i x = coordinate i y) =>
      Native.injective x y (\axiom:funext(#apply{Native.forward} x, #apply{Native.forward} y, same));
  \definition zero: \forall (x: Term.Carrier) -> (\forall (i: Degrees.Index n) -> coordinate i x = #zero{(C.family.space #first{i} #second{i})}) -> x = #zero{Term.space} :=
    \fun (x: Term.Carrier)(vanishes: \forall (i: Degrees.Index n) -> coordinate i x = #zero{(C.family.space #first{i} #second{i})}) =>
      ext x #zero{Term.space} (\fun (i: Degrees.Index n) => trans!{{C.family.Carrier #first{i} #second{i}}} _ _ _ (vanishes i) (sym!{{C.family.Carrier #first{i} #second{i}}} _ _ At[i := i].zero));
}
\module Step(n: Nat.Nat^, i: Degrees.Index n);
\module Axis(n: Nat.Nat^, j: Degrees.Index (Nat.Nat^::succ n));
