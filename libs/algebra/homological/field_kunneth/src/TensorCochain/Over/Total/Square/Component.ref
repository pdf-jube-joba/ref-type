\definition p: Nat.Nat^ := i.first;
\definition q: Nat.Nat^ := i.second;
\definition hi: Index (Nat.Nat^::succ n) := upHorizontal n i;
\definition vi: Index (Nat.Nat^::succ n) := upVertical n i;
\import Target.Component[i := upHorizontal (Nat.Nat^::succ n) hi] \as HH;
\import Target.Component[i := upVertical (Nat.Nat^::succ n) vi] \as VV;
\import Target.Component[i := upHorizontal (Nat.Nat^::succ n) vi] \as HV;
\import Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ p)) q, W := Target.Carrier,
  source := C.family.space (Nat.Nat^::succ (Nat.Nat^::succ p)) q, target := Target.space] \as HHMaps;
\import Modules.Hom[V := C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q)), W := Target.Carrier,
  source := C.family.space p (Nat.Nat^::succ (Nat.Nat^::succ q)), target := Target.space] \as VVMaps;
\import Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q), W := Target.Carrier,
  source := C.family.space (Nat.Nat^::succ p) (Nat.Nat^::succ q), target := Target.space] \as HVMaps;
\definition horizontalZero: \forall (x: C.family.Carrier p q) ->
  Second.horizontal.apply (First.horizontal.apply ((Source.Component[i := i].injection).apply x)) = Target.space.zero :=
  \fun (x: C.family.Carrier p q) => trans!{Target.Carrier} _ _ _
    (congr!{Middle.Carrier Target.Carrier} (Second.horizontal.apply) _ _ (First.horizontalOnInjection i x))
    (trans!{Target.Carrier} _ _ _ (Second.horizontalOnInjection hi ((C.differential.horizontal p q).apply x))
      (trans!{Target.Carrier} _ _ _
        (congr!{{C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ p)) q} Target.Carrier} (HH.injection.apply) _ _ (C.laws.horizontalZero p q x))
        (HHMaps.zeroPreserved HH.injection)));
\import Degrees.Sign[V := C.family.Carrier p (Nat.Nat^::succ q), space := C.family.space p (Nat.Nat^::succ q)] \as VSign;
\import Degrees.Sign[V := C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q)), space := C.family.space p (Nat.Nat^::succ (Nat.Nat^::succ q))] \as VVSign;
\import VSign.Mapping[W := C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q)), target := C.family.space p (Nat.Nat^::succ (Nat.Nat^::succ q))] \as VSignMap;
\definition verticalZero: \forall (x: C.family.Carrier p q) ->
  Second.vertical.apply (First.vertical.apply ((Source.Component[i := i].injection).apply x)) = Target.space.zero :=
  \fun (x: C.family.Carrier p q) => trans!{Target.Carrier} _ _ _
    (congr!{Middle.Carrier Target.Carrier} (Second.vertical.apply) _ _ (First.verticalOnInjection i x))
    (trans!{Target.Carrier} _ _ _ (Second.verticalOnInjection vi ((VSign.map p).apply ((C.differential.vertical p q).apply x)))
      (trans!{Target.Carrier} _ _ _
        (congr!{{C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q))} Target.Carrier}
          (\fun (z: C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q))) => VV.injection.apply ((VVSign.map p).apply z)) _ _
          (VSignMap.naturality (C.differential.vertical p (Nat.Nat^::succ q)) p ((C.differential.vertical p q).apply x)))
        (trans!{Target.Carrier} _ _ _
          (congr!{{C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q))} Target.Carrier} (VV.injection.apply) _ _
            (VVSign.involutive p ((C.differential.vertical p (Nat.Nat^::succ q)).apply ((C.differential.vertical p q).apply x))))
          (trans!{Target.Carrier} _ _ _
            (congr!{{C.family.Carrier p (Nat.Nat^::succ (Nat.Nat^::succ q))} Target.Carrier} (VV.injection.apply) _ _ (C.laws.verticalZero p q x))
            (VVMaps.zeroPreserved VV.injection)))));
\import Degrees.Sign[V := C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q), space := C.family.space (Nat.Nat^::succ p) (Nat.Nat^::succ q)] \as HVSign;
\import VSign.Mapping[W := C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q), target := C.family.space (Nat.Nat^::succ p) (Nat.Nat^::succ q)] \as HSignMap;
\definition mixed(x: C.family.Carrier p q): Target.Carrier :=
  HV.injection.apply ((HVSign.map p).apply ((C.differential.vertical (Nat.Nat^::succ p) q).apply ((C.differential.horizontal p q).apply x)));
\definition horizontalVertical: \forall (x: C.family.Carrier p q) ->
  Second.horizontal.apply (First.vertical.apply ((Source.Component[i := i].injection).apply x)) = mixed x :=
  \fun (x: C.family.Carrier p q) => trans!{Target.Carrier} _ _ _
    (congr!{Middle.Carrier Target.Carrier} (Second.horizontal.apply) _ _ (First.verticalOnInjection i x))
    (trans!{Target.Carrier} _ _ _ (Second.horizontalOnInjection vi ((VSign.map p).apply ((C.differential.vertical p q).apply x)))
      (trans!{Target.Carrier} _ _ _
        (congr!{{C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q)} Target.Carrier} (HV.injection.apply) _ _
          (HSignMap.naturality (C.differential.horizontal p (Nat.Nat^::succ q)) p ((C.differential.vertical p q).apply x)))
        (congr!{{C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q)} Target.Carrier}
          (\fun (z: C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q)) => HV.injection.apply ((HVSign.map p).apply z)) _ _ (C.laws.commute p q x))));
\definition verticalHorizontal: \forall (x: C.family.Carrier p q) ->
  Second.vertical.apply (First.horizontal.apply ((Source.Component[i := i].injection).apply x)) = Target.space.neg (mixed x) :=
  \fun (x: C.family.Carrier p q) => trans!{Target.Carrier} _ _ _
    (congr!{Middle.Carrier Target.Carrier} (Second.vertical.apply) _ _ (First.horizontalOnInjection i x))
    (trans!{Target.Carrier} _ _ _ (Second.verticalOnInjection hi ((C.differential.horizontal p q).apply x))
      (HVMaps.negativePreserved HV.injection
        ((HVSign.map p).apply ((C.differential.vertical (Nat.Nat^::succ p) q).apply ((C.differential.horizontal p q).apply x)))));
\definition antiCommutes: \forall (x: C.family.Carrier p q) ->
  Second.horizontal.apply (First.vertical.apply ((Source.Component[i := i].injection).apply x)) =
  Target.space.neg (Second.vertical.apply (First.horizontal.apply ((Source.Component[i := i].injection).apply x))) :=
  \fun (x: C.family.Carrier p q) => trans!{Target.Carrier} _ _ _ (horizontalVertical x)
    (trans!{Target.Carrier} _ _ _ (sym!{Target.Carrier} _ _ (Additive.negNeg (mixed x)))
      (congr!{Target.Carrier Target.Carrier} (Target.space.neg) _ _ (sym!{Target.Carrier} _ _ (verticalHorizontal x))));
