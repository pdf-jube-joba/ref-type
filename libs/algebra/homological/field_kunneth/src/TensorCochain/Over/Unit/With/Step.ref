\import \parent.At[n := n] \as A;
\import \parent.At[n := Nat.Nat^::succ n] \as B;
\import Total.Degree[n := n] \as Source;
\import Total.Degree[n := Nat.Nat^::succ n] \as Target;
\import Total.Step[n := n] \as Step;
\import Product.Term[p := Nat.Nat^::zero, q := n] \as Tensor;
\import Product.Term[p := Nat.Nat^::succ Nat.Nat^::zero, q := n] \as HTerm;
\import Product.Term[p := Nat.Nat^::zero, q := Nat.Nat^::succ n] \as VTerm;
\import Product.At[p := Nat.Nat^::zero, q := n] \as Differential;
\import Modules.Hom[V := HTerm.Carrier, W := Target.Carrier,
  source := HTerm.space, target := Target.space] \as HMaps;
\definition horizontal: \forall (x: C.family.Carrier n) ->
  #apply{Step.horizontal} (#apply{A.backward} x) = #zero{Target.space} :=
  \fun (x: C.family.Carrier n) => trans!{Target.Carrier} _ _ _
    (Step.horizontalOnInjection A.point (Tensor.tensor one x))
    (trans!{Target.Carrier} _ _ _
      (congr!{HTerm.Carrier Target.Carrier}
        (#apply{(Target.Component[i := Total.upHorizontal n A.point].injection)}) _ _
        (trans!{HTerm.Carrier} _ _ _ (Differential.horizontalOnTensor one x) (HTerm.zeroLeft x)))
      (HMaps.zeroPreserved (Target.Component[i := Total.upHorizontal n A.point].injection)));
\definition vertical: \forall (x: C.family.Carrier n) ->
  #apply{Step.vertical} (#apply{A.backward} x) = #apply{B.backward} (#apply{C.differential} n x) :=
  \fun (x: C.family.Carrier n) => trans!{Target.Carrier} _ _ _
    (Step.verticalOnInjection A.point (Tensor.tensor one x))
    (congr!{VTerm.Carrier Target.Carrier} (#apply{(Target.Component[i := B.point].injection)}) _ _
      (Differential.verticalOnTensor one x));
\import Modules.Laws[V := Target.Carrier, space := Target.space] \as Vector;
\import algebra.Group[].Of[Carrier := Target.Carrier, group := Vector.additive] \as Group;
\definition commutes: \forall (x: C.family.Carrier n) ->
  #apply{Total.differential} n (#apply{A.backward} x) = #apply{B.backward} (#apply{C.differential} n x) :=
  \fun (x: C.family.Carrier n) => trans!{Target.Carrier} _ _ _
    (congr2!{Target.Carrier Target.Carrier Target.Carrier} (#add{Target.space}) _ _ _ _ (horizontal x) (vertical x))
    (Group.zeroLeft (#apply{B.backward} (#apply{C.differential} n x)));
