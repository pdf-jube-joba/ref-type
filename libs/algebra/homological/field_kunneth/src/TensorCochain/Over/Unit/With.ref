\import \parent.\parent.Tensor[C := complex, D := C] \as Product;
\import \parent.\parent.Total[C := Product.complex] \as Total;
\import commutative_algebra.Modules[R := R, ring := ring] \as Commutative;
\module At(n: Nat.Nat^);
\module Step(n: Nat.Nat^);
\import Cochains.Map[C := C, D := Total.complex] \as Injections;
\definition injection: Injections.Map := Injections.Map {
  apply := \fun (n: Nat.Nat^) => #apply{(At[n := n].backward)},
  addition := \fun (n: Nat.Nat^) => #addition{(At[n := n].backward)},
  scalar := \fun (n: Nat.Nat^) => #scalar{(At[n := n].backward)},
  commutes := \fun (n: Nat.Nat^) => Step[n := n].commutes,
};
\import Cochains.Map[C := Total.complex, D := C] \as Contractions;
\module ContractionStep(n: Nat.Nat^) {
  \import \parent.At[n := n] \as A;
  \import \parent.At[n := Nat.Nat^::succ n] \as B;
  \definition commutes: \forall (x: Total.family.Carrier n) ->
    #apply{C.differential} n (#apply{A.forward} x) = #apply{B.forward} (#apply{Total.differential} n x) :=
    \fun (x: Total.family.Carrier n) => trans!{{C.family.Carrier (Nat.Nat^::succ n)}} _ _ _
      (sym!{{C.family.Carrier (Nat.Nat^::succ n)}} _ _ (#rightInverse{B.isomorphism} (#apply{C.differential} n (#apply{A.forward} x))))
      (trans!{{C.family.Carrier (Nat.Nat^::succ n)}} _ _ _
        (congr!{{Total.family.Carrier (Nat.Nat^::succ n)} {C.family.Carrier (Nat.Nat^::succ n)}} (#apply{B.forward}) _ _
          (sym!{{Total.family.Carrier (Nat.Nat^::succ n)}} _ _ (#commutes{injection} n (#apply{A.forward} x))))
        (congr!{{Total.family.Carrier n} {C.family.Carrier (Nat.Nat^::succ n)}}
          (\fun (y: Total.family.Carrier n) => #apply{B.forward} (#apply{Total.differential} n y))
          _ _ (#leftInverse{A.isomorphism} x)));
}
\definition contraction: Contractions.Map := Contractions.Map {
  apply := \fun (n: Nat.Nat^) => #apply{(At[n := n].forward)},
  addition := \fun (n: Nat.Nat^) => #addition{(At[n := n].forward)},
  scalar := \fun (n: Nat.Nat^) => #scalar{(At[n := n].forward)},
  commutes := \fun (n: Nat.Nat^) => ContractionStep[n := n].commutes,
};
\module Cohomology(n: Nat.Nat^);
\module RightCohomology(n: Nat.Nat^);
