\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Tensor[C := complex, D := C] \as Product;
\import \parent.\parent.Total[C := Product.complex] \as Total;
\import commutative_algebra.Modules[R := R, ring := ring] \as Commutative;
\module At(n: Nat.Nat^);
\module Step(n: Nat.Nat^);
\import Cochains.Map[C := C, D := Total.complex] \as Injections;
\definition injection: Injections.Map := Injections.Map {
  apply := \fun (n: Nat.Nat^) => (At[n := n].backward).apply,
  addition := \fun (n: Nat.Nat^) => (At[n := n].backward).addition,
  scalar := \fun (n: Nat.Nat^) => (At[n := n].backward).scalar,
  commutes := \fun (n: Nat.Nat^) => Step[n := n].commutes,
};
\import Cochains.Map[C := Total.complex, D := C] \as Contractions;
\module ContractionStep(n: Nat.Nat^) {
  \import \parent.At[n := n] \as A;
  \import \parent.At[n := Nat.Nat^::succ n] \as B;
  \definition commutes: \forall (x: Total.family.Carrier n) ->
    C.differential.apply n (A.forward.apply x) = B.forward.apply (Total.differential.apply n x) :=
    \fun (x: Total.family.Carrier n) => eq_reason_in!{{C.family.Carrier (Nat.Nat^::succ n)} _
      "=" _ "by" { sym!{{C.family.Carrier (Nat.Nat^::succ n)}} _ _ (B.isomorphism.rightInverse (C.differential.apply n (A.forward.apply x))) }
      "=" _ "by" { congr!{{Total.family.Carrier (Nat.Nat^::succ n)} {C.family.Carrier (Nat.Nat^::succ n)}} (B.forward.apply) _ _
          (sym!{{Total.family.Carrier (Nat.Nat^::succ n)}} _ _ (injection.commutes n (A.forward.apply x))) }
      "=" _ "by" { congr!{{Total.family.Carrier n} {C.family.Carrier (Nat.Nat^::succ n)}}
          (\fun (y: Total.family.Carrier n) => B.forward.apply (Total.differential.apply n y))
          _ _ (A.isomorphism.leftInverse x) }
    };
}
\definition contraction: Contractions.Map := Contractions.Map {
  apply := \fun (n: Nat.Nat^) => (At[n := n].forward).apply,
  addition := \fun (n: Nat.Nat^) => (At[n := n].forward).addition,
  scalar := \fun (n: Nat.Nat^) => (At[n := n].forward).scalar,
  commutes := \fun (n: Nat.Nat^) => ContractionStep[n := n].commutes,
};
\module Cohomology(n: Nat.Nat^);
\module RightCohomology(n: Nat.Nat^);
