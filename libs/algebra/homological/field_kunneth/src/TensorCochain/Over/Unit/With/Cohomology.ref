\import \parent.At[n := n] \as Term;
\import Cochains.At[C := Total.complex, k := n] \as TH;
\import Cochains.At[C := C, k := n] \as H;
\import Contractions.At[k := n] \as F;
\import Injections.At[k := n] \as G;
\definition leftInverse: \forall (h: TH.Cohomology) ->
  (G.induced injection).apply ((F.induced contraction).apply h) = h :=
  TH.classInduction
    (\fun (h: TH.Cohomology) => (G.induced injection).apply ((F.induced contraction).apply h) = h)
    (\fun (x: TH.CycleCarrier) => trans!{TH.Cohomology} _ _ _
      (congr!{H.Cohomology TH.Cohomology} ((G.induced injection).apply) _ _ (F.onClass contraction x))
      (trans!{TH.Cohomology} _ _ _ (G.onClass injection ((F.cyclesMap contraction).apply x))
        (TH.equalClass ((G.cyclesMap injection).apply ((F.cyclesMap contraction).apply x)) x
          (Term.isomorphism.leftInverse x))));
\definition rightInverse: \forall (h: H.Cohomology) ->
  (F.induced contraction).apply ((G.induced injection).apply h) = h :=
  H.classInduction
    (\fun (h: H.Cohomology) => (F.induced contraction).apply ((G.induced injection).apply h) = h)
    (\fun (x: H.CycleCarrier) => trans!{H.Cohomology} _ _ _
      (congr!{TH.Cohomology H.Cohomology} ((F.induced contraction).apply) _ _ (G.onClass injection x))
      (trans!{H.Cohomology} _ _ _ (F.onClass contraction ((G.cyclesMap injection).apply x))
        (H.equalClass ((F.cyclesMap contraction).apply ((G.cyclesMap injection).apply x)) x
          (Term.isomorphism.rightInverse x))));
\import Modules.Isomorphism[V := TH.Cohomology, W := H.Cohomology,
  source := TH.cohomologySpace, target := H.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := F.induced contraction, backward := G.induced injection,
  leftInverse := leftInverse, rightInverse := rightInverse,
};
\import Cochains.At[C := complex, k := Nat.Nat^::zero] \as UH;
\definition unitCycle: UH.CycleCarrier := UH.cycle one (\refl((family.space (Nat.Nat^::succ Nat.Nat^::zero)).zero));
\definition unitClass: UH.Cohomology := UH.classOf unitCycle;
\import \parent.\parent.\parent.IndexedExterior[C := complex, D := C, n := n].At[i := Term.point] \as Exterior;
\import Modules.Tensor[V := UH.Cohomology, W := H.Cohomology,
  left := UH.cohomologySpace, right := H.cohomologySpace] \as Tensor;
\import \parent.\parent.\parent.IndexedCycleProduct[C := complex, D := C, n := n].At[i := Term.point] \as Cycles;
\definition exteriorUnit: \forall (h: H.Cohomology) ->
  isomorphism.forward.apply (Exterior.map.apply (Tensor.tensor unitClass h)) = h :=
  H.classInduction
    (\fun (h: H.Cohomology) => isomorphism.forward.apply (Exterior.map.apply (Tensor.tensor unitClass h)) = h)
    (\fun (x: H.CycleCarrier) => trans!{H.Cohomology} _ _ _
      (congr!{TH.Cohomology H.Cohomology} (isomorphism.forward.apply) _ _ (Exterior.onClass unitCycle x))
      (trans!{H.Cohomology} _ _ _ (F.onClass contraction (Cycles.cycle unitCycle x))
        (H.equalClass ((F.cyclesMap contraction).apply (Cycles.cycle unitCycle x)) x
          (Term.isomorphism.rightInverse x))));
\definition onUnitClass: \forall (x: H.CycleCarrier) ->
  isomorphism.forward.apply (Cycles.classOf unitCycle x) = H.classOf x :=
  \fun (x: H.CycleCarrier) => trans!{H.Cohomology} _ _ _
    (F.onClass contraction (Cycles.cycle unitCycle x))
    (H.equalClass ((F.cyclesMap contraction).apply (Cycles.cycle unitCycle x)) x
      (Term.isomorphism.rightInverse x));
