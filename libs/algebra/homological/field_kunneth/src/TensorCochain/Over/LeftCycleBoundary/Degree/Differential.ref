\use std.Logic[].Equality[].eq_reason_in;
\definition horizontal: \forall (a: C.family.Carrier p)(y: Right.CycleCarrier) ->
  Step.horizontal.apply (lift a y) = HInclusion.injection.apply (HTerm.tensor (C.differential.apply p a) y) :=
  \fun (a: C.family.Carrier p)(y: Right.CycleCarrier) => trans!{Current.Carrier} _ _ _
    (Step.horizontalOnInjection index (Term.tensor a y))
    (congr!{HTerm.Carrier Current.Carrier} (HInclusion.injection.apply) _ _ (Differential.horizontalOnTensor a y));
\definition vertical: \forall (a: C.family.Carrier p)(y: Right.CycleCarrier) ->
  Step.vertical.apply (lift a y) = Current.space.zero :=
  \fun (a: C.family.Carrier p)(y: Right.CycleCarrier) => eq_reason_in!{Current.Carrier _
    "=" _ "by" { Step.verticalOnInjection index (Term.tensor a y) }
    "=" _ "by" { congr!{VTerm.Carrier Current.Carrier} (\fun (v: VTerm.Carrier) => VInclusion.injection.apply ((Sign.map p).apply v)) _ _
        (eq_reason_in!{VTerm.Carrier _
          "=" _ "by" { Differential.verticalOnTensor a y }
          "=" _ "by" { congr!{{D.family.Carrier (Nat.Nat^::succ q)} VTerm.Carrier} (VTerm.tensor a) _ _
              (\bysub(D.family.Carrier q, Right.cycles.carrier, y)) }
          "=" _ "by" { VTerm.zeroRight a }
        }) }
    "=" _ "by" { congr!{VTerm.Carrier Current.Carrier} (VInclusion.injection.apply) _ _ (Signs.zeroPreserved (Sign.map p)) }
    "=" _ "by" { VMaps.zeroPreserved VInclusion.injection }
  };
\definition value: \forall (a: C.family.Carrier p)(y: Right.CycleCarrier) ->
  Total.differential.apply n (lift a y) = HInclusion.injection.apply (HTerm.tensor (C.differential.apply p a) y) :=
  \fun (a: C.family.Carrier p)(y: Right.CycleCarrier) => trans!{Current.Carrier} _ _ _
    (congr!{Current.Carrier Current.Carrier Current.Carrier} (Current.space.add)
      _ _ _ _
      (horizontal a y) (vertical a y))
    (Group.zeroRight (HInclusion.injection.apply (HTerm.tensor (C.differential.apply p a) y)));
