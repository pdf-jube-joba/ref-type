\import Cochains.ZeroDifferential[family := left] \as Left;
\import Cochains.ZeroDifferential[family := right] \as Right;
\import \parent.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import \parent.Total[C := Tensor.complex] \as Total;
\module Step(n: Nat.Nat^);
\definition differentialZero: \forall (n: Nat.Nat^)(x: Total.family.Carrier n) ->
  Total.differential.apply n x = (Total.family.space (Nat.Nat^::succ n)).zero :=
  \fun (n: Nat.Nat^) => Step[n := n].zero;
\import Cochains.ZeroCriterion[C := Total.complex] \as Criterion;
\module At(n: Nat.Nat^) {
  \import Cochains.At[C := Total.complex, k := n] \as H;
  \import Criterion.At[n := n] \as Comparison;
  \definition isomorphism: Modules.Isomorphism[V := Total.family.Carrier n, W := H.Cohomology,
    source := Total.family.space n, target := H.cohomologySpace].Isomorphism := Comparison.termIsomorphism differentialZero;
  \import Cochains.ZeroDifferential[family := Total.family] \as Z;
  \import Cochains.At[C := Z.complex, k := n] \as ZH;
  \import Cochains.Map[C := Z.complex, D := Total.complex].At[k := n] \as Induced;
  \definition zeroCycle[x: Total.family.Carrier n]: ZH.CycleCarrier :=
    ZH.cycle x (\refl((Total.family.space (Nat.Nat^::succ n)).zero));
  \definition onTerm: \forall (x: Total.family.Carrier n) ->
    isomorphism.forward.apply x = H.classOf (H.cycle x (differentialZero n x)) :=
    \fun (x: Total.family.Carrier n) => trans!{H.Cohomology} _ _ _
      (Induced.onClass (Criterion.forward differentialZero) (zeroCycle x))
      (H.equalClass
        ((Induced.cyclesMap (Criterion.forward differentialZero)).apply (zeroCycle x))
        (H.cycle x (differentialZero n x)) (\refl(x)));
}
