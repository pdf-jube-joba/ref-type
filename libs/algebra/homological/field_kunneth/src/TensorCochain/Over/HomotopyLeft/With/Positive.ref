\definition next: Nat.Nat^ := Nat.Nat^::succ p;
\import SourceTensor.Term[p := next, q := q] \as Source;
\import SourceTensor.Term[p := Nat.Nat^::succ next, q := q] \as AfterSource;
\import TargetTensor.Term[p := p, q := q] \as BeforeTarget;
\import TargetTensor.Term[p := next, q := q] \as Target;
\import SourceTensor.At[p := next, q := q] \as SD;
\import TargetTensor.At[p := p, q := q] \as TD;
\import \parent.Term[p := p, q := q] \as BeforeH;
\import \parent.Term[p := next, q := q] \as AfterH;
\import Forward.Degree[p := next, q := q] \as F;
\import Backward.Degree[p := next, q := q] \as G;
\import Modules.Tensor[V := D.family.Carrier next, W := E.family.Carrier q, left := D.family.space next, right := E.family.space q] \as TargetTensorModule;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
\import Modules.Hom[V := BeforeTarget.Carrier, W := Target.Carrier, source := BeforeTarget.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as DH;
\import Modules.Hom[V := AfterSource.Carrier, W := Target.Carrier, source := AfterSource.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as HD;
\import Modules.Tensor[V := C.family.Carrier next, W := E.family.Carrier q, left := C.family.space next, right := E.family.space q].Universal[
  U := Target.Carrier, target := Target.space] \as Universal;
\definition horizontalBefore: \forall (x: C.family.Carrier next)(y: E.family.Carrier q) ->
  #apply{TD.horizontal} (#apply{BeforeH.map} (Source.tensor x y)) = Target.tensor (#apply{D.differential} p (#apply{(h p)} x)) y :=
  \fun (x: C.family.Carrier next)(y: E.family.Carrier q) => trans!{Target.Carrier} _ _ _
    (congr!{BeforeTarget.Carrier Target.Carrier} (#apply{TD.horizontal}) _ _ (BeforeH.onTensor x y)) (TD.horizontalOnTensor (#apply{(h p)} x) y);
\definition horizontalAfter: \forall (x: C.family.Carrier next)(y: E.family.Carrier q) ->
  #apply{AfterH.map} (#apply{SD.horizontal} (Source.tensor x y)) = Target.tensor (#apply{(h next)} (#apply{C.differential} next x)) y :=
  \fun (x: C.family.Carrier next)(y: E.family.Carrier q) => trans!{Target.Carrier} _ _ _
    (congr!{AfterSource.Carrier Target.Carrier} (#apply{AfterH.map}) _ _ (SD.horizontalOnTensor x y)) (AfterH.onTensor (#apply{C.differential} next x) y);
\definition equality: Maps.plus F.map (Maps.negative G.map) = Maps.plus (DH.compose TD.horizontal BeforeH.map) (HD.compose AfterH.map SD.horizontal) :=
  Universal.ext (Maps.plus F.map (Maps.negative G.map)) (Maps.plus (DH.compose TD.horizontal BeforeH.map) (HD.compose AfterH.map SD.horizontal))
    (\fun (x: C.family.Carrier next)(y: E.family.Carrier q) => trans!{Target.Carrier} _ _ _
      (congr2!{Target.Carrier Target.Carrier Target.Carrier} (\fun (a, b: Target.Carrier) => #add{Target.space} a (#neg{Target.space} b)) _ _ _ _ (F.onTensor x y) (G.onTensor x y))
      (trans!{Target.Carrier} _ _ _ (sym!{Target.Carrier} _ _ (TargetTensorModule.tensorDifferenceLeft (#apply{f} next x) (#apply{g} next x) y))
        (trans!{Target.Carrier} _ _ _
          (congr!{{D.family.Carrier next} Target.Carrier} (\fun (z: D.family.Carrier next) => Target.tensor z y) _ _ (#positive{laws} p x))
          (trans!{Target.Carrier} _ _ _
            (#addLeft{TargetTensorModule.bilinear} (#apply{D.differential} p (#apply{(h p)} x)) (#apply{(h next)} (#apply{C.differential} next x)) y)
            (congr2!{Target.Carrier Target.Carrier Target.Carrier} (#add{Target.space}) _ _ _ _
              (sym!{Target.Carrier} _ _ (horizontalBefore x y)) (sym!{Target.Carrier} _ _ (horizontalAfter x y)))))));
\definition point: \forall (x: Source.Carrier) -> #add{Target.space} (#apply{F.map} x) (#neg{Target.space} (#apply{G.map} x)) =
  #add{Target.space} (#apply{TD.horizontal} (#apply{BeforeH.map} x)) (#apply{AfterH.map} (#apply{SD.horizontal} x)) :=
  \fun (x: Source.Carrier) => congr!{Maps.Map Target.Carrier} (\fun (m: Maps.Map) => #apply{m} x) _ _ equality;
