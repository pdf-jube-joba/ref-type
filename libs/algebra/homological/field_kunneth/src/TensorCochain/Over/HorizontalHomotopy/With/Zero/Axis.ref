\use std.Logic[].Equality[].eq_reason_in;
\definition i: Source.Index zero := Degrees.index zero zero q;
\definition hi: Source.Index one := Source.upHorizontal zero i;
\definition vi: Source.Index one := Source.upVertical zero i;
\import TD.Component[i := i] \as Injection;
\import Modules.Hom[V := D.family.Carrier zero q, W := TD.Carrier, source := D.family.space zero q, target := TD.space] \as Injections;
\definition core[x: C.family.Carrier zero q]: TD.Carrier :=
  Injection.injection.apply ((h zero q).apply ((C.differential.horizontal zero q).apply x));
\definition differenceValue: \forall (x: C.family.Carrier zero q) ->
  difference.apply ((SD.Component[i := i].injection).apply x) = core x :=
  \fun (x: C.family.Carrier zero q) => eq_reason_in!{TD.Carrier _
    "=" _ "by" { congr!{TD.Carrier TD.Carrier TD.Carrier} Group.difference _ _ _ _ (F.onInjection i x) (G.onInjection i x) }
    "=" _ "by" { sym!{TD.Carrier} _ _ (Injections.differencePreserved Injection.injection ((f zero q).apply x) ((g zero q).apply x)) }
    "=" _ "by" { congr!{{D.family.Carrier zero q} TD.Carrier} (Injection.injection.apply) _ _ (laws.degreeZero q x) }
  };
\definition horizontalValue: \forall (x: C.family.Carrier zero q) ->
  H.map.apply (SS.horizontal.apply ((SD.Component[i := i].injection).apply x)) = core x :=
  \fun (x: C.family.Carrier zero q) => trans!{TD.Carrier} _ _ _
    (congr!{SN.Carrier TD.Carrier} (H.map.apply) _ _ (SS.horizontalOnInjection i x))
    (H.onInjection hi ((C.differential.horizontal zero q).apply x));
\import Degrees.Sign[V := C.family.Carrier zero (Nat.Nat^::succ q), space := C.family.space zero (Nat.Nat^::succ q)] \as Sign;
\definition verticalZero: \forall (x: C.family.Carrier zero q) ->
  H.map.apply (SS.vertical.apply ((SD.Component[i := i].injection).apply x)) = TD.space.zero :=
  \fun (x: C.family.Carrier zero q) => trans!{TD.Carrier} _ _ _
    (congr!{SN.Carrier TD.Carrier} (H.map.apply) _ _ (SS.verticalOnInjection i x))
    (H.onInjection vi ((Sign.map zero).apply ((C.differential.vertical zero q).apply x)));
\definition equality: \forall (x: C.family.Carrier zero q) ->
  difference.apply ((SD.Component[i := i].injection).apply x) = after.apply ((SD.Component[i := i].injection).apply x) :=
  \fun (x: C.family.Carrier zero q) => trans!{TD.Carrier} _ _ _ (differenceValue x)
    (sym!{TD.Carrier} _ _ (eq_reason_in!{TD.Carrier _
      "=" _ "by" { H.map.addition (SS.horizontal.apply ((SD.Component[i := i].injection).apply x)) (SS.vertical.apply ((SD.Component[i := i].injection).apply x)) }
      "=" _ "by" { congr!{TD.Carrier TD.Carrier TD.Carrier} (TD.space.add) _ _ _ _ (horizontalValue x) (verticalZero x) }
      "=" _ "by" { Group.zeroRight (core x) }
    }));
