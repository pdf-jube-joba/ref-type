\definition i: Source.Index current := Degrees.index current (Nat.Nat^::succ p) q;
\definition low: Source.Index n := Degrees.index n p (PreviousH.lower p q);
\definition hi: Source.Index next := Source.upHorizontal current i;
\definition vi: Source.Index next := Source.upVertical current i;
\definition mixed: Source.Index current := Target.upVertical n low;
\import TD.Component[i := i] \as Injection;
\import TD.Component[i := mixed] \as MixedInjection;
\import Modules.Hom[V := D.family.Carrier (Nat.Nat^::succ p) q, W := TD.Carrier,
  source := D.family.space (Nat.Nat^::succ p) q, target := TD.space] \as Injections;
\import Modules.Hom[V := D.family.Carrier p (Nat.Nat^::succ q), W := TD.Carrier,
  source := D.family.space p (Nat.Nat^::succ q), target := TD.space] \as MixedInjections;
\definition horizontalAfterValue: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  horizontalAfter.apply ((SD.Component[i := i].injection).apply x) =
    Injection.injection.apply ((D.differential.horizontal p q).apply ((h p q).apply x)) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{TD.Carrier} _ _ _
    (congr!{TP.Carrier TD.Carrier} (TS.horizontal.apply) _ _ (PreviousH.onInjection i x))
    (TS.horizontalOnInjection low ((h p q).apply x));
\definition horizontalBeforeValue: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  horizontalBefore.apply ((SD.Component[i := i].injection).apply x) =
    Injection.injection.apply ((h (Nat.Nat^::succ p) q).apply ((C.differential.horizontal (Nat.Nat^::succ p) q).apply x)) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{TD.Carrier} _ _ _
    (congr!{SN.Carrier TD.Carrier} (NextH.map.apply) _ _ (SS.horizontalOnInjection i x))
    (NextH.onInjection hi ((C.differential.horizontal (Nat.Nat^::succ p) q).apply x));
\definition horizontal: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  difference.apply ((SD.Component[i := i].injection).apply x) =
    Group.add (horizontalAfter.apply ((SD.Component[i := i].injection).apply x))
      (horizontalBefore.apply ((SD.Component[i := i].injection).apply x)) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{TD.Carrier} _ _ _
    (congr2!{TD.Carrier TD.Carrier TD.Carrier} Group.difference _ _ _ _ (F.onInjection i x) (G.onInjection i x))
    (trans!{TD.Carrier} _ _ _
      (sym!{TD.Carrier} _ _ (Injections.differencePreserved Injection.injection ((f (Nat.Nat^::succ p) q).apply x) ((g (Nat.Nat^::succ p) q).apply x)))
      (trans!{TD.Carrier} _ _ _
        (congr!{{D.family.Carrier (Nat.Nat^::succ p) q} TD.Carrier} (Injection.injection.apply) _ _ (laws.positive p q x))
        (trans!{TD.Carrier} _ _ _
          (Injection.injection.addition ((D.differential.horizontal p q).apply ((h p q).apply x))
            ((h (Nat.Nat^::succ p) q).apply ((C.differential.horizontal (Nat.Nat^::succ p) q).apply x)))
          (congr2!{TD.Carrier TD.Carrier TD.Carrier} Group.add _ _ _ _
            (sym!{TD.Carrier} _ _ (horizontalAfterValue x)) (sym!{TD.Carrier} _ _ (horizontalBeforeValue x))))));
\import Degrees.Sign[V := C.family.Carrier (Nat.Nat^::succ p) (Nat.Nat^::succ q), space := C.family.space (Nat.Nat^::succ p) (Nat.Nat^::succ q)] \as SourceSign;
\import Degrees.Sign[V := D.family.Carrier p (Nat.Nat^::succ q), space := D.family.space p (Nat.Nat^::succ q)] \as TargetSign;
\import SourceSign.Mapping[W := D.family.Carrier p (Nat.Nat^::succ q), target := D.family.space p (Nat.Nat^::succ q)] \as SignMapping;
\definition verticalValue(x: C.family.Carrier (Nat.Nat^::succ p) q): TD.Carrier :=
  MixedInjection.injection.apply ((TargetSign.map p).apply ((D.differential.vertical p q).apply ((h p q).apply x)));
\definition verticalAfterValue: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  verticalAfter.apply ((SD.Component[i := i].injection).apply x) = verticalValue x :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{TD.Carrier} _ _ _
    (congr!{TP.Carrier TD.Carrier} (TS.vertical.apply) _ _ (PreviousH.onInjection i x))
    (TS.verticalOnInjection low ((h p q).apply x));
\definition vertical: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
  verticalBefore.apply ((SD.Component[i := i].injection).apply x) =
    TD.space.neg (verticalAfter.apply ((SD.Component[i := i].injection).apply x)) :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{TD.Carrier} _ _ _
    (congr!{SN.Carrier TD.Carrier} (NextH.map.apply) _ _ (SS.verticalOnInjection i x))
    (trans!{TD.Carrier} _ _ _
      (NextH.onInjection vi ((SourceSign.map (Nat.Nat^::succ p)).apply ((C.differential.vertical (Nat.Nat^::succ p) q).apply x)))
      (trans!{TD.Carrier} _ _ _
        (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TD.Carrier} (MixedInjection.injection.apply) _ _
          (SignMapping.naturality (h p (Nat.Nat^::succ q)) (Nat.Nat^::succ p) ((C.differential.vertical (Nat.Nat^::succ p) q).apply x)))
        (trans!{TD.Carrier} _ _ _
          (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TD.Carrier} (MixedInjection.injection.apply) _ _
            (TargetSign.successor p ((h p (Nat.Nat^::succ q)).apply ((C.differential.vertical (Nat.Nat^::succ p) q).apply x))))
          (trans!{TD.Carrier} _ _ _
            (congr!{{D.family.Carrier p (Nat.Nat^::succ q)} TD.Carrier}
              (\fun (z: D.family.Carrier p (Nat.Nat^::succ q)) => MixedInjection.injection.apply ((D.family.space p (Nat.Nat^::succ q)).neg ((TargetSign.map p).apply z))) _ _
              (sym!{{D.family.Carrier p (Nat.Nat^::succ q)}} _ _ (laws.vertical p q x)))
            (trans!{TD.Carrier} _ _ _
              (MixedInjections.negativePreserved MixedInjection.injection ((TargetSign.map p).apply ((D.differential.vertical p q).apply ((h p q).apply x))))
              (congr!{TD.Carrier TD.Carrier} (TD.space.neg) _ _ (sym!{TD.Carrier} _ _ (verticalAfterValue x))))))));
