\import Cochains.At[C := D, k := p] \as TC;
\import Cochains.At[C := F, k := q] \as TF;
\import Cochains.At[C := SourceTotal.complex, k := n] \as HS;
\import \parent.\parent.\parent.CycleProductRightDescent[C := C, D := E, p := p, q := q] \as SourceDescent;
\import \parent.\parent.\parent.CycleProductRightDescent[C := D, D := F, p := p, q := q] \as TargetDescent;
\import Modules.Tensor[V := SC.CycleCarrier, W := SE.Cohomology,
  left := SC.cycleSpace, right := SE.cohomologySpace] \as S;
\import Modules.Tensor[V := TC.CycleCarrier, W := TF.Cohomology,
  left := TC.cycleSpace, right := TF.cohomologySpace] \as T;
\import S.Mapping[U := TC.CycleCarrier, Z := TF.Cohomology,
  targetLeft := TC.cycleSpace, targetRight := TF.cohomologySpace] \as Components;
\definition map: Modules.Hom[V := S.Carrier, W := T.Carrier, source := S.space, target := T.space].Map :=
  Components.map (Left.cyclesMap f) (Right.induced g);
\import Modules.Hom[V := HS.Cohomology, W := H.Cohomology,
  source := HS.cohomologySpace, target := H.cohomologySpace].Composition[
  U := S.Carrier, domain := S.space] \as After;
\import Modules.Hom[V := T.Carrier, W := H.Cohomology,
  source := T.space, target := H.cohomologySpace].Composition[
  U := S.Carrier, domain := S.space] \as Before;
\import Modules.Hom[V := S.Carrier, W := H.Cohomology,
  source := S.space, target := H.cohomologySpace] \as Maps;
\definition after: Maps.Map := After.compose (Induced.induced TensorMap.total) SourceDescent.map;
\definition before: Maps.Map := Before.compose TargetDescent.map map;
\definition afterOnClass: \forall (x: SC.CycleCarrier)(y: SE.CycleCarrier) ->
  after.apply (S.tensor x (SE.classOf y)) =
  Target.classOf ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y) :=
  \fun (x: SC.CycleCarrier)(y: SE.CycleCarrier) => trans!{H.Cohomology}
    _ _ _
    (congr!{HS.Cohomology H.Cohomology} ((Induced.induced TensorMap.total).apply) _ _ (SourceDescent.onTensor x y))
    (onClass x y);
\definition beforeOnClass: \forall (x: SC.CycleCarrier)(y: SE.CycleCarrier) ->
  before.apply (S.tensor x (SE.classOf y)) =
  Target.classOf ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y) :=
  \fun (x: SC.CycleCarrier)(y: SE.CycleCarrier) => trans!{H.Cohomology}
    _ _ _
    (congr!{T.Carrier H.Cohomology} (TargetDescent.map.apply) _ _
      (Components.onTensor (Left.cyclesMap f) (Right.induced g) x (SE.classOf y)))
    (trans!{H.Cohomology} _ _ _
      (congr!{TF.Cohomology H.Cohomology}
        (\fun (h: TF.Cohomology) => TargetDescent.map.apply (T.tensor ((Left.cyclesMap f).apply x) h)) _ _ (Right.onClass g y))
      (TargetDescent.onTensor ((Left.cyclesMap f).apply x) ((Right.cyclesMap g).apply y)));
\import S.Universal[U := H.Cohomology, target := H.cohomologySpace] \as Universal;
\definition naturality: after = before := Universal.ext after before
  (\fun (x: SC.CycleCarrier) => SE.classInduction
    (\fun (h: SE.Cohomology) => after.apply (S.tensor x h) = before.apply (S.tensor x h))
    (\fun (y: SE.CycleCarrier) => trans!{H.Cohomology}
      _ _ _
      (afterOnClass x y) (sym!{H.Cohomology} _ _ (beforeOnClass x y))));
