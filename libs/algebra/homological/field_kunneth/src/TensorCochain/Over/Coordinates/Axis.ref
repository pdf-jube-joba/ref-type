\import Total.Degree[n := n] \as Source;
\import Total.Degree[n := Nat.Nat^::succ n] \as Target;
\import Total.Step[n := n] \as Differential;
\import \parent.Degree[n := Nat.Nat^::succ n] \as TC;
\definition U: \Set := C.family.Carrier (j).first (j).second;
\definition targetSpace: Modules.Space U := C.family.space (j).first (j).second;
\import Modules.Hom[V := Source.Carrier, W := U, source := Source.space, target := targetSpace] \as Maps;
\import Modules.Hom[V := Target.Carrier, W := U, source := Target.space, target := targetSpace].Composition[U := Source.Carrier, domain := Source.space] \as Compose;
\import Modules.DirectSum[Index := Degrees.Index n, family := Source.family].To[W := U, target := targetSpace] \as Universal;
\definition horizontal: Maps.Map := Compose.compose (TC.At[i := j].map) Differential.horizontal;
\definition horizontalDifferent[k: Degrees.Index n][zero: (j).first = Nat.Nat^::zero]: Logic.Not (Total.upHorizontal n k = j) :=
  \fun (same: Total.upHorizontal n k = j) => Natural.succNeZero (k).first (trans!{Nat.Nat^} _ _ _ (congr!{Degrees.Pair Nat.Nat^} (\fun (i: Degrees.Pair) => (i).first) _ _ same) zero);
\definition horizontalOnInjection[zero: (j).first = Nat.Nat^::zero][k: Degrees.Index n][x: C.family.Carrier (k).first (k).second]: (horizontal).apply ((Source.Component[i := k].injection).apply x) = (Maps.zeroMap).apply ((Source.Component[i := k].injection).apply x) :=
  trans!{U} _ _ _ (congr!{Target.Carrier U} (TC.coordinate j) _ _ (Differential.horizontalOnInjection k x))
    (TC.other (Total.upHorizontal n k) j ((C.differential.horizontal (k).first (k).second).apply x) (horizontalDifferent k zero));
\definition horizontalEquation[zero: (j).first = Nat.Nat^::zero]: horizontal = Maps.zeroMap := Universal.ext horizontal Maps.zeroMap (horizontalOnInjection zero);
\definition horizontalZero[zero: (j).first = Nat.Nat^::zero][x: Source.Carrier]: TC.coordinate j ((Differential.horizontal).apply x) = (targetSpace).zero := congr!{Maps.Map U} (\fun (f: Maps.Map) => (f).apply x) _ _ (horizontalEquation zero);
\definition vertical: Maps.Map := Compose.compose (TC.At[i := j].map) Differential.vertical;
\definition verticalDifferent[k: Degrees.Index n][zero: (j).second = Nat.Nat^::zero]: Logic.Not (Total.upVertical n k = j) :=
  \fun (same: Total.upVertical n k = j) => Natural.succNeZero (k).second (trans!{Nat.Nat^} _ _ _ (congr!{Degrees.Pair Nat.Nat^} (\fun (i: Degrees.Pair) => (i).second) _ _ same) zero);
\definition verticalOnInjection[zero: (j).second = Nat.Nat^::zero][k: Degrees.Index n][x: C.family.Carrier (k).first (k).second]: (vertical).apply ((Source.Component[i := k].injection).apply x) = (Maps.zeroMap).apply ((Source.Component[i := k].injection).apply x) :=
  trans!{U} _ _ _ (congr!{Target.Carrier U} (TC.coordinate j) _ _ (Differential.verticalOnInjection k x))
    (TC.other (Total.upVertical n k) j ((Degrees.Sign[V := C.family.Carrier (k).first (Nat.Nat^::succ (k).second), space := C.family.space (k).first (Nat.Nat^::succ (k).second)].map (k).first).apply ((C.differential.vertical (k).first (k).second).apply x)) (verticalDifferent k zero));
\definition verticalEquation[zero: (j).second = Nat.Nat^::zero]: vertical = Maps.zeroMap := Universal.ext vertical Maps.zeroMap (verticalOnInjection zero);
\definition verticalZero[zero: (j).second = Nat.Nat^::zero][x: Source.Carrier]: TC.coordinate j ((Differential.vertical).apply x) = (targetSpace).zero := congr!{Maps.Map U} (\fun (f: Maps.Map) => (f).apply x) _ _ (verticalEquation zero);
