\definition targetIndex: Degrees.Index (Nat.Nat^::succ n) := Total.upHorizontal n i;
\definition U: \Set := C.family.Carrier (Nat.Nat^::succ (i).first) ((i).second);
\definition targetSpace: Modules.Space U := C.family.space (Nat.Nat^::succ (i).first) ((i).second);
\import Modules.Hom[V := C.family.Carrier (i).first (i).second, W := U, source := C.family.space (i).first (i).second, target := targetSpace] \as ComponentMaps;
\definition original: ComponentMaps.Map := C.differential.horizontal (i).first (i).second;
\import Modules.Hom[V := Source.Carrier, W := U, source := Source.space, target := targetSpace] \as Maps;
\import Modules.Hom[V := Target.Carrier, W := U, source := Target.space, target := targetSpace].Composition[U := Source.Carrier, domain := Source.space] \as After;
\import ComponentMaps.Composition[U := Source.Carrier, domain := Source.space] \as Before;
\definition lhs: Maps.Map := After.compose (TC.At[i := targetIndex].map) Differential.horizontal;
\definition rhs: Maps.Map := Before.compose original (SC.At[i := i].map);
\definition lower[k: Degrees.Pair]: Degrees.Pair := Degrees.Pair { first := Arithmetic.pred (k).first, second := (k).second };
\definition different[j: Degrees.Index n][ne: Logic.Not (j = i)]: Logic.Not (Total.upHorizontal n j = targetIndex) :=
  \fun (same: Total.upHorizontal n j = targetIndex) => ne (trans!{Degrees.Pair} _ _ _ (sym!{Degrees.Pair} _ _ (Degrees.pairRebuild j))
    (trans!{Degrees.Pair} _ _ _ (congr!{Degrees.Pair Degrees.Pair} lower _ _ same) (Degrees.pairRebuild i)));
\definition Property[j: Degrees.Index n]: \Prop := \forall (x: C.family.Carrier (j).first (j).second) -> (lhs).apply ((Source.Component[i := j].injection).apply x) = (rhs).apply ((Source.Component[i := j].injection).apply x);
\definition own: Property i := \fun (x: C.family.Carrier (i).first (i).second) => trans!{U} _ _ _
  (congr!{Target.Carrier U} (TC.coordinate targetIndex) _ _ (Differential.horizontalOnInjection i x))
  (trans!{U} _ _ _ (TC.own targetIndex ((original).apply x))
    (sym!{U} _ _ (congr!{{C.family.Carrier (i).first (i).second} U} ((original).apply) _ _ (SC.own i x))));
\definition other[j: Degrees.Index n][ne: Logic.Not (j = i)]: Property j := \fun (x: C.family.Carrier (j).first (j).second) => trans!{U} _ _ _
  (trans!{U} _ _ _ (congr!{Target.Carrier U} (TC.coordinate targetIndex) _ _ (Differential.horizontalOnInjection j x))
    (TC.other (Total.upHorizontal n j) targetIndex ((C.differential.horizontal (j).first (j).second).apply x) (different j ne)))
  (sym!{U} _ _ (trans!{U} _ _ _ (congr!{{C.family.Carrier (i).first (i).second} U} ((original).apply) _ _ (SC.other j i x ne)) (ComponentMaps.zeroPreserved original)));
\definition onInjection: \forall (j: Degrees.Index n) -> Property j := \fun (j: Degrees.Index n) => Logic.orElim (j = i) (Logic.Not (j = i)) (Property j) (Classical.excludedMiddle (j = i))
  (\fun (same: j = i) => \idelim i = j \with k: Degrees.Index n => Property k \by { base: own, equality: sym!{Degrees.Pair} _ _ same }) (other j);
\import Modules.DirectSum[Index := Degrees.Index n, family := Source.family].To[W := U, target := targetSpace] \as Universal;
\definition equation: lhs = rhs := Universal.ext lhs rhs onInjection;
\definition law[x: Source.Carrier]: TC.coordinate targetIndex ((Differential.horizontal).apply x) = (original).apply (SC.coordinate i x) := congr!{Maps.Map U} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
