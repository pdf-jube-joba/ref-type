\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := n] \as Current;
\import \parent.Degree[n := Nat.Nat^::succ n] \as Next;
\import Source.Degree[n := n] \as SD;
\import Source.Degree[n := Nat.Nat^::succ n] \as SN;
\import Target.Degree[n := n] \as TD;
\import Target.Degree[n := Nat.Nat^::succ n] \as TN;
\import Source.Step[n := n] \as SS;
\import Target.Step[n := n] \as TS;
\module Component(i: Source.Index n) {
  \definition p: Nat.Nat^ := i.first;
  \definition q: Nat.Nat^ := i.second;
  \definition j: Target.Index n := index n i;
  \definition hi: Source.Index (Nat.Nat^::succ n) := Source.upHorizontal n i;
  \definition vi: Source.Index (Nat.Nat^::succ n) := Source.upVertical n i;
  \import Degrees.Sign[V := C.family.Carrier p q, space := C.family.space p q] \as Sign;
  \import Degrees.Sign[V := C.family.Carrier (Nat.Nat^::succ p) q, space := C.family.space (Nat.Nat^::succ p) q] \as HSign;
  \import Degrees.Sign[V := C.family.Carrier p (Nat.Nat^::succ q), space := C.family.space p (Nat.Nat^::succ q)] \as VSign;
  \import Sign.Mapping[W := C.family.Carrier (Nat.Nat^::succ p) q, target := C.family.space (Nat.Nat^::succ p) q] \as HNatural;
  \import Sign.Mapping[W := C.family.Carrier p (Nat.Nat^::succ q), target := C.family.space p (Nat.Nat^::succ q)] \as VNatural;
  \definition horizontalSign: \forall (x: C.family.Carrier (Nat.Nat^::succ p) q) ->
    (HSign.map (Arithmetic.mul (Nat.Nat^::succ p) q)).apply x = (HSign.map q).apply ((HSign.map (Arithmetic.mul p q)).apply x) :=
    \fun (x: C.family.Carrier (Nat.Nat^::succ p) q) => trans!{{C.family.Carrier (Nat.Nat^::succ p) q}} _ _ _
      (congr!{Nat.Nat^ {C.family.Carrier (Nat.Nat^::succ p) q}}
        (\fun (k: Nat.Nat^) => (HSign.map k).apply x) _ _ (Natural.mulSuccLeft p q))
      (HSign.addition q (Arithmetic.mul p q) x);
  \definition verticalSign: \forall (x: C.family.Carrier p (Nat.Nat^::succ q)) ->
    (VSign.map (Arithmetic.mul p (Nat.Nat^::succ q))).apply ((VSign.map p).apply x) = (VSign.map (Arithmetic.mul p q)).apply x :=
    \fun (x: C.family.Carrier p (Nat.Nat^::succ q)) => VSign.cancelAddition p (Arithmetic.mul p q) x;
  \definition horizontal: \forall (x: C.family.Carrier p q) ->
    TS.vertical.apply (Current.forward.apply ((SD.Component[i := i].injection).apply x)) =
      Next.forward.apply (SS.horizontal.apply ((SD.Component[i := i].injection).apply x)) :=
    \fun (x: C.family.Carrier p q) => eq_reason_in!{TN.Carrier _
      "=" _ "by" { congr!{TD.Carrier TN.Carrier} (TS.vertical.apply) _ _ (Current.onInjection i x) }
      "=" _ "by" { TS.verticalOnInjection j ((Sign.map (Arithmetic.mul p q)).apply x) }
      "=" _ "by" { congr!{{C.family.Carrier (Nat.Nat^::succ p) q} TN.Carrier}
            (\fun (z: C.family.Carrier (Nat.Nat^::succ p) q) => (TN.Component[i := index (Nat.Nat^::succ n) hi].injection).apply ((HSign.map q).apply z)) _ _
            (HNatural.naturality (C.differential.horizontal p q) (Arithmetic.mul p q) x) }
      "=" _ "by" { congr!{{C.family.Carrier (Nat.Nat^::succ p) q} TN.Carrier}
              ((TN.Component[i := index (Nat.Nat^::succ n) hi].injection).apply) _ _
              (sym!{{C.family.Carrier (Nat.Nat^::succ p) q}} _ _ (horizontalSign ((C.differential.horizontal p q).apply x))) }
      "=" _ "by" { sym!{TN.Carrier} _ _ (Next.onInjection hi ((C.differential.horizontal p q).apply x)) }
      "=" _ "by" { congr!{SN.Carrier TN.Carrier} (Next.forward.apply) _ _ (sym!{SN.Carrier} _ _ (SS.horizontalOnInjection i x)) }
    };
  \definition vertical: \forall (x: C.family.Carrier p q) ->
    TS.horizontal.apply (Current.forward.apply ((SD.Component[i := i].injection).apply x)) =
      Next.forward.apply (SS.vertical.apply ((SD.Component[i := i].injection).apply x)) :=
    \fun (x: C.family.Carrier p q) => eq_reason_in!{TN.Carrier _
      "=" _ "by" { congr!{TD.Carrier TN.Carrier} (TS.horizontal.apply) _ _ (Current.onInjection i x) }
      "=" _ "by" { TS.horizontalOnInjection j ((Sign.map (Arithmetic.mul p q)).apply x) }
      "=" _ "by" { congr!{{C.family.Carrier p (Nat.Nat^::succ q)} TN.Carrier}
            ((TN.Component[i := index (Nat.Nat^::succ n) vi].injection).apply) _ _
            (VNatural.naturality (C.differential.vertical p q) (Arithmetic.mul p q) x) }
      "=" _ "by" { congr!{{C.family.Carrier p (Nat.Nat^::succ q)} TN.Carrier}
              ((TN.Component[i := index (Nat.Nat^::succ n) vi].injection).apply) _ _
              (sym!{{C.family.Carrier p (Nat.Nat^::succ q)}} _ _ (verticalSign ((C.differential.vertical p q).apply x))) }
      "=" _ "by" { sym!{TN.Carrier} _ _ (Next.onInjection vi ((VSign.map p).apply ((C.differential.vertical p q).apply x))) }
      "=" _ "by" { congr!{SN.Carrier TN.Carrier} (Next.forward.apply) _ _ (sym!{SN.Carrier} _ _ (SS.verticalOnInjection i x)) }
    };
}
\import Modules.Hom[V := TD.Carrier, W := TN.Carrier, source := TD.space, target := TN.space].Composition[U := SD.Carrier, domain := SD.space] \as After;
\import Modules.Hom[V := SN.Carrier, W := TN.Carrier, source := SN.space, target := TN.space].Composition[U := SD.Carrier, domain := SD.space] \as Before;
\import Modules.DirectSum[Index := Source.Index n, family := SD.family].To[W := TN.Carrier, target := TN.space] \as Universal;
\import Modules.Hom[V := SD.Carrier, W := TN.Carrier, source := SD.space, target := TN.space] \as Maps;
\definition horizontalEquality: After.compose TS.vertical Current.forward = Before.compose Next.forward SS.horizontal :=
  Universal.ext (After.compose TS.vertical Current.forward) (Before.compose Next.forward SS.horizontal)
    (\fun (i: Source.Index n) => Component[i := i].horizontal);
\definition verticalEquality: After.compose TS.horizontal Current.forward = Before.compose Next.forward SS.vertical :=
  Universal.ext (After.compose TS.horizontal Current.forward) (Before.compose Next.forward SS.vertical)
    (\fun (i: Source.Index n) => Component[i := i].vertical);
\definition commutes: \forall (x: SD.Carrier) -> TS.differential.apply (Current.forward.apply x) = Next.forward.apply (SS.differential.apply x) :=
  \fun (x: SD.Carrier) => eq_reason_in!{TN.Carrier _
    "=" _ "by" { congr!{TN.Carrier TN.Carrier TN.Carrier} (TN.space.add) _ _ _ _
      (congr!{Maps.Map TN.Carrier} (\fun (m: Maps.Map) => m.apply x) _ _ verticalEquality)
      (congr!{Maps.Map TN.Carrier} (\fun (m: Maps.Map) => m.apply x) _ _ horizontalEquality) }
    "=" _ "by" { (TN.space.additive).commutative (Next.forward.apply (SS.vertical.apply x)) (Next.forward.apply (SS.horizontal.apply x)) }
    "=" _ "by" { sym!{TN.Carrier} _ _ (Next.forward.addition (SS.horizontal.apply x) (SS.vertical.apply x)) }
  };
\definition backwardCommutes: \forall (y: TD.Carrier) ->
  SS.differential.apply (Current.backward.apply y) = Next.backward.apply (TS.differential.apply y) :=
  \block {
    \fun (y: TD.Carrier) \then
    \let x: SD.Carrier := Current.backward.apply y \then
    \let z: SN.Carrier := SS.differential.apply x \then
    \return eq_reason_in!{SN.Carrier z
      "=" { Next.backward.apply (Next.forward.apply z) } "by" { sym!{SN.Carrier} (Next.backward.apply (Next.forward.apply z)) z (Next.leftInverse z) }
      "=" _ "by" { congr!{TN.Carrier SN.Carrier} (Next.backward.apply)
          (Next.forward.apply z) (TS.differential.apply (Current.forward.apply x))
          (sym!{TN.Carrier} (TS.differential.apply (Current.forward.apply x)) (Next.forward.apply z) (commutes x)) }
      "=" _ "by" { congr!{TD.Carrier SN.Carrier} (\fun (u: TD.Carrier) => Next.backward.apply (TS.differential.apply u))
          (Current.forward.apply x) y (Current.rightInverse y) }
    }
  };
