\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := n] \as Term;
\import Cochains.At[C := Source.complex, k := n] \as SH;
\import Cochains.At[C := Target.complex, k := n] \as TH;
\import Forward.At[k := n] \as F;
\import Backward.At[k := n] \as G;
\import Modules.Isomorphism[V := SH.Cohomology, W := TH.Cohomology, source := SH.cohomologySpace, target := TH.cohomologySpace] \as Iso;
\definition leftInverse: \forall (x: SH.Cohomology) -> (G.induced backward).apply ((F.induced forward).apply x) = x :=
  SH.classInduction (\fun (x: SH.Cohomology) => (G.induced backward).apply ((F.induced forward).apply x) = x)
    (\fun (x: SH.CycleCarrier) => eq_reason_in!{SH.Cohomology _
      "=" _ "by" { congr!{TH.Cohomology SH.Cohomology} ((G.induced backward).apply) _ _ (F.onClass forward x) }
      "=" _ "by" { G.onClass backward ((F.cyclesMap forward).apply x) }
      "=" _ "by" { SH.equalClass ((G.cyclesMap backward).apply ((F.cyclesMap forward).apply x)) x (Term.leftInverse x) }
    });
\definition rightInverse: \forall (y: TH.Cohomology) -> (F.induced forward).apply ((G.induced backward).apply y) = y :=
  TH.classInduction (\fun (y: TH.Cohomology) => (F.induced forward).apply ((G.induced backward).apply y) = y)
    (\fun (y: TH.CycleCarrier) => eq_reason_in!{TH.Cohomology _
      "=" _ "by" { congr!{SH.Cohomology TH.Cohomology} ((F.induced forward).apply) _ _ (G.onClass backward y) }
      "=" _ "by" { F.onClass forward ((G.cyclesMap backward).apply y) }
      "=" _ "by" { TH.equalClass ((F.cyclesMap forward).apply ((G.cyclesMap backward).apply y)) y (Term.rightInverse y) }
    });
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := F.induced forward, backward := G.induced backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
