\use std.Logic[].Equality[].eq_reason_in;
\definition p: Nat.Nat^ := i.first;
\definition q: Nat.Nat^ := i.second;
\import Tensor.Term[p := p, q := q] \as Current;
\import Tensor.At[p := p, q := q] \as Differential;
\import Tensor.Term[p := Nat.Nat^::succ p, q := q] \as H;
\import Tensor.Term[p := p, q := Nat.Nat^::succ q] \as V;
\import Target.Component[i := Total.upHorizontal n i] \as HI;
\import Target.Component[i := Total.upVertical n i] \as VI;
\import Modules.Hom[V := H.Carrier, W := Target.Carrier, source := H.space, target := Target.space] \as HInjections;
\import Modules.Hom[V := V.Carrier, W := Target.Carrier, source := V.space, target := Target.space] \as VInjections;
\import Modules.Hom[V := V.Carrier, W := V.Carrier, source := V.space, target := V.space] \as SignMaps;
\import Degrees.Sign[V := V.Carrier, space := V.space] \as Sign;
\import Modules.Hom[V := Current.Carrier, W := Target.Carrier, source := Current.space, target := Target.space] \as ComponentMaps;
\import Modules.Tensor[V := left.Carrier p, W := right.Carrier q, left := left.space p, right := right.space q].Universal[
  U := Target.Carrier, target := Target.space] \as TensorUniversal;
\definition horizontalMap: Step.horizontalComponents i = ComponentMaps.zeroMap :=
  TensorUniversal.ext (Step.horizontalComponents i) ComponentMaps.zeroMap
    (\fun (x: left.Carrier p)(y: right.Carrier q) => eq_reason_in!{Target.Carrier _
      "=" _ "by" { congr!{H.Carrier Target.Carrier} (HI.injection.apply) _ _ (Differential.horizontalOnTensor x y) }
      "=" _ "by" { congr!{H.Carrier Target.Carrier} (HI.injection.apply) _ _ (H.zeroLeft y) }
      "=" _ "by" { HInjections.zeroPreserved HI.injection }
    });
\definition horizontal: \forall (x: Current.Carrier) -> Step.horizontal.apply ((Source.Component[i := i].injection).apply x) = Target.space.zero :=
  \fun (x: Current.Carrier) => trans!{Target.Carrier} _ _ _ (Step.horizontalOnInjection i x)
    (congr!{ComponentMaps.Map Target.Carrier} (\fun (f: ComponentMaps.Map) => f.apply x) _ _ horizontalMap);
\definition verticalMap: Step.verticalComponents i = ComponentMaps.zeroMap :=
  TensorUniversal.ext (Step.verticalComponents i) ComponentMaps.zeroMap
    (\fun (x: left.Carrier p)(y: right.Carrier q) => eq_reason_in!{Target.Carrier _
      "=" _ "by" { congr!{V.Carrier Target.Carrier} (\fun (z: V.Carrier) => VI.injection.apply ((Sign.map p).apply z)) _ _ (Differential.verticalOnTensor x y) }
      "=" _ "by" { congr!{V.Carrier Target.Carrier} (\fun (z: V.Carrier) => VI.injection.apply ((Sign.map p).apply z)) _ _ (V.zeroRight x) }
      "=" _ "by" { congr!{V.Carrier Target.Carrier} (VI.injection.apply) _ _ (SignMaps.zeroPreserved (Sign.map p)) }
      "=" _ "by" { VInjections.zeroPreserved VI.injection }
    });
\definition vertical: \forall (x: Current.Carrier) -> Step.vertical.apply ((Source.Component[i := i].injection).apply x) = Target.space.zero :=
  \fun (x: Current.Carrier) => trans!{Target.Carrier} _ _ _ (Step.verticalOnInjection i x)
    (congr!{ComponentMaps.Map Target.Carrier} (\fun (f: ComponentMaps.Map) => f.apply x) _ _ verticalMap);
