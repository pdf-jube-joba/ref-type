\import \parent.At[q := Nat.Nat^::zero] \as Case;
\import Cochains.At[C := D, k := Nat.Nat^::zero] \as Right;
\import \parent.\parent.Tensor[C := C, D := D] \as Product;
\import \parent.\parent.Total[C := Product.complex] \as Total;
\import \parent.\parent.CycleProduct[C := C, D := D, p := p, q := Nat.Nat^::zero] \as Exterior;
\import Product.Term[p := p, q := Nat.Nat^::zero] \as Term;
\import Total.Degree[n := p] \as Current;
\import Current.Component[i := Exterior.index] \as Inclusion;
\import Cochains.At[C := Total.complex, k := p] \as H;
\import Modules.Hom[V := Term.Carrier, W := Current.Carrier, source := Term.space, target := Current.space] \as Maps;
\import Modules.Hom[V := H.CycleCarrier, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace] \as Classes;
\definition vanishes: Case.Vanishes :=
  \fun (x: Left.CycleCarrier)(y: Right.CycleCarrier)(boundary: y = (D.family.space Nat.Nat^::zero).zero) =>
    trans!{H.Cohomology} (Exterior.classOf x y) (H.classOf H.cycleSpace.zero) H.cohomologySpace.zero
      (H.equalClass (Exterior.cycle x y) H.cycleSpace.zero
        (trans!{Current.Carrier} (Exterior.value x y) (Inclusion.injection.apply Term.space.zero) Current.space.zero
          (congr!{Term.Carrier Current.Carrier} (Inclusion.injection.apply) _ _
            (trans!{Term.Carrier} (Term.tensor x y) (Term.tensor x (D.family.space Nat.Nat^::zero).zero) Term.space.zero
              (congr!{{D.family.Carrier Nat.Nat^::zero} Term.Carrier} (Term.tensor x) _ _ boundary)
              (Term.zeroRight x)))
          (Maps.zeroPreserved Inclusion.injection)))
      (Classes.zeroPreserved H.classLinear);
