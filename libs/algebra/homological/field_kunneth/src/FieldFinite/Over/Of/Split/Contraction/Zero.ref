\import \parent.Degree[n := N.Nat^::zero] \as Term;
\import \parent.\parent.Remainder[n := N.Nat^::zero] \as Remainder;
\import \parent.\parent.Degree[n := N.Nat^::zero] \as Current;
\import \parent.Step[n := N.Nat^::zero] \as First;
\import \parent.\parent.\parent.At[n := N.Nat^::zero].Outgoing[] \as Out;
\import Cochains.At[C := complex, k := N.Nat^::zero] \as H;
\import Modules.Laws[V := Carrier (C.ranks N.Nat^::zero), space := space (C.ranks N.Nat^::zero)] \as Vector;
\import algebra.Group[].Of[Carrier := Carrier (C.ranks N.Nat^::zero), group := Vector.additive] \as Group;
\definition residueZero: \forall (x: Carrier (C.ranks N.Nat^::zero)) -> Remainder.ambient.apply x = (space (C.ranks N.Nat^::zero)).zero :=
  \fun (x: Carrier (C.ranks N.Nat^::zero)) =>
    \bysub(Carrier (C.ranks N.Nat^::zero), H.boundaries.carrier, Remainder.ambient.apply x);
\definition equality: \forall (x: Carrier (C.ranks N.Nat^::zero)) ->
  Group.difference x (Current.inclusion.apply (Current.projection.apply x)) = First.map.apply ((C.differential N.Nat^::zero).apply x) :=
  \fun (x: Carrier (C.ranks N.Nat^::zero)) => trans!{{Carrier (C.ranks N.Nat^::zero)}} _ _ _ (Term.decomposition x)
    (trans!{{Carrier (C.ranks N.Nat^::zero)}} _ _ _
      (congr!{{Carrier (C.ranks N.Nat^::zero)} {Carrier (C.ranks N.Nat^::zero)}}
        (\fun (z: Carrier (C.ranks N.Nat^::zero)) => Group.add z (((d N.Nat^::zero).outgoing).apply (Out.differential.apply x))) _ _ (residueZero x))
      (trans!{{Carrier (C.ranks N.Nat^::zero)}} _ _ _
        (Group.zeroLeft (((d N.Nat^::zero).outgoing).apply (Out.differential.apply x)))
        (sym!{{Carrier (C.ranks N.Nat^::zero)}} _ _ (First.onDifferential x))));
