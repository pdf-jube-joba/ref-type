\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := n] \as Term;
\import Cochains.At[C := complex, k := n] \as H;
\import Cochains.At[C := HomologyComplex.complex, k := n] \as Zero;
\import Inclusions.At[k := n] \as Include;
\import Projections.At[k := n] \as Project;
\definition zeroClass[x: H.Cohomology]: Zero.Cohomology :=
  Zero.classOf (Zero.cycle x (\refl((homologyFamily.space (N.Nat^::succ n)).zero)));
\definition inclusionClass: \forall (x: H.Cohomology) ->
  H.classOf (H.cycle (Term.inclusion.apply x) (Term.inclusionClosed x)) = x := (d n).represents;
\definition leftInverse: \forall (x: Zero.Cohomology) ->
  (Project.induced projection).apply ((Include.induced inclusion).apply x) = x :=
  Zero.classInduction (\fun (x: Zero.Cohomology) => (Project.induced projection).apply ((Include.induced inclusion).apply x) = x)
    (\fun (x: Zero.CycleCarrier) => eq_reason_in!{Zero.Cohomology _
      "=" _ "by" { congr!{H.Cohomology Zero.Cohomology} ((Project.induced projection).apply) _ _ (Include.onClass inclusion x) }
      "=" _ "by" { Project.onClass projection ((Include.cyclesMap inclusion).apply x) }
      "=" _ "by" { congr!{H.Cohomology Zero.Cohomology} zeroClass
          (Term.projection.apply (Term.inclusion.apply x)) x (Term.inverse x) }
    });
\definition rightInverse: \forall (x: H.Cohomology) ->
  (Include.induced inclusion).apply ((Project.induced projection).apply x) = x :=
  H.classInduction (\fun (x: H.Cohomology) => (Include.induced inclusion).apply ((Project.induced projection).apply x) = x)
    (\fun (x: H.CycleCarrier) => eq_reason_in!{H.Cohomology _
      "=" _ "by" { congr!{Zero.Cohomology H.Cohomology} ((Include.induced inclusion).apply) _ _ (Project.onClass projection x) }
      "=" _ "by" { Include.onClass inclusion ((Project.cyclesMap projection).apply x) }
      "=" _ "by" { inclusionClass (Term.projection.apply x) }
      "=" _ "by" { Term.projectionOnCycle x }
    });
\import Modules.Isomorphism[V := Zero.Cohomology, W := H.Cohomology,
  source := Zero.cohomologySpace, target := H.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Include.induced inclusion, backward := Project.induced projection,
  leftInverse := leftInverse, rightInverse := rightInverse,
};
