\definition higher: N.Nat^ := N.Nat^::succ n;
\import Cochains.At[C := complex, k := higher] \as Next;
\import Modules.Of[V := Carrier (C.ranks higher), space := space (C.ranks higher)].Submodule[].Of[S := Next.boundaries] \as Image;
\definition source: Modules.Bundle := Modules.Bundle { Carrier := Carrier (C.ranks n), space := space (C.ranks n) };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := Image.Carrier, space := Image.moduleSpace };
\import Modules.Hom[V := source.Carrier, W := Image.Carrier, source := source.space, target := Image.moduleSpace] \as Maps;
\definition differential: Maps.Map := Maps.Map {
  apply := \fun (x: source.Carrier) => \into[Carrier (C.ranks higher)]((C.differential n).apply x, Next.boundaries.carrier) \by {
    Existential.existsIntro[source.Carrier, { y: source.Carrier \where (C.differential n).apply y = (C.differential n).apply x }] x
    (\refl((C.differential n).apply x))
  },
  addition := \fun (x, y: source.Carrier) => (C.differential n).addition x y,
  scalar := \fun (a: K)(x: source.Carrier) => (C.differential n).scalar a x,
};
\definition onto: Modules.Surjective source target differential := \block {
  \fun (y: target.Carrier) \then
  \takefrom x: \Cast[source.Carrier] ({ x: source.Carrier \where (C.differential n).apply x = y })
    \by \bysub(Carrier (C.ranks higher), Next.boundaries.carrier, y) \then
  \return Existential.existsIntro[source.Carrier, { x: source.Carrier \where differential.apply x = y }] x
    (\bysub(source.Carrier, { x: source.Carrier \where (C.differential n).apply x = y }, x))
};
\import Modules.ShortExact[A := cycleBundle, B := source, C := target] \as Sequences;
\definition sequence: Sequences.Sequence := Sequences.Sequence {
  inclusion := Cycles.inclusion, projection := differential,
  injective := \fun (x, y: H.CycleCarrier)(equal: x = y) => equal,
  onto := onto,
  zero := \fun (x: H.CycleCarrier) => \bysub(source.Carrier, H.cycles.carrier, x),
  kernelImage := \fun (x: source.Carrier)(closed: differential.apply x = target.space.zero) =>
    Existential.existsIntro[H.CycleCarrier, { y: H.CycleCarrier \where y = x }] (H.cycle x closed) (\refl(x)),
};
\definition imageProjective: Modules.Projective target := Subspaces.projective (C.ranks higher) Next.boundaries;
\definition Section: \Set := \Cast[Modules.MapBetween target source] ({ s: Modules.MapBetween target source \where
  \forall (x: target.Carrier) -> differential.apply (s.apply x) = x });
\definition sectionExistence: \exists Section := imageProjective source.Carrier source.space target.Carrier target.space differential onto
  (Modules.End[V := target.Carrier, space := target.space].identity);
