\import derived_functors.Tor[].Over[R := I.Int^, ring := IntegerRing.commutativeRing] \as Tor;
\import derived_functors.IntegerCyclicResolution[].Positive[m := one] \as CyclicResolution;
\import AtOne.Presentation[] \as Presentation;
\import homological_algebra.Kunneth[].Integer[].Of[C := complex, D := complex].At[n := I.Int^::ofNat three].Component[p := I.Int^::ofNat two] \as Component;
\definition homologyBundle: Modules.Bundle := Modules.Bundle { Carrier := ChainHomology.Homology, space := ChainHomology.homologySpace };
\import Tor.Of[M := homologyBundle, N := homologyBundle, P := Presentation.complex].At[n := one] \as Source;
\import Tor.Of[M := CyclicTwo.bundle, N := homologyBundle, P := CyclicResolution.complex].At[n := one] \as Middle;
\import Tor.Of[M := CyclicTwo.bundle, N := CyclicTwo.bundle, P := CyclicResolution.complex].At[n := one] \as Target;
\import Tor.First[M := homologyBundle, L := CyclicTwo.bundle, N := homologyBundle, P := Presentation.complex, Q := CyclicResolution.complex] \as FirstForward;
\import Tor.First[M := CyclicTwo.bundle, L := homologyBundle, N := homologyBundle, P := CyclicResolution.complex, Q := Presentation.complex] \as FirstBackward;
\definition forwardCoefficient: Modules.MapBetween homologyBundle CyclicTwo.bundle := #forward{cyclicIsomorphism};
\definition backwardCoefficient: Modules.MapBetween CyclicTwo.bundle homologyBundle := #backward{cyclicIsomorphism};
\import FirstForward.Positive[n := zero].With[p := Presentation.resolution, q := CyclicResolution.resolution, f := forwardCoefficient] \as Forward;
\import FirstBackward.Positive[n := zero].With[p := CyclicResolution.resolution, q := Presentation.resolution, f := backwardCoefficient] \as Backward;
\import Modules.Hom[V := CyclicTwo.bundle.Carrier, W := homologyBundle.Carrier, source := CyclicTwo.bundle.space, target := homologyBundle.space].Composition[U := homologyBundle.Carrier, domain := homologyBundle.space] \as SourceCompose;
\import Modules.End[V := homologyBundle.Carrier, space := homologyBundle.space] \as SourceEnd;
\definition sourceCoefficientIdentity: SourceCompose.compose backwardCoefficient forwardCoefficient = SourceEnd.identity :=
  Modules.Hom[V := homologyBundle.Carrier, W := homologyBundle.Carrier, source := homologyBundle.space, target := homologyBundle.space].ext _ _ #leftInverse{cyclicIsomorphism};
\import Modules.Hom[V := homologyBundle.Carrier, W := CyclicTwo.bundle.Carrier, source := homologyBundle.space, target := CyclicTwo.bundle.space].Composition[U := CyclicTwo.bundle.Carrier, domain := CyclicTwo.bundle.space] \as TargetCompose;
\import Modules.End[V := CyclicTwo.bundle.Carrier, space := CyclicTwo.bundle.space] \as TargetEnd;
\definition targetCoefficientIdentity: TargetCompose.compose forwardCoefficient backwardCoefficient = TargetEnd.identity :=
  Modules.Hom[V := CyclicTwo.bundle.Carrier, W := CyclicTwo.bundle.Carrier, source := CyclicTwo.bundle.space, target := CyclicTwo.bundle.space].ext _ _ #rightInverse{cyclicIsomorphism};
\module FirstSource;
\module FirstTarget;
\definition firstIsomorphism: Modules.Isomorphism[V := Source.Carrier, W := Middle.Carrier, source := Source.space, target := Middle.space].Isomorphism :=
  Modules.Isomorphism[V := Source.Carrier, W := Middle.Carrier, source := Source.space, target := Middle.space].Isomorphism {
    forward := Forward.map, backward := Backward.map, leftInverse := FirstSource[].firstSourceInverse, rightInverse := FirstTarget[].firstTargetInverse,
  };
\import Tor.Second[M := CyclicTwo.bundle, N := homologyBundle, L := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondForward;
\import Tor.Second[M := CyclicTwo.bundle, N := CyclicTwo.bundle, L := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondBackward;
\module SecondSource;
\module SecondTarget;
\definition secondIsomorphism: Modules.Isomorphism[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Isomorphism :=
  Modules.Isomorphism[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Isomorphism {
    forward := SecondForward.map forwardCoefficient, backward := SecondBackward.map backwardCoefficient,
    leftInverse := SecondSource[].secondSourceInverse, rightInverse := SecondTarget[].secondTargetInverse,
  };
\import Modules.Isomorphism[V := Source.Carrier, W := Middle.Carrier, source := Source.space, target := Middle.space].Composition[U := Target.Carrier, final := Target.space] \as FirstComposition;
\import CyclicResolution.Coefficients[k := zero].Tor[] \as CyclicComputation;
\import Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Composition[U := CyclicTwo.Carrier, final := CyclicTwo.space] \as FinalComposition;
\definition isomorphism: Modules.Isomorphism[V := Component.torCarrier, W := CyclicTwo.Carrier, source := Component.torSpace, target := CyclicTwo.space].Isomorphism :=
  FinalComposition.compose CyclicComputation.isomorphism (FirstComposition.compose secondIsomorphism firstIsomorphism);
\definition generator: Component.torCarrier := #apply{#backward{isomorphism}} (CyclicTwo.class (I.Int^::ofNat one));
\definition onGenerator: #apply{#forward{isomorphism}} generator = CyclicTwo.class (I.Int^::ofNat one) :=
  #rightInverse{isomorphism} (CyclicTwo.class (I.Int^::ofNat one));
