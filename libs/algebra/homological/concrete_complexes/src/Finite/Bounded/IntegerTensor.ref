\import homological_algebra.Kunneth[].Integer[] \as IntegerKunneth;
\definition degree: I.Int^ := I.Int^::ofNat three;
\definition torsionDegree: I.Int^ := I.Int^::ofNat two;
\import IntegerKunneth.CoreTerms[C := complex, D := complex].At[n := degree] \as Data;
\import IntegerKunneth.Theorem[C := complex, D := complex].ExactAt[n := degree] \as Theorem;
\definition tensorBundle: Modules.Bundle := Data.tensorBundle;
\definition homologyBundle: Modules.Bundle := Data.homologyBundle;
\definition torBundle: Modules.Bundle := Data.torBundle;
\import Modules.ShortExact[A := tensorBundle, B := homologyBundle, C := torBundle] \as Exact;
\definition sequence: Exact.Sequence := Theorem.sequence;
\definition exterior: Modules.MapBetween tensorBundle homologyBundle := Data.exterior;
\definition inclusionEq: sequence.inclusion = exterior := Theorem.inclusionEq;
\module Selected;
