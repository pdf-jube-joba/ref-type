\import Bounded.Mapping[C := complex, D := complex] \as SelfMaps;
\definition data: SelfMaps.Data := SelfMaps.Data {
  entries := \fun (z: I.Int^) => NativeIdentity.Identity.program^,
};
\module Term(z: I.Int^);
\definition laws: SelfMaps.Laws[data] := SelfMaps.Laws[data] {
  commutes := \fun (z: I.Int^)(v: Bounded.Carrier complex z) =>
    trans!{{Bounded.Carrier complex (Bounded.previous z)}} _ _ _
      (congr!{{Bounded.Carrier complex z} {Bounded.Carrier complex (Bounded.previous z)}}
        (Bounded.apply complex z) _ _ (Term[z := z].action v))
      (sym!{{Bounded.Carrier complex (Bounded.previous z)}} _ _
        (Term[z := Bounded.previous z].action (Bounded.apply complex z v))),
};
\definition map: SelfMaps.Map := \into[SelfMaps.Data](data,
  { d: SelfMaps.Data \where SelfMaps.Laws[d] }) \by { laws };
