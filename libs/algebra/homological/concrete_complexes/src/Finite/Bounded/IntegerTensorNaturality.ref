\import homological_algebra.Kunneth[].Integer[] \as IntegerKunneth;
\definition degree: I.Int^ := I.Int^::ofNat three;
\import \parent.BasisChange[] \as Changed;
\import Changed.UniversalCoefficient[z := degree] \as Change;
\import \parent.IdentityMap[] \as Identity;
