\import IntegerKunneth.Of[C := complex, D := complex].At[n := degree] \as SmithData;
\import IntegerKunneth.Theorem[C := complex, D := complex].At[n := degree] \as FullTheorem;
\definition smithBundle: Modules.Bundle := SmithData.smithBundle;
\import Modules.Biproduct[V := tensorBundle.Carrier, W := torBundle.Carrier, left := tensorBundle.space, right := torBundle.space] \as Sum;
\definition selectedSplitting: Modules.Isomorphism[V := Sum.Carrier, W := homologyBundle.Carrier, source := Sum.space, target := homologyBundle.space].Isomorphism := FullTheorem.selectedSplitting;
\import Modules.Biproduct[V := smithBundle.Carrier, W := torBundle.Carrier, left := smithBundle.space, right := torBundle.space] \as SmithSum;
\definition smithSplitting: Modules.Isomorphism[V := SmithSum.Carrier, W := homologyBundle.Carrier, source := SmithSum.space, target := homologyBundle.space].Isomorphism := FullTheorem.smithSplitting;
\import \parent.\parent.IntegerTor[] \as IntegerTor;
\import Modules.DirectSum[Index := I.Int^, family := Data.torFamily] \as TorTerms;
\definition torsionGenerator: torBundle.Carrier := (TorTerms.Injection[i := torsionDegree].map).apply IntegerTor.generator;
\import FullTheorem.Selected[] \as Selection;
\definition liftedGenerator: homologyBundle.Carrier := Selection.section.apply torsionGenerator;
\definition projectionOnGenerator: sequence.projection.apply liftedGenerator = torsionGenerator := Selection.rightInverse torsionGenerator;
\definition cyclicGenerator: IntegerTor.isomorphism.forward.apply IntegerTor.generator = CyclicTwo.class (I.Int^::ofNat one) := IntegerTor.onGenerator;
