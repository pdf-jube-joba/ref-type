\definition integers: Modules.Bundle := Modules.Bundle { Carrier := I.Int^, space := Modules.scalarModule };
\import Modules.End[V := I.Int^, space := Modules.scalarModule] \as IntegerIdentity;
\import Modules.Hom[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule] \as IntegerMaps;
\definition twice: IntegerMaps.Map := IntegerMaps.plus IntegerIdentity.identity IntegerIdentity.identity;
\import \parent.Coefficients[A := integers, B := integers].On[u := twice] \as Diagram;
\definition basisChangeAndCoefficientExt: _ := Diagram.Inclusion[].naturality;
\definition basisChangeAndCoefficientTor: _ := Diagram.Projection[].naturality;
