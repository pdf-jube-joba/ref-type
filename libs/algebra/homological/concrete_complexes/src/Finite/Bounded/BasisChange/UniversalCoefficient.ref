\import \root.Finite[].Bounded[] \as Original;
\import Bounded.Mapping[C := Original.complex, D := complex] \as Mapping;
\definition mapData: Mapping.Data := Mapping.Data { entries := matrices };
\definition mapLaws: Mapping.Laws[mapData] := Mapping.Laws[mapData] { commutes := Updated.forward.commutes };
\definition map: Mapping.Map := \into[Mapping.Data](mapData, { data: Mapping.Data \where Mapping.Laws[data] }) \by { mapLaws };
\module Coefficients(A, B: Modules.Bundle) ;
\module Integer;
