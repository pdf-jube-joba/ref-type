\use std.Logic[].Equality[].eq_reason_in;
\import Tor.Second[M := CyclicTwo.bundle, N := CyclicTwo.bundle, L := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondTargetAction;
\import Tor.SecondIdentity[M := CyclicTwo.bundle, N := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondTargetIdentity;
\import Tor.SecondComposition[M := CyclicTwo.bundle, N := CyclicTwo.bundle, L := homologyBundle, T := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondTargetComposition;
\definition secondTargetInverse: \forall (x: Target.Carrier) -> (SecondForward.map forwardCoefficient).apply ((SecondBackward.map backwardCoefficient).apply x) = x :=
  \fun (x: Target.Carrier) => eq_reason_in!{Target.Carrier _
    "=" _ "by" { sym!{Target.Carrier} _ _ (SecondTargetComposition.composition backwardCoefficient forwardCoefficient x) }
    "=" _ "by" { congr!{{Modules.MapBetween CyclicTwo.bundle CyclicTwo.bundle} Target.Carrier} (\fun (f: Modules.MapBetween CyclicTwo.bundle CyclicTwo.bundle) => (SecondTargetAction.map f).apply x) _ _ targetCoefficientIdentity }
    "=" _ "by" { SecondTargetIdentity.identity x }
  };
