\import Tor.Second[M := CyclicTwo.bundle, N := CyclicTwo.bundle, L := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondTargetAction;
\import Tor.SecondIdentity[M := CyclicTwo.bundle, N := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondTargetIdentity;
\import Tor.SecondComposition[M := CyclicTwo.bundle, N := CyclicTwo.bundle, L := homologyBundle, T := CyclicTwo.bundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondTargetComposition;
\definition secondTargetInverse: \forall (x: Target.Carrier) -> #apply{(SecondForward.map forwardCoefficient)} (#apply{(SecondBackward.map backwardCoefficient)} x) = x :=
  \fun (x: Target.Carrier) => trans!{Target.Carrier} _ _ _ (sym!{Target.Carrier} _ _ (SecondTargetComposition.composition backwardCoefficient forwardCoefficient x))
    (trans!{Target.Carrier} _ _ _
      (congr!{{Modules.MapBetween CyclicTwo.bundle CyclicTwo.bundle} Target.Carrier} (\fun (f: Modules.MapBetween CyclicTwo.bundle CyclicTwo.bundle) => #apply{(SecondTargetAction.map f)} x) _ _ targetCoefficientIdentity)
      (SecondTargetIdentity.identity x));
