\import Tor.First[M := CyclicTwo.bundle, L := CyclicTwo.bundle, N := homologyBundle, P := CyclicResolution.complex, Q := CyclicResolution.complex] \as TargetAction;
\import Tor.FirstIdentity[M := CyclicTwo.bundle, N := homologyBundle, P := CyclicResolution.complex].With[resolution := CyclicResolution.resolution].Positive[n := zero] \as TargetIdentity;
\import Tor.FirstComposition[M := CyclicTwo.bundle, L := homologyBundle, T := CyclicTwo.bundle, N := homologyBundle, P := CyclicResolution.complex, Q := Presentation.complex, S := CyclicResolution.complex].With[p := CyclicResolution.resolution, q := Presentation.resolution, r := CyclicResolution.resolution, u := backwardCoefficient, v := forwardCoefficient].Positive[n := zero] \as TargetComposition;
\definition firstTargetInverse: \forall (x: Middle.Carrier) -> #apply{Forward.map} (#apply{Backward.map} x) = x :=
  \fun (x: Middle.Carrier) => trans!{Middle.Carrier} _ _ _ (sym!{Middle.Carrier} _ _ (TargetComposition.composition x))
    (trans!{Middle.Carrier} _ _ _
      (congr!{{Modules.MapBetween CyclicTwo.bundle CyclicTwo.bundle} Middle.Carrier} (\fun (f: Modules.MapBetween CyclicTwo.bundle CyclicTwo.bundle) => #apply{TargetAction.Positive[n := zero].With[p := CyclicResolution.resolution, q := CyclicResolution.resolution, f := f].map} x) _ _ targetCoefficientIdentity)
      (TargetIdentity.identity x));
