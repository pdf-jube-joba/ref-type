\use std.Logic[].Equality[].eq_reason_in;
\import Tor.First[M := homologyBundle, L := homologyBundle, N := homologyBundle, P := Presentation.complex, Q := Presentation.complex] \as SourceAction;
\import Tor.FirstIdentity[M := homologyBundle, N := homologyBundle, P := Presentation.complex].With[resolution := Presentation.resolution].Positive[n := zero] \as SourceIdentity;
\import Tor.FirstComposition[M := homologyBundle, L := CyclicTwo.bundle, T := homologyBundle, N := homologyBundle, P := Presentation.complex, Q := CyclicResolution.complex, S := Presentation.complex].With[p := Presentation.resolution, q := CyclicResolution.resolution, r := Presentation.resolution, u := forwardCoefficient, v := backwardCoefficient].Positive[n := zero] \as SourceComposition;
\definition firstSourceInverse: \forall (x: Source.Carrier) -> Backward.map.apply (Forward.map.apply x) = x :=
  \fun (x: Source.Carrier) => eq_reason_in!{Source.Carrier _
    "=" _ "by" { sym!{Source.Carrier} _ _ (SourceComposition.composition x) }
    "=" _ "by" { congr!{{Modules.MapBetween homologyBundle homologyBundle} Source.Carrier} (\fun (f: Modules.MapBetween homologyBundle homologyBundle) => (SourceAction.Positive[n := zero].With[p := Presentation.resolution, q := Presentation.resolution, f := f].map).apply x) _ _ sourceCoefficientIdentity }
    "=" _ "by" { SourceIdentity.identity x }
  };
