\import Tor.Second[M := CyclicTwo.bundle, N := homologyBundle, L := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondSourceAction;
\import Tor.SecondIdentity[M := CyclicTwo.bundle, N := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondSourceIdentity;
\import Tor.SecondComposition[M := CyclicTwo.bundle, N := homologyBundle, L := CyclicTwo.bundle, T := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondSourceComposition;
\definition secondSourceInverse: \forall (x: Middle.Carrier) -> #apply{(SecondBackward.map backwardCoefficient)} (#apply{(SecondForward.map forwardCoefficient)} x) = x :=
  \fun (x: Middle.Carrier) => trans!{Middle.Carrier} _ _ _ (sym!{Middle.Carrier} _ _ (SecondSourceComposition.composition forwardCoefficient backwardCoefficient x))
    (trans!{Middle.Carrier} _ _ _
      (congr!{{Modules.MapBetween homologyBundle homologyBundle} Middle.Carrier} (\fun (f: Modules.MapBetween homologyBundle homologyBundle) => #apply{(SecondSourceAction.map f)} x) _ _ sourceCoefficientIdentity)
      (SecondSourceIdentity.identity x));
