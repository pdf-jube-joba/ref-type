\use std.Logic[].Equality[].eq_reason_in;
\import Tor.Second[M := CyclicTwo.bundle, N := homologyBundle, L := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondSourceAction;
\import Tor.SecondIdentity[M := CyclicTwo.bundle, N := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondSourceIdentity;
\import Tor.SecondComposition[M := CyclicTwo.bundle, N := homologyBundle, L := CyclicTwo.bundle, T := homologyBundle, P := CyclicResolution.complex].Positive[n := zero] \as SecondSourceComposition;
\definition secondSourceInverse: \forall (x: Middle.Carrier) -> (SecondBackward.map backwardCoefficient).apply ((SecondForward.map forwardCoefficient).apply x) = x :=
  \fun (x: Middle.Carrier) => eq_reason_in!{Middle.Carrier _
    "=" _ "by" { sym!{Middle.Carrier} _ _ (SecondSourceComposition.composition forwardCoefficient backwardCoefficient x) }
    "=" _ "by" { congr!{{Modules.MapBetween homologyBundle homologyBundle} Middle.Carrier} (\fun (f: Modules.MapBetween homologyBundle homologyBundle) => (SecondSourceAction.map f).apply x) _ _ sourceCoefficientIdentity }
    "=" _ "by" { SecondSourceIdentity.identity x }
  };
