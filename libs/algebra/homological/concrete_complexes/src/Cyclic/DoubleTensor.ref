\use Equality.congr2;
\import std.Data[].Nat[].Basic[].Def[] \as Degrees;
\import double_complexes.DoubleComplex[].Over[R := Int.Int^, ring := Ring.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing] \as Doubles;
\import double_complexes.NonnegativeChain[].Over[R := Int.Int^, ring := Ring.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing] \as Chains;
\import Doubles.Tensor[C := Presentation.complex, D := Presentation.complex] \as Tensor;
\import Doubles.Total[C := Tensor.complex] \as Total;
\import resolutions.ResolutionTensor[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Double[
  M := Z2.bundle, N := Z2.bundle, P := Presentation.complex, Q := Presentation.complex] \as Model;
\import Model.With[p := Presentation.resolution, q := Presentation.resolution] \as Comparison;
\import resolutions.TensorComplex[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].On[P := Presentation.complex, N := Z2.bundle] \as OneSided;
\definition left: Chains.Map[C := Total.complex, D := OneSided.complex].Map := Comparison.standardLeft;
\definition projective: \forall (n: Nat.Nat^) -> Modules.Projective (Modules.Bundle { Carrier := Total.Carrier n, space := Total.space n }) :=
  \fun (n: Nat.Nat^) => Model.Degree[n := n].projective Presentation.resolution Presentation.resolution;
\definition degreeTwo: Nat.Nat^ := Nat.Nat^::succ one;
\definition mixed: Doubles.Index degreeTwo := \into[Doubles.Pair](Doubles.Pair { first := one, second := one },
  { i: Doubles.Pair \where Degrees.add i.first i.second = degreeTwo }) \by { \refl(degreeTwo) };
\definition lowerLeft: Doubles.Index one := \into[Doubles.Pair](Doubles.Pair { first := Nat.Nat^::zero, second := one },
  { i: Doubles.Pair \where Degrees.add i.first i.second = one }) \by { \refl(one) };
\definition lowerRight: Doubles.Index one := \into[Doubles.Pair](Doubles.Pair { first := one, second := Nat.Nat^::zero },
  { i: Doubles.Pair \where Degrees.add i.first i.second = one }) \by { \refl(one) };
\import Tensor.Term[p := one, q := one] \as Mixed;
\import Tensor.Term[p := Nat.Nat^::zero, q := one] \as LeftTerm;
\import Tensor.Term[p := one, q := Nat.Nat^::zero] \as RightTerm;
\import Tensor.At[p := Nat.Nat^::zero, q := one] \as Horizontal;
\import Tensor.At[p := one, q := Nat.Nat^::zero] \as Vertical;
\import Total.Degree[n := degreeTwo] \as Two;
\import Total.Degree[n := one] \as One;
\import Total.Step[n := one] \as Step;
\import One.Component[i := lowerLeft] \as LeftInjection;
\import One.Component[i := lowerRight] \as RightInjection;
\import Modules.Hom[V := RightTerm.Carrier, W := One.Carrier, source := RightTerm.space, target := One.space] \as RightMaps;
\definition generator[x, y: Int.Int^]: Two.Carrier :=
  (Two.Component[i := mixed].injection).apply (Mixed.tensor (Presentation.oneIntro x) (Presentation.oneIntro y));
\definition boundary: \forall (x, y: Int.Int^) ->
  Total.differential.apply one (generator x y) =
  One.space.add
    (LeftInjection.injection.apply (LeftTerm.tensor (Presentation.zeroIntro (Arithmetic.mul two x)) (Presentation.oneIntro y)))
    (One.space.neg (RightInjection.injection.apply (RightTerm.tensor (Presentation.oneIntro x) (Presentation.zeroIntro (Arithmetic.mul two y))))) :=
  \fun (x, y: Int.Int^) => trans!{One.Carrier} _ _ _
    (Step.onComponent mixed (Mixed.tensor (Presentation.oneIntro x) (Presentation.oneIntro y)))
    (congr2!{One.Carrier One.Carrier One.Carrier} (One.space.add) _ _ _ _
      (congr!{LeftTerm.Carrier One.Carrier} (LeftInjection.injection.apply) _ _
        (Horizontal.horizontalOnTensor (Presentation.oneIntro x) (Presentation.oneIntro y)))
      (trans!{One.Carrier} _ _ _
        (congr!{RightTerm.Carrier One.Carrier} (\fun (v: RightTerm.Carrier) => RightInjection.injection.apply (RightTerm.space.neg v)) _ _
          (Vertical.verticalOnTensor (Presentation.oneIntro x) (Presentation.oneIntro y)))
        (RightMaps.negativePreserved RightInjection.injection
          (RightTerm.tensor (Presentation.oneIntro x) (Presentation.zeroIntro (Arithmetic.mul two y))))));
\definition squareZero: \forall (x, y: Int.Int^) ->
  Total.differential.apply Nat.Nat^::zero (Total.differential.apply one (generator x y)) = (Total.space Nat.Nat^::zero).zero :=
  \fun (x, y: Int.Int^) => Total.squareZero Nat.Nat^::zero (generator x y);
\definition comparisonCommutes: \forall (x, y: Int.Int^) ->
  OneSided.differential.apply one (left.apply degreeTwo (generator x y)) =
  left.apply one (Total.differential.apply one (generator x y)) :=
  \fun (x, y: Int.Int^) => left.commutes one (generator x y);

\module Balanced;
