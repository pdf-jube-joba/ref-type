\import derived_functors.Tor[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing] \as Derived;
\import Derived.Balance[M := Z2.bundle, N := Z2.bundle, P := Presentation.complex, Q := Presentation.complex] \as Balance;
\import Balance.With[p := Presentation.resolution, q := Presentation.resolution] \as Balanced;
\import Derived.Of[M := Z2.bundle, N := Z2.bundle, P := Presentation.complex].At[n := one] \as H;
\import Balance.At[n := one] \as DoubleHomology;
\import Balanced.At[n := one] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := H.Carrier, W := H.Carrier, source := H.space, target := H.space].Isomorphism := Comparison.isomorphism;
\definition onDoubleTotal: \forall (x: DoubleHomology.Carrier) ->
  isomorphism.forward.apply (Comparison.leftIsomorphism.forward.apply x) =
  Comparison.rightIsomorphism.forward.apply x := Comparison.onTotal;
\definition leftInverse: \forall (x: H.Carrier) ->
  isomorphism.backward.apply (isomorphism.forward.apply x) = x := isomorphism.leftInverse;
\definition rightInverse: \forall (x: H.Carrier) ->
  isomorphism.forward.apply (isomorphism.backward.apply x) = x := isomorphism.rightInverse;
