\import derived_functors.Ext[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Extension[
  M := Z2.bundle, N := Z4.bundle, P := Presentation.complex].With[resolution := Presentation.resolution] \as Classes;
\import resolutions.Resolution[].Over[R := Int.Int^, ring := Ring.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing].Of[
  M := Z2.bundle, P := Presentation.complex] \as NativeResolution;
\import Presentation.Term[n := Nat.Nat^::zero] \as DegreeZero;
\import Modules.Of[V := DegreeZero.Carrier, space := DegreeZero.space].Submodule[].Of[
  S := NativeResolution.augmentationKernel Presentation.resolution] \as Kernel;
\import Modules.Hom[V := Kernel.Carrier, W := Z4.Carrier, source := Kernel.moduleSpace, target := Z4.space] \as Relations;
\import derived_functors.Ext[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Of[M := Z2.bundle, N := Z4.bundle, P := Presentation.complex].At[n := one] \as H;
\definition represented: \forall (x: H.Carrier) ->
  \exists { f: Relations.Map \where Classes.RepresentationClass[f := f].extClass = x } := Classes.represented;
\import Modules.Biproduct[V := Z4.Carrier, W := Z2.Carrier, left := Z4.space, right := Z2.space] \as Sum;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Sum.Carrier, space := Sum.space };
\import Modules.ShortExact[A := Z4.bundle, B := bundle, C := Z2.bundle] \as Sequences;
\import std.Data[].Pair[].Prop[A := Z4.Carrier, B := Z2.Carrier] \as Pairs;
\definition sequence: Sequences.Sequence := Sequences.Sequence {
  inclusion := Sum.firstInjection, projection := Sum.secondProjection,
  injective := \fun (x, y: Z4.Carrier)(equal: Sum.firstInjection.apply x = Sum.firstInjection.apply y) =>
    congr!{Sum.Carrier Z4.Carrier} Sum.first (Sum.firstInjection.apply x) (Sum.firstInjection.apply y) equal,
  onto := \fun (x: Z2.Carrier) => \exact(\into[Sum.Carrier](Sum.secondInjection.apply x,
    { y: Sum.Carrier \where Sum.secondProjection.apply y = x }) \by { \refl(x) },
      \Cast[Sum.Carrier] ({ y: Sum.Carrier \where Sum.secondProjection.apply y = x })),
  zero := \fun (x: Z4.Carrier) => \refl(Z2.space.zero),
  kernelImage := \fun (x: Sum.Carrier)(closed: Sum.secondProjection.apply x = Z2.space.zero) =>
    \exact(\into[Z4.Carrier](Sum.first x, { y: Z4.Carrier \where Sum.firstInjection.apply y = x }) \by {
      Pairs.ext (Sum.firstInjection.apply (Sum.first x)) x (\refl(Sum.first x)) (sym!{Z2.Carrier} (Sum.second x) Z2.space.zero closed)
    }, \Cast[Z4.Carrier] ({ y: Z4.Carrier \where Sum.firstInjection.apply y = x })),
};
\import Classes.OfExtension[E := bundle].With[s := sequence] \as SplitClass;
\definition splitClassZero: SplitClass.extClass = H.space.zero := SplitClass.splitZero Sum.secondInjection Sum.secondRoundtrip;
