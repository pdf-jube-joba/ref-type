\import Modules.ProjectiveLaws[].Scalar[] \as Scalar;
\import derived_functors.Tor[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing] \as Tor;
\import Tor.Of[M := Z2.bundle, N := Scalar.bundle, P := Presentation.complex] \as Integral;
\import Tor.ProjectiveSecond[M := Z2.bundle, N := Scalar.bundle, P := Presentation.complex] \as ProjectiveSecond;
\module Positive(n: Nat.Nat^) {
  \import Integral.Positive[n := n] \as H;
  \import ProjectiveSecond.Positive[n := n] \as Vanishing;
  \definition trivial: \forall (x: H.Carrier) -> x = #zero{H.space} :=
    Vanishing.vanishing Scalar.projective Presentation.resolution;
}
