\definition augmented: \forall (x: P.family.Carrier Nat.Nat^::zero) ->
  resolution.augmentation.apply (ChainIdentity.identity.apply Nat.Nat^::zero x) =
  AugmentedIdentity.identity.apply (resolution.augmentation.apply x) :=
  \fun (x: P.family.Carrier Nat.Nat^::zero) => \refl(resolution.augmentation.apply x);
\module DegreeZero;
\module Positive(n: Nat.Nat^);
