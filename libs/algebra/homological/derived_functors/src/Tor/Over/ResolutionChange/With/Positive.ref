\import First.At[n := Nat.Nat^::succ n] \as Source;
\import Third.At[n := Nat.Nat^::succ n] \as Target;
\import FirstChange.Positive[n := n] \as First;
\import SecondChange.Positive[n := n] \as Second;
\import DirectChange.Positive[n := n] \as Direct;
\import SelfChange.Positive[n := n] \as Self;
\import Composition.Positive[n := n] \as Law;
\import IdentityLaw.Positive[n := n] \as Identity;
\definition composition: \forall (x: Source.Carrier) ->
  Direct.isomorphism.forward.apply x = Second.isomorphism.forward.apply (First.isomorphism.forward.apply x) := Law.composition;
\definition identity: \forall (x: Source.Carrier) -> Self.isomorphism.forward.apply x = x := Identity.identity;
