\import First.At[n := Nat.Nat^::zero] \as Source;
\import Third.At[n := Nat.Nat^::zero] \as Target;
\import FirstChange.DegreeZero[] \as First;
\import SecondChange.DegreeZero[] \as Second;
\import DirectChange.DegreeZero[] \as Direct;
\import SelfChange.DegreeZero[] \as Self;
\import Composition.DegreeZero[] \as Law;
\import IdentityLaw.DegreeZero[] \as Identity;
\definition composition: \forall (x: Source.Carrier) ->
  Direct.isomorphism.forward.apply x = Second.isomorphism.forward.apply (First.isomorphism.forward.apply x) := Law.composition;
\definition identity: \forall (x: Source.Carrier) -> Self.isomorphism.forward.apply x = x := Identity.identity;
