\import Source.At[n := Nat.Nat^::zero] \as SourceTerm;
\import Target.At[n := Nat.Nat^::zero] \as TargetTerm;
\import Maps.DegreeZero[] \as Induced;
\definition composition: \forall (u: Before.Map)(v: After.Map)(q: SourceTerm.Carrier) ->
  (Direct.DegreeZero[].map (Coefficients.compose v u)).apply q =
    (Second.DegreeZero[].map v).apply ((First.DegreeZero[].map u).apply q) :=
  \fun (u: Before.Map)(v: After.Map)(q: SourceTerm.Carrier) => trans!{TargetTerm.Carrier} _ _ _
    (congr!{Maps.Map TargetTerm.Carrier} (\fun (f: Maps.Map) => (Induced.induced f).apply q) _ _ (chainLaw u v))
    (Composition.DegreeZero[].compositionOnHomology (Second.chainMap v) (First.chainMap u) q);
