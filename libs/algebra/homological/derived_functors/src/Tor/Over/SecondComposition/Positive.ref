\import Source.At[n := Nat.Nat^::succ n] \as SourceTerm;
\import Target.At[n := Nat.Nat^::succ n] \as TargetTerm;
\import Maps.Positive[n := n] \as Induced;
\definition composition: \forall (u: Before.Map)(v: After.Map)(q: SourceTerm.Carrier) ->
  (Direct.Positive[n := n].map (Coefficients.compose v u)).apply q =
    (Second.Positive[n := n].map v).apply ((First.Positive[n := n].map u).apply q) :=
  \fun (u: Before.Map)(v: After.Map)(q: SourceTerm.Carrier) => trans!{TargetTerm.Carrier} _ _ _
    (congr!{Maps.Map TargetTerm.Carrier} (\fun (f: Maps.Map) => (Induced.induced f).apply q) _ _ (chainLaw u v))
    (Composition.Positive[n := n].compositionOnHomology (Second.chainMap v) (First.chainMap u) q);
