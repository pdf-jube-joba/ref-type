\import derived_functors.Tor[].Over[R := R, ring := ring].Independence[M := B, N := N, P := middleComplex, Q := S].Selected[p := Middle.resolution, q := r] \as Comparison;
\module At(n: Nat.Nat^) {
  \import \parent.\parent.At[n := n] \as Source;
  \import Comparison.At[n := Nat.Nat^::succ n] \as Change;
  \import Comparison.At[n := n] \as NextChange;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := A, N := N, P := P].At[n := Nat.Nat^::succ n] \as Left;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := C, N := N, P := Q].At[n := Nat.Nat^::succ n] \as Right;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := A, N := N, P := P].At[n := n] \as Next;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := B, N := N, P := middleComplex].At[n := Nat.Nat^::succ n] \as OldMiddle;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := B, N := N, P := middleComplex].At[n := n] \as OldNextMiddle;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := B, N := N, P := S].At[n := Nat.Nat^::succ n] \as NewMiddle;
  \import derived_functors.Tor[].Over[R := R, ring := ring].Of[M := B, N := N, P := S].At[n := n] \as NewNextMiddle;
  \import Modules.Hom[V := OldMiddle.Carrier, W := NewMiddle.Carrier, source := OldMiddle.space, target := NewMiddle.space].Composition[U := Left.Carrier, domain := Left.space] \as Inclusions;
  \import Modules.Hom[V := OldMiddle.Carrier, W := Right.Carrier, source := OldMiddle.space, target := Right.space].Composition[U := NewMiddle.Carrier, domain := NewMiddle.space] \as Projections;
  \import Modules.Hom[V := OldNextMiddle.Carrier, W := NewNextMiddle.Carrier, source := OldNextMiddle.space, target := NewNextMiddle.space].Composition[U := Next.Carrier, domain := Next.space] \as NextInclusions;
  \definition inclusion: Modules.MapBetween Left.bundle NewMiddle.bundle := Inclusions.compose Change.isomorphism.forward Source.inclusion;
  \definition projection: Modules.MapBetween NewMiddle.bundle Right.bundle := Projections.compose Source.projection Change.isomorphism.backward;
  \definition connecting: Modules.MapBetween Right.bundle Next.bundle := Source.connecting;
  \definition nextInclusion: Modules.MapBetween Next.bundle NewNextMiddle.bundle := NextInclusions.compose NextChange.isomorphism.forward Source.nextInclusion;
  \import Modules.End[V := Left.Carrier, space := Left.space] \as LeftIdentity;
  \import Modules.End[V := Right.Carrier, space := Right.space] \as RightIdentity;
  \import Modules.End[V := Next.Carrier, space := Next.space] \as NextIdentity;
  \definition leftIsomorphism: Modules.Isomorphism[V := Left.Carrier, W := Left.Carrier, source := Left.space, target := Left.space].Isomorphism :=
    Modules.Isomorphism[V := Left.Carrier, W := Left.Carrier, source := Left.space, target := Left.space].Isomorphism {
      forward := LeftIdentity.identity, backward := LeftIdentity.identity,
      leftInverse := \fun (x: Left.Carrier) => \refl(x), rightInverse := \fun (x: Left.Carrier) => \refl(x),
    };
  \definition rightIsomorphism: Modules.Isomorphism[V := Right.Carrier, W := Right.Carrier, source := Right.space, target := Right.space].Isomorphism :=
    Modules.Isomorphism[V := Right.Carrier, W := Right.Carrier, source := Right.space, target := Right.space].Isomorphism {
      forward := RightIdentity.identity, backward := RightIdentity.identity,
      leftInverse := \fun (x: Right.Carrier) => \refl(x), rightInverse := \fun (x: Right.Carrier) => \refl(x),
    };
  \definition nextIsomorphism: Modules.Isomorphism[V := Next.Carrier, W := Next.Carrier, source := Next.space, target := Next.space].Isomorphism :=
    Modules.Isomorphism[V := Next.Carrier, W := Next.Carrier, source := Next.space, target := Next.space].Isomorphism {
      forward := NextIdentity.identity, backward := NextIdentity.identity,
      leftInverse := \fun (x: Next.Carrier) => \refl(x), rightInverse := \fun (x: Next.Carrier) => \refl(x),
    };
  \import Modules.ExactPair[A := Left.bundle, B := OldMiddle.bundle, C := Right.bundle] \as MiddlePair;
  \definition middleSource: MiddlePair.Sequence := MiddlePair.Sequence {
    first := Source.inclusion, last := Source.projection,
    zero := Source.inclusionProjectionZero, kernelImage := Source.exactAtB,
  };
  \import MiddlePair.Transport[A1 := Left.bundle, B1 := NewMiddle.bundle, C1 := Right.bundle, sequence := middleSource,
    f := inclusion, g := projection, a := leftIsomorphism, b := Change.isomorphism, c := rightIsomorphism] \as MiddleTransport;
  \definition inclusionCommutes: \forall (x: Left.Carrier) -> Change.isomorphism.forward.apply (Source.inclusion.apply x) = inclusion.apply x :=
    \fun (x: Left.Carrier) => \refl(inclusion.apply x);
  \definition projectionCommutes: \forall (x: OldMiddle.Carrier) -> Source.projection.apply x = projection.apply (Change.isomorphism.forward.apply x) :=
    \fun (x: OldMiddle.Carrier) => sym!{Right.Carrier} _ _
      (congr!{OldMiddle.Carrier Right.Carrier} (Source.projection.apply) _ _ (Change.isomorphism.leftInverse x));
  \import Modules.ExactPair[A := OldMiddle.bundle, B := Right.bundle, C := Next.bundle] \as RightPair;
  \definition rightSource: RightPair.Sequence := RightPair.Sequence {
    first := Source.projection, last := Source.connecting,
    zero := Source.projectionConnectingZero, kernelImage := Source.exactAtC,
  };
  \import RightPair.Transport[A1 := NewMiddle.bundle, B1 := Right.bundle, C1 := Next.bundle, sequence := rightSource,
    f := projection, g := connecting, a := Change.isomorphism, b := rightIsomorphism, c := nextIsomorphism] \as RightTransport;
  \definition connectingCommutes: \forall (x: Right.Carrier) -> Source.connecting.apply x = connecting.apply x := \fun (x: Right.Carrier) => \refl(connecting.apply x);
  \import Modules.ExactPair[A := Right.bundle, B := Next.bundle, C := OldNextMiddle.bundle] \as NextPair;
  \definition nextSource: NextPair.Sequence := NextPair.Sequence {
    first := Source.connecting, last := Source.nextInclusion,
    zero := Source.connectingInclusionZero, kernelImage := Source.exactAtALower,
  };
  \import NextPair.Transport[A1 := Right.bundle, B1 := Next.bundle, C1 := NewNextMiddle.bundle, sequence := nextSource,
    f := connecting, g := nextInclusion, a := rightIsomorphism, b := nextIsomorphism, c := NextChange.isomorphism] \as NextTransport;
  \definition nextInclusionCommutes: \forall (x: Next.Carrier) -> NextChange.isomorphism.forward.apply (Source.nextInclusion.apply x) = nextInclusion.apply x :=
    \fun (x: Next.Carrier) => \refl(nextInclusion.apply x);
  \definition inclusionProjectionZero: \forall (x: Left.Carrier) -> projection.apply (inclusion.apply x) = Right.space.zero := MiddleTransport.zero inclusionCommutes projectionCommutes;
  \definition projectionConnectingZero: \forall (x: NewMiddle.Carrier) -> connecting.apply (projection.apply x) = Next.space.zero := RightTransport.zero projectionCommutes connectingCommutes;
  \definition connectingInclusionZero: \forall (x: Right.Carrier) -> nextInclusion.apply (connecting.apply x) = NewNextMiddle.space.zero := NextTransport.zero connectingCommutes nextInclusionCommutes;
  \definition exactAtB: \forall (x: NewMiddle.Carrier) -> projection.apply x = Right.space.zero ->
    \exists { y: Left.Carrier \where inclusion.apply y = x } := MiddleTransport.kernelImage inclusionCommutes projectionCommutes;
  \definition exactAtC: \forall (x: Right.Carrier) -> connecting.apply x = Next.space.zero ->
    \exists { y: NewMiddle.Carrier \where projection.apply y = x } := RightTransport.kernelImage projectionCommutes connectingCommutes;
  \definition exactAtALower: \forall (x: Next.Carrier) -> nextInclusion.apply x = NewNextMiddle.space.zero ->
    \exists { y: Right.Carrier \where connecting.apply y = x } := NextTransport.kernelImage connectingCommutes nextInclusionCommutes;
}
