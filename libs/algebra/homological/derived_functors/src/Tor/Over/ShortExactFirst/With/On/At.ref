\definition higher: Nat.Nat^ := Nat.Nat^::succ n;
\import IntegerSequence.At[n := n] \as Exact;
\import Exact.Exactness[] \as Exactness;
\import Chains.Map[C := Left.tensorComplex, D := Center.tensorComplex].HomologyAt[n := higher] \as InclusionMaps;
\import Chains.Map[C := Center.tensorComplex, D := Right.tensorComplex].HomologyAt[n := higher] \as ProjectionMaps;
\import Chains.Map[C := Left.tensorComplex, D := Center.tensorComplex].HomologyAt[n := n] \as NextMaps;
\definition inclusion: Modules.Hom[V := Left.At[n := higher].Carrier, W := Center.At[n := higher].Carrier, source := Left.At[n := higher].space, target := Center.At[n := higher].space].Map := InclusionMaps.induced sequence.inclusion;
\definition projection: Modules.Hom[V := Center.At[n := higher].Carrier, W := Right.At[n := higher].Carrier, source := Center.At[n := higher].space, target := Right.At[n := higher].space].Map := ProjectionMaps.induced sequence.projection;
\definition connecting: Modules.Hom[V := Right.At[n := higher].Carrier, W := Left.At[n := n].Carrier, source := Right.At[n := higher].space, target := Left.At[n := n].space].Map := Exact.connecting;
\definition nextInclusion: Modules.Hom[V := Left.At[n := n].Carrier, W := Center.At[n := n].Carrier, source := Left.At[n := n].space, target := Center.At[n := n].space].Map := NextMaps.induced sequence.inclusion;
\definition inclusionProjectionZero: \forall (x: Left.At[n := higher].Carrier) -> projection.apply (inclusion.apply x) = (Right.At[n := higher].space).zero := Exactness.inclusionProjectionZero;
\definition projectionConnectingZero: \forall (x: Center.At[n := higher].Carrier) -> connecting.apply (projection.apply x) = (Left.At[n := n].space).zero := Exactness.projectionConnectingZero;
\definition connectingInclusionZero: \forall (x: Right.At[n := higher].Carrier) -> nextInclusion.apply (connecting.apply x) = (Center.At[n := n].space).zero := Exactness.connectingInclusionZero;
\definition exactAtB: \forall (x: Center.At[n := higher].Carrier) -> projection.apply x = (Right.At[n := higher].space).zero -> \exists { y: Left.At[n := higher].Carrier \where inclusion.apply y = x } := Exactness.exactAtB;
\definition exactAtC: \forall (x: Right.At[n := higher].Carrier) -> connecting.apply x = (Left.At[n := n].space).zero -> \exists { y: Center.At[n := higher].Carrier \where projection.apply y = x } := Exactness.exactAtC;
\definition exactAtALower: \forall (x: Left.At[n := n].Carrier) -> nextInclusion.apply x = (Center.At[n := n].space).zero -> \exists { y: Right.At[n := higher].Carrier \where connecting.apply y = x } := Exactness.exactAtALower;
