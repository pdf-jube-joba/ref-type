\import derived_functors.Tor[].Over[R := R, ring := ring] \as Tor;
\import Tor.Of[M := A1, N := N, P := P1] \as TargetLeft;
\import Tor.Of[M := B1, N := N, P := Target.middleComplex] \as TargetMiddle;
\import Tor.Of[M := C1, N := N, P := Q1] \as TargetRight;
\import Tor.First[M := A, L := A1, N := N, P := P, Q := P1] \as LeftAction;
\import Tor.First[M := B, L := B1, N := N, P := middleComplex, Q := Target.middleComplex] \as MiddleAction;
\import Tor.First[M := C, L := C1, N := N, P := Q, Q := Q1] \as RightAction;
\definition leftMap: Chains.Map[C := Left.tensorComplex, D := TargetLeft.tensorComplex].Map := LeftAction.chainMap lift.left;
\definition middleMap: Chains.Map[C := Center.tensorComplex, D := TargetMiddle.tensorComplex].Map := MiddleAction.chainMap lift.middle;
\definition rightMap: Chains.Map[C := Right.tensorComplex, D := TargetRight.tensorComplex].Map := RightAction.chainMap lift.right;
\import resolutions.TensorComplex[].Over[R := R, ring := ring].Square[A := P, B := middleComplex, C := P1, D := Target.middleComplex, N := N].With[
  i := chainSequence.inclusion, j := Target.chainSequence.inclusion, a := lift.left, b := lift.middle] \as LeftSquare;
\import resolutions.TensorComplex[].Over[R := R, ring := ring].Square[A := middleComplex, B := Q, C := Target.middleComplex, D := Q1, N := N].With[
  i := chainSequence.projection, j := Target.chainSequence.projection, a := lift.middle, b := lift.right] \as RightSquare;
\import Chains.ShortExact[A := Left.tensorComplex, B := Center.tensorComplex, C := Right.tensorComplex].Morphism[
  A1 := TargetLeft.tensorComplex, B1 := TargetMiddle.tensorComplex, C1 := TargetRight.tensorComplex].Diagram[
    s := sequence, t := Target.sequence, a := leftMap, b := middleMap, c := rightMap] \as Diagram;
\definition rightCommutes: RightSquare.Commutes := \fun (n: Nat.Nat^)(x: middleComplex.family.Carrier n) =>
  sym!{{Q1.family.Carrier n}} _ _ (lift.diagram.right n x);
\definition commutative: Diagram.Commutative := Diagram.Commutative {
  left := LeftSquare.naturality lift.diagram.left,
  right := \fun (n: Nat.Nat^)(x: Center.tensorCarrier n) =>
    sym!{{TargetRight.tensorCarrier n}} _ _ (RightSquare.naturality rightCommutes n x),
};
\module At(n: Nat.Nat^) {
  \definition higher: Nat.Nat^ := Nat.Nat^::succ n;
  \import Tor.Of[M := C, N := N, P := Q].At[n := higher] \as Domain;
  \import Tor.Of[M := C1, N := N, P := Q1].At[n := higher] \as Codomain;
  \import Tor.Of[M := A, N := N, P := P].At[n := n] \as SourceLower;
  \import Tor.Of[M := A1, N := N, P := P1].At[n := n] \as TargetLower;
  \import LeftAction.With[p := p, q := p1, f := f.left] \as LeftFunctor;
  \import RightAction.With[p := q, q := q1, f := f.right] \as RightFunctor;
  \import Chains.Map[C := Left.tensorComplex, D := TargetLeft.tensorComplex].HomologyAt[n := n] \as LeftInduced;
  \import Chains.Map[C := Right.tensorComplex, D := TargetRight.tensorComplex].HomologyAt[n := higher] \as RightInduced;
  \import derived_functors.Tor[].Over[R := R, ring := ring].ShortExactFirst[A := A, B := B, C := C, N := N, P := P, Q := Q].With[
    sequence := coefficientSequence, p := p, q := q].On[construction := construction].At[n := n] \as Source;
  \import Target.At[n := n] \as TargetConnecting;
  \definition leftCanonical: LeftFunctor.map n = LeftInduced.induced leftMap := LeftFunctor.onComparison n lift.left lift.leftAugmented;
  \definition rightCanonical: RightFunctor.map higher = RightInduced.induced rightMap := RightFunctor.onComparison higher lift.right lift.rightAugmented;
  \definition naturality: \forall (x: Domain.Carrier) ->
    TargetConnecting.connecting.apply ((RightFunctor.map higher).apply x) = (LeftFunctor.map n).apply (Source.connecting.apply x) :=
    \fun (x: Domain.Carrier) => trans!{TargetLower.Carrier} _ _ _
      (congr!{Codomain.Carrier TargetLower.Carrier} (TargetConnecting.connecting.apply) _ _
        (congr!{{Modules.MapBetween Domain.bundle Codomain.bundle} Codomain.Carrier}
          (\fun (g: Modules.MapBetween Domain.bundle Codomain.bundle) => g.apply x) _ _ rightCanonical))
      (trans!{TargetLower.Carrier} _ _ _ (Diagram.At[n := n].naturality commutative x)
        (congr!{{Modules.MapBetween SourceLower.bundle TargetLower.bundle} TargetLower.Carrier}
          (\fun (g: Modules.MapBetween SourceLower.bundle TargetLower.bundle) => g.apply (Source.connecting.apply x)) _ _
          (sym!{{Modules.MapBetween SourceLower.bundle TargetLower.bundle}} _ _ leftCanonical)));
}
