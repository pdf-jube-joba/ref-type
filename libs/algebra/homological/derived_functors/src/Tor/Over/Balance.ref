\import \parent.Of[M := M, N := N, P := P] \as Left;
\import \parent.Of[M := N, N := M, P := Q] \as Right;
\import resolutions.ResolutionTensor[].Over[R := R, ring := ring].Double[M := M, N := N, P := P, Q := Q] \as Double;
\import double_complexes.DoubleComplex[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Doubles;
\import Doubles.Tensor[C := P, D := Q] \as Tensor;
\import Doubles.Total[C := Tensor.complex] \as Total;
\definition complex: Chains.Complex := Total.complex;
\import Chains.ProjectiveResolution[M := M] \as LeftModule;
\import Chains.ProjectiveResolution[M := N] \as RightModule;
\import Doubles.Tensor[C := P, D := RightModule.complex] \as LeftTensor;
\import Doubles.Tensor[C := LeftModule.complex, D := Q] \as RightTensor;
\import Doubles.Total[C := LeftTensor.complex] \as LeftTotal;
\import Doubles.Total[C := RightTensor.complex] \as RightTotal;
\module With(p: Left.Resolution, q: Right.Resolution);
\module At(n: Nat.Nat^) {
  \import Chains.Homology[C := complex].At[n := n] \as H;
  \definition Carrier: \Set := H.Carrier;
  \definition space: Modules.Space Carrier := H.space;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
}
\import resolutions.TensorComplex[].Over[R := R, ring := ring].On[P := P, N := N] \as StandardLeft;
\import resolutions.TensorComplex[].Over[R := R, ring := ring].On[P := Q, N := M] \as StandardRight;
\import Double.Left[] \as LeftNormalization;
\import Double.Right[] \as RightNormalization;

\module Naturality(L, K: Modules.Bundle, S, T: Chains.Complex);
