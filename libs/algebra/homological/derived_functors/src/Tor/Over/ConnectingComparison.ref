\structure Data: \Set {
  cover: Modules.Isomorphism[V := V.Carrier, W := A.Carrier, source := V.space, target := A.space].Isomorphism,
  total: Modules.MapBetween V W,
  first: Modules.MapBetween A B,
  second: Modules.MapBetween C D,
  leftLower: Modules.MapBetween W B,
  rightUpper: Modules.MapBetween V C,
  rightLower: Modules.MapBetween W D,
  upper: Modules.Isomorphism[V := A.Carrier, W := C.Carrier, source := A.space, target := C.space].Isomorphism,
  lower: Modules.Isomorphism[V := B.Carrier, W := D.Carrier, source := B.space, target := D.space].Isomorphism,
}
\module On(data: Data) {
  \structure Laws: \Prop {
    first: \forall (x: V.Carrier) -> data.first.apply (data.cover.forward.apply x) = data.leftLower.apply (data.total.apply x),
    second: \forall (x: V.Carrier) -> data.second.apply (data.rightUpper.apply x) = data.rightLower.apply (data.total.apply x),
    upper: \forall (x: V.Carrier) -> data.upper.forward.apply (data.cover.forward.apply x) = data.rightUpper.apply x,
    lower: \forall (x: W.Carrier) -> data.lower.forward.apply (data.leftLower.apply x) = data.rightLower.apply x,
  }
  \definition lift(x: A.Carrier): V.Carrier := data.cover.backward.apply x;
  \definition upper: \forall (laws: Laws)(x: A.Carrier) -> data.upper.forward.apply x = data.rightUpper.apply (lift x) :=
    \fun (laws: Laws)(x: A.Carrier) => trans!{C.Carrier} _ _ _
      (congr!{A.Carrier C.Carrier} (data.upper.forward.apply) _ _ (sym!{A.Carrier} _ _ (data.cover.rightInverse x))) (laws.upper (lift x));
  \definition naturality: \forall (laws: Laws)(x: A.Carrier) ->
    data.lower.forward.apply (data.first.apply x) = data.second.apply (data.upper.forward.apply x) :=
    \fun (laws: Laws)(x: A.Carrier) => sym!{D.Carrier} _ _
      (trans!{D.Carrier} _ _ _
        (congr!{C.Carrier D.Carrier} (data.second.apply) _ _ (upper laws x))
        (trans!{D.Carrier} _ _ _ (laws.second (lift x))
          (trans!{D.Carrier} _ _ _ (sym!{D.Carrier} _ _ (laws.lower (data.total.apply (lift x))))
            (trans!{D.Carrier} _ _ _
              (congr!{B.Carrier D.Carrier} (data.lower.forward.apply) _ _ (sym!{B.Carrier} _ _ (laws.first (lift x))))
              (congr!{A.Carrier D.Carrier} (\fun (y: A.Carrier) => data.lower.forward.apply (data.first.apply y)) _ _ (data.cover.rightInverse x))))));
}
