\definition term: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier n, space := P.family.space n };
\import Algebra.ProjectiveTensorShortExact[P := term, A := A, B := B, C := C].On[sequence := sequence] \as TermSequence;
\definition nativeSequence: Modules.ShortExact[
  A := Modules.Bundle { Carrier := Left.tensorCarrier n, space := Left.tensorSpace n },
  B := Modules.Bundle { Carrier := Middle.tensorCarrier n, space := Middle.tensorSpace n },
  C := Modules.Bundle { Carrier := Right.tensorCarrier n, space := Right.tensorSpace n }].Sequence := TermSequence.sequence (#projective{resolution} n);
\definition injective: \forall (x, y: Left.tensorCarrier n) -> #apply{data.inclusion} n x = #apply{data.inclusion} n y -> x = y := #injective{nativeSequence};
\definition onto: \forall (x: Right.tensorCarrier n) -> \exists { y: Middle.tensorCarrier n \where #apply{data.projection} n y = x } := #onto{nativeSequence};
\definition zero: \forall (x: Left.tensorCarrier n) -> #apply{data.projection} n (#apply{data.inclusion} n x) = #zero{(Right.tensorSpace n)} := #zero{nativeSequence};
\definition kernelImage: \forall (x: Middle.tensorCarrier n) -> #apply{data.projection} n x = #zero{(Right.tensorSpace n)} -> \exists { y: Left.tensorCarrier n \where #apply{data.inclusion} n y = x } := #kernelImage{nativeSequence};
