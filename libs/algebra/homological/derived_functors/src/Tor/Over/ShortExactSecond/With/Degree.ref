\definition term: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier n, space := P.family.space n };
\import Algebra.ProjectiveTensorShortExact[P := term, A := A, B := B, C := C].On[sequence := sequence] \as TermSequence;
\definition nativeSequence: Modules.ShortExact[
  A := Modules.Bundle { Carrier := Left.tensorCarrier n, space := Left.tensorSpace n },
  B := Modules.Bundle { Carrier := Middle.tensorCarrier n, space := Middle.tensorSpace n },
  C := Modules.Bundle { Carrier := Right.tensorCarrier n, space := Right.tensorSpace n }].Sequence := TermSequence.sequence (resolution.projective n);
\definition injective: \forall (x, y: Left.tensorCarrier n) -> data.inclusion.apply n x = data.inclusion.apply n y -> x = y := nativeSequence.injective;
\definition onto: \forall (x: Right.tensorCarrier n) -> \exists { y: Middle.tensorCarrier n \where data.projection.apply n y = x } := nativeSequence.onto;
\definition zero: \forall (x: Left.tensorCarrier n) -> data.projection.apply n (data.inclusion.apply n x) = (Right.tensorSpace n).zero := nativeSequence.zero;
\definition kernelImage: \forall (x: Middle.tensorCarrier n) -> data.projection.apply n x = (Right.tensorSpace n).zero -> \exists { y: Left.tensorCarrier n \where data.inclusion.apply n y = x } := nativeSequence.kernelImage;
