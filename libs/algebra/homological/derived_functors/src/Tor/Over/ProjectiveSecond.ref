\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Logic;
\import \parent.Of[M := M, N := N, P := P] \as Derived;
\import resolutions.ResolutionTensor[].Over[R := R, ring := ring].Of[P := N, N := M, Q := P] \as Reversed;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficient;
\module Degree(n: Nat.Nat^) {
  \import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as Tensor;
  \import Tensor.Symmetry[] \as Swap;
  \definition forward: Modules.Hom[V := Derived.tensorCarrier n, W := Reversed.Term[n := n].Carrier,
    source := Derived.tensorSpace n, target := Reversed.Term[n := n].space].Map := Swap.forward;
  \definition backward: Modules.Hom[V := Reversed.Term[n := n].Carrier, W := Derived.tensorCarrier n,
    source := Reversed.Term[n := n].space, target := Derived.tensorSpace n].Map := Swap.backward;
  \definition leftInverse: \forall (x: Derived.tensorCarrier n) -> backward.apply (forward.apply x) = x := Swap.leftInverse;
  \definition rightInverse: \forall (x: Reversed.Term[n := n].Carrier) -> forward.apply (backward.apply x) = x := Swap.rightInverse;
}
\module Step(n: Nat.Nat^) {
  \import Derived.TensorTerm[n := n] \as Differential;
  \import \parent.Degree[n := n] \as Current;
  \import \parent.Degree[n := Nat.Nat^::succ n] \as Next;
  \import Modules.Tensor[V := P.family.Carrier (Nat.Nat^::succ n), W := N.Carrier,
    left := P.family.space (Nat.Nat^::succ n), right := N.space].Symmetry[].Mapping[
    U := P.family.Carrier n, Z := N.Carrier, targetLeft := P.family.space n, targetRight := N.space] \as Naturality;
  \definition forwardCommutes: \forall (x: Derived.tensorCarrier (Nat.Nat^::succ n)) ->
    Reversed.complex.differential.apply n (Next.forward.apply x) = Current.forward.apply (Derived.tensorComplex.differential.apply n x) :=
    \fun (x: Derived.tensorCarrier (Nat.Nat^::succ n)) => sym!{{Reversed.Term[n := n].Carrier}} _ _
      (Naturality.commutes Differential.original Coefficient.identity x);
  \definition backwardCommutes: \forall (x: Reversed.Term[n := Nat.Nat^::succ n].Carrier) ->
    Derived.tensorComplex.differential.apply n (Next.backward.apply x) = Current.backward.apply (Reversed.complex.differential.apply n x) :=
    \fun (x: Reversed.Term[n := Nat.Nat^::succ n].Carrier) => eq_reason_in!{{Derived.tensorCarrier n} _
      "=" _ "by" { sym!{{Derived.tensorCarrier n}} _ _ (Current.leftInverse (Derived.tensorComplex.differential.apply n (Next.backward.apply x))) }
      "=" _ "by" { congr!{{Reversed.Term[n := n].Carrier} {Derived.tensorCarrier n}} (Current.backward.apply) _ _
          (sym!{{Reversed.Term[n := n].Carrier}} _ _ (forwardCommutes (Next.backward.apply x))) }
      "=" _ "by" { congr!{{Reversed.Term[n := Nat.Nat^::succ n].Carrier} {Derived.tensorCarrier n}}
          (\fun (y: Reversed.Term[n := Nat.Nat^::succ n].Carrier) => Current.backward.apply (Reversed.complex.differential.apply n y)) _ _
          (Next.rightInverse x) }
    };
}
\import Chains.Map[C := Derived.tensorComplex, D := Reversed.complex] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (n: Nat.Nat^) => (Degree[n := n].forward).apply,
  addition := \fun (n: Nat.Nat^) => (Degree[n := n].forward).addition,
  scalar := \fun (n: Nat.Nat^) => (Degree[n := n].forward).scalar,
  commutes := \fun (n: Nat.Nat^) => Step[n := n].forwardCommutes,
};
\import Chains.Map[C := Reversed.complex, D := Derived.tensorComplex] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (n: Nat.Nat^) => (Degree[n := n].backward).apply,
  addition := \fun (n: Nat.Nat^) => (Degree[n := n].backward).addition,
  scalar := \fun (n: Nat.Nat^) => (Degree[n := n].backward).scalar,
  commutes := \fun (n: Nat.Nat^) => Step[n := n].backwardCommutes,
};
\module Positive(n: Nat.Nat^) {
  \import Derived.Positive[n := n] \as H;
  \import \parent.Degree[n := Nat.Nat^::succ n] \as Current;
  \import \parent.Degree[n := Nat.Nat^::succ (Nat.Nat^::succ n)] \as Next;
  \import \parent.Step[n := Nat.Nat^::succ n] \as BoundaryStep;
  \import Chains.Positive[C := Derived.tensorComplex, n := n] \as Native;
  \import Chains.Positive[C := Reversed.complex, n := n] \as Target;
  \import Forward.Positive[n := n] \as Cycles;
  \import Modules.Of[V := Derived.tensorCarrier (Nat.Nat^::succ n), space := Derived.tensorSpace (Nat.Nat^::succ n)].Submodule[].Image[
    U := Derived.tensorCarrier (Nat.Nat^::succ (Nat.Nat^::succ n)), source := Derived.tensorSpace (Nat.Nat^::succ (Nat.Nat^::succ n))] \as Boundaries;
  \module With(resolution: Derived.Resolution) {
    \import Reversed.With[q := resolution] \as TensorResolution;
    \definition vanishing: Modules.Projective N -> \forall (q: H.Carrier) -> q = H.space.zero :=
      \fun (projective: Modules.Projective N) => H.classInduction (\fun (q: H.Carrier) => q = H.space.zero) (\block {
        \fun (x: H.Cycle) \then
        \let y: Target.Cycle := (Cycles.cyclesMap forward).apply x \then
        \takefrom z: \Cast[Reversed.Term[n := Nat.Nat^::succ (Nat.Nat^::succ n)].Carrier]
          ({ z: Reversed.Term[n := Nat.Nat^::succ (Nat.Nat^::succ n)].Carrier \where Reversed.complex.differential.apply (Nat.Nat^::succ n) z = y })
          \by TensorResolution.exact projective n y
            (\bysub(Reversed.Term[n := Nat.Nat^::succ n].Carrier, Target.cycles.carrier, y)) \then
        \return Native.boundaryClassZero x (Boundaries.introduce Native.prior x
          (Next.backward.apply z)
          (eq_reason_in!{{Derived.tensorCarrier (Nat.Nat^::succ n)} _
            "=" _ "by" { BoundaryStep.backwardCommutes z }
            "=" _ "by" { congr!{{Reversed.Term[n := Nat.Nat^::succ n].Carrier} {Derived.tensorCarrier (Nat.Nat^::succ n)}}
                (Current.backward.apply) _ _
                (\bysub(Reversed.Term[n := Nat.Nat^::succ (Nat.Nat^::succ n)].Carrier,
                  { z: Reversed.Term[n := Nat.Nat^::succ (Nat.Nat^::succ n)].Carrier \where Reversed.complex.differential.apply (Nat.Nat^::succ n) z = y }, z)) }
            "=" _ "by" { Current.leftInverse x }
          }))
      });
  }
  \definition vanishing: Modules.Projective N -> \forall (resolution: Derived.Resolution)(q: H.Carrier) -> q = H.space.zero :=
    \fun (projective: Modules.Projective N)(resolution: Derived.Resolution) => With[resolution := resolution].vanishing projective;
}
