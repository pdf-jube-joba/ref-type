\definition balance: _ :=
  \fun (M, N: Modules.Bundle)(P, Q: Chains.Complex)
    (p: \parent.Of[M := M, N := N, P := P].Resolution)
    (q: \parent.Of[M := N, N := M, P := Q].Resolution)(n: Nat.Nat^) =>
    \parent.Balance[M := M, N := N, P := P, Q := Q].With[p := p, q := q].At[n := n].onComparison;
\import resolutions.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Resolutions;
\definition connectingNaturality: _ :=
  \fun (A, B, C, N: Modules.Bundle)(P, Q, T: Chains.Complex)
    (sequence: Modules.ShortExact[A := A, B := B, C := C].Sequence)
    (p: Resolutions.Of[M := A, P := P].Resolution)
    (q: Resolutions.Of[M := C, P := Q].Resolution)
    (construction: Resolutions.Horseshoe[A := A, B := B, C := C, P := P, Q := Q].With[sequence := sequence, p := p, q := q].Construction)
    (t: Resolutions.Of[M := N, P := T].Resolution)(n: Nat.Nat^) =>
    \parent.ShortExactFirst[A := A, B := B, C := C, N := N, P := P, Q := Q].With[
      sequence := sequence, p := p, q := q].On[construction := construction].Balance[T := T].With[t := t].At[n := n].connectingNaturality;
