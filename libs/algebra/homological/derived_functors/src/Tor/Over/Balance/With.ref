\use std.Logic[].Equality[].eq_reason_in;
\import Double.With[p := p, q := q] \as Comparisons;
\definition left: Chains.Map[C := complex, D := Left.tensorComplex].Map := Chains.Map[C := complex, D := Left.tensorComplex].Map {
  apply := Comparisons.standardLeft.apply, addition := Comparisons.standardLeft.addition,
  scalar := Comparisons.standardLeft.scalar, commutes := Comparisons.standardLeft.commutes,
};
\definition right: Chains.Map[C := complex, D := Right.tensorComplex].Map := Chains.Map[C := complex, D := Right.tensorComplex].Map {
  apply := Comparisons.standardRight.apply, addition := Comparisons.standardRight.addition,
  scalar := Comparisons.standardRight.scalar, commutes := Comparisons.standardRight.commutes,
};
\definition leftChainMap: Chains.Map[C := complex, D := Left.tensorComplex].Map := left;
\definition rightChainMap: Chains.Map[C := complex, D := Right.tensorComplex].Map := right;
\module At(n: Nat.Nat^) {
  \import \parent.\parent.At[n := n] \as H;
  \definition left: Modules.Hom[V := H.Carrier, W := Left.At[n := n].Carrier, source := H.space, target := Left.At[n := n].space].Map :=
    Chains.Map[C := complex, D := Left.tensorComplex].HomologyAt[n := n].induced leftChainMap;
  \definition right: Modules.Hom[V := H.Carrier, W := Right.At[n := n].Carrier, source := H.space, target := Right.At[n := n].space].Map :=
    Chains.Map[C := complex, D := Right.tensorComplex].HomologyAt[n := n].induced rightChainMap;
  \definition leftIsomorphism: Modules.Isomorphism[V := H.Carrier, W := Left.At[n := n].Carrier, source := H.space, target := Left.At[n := n].space].Isomorphism :=
    \parent.LeftComparison[].At[n := n].isomorphism;
  \definition rightIsomorphism: Modules.Isomorphism[V := H.Carrier, W := Right.At[n := n].Carrier, source := H.space, target := Right.At[n := n].space].Isomorphism :=
    \parent.RightComparison[].At[n := n].isomorphism;
  \import Modules.Isomorphism[V := H.Carrier, W := Left.At[n := n].Carrier, source := H.space, target := Left.At[n := n].space].Inverse[] \as InverseLeft;
  \import Modules.Isomorphism[V := Left.At[n := n].Carrier, W := H.Carrier, source := Left.At[n := n].space, target := H.space].Composition[
    U := Right.At[n := n].Carrier, final := Right.At[n := n].space] \as Composition;
  \definition isomorphism: Modules.Isomorphism[V := Left.At[n := n].Carrier, W := Right.At[n := n].Carrier, source := Left.At[n := n].space, target := Right.At[n := n].space].Isomorphism :=
    Composition.compose rightIsomorphism (InverseLeft.inverse leftIsomorphism);
  \definition onTotal: \forall (x: H.Carrier) -> isomorphism.forward.apply (leftIsomorphism.forward.apply x) = rightIsomorphism.forward.apply x :=
    \fun (x: H.Carrier) => congr!{H.Carrier {Right.At[n := n].Carrier}} (rightIsomorphism.forward.apply) _ _ (leftIsomorphism.leftInverse x);
  \definition onComparison: \forall (x: H.Carrier) -> isomorphism.forward.apply (left.apply x) = right.apply x :=
    \fun (x: H.Carrier) => eq_reason_in!{{Right.At[n := n].Carrier} _
      "=" _ "by" { congr!{{Left.At[n := n].Carrier} {Right.At[n := n].Carrier}} (isomorphism.forward.apply) _ _
        (sym!{{Left.At[n := n].Carrier}} _ _ (\parent.LeftComparison[].At[n := n].forward x)) }
      "=" _ "by" { onTotal x }
      "=" _ "by" { \parent.RightComparison[].At[n := n].forward x }
    };
}

\module LeftComparison;

\module RightComparison;

\module Swap;
