\import \root.Tor[].Over[R := R, ring := ring].Balance[M := N, N := M, P := Q, Q := P].With[p := q, q := p] \as Swapped;
\import Doubles.Tensor[C := Q, D := P] \as SwappedTensor;
\import Doubles.Total[C := SwappedTensor.complex] \as SwappedTotal;
\import Doubles.TensorSwap[C := P, D := Q] \as Exchange;
\import Comparisons.Swap[] \as Raw;
\import Chains.Map[C := SwappedTotal.complex, D := Left.tensorComplex].Composition[B := complex] \as LeftCompose;
\import Chains.Map[C := SwappedTotal.complex, D := Right.tensorComplex].Composition[B := complex] \as RightCompose;
\definition leftSquare: leftChainMap = LeftCompose.compose Swapped.rightChainMap Exchange.forward :=
  Chains.Map[C := complex, D := Left.tensorComplex].ext leftChainMap (LeftCompose.compose Swapped.rightChainMap Exchange.forward) Raw.leftPoint;
\definition rightSquare: rightChainMap = RightCompose.compose Swapped.leftChainMap Exchange.forward :=
  Chains.Map[C := complex, D := Right.tensorComplex].ext rightChainMap (RightCompose.compose Swapped.leftChainMap Exchange.forward)
    (\fun (n: Nat.Nat^)(x: Total.Carrier n) => sym!{{Right.tensorCarrier n}} _ _ (Raw.Right[].point n x));
\module At(n: Nat.Nat^);
