\import \parent.\parent.At[n := n] \as Source;
\import Swapped.At[n := n] \as Target;
\import Chains.Homology[C := complex].At[n := n] \as H;
\import Chains.Map[C := complex, D := SwappedTotal.complex].HomologyAt[n := n] \as ExchangeMap;
\definition exchange: Modules.Hom[V := H.Carrier, W := Chains.Homology[C := SwappedTotal.complex].At[n := n].Carrier,
  source := H.space, target := Chains.Homology[C := SwappedTotal.complex].At[n := n].space].Map := ExchangeMap.induced Exchange.forward;
\definition leftDiagram: \forall (x: H.Carrier) -> #apply{Source.left} x = #apply{Target.right} (#apply{exchange} x) :=
  \fun (x: H.Carrier) => trans!{{Left.At[n := n].Carrier}} _ _ _
    (congr!{{Chains.Map[C := complex, D := Left.tensorComplex].Map} {Left.At[n := n].Carrier}}
      (\fun (f: Chains.Map[C := complex, D := Left.tensorComplex].Map) => #apply{(Chains.Map[C := complex, D := Left.tensorComplex].HomologyAt[n := n].induced f)} x) _ _ leftSquare)
    (LeftCompose.HomologyAt[n := n].composition Swapped.rightChainMap Exchange.forward x);
\definition rightDiagram: \forall (x: H.Carrier) -> #apply{Source.right} x = #apply{Target.left} (#apply{exchange} x) :=
  \fun (x: H.Carrier) => trans!{{Right.At[n := n].Carrier}} _ _ _
    (congr!{{Chains.Map[C := complex, D := Right.tensorComplex].Map} {Right.At[n := n].Carrier}}
      (\fun (f: Chains.Map[C := complex, D := Right.tensorComplex].Map) => #apply{(Chains.Map[C := complex, D := Right.tensorComplex].HomologyAt[n := n].induced f)} x) _ _ rightSquare)
    (RightCompose.HomologyAt[n := n].composition Swapped.leftChainMap Exchange.forward x);
\definition leftInverse: \forall (x: Left.At[n := n].Carrier) ->
  #apply{#forward{Target.isomorphism}} (#apply{#forward{Source.isomorphism}} x) = x := \block {
  \fun (x: Left.At[n := n].Carrier) \then
  \let y: H.Carrier := #apply{#backward{Source.leftIsomorphism}} x \then
  \let lift: #apply{Source.left} y = x := trans!{{Left.At[n := n].Carrier}} _ _ _
    (sym!{{Left.At[n := n].Carrier}} _ _ (\parent.\parent.LeftComparison[].At[n := n].forward y)) (#rightInverse{Source.leftIsomorphism} x) \then
  \return trans!{{Left.At[n := n].Carrier}} _ _ _
    (congr!{{Left.At[n := n].Carrier} {Left.At[n := n].Carrier}}
      (\fun (z: Left.At[n := n].Carrier) => #apply{#forward{Target.isomorphism}} (#apply{#forward{Source.isomorphism}} z)) _ _ (sym!{{Left.At[n := n].Carrier}} _ _ lift))
    (trans!{{Left.At[n := n].Carrier}} _ _ _
      (congr!{{Right.At[n := n].Carrier} {Left.At[n := n].Carrier}} (#apply{#forward{Target.isomorphism}}) _ _ (Source.onComparison y))
      (trans!{{Left.At[n := n].Carrier}} _ _ _
        (congr!{{Right.At[n := n].Carrier} {Left.At[n := n].Carrier}} (#apply{#forward{Target.isomorphism}}) _ _ (rightDiagram y))
        (trans!{{Left.At[n := n].Carrier}} _ _ _ (Target.onComparison (#apply{exchange} y))
          (trans!{{Left.At[n := n].Carrier}} _ _ _ (sym!{{Left.At[n := n].Carrier}} _ _ (leftDiagram y)) lift))))
};
\definition rightInverse: \forall (x: Right.At[n := n].Carrier) ->
  #apply{#forward{Source.isomorphism}} (#apply{#forward{Target.isomorphism}} x) = x := Swapped.Swap[].At[n := n].leftInverse;
