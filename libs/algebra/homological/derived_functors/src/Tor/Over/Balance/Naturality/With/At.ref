\import Chains.Homology[C := complex].At[n := n] \as SourceTotal;
\import Chains.Map[C := complex, D := TargetTotal.complex].HomologyAt[n := n] \as TotalInduced;
\import Chains.Map[C := Left.tensorComplex, D := TargetLeft.tensorComplex].HomologyAt[n := n] \as LeftInduced;
\import Chains.Map[C := Right.tensorComplex, D := TargetRight.tensorComplex].HomologyAt[n := n] \as RightInduced;
\definition left: Modules.Hom[V := Left.At[n := n].Carrier, W := TargetLeft.At[n := n].Carrier, source := Left.At[n := n].space, target := TargetLeft.At[n := n].space].Map := LeftInduced.induced leftAction;
\definition right: Modules.Hom[V := Right.At[n := n].Carrier, W := TargetRight.At[n := n].Carrier, source := Right.At[n := n].space, target := TargetRight.At[n := n].space].Map := RightInduced.induced rightAction;
\definition leftDiagram: RightAugmented -> \forall (x: SourceTotal.Carrier) ->
  (Target.At[n := n].left).apply ((TotalInduced.induced total).apply x) = left.apply ((Source.At[n := n].left).apply x) :=
  \fun (augmented: RightAugmented)(x: SourceTotal.Carrier) => trans!{{TargetLeft.At[n := n].Carrier}} _ _ _
    (sym!{{TargetLeft.At[n := n].Carrier}} _ _ (LeftAfter.HomologyAt[n := n].composition Target.left total x))
    (trans!{{TargetLeft.At[n := n].Carrier}} _ _ _
      (congr!{{Chains.Map[C := complex, D := TargetLeft.tensorComplex].Map} {TargetLeft.At[n := n].Carrier}}
        (\fun (h: Chains.Map[C := complex, D := TargetLeft.tensorComplex].Map) => (Chains.Map[C := complex, D := TargetLeft.tensorComplex].HomologyAt[n := n].induced h).apply x) _ _ (leftSquare augmented))
      (LeftBefore.HomologyAt[n := n].composition leftAction Source.left x));
\definition rightDiagram: LeftAugmented -> \forall (x: SourceTotal.Carrier) ->
  (Target.At[n := n].right).apply ((TotalInduced.induced total).apply x) = right.apply ((Source.At[n := n].right).apply x) :=
  \fun (augmented: LeftAugmented)(x: SourceTotal.Carrier) => trans!{{TargetRight.At[n := n].Carrier}} _ _ _
    (sym!{{TargetRight.At[n := n].Carrier}} _ _ (RightAfter.HomologyAt[n := n].composition Target.right total x))
    (trans!{{TargetRight.At[n := n].Carrier}} _ _ _
      (congr!{{Chains.Map[C := complex, D := TargetRight.tensorComplex].Map} {TargetRight.At[n := n].Carrier}}
        (\fun (h: Chains.Map[C := complex, D := TargetRight.tensorComplex].Map) => (Chains.Map[C := complex, D := TargetRight.tensorComplex].HomologyAt[n := n].induced h).apply x) _ _ (rightSquare augmented))
      (RightBefore.HomologyAt[n := n].composition rightAction Source.right x));
\definition naturality: LeftAugmented -> RightAugmented -> \forall (x: Left.At[n := n].Carrier) ->
  ((Target.At[n := n].isomorphism).forward).apply (left.apply x) = right.apply (((Source.At[n := n].isomorphism).forward).apply x) := \block {
  \fun (leftAugmented: LeftAugmented)(rightAugmented: RightAugmented)(x: Left.At[n := n].Carrier) \then
  \let y: SourceTotal.Carrier := ((Source.At[n := n].leftIsomorphism).backward).apply x \then
  \let lift: (Source.At[n := n].left).apply y = x := trans!{{Left.At[n := n].Carrier}} _ _ _
    (sym!{{Left.At[n := n].Carrier}} _ _ (Source.LeftComparison[].At[n := n].forward y)) ((Source.At[n := n].leftIsomorphism).rightInverse x) \then
  \return trans!{{TargetRight.At[n := n].Carrier}} _ _ _
    (congr!{{Left.At[n := n].Carrier} {TargetRight.At[n := n].Carrier}}
      (\fun (z: Left.At[n := n].Carrier) => ((Target.At[n := n].isomorphism).forward).apply (left.apply z)) _ _ (sym!{{Left.At[n := n].Carrier}} _ _ lift))
    (trans!{{TargetRight.At[n := n].Carrier}} _ _ _
      (congr!{{TargetLeft.At[n := n].Carrier} {TargetRight.At[n := n].Carrier}} (((Target.At[n := n].isomorphism).forward).apply) _ _ (sym!{{TargetLeft.At[n := n].Carrier}} _ _ (leftDiagram rightAugmented y)))
      (trans!{{TargetRight.At[n := n].Carrier}} _ _ _ (Target.At[n := n].onComparison ((TotalInduced.induced total).apply y))
        (trans!{{TargetRight.At[n := n].Carrier}} _ _ _ (rightDiagram leftAugmented y)
          (trans!{{TargetRight.At[n := n].Carrier}} _ _ _
            (congr!{{Right.At[n := n].Carrier} {TargetRight.At[n := n].Carrier}} (right.apply) _ _ (sym!{{Right.At[n := n].Carrier}} _ _ (Source.At[n := n].onComparison y)))
            (congr!{{Left.At[n := n].Carrier} {TargetRight.At[n := n].Carrier}}
              (\fun (z: Left.At[n := n].Carrier) => right.apply (((Source.At[n := n].isomorphism).forward).apply z)) _ _ lift)))))
};
