\import \parent.\parent.With[p := p, q := q] \as Source;
\import TargetModel.With[p := s, q := t] \as Target;
\import Double.Naturality[L := L, K := K, S := S, T := T].With[p := p, q := q, s := s, t := t, u := u, v := v, f := f, g := g] \as Comparison;
\definition LeftAugmented: \Prop := Comparison.LeftAugmented;
\definition RightAugmented: \Prop := Comparison.RightAugmented;
\definition total: Chains.Map[C := complex, D := TargetTotal.complex].Map := Comparison.total;
\definition leftAction: Chains.Map[C := Left.tensorComplex, D := TargetLeft.tensorComplex].Map := Chains.Map[C := Left.tensorComplex, D := TargetLeft.tensorComplex].Map {
  apply := Comparison.leftAction.apply, addition := Comparison.leftAction.addition,
  scalar := Comparison.leftAction.scalar, commutes := Comparison.leftAction.commutes,
};
\definition rightAction: Chains.Map[C := Right.tensorComplex, D := TargetRight.tensorComplex].Map := Chains.Map[C := Right.tensorComplex, D := TargetRight.tensorComplex].Map {
  apply := Comparison.rightAction.apply, addition := Comparison.rightAction.addition,
  scalar := Comparison.rightAction.scalar, commutes := Comparison.rightAction.commutes,
};
\import Chains.Map[C := TargetTotal.complex, D := TargetLeft.tensorComplex].Composition[B := complex] \as LeftAfter;
\import Chains.Map[C := Left.tensorComplex, D := TargetLeft.tensorComplex].Composition[B := complex] \as LeftBefore;
\import Chains.Map[C := TargetTotal.complex, D := TargetRight.tensorComplex].Composition[B := complex] \as RightAfter;
\import Chains.Map[C := Right.tensorComplex, D := TargetRight.tensorComplex].Composition[B := complex] \as RightBefore;
\definition leftSquare: RightAugmented -> LeftAfter.compose Target.left total = LeftBefore.compose leftAction Source.left :=
  \fun (augmented: RightAugmented) => Chains.Map[C := complex, D := TargetLeft.tensorComplex].ext
    (LeftAfter.compose Target.left total) (LeftBefore.compose leftAction Source.left) (Comparison.Left[].point augmented);
\definition rightSquare: LeftAugmented -> RightAfter.compose Target.right total = RightBefore.compose rightAction Source.right :=
  \fun (augmented: LeftAugmented) => Chains.Map[C := complex, D := TargetRight.tensorComplex].ext
    (RightAfter.compose Target.right total) (RightBefore.compose rightAction Source.right) (Comparison.Right[].point augmented);
\module At(n: Nat.Nat^);
