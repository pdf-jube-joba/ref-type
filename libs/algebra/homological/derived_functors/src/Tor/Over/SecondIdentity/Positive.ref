\import Tor.At[n := Nat.Nat^::succ n] \as Term;
\import TensorMaps.Positive[n := n] \as Induced;
\definition identity: \forall (q: Term.Carrier) -> (Action.Positive[n := n].map Coefficients.identity).apply q = q :=
  \fun (q: Term.Carrier) => trans!{Term.Carrier} _ _ _
    (congr!{TensorMaps.Map Term.Carrier} (\fun (f: TensorMaps.Map) => (Induced.induced f).apply q) _ _ chainLaw)
    (TensorIdentity.Positive[n := n].identityOnHomology q);
