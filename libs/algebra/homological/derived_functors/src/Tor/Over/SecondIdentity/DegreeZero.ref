\import Tor.At[n := Nat.Nat^::zero] \as Term;
\import TensorMaps.DegreeZero[] \as Induced;
\definition identity: \forall (q: Term.Carrier) -> #apply{(Action.DegreeZero[].map Coefficients.identity)} q = q :=
  \fun (q: Term.Carrier) => trans!{Term.Carrier} _ _ _
    (congr!{TensorMaps.Map Term.Carrier} (\fun (f: TensorMaps.Map) => #apply{(Induced.induced f)} q) _ _ chainLaw)
    (TensorIdentity.DegreeZero[].identityOnHomology q);
