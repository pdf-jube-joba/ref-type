\definition degree: Nat.Nat^ := Nat.Nat^::succ (Nat.Nat^::succ n);
\import Hom.At[n := degree] \as Term;
\import Derived.At[n := degree] \as H;
\definition trivial: \forall (f: Term.Carrier) -> f = #zero{Term.space} :=
  \fun (f: Term.Carrier) => Term.ext f (#zero{Term.space}) (\fun (x: family.Carrier degree) => trans!{A.Carrier} _ _ _
    (congr!{{family.Carrier degree} A.Carrier} (#apply{f}) x (zero degree) (highZero n x)) (Term.zeroPreserved f));
\definition vanishing: \forall (q: H.Carrier) -> q = H.zeroClass := H.vanishing trivial;
