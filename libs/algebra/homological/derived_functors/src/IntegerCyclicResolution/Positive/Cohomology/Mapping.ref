\import \parent.\parent.Cohomology[A := B] \as Target;
\import derived_functors.Ext[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Of[M := Cyclic.bundle, N := B, P := complex].At[n := one] \as TargetH;
\import Modules.Of[V := B.Carrier, space := B.space].Submodule[] \as TargetSub;
\import TargetSub.Image[U := B.Carrier, source := B.space] \as TargetImage;
\import Modules.QuotientMapping[A := A, B := B].On[S := multiples, T := Target.multiples, f := u] \as QuotientMap;
\definition compatible: QuotientMap.Compatible := \fun (x: A.Carrier)(member: _) =>
  CoefficientImage.eliminate multiplication x (TargetSub.Member Target.multiples (u.apply x))
    (\fun (a: A.Carrier)(represented: A.space.smul multiplier a = x) =>
      TargetImage.introduce Target.multiplication (u.apply x) (u.apply a)
        (trans!{B.Carrier} _ _ _ (sym!{B.Carrier} _ _ (u.scalar multiplier a))
          (congr!{A.Carrier B.Carrier} (u.apply) _ _ represented))) member;
\definition map: Modules.Hom[V := Quotient.Carrier, W := TargetSub.Quotient[S := Target.multiples].Carrier, source := Quotient.moduleSpace, target := TargetSub.Quotient[S := Target.multiples].moduleSpace].Map := QuotientMap.map compatible;
\import TargetSub.Quotient[S := Target.multiples] \as TargetQuotient;
\definition onCoefficientClass: \forall (x: A.Carrier) -> map.apply (Quotient.class x) = TargetQuotient.class (u.apply x) := QuotientMap.onClass compatible;
\import derived_functors.Ext[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Second[M := Cyclic.bundle, N := A, L := B, P := complex] \as Second;
\import Second.At[k := one] \as DerivedMap;
\import resolutions.HomComplex[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].On[P := complex, N := B] \as TargetHom;
\import Cochains.Map[C := Hom.complex, D := TargetHom.complex].At[k := one] \as Induced;
\definition onClasses: \forall (x: H.CycleCarrier) ->
  Target.isomorphism.forward.apply ((DerivedMap.map u).apply (H.classOf x)) = map.apply (isomorphism.forward.apply (H.classOf x)) :=
  \fun (x: H.CycleCarrier) => trans!{TargetQuotient.Carrier} _ _ _
    (congr!{TargetH.Carrier TargetQuotient.Carrier} (Target.isomorphism.forward.apply) _ _ (DerivedMap.onClass u x))
    (trans!{TargetQuotient.Carrier} _ _ _ (Target.onClass ((Induced.cyclesMap (Second.cochainMap u)).apply x))
      (trans!{TargetQuotient.Carrier} _ _ _ (sym!{TargetQuotient.Carrier} _ _ (QuotientMap.onClass compatible (forward.apply x)))
        (congr!{Quotient.Carrier TargetQuotient.Carrier} (map.apply) _ _ (sym!{Quotient.Carrier} _ _ (onClass x)))));
\definition naturality: \forall (q: H.Carrier) ->
  Target.isomorphism.forward.apply ((DerivedMap.map u).apply q) = map.apply (isomorphism.forward.apply q) := H.classInduction
    (\fun (q: H.Carrier) => Target.isomorphism.forward.apply ((DerivedMap.map u).apply q) = map.apply (isomorphism.forward.apply q)) onClasses;
