\import Int.Math[].Specification[].Prop[].Multiplication[] \as Multiplication;
\definition oneExact: \forall (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) -> apply Nat.Nat^::zero x = (family.space Nat.Nat^::zero).zero ->
  \exists ( y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where apply (Nat.Nat^::succ Nat.Nat^::zero) y = x ) :=
  \fun (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero))(killed: apply Nat.Nat^::zero x = (family.space Nat.Nat^::zero).zero) =>
    Logic.existsIntro[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)), { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where apply (Nat.Nat^::succ Nat.Nat^::zero) y = x }] (zero (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)))
    (sym!{Int.Int^} x Arithmetic.zero (Domain.positiveCancellation m x Arithmetic.zero
          (trans!{Int.Int^} (Arithmetic.mul multiplier x) Arithmetic.zero (Arithmetic.mul multiplier Arithmetic.zero) killed (sym!{Int.Int^} _ _ (Multiplication.mulZeroRight multiplier)))));
\definition highExact: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> apply (Nat.Nat^::succ n) x = (family.space (Nat.Nat^::succ n)).zero ->
  \exists ( y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))) \where apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x ) :=
  \fun (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)))(killed: _) =>
    Logic.existsIntro[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))), { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))) \where apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x }] (zero (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))))
    (sym!{Int.Int^} _ _ (highZero n x));
\definition exact: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ n)) -> apply n x = (family.space n).zero -> \exists ( y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where apply (Nat.Nat^::succ n) y = x ) :=
  \induction (n: Nat.Nat^) \return \forall (x: family.Carrier (Nat.Nat^::succ n)) -> apply n x = (family.space n).zero -> \exists ( y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where apply (Nat.Nat^::succ n) y = x ) \with {
    | zero: oneExact
    | succ: \fun (n: Nat.Nat^)(before: _) => highExact n
  };
