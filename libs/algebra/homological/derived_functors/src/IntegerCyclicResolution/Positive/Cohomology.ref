\import derived_functors.Ext[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Of[M := Cyclic.bundle, N := A, P := complex] \as Derived;
\import resolutions.HomComplex[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].On[P := complex, N := A] \as Hom;
\import chain_complexes.Cochain[].Over[R := Int.Int^, ring := Rings.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing] \as Cochains;
\definition one: Nat.Nat^ := Nat.Nat^::succ Nat.Nat^::zero;
\definition two: Nat.Nat^ := Nat.Nat^::succ one;
\import Derived.At[n := one] \as H;
\import Modules.Hom[V := family.Carrier one, W := A.Carrier, source := family.space one, target := A.space] \as OneHom;
\import Modules.Hom[V := family.Carrier Nat.Nat^::zero, W := A.Carrier, source := family.space Nat.Nat^::zero, target := A.space] \as ZeroHom;
\import Modules.Hom[V := family.Carrier two, W := A.Carrier, source := family.space two, target := A.space] \as TwoHom;
\import Modules.Laws[V := A.Carrier, space := A.space] \as Coefficient;
\import Int.Math[].Specification[].Prop[].Multiplication[] \as Multiplication;
\definition value[a: A.Carrier]: OneHom.Map := OneHom.Map {
  apply := \fun (r: family.Carrier one) => A.space.smul r a,
  addition := \fun (r, s: family.Carrier one) => A.space.scalarAdd r s a,
  scalar := \fun (r: Int.Int^)(s: family.Carrier one) => A.space.scalarAssoc r s a,
};
\definition zeroValue[a: A.Carrier]: ZeroHom.Map := ZeroHom.Map {
  apply := \fun (r: family.Carrier Nat.Nat^::zero) => A.space.smul r a,
  addition := \fun (r, s: family.Carrier Nat.Nat^::zero) => A.space.scalarAdd r s a,
  scalar := \fun (r: Int.Int^)(s: family.Carrier Nat.Nat^::zero) => A.space.scalarAssoc r s a,
};
\definition closed: \forall (f: OneHom.Map) -> Hom.apply one f = (Hom.space two).zero :=
  \fun (f: OneHom.Map) => TwoHom.ext (Hom.apply one f) ((Hom.space two).zero)
    (\fun (x: family.Carrier two) => OneHom.zeroPreserved f);
\definition cycle[a: A.Carrier]: H.CycleCarrier := \into[Hom.Carrier one](value a, H.cyclePredicate) \by { closed (value a) };
\import Modules.Hom[V := H.CycleCarrier, W := A.Carrier, source := H.cycleSpace, target := A.space] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (f: H.CycleCarrier) => f.apply (oneIntro Arithmetic.one),
  addition := \fun (f, g: H.CycleCarrier) => \refl(A.space.add (f.apply (oneIntro Arithmetic.one)) (g.apply (oneIntro Arithmetic.one))),
  scalar := \fun (a: Int.Int^)(f: H.CycleCarrier) => \refl(A.space.smul a (f.apply (oneIntro Arithmetic.one))),
};
\import Modules.Hom[V := A.Carrier, W := H.CycleCarrier, source := A.space, target := H.cycleSpace] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := cycle,
  addition := \fun (a, b: A.Carrier) => OneHom.ext (value (A.space.add a b)) ((Hom.space one).add (value a) (value b)) (\fun (r: family.Carrier one) => A.space.vectorAdd r a b),
  scalar := \fun (a: Int.Int^)(b: A.Carrier) => OneHom.ext (value (A.space.smul a b)) ((Hom.space one).smul a (value b))
    (\fun (r: family.Carrier one) => trans!{A.Carrier} _ _ _ (sym!{A.Carrier} _ _ (A.space.scalarAssoc r a b))
      (trans!{A.Carrier} _ _ _ (congr!{Int.Int^ A.Carrier} (\fun (s: Int.Int^) => A.space.smul s b) _ _ (IntegerRing.commutativeRing.mulCommutative r a)) (A.space.scalarAssoc a r b))),
};
\definition leftInverse: \forall (f: H.CycleCarrier) -> backward.apply (forward.apply f) = f :=
  \fun (f: H.CycleCarrier) => OneHom.ext (value (f.apply (oneIntro Arithmetic.one))) f (\fun (r: family.Carrier one) =>
    trans!{A.Carrier} _ _ _ (sym!{A.Carrier} _ _ (f.scalar r (oneIntro Arithmetic.one)))
      (congr!{Int.Int^ A.Carrier} (\fun (s: Int.Int^) => f.apply (oneIntro s)) (Arithmetic.mul r Arithmetic.one) r (Multiplication.mulOneRight r)));
\definition rightInverse: \forall (a: A.Carrier) -> forward.apply (backward.apply a) = a := A.space.scalarOne;
\import Modules.Isomorphism[V := H.CycleCarrier, W := A.Carrier, source := H.cycleSpace, target := A.space] \as CycleIso;
\definition cycleIsomorphism: CycleIso.Isomorphism := CycleIso.Isomorphism { forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse };
\import Modules.Hom[V := A.Carrier, W := A.Carrier, source := A.space, target := A.space] \as CoefficientMaps;
\definition multiplication: CoefficientMaps.Map := CoefficientMaps.Map {
  apply := A.space.smul multiplier,
  addition := A.space.vectorAdd multiplier,
  scalar := \fun (a: Int.Int^)(x: A.Carrier) => trans!{A.Carrier} _ _ _ (sym!{A.Carrier} _ _ (A.space.scalarAssoc multiplier a x))
    (trans!{A.Carrier} _ _ _ (congr!{Int.Int^ A.Carrier} (\fun (r: Int.Int^) => A.space.smul r x) _ _ (IntegerRing.commutativeRing.mulCommutative multiplier a)) (A.space.scalarAssoc a multiplier x)),
};
\import Modules.Of[V := A.Carrier, space := A.space].Submodule[] \as CoefficientSub;
\import CoefficientSub.Image[U := A.Carrier, source := A.space] \as CoefficientImage;
\definition multiples: CoefficientSub.Submodule := CoefficientImage.image multiplication;
\import CoefficientSub.Quotient[S := multiples] \as Quotient;
\definition cycleBundle: Modules.Bundle := Modules.Bundle { Carrier := H.CycleCarrier, space := H.cycleSpace };
\import Modules.QuotientMapping[A := cycleBundle, B := A].On[S := H.boundariesInside, T := multiples, f := forward] \as Descent;
\import Descent.Inverse[g := backward] \as Inverse;
\definition evaluateDifferential: \forall (f: ZeroHom.Map) -> (Hom.apply Nat.Nat^::zero f).apply (oneIntro Arithmetic.one) = A.space.smul multiplier (f.apply (zeroIntro Arithmetic.one)) :=
  \fun (f: ZeroHom.Map) => f.scalar multiplier (zeroIntro Arithmetic.one);
\definition compatible: Descent.Compatible := \block {
  \fun (f: H.CycleCarrier)(member: _) \then
  \takefrom g: \Cast[Hom.Carrier Nat.Nat^::zero] ({ g: Hom.Carrier Nat.Nat^::zero \where Hom.apply Nat.Nat^::zero g = f }) \by member \then
  \return CoefficientImage.introduce multiplication (forward.apply f) (g.apply (zeroIntro Arithmetic.one))
    (trans!{A.Carrier} _ _ _ (sym!{A.Carrier} _ _ (evaluateDifferential g))
      (congr!{{Hom.Carrier one} A.Carrier} (\fun (h: Hom.Carrier one) => h.apply (oneIntro Arithmetic.one)) _ _
        (\bysub(Hom.Carrier Nat.Nat^::zero, { g: Hom.Carrier Nat.Nat^::zero \where Hom.apply Nat.Nat^::zero g = f }, g))))
};
\definition boundaryValue: \forall (a: A.Carrier) -> Hom.apply Nat.Nat^::zero (zeroValue a) = value (A.space.smul multiplier a) :=
  \fun (a: A.Carrier) => OneHom.ext (Hom.apply Nat.Nat^::zero (zeroValue a)) (value (A.space.smul multiplier a))
    (\fun (r: family.Carrier one) => trans!{A.Carrier} _ _ _
      (congr!{Int.Int^ A.Carrier} (\fun (s: Int.Int^) => A.space.smul s a) _ _ (IntegerRing.commutativeRing.mulCommutative multiplier r)) (A.space.scalarAssoc r multiplier a));
\definition compatibleBack: Inverse.CompatibleBack := \block {
  \fun (a: A.Carrier)(member: _) \then
  \takefrom b: \Cast[A.Carrier] ({ b: A.Carrier \where multiplication.apply b = a }) \by member \then
  \return Logic.existsIntro[Hom.Carrier Nat.Nat^::zero, { g: Hom.Carrier Nat.Nat^::zero \where Hom.apply Nat.Nat^::zero g = cycle a }] (zeroValue b)
    (trans!{{Hom.Carrier one}} _ _ _ (boundaryValue b)
      (congr!{A.Carrier {Hom.Carrier one}} value _ _ (\bysub(A.Carrier, { b: A.Carrier \where multiplication.apply b = a }, b))))
};
\definition isomorphism: Modules.Isomorphism[V := H.Carrier, W := Quotient.Carrier, source := H.space, target := Quotient.moduleSpace].Isomorphism :=
  Inverse.isomorphism compatible compatibleBack leftInverse rightInverse;
\definition onClass: \forall (f: H.CycleCarrier) -> isomorphism.forward.apply (H.classOf f) = Quotient.class (forward.apply f) := Descent.onClass compatible;
\module Higher(n: Nat.Nat^);
\module Mapping(B: Modules.Bundle, u: Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Map);
