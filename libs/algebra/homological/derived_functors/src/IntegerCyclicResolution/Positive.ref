\definition multiplier: Int.Int^ := Int.Int^::ofNat (Nat.Nat^::succ m);
\import finitely_generated_modules.IntegerCyclic[d := multiplier] \as Cyclic;
\import Modules.Of[V := Int.Int^, space := Modules.scalarModule].Submodule[] \as Sub;
\definition upper(n: Nat.Nat^): Sub.Submodule := (\induction (n: Nat.Nat^) \return Sub.Submodule \with {
  | zero: Sub.whole
  | succ: \fun (n: Nat.Nat^)(before: Sub.Submodule) => Sub.zeroSubmodule
}) n;
\definition submodule: Nat.Nat^ -> Sub.Submodule := \induction (n: Nat.Nat^) \return Sub.Submodule \with {
  | zero: Sub.whole
  | succ: \fun (n: Nat.Nat^)(before: Sub.Submodule) => upper n
};
\module Term(n: Nat.Nat^) {
  \import Sub.Of[S := submodule n] \as Included;
  \definition Carrier: \Set := Included.Carrier;
  \definition space: Modules.Space Carrier := Included.moduleSpace;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
}
\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: Nat.Nat^) => \Cast[Int.Int^] ((submodule n).carrier),
  space := \fun (n: Nat.Nat^) => Term[n := n].space,
};
\definition term(n: Nat.Nat^): Modules.Bundle := Modules.Bundle { Carrier := \Cast[Int.Int^] ((submodule n).carrier), space := Term[n := n].space };
\definition zero(n: Nat.Nat^): family.Carrier n := \into[Int.Int^](Arithmetic.zero, (submodule n).carrier) \by { (submodule n).zero };
\definition scalarZero: \forall (n: Nat.Nat^) -> (family.space n).zero = zero n := \fun (n: Nat.Nat^) => \refl(Arithmetic.zero);
\definition highZero: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> x = zero (Nat.Nat^::succ (Nat.Nat^::succ n)) :=
  \fun (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => \bysub(Int.Int^, (submodule (Nat.Nat^::succ (Nat.Nat^::succ n))).carrier, x);
\definition zeroIntro(x: Int.Int^): family.Carrier Nat.Nat^::zero := \into[Int.Int^](x, Sub.whole.carrier) \by { \refl(x) };
\definition oneIntro(x: Int.Int^): family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) := \into[Int.Int^](x, Sub.whole.carrier) \by { \refl(x) };
\definition apply: \forall (n: Nat.Nat^) -> family.Carrier (Nat.Nat^::succ n) -> family.Carrier n :=
  \induction (n: Nat.Nat^) \return family.Carrier (Nat.Nat^::succ n) -> family.Carrier n \with {
    | zero: \fun (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => zeroIntro (Arithmetic.mul multiplier x)
    | succ: \fun (n: Nat.Nat^)(before: _)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => zero (Nat.Nat^::succ n)
  };
\definition addition: \forall (n: Nat.Nat^)(x, y: family.Carrier (Nat.Nat^::succ n)) -> apply n ((family.space (Nat.Nat^::succ n)).add x y) = (family.space n).add (apply n x) (apply n y) :=
  \induction (n: Nat.Nat^) \return \forall (x, y: family.Carrier (Nat.Nat^::succ n)) -> apply n ((family.space (Nat.Nat^::succ n)).add x y) = (family.space n).add (apply n x) (apply n y) \with {
    | zero: \fun (x, y: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => Cyclic.multiplication.addition x y
    | succ: \fun (n: Nat.Nat^)(before: _)(x, y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => sym!{Int.Int^} _ _ (ScalarGroup.zeroLeft Arithmetic.zero)
  };
\definition scalar: \forall (n: Nat.Nat^)(a: Int.Int^)(x: family.Carrier (Nat.Nat^::succ n)) -> apply n ((family.space (Nat.Nat^::succ n)).smul a x) = (family.space n).smul a (apply n x) :=
  \induction (n: Nat.Nat^) \return \forall (a: Int.Int^)(x: family.Carrier (Nat.Nat^::succ n)) -> apply n ((family.space (Nat.Nat^::succ n)).smul a x) = (family.space n).smul a (apply n x) \with {
    | zero: \fun (a: Int.Int^)(x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => Cyclic.multiplication.scalar a x
    | succ: \fun (n: Nat.Nat^)(before: _)(a: Int.Int^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) => sym!{Int.Int^} _ _ (Int.Math[].Specification[].Prop[].Multiplication[].mulZeroRight a)
  };
\definition squareZero: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> apply n (apply (Nat.Nat^::succ n) x) = (family.space n).zero :=
  \induction (n: Nat.Nat^) \return \forall (x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> apply n (apply (Nat.Nat^::succ n) x) = (family.space n).zero \with {
    | zero: \fun (x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))) => Int.Math[].Specification[].Prop[].Multiplication[].mulZeroRight multiplier
    | succ: \fun (n: Nat.Nat^)(before: _)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n)))) => \refl(Arithmetic.zero)
  };
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] { apply := apply };
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] { addition := addition, scalar := scalar, squareZero := squareZero },
};
\import Modules.Hom[V := family.Carrier Nat.Nat^::zero, W := Cyclic.Carrier, source := family.space Nat.Nat^::zero, target := Cyclic.space] \as Augmentation;
\definition augmentation: Augmentation.Map := Augmentation.Map {
  apply := \fun (x: family.Carrier Nat.Nat^::zero) => Cyclic.class x,
  addition := \fun (x, y: family.Carrier Nat.Nat^::zero) => Cyclic.projection.addition x y, scalar := \fun (a: Int.Int^)(x: family.Carrier Nat.Nat^::zero) => Cyclic.projection.scalar a x,
};
\definition augmentationOnto: \forall (x: Cyclic.Carrier) -> \exists { y: family.Carrier Nat.Nat^::zero \where augmentation.apply y = x } := \block {
  \fun (x: Cyclic.Carrier) \then
  \takefrom y: \Cast[Int.Int^] ({ y: Int.Int^ \where Cyclic.class y = x }) \by Cyclic.onto x \then
  \return Logic.existsIntro[family.Carrier Nat.Nat^::zero, { y: family.Carrier Nat.Nat^::zero \where augmentation.apply y = x }] (zeroIntro y)
    (\bysub(Int.Int^, { y: Int.Int^ \where Cyclic.class y = x }, y))
};
\definition killed: \forall (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) -> augmentation.apply (apply Nat.Nat^::zero x) = Cyclic.space.zero := \fun (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => Cyclic.classMultiple x;
\definition augmentationExact: \forall (x: family.Carrier Nat.Nat^::zero) -> augmentation.apply x = Cyclic.space.zero -> \exists { y: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where apply Nat.Nat^::zero y = x } := \block {
  \fun (x: family.Carrier Nat.Nat^::zero)(killed: augmentation.apply x = Cyclic.space.zero) \then
  \takefrom y: \Cast[Int.Int^] ({ y: Int.Int^ \where Arithmetic.mul multiplier y = x }) \by Cyclic.classZeroMember x killed \then
  \return Logic.existsIntro[family.Carrier (Nat.Nat^::succ Nat.Nat^::zero), { y: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where apply Nat.Nat^::zero y = x }] (oneIntro y)
    (\bysub(Int.Int^, { y: Int.Int^ \where Arithmetic.mul multiplier y = x }, y))
};
\module Projectivity;
\module Exactness;
\module Cohomology(A: Modules.Bundle);
\module TensorHomology(A: Modules.Bundle);
\module Ext(A: Modules.Bundle);
\module Tor(A: Modules.Bundle);
\module Coefficients(k: Nat.Nat^);
\import Resolutions.Of[M := Cyclic.bundle, P := complex] \as Of;
\definition resolution: Of.Resolution := \into[Of.Data](Of.Data { augmentation := augmentation }, { d: Of.Data \where Of.Laws[d] }) \by {
  Of.Laws[Of.Data { augmentation := augmentation }] {
    projective := \fun (n: Nat.Nat^) => Projectivity[].projective n,
    onto := augmentationOnto, killed := killed, augmentationExact := augmentationExact, exact := Exactness[].exact,
  }
};
