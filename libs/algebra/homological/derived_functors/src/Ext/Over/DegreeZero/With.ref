\definition closedEvaluation: \forall (f: H.CycleCarrier)(y: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) ->
  f.apply (P.differential.apply Nat.Nat^::zero y) = N.space.zero :=
  \fun (f: H.CycleCarrier)(y: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) =>
    congr!{{Hom.Carrier (Nat.Nat^::succ Nat.Nat^::zero)} N.Carrier}
      (\fun (g: Hom.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => g.apply y) _ _
      (\bysub(Hom.Carrier Nat.Nat^::zero, H.cycles.carrier, f));
\module On(f: H.CycleCarrier) {
  \import Descent.On[q := resolution.augmentation, f := f] \as D;
  \definition kills: D.KillsKernel := \block {
    \fun (x: P.family.Carrier Nat.Nat^::zero)(zero: (resolution.augmentation).apply x = M.space.zero) \then
    \takefrom y: \Cast[P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)]
      ({ y: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where P.differential.apply Nat.Nat^::zero y = x }) \by resolution.augmentationExact x zero \then
    \return trans!{N.Carrier} _ _ _ (congr!{{P.family.Carrier Nat.Nat^::zero} N.Carrier} (f.apply) _ _
      (sym!{{P.family.Carrier Nat.Nat^::zero}} _ _ (\bysub(P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero),
        { y: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero) \where P.differential.apply Nat.Nat^::zero y = x }, y))))
      (closedEvaluation f y)
  };
  \definition map: Native.Map := D.map (resolution.onto) kills;
  \definition onAugmentation: \forall (x: P.family.Carrier Nat.Nat^::zero) -> map.apply ((resolution.augmentation).apply x) = f.apply x :=
    D.onImage (resolution.onto) kills;
}
\definition reflects: \forall (f, g: Native.Map) ->
  (\forall (x: P.family.Carrier Nat.Nat^::zero) -> f.apply ((resolution.augmentation).apply x) = g.apply ((resolution.augmentation).apply x)) -> f = g :=
  \fun (f, g: Native.Map)(same: \forall (x: P.family.Carrier Nat.Nat^::zero) -> f.apply ((resolution.augmentation).apply x) = g.apply ((resolution.augmentation).apply x)) =>
    Native.ext f g (\block {
      \fun (y: M.Carrier) \then
      \takefrom x: \Cast[P.family.Carrier Nat.Nat^::zero] ({ x: P.family.Carrier Nat.Nat^::zero \where (resolution.augmentation).apply x = y }) \by resolution.onto y \then
      \let ex: (resolution.augmentation).apply x = y := \bysub(P.family.Carrier Nat.Nat^::zero, { x: P.family.Carrier Nat.Nat^::zero \where (resolution.augmentation).apply x = y }, x) \then
      \return trans!{N.Carrier} _ _ _ (congr!{M.Carrier N.Carrier} (f.apply) _ _ (sym!{M.Carrier} _ _ ex))
        (trans!{N.Carrier} _ _ _ (same x) (congr!{M.Carrier N.Carrier} (g.apply) _ _ ex))
    });
\import Modules.Hom[V := H.CycleCarrier, W := Target.Carrier, source := H.cycleSpace, target := Target.space] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (f: H.CycleCarrier) => On[f := f].map,
  addition := \fun (f, g: H.CycleCarrier) => reflects _ _
    (\fun (x: P.family.Carrier Nat.Nat^::zero) => trans!{N.Carrier} _ _ _
      (On[f := H.cycleSpace.add f g].onAugmentation x)
      (sym!{N.Carrier} _ _ (congr2!{N.Carrier N.Carrier N.Carrier} (N.space.add) _ _ _ _
        (On[f := f].onAugmentation x) (On[f := g].onAugmentation x)))),
  scalar := \fun (a: R)(f: H.CycleCarrier) => reflects _ _
    (\fun (x: P.family.Carrier Nat.Nat^::zero) => trans!{N.Carrier} _ _ _
      (On[f := H.cycleSpace.smul a f].onAugmentation x)
      (sym!{N.Carrier} _ _ (congr!{N.Carrier N.Carrier} (N.space.smul a) _ _ (On[f := f].onAugmentation x)))),
};
\definition precompose(f: Native.Map): Hom.Carrier Nat.Nat^::zero := Hom.At[n := Nat.Nat^::zero].Carrier {
  apply := \fun (x: P.family.Carrier Nat.Nat^::zero) => f.apply ((resolution.augmentation).apply x),
  addition := \fun (x, y: P.family.Carrier Nat.Nat^::zero) => trans!{N.Carrier} _ _ _
    (congr!{M.Carrier N.Carrier} (f.apply) _ _ ((resolution.augmentation).addition x y))
    (f.addition ((resolution.augmentation).apply x) ((resolution.augmentation).apply y)),
  scalar := \fun (a: R)(x: P.family.Carrier Nat.Nat^::zero) => trans!{N.Carrier} _ _ _
    (congr!{M.Carrier N.Carrier} (f.apply) _ _ ((resolution.augmentation).scalar a x))
    (f.scalar a ((resolution.augmentation).apply x)),
};
\definition precomposeClosed: \forall (f: Native.Map) -> \In[Hom.Carrier Nat.Nat^::zero] (H.cycles.carrier) (precompose f) :=
  \fun (f: Native.Map) => Hom.At[n := Nat.Nat^::succ Nat.Nat^::zero].ext
    (Hom.apply Nat.Nat^::zero (precompose f)) (Hom.space (Nat.Nat^::succ Nat.Nat^::zero)).zero
    (\fun (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) => trans!{N.Carrier} _ _ _
      (congr!{M.Carrier N.Carrier} (f.apply) _ _ (resolution.killed x)) (Native.zeroPreserved f));
\definition cycle(f: Native.Map): H.CycleCarrier := \into[Hom.Carrier Nat.Nat^::zero](precompose f, H.cycles.carrier) \by { precomposeClosed f };
\import Modules.Hom[V := Target.Carrier, W := H.CycleCarrier, source := Target.space, target := H.cycleSpace] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := cycle,
  addition := \fun (f, g: Target.Carrier) => Hom.At[n := Nat.Nat^::zero].ext (precompose (Target.add f g)) ((Hom.space Nat.Nat^::zero).add (precompose f) (precompose g))
    (\fun (x: P.family.Carrier Nat.Nat^::zero) => \refl(N.space.add (f.apply ((resolution.augmentation).apply x)) (g.apply ((resolution.augmentation).apply x)))),
  scalar := \fun (a: R)(f: Target.Carrier) => Hom.At[n := Nat.Nat^::zero].ext (precompose (Target.scale a f)) ((Hom.space Nat.Nat^::zero).smul a (precompose f))
    (\fun (x: P.family.Carrier Nat.Nat^::zero) => \refl(N.space.smul a (f.apply ((resolution.augmentation).apply x)))),
};
\definition leftInverse: \forall (f: H.CycleCarrier) -> backward.apply (forward.apply f) = f :=
  \fun (f: H.CycleCarrier) => Hom.At[n := Nat.Nat^::zero].ext (precompose (On[f := f].map)) f (On[f := f].onAugmentation);
\definition rightInverse: \forall (f: Target.Carrier) -> forward.apply (backward.apply f) = f :=
  \fun (f: Target.Carrier) => reflects (On[f := cycle f].map) f (On[f := cycle f].onAugmentation);
\import Modules.Isomorphism[V := H.CycleCarrier, W := Target.Carrier, source := H.cycleSpace, target := Target.space] \as Iso;
\definition cycleIsomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
\import Modules.Isomorphism[V := H.CycleCarrier, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := H.Cohomology, W := H.CycleCarrier, source := H.cohomologySpace, target := H.cycleSpace].Composition[U := Target.Carrier, final := Target.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := H.Cohomology, W := Target.Carrier, source := H.cohomologySpace, target := Target.space].Isomorphism :=
  Composition.compose cycleIsomorphism (Inverse.inverse Zero.kernelIso);
