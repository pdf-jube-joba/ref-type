\import Modules.Isomorphism[V := Source.At[n := n].Carrier, W := Target.At[n := n].Carrier, source := Source.At[n := n].space, target := Target.At[n := n].space] \as Iso;
\definition existence: \forall (p: Source.Resolution)(q: Target.Resolution) -> \exists Iso.Isomorphism := \block {
  \fun (p: Source.Resolution)(q: Target.Resolution) \then
  \takefrom e: Equivalences.Equivalence \by Comparison.existence p q \then
  \return \exact(Hom.At[k := n].isomorphism e, Iso.Isomorphism)
};
