\definition data: Sequence.Data := Sequence.Data { inclusion := Inclusion.cochainMap sequence.inclusion, projection := Projection.cochainMap sequence.projection };
\module Degree(n: Nat.Nat^);
\definition laws: Sequence.Laws[data] := Sequence.Laws[data] {
  injective := \fun (n: Nat.Nat^) => Degree[n := n].injective,
  onto := \fun (n: Nat.Nat^) => Degree[n := n].onto,
  zero := \fun (n: Nat.Nat^) => Degree[n := n].zero,
  kernelImage := \fun (n: Nat.Nat^) => Degree[n := n].kernelImage,
};
\definition cochainSequence: Sequence.Sequence := \into[Sequence.Data](data, { s: Sequence.Data \where Sequence.Laws[s] }) \by { laws };
\import Sequence.With[s := cochainSequence] \as LongExact;
\module At(n: Nat.Nat^);
\module Morphism(A1, B1, C1: Modules.Bundle,
  t: Modules.ShortExact[A := A1, B := B1, C := C1].Sequence,
  a: Modules.MapBetween A A1, b: Modules.MapBetween B B1, c: Modules.MapBetween C C1);
\definition degreeZeroInjective: \forall (x, y: Cochains.At[C := Left.complex, k := Nat.Nat^::zero].Cohomology) ->
  #apply{(Inclusion.At[k := Nat.Nat^::zero].map sequence.inclusion)} x = #apply{(Inclusion.At[k := Nat.Nat^::zero].map sequence.inclusion)} y -> x = y := LongExact.DegreeZero[].injective;
