\definition term: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier n, space := P.family.space n };
\import Algebra.ProjectiveHomShortExact[P := term, A := A, B := B, C := C].On[sequence := sequence] \as HomSequence;
\definition nativeSequence: Modules.ShortExact[A := Modules.Bundle { Carrier := Left.Carrier n, space := Left.space n }, B := Modules.Bundle { Carrier := Middle.Carrier n, space := Middle.space n }, C := Modules.Bundle { Carrier := Right.Carrier n, space := Right.space n }].Sequence := HomSequence.shortExact (resolution.projective n);
\definition injective: \forall (f, g: Left.Carrier n) -> data.inclusion.apply n f = data.inclusion.apply n g -> f = g := nativeSequence.injective;
\definition onto: \forall (f: Right.Carrier n) -> \exists ( g: Middle.Carrier n \where data.projection.apply n g = f ) := nativeSequence.onto;
\definition zero: \forall (f: Left.Carrier n) -> data.projection.apply n (data.inclusion.apply n f) = (Right.space n).zero := nativeSequence.zero;
\definition kernelImage: \forall (f: Middle.Carrier n) -> data.projection.apply n f = (Right.space n).zero -> \exists ( g: Left.Carrier n \where data.inclusion.apply n g = f ) := nativeSequence.kernelImage;
