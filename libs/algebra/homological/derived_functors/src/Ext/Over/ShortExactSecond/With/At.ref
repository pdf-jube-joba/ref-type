\import LongExact.At[n := n] \as Exact;
\import \parent.\parent.\parent.Of[M := M, N := A, P := P].At[n := n] \as LeftTerm;
\import \parent.\parent.\parent.Of[M := M, N := B, P := P].At[n := n] \as MiddleTerm;
\import \parent.\parent.\parent.Of[M := M, N := C, P := P].At[n := n] \as RightTerm;
\import \parent.\parent.\parent.Of[M := M, N := A, P := P].At[n := Nat.Nat^::succ n] \as NextLeftTerm;
\import \parent.\parent.\parent.Of[M := M, N := B, P := P].At[n := Nat.Nat^::succ n] \as NextMiddleTerm;
\definition inclusion: Modules.MapBetween LeftTerm.bundle MiddleTerm.bundle := Inclusion.At[k := n].map sequence.inclusion;
\definition projection: Modules.MapBetween MiddleTerm.bundle RightTerm.bundle := Projection.At[k := n].map sequence.projection;
\definition nextInclusion: Modules.MapBetween NextLeftTerm.bundle NextMiddleTerm.bundle := Inclusion.At[k := Nat.Nat^::succ n].map sequence.inclusion;
\definition connecting: Modules.MapBetween RightTerm.bundle NextLeftTerm.bundle := Exact.connecting;
\definition inclusionProjectionZero: \forall (x: LeftTerm.Carrier) -> projection.apply (inclusion.apply x) = RightTerm.space.zero := Exact.Exactness[].inclusionProjectionZero;
\definition projectionConnectingZero: \forall (x: MiddleTerm.Carrier) -> connecting.apply (projection.apply x) = NextLeftTerm.space.zero := Exact.Exactness[].projectionConnectingZero;
\definition connectingInclusionZero: \forall (x: RightTerm.Carrier) -> nextInclusion.apply (connecting.apply x) = NextMiddleTerm.space.zero := Exact.Exactness[].connectingInclusionZero;
\definition exactAtB: \forall (x: MiddleTerm.Carrier) -> projection.apply x = RightTerm.space.zero -> \exists { y: LeftTerm.Carrier \where inclusion.apply y = x } := Exact.Exactness[].exactAtB;
\definition exactAtC: \forall (x: RightTerm.Carrier) -> connecting.apply x = NextLeftTerm.space.zero -> \exists { y: MiddleTerm.Carrier \where projection.apply y = x } := Exact.Exactness[].exactAtC;
\definition exactAtANext: \forall (x: NextLeftTerm.Carrier) -> nextInclusion.apply x = NextMiddleTerm.space.zero -> \exists { y: RightTerm.Carrier \where connecting.apply y = x } := Exact.Exactness[].exactAtANext;
