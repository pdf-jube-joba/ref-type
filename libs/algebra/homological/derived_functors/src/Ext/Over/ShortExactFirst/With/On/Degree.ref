\import std.Logic[].Proposition[] \as Existential;
\import Modules.Biproduct[V := P.family.Carrier n, W := Q.family.Carrier n, left := P.family.space n, right := Q.family.space n] \as Sum;
\definition leftTerm: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier n, space := P.family.space n };
\definition middleTerm: Modules.Bundle := Modules.Bundle { Carrier := std.Data[].Pair[].Times^[P.family.Carrier n, Q.family.Carrier n], space := Sum.space };
\definition rightTerm: Modules.Bundle := Modules.Bundle { Carrier := Q.family.Carrier n, space := Q.family.space n };
\import Modules.ShortExact[A := leftTerm, B := middleTerm, C := rightTerm] \as Split;
\import std.Data[].Pair[].Prop[A := P.family.Carrier n, B := Q.family.Carrier n] \as Pairs;
\definition splitData: Split.Data := Split.Data { inclusion := Sum.firstInjection, projection := Sum.secondProjection };
\definition splitLaws: Split.Laws[splitData] := Split.Laws[splitData] {
  injective := \fun (x, y: P.family.Carrier n)(e: Sum.firstInjection.apply x = Sum.firstInjection.apply y) => congr!{Sum.Carrier {P.family.Carrier n}} Sum.first _ _ e,
  onto := \fun (x: Q.family.Carrier n) => Existential.existsIntro[Sum.Carrier, { y: Sum.Carrier \where Sum.secondProjection.apply y = x }] (Sum.secondInjection.apply x) (\refl(x)),
  zero := \fun (x: P.family.Carrier n) => \refl((Q.family.space n).zero),
  kernelImage := \fun (x: Sum.Carrier)(e: Sum.secondProjection.apply x = (Q.family.space n).zero) => Existential.existsIntro[P.family.Carrier n, { y: P.family.Carrier n \where Sum.firstInjection.apply y = x }] (Sum.first x)
    (Pairs.ext (Sum.firstInjection.apply (Sum.first x)) x (\refl(Sum.first x)) (sym!{{Q.family.Carrier n}} _ _ e)),
};
\definition split: Split.Sequence := \into[Split.Data](splitData, { data: Split.Data \where Split.Laws[data] }) \by { splitLaws };
\import Algebra.ShortExactDual[A := leftTerm, B := middleTerm, C := rightTerm, N := N].On[sequence := split, s := Sum.secondInjection] \as Duality;
\definition sequence: Modules.ShortExact[A := Modules.Bundle { Carrier := RightHom.Carrier n, space := RightHom.space n },
  B := Modules.Bundle { Carrier := MiddleHom.Carrier n, space := MiddleHom.space n }, C := Modules.Bundle { Carrier := LeftHom.Carrier n, space := LeftHom.space n }].Sequence :=
  Duality.shortExact Sum.secondRoundtrip;
\definition injective: \forall (f, g: RightHom.Carrier n) -> data.inclusion.apply n f = data.inclusion.apply n g -> f = g := sequence.injective;
\definition onto: \forall (f: LeftHom.Carrier n) -> \exists ( g: MiddleHom.Carrier n \where data.projection.apply n g = f ) := sequence.onto;
\definition zero: \forall (f: RightHom.Carrier n) -> data.projection.apply n (data.inclusion.apply n f) = (LeftHom.space n).zero := sequence.zero;
\definition kernelImage: \forall (f: MiddleHom.Carrier n) -> data.projection.apply n f = (LeftHom.space n).zero ->
  \exists ( g: RightHom.Carrier n \where data.inclusion.apply n g = f ) := sequence.kernelImage;
