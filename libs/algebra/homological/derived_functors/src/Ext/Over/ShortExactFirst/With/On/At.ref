\import Dual.With[s := cochainSequence].At[n := n] \as Exact;
\import \parent.\parent.\parent.\parent.Of[M := A, N := N, P := P].At[n := n] \as Source;
\import \parent.\parent.\parent.\parent.Of[M := C, N := N, P := Q].At[n := Nat.Nat^::succ n] \as Target;
\definition connecting: Modules.MapBetween Source.bundle Target.bundle := Exact.connecting;
\import \parent.\parent.\parent.\parent.Of[M := C, N := N, P := Q].At[n := n] \as LeftTerm;
\import \parent.\parent.\parent.\parent.Of[M := B, N := N, P := middleComplex].At[n := n] \as MiddleTerm;
\import \parent.\parent.\parent.\parent.Of[M := B, N := N, P := middleComplex].At[n := Nat.Nat^::succ n] \as NextMiddleTerm;
\import Cochains.Map[C := RightHom.complex, D := MiddleHom.complex].At[k := n] \as Inclusion;
\import Cochains.Map[C := MiddleHom.complex, D := LeftHom.complex].At[k := n] \as Projection;
\import Cochains.Map[C := RightHom.complex, D := MiddleHom.complex].At[k := Nat.Nat^::succ n] \as NextInclusion;
\definition inclusion: Modules.MapBetween LeftTerm.bundle MiddleTerm.bundle := Inclusion.induced cochainSequence.inclusion;
\definition projection: Modules.MapBetween MiddleTerm.bundle Source.bundle := Projection.induced cochainSequence.projection;
\definition nextInclusion: Modules.MapBetween Target.bundle NextMiddleTerm.bundle := NextInclusion.induced cochainSequence.inclusion;
\definition inclusionProjectionZero: \forall (x: LeftTerm.Carrier) -> projection.apply (inclusion.apply x) = Source.space.zero := Exact.Exactness[].inclusionProjectionZero;
\definition projectionConnectingZero: \forall (x: MiddleTerm.Carrier) -> connecting.apply (projection.apply x) = Target.space.zero := Exact.Exactness[].projectionConnectingZero;
\definition connectingInclusionZero: \forall (x: Source.Carrier) -> nextInclusion.apply (connecting.apply x) = NextMiddleTerm.space.zero := Exact.Exactness[].connectingInclusionZero;
\definition exactAtB: \forall (x: MiddleTerm.Carrier) -> projection.apply x = Source.space.zero ->
  \exists { y: LeftTerm.Carrier \where inclusion.apply y = x } := Exact.Exactness[].exactAtB;
\definition exactAtA: \forall (x: Source.Carrier) -> connecting.apply x = Target.space.zero ->
  \exists { y: MiddleTerm.Carrier \where projection.apply y = x } := Exact.Exactness[].exactAtC;
\definition exactAtCNext: \forall (x: Target.Carrier) -> nextInclusion.apply x = NextMiddleTerm.space.zero ->
  \exists { y: Source.Carrier \where connecting.apply y = x } := Exact.Exactness[].exactAtANext;
\import \parent.\parent.\parent.\parent.First[M := B, L := C, N := N, P := middleComplex, Q := Q].At[k := n].With[p := Middle.resolution, q := q, f := sequence.projection] \as FirstProjection;
\import \parent.\parent.\parent.\parent.First[M := A, L := B, N := N, P := P, Q := middleComplex].At[k := n].With[p := p, q := Middle.resolution, f := sequence.inclusion] \as FirstInclusion;
\definition canonicalInclusion: FirstProjection.map = inclusion := FirstProjection.onComparison Middle.projection Middle.projectionAugmented;
\definition canonicalProjection: FirstInclusion.map = projection := FirstInclusion.onComparison Middle.inclusion Middle.inclusionAugmented;
