\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Existential;
\definition one: Nat.Nat^ := Nat.Nat^::succ Nat.Nat^::zero;
\definition two: Nat.Nat^ := Nat.Nat^::succ one;
\import Resolutions.Syzygy[n := Nat.Nat^::zero, resolution := resolution] \as K;
\import Modules.Of[V := P.family.Carrier Nat.Nat^::zero, space := P.family.space Nat.Nat^::zero].Submodule[].Of[S := Resolutions.augmentationKernel resolution] \as Kernel;
\definition L: Modules.Bundle := Resolutions.term Nat.Nat^::zero;
\definition KBundle: Modules.Bundle := K.bundle;
\import Modules.ShortExact[A := KBundle, B := L, C := M] \as Sequences;
\definition presentation: Sequences.Sequence := Sequences.Sequence {
  inclusion := Kernel.inclusion, projection := resolution.augmentation,
  injective := \fun (x, y: K.Carrier)(equal: x = y) => equal,
  onto := resolution.onto,
  zero := \fun (x: K.Carrier) => \bysub(L.Carrier, (Resolutions.augmentationKernel resolution).carrier, x),
  kernelImage := \fun (x: L.Carrier)(closed: resolution.augmentation.apply x = M.space.zero) =>
    Existential.existsIntro[K.Carrier, { k: K.Carrier \where Kernel.inclusion.apply k = x }] (\into[L.Carrier](x, (Resolutions.augmentationKernel resolution).carrier) \by { closed })
    (\refl(x)),
};
\import resolutions.HomComplex[].Over[R := R, ring := ring].On[P := P, N := N] \as Hom;
\import \parent.\parent.Of[M := M, N := N, P := P].At[n := one] \as H;
\import Algebra.HomSpace[V := K.Carrier, W := N.Carrier, source := K.space, target := N.space] \as Relations;
\import Algebra.HomSpace[V := L.Carrier, W := N.Carrier, source := L.space, target := N.space] \as Generators;
\import Modules.Hom[V := K.Carrier, W := N.Carrier, source := K.space, target := N.space] \as RelationMaps;
\import Modules.Hom[V := L.Carrier, W := N.Carrier, source := L.space, target := N.space] \as GeneratorMaps;
\import GeneratorMaps.Composition[U := K.Carrier, domain := K.space] \as Composition;
\definition precompose[g: GeneratorMaps.Map]: RelationMaps.Map := Composition.compose g Kernel.inclusion;
\import Modules.Hom[V := Generators.Carrier, W := Relations.Carrier, source := Generators.space, target := Relations.space] \as RestrictionMaps;
\definition restriction: RestrictionMaps.Map := RestrictionMaps.Map {
  apply := precompose,
  addition := \fun (f, g: Generators.Carrier) => RelationMaps.ext (precompose (Generators.space.add f g)) (Relations.space.add (precompose f) (precompose g))
    (\fun (x: K.Carrier) => \refl(N.space.add (f.apply x) (g.apply x))),
  scalar := \fun (a: R)(f: Generators.Carrier) => RelationMaps.ext (precompose (Generators.space.smul a f)) (Relations.space.smul a (precompose f))
    (\fun (x: K.Carrier) => \refl(N.space.smul a (f.apply x))),
};
\import Modules.Of[V := Relations.Carrier, space := Relations.space].Submodule[] \as RelationSubmodules;
\import RelationSubmodules.Image[U := Generators.Carrier, source := Generators.space] \as Images;
\definition extensions: RelationSubmodules.Submodule := Images.image restriction;
\import RelationSubmodules.Quotient[S := extensions] \as Quotient;
\module Cycle(f: H.CycleCarrier) {
  \import Modules.SurjectiveDescent[A := Resolutions.term one, B := KBundle, U := N].On[q := K.projection, f := f] \as Descent;
  \definition kills: Descent.KillsKernel := \block {
    \fun (x: P.family.Carrier one)(closed: K.projection.apply x = K.space.zero) \then
    \takefrom y: \Cast[P.family.Carrier two] ({ y: P.family.Carrier two \where P.differential.apply one y = x })
      \by resolution.exact Nat.Nat^::zero x closed \then
    \let represented: P.differential.apply one y = x :=
      \bysub(P.family.Carrier two, { y: P.family.Carrier two \where P.differential.apply one y = x }, y) \then
    \return trans!{N.Carrier} (f.apply x) (f.apply (P.differential.apply one y)) N.space.zero
      (congr!{{P.family.Carrier one} N.Carrier} (f.apply) x (P.differential.apply one y)
        (sym!{{P.family.Carrier one}} (P.differential.apply one y) x represented))
      (congr!{{Hom.Carrier two} N.Carrier} (\fun (g: Hom.Carrier two) => g.apply y) (Hom.apply one f) ((Hom.space two).zero)
        (\bysub(Hom.Carrier one, H.cyclePredicate, f)))
  };
  \definition map: RelationMaps.Map := Descent.map K.onto kills;
  \definition onImage: \forall (x: P.family.Carrier one) -> map.apply (K.projection.apply x) = f.apply x := Descent.onImage K.onto kills;
}
\definition value[f: H.CycleCarrier]: RelationMaps.Map := Cycle[f := f].map;
\definition onImage: \forall (f: H.CycleCarrier)(x: P.family.Carrier one) -> (value f).apply (K.projection.apply x) = f.apply x :=
  \fun (f: H.CycleCarrier) => Cycle[f := f].onImage;
\definition valueAddition: \forall (f, g: H.CycleCarrier) -> value (H.cycleSpace.add f g) = Relations.space.add (value f) (value g) :=
  \fun (f, g: H.CycleCarrier) => RelationMaps.ext (value (H.cycleSpace.add f g)) (Relations.space.add (value f) (value g)) (\block {
    \fun (k: K.Carrier) \then
    \takefrom x: \Cast[P.family.Carrier one] ({ x: P.family.Carrier one \where K.projection.apply x = k }) \by K.onto k \then
    \let represented: K.projection.apply x = k := \bysub(P.family.Carrier one, { x: P.family.Carrier one \where K.projection.apply x = k }, x) \then
    \let atImage: (value (H.cycleSpace.add f g)).apply (K.projection.apply x) = N.space.add ((value f).apply (K.projection.apply x)) ((value g).apply (K.projection.apply x)) :=
      trans!{N.Carrier} _ _ _ (onImage (H.cycleSpace.add f g) x)
        (congr!{N.Carrier N.Carrier N.Carrier} (N.space.add) _ _ _ _ (sym!{N.Carrier} _ _ (onImage f x)) (sym!{N.Carrier} _ _ (onImage g x))) \then
    \return \idelim K.projection.apply x = k \with z: K.Carrier =>
      (value (H.cycleSpace.add f g)).apply z = N.space.add ((value f).apply z) ((value g).apply z)
      \by { base: atImage, equality: represented }
  });
\definition valueScalar: \forall (a: R)(f: H.CycleCarrier) -> value (H.cycleSpace.smul a f) = Relations.space.smul a (value f) :=
  \fun (a: R)(f: H.CycleCarrier) => RelationMaps.ext (value (H.cycleSpace.smul a f)) (Relations.space.smul a (value f)) (\block {
    \fun (k: K.Carrier) \then
    \takefrom x: \Cast[P.family.Carrier one] ({ x: P.family.Carrier one \where K.projection.apply x = k }) \by K.onto k \then
    \let represented: K.projection.apply x = k := \bysub(P.family.Carrier one, { x: P.family.Carrier one \where K.projection.apply x = k }, x) \then
    \return \idelim K.projection.apply x = k \with z: K.Carrier => (value (H.cycleSpace.smul a f)).apply z = N.space.smul a ((value f).apply z)
      \by { base: trans!{N.Carrier} _ _ _ (onImage (H.cycleSpace.smul a f) x)
        (congr!{N.Carrier N.Carrier} (N.space.smul a) _ _ (sym!{N.Carrier} _ _ (onImage f x))), equality: represented }
  });
\import Modules.Hom[V := H.CycleCarrier, W := Relations.Carrier, source := H.cycleSpace, target := Relations.space] \as Forward;
\definition forward: Forward.Map := Forward.Map { apply := value, addition := valueAddition, scalar := valueScalar };
\import Modules.Hom[V := P.family.Carrier one, W := N.Carrier, source := P.family.space one, target := N.space] \as OneMaps;
\import RelationMaps.Composition[U := P.family.Carrier one, domain := P.family.space one] \as ProjectionComposition;
\definition cocycle[f: Relations.Carrier]: Hom.Carrier one := ProjectionComposition.compose f K.projection;
\definition closed: \forall (f: Relations.Carrier) -> Hom.apply one (cocycle f) = (Hom.space two).zero :=
  \fun (f: Relations.Carrier) => Hom.At[n := two].ext (Hom.apply one (cocycle f)) ((Hom.space two).zero)
    (\fun (x: P.family.Carrier two) => trans!{N.Carrier} _ _ _
      (congr!{K.Carrier N.Carrier} (f.apply) (K.projection.apply (P.differential.apply one x)) K.space.zero (P.laws.squareZero Nat.Nat^::zero x))
      (RelationMaps.zeroPreserved f));
\definition cycle[f: Relations.Carrier]: H.CycleCarrier := \into[Hom.Carrier one](cocycle f, H.cyclePredicate) \by { closed f };
\import Modules.Hom[V := Relations.Carrier, W := H.CycleCarrier, source := Relations.space, target := H.cycleSpace] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := cycle,
  addition := \fun (f, g: Relations.Carrier) => OneMaps.ext (cocycle (Relations.space.add f g)) ((Hom.space one).add (cocycle f) (cocycle g))
    (\fun (x: P.family.Carrier one) => \refl(N.space.add (f.apply (K.projection.apply x)) (g.apply (K.projection.apply x)))),
  scalar := \fun (a: R)(f: Relations.Carrier) => OneMaps.ext (cocycle (Relations.space.smul a f)) ((Hom.space one).smul a (cocycle f))
    (\fun (x: P.family.Carrier one) => \refl(N.space.smul a (f.apply (K.projection.apply x)))),
};
\definition cycleInverse: \forall (f: H.CycleCarrier) -> cycle (value f) = f :=
  \fun (f: H.CycleCarrier) => OneMaps.ext (cocycle (value f)) f (onImage f);
\definition valueInverse: \forall (f: Relations.Carrier) -> value (cycle f) = f :=
  \fun (f: Relations.Carrier) => RelationMaps.ext (value (cycle f)) f (\block {
    \fun (k: K.Carrier) \then
    \takefrom x: \Cast[P.family.Carrier one] ({ x: P.family.Carrier one \where K.projection.apply x = k }) \by K.onto k \then
    \return \idelim K.projection.apply x = k \with z: K.Carrier => (value (cycle f)).apply z = f.apply z
      \by { base: onImage (cycle f) x, equality: \bysub(P.family.Carrier one, { x: P.family.Carrier one \where K.projection.apply x = k }, x) }
  });
\definition cycleBundle: Modules.Bundle := Modules.Bundle { Carrier := H.CycleCarrier, space := H.cycleSpace };
\definition relationBundle: Modules.Bundle := Modules.Bundle { Carrier := Relations.Carrier, space := Relations.space };
\import Modules.QuotientMapping[A := cycleBundle, B := relationBundle].On[S := H.boundariesInside, T := extensions, f := forward] \as Descent;
\import Descent.Inverse[g := backward] \as Inverse;
\definition differential: \forall (g: Generators.Carrier) -> Hom.apply Nat.Nat^::zero g = cocycle (precompose g) :=
  \fun (g: Generators.Carrier) => OneMaps.ext (Hom.apply Nat.Nat^::zero g) (cocycle (precompose g))
    (\fun (x: P.family.Carrier one) => \refl(g.apply (P.differential.apply Nat.Nat^::zero x)));
\definition compatible: Descent.Compatible := \block {
  \fun (f: H.CycleCarrier)(member: _) \then
  \takefrom g: \Cast[Generators.Carrier] ({ g: Generators.Carrier \where Hom.apply Nat.Nat^::zero g = f }) \by member \then
  \let equal: cycle (precompose g) = f := trans!{{Hom.Carrier one}} _ _ _ (sym!{{Hom.Carrier one}} _ _ (differential g))
    (\bysub(Generators.Carrier, { g: Generators.Carrier \where Hom.apply Nat.Nat^::zero g = f }, g)) \then
  \return Images.introduce restriction (value f) g
    (trans!{Relations.Carrier} _ _ _ (sym!{Relations.Carrier} _ _ (valueInverse (precompose g)))
      (congr!{H.CycleCarrier Relations.Carrier} value (cycle (precompose g)) f equal))
};
\definition compatibleBack: Inverse.CompatibleBack := \block {
  \fun (f: Relations.Carrier)(member: _) \then
  \takefrom g: \Cast[Generators.Carrier] ({ g: Generators.Carrier \where precompose g = f }) \by member \then
  \return Existential.existsIntro[Generators.Carrier, { g: Generators.Carrier \where Hom.apply Nat.Nat^::zero g = cycle f }] g
    (trans!{{Hom.Carrier one}} _ _ _ (differential g)
      (congr!{Relations.Carrier {Hom.Carrier one}} cocycle (precompose g) f (\bysub(Generators.Carrier, { g: Generators.Carrier \where precompose g = f }, g))))
};
\definition isomorphism: Modules.Isomorphism[V := H.Carrier, W := Quotient.Carrier, source := H.space, target := Quotient.moduleSpace].Isomorphism :=
  Inverse.isomorphism compatible compatibleBack cycleInverse valueInverse;
\definition onClass: \forall (f: H.CycleCarrier) -> isomorphism.forward.apply (H.classOf f) = Quotient.class (value f) := Descent.onClass compatible;
\module OfExtension(E: Modules.Bundle);
\module Represent(f: Relations.Carrier);
\module RepresentationClass(f: Relations.Carrier);
\definition represented: \forall (x: H.Carrier) ->
  \exists ( f: Relations.Carrier \where RepresentationClass[f := f].extClass = x ) := \block {
  \fun (x: H.Carrier) \then
  \takefrom f: \Cast[Relations.Carrier] ({ f: Relations.Carrier \where Quotient.class f = isomorphism.forward.apply x })
    \by Quotient.onto (isomorphism.forward.apply x) \then
  \return Existential.existsIntro[Relations.Carrier, { f: Relations.Carrier \where RepresentationClass[f := f].extClass = x }] f
    (eq_reason_in!{H.Carrier _
      "=" _ "by" { RepresentationClass[f := f].onExt }
      "=" _ "by" { congr!{Quotient.Carrier H.Carrier} (isomorphism.backward.apply) (Quotient.class f) (isomorphism.forward.apply x)
          (\bysub(Relations.Carrier, { f: Relations.Carrier \where Quotient.class f = isomorphism.forward.apply x }, f)) }
      "=" _ "by" { isomorphism.leftInverse x }
    })
};
\definition ClassCarrier: \Set := Quotient.Carrier;
\definition classSpace: Modules.Space ClassCarrier := Quotient.moduleSpace;
\definition zeroClass: ClassCarrier := Quotient.zeroClass;
\module CompareRepresentatives(f, g: Relations.Carrier);
\module Compare(E, F: Modules.Bundle,
  s: Modules.ShortExact[A := N, B := E, C := M].Sequence,
  t: Modules.ShortExact[A := N, B := F, C := M].Sequence);
