\import Source.Chosen[lift := first] \as First;
\import Modules.Hom[V := E.Carrier, W := F.Carrier, source := E.space, target := F.space].Composition[U := L.Carrier, domain := L.space] \as Composition;
\definition map: Modules.MapBetween L F := Composition.compose e.forward first;
\definition lift: Target.Lift := \into[Modules.MapBetween L F](map,
  { f: Modules.MapBetween L F \where \forall (x: L.Carrier) -> t.projection.apply (f.apply x) = resolution.augmentation.apply x }) \by {
    \fun (x: L.Carrier) => trans!{M.Carrier} _ _ _ (laws.right (first.apply x))
      ((\bysub(Modules.MapBetween L E, { f: Modules.MapBetween L E \where \forall (x: L.Carrier) ->
        s.projection.apply (f.apply x) = resolution.augmentation.apply x }, first)) x)
  };
\import Target.Chosen[lift := lift] \as Second;
\definition relationEquality: First.relation = Second.relation := RelationMaps.ext First.relation Second.relation
  (\fun (x: K.Carrier) => t.injective (First.relation.apply x) (Second.relation.apply x)
    (trans!{F.Carrier} _ _ _ (sym!{F.Carrier} _ _ (laws.left (First.relation.apply x)))
      (trans!{F.Carrier} _ _ _
        (congr!{E.Carrier F.Carrier} (e.forward.apply) _ _ (First.onKernel x)) (sym!{F.Carrier} _ _ (Second.onKernel x)))));
\definition classEqual: Source.class = Target.class := trans!{Quotient.Carrier} _ _ _ (Source.onLift first)
  (trans!{Quotient.Carrier} _ _ _ (congr!{Relations.Carrier Quotient.Carrier} Quotient.class _ _ relationEquality)
    (sym!{Quotient.Carrier} _ _ (Target.onLift lift)));
