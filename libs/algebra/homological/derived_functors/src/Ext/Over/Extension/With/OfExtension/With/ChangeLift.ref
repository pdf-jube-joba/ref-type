\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Chosen[lift := first] \as First;
\import \parent.Chosen[lift := second] \as Second;
\import Modules.Hom[V := L.Carrier, W := E.Carrier, source := L.space, target := E.space] \as LiftMaps;
\import Modules.Hom[V := E.Carrier, W := M.Carrier, source := E.space, target := M.space] \as ProjectionMaps;
\import Modules.Laws[V := M.Carrier, space := M.space] \as Right;
\import algebra.Group[].Of[Carrier := M.Carrier, group := Right.additive] \as RightGroup;
\definition difference: LiftMaps.Map := LiftMaps.plus first (LiftMaps.negative second);
\definition firstAugmented: \forall (x: L.Carrier) -> s.projection.apply (first.apply x) = resolution.augmentation.apply x :=
  \bysub(Modules.MapBetween L E, { f: Modules.MapBetween L E \where \forall (x: L.Carrier) ->
    s.projection.apply (f.apply x) = resolution.augmentation.apply x }, first);
\definition secondAugmented: \forall (x: L.Carrier) -> s.projection.apply (second.apply x) = resolution.augmentation.apply x :=
  \bysub(Modules.MapBetween L E, { f: Modules.MapBetween L E \where \forall (x: L.Carrier) ->
    s.projection.apply (f.apply x) = resolution.augmentation.apply x }, second);
\definition closed: \forall (x: L.Carrier) -> s.projection.apply (difference.apply x) = M.space.zero :=
  \fun (x: L.Carrier) => eq_reason_in!{M.Carrier _
    "=" _ "by" { ProjectionMaps.differencePreserved s.projection (first.apply x) (second.apply x) }
    "=" _ "by" { congr!{M.Carrier M.Carrier M.Carrier} RightGroup.difference _ _ _ _ (firstAugmented x) (secondAugmented x) }
    "=" _ "by" { RightGroup.inverseRight (resolution.augmentation.apply x) }
  };
\import Modules.Hom[V := L.Carrier, W := EKernel.Carrier, source := L.space, target := EKernel.space] \as KernelMaps;
\definition mapIntoKernel: KernelMaps.Map := KernelMaps.Map {
  apply := \fun (x: L.Carrier) => \into[E.Carrier](difference.apply x, EKernel.kernel.carrier) \by { closed x },
  addition := difference.addition, scalar := difference.scalar,
};
\import Modules.Hom[V := EKernel.Carrier, W := N.Carrier, source := EKernel.space, target := N.space].Composition[U := L.Carrier, domain := L.space] \as Composition;
\definition correction: Generators.Carrier := Composition.compose EKernel.backward mapIntoKernel;
\definition onCorrection: \forall (x: L.Carrier) -> s.inclusion.apply (correction.apply x) = difference.apply x :=
  \fun (x: L.Carrier) => EKernel.onKernel (mapIntoKernel.apply x);
\import Modules.Hom[V := N.Carrier, W := E.Carrier, source := N.space, target := E.space] \as Inclusions;
\import Modules.Laws[V := E.Carrier, space := E.space] \as Middle;
\import algebra.Group[].Of[Carrier := E.Carrier, group := Middle.additive] \as MiddleGroup;
\definition restrictionEquality: precompose correction = RelationMaps.plus First.relation (RelationMaps.negative Second.relation) :=
  RelationMaps.ext (precompose correction) (RelationMaps.plus First.relation (RelationMaps.negative Second.relation))
    (\fun (x: K.Carrier) => s.injective (correction.apply x) ((RelationMaps.plus First.relation (RelationMaps.negative Second.relation)).apply x)
      (eq_reason_in!{E.Carrier _
        "=" _ "by" { onCorrection x }
        "=" _ "by" { congr!{E.Carrier E.Carrier E.Carrier} MiddleGroup.difference _ _ _ _
            (sym!{E.Carrier} _ _ (First.onKernel x)) (sym!{E.Carrier} _ _ (Second.onKernel x)) }
        "=" _ "by" { sym!{E.Carrier} _ _ (Inclusions.differencePreserved s.inclusion (First.relation.apply x) (Second.relation.apply x)) }
      }));
\definition relationDifference: RelationSubmodules.Member extensions (RelationMaps.plus First.relation (RelationMaps.negative Second.relation)) :=
  Images.introduce restriction (RelationMaps.plus First.relation (RelationMaps.negative Second.relation)) correction restrictionEquality;
\definition classEquality: First.class = Second.class := Quotient.classRelated First.relation Second.relation relationDifference;
