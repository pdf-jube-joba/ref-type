\import Modules.Hom[V := N.Carrier, W := Target.Carrier, source := N.space, target := Target.space] \as Inclusions;
\import Inclusions.Composition[U := L.Carrier, domain := L.space] \as ComposeCorrection;
\import Modules.Hom[V := L.Carrier, W := Target.Carrier, source := L.space, target := Target.space] \as LiftMaps;
\definition corrected: LiftMaps.Map := LiftMaps.plus TargetPushout.right (ComposeCorrection.compose Target.sequence.inclusion t);
\import Modules.Laws[V := N.Carrier, space := N.space] \as Left;
\import algebra.Group[].Of[Carrier := N.Carrier, group := Left.additive] \as LeftGroup;
\definition correction: \forall (x: K.Carrier) -> t.apply x = LeftGroup.difference (f.apply x) (g.apply x) :=
  \fun (x: K.Carrier) => congr!{Relations.Carrier N.Carrier} (\fun (a: Relations.Carrier) => a.apply x)
    (precompose t) relationDifference (\bysub(Generators.Carrier, { t: Generators.Carrier \where precompose t = relationDifference }, t));
\definition recover: \forall (x: K.Carrier) -> f.apply x = N.space.add (g.apply x) (t.apply x) :=
  \fun (x: K.Carrier) => trans!{N.Carrier} _ _ _
    (sym!{N.Carrier} _ _ (LeftGroup.addDifference (f.apply x) (g.apply x)))
    (trans!{N.Carrier} _ _ _ (LeftGroup.comm (LeftGroup.difference (f.apply x) (g.apply x)) (g.apply x))
      (congr!{N.Carrier N.Carrier} (N.space.add (g.apply x)) _ _ (sym!{N.Carrier} _ _ (correction x))));
\import SourcePushout.Universal[U := Target.bundle, b := Target.sequence.inclusion, c := corrected] \as Universal;
\definition compatible: Universal.Compatible := \fun (x: K.Carrier) => trans!{Target.Carrier} _ _ _
  (congr!{N.Carrier Target.Carrier} (Target.sequence.inclusion.apply) _ _ (recover x))
  (trans!{Target.Carrier} _ _ _ (Target.sequence.inclusion.addition (g.apply x) (t.apply x))
    (congr!{Target.Carrier Target.Carrier} (\fun (a: Target.Carrier) => Target.space.add a (Target.sequence.inclusion.apply (t.apply x))) _ _ (TargetPushout.square x)));
\definition map: Modules.MapBetween Source.bundle Target.bundle := Universal.map compatible;
\definition onLeft: \forall (n: N.Carrier) -> map.apply (Source.sequence.inclusion.apply n) = Target.sequence.inclusion.apply n := Universal.onLeft compatible;
\definition onRight: \forall (x: L.Carrier) -> map.apply (SourcePushout.right.apply x) = corrected.apply x := Universal.onRight compatible;
\import Modules.Hom[V := N.Carrier, W := M.Carrier, source := N.space, target := M.space] \as Zero;
\import SourcePushout.Universal[U := M, b := Zero.zeroMap, c := resolution.augmentation] \as Projection;
\definition projectionCompatible: Projection.Compatible := \fun (x: K.Carrier) => sym!{M.Carrier} _ _ (presentation.zero x);
\import TargetPushout.Universal[U := M, b := Zero.zeroMap, c := resolution.augmentation] \as TargetProjection;
\definition targetCompatible: TargetProjection.Compatible := \fun (x: K.Carrier) => sym!{M.Carrier} _ _ (presentation.zero x);
\import Modules.Laws[V := M.Carrier, space := M.space] \as Right;
\import algebra.Group[].Of[Carrier := M.Carrier, group := Right.additive] \as RightGroup;
\definition correctedAugmented: \forall (x: L.Carrier) -> Target.sequence.projection.apply (corrected.apply x) = resolution.augmentation.apply x :=
  \fun (x: L.Carrier) => trans!{M.Carrier} _ _ _
    (Target.sequence.projection.addition (TargetPushout.right.apply x) (Target.sequence.inclusion.apply (t.apply x)))
    (trans!{M.Carrier} _ _ _
      (congr2!{M.Carrier M.Carrier M.Carrier} (M.space.add) _ _ _ _ (TargetProjection.onRight targetCompatible x) (Target.sequence.zero (t.apply x)))
      (RightGroup.zeroRight (resolution.augmentation.apply x)));
\import Modules.Hom[V := Target.Carrier, W := M.Carrier, source := Target.space, target := M.space].Composition[U := Source.Carrier, domain := Source.space] \as ComposeProjection;
\definition composed: Modules.MapBetween Source.bundle M := ComposeProjection.compose Target.sequence.projection map;
\definition projectionEquality: composed = Source.sequence.projection := Projection.unique projectionCompatible composed
  (\fun (n: N.Carrier) => trans!{M.Carrier} _ _ _
    (congr!{Target.Carrier M.Carrier} (Target.sequence.projection.apply) (map.apply (SourcePushout.left.apply n)) (Target.sequence.inclusion.apply n) (onLeft n)) (Target.sequence.zero n))
  (\fun (x: L.Carrier) => trans!{M.Carrier} _ _ _
    (congr!{Target.Carrier M.Carrier} (Target.sequence.projection.apply) (map.apply (SourcePushout.right.apply x)) (corrected.apply x) (onRight x)) (correctedAugmented x));
\definition onProjection: \forall (x: Source.Carrier) -> Target.sequence.projection.apply (map.apply x) = Source.sequence.projection.apply x :=
  \fun (x: Source.Carrier) => congr!{{Modules.MapBetween Source.bundle M} M.Carrier}
    (\fun (a: Modules.MapBetween Source.bundle M) => a.apply x) composed Source.sequence.projection projectionEquality;
\import Modules.End[V := N.Carrier, space := N.space] \as LeftIdentity;
\import Modules.End[V := M.Carrier, space := M.space] \as RightIdentity;
\import Modules.ShortExactComparison[A := N, B := Source.bundle, C := M, A1 := N, B1 := Target.bundle, C1 := M].Diagram[
  s := Source.sequence, t := Target.sequence, a := LeftIdentity.identity, b := map, c := RightIdentity.identity] \as Comparison;
\definition diagram: Comparison.Commutative := Comparison.Commutative { left := onLeft, right := onProjection };
\definition leftOnto: Modules.Surjective N N LeftIdentity.identity := \fun (x: N.Carrier) =>
  Existential.existsIntro[N.Carrier, { y: N.Carrier \where y = x }] x (\refl(x));
\definition rightOnto: Modules.Surjective M M RightIdentity.identity := \fun (x: M.Carrier) =>
  Existential.existsIntro[M.Carrier, { y: M.Carrier \where y = x }] x (\refl(x));
\definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism :=
  Comparison.isomorphism diagram (\fun (x, y: N.Carrier)(equal: x = y) => equal) leftOnto
    (\fun (x, y: M.Carrier)(equal: x = y) => equal) rightOnto;
