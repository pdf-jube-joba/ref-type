\use std.Logic[].Equality[].eq_reason_in;
\import Comparison.Selected[t := correction] \as ComparisonIso;
\import derived_functors.Ext[].Over[R := R, ring := ring].Extension[M := M, N := N, P := P].With[resolution := resolution].Represent[f := First.relation] \as FirstMiddle;
\import derived_functors.Ext[].Over[R := R, ring := ring].Extension[M := M, N := N, P := P].With[resolution := resolution].Represent[f := Second.relation] \as SecondMiddle;
\import Modules.Isomorphism[V := FirstMiddle.Carrier, W := E.Carrier, source := FirstMiddle.space, target := E.space].Inverse[] \as InverseFirst;
\definition firstInverse: Modules.Isomorphism[V := E.Carrier, W := FirstMiddle.Carrier, source := E.space, target := FirstMiddle.space].Isomorphism :=
  InverseFirst.inverse FirstRepresentative.isomorphism;
\import Modules.Isomorphism[V := E.Carrier, W := FirstMiddle.Carrier, source := E.space, target := FirstMiddle.space].Composition[U := SecondMiddle.Carrier, final := SecondMiddle.space] \as ComposeFirst;
\definition intermediate: Modules.Isomorphism[V := E.Carrier, W := SecondMiddle.Carrier, source := E.space, target := SecondMiddle.space].Isomorphism :=
  ComposeFirst.compose ComparisonIso.isomorphism firstInverse;
\import Modules.Isomorphism[V := E.Carrier, W := SecondMiddle.Carrier, source := E.space, target := SecondMiddle.space].Composition[U := F.Carrier, final := F.space] \as ComposeSecond;
\definition isomorphism: Iso.Isomorphism := ComposeSecond.compose SecondRepresentative.isomorphism intermediate;
\definition inverseOnLeft: \forall (n: N.Carrier) -> FirstRepresentative.isomorphism.backward.apply (s.inclusion.apply n) = FirstMiddle.sequence.inclusion.apply n :=
  \fun (n: N.Carrier) => trans!{FirstMiddle.Carrier} _ _ _
    (congr!{E.Carrier FirstMiddle.Carrier} (FirstRepresentative.isomorphism.backward.apply) _ _ (sym!{E.Carrier} _ _ (FirstRepresentative.onLeft n)))
    (FirstRepresentative.isomorphism.leftInverse (FirstMiddle.sequence.inclusion.apply n));
\definition onLeft: \forall (n: N.Carrier) -> isomorphism.forward.apply (s.inclusion.apply n) = t.inclusion.apply n :=
  \fun (n: N.Carrier) => eq_reason_in!{F.Carrier _
    "=" _ "by" { congr!{FirstMiddle.Carrier F.Carrier} (\fun (x: FirstMiddle.Carrier) => SecondRepresentative.map.apply (ComparisonIso.map.apply x)) _ _ (inverseOnLeft n) }
    "=" _ "by" { congr!{SecondMiddle.Carrier F.Carrier} (SecondRepresentative.map.apply) _ _ (ComparisonIso.onLeft n) }
    "=" _ "by" { SecondRepresentative.onLeft n }
  };
\definition inverseOnProjection: \forall (x: E.Carrier) -> FirstMiddle.sequence.projection.apply (FirstRepresentative.isomorphism.backward.apply x) = s.projection.apply x :=
  \fun (x: E.Carrier) => trans!{M.Carrier} _ _ _
    (sym!{M.Carrier} _ _ (FirstRepresentative.onProjection (FirstRepresentative.isomorphism.backward.apply x)))
    (congr!{E.Carrier M.Carrier} (s.projection.apply) _ _ (FirstRepresentative.isomorphism.rightInverse x));
\definition onProjection: \forall (x: E.Carrier) -> t.projection.apply (isomorphism.forward.apply x) = s.projection.apply x :=
  \fun (x: E.Carrier) => eq_reason_in!{M.Carrier _
    "=" _ "by" { SecondRepresentative.onProjection (ComparisonIso.map.apply (FirstRepresentative.isomorphism.backward.apply x)) }
    "=" _ "by" { ComparisonIso.onProjection (FirstRepresentative.isomorphism.backward.apply x) }
    "=" _ "by" { inverseOnProjection x }
  };
\definition equivalence: Equivalence := \into[Iso.Isomorphism](isomorphism, { e: Iso.Isomorphism \where Laws[e] }) \by {
  Laws[isomorphism] { left := onLeft, right := onProjection }
};
