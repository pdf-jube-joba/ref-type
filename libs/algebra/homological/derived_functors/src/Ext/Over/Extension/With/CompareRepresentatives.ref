\import \parent.Represent[f := f] \as Source;
\import \parent.Represent[f := g] \as Target;
\import Modules.Pushout[A := KBundle, B := N, C := L].On[f := f, g := Kernel.inclusion] \as SourcePushout;
\import Modules.Pushout[A := KBundle, B := N, C := L].On[f := g, g := Kernel.inclusion] \as TargetPushout;
\definition relationDifference: Relations.Carrier := RelationMaps.plus f (RelationMaps.negative g);
\definition Correction: \Set := \Cast[Generators.Carrier] ({ t: Generators.Carrier \where precompose t = relationDifference });
\definition existence: Quotient.class f = Quotient.class g -> \exists Correction :=
  Quotient.relatedOfClassEq f g;
\module Selected(t: Correction);
