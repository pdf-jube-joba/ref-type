\import Sequences.Pushout[N := N].On[s := presentation, f := f] \as Pushout;
\definition Carrier: \Set := Pushout.Carrier;
\definition space: Modules.Space Carrier := Pushout.space;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
\definition sequence: Modules.ShortExact[A := N, B := bundle, C := M].Sequence := Modules.ShortExact[A := N, B := bundle, C := M].Sequence {
  inclusion := Pushout.inclusion, projection := Pushout.projection,
  injective := Pushout.injective, onto := Pushout.onto, zero := Pushout.zero, kernelImage := Pushout.kernelImage,
};
