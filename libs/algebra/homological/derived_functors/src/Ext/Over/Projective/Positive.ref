\import resolutions.HomComplex[].Over[R := R, ring := ring].On[P := Chosen.complex, N := N] \as Hom;
\import Hom.At[n := Nat.Nat^::succ n] \as Term;
\import chain_complexes.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring].At[C := Hom.complex, k := Nat.Nat^::succ n] \as Homology;
\definition trivial: \forall (f: Term.Carrier) -> f = Term.space.zero :=
  \fun (f: Term.Carrier) => Term.ext f Term.space.zero
    (\fun (x: Chosen.Carrier (Nat.Nat^::succ n)) => trans!{N.Carrier} _ _ _
      (congr!{{Chosen.Carrier (Nat.Nat^::succ n)} N.Carrier} (f.apply) x (Chosen.space (Nat.Nat^::succ n)).zero (Chosen.Positive[n := n].trivial x))
      (Term.zeroPreserved f));
\definition chosenVanishing: \forall (x: Source.At[n := Nat.Nat^::succ n].Carrier) -> x = (Source.At[n := Nat.Nat^::succ n].space).zero :=
  Homology.Vanishing[].zero trivial;
\import \parent.\parent.Independence[M := M, N := N, P := Chosen.complex, Q := P].At[n := Nat.Nat^::succ n] \as Comparison;
\import Source.At[n := Nat.Nat^::succ n] \as SourceTerm;
\import Target.At[n := Nat.Nat^::succ n] \as TargetTerm;
\import Modules.Isomorphism[V := SourceTerm.Carrier, W := TargetTerm.Carrier, source := SourceTerm.space, target := TargetTerm.space] \as Iso;
\import Modules.Hom[V := SourceTerm.Carrier, W := TargetTerm.Carrier, source := SourceTerm.space, target := TargetTerm.space] \as Forward;
\definition vanishing: Modules.Projective M -> \forall (resolution: Target.Resolution)(x: TargetTerm.Carrier) -> x = TargetTerm.space.zero := \block {
  \fun (projective: Modules.Projective M)(resolution: Target.Resolution)(x: TargetTerm.Carrier) \then
  \takefrom iso: Iso.Isomorphism \by Comparison.existence (Resolution.resolution projective) resolution \then
  \return trans!{TargetTerm.Carrier} x (iso.forward.apply (iso.backward.apply x)) TargetTerm.space.zero
    (sym!{TargetTerm.Carrier} _ _ (iso.rightInverse x))
    (trans!{TargetTerm.Carrier} _ _ _
      (congr!{SourceTerm.Carrier TargetTerm.Carrier} (iso.forward.apply) _ _ (chosenVanishing (iso.backward.apply x)))
      (Forward.zeroPreserved iso.forward))
};
