\import First.At[n := k] \as Source;
\import Third.At[n := k] \as Target;
\definition composition: \forall (x: Source.Carrier) ->
  ((DirectChange.At[k := k].isomorphism).forward).apply x =
    ((SecondChange.At[k := k].isomorphism).forward).apply (((FirstChange.At[k := k].isomorphism).forward).apply x) :=
  Composition.At[k := k].composition;
\definition identity: \forall (x: Source.Carrier) -> ((SelfChange.At[k := k].isomorphism).forward).apply x = x :=
  IdentityLaw.At[k := k, resolution := p].identity;
