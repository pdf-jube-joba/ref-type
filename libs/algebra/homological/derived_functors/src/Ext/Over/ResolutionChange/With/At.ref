\import First.At[n := k] \as Source;
\import Third.At[n := k] \as Target;
\definition composition: \forall (x: Source.Carrier) ->
  #apply{#forward{DirectChange.At[k := k].isomorphism}} x =
    #apply{#forward{SecondChange.At[k := k].isomorphism}} (#apply{#forward{FirstChange.At[k := k].isomorphism}} x) :=
  Composition.At[k := k].composition;
\definition identity: \forall (x: Source.Carrier) -> #apply{#forward{SelfChange.At[k := k].isomorphism}} x = x :=
  IdentityLaw.At[k := k, resolution := p].identity;
