\import std.Data[].Nat[] \as Nat;
\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\module Over(R: \Set, ring: Ring.CommutativeRing[R]) {
  \import module_theory.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
  \import commutative_algebra.Modules[R := R, ring := ring] \as Algebra;
  \import chain_complexes.Chain[] \as Degrees;
  \import Degrees.Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
  \import resolutions.HomComplex[].Over[R := R, ring := ring] \as HomComplex;
  \module On(C: Chains.Complex, A: Modules.Bundle) {
    \import HomComplex.Integer[P := C, N := A] \as Hom;
    \module At(z: Degrees.Degree);
  }
  \module Morphism(C, D: Chains.Complex, A, B: Modules.Bundle);
  \module Projective(C: Chains.Complex, A: Modules.Bundle);
  \module LengthOneMapping(K, L, M, K1, L1, M1: Modules.Bundle);
  \module ExactNaturality(L, M, N, L1, M1, N1: Modules.Bundle);
  \module ExactIdentity(L, M, N: Modules.Bundle);
  \module Assertions;
  \module ExactComposition(L, M, N, L1, M1, N1, L2, M2, N2: Modules.Bundle);
}
