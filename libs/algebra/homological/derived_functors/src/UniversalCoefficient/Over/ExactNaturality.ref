\import Modules.ShortExact[A := L, B := M, C := N] \as Source;
\import Modules.ShortExact[A := L1, B := M1, C := N1] \as Target;
\import Modules.Hom[V := L.Carrier, W := L1.Carrier, source := L.space, target := L1.space] \as Left;
\import Modules.Hom[V := M.Carrier, W := M1.Carrier, source := M.space, target := M1.space] \as Middle;
\import Modules.Hom[V := N.Carrier, W := N1.Carrier, source := N.space, target := N1.space] \as Right;
\module Kernel(s: Source.Sequence, t: Target.Sequence, b: Middle.Map, c: Right.Map);
\module Cokernel(s: Source.Sequence, t: Target.Sequence, a: Left.Map, b: Middle.Map);
