\definition cohomologySequence: _ :=
  \fun (C: Chains.Complex)(A: Modules.Bundle)(z: Degrees.Degree)
    (h: \parent.Projective[C := C, A := A].At[z := z].Hypotheses) =>
    \parent.Projective[C := C, A := A].At[z := z].cohomologySequenceExistence h;
\definition tensorSequence: _ :=
  \fun (C: Chains.Complex)(A: Modules.Bundle)(z: Degrees.Degree)
    (h: \parent.Projective[C := C, A := A].At[z := z].Hypotheses) =>
    \parent.Projective[C := C, A := A].At[z := z].tensorSequenceExistence h;
\definition kernelNaturality: _ :=
  \fun (L, M, N, L1, M1, N1: Modules.Bundle)
    (s: Modules.ShortExact[A := L, B := M, C := N].Sequence)
    (t: Modules.ShortExact[A := L1, B := M1, C := N1].Sequence)
    (b: Modules.MapBetween M M1)(c: Modules.MapBetween N N1)
    (commutes: \parent.ExactNaturality[L := L, M := M, N := N, L1 := L1, M1 := M1, N1 := N1].Kernel[s := s, t := t, b := b, c := c].Commutes) =>
    \parent.ExactNaturality[L := L, M := M, N := N, L1 := L1, M1 := M1, N1 := N1].Kernel[s := s, t := t, b := b, c := c].diagram commutes;
\definition cokernelNaturality: _ :=
  \fun (L, M, N, L1, M1, N1: Modules.Bundle)
    (s: Modules.ShortExact[A := L, B := M, C := N].Sequence)
    (t: Modules.ShortExact[A := L1, B := M1, C := N1].Sequence)
    (a: Modules.MapBetween L L1)(b: Modules.MapBetween M M1)
    (commutes: \parent.ExactNaturality[L := L, M := M, N := N, L1 := L1, M1 := M1, N1 := N1].Cokernel[s := s, t := t, a := a, b := b].Commutes) =>
    \parent.ExactNaturality[L := L, M := M, N := N, L1 := L1, M1 := M1, N1 := N1].Cokernel[s := s, t := t, a := a, b := b].diagram commutes;
