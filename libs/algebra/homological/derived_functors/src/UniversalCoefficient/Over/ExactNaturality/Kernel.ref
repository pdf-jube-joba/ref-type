\definition Commutes: \Prop := \forall (x: M.Carrier) ->
  t.projection.apply (b.apply x) = c.apply (s.projection.apply x);
\import Target.Kernel[sequence := t] \as K;
\import Modules.Hom[V := L.Carrier, W := K.Carrier, source := L.space, target := K.space] \as ToKernel;
\definition closed: \forall (h: Commutes)(x: L.Carrier) ->
  t.projection.apply (b.apply (s.inclusion.apply x)) = N1.space.zero :=
  \fun (h: Commutes)(x: L.Carrier) => trans!{N1.Carrier} _ _ _ (h (s.inclusion.apply x))
    (trans!{N1.Carrier} _ _ _ (congr!{N.Carrier N1.Carrier} (c.apply) _ _ (s.zero x)) (Right.zeroPreserved c));
\definition toKernel(h: Commutes): ToKernel.Map := ToKernel.Map {
  apply := \fun (x: L.Carrier) => \into[M1.Carrier](b.apply (s.inclusion.apply x), K.kernel.carrier) \by { closed h x },
  addition := \fun (x, y: L.Carrier) => trans!{M1.Carrier} _ _ _
    (congr!{M.Carrier M1.Carrier} (b.apply) _ _ (s.inclusion.addition x y))
    (b.addition (s.inclusion.apply x) (s.inclusion.apply y)),
  scalar := \fun (r: R)(x: L.Carrier) => trans!{M1.Carrier} _ _ _
    (congr!{M.Carrier M1.Carrier} (b.apply) _ _ (s.inclusion.scalar r x))
    (b.scalar r (s.inclusion.apply x)),
};
\import Modules.Hom[V := K.Carrier, W := L1.Carrier, source := K.space, target := L1.space].Composition[U := L.Carrier, domain := L.space] \as Composition;
\definition map(h: Commutes): Left.Map := Composition.compose K.backward (toKernel h);
\definition naturality: \forall (h: Commutes)(x: L.Carrier) ->
  t.inclusion.apply ((map h).apply x) = b.apply (s.inclusion.apply x) :=
  \fun (h: Commutes)(x: L.Carrier) => K.onKernel ((toKernel h).apply x);
\definition unique: \forall (h: Commutes)(a: Left.Map) ->
  (\forall (x: L.Carrier) -> t.inclusion.apply (a.apply x) = b.apply (s.inclusion.apply x)) -> a = map h :=
  \fun (h: Commutes)(a: Left.Map)(agrees: _ ) => Left.ext a (map h)
    (\fun (x: L.Carrier) => t.injective _ _
      (trans!{M1.Carrier} _ _ _ (agrees x) (sym!{M1.Carrier} _ _ (naturality h x))));
\import Modules.ShortExactComparison[A := L, B := M, C := N, A1 := L1, B1 := M1, C1 := N1] \as Comparison;
\definition diagram(h: Commutes): Comparison.Diagram[s := s, t := t, a := map h, b := b, c := c].Commutative :=
  Comparison.Diagram[s := s, t := t, a := map h, b := b, c := c].Commutative {
    left := \fun (x: L.Carrier) => sym!{M1.Carrier} _ _ (naturality h x), right := h,
  };
\definition independent: \forall (h, k: Commutes) -> map h = map k :=
  \fun (h, k: Commutes) => unique k (map h) (naturality h);
