\definition Commutes: \Prop := \forall (x: L.Carrier) ->
  b.apply (s.inclusion.apply x) = t.inclusion.apply (a.apply x);
\import Modules.Hom[V := M1.Carrier, W := N1.Carrier, source := M1.space, target := N1.space].Composition[U := M.Carrier, domain := M.space] \as Composition;
\definition composite: _ := Composition.compose t.projection b;
\import Modules.SurjectiveDescent[A := M, B := N, U := N1].On[q := s.projection, f := composite] \as Descent;
\definition kills: Commutes -> Descent.KillsKernel := \block {
  \fun (h: Commutes)(x: M.Carrier)(zero: _) \then
  \takefrom y: \Cast[L.Carrier] ({ y: L.Carrier \where s.inclusion.apply y = x }) \by s.kernelImage x zero \then
  \return trans!{N1.Carrier} _ _ _
    (sym!{N1.Carrier} _ _ (congr!{M.Carrier N1.Carrier} (composite.apply) _ _
      (\bysub(L.Carrier, { y: L.Carrier \where s.inclusion.apply y = x }, y))))
    (trans!{N1.Carrier} _ _ _ (congr!{M1.Carrier N1.Carrier} (t.projection.apply) _ _ (h y)) (t.zero (a.apply y)))
};
\definition map[h: Commutes]: Right.Map := Descent.map (s.onto) (kills h);
\definition naturality: \forall (h: Commutes)(x: M.Carrier) ->
  (map h).apply (s.projection.apply x) = t.projection.apply (b.apply x) :=
  \fun (h: Commutes) => Descent.onImage (s.onto) (kills h);
\definition unique: \forall (h: Commutes)(c: Right.Map) ->
  (\forall (x: M.Carrier) -> c.apply (s.projection.apply x) = t.projection.apply (b.apply x)) -> c = map h :=
  \fun (h: Commutes) => Descent.unique (s.onto) (kills h);
\import Modules.ShortExactComparison[A := L, B := M, C := N, A1 := L1, B1 := M1, C1 := N1] \as Comparison;
\definition diagram[h: Commutes]: Comparison.Diagram[s := s, t := t, a := a, b := b, c := map h].Commutative :=
  Comparison.Diagram[s := s, t := t, a := a, b := b, c := map h].Commutative {
    left := h, right := \fun (x: M.Carrier) => sym!{N1.Carrier} _ _ (naturality h x),
  };
\definition independent: \forall (h, k: Commutes) -> map h = map k :=
  \fun (h, k: Commutes) => unique k (map h) (naturality h);
