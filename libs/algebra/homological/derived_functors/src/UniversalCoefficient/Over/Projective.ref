\import std.Logic[].Proposition[] \as Existential;
\definition Degree: \Set := Degrees.Degree;
\definition previous: Degree -> Degree := Degrees.previous;
\definition next: Degree -> Degree := Degrees.next;
\definition Carrier(k: Degree): \Set := C.family.Carrier k;
\definition space(k: Degree): Modules.Space (Carrier k) := C.family.space k;
\definition chain: Chains.Complex := C;
\import Chains.Prior[C := C] \as Prior;
\module At(z: Degree);
