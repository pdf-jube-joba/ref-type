\use std.Logic[].Equality[].eq_reason_in;
\import Chains.At[C := C, z := z] \as H;
\import Hom.Cohomology[z := z] \as Cohomology;
\import Modules.Hom[V := H.Cycle, W := A.Carrier, source := H.cycleSpace, target := A.space] \as Restriction;
\definition restriction[f: Cohomology.Closed]: Restriction.Map := Restriction.Map {
  apply := \fun (x: H.Cycle) => f.apply x,
  addition := \fun (x, y: H.Cycle) => f.addition x y,
  scalar := \fun (a: R)(x: H.Cycle) => f.scalar a x,
};
\import Modules.Of[V := H.Cycle, space := H.cycleSpace].Submodule[].Quotient[S := H.boundariesInside].To[W := A.Carrier, target := A.space] \as Descent;
\import Modules.Hom[V := C.family.Carrier (Degrees.next z), W := A.Carrier, source := C.family.space (Degrees.next z), target := A.space] \as Differential;
\definition onBoundary: \forall (f: Cohomology.Closed)(x: C.family.Carrier (Degrees.next z)) -> f.apply (H.prior.apply x) = A.space.zero :=
  \fun (f: Cohomology.Closed)(x: C.family.Carrier (Degrees.next z)) =>
    congr!{Differential.Map A.Carrier} (\fun (g: Differential.Map) => g.apply x)
      (Hom.apply z f) ((Hom.space (Degrees.next z)).zero) (Cohomology.closed f);
\definition vanishes: \forall (f: Cohomology.Closed) -> Descent.Vanishes (restriction f) := \block {
  \fun (f: Cohomology.Closed)(x: H.Cycle)(member: _) \then
  \takefrom y: \Cast[C.family.Carrier (Degrees.next z)] ({ y: C.family.Carrier (Degrees.next z) \where H.prior.apply y = x }) \by member \then
  \return trans!{A.Carrier} (f.apply x) (f.apply (H.prior.apply y)) (A.space.zero)
    (sym!{A.Carrier} _ _ (congr!{{C.family.Carrier z} A.Carrier} (f.apply) _ _
      (\bysub(C.family.Carrier (Degrees.next z), { y: C.family.Carrier (Degrees.next z) \where H.prior.apply y = x }, y))))
    (onBoundary f y)
};
\import Algebra.HomSpace[V := H.Homology, W := A.Carrier, source := H.homologySpace, target := A.space] \as Values;
\definition evaluate[f: Cohomology.Closed]: Values.Carrier := Descent.descend (restriction f) (vanishes f);
\definition onClass: \forall (f: Cohomology.Closed)(x: H.Cycle) -> (evaluate f).apply (H.classOf x) = f.apply x :=
  \fun (f: Cohomology.Closed) => Descent.onClass (restriction f) (vanishes f);
\import Modules.Hom[V := H.Homology, W := A.Carrier, source := H.homologySpace, target := A.space] \as ValueMaps;
\import Modules.Hom[V := Cohomology.Closed, W := Values.Carrier, source := Cohomology.cycleSpace, target := Values.space] \as Evaluations;
\definition evaluation: Evaluations.Map := Evaluations.Map {
  apply := evaluate,
  addition := \fun (f, g: Cohomology.Closed) => ValueMaps.ext (evaluate (Cohomology.cycleSpace.add f g)) (Values.space.add (evaluate f) (evaluate g))
    (H.classInduction (\fun (x: H.Homology) => (evaluate (Cohomology.cycleSpace.add f g)).apply x = (Values.space.add (evaluate f) (evaluate g)).apply x)
      (\fun (x: H.Cycle) => trans!{A.Carrier} _ _ _ (onClass (Cohomology.cycleSpace.add f g) x)
        (sym!{A.Carrier} _ _ (congr!{A.Carrier A.Carrier A.Carrier} (A.space.add) _ _ _ _ (onClass f x) (onClass g x))))),
  scalar := \fun (a: R)(f: Cohomology.Closed) => ValueMaps.ext (evaluate (Cohomology.cycleSpace.smul a f)) (Values.space.smul a (evaluate f))
    (H.classInduction (\fun (x: H.Homology) => (evaluate (Cohomology.cycleSpace.smul a f)).apply x = (Values.space.smul a (evaluate f)).apply x)
      (\fun (x: H.Cycle) => trans!{A.Carrier} _ _ _ (onClass (Cohomology.cycleSpace.smul a f) x)
        (sym!{A.Carrier} _ _ (congr!{A.Carrier A.Carrier} (A.space.smul a) _ _ (onClass f x))))),
};
\definition onCoboundary: \forall (g: Hom.Carrier (Degrees.previous z))(x: H.Cycle) -> (Cohomology.prior g).apply x = A.space.zero :=
  \fun (g: Hom.Carrier (Degrees.previous z))(x: H.Cycle) => eq_reason_in!{A.Carrier _
    "=" _ "by" { Cohomology.priorOnElement g x }
    "=" _ "by" { congr!{{C.family.Carrier (Degrees.previous z)} A.Carrier} (g.apply) _ _
        (\bysub(C.family.Carrier z, H.cycles.carrier, x)) }
    "=" _ "by" { Hom.At[z := Degrees.previous z].zeroPreserved g }
  };
\definition evaluationVanishes: \forall (f: Cohomology.Closed) ->
  Modules.Submodule[V := Cohomology.Closed, space := Cohomology.cycleSpace].Member Cohomology.boundariesInside f -> evaluate f = Values.space.zero := \block {
  \fun (f: Cohomology.Closed)(member: _) \then
  \takefrom g: \Cast[Hom.Carrier (Degrees.previous z)] ({ g: Hom.Carrier (Degrees.previous z) \where Cohomology.prior g = f })
    \by Cohomology.boundaryExists f member \then
  \return ValueMaps.ext (evaluate f) (Values.space.zero)
    (H.classInduction (\fun (x: H.Homology) => (evaluate f).apply x = A.space.zero)
      (\fun (x: H.Cycle) => eq_reason_in!{A.Carrier _
        "=" _ "by" { onClass f x }
        "=" _ "by" { sym!{A.Carrier} _ _ (congr!{{Hom.Carrier z} A.Carrier} (\fun (h: Hom.Carrier z) => h.apply x) _ _
            (\bysub(Hom.Carrier (Degrees.previous z), { g: Hom.Carrier (Degrees.previous z) \where Cohomology.prior g = f }, g))) }
        "=" _ "by" { onCoboundary g x }
      }))
};
\import Modules.Of[V := Cohomology.Closed, space := Cohomology.cycleSpace].Submodule[].Quotient[S := Cohomology.boundariesInside].To[W := Values.Carrier, target := Values.space] \as CohomologyDescent;
\definition map: Modules.Hom[V := Cohomology.Cohomology, W := Values.Carrier, source := Cohomology.cohomologySpace, target := Values.space].Map :=
  CohomologyDescent.descend evaluation evaluationVanishes;
\definition onCohomologyClass: \forall (f: Cohomology.Closed) -> map.apply (Cohomology.classOf f) = evaluate f := CohomologyDescent.onClass evaluation evaluationVanishes;

\definition Homology: \Set := H.Homology;
\definition homologySpace: Modules.Space Homology := H.homologySpace;
\definition ValueCarrier: \Set := Values.Carrier;
\definition valueSpace: Modules.Space ValueCarrier := Values.space;
\definition Closed: \Set := Cohomology.Closed;
\definition cycleSpace: Modules.Space Closed := Cohomology.cycleSpace;
\definition CohomologyCarrier: \Set := Cohomology.Cohomology;
\definition cohomologySpace: Modules.Space CohomologyCarrier := Cohomology.cohomologySpace;
