\import Modules.ShortExact[A := K, B := L, C := M] \as Source;
\import Modules.ShortExact[A := K1, B := L1, C := M1] \as Target;
\import Modules.Hom[V := K.Carrier, W := K1.Carrier, source := K.space, target := K1.space] \as Left;
\import Modules.Hom[V := L.Carrier, W := L1.Carrier, source := L.space, target := L1.space] \as Middle;
\import Modules.Hom[V := M.Carrier, W := M1.Carrier, source := M.space, target := M1.space] \as Right;
\module On(s: Source.Sequence, t: Target.Sequence, a: Left.Map, b: Middle.Map, c: Right.Map);
