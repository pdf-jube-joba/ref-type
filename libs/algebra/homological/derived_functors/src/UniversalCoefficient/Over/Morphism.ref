\import Chains.Map[C := C, D := D] \as ChainMaps;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as Coefficients;
\import HomComplex.Integer[P := D, N := A] \as SourceHom;
\import HomComplex.Integer[P := C, N := B] \as TargetHom;
\import HomComplex.IntegerMapping[P := C, Q := D, N := A, L := B] \as Mapping;
\module On(f: ChainMaps.Map, u: Coefficients.Map) {
  \import Mapping.On[f := f, u := u] \as HomMap;
  \module At(z: Degrees.Degree) {
    \import \parent.\parent.\parent.On[C := D, A := A].At[z := z] \as Source;
    \import \parent.\parent.\parent.On[C := C, A := B].At[z := z] \as Target;
    \import Chains.At[C := C, z := z] \as H;
    \import Chains.At[C := D, z := z] \as K;
    \import ChainMaps.At[k := z] \as Homology;
    \import SourceHom.Cohomology[z := z] \as SourceCohomology;
    \import TargetHom.Cohomology[z := z] \as TargetCohomology;
    \import HomMap.At[z := z] \as Induced;
    \import Modules.Hom[V := K.Homology, W := A.Carrier, source := K.homologySpace, target := A.space] \as SourceValues;
    \import Modules.Hom[V := H.Homology, W := B.Carrier, source := H.homologySpace, target := B.space] \as TargetValues;
    \definition value(g: Source.ValueCarrier): Target.ValueCarrier := TargetValues.Map {
      apply := \fun (x: H.Homology) => u.apply (g.apply ((Homology.induced f).apply x)),
      addition := \fun (x, y: H.Homology) => trans!{B.Carrier} _ _ _
        (congr!{A.Carrier B.Carrier} (u.apply) _ _
          (trans!{A.Carrier} _ _ _
            (congr!{K.Homology A.Carrier} (g.apply) _ _ ((Homology.induced f).addition x y))
            (g.addition ((Homology.induced f).apply x) ((Homology.induced f).apply y))))
        (u.addition (g.apply ((Homology.induced f).apply x)) (g.apply ((Homology.induced f).apply y))),
      scalar := \fun (a: R)(x: H.Homology) => trans!{B.Carrier} _ _ _
        (congr!{A.Carrier B.Carrier} (u.apply) _ _
          (trans!{A.Carrier} _ _ _
            (congr!{K.Homology A.Carrier} (g.apply) _ _ ((Homology.induced f).scalar a x))
            (g.scalar a ((Homology.induced f).apply x))))
        (u.scalar a (g.apply ((Homology.induced f).apply x))),
    };
    \definition values: Modules.Hom[V := Source.ValueCarrier, W := Target.ValueCarrier, source := Source.valueSpace, target := Target.valueSpace].Map :=
      Modules.Hom[V := Source.ValueCarrier, W := Target.ValueCarrier, source := Source.valueSpace, target := Target.valueSpace].Map {
        apply := value,
        addition := \fun (g, h: Source.ValueCarrier) => TargetValues.ext (value (Source.valueSpace.add g h)) (Target.valueSpace.add (value g) (value h))
          (\fun (x: H.Homology) => u.addition (g.apply ((Homology.induced f).apply x)) (h.apply ((Homology.induced f).apply x))),
        scalar := \fun (a: R)(g: Source.ValueCarrier) => TargetValues.ext (value (Source.valueSpace.smul a g)) (Target.valueSpace.smul a (value g))
          (\fun (x: H.Homology) => u.scalar a (g.apply ((Homology.induced f).apply x))),
      };
    \definition cohomology: Modules.Hom[V := Source.CohomologyCarrier, W := Target.CohomologyCarrier, source := Source.cohomologySpace, target := Target.cohomologySpace].Map := Induced.map;
    \definition onClass: \forall (g: SourceCohomology.Closed)(x: H.Cycle) ->
      (Target.map.apply (cohomology.apply (SourceCohomology.classOf g))).apply (H.classOf x) = u.apply (g.apply (f.apply z x)) :=
      \fun (g: SourceCohomology.Closed)(x: H.Cycle) => trans!{B.Carrier} _ _ _
        (congr!{Target.CohomologyCarrier B.Carrier} (\fun (q: Target.CohomologyCarrier) => (Target.map.apply q).apply (H.classOf x)) _ _ (Induced.onClass g))
        (trans!{B.Carrier} _ _ _
          (congr!{Target.ValueCarrier B.Carrier} (\fun (v: Target.ValueCarrier) => v.apply (H.classOf x)) _ _ (Target.onCohomologyClass (Induced.cycles.apply g)))
          (Target.onClass (Induced.cycles.apply g) x));
    \definition valueOnClass: \forall (g: SourceCohomology.Closed)(x: H.Cycle) ->
      (values.apply (Source.map.apply (SourceCohomology.classOf g))).apply (H.classOf x) = u.apply (g.apply (f.apply z x)) :=
      \fun (g: SourceCohomology.Closed)(x: H.Cycle) => trans!{B.Carrier} _ _ _
        (congr!{Source.ValueCarrier B.Carrier} (\fun (v: Source.ValueCarrier) => (value v).apply (H.classOf x)) _ _ (Source.onCohomologyClass g))
        (trans!{B.Carrier} _ _ _
          (congr!{K.Homology B.Carrier} (\fun (q: K.Homology) => u.apply ((Source.evaluate g).apply q)) _ _ (Homology.onClass f x))
          (congr!{A.Carrier B.Carrier} (u.apply) _ _ (Source.onClass g ((Homology.cyclesMap f).apply x))));
    \definition naturality: \forall (q: Source.CohomologyCarrier) -> Target.map.apply (cohomology.apply q) = values.apply (Source.map.apply q) :=
      SourceCohomology.classInduction (\fun (q: Source.CohomologyCarrier) => Target.map.apply (cohomology.apply q) = values.apply (Source.map.apply q))
        (\fun (g: SourceCohomology.Closed) => TargetValues.ext (Target.map.apply (cohomology.apply (SourceCohomology.classOf g))) (values.apply (Source.map.apply (SourceCohomology.classOf g)))
          (H.classInduction (\fun (x: H.Homology) => (Target.map.apply (cohomology.apply (SourceCohomology.classOf g))).apply x = (values.apply (Source.map.apply (SourceCohomology.classOf g))).apply x)
            (\fun (x: H.Cycle) => trans!{B.Carrier} _ _ _ (onClass g x) (sym!{B.Carrier} _ _ (valueOnClass g x)))));
  }
}
