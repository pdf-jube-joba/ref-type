\import Modules.ShortExact[A := Boundary.cyclesBundle, B := Boundary.chainsBundle, C := Boundary.boundaryBundle].Splitting[sequence := Boundary.sequence] \as Splitting;
\import Splitting.With[s := s] \as Selected;
\import Modules.Biproduct[V := Homology.Cycle, W := Boundary.Carrier, left := Homology.cycleSpace, right := Boundary.space] \as Sum;
\import Modules.Hom[V := Sum.Carrier, W := Homology.Cycle, source := Sum.space, target := Homology.cycleSpace].Composition[U := Carrier z, domain := space z] \as Composition;
\definition Section: \Prop := \forall (b: Boundary.Carrier) -> #apply{Boundary.map} (#apply{s} b) = b;
\definition retraction(section: Section): Retractions.Map := Composition.compose Sum.firstProjection #backward{(Selected.isomorphism section)};
\import Modules.Hom[V := Boundary.Carrier, W := Carrier z, source := Boundary.space, target := space z] \as Maps;
\import Modules.Laws[V := Carrier z, space := space z] \as Current;
\import algebra.Group[].Of[Carrier := Carrier z, group := Current.additive] \as Group;
\definition onCycle: \forall (section: Section)(x: Homology.Cycle) ->
  #apply{#forward{(Selected.isomorphism section)}} (Sum.make x #zero{Boundary.space}) = x :=
  \fun (section: Section)(x: Homology.Cycle) => trans!{{Carrier z}} _ _ _
    (congr!{{Carrier z} {Carrier z}} (#add{(space z)} x) _ _ (Maps.zeroPreserved s)) (Group.zeroRight x);
\definition retractCycle: \forall (section: Section)(x: Homology.Cycle) -> #apply{(retraction section)} x = x :=
  \fun (section: Section)(x: Homology.Cycle) => trans!{Homology.Cycle} _ _ _
    (sym!{Homology.Cycle} _ _ (congr!{{Carrier z} Homology.Cycle} (#apply{(retraction section)}) _ _ (onCycle section x)))
    (congr!{Sum.Carrier Homology.Cycle} Sum.first _ _ (#leftInverse{(Selected.isomorphism section)} (Sum.make x #zero{Boundary.space})));
