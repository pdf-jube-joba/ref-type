\import Modules.Of[V := Carrier z, space := space z].Submodule[].Image[U := Carrier (next z), source := space (next z)] \as AmbientImages;
\definition previousRetractCycle: \forall (x: PreviousHomology.Cycle) -> rprev.apply x = x :=
  \bysub(PreviousRetractions.Map, { r: PreviousRetractions.Map \where \forall (x: PreviousHomology.Cycle) -> r.apply x = x }, rprev);
\definition retraction: Retractions.Map := r;
\definition retractCycle: \forall (x: Homology.Cycle) -> retraction.apply x = x :=
  \bysub(Retractions.Map, { r: Retractions.Map \where \forall (x: Homology.Cycle) -> r.apply x = x }, r);
\import \parent.\parent.\parent.On[C := chain, A := A].At[z := z] \as Evaluation;
\import resolutions.HomComplex[].Over[R := R, ring := ring].Integer[P := chain, N := A] \as Hom;
\import Hom.Cohomology[z := z] \as Cohomology;
\import Modules.Hom[V := Homology.Homology, W := A.Carrier, source := Homology.homologySpace, target := A.space] \as Values;
\import Values.Composition[U := Homology.Cycle, domain := Homology.cycleSpace] \as FromCycles;
\import Modules.Hom[V := Homology.Cycle, W := A.Carrier, source := Homology.cycleSpace, target := A.space].Composition[U := Carrier z, domain := space z] \as FromChains;
\definition extend[f: Values.Map]: Hom.Carrier z := FromChains.compose (FromCycles.compose f Homology.classLinear) retraction;
\definition onCycle: \forall (f: Values.Map)(x: Homology.Cycle) -> (extend f).apply x = f.apply (Homology.classOf x) :=
  \fun (f: Values.Map)(x: Homology.Cycle) => congr!{Homology.Cycle A.Carrier} (\fun (y: Homology.Cycle) => f.apply (Homology.classOf y)) _ _ (retractCycle x);
\import Modules.Hom[V := Carrier (next z), W := A.Carrier, source := space (next z), target := A.space] \as Differentials;
\definition closed: \forall (f: Values.Map) -> Hom.apply z (extend f) = (Hom.space (next z)).zero :=
  \fun (f: Values.Map) => Differentials.ext (Hom.apply z (extend f)) ((Hom.space (next z)).zero)
    (\fun (x: Carrier (next z)) => trans!{A.Carrier} _ _ _ (onCycle f (Homology.cycle (Homology.prior.apply x) (Prior.squareZero z x)))
      (trans!{A.Carrier} _ _ _
        (congr!{Homology.Homology A.Carrier} (f.apply) _ _ (Homology.boundaryClassZero
          (Homology.cycle (Homology.prior.apply x) (Prior.squareZero z x)) (AmbientImages.member Homology.prior x)))
        (Values.zeroPreserved f)));
\definition cocycle[f: Values.Map]: Cohomology.Closed := \into[Hom.Carrier z](extend f,
  { g: Hom.Carrier z \where Hom.apply z g = (Hom.space (next z)).zero }) \by { closed f };
\definition lift[f: Values.Map]: Evaluation.CohomologyCarrier := Cohomology.classOf (cocycle f);
\definition rightInverse: \forall (f: Values.Map) -> Evaluation.map.apply (lift f) = f :=
  \fun (f: Values.Map) => Values.ext (Evaluation.map.apply (lift f)) f
    (Homology.classInduction (\fun (x: Homology.Homology) => (Evaluation.map.apply (lift f)).apply x = f.apply x)
      (\fun (x: Homology.Cycle) => trans!{A.Carrier} _ _ _
        (congr!{Values.Map A.Carrier} (\fun (g: Values.Map) => g.apply (Homology.classOf x)) _ _ (Evaluation.onCohomologyClass (cocycle f)))
        (trans!{A.Carrier} _ _ _ (Evaluation.onClass (cocycle f) x) (onCycle f x))));
\definition onto: \forall (f: Values.Map) -> \exists ( q: Evaluation.CohomologyCarrier \where Evaluation.map.apply q = f ) :=
  \fun (f: Values.Map) => Existential.existsIntro[Evaluation.CohomologyCarrier, { q: Evaluation.CohomologyCarrier \where Evaluation.map.apply q = f }] (lift f)
    (rightInverse f);
\module CohomologyKernel;
\module Tensor;
