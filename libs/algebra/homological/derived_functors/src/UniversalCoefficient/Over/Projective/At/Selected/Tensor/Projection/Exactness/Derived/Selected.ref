\definition Section: \Prop := \forall (b: Boundary.Carrier) -> Boundary.map.apply (s.apply b) = b;
\import BoundaryTensor.Mapping[U := Carrier z, Z := A.Carrier, targetLeft := space z, targetRight := A.space] \as TensorSection;
\definition tensorSection: Modules.Hom[V := BoundaryTensor.Carrier, W := CurrentTensor.Carrier, source := BoundaryTensor.space, target := CurrentTensor.space].Map := TensorSection.map s Coefficient.identity;
\import Modules.Hom[V := CurrentTensor.Carrier, W := BoundaryTensor.Carrier, source := CurrentTensor.space, target := BoundaryTensor.space].Composition[U := BoundaryTensor.Carrier, domain := BoundaryTensor.space] \as Roundtrip;
\import Modules.End[V := BoundaryTensor.Carrier, space := BoundaryTensor.space] \as Identity;
\import BoundaryTensor.Universal[U := BoundaryTensor.Carrier, target := BoundaryTensor.space] \as Universal;
\definition tensorRoundtrip: Section -> Roundtrip.compose Source.projection tensorSection = Identity.identity :=
  \fun (section: Section) => Universal.ext (Roundtrip.compose Source.projection tensorSection) Identity.identity
    (\fun (b: Boundary.Carrier)(a: A.Carrier) => trans!{BoundaryTensor.Carrier} _ _ _
      (congr!{CurrentTensor.Carrier BoundaryTensor.Carrier} (Source.projection.apply) _ _ (TensorSection.onTensor s Coefficient.identity b a))
      (trans!{BoundaryTensor.Carrier} _ _ _ (QuotientMapping.onTensor Boundary.map Coefficient.identity (s.apply b) a)
        (congr!{Boundary.Carrier BoundaryTensor.Carrier} (\fun (v: Boundary.Carrier) => BoundaryTensor.tensor v a) _ _ (section b))));
\definition tensorRoundtripPoint: Section -> \forall (b: BoundaryTensor.Carrier) -> Source.projection.apply (tensorSection.apply b) = b :=
  \fun (section: Section)(b: BoundaryTensor.Carrier) =>
    congr!{Modules.Hom[V := BoundaryTensor.Carrier, W := BoundaryTensor.Carrier, source := BoundaryTensor.space, target := BoundaryTensor.space].Map BoundaryTensor.Carrier}
      (\fun (f: Modules.Hom[V := BoundaryTensor.Carrier, W := BoundaryTensor.Carrier, source := BoundaryTensor.space, target := BoundaryTensor.space].Map) => f.apply b) _ _ (tensorRoundtrip section);
\definition closed: Section -> \forall (b: Tor.Kernel) -> NativeTensor.apply z (tensorSection.apply b) = LowerTensor.space.zero :=
  \fun (section: Section)(b: Tor.Kernel) => trans!{LowerTensor.Carrier} _ _ _
    (sym!{LowerTensor.Carrier} _ _ (differentialFactorPoint (tensorSection.apply b)))
    (trans!{LowerTensor.Carrier} _ _ _
      (congr!{BoundaryTensor.Carrier LowerTensor.Carrier} (\fun (v: BoundaryTensor.Carrier) => lowerInclusion.apply (Tor.kernelDifferential.apply v)) _ _ (tensorRoundtripPoint section b))
      (trans!{LowerTensor.Carrier} _ _ _ (congr!{LowerCycles.Carrier LowerTensor.Carrier} (lowerInclusion.apply) _ _ (Tor.kernelClosed b))
        (LowerMaps.zeroPreserved lowerInclusion)));
\definition cycle[section: Section][b: Tor.Kernel]: TensorHomology.Cycle := TensorHomology.cycle (tensorSection.apply b) (closed section b);
\import Modules.Hom[V := Tor.Kernel, W := TensorHomology.Cycle, source := Tor.kernelSpace, target := TensorHomology.cycleSpace] \as Cycles;
\definition cycles[section: Section]: Cycles.Map := Cycles.Map {
  apply := cycle section,
  addition := \fun (b, c: Tor.Kernel) => tensorSection.addition b c,
  scalar := \fun (a: R)(b: Tor.Kernel) => tensorSection.scalar a b,
};
\import Modules.Hom[V := TensorHomology.Cycle, W := TensorHomology.Homology, source := TensorHomology.cycleSpace, target := TensorHomology.homologySpace].Composition[U := Tor.Kernel, domain := Tor.kernelSpace] \as Classes;
\definition kernelSection[section: Section]: Modules.Hom[V := Tor.Kernel, W := TensorHomology.Homology, source := Tor.kernelSpace, target := TensorHomology.homologySpace].Map := Classes.compose TensorHomology.classLinear (cycles section);
\import Modules.Hom[V := Tor.Kernel, W := TensorHomology.Homology, source := Tor.kernelSpace, target := TensorHomology.homologySpace].Composition[U := Tor.Carrier, domain := Tor.space] \as Composition;
\definition map[section: Section]: Modules.Hom[V := Tor.Carrier, W := TensorHomology.Homology, source := Tor.space, target := TensorHomology.homologySpace].Map := Composition.compose (kernelSection section) Tor.isomorphism.forward;
\definition rightInverse: \forall (section: Section)(b: Tor.Carrier) -> projection.apply ((map section).apply b) = b :=
  \fun (section: Section)(b: Tor.Carrier) => trans!{Tor.Carrier} _ _ _
    (congr!{Tor.Kernel Tor.Carrier} (Tor.isomorphism.backward.apply) _ _ (KernelProjection.onClass (cycle section (Tor.isomorphism.forward.apply b))))
    (trans!{Tor.Carrier} _ _ _
      (congr!{Tor.Kernel Tor.Carrier} (Tor.isomorphism.backward.apply)
        (KernelProjection.kernel (cycle section (Tor.isomorphism.forward.apply b))) (Tor.isomorphism.forward.apply b)
        (tensorRoundtripPoint section (Tor.isomorphism.forward.apply b)))
      (Tor.isomorphism.leftInverse b));
\import DerivedSequences.Splitting[sequence := sequence] \as Splitting;
\import Modules.Biproduct[V := HomologyTensor.Carrier, W := Tor.Carrier, left := HomologyTensor.space, right := Tor.space] \as Sum;
\definition isomorphism[section: Section]: Modules.Isomorphism[V := Sum.Carrier, W := TensorHomology.Homology, source := Sum.space, target := TensorHomology.homologySpace].Isomorphism :=
  Splitting.With[s := map section].isomorphism (rightInverse section);
