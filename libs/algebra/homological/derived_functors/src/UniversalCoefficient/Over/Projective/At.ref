\import Chains.At[C := C, z := z] \as Homology;
\import Chains.At[C := C, z := previous z] \as PreviousHomology;
\import Modules.Hom[V := Carrier z, W := Homology.Cycle, source := space z, target := Homology.cycleSpace] \as Retractions;
\import Modules.Hom[V := Carrier (previous z), W := PreviousHomology.Cycle, source := space (previous z), target := PreviousHomology.cycleSpace] \as PreviousRetractions;
\definition Retraction: \Set := \Cast[Retractions.Map] ({ r: Retractions.Map \where \forall (x: Homology.Cycle) -> #apply{r} x = x });
\definition PreviousRetraction: \Set := \Cast[PreviousRetractions.Map] ({ r: PreviousRetractions.Map \where \forall (x: PreviousHomology.Cycle) -> #apply{r} x = x });
\module Boundary;
\module Presentation;
\module Incoming;
\module Selected(r: Retraction, rprev: PreviousRetraction);
\import \root.UniversalCoefficient[].Over[R := R, ring := ring].Projective[C := C, A := A].At[z := z].Boundary[] \as Boundary;
\module Section(s: Modules.Hom[V := Boundary.Carrier, W := Carrier z, source := Boundary.space, target := space z].Map);
\import Modules.Hom[V := Boundary.Carrier, W := Carrier z, source := Boundary.space, target := space z] \as Sections;
\import Modules.End[V := Boundary.Carrier, space := Boundary.space] \as BoundaryIdentity;
\definition retractionExistence: Modules.Projective Boundary.boundaryBundle -> \exists Retraction := \block {
  \fun (projective: Modules.Projective Boundary.boundaryBundle) \then
  \takefrom s: \Cast[Sections.Map] ({ s: Sections.Map \where \forall (b: Boundary.Carrier) -> #apply{Boundary.map} (#apply{s} b) = b })
    \by projective (Carrier z) (space z) Boundary.Carrier Boundary.space Boundary.map Boundary.onto BoundaryIdentity.identity \then
  \let section: \forall (b: Boundary.Carrier) -> #apply{Boundary.map} (#apply{s} b) = b :=
    \bysub(Sections.Map, { s: Sections.Map \where \forall (b: Boundary.Carrier) -> #apply{Boundary.map} (#apply{s} b) = b }, s) \then
  \return \exact(\into[Retractions.Map](Section[s := s].retraction section,
    { r: Retractions.Map \where \forall (x: Homology.Cycle) -> #apply{r} x = x }) \by { Section[s := s].retractCycle section }, Retraction)
};
\import \root.UniversalCoefficient[].Over[R := R, ring := ring].Projective[C := C, A := A].At[z := previous z] \as Previous;
\import Previous.Boundary[] \as PreviousBoundary;
\import Previous.Presentation[] \as PreviousPresentation;
\structure Hypotheses: \Prop {
  currentBoundary: Modules.Projective Boundary.boundaryBundle,
  previousBoundary: Modules.Projective PreviousBoundary.boundaryBundle,
  previousCycles: Modules.Projective PreviousPresentation.cyclesBundle,
}
\import \root.Ext[].Over[R := R, ring := ring].LengthOne[K := PreviousPresentation.boundaryBundle, L := PreviousPresentation.cyclesBundle, M := PreviousPresentation.homologyBundle, N := A].With[sequence := PreviousPresentation.sequence] \as E;
\import \root.Tor[].Over[R := R, ring := ring].LengthOne[K := PreviousPresentation.boundaryBundle, L := PreviousPresentation.cyclesBundle, M := PreviousPresentation.homologyBundle, N := A].With[sequence := PreviousPresentation.sequence] \as T;
\definition extResolution(h: Hypotheses): _ := E.resolution #currentBoundary{h} #previousCycles{h};
\definition torResolution(h: Hypotheses): _ := T.resolution #currentBoundary{h} #previousCycles{h};
\import \parent.\parent.On[C := C, A := A].At[z := z] \as Evaluation;
\definition extBundle: Modules.Bundle := Modules.Bundle { Carrier := E.Carrier, space := E.space };
\definition cohomologyBundle: Modules.Bundle := Modules.Bundle { Carrier := Evaluation.CohomologyCarrier, space := Evaluation.cohomologySpace };
\definition valuesBundle: Modules.Bundle := Modules.Bundle { Carrier := Evaluation.ValueCarrier, space := Evaluation.valueSpace };
\import Modules.ShortExact[A := extBundle, B := cohomologyBundle, C := valuesBundle] \as CohomologySequences;
\definition cohomologySequenceExistence: Hypotheses -> \exists CohomologySequences.Sequence := \block {
  \fun (h: Hypotheses) \then
  \takefrom r: Retraction \by retractionExistence #currentBoundary{h} \then
  \takefrom p: PreviousRetraction \by Previous.retractionExistence #previousBoundary{h} \then
  \return \exact(Selected[r := r, rprev := p].CohomologyKernel[].sequence, CohomologySequences.Sequence)
};
\import resolutions.TensorComplex[].Over[R := R, ring := ring].Integer[P := C, N := A] \as Tensor;
\import Chains.At[C := Tensor.complex, z := z] \as TensorHomology;
\import Modules.Tensor[V := Homology.Homology, W := A.Carrier, left := Homology.homologySpace, right := A.space] \as HomologyTensor;
\definition tensorLeft: Modules.Bundle := Modules.Bundle { Carrier := HomologyTensor.Carrier, space := HomologyTensor.space };
\definition tensorMiddle: Modules.Bundle := Modules.Bundle { Carrier := TensorHomology.Homology, space := TensorHomology.homologySpace };
\definition torBundle: Modules.Bundle := Modules.Bundle { Carrier := T.Carrier, space := T.space };
\import Modules.ShortExact[A := tensorLeft, B := tensorMiddle, C := torBundle] \as TensorSequences;
\definition tensorSequenceExistence: Hypotheses -> \exists TensorSequences.Sequence := \block {
  \fun (h: Hypotheses) \then
  \takefrom r: Retraction \by retractionExistence #currentBoundary{h} \then
  \takefrom p: PreviousRetraction \by Previous.retractionExistence #previousBoundary{h} \then
  \return \exact(Selected[r := r, rprev := p].Tensor[].Projection[].Exactness[].Derived[].sequence, TensorSequences.Sequence)
};
\module ChoiceIndependence(r, s: Retraction, rprev, sprev: PreviousRetraction);
