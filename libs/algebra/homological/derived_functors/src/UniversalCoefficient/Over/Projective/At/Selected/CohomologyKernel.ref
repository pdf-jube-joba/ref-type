\definition liftClosed(f: Values.Map): Cohomology.Closed := cocycle f;
\definition liftExtend(f: Values.Map): Hom.Carrier z := extend f;
\definition previousRetractCycle: \forall (x: PreviousHomology.Cycle) -> rprev.apply x = x :=
  \bysub(PreviousRetractions.Map, { r: PreviousRetractions.Map \where \forall (x: PreviousHomology.Cycle) -> r.apply x = x }, rprev);
\import \parent.\parent.Boundary[] \as Boundary;
\import \parent.\parent.\parent.At[z := previous z].Presentation[] \as Presentation;
\import derived_functors.Ext[].Over[R := R, ring := ring].LengthOne[K := Presentation.boundaryBundle, L := Presentation.cyclesBundle, M := Presentation.homologyBundle, N := A].With[sequence := Presentation.sequence] \as Ext;
\definition resolution(bp: Modules.Projective Presentation.boundaryBundle)(cp: Modules.Projective Presentation.cyclesBundle): _ := Ext.resolution bp cp;
\import Chains.At[C := chain, z := previous z] \as PreviousHomology;
\import Modules.Hom[V := Boundary.Carrier, W := A.Carrier, source := Boundary.space, target := A.space] \as BoundaryMaps;
\import Algebra.HomSpace[V := Boundary.Carrier, W := A.Carrier, source := Boundary.space, target := A.space] \as BoundaryValues;
\import Modules.Hom[V := Carrier z, W := A.Carrier, source := space z, target := A.space] \as CurrentMaps;
\import BoundaryMaps.Composition[U := Carrier z, domain := space z] \as Composition;
\definition cochain(f: BoundaryMaps.Map): Hom.Carrier z := Composition.compose f Boundary.map;
\definition closed: \forall (f: BoundaryMaps.Map) -> Hom.apply z (cochain f) = (Hom.space (next z)).zero :=
  \fun (f: BoundaryMaps.Map) => Differentials.ext (Hom.apply z (cochain f)) ((Hom.space (next z)).zero)
    (\fun (x: Carrier (next z)) => trans!{A.Carrier} _ _ _
      (congr!{Boundary.Carrier A.Carrier} (f.apply) _ _
        (Boundary.onCycle (Homology.cycle (Prior.value z x) (Prior.squareZero z x))))
      (BoundaryMaps.zeroPreserved f));
\definition cocycle(f: BoundaryMaps.Map): Cohomology.Closed := \into[Hom.Carrier z](cochain f,
  { g: Hom.Carrier z \where Hom.apply z g = (Hom.space (next z)).zero }) \by { closed f };
\import Modules.Hom[V := BoundaryValues.Carrier, W := Cohomology.Closed, source := BoundaryValues.space, target := Cohomology.cycleSpace] \as Cycles;
\definition cycleMap: Cycles.Map := Cycles.Map {
  apply := cocycle,
  addition := \fun (f, g: BoundaryValues.Carrier) => CurrentMaps.ext (cochain (BoundaryValues.space.add f g)) ((Hom.space z).add (cochain f) (cochain g))
    (\fun (x: Carrier z) => \refl(A.space.add (f.apply (Boundary.value x)) (g.apply (Boundary.value x)))),
  scalar := \fun (a: R)(f: BoundaryValues.Carrier) => CurrentMaps.ext (cochain (BoundaryValues.space.smul a f)) ((Hom.space z).smul a (cochain f))
    (\fun (x: Carrier z) => \refl(A.space.smul a (f.apply (Boundary.value x)))),
};
\import Modules.Hom[V := Cohomology.Closed, W := Cohomology.Cohomology, source := Cohomology.cycleSpace, target := Cohomology.cohomologySpace].Composition[U := BoundaryValues.Carrier, domain := BoundaryValues.space] \as Classes;
\definition classMap: Modules.Hom[V := BoundaryValues.Carrier, W := Cohomology.Cohomology, source := BoundaryValues.space, target := Cohomology.cohomologySpace].Map :=
  Classes.compose Cohomology.classLinear cycleMap;
\import Modules.Hom[V := PreviousHomology.Cycle, W := A.Carrier, source := PreviousHomology.cycleSpace, target := A.space] \as PreviousMaps;
\import Algebra.HomSpace[V := PreviousHomology.Cycle, W := A.Carrier, source := PreviousHomology.cycleSpace, target := A.space] \as CycleValues;
\import PreviousMaps.Composition[U := Carrier (previous z), domain := space (previous z)] \as Extensions;
\definition extend(g: PreviousMaps.Map): Hom.Carrier (previous z) := Extensions.compose g rprev;
\definition onRestriction: \forall (g: PreviousMaps.Map) -> Cohomology.prior (extend g) = cochain (Ext.precompose g) :=
  \fun (g: PreviousMaps.Map) => CurrentMaps.ext (Cohomology.prior (extend g)) (cochain (Ext.precompose g))
    (\fun (x: Carrier z) => trans!{A.Carrier} _ _ _ (Cohomology.priorOnElement (extend g) x)
      (congr!{PreviousHomology.Cycle A.Carrier} (g.apply) _ _
        (previousRetractCycle (PreviousHomology.cycle (chain.differential.apply z x) (chain.laws.squareZero z x)))));
\definition restrictionZero: \forall (g: PreviousMaps.Map) -> classMap.apply (Ext.precompose g) = Cohomology.cohomologySpace.zero :=
  \fun (g: PreviousMaps.Map) => Cohomology.boundaryClassZero (cocycle (Ext.precompose g))
    (Existential.existsIntro[Hom.Carrier (previous z), { h: Hom.Carrier (previous z) \where Cohomology.prior h = cocycle (Ext.precompose g) }] (extend g)
      (onRestriction g));
\import Modules.Of[V := BoundaryValues.Carrier, space := BoundaryValues.space].Submodule[] \as Submodules;
\import Submodules.Image[U := CycleValues.Carrier, source := CycleValues.space] \as Images;
\import Submodules.Quotient[S := Ext.extensions] \as Quotient;
\import Quotient.To[W := Cohomology.Cohomology, target := Cohomology.cohomologySpace] \as Descent;
\definition vanishes: Descent.Vanishes classMap := \block {
  \fun (f: BoundaryValues.Carrier)(member: _) \then
  \takefrom g: \Cast[CycleValues.Carrier] ({ g: CycleValues.Carrier \where Ext.precompose g = f }) \by member \then
  \return trans!{Cohomology.Cohomology} _ _ _
    (sym!{Cohomology.Cohomology} _ _ (congr!{BoundaryValues.Carrier Cohomology.Cohomology} (classMap.apply) _ _
      (\bysub(CycleValues.Carrier, { g: CycleValues.Carrier \where Ext.precompose g = f }, g))))
    (restrictionZero g)
};
\definition quotientMap: Modules.Hom[V := Quotient.Carrier, W := Cohomology.Cohomology, source := Quotient.moduleSpace, target := Cohomology.cohomologySpace].Map :=
  Descent.descend classMap vanishes;
\definition onClass: \forall (f: BoundaryValues.Carrier) -> quotientMap.apply (Quotient.class f) = Cohomology.classOf (cocycle f) := Descent.onClass classMap vanishes;
\definition restrict(g: Hom.Carrier (previous z)): PreviousMaps.Map := PreviousMaps.Map {
  apply := \fun (x: PreviousHomology.Cycle) => g.apply x,
  addition := \fun (x, y: PreviousHomology.Cycle) => g.addition x y,
  scalar := \fun (a: R)(x: PreviousHomology.Cycle) => g.scalar a x,
};
\definition restrictionOfCoboundary: \forall (f: BoundaryValues.Carrier)(g: Hom.Carrier (previous z)) ->
  Cohomology.prior g = cocycle f -> Ext.precompose (restrict g) = f := \block {
  \fun (f: BoundaryValues.Carrier)(g: Hom.Carrier (previous z))(equal: _) \then
  \return BoundaryMaps.ext (Ext.precompose (restrict g)) f (\block {
    \fun (b: Boundary.Carrier) \then
    \takefrom x: \Cast[Carrier z] ({ x: Carrier z \where Boundary.value x = b }) \by Boundary.onto b \then
    \let image: Boundary.value x = b := \bysub(Carrier z, { x: Carrier z \where Boundary.value x = b }, x) \then
    \return trans!{A.Carrier} _ _ _
      (sym!{A.Carrier} _ _ (congr!{Boundary.Carrier A.Carrier} (\fun (u: Boundary.Carrier) => (Ext.precompose (restrict g)).apply u) _ _ image))
      (trans!{A.Carrier} _ _ _ (sym!{A.Carrier} _ _ (Cohomology.priorOnElement g x))
        (trans!{A.Carrier} _ _ _
          (congr!{{Hom.Carrier z} A.Carrier} (\fun (h: Hom.Carrier z) => h.apply x) _ _ equal)
          (congr!{Boundary.Carrier A.Carrier} (f.apply) _ _ image)))
  })
};
\definition zeroClass: \forall (f: BoundaryValues.Carrier) -> Cohomology.classOf (cocycle f) = Cohomology.cohomologySpace.zero -> Quotient.class f = Quotient.moduleSpace.zero := \block {
  \fun (f: BoundaryValues.Carrier)(zero: _) \then
  \takefrom g: \Cast[Hom.Carrier (previous z)] ({ g: Hom.Carrier (previous z) \where Cohomology.prior g = cocycle f })
    \by Cohomology.boundaryExists (cocycle f) (Cohomology.zeroClassBoundary (cocycle f) zero) \then
  \return Quotient.classZero f (Images.introduce Ext.restriction f (restrict g)
    (restrictionOfCoboundary f g (\bysub(Hom.Carrier (previous z), { g: Hom.Carrier (previous z) \where Cohomology.prior g = cocycle f }, g))))
};
\definition quotientZeroKernel: \forall (q: Quotient.Carrier) -> quotientMap.apply q = Cohomology.cohomologySpace.zero -> q = Quotient.moduleSpace.zero :=
  Quotient.induction (\fun (q: Quotient.Carrier) => quotientMap.apply q = Cohomology.cohomologySpace.zero -> q = Quotient.moduleSpace.zero)
    (\fun (f: BoundaryValues.Carrier)(zero: _) => zeroClass f
      (trans!{Cohomology.Cohomology} _ _ _ (sym!{Cohomology.Cohomology} _ _ (onClass f)) zero));
\import Modules.Hom[V := Quotient.Carrier, W := Cohomology.Cohomology, source := Quotient.moduleSpace, target := Cohomology.cohomologySpace] \as QuotientMaps;
\definition quotientInjective: \forall (p, q: Quotient.Carrier) -> quotientMap.apply p = quotientMap.apply q -> p = q :=
  QuotientMaps.injectiveOfZeroKernel quotientMap quotientZeroKernel;
\definition evaluationZero: \forall (f: BoundaryValues.Carrier) -> Evaluation.map.apply (Cohomology.classOf (cocycle f)) = Evaluation.valueSpace.zero :=
  \fun (f: BoundaryValues.Carrier) => Values.ext (Evaluation.map.apply (Cohomology.classOf (cocycle f))) (Evaluation.valueSpace.zero)
    (Homology.classInduction (\fun (q: Homology.Homology) => (Evaluation.map.apply (Cohomology.classOf (cocycle f))).apply q = A.space.zero)
      (\fun (x: Homology.Cycle) => trans!{A.Carrier} _ _ _
        (congr!{Values.Map A.Carrier} (\fun (g: Values.Map) => g.apply (Homology.classOf x)) _ _ (Evaluation.onCohomologyClass (cocycle f)))
        (trans!{A.Carrier} _ _ _ (Evaluation.onClass (cocycle f) x)
          (trans!{A.Carrier} _ _ _ (congr!{Boundary.Carrier A.Carrier} (f.apply) _ _ (Boundary.onCycle x)) (BoundaryMaps.zeroPreserved f)))));
\definition quotientEvaluationZero: \forall (q: Quotient.Carrier) -> Evaluation.map.apply (quotientMap.apply q) = Evaluation.valueSpace.zero :=
  Quotient.induction (\fun (q: Quotient.Carrier) => Evaluation.map.apply (quotientMap.apply q) = Evaluation.valueSpace.zero)
    (\fun (f: BoundaryValues.Carrier) => trans!{Evaluation.ValueCarrier} _ _ _
      (congr!{Cohomology.Cohomology Evaluation.ValueCarrier} (Evaluation.map.apply) _ _ (onClass f)) (evaluationZero f));
\definition vanishesOnCycles: \forall (f: Cohomology.Closed) -> Evaluation.map.apply (Cohomology.classOf f) = Evaluation.valueSpace.zero ->
  \forall (x: Homology.Cycle) -> f.apply x = A.space.zero :=
  \fun (f: Cohomology.Closed)(zero: _)(x: Homology.Cycle) => trans!{A.Carrier} _ _ _
    (sym!{A.Carrier} _ _ (Evaluation.onClass f x))
    (congr!{Values.Map A.Carrier} (\fun (g: Values.Map) => g.apply (Homology.classOf x)) _ _
      (trans!{Values.Map} _ _ _ (sym!{Values.Map} _ _ (Evaluation.onCohomologyClass f)) zero));
\definition chainsBundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier z, space := space z };
\definition boundaryBundle: Modules.Bundle := Modules.Bundle { Carrier := Boundary.Carrier, space := Boundary.space };
\import Modules.SurjectiveDescent[A := chainsBundle, B := boundaryBundle, U := A] \as Factorization;
\module Factor(f: Cohomology.Closed) {
  \import Factorization.On[q := Boundary.map, f := f] \as Descent;
  \definition kills: (Evaluation.map.apply (Cohomology.classOf f) = Evaluation.valueSpace.zero) -> Descent.KillsKernel :=
    \fun (zero: _)(x: Carrier z)(closed: _) => vanishesOnCycles f zero (Homology.cycle x (Boundary.kernelCycle x closed));
  \definition map(zero: Evaluation.map.apply (Cohomology.classOf f) = Evaluation.valueSpace.zero): BoundaryMaps.Map := Descent.map Boundary.onto (kills zero);
  \definition agrees: \forall (zero: Evaluation.map.apply (Cohomology.classOf f) = Evaluation.valueSpace.zero) -> cochain (map zero) = f :=
    \fun (zero: _) => CurrentMaps.ext (cochain (map zero)) f (Descent.onImage Boundary.onto (kills zero));
  \definition preimage: \forall (zero: Evaluation.map.apply (Cohomology.classOf f) = Evaluation.valueSpace.zero) ->
    quotientMap.apply (Quotient.class (map zero)) = Cohomology.classOf f :=
    \fun (zero: _) => trans!{Cohomology.Cohomology} _ _ _ (onClass (map zero))
      (congr!{Cohomology.Closed Cohomology.Cohomology} Cohomology.classOf (cocycle (map zero)) f (agrees zero));
}
\definition quotientKernelImage: \forall (q: Cohomology.Cohomology) -> Evaluation.map.apply q = Evaluation.valueSpace.zero ->
  \exists { p: Quotient.Carrier \where quotientMap.apply p = q } :=
  Cohomology.classInduction (\fun (q: Cohomology.Cohomology) => Evaluation.map.apply q = Evaluation.valueSpace.zero ->
    \exists { p: Quotient.Carrier \where quotientMap.apply p = q })
    (\fun (f: Cohomology.Closed)(zero: _) => Existential.existsIntro[Quotient.Carrier, { p: Quotient.Carrier \where quotientMap.apply p = Cohomology.classOf f }] (Quotient.class (Factor[f := f].map zero))
      (Factor[f := f].preimage zero));
\definition extBundle: Modules.Bundle := Modules.Bundle { Carrier := Ext.Carrier, space := Ext.space };
\definition cohomologyBundle: Modules.Bundle := Modules.Bundle { Carrier := Cohomology.Cohomology, space := Cohomology.cohomologySpace };
\definition homBundle: Modules.Bundle := Modules.Bundle { Carrier := Evaluation.ValueCarrier, space := Evaluation.valueSpace };
\import QuotientMaps.Composition[U := Ext.Carrier, domain := Ext.space] \as Inclusion;
\definition inclusion: Modules.Hom[V := Ext.Carrier, W := Cohomology.Cohomology, source := Ext.space, target := Cohomology.cohomologySpace].Map :=
  Inclusion.compose quotientMap Ext.isomorphism.forward;
\definition injective: \forall (p, q: Ext.Carrier) -> inclusion.apply p = inclusion.apply q -> p = q :=
  \fun (p, q: Ext.Carrier)(equal: _) => trans!{Ext.Carrier} _ _ _
    (sym!{Ext.Carrier} _ _ (Ext.isomorphism.leftInverse p))
    (trans!{Ext.Carrier} _ _ _
      (congr!{Quotient.Carrier Ext.Carrier} (Ext.isomorphism.backward.apply) _ _
        (quotientInjective (Ext.isomorphism.forward.apply p) (Ext.isomorphism.forward.apply q) equal))
      (Ext.isomorphism.leftInverse q));
\definition kernelImage: \forall (q: Cohomology.Cohomology) -> Evaluation.map.apply q = Evaluation.valueSpace.zero ->
  \exists { p: Ext.Carrier \where inclusion.apply p = q } := \block {
  \fun (q: Cohomology.Cohomology)(zero: _) \then
  \takefrom p: \Cast[Quotient.Carrier] ({ p: Quotient.Carrier \where quotientMap.apply p = q }) \by quotientKernelImage q zero \then
  \return Existential.existsIntro[Ext.Carrier, { e: Ext.Carrier \where inclusion.apply e = q }] (Ext.isomorphism.backward.apply p)
    (trans!{Cohomology.Cohomology} _ _ _
        (congr!{Quotient.Carrier Cohomology.Cohomology} (quotientMap.apply) _ _ (Ext.isomorphism.rightInverse p))
        (\bysub(Quotient.Carrier, { p: Quotient.Carrier \where quotientMap.apply p = q }, p)))
};
\import Modules.ShortExact[A := extBundle, B := cohomologyBundle, C := homBundle] \as Sequences;
\definition data: Sequences.Data := Sequences.Data { inclusion := inclusion, projection := Evaluation.map };
\definition laws: Sequences.Laws[data] := Sequences.Laws[data] {
  injective := injective, onto := onto,
  zero := \fun (p: Ext.Carrier) => quotientEvaluationZero (Ext.isomorphism.forward.apply p),
  kernelImage := kernelImage,
};
\definition sequence: Sequences.Sequence := \into[Sequences.Data](data, { data: Sequences.Data \where Sequences.Laws[data] }) \by { laws };
\import Modules.Hom[V := Carrier z, W := A.Carrier, source := space z, target := A.space] \as ChainMaps;
\import Modules.Hom[V := Evaluation.ValueCarrier, W := Cohomology.Closed, source := Evaluation.valueSpace, target := Cohomology.cycleSpace] \as LiftCycles;
\definition liftCycles: LiftCycles.Map := LiftCycles.Map {
  apply := liftClosed,
  addition := \fun (f, g: Evaluation.ValueCarrier) => ChainMaps.ext (liftExtend (Evaluation.valueSpace.add f g)) ((Hom.space z).add (liftExtend f) (liftExtend g))
    (\fun (x: Carrier z) => \refl(A.space.add (f.apply (Homology.classOf (retraction.apply x))) (g.apply (Homology.classOf (retraction.apply x))))),
  scalar := \fun (a: R)(f: Evaluation.ValueCarrier) => ChainMaps.ext (liftExtend (Evaluation.valueSpace.smul a f)) ((Hom.space z).smul a (liftExtend f))
    (\fun (x: Carrier z) => \refl(A.space.smul a (f.apply (Homology.classOf (retraction.apply x))))),
};
\import Modules.Hom[V := Cohomology.Closed, W := Cohomology.Cohomology, source := Cohomology.cycleSpace, target := Cohomology.cohomologySpace].Composition[U := Evaluation.ValueCarrier, domain := Evaluation.valueSpace] \as LiftClasses;
\definition section: Modules.Hom[V := Evaluation.ValueCarrier, W := Cohomology.Cohomology, source := Evaluation.valueSpace, target := Cohomology.cohomologySpace].Map :=
  LiftClasses.compose Cohomology.classLinear liftCycles;
\import Sequences.Splitting[sequence := sequence].With[s := section] \as ChosenSplitting;
\import Modules.Biproduct[V := Ext.Carrier, W := Evaluation.ValueCarrier, left := Ext.space, right := Evaluation.valueSpace] \as Sum;
\definition splitting: Modules.Isomorphism[V := Sum.Carrier, W := Cohomology.Cohomology, source := Sum.space, target := Cohomology.cohomologySpace].Isomorphism :=
  ChosenSplitting.isomorphism rightInverse;
