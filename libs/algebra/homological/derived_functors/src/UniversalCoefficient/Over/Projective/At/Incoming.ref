\import Modules.Of[V := C.family.Carrier z, space := C.family.space z].Submodule[].Image[U := C.family.Carrier (next z), source := C.family.space (next z)] \as AmbientImages;
\import \parent.Presentation[] \as Presentation;
\definition ChainCarrier(k: Degree): \Set := C.family.Carrier k;
\definition chainSpace(k: Degree): Modules.Space (ChainCarrier k) := C.family.space k;
\definition Carrier: \Set := Presentation.boundaryBundle.Carrier;
\definition space: Modules.Space Carrier := Presentation.boundaryBundle.space;
\definition value(x: ChainCarrier (next z)): Carrier := \into[Homology.Cycle](
  Homology.cycle (Prior.value z x) (Prior.squareZero z x), #carrier{Homology.boundariesInside}) \by {
    AmbientImages.member Homology.prior x
  };
\import Modules.Hom[V := ChainCarrier (next z), W := Carrier, source := chainSpace (next z), target := space] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := value,
  addition := \fun (x, y: ChainCarrier (next z)) => Prior.addition z x y,
  scalar := \fun (a: R)(x: ChainCarrier (next z)) => Prior.scalar z a x,
};
\definition onto: \forall (b: Carrier) -> \exists { x: ChainCarrier (next z) \where value x = b } := \block {
  \fun (b: Carrier) \then
  \takefrom x: \Cast[ChainCarrier (next z)] ({ x: ChainCarrier (next z) \where #apply{Homology.prior} x = b })
    \by \bysub(Homology.Cycle, #carrier{Homology.boundariesInside}, b) \then
  \return Existential.existsIntro[ChainCarrier (next z), { x: ChainCarrier (next z) \where value x = b }] x
    (\bysub(ChainCarrier (next z), { x: ChainCarrier (next z) \where #apply{Homology.prior} x = b }, x))
};
