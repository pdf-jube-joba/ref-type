\import \parent.Selected[r := r, rprev := rprev].CohomologyKernel[] \as First;
\import \parent.Selected[r := s, rprev := sprev].CohomologyKernel[] \as Second;
\definition cohomologySequence: First.sequence = Second.sequence := \refl(First.sequence);
\import Modules.Biproduct[V := E.Carrier, W := Evaluation.ValueCarrier, left := E.space, right := Evaluation.valueSpace] \as CohomologySum;
\import Modules.Hom[V := Evaluation.CohomologyCarrier, W := CohomologySum.Carrier, source := Evaluation.cohomologySpace, target := CohomologySum.space].Composition[U := CohomologySum.Carrier, domain := CohomologySum.space] \as CohomologyComposition;
\definition cohomologyTransition: _ := CohomologyComposition.compose Second.splitting.backward First.splitting.forward;
\definition cohomologyCoordinates: \forall (x: CohomologySum.Carrier) ->
  Second.splitting.forward.apply (cohomologyTransition.apply x) = First.splitting.forward.apply x :=
  \fun (x: CohomologySum.Carrier) => Second.splitting.rightInverse (First.splitting.forward.apply x);
\import \parent.Selected[r := r, rprev := rprev].Tensor[].Projection[].Exactness[].Derived[] \as TensorFirst;
\import \parent.Selected[r := s, rprev := sprev].Tensor[].Projection[].Exactness[].Derived[] \as TensorSecond;
\definition tensorSequence: TensorFirst.sequence = TensorSecond.sequence := \refl(TensorFirst.sequence);
\import Modules.Biproduct[V := HomologyTensor.Carrier, W := T.Carrier, left := HomologyTensor.space, right := T.space] \as TensorSum;
\import Modules.Hom[V := TensorHomology.Homology, W := TensorSum.Carrier, source := TensorHomology.homologySpace, target := TensorSum.space].Composition[U := TensorSum.Carrier, domain := TensorSum.space] \as TensorComposition;
\definition tensorTransition: _ := TensorComposition.compose TensorSecond.isomorphism.backward TensorFirst.isomorphism.forward;
\definition tensorCoordinates: \forall (x: TensorSum.Carrier) ->
  TensorSecond.isomorphism.forward.apply (tensorTransition.apply x) = TensorFirst.isomorphism.forward.apply x :=
  \fun (x: TensorSum.Carrier) => TensorSecond.isomorphism.rightInverse (TensorFirst.isomorphism.forward.apply x);
