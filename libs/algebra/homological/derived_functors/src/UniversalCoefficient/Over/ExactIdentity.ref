\import Modules.ShortExact[A := L, B := M, C := N] \as Sequences;
\import Modules.End[V := L.Carrier, space := L.space] \as Left;
\import Modules.End[V := M.Carrier, space := M.space] \as Middle;
\import Modules.End[V := N.Carrier, space := N.space] \as Right;
\import \parent.ExactNaturality[L := L, M := M, N := N, L1 := L, M1 := M, N1 := N] \as Natural;
\module On(s: Sequences.Sequence) {
  \import Natural.Kernel[s := s, t := s, b := Middle.identity, c := Right.identity] \as Kernel;
  \definition right: Kernel.Commutes := \fun (x: M.Carrier) => \refl(#apply{s.projection} x);
  \definition kernel: Kernel.map right = Left.identity := sym!{Modules.Hom[V := L.Carrier, W := L.Carrier, source := L.space, target := L.space].Map} _ _
    (Kernel.unique right Left.identity (\fun (x: L.Carrier) => \refl(#apply{s.inclusion} x)));
  \import Natural.Cokernel[s := s, t := s, a := Left.identity, b := Middle.identity] \as Cokernel;
  \definition left: Cokernel.Commutes := \fun (x: L.Carrier) => \refl(#apply{s.inclusion} x);
  \definition cokernel: Cokernel.map left = Right.identity := sym!{Modules.Hom[V := N.Carrier, W := N.Carrier, source := N.space, target := N.space].Map} _ _
    (Cokernel.unique left Right.identity (\fun (x: M.Carrier) => \refl(#apply{s.projection} x)));
}
