\definition T: \VType := \U(Smith.SmithResult -> Runtime);
\definition program: T := \thunk (\cfun (result: Smith.SmithResult) => \match result \in Smith.SmithResult \with {
  | result rank a history frame: \match frame \in Smith.BasisChange \with { | frame u v ui vi: \return ui }
});
\definition matches: \forall (result: Smith.SmithResult^) -> program^ result = Diagonalize.leftInverse result :=
  \induction (result: Smith.SmithResult^) \return program^ result = Diagonalize.leftInverse result \with {
    | result: \fun (rank: N.Nat^)(a: Runtime^)(history: Smith.History^) => \induction (frame: Smith.BasisChange^) \return program^ (Smith.SmithResult^::result rank a history frame) = Diagonalize.leftInverse (Smith.SmithResult^::result rank a history frame) \with {
        | frame: \fun (u, v, ui, vi: Runtime^) => \refl(ui)
      }
  };
\definition coherence: program^ = Diagonalize.leftInverse := \axiom:funext(program^, Diagonalize.leftInverse, matches);
