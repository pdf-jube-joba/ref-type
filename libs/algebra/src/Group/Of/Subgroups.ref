\structure Closed[S: \Pow Carrier]: \Prop {
  zero: \In[Carrier] S zero,
  add: \forall (x, y: Carrier) -> \In[Carrier] S x -> \In[Carrier] S y -> \In[Carrier] S (add x y),
  neg: \forall (x: Carrier) -> \In[Carrier] S x -> \In[Carrier] S (neg x),
}
\definition zeroIn(S: \Pow Carrier) (closed: Closed[S]): \Cast[Carrier] S := \into[Carrier](zero, S) \by { #zero{closed} };
\definition addIn(S: \Pow Carrier) (closed: Closed[S]) (x, y: \Cast[Carrier] S): \Cast[Carrier] S :=
  \into[Carrier](add x y, S) \by { #add{closed} x y (\bysub(Carrier, S, x)) (\bysub(Carrier, S, y)) };
\definition negIn(S: \Pow Carrier) (closed: Closed[S]) (x: \Cast[Carrier] S): \Cast[Carrier] S :=
  \into[Carrier](neg x, S) \by { #neg{closed} x (\bysub(Carrier, S, x)) };
\definition subgroup(S: \Pow Carrier) (closed: Closed[S]): Alg.CommutativeGroup[\Cast[Carrier] S] :=
  Alg.CommutativeGroup[\Cast[Carrier] S] {
    base := Alg.GroupData[\Cast[Carrier] S]::# (zeroIn S closed) (addIn S closed) (negIn S closed),
    group := Alg.GroupLaws[\Cast[Carrier] S, (Alg.GroupData[\Cast[Carrier] S]::# (zeroIn S closed) (addIn S closed) (negIn S closed))] {
      monoid := Monoid.MonoidLaws[\Cast[Carrier] S, (Monoid.MonoidData[\Cast[Carrier] S]::# (zeroIn S closed) (addIn S closed))] {
        leftIdentity := \fun (x: \Cast[Carrier] S) => zeroLeft x,
        rightIdentity := \fun (x: \Cast[Carrier] S) => zeroRight x,
        associative := \fun (x, y, z: \Cast[Carrier] S) => assoc x y z,
      },
      leftInverse := \fun (x: \Cast[Carrier] S) => inverseLeft x,
      rightInverse := \fun (x: \Cast[Carrier] S) => inverseRight x,
    },
    commutative := \fun (x, y: \Cast[Carrier] S) => comm x y,
  };
