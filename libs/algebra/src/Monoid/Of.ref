\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::trans;
\use Equality::congr;
\use Equality::congr2;
\use Equality::eq_reason;

\definition zero: Carrier := #unit{(#base{monoid})};
\definition add: Carrier -> Carrier -> Carrier := #op{(#base{monoid})};
\definition zeroLeft: \forall (a: Carrier) -> add zero a = a := #leftIdentity{(#monoid{monoid})};
\definition zeroRight: \forall (a: Carrier) -> add a zero = a := #rightIdentity{(#monoid{monoid})};
\definition assoc: \forall (a, b, c: Carrier) -> add (add a b) c = add a (add b c) := #associative{(#monoid{monoid})};
\definition comm: \forall (a, b: Carrier) -> add a b = add b a := #commutative{monoid};

\definition swap(a, b, c: Carrier): add a (add b c) = add b (add a c) :=
  eq_reason!{{add a (add b c)}
    "=" {add (add a b) c} "by" {sym!{Carrier} _ _ (assoc a b c)}
    "=" {add (add b a) c} "by" {congr!{Carrier Carrier} (\fun (x: _) => add x c) _ _ (comm a b)}
    "=" {add b (add a c)} "by" {assoc b a c}};

\definition four(a, b, c, d: Carrier): add (add a b) (add c d) = add (add a c) (add b d) :=
  eq_reason!{{add (add a b) (add c d)}
    "=" {add a (add b (add c d))} "by" {assoc a b (add c d)}
    "=" {add a (add c (add b d))} "by" {congr!{Carrier Carrier} (add a) _ _ (swap b c d)}
    "=" {add (add a c) (add b d)} "by" {sym!{Carrier} _ _ (assoc a c (add b d))}};
