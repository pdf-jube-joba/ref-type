\definition vanishing: n = N.Nat^::zero -> \forall (i: Finite.Fin n) -> Logic.False :=
  \fun (zero: n = N.Nat^::zero)(i: Finite.Fin n) => Finite.zeroImpossible i
    (\idelim n = N.Nat^::zero \with m: N.Nat^ => std.Data[].Nat[].Basic[].Prop[].Lt i m
      \by { base: Finite.bound n i, equality: zero });
\definition splits: n = N.Nat^::zero -> Splits Maps.zeroMap :=
  \fun (zero: n = N.Nat^::zero)(x: Carrier) => \axiom:funext(#zero{Coordinates.space}, x,
    \fun (i: Finite.Fin n) => Logic.falseElim (#zero{ring} = x i) (vanishing zero i));
\definition existence: n = N.Nat^::zero -> \exists Retraction := \fun (zero: n = N.Nat^::zero) =>
  \exact(\into[Maps.Map](Maps.zeroMap, { r: Maps.Map \where Splits r }) \by { splits zero }, Retraction);
