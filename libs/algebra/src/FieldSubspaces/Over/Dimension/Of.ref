\import Submodules.Of[S := S] \as Included;
\definition Carrier: \Set := Included.Carrier;
\definition space: Modules.Space Carrier := Included.moduleSpace;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
\import Modules.Hom[V := Coordinates.Carrier, W := Carrier, source := Coordinates.space, target := space] \as Maps;
\definition Splits(r: Maps.Map): \Prop := \forall (x: Carrier) -> #apply{r} x = x;
\definition Retraction: \Set := \Cast[Maps.Map] ({ r: Maps.Map \where Splits r });
\definition Map: \Set := Maps.Map;
\definition inclusion: Modules.Hom[V := Carrier, W := Coordinates.Carrier, source := space, target := Coordinates.space].Map := Included.inclusion;
\module Zero;
\definition zeroExistence: n = N.Nat^::zero -> \exists Retraction := Zero[].existence;
\module Selected(r: Retraction) {
  \definition ambient: Modules.Bundle := Modules.Bundle { Carrier := Coordinates.Carrier, space := Coordinates.space };
  \import Modules.ProjectiveLaws[].Retract[P := bundle, Q := ambient, inclusion := inclusion, retraction := r] \as Retract;
  \definition projective: Modules.Projective bundle := Retract.projective
    (\bysub(Map, { r: Map \where Splits r }, r)) Coordinates.Free[].projective;
}
