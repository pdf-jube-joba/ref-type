\import Modules.Hom[V := TailSpace.Carrier, W := Included.Carrier, source := TailSpace.space, target := Included.space].Composition[U := Small.Carrier, domain := Small.space] \as ComposeSmall;
\definition smallMap: Modules.Hom[V := Small.Carrier, W := Included.Carrier, source := Small.space, target := Included.space].Map := ComposeSmall.compose embedding r;
\import Modules.Hom[V := Small.Carrier, W := Included.Carrier, source := Small.space, target := Included.space].Composition[U := Large.Carrier, domain := Large.space] \as ComposeLarge;
\definition map: Included.Map := ComposeLarge.compose smallMap Split.restriction;
\definition retracts: headZero -> Included.Splits map := \fun (zero: headZero)(x: Included.Carrier) =>
  trans!{Included.Carrier} _ _ _
    (congr!{TailSpace.Carrier Included.Carrier} (#apply{embedding}) (#apply{r} (tail x (zero x))) (tail x (zero x)) (splits (tail x (zero x))))
    (recoverZero x (zero x));
\definition retraction(zero: headZero): Included.Retraction := \into[Included.Map](map, { r: Included.Map \where Included.Splits r }) \by { retracts zero };
