\import Submodules.Of[S := S] \as Inside;
\definition Carrier: \Set := Inside.Carrier;
\definition moduleSpace: Modules.Space Carrier := Inside.moduleSpace;
\import Modules.Hom[V := Vector, W := Carrier, source := space, target := moduleSpace] \as Maps;
\definition Map: \Set := Maps.Map;
\definition Onto(f: Map): \Prop := \forall (y: Carrier) -> \exists { x: Vector \where #apply{f} x = y };
\definition Generated: \Prop := \exists { f: Map \where Onto f };
\definition Generator: \Set := \Cast[Map] ({ f: Map \where Onto f });

\structure BasisData: \Set {
  rank: N.Nat^,
  isomorphism: Modules.Isomorphism[
    V := Modules.FiniteCoordinates[n := rank].Carrier, W := Carrier,
    source := Modules.FiniteCoordinates[n := rank].space, target := moduleSpace
  ].Isomorphism,
}
\module Basis(f: Generator);
\definition basisExistence: Generated -> \exists BasisData := \block {
  \fun (generated: Generated) \then
  \takefrom f: Generator \by generated \then
  \return \exact(Basis[f := f].data, BasisData)
};
