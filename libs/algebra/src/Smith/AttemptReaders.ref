\definition matrixProgram: \U(Attempt -> Runtime) := \thunk (\cfun (current: Attempt) => \match current \in Attempt \with {
  | attempt a history changed: \return a
});
\definition matrixMatches: \forall (current: Attempt^) -> matrixProgram^ current = attemptMatrix current :=
  \induction (current: Attempt^) \return matrixProgram^ current = attemptMatrix current \with {
    | attempt: \fun (a: Runtime^)(history: History^)(changed: B.Bool^) => \refl(a)
  };
\correspondence ReadMatrix: Programs.Correspondence := Programs.Correspondence {
  T := \U(Attempt -> Runtime), program := matrixProgram, specification := attemptMatrix,
  coherence := \axiom:funext(matrixProgram^, attemptMatrix, matrixMatches),
};
\definition historyProgram: \U(Attempt -> History) := \thunk (\cfun (current: Attempt) => \match current \in Attempt \with {
  | attempt a history changed: \return history
});
\definition historyMatches: \forall (current: Attempt^) -> historyProgram^ current = attemptHistory current :=
  \induction (current: Attempt^) \return historyProgram^ current = attemptHistory current \with {
    | attempt: \fun (a: Runtime^)(history: History^)(changed: B.Bool^) => \refl(history)
  };
\correspondence ReadHistory: Programs.Correspondence := Programs.Correspondence {
  T := \U(Attempt -> History), program := historyProgram, specification := attemptHistory,
  coherence := \axiom:funext(historyProgram^, attemptHistory, historyMatches),
};
\definition changedProgram: \U(Attempt -> B.Bool) := \thunk (\cfun (current: Attempt) => \match current \in Attempt \with {
  | attempt a history changed: \return changed
});
\definition changedMatches: \forall (current: Attempt^) -> changedProgram^ current = attemptReduced current :=
  \induction (current: Attempt^) \return changedProgram^ current = attemptReduced current \with {
    | attempt: \fun (a: Runtime^)(history: History^)(changed: B.Bool^) => \refl(changed)
  };
\correspondence ReadChanged: Programs.Correspondence := Programs.Correspondence {
  T := \U(Attempt -> B.Bool), program := changedProgram, specification := attemptReduced,
  coherence := \axiom:funext(changedProgram^, attemptReduced, changedMatches),
};
