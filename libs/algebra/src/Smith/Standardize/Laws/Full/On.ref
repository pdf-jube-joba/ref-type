\import \parent.\parent.\parent.\parent.Properties[m := m, n := n, rank := rank] \as Properties;
\import \parent.\parent.\parent.\parent.Prefix[m := m, n := n].End[k := rank, a := a] \as Prefix;
\definition normalized: Attempt^ := Normalize.fold rank a history;
\definition law: Diagonalization.OutputLaw[rank, a, history] -> FullCertificate[normalizeOutput (Compute.Output^::result rank a history)] :=
  \fun (law: Diagonalization.OutputLaw[rank, a, history]) =>
    assembly rank normalized
      (normalization (Compute.Output^::result rank a history) #computation{law})
      (Properties.normalizedDiagonal rank a history (Prefix.diagonal #prefix{law} #trailing{law}))
      (Properties.normalizedTrailing rank a history #trailing{law})
      (Properties.normalizedNonzero rank a history (Prefix.nonzero #prefix{law}))
      (Properties.normalizedDivides rank a history (Prefix.divides #prefix{law}));
