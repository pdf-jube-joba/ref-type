\definition T: \VType := \U(N.Nat -> N.Nat -> N.Nat -> Runtime -> History -> Attempt);
\definition program: T := \thunk (\cfun (rows: N.Nat) => \return(\thunk (\cfun (cols: N.Nat) => \return(\thunk (\cfun (k: N.Nat) => \return(\thunk (\cfun (a: Runtime) => \return(\thunk (\cfun (history: History) => \program {
  \bind clearCols: \U(N.Nat -> N.Nat -> Runtime -> History -> Attempt) <- (\force Clearing.Clear.program) rows \then
  \bind clearK: \U(N.Nat -> Runtime -> History -> Attempt) <- (\force clearCols) cols \then
  \bind clearA: \U(Runtime -> History -> Attempt) <- (\force clearK) k \then
  \bind clearH: \U(History -> Attempt) <- (\force clearA) a \then
  \bind current: Attempt <- (\force clearH) history \then
  \bind changed: B.Bool <- (\force changedProgram) current \then
  \bind matrix: Runtime <- (\force matrixProgram) current \then
  \bind seekCols: \U(N.Nat -> N.Nat -> Runtime -> Grid.Position) <- (\force Offender.Seek.program) rows \then
  \bind seekK: \U(N.Nat -> Runtime -> Grid.Position) <- (\force seekCols) cols \then
  \bind seekA: \U(Runtime -> Grid.Position) <- (\force seekK) k \then
  \bind offender: Grid.Position <- (\force seekA) matrix \then
  \bind resolveA: \U(Attempt -> Grid.Position -> Attempt) <- (\force Resolve.program) k \then
  \bind resolveP: \U(Grid.Position -> Attempt) <- (\force resolveA) current \then
  \bind resolved: Attempt <- (\force resolveP) offender \then
  \bind yes: \U(Attempt -> Attempt -> Attempt) <- (\force chooseProgram) changed \then
  \bind no: \U(Attempt -> Attempt) <- (\force yes) current \then
  \bind result: Attempt <- (\force no) resolved \then
  \return result
})))))))));
\definition withOperations(clear: Clearing.Clear.T^)(seek: Offender.Seek.T^)(resolve: Resolve.T^)(flag: Readers.ReadChanged.T^)(matrix: Readers.ReadMatrix.T^)(choose: Choice.T^)(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ :=
  choose (flag (clear rows cols k a history)) (clear rows cols k a history) (resolve k (clear rows cols k a history) (seek rows cols k (matrix (clear rows cols k a history))));
\definition stage1(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (Clearing.clear) (Offender.Seek.program^) (Resolve.program^) (changedProgram^) (matrixProgram^) (chooseProgram^) rows cols k a history;
\definition stage2(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (Clearing.clear) (Offender.seek) (Resolve.program^) (changedProgram^) (matrixProgram^) (chooseProgram^) rows cols k a history;
\definition stage3(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (Clearing.clear) (Offender.seek) (resolve) (changedProgram^) (matrixProgram^) (chooseProgram^) rows cols k a history;
\definition stage4(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (Clearing.clear) (Offender.seek) (resolve) (attemptReduced) (matrixProgram^) (chooseProgram^) rows cols k a history;
\definition stage5(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (Clearing.clear) (Offender.seek) (resolve) (attemptReduced) (attemptMatrix) (chooseProgram^) rows cols k a history;
\definition matches: \forall (rows, cols, k: N.Nat^)(a: Runtime^)(history: History^) -> program^ rows cols k a history = round rows cols k a history :=
  \fun (rows, cols, k: N.Nat^)(a: Runtime^)(history: History^) => trans!{Attempt^} (program^ rows cols k a history) (stage1 rows cols k a history) (round rows cols k a history)
    (congr!{Clearing.Clear.T^ Attempt^} (\fun (f: Clearing.Clear.T^) => withOperations (f) (Offender.Seek.program^) (Resolve.program^) (changedProgram^) (matrixProgram^) (chooseProgram^) rows cols k a history) Clearing.Clear.program^ (Clearing.clear) Clearing.Clear.coherence)
    (trans!{Attempt^} (stage1 rows cols k a history) (stage2 rows cols k a history) (round rows cols k a history)
    (congr!{Offender.Seek.T^ Attempt^} (\fun (f: Offender.Seek.T^) => withOperations (Clearing.clear) (f) (Resolve.program^) (changedProgram^) (matrixProgram^) (chooseProgram^) rows cols k a history) Offender.Seek.program^ (Offender.seek) Offender.Seek.coherence)
    (trans!{Attempt^} (stage2 rows cols k a history) (stage3 rows cols k a history) (round rows cols k a history)
    (congr!{Resolve.T^ Attempt^} (\fun (f: Resolve.T^) => withOperations (Clearing.clear) (Offender.seek) (f) (changedProgram^) (matrixProgram^) (chooseProgram^) rows cols k a history) Resolve.program^ (resolve) Resolve.coherence)
    (trans!{Attempt^} (stage3 rows cols k a history) (stage4 rows cols k a history) (round rows cols k a history)
    (congr!{Readers.ReadChanged.T^ Attempt^} (\fun (f: Readers.ReadChanged.T^) => withOperations (Clearing.clear) (Offender.seek) (resolve) (f) (matrixProgram^) (chooseProgram^) rows cols k a history) changedProgram^ (attemptReduced) Readers.ReadChanged.coherence)
    (trans!{Attempt^} (stage4 rows cols k a history) (stage5 rows cols k a history) (round rows cols k a history)
    (congr!{Readers.ReadMatrix.T^ Attempt^} (\fun (f: Readers.ReadMatrix.T^) => withOperations (Clearing.clear) (Offender.seek) (resolve) (attemptReduced) (f) (chooseProgram^) rows cols k a history) matrixProgram^ (attemptMatrix) Readers.ReadMatrix.coherence)
    ((congr!{Choice.T^ Attempt^} (\fun (f: Choice.T^) => withOperations (Clearing.clear) (Offender.seek) (resolve) (attemptReduced) (attemptMatrix) (f) rows cols k a history) chooseProgram^ (B.ite Attempt^) Choice.coherence))))));
\definition coherence: program^ = round := \axiom:funext(program^, round,
  \fun (rows: N.Nat^) => \axiom:funext(program^ rows, round rows,
    \fun (cols: N.Nat^) => \axiom:funext(program^ rows cols, round rows cols,
      \fun (k: N.Nat^) => \axiom:funext(program^ rows cols k, round rows cols k,
        \fun (a: Runtime^) => \axiom:funext(program^ rows cols k a, round rows cols k a, \fun (history: History^) => matches rows cols k a history)))));
