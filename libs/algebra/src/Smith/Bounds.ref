\import N.Basic[].Prop[] \as NaturalBounds;
\import std.Logic[].Proposition[] \as Logic;
\structure PairBounds[limit, r, s: N.Nat^]: \Prop { first: NaturalBounds.Lt r limit, second: NaturalBounds.Lt s limit }
\structure ShearBounds[limit, r, s: N.Nat^]: \Prop { first: NaturalBounds.Lt r limit, second: NaturalBounds.Lt s limit, distinct: Logic.Not (r = s) }
\definition OperationLaws(rows, cols: N.Nat^): Operation^ -> \Prop := \induction (operation: Operation^) \return \Prop \with {
  | identity: Logic.True
  | rowSwap: \fun (r, s: N.Nat^) => PairBounds[rows, r, s]
  | rowAdd: \fun (r, s: N.Nat^)(c: I.Int^) => ShearBounds[rows, r, s]
  | rowNegate: \fun (r: N.Nat^) => NaturalBounds.Lt r rows
  | columnSwap: \fun (r, s: N.Nat^) => PairBounds[cols, r, s]
  | columnAdd: \fun (r, s: N.Nat^)(c: I.Int^) => ShearBounds[cols, r, s]
  | columnNegate: \fun (r: N.Nat^) => NaturalBounds.Lt r cols
};

\structure HistoryStep[rows, cols: N.Nat^, operation: Operation^, older: \Prop]: \Prop { operation: OperationLaws rows cols operation, older: older }
\definition HistoryLaws(rows, cols: N.Nat^): History^ -> \Prop := \induction (history: History^) \return \Prop \with {
  | empty: Logic.True
  | prepend: \fun (operation: Operation^)(history: History^)(previous: \Prop) => HistoryStep[rows, cols, operation, previous]
};
\definition prepend: \forall (rows, cols: N.Nat^)(operation: Operation^)(history: History^) -> OperationLaws rows cols operation -> HistoryLaws rows cols history -> HistoryLaws rows cols (History^::prepend operation history) :=
  \fun (rows, cols: N.Nat^)(operation: Operation^)(history: History^)(operationLaws: _)(historyLaws: _) => HistoryStep[rows, cols, operation, HistoryLaws rows cols history] { operation := operationLaws, older := historyLaws };
