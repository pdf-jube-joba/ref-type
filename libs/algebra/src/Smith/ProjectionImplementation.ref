\definition left: Mapper := \thunk (\cfun (operation: Operation) => \match operation \in Operation \with {
  | identity: \return(Operation::identity)
  | rowSwap r s: \return(Operation::rowSwap r s)
  | rowAdd r s c: \return(Operation::rowAdd r s c)
  | rowNegate r: \return(Operation::rowNegate r)
  | columnSwap r s: \return(Operation::identity)
  | columnAdd r s c: \return(Operation::identity)
  | columnNegate r: \return(Operation::identity)
});
\definition leftMatches: \forall (operation: Operation^) -> left^ operation = leftProjection operation :=
  \induction (operation: Operation^) \return left^ operation = leftProjection operation \with {
    | identity: \refl(Operation^::identity)
    | rowSwap: \fun (r: N.Nat^)(s: N.Nat^) => \refl(Operation^::rowSwap r s)
    | rowAdd: \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^) => \refl(Operation^::rowAdd r s c)
    | rowNegate: \fun (r: N.Nat^) => \refl(Operation^::rowNegate r)
    | columnSwap: \fun (r: N.Nat^)(s: N.Nat^) => \refl(Operation^::identity)
    | columnAdd: \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^) => \refl(Operation^::identity)
    | columnNegate: \fun (r: N.Nat^) => \refl(Operation^::identity)
  };
\definition leftCoherence: left^ = leftProjection := \axiom:funext(left^, leftProjection, leftMatches);
\definition right: Mapper := \thunk (\cfun (operation: Operation) => \match operation \in Operation \with {
  | identity: \return(Operation::identity)
  | rowSwap r s: \return(Operation::identity)
  | rowAdd r s c: \return(Operation::identity)
  | rowNegate r: \return(Operation::identity)
  | columnSwap r s: \return(Operation::columnSwap r s)
  | columnAdd r s c: \return(Operation::columnAdd r s c)
  | columnNegate r: \return(Operation::columnNegate r)
});
\definition rightMatches: \forall (operation: Operation^) -> right^ operation = rightProjection operation :=
  \induction (operation: Operation^) \return right^ operation = rightProjection operation \with {
    | identity: \refl(Operation^::identity)
    | rowSwap: \fun (r: N.Nat^)(s: N.Nat^) => \refl(Operation^::identity)
    | rowAdd: \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^) => \refl(Operation^::identity)
    | rowNegate: \fun (r: N.Nat^) => \refl(Operation^::identity)
    | columnSwap: \fun (r: N.Nat^)(s: N.Nat^) => \refl(Operation^::columnSwap r s)
    | columnAdd: \fun (r: N.Nat^)(s: N.Nat^)(c: I.Int^) => \refl(Operation^::columnAdd r s c)
    | columnNegate: \fun (r: N.Nat^) => \refl(Operation^::columnNegate r)
  };
\definition rightCoherence: right^ = rightProjection := \axiom:funext(right^, rightProjection, rightMatches);
