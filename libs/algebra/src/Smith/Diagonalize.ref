\import \parent.Compute[] \as Compute;
\import \parent.Standardize[] \as Standardize;
\import \parent.FrameExecution[] \as NativeFrames;
\definition assemble(rows, cols: N.Nat^): Compute.Output^ -> SmithResult^ :=
  \induction (output: Compute.Output^) \return SmithResult^ \with {
    | result: \fun (rank: N.Nat^)(a: Runtime^)(history: History^) => SmithResult^::result rank a history (NativeFrames.build rows cols history)
  };
\definition buildProgram: NativeFrames.Build.T := NativeFrames.Build.program;
\module AssemblyImplementation;
\correspondence Assembly: Programs.Correspondence := Programs.Correspondence {
  T := AssemblyImplementation[].T, program := AssemblyImplementation[].program, specification := assemble, coherence := AssemblyImplementation[].coherence,
};
\definition result(rows, cols: N.Nat^)(a: Runtime^): SmithResult^ := assemble rows cols (Standardize.standardize rows cols a);
\definition standardizeProgram: Standardize.Standardize.T := Standardize.Standardize.program;
\definition assemblyProgram: Assembly.T := Assembly.program;
\module Implementation;
\correspondence Diagonalize: Programs.Correspondence := Programs.Correspondence {
  T := Implementation[].T, program := Implementation[].program, specification := result, coherence := Implementation[].coherence,
};
\definition diagonal: SmithResult^ -> Runtime^ := \induction (result: SmithResult^) \return Runtime^ \with {
  | result: \fun (rank: N.Nat^)(a: Runtime^)(history: History^)(frame: BasisChange^) => a
};
\definition rank: SmithResult^ -> N.Nat^ := \induction (result: SmithResult^) \return N.Nat^ \with {
  | result: \fun (rank: N.Nat^)(a: Runtime^)(history: History^)(frame: BasisChange^) => rank
};
\definition history: SmithResult^ -> History^ := \induction (result: SmithResult^) \return History^ \with {
  | result: \fun (rank: N.Nat^)(a: Runtime^)(history: History^)(frame: BasisChange^) => history
};
\definition frame: SmithResult^ -> BasisChange^ := \induction (result: SmithResult^) \return BasisChange^ \with {
  | result: \fun (rank: N.Nat^)(a: Runtime^)(history: History^)(frame: BasisChange^) => frame
};
\definition left(result: SmithResult^): Runtime^ := NativeFrames.left (frame result);
\definition right(result: SmithResult^): Runtime^ := NativeFrames.right (frame result);
\definition leftInverse(result: SmithResult^): Runtime^ := NativeFrames.leftInverse (frame result);
\definition rightInverse(result: SmithResult^): Runtime^ := NativeFrames.rightInverse (frame result);
\module Specification(m, n: N.Nat^, original: Runtime^);
