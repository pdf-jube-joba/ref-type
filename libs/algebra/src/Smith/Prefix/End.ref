\import \parent.\parent.Properties[m := m, n := n, rank := k] \as Properties;
\definition earlyRow: Holds k a -> \forall (i, j: N.Nat^) -> Bounds.Lt i k -> Bounds.Lt j n -> Logic.Not (i = j) -> a i j = Arithmetic.zero := \block {
  \fun (prefix: Holds k a)(i, j: N.Nat^)(before: _)(bound: _)(different: _) \then
  \takefrom d: Witness i a \by prefix i before \then
  \let stage: Stage[i, d, a] := \bysub(I.Int^, { d: I.Int^ \where Stage[i, d, a] }, d) \then
  \return #row{(#cleared{stage})} j bound (\fun (equal: j = i) => different (sym!{N.Nat^} j i equal))
};
\definition earlyColumn: Holds k a -> \forall (i, j: N.Nat^) -> Bounds.Lt j k -> Bounds.Lt i m -> Logic.Not (i = j) -> a i j = Arithmetic.zero := \block {
  \fun (prefix: Holds k a)(i, j: N.Nat^)(before: _)(bound: _)(different: _) \then
  \takefrom d: Witness j a \by prefix j before \then
  \let stage: Stage[j, d, a] := \bysub(I.Int^, { d: I.Int^ \where Stage[j, d, a] }, d) \then
  \return #column{(#cleared{stage})} i bound different
};
\definition diagonal: Holds k a -> Properties.TrailingZero a -> Properties.Diagonal a :=
  \fun (prefix: Holds k a)(trailing: Properties.TrailingZero a)(i, j: N.Nat^)(rowBound: _)(columnBound: _)(different: _) => B.cases2
    (\fun (first, second: B.Bool^) => Nat.ltb i k = first -> Nat.ltb j k = second -> a i j = Arithmetic.zero)
    (\fun (first: _)(second: _) => trailing i j rowBound columnBound (Bounds.leOfLtbFalse i k first) (Bounds.leOfLtbFalse j k second))
    (\fun (first: _)(second: _) => earlyColumn prefix i j second rowBound different)
    (\fun (first: _)(second: _) => earlyRow prefix i j first columnBound different)
    (\fun (first: _)(second: _) => earlyRow prefix i j first columnBound different) (Nat.ltb i k) (Nat.ltb j k) (\refl(Nat.ltb i k)) (\refl(Nat.ltb j k));
\definition nonzero: Holds k a -> Properties.Nonzero a := \block {
  \fun (prefix: Holds k a)(i: N.Nat^)(before: _) \then
  \takefrom d: Witness i a \by prefix i before \then
  \let stage: Stage[i, d, a] := \bysub(I.Int^, { d: I.Int^ \where Stage[i, d, a] }, d) \then
  \return \fun (zero: _) => #nonzero{stage}
    (trans!{I.Int^} d (a i i) Arithmetic.zero (sym!{I.Int^} (a i i) d #diagonal{stage}) zero)
};
\definition divides: Holds k a -> Properties.Divides a := \block {
  \fun (prefix: Holds k a)(i, j: N.Nat^)(before: _)(rowBound: _)(columnBound: _)(later: _) \then
  \takefrom d: Witness i a \by prefix i before \then
  \let stage: Stage[i, d, a] := \bysub(I.Int^, { d: I.Int^ \where Stage[i, d, a] }, d) \then
  \return \idelim d = a i i \with divisor: I.Int^ => Signed.Divides divisor (a j j) \by {
    base: #divides{stage} j j rowBound columnBound later later,
    equality: sym!{I.Int^} (a i i) d #diagonal{stage}
  }
};
