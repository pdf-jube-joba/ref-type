\definition T: \VType := \U(Mapper -> Handler);
\definition program: T := \thunk (\cfun (mapper: Mapper) => \return(\thunk (\cfun (operation: Operation) => \program {
  \bind mapped: Operation <- (\force mapper) operation \then
  \bind transformer: Transformer <- (\force Apply.program) mapped \then
  \return transformer
})));
\definition matches: \forall (mapper: Mapper^)(operation: Operation^) -> program^ mapper operation = applyMapped mapper operation :=
  \fun (mapper: Mapper^)(operation: Operation^) => congr!{Apply.T^ Transformer^} (\fun (f: Apply.T^) => f (mapper operation)) Apply.program^ Apply.specification Apply.coherence;
\definition coherence: program^ = applyMapped := \axiom:funext(program^, applyMapped,
  \fun (mapper: Mapper^) => \axiom:funext(program^ mapper, applyMapped mapper, matches mapper));
