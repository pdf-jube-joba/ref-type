\definition T: \VType := \U(N.Nat -> N.Nat -> N.Nat -> Runtime -> History -> Attempt);
\import \parent.\parent.RowImplementation[] \as Row;
\import \parent.\parent.ColumnImplementation[] \as Column;
\definition program: T := \thunk (\cfun (rows: N.Nat) => \return(\thunk (\cfun (cols: N.Nat) => \return(\thunk (\cfun (k: N.Nat) => \return(\thunk (\cfun (a: Runtime) => \return(\thunk (\cfun (history: History) => \program {
  \bind rowK: \U(N.Nat -> Runtime -> History -> Attempt) <- (\force Row.program) rows \then
  \bind rowA: \U(Runtime -> History -> Attempt) <- (\force rowK) k \then
  \bind rowH: \U(History -> Attempt) <- (\force rowA) a \then
  \bind rowResult: Attempt <- (\force rowH) history \then
  \bind rowMatrix: Runtime <- (\force matrixProgram) rowResult \then
  \bind rowHistory: History <- (\force historyProgram) rowResult \then
  \bind changed: B.Bool <- (\force changedProgram) rowResult \then
  \bind columnK: \U(N.Nat -> Runtime -> History -> Attempt) <- (\force Column.program) cols \then
  \bind columnA: \U(Runtime -> History -> Attempt) <- (\force columnK) k \then
  \bind columnH: \U(History -> Attempt) <- (\force columnA) rowMatrix \then
  \bind columnResult: Attempt <- (\force columnH) rowHistory \then
  \bind yes: \U(Attempt -> Attempt -> Attempt) <- (\force chooseProgram) changed \then
  \bind no: \U(Attempt -> Attempt) <- (\force yes) rowResult \then
  \bind result: Attempt <- (\force no) columnResult \then
  \return result
})))))))));
\definition withOperations(rf: Row.T^)(cf: Column.T^)(mf: Readers.ReadMatrix.T^)(hf: Readers.ReadHistory.T^)(bf: Readers.ReadChanged.T^)(choose: Choice.T^)(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ :=
  choose (bf (rf rows k a history)) (rf rows k a history) (cf cols k (mf (rf rows k a history)) (hf (rf rows k a history)));
\definition stage1(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (row) (Column.program^) (matrixProgram^) (historyProgram^) (changedProgram^) (chooseProgram^) rows cols k a history;
\definition stage2(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (row) (column) (matrixProgram^) (historyProgram^) (changedProgram^) (chooseProgram^) rows cols k a history;
\definition stage3(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (row) (column) (attemptMatrix) (historyProgram^) (changedProgram^) (chooseProgram^) rows cols k a history;
\definition stage4(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (row) (column) (attemptMatrix) (attemptHistory) (changedProgram^) (chooseProgram^) rows cols k a history;
\definition stage5(rows, cols, k: N.Nat^)(a: Runtime^)(history: History^): Attempt^ := withOperations (row) (column) (attemptMatrix) (attemptHistory) (attemptReduced) (chooseProgram^) rows cols k a history;
\definition matches: \forall (rows, cols, k: N.Nat^)(a: Runtime^)(history: History^) -> program^ rows cols k a history = clear rows cols k a history :=
  \fun (rows, cols, k: N.Nat^)(a: Runtime^)(history: History^) => trans!{Attempt^} (program^ rows cols k a history) (stage1 rows cols k a history) (clear rows cols k a history)
    (congr!{Row.T^ Attempt^} (\fun (f: Row.T^) => withOperations (f) (Column.program^) (matrixProgram^) (historyProgram^) (changedProgram^) (chooseProgram^) rows cols k a history) Row.program^ (row) Row.coherence)
    (trans!{Attempt^} (stage1 rows cols k a history) (stage2 rows cols k a history) (clear rows cols k a history)
    (congr!{Column.T^ Attempt^} (\fun (f: Column.T^) => withOperations (row) (f) (matrixProgram^) (historyProgram^) (changedProgram^) (chooseProgram^) rows cols k a history) Column.program^ (column) Column.coherence)
    (trans!{Attempt^} (stage2 rows cols k a history) (stage3 rows cols k a history) (clear rows cols k a history)
    (congr!{Readers.ReadMatrix.T^ Attempt^} (\fun (f: Readers.ReadMatrix.T^) => withOperations (row) (column) (f) (historyProgram^) (changedProgram^) (chooseProgram^) rows cols k a history) matrixProgram^ (attemptMatrix) Readers.ReadMatrix.coherence)
    (trans!{Attempt^} (stage3 rows cols k a history) (stage4 rows cols k a history) (clear rows cols k a history)
    (congr!{Readers.ReadHistory.T^ Attempt^} (\fun (f: Readers.ReadHistory.T^) => withOperations (row) (column) (attemptMatrix) (f) (changedProgram^) (chooseProgram^) rows cols k a history) historyProgram^ (attemptHistory) Readers.ReadHistory.coherence)
    (trans!{Attempt^} (stage4 rows cols k a history) (stage5 rows cols k a history) (clear rows cols k a history)
    (congr!{Readers.ReadChanged.T^ Attempt^} (\fun (f: Readers.ReadChanged.T^) => withOperations (row) (column) (attemptMatrix) (attemptHistory) (f) (chooseProgram^) rows cols k a history) changedProgram^ (attemptReduced) Readers.ReadChanged.coherence)
    ((congr!{Choice.T^ Attempt^} (\fun (f: Choice.T^) => withOperations (row) (column) (attemptMatrix) (attemptHistory) (attemptReduced) (f) rows cols k a history) chooseProgram^ (B.ite Attempt^) Choice.coherence))))));
\definition coherence: program^ = clear := \axiom:funext(program^, clear,
  \fun (rows: N.Nat^) => \axiom:funext(program^ rows, clear rows,
    \fun (cols: N.Nat^) => \axiom:funext(program^ rows cols, clear rows cols,
      \fun (k: N.Nat^) => \axiom:funext(program^ rows cols k, clear rows cols k,
        \fun (a: Runtime^) => \axiom:funext(program^ rows cols k a, clear rows cols k a,
          \fun (history: History^) => matches rows cols k a history)))));
