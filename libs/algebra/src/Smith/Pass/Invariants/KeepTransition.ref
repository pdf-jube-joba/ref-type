\definition candidate: Attempt^ := reduce k i (attemptMatrix current) (attemptHistory current);
\definition law: PreserveStep reduce value k -> Keeps value a current -> Keeps value a (next reduce k i current) :=
  \fun (step: _)(previous: _) => B.cases
    (\fun (test: B.Bool^) => eligible k i current = test -> Keeps value a (B.ite Attempt^ test candidate current))
    (\fun (equal: eligible k i current = B.Bool^::false) => previous)
    (\fun (equal: eligible k i current = B.Bool^::true)(noSwap: _) => trans!{I.Int^} (value (attemptMatrix candidate)) (value (attemptMatrix current)) (value a)
      (step i (attemptMatrix current) (attemptHistory current) (eligibleLess k i current equal) noSwap)
      (previous (eligibleUnchanged k i current equal)))
    (eligible k i current) (\refl(eligible k i current));
