\import std.Data[].Bool[] \as B;
\import N.Basic[].Def[] \as Nat;
\definition transposition(r, s, i: N.Nat^): N.Nat^ := B.ite N.Nat^ (Nat.eqb i r) s (B.ite N.Nat^ (Nat.eqb i s) r i);
\definition swap(a: Runtime^)(r, s: N.Nat^): Runtime^ := \fun (i, j: N.Nat^) => a (transposition r s i) j;
\definition add(a: Runtime^)(r, s: N.Nat^)(c: I.Int^): Runtime^ := \fun (i, j: N.Nat^) =>
  B.ite I.Int^ (Nat.eqb i r) (Arithmetic.add (a i j) (Arithmetic.mul c (a s j))) (a i j);
\definition negate(a: Runtime^)(r: N.Nat^): Runtime^ := \fun (i, j: N.Nat^) => B.ite I.Int^ (Nat.eqb i r) (Arithmetic.neg (a i j)) (a i j);
\module SwapImplementation;
\correspondence Swap: Programs.Correspondence := Programs.Correspondence {
  T := SwapImplementation[].T, program := SwapImplementation[].program,
  specification := swap, coherence := SwapImplementation[].coherence,
};
\module AddImplementation;
\correspondence Add: Programs.Correspondence := Programs.Correspondence {
  T := AddImplementation[].T, program := AddImplementation[].program,
  specification := add, coherence := AddImplementation[].coherence,
};
\module NegateImplementation;
\correspondence Negate: Programs.Correspondence := Programs.Correspondence {
  T := NegateImplementation[].T, program := NegateImplementation[].program,
  specification := negate, coherence := NegateImplementation[].coherence,
};

\module Typed(r, s: Finite.Fin m);
\module Laws;
