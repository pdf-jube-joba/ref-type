\import N.Basic[].Program[] \as NatPrograms;
\import N.Basic[].ProgramProp[] \as NatCorrespondence;
\import B.Choose[A := I.Int] \as Choice;
\definition T: \VType := \U(Runtime -> N.Nat -> N.Nat -> I.Int -> Runtime);
\definition program: T := \thunk (\cfun (a: Runtime) => \return(\thunk (\cfun (r: N.Nat) => \return(\thunk (\cfun (s: N.Nat) =>
  \return(\thunk (\cfun (c: I.Int) => \return(\thunk (\cfun (i: N.Nat) => \return(\thunk (\cfun (j: N.Nat) => \program {
    \bind compare: \U(N.Nat -> B.Bool) <- (\force NatPrograms.eqb) i \then
    \bind hit: B.Bool <- (\force compare) r \then
    \bind row: \U(N.Nat -> I.Int) <- (\force a) i \then
    \bind old: I.Int <- (\force row) j \then
    \bind otherRow: \U(N.Nat -> I.Int) <- (\force a) s \then
    \bind other: I.Int <- (\force otherRow) j \then
    \bind multiply: \U(I.Int -> I.Int) <- (\force I.Mul.program) c \then
    \bind scaled: I.Int <- (\force multiply) other \then
    \bind plus: \U(I.Int -> I.Int) <- (\force I.Add.program) old \then
    \bind updated: I.Int <- (\force plus) scaled \then
    \bind chooseYes: \U(I.Int -> I.Int -> I.Int) <- (\force Choice.program) hit \then
    \bind chooseNo: \U(I.Int -> I.Int) <- (\force chooseYes) updated \then
    \bind answer: I.Int <- (\force chooseNo) old \then
    \return answer
  })))))))))));
\definition multiplied(a: Runtime^)(r, s: N.Nat^)(c: I.Int^)(i, j: N.Nat^): I.Int^ :=
  B.ite I.Int^ (NatPrograms.eqb^ i r) (I.Add.program^ (a i j) (Arithmetic.mul c (a s j))) (a i j);
\definition added(a: Runtime^)(r, s: N.Nat^)(c: I.Int^)(i, j: N.Nat^): I.Int^ :=
  B.ite I.Int^ (NatPrograms.eqb^ i r) (Arithmetic.add (a i j) (Arithmetic.mul c (a s j))) (a i j);
\definition chosen(a: Runtime^)(r, s: N.Nat^)(c: I.Int^)(i, j: N.Nat^): I.Int^ := B.ite I.Int^ (NatPrograms.eqb^ i r) (I.Add.program^ (a i j) (I.Mul.program^ c (a s j))) (a i j);
\definition matches: \forall (a: Runtime^)(r, s: N.Nat^)(c: I.Int^)(i, j: N.Nat^) -> program^ a r s c i j = add a r s c i j :=
  \fun (a: Runtime^)(r, s: N.Nat^)(c: I.Int^)(i, j: N.Nat^) => trans!{I.Int^} (program^ a r s c i j) (chosen a r s c i j) (add a r s c i j)
    (Choice.matches (NatPrograms.eqb^ i r) (I.Add.program^ (a i j) (I.Mul.program^ c (a s j))) (a i j))
    (trans!{I.Int^} (chosen a r s c i j) (multiplied a r s c i j) (add a r s c i j)
    (congr!{I.Mul.T^ I.Int^} (\fun (f: I.Mul.T^) => B.ite I.Int^ (NatPrograms.eqb^ i r) (I.Add.program^ (a i j) (f c (a s j))) (a i j)) I.Mul.program^ I.Mul.specification I.Mul.coherence)
    (trans!{I.Int^} (multiplied a r s c i j) (added a r s c i j) (add a r s c i j)
      (congr!{I.Add.T^ I.Int^} (\fun (f: I.Add.T^) => B.ite I.Int^ (NatPrograms.eqb^ i r) (f (a i j) (Arithmetic.mul c (a s j))) (a i j)) I.Add.program^ I.Add.specification I.Add.coherence)
      (congr!{NatCorrespondence.Eqb.T^ I.Int^} (\fun (f: NatCorrespondence.Eqb.T^) => B.ite I.Int^ (f i r) (Arithmetic.add (a i j) (Arithmetic.mul c (a s j))) (a i j)) NatCorrespondence.Eqb.program^ NatCorrespondence.Eqb.specification NatCorrespondence.Eqb.coherence)));
\definition coherence: program^ = add := \axiom:funext(program^, add,
  \fun (a: Runtime^) => \axiom:funext(program^ a, add a,
    \fun (r: N.Nat^) => \axiom:funext(program^ a r, add a r,
      \fun (s: N.Nat^) => \axiom:funext(program^ a r s, add a r s,
        \fun (c: I.Int^) => \axiom:funext(program^ a r s c, add a r s c,
          \fun (i: N.Nat^) => \axiom:funext(program^ a r s c i, add a r s c i, \fun (j: N.Nat^) => matches a r s c i j))))));
