\import algebra.Module[].Commutative[R := I.Int^, ring := IntegerRing.commutativeRing].Matrix[m := n, n := k] \as Before;
\import algebra.Module[].Commutative[R := I.Int^, ring := IntegerRing.commutativeRing].Matrix[m := m, n := k] \as Result;
\import Base.Composition[k := k] \as Composition;
\import std.Arithmetic[].IntegerSum[] \as Numeric;
\definition product(a: Matrix)(b: Before.Matrix): Result.Matrix := Composition.product a b;
\definition mathematical(count: N.Nat^)(a, b: Runtime^): Runtime^ := \fun (i, j: N.Nat^) =>
  Numeric.sum count (\fun (l: N.Nat^) => Arithmetic.mul (a i l) (b l j));
\module Implementation;
\correspondence Multiply: Programs.Correspondence := Programs.Correspondence {
  T := Implementation[].T, program := Implementation[].program,
  specification := mathematical, coherence := Implementation[].coherence,
};
\definition reflected(a, b: Runtime^): Result.Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin k) => Multiply.program^ n a b i j;
\definition correspondence: \forall (a, b: Runtime^) -> reflected a b = product (reflect a) (\fun (i: Finite.Fin n)(j: Finite.Fin k) => b i j) :=
  \fun (a, b: Runtime^) => \axiom:funext(reflected a b, product (reflect a) (\fun (i: Finite.Fin n)(j: Finite.Fin k) => b i j),
    \fun (i: Finite.Fin m) => \axiom:funext(reflected a b i, product (reflect a) (\fun (i: Finite.Fin n)(j: Finite.Fin k) => b i j) i,
      \fun (j: Finite.Fin k) => trans!{I.Int^} (Multiply.program^ n a b i j) (Numeric.sum n (\fun (l: N.Nat^) => Arithmetic.mul (a i l) (b l j))) (\parent.FiniteSum[].sum n (\fun (l: N.Nat^) => Arithmetic.mul (a i l) (b l j)))
        (congr!{Multiply.T^ I.Int^} (\fun (f: Multiply.T^) => f n a b i j) Multiply.program^ Multiply.specification Multiply.coherence)
        (sym!{I.Int^} (\parent.FiniteSum[].sum n (\fun (l: N.Nat^) => Arithmetic.mul (a i l) (b l j))) (Numeric.sum n (\fun (l: N.Nat^) => Arithmetic.mul (a i l) (b l j))) (\parent.FiniteSum[].law n (\fun (l: N.Nat^) => Arithmetic.mul (a i l) (b l j))))));
