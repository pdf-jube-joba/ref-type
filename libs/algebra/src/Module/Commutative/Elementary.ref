\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Finite;
\import Modules.FiniteCoordinates[n := n] \as Coordinates;
\definition Index: \Set := Finite.Fin n;
\definition Vector: \Set := Coordinates.Carrier;
\definition space: Modules.Space Vector := Coordinates.space;
\import Modules.Hom[V := Vector, W := Vector, source := space, target := space] \as Maps;
\import Modules.Isomorphism[V := Vector, W := Vector, source := space, target := space] \as Iso;
\import Modules.End[V := Vector, space := space] \as End;
\import Modules.Laws[V := Vector, space := space] \as Values;
\import algebra.Group[].Of[Carrier := Vector, group := Values.additive] \as Group;
\import algebra.Group[].Of[Carrier := R, group := Modules.scalarGroup] \as Scalars;
\import \parent.Matrix[m := n, n := n] \as Square;
\import Square.Invertible[] \as Invertible;
\import Modules.Coordinates[I := Index].Kronecker[] \as Kronecker;
\module Swap(i, j: Index);
\module Shear(i, j: Index);
\module Negate(i: Index);
