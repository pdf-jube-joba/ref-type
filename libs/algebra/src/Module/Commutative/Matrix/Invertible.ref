\import \parent.\parent.Matrix[m := n, n := m] \as Backward;
\import \parent.Composition[k := m] \as ForwardComposition;
\import Backward.Composition[k := n] \as BackwardComposition;
\import \parent.End[] \as Identity;
\structure Data: \Set { inverse: Backward.Matrix }
\structure Laws[a: Matrix, data: Data]: \Prop {
  leftInverse: BackwardComposition.product data.inverse a = Identity.identity,
  rightInverse: ForwardComposition.product a data.inverse = Identity.targetIdentity,
}
\definition Inverse(a: Matrix): \Set := \Cast[Data] ({ data: Data \where Laws[a, data] });
\import Modules.Isomorphism[V := Domain.Carrier, W := Codomain.Carrier, source := Domain.space, target := Codomain.space] \as Iso;
\import Modules.Hom[V := Domain.Carrier, W := Domain.Carrier, source := Domain.space, target := Domain.space] \as DomainMaps;
\import Modules.Hom[V := Codomain.Carrier, W := Codomain.Carrier, source := Codomain.space, target := Codomain.space] \as CodomainMaps;
\import \parent.\parent.Matrix[m := n, n := n] \as DomainSquare;
\import \parent.\parent.Matrix[m := m, n := m] \as CodomainSquare;
\module On(a: Matrix, inverse: Inverse a);
\definition isomorphism(a: Matrix)(inverse: Inverse a): Iso.Isomorphism := On[a := a, inverse := inverse].isomorphism;
\definition existence: \forall (a: Matrix) -> (\exists Inverse a) -> \exists Iso.Isomorphism := \block {
  \fun (a: Matrix)(exists: \exists Inverse a) \then
  \takefrom inverse: Inverse a \by exists \then
  \return \exact(isomorphism a inverse, Iso.Isomorphism)
};
\module FromIsomorphism(e: Iso.Isomorphism);
\definition fromIsomorphism(e: Iso.Isomorphism): Inverse (entries #forward{e}) := FromIsomorphism[e := e].inverse;

\definition transport(a, b: Matrix)(equal: a = b)(certificate: Inverse a): Inverse b :=
  \into[Data](certificate, { data: Data \where Laws[b, data] }) \by { Laws[b, certificate] {
    leftInverse := trans!{DomainSquare.Matrix} (BackwardComposition.product #inverse{certificate} b)
      (BackwardComposition.product #inverse{certificate} a) Identity.identity
      (congr!{Matrix DomainSquare.Matrix} (BackwardComposition.product #inverse{certificate}) b a (sym!{Matrix} a b equal))
      #leftInverse{(\bysub(Data, { data: Data \where Laws[a, data] }, certificate))},
    rightInverse := trans!{CodomainSquare.Matrix} (ForwardComposition.product b #inverse{certificate})
      (ForwardComposition.product a #inverse{certificate}) Identity.targetIdentity
      (congr!{Matrix CodomainSquare.Matrix} (\fun (c: Matrix) => ForwardComposition.product c #inverse{certificate}) b a (sym!{Matrix} a b equal))
      #rightInverse{(\bysub(Data, { data: Data \where Laws[a, data] }, certificate))},
  } };
\module Composition(k: N.Nat^);

\module Transpose(a: Matrix, certificate: Inverse a);
\definition transpose(a: Matrix)(certificate: Inverse a): \parent.\parent.Matrix[m := n, n := m].Invertible[].Inverse (\parent.Transpose[].transpose a) :=
  Transpose[a := a, certificate := certificate].inverse;
