\definition inverseLaws: Laws[a, inverse] := \bysub(Data, { data: Data \where Laws[a, data] }, inverse);
\definition left: \forall (v: Domain.Carrier) -> Backward.apply #inverse{inverse} (apply a v) = v :=
  \fun (v: Domain.Carrier) => eq_reason!{{Backward.apply #inverse{inverse} (apply a v)}
    "=" {DomainSquare.apply (BackwardComposition.product #inverse{inverse} a) v} "by" {
      sym!{Domain.Carrier} _ _ (congr!{DomainMaps.Map Domain.Carrier} (\fun (f: DomainMaps.Map) => #apply{f} v)
        _ _ (BackwardComposition.law #inverse{inverse} a))}
    "=" {DomainSquare.apply Identity.identity v} "by" {
      congr!{DomainSquare.Matrix Domain.Carrier} (\fun (b: DomainSquare.Matrix) => DomainSquare.apply b v) _ _ #leftInverse{inverseLaws}}
    "=" {v} "by" {congr!{DomainMaps.Map Domain.Carrier} (\fun (f: DomainMaps.Map) => #apply{f} v) _ _ Identity.identityLaw}};
\definition right: \forall (v: Codomain.Carrier) -> apply a (Backward.apply #inverse{inverse} v) = v :=
  \fun (v: Codomain.Carrier) => eq_reason!{{apply a (Backward.apply #inverse{inverse} v)}
    "=" {CodomainSquare.apply (ForwardComposition.product a #inverse{inverse}) v} "by" {
      sym!{Codomain.Carrier} _ _ (congr!{CodomainMaps.Map Codomain.Carrier} (\fun (f: CodomainMaps.Map) => #apply{f} v)
        _ _ (ForwardComposition.law a #inverse{inverse}))}
    "=" {CodomainSquare.apply Identity.targetIdentity v} "by" {
      congr!{CodomainSquare.Matrix Codomain.Carrier} (\fun (b: CodomainSquare.Matrix) => CodomainSquare.apply b v) _ _ #rightInverse{inverseLaws}}
    "=" {v} "by" {congr!{CodomainMaps.Map Codomain.Carrier} (\fun (f: CodomainMaps.Map) => #apply{f} v) _ _ Identity.targetIdentityLaw}};
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := linear a, backward := Backward.linear #inverse{inverse},
  leftInverse := left, rightInverse := right,
};
