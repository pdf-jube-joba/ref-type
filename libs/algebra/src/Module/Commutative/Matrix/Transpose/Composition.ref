\import \parent.\parent.Composition[k := k] \as Original;
\import \parent.\parent.\parent.Matrix[m := n, n := k] \as Before;
\import Before.Transpose[] \as BeforeTranspose;
\import \parent.\parent.\parent.Matrix[m := k, n := n].Composition[k := m] \as ReversedComposition;
\import \parent.\parent.\parent.Matrix[m := m, n := k].Transpose[] \as ResultTranspose;
\definition product: \forall (a: Matrix)(b: Before.Matrix) -> ResultTranspose.transpose (Original.product a b) = ReversedComposition.product (BeforeTranspose.transpose b) (transpose a) :=
  \fun (a: Matrix)(b: Before.Matrix) => \axiom:funext(ResultTranspose.transpose (Original.product a b), ReversedComposition.product (BeforeTranspose.transpose b) (transpose a),
    \fun (i: Finite.Fin k) => \axiom:funext(ResultTranspose.transpose (Original.product a b) i, ReversedComposition.product (BeforeTranspose.transpose b) (transpose a) i,
      \fun (j: Finite.Fin m) => SumLaws.congruent (Finite.elements n)
        (\fun (s: Finite.Fin n) => #mul{ordinaryRing} (a j s) (b s i))
        (\fun (s: Finite.Fin n) => #mul{ordinaryRing} (b s i) (a j s))
        (\fun (s: Finite.Fin n) => #mulCommutative{ring} (a j s) (b s i))));
