\import Modules.CanonicalFree[M := P] \as Canonical;
\import Modules.Free[Generators := P.Carrier] \as Free;
\import Modules.End[V := P.Carrier, space := P.space] \as End;
\import Modules.Tensor[V := P.Carrier, W := A.Carrier, left := P.space, right := A.space] \as Source;
\import Modules.Tensor[V := P.Carrier, W := B.Carrier, left := P.space, right := B.space] \as Target;
\import Source.Mapping[U := P.Carrier, Z := B.Carrier, targetLeft := P.space, targetRight := B.space] \as Coefficients;
