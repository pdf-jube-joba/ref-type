\import Finite.Transposition[n := n, a := i, b := j] \as Permutation;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (v: Vector)(k: Index) => v (Permutation.apply k),
  addition := \fun (v, w: Vector) => \axiom:funext((\fun (k: Index) => #add{ordinaryRing} (v (Permutation.apply k)) (w (Permutation.apply k))),
    (\fun (k: Index) => #add{ordinaryRing} (v (Permutation.apply k)) (w (Permutation.apply k))), \fun (k: Index) => \refl(#add{ordinaryRing} (v (Permutation.apply k)) (w (Permutation.apply k)))),
  scalar := \fun (a: R)(v: Vector) => \axiom:funext((\fun (k: Index) => #mul{ordinaryRing} a (v (Permutation.apply k))),
    (\fun (k: Index) => #mul{ordinaryRing} a (v (Permutation.apply k))), \fun (k: Index) => \refl(#mul{ordinaryRing} a (v (Permutation.apply k)))),
};
\definition inverse: \forall (v: Vector) -> #apply{map} (#apply{map} v) = v :=
  \fun (v: Vector) => \axiom:funext(#apply{map} (#apply{map} v), v,
    \fun (k: Index) => congr!{Index R} v _ _ (Permutation.involution k));
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := map, backward := map, leftInverse := inverse, rightInverse := inverse,
};
\definition matrix: Square.Matrix := Square.entries map;
\definition certificate: Invertible.Inverse matrix := Invertible.fromIsomorphism isomorphism;
