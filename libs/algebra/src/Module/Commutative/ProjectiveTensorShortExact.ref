\import Modules.ShortExact[A := A, B := B, C := C] \as Given;
\import Modules.RightExact[A := A, B := B, C := C] \as RightExact;
\import Modules.TensorRightExact[A := A, B := B, C := C, N := P] \as Reverse;
\import Modules.End[V := P.Carrier, space := P.space] \as Identity;
\import Modules.Tensor[V := P.Carrier, W := A.Carrier, left := P.space, right := A.space] \as Left;
\definition leftBundle: Modules.Bundle := Modules.Bundle { Carrier := Left.Carrier, space := Left.space };
\import Modules.Tensor[V := A.Carrier, W := P.Carrier, left := A.space, right := P.space] \as ReverseLeft;
\definition reverseLeftBundle: Modules.Bundle := Modules.Bundle { Carrier := ReverseLeft.Carrier, space := ReverseLeft.space };
\import ReverseLeft.Symmetry[] \as LeftSwap;
\import Modules.Tensor[V := P.Carrier, W := B.Carrier, left := P.space, right := B.space] \as Middle;
\definition middleBundle: Modules.Bundle := Modules.Bundle { Carrier := Middle.Carrier, space := Middle.space };
\import Modules.Tensor[V := B.Carrier, W := P.Carrier, left := B.space, right := P.space] \as ReverseMiddle;
\definition reverseMiddleBundle: Modules.Bundle := Modules.Bundle { Carrier := ReverseMiddle.Carrier, space := ReverseMiddle.space };
\import ReverseMiddle.Symmetry[] \as MiddleSwap;
\import Modules.Tensor[V := P.Carrier, W := C.Carrier, left := P.space, right := C.space] \as Right;
\definition rightBundle: Modules.Bundle := Modules.Bundle { Carrier := Right.Carrier, space := Right.space };
\import Modules.Tensor[V := C.Carrier, W := P.Carrier, left := C.space, right := P.space] \as ReverseRight;
\definition reverseRightBundle: Modules.Bundle := Modules.Bundle { Carrier := ReverseRight.Carrier, space := ReverseRight.space };
\import ReverseRight.Symmetry[] \as RightSwap;
\import Modules.ShortExact[A := leftBundle, B := middleBundle, C := rightBundle] \as Result;
\import Modules.ExactPair[A := reverseLeftBundle, B := reverseMiddleBundle, C := reverseRightBundle] \as OriginalPair;
\import Left.Mapping[U := P.Carrier, Z := B.Carrier, targetLeft := P.space, targetRight := B.space] \as Inclusion;
\import Middle.Mapping[U := P.Carrier, Z := C.Carrier, targetLeft := P.space, targetRight := C.space] \as Projection;
\import LeftSwap.Mapping[U := B.Carrier, Z := P.Carrier, targetLeft := B.space, targetRight := P.space] \as InclusionSwap;
\import MiddleSwap.Mapping[U := C.Carrier, Z := P.Carrier, targetLeft := C.space, targetRight := P.space] \as ProjectionSwap;
\module On(sequence: Given.Sequence);
