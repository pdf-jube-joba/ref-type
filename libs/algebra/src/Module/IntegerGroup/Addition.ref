\definition sum: CompletedMaps.MonoidMap Completion.asMonoid target :=
  \into[Completion.Carrier -> Carrier](\fun (c: Completion.Carrier) => Group.add (extension x c) (extension y c),
    CompletedMaps.MonoidMap Completion.asMonoid target) \by {
      CompletedMaps.MonoidLaws[Completion.asMonoid, target, \fun (c: Completion.Carrier) => Group.add (extension x c) (extension y c)] {
        unit := trans!{Carrier} _ _ _
          (congr2!{Carrier Carrier Carrier} Group.add _ _ _ _
            (#unit{(CompletedMaps.monoidLaws Completion.asMonoid target (extension x))})
            (#unit{(CompletedMaps.monoidLaws Completion.asMonoid target (extension y))})) (Group.zeroLeft Group.zero),
        operation := \fun (a, b: Completion.Carrier) => trans!{Carrier} _ _ _
          (congr2!{Carrier Carrier Carrier} Group.add _ _ _ _
            (#operation{(CompletedMaps.monoidLaws Completion.asMonoid target (extension x))} a b)
            (#operation{(CompletedMaps.monoidLaws Completion.asMonoid target (extension y))} a b))
          (Group.four (extension x a) (extension x b) (extension y a) (extension y b)),
      }
    };
\definition same: extension (Group.add x y) = sum := Universal.ext (extension (Group.add x y)) sum
  (\fun (n: N.Nat^) => trans!{Carrier} _ _ _ (Universal.extendIncludes (naturalMap (Group.add x y)) n)
    (trans!{Carrier} _ _ _ (repeatVectorAdd n x y)
      (sym!{Carrier} _ _ (congr2!{Carrier Carrier Carrier} Group.add _ _ _ _
        (Universal.extendIncludes (naturalMap x) n) (Universal.extendIncludes (naturalMap y) n)))));
\definition law: \forall (a: I.Int^) -> action a (Group.add x y) = Group.add (action a x) (action a y) :=
  \fun (a: I.Int^) => congr!{{Completion.Carrier -> Carrier} Carrier} (\fun (f: Completion.Carrier -> Carrier) => f (Natural.fromInt a)) _ _ same;
