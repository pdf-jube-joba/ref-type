\import \parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as Inclusion;
\import \parent.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as Projection;
\structure Data: \Set {
  inclusion: Inclusion.Map,
  projection: Projection.Map,
}
\structure Laws[data: Data]: \Prop {
  onto: \forall (z: C.Carrier) -> \exists { y: B.Carrier \where #apply{data.projection} y = z },
  zero: \forall (x: A.Carrier) -> #apply{data.projection} (#apply{data.inclusion} x) = #zero{C.space},
  kernelImage: \forall (y: B.Carrier) -> #apply{data.projection} y = #zero{C.space} ->
    \exists { x: A.Carrier \where #apply{data.inclusion} x = y },
}
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\import \parent.ShortExact[A := A, B := B, C := C] \as Short;
\definition ofShort(sequence: Short.Sequence): Sequence := Sequence {
  inclusion := sequence.inclusion, projection := sequence.projection,
  onto := #onto{sequence}, zero := #zero{sequence}, kernelImage := #kernelImage{sequence},
};
\module Cokernel(sequence: Sequence);
