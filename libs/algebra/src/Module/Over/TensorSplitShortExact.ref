\import \parent.ShortExact[A := A, B := B, C := C] \as Short;
\import \parent.RightExact[A := A, B := B, C := C] \as RightExact;
\import \parent.TensorRightExact[A := A, B := B, C := C, N := N] \as RightTensor;
\import \parent.Hom[V := B.Carrier, W := A.Carrier, source := B.space, target := A.space] \as Retractions;
\import \parent.Tensor[V := A.Carrier, W := N.Carrier, left := A.space, right := N.space] \as Left;
\import \parent.Tensor[V := B.Carrier, W := N.Carrier, left := B.space, right := N.space] \as Middle;
\import \parent.Tensor[V := C.Carrier, W := N.Carrier, left := C.space, right := N.space] \as Right;
\definition leftBundle: Bundle := Bundle { Carrier := Left.Carrier, space := Left.space };
\definition middleBundle: Bundle := Bundle { Carrier := Middle.Carrier, space := Middle.space };
\definition rightBundle: Bundle := Bundle { Carrier := Right.Carrier, space := Right.space };
\import \parent.ShortExact[A := leftBundle, B := middleBundle, C := rightBundle] \as Result;
\import \parent.End[V := N.Carrier, space := N.space] \as Coefficients;
\module On(sequence: Short.Sequence, r: Retractions.Map);
