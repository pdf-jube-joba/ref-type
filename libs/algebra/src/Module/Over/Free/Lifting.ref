\import \parent.\parent.Hom[V := Carrier, W := B.Carrier, source := space, target := B.space] \as Target;
\import \parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Composition[U := Carrier, domain := space] \as Composition;
\definition existence: Surjective A B q ->
  \exists { g: MapBetween bundle A \where \forall (x: Carrier) -> #apply{q} (#apply{g} x) = #apply{f} x } := \block {
  \fun (onto: Surjective A B q) \then
  \let Fiber: Generators -> \Set := \fun (s: Generators) => \Cast[A.Carrier] ({ x: A.Carrier \where #apply{q} x = #apply{f} (generator s) }) \then
  \let inhabited: \forall (s: Generators) -> \exists Fiber s := \fun (s: Generators) => onto (#apply{f} (generator s)) \then
  \let sections: \Prop := \exists (\forall (s: Generators) -> Fiber s) \then
  \let choices: sections := \axiom:classicalIndefiniteChoice(Generators, Fiber, inhabited) \then
  \takefrom selected: \forall (s: Generators) -> Fiber s \by choices \then
  \let values: Generators -> A.Carrier := \fun (s: Generators) => selected s \then
  \let lift: MapBetween bundle A := \parent.To[W := A.Carrier, target := A.space].extension values \then
  \let composite: Target.Map := Composition.compose q lift \then
  \let generatorLaw: \forall (s: Generators) -> #apply{composite} (generator s) = #apply{f} (generator s) :=
    \fun (s: Generators) => trans!{B.Carrier} _ _ _
      (congr!{A.Carrier B.Carrier} (#apply{q}) _ _ (\parent.To[W := A.Carrier, target := A.space].onGenerator values s))
      (\bysub(A.Carrier, { x: A.Carrier \where #apply{q} x = #apply{f} (generator s) }, selected s)) \then
  \let extended: Generators -> B.Carrier := \fun (s: Generators) => #apply{f} (generator s) \then
  \let equal: #apply{composite} = #apply{f} := trans!{{Carrier -> B.Carrier}} _ _ _
    (\parent.To[W := B.Carrier, target := B.space].unique extended composite generatorLaw)
    (sym!{{Carrier -> B.Carrier}} _ _ (\parent.To[W := B.Carrier, target := B.space].unique extended f (\fun (s: Generators) => \refl(#apply{f} (generator s))))) \then
  \return \exact(\into[MapBetween bundle A](lift, { g: MapBetween bundle A \where \forall (x: Carrier) -> #apply{q} (#apply{g} x) = #apply{f} x }) \by {
    \fun (x: Carrier) => congr!{{Carrier -> B.Carrier} B.Carrier} (\fun (h: Carrier -> B.Carrier) => h x) _ _ equal
  }, \Cast[MapBetween bundle A] ({ g: MapBetween bundle A \where \forall (x: Carrier) -> #apply{q} (#apply{g} x) = #apply{f} x }))
};
