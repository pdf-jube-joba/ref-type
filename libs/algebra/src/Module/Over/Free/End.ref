\import \parent.Reindex[TargetGenerators := Generators] \as Reindex;
\import \parent.\parent.End[V := Carrier, space := space] \as Identity;
\import \parent.To[W := Carrier, target := space] \as Universal;
\definition identity: #apply{(Reindex.push (\fun (s: Generators) => s))} = #apply{Identity.identity} :=
  trans!{{Carrier -> Carrier}} _ _ _
    (Universal.unique generator (Reindex.push (\fun (s: Generators) => s)) (Reindex.onGenerator (\fun (s: Generators) => s)))
    (sym!{{Carrier -> Carrier}} _ _ (Universal.unique generator Identity.identity (\fun (s: Generators) => \refl(generator s))));
