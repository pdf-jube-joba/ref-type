\import \parent.\parent.\parent.Free[Generators := FinalGenerators] \as Final;
\import Destination.Reindex[TargetGenerators := FinalGenerators] \as Second;
\import \parent.\parent.Reindex[TargetGenerators := FinalGenerators] \as Direct;
\import \parent.\parent.\parent.Hom[V := Destination.Carrier, W := Final.Carrier, source := Destination.space, target := Final.space] \as SecondMaps;
\import SecondMaps.Composition[U := Carrier, domain := space] \as Compose;
\import \parent.\parent.To[W := Final.Carrier, target := Final.space] \as Universal;
\definition composition: \forall (f: Generators -> TargetGenerators)(g: TargetGenerators -> FinalGenerators) ->
  #apply{(Compose.compose (Second.push g) (push f))} = #apply{(Direct.push (\fun (s: Generators) => g (f s)))} :=
  \fun (f: Generators -> TargetGenerators)(g: TargetGenerators -> FinalGenerators) =>
    Universal.unique (\fun (s: Generators) => Final.generator (g (f s)))
      (Compose.compose (Second.push g) (push f))
      (\fun (s: Generators) => trans!{Final.Carrier} _ _ _
        (congr!{Destination.Carrier Final.Carrier} (#apply{(Second.push g)}) _ _ (onGenerator f s)) (Second.onGenerator g (f s)));
