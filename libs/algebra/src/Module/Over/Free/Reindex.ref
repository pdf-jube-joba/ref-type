\import \parent.\parent.Free[Generators := TargetGenerators] \as Destination;
\import \parent.To[W := Destination.Carrier, target := Destination.space] \as Extend;
\import \parent.\parent.Hom[V := Carrier, W := Destination.Carrier, source := space, target := Destination.space] \as Maps;
\definition push(f: Generators -> TargetGenerators): Maps.Map := Extend.extension (\fun (s: Generators) => Destination.generator (f s));
\definition onGenerator: \forall (f: Generators -> TargetGenerators)(s: Generators) ->
  #apply{(push f)} (generator s) = Destination.generator (f s) :=
  \fun (f: Generators -> TargetGenerators) => Extend.onGenerator (\fun (s: Generators) => Destination.generator (f s));
\module Composition(FinalGenerators: \Set);
\module Injection(f: Generators -> TargetGenerators);
