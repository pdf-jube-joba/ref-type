\structure Data: \Set {
  first: MapBetween A B,
  second: MapBetween B C,
  third: MapBetween C D,
  last: MapBetween D E,
}
\structure Laws[data: Data]: \Prop {
  zeroB: \forall (x: A.Carrier) -> #apply{data.second} (#apply{data.first} x) = #zero{C.space},
  zeroC: \forall (x: B.Carrier) -> #apply{data.third} (#apply{data.second} x) = #zero{D.space},
  zeroD: \forall (x: C.Carrier) -> #apply{data.last} (#apply{data.third} x) = #zero{E.space},
  kernelB: \forall (x: B.Carrier) -> #apply{data.second} x = #zero{C.space} -> \exists { a: A.Carrier \where #apply{data.first} a = x },
  kernelC: \forall (x: C.Carrier) -> #apply{data.third} x = #zero{D.space} -> \exists { b: B.Carrier \where #apply{data.second} b = x },
  kernelD: \forall (x: D.Carrier) -> #apply{data.last} x = #zero{E.space} -> \exists { c: C.Carrier \where #apply{data.third} c = x },
}
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });

\module Vanishing(sequence: Sequence);
