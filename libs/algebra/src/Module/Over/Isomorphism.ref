\import \parent.Hom[V := V, W := W, source := source, target := target] \as Forward;
\import \parent.Hom[V := W, W := V, source := target, target := source] \as Backward;
\structure Data: \Set {
  forward: Forward.Map,
  backward: Backward.Map,
}
\structure Laws[data: Data]: \Prop {
  leftInverse: \forall (x: V) -> #apply{data.backward} (#apply{data.forward} x) = x,
  rightInverse: \forall (x: W) -> #apply{data.forward} (#apply{data.backward} x) = x,
}
\definition Isomorphism: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
