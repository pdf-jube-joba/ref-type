\import \parent.\parent.Hom[V := U, W := V, source := domain, target := left] \as LeftMaps;
\import \parent.\parent.Hom[V := U, W := W, source := domain, target := right] \as RightMaps;
\import \parent.\parent.Hom[V := U, W := Carrier, source := domain, target := space] \as Maps;
\definition pair(f: LeftMaps.Map) (g: RightMaps.Map): Maps.Map := Maps.Map {
  apply := \fun (x: U) => make (#apply{f} x) (#apply{g} x),
  addition := \fun (x, y: U) => Pairs.pairCong _ _ _ _ (#addition{f} x y) (#addition{g} x y),
  scalar := \fun (a: R) (x: U) => Pairs.pairCong _ _ _ _ (#scalar{f} a x) (#scalar{g} a x),
};
\definition unique: \forall (f: LeftMaps.Map) (g: RightMaps.Map) (h: Maps.Map) ->
  (\forall (x: U) -> first (#apply{h} x) = #apply{f} x) ->
  (\forall (x: U) -> second (#apply{h} x) = #apply{g} x) ->
  #apply{h} = #apply{(pair f g)} :=
  \fun (f: _) (g: _) (h: _) (lf: _) (rg: _) => \axiom:funext(#apply{h}, #apply{(pair f g)},
    \fun (x: U) => Pairs.ext _ _ (lf x) (rg x));
