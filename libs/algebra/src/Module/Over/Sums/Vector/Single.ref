\import \parent.\parent.\parent.Coordinates[I := I].Kronecker[] \as Kronecker;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition absent: \forall (indices: Lists.List[I]) (i: I) -> Logic.Not (\In[I] (keys indices) i) ->
  \forall (f: I -> V) -> sum indices (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j)) = Values.zero :=
  \induction (indices: Lists.List[I]) \return \forall (i: I) -> Logic.Not (\In[I] (keys indices) i) ->
    \forall (f: I -> V) -> sum indices (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j)) = Values.zero \with {
      | nil: \fun (i: I) (outside: _) (f: _) => \refl(Values.zero)
      | cons: \fun (j: I) (tail: Lists.List[I]) (ih: _) (i: I) (outside: _) (f: _) =>
        trans!{V} _ _ _ (congr2!{V V V} Values.add _ _ _ _
          (trans!{V} _ _ _ (congr!{R V} (\fun (a: R) => Values.scale a (f j)) _ _
            (Kronecker.different i j (\fun (equal: i = j) => outside (Logic.Or[_, _]::left equal)))) (Values.zeroScale (f j)))
          (ih i (\fun (member: _) => outside (Logic.Or[_, _]::right member)) f)) (Values.zeroLeft Values.zero)
    };
\definition extract: \forall (indices: Lists.List[I]) -> Distinct indices ->
  \forall (i: I) -> \In[I] (keys indices) i -> \forall (f: I -> V) ->
  sum indices (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j)) = f i :=
  \fun (indices: _) (distinct: Distinct indices) => distinct
    (\fun (indices: Lists.List[I]) => \forall (i: I) -> \In[I] (keys indices) i -> \forall (f: I -> V) ->
      sum indices (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j)) = f i)
    (\fun (i: I) (empty: Logic.False) (f: _) => Logic.falseElim (Values.zero = f i) empty)
    (\fun (j: I) (tail: Lists.List[I]) (fresh: Logic.Not (\In[I] (keys tail) j)) (ih: _) (i: I) (member: _) (f: _) =>
      either!{{i = j} "or" {Logic.Not (i = j)} "either" {sum (Lists.List[I]::cons j tail) (\fun (k: I) => Values.scale (Kronecker.delta i k) (f k)) = f i}
        "lt:" {\fun (equal: i = j) => \block {
          \let outside: Logic.Not (\In[I] (keys tail) i) := \fun (inTail: _) => fresh
            (\idelim i = j \with k: I => \In[I] (keys tail) k \by { base: inTail, equality: equal }) \then
          \return trans!{V} _ _ _ (congr2!{V V V} Values.add _ _ _ _
            (trans!{V} _ _ _ (congr!{R V} (\fun (a: R) => Values.scale a (f j)) _ _ (Kronecker.equal i j equal)) (#scalarOne{space} (f j)))
            (absent tail i outside f)) (trans!{V} _ _ _ (Values.zeroRight (f j)) (congr!{I V} f _ _ (sym!{I} _ _ equal)))
        }}
        "rt:" {\fun (different: Logic.Not (i = j)) => \block {
          \let inTail: \In[I] (keys tail) i := either!{{i = j} "or" {\In[I] (keys tail) i} "either" {\In[I] (keys tail) i}
            "lt:" {\fun (equal: _) => Logic.falseElim (\In[I] (keys tail) i) (different equal)}
            "rt:" {\fun (old: _) => old}} member \then
          \return trans!{V} _ _ _ (congr2!{V V V} Values.add _ _ _ _
            (trans!{V} _ _ _ (congr!{R V} (\fun (a: R) => Values.scale a (f j)) _ _ (Kronecker.different i j different)) (Values.zeroScale (f j)))
            (ih i inTail f)) (Values.zeroLeft (f i))
        }}} (Classical.excludedMiddle (i = j)));

\definition normalize: \forall (i: I)(f: I -> V) ->
  (\forall (j: I) -> Logic.Not (i = j) -> f j = Values.zero) ->
  \forall (j: I) -> f j = Values.scale (Kronecker.delta i j) (f j) :=
  \fun (i: I)(f: I -> V)(outside: \forall (j: I) -> Logic.Not (i = j) -> f j = Values.zero)(j: I) =>
    either!{{i = j} "or" {Logic.Not (i = j)} "either" {f j = Values.scale (Kronecker.delta i j) (f j)}
      "lt:" {\fun (same: i = j) => sym!{V} _ _ (trans!{V} _ _ _
        (congr!{R V} (\fun (a: R) => Values.scale a (f j)) _ _ (Kronecker.equal i j same))
        (#scalarOne{space} (f j)))}
      "rt:" {\fun (ne: Logic.Not (i = j)) => trans!{V} (f j) Values.zero _
        (outside j ne)
        (sym!{V} _ Values.zero (trans!{V} _ _ _
          (congr!{R V} (\fun (a: R) => Values.scale a (f j)) _ _ (Kronecker.different i j ne))
          (Values.zeroScale (f j))))}
    } (Classical.excludedMiddle (i = j));
\definition select: \forall (indices: Lists.List[I]) -> Distinct indices ->
  \forall (i: I) -> \In[I] (keys indices) i -> \forall (f: I -> V) ->
  (\forall (j: I) -> Logic.Not (i = j) -> f j = Values.zero) -> sum indices f = f i :=
  \fun (indices: Lists.List[I])(distinct: Distinct indices)(i: I)(member: _)(f: I -> V)(outside: _) =>
    trans!{V} (sum indices f) (sum indices (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j))) (f i)
      (congruent indices f (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j)) (normalize i f outside))
      (extract indices distinct i member f);
\definition selectAbsent: \forall (indices: Lists.List[I])(i: I) ->
  Logic.Not (\In[I] (keys indices) i) -> \forall (f: I -> V) ->
  (\forall (j: I) -> Logic.Not (i = j) -> f j = Values.zero) -> sum indices f = Values.zero :=
  \fun (indices: Lists.List[I])(i: I)(missing: _)(f: I -> V)(outside: _) =>
    trans!{V} (sum indices f) (sum indices (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j))) Values.zero
      (congruent indices f (\fun (j: I) => Values.scale (Kronecker.delta i j) (f j)) (normalize i f outside))
      (absent indices i missing f);
