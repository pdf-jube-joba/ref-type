\import \parent.Tensor[V := B.Carrier, W := N.Carrier, left := B.space, right := N.space] \as Source;
\import \parent.Tensor[V := C.Carrier, W := N.Carrier, left := C.space, right := N.space] \as Target;
\import \parent.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as Maps;
\import \parent.Hom[V := Source.Carrier, W := U.Carrier, source := Source.space, target := U.space] \as Input;
\import \parent.Hom[V := Target.Carrier, W := U.Carrier, source := Target.space, target := U.space] \as Output;
\import \parent.SurjectiveDescent[A := B, B := C, U := U] \as Descent;
\import Target.Universal[U := U.Carrier, target := U.space] \as Universal;
\import Source.Universal[U := U.Carrier, target := U.space] \as Equality;
\import \parent.End[V := N.Carrier, space := N.space] \as Coefficients;
\import Source.Mapping[U := C.Carrier, Z := N.Carrier, targetLeft := C.space, targetRight := N.space] \as Mapping;
\import Output.Composition[U := Source.Carrier, domain := Source.space] \as Composition;
\module On(q: Maps.Map, f: Input.Map);
