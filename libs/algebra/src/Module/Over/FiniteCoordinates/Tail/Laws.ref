\definition extensionAddition: \forall (v, w: Smaller.Carrier) -> extension (#add{Smaller.space} v w) = #add{space} (extension v) (extension w) :=
  \fun (v, w: Smaller.Carrier) => \axiom:funext(extension (#add{Smaller.space} v w), #add{space} (extension v) (extension w),
    \fun (i: Index) => trans!{R} (extension (#add{Smaller.space} v w) i)
      (SmallSums.sum (Finite.elements (Nat.sub n start)) (\fun (j: Smaller.Index) => #add{ring}
        (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j)) (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (w j))))
      (#add{ring} (extension v i) (extension w i))
      (SumLaws.congruent (Finite.elements (Nat.sub n start))
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (#add{ring} (v j) (w j)))
        (\fun (j: Smaller.Index) => #add{ring} (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j)) (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (w j)))
        (\fun (j: Smaller.Index) => #leftDistributive{(#semiring{ring})} (NaturalDelta.delta i (Nat.add start j)) (v j) (w j)))
      (SumLaws.additive (Finite.elements (Nat.sub n start))
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j))
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (w j))));
\definition scalarTerm: \forall (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) ->
  #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (#mul{ring} a (v j)) =
  #mul{ring} a (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j)) :=
  \fun (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) =>
    trans!{R} (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (#mul{ring} a (v j)))
      (#mul{ring} (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) a) (v j))
      (#mul{ring} a (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j)))
      (sym!{R} (#mul{ring} (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) a) (v j))
        (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (#mul{ring} a (v j))) (#associative{(#multiplicative{(#semiring{ring})})} (NaturalDelta.delta i (Nat.add start j)) a (v j)))
      (trans!{R} (#mul{ring} (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) a) (v j))
        (#mul{ring} (#mul{ring} a (NaturalDelta.delta i (Nat.add start j))) (v j))
        (#mul{ring} a (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j)))
        (congr!{R R} (\fun (x: R) => #mul{ring} x (v j)) (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) a)
          (#mul{ring} a (NaturalDelta.delta i (Nat.add start j))) (sym!{R} (#mul{ring} a (NaturalDelta.delta i (Nat.add start j))) (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) a) (NaturalDelta.central i (Nat.add start j) a)))
        (#associative{(#multiplicative{(#semiring{ring})})} a (NaturalDelta.delta i (Nat.add start j)) (v j)));
\definition extensionScalar: \forall (a: R)(v: Smaller.Carrier) -> extension (#smul{Smaller.space} a v) = #smul{space} a (extension v) :=
  \fun (a: R)(v: Smaller.Carrier) => \axiom:funext(extension (#smul{Smaller.space} a v), #smul{space} a (extension v),
    \fun (i: Index) => trans!{R} (extension (#smul{Smaller.space} a v) i)
      (SmallSums.sum (Finite.elements (Nat.sub n start)) (\fun (j: Smaller.Index) => #mul{ring} a (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j))))
      (#mul{ring} a (extension v i))
      (SumLaws.congruent (Finite.elements (Nat.sub n start))
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (#mul{ring} a (v j)))
        (\fun (j: Smaller.Index) => #mul{ring} a (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j)))
        (\fun (j: Smaller.Index) => scalarTerm a v i j))
      (SumLaws.multiplyLeft (Finite.elements (Nat.sub n start)) a (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j))));
