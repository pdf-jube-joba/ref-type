\import \parent.Laws[V := V, space := space] \as Laws;
\definition additive: Alg.CommutativeGroup[V] := Laws.additive;
\import algebra.Group[].Of[Carrier := V, group := additive] \as Group;
\definition zero: V := Laws.zero;
\definition add: V -> V -> V := Laws.add;
\definition neg: V -> V := Laws.neg;
\definition scale: R -> V -> V := Laws.scale;
\definition scaleZero: \forall (a: R) -> scale a zero = zero := Laws.scaleZero;
\definition zeroScale: \forall (x: V) -> scale (#zero{ring}) x = zero := Laws.zeroScale;
\definition scaleNeg: \forall (a: R)(x: V) -> scale a (neg x) = neg (scale a x) := Laws.scaleNeg;
\definition negativeOne: \forall (x: V) -> scale (#neg{ring} (#one{ring})) x = neg x := Laws.negativeOne;
\definition scaleDifference: \forall (a: R)(x, y: V) ->
  scale a (Group.difference x y) = Group.difference (scale a x) (scale a y) := Laws.scaleDifference;
\module Submodule;
