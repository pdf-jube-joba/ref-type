\import \parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as Maps;
\import \parent.Hom[V := A.Carrier, W := U.Carrier, source := A.space, target := U.space] \as Input;
\import \parent.Hom[V := B.Carrier, W := U.Carrier, source := B.space, target := U.space] \as Output;
\import \parent.Laws[V := A.Carrier, space := A.space] \as Source;
\import \parent.Laws[V := B.Carrier, space := B.space] \as Middle;
\import \parent.Laws[V := U.Carrier, space := U.space] \as Target;
\import algebra.Group[].Of[Carrier := B.Carrier, group := Middle.additive] \as MiddleGroup;
\import algebra.Group[].Of[Carrier := U.Carrier, group := Target.additive] \as Group;
\module On(q: Maps.Map, f: Input.Map);
\definition factorExists: \forall (q: Maps.Map)(f: Input.Map) -> On[q := q, f := f].Onto -> On[q := q, f := f].KillsKernel ->
  \exists { h: Output.Map \where \forall (x: A.Carrier) -> #apply{h} (#apply{q} x) = #apply{f} x } :=
  \fun (q: Maps.Map)(f: Input.Map)(onto: On[q := q, f := f].Onto)(kills: On[q := q, f := f].KillsKernel) =>
    \exact(\into[Output.Map](On[q := q, f := f].map onto kills,
      { h: Output.Map \where \forall (x: A.Carrier) -> #apply{h} (#apply{q} x) = #apply{f} x }) \by { On[q := q, f := f].onImage onto kills },
      \Cast[Output.Map] ({ h: Output.Map \where \forall (x: A.Carrier) -> #apply{h} (#apply{q} x) = #apply{f} x }));
