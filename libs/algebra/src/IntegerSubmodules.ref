\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Finite;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import std.Arithmetic[].ExtendedEuclid[].Signed[] \as Signed;
\import std.Alg[].Ring[] \as Ring;
\import algebra.Module[].Over[R := I.Int^, ring := Ring.commutativeRingAsRing I.Int^ IntegerRing.commutativeRing] \as Modules;
\import algebra.IntegerIdeals[] \as Ideals;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;
\module Dimension(n: N.Nat^);
\module Zero;
\module Step(n: N.Nat^);
\definition finiteGeneration: \forall (n: N.Nat^)(S: Dimension[n := n].Submodule) -> Dimension[n := n].Generated S :=
  \induction (n: N.Nat^) \return \forall (S: Dimension[n := n].Submodule) -> Dimension[n := n].Generated S \with {
    | zero: Zero[].existence
    | succ: \fun (n: N.Nat^)(previous: _) => Step[n := n].existence previous
  };

\definition freeBases: \forall (n: N.Nat^)(S: Dimension[n := n].Submodule) ->
  \exists Dimension[n := n].Of[S := S].BasisData :=
  \fun (n: N.Nat^)(S: Dimension[n := n].Submodule) =>
    Dimension[n := n].Of[S := S].basisExistence (finiteGeneration n S);
\module Projectivity(n: N.Nat^, S: \parent.Dimension[n := n].Submodule);
