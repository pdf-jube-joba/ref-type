\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Finite;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import std.Alg[].Ring[] \as Ring;
\import algebra.Module[].Over[R := I.Int^, ring := Ring.commutativeRingAsRing I.Int^ IntegerRing.commutativeRing] \as Modules;
\import algebra.Module[].Commutative[R := I.Int^, ring := IntegerRing.commutativeRing].Matrix[m := m, n := n] \as Base;
\import std.Logic[].Equality[] \as Equality;
\import std.Program[] \as Programs;
\use Equality::trans;
\use Equality::sym;
\use Equality::congr;
\use Equality::congr2;
\use Equality::eq_reason;
\definition Matrix: \Set := Base.Matrix;
\definition Runtime: \VType := \U(N.Nat -> N.Nat -> I.Int);
\definition reflect(a: Runtime^): Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin n) => a i j;
\definition Vector: \Set := Modules.FiniteCoordinates[n := n].Carrier;
\definition Output: \Set := Modules.FiniteCoordinates[n := m].Carrier;
\definition domain: Modules.Space Vector := Modules.FiniteCoordinates[n := n].space;
\definition codomain: Modules.Space Output := Modules.FiniteCoordinates[n := m].space;
\definition apply: Matrix -> Vector -> Output := Base.apply;
\module FiniteSum;
\module Product(k: N.Nat^);
\module RowOperations;

\module Transpose;
\module ColumnOperations;

\module Search;

\module Identity;

\module Extension;
