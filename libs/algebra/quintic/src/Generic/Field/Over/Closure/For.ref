\import \parent.\parent.Renaming[p := p].Isomorphism[] \as Initial;
\module Selected(initial: Initial.Initial);
\definition exists: Conditions -> \exists Lift[p] := \block {
  \fun (conditions: Conditions) \then
  \takefrom initial: Initial.Initial \by Initial.initialExists conditions.independent \then
  \return Selected[initial := initial].exists conditions
};
