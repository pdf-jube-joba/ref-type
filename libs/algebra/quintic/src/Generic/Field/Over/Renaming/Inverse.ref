\import \parent.\parent.Renaming[p := Permutations.inverse p] \as Inverse;
\definition cancels: \forall (e: Free.Expression) -> Inverse.rename (rename e) = e :=
  \induction (e: Free.Expression) \return Inverse.rename (rename e) = e \with {
    | constant: \fun (a: Base.Carrier) => \refl(Free.Expression::constant a)
    | variable: \fun (i: Quintic.Five) => congr!{Quintic.Five Free.Expression} Free.Expression::variable _ _ (p.leftInverse i)
    | sum: \fun (a: Free.Expression)(left: _)(b: Free.Expression)(right: _) => congr!{Free.Expression Free.Expression Free.Expression} Free.Expression::sum _ _ _ _ left right
    | negative: \fun (a: Free.Expression)(previous: _) => congr!{Free.Expression Free.Expression} Free.Expression::negative _ _ previous
    | product: \fun (a: Free.Expression)(left: _)(b: Free.Expression)(right: _) => congr!{Free.Expression Free.Expression Free.Expression} Free.Expression::product _ _ _ _ left right
  };
\definition reflects: \forall (e: Free.Expression) -> Polynomial.Equivalent (rename e) Free.zeroExpr -> Polynomial.Equivalent e Free.zeroExpr :=
  \fun (e: Free.Expression)(zero: _) => \idelim Inverse.rename (rename e) = e
    \with a: Free.Expression => Polynomial.Equivalent a Free.zeroExpr \by {
      base: Inverse.preserves (rename e) Free.zeroExpr zero,
      equality: cancels e
    };
