\import F.Polynomial[] \as Polynomials;
\import F.Partial[] \as Partial;
\import F.Automorphism[] \as Automorphisms;
\import std.Set[].Infinite[A := K] \as Infinite;
\structure Conditions: \Prop := {
  closed: Polynomials.AlgebraicallyClosed (\fun (x: K) => Logic.True),
  independent: Independent,
  injective: Infinite.Injective index,
  constants: \forall (n: N.Nat^) -> Subfields.Member constants (index n),
  algebraic: \forall (x: K) -> Polynomials.Algebraic (Subfields.Member splittingField) x,
};
\structure Lift[p: Permutations.Permutation]: \Set := {
  automorphism: Automorphisms.Automorphism,
  constants: Automorphisms.Fixes (Subfields.Member constants) automorphism,
  roots: \forall (i: Quintic.Five) -> automorphism.map.apply (roots i) = roots (p.apply i),
};
\module For(p: Permutations.Permutation);
\definition liftExists: Conditions -> \forall (p: Permutations.Permutation) -> \exists Lift[p] :=
  \fun (conditions: Conditions)(p: Permutations.Permutation) => For[p := p].exists conditions;
