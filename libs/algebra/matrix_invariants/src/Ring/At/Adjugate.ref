\import \parent.Operations[] \as Operations;
\import \parent.Rows[] \as Rows;
\import \parent.Cofactors[] \as Cofactors;
\import Algebra.Laws[V := K, space := Algebra.scalarSpace] \as Scalars;
\definition bump[A: Matrix][i, j: Index]: Matrix := \fun (k, l: Index) => add (A k l) (mul (Kronecker.delta i k) (Kronecker.delta j l));
\definition transposeBump: \forall (A: Matrix)(i, j: Index) -> transpose (bump A i j) = bump (transpose A) j i :=
  \fun (A: Matrix)(i, j: Index) => Operations.ext (transpose (bump A i j)) (bump (transpose A) j i) (\fun (k, l: Index) =>
    congr!{K K} (add (A l k)) _ _ (Algebra.mulComm (Kronecker.delta i l) (Kronecker.delta j k)));
\definition bumpColumns: \forall (A: Matrix)(i, j: Index) -> columns (bump A i j) = Multilinear.update n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i)) :=
  \fun (A: Matrix)(i, j: Index) => \axiom:funext(columns (bump A i j), Multilinear.update n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i)),
    \fun (l: Index) => \axiom:funext(columns (bump A i j) l, Multilinear.update n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i)) l,
      \fun (k: Index) => either!{{(Classical.excludedMiddle (j = l))} {bump A i j k l = Multilinear.update n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i)) l k}
        {\fun (same: j = l) => \idelim j = l \with t: Index => bump A i j k t = Multilinear.update n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i)) t k \by {
          base: eq_reason_in!{K _
            "=" { add (A k j) (mul (Kronecker.delta i k) one) } "by" { congr!{K K} (\fun (a: K) => add (A k j) (mul (Kronecker.delta i k) a)) _ _ (Kronecker.self j) }
            "=" { add (A k j) (Kronecker.delta i k) } "by" { congr!{K K} (add (A k j)) _ _ (Algebra.mulOneRight (Kronecker.delta i k)) }
            "=" _ "by" { sym!{K} _ _ (congr!{Vector K} (\fun (v: Vector) => v k) _ _ (Updates.updateSelf n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i)))) }
          }, equality: same
        }}
        {\fun (different: Logic.Not (j = l)) => eq_reason_in!{K _
          "=" { add (A k l) (mul (Kronecker.delta i k) zero) } "by" { congr!{K K} (\fun (a: K) => add (A k l) (mul (Kronecker.delta i k) a)) _ _ (Kronecker.different j l different) }
          "=" { add (A k l) zero } "by" { congr!{K K} (add (A k l)) _ _ (Algebra.mulZeroRight (Kronecker.delta i k)) }
          "=" { A k l } "by" { Algebra.addZeroRight (A k l) }
          "=" _ "by" { sym!{K} _ _ (congr!{Vector K} (\fun (v: Vector) => v k) _ _ (Updates.updateOther n (columns A) j l (Vectors.plus (columns A j) (Coordinates.vectors i)) different)) }
        }}
      }));
\definition bumpDeterminant: \forall (A: Matrix)(i, j: Index) -> determinant (bump A i j) = add (determinant A) (cofactor A i j) :=
  \fun (A: Matrix)(i, j: Index) => eq_reason_in!{K _
    "=" { Top.volume (Multilinear.update n (columns A) j (Vectors.plus (columns A j) (Coordinates.vectors i))) } "by" { congr!{{Multilinear.Arguments n} K} Top.volume _ _ (bumpColumns A i j) }
    "=" { determinant (replaceColumn A j (Vectors.plus (columns A j) (Coordinates.vectors i))) } "by" { sym!{K} _ _ (determinantReplace A j (Vectors.plus (columns A j) (Coordinates.vectors i))) }
    "=" _ "by" { columnAddition A j (columns A j) (Coordinates.vectors i) }
    "=" _ "by" { congr!{K K} (\fun (a: K) => add a (cofactor A i j)) _ _ (Cofactors.original A j) }
  };
\definition cofactorTranspose: \forall (A: Matrix)(i, j: Index) -> cofactor (transpose A) j i = cofactor A i j :=
  \fun (A: Matrix)(i, j: Index) => Scalars.cancelLeft (determinant A) _ _ (eq_reason_in!{K _
    "=" { add (determinant (transpose A)) (cofactor (transpose A) j i) } "by" { congr!{K K} (\fun (a: K) => add a (cofactor (transpose A) j i)) _ _ (sym!{K} _ _ (Rows.transposeInvariant A)) }
    "=" { determinant (bump (transpose A) j i) } "by" { sym!{K} _ _ (bumpDeterminant (transpose A) j i) }
    "=" { determinant (transpose (bump A i j)) } "by" { congr!{Matrix K} determinant _ _ (sym!{Matrix} _ _ (transposeBump A i j)) }
    "=" { determinant (bump A i j) } "by" { Rows.transposeInvariant (bump A i j) }
    "=" _ "by" { bumpDeterminant A i j }
  });
\definition transposeAdjugate: \forall (A: Matrix) -> transpose (adjugate A) = adjugate (transpose A) :=
  \fun (A: Matrix) => Operations.ext (transpose (adjugate A)) (adjugate (transpose A)) (\fun (i, j: Index) => sym!{K} _ _ (cofactorTranspose A i j));
\definition productAdjugate: \forall (A: Matrix) -> product A (adjugate A) = Matrices.scale (determinant A) identity :=
  \fun (A: Matrix) => Operations.ext (product A (adjugate A)) (Matrices.scale (determinant A) identity) (\fun (i, j: Index) => eq_reason_in!{K _
    "=" { product (adjugate (transpose A)) (transpose A) j i } "by" {
      SumLaws.congruent (Fin.elements n)
        (\fun (k: Index) => mul (A i k) (cofactor A j k)) (\fun (k: Index) => mul (cofactor (transpose A) k j) (A i k))
        (\fun (k: Index) => trans!{K} _ _ _ (Algebra.mulComm (A i k) (cofactor A j k))
          (congr!{K K} (\fun (a: K) => mul a (A i k)) _ _ (sym!{K} _ _ (cofactorTranspose A j k)))) }
    "=" { mul (determinant (transpose A)) (identity j i) } "by" { Operations.entry _ _ (Cofactors.adjugateProduct (transpose A)) j i }
    "=" _ "by" { congr!{K K K} mul _ _ _ _ (Rows.transposeInvariant A) (Kronecker.symmetric i j) }
  });
\definition laplaceRow: \forall (A: Matrix)(i: Index) ->
  Sums.sum (Fin.elements n) (\fun (j: Index) => mul (A i j) (cofactor A i j)) = determinant A :=
  \fun (A: Matrix)(i: Index) => trans!{K} _ _ _ (Operations.entry _ _ (productAdjugate A) i i)
    (trans!{K} _ _ _ (congr!{K K} (mul (determinant A)) _ _ (Kronecker.self i)) (Algebra.mulOneRight (determinant A)));
