\import \parent.\parent.Products[n := m] \as Other;
\definition law: \forall (xs: Lists.List[Index])(map: Index -> Fin.Fin m)(f: Fin.Fin m -> K) ->
  Other.value (Lists.map Index (Fin.Fin m) map xs) f = value xs (\fun (i: Index) => f (map i)) :=
  \induction (xs: Lists.List[Index]) \return \forall (map: Index -> Fin.Fin m)(f: Fin.Fin m -> K) ->
    Other.value (Lists.map Index (Fin.Fin m) map xs) f = value xs (\fun (i: Index) => f (map i)) \with {
    | nil: \fun (map: Index -> Fin.Fin m)(f: Fin.Fin m -> K) => \refl(one)
    | cons: \fun (head: Index)(tail: Lists.List[Index])(previous: _)(map: Index -> Fin.Fin m)(f: Fin.Fin m -> K) =>
      congr!{K K} (mul (f (map head))) _ _ (previous map f)
  };
