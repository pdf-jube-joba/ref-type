\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import std.Logic[].Proposition[] \as Logic;
\use Logic.either;
\import std.Logic[].Classical[] \as Classical;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import linear_algebra.Commutative[K := K, scalarRing := scalars] \as Algebra;
\definition zero: K := Algebra.zero;
\definition one: K := Algebra.one;
\definition add: K -> K -> K := Algebra.add;
\definition mul: K -> K -> K := Algebra.mul;
\definition neg: K -> K := Algebra.neg;
\module At(n: N.Nat^);
\module TensorSum(n: N.Nat^);
\module Products(n: N.Nat^);
