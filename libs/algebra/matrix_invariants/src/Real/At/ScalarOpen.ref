\import metric_spaces.RealLine[] \as Line;
\import metric_spaces.RealMetric[] \as Metric;
\import metric_spaces.MetricSpace[Carrier := K].Topology[] \as MetricTopology;
\definition scalarTopology: ScalarSpace.Topology := Line.topology;
\definition nonzeroOpen: ScalarSpace.IsOpenIn scalarTopology (ScalarSpace.Complement (ScalarSpace.Singleton Scalars.field.zero)) :=
  MetricTopology.singletonClosed Metric.metric Scalars.field.zero;
