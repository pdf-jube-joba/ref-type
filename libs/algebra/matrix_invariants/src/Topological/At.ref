\import Ring.At[n := n] \as Matrix;
\import Matrix.Operations[] \as Operations;
\import Matrix.Expansion[] \as Expanded;
\import Matrix.RowTerms[] \as Terms;
\import Ring.TensorSum[n := n] \as TuplesSum;
\import Ring.Products[n := n] \as Products;
\import topological_algebra.Matrix[K := K, I := Matrix.Index, J := Matrix.Index] \as Matrices;
\import topology.Topology[Carrier := Matrix.Matrix] \as Space;
\definition topology: Space.Topology := Matrices.topology ring.topology;
\definition Nonvanishing: \Pow Matrix.Matrix := { A: Matrix.Matrix \where Logic.Not (Matrix.determinant A = Algebra.zero) };
\module Families(X: \Set);
\definition determinantContinuous: topology.Continuity[A := Matrix.Matrix, B := K].Continuous topology ring.topology Matrix.determinant :=
  Families[X := Matrix.Matrix].determinantContinuous topology (\fun (A: Matrix.Matrix) => A) (\fun (i, j: Matrix.Index) => Matrices.entryContinuous ring.topology i j);
\definition nonvanishingOpen: ScalarSpace.IsOpenIn ring.topology (ScalarSpace.Complement (ScalarSpace.Singleton Algebra.zero)) -> Space.IsOpenIn topology Nonvanishing :=
  \fun (scalarOpen: _) => determinantContinuous (ScalarSpace.Complement (ScalarSpace.Singleton Algebra.zero)) scalarOpen;
