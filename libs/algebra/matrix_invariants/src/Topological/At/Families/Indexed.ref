\import Algebra.Sums[I := I] \as Sums;
\definition sumContinuous: \forall (xs: Lists.List[I])(source: Source.Topology)(f: I -> X -> K) ->
  (\forall (i: I) -> Continuous source (f i)) -> Continuous source (\fun (x: X) => Sums.sum xs (\fun (i: I) => f i x)) :=
  \induction (xs: Lists.List[I]) \return \forall (source: Source.Topology)(f: I -> X -> K) ->
    (\forall (i: I) -> Continuous source (f i)) -> Continuous source (\fun (x: X) => Sums.sum xs (\fun (i: I) => f i x)) \with {
      | nil: \fun (source: Source.Topology)(f: I -> X -> K)(continuous: _) => constant source Algebra.zero
      | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(source: Source.Topology)(f: I -> X -> K)(continuous: _) =>
        addition source (f head) (\fun (x: X) => Sums.sum tail (\fun (i: I) => f i x)) (continuous head) (previous source f continuous)
    };
