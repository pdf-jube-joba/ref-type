\import Composition.After[l := l, W := W, g := g] \as Composition;
\import \root.Euclidean[n := m].Pullback[m := l, U := V, V := W, f := g] \as Outer;
\import \root.Euclidean[n := n].Pullback[m := l, U := U, V := W, f := Composition.compose] \as Composite;
\import \root.Euclidean[n := l].On[U := W] \as Forms;
\import Spaces.Coordinates[I := Fin.Fin l] \as End;
\import Spaces.Linear[V := Vectors.Vector, W := End.Vector, source := Vectors.space, target := End.space] \as FinalMaps;
\definition law: \forall (k: N.Nat^)(omega: Forms.Form k) -> Composite.apply k omega = apply k (Outer.apply k omega) :=
  \fun (k: N.Nat^)(omega: Forms.Form k) => SourceForms.ext k (Composite.apply k omega) (apply k (Outer.apply k omega))
    (\fun (x: Open.Carrier U)(arguments: Multilinear.Arguments k) =>
      congr!{{FinalMaps.Map} {Reals.Real}} (\fun (d: FinalMaps.Map) => omega (calculus.Maps[n := m, m := l].apply V W g (Maps.apply U V f x))
        (\fun (i: Fin.Fin k) => #apply{d} (arguments i))) (Composite.jacobian x) (Composition.At[a := x].candidate) (Composition.At[a := x].jacobian));
