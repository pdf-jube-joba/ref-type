\import Basis.Exterior[] \as Coordinates;
\definition Operator(k: N.Nat^): \Set := (Fin.Fin k -> Fin.Fin n) -> Form k;
\definition word(k: N.Nat^)(indices: Fin.Fin k -> Fin.Fin n): Form k := \parent.At[k := k].constant (Coordinates.word k indices);
\definition increasing(k: N.Nat^)(indices: \parent.Increasing[k := k].Index): Form k := word k indices;
\definition zero: \forall (indices: Fin.Fin N.Nat^::zero -> Fin.Fin n) -> word N.Nat^::zero indices = unit :=
  \fun (indices: Fin.Fin N.Nat^::zero -> Fin.Fin n) => \refl(unit);
\module At(k: N.Nat^);
