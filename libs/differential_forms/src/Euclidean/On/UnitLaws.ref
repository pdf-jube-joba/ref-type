\import \parent.Wedge[p := N.Nat^::zero, q := k] \as Left;
\import \parent.Wedge[p := k, q := N.Nat^::zero] \as Right;
\import \parent.Regrade[k := Nat.add N.Nat^::zero k, l := k] \as Degree;
\import Exterior.UnitLaws[k := k] \as Point;
\import Exterior.Components[k := k] \as Components;
\import N.Basic[].Prop[] \as Naturals;
\definition degree: Nat.add N.Nat^::zero k = k := Naturals.addZeroLeft k;
\definition left: \forall (omega: Form k) -> Degree.cast (Left.apply unit omega) degree = omega :=
  \fun (omega: Form k) => \axiom:funext(Degree.cast (Left.apply unit omega) degree, omega,
    \fun (x: Open.Carrier U) => Components.ext (Degree.cast (Left.apply unit omega) degree x) (omega x)
      (trans!{{Shuffle.Function}} (Exterior.component k (Degree.cast (Left.apply unit omega) degree x))
        (Exterior.component (Nat.add N.Nat^::zero k) (Left.apply unit omega x)) (Exterior.component k (omega x))
        (Degree.series (Left.apply unit omega) degree x) (Point.left (omega x))));
\definition right: \forall (omega: Form k) -> Right.apply omega unit = omega :=
  \fun (omega: Form k) => \axiom:funext(Right.apply omega unit, omega, \fun (x: Open.Carrier U) => Point.right (omega x));
