\import \parent.Regrade[k := k, l := k] \as Degree;
\import Exterior.Components[k := k] \as Components;
\definition law: \forall (omega: Form k)(same: k = k) -> Degree.cast omega same = omega :=
  \fun (omega: Form k)(same: k = k) => \axiom:funext(Degree.cast omega same, omega,
    \fun (x: Open.Carrier U) => Components.ext (Degree.cast omega same x) (omega x) (Degree.series omega same x));
