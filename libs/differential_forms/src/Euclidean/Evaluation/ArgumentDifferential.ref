\import Regularity.Derivative[] \as Partials;
\definition coordinate(arguments: RegularArguments k)(slot: Fin.Fin k)(j: Fin.Fin n): Functions.Function :=
  \into[Source.ScalarFunction U]((\fun (x: Source.Carrier U) => arguments x slot j), { h: Source.ScalarFunction U \where Regularity.SmoothOn U h }) \by {
    (\bysub(VariableArguments k, { arguments: VariableArguments k \where ArgumentSmooth k arguments }, arguments)) slot j
  };
\definition apply(i: Fin.Fin m)(arguments: RegularArguments k): RegularArguments k :=
  \into[VariableArguments k]((\fun (x: Source.Carrier U)(slot: Fin.Fin k)(j: Fin.Fin n) => Partials.derivative U (coordinate arguments slot j) i x),
    { result: VariableArguments k \where ArgumentSmooth k result }) \by {
      \fun (slot: Fin.Fin k)(j: Fin.Fin n) => equalSmooth (Partials.partial U (coordinate arguments slot j) i)
        (\fun (x: Source.Carrier U) => Partials.derivative U (coordinate arguments slot j) i x)
        (\fun (x: Source.Carrier U) => \refl(Partials.derivative U (coordinate arguments slot j) i x))
        (Partials.partialSmooth U (coordinate arguments slot j) i)
    };
