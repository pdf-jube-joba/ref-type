\definition Family(k: N.Nat^): \Set := Open.Carrier U -> Alternating.Form k;
\definition SmoothFamily(k: N.Nat^)(omega: Family k): \Prop :=
  \forall (arguments: Multilinear.Arguments k) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => omega x arguments);
\definition Form(k: N.Nat^): \Set := \Cast[Family k] ({ omega: Family k \where SmoothFamily k omega });
\definition smoothOfEqual: \forall (f, g: Open.ScalarFunction U) -> (\forall (x: Open.Carrier U) -> f x = g x) -> Smooth.SmoothOn U f -> Smooth.SmoothOn U g :=
  \fun (f, g: Open.ScalarFunction U)(equal: \forall (x: Open.Carrier U) -> f x = g x)(smooth: Smooth.SmoothOn U f) =>
    \idelim f = g \with h: Open.ScalarFunction U => Smooth.SmoothOn U h \by { base: smooth, equality: \axiom:funext(f, g, equal) };
\definition evaluate(k: N.Nat^)(omega: Form k)(arguments: Multilinear.Arguments k): Smooth.SmoothFunction U :=
  \into[Open.ScalarFunction U](\fun (x: Open.Carrier U) => omega x arguments,
    { f: Open.ScalarFunction U \where Smooth.SmoothOn U f }) \by {
      (\bysub(Family k, { omega: Family k \where SmoothFamily k omega }, omega)) arguments
    };
\definition coefficient(k: N.Nat^)(omega: Form k)(indices: Fin.Fin k -> Fin.Fin n): Smooth.SmoothFunction U :=
  evaluate k omega (\fun (i: Fin.Fin k) => Basis.vectors (indices i));
\module At(k: N.Nat^);
\definition space(k: N.Nat^): Spaces.VectorSpace (Form k) := At[k := k].space;
\definition ext: \forall (k: N.Nat^)(omega, eta: Form k) ->
  (\forall (x: Open.Carrier U)(arguments: Multilinear.Arguments k) -> omega x arguments = eta x arguments) -> omega = eta :=
  \fun (k: N.Nat^)(omega, eta: Form k)(same: \forall (x: Open.Carrier U)(arguments: Multilinear.Arguments k) -> omega x arguments = eta x arguments) =>
    \axiom:funext(omega, eta, \fun (x: Open.Carrier U) => Alternating.At[k := k].ext (omega x) (eta x) (same x));
\definition coefficientExt: \forall (k: N.Nat^)(omega, eta: Form k) ->
  (\forall (indices: Fin.Fin k -> Fin.Fin n) -> coefficient k omega indices = coefficient k eta indices) -> omega = eta :=
  \fun (k: N.Nat^)(omega, eta: Form k)(same: \forall (indices: Fin.Fin k -> Fin.Fin n) -> coefficient k omega indices = coefficient k eta indices) =>
    \axiom:funext(omega, eta, \fun (x: Open.Carrier U) => Coefficients.basisExt k (omega x) (eta x)
      (\fun (indices: Fin.Fin k -> Fin.Fin n) => congr!{{Smooth.SmoothFunction U} {Reals.Real}} (\fun (f: Smooth.SmoothFunction U) => f x)
        (coefficient k omega indices) (coefficient k eta indices) (same indices)));
\module Partial(k: N.Nat^);
\module DegreeZero;
\module Above(k: N.Nat^);
\module FunctionSums(I: \Set);
\module Series(k: N.Nat^);
\module Wedge(p, q: N.Nat^);
\module Regrade(k, l: N.Nat^);
\module RegradeIdentity(k: N.Nat^);
\module ExteriorDerivative(k: N.Nat^);
\module CoefficientSmooth;
\module Increasing(k: N.Nat^);
\module Square(k: N.Nat^);
\module Leibniz(p, q: N.Nat^);
\module DeRham;
\module Summation(k: N.Nat^, I: \Set);
\module FunctionDifferential;
\module Projection(i: Fin.Fin n);
\module Associativity(p, q, r: N.Nat^);
\module GradedCommutativity(p, q: N.Nat^);
\definition unit: Form N.Nat^::zero := At[k := N.Nat^::zero].constant Exterior.unit;
\module UnitLaws(k: N.Nat^);
\module CoordinateBasis;
