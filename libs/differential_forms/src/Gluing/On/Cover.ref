\module Piece(i: I);
\definition Point(i: I): \Set := \Cast[M.Point] (domains i);
\definition LocalForm: \forall (i: I)(k: Naturals.Nat^) -> \Set :=
  \fun (i: I)(k: Naturals.Nat^) => Piece[i := i].Form k;
\definition Indices(x: M.Point): \Set := \Cast[I] ({ i: I \where \In[M.Point] (domains i) x });
\definition Covers: \Prop := \forall (x: M.Point) -> \exists Indices x;
\module At(k: Naturals.Nat^, forms: \forall (i: I) -> LocalForm i k);
