
\import N.Basic[].Prop[] \as Naturals;
\import Spaces.Sign[] \as Sign;
\definition total: N.Nat^ := N.Nat^::succ (Nat.add p q);
\import \parent.Wedge[p := p, q := q] \as Product;
\import \parent.Wedge[p := N.Nat^::succ p, q := q] \as Left;
\import \parent.Wedge[p := p, q := N.Nat^::succ q] \as Right;
\import \parent.Regrade[k := Nat.add (N.Nat^::succ p) q, l := total] \as Degree;
\import \parent.ExteriorDerivative[k := p] \as LeftD;
\import \parent.ExteriorDerivative[k := q] \as RightD;
\import \parent.ExteriorDerivative[k := Nat.add p q] \as D;
\import \parent.At[k := total] \as Result;
\definition degree: Nat.add (N.Nat^::succ p) q = total := Naturals.addSuccLeft p q;
\definition left(omega: Form (N.Nat^::succ p))(eta: Form q): Form total := Degree.cast (Left.apply omega eta) degree;
\definition right(omega: Form p)(eta: Form (N.Nat^::succ q)): Form total := Right.apply omega eta;
\definition law: \forall (omega: Form p)(eta: Form q) -> D.apply (Product.apply omega eta) =
  Result.plus (left (LeftD.apply omega) eta) (Result.scale (Sign.value p) (right omega (RightD.apply eta))) :=
  \fun (omega: Form p)(eta: Form q) => ext total (D.apply (Product.apply omega eta))
    (Result.plus (left (LeftD.apply omega) eta) (Result.scale (Sign.value p) (right omega (RightD.apply eta))))
    (\fun (chart: Chart) => trans!{{Euclidean.LocalForm #image{chart} total}} _ _ _
      (Euclidean.On[U := #image{chart}].Leibniz[p := p, q := q].law (omega chart) (eta chart))
      (congr!{{Euclidean.LocalForm #image{chart} total} {Euclidean.LocalForm #image{chart} total}}
        (\fun (alpha: Euclidean.LocalForm #image{chart} total) => Euclidean.On[U := #image{chart}].At[k := total].plus alpha
          ((Result.scale (Sign.value p) (right omega (RightD.apply eta))) chart)) _ _
        (sym!{{Euclidean.LocalForm #image{chart} total}} _ _ (Degree.chart (Left.apply (LeftD.apply omega) eta) degree chart))));
