\import \parent.Wedge[p := p, q := q] \as Forward;
\import \parent.Wedge[p := q, q := p] \as Reverse;
\import \parent.Regrade[k := Nat.add p q, l := Nat.add q p] \as Degree;
\import \parent.At[k := Nat.add q p] \as Result;

\import Spaces.Sign[] \as Sign;
\import N.Basic[].Prop[] \as Naturals;
\definition degree: Nat.add p q = Nat.add q p := Naturals.addComm p q;
\definition law: \forall (omega: Form p)(eta: Form q) -> Reverse.apply eta omega = Result.scale (Sign.value (Nat.mul p q)) (Degree.cast (Forward.apply omega eta) degree) :=
  \fun (omega: Form p)(eta: Form q) => ext (Nat.add q p) (Reverse.apply eta omega) (Result.scale (Sign.value (Nat.mul p q)) (Degree.cast (Forward.apply omega eta) degree))
    (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].GradedCommutativity[p := p, q := q].law (omega chart) (eta chart));
