\import \parent.RegradeDisplay[k := k, l := l] \as Display;
\import \parent.RegradeDisplay[k := k, l := k] \as SelfDisplay;
\definition cast(omega: Form k)(same: k = l): Form l :=
  \idelim k = l \with j: _ => Form j \by { base: omega, equality: same };
\definition family(omega: Form k)(same: k = l): Family l := Display.family omega same;
\definition compatible: \forall (omega: Form k)(same: k = l) -> Compatible l (family omega same) := Display.compatible;
\definition displayIdentity: \forall (omega: Form k)(same: k = k) -> SelfDisplay.cast omega same = omega :=
  \fun (omega: Form k)(same: k = k) => ext k (SelfDisplay.cast omega same) omega
    (\fun (chart: Chart) => \transporteq k \with j: _ => Euclidean.LocalForm #image{chart} j \by { base: omega chart });
\definition bridge: \forall (omega: Form k)(same: k = l) -> cast omega same = Display.cast omega same :=
  \fun (omega: Form k)(same: k = l) =>
    (\idelim k = l \with j: _ => \forall (kj: k = j) ->
      (\idelim k = j \with i: _ => Form i \by { base: omega, equality: kj }) = \parent.RegradeDisplay[k := k, l := j].cast omega kj
    \by { base: \fun (kk: k = k) => trans!{{Form k}} _ _ _
      (\transporteq k \with j: _ => Form j \by { base: omega })
      (sym!{{Form k}} _ _ (displayIdentity omega kk)), equality: same }) same;
\definition chart: \forall (omega: Form k)(same: k = l)(chart: Chart) ->
  cast omega same chart = Euclidean.On[U := #image{chart}].Regrade[k := k, l := l].cast (omega chart) same :=
  \fun (omega: Form k)(same: k = l)(chart: Chart) =>
    congr!{{Form l} {Euclidean.LocalForm #image{chart} l}} (\fun (eta: Form l) => eta chart) _ _ (bridge omega same);
\import \parent.At[k := k] \as Source;
\import \parent.At[k := l] \as Target;
\definition addition: \forall (omega, eta: Form k)(same: k = l) ->
  cast (Source.plus omega eta) same = Target.plus (cast omega same) (cast eta same) :=
  \fun (omega, eta: Form k)(same: k = l) => trans!{{Form l}} _ _ _
    (bridge (Source.plus omega eta) same)
    (trans!{{Form l}} _ _ _ (Display.addition omega eta same)
      (congr2!{{Form l} {Form l} {Form l}} Target.plus _ _ _ _
        (sym!{{Form l}} _ _ (bridge omega same)) (sym!{{Form l}} _ _ (bridge eta same))));
\definition scalar: \forall (a: Reals.Real)(omega: Form k)(same: k = l) ->
  cast (Source.scale a omega) same = Target.scale a (cast omega same) :=
  \fun (a: Reals.Real)(omega: Form k)(same: k = l) => trans!{{Form l}} _ _ _
    (bridge (Source.scale a omega) same)
    (trans!{{Form l}} _ _ _ (Display.scalar a omega same)
      (congr!{{Form l} {Form l}} (Target.scale a) _ _ (sym!{{Form l}} _ _ (bridge omega same))));
\import Spaces.Linear[V := Form k, W := Form l, source := Source.space, target := Target.space] \as Maps;
\definition map(same: k = l): Maps.Map := Maps.Map {
  apply := \fun (omega: Form k) => cast omega same,
  preservesAdd := \fun (omega, eta: Form k) => addition omega eta same,
  preservesScale := \fun (a: Reals.Real)(omega: Form k) => scalar a omega same,
};
\definition zero: \forall (same: k = l) -> cast Source.zero same = Target.zero :=
  \fun (same: k = l) => #preservesZero{(map same)};
\import Equality.Transport[A := N.Nat^, F := Form] \as Transport;
\definition composition: \forall (m: N.Nat^)(omega: Form k)(kl: k = l)(lm: l = m) ->
  \parent.Regrade[k := l, l := m].cast (cast omega kl) lm =
    \parent.Regrade[k := k, l := m].cast omega (trans!{{N.Nat^}} k l m kl lm) :=
  \fun (m: N.Nat^)(omega: Form k)(kl: k = l)(lm: l = m) => Transport.composition k l m omega kl lm;
