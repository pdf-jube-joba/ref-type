\import \parent.Regrade[k := k, l := k] \as Degree;
\definition law: \forall (omega: Form k)(same: k = k) -> Degree.cast omega same = omega :=
  \fun (omega: Form k)(same: k = k) => ext k (Degree.cast omega same) omega
    (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].RegradeIdentity[k := k].law (omega chart) same);
