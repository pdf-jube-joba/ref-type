\import Euclidean.On[U := Transition.domain].Wedge[p := p, q := q] \as Product;
\import Euclidean.On[U := #image{left}].Wedge[p := p, q := q] \as Left;
\import Euclidean.On[U := #image{right}].Wedge[p := p, q := q] \as Right;
\definition family(omega: Family p)(eta: Family q): Family (Nat.add p q) :=
  \fun (chart: Chart) => Euclidean.On[U := #image{chart}].Wedge[p := p, q := q].apply (omega chart) (eta chart);
\definition law: \forall (omega: Family p)(eta: Family q) -> Agreement p omega -> Agreement q eta -> Agreement (Nat.add p q) (family omega eta) :=
  \fun (omega: Family p)(eta: Family q)(first: Agreement p omega)(second: Agreement q eta) =>
    trans!{{Euclidean.LocalForm Transition.domain (Nat.add p q)}} (restrict (Nat.add p q) (family omega eta))
      (Product.apply (restrict p omega) (restrict q eta)) (transport (Nat.add p q) (family omega eta))
      (Restriction.Product[p := p, q := q].law included (omega left) (eta left))
      (trans!{{Euclidean.LocalForm Transition.domain (Nat.add p q)}} (Product.apply (restrict p omega) (restrict q eta))
        (Product.apply (transport p omega) (transport q eta)) (transport (Nat.add p q) (family omega eta))
        (congr2!{{Euclidean.LocalForm Transition.domain p} {Euclidean.LocalForm Transition.domain q} {Euclidean.LocalForm Transition.domain (Nat.add p q)}} Product.apply
          (restrict p omega) (transport p omega) (restrict q eta) (transport q eta) first second)
        (sym!{{Euclidean.LocalForm Transition.domain (Nat.add p q)}} (transport (Nat.add p q) (family omega eta))
          (Product.apply (transport p omega) (transport q eta)) (Pullback.Product[p := p, q := q].law (omega right) (eta right))));
