\import \parent.At[k := k] \as Forms;
\import N.Basic[].Prop[] \as Naturals;
\definition zero: \forall (large: Naturals.Lt n k)(omega: Form k) -> omega = Forms.zero :=
  \fun (large: Naturals.Lt n k)(omega: Form k) => ext k omega Forms.zero
    (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].Above[k := k].zero large (omega chart));
