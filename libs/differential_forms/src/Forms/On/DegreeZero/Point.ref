
\import Tangent.At[x := x] \as Tangent;
\import Spaces.Multilinear[V := Tangent.Vector, space := Tangent.space].Alternating[].DegreeZero[] \as Scalars;
\definition constant: Reals.Real -> PointForm zero x := Scalars.constant;
\definition evaluate: PointForm zero x -> Reals.Real := #apply{Scalars.evaluate};
\definition recover: \forall (f: PointForm zero x) -> constant (evaluate f) = f := #rightInverse{Scalars.isomorphism};
