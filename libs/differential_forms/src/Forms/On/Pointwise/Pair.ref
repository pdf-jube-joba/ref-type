
\import \parent.\parent.Pair[left := left, right := right] \as Overlap;
\import Charts.Transition[left := left, right := right] \as Transition;
\import \parent.Coordinates[chart := left] \as Left;
\import \parent.Coordinates[chart := right] \as Right;
\import Euclidean.On[U := Transition.domain] \as LocalForms;
\module At(a: Open.Carrier Transition.domain);
\definition law: \forall (phi: RegularPointFamily) -> Overlap.Agreement k (coordinateFamily phi) :=
  \fun (phi: RegularPointFamily) => LocalForms.ext k (Overlap.restrict k (coordinateFamily phi)) (Overlap.transport k (coordinateFamily phi))
    (\fun (a: Open.Carrier Transition.domain)(arguments: Multilinear.Arguments k) => At[a := a].law phi arguments);
