
\import \parent.At[x := x] \as Point;
\import Tangent.At[x := x] \as Tangent;
\import Spaces.Multilinear[V := Tangent.Vector, space := Tangent.space] \as Arguments;
\definition law: \forall (phi: RegularPointFamily) -> value (fromPointwise phi) x = phi x := \block {
  \fun (phi: RegularPointFamily) \then
  \takefrom chart: Tangent.Chart \by Tangent.chartExists \then
  \let global: Chart := Point.globalChart chart \then
  \return \axiom:funext(value (fromPointwise phi) x, phi x, \fun (arguments: Arguments.Arguments k) =>
    trans!{{Reals.Real}} (value (fromPointwise phi) x arguments) (Point.ofChart (fromPointwise phi) chart arguments) (phi x arguments)
      (congr!{{PointForm k x} {Reals.Real}} (\fun (f: PointForm k x) => f arguments)
        (value (fromPointwise phi) x) (Point.ofChart (fromPointwise phi) chart) (Point.inChart (fromPointwise phi) chart))
      (trans!{{Reals.Real}} (Point.ofChart (fromPointwise phi) chart arguments)
        (Point.pointCoordinates phi chart (\fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].decode (arguments slot))) (phi x arguments)
        (\parent.Coordinates[chart := global].inChart phi (Tangent.localPoint chart) (\fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].decode (arguments slot)))
        (congr!{{Arguments.Arguments k} {Reals.Real}} (phi x)
          (\fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].encode (Tangent.Coordinate[chart := chart].decode (arguments slot))) arguments
          (\axiom:funext((\fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].encode (Tangent.Coordinate[chart := chart].decode (arguments slot))), arguments,
            \fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].encodeDecode (arguments slot))))))
};
