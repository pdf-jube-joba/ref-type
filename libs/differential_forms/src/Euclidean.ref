\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import N.Basic[].Def[] \as Nat;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;
\import calculus.Real[] \as Reals;
\import Reals.Multivariable[n := n].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Operations;
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Reals.Real, field := Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\import Multilinear.Alternating[] \as Alternating;
\import Spaces.Exterior[V := Vectors.Vector, space := Vectors.space] \as Exterior;
\import Spaces.Shuffle[I := Vectors.Vector] \as Shuffle;
\import Spaces.FiniteCoordinates[n := n] \as Basis;
\import Alternating.Finite[I := Fin.Fin n, b := Basis.basis] \as Coefficients;
\import algebra.Module[].Over[R := Reals.Real, ring := Spaces.ring] \as Modules;
\module On(U: Open.OpenSet);
\definition LocalForm(U: Open.OpenSet)(k: N.Nat^): \Set := On[U := U].Form k;
\module Covector(i: Fin.Fin n);
\module Evaluation(m: N.Nat^, U: Reals.OpenSpace m);
\definition SmoothMap(m: N.Nat^)(U: Reals.OpenSpace n)(V: Reals.OpenSpace m): \Set := calculus.Maps[n := n, m := m].Map U V;
\module Pullback(m: N.Nat^, U: Reals.OpenSpace n, V: Reals.OpenSpace m, f: SmoothMap m U V);
\module Restriction(U, V: Open.OpenSet);
\module Gluing(k: N.Nat^, I: \Set, U: Open.OpenSet, domains: I -> Open.OpenSet, forms: \forall (i: I) -> LocalForm (domains i) k);
\module Identity(U: Open.OpenSet);
