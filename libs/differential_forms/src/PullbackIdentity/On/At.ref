\import Pullback.At[k := k] \as Map;
\import Forms.Pointwise[k := k] \as Pointwise;
\definition law: \forall (omega: Forms.Form k) -> Map.apply omega = omega :=
  \fun (omega: Forms.Form k) => Pointwise.Algebra[].injective (Map.apply omega) omega
    (\axiom:funext(Pointwise.value (Map.apply omega), Pointwise.value omega,
      \fun (x: M.Point) => \axiom:funext(Pointwise.value (Map.apply omega) x, Pointwise.value omega x,
        \fun (arguments: Fin.Fin k -> Tangent.Vector x) => trans!{{Reals.Real}} _
          (Pointwise.value omega x (\fun (i: Fin.Fin k) =>
            #apply{(Differential.At[f := Identity.map, x := x].value)} (arguments i))) _
          (Map.formula omega x arguments)
          (congr!{{Fin.Fin k -> Tangent.Vector x} {Reals.Real}} (Pointwise.value omega x) _ _
            (\axiom:funext((\fun (i: Fin.Fin k) =>
              #apply{(Differential.At[f := Identity.map, x := x].value)} (arguments i)), arguments,
              \fun (i: Fin.Fin k) => DifferentialIdentity.At[x := x].pointwise (arguments i)))))));
\import Forms.DeRham[] \as DeRham;
\import homological_algebra.Cochain[].Over[R := Reals.Real, ring := linear_algebra.Field[].Space[K := Reals.Real, field := Reals.Algebra[].field].ring].At[C := DeRham.complex, k := k] \as Cohomology;
\import Pullback.DeRham[].At[k := k] \as Induced;
\definition cohomologyLaw: \forall (h: DeRham.Cohomology k) -> Induced.apply h = h :=
  Cohomology.classInduction (\fun (h: DeRham.Cohomology k) => Induced.apply h = h)
    (\fun (omega: Cohomology.CycleCarrier) => trans!{{DeRham.Cohomology k}} _
      (Cohomology.classOf (Induced.cycle omega)) _ (Induced.onClass omega)
      (congr!{{Cohomology.CycleCarrier} {DeRham.Cohomology k}} Cohomology.classOf (Induced.cycle omega) omega (law omega)));
