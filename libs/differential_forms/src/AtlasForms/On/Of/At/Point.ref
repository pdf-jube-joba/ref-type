\import Tangent.At[x := x] \as Tangent;
\import Spaces.Multilinear[V := Tangent.Vector, space := Tangent.space] \as TangentMultilinear;
\import TangentMultilinear.Alternating[] \as Alternating;
\import Alternating.Precomposition[W := Vectors.Vector, target := Vectors.space] \as Precomposition;
\definition LocalChart: \Set := \Cast[Tangent.Chart] ({ chart: Tangent.Chart \where Atlases.Member atlas chart });
\definition chartExists: \exists LocalChart := \block {
  \takefrom chart: \Cast[Charts.Chart] ({ c: Charts.Chart \where Logic.And[Atlases.Member atlas c, Charts.Contains c x] }) \by #covers{atlas} x \then
  \let witness: Logic.And[Atlases.Member atlas chart, Charts.Contains chart x] :=
    \bysub(Charts.Chart, { c: Charts.Chart \where Logic.And[Atlases.Member atlas c, Charts.Contains c x] }, chart) \then
  \let ambient: Tangent.Chart := \into[Charts.Chart](chart, Tangent.Chart) \by {
    Tangent.ChartLaws[chart] { member := included chart (#left{witness}), contains := #right{witness} }
  } \then
  \return \exact(\into[Tangent.Chart](ambient, LocalChart) \by { #left{witness} }, LocalChart)
};
\definition globalChart(chart: LocalChart): Chart := \into[Charts.Chart](chart, #charts{atlas}) \by {
  \bysub(Tangent.Chart, LocalChart, chart)
};
\definition coordinateMap(chart: LocalChart): Spaces.Linear[V := Tangent.Vector, W := Vectors.Vector, source := Tangent.space, target := Vectors.space].Map :=
  Tangent.ChartIsomorphism[chart := chart].forward;
\definition ofChart(omega: Form k)(chart: LocalChart): Global.PointForm k x := Precomposition.precompose k (coordinateMap chart) (omega (globalChart chart) (Tangent.coordinate chart));
\definition pointCoordinates(phi: Global.PointFamily k)(chart: LocalChart): Multilinear.Alternating[].Form k :=
  Multilinear.Alternating[].Precomposition[W := Tangent.Vector, target := Tangent.space].precompose k
    (Tangent.ChartIsomorphism[chart := chart].backward) (phi x);
\module Pair(left, right: LocalChart);
\definition independent: \forall (omega: Form k)(left, right: LocalChart) -> ofChart omega left = ofChart omega right :=
  \fun (omega: Form k)(left, right: LocalChart) => Pair[left := left, right := right].law omega;
\definition Values(omega: Form k): \Pow (Global.PointForm k x) := { f: Global.PointForm k x \where \forall (chart: LocalChart) -> f = ofChart omega chart };
\definition ValueType(omega: Form k): \Set := \Cast[Global.PointForm k x] (Values omega);
\definition exists: \forall (omega: Form k) -> \exists ValueType omega := \block {
  \fun (omega: Form k) \then
  \takefrom chart: LocalChart \by chartExists \then
  \return \exact(\into[Global.PointForm k x](ofChart omega chart, Values omega) \by {
    \fun (other: LocalChart) => independent omega chart other
  }, ValueType omega)
};
\definition unique: \forall (omega: Form k)(f, g: ValueType omega) -> f = g := \block {
  \fun (omega: Form k)(f, g: ValueType omega) \then
  \takefrom chart: LocalChart \by chartExists \then
  \return trans!{{Global.PointForm k x}} f (ofChart omega chart) g
    ((\bysub(Global.PointForm k x, Values omega, f)) chart)
    (sym!{{Global.PointForm k x}} g (ofChart omega chart) ((\bysub(Global.PointForm k x, Values omega, g)) chart))
};
\definition value(omega: Form k): Global.PointForm k x := \choice ValueType omega \by { existence: exists omega, uniqueness: unique omega };
\definition inChart: \forall (omega: Form k)(chart: LocalChart) -> value omega = ofChart omega chart :=
  \fun (omega: Form k)(chart: LocalChart) => (\bysub(Global.PointForm k x, Values omega, (\choice ValueType omega \by { existence: exists omega, uniqueness: unique omega }))) chart;

\definition roundtrip(chart: LocalChart)(arguments: Multilinear.Arguments k): Multilinear.Arguments k :=
  \fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].decode (Tangent.Coordinate[chart := chart].encode (arguments slot));
\definition roundtripLaw: \forall (chart: LocalChart)(arguments: Multilinear.Arguments k) -> roundtrip chart arguments = arguments :=
  \fun (chart: LocalChart)(arguments: Multilinear.Arguments k) => \axiom:funext(roundtrip chart arguments, arguments,
    \fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].decodeEncode (arguments slot));

\definition recover: \forall (omega: Form k)(chart: LocalChart) -> pointCoordinates (\fun (point: M.Point) => \parent.Point[x := point].value omega) chart = omega (globalChart chart) (Tangent.coordinate chart) :=
  \fun (omega: Form k)(chart: LocalChart) => \axiom:funext(pointCoordinates (\fun (point: M.Point) => \parent.Point[x := point].value omega) chart,
    omega (globalChart chart) (Tangent.coordinate chart), \fun (arguments: Multilinear.Arguments k) =>
      trans!{{Reals.Real}}
        (pointCoordinates (\fun (point: M.Point) => \parent.Point[x := point].value omega) chart arguments)
        (ofChart omega chart (\fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].encode (arguments slot)))
        (omega (globalChart chart) (Tangent.coordinate chart) arguments)
        (congr!{{Global.PointForm k x} {Reals.Real}} (\fun (f: Global.PointForm k x) => f (\fun (slot: Fin.Fin k) => Tangent.Coordinate[chart := chart].encode (arguments slot)))
          (value omega) (ofChart omega chart) (inChart omega chart))
        (congr!{{Multilinear.Arguments k} {Reals.Real}} (omega (globalChart chart) (Tangent.coordinate chart))
          (roundtrip chart arguments) arguments (roundtripLaw chart arguments)));
