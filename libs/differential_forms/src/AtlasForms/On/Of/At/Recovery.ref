\import Pointwise.Coordinates[chart := globalChart chart] \as Coordinates;
\import Charts.Of[chart := chart] \as Geometry;
\definition smallPoint(p: Charts.LocalPoint chart): \parent.Point[x := p].LocalChart :=
  \into[Tangent.At[x := p].Chart](Coordinates.lift p, \parent.Point[x := p].LocalChart) \by { member chart };
\definition recover: \forall (omega: Form k) -> Coordinates.family (value omega) = omega chart :=
  \fun (omega: Form k) => \axiom:funext(Coordinates.family (value omega), omega chart,
    \fun (a: Open.Carrier #image{chart}) => trans!{{Multilinear.Alternating[].Form k}} _
      (omega chart (Charts.coordinate chart (Charts.point chart a))) _
      (\parent.Point[x := Charts.point chart a].recover omega (smallPoint (Charts.point chart a)))
      (congr!{{Open.Carrier #image{chart}} {Multilinear.Alternating[].Form k}} (omega chart) _ _ (Geometry.coordinatePoint a)));
\definition law: \forall (omega: Form k) -> restrict (extend omega) chart = omega chart :=
  \fun (omega: Form k) => trans!{{Euclidean.On[U := #image{chart}].Family k}} _ (Coordinates.family (Pointwise.value (extend omega))) _
    (sym!{{Euclidean.On[U := #image{chart}].Family k}} _ _ (Coordinates.recover (extend omega)))
    (trans!{{Euclidean.On[U := #image{chart}].Family k}} _ (Coordinates.family (value omega)) _
      (congr!{{Global.PointFamily k} {Euclidean.On[U := #image{chart}].Family k}} Coordinates.family _ _ (evaluation omega))
      (recover omega));
