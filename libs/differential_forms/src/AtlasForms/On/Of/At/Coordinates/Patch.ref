\import Charts.Transition[left := chart, right := right] \as Transition;
\import Global.Pair[left := chart, right := globalChart right] \as Overlap;
\import Euclidean.Pullback[m := n, U := Transition.domain, V := #image{right}, f := Overlap.transition] \as Pullback;
\import Euclidean.On[U := Transition.domain] \as Restricted;
\module At(a: Open.Carrier Transition.domain);
\definition agreement: \forall (omega: Form k)(a: Open.Carrier Transition.domain)(arguments: Multilinear.Arguments k) ->
  Coordinates.family (value omega) (Transition.leftCoordinate a) arguments = Pullback.apply k (omega right) a arguments :=
    \fun (omega: Form k)(a: Open.Carrier Transition.domain)(arguments: Multilinear.Arguments k) => At[a := a].agreement omega arguments;
\definition regular: \forall (omega: Form k)(arguments: Multilinear.Arguments k) -> Open.Smooth[].SmoothOn Transition.domain
  (\fun (a: Open.Carrier Transition.domain) => Coordinates.family (value omega) (Transition.leftCoordinate a) arguments) :=
    \fun (omega: Form k)(arguments: Multilinear.Arguments k) => Restricted.smoothOfEqual
      (\fun (a: Open.Carrier Transition.domain) => Pullback.apply k (omega right) a arguments)
      (\fun (a: Open.Carrier Transition.domain) => Coordinates.family (value omega) (Transition.leftCoordinate a) arguments)
      (\fun (a: Open.Carrier Transition.domain) => sym!{{Reals.Real}} _ _ (agreement omega a arguments))
      (Pullback.regular k (omega right) arguments);
