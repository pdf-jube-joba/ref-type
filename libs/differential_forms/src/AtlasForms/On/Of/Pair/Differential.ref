
\definition next: N.Nat^ := N.Nat^::succ k;
\import Euclidean.On[U := Transition.domain].ExteriorDerivative[k := k] \as D;
\import Restriction.Differential[k := k] \as Restricted;
\import Pullback.Naturality[k := k] \as Pulled;
\definition family(omega: Family k): Family next :=
  \fun (chart: Chart) => Euclidean.On[U := #image{chart}].ExteriorDerivative[k := k].apply (omega chart);
\definition law: \forall (omega: Family k) -> Agreement k omega -> Agreement next (family omega) :=
  \fun (omega: Family k)(agreement: Agreement k omega) => eq_reason!{
    {restrict next (family omega)}
    "=" {D.apply (restrict k omega)} "by" {
      sym!{{Euclidean.LocalForm Transition.domain next}} (D.apply (restrict k omega)) (restrict next (family omega)) (Restricted.law included (omega left))}
    "=" {D.apply (transport k omega)} "by" {
      congr!{{Euclidean.LocalForm Transition.domain k} {Euclidean.LocalForm Transition.domain next}} D.apply (restrict k omega) (transport k omega) agreement}
    "=" {transport next (family omega)} "by" {Pulled.law (omega right)}
  };
