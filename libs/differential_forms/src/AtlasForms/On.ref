\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import real.Analysis[] \as Reals;
\import Reals.Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Reals.Real, field := Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import \root.Forms[n := n].On[M := M] \as Global;
\import \root.Euclidean[n := n] \as Euclidean;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import manifolds.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as Atlases;
\import manifolds.Tangent[n := n].On[M := M] \as Tangent;
\definition EmbeddedAtlas: \Set := \Cast[Atlases.Atlas] ({ atlas: Atlases.Atlas \where
  \forall (chart: Charts.Chart) -> Atlases.Member atlas chart -> Atlases.Member M.atlas chart });
\module Of(atlas: EmbeddedAtlas);
