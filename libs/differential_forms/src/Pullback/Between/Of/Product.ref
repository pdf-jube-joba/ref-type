\definition degree: Naturals.Nat^ := Naturals.Basic[].Def[].add p q;
\import \parent.At[k := p] \as First;
\import \parent.At[k := q] \as Second;
\import \parent.At[k := degree] \as Result;
\import SourceForms.Wedge[p := p, q := q] \as SourceProduct;
\import TargetForms.Wedge[p := p, q := q] \as TargetProduct;
\module Local(chart: SourceForms.Chart, right: TargetForms.Chart);
\definition law: \forall (omega: TargetForms.Form p)(eta: TargetForms.Form q) ->
  Result.apply (TargetProduct.apply omega eta) = SourceProduct.apply (First.apply omega) (Second.apply eta) :=
    \fun (omega: TargetForms.Form p)(eta: TargetForms.Form q) => Result.localExt _ _
      (\fun (chart: SourceForms.Chart)(right: TargetForms.Chart) => Local[chart := chart, right := right].law omega eta);
