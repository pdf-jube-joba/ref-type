\module AtPoint(k: Naturals.Nat^, x: M.Point) {
  \import manifolds.Differential[n := n, m := m].Between[M := M, N := N].At[f := f, x := x] \as Differential;
  \import Spaces.Multilinear[V := SourceTangent.Vector x, space := SourceTangent.space x].Alternating[] \as Alternating;
  \import Alternating.Precomposition[W := TargetTangent.Vector (Maps.apply f x), target := TargetTangent.space (Maps.apply f x)] \as Precomposition;
  \definition apply(omega: TargetForms.Form k): SourceForms.PointForm k x :=
    Precomposition.precompose k Differential.value (TargetForms.Pointwise[k := k].value omega (Maps.apply f x));
}
\definition pointwise(k: Naturals.Nat^)(omega: TargetForms.Form k): SourceForms.PointFamily k :=
  \fun (x: M.Point) => AtPoint[k := k, x := x].apply omega;
\module At(k: Naturals.Nat^);
\module Differential(k: Naturals.Nat^);
\module Product(p, q: Naturals.Nat^);
\module DeRham;
