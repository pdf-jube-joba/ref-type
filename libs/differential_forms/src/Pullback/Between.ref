\import std.Data[].Nat[] \as Naturals;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\import real.Analysis[] \as Reals;
\import Reals.Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Reals.Real, field := Algebra.field] \as Spaces;
\import \root.Forms[n := n].On[M := M] \as SourceForms;
\import \root.Forms[n := m].On[M := N] \as TargetForms;
\import manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import manifolds.Tangent[n := n].On[M := M] \as SourceTangent;
\import manifolds.Tangent[n := m].On[M := N] \as TargetTangent;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import manifolds.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Maps[n := n, m := m] \as Calculus;
\import Spaces.Coordinates[I := Fin.Fin n] \as SourceVectors;
\import Spaces.Coordinates[I := Fin.Fin m] \as TargetVectors;
\import Spaces.Multilinear[V := SourceVectors.Vector, space := SourceVectors.space] \as SourceMultilinear;
\module Of(f: Maps.Map);
