\import Original.At[k := k] \as OriginalForms;
\import Replacement.At[k := k] \as ReplacementForms;
\import Spaces.Isomorphism[V := Replacement.Form k, W := Original.Form k,
  source := ReplacementForms.space, target := OriginalForms.space] \as FormIsomorphisms;
\definition forms(same: SameCharts): FormIsomorphisms.Isomorphism :=
  Diffeomorphisms.Of[d := Presentation.diffeomorphism same].At[k := k].formsIsomorphism;
\import Original.DeRham[].At[k := k] \as OriginalH;
\import Replacement.DeRham[].At[k := k] \as ReplacementH;
\import Spaces.Isomorphism[V := ReplacementH.H, W := OriginalH.H,
  source := ReplacementH.vectorSpace, target := OriginalH.vectorSpace] \as CohomologyIsomorphisms;
\definition cohomology(same: SameCharts): CohomologyIsomorphisms.Isomorphism :=
  Diffeomorphisms.Of[d := Presentation.diffeomorphism same].At[k := k].cohomologyIsomorphism;
