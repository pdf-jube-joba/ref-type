\import \parent.\parent.Matrix[m := n, n := m] \as Reversed;
\definition transpose(a: Matrix): Reversed.Matrix := \fun (j: Finite.Fin n)(i: Finite.Fin m) => a i j;
\definition reverse(a: Reversed.Matrix): Matrix := \fun (i: Finite.Fin m)(j: Finite.Fin n) => a j i;
\definition involution: \forall (a: Matrix) -> reverse (transpose a) = a :=
  \fun (a: Matrix) => \axiom:funext(reverse (transpose a), a,
    \fun (i: Finite.Fin m) => \axiom:funext(reverse (transpose a) i, a i, \fun (j: Finite.Fin n) => \refl(a i j)));
\definition addition: \forall (a, b: Matrix) -> transpose (add a b) = Reversed.add (transpose a) (transpose b) :=
  \fun (a, b: Matrix) => \axiom:funext(transpose (add a b), Reversed.add (transpose a) (transpose b),
    \fun (j: Finite.Fin n) => \axiom:funext(transpose (add a b) j, Reversed.add (transpose a) (transpose b) j,
      \fun (i: Finite.Fin m) => \refl(#add{ordinaryRing} (a i j) (b i j))));

\module Composition(k: N.Nat^);

\module Identity(k: N.Nat^);
