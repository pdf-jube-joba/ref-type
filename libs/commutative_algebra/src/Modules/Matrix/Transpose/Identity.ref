\import \parent.\parent.\parent.Matrix[m := k, n := k] \as Square;
\import Square.End[] \as End;
\import Square.Transpose[] \as Transpose;
\import Modules.Coordinates[I := Finite.Fin k].Kronecker[] \as Kronecker;
\definition law: Transpose.transpose End.identity = End.identity :=
  \axiom:funext(Transpose.transpose End.identity, End.identity,
    \fun (i: Finite.Fin k) => \axiom:funext(Transpose.transpose End.identity i, End.identity i,
      \fun (j: Finite.Fin k) => Kronecker.symmetric j i));
