\import \parent.Tensor[V := P.Carrier, W := Q.Carrier, left := P.space, right := Q.space] \as Product;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Product.Carrier, space := Product.space };
\module Lift(A, B: Modules.Bundle,
  q: Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Map,
  f: Modules.Hom[V := Product.Carrier, W := B.Carrier, source := Product.space, target := B.space].Map);
\definition projective: Modules.Projective P -> Modules.Projective Q -> Modules.Projective bundle :=
  \fun (left: Modules.Projective P)(right: Modules.Projective Q)(A, B: Modules.Bundle)
    (q: Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Map)
    (onto: Modules.Surjective A B q)
    (f: Modules.Hom[V := Product.Carrier, W := B.Carrier, source := Product.space, target := B.space].Map) =>
    Lift[A := A, B := B, q := q, f := f].existence left right onto;
