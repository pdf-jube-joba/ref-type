\import \parent.FreeTensor[Generators := Generators, W := A.Carrier, target := A.space] \as Source;
\import \parent.FreeTensor[Generators := Generators, W := B.Carrier, target := B.space] \as Target;
\import Modules.Free[Generators := Generators] \as Free;
\import Modules.Tensor[V := Free.Carrier, W := A.Carrier, left := Free.space, right := A.space] \as SourceTensor;
\import Modules.Tensor[V := Free.Carrier, W := B.Carrier, left := Free.space, right := B.space] \as TargetTensor;
\import Modules.DirectSum[Index := Generators, family := Source.family] \as SourceSum;
\import Modules.DirectSum[Index := Generators, family := Target.family] \as TargetSum;
\import Modules.DirectSumMapping[Index := Generators, sourceFamily := Source.family, targetFamily := Target.family] \as SumMapping;
\import SourceTensor.Mapping[U := Free.Carrier, Z := B.Carrier, targetLeft := Free.space, targetRight := B.space] \as TensorMapping;
\import Modules.End[V := Free.Carrier, space := Free.space] \as FreeEnd;
\module On(f: Modules.MapBetween A B);
