/* The numerical distance packaged as a metric space. */
\import real.Analysis[] \as Real;
\import Real.Distance[] \as Distance;
\import metric_spaces.MetricSpace[Carrier := Real.Real] \as M;

\definition metric: M.Metric := M.Metric {
  distance := Distance.distance,
  nonnegative := Distance.distanceNonnegative,
  self := Distance.distanceSelf,
  separated := Distance.distanceSeparated,
  symmetric := Distance.distanceSymmetric,
  triangle := Distance.distanceTriangle,
};
