\import Line.CompactExtrema[] \as Extrema;
\import topology.Compactness[A := A, B := Real.Real] \as CompactImages;
\import R.Completeness[] \as Complete;
\structure Maximum[S: \Pow A, f: A -> Real.Real, a: A]: \Prop {
  member: Source.Member S a,
  upper: \forall (x: A) -> Source.Member S x -> R.Le (f x) (f a),
}
\structure Minimum[S: \Pow A, f: A -> Real.Real, a: A]: \Prop {
  member: Source.Member S a,
  lower: \forall (x: A) -> Source.Member S x -> R.Le (f a) (f x),
}
\definition maximum: \forall (source: Source.Topology)(S: \Pow A)(f: A -> Real.Real) ->
  (\exists \Cast[A] S) -> Source.IsCompactIn source S -> Continuous source f ->
  \exists { a: A \where Maximum[S, f, a] } := \block {
  \fun (source: _)(S: _)(f: _)(nonempty: _)(compact: _)(continuous: _) \then
  \let image: \Pow Real.Real := GeneralMaps.Image f S \then
  \let inhabited: Complete.Nonempty image := \block {
    \takefrom x: \Cast[A] S \by nonempty \then
    \return \exact(\into[Real.Real](f x, image) \by { GeneralMaps.imageMember f S x (\bysub(A, S, x)) }, \Cast[Real.Real] image)
  } \then
  \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Extrema.Maximum[image, b] })
    \by Extrema.compactMaximum image inhabited (CompactImages.continuousImage source Line.topology f continuous S compact) \then
  \let extremum: Extrema.Maximum[image, b] := \bysub(Real.Real, { b: Real.Real \where Extrema.Maximum[image, b] }, b) \then
  \return GeneralMaps.imageElim f S b (\exists { a: A \where Maximum[S, f, a] })
    (\fun (a: A)(member: Source.Member S a)(equal: f a = b) => \exact(\into[A](a,
      { a: A \where Maximum[S, f, a] }) \by {
        Maximum[S, f, a] {
          member := member,
          upper := \fun (x: A)(inS: Source.Member S x) => R.leReplaceRight (f x) b (f a) (sym!{Real.Real} _ _ equal)
            (#upper{extremum} (f x) (GeneralMaps.imageMember f S x inS)),
        }
      }, \Cast[A] ({ a: A \where Maximum[S, f, a] }))) (#member{extremum})
};
\definition minimum: \forall (source: Source.Topology)(S: \Pow A)(f: A -> Real.Real) ->
  (\exists \Cast[A] S) -> Source.IsCompactIn source S -> Continuous source f ->
  \exists { a: A \where Minimum[S, f, a] } := \block {
  \fun (source: _)(S: _)(f: _)(nonempty: _)(compact: _)(continuous: _) \then
  \takefrom a: \Cast[A] ({ a: A \where Maximum[S, (\fun (x: A) => Real.neg (f x)), a] })
    \by maximum source S (\fun (x: A) => Real.neg (f x)) nonempty compact (negContinuous source f continuous) \then
  \let extremum: Maximum[S, (\fun (x: A) => Real.neg (f x)), a] :=
    \bysub(A, { a: A \where Maximum[S, (\fun (x: A) => Real.neg (f x)), a] }, a) \then
  \return \exact(\into[A](a, { a: A \where Minimum[S, f, a] }) \by {
    Minimum[S, f, a] {
      member := #member{extremum},
      lower := \fun (x: A)(member: Source.Member S x) => R.leReplace _ _ _ _ (Laws.negInvolutive (f a)) (Laws.negInvolutive (f x))
        (Laws.negAntitone (Real.neg (f x)) (Real.neg (f a)) (#upper{extremum} x member)),
    }
  }, \Cast[A] ({ a: A \where Minimum[S, f, a] }))
};
