\definition composeCong: \forall (x, y, z: C.Object) ->
  \forall (g, g2: C.Hom y z) -> \forall (f, f2: C.Hom x y) ->
  g = g2 -> f = f2 -> C.structure.compose x y z g f = C.structure.compose x y z g2 f2 :=
  \fun (x, y, z: _) => congr2!{{C.Hom y z} {C.Hom x y} {C.Hom x z}} (C.structure.compose x y z);

\definition cancelIdentity: \forall (x: C.Object) ->
  C.structure.compose x x x (C.structure.identity x) (C.structure.identity x) = C.structure.identity x :=
  \fun (x: _) => C.laws.leftIdentity x x (C.structure.identity x);
