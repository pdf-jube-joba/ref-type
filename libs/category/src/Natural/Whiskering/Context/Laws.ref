\definition precomposeIdentity: \forall (F: Functors.Functor D E) -> \forall (K: Functors.Functor C D) ->
  precomposeFamily F F (Vertical.identityFamily D E F) K =
    (\fun (u: C.Object) => E.structure.identity (F.object (K.object u))) :=
  \fun (F: Functors.Functor D E) (K: Functors.Functor C D) =>
    \axiom:funext(precomposeFamily F F (Vertical.identityFamily D E F) K,
      \fun (u: C.Object) => E.structure.identity (F.object (K.object u)),
      \fun (u: C.Object) => \refl(E.structure.identity (F.object (K.object u))));

\definition precomposeCompose: \forall (F, G, H: Functors.Functor D E) ->
  \forall (b: Family D E G H) -> \forall (a: Family D E F G) -> \forall (K: Functors.Functor C D) ->
  precomposeFamily F H (Vertical.composeFamily D E F G H b a) K =
    (\fun (u: C.Object) => E.structure.compose (F.object (K.object u)) (G.object (K.object u)) (H.object (K.object u)) (b (K.object u)) (a (K.object u))) :=
  \fun (F, G, H: Functors.Functor D E) (b: Family D E G H) (a: Family D E F G) (K: Functors.Functor C D) =>
    \axiom:funext(precomposeFamily F H (Vertical.composeFamily D E F G H b a) K,
      \fun (u: C.Object) => E.structure.compose (F.object (K.object u)) (G.object (K.object u)) (H.object (K.object u))
        (b (K.object u)) (a (K.object u)),
      \fun (u: C.Object) => \refl(E.structure.compose (F.object (K.object u)) (G.object (K.object u)) (H.object (K.object u)) (b (K.object u)) (a (K.object u))));

\definition postcomposeIdentity: \forall (F: Functors.Functor C D) -> \forall (H: Functors.Functor D E) ->
  postcomposeFamily F F H (Vertical.identityFamily C D F) =
    (\fun (u: C.Object) => E.structure.identity (H.object (F.object u))) :=
  \fun (F: Functors.Functor C D) (H: Functors.Functor D E) =>
    \axiom:funext(postcomposeFamily F F H (Vertical.identityFamily C D F),
      \fun (u: C.Object) => E.structure.identity (H.object (F.object u)),
      \fun (u: C.Object) => H.mapIdentity (F.object u));

\definition postcomposeCompose: \forall (F, G, H: Functors.Functor C D) ->
  \forall (K: Functors.Functor D E) -> \forall (b: Family C D G H) -> \forall (a: Family C D F G) ->
  postcomposeFamily F H K (Vertical.composeFamily C D F G H b a) =
    (\fun (u: C.Object) => E.structure.compose (K.object (F.object u)) (K.object (G.object u)) (K.object (H.object u))
      (K.map (G.object u) (H.object u) (b u)) (K.map (F.object u) (G.object u) (a u))) :=
  \fun (F, G, H: Functors.Functor C D) (K: Functors.Functor D E) (b: Family C D G H) (a: Family C D F G) =>
    \axiom:funext(postcomposeFamily F H K (Vertical.composeFamily C D F G H b a),
      \fun (u: C.Object) => E.structure.compose (K.object (F.object u)) (K.object (G.object u)) (K.object (H.object u))
        (K.map (G.object u) (H.object u) (b u)) (K.map (F.object u) (G.object u) (a u)),
      \fun (u: C.Object) => K.mapCompose (F.object u) (G.object u) (H.object u) (b u) (a u));
