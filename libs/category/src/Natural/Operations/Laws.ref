\definition leftIdentity: \forall (F, G: Functors.Functor C D) ->
  \forall (a: Family C D F G) -> composeFamily C D F G G (identityFamily C D G) a = a :=
  \fun (F, G: Functors.Functor C D) (a: Family C D F G) =>
    \axiom:funext(composeFamily C D F G G (identityFamily C D G) a, a,
      \fun (u: C.Object) => D.laws.leftIdentity (F.object u) (G.object u) (a u));

\definition rightIdentity: \forall (F, G: Functors.Functor C D) ->
  \forall (a: Family C D F G) -> composeFamily C D F F G a (identityFamily C D F) = a :=
  \fun (F, G: Functors.Functor C D) (a: Family C D F G) =>
    \axiom:funext(composeFamily C D F F G a (identityFamily C D F), a,
      \fun (u: C.Object) => D.laws.rightIdentity (F.object u) (G.object u) (a u));

\definition associative: \forall (F, G, H, I: Functors.Functor C D) ->
  \forall (c: Family C D H I) -> \forall (b: Family C D G H) ->
  \forall (a: Family C D F G) ->
  composeFamily C D F H I c (composeFamily C D F G H b a) =
    composeFamily C D F G I (composeFamily C D G H I c b) a :=
  \fun (F, G, H, I: Functors.Functor C D) (c: Family C D H I)
    (b: Family C D G H) (a: Family C D F G) =>
    \axiom:funext(composeFamily C D F H I c (composeFamily C D F G H b a),
      composeFamily C D F G I (composeFamily C D G H I c b) a,
      \fun (u: C.Object) => D.laws.associative (F.object u) (G.object u) (H.object u) (I.object u) (c u) (b u) (a u));
