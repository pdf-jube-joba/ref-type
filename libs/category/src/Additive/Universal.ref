\import Pre.Over[P := P] \as Operations;
\definition reconstruct(z: P.category.Object)(f: P.category.Hom z B.object):
  f = Operations.add z B.object
    (P.category.structure.compose z x B.object B.firstInjection (P.category.structure.compose z B.object x B.firstProjection f))
    (P.category.structure.compose z y B.object B.secondInjection (P.category.structure.compose z B.object y B.secondProjection f)) := eq_reason!{
  f "=" {P.category.structure.compose z B.object B.object (P.category.structure.identity B.object) f}
  "by" {sym!{{P.category.Hom z B.object}} _ _ (P.category.laws.leftIdentity z B.object f)}
  "=" {P.category.structure.compose z B.object B.object
    (Operations.add B.object B.object (P.category.structure.compose B.object x B.object B.firstInjection B.firstProjection)
      (P.category.structure.compose B.object y B.object B.secondInjection B.secondProjection)) f}
  "by" {congr!{{P.category.Hom B.object B.object} {P.category.Hom z B.object}}
    (\fun (t: P.category.Hom B.object B.object) => P.category.structure.compose z B.object B.object t f) _ _
    (sym!{{P.category.Hom B.object B.object}} _ _ (#reconstruction{B}))}
  "=" {Operations.add z B.object
    (P.category.structure.compose z B.object B.object (P.category.structure.compose B.object x B.object B.firstInjection B.firstProjection) f)
    (P.category.structure.compose z B.object B.object (P.category.structure.compose B.object y B.object B.secondInjection B.secondProjection) f)}
  "by" {P.composeLeft z B.object B.object (P.category.structure.compose B.object x B.object B.firstInjection B.firstProjection)
    (P.category.structure.compose B.object y B.object B.secondInjection B.secondProjection) f}
  "=" {Operations.add z B.object
    (P.category.structure.compose z x B.object B.firstInjection (P.category.structure.compose z B.object x B.firstProjection f))
    (P.category.structure.compose z y B.object B.secondInjection (P.category.structure.compose z B.object y B.secondProjection f))}
  "by" {congr2!{{P.category.Hom z B.object} {P.category.Hom z B.object} {P.category.Hom z B.object}} (Operations.add z B.object) _ _ _ _
    (sym!{{P.category.Hom z B.object}} _ _ (P.category.laws.associative z B.object x B.object B.firstInjection B.firstProjection f))
    (sym!{{P.category.Hom z B.object}} _ _ (P.category.laws.associative z B.object y B.object B.secondInjection B.secondProjection f))}
};
\definition projectionsExt: \forall (z: P.category.Object)(f, g: P.category.Hom z B.object) ->
  P.category.structure.compose z B.object x B.firstProjection f = P.category.structure.compose z B.object x B.firstProjection g ->
  P.category.structure.compose z B.object y B.secondProjection f = P.category.structure.compose z B.object y B.secondProjection g -> f = g :=
  \fun (z: P.category.Object)(f, g: P.category.Hom z B.object)(first: _)(second: _) => trans!{{P.category.Hom z B.object}} _ _ _ (reconstruct z f)
    (trans!{{P.category.Hom z B.object}} _ _ _
      (congr2!{{P.category.Hom z B.object} {P.category.Hom z B.object} {P.category.Hom z B.object}} (Operations.add z B.object) _ _ _ _
        (congr!{{P.category.Hom z x} {P.category.Hom z B.object}} (P.category.structure.compose z x B.object B.firstInjection) _ _ first)
        (congr!{{P.category.Hom z y} {P.category.Hom z B.object}} (P.category.structure.compose z y B.object B.secondInjection) _ _ second))
      (sym!{{P.category.Hom z B.object}} _ _ (reconstruct z g)));
\definition coreconstruct(z: P.category.Object)(f: P.category.Hom B.object z):
  f = Operations.add B.object z
    (P.category.structure.compose B.object x z (P.category.structure.compose x B.object z f B.firstInjection) B.firstProjection)
    (P.category.structure.compose B.object y z (P.category.structure.compose y B.object z f B.secondInjection) B.secondProjection) := eq_reason!{
  f "=" {P.category.structure.compose B.object B.object z f (P.category.structure.identity B.object)}
  "by" {sym!{{P.category.Hom B.object z}} _ _ (P.category.laws.rightIdentity B.object z f)}
  "=" {P.category.structure.compose B.object B.object z f
    (Operations.add B.object B.object (P.category.structure.compose B.object x B.object B.firstInjection B.firstProjection)
      (P.category.structure.compose B.object y B.object B.secondInjection B.secondProjection))}
  "by" {congr!{{P.category.Hom B.object B.object} {P.category.Hom B.object z}}
    (P.category.structure.compose B.object B.object z f) _ _ (sym!{{P.category.Hom B.object B.object}} _ _ (#reconstruction{B}))}
  "=" {Operations.add B.object z
    (P.category.structure.compose B.object B.object z f (P.category.structure.compose B.object x B.object B.firstInjection B.firstProjection))
    (P.category.structure.compose B.object B.object z f (P.category.structure.compose B.object y B.object B.secondInjection B.secondProjection))}
  "by" {P.composeRight B.object B.object z f (P.category.structure.compose B.object x B.object B.firstInjection B.firstProjection)
    (P.category.structure.compose B.object y B.object B.secondInjection B.secondProjection)}
  "=" {Operations.add B.object z
    (P.category.structure.compose B.object x z (P.category.structure.compose x B.object z f B.firstInjection) B.firstProjection)
    (P.category.structure.compose B.object y z (P.category.structure.compose y B.object z f B.secondInjection) B.secondProjection)}
  "by" {congr2!{{P.category.Hom B.object z} {P.category.Hom B.object z} {P.category.Hom B.object z}} (Operations.add B.object z) _ _ _ _
    (P.category.laws.associative B.object x B.object z f B.firstInjection B.firstProjection)
    (P.category.laws.associative B.object y B.object z f B.secondInjection B.secondProjection)}
};
\definition injectionsExt: \forall (z: P.category.Object)(f, g: P.category.Hom B.object z) ->
  P.category.structure.compose x B.object z f B.firstInjection = P.category.structure.compose x B.object z g B.firstInjection ->
  P.category.structure.compose y B.object z f B.secondInjection = P.category.structure.compose y B.object z g B.secondInjection -> f = g :=
  \fun (z: P.category.Object)(f, g: P.category.Hom B.object z)(first: _)(second: _) => trans!{{P.category.Hom B.object z}} _ _ _ (coreconstruct z f)
    (trans!{{P.category.Hom B.object z}} _ _ _
      (congr2!{{P.category.Hom B.object z} {P.category.Hom B.object z} {P.category.Hom B.object z}} (Operations.add B.object z) _ _ _ _
        (congr!{{P.category.Hom x z} {P.category.Hom B.object z}}
          (\fun (t: P.category.Hom x z) => P.category.structure.compose B.object x z t B.firstProjection) _ _ first)
        (congr!{{P.category.Hom y z} {P.category.Hom B.object z}}
          (\fun (t: P.category.Hom y z) => P.category.structure.compose B.object y z t B.secondProjection) _ _ second))
      (sym!{{P.category.Hom B.object z}} _ _ (coreconstruct z g)));

\definition composeThrough: \forall (z, w: P.category.Object)(g: P.category.Hom B.object w)(f: P.category.Hom z B.object) ->
  P.category.structure.compose z B.object w g f = Operations.add z w
    (P.category.structure.compose z x w (P.category.structure.compose x B.object w g B.firstInjection) (P.category.structure.compose z B.object x B.firstProjection f))
    (P.category.structure.compose z y w (P.category.structure.compose y B.object w g B.secondInjection) (P.category.structure.compose z B.object y B.secondProjection f)) :=
  \fun (z, w: P.category.Object)(g: P.category.Hom B.object w)(f: P.category.Hom z B.object) => trans!{{P.category.Hom z w}} _ _ _
    (congr!{{P.category.Hom z B.object} {P.category.Hom z w}} (P.category.structure.compose z B.object w g) _ _ (reconstruct z f))
    (trans!{{P.category.Hom z w}} _ _ _
      (P.composeRight z B.object w g
        (P.category.structure.compose z x B.object B.firstInjection (P.category.structure.compose z B.object x B.firstProjection f))
        (P.category.structure.compose z y B.object B.secondInjection (P.category.structure.compose z B.object y B.secondProjection f)))
      (congr2!{{P.category.Hom z w} {P.category.Hom z w} {P.category.Hom z w}} (Operations.add z w) _ _ _ _
        (P.category.laws.associative z x B.object w g B.firstInjection (P.category.structure.compose z B.object x B.firstProjection f))
        (P.category.laws.associative z y B.object w g B.secondInjection (P.category.structure.compose z B.object y B.secondProjection f))));
\definition sandwichComposition: \forall (a, b, z, w: P.category.Object)(g: P.category.Hom B.object b)(f: P.category.Hom a B.object)
  (projection: P.category.Hom b w)(injection: P.category.Hom z a) ->
  P.category.structure.compose z b w projection (P.category.structure.compose z a b (P.category.structure.compose a B.object b g f) injection) =
  Operations.add z w
    (P.category.structure.compose z x w
      (P.category.structure.compose x b w projection (P.category.structure.compose x B.object b g B.firstInjection))
      (P.category.structure.compose z B.object x B.firstProjection (P.category.structure.compose z a B.object f injection)))
    (P.category.structure.compose z y w
      (P.category.structure.compose y b w projection (P.category.structure.compose y B.object b g B.secondInjection))
      (P.category.structure.compose z B.object y B.secondProjection (P.category.structure.compose z a B.object f injection))) :=
  \fun (a, b, z, w: P.category.Object)(g: P.category.Hom B.object b)(f: P.category.Hom a B.object)
    (projection: P.category.Hom b w)(injection: P.category.Hom z a) => trans!{{P.category.Hom z w}} _ _ _
      (congr!{{P.category.Hom z b} {P.category.Hom z w}} (P.category.structure.compose z b w projection) _ _
        (sym!{{P.category.Hom z b}} _ _ (P.category.laws.associative z a B.object b g f injection)))
      (trans!{{P.category.Hom z w}} _ _ _
        (P.category.laws.associative z B.object b w projection g (P.category.structure.compose z a B.object f injection))
        (trans!{{P.category.Hom z w}} _ _ _
          (composeThrough z w (P.category.structure.compose B.object b w projection g) (P.category.structure.compose z a B.object f injection))
          (congr2!{{P.category.Hom z w} {P.category.Hom z w} {P.category.Hom z w}} (Operations.add z w) _ _ _ _
            (congr!{{P.category.Hom x w} {P.category.Hom z w}}
              (\fun (h: P.category.Hom x w) => P.category.structure.compose z x w h (P.category.structure.compose z B.object x B.firstProjection (P.category.structure.compose z a B.object f injection))) _ _
              (sym!{{P.category.Hom x w}} _ _ (P.category.laws.associative x B.object b w projection g B.firstInjection)))
            (congr!{{P.category.Hom y w} {P.category.Hom z w}}
              (\fun (h: P.category.Hom y w) => P.category.structure.compose z y w h (P.category.structure.compose z B.object y B.secondProjection (P.category.structure.compose z a B.object f injection))) _ _
              (sym!{{P.category.Hom y w}} _ _ (P.category.laws.associative y B.object b w projection g B.secondInjection))))));
