\import \parent.Universal[P := P, x := x, y := y, B := B] \as Source;
\import \parent.Universal[P := P, x := u, y := v, B := D] \as Target;
\structure Entries: \Set {
  firstFirst: P.category.Hom x u,
  firstSecond: P.category.Hom y u,
  secondFirst: P.category.Hom x v,
  secondSecond: P.category.Hom y v,
}
\definition entries(f: P.category.Hom B.object D.object): Entries := Entries {
  firstFirst := P.category.structure.compose x D.object u D.firstProjection (P.category.structure.compose x B.object D.object f B.firstInjection),
  firstSecond := P.category.structure.compose y D.object u D.firstProjection (P.category.structure.compose y B.object D.object f B.secondInjection),
  secondFirst := P.category.structure.compose x D.object v D.secondProjection (P.category.structure.compose x B.object D.object f B.firstInjection),
  secondSecond := P.category.structure.compose y D.object v D.secondProjection (P.category.structure.compose y B.object D.object f B.secondInjection),
};
\definition ext: \forall (f, g: P.category.Hom B.object D.object) ->
  #firstFirst{(entries f)} = #firstFirst{(entries g)} -> #firstSecond{(entries f)} = #firstSecond{(entries g)} ->
  #secondFirst{(entries f)} = #secondFirst{(entries g)} -> #secondSecond{(entries f)} = #secondSecond{(entries g)} -> f = g :=
  \fun (f, g: P.category.Hom B.object D.object)(a: _)(b: _)(c: _)(d: _) => Source.injectionsExt D.object f g
    (Target.projectionsExt x (P.category.structure.compose x B.object D.object f B.firstInjection) (P.category.structure.compose x B.object D.object g B.firstInjection) a c)
    (Target.projectionsExt y (P.category.structure.compose y B.object D.object f B.secondInjection) (P.category.structure.compose y B.object D.object g B.secondInjection) b d);
\module Composition(s, t: P.category.Object,
  E: category.Additive[].Biproduct[P.category.Object, P.category.Hom, P.category.structure, P.addition, s, t]);
