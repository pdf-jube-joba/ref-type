\import \parent.\parent.Matrix[P := P, x := u, y := v, u := s, v := t, B := D, D := E] \as After;
\import \parent.\parent.Matrix[P := P, x := x, y := y, u := s, v := t, B := B, D := E] \as Result;
\import \parent.\parent.Universal[P := P, x := u, y := v, B := D] \as Middle;
\import Pre.Over[P := P] \as Operations;
\definition firstFirst: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  #firstFirst{(Result.entries (P.category.structure.compose B.object D.object E.object g f))} = Operations.add x s
    (P.category.structure.compose x u s #firstFirst{(After.entries g)} #firstFirst{(entries f)})
    (P.category.structure.compose x v s #firstSecond{(After.entries g)} #secondFirst{(entries f)}) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object x s g f E.firstProjection B.firstInjection;
\definition firstSecond: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  #firstSecond{(Result.entries (P.category.structure.compose B.object D.object E.object g f))} = Operations.add y s
    (P.category.structure.compose y u s #firstFirst{(After.entries g)} #firstSecond{(entries f)})
    (P.category.structure.compose y v s #firstSecond{(After.entries g)} #secondSecond{(entries f)}) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object y s g f E.firstProjection B.secondInjection;
\definition secondFirst: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  #secondFirst{(Result.entries (P.category.structure.compose B.object D.object E.object g f))} = Operations.add x t
    (P.category.structure.compose x u t #secondFirst{(After.entries g)} #firstFirst{(entries f)})
    (P.category.structure.compose x v t #secondSecond{(After.entries g)} #secondFirst{(entries f)}) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object x t g f E.secondProjection B.firstInjection;
\definition secondSecond: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  #secondSecond{(Result.entries (P.category.structure.compose B.object D.object E.object g f))} = Operations.add y t
    (P.category.structure.compose y u t #secondFirst{(After.entries g)} #firstSecond{(entries f)})
    (P.category.structure.compose y v t #secondSecond{(After.entries g)} #secondSecond{(entries f)}) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object y t g f E.secondProjection B.secondInjection;
