\import \parent.\parent.Matrix[P := P, x := u, y := v, u := s, v := t, B := D, D := E] \as After;
\import \parent.\parent.Matrix[P := P, x := x, y := y, u := s, v := t, B := B, D := E] \as Result;
\import \parent.\parent.Universal[P := P, x := u, y := v, B := D] \as Middle;
\import Pre.Over[P := P] \as Operations;
\definition firstFirst: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  (Result.entries (P.category.structure.compose B.object D.object E.object g f)).firstFirst = Operations.add x s
    (P.category.structure.compose x u s (After.entries g).firstFirst (entries f).firstFirst)
    (P.category.structure.compose x v s (After.entries g).firstSecond (entries f).secondFirst) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object x s g f E.firstProjection B.firstInjection;
\definition firstSecond: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  (Result.entries (P.category.structure.compose B.object D.object E.object g f)).firstSecond = Operations.add y s
    (P.category.structure.compose y u s (After.entries g).firstFirst (entries f).firstSecond)
    (P.category.structure.compose y v s (After.entries g).firstSecond (entries f).secondSecond) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object y s g f E.firstProjection B.secondInjection;
\definition secondFirst: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  (Result.entries (P.category.structure.compose B.object D.object E.object g f)).secondFirst = Operations.add x t
    (P.category.structure.compose x u t (After.entries g).secondFirst (entries f).firstFirst)
    (P.category.structure.compose x v t (After.entries g).secondSecond (entries f).secondFirst) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object x t g f E.secondProjection B.firstInjection;
\definition secondSecond: \forall (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) ->
  (Result.entries (P.category.structure.compose B.object D.object E.object g f)).secondSecond = Operations.add y t
    (P.category.structure.compose y u t (After.entries g).secondFirst (entries f).firstSecond)
    (P.category.structure.compose y v t (After.entries g).secondSecond (entries f).secondSecond) :=
  \fun (g: P.category.Hom D.object E.object)(f: P.category.Hom B.object D.object) =>
    Middle.sandwichComposition B.object E.object y t g f E.secondProjection B.secondInjection;
