\module Proposition;
\module Algebra;
\module Relation;
\module Rel;
\module Classical;
\module Equality;
\module Transitive;
\module Equivalence(A: \Set, R: A -> A -> \Prop,
  refl: \forall (a: A) -> R a a,
  sym: \forall (a, b: A) -> R a b -> R b a,
  trans: \forall (a, b, c: A) -> R a b -> R b c -> R a c);
\module Order;
\module Reflection;
\module Termination(State, Output: \Set, step: State -> \RunStep[State, Output]);
