\import std.Data[].Nat[] \as N;
\import \parent.Basic[] \as Op;
\import std.Data[].Bool[] \as B;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;

\definition two: N.Nat := N.Nat::succ (N.Nat::succ N.Nat::zero);

\correspondence Even: N.Nat -> B.Bool {
  \program := \fun (n: N.Nat) => \program {
    \bind partial: \U(N.Nat -> N.Nat) <- Op.Mod::[program] n \then
    \bind remainder: N.Nat <- (\force partial) two \then
    \bind result: B.Bool <- Op.IsZero::[program] remainder \then
    \return result
  },
  \set := \fun (n: N.Nat^) => Op.IsZero::[set] (Op.Mod::[set] n two^),

  \definition matches (n: N.Nat^): Even::[program]^ n = Even::[set] n :=
    trans!{B.Bool^} _ _ _
      (congr!{Op.IsZero::[Type]^ B.Bool^}
        (\fun (test: _) => test (Op.Mod::[program]^ n two^)) _ _ Op.IsZero::[coherence])
      (congr!{Op.Mod::[Type]^ B.Bool^}
        (\fun (mod: _) => Op.IsZero::[set] (mod n two^)) _ _ Op.Mod::[coherence]);
  \coherence := \axiom:funext(Even::[program]^, Even::[set], matches),
}

\correspondence Odd: N.Nat -> B.Bool {
  \program := \fun (n: N.Nat) => \program {
    \bind partial: \U(N.Nat -> N.Nat) <- Op.Mod::[program] n \then
    \bind remainder: N.Nat <- (\force partial) two \then
    \bind test: \U(N.Nat -> B.Bool) <- Op.Eqb::[program] remainder \then
    \bind result: B.Bool <- (\force test) Op.one \then
    \return result
  },
  \set := \fun (n: N.Nat^) => Op.Eqb::[set] (Op.Mod::[set] n two^) Op.one^,

  \definition matches (n: N.Nat^): Odd::[program]^ n = Odd::[set] n :=
    trans!{B.Bool^} _ _ _
      (congr!{Op.Eqb::[Type]^ B.Bool^}
        (\fun (test: _) => test (Op.Mod::[program]^ n two^) Op.one^) _ _ Op.Eqb::[coherence])
      (congr!{Op.Mod::[Type]^ B.Bool^}
        (\fun (mod: _) => Op.Eqb::[set] (mod n two^) Op.one^) _ _ Op.Mod::[coherence]);
  \coherence := \axiom:funext(Odd::[program]^, Odd::[set], matches),
}
