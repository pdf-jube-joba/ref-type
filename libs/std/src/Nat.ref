\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as L;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;
\use Equality.congr2;
\use Equality.transport;

\import std.Data[].Bool[] \as B;
\import std.Data[].Pair[] \as P;

/*
 * Natural numbers in the Program universe.
 *
 * Recursive computation is expressed as a state machine.  Program does not
 * use a PTS primitive recursor: AddState::running transfers one successor from
 * the remaining operand to the accumulator on every run step.
 */
\inductive Nat: \VType :=
| zero: Nat
| succ: Nat -> Nat
;

\definition zero: Nat := Nat::zero;
\definition one: Nat := Nat::succ Nat::zero;

/* Finite iteration and its computation laws, shared by both payload types. */
\structure Iteration[A: \Set]: \Set {
  apply: (A -> A) -> A -> Nat^ -> A,
} \where {
  zero: \forall (f: A -> A) (value: A) -> apply f value Nat^::zero = value,
  succ: \forall (f: A -> A) (value: A) (count: Nat^) ->
    apply f value (Nat^::succ count) = f (apply f value count),
  advance: \forall (f: A -> A) (count: Nat^) (value: A) ->
    apply f (f value) count = f (apply f value count),
}

\module FiniteIteration(A: \Set) {
  \definition apply (f: A -> A) (value: A) (count: Nat^): A :=
    \induction (n: Nat^) \return A \with {
      | zero: value
      | succ: \fun (k: Nat^) (previous: A) => f previous
    } count;

  \definition advance (f: A -> A): \forall (count: Nat^) (value: A) ->
    apply f (f value) count = f (apply f value count) :=
    \induction (count: Nat^) \return \forall (value: A) ->
      apply f (f value) count = f (apply f value count) \with {
        | zero: \fun (value: A) => \refl(f value)
        | succ: \fun (k: Nat^) (ih: _) (value: A) =>
        congr!{A A} f _ _ (ih value)
      };

  \definition specification: Iteration[A]::[Set] :=
    Iteration[A] { apply := apply } \with {
      zero := \fun (f: A -> A) (value: A) => \refl(value),
      succ := \fun (f: A -> A) (value: A) (count: Nat^) =>
        \refl(f (apply f value count)),
      advance := advance,
    };
}

\inductive AddState: \VType :=
| running: Nat -> Nat -> AddState
;

\machine AddLoop {
  \State := AddState,
  \Output := Nat,
  \step := \thunk(\cfun (state: AddState) => \match state \in AddState \with {
    | running accumulator remaining :
        \match remaining \in Nat \with {
          | zero :
            \return(\finish[AddState, Nat](accumulator))
          | succ smaller :
            \return(\continue[AddState, Nat](AddState::running (Nat::succ accumulator) smaller))
        }
  }),

  \definition ready: \RunStep[AddState^, Nat^] -> \Prop :=
    \step-match t: \RunStep[AddState^, Nat^] \return \Prop \with {
      | \continue s: \Acc[AddState^, Nat^](AddLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: AddState^) (certificate: ready (AddLoop::[step]^ s)):
    \Acc[AddState^, Nat^](AddLoop::[step]^, s) :=
    \accintro[AddState^, Nat^](AddLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim AddLoop::[step]^ s = \continue[AddState^, Nat^](next)
          \with t: \RunStep[AddState^, Nat^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates:
    \forall (remaining: Nat^) -> \forall (accumulator: Nat^) ->
      \Acc[AddState^, Nat^](AddLoop::[step]^, AddState^::running accumulator remaining) :=
    \induction (n: Nat^) \return \forall (a: Nat^) -> \Acc[AddState^, Nat^](AddLoop::[step]^, AddState^::running a n) \with {
      | zero : (\fun (a: Nat^) => accIntro (AddState^::running a Nat^::zero) L.True::intro)
      | succ : (\fun (n: Nat^) => \fun (ih: _) =>
        \fun (a: Nat^) => accIntro (AddState^::running a (Nat^::succ n)) (ih (Nat^::succ a)))
    };
  \terminates := \induction (s: AddState^) \return
    \Acc[AddState^, Nat^](AddLoop::[step]^, s) \with {
      | running: \fun (accumulator, remaining: Nat^) => terminates remaining accumulator
    },
}

\definition succCong: \forall (a, b: Nat^) -> a = b -> Nat^::succ a = Nat^::succ b :=
  congr!{Nat^ Nat^} (\fun (n: Nat^) => Nat^::succ n);

\correspondence Add: Nat -> Nat -> Nat {
  \program := \fun (left, right: Nat) =>
    AddLoop::[run] (AddState::running left right),
  \set := \fun (a, b: Nat^) =>
    \induction (n: Nat^) \return Nat^ \with {
    | zero : a
    | succ : (\fun (n: Nat^) => \fun (sum: Nat^) => Nat^::succ sum)
  } b,

  \definition succLeft (a: Nat^):
    \forall (b: Nat^) -> Add::[set] (Nat^::succ a) b = Nat^::succ (Add::[set] a b) :=
    \induction (b: Nat^) \return Add::[set] (Nat^::succ a) b = Nat^::succ (Add::[set] a b) \with {
      | zero : (\refl(Nat^::succ a))
      | succ : (\fun (b: Nat^) => \fun (ih: _) =>
        succCong (Add::[set] (Nat^::succ a) b) (Nat^::succ (Add::[set] a b)) ih)
    };
  \math-macro nat_add($x, "+", $y) := Add::[program]^ $x $y;

  \definition matches: \forall (b, a: Nat^) -> \(a "+" b\) = Add::[set] a b :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> \(a "+" b\) = Add::[set] a b \with {
      | zero : (\fun (a: Nat^) => \refl(a))
      | succ : (\fun (b: Nat^) => \fun (ih: _) => \fun (a: Nat^) =>
        eq_reason!{
          \(a "+" { Nat^::succ b }\)
          "=" { Add::[set] (Nat^::succ a) b } "by" { ih (Nat^::succ a) }
          "=" { Nat^::succ (Add::[set] a b) } "by" { succLeft a b }
        })
    };
  \coherence := \axiom:funext(Add::[program]^, Add::[set],
    \fun (a: Nat^) => \axiom:funext(Add::[program]^ a, Add::[set] a,
      \fun (b: Nat^) => matches b a)),
}

\math-macro nat_add($x, "+", $y) := Add::[set] $x $y;

\correspondence Pred: Nat -> Nat {
  \program := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return Nat::zero | succ k : \return k }),
  \set := \fun (n: Nat^) =>
    \induction (n: Nat^) \return Nat^ \with {
    | zero : Nat^::zero
    | succ : (\fun (k: Nat^) => \fun (_: _) => k)
  } n,

  \definition matches: \forall (n: Nat^) -> Pred::[program]^ n = Pred::[set] n :=
    \induction (n: Nat^) \return Pred::[program]^ n = Pred::[set] n \with {
      | zero : (\refl(Nat^::zero))
      | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(k))
    };
  \coherence := \axiom:funext(Pred::[program]^, Pred::[set],
    \fun (n: Nat^) => matches n),
}

\correspondence IsZero: Nat -> B.Bool {
  \program := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false }),
  \set := \fun (n: Nat^) =>
    \induction (n: Nat^) \return B.Bool^ \with {
    | zero : B.Bool^::true
    | succ : (\fun (k: Nat^) => \fun (_: _) => B.Bool^::false)
  } n,

  \definition matches: \forall (n: Nat^) -> IsZero::[program]^ n = IsZero::[set] n :=
    \induction (n: Nat^) \return IsZero::[program]^ n = IsZero::[set] n \with {
      | zero : (\refl(B.Bool^::true))
      | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(B.Bool^::false))
    };
  \coherence := \axiom:funext(IsZero::[program]^, IsZero::[set],
    \fun (n: Nat^) => matches n),
}

/* sub: both operands decrease on every continuing transition. */
\inductive SubState: \VType := | running: Nat -> Nat -> SubState;
\machine SubLoop {
  \State := SubState,
  \Output := Nat,
  \step := \thunk(\cfun (state: SubState) => \match state \in SubState \with { | running a b :
    \match b \in Nat \with {
      | zero : \return(\finish[SubState, Nat](a))
      | succ k : \match a \in Nat \with {
        | zero : \return(\finish[SubState, Nat](Nat::zero))
        | succ j : \return(\continue[SubState, Nat](SubState::running j k))
      }
    }
  }),

  \definition ready: \RunStep[SubState^, Nat^] -> \Prop :=
    \step-match t: \RunStep[SubState^, Nat^] \return \Prop \with {
      | \continue s: \Acc[SubState^, Nat^](SubLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: SubState^) (certificate: ready (SubLoop::[step]^ s)):
    \Acc[SubState^, Nat^](SubLoop::[step]^, s) :=
    \accintro[SubState^, Nat^](SubLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim SubLoop::[step]^ s = \continue[SubState^, Nat^](next)
          \with t: \RunStep[SubState^, Nat^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (b, a: Nat^) -> \Acc[SubState^, Nat^](SubLoop::[step]^, SubState^::running a b) :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> \Acc[SubState^, Nat^](SubLoop::[step]^, SubState^::running a b) \with {
      | zero : (\induction (a: Nat^) \return \Acc[SubState^, Nat^](SubLoop::[step]^, SubState^::running a Nat^::zero) \with {
        | zero : (accIntro (SubState^::running Nat^::zero Nat^::zero) L.True::intro)
        | succ : (\fun (j: Nat^) => \fun (unused: _) => accIntro (SubState^::running
        (Nat^::succ j) Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return \Acc[SubState^, Nat^](SubLoop::[step]^, SubState^::running a (Nat^::succ k)) \with {
          | zero : (accIntro (SubState^::running Nat^::zero (Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: Nat^) => \fun (unused: _) =>
            accIntro (SubState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: SubState^) \return
    \Acc[SubState^, Nat^](SubLoop::[step]^, s) \with {
      | running: \fun (a, b: Nat^) => terminates b a
    },
}

\correspondence Sub: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) =>
    SubLoop::[run] (SubState::running a b),
  \set := \fun (a, b: Nat^) =>
    \induction (b: Nat^) \return Nat^ -> Nat^ \with {
    | zero : (\fun (a: Nat^) => a)
    | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> Nat^) => \fun (a: Nat^) =>
      \induction (a: Nat^) \return Nat^ \with {
        | zero : Nat^::zero
        | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: Nat^) -> Sub::[program]^ a b = Sub::[set] a b :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> Sub::[program]^ a b = Sub::[set] a b \with {
      | zero : (\induction (a: Nat^) \return Sub::[program]^ a Nat^::zero = Sub::[set] a Nat^::zero \with {
        | zero : (\refl(Sub::[set] Nat^::zero
        Nat^::zero))
        | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(Sub::[set]
        (Nat^::succ j) Nat^::zero))
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return Sub::[program]^ a (Nat^::succ k) = Sub::[set] a (Nat^::succ k) \with {
          | zero : (\refl(Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Sub::[program]^, Sub::[set],
    \fun (a: Nat^) => \axiom:funext(Sub::[program]^ a, Sub::[set] a,
      \fun (b: Nat^) => matches b a)),
}

/* eqb: both operands decrease on every continuing transition. */
\inductive EqbState: \VType := | running: Nat -> Nat -> EqbState;
\machine EqbLoop {
  \State := EqbState,
  \Output := B.Bool,
  \step := \thunk(\cfun (state: EqbState) => \match state \in EqbState \with { | running a b :
    \match b \in Nat \with {
      | zero : \match a \in Nat \with { | zero : \return(\finish[EqbState, B.Bool](B.Bool::true)) | succ k :
        \return(\finish[EqbState, B.Bool](B.Bool::false)) }
      | succ k : \match a \in Nat \with {
        | zero : \return(\finish[EqbState, B.Bool](B.Bool::false))
        | succ j : \return(\continue[EqbState, B.Bool](EqbState::running j k))
      }
    }
  }),

  \definition ready: \RunStep[EqbState^, B.Bool^] -> \Prop :=
    \step-match t: \RunStep[EqbState^, B.Bool^] \return \Prop \with {
      | \continue s: \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: EqbState^) (certificate: ready (EqbLoop::[step]^ s)):
    \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, s) :=
    \accintro[EqbState^, B.Bool^](EqbLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim EqbLoop::[step]^ s = \continue[EqbState^, B.Bool^](next)
          \with t: \RunStep[EqbState^, B.Bool^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (b, a: Nat^) -> \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a b) :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a b) \with {
      | zero : (\induction (a: Nat^) \return \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a Nat^::zero) \with {
        | zero : (accIntro (EqbState^::running Nat^::zero Nat^::zero) L.True::intro)
        | succ : (\fun (j: Nat^) => \fun (unused: _) => accIntro (EqbState^::running
        (Nat^::succ j) Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a (Nat^::succ k)) \with {
          | zero : (accIntro (EqbState^::running Nat^::zero (Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: Nat^) => \fun (unused: _) =>
            accIntro (EqbState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: EqbState^) \return
    \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, s) \with {
      | running: \fun (a, b: Nat^) => terminates b a
    },
}

\correspondence Eqb: Nat -> Nat -> B.Bool {
  \program := \fun (a, b: Nat) =>
    EqbLoop::[run] (EqbState::running a b),
  \set := \fun (a, b: Nat^) =>
    \induction (b: Nat^) \return Nat^ -> B.Bool^ \with {
    | zero : (\fun (a: Nat^) => IsZero::[set] a)
    | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> B.Bool^) => \fun (a: Nat^) =>
      \induction (a: Nat^) \return B.Bool^ \with {
        | zero : B.Bool^::false
        | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: Nat^) -> Eqb::[program]^ a b = Eqb::[set] a b :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> Eqb::[program]^ a b = Eqb::[set] a b \with {
      | zero : (\induction (a: Nat^) \return Eqb::[program]^ a Nat^::zero = Eqb::[set] a Nat^::zero \with {
        | zero : (\refl(Eqb::[set] Nat^::zero
        Nat^::zero))
        | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(Eqb::[set]
        (Nat^::succ j) Nat^::zero))
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return Eqb::[program]^ a (Nat^::succ k) = Eqb::[set] a (Nat^::succ k) \with {
          | zero : (\refl(B.Bool^::false))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Eqb::[program]^, Eqb::[set],
    \fun (a: Nat^) => \axiom:funext(Eqb::[program]^ a, Eqb::[set] a,
      \fun (b: Nat^) => matches b a)),
}

/* leb: both operands decrease on every continuing transition. */
\inductive LebState: \VType := | running: Nat -> Nat -> LebState;
\machine LebLoop {
  \State := LebState,
  \Output := B.Bool,
  \step := \thunk(\cfun (state: LebState) => \match state \in LebState \with { | running a b :
    \match b \in Nat \with {
      | zero : \match a \in Nat \with { | zero : \return(\finish[LebState, B.Bool](B.Bool::true)) | succ k :
        \return(\finish[LebState, B.Bool](B.Bool::false)) }
      | succ k : \match a \in Nat \with {
        | zero : \return(\finish[LebState, B.Bool](B.Bool::true))
        | succ j : \return(\continue[LebState, B.Bool](LebState::running j k))
      }
    }
  }),

  \definition ready: \RunStep[LebState^, B.Bool^] -> \Prop :=
    \step-match t: \RunStep[LebState^, B.Bool^] \return \Prop \with {
      | \continue s: \Acc[LebState^, B.Bool^](LebLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: LebState^) (certificate: ready (LebLoop::[step]^ s)):
    \Acc[LebState^, B.Bool^](LebLoop::[step]^, s) :=
    \accintro[LebState^, B.Bool^](LebLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim LebLoop::[step]^ s = \continue[LebState^, B.Bool^](next)
          \with t: \RunStep[LebState^, B.Bool^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (b, a: Nat^) -> \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a b) :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a b) \with {
      | zero : (\induction (a: Nat^) \return \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a Nat^::zero) \with {
        | zero : (accIntro (LebState^::running Nat^::zero Nat^::zero) L.True::intro)
        | succ : (\fun (j: Nat^) => \fun (unused: _) => accIntro (LebState^::running
        (Nat^::succ j) Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a (Nat^::succ k)) \with {
          | zero : (accIntro (LebState^::running Nat^::zero (Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: Nat^) => \fun (unused: _) =>
            accIntro (LebState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: LebState^) \return
    \Acc[LebState^, B.Bool^](LebLoop::[step]^, s) \with {
      | running: \fun (a, b: Nat^) => terminates b a
    },
}

\correspondence Leb: Nat -> Nat -> B.Bool {
  \program := \fun (a, b: Nat) =>
    LebLoop::[run] (LebState::running a b),
  \set := \fun (a, b: Nat^) =>
    \induction (b: Nat^) \return Nat^ -> B.Bool^ \with {
    | zero : (\fun (a: Nat^) => IsZero::[set] a)
    | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> B.Bool^) => \fun (a: Nat^) =>
      \induction (a: Nat^) \return B.Bool^ \with {
        | zero : B.Bool^::true
        | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: Nat^) -> Leb::[program]^ a b = Leb::[set] a b :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> Leb::[program]^ a b = Leb::[set] a b \with {
      | zero : (\induction (a: Nat^) \return Leb::[program]^ a Nat^::zero = Leb::[set] a Nat^::zero \with {
        | zero : (\refl(Leb::[set] Nat^::zero
        Nat^::zero))
        | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(Leb::[set]
        (Nat^::succ j) Nat^::zero))
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return Leb::[program]^ a (Nat^::succ k) = Leb::[set] a (Nat^::succ k) \with {
          | zero : (\refl(B.Bool^::true))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Leb::[program]^, Leb::[set],
    \fun (a: Nat^) => \axiom:funext(Leb::[program]^ a, Leb::[set] a,
      \fun (b: Nat^) => matches b a)),
}

/* ltb: both operands decrease on every continuing transition. */
\inductive LtbState: \VType := | running: Nat -> Nat -> LtbState;
\machine LtbLoop {
  \State := LtbState,
  \Output := B.Bool,
  \step := \thunk(\cfun (state: LtbState) => \match state \in LtbState \with { | running a b :
    \match b \in Nat \with {
      | zero : \return(\finish[LtbState, B.Bool](B.Bool::false))
      | succ k : \match a \in Nat \with {
        | zero : \return(\finish[LtbState, B.Bool](B.Bool::true))
        | succ j : \return(\continue[LtbState, B.Bool](LtbState::running j k))
      }
    }
  }),

  \definition ready: \RunStep[LtbState^, B.Bool^] -> \Prop :=
    \step-match t: \RunStep[LtbState^, B.Bool^] \return \Prop \with {
      | \continue s: \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: LtbState^) (certificate: ready (LtbLoop::[step]^ s)):
    \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, s) :=
    \accintro[LtbState^, B.Bool^](LtbLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim LtbLoop::[step]^ s = \continue[LtbState^, B.Bool^](next)
          \with t: \RunStep[LtbState^, B.Bool^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (b, a: Nat^) -> \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a b) :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a b) \with {
      | zero : (\induction (a: Nat^) \return \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a Nat^::zero) \with {
        | zero : (accIntro (LtbState^::running Nat^::zero Nat^::zero) L.True::intro)
        | succ : (\fun (j: Nat^) => \fun (unused: _) => accIntro (LtbState^::running
        (Nat^::succ j) Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a (Nat^::succ k)) \with {
          | zero : (accIntro (LtbState^::running Nat^::zero (Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: Nat^) => \fun (unused: _) =>
            accIntro (LtbState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: LtbState^) \return
    \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, s) \with {
      | running: \fun (a, b: Nat^) => terminates b a
    },
}

\correspondence Ltb: Nat -> Nat -> B.Bool {
  \program := \fun (a, b: Nat) =>
    LtbLoop::[run] (LtbState::running a b),
  \set := \fun (a, b: Nat^) =>
    \induction (b: Nat^) \return Nat^ -> B.Bool^ \with {
    | zero : (\fun (a: Nat^) => B.Bool^::false)
    | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> B.Bool^) => \fun (a: Nat^) =>
      \induction (a: Nat^) \return B.Bool^ \with {
        | zero : B.Bool^::true
        | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: Nat^) -> Ltb::[program]^ a b = Ltb::[set] a b :=
    \induction (b: Nat^) \return \forall (a: Nat^) -> Ltb::[program]^ a b = Ltb::[set] a b \with {
      | zero : (\induction (a: Nat^) \return Ltb::[program]^ a Nat^::zero = Ltb::[set] a Nat^::zero \with {
        | zero : (\refl(Ltb::[set] Nat^::zero
        Nat^::zero))
        | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(Ltb::[set]
        (Nat^::succ j) Nat^::zero))
      })
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \induction (a: Nat^) \return Ltb::[program]^ a (Nat^::succ k) = Ltb::[set] a (Nat^::succ k) \with {
          | zero : (\refl(B.Bool^::true))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Ltb::[program]^, Ltb::[set],
    \fun (a: Nat^) => \axiom:funext(Ltb::[program]^ a, Ltb::[set] a,
      \fun (b: Nat^) => matches b a)),
}

/* A total iterator, shared by multiplication, powers and other finite loops. */
\inductive IterState: \VType :=
| running: \U(Nat -> Nat) -> Nat -> Nat -> IterState
;
\machine IterLoop {
  \State := IterState,
  \Output := Nat,
  \step := \thunk(\cfun (state: IterState) => \match state \in IterState \with {
    | running f value count : \match count \in Nat \with {
      | zero : \return(\finish[IterState, Nat](value))
      | succ k : \program {
        \bind next: Nat <- (\force f) value \then
        \return \continue[IterState, Nat](IterState::running f next k)
      }
    }
  }),

  \definition ready: \RunStep[IterState^, Nat^] -> \Prop :=
    \step-match t: \RunStep[IterState^, Nat^] \return \Prop \with {
      | \continue s: \Acc[IterState^, Nat^](IterLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: IterState^) (certificate: ready (IterLoop::[step]^ s)):
    \Acc[IterState^, Nat^](IterLoop::[step]^, s) :=
    \accintro[IterState^, Nat^](IterLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim IterLoop::[step]^ s = \continue[IterState^, Nat^](next)
          \with t: \RunStep[IterState^, Nat^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (count: Nat^) (f: Nat^ -> Nat^) (value: Nat^) ->
    \Acc[IterState^, Nat^](IterLoop::[step]^, IterState^::running f value count) :=
    \induction (count: Nat^) \return \forall (f: Nat^ -> Nat^) (value: Nat^) ->
      \Acc[IterState^, Nat^](IterLoop::[step]^, IterState^::running f value count) \with {
      | zero: \fun (f: Nat^ -> Nat^) (value: Nat^) =>
        accIntro (IterState^::running f value Nat^::zero) L.True::intro
      | succ: \fun (k: Nat^) (ih: _) (f: Nat^ -> Nat^) (value: Nat^) =>
        accIntro (IterState^::running f value (Nat^::succ k)) (ih f (f value))
    };
  \terminates := \induction (s: IterState^) \return
    \Acc[IterState^, Nat^](IterLoop::[step]^, s) \with {
      | running: \fun (f: Nat^ -> Nat^) (value, count: Nat^) => terminates count f value
    },
}

\import FiniteIteration[A := Nat^] \as NatIteration;

\correspondence Iter: \U(Nat -> Nat) -> Nat -> Nat -> Nat {
  \program := \fun (f: \U(Nat -> Nat)) =>
    \fun (value, count: Nat) =>
      IterLoop::[run] (IterState::running f value count),
  \set := NatIteration.specification #apply,

  \definition matches (f: Nat^ -> Nat^): \forall (count, value: Nat^) ->
    Iter::[program]^ f value count = Iter::[set] f value count :=
    \induction (count: Nat^) \return \forall (value: Nat^) -> Iter::[program]^ f value count = Iter::[set] f value count \with {
      | zero : (\fun (value: Nat^) => \refl(value))
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \fun (value: Nat^) =>
          \idelim Iter::[set] f (f value) k = f (Iter::[set] f value k)
            \with x: Nat^ => Iter::[program]^ f value (Nat^::succ k) = x
          \by { base: ih (f value), equality: (NatIteration.specification #advance) f k value })
    };
  \coherence := \axiom:funext(Iter::[program]^, Iter::[set],
    \fun (f: Nat^ -> Nat^) => \axiom:funext(Iter::[program]^ f, Iter::[set] f,
      \fun (value: Nat^) => \axiom:funext(Iter::[program]^ f value, Iter::[set] f value,
        \fun (count: Nat^) => matches f count value))),
}

\correspondence Mul: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) =>
    IterLoop::[run] (IterState::running
      \thunk(\cfun (current: Nat) => AddLoop::[run] (AddState::running a current))
      Nat::zero b),
  \set := \fun (a, b: Nat^) =>
    Iter::[set] (Add::[set] a) Nat^::zero b,
  \math-macro nat_mul($x, "*", $y) := Mul::[program]^ $x $y;

  \definition matches (a, b: Nat^): \(a "*" b\) = Mul::[set] a b :=
    trans!{Nat^} _ _ _
      (congr!{Iter::[Type]^ _} (\fun (f: _) => f (Add::[program]^ a) Nat^::zero b) _ _ Iter::[coherence])
      (congr!{Add::[Type]^ Nat^}
      (\fun (operation: _) => Iter::[set] (operation a) Nat^::zero b) _ _ Add::[coherence]);
  \coherence := \axiom:funext(Mul::[program]^, Mul::[set],
    \fun (a: Nat^) => \axiom:funext(Mul::[program]^ a, Mul::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\math-macro nat_mul($x, "*", $y) := Mul::[set] $x $y;

\correspondence Pow: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) =>
    IterLoop::[run] (IterState::running
      \thunk(\cfun (current: Nat) => IterLoop::[run] (IterState::running
          \thunk(\cfun (next: Nat) => AddLoop::[run] (AddState::running a next))
          Nat::zero current))
      one b),
  \set := \fun (a, b: Nat^) =>
    Iter::[set] (Mul::[set] a) (Nat^::succ Nat^::zero) b,

  \definition matches (a, b: Nat^): Pow::[program]^ a b = Pow::[set] a b :=
    trans!{Nat^} _ _ _
      (congr!{Iter::[Type]^ _} (\fun (f: _) => f (Mul::[program]^ a) (Nat^::succ Nat^::zero) b) _ _ Iter::[coherence])
      (congr!{Mul::[Type]^ Nat^}
      (\fun (operation: _) => Iter::[set] (operation a) (Nat^::succ Nat^::zero) b) _ _ Mul::[coherence]);
  \coherence := \axiom:funext(Pow::[program]^, Pow::[set],
    \fun (a: Nat^) => \axiom:funext(Pow::[program]^ a, Pow::[set] a,
      \fun (b: Nat^) => matches a b)),
}

/* Selection is reflected once, then shared by min and max. */
\correspondence Choose: B.Bool -> Nat -> Nat -> Nat {
  \program := \fun (test: B.Bool) =>
    \fun (yes, no: Nat) =>
      \match test \in B.Bool \with { | false : \return no | true : \return yes },
  \set := \fun (test: B.Bool^) (yes, no: Nat^) =>
    B.ite Nat^ test yes no,

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: Nat^) -> Choose::[program]^ test yes no = Choose::[set] test yes
    no :=
    \induction (test: B.Bool^) \return \forall (yes, no: Nat^) -> Choose::[program]^ test yes no = Choose::[set] test yes no \with {
      | false : (\fun (yes, no: Nat^) => \refl(no))
      | true : (\fun (yes, no: Nat^) => \refl(yes))
    };
  \coherence := \axiom:funext(Choose::[program]^, Choose::[set],
    \fun (test: B.Bool^) => \axiom:funext(Choose::[program]^ test, Choose::[set] test,
      \fun (yes: Nat^) => \axiom:funext(Choose::[program]^ test yes, Choose::[set] test yes,
        \fun (no: Nat^) => matches test yes no))),
}

\correspondence Min: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind test: B.Bool <- LtbLoop::[run] (LtbState::running a b) \then
    \bind selected: Nat <- \match test \in B.Bool \with { | false : \return b | true : \return a } \then
    \return selected
  },
  \set := \fun (a, b: Nat^) =>
    Choose::[set] (Ltb::[set] a b) a b,

  \definition matches: \forall (a, b: Nat^) -> Min::[program]^ a b = Min::[set] a b :=
    \block {
      \fix (a, b: Nat^) \then
      \let testMatches: Ltb::[program]^ a b = Ltb::[set] a b := (congr!{Ltb::[Type]^ _} (\fun (f: _) => f a b) _ _ Ltb::[coherence]) \then
      \return
      \idelim Ltb::[program]^ a b = Ltb::[set] a b
        \with test: B.Bool^ => Min::[program]^ a b = Choose::[set] test a b
      \by { base: (congr!{Choose::[Type]^ _} (\fun (f: _) => f (Ltb::[program]^ a b) a b) _ _ Choose::[coherence]), equality: testMatches }
    };
  \coherence := \axiom:funext(Min::[program]^, Min::[set],
    \fun (a: Nat^) => \axiom:funext(Min::[program]^ a, Min::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\correspondence Max: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind test: B.Bool <- LtbLoop::[run] (LtbState::running a b) \then
    \bind selected: Nat <- \match test \in B.Bool \with { | false : \return a | true : \return b } \then
    \return selected
  },
  \set := \fun (a, b: Nat^) =>
    Choose::[set] (Ltb::[set] a b) b a,

  \definition matches: \forall (a, b: Nat^) -> Max::[program]^ a b = Max::[set] a b :=
    \block {
      \fix (a, b: Nat^) \then
      \let testMatches: Ltb::[program]^ a b = Ltb::[set] a b := (congr!{Ltb::[Type]^ _} (\fun (f: _) => f a b) _ _ Ltb::[coherence]) \then
      \return
      \idelim Ltb::[program]^ a b = Ltb::[set] a b
        \with test: B.Bool^ => Max::[program]^ a b = Choose::[set] test b a
      \by { base: (congr!{Choose::[Type]^ _} (\fun (f: _) => f (Ltb::[program]^ a b) b a) _ _ Choose::[coherence]), equality: testMatches }
    };
  \coherence := \axiom:funext(Max::[program]^, Max::[set],
    \fun (a: Nat^) => \axiom:funext(Max::[program]^ a, Max::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\correspondence Toggle: Nat -> Nat {
  \program := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return one | succ k : \return Nat::zero }),
  \set := \fun (n: Nat^) =>
    \induction (n: Nat^) \return Nat^ \with {
    | zero : (Nat^::succ Nat^::zero)
    | succ : (\fun (k: Nat^) => \fun (_: _) => Nat^::zero)
  } n,

  \definition matches: \forall (n: Nat^) -> Toggle::[program]^ n = Toggle::[set] n :=
    \induction (n: Nat^) \return Toggle::[program]^ n = Toggle::[set] n \with {
      | zero : (\refl(Nat^::succ Nat^::zero))
      | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(Nat^::zero))
    };
  \coherence := \axiom:funext(Toggle::[program]^, Toggle::[set],
    \fun (n: Nat^) => matches n),
}

\definition evenResult (n: Nat^): B.Bool^ :=
  \induction (n: Nat^) \return B.Bool^ \with {
    | zero : B.Bool^::true
    | succ : (\fun (k: Nat^) => \fun (_: _) => B.Bool^::false)
  } n;
\definition evenTest: (Nat -> B.Bool) := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false });

\definition evenTestMatches: \forall (n: Nat^) -> evenTest^ n = evenResult n :=
  \induction (n: Nat^) \return evenTest^ n = evenResult n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(B.Bool^::false))
  };
\correspondence Even: Nat -> B.Bool {
  \program := (\cfun (n: Nat) => \program {
    \bind parity: Nat <- IterLoop::[run] (IterState::running \thunk Toggle::[program] Nat::zero n) \then
    \bind result: B.Bool <- \match parity \in Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false } \then
    \return result
  }),
  \set := \fun (n: Nat^) =>
    evenResult (Iter::[set] Toggle::[set] Nat^::zero n),

  \definition matches: \forall (n: Nat^) -> Even::[program]^ n = Even::[set] n :=
    \block {
      \fix (n: Nat^) \then
      \let iterationMatches:
        Iter::[set] Toggle::[set] Nat^::zero n = Iter::[program]^ Toggle::[program]^ Nat^::zero n :=
        trans!{Nat^} _ _ _
          (sym!{Nat^} _ _ (congr!{Toggle::[Type]^ Nat^}
            (\fun (toggle: _) => Iter::[set] toggle Nat^::zero n) _ _ Toggle::[coherence]))
          (sym!{Nat^} _ _ (congr!{Iter::[Type]^ Nat^}
            (\fun (iteration: _) => iteration Toggle::[program]^ Nat^::zero n) _ _ Iter::[coherence])) \then
      \return \idelim Iter::[set] Toggle::[set] Nat^::zero n = Iter::[program]^ Toggle::[program]^ Nat^::zero n
        \with k: Nat^ => evenTest^ k = Even::[set] n
        \by { base: evenTestMatches (Iter::[set] Toggle::[set] Nat^::zero n), equality: iterationMatches }
    };
  \coherence := \axiom:funext(Even::[program]^, Even::[set],
    \fun (n: Nat^) => matches n),
}

\definition oddResult (n: Nat^): B.Bool^ :=
  \induction (n: Nat^) \return B.Bool^ \with {
    | zero : B.Bool^::false
    | succ : (\fun (k: Nat^) => \fun (_: _) => B.Bool^::true)
  } n;
\definition oddTest: (Nat -> B.Bool) := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return B.Bool::false | succ k : \return B.Bool::true });

\definition oddTestMatches: \forall (n: Nat^) -> oddTest^ n = oddResult n :=
  \induction (n: Nat^) \return oddTest^ n = oddResult n \with {
    | zero : (\refl(B.Bool^::false))
    | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(B.Bool^::true))
  };
\correspondence Odd: Nat -> B.Bool {
  \program := (\cfun (n: Nat) => \program {
    \bind parity: Nat <- IterLoop::[run] (IterState::running \thunk Toggle::[program] Nat::zero n) \then
    \bind result: B.Bool <- \match parity \in Nat \with { | zero : \return B.Bool::false | succ k : \return B.Bool::true } \then
    \return result
  }),
  \set := \fun (n: Nat^) =>
    oddResult (Iter::[set] Toggle::[set] Nat^::zero n),

  \definition matches: \forall (n: Nat^) -> Odd::[program]^ n = Odd::[set] n :=
    \block {
      \fix (n: Nat^) \then
      \let iterationMatches:
        Iter::[set] Toggle::[set] Nat^::zero n = Iter::[program]^ Toggle::[program]^ Nat^::zero n :=
        trans!{Nat^} _ _ _
          (sym!{Nat^} _ _ (congr!{Toggle::[Type]^ Nat^}
            (\fun (toggle: _) => Iter::[set] toggle Nat^::zero n) _ _ Toggle::[coherence]))
          (sym!{Nat^} _ _ (congr!{Iter::[Type]^ Nat^}
            (\fun (iteration: _) => iteration Toggle::[program]^ Nat^::zero n) _ _ Iter::[coherence])) \then
      \return \idelim Iter::[set] Toggle::[set] Nat^::zero n = Iter::[program]^ Toggle::[program]^ Nat^::zero n
        \with k: Nat^ => oddTest^ k = Odd::[set] n
        \by { base: oddTestMatches (Iter::[set] Toggle::[set] Nat^::zero n), equality: iterationMatches }
    };
  \coherence := \axiom:funext(Odd::[program]^, Odd::[set],
    \fun (n: Nat^) => matches n),
}

/* Pairs are Program data so that quotient/remainder and Euclidean states can
 * cross the reflection boundary together. */
\definition NatPair: \Set := P.Times^[Nat^, Nat^];
\definition natPair: Nat^ -> Nat^ -> NatPair := P.pair Nat^ Nat^;
\definition natPairFirst: NatPair -> Nat^ := P.first Nat^ Nat^;
\definition natPairSecond: NatPair -> Nat^ := P.second Nat^ Nat^;
\definition natPairElim (Q: NatPair -> \Prop):
  (\forall (a, b: Nat^) -> Q (natPair a b)) -> \forall (p: NatPair) -> Q p :=
  \fun (pairCase: \forall (a, b: Nat^) -> Q (natPair a b)) =>
    \induction (p: P.Times^[Nat^, Nat^]) \return Q p \with {
      | pair : pairCase
    };

/* A pair-valued finite iterator. Its count, not the payload, proves totality. */
\inductive PairIterState: \VType :=
| running: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) -> P.Times[Nat, Nat] -> Nat -> PairIterState
;
\machine PairIterLoop {
  \State := PairIterState,
  \Output := P.Times[Nat, Nat],
  \step := \thunk(\cfun (state: PairIterState) => \match state \in PairIterState \with {
    | running f value count : \match count \in Nat \with {
      | zero : \return(\finish[PairIterState, P.Times[Nat, Nat]](value))
      | succ k : \program {
        \bind next: P.Times[Nat, Nat] <- (\force f) value \then
        \return \continue[PairIterState, P.Times[Nat, Nat]](PairIterState::running f next k)
      }
    }
  }),

  \definition ready: \RunStep[PairIterState^, NatPair] -> \Prop :=
    \step-match t: \RunStep[PairIterState^, NatPair] \return \Prop \with {
      | \continue s: \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: PairIterState^) (certificate: ready (PairIterLoop::[step]^ s)):
    \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, s) :=
    \accintro[PairIterState^, NatPair](PairIterLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim PairIterLoop::[step]^ s = \continue[PairIterState^, NatPair](next)
          \with t: \RunStep[PairIterState^, NatPair] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (count: Nat^) (f: NatPair -> NatPair) (value: NatPair) ->
    \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, PairIterState^::running f value count) :=
    \induction (count: Nat^) \return \forall (f: NatPair -> NatPair) (value: NatPair) ->
      \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, PairIterState^::running f value count) \with {
      | zero: \fun (f: NatPair -> NatPair) (value: NatPair) =>
        accIntro (PairIterState^::running f value Nat^::zero) L.True::intro
      | succ: \fun (k: Nat^) (ih: _) (f: NatPair -> NatPair) (value: NatPair) =>
        accIntro (PairIterState^::running f value (Nat^::succ k)) (ih f (f value))
    };
  \terminates := \induction (s: PairIterState^) \return
    \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, s) \with {
      | running: \fun (f: NatPair -> NatPair) (value: NatPair) (count: Nat^) => terminates count f value
    },
}

\import FiniteIteration[A := NatPair] \as PairIteration;

\correspondence PairIter: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) -> P.Times[Nat, Nat] -> Nat -> P.Times[Nat, Nat] {
  \program := \fun (f: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat])) =>
    \fun (value: P.Times[Nat, Nat]) =>
      \fun (count: Nat) =>
        PairIterLoop::[run] (PairIterState::running f value count),
  \set := PairIteration.specification #apply,

  \definition matches (f: NatPair -> NatPair): \forall (count: Nat^) -> \forall (value: NatPair) ->
    PairIter::[program]^ f value count = PairIter::[set] f value count :=
    \induction (count: Nat^) \return \forall (value: NatPair) -> PairIter::[program]^ f value count = PairIter::[set] f value count \with {
      | zero : (\fun (value: NatPair) => \refl(value))
      | succ : (\fun (k: Nat^) => \fun (ih: _) =>
        \fun (value: NatPair) =>
          \idelim PairIter::[set] f (f value) k = f (PairIter::[set] f value k)
            \with x: NatPair => PairIter::[program]^ f value (Nat^::succ k) = x
          \by { base: ih (f value), equality: (PairIteration.specification #advance) f k value })
    };
  \coherence := \axiom:funext(PairIter::[program]^, PairIter::[set],
    \fun (f: NatPair -> NatPair) => \axiom:funext(PairIter::[program]^ f, PairIter::[set] f,
      \fun (value: NatPair) => \axiom:funext(PairIter::[program]^ f value, PairIter::[set] f value,
        \fun (count: Nat^) => matches f count value))),
}

\correspondence PairChoose: B.Bool -> P.Times[Nat, Nat] -> P.Times[Nat, Nat] -> P.Times[Nat, Nat] {
  \program := \fun (test: B.Bool) =>
    \fun (yes, no: P.Times[Nat, Nat]) =>
      \match test \in B.Bool \with { | false : \return no | true : \return yes },
  \set := \fun (test: B.Bool^) (yes, no: NatPair) =>
    B.ite NatPair test yes no,

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: NatPair) ->
    PairChoose::[program]^ test yes no = PairChoose::[set] test yes no :=
    \induction (test: B.Bool^) \return \forall (yes, no: NatPair) -> PairChoose::[program]^ test yes no = PairChoose::[set] test yes no \with {
      | false : (\fun (yes, no: NatPair) => \refl(no))
      | true : (\fun (yes, no: NatPair) => \refl(yes))
    };
  \coherence := \axiom:funext(PairChoose::[program]^, PairChoose::[set],
    \fun (test: B.Bool^) => \axiom:funext(PairChoose::[program]^ test, PairChoose::[set] test,
      \fun (yes: NatPair) => \axiom:funext(PairChoose::[program]^ test yes, PairChoose::[set] test yes,
        \fun (no: NatPair) => matches test yes no))),
}

/* Consume one unit of the dividend. At a positive divisor's boundary the
 * remainder wraps to zero and the quotient increases. At divisor zero only
 * the remainder increases: div a 0 = 0, mod a 0 = a. */
\correspondence DivModNext: Nat -> P.Times[Nat, Nat] -> P.Times[Nat, Nat] {
  \program := \fun (b: Nat) =>
    \fun (p: P.Times[Nat, Nat]) =>
      \match p \in P.Times \with {
        | pair q r : \match b \in Nat \with {
          | zero : \return(P.Times[Nat, Nat]::pair q (Nat::succ r))
          | succ d :
          \program {
            \bind hit: B.Bool <- EqbLoop::[run] (EqbState::running r d) \then
            \bind pick: \U(P.Times[Nat, Nat] -> (P.Times[Nat, Nat] -> P.Times[Nat, Nat])) <- (PairChoose::[program] hit) \then
            \bind pickYes: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) <- (\force pick) (P.Times[Nat, Nat]::pair (Nat::succ q) Nat::zero) \then
            \bind next: P.Times[Nat, Nat] <- (\force pickYes) (P.Times[Nat, Nat]::pair q (Nat::succ r)) \then
            \return next
          }
        }
      },
  \set := \fun (b: Nat^) =>
    \induction (p: P.Times^[Nat^, Nat^]) \return NatPair \with {
    | pair : (\fun (q, r: Nat^) => \induction (b: Nat^) \return NatPair \with {
      | zero : (natPair q (Nat^::succ r))
      | succ : (\fun (d: Nat^) => \fun (_: _) => \match (Eqb::[set] r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => NatPair) \with {
        | false : (natPair q (Nat^::succ r))
        | true : (natPair (Nat^::succ q) Nat^::zero)
      })
    } b)
  },

  \definition matches (b: Nat^): \forall (p: NatPair) ->
    DivModNext::[program]^ b p = DivModNext::[set] b p :=
    \induction (p: P.Times^[Nat^, Nat^]) \return DivModNext::[program]^ b p = DivModNext::[set] b p \with {
      | pair : (\fun (q, r: Nat^) => \induction (b: Nat^) \return DivModNext::[program]^ b (natPair q r) = DivModNext::[set] b (natPair q r) \with {
        | zero : (\refl(natPair q (Nat^::succ r)))
        | succ : (\fun (d: Nat^) => \fun (_: _) => (trans!{NatPair} _ _ _
          (congr!{PairChoose::[Type]^ _} (\fun (f: _) => f (Eqb::[program]^ r d) (natPair (Nat^::succ q) Nat^::zero) (natPair q (Nat^::succ r))) _ _ PairChoose::[coherence])
          (congr!{Eqb::[Type]^ NatPair}
            (\fun (equal: _) => PairChoose::[set] (equal r d)
              (natPair (Nat^::succ q) Nat^::zero) (natPair q (Nat^::succ r)))
            _ _ Eqb::[coherence])))
      } b)
    };
  \coherence := \axiom:funext(DivModNext::[program]^, DivModNext::[set],
    \fun (b: Nat^) => \axiom:funext(DivModNext::[program]^ b, DivModNext::[set] b,
      \fun (p: NatPair) => matches b p)),
}

\correspondence DivMod: Nat -> Nat -> P.Times[Nat, Nat] {
  \program := \fun (a, b: Nat) => \program {
    \bind advance: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) <- (DivModNext::[program] b) \then
    \bind result: P.Times[Nat, Nat] <- PairIterLoop::[run] (PairIterState::running advance (P.Times[Nat, Nat]::pair Nat::zero Nat::zero) a) \then
    \return result
  },
  \set := \fun (a, b: Nat^) =>
    PairIter::[set] (DivModNext::[set] b) (natPair Nat^::zero Nat^::zero) a,

  \definition matches: \forall (a, b: Nat^) -> DivMod::[program]^ a b = DivMod::[set] a b :=
    \block {
      \fix (a, b: Nat^) \then
      \let iterationMatches:
        DivMod::[program]^ a b = PairIter::[set] (DivModNext::[program]^ b) (natPair Nat^::zero Nat^::zero) a :=
        (congr!{PairIter::[Type]^ _} (\fun (f: _) => f (DivModNext::[program]^ b) (natPair Nat^::zero Nat^::zero) a) _ _ PairIter::[coherence]) \then
      \let stepMatches:
        PairIter::[set] (DivModNext::[program]^ b) (natPair Nat^::zero Nat^::zero) a = DivMod::[set] a b :=
        congr!{DivModNext::[Type]^ NatPair}
          (\fun (next: _) => PairIter::[set] (next b) (natPair Nat^::zero Nat^::zero) a)
          _ _ DivModNext::[coherence] \then
      \return trans!{NatPair} _ _ _ iterationMatches stepMatches
    };
  \coherence := \axiom:funext(DivMod::[program]^, DivMod::[set],
    \fun (a: Nat^) => \axiom:funext(DivMod::[program]^ a, DivMod::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\correspondence Div: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind partial: \U(Nat -> P.Times[Nat, Nat]) <- (DivMod::[program] a) \then
    \bind result: P.Times[Nat, Nat] <- (\force partial) b \then
    \bind quotient: Nat <- (P.Times[Nat, Nat]::first result) \then
    \return quotient
  },
  \set := \fun (a, b: Nat^) =>
    P.Times[Nat, Nat]::first^ (DivMod::[set] a b),

  \definition matches (a, b: Nat^): Div::[program]^ a b = Div::[set] a b := congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ ((congr!{DivMod::[Type]^ _} (\fun (f: _) => f a b) _ _ DivMod::[coherence]));
  \coherence := \axiom:funext(Div::[program]^, Div::[set],
    \fun (a: Nat^) => \axiom:funext(Div::[program]^ a, Div::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\correspondence Mod: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind partial: \U(Nat -> P.Times[Nat, Nat]) <- (DivMod::[program] a) \then
    \bind result: P.Times[Nat, Nat] <- (\force partial) b \then
    \bind remainder: Nat <- (P.Times[Nat, Nat]::second result) \then
    \return remainder
  },
  \set := \fun (a, b: Nat^) =>
    P.Times[Nat, Nat]::second^ (DivMod::[set] a b),

  \definition matches (a, b: Nat^): Mod::[program]^ a b = Mod::[set] a b := congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ ((congr!{DivMod::[Type]^ _} (\fun (f: _) => f a b) _ _ DivMod::[coherence]));
  \coherence := \axiom:funext(Mod::[program]^, Mod::[set],
    \fun (a: Nat^) => \axiom:funext(Mod::[program]^ a, Mod::[set] a,
      \fun (b: Nat^) => matches a b)),
}

/* Euclid's transition is stationary at (a,0). Starting at (a,b), b steps
 * suffice because each nonzero second component strictly decreases. */
\correspondence GcdNext: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) {
  \program := \thunk(\cfun (p: P.Times[Nat, Nat]) => \match p \in P.Times \with {
    | pair a b : \match b \in Nat \with {
      | zero : \return(P.Times[Nat, Nat]::pair a Nat::zero)
      | succ d : \program {
        \bind partial: \U(Nat -> Nat) <- (Mod::[program] a) \then
        \bind r: Nat <- (\force partial) (Nat::succ d) \then
        \return P.Times[Nat, Nat]::pair (Nat::succ d) r
      }
    }
  }),
  \set := \induction (p: P.Times^[Nat^, Nat^]) \return NatPair \with {
    | pair : (\fun (a, b: Nat^) => \induction (b: Nat^) \return NatPair \with {
      | zero : (natPair a Nat^::zero)
      | succ : (\fun (d: Nat^) => \fun (_: _) => natPair (Nat^::succ d) (Mod::[set] a (Nat^::succ d)))
    } b)
  },

  \definition matches: \forall (p: NatPair) -> GcdNext::[program]^ p = GcdNext::[set] p :=
    \induction (p: P.Times^[Nat^, Nat^]) \return GcdNext::[program]^ p = GcdNext::[set] p \with {
      | pair : (\fun (a, b: Nat^) => \induction (b: Nat^) \return GcdNext::[program]^ (natPair a b) = GcdNext::[set] (natPair a b) \with {
        | zero : (\refl(natPair a Nat^::zero))
        | succ : (\fun (d: Nat^) => \fun (_: _) => \idelim Mod::[program]^ a (Nat^::succ d) = Mod::[set] a (Nat^::succ d)
            \with r: Nat^ => natPair (Nat^::succ d) (Mod::[program]^ a (Nat^::succ d)) = natPair (Nat^::succ d) r
            \by { base: \refl(natPair (Nat^::succ d) (Mod::[program]^ a (Nat^::succ d))), equality: (congr!{Mod::[Type]^ _} (\fun (f: _) => f a (Nat^::succ d)) _ _ Mod::[coherence]) })
      } b)
    };
  \coherence := \axiom:funext(GcdNext::[program]^, GcdNext::[set],
    \fun (p: NatPair) => matches p),
}

\correspondence Gcd: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind result: P.Times[Nat, Nat] <- PairIterLoop::[run] (PairIterState::running GcdNext::[program] (P.Times[Nat, Nat]::pair a b) b) \then
    \bind divisor: Nat <- (P.Times[Nat, Nat]::first result) \then
    \return divisor
  },
  \set := \fun (a, b: Nat^) =>
    P.Times[Nat, Nat]::first^ (PairIter::[set] GcdNext::[set] (natPair a b) b),

  \definition matches: \forall (a, b: Nat^) -> Gcd::[program]^ a b = Gcd::[set] a b :=
    \block {
      \fix (a, b: Nat^) \then
      \let iterationMatches:
        PairIter::[program]^ GcdNext::[program]^ (natPair a b) b =
          PairIter::[set] GcdNext::[program]^ (natPair a b) b :=
        (congr!{PairIter::[Type]^ _} (\fun (f: _) => f GcdNext::[program]^ (natPair a b) b) _ _ PairIter::[coherence]) \then
      \let stepMatches:
        PairIter::[set] GcdNext::[program]^ (natPair a b) b =
          PairIter::[set] GcdNext::[set] (natPair a b) b :=
        congr!{GcdNext::[Type]^ NatPair}
          (\fun (next: _) => PairIter::[set] next (natPair a b) b)
          _ _ GcdNext::[coherence] \then
      \let resultMatches:
        PairIter::[program]^ GcdNext::[program]^ (natPair a b) b =
          PairIter::[set] GcdNext::[set] (natPair a b) b :=
        trans!{NatPair} _ _ _ iterationMatches stepMatches \then
      \return congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ resultMatches
    };
  \coherence := \axiom:funext(Gcd::[program]^, Gcd::[set],
    \fun (a: Nat^) => \axiom:funext(Gcd::[program]^ a, Gcd::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\module Laws;
