/* Mapping acts independently on the two components. */
\definition mapFirstPair (f: A -> C) (a: A) (b: B):
  mapFirst A B C f (pair A B a b) = pair C B (f a) b := \refl(pair C B (f a) b);

\definition mapSecondPair (g: B -> D) (a: A) (b: B):
  mapSecond A B D g (pair A B a b) = pair A D a (g b) := \refl(pair A D a (g b));

\definition mapFirstSecond (f: A -> C) (p: Times^[A, B]):
  second C B (mapFirst A B C f p) = second A B p := \refl(second A B p);

\definition mapSecondFirst (g: B -> D) (p: Times^[A, B]):
  first A D (mapSecond A B D g p) = first A B p := \refl(first A B p);

\definition mapSeparate (f: A -> C) (g: B -> D) (p: Times^[A, B]):
  mapSecond C B D g (mapFirst A B C f p) = map A B C D f g p :=
    \refl(pair C D (f (first A B p)) (g (second A B p)));

\definition mapSeparateReverse (f: A -> C) (g: B -> D) (p: Times^[A, B]):
  mapFirst A D C f (mapSecond A B D g p) = map A B C D f g p :=
    \refl(pair C D (f (first A B p)) (g (second A B p)));

\definition mapPair (f: A -> C) (g: B -> D) (a: A) (b: B):
  map A B C D f g (pair A B a b) = pair C D (f a) (g b) := \refl(pair C D (f a) (g b));

\definition firstMap (f: A -> C) (g: B -> D) (p: Times^[A, B]):
  first C D (map A B C D f g p) = f (first A B p) := \refl(f (first A B p));

\definition secondMap (f: A -> C) (g: B -> D) (p: Times^[A, B]):
  second C D (map A B C D f g p) = g (second A B p) := \refl(g (second A B p));

\definition swapMap (f: A -> C) (g: B -> D) (p: Times^[A, B]):
  swap C D (map A B C D f g p) = map B A D C g f (swap A B p) :=
    \refl(pair D C (g (second A B p)) (f (first A B p)));

\module Composition(E, F: \Set) {
  \definition mapCompose (f: A -> C) (g: B -> D) (h: C -> E) (k: D -> F) (p: Times^[A, B]): map C D E F h k (map A B C D f g p) =
      map A B E F (\fun (a: A) => h (f a)) (\fun (b: B) => k (g b)) p :=
      \refl(pair E F (h (f (first A B p))) (k (g (second A B p))));
}
