/* Fixed carriers for Program operations; Times is inherited from this Pair instance. */
\correspondence Make: A ~> B ~> \F(Times[A, B]) {
  \definition implementation(a: A, b: B): \F(Times[A, B]) := Times[A, B]::make a b;
  \program := implementation,
  \set := pair A^ B^,
  \coherence := \axiom:funext(Make::[program]^, Make::[set],
    \fun (a: A^) => \axiom:funext(Make::[program]^ a, Make::[set] a,
    \fun (b: B^) => \refl(Make::[set] a b))),
}

\correspondence First: Times[A, B] ~> \F(A) {
  \definition implementation(p: Times[A, B]): \F(A) := Times[A, B]::first p;
  \program := implementation,
  \set := first A^ B^,
  \coherence := \axiom:funext(First::[program]^, First::[set],
    \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return First::[program]^ p = First::[set] p \with {
      | pair: \fun (a: A^) (b: B^) => \refl(First::[set] (Times^[A^, B^]::pair a b))
    } p),
}

\correspondence Second: Times[A, B] ~> \F(B) {
  \definition implementation(p: Times[A, B]): \F(B) := Times[A, B]::second p;
  \program := implementation,
  \set := second A^ B^,
  \coherence := \axiom:funext(Second::[program]^, Second::[set],
    \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return Second::[program]^ p = Second::[set] p \with {
      | pair: \fun (a: A^) (b: B^) => \refl(Second::[set] (Times^[A^, B^]::pair a b))
    } p),
}

\correspondence Swap: Times[A, B] ~> \F(Times[B, A]) {
  \definition implementation(p: Times[A, B]): \F(Times[B, A]) := Times[A, B]::swap p;
  \program := implementation,
  \set := swap A^ B^,
  \coherence := \axiom:funext(Swap::[program]^, Swap::[set],
    \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return Swap::[program]^ p = Swap::[set] p \with {
      | pair: \fun (a: A^) (b: B^) => \refl(Swap::[set] (Times^[A^, B^]::pair a b))
    } p),
}

\module Mapping(C, D: \VType);
\module Functions(C: \VType);
