/* The left computation runs before the right computation, once each. */
\correspondence Map: (A -> C) ~> (B -> D) ~> Times[A, B] ~> \F(Times[C, D]) {
  \definition implementation(f: A -> C, g: B -> D, p: Times[A, B]): \F(Times[C, D]) :=
    \match p \in Times \with {
    | pair a b : \program {
        \bind c: C <- \force f a \then
        \bind d: D <- \force g b \then
        \return Times[C, D]::pair c d
      }
    };
  \program := implementation,
  \set := map A^ B^ C^ D^,
  \coherence := \axiom:funext(Map::[program]^, Map::[set],
    \fun (f: A^ -> C^) => \axiom:funext(Map::[program]^ f, Map::[set] f,
    \fun (g: B^ -> D^) => \axiom:funext(Map::[program]^ f g, Map::[set] f g,
    \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return Map::[program]^ f g p = Map::[set] f g p \with {
      | pair: \fun (a: A^) (b: B^) => \refl(Map::[set] f g (Times^[A^, B^]::pair a b))
    } p))),
}

\correspondence MapFirst: (A -> C) ~> Times[A, B] ~> \F(Times[C, B]) {
  \definition implementation(f: A -> C, p: Times[A, B]): \F(Times[C, B]) :=
    \match p \in Times \with {
    | pair a b : \program {
        \bind c: C <- \force f a \then
        \return Times[C, B]::pair c b
      }
    };
  \program := implementation,
  \set := mapFirst A^ B^ C^,
  \coherence := \axiom:funext(MapFirst::[program]^, MapFirst::[set],
    \fun (f: A^ -> C^) => \axiom:funext(MapFirst::[program]^ f, MapFirst::[set] f,
    \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return MapFirst::[program]^ f p = MapFirst::[set] f p \with {
      | pair: \fun (a: A^) (b: B^) => \refl(MapFirst::[set] f (Times^[A^, B^]::pair a b))
    } p)),
}

\correspondence MapSecond: (B -> D) ~> Times[A, B] ~> \F(Times[A, D]) {
  \definition implementation(g: B -> D, p: Times[A, B]): \F(Times[A, D]) :=
    \match p \in Times \with {
    | pair a b : \program {
        \bind d: D <- \force g b \then
        \return Times[A, D]::pair a d
      }
    };
  \program := implementation,
  \set := mapSecond A^ B^ D^,
  \coherence := \axiom:funext(MapSecond::[program]^, MapSecond::[set],
    \fun (g: B^ -> D^) => \axiom:funext(MapSecond::[program]^ g, MapSecond::[set] g,
    \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return MapSecond::[program]^ g p = MapSecond::[set] g p \with {
      | pair: \fun (a: A^) (b: B^) => \refl(MapSecond::[set] g (Times^[A^, B^]::pair a b))
    } p)),
}
