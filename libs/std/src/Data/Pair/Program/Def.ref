\import std.Program[] \as ProgramBundles;
/* Fixed carriers for Program operations; Times is inherited from this Pair instance. */

\module MakeImplementation {
  \definition T: \VType := \U(A ~> B ~> \F(Times[A, B]));

  \definition implementation(a: A, b: B): \F(Times[A, B]) := Times[A, B]::make a b;

  \definition program: A ~> B ~> \F(Times[A, B]) := implementation;

  \definition specification: T^ := pair A^ B^;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: A^) => \axiom:funext(program^ a, specification a,
      \fun (b: B^) => \refl(specification a b)));
}
\import .MakeImplementation[] \as MakeParts;
\definition Make: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MakeParts.T,
  program := \thunk (MakeParts.program),
  specification := MakeParts.specification,
  coherence := MakeParts.coherence,
};

\module FirstImplementation {
  \definition T: \VType := \U(Times[A, B] ~> \F(A));

  \definition implementation(p: Times[A, B]): \F(A) := Times[A, B]::first p;

  \definition program: Times[A, B] ~> \F(A) := implementation;

  \definition specification: T^ := first A^ B^;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return program^ p = specification p \with {
        | pair: \fun (a: A^) (b: B^) => \refl(specification (Times^[A^, B^]::pair a b))
      } p);
}
\import .FirstImplementation[] \as FirstParts;
\definition First: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := FirstParts.T,
  program := \thunk (FirstParts.program),
  specification := FirstParts.specification,
  coherence := FirstParts.coherence,
};

\module SecondImplementation {
  \definition T: \VType := \U(Times[A, B] ~> \F(B));

  \definition implementation(p: Times[A, B]): \F(B) := Times[A, B]::second p;

  \definition program: Times[A, B] ~> \F(B) := implementation;

  \definition specification: T^ := second A^ B^;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return program^ p = specification p \with {
        | pair: \fun (a: A^) (b: B^) => \refl(specification (Times^[A^, B^]::pair a b))
      } p);
}
\import .SecondImplementation[] \as SecondParts;
\definition Second: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SecondParts.T,
  program := \thunk (SecondParts.program),
  specification := SecondParts.specification,
  coherence := SecondParts.coherence,
};

\module SwapImplementation {
  \definition T: \VType := \U(Times[A, B] ~> \F(Times[B, A]));

  \definition implementation(p: Times[A, B]): \F(Times[B, A]) := Times[A, B]::swap p;

  \definition program: Times[A, B] ~> \F(Times[B, A]) := implementation;

  \definition specification: T^ := swap A^ B^;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (p: Times^[A^, B^]) => \induction (p: Times^[A^, B^]) \return program^ p = specification p \with {
        | pair: \fun (a: A^) (b: B^) => \refl(specification (Times^[A^, B^]::pair a b))
      } p);
}
\import .SwapImplementation[] \as SwapParts;
\definition Swap: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SwapParts.T,
  program := \thunk (SwapParts.program),
  specification := SwapParts.specification,
  coherence := SwapParts.coherence,
};
