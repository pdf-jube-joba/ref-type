/* The left computation runs before the right computation, once each. */
\definition map(f: A -> C, g: B -> D, p: Times[A, B]): \F(Times[C, D]) :=
  \match p \in Times \with {
  | pair a b => \program {
      \bind c: C <- \force f a \then
      \bind d: D <- \force g b \then
      \return Times[C, D]::pair c d
    }
  };

\definition mapFirst(f: A -> C, p: Times[A, B]): \F(Times[C, B]) :=
  \match p \in Times \with {
  | pair a b => \program {
      \bind c: C <- \force f a \then
      \return Times[C, B]::pair c b
    }
  };

\definition mapSecond(g: B -> D, p: Times[A, B]): \F(Times[A, D]) :=
  \match p \in Times \with {
  | pair a b => \program {
      \bind d: D <- \force g b \then
      \return Times[A, D]::pair a d
    }
  };
