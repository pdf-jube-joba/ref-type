/* Pointwise inverse laws need no function-extensionality axiom. */
\definition curryUncurry (f: A -> B -> C) (a: A) (b: B):
  curry A B C (uncurry A B C f) a b = f a b := \refl(f a b);

\definition uncurryCurry (f: Times^[A, B] -> C) (p: Times^[A, B]):
  uncurry A B C (curry A B C f) p = f p :=
    \induction (p: Times^[A, B]) \return uncurry A B C (curry A B C f) p = f p \with {
      | pair => (\fun (a: A) => \fun (b: B) => \refl(f (pair A B a b)))
      } p;

\definition assocPair (a: A) (b: B) (c: C):
  assoc A B C (pair Times^[A, B] C (pair A B a b) c) = pair A Times^[B, C] a (pair B C b c) := \refl(pair A Times^[B, C] a (pair B C b c));

\definition unassocPair (a: A) (b: B) (c: C):
  unassoc A B C (pair A Times^[B, C] a (pair B C b c)) = pair Times^[A, B] C (pair A B a b) c := \refl(pair Times^[A, B] C (pair A B a b) c);

\definition unassocAssoc: \forall (p: Times^[Times^[A, B], C]) -> unassoc A B C (assoc A B C p) = p :=
  \induction (p: Times^[Times^[A, B], C]) \return unassoc A B C (assoc A B C p) = p \with {
    | pair => (\fun (ab: Times^[A, B]) => \fun (c: C) =>
      \induction (ab: Times^[A, B]) \return unassoc A B C (assoc A B C (pair Times^[A, B] C ab c)) = pair Times^[A, B] C ab c \with {
      | pair => (\fun (a: A) => \fun (b: B) => \refl(pair Times^[A, B] C (pair A B a b) c))
      } ab)
    };

\definition assocUnassoc: \forall (p: Times^[A, Times^[B, C]]) -> assoc A B C (unassoc A B C p) = p :=
  \induction (p: Times^[A, Times^[B, C]]) \return assoc A B C (unassoc A B C p) = p \with {
    | pair => (\fun (a: A) => \fun (bc: Times^[B, C]) =>
      \induction (bc: Times^[B, C]) \return assoc A B C (unassoc A B C (pair A Times^[B, C] a bc)) = pair A Times^[B, C] a bc \with {
      | pair => (\fun (b: B) => \fun (c: C) => \refl(pair A Times^[B, C] a (pair B C b c)))
      } bc)
    };
