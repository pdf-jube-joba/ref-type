/* Finite lists over an arbitrary Set carrier. */
\import std.Nat[] \as N;

\inductive List[A: \Set]: \Set :=
| nil: List
| cons: A -> List -> List
;

\definition length (A: \Set) (xs: List[A]): N.Nat^ :=
  \prec[List[A], \fun (xs: List[A]) => N.Nat^]
    N.Nat^::zero
    (\fun (head: A) => \fun (tail: List[A]) => \fun (tailLength: N.Nat^) => N.Nat^::succ tailLength)
    xs;

\definition map (A, B: \Set) (f: A -> B) (xs: List[A]): List[B] :=
  \prec[List[A], \fun (xs: List[A]) => List[B]]
    List[B]::nil
    (\fun (head: A) => \fun (tail: List[A]) => \fun (mappedTail: List[B]) =>
      List[B]::cons (f head) mappedTail)
    xs;

\definition foldr (A, B: \Set) (f: A -> B -> B) (initial: B) (xs: List[A]): B :=
  \prec[List[A], \fun (xs: List[A]) => B]
    initial
    (\fun (head: A) => \fun (tail: List[A]) => \fun (foldedTail: B) => f head foldedTail)
    xs;

\definition foldl (A, B: \Set) (f: B -> A -> B) (initial: B) (xs: List[A]): B :=
  (\prec[List[A], \fun (xs: List[A]) => B -> B]
    (\fun (acc: B) => acc)
    (\fun (head: A) => \fun (tail: List[A]) => \fun (foldedTail: B -> B) =>
      \fun (acc: B) => foldedTail (f acc head))
    xs) initial;

\definition append (A: \Set) (xs, ys: List[A]): List[A] :=
  \prec[List[A], \fun (xs: List[A]) => List[A]]
    ys
    (\fun (head: A) => \fun (tail: List[A]) => \fun (appendedTail: List[A]) =>
      List[A]::cons head appendedTail)
    xs;

\definition reverse (A: \Set) (xs: List[A]): List[A] :=
  \prec[List[A], \fun (xs: List[A]) => List[A]]
    List[A]::nil
    (\fun (head: A) => \fun (tail: List[A]) => \fun (reversedTail: List[A]) =>
      append A reversedTail (List[A]::cons head List[A]::nil))
    xs;

\module Laws(A: \Set);
