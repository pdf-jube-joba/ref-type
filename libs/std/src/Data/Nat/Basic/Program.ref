\import std.Program[] \as ProgramBundles;
\import std.Data[].Bool[] \as B;

\definition zero: Nat := Nat::zero;

\definition one: Nat := Nat::succ Nat::zero;

\inductive AddState: \VType :=
| running: Nat -> Nat -> AddState
;

\module AddLoopImplementation {
  \definition State: \VType := AddState;

  \definition Output: \VType := Nat;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: AddState) => \match state \in AddState \with {
      | running accumulator remaining :
          \match remaining \in Nat \with {
            | zero :
              \return(\finish[AddState, Nat](accumulator))
            | succ smaller :
              \return(\continue[AddState, Nat](AddState::running (Nat::succ accumulator) smaller))
          }
    });

  \import std.Logic[].Termination[State := AddState^, Output := Nat^,
      step := step^] \as Termination;

  \definition terminates:
      \forall (remaining: Nat^) -> \forall (accumulator: Nat^) ->
        Termination.Holds (AddState^::running accumulator remaining) :=
      \induction (n: Nat^) \return \forall (a: Nat^) -> Termination.Holds (AddState^::running a n) \with {
        | zero : (\fun (a: Nat^) => Termination.intro (AddState^::running a Nat^::zero) Termination.trivial)
        | succ : (\fun (n: Nat^) => \fun (ih: _) =>
          \fun (a: Nat^) => Termination.intro (AddState^::running a (Nat^::succ n)) (ih (Nat^::succ a)))
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: AddState^) \return
      Termination.Holds s \with {
        | running: \fun (accumulator, remaining: Nat^) => terminates remaining accumulator
      };
}

\import .AddLoopImplementation[] \as AddLoopParts;

\definition AddLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := AddLoopParts.State,
  Output := AddLoopParts.Output,
  step := AddLoopParts.step,
  terminates := AddLoopParts.certificate,
};

\definition add: \U(Nat -> Nat -> Nat) :=
  \thunk (\fun (left, right: Nat) =>
      (\force AddLoop.run) (AddState::running left right));

\definition pred: \U(Nat -> Nat) :=
  \thunk ((\cfun (n: Nat) => \match n \in Nat \with { | zero : \return Nat::zero | succ k : \return k }));

\definition isZero: \U(Nat -> B.Bool) :=
  \thunk ((\cfun (n: Nat) => \match n \in Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false }));

\inductive SubState: \VType := | running: Nat -> Nat -> SubState;

\module SubLoopImplementation {
  \definition State: \VType := SubState;

  \definition Output: \VType := Nat;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: SubState) => \match state \in SubState \with { | running a b :
      \match b \in Nat \with {
        | zero : \return(\finish[SubState, Nat](a))
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[SubState, Nat](Nat::zero))
          | succ j : \return(\continue[SubState, Nat](SubState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := SubState^, Output := Nat^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (SubState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (SubState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (SubState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (SubState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (SubState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (SubState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (SubState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (SubState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: SubState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}

\import .SubLoopImplementation[] \as SubLoopParts;

\definition SubLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := SubLoopParts.State,
  Output := SubLoopParts.Output,
  step := SubLoopParts.step,
  terminates := SubLoopParts.certificate,
};

\definition sub: \U(Nat -> Nat -> Nat) :=
  \thunk (\fun (a, b: Nat) =>
      (\force SubLoop.run) (SubState::running a b));

\inductive EqbState: \VType := | running: Nat -> Nat -> EqbState;

\module EqbLoopImplementation {
  \definition State: \VType := EqbState;

  \definition Output: \VType := B.Bool;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: EqbState) => \match state \in EqbState \with { | running a b :
      \match b \in Nat \with {
        | zero : \match a \in Nat \with { | zero : \return(\finish[EqbState, B.Bool](B.Bool::true)) | succ k :
          \return(\finish[EqbState, B.Bool](B.Bool::false)) }
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[EqbState, B.Bool](B.Bool::false))
          | succ j : \return(\continue[EqbState, B.Bool](EqbState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := EqbState^, Output := B.Bool^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (EqbState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (EqbState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (EqbState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (EqbState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (EqbState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (EqbState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (EqbState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (EqbState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: EqbState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}

\import .EqbLoopImplementation[] \as EqbLoopParts;

\definition EqbLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := EqbLoopParts.State,
  Output := EqbLoopParts.Output,
  step := EqbLoopParts.step,
  terminates := EqbLoopParts.certificate,
};

\definition eqb: \U(Nat -> Nat -> B.Bool) :=
  \thunk (\fun (a, b: Nat) =>
      (\force EqbLoop.run) (EqbState::running a b));

\inductive LebState: \VType := | running: Nat -> Nat -> LebState;

\module LebLoopImplementation {
  \definition State: \VType := LebState;

  \definition Output: \VType := B.Bool;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: LebState) => \match state \in LebState \with { | running a b :
      \match b \in Nat \with {
        | zero : \match a \in Nat \with { | zero : \return(\finish[LebState, B.Bool](B.Bool::true)) | succ k :
          \return(\finish[LebState, B.Bool](B.Bool::false)) }
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[LebState, B.Bool](B.Bool::true))
          | succ j : \return(\continue[LebState, B.Bool](LebState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := LebState^, Output := B.Bool^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (LebState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (LebState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (LebState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (LebState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (LebState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (LebState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (LebState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (LebState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: LebState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}

\import .LebLoopImplementation[] \as LebLoopParts;

\definition LebLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := LebLoopParts.State,
  Output := LebLoopParts.Output,
  step := LebLoopParts.step,
  terminates := LebLoopParts.certificate,
};

\definition leb: \U(Nat -> Nat -> B.Bool) :=
  \thunk (\fun (a, b: Nat) =>
      (\force LebLoop.run) (LebState::running a b));

\inductive LtbState: \VType := | running: Nat -> Nat -> LtbState;

\module LtbLoopImplementation {
  \definition State: \VType := LtbState;

  \definition Output: \VType := B.Bool;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: LtbState) => \match state \in LtbState \with { | running a b :
      \match b \in Nat \with {
        | zero : \return(\finish[LtbState, B.Bool](B.Bool::false))
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[LtbState, B.Bool](B.Bool::true))
          | succ j : \return(\continue[LtbState, B.Bool](LtbState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := LtbState^, Output := B.Bool^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (LtbState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (LtbState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (LtbState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (LtbState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (LtbState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (LtbState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (LtbState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (LtbState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: LtbState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}

\import .LtbLoopImplementation[] \as LtbLoopParts;

\definition LtbLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := LtbLoopParts.State,
  Output := LtbLoopParts.Output,
  step := LtbLoopParts.step,
  terminates := LtbLoopParts.certificate,
};

\definition ltb: \U(Nat -> Nat -> B.Bool) :=
  \thunk (\fun (a, b: Nat) =>
      (\force LtbLoop.run) (LtbState::running a b));

\inductive IterState: \VType :=
| running: \U(Nat -> Nat) -> Nat -> Nat -> IterState
;

\module IterLoopImplementation {
  \definition State: \VType := IterState;

  \definition Output: \VType := Nat;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: IterState) => \match state \in IterState \with {
      | running f value count : \match count \in Nat \with {
        | zero : \return(\finish[IterState, Nat](value))
        | succ k : \program {
          \bind next: Nat <- (\force f) value \then
          \return \continue[IterState, Nat](IterState::running f next k)
        }
      }
    });

  \import std.Logic[].Termination[State := IterState^, Output := Nat^,
      step := step^] \as Termination;

  \definition terminates: \forall (count: Nat^) (f: Nat^ -> Nat^) (value: Nat^) ->
      Termination.Holds (IterState^::running f value count) :=
      \induction (count: Nat^) \return \forall (f: Nat^ -> Nat^) (value: Nat^) ->
        Termination.Holds (IterState^::running f value count) \with {
        | zero: \fun (f: Nat^ -> Nat^) (value: Nat^) =>
          Termination.intro (IterState^::running f value Nat^::zero) Termination.trivial
        | succ: \fun (k: Nat^) (ih: _) (f: Nat^ -> Nat^) (value: Nat^) =>
          Termination.intro (IterState^::running f value (Nat^::succ k)) (ih f (f value))
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: IterState^) \return
      Termination.Holds s \with {
        | running: \fun (f: Nat^ -> Nat^) (value, count: Nat^) => terminates count f value
      };
}

\import .IterLoopImplementation[] \as IterLoopParts;

\definition IterLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := IterLoopParts.State,
  Output := IterLoopParts.Output,
  step := IterLoopParts.step,
  terminates := IterLoopParts.certificate,
};

\definition iter: \U(\U(Nat -> Nat) -> Nat -> Nat -> Nat) :=
  \fun (f: \U(Nat -> Nat)) =>
      \fun (value, count: Nat) =>
        (\force IterLoop.run) (IterState::running f value count);

\definition mul: \U(Nat -> Nat -> Nat) :=
  \thunk (\fun (a, b: Nat) =>
      (\force IterLoop.run) (IterState::running
        \thunk(\cfun (current: Nat) => (\force AddLoop.run) (AddState::running a current))
        Nat::zero b));

\definition pow: \U(Nat -> Nat -> Nat) :=
  \thunk (\fun (a, b: Nat) =>
      (\force IterLoop.run) (IterState::running
        \thunk(\cfun (current: Nat) => (\force IterLoop.run) (IterState::running
            \thunk(\cfun (next: Nat) => (\force AddLoop.run) (AddState::running a next))
            Nat::zero current))
        one b));

\definition choose: \U(B.Bool -> Nat -> Nat -> Nat) :=
  \thunk (\fun (test: B.Bool) =>
      \fun (yes, no: Nat) =>
        \match test \in B.Bool \with { | false : \return no | true : \return yes });

\definition min: \U(Nat -> Nat -> Nat) :=
  \thunk (\fun (a, b: Nat) => \program {
      \bind test: B.Bool <- (\force LtbLoop.run) (LtbState::running a b) \then
      \bind selected: Nat <- \match test \in B.Bool \with { | false : \return b | true : \return a } \then
      \return selected
    });

\definition max: \U(Nat -> Nat -> Nat) :=
  \thunk (\fun (a, b: Nat) => \program {
      \bind test: B.Bool <- (\force LtbLoop.run) (LtbState::running a b) \then
      \bind selected: Nat <- \match test \in B.Bool \with { | false : \return a | true : \return b } \then
      \return selected
    });
