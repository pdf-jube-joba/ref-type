\import std.Data[].Nat[].Iteration[].Def[A := Nat^] \as NatIteration;

\module IterProof {
  \definition T: \VType := \U(\U(Nat -> Nat) -> Nat -> Nat -> Nat);

  \definition program: T := Programs.iter;

  \definition specification: T^ := Def.iter;

  \definition matches (f: Nat^ -> Nat^): \forall (count, value: Nat^) ->
      program^ f value count = specification f value count :=
      \induction (count: Nat^) \return \forall (value: Nat^) -> program^ f value count = specification f value count \with {
        | zero : (\fun (value: Nat^) => \refl(value))
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \fun (value: Nat^) =>
            \idelim specification f (f value) k = f (specification f value k)
              \with x: Nat^ => program^ f value (Nat^::succ k) = x
            \by { base: ih (f value), equality: (NatIteration.specification #advance) f k value })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (f: Nat^ -> Nat^) => \axiom:funext(program^ f, specification f,
        \fun (value: Nat^) => \axiom:funext(program^ f value, specification f value,
          \fun (count: Nat^) => matches f count value)));
}

\import .IterProof[] \as IterParts;

\definition Iter: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := IterParts.T,
  program := IterParts.program,
  specification := IterParts.specification,
  coherence := IterParts.coherence,
};

\module MulProof {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: T := Programs.mul;

  \definition specification: T^ := Def.mul;

  \math-macro nat_mul($x, "*", $y) := program^ $x $y;

  \definition matches (a, b: Nat^): \(a "*" b\) = specification a b :=
      trans!{Nat^} _ _ _
        (congr!{Iter.T^ _} (\fun (f: _) => f (Add.program^ a) Nat^::zero b) _ _ Iter.coherence)
        (congr!{Add.T^ Nat^}
        (\fun (operation: _) => Iter.specification (operation a) Nat^::zero b) _ _ Add.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}

\import .MulProof[] \as MulParts;

\definition Mul: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MulParts.T,
  program := MulParts.program,
  specification := MulParts.specification,
  coherence := MulParts.coherence,
};

\module PowProof {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: T := Programs.pow;

  \definition specification: T^ := Def.pow;

  \definition matches (a, b: Nat^): program^ a b = specification a b :=
      trans!{Nat^} _ _ _
        (congr!{Iter.T^ _} (\fun (f: _) => f (Mul.program^ a) (Nat^::succ Nat^::zero) b) _ _ Iter.coherence)
        (congr!{Mul.T^ Nat^}
        (\fun (operation: _) => Iter.specification (operation a) (Nat^::succ Nat^::zero) b) _ _ Mul.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}

\import .PowProof[] \as PowParts;

\definition Pow: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PowParts.T,
  program := PowParts.program,
  specification := PowParts.specification,
  coherence := PowParts.coherence,
};

\module ChooseProof {
  \definition T: \VType := \U(B.Bool -> Nat -> Nat -> Nat);

  \definition program: T := Programs.choose;

  \definition specification: T^ := Def.choose;

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: Nat^) -> program^ test yes no = specification test yes
      no :=
      \induction (test: B.Bool^) \return \forall (yes, no: Nat^) -> program^ test yes no = specification test yes no \with {
        | false : (\fun (yes, no: Nat^) => \refl(no))
        | true : (\fun (yes, no: Nat^) => \refl(yes))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (test: B.Bool^) => \axiom:funext(program^ test, specification test,
        \fun (yes: Nat^) => \axiom:funext(program^ test yes, specification test yes,
          \fun (no: Nat^) => matches test yes no)));
}

\import .ChooseProof[] \as ChooseParts;

\definition Choose: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := ChooseParts.T,
  program := ChooseParts.program,
  specification := ChooseParts.specification,
  coherence := ChooseParts.coherence,
};

\module MinProof {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: T := Programs.min;

  \definition specification: T^ := Def.min;

  \definition matches: \forall (a, b: Nat^) -> program^ a b = specification a b :=
      \block {
        \fun (a, b: Nat^) \then
        \let testMatches: Ltb.program^ a b = Ltb.specification a b := (congr!{Ltb.T^ _} (\fun (f: _) => f a b) _ _ Ltb.coherence) \then
        \return
        \idelim Ltb.program^ a b = Ltb.specification a b
          \with test: B.Bool^ => program^ a b = Choose.specification test a b
        \by { base: (congr!{Choose.T^ _} (\fun (f: _) => f (Ltb.program^ a b) a b) _ _ Choose.coherence), equality: testMatches }
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}

\import .MinProof[] \as MinParts;

\definition Min: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MinParts.T,
  program := MinParts.program,
  specification := MinParts.specification,
  coherence := MinParts.coherence,
};

\module MaxProof {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: T := Programs.max;

  \definition specification: T^ := Def.max;

  \definition matches: \forall (a, b: Nat^) -> program^ a b = specification a b :=
      \block {
        \fun (a, b: Nat^) \then
        \let testMatches: Ltb.program^ a b = Ltb.specification a b := (congr!{Ltb.T^ _} (\fun (f: _) => f a b) _ _ Ltb.coherence) \then
        \return
        \idelim Ltb.program^ a b = Ltb.specification a b
          \with test: B.Bool^ => program^ a b = Choose.specification test b a
        \by { base: (congr!{Choose.T^ _} (\fun (f: _) => f (Ltb.program^ a b) b a) _ _ Choose.coherence), equality: testMatches }
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}

\import .MaxProof[] \as MaxParts;

\definition Max: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MaxParts.T,
  program := MaxParts.program,
  specification := MaxParts.specification,
  coherence := MaxParts.coherence,
};
