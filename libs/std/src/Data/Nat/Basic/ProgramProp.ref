\import \parent.Def[] \as Def;
\import \parent.Program[] \as Programs;
\import std.Program[] \as ProgramBundles;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;
\import std.Data[].Bool[] \as B;

\definition zeroCoherence: Programs.zero^ = Def.zero := \refl(Def.zero);
\definition oneCoherence: Programs.one^ = Def.one := \refl(Def.one);

\definition succCong: \forall (a, b: Nat^) -> a = b -> Nat^::succ a = Nat^::succ b := Def.succCong;

\module AddProof {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: T := Programs.add;

  \definition specification: T^ := Def.add;

  \definition succLeft (a: Nat^):
      \forall (b: Nat^) -> specification (Nat^::succ a) b = Nat^::succ (specification a b) :=
      \induction (b: Nat^) \return specification (Nat^::succ a) b = Nat^::succ (specification a b) \with {
        | zero : (\refl(Nat^::succ a))
        | succ : (\fun (b: Nat^) => \fun (ih: _) =>
          succCong (specification (Nat^::succ a) b) (Nat^::succ (specification a b)) ih)
      };

  \math-macro nat_add($x, "+", $y) := program^ $x $y;

  \definition matches: \forall (b, a: Nat^) -> \(a "+" b\) = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> \(a "+" b\) = specification a b \with {
        | zero : (\fun (a: Nat^) => \refl(a))
        | succ : (\fun (b: Nat^) => \fun (ih: _) => \fun (a: Nat^) =>
          eq_reason!{
            \(a "+" { Nat^::succ b }\)
            "=" { specification (Nat^::succ a) b } "by" { ih (Nat^::succ a) }
            "=" { Nat^::succ (specification a b) } "by" { succLeft a b }
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}

\import .AddProof[] \as AddParts;

\definition Add: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := AddParts.T,
  program := AddParts.program,
  specification := AddParts.specification,
  coherence := AddParts.coherence,
};

\module PredProof {
  \definition T: \VType := \U(Nat -> Nat);

  \definition program: T := Programs.pred;

  \definition specification: T^ := Def.pred;

  \definition matches: \forall (n: Nat^) -> program^ n = specification n :=
      \induction (n: Nat^) \return program^ n = specification n \with {
        | zero : (\refl(Nat^::zero))
        | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(k))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (n: Nat^) => matches n);
}

\import .PredProof[] \as PredParts;

\definition Pred: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PredParts.T,
  program := PredParts.program,
  specification := PredParts.specification,
  coherence := PredParts.coherence,
};

\module IsZeroProof {
  \definition T: \VType := \U(Nat -> B.Bool);

  \definition program: T := Programs.isZero;

  \definition specification: T^ := Def.isZero;

  \definition matches: \forall (n: Nat^) -> program^ n = specification n :=
      \induction (n: Nat^) \return program^ n = specification n \with {
        | zero : (\refl(B.Bool^::true))
        | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(B.Bool^::false))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (n: Nat^) => matches n);
}

\import .IsZeroProof[] \as IsZeroParts;

\definition IsZero: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := IsZeroParts.T,
  program := IsZeroParts.program,
  specification := IsZeroParts.specification,
  coherence := IsZeroParts.coherence,
};

\module SubProof {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: T := Programs.sub;

  \definition specification: T^ := Def.sub;

  \definition matches: \forall (b, a: Nat^) -> program^ a b = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> program^ a b = specification a b \with {
        | zero : (\induction (a: Nat^) \return program^ a Nat^::zero = specification a Nat^::zero \with {
          | zero : (\refl(specification Nat^::zero
          Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(specification
          (Nat^::succ j) Nat^::zero))
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return program^ a (Nat^::succ k) = specification a (Nat^::succ k) \with {
            | zero : (\refl(Nat^::zero))
            | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}

\import .SubProof[] \as SubParts;

\definition Sub: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SubParts.T,
  program := SubParts.program,
  specification := SubParts.specification,
  coherence := SubParts.coherence,
};

\module EqbProof {
  \definition T: \VType := \U(Nat -> Nat -> B.Bool);

  \definition program: T := Programs.eqb;

  \definition specification: T^ := Def.eqb;

  \definition matches: \forall (b, a: Nat^) -> program^ a b = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> program^ a b = specification a b \with {
        | zero : (\induction (a: Nat^) \return program^ a Nat^::zero = specification a Nat^::zero \with {
          | zero : (\refl(specification Nat^::zero
          Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(specification
          (Nat^::succ j) Nat^::zero))
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return program^ a (Nat^::succ k) = specification a (Nat^::succ k) \with {
            | zero : (\refl(B.Bool^::false))
            | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}

