\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;
\use Equality.congr2;

\import std.Data[].Bool[] \as B;
\import B.Prop[] \as BoolLaws;

\import std.Data[].Nat[].Basic[].Def[] \as Op;
\use Op.nat_add;
\use Op.nat_mul;

/* Arithmetic laws on the Set specifications. */
\import std.Logic[].Rel[] \as Rel;
\import std.Logic[].Algebra[].Def[] \as Law;
\definition succInjective(a, b: Nat^):
  Nat^::succ a = Nat^::succ b ->
  a = b := congr!{Nat^ Nat^} Op.Pred.specification (Nat^::succ a) (Nat^::succ b);
\definition predZero: Op.Pred.specification Nat^::zero = Nat^::zero := \refl(Nat^::zero);
\definition predSucc(n: Nat^): Op.Pred.specification (Nat^::succ n) = n := \refl(n);
\definition addZeroRight(a: Nat^): \(a "+" { Nat^::zero }\) = a := \refl(a);
\definition addSuccLeft:
  \forall (a, b: Nat^) ->
  \({ Nat^::succ a } "+" b\) = Nat^::succ \(a "+" b\) :=
  \fun (a, b: Nat^) =>
    (\induction (b: Nat^) \return \forall (a: Nat^) ->
      \({ Nat^::succ a } "+" b\) = Nat^::succ \(a "+" b\) \with {
      | zero: \fun (a: Nat^) => \refl(Nat^::succ a)
      | succ: \fun (b: Nat^) (ih: _) (a: Nat^) => Op.succCong _ _ (ih a)
    }) b a;
\definition addSuccRight(a, b: Nat^): \(a "+" { Nat^::succ b }\) = Nat^::succ \(a "+" b\) := \refl(Nat^::succ \(a "+" b\));
\definition addZeroLeft: \forall (a: Nat^) -> \({ Nat^::zero } "+" a\) = a :=
  \induction (a: Nat^) \return \({ Nat^::zero } "+" a\) = a \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \({ Nat^::zero } "+" a\) = a) =>
      trans!{Nat^} _ _ _ (addSuccRight Nat^::zero a) (Op.succCong \({ Nat^::zero } "+" a\) a ih))
    };
\definition addComm(a: Nat^): \forall (b: Nat^) -> \(a "+" b\) = \(b "+" a\) :=
  \induction (b: Nat^) \return \(a "+" b\) = \(b "+" a\) \with {
    | zero : sym!{Nat^} _ _ (addZeroLeft a)
    | succ : \fun (b: Nat^) (ih: \(a "+" b\) = \(b "+" a\)) => eq_reason!{
        \(a "+" { Nat^::succ b }\)
        "=" { Nat^::succ \(a "+" b\) } "by" { addSuccRight a b }
        "=" { Nat^::succ \(b "+" a\) } "by" { Op.succCong _ _ ih }
        "=" \({ Nat^::succ b } "+" a\) "by" { sym!{Nat^} _ _ (addSuccLeft b a) }
      }
  };
\definition addAssoc(a, b: Nat^):
  \forall (c: Nat^) ->
  \((a "+" b) "+" c\) = \(a "+" (b "+" c)\) :=
  \induction (c: Nat^) \return \((a "+" b) "+" c\) = \(a "+" (b "+" c)\) \with {
    | zero : \refl(\(a "+" b\))
    | succ : \fun (c: Nat^) (ih: \((a "+" b) "+" c\) = \(a "+" (b "+" c)\)) =>
      eq_reason!{
        \((a "+" b) "+" { Nat^::succ c }\)
        "=" { Nat^::succ \((a "+" b) "+" c\) } "by" { addSuccRight \(a "+" b\) c }
        "=" { Nat^::succ \(a "+" (b "+" c)\) } "by" { Op.succCong _ _ ih }
        "=" \(a "+" { Nat^::succ \(b "+" c\) }\)
        "by" { sym!{Nat^} _ _ (addSuccRight a \(b "+" c\)) }
        "=" \(a "+" (b "+" { Nat^::succ c })\)
        "by" { congr!{Nat^ Nat^} (Op.Add.specification a) _ _ (sym!{Nat^} _ _ (addSuccRight b c)) }
      }
  };
\definition addCancelRight: \forall (c, a, b: Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b \with {
    | zero : (\fun (a, b: Nat^) => \fun (e: a = b) => e)
    | succ : (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b) =>
      \fun (a, b: Nat^) => \fun (e: \(a "+" { Nat^::succ c }\) = \(b "+" { Nat^::succ c }\)) =>
        ih a b (succInjective _ _
          (trans!{Nat^} _ _ _ (sym!{Nat^} _ _ (addSuccRight a c))
            (trans!{Nat^} _ _ _ e (addSuccRight b c)))))
    };
\definition addCancelLeft: \forall (c, a, b: Nat^) -> \(c "+" a\) = \(c "+" b\) -> a = b :=
  \fun (c, a, b: _) (e: _) =>
    addCancelRight c a b eq_reason!{
      \(a "+" c\) "=" \(c "+" a\) "by" { addComm a c }
      "=" \(c "+" b\) "by" e
      "=" \(b "+" c\) "by" { addComm c b }
    };
\definition subZeroRight(a: Nat^): Op.Sub.specification a Nat^::zero = a := \refl(a);
\definition subZeroLeft: \forall (a: Nat^) -> Op.Sub.specification Nat^::zero a = Nat^::zero :=
  \induction (a: Nat^) \return Op.Sub.specification Nat^::zero a = Nat^::zero \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: Op.Sub.specification Nat^::zero a = Nat^::zero) => \refl(Nat^::zero))
    };
\definition subSuccSucc(a, b: Nat^): Op.Sub.specification (Nat^::succ a) (Nat^::succ b) = Op.Sub.specification a b := \refl(Op.Sub.specification a b);
\definition subSelf: \forall (a: Nat^) -> Op.Sub.specification a a = Nat^::zero :=
  \induction (a: Nat^) \return Op.Sub.specification a a = Nat^::zero \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: Op.Sub.specification a a = Nat^::zero) => ih)
    };
\definition subAddCancel: \forall (b, a: Nat^) -> Op.Sub.specification \(a "+" b\) b = a :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Op.Sub.specification \(a "+" b\) b = a \with {
    | zero : (\fun (a: Nat^) => \refl(a))
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> Op.Sub.specification \(a "+" b\) b = a) => \fun (a: Nat^) =>
      trans!{Nat^} _ _ _
        (congr!{Nat^ Nat^} (\fun (x: Nat^) => Op.Sub.specification x (Nat^::succ b)) _ _ (addSuccRight a b)) (ih a))
    };
\definition mulZeroRight(a: Nat^): \(a "*" { Nat^::zero }\) = Nat^::zero := \refl(Nat^::zero);
\definition mulSuccRight(a, b: Nat^): \(a "*" { Nat^::succ b }\) = \(a "+" (a "*" b)\) :=
  \refl(\(a "+" (a "*" b)\));
\definition powZero(a: Nat^): Op.Pow.specification a Nat^::zero = Nat^::succ Nat^::zero := \refl(Nat^::succ
  Nat^::zero);
\definition powSucc(a, b: Nat^): Op.Pow.specification a (Nat^::succ b) = \(a "*" { Op.Pow.specification a b }\) :=
  \refl(\(a "*" { Op.Pow.specification a b }\));

/* Boolean decisions can be consumed directly as propositions. */
\definition zeroNeSucc(n: Nat^):
  Nat^::zero = Nat^::succ n ->
  B.False := \fun (e: Nat^::zero = Nat^::succ n) =>
    BoolLaws.trueNeFalse
    (\idelim Nat^::zero = Nat^::succ n \with x: Nat^ => Op.IsZero.specification Nat^::zero = Op.IsZero.specification x
      \by { base: \refl(B.Bool^::true), equality: e });
\definition succNeZero(n: Nat^):
  Nat^::succ n = Nat^::zero ->
  B.False := \fun (e: _) =>
    zeroNeSucc n (sym!{Nat^} _ _ e);
\definition eqbRefl: \forall (n: Nat^) -> Op.Eqb.specification n n = B.Bool^::true :=
  \induction (n: Nat^) \return Op.Eqb.specification n n = B.Bool^::true \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: Nat^) => \fun (ih: Op.Eqb.specification n n = B.Bool^::true) => ih)
    };
\definition eqOfEqbTrue: \forall (b, a: Nat^) -> Op.Eqb.specification a b = B.Bool^::true -> a = b :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Op.Eqb.specification a b = B.Bool^::true -> a = b \with {
    | zero : (\induction (a: Nat^) \return Op.Eqb.specification a Nat^::zero = B.Bool^::true -> a = Nat^::zero \with {
      | zero : (\fun (e: B.Bool^::true = B.Bool^::true) => \refl(Nat^::zero))
      | succ : \block {
          \fun (a: Nat^) \then
          \fun (unused: Op.Eqb.specification a Nat^::zero = B.Bool^::true -> a = Nat^::zero) \then
          \fun (e: B.Bool^::false = B.Bool^::true) \then
          \return BoolLaws.absurd (Nat^::succ a = Nat^::zero) e
        }
      })
    | succ : \block {
        \fun (b: Nat^) \then
        \fun (ih: \forall (a: Nat^) -> Op.Eqb.specification a b = B.Bool^::true -> a = b) \then
        \return \induction (a: Nat^) \return
          Op.Eqb.specification a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b \with {
          | zero : \fun (e: B.Bool^::false = B.Bool^::true) =>
              BoolLaws.absurd (Nat^::zero = Nat^::succ b) e
          | succ : \block {
              \fun (a: Nat^) \then
              \fun (unused: Op.Eqb.specification a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b) \then
              \fun (e: Op.Eqb.specification a b = B.Bool^::true) \then
              \return Op.succCong a b (ih a e)
            }
          }
      }
    };
\definition eqbTrueOfEq(a, b: Nat^):
  a = b ->
  Op.Eqb.specification a b = B.Bool^::true :=
    \fun (e: a = b) =>
    \idelim a = b \with x: Nat^ => Op.Eqb.specification a x = B.Bool^::true \by { base: eqbRefl a, equality: e };
\definition Le(a, b: Nat^): \Prop := Op.Leb.specification a b = B.Bool^::true;
\definition Lt(a, b: Nat^): \Prop := Op.Ltb.specification a b = B.Bool^::true;
\definition leRefl: Rel.Reflexive Nat^ Le :=
  \induction (n: Nat^) \return Le n n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: Nat^) => \fun (ih: Le n n) => ih)
    };
\definition zeroLe: \forall (n: Nat^) -> Le Nat^::zero n :=
  \induction (n: Nat^) \return Le Nat^::zero n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: Nat^) => \fun (ih: Le Nat^::zero n) => \refl(B.Bool^::true))
    };
\definition ltIrrefl: Rel.Irreflexive Nat^ Lt :=
  \induction (n: Nat^) \return Lt n n -> B.False \with {
    | zero : BoolLaws.falseNeTrue
    | succ : (\fun (n: Nat^) => \fun (ih: Lt n n -> B.False) => ih)
    };
\definition leSuccSucc(a, b: Nat^):
  Le a b ->
  Le (Nat^::succ a) (Nat^::succ b) := \fun (e: _) =>
    e;
\definition leOfSuccSucc(a, b: Nat^):
  Le (Nat^::succ a) (Nat^::succ b) ->
  Le a b := \fun (e: _) =>
    e;
\definition ltSuccSucc(a, b: Nat^):
  Lt a b ->
  Lt (Nat^::succ a) (Nat^::succ b) := \fun (e: _) =>
    e;
\definition leZeroEq: \forall (a: Nat^) -> Le a Nat^::zero -> a = Nat^::zero :=
  \induction (a: Nat^) \return Le a Nat^::zero -> a = Nat^::zero \with {
    | zero : (\fun (e: Le Nat^::zero Nat^::zero) => \refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: Le a Nat^::zero -> a = Nat^::zero) => \fun (e: Le (Nat^::succ a) Nat^::zero) =>
      BoolLaws.absurd (Nat^::succ a = Nat^::zero) e)
    };
\definition leAntisym: Rel.Antisymmetric Nat^ Le :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Le a b -> Le b a -> a = b \with {
    | zero : \block {
        \fun (b: Nat^) \then
        \fun (ab: Le Nat^::zero b) \then
        \fun (ba: Le b Nat^::zero) \then
        \return sym!{Nat^} b Nat^::zero (leZeroEq b ba)
      }
    | succ : \block {
        \fun (a: Nat^) \then
        \fun (ih: \forall (b: Nat^) -> Le a b -> Le b a -> a = b) \then
        \return \induction (b: Nat^) \return
          Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b \with {
          | zero : \fun (ab: Le (Nat^::succ a) Nat^::zero)
            (ba: Le Nat^::zero (Nat^::succ a)) => leZeroEq (Nat^::succ a) ab
          | succ : \block {
              \fun (b: Nat^) \then
              \fun (unused: Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b) \then
              \fun (ab: Le (Nat^::succ a) (Nat^::succ b)) \then
              \fun (ba: Le (Nat^::succ b) (Nat^::succ a)) \then
              \return Op.succCong a b (ih b ab ba)
            }
          }
      }
    };
\definition leTrans: Rel.Transitive Nat^ Le :=
  \induction (a: Nat^) \return \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c \with {
    | zero : \fun (b, c: Nat^) (ab: Le Nat^::zero b) (bc: Le b c) => zeroLe c
    | succ : \block {
        \fun (a: Nat^) \then
        \fun (ih: \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c) \then
        \return \induction (b: Nat^) \return \forall (c: Nat^) ->
          Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c \with {
          | zero : \fun (c: Nat^) (ab: Le (Nat^::succ a) Nat^::zero)
              (bc: Le Nat^::zero c) => BoolLaws.absurd (Le (Nat^::succ a) c) ab
          | succ : \block {
              \fun (b: Nat^) \then
              \fun (unused: \forall (c: Nat^) ->
                Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c) \then
              \return \induction (c: Nat^) \return
                Le (Nat^::succ a) (Nat^::succ b) -> Le (Nat^::succ b) c ->
                  Le (Nat^::succ a) c \with {
                | zero : \fun (ab: Le (Nat^::succ a) (Nat^::succ b))
                    (bc: Le (Nat^::succ b) Nat^::zero) =>
                    BoolLaws.absurd (Le (Nat^::succ a) Nat^::zero) bc
                | succ : \block {
                    \fun (c: Nat^) \then
                    \fun (unusedC: Le (Nat^::succ a) (Nat^::succ b) ->
                      Le (Nat^::succ b) c -> Le (Nat^::succ a) c) \then
                    \fun (ab: Le (Nat^::succ a) (Nat^::succ b)) \then
                    \fun (bc: Le (Nat^::succ b) (Nat^::succ c)) \then
                    \return ih b c ab bc
                  }
                }
            }
          }
      }
    };

\definition addCong: \forall (a, b, c, d: Nat^) -> a = b -> c = d -> \(a "+" c\) = \(b "+" d\) :=
  congr2!{Nat^ Nat^ Nat^} Op.Add.specification;
\definition addSwap: \forall (a, b, c: Nat^) -> \(a "+" (b "+" c)\) = \(b "+" (a "+" c)\) :=
  \fun (a, b, c: Nat^) => eq_reason!{
    \(a "+" (b "+" c)\)
    "=" \((a "+" b) "+" c\) "by" { sym!{Nat^} _ _ (addAssoc a b c) }
    "=" \((b "+" a) "+" c\)
    "by" { congr!{Nat^ Nat^} (\fun (n: Nat^) => \(n "+" c\)) _ _ (addComm a b) }
    "=" \(b "+" (a "+" c)\) "by" { addAssoc b a c }
  };
\definition addInterchange:
  \forall (a, b, c, d: Nat^) ->
  \((a "+" b) "+" (c "+" d)\) = \((a "+" c) "+" (b "+" d)\) :=
  \fun (a, b, c, d: _) => eq_reason!{
    \((a "+" b) "+" (c "+" d)\)
    "=" \(a "+" (b "+" (c "+" d))\) "by" { addAssoc a b \(c "+" d\) }
    "=" \(a "+" (c "+" (b "+" d))\)
    "by" { congr!{Nat^ Nat^} (Op.Add.specification a) _ _ (addSwap b c d) }
    "=" \((a "+" c) "+" (b "+" d)\) "by" { sym!{Nat^} _ _ (addAssoc a c \(b "+" d\)) }
  };
\definition mulZeroLeft: \forall (a: Nat^) -> \({ Nat^::zero } "*" a\) = Nat^::zero :=
  \induction (a: Nat^) \return \({ Nat^::zero } "*" a\) = Nat^::zero \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \({ Nat^::zero } "*" a\) = Nat^::zero) =>
      trans!{Nat^} _ _ _ (mulSuccRight Nat^::zero a) (trans!{Nat^} \({ Nat^::zero } "+" ({ Nat^::zero } "*" a)\) \({ Nat^::zero } "*" a\) Nat^::zero (addZeroLeft \({ Nat^::zero } "*" a\)) ih))
    };
\definition mulOneLeft: \forall (a: Nat^) -> \({ Nat^::succ Nat^::zero } "*" a\) = a :=
  \induction (a: Nat^) \return \({ Nat^::succ Nat^::zero } "*" a\) = a \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \({ Nat^::succ Nat^::zero } "*" a\) = a) =>
      trans!{Nat^} _ _ _ (mulSuccRight (Nat^::succ Nat^::zero) a)
        (trans!{Nat^} _ _ _ (addSuccLeft Nat^::zero \({ Nat^::succ Nat^::zero } "*" a\))
          (Op.succCong \({ Nat^::zero } "+" ({ Nat^::succ Nat^::zero } "*" a)\) a
            (trans!{Nat^} \({ Nat^::zero } "+" ({ Nat^::succ Nat^::zero } "*" a)\) \({ Nat^::succ Nat^::zero } "*" a\) a
              (addZeroLeft \({ Nat^::succ Nat^::zero } "*" a\)) ih))))
    };
\definition mulDistribRight(a, b: Nat^):
  \forall (c: Nat^) ->
  \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\) :=
  \induction (c: Nat^) \return \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\) \with {
    | zero : \refl(Nat^::zero)
    | succ : \fun (c: Nat^) (ih: \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\)) =>
      eq_reason!{
        \((a "+" b) "*" { Nat^::succ c }\)
        "=" \((a "+" b) "+" ((a "+" b) "*" c)\) "by" { mulSuccRight \(a "+" b\) c }
        "=" \((a "+" b) "+" ((a "*" c) "+" (b "*" c))\)
        "by" { congr!{Nat^ Nat^} (Op.Add.specification \(a "+" b\)) _ _ ih }
        "=" \((a "+" (a "*" c)) "+" (b "+" (b "*" c))\)
        "by" { addInterchange a b \(a "*" c\) \(b "*" c\) }
        "=" \((a "*" { Nat^::succ c }) "+" (b "*" { Nat^::succ c })\)
        "by" { congr2!{Nat^ Nat^ Nat^} Op.Add.specification _ _ _ _
          (sym!{Nat^} _ _ (mulSuccRight a c)) (sym!{Nat^} _ _ (mulSuccRight b c)) }
      }
  };
\definition mulSuccLeft: \forall (a, b: Nat^) -> \({ Nat^::succ a } "*" b\) = \(b "+" (a "*" b)\) :=
  \fun (a, b: _) => eq_reason!{
    \({ Nat^::succ a } "*" b\)
    "=" \((a "*" b) "+" ({ Nat^::succ Nat^::zero } "*" b)\)
    "by" { mulDistribRight a (Nat^::succ Nat^::zero) b }
    "=" \((a "*" b) "+" b\)
    "by" { congr!{Nat^ Nat^} (Op.Add.specification \(a "*" b\)) _ _ (mulOneLeft b) }
    "=" \(b "+" (a "*" b)\) "by" { addComm \(a "*" b\) b }
  };
\definition mulComm(a: Nat^): \forall (b: Nat^) -> \(a "*" b\) = \(b "*" a\) :=
  \induction (b: Nat^) \return \(a "*" b\) = \(b "*" a\) \with {
    | zero : sym!{Nat^} _ _ (mulZeroLeft a)
    | succ : \fun (b: Nat^) (ih: \(a "*" b\) = \(b "*" a\)) => eq_reason!{
        \(a "*" { Nat^::succ b }\)
        "=" \(a "+" (a "*" b)\) "by" { mulSuccRight a b }
        "=" \(a "+" (b "*" a)\) "by" { congr!{Nat^ Nat^} (Op.Add.specification a) _ _ ih }
        "=" \({ Nat^::succ b } "*" a\) "by" { sym!{Nat^} _ _ (mulSuccLeft b a) }
      }
  };
\definition mulOneRight(a: Nat^): \(a "*" { Nat^::succ Nat^::zero }\) = a :=
  eq_reason!{
    \(a "*" { Nat^::succ Nat^::zero }\)
    "=" \({ Nat^::succ Nat^::zero } "*" a\) "by" { mulComm a (Nat^::succ Nat^::zero) }
    "=" a "by" { mulOneLeft a }
  };
\definition mulDistribLeft:
  \forall (a, b, c: Nat^) ->
  \(a "*" (b "+" c)\) = \((a "*" b) "+" (a "*" c)\) :=
  \fun (a, b, c: _) => eq_reason!{
    \(a "*" (b "+" c)\)
    "=" \((b "+" c) "*" a\) "by" { mulComm a \(b "+" c\) }
    "=" \((b "*" a) "+" (c "*" a)\) "by" { mulDistribRight b c a }
    "=" \((a "*" b) "+" (a "*" c)\)
    "by" { congr2!{Nat^ Nat^ Nat^} Op.Add.specification _ _ _ _ (mulComm b a) (mulComm c a) }
  };
\definition mulAssoc(a, b: Nat^):
  \forall (c: Nat^) ->
  \((a "*" b) "*" c\) = \(a "*" (b "*" c)\) :=
  \induction (c: Nat^) \return \((a "*" b) "*" c\) = \(a "*" (b "*" c)\) \with {
    | zero : \refl(Nat^::zero)
    | succ : \fun (c: Nat^) (ih: \((a "*" b) "*" c\) = \(a "*" (b "*" c)\)) =>
      eq_reason!{
        \((a "*" b) "*" { Nat^::succ c }\)
        "=" \((a "*" b) "+" ((a "*" b) "*" c)\) "by" { mulSuccRight \(a "*" b\) c }
        "=" \((a "*" b) "+" (a "*" (b "*" c))\)
        "by" { congr!{Nat^ Nat^} (Op.Add.specification \(a "*" b\)) _ _ ih }
        "=" \(a "*" (b "+" (b "*" c))\) "by" { sym!{Nat^} _ _ (mulDistribLeft a b \(b "*" c\)) }
        "=" \(a "*" (b "*" { Nat^::succ c })\)
        "by" { congr!{Nat^ Nat^} (Op.Mul.specification a) _ _ (sym!{Nat^} _ _ (mulSuccRight b c)) }
      }
  };

\definition zeroEqSuccElim(n: Nat^) (P: \Prop):
  Nat^::zero = Nat^::succ n ->
  P :=
    \fun (e: _) =>
    BoolLaws.absurd P
      (sym!{B.Bool^} B.Bool^::true B.Bool^::false
        (congr!{Nat^ B.Bool^} Op.IsZero.specification Nat^::zero (Nat^::succ n) e));

\definition succEqZeroElim(n: Nat^) (P: \Prop):
  Nat^::succ n = Nat^::zero ->
  P :=
    \fun (e: _) =>
    BoolLaws.absurd P
      (congr!{Nat^ B.Bool^} Op.IsZero.specification (Nat^::succ n) Nat^::zero e);

\definition mulSuccSucc(a, k: Nat^):
  \({ Nat^::succ a } "*" { Nat^::succ k }\) =
    Nat^::succ \(k "+" (a "*" { Nat^::succ k })\) :=
    trans!{Nat^} _ _ _ (mulSuccLeft a (Nat^::succ k))
      (addSuccLeft k \(a "*" { Nat^::succ k }\));

/* Multiplication by a successor is injective. */
\definition mulCancelRightSucc:
  \forall (k, a, b: Nat^) ->
  \(a "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) -> a = b :=

  \fun (k: Nat^) =>
    \induction (a: Nat^) \return \forall (b: Nat^) ->
        \(a "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) -> a = b \with {
      | zero : (\induction (b: Nat^) \return \({ Nat^::zero } "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) ->
          Nat^::zero = b \with {
        | zero : (\fun (e: \({ Nat^::zero } "*" { Nat^::succ k }\) =
          \({ Nat^::zero } "*" { Nat^::succ k }\)) => \refl(Nat^::zero))
        | succ : (\fun (b: Nat^) =>
        \fun (unused: \({ Nat^::zero } "*" { Nat^::succ k }\) =
          \(b "*" { Nat^::succ k }\) -> Nat^::zero = b) =>
        \fun (e: \({ Nat^::zero } "*" { Nat^::succ k }\) =
          \({ Nat^::succ b } "*" { Nat^::succ k }\)) =>
          zeroEqSuccElim
            \(k "+" (b "*" { Nat^::succ k })\)
            (Nat^::zero = Nat^::succ b)
            (trans!{Nat^} _ _ _
              (sym!{Nat^} _ _ (mulZeroLeft (Nat^::succ k)))
              (trans!{Nat^} _ _ _ e (mulSuccSucc b k))))
        })
      | succ : (\fun (a: Nat^) =>
      \fun (ih: \forall (b: Nat^) ->
        \(a "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) -> a = b) =>
        \induction (b: Nat^) \return \({ Nat^::succ a } "*" { Nat^::succ k }\) =
              \(b "*" { Nat^::succ k }\) -> Nat^::succ a = b \with {
        | zero : (\fun (e: \({ Nat^::succ a } "*" { Nat^::succ k }\) =
            \({ Nat^::zero } "*" { Nat^::succ k }\)) =>
            succEqZeroElim
              \(k "+" (a "*" { Nat^::succ k })\)
              (Nat^::succ a = Nat^::zero)
              (trans!{Nat^} _ _ _
                (sym!{Nat^} _ _ (mulSuccSucc a k))
                (trans!{Nat^} _ _ _ e (mulZeroLeft (Nat^::succ k)))))
        | succ : (\fun (b: Nat^) =>
          \fun (unused: \({ Nat^::succ a } "*" { Nat^::succ k }\) =
            \(b "*" { Nat^::succ k }\) -> Nat^::succ a = b) =>
          \fun (e: \({ Nat^::succ a } "*" { Nat^::succ k }\) =
            \({ Nat^::succ b } "*" { Nat^::succ k }\)) =>
            Op.succCong a b
              (ih b
                (addCancelLeft k
                  \(a "*" { Nat^::succ k }\)
                  \(b "*" { Nat^::succ k }\)
                  (succInjective
                    \(k "+" (a "*" { Nat^::succ k })\)
                    \(k "+" (b "*" { Nat^::succ k })\)
                    (trans!{Nat^} _ _ _
                      (sym!{Nat^} _ _ (mulSuccSucc a k))
                      (trans!{Nat^} _ _ _ e (mulSuccSucc b k)))))))
        })
      };

/* General Law views of the arithmetic theorems above. */
\definition addCommutative: Law.Commutative Nat^ Op.Add.specification :=
  addComm;
\definition addAssociative: Law.Associative Nat^ Op.Add.specification :=
  addAssoc;
\definition mulCommutative: Law.Commutative Nat^ Op.Mul.specification :=
  mulComm;
\definition mulAssociative: Law.Associative Nat^ Op.Mul.specification :=
  mulAssoc;
\definition mulLeftDistributive: Law.LeftDistributive Nat^ Op.Mul.specification Op.Add.specification :=
  mulDistribLeft;
\definition mulRightDistributive: Law.RightDistributive Nat^ Op.Mul.specification Op.Add.specification :=
  mulDistribRight;

\definition leStep: \forall (b, a: Nat^) -> Le a b -> Le a (Nat^::succ b) :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Le a b -> Le a (Nat^::succ b) \with {
    | zero : (\induction (a: Nat^) \return Le a Nat^::zero -> Le a (Nat^::succ Nat^::zero) \with {
      | zero : (\fun (_: Le Nat^::zero Nat^::zero) => \refl(B.Bool^::true))
      | succ : (\fun (a: Nat^) => \fun (_: Le a Nat^::zero -> Le a (Nat^::succ Nat^::zero)) =>
        \fun (bad: Le (Nat^::succ a) Nat^::zero) => BoolLaws.absurd (Le (Nat^::succ a) (Nat^::succ Nat^::zero)) bad)
      })
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> Le a b -> Le a (Nat^::succ b)) =>
      \induction (a: Nat^) \return Le a (Nat^::succ b) -> Le a (Nat^::succ (Nat^::succ b)) \with {
      | zero : (\fun (_: Le Nat^::zero (Nat^::succ b)) => \refl(B.Bool^::true))
      | succ : (\fun (a: Nat^) => \fun (_: Le a (Nat^::succ b) -> Le a (Nat^::succ (Nat^::succ b))) =>
          \fun (h: Le (Nat^::succ a) (Nat^::succ b)) => ih a h)
      })
    };
\definition leAddRight(a: Nat^): \forall (b: Nat^) -> Le a \(a "+" b\) :=
  \induction (b: Nat^) \return Le a \(a "+" b\) \with {
    | zero : (leRefl a)
    | succ : (\fun (b: Nat^) => \fun (ih: Le a \(a "+" b\)) =>
      \idelim Nat^::succ \(a "+" b\) = \(a "+" { Nat^::succ b }\)
        \with c: Nat^ => Le a c
        \by { base: leStep \(a "+" b\) a ih, equality: sym!{Nat^} _ _ (addSuccRight a b) })
    };
\definition leAddLeft(a, b: Nat^): Le b \(a "+" b\) :=
  \idelim \(b "+" a\) = \(a "+" b\) \with c: Nat^ => Le b c
    \by { base: leAddRight b a, equality: addComm b a };

