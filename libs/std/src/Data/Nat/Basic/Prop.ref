\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;
\use Equality.congr2;

\import std.Data[].Bool[] \as B;

\import std.Data[].Nat[].Basic[].Def[] \as Op;
\use Op.nat_add;
\use Op.nat_mul;

/* Arithmetic laws on the Set specifications. */
\import std.Logic[].Rel[] \as Rel;
\import std.Logic[].Algebra[].Def[] \as Law;
\definition succInjective (a, b: N.Nat^) (e: N.Nat^::succ a = N.Nat^::succ b): a = b := congr!{N.Nat^ N.Nat^} Op.Pred::[set] (N.Nat^::succ a) (N.Nat^::succ b) e;
\definition predZero: Op.Pred::[set] N.Nat^::zero = N.Nat^::zero := \refl(N.Nat^::zero);
\definition predSucc (n: N.Nat^): Op.Pred::[set] (N.Nat^::succ n) = n := \refl(n);
\definition addZeroRight (a: N.Nat^): \(a "+" { N.Nat^::zero }\) = a := \refl(a);
\definition addSuccLeft: \forall (a, b: N.Nat^) ->
  \({ N.Nat^::succ a } "+" b\) = N.Nat^::succ \(a "+" b\) :=
  \fun (a, b: N.Nat^) =>
    (\induction (b: N.Nat^) \return \forall (a: N.Nat^) ->
      \({ N.Nat^::succ a } "+" b\) = N.Nat^::succ \(a "+" b\) \with {
      | zero: \fun (a: N.Nat^) => \refl(N.Nat^::succ a)
      | succ: \fun (b: N.Nat^) (ih: _) (a: N.Nat^) => Op.succCong _ _ (ih a)
    }) b a;
\definition addSuccRight (a, b: N.Nat^): \(a "+" { N.Nat^::succ b }\) = N.Nat^::succ \(a "+" b\) := \refl(N.Nat^::succ \(a "+" b\));
\definition addZeroLeft: \forall (a: N.Nat^) -> \({ N.Nat^::zero } "+" a\) = a :=
  \induction (a: N.Nat^) \return \({ N.Nat^::zero } "+" a\) = a \with {
    | zero : (\refl(N.Nat^::zero))
    | succ : (\fun (a: N.Nat^) => \fun (ih: \({ N.Nat^::zero } "+" a\) = a) =>
      trans!{N.Nat^} _ _ _ (addSuccRight N.Nat^::zero a) (Op.succCong \({ N.Nat^::zero } "+" a\) a ih))
    };
\definition addComm (a: N.Nat^): \forall (b: N.Nat^) -> \(a "+" b\) = \(b "+" a\) :=
  \induction (b: N.Nat^) \return \(a "+" b\) = \(b "+" a\) \with {
    | zero : sym!{N.Nat^} _ _ (addZeroLeft a)
    | succ : \fun (b: N.Nat^) (ih: \(a "+" b\) = \(b "+" a\)) => eq_reason!{
        \(a "+" { N.Nat^::succ b }\)
        "=" { N.Nat^::succ \(a "+" b\) } "by" { addSuccRight a b }
        "=" { N.Nat^::succ \(b "+" a\) } "by" { Op.succCong _ _ ih }
        "=" \({ N.Nat^::succ b } "+" a\) "by" { sym!{N.Nat^} _ _ (addSuccLeft b a) }
      }
  };
\definition addAssoc (a, b: N.Nat^): \forall (c: N.Nat^) ->
  \((a "+" b) "+" c\) = \(a "+" (b "+" c)\) :=
  \induction (c: N.Nat^) \return \((a "+" b) "+" c\) = \(a "+" (b "+" c)\) \with {
    | zero : \refl(\(a "+" b\))
    | succ : \fun (c: N.Nat^) (ih: \((a "+" b) "+" c\) = \(a "+" (b "+" c)\)) =>
      eq_reason!{
        \((a "+" b) "+" { N.Nat^::succ c }\)
        "=" { N.Nat^::succ \((a "+" b) "+" c\) } "by" { addSuccRight \(a "+" b\) c }
        "=" { N.Nat^::succ \(a "+" (b "+" c)\) } "by" { Op.succCong _ _ ih }
        "=" \(a "+" { N.Nat^::succ \(b "+" c\) }\)
        "by" { sym!{N.Nat^} _ _ (addSuccRight a \(b "+" c\)) }
        "=" \(a "+" (b "+" { N.Nat^::succ c })\)
        "by" { congr!{N.Nat^ N.Nat^} (Op.Add::[set] a) _ _ (sym!{N.Nat^} _ _ (addSuccRight b c)) }
      }
  };
\definition addCancelRight: \forall (c, a, b: N.Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b :=
  \induction (c: N.Nat^) \return \forall (a, b: N.Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b \with {
    | zero : (\fun (a, b: N.Nat^) => \fun (e: a = b) => e)
    | succ : (\fun (c: N.Nat^) => \fun (ih: \forall (a, b: N.Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b) =>
      \fun (a, b: N.Nat^) => \fun (e: \(a "+" { N.Nat^::succ c }\) = \(b "+" { N.Nat^::succ c }\)) =>
        ih a b (succInjective _ _
          (trans!{N.Nat^} _ _ _ (sym!{N.Nat^} _ _ (addSuccRight a c))
            (trans!{N.Nat^} _ _ _ e (addSuccRight b c)))))
    };
\definition addCancelLeft: \forall (c, a, b: N.Nat^) -> \(c "+" a\) = \(c "+" b\) -> a = b :=
  \fun (c, a, b: N.Nat^) (e: \(c "+" a\) = \(c "+" b\)) =>
    addCancelRight c a b eq_reason!{
      \(a "+" c\) "=" \(c "+" a\) "by" { addComm a c }
      "=" \(c "+" b\) "by" e
      "=" \(b "+" c\) "by" { addComm c b }
    };
\definition subZeroRight (a: N.Nat^): Op.Sub::[set] a N.Nat^::zero = a := \refl(a);
\definition subZeroLeft: \forall (a: N.Nat^) -> Op.Sub::[set] N.Nat^::zero a = N.Nat^::zero :=
  \induction (a: N.Nat^) \return Op.Sub::[set] N.Nat^::zero a = N.Nat^::zero \with {
    | zero : (\refl(N.Nat^::zero))
    | succ : (\fun (a: N.Nat^) => \fun (ih: Op.Sub::[set] N.Nat^::zero a = N.Nat^::zero) => \refl(N.Nat^::zero))
    };
\definition subSuccSucc (a, b: N.Nat^): Op.Sub::[set] (N.Nat^::succ a) (N.Nat^::succ b) = Op.Sub::[set] a b := \refl(Op.Sub::[set] a b);
\definition subSelf: \forall (a: N.Nat^) -> Op.Sub::[set] a a = N.Nat^::zero :=
  \induction (a: N.Nat^) \return Op.Sub::[set] a a = N.Nat^::zero \with {
    | zero : (\refl(N.Nat^::zero))
    | succ : (\fun (a: N.Nat^) => \fun (ih: Op.Sub::[set] a a = N.Nat^::zero) => ih)
    };
\definition subAddCancel: \forall (b, a: N.Nat^) -> Op.Sub::[set] \(a "+" b\) b = a :=
  \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Op.Sub::[set] \(a "+" b\) b = a \with {
    | zero : (\fun (a: N.Nat^) => \refl(a))
    | succ : (\fun (b: N.Nat^) => \fun (ih: \forall (a: N.Nat^) -> Op.Sub::[set] \(a "+" b\) b = a) => \fun (a: N.Nat^) =>
      trans!{N.Nat^} _ _ _
        (congr!{N.Nat^ N.Nat^} (\fun (x: N.Nat^) => Op.Sub::[set] x (N.Nat^::succ b)) _ _ (addSuccRight a b)) (ih a))
    };
\definition mulZeroRight (a: N.Nat^): \(a "*" { N.Nat^::zero }\) = N.Nat^::zero := \refl(N.Nat^::zero);
\definition mulSuccRight (a, b: N.Nat^): \(a "*" { N.Nat^::succ b }\) = \(a "+" (a "*" b)\) :=
  \refl(\(a "+" (a "*" b)\));
\definition powZero (a: N.Nat^): Op.Pow::[set] a N.Nat^::zero = N.Nat^::succ N.Nat^::zero := \refl(N.Nat^::succ
  N.Nat^::zero);
\definition powSucc (a, b: N.Nat^): Op.Pow::[set] a (N.Nat^::succ b) = \(a "*" { Op.Pow::[set] a b }\) :=
  \refl(\(a "*" { Op.Pow::[set] a b }\));

/* Boolean decisions can be consumed directly as propositions. */
\definition zeroNeSucc (n: N.Nat^) (e: N.Nat^::zero = N.Nat^::succ n): B.False := B.trueNeFalse
    (\idelim N.Nat^::zero = N.Nat^::succ n \with x: N.Nat^ => Op.IsZero::[set] N.Nat^::zero = Op.IsZero::[set] x
      \by { base: \refl(B.Bool^::true), equality: e });
\definition succNeZero (n: N.Nat^) (e: N.Nat^::succ n = N.Nat^::zero): B.False := zeroNeSucc n (sym!{N.Nat^} _ _ e);
\definition eqbRefl: \forall (n: N.Nat^) -> Op.Eqb::[set] n n = B.Bool^::true :=
  \induction (n: N.Nat^) \return Op.Eqb::[set] n n = B.Bool^::true \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: N.Nat^) => \fun (ih: Op.Eqb::[set] n n = B.Bool^::true) => ih)
    };
\definition eqOfEqbTrue: \forall (b, a: N.Nat^) -> Op.Eqb::[set] a b = B.Bool^::true -> a = b :=
  \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Op.Eqb::[set] a b = B.Bool^::true -> a = b \with {
    | zero : (\induction (a: N.Nat^) \return Op.Eqb::[set] a N.Nat^::zero = B.Bool^::true -> a = N.Nat^::zero \with {
      | zero : (\fun (e: B.Bool^::true = B.Bool^::true) => \refl(N.Nat^::zero))
      | succ : \block {
          \fun (a: N.Nat^) \then
          \fun (unused: Op.Eqb::[set] a N.Nat^::zero = B.Bool^::true -> a = N.Nat^::zero) \then
          \fun (e: B.Bool^::false = B.Bool^::true) \then
          \return B.absurd (N.Nat^::succ a = N.Nat^::zero) e
        }
      })
    | succ : \block {
        \fun (b: N.Nat^) \then
        \fun (ih: \forall (a: N.Nat^) -> Op.Eqb::[set] a b = B.Bool^::true -> a = b) \then
        \return \induction (a: N.Nat^) \return
          Op.Eqb::[set] a (N.Nat^::succ b) = B.Bool^::true -> a = N.Nat^::succ b \with {
          | zero : \fun (e: B.Bool^::false = B.Bool^::true) =>
              B.absurd (N.Nat^::zero = N.Nat^::succ b) e
          | succ : \block {
              \fun (a: N.Nat^) \then
              \fun (unused: Op.Eqb::[set] a (N.Nat^::succ b) = B.Bool^::true -> a = N.Nat^::succ b) \then
              \fun (e: Op.Eqb::[set] a b = B.Bool^::true) \then
              \return Op.succCong a b (ih a e)
            }
          }
      }
    };
\definition eqbTrueOfEq (a, b: N.Nat^) (e: a = b): Op.Eqb::[set] a b = B.Bool^::true :=
    \idelim a = b \with x: N.Nat^ => Op.Eqb::[set] a x = B.Bool^::true \by { base: eqbRefl a, equality: e };
\definition Le (a, b: N.Nat^): \Prop := Op.Leb::[set] a b = B.Bool^::true;
\definition Lt (a, b: N.Nat^): \Prop := Op.Ltb::[set] a b = B.Bool^::true;
\definition leRefl: Rel.Reflexive N.Nat^ Le :=
  \induction (n: N.Nat^) \return Le n n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: N.Nat^) => \fun (ih: Le n n) => ih)
    };
\definition zeroLe: \forall (n: N.Nat^) -> Le N.Nat^::zero n :=
  \induction (n: N.Nat^) \return Le N.Nat^::zero n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: N.Nat^) => \fun (ih: Le N.Nat^::zero n) => \refl(B.Bool^::true))
    };
\definition ltIrrefl: Rel.Irreflexive N.Nat^ Lt :=
  \induction (n: N.Nat^) \return Lt n n -> B.False \with {
    | zero : B.falseNeTrue
    | succ : (\fun (n: N.Nat^) => \fun (ih: Lt n n -> B.False) => ih)
    };
\definition leSuccSucc (a, b: N.Nat^) (e: Le a b): Le (N.Nat^::succ a) (N.Nat^::succ b) := e;
\definition leOfSuccSucc (a, b: N.Nat^) (e: Le (N.Nat^::succ a) (N.Nat^::succ b)): Le a b := e;
\definition ltSuccSucc (a, b: N.Nat^) (e: Lt a b): Lt (N.Nat^::succ a) (N.Nat^::succ b) := e;
\definition leZeroEq: \forall (a: N.Nat^) -> Le a N.Nat^::zero -> a = N.Nat^::zero :=
  \induction (a: N.Nat^) \return Le a N.Nat^::zero -> a = N.Nat^::zero \with {
    | zero : (\fun (e: Le N.Nat^::zero N.Nat^::zero) => \refl(N.Nat^::zero))
    | succ : (\fun (a: N.Nat^) => \fun (ih: Le a N.Nat^::zero -> a = N.Nat^::zero) => \fun (e: Le (N.Nat^::succ a) N.Nat^::zero) =>
      B.absurd (N.Nat^::succ a = N.Nat^::zero) e)
    };
\definition leAntisym: Rel.Antisymmetric N.Nat^ Le :=
  \induction (a: N.Nat^) \return \forall (b: N.Nat^) -> Le a b -> Le b a -> a = b \with {
    | zero : \block {
        \fun (b: N.Nat^) \then
        \fun (ab: Le N.Nat^::zero b) \then
        \fun (ba: Le b N.Nat^::zero) \then
        \return sym!{N.Nat^} b N.Nat^::zero (leZeroEq b ba)
      }
    | succ : \block {
        \fun (a: N.Nat^) \then
        \fun (ih: \forall (b: N.Nat^) -> Le a b -> Le b a -> a = b) \then
        \return \induction (b: N.Nat^) \return
          Le (N.Nat^::succ a) b -> Le b (N.Nat^::succ a) -> N.Nat^::succ a = b \with {
          | zero : \fun (ab: Le (N.Nat^::succ a) N.Nat^::zero)
            (ba: Le N.Nat^::zero (N.Nat^::succ a)) => leZeroEq (N.Nat^::succ a) ab
          | succ : \block {
              \fun (b: N.Nat^) \then
              \fun (unused: Le (N.Nat^::succ a) b -> Le b (N.Nat^::succ a) -> N.Nat^::succ a = b) \then
              \fun (ab: Le (N.Nat^::succ a) (N.Nat^::succ b)) \then
              \fun (ba: Le (N.Nat^::succ b) (N.Nat^::succ a)) \then
              \return Op.succCong a b (ih b ab ba)
            }
          }
      }
    };
\definition leTrans: Rel.Transitive N.Nat^ Le :=
  \induction (a: N.Nat^) \return \forall (b, c: N.Nat^) -> Le a b -> Le b c -> Le a c \with {
    | zero : \fun (b, c: N.Nat^) (ab: Le N.Nat^::zero b) (bc: Le b c) => zeroLe c
    | succ : \block {
        \fun (a: N.Nat^) \then
        \fun (ih: \forall (b, c: N.Nat^) -> Le a b -> Le b c -> Le a c) \then
        \return \induction (b: N.Nat^) \return \forall (c: N.Nat^) ->
          Le (N.Nat^::succ a) b -> Le b c -> Le (N.Nat^::succ a) c \with {
          | zero : \fun (c: N.Nat^) (ab: Le (N.Nat^::succ a) N.Nat^::zero)
              (bc: Le N.Nat^::zero c) => B.absurd (Le (N.Nat^::succ a) c) ab
          | succ : \block {
              \fun (b: N.Nat^) \then
              \fun (unused: \forall (c: N.Nat^) ->
                Le (N.Nat^::succ a) b -> Le b c -> Le (N.Nat^::succ a) c) \then
              \return \induction (c: N.Nat^) \return
                Le (N.Nat^::succ a) (N.Nat^::succ b) -> Le (N.Nat^::succ b) c ->
                  Le (N.Nat^::succ a) c \with {
                | zero : \fun (ab: Le (N.Nat^::succ a) (N.Nat^::succ b))
                    (bc: Le (N.Nat^::succ b) N.Nat^::zero) =>
                    B.absurd (Le (N.Nat^::succ a) N.Nat^::zero) bc
                | succ : \block {
                    \fun (c: N.Nat^) \then
                    \fun (unusedC: Le (N.Nat^::succ a) (N.Nat^::succ b) ->
                      Le (N.Nat^::succ b) c -> Le (N.Nat^::succ a) c) \then
                    \fun (ab: Le (N.Nat^::succ a) (N.Nat^::succ b)) \then
                    \fun (bc: Le (N.Nat^::succ b) (N.Nat^::succ c)) \then
                    \return ih b c ab bc
                  }
                }
            }
          }
      }
    };

\definition addCong: \forall (a, b, c, d: N.Nat^) -> a = b -> c = d -> \(a "+" c\) = \(b "+" d\) :=
  congr2!{N.Nat^ N.Nat^ N.Nat^} Op.Add::[set];
\definition addSwap: \forall (a, b, c: N.Nat^) -> \(a "+" (b "+" c)\) = \(b "+" (a "+" c)\) :=
  \fun (a, b, c: N.Nat^) => eq_reason!{
    \(a "+" (b "+" c)\)
    "=" \((a "+" b) "+" c\) "by" { sym!{N.Nat^} _ _ (addAssoc a b c) }
    "=" \((b "+" a) "+" c\)
    "by" { congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => \(n "+" c\)) _ _ (addComm a b) }
    "=" \(b "+" (a "+" c)\) "by" { addAssoc b a c }
  };
\definition addInterchange: \forall (a, b, c, d: N.Nat^) ->
  \((a "+" b) "+" (c "+" d)\) = \((a "+" c) "+" (b "+" d)\) :=
  \fun (a, b, c, d: N.Nat^) => eq_reason!{
    \((a "+" b) "+" (c "+" d)\)
    "=" \(a "+" (b "+" (c "+" d))\) "by" { addAssoc a b \(c "+" d\) }
    "=" \(a "+" (c "+" (b "+" d))\)
    "by" { congr!{N.Nat^ N.Nat^} (Op.Add::[set] a) _ _ (addSwap b c d) }
    "=" \((a "+" c) "+" (b "+" d)\) "by" { sym!{N.Nat^} _ _ (addAssoc a c \(b "+" d\)) }
  };
\definition mulZeroLeft: \forall (a: N.Nat^) -> \({ N.Nat^::zero } "*" a\) = N.Nat^::zero :=
  \induction (a: N.Nat^) \return \({ N.Nat^::zero } "*" a\) = N.Nat^::zero \with {
    | zero : (\refl(N.Nat^::zero))
    | succ : (\fun (a: N.Nat^) => \fun (ih: \({ N.Nat^::zero } "*" a\) = N.Nat^::zero) =>
      trans!{N.Nat^} _ _ _ (mulSuccRight N.Nat^::zero a) (trans!{N.Nat^} \({ N.Nat^::zero } "+" ({ N.Nat^::zero } "*" a)\) \({ N.Nat^::zero } "*" a\) N.Nat^::zero (addZeroLeft \({ N.Nat^::zero } "*" a\)) ih))
    };
\definition mulOneLeft: \forall (a: N.Nat^) -> \({ N.Nat^::succ N.Nat^::zero } "*" a\) = a :=
  \induction (a: N.Nat^) \return \({ N.Nat^::succ N.Nat^::zero } "*" a\) = a \with {
    | zero : (\refl(N.Nat^::zero))
    | succ : (\fun (a: N.Nat^) => \fun (ih: \({ N.Nat^::succ N.Nat^::zero } "*" a\) = a) =>
      trans!{N.Nat^} _ _ _ (mulSuccRight (N.Nat^::succ N.Nat^::zero) a)
        (trans!{N.Nat^} _ _ _ (addSuccLeft N.Nat^::zero \({ N.Nat^::succ N.Nat^::zero } "*" a\))
          (Op.succCong \({ N.Nat^::zero } "+" ({ N.Nat^::succ N.Nat^::zero } "*" a)\) a
            (trans!{N.Nat^} \({ N.Nat^::zero } "+" ({ N.Nat^::succ N.Nat^::zero } "*" a)\) \({ N.Nat^::succ N.Nat^::zero } "*" a\) a
              (addZeroLeft \({ N.Nat^::succ N.Nat^::zero } "*" a\)) ih))))
    };
\definition mulDistribRight (a, b: N.Nat^): \forall (c: N.Nat^) ->
  \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\) :=
  \induction (c: N.Nat^) \return \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\) \with {
    | zero : \refl(N.Nat^::zero)
    | succ : \fun (c: N.Nat^) (ih: \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\)) =>
      eq_reason!{
        \((a "+" b) "*" { N.Nat^::succ c }\)
        "=" \((a "+" b) "+" ((a "+" b) "*" c)\) "by" { mulSuccRight \(a "+" b\) c }
        "=" \((a "+" b) "+" ((a "*" c) "+" (b "*" c))\)
        "by" { congr!{N.Nat^ N.Nat^} (Op.Add::[set] \(a "+" b\)) _ _ ih }
        "=" \((a "+" (a "*" c)) "+" (b "+" (b "*" c))\)
        "by" { addInterchange a b \(a "*" c\) \(b "*" c\) }
        "=" \((a "*" { N.Nat^::succ c }) "+" (b "*" { N.Nat^::succ c })\)
        "by" { congr2!{N.Nat^ N.Nat^ N.Nat^} Op.Add::[set] _ _ _ _
          (sym!{N.Nat^} _ _ (mulSuccRight a c)) (sym!{N.Nat^} _ _ (mulSuccRight b c)) }
      }
  };
\definition mulSuccLeft: \forall (a, b: N.Nat^) -> \({ N.Nat^::succ a } "*" b\) = \(b "+" (a "*" b)\) :=
  \fun (a, b: N.Nat^) => eq_reason!{
    \({ N.Nat^::succ a } "*" b\)
    "=" \((a "*" b) "+" ({ N.Nat^::succ N.Nat^::zero } "*" b)\)
    "by" { mulDistribRight a (N.Nat^::succ N.Nat^::zero) b }
    "=" \((a "*" b) "+" b\)
    "by" { congr!{N.Nat^ N.Nat^} (Op.Add::[set] \(a "*" b\)) _ _ (mulOneLeft b) }
    "=" \(b "+" (a "*" b)\) "by" { addComm \(a "*" b\) b }
  };
\definition mulComm (a: N.Nat^): \forall (b: N.Nat^) -> \(a "*" b\) = \(b "*" a\) :=
  \induction (b: N.Nat^) \return \(a "*" b\) = \(b "*" a\) \with {
    | zero : sym!{N.Nat^} _ _ (mulZeroLeft a)
    | succ : \fun (b: N.Nat^) (ih: \(a "*" b\) = \(b "*" a\)) => eq_reason!{
        \(a "*" { N.Nat^::succ b }\)
        "=" \(a "+" (a "*" b)\) "by" { mulSuccRight a b }
        "=" \(a "+" (b "*" a)\) "by" { congr!{N.Nat^ N.Nat^} (Op.Add::[set] a) _ _ ih }
        "=" \({ N.Nat^::succ b } "*" a\) "by" { sym!{N.Nat^} _ _ (mulSuccLeft b a) }
      }
  };
\definition mulOneRight (a: N.Nat^): \(a "*" { N.Nat^::succ N.Nat^::zero }\) = a :=
  eq_reason!{
    \(a "*" { N.Nat^::succ N.Nat^::zero }\)
    "=" \({ N.Nat^::succ N.Nat^::zero } "*" a\) "by" { mulComm a (N.Nat^::succ N.Nat^::zero) }
    "=" a "by" { mulOneLeft a }
  };
\definition mulDistribLeft: \forall (a, b, c: N.Nat^) ->
  \(a "*" (b "+" c)\) = \((a "*" b) "+" (a "*" c)\) :=
  \fun (a, b, c: N.Nat^) => eq_reason!{
    \(a "*" (b "+" c)\)
    "=" \((b "+" c) "*" a\) "by" { mulComm a \(b "+" c\) }
    "=" \((b "*" a) "+" (c "*" a)\) "by" { mulDistribRight b c a }
    "=" \((a "*" b) "+" (a "*" c)\)
    "by" { congr2!{N.Nat^ N.Nat^ N.Nat^} Op.Add::[set] _ _ _ _ (mulComm b a) (mulComm c a) }
  };
\definition mulAssoc (a, b: N.Nat^): \forall (c: N.Nat^) ->
  \((a "*" b) "*" c\) = \(a "*" (b "*" c)\) :=
  \induction (c: N.Nat^) \return \((a "*" b) "*" c\) = \(a "*" (b "*" c)\) \with {
    | zero : \refl(N.Nat^::zero)
    | succ : \fun (c: N.Nat^) (ih: \((a "*" b) "*" c\) = \(a "*" (b "*" c)\)) =>
      eq_reason!{
        \((a "*" b) "*" { N.Nat^::succ c }\)
        "=" \((a "*" b) "+" ((a "*" b) "*" c)\) "by" { mulSuccRight \(a "*" b\) c }
        "=" \((a "*" b) "+" (a "*" (b "*" c))\)
        "by" { congr!{N.Nat^ N.Nat^} (Op.Add::[set] \(a "*" b\)) _ _ ih }
        "=" \(a "*" (b "+" (b "*" c))\) "by" { sym!{N.Nat^} _ _ (mulDistribLeft a b \(b "*" c\)) }
        "=" \(a "*" (b "*" { N.Nat^::succ c })\)
        "by" { congr!{N.Nat^ N.Nat^} (Op.Mul::[set] a) _ _ (sym!{N.Nat^} _ _ (mulSuccRight b c)) }
      }
  };

\definition zeroEqSuccElim (n: N.Nat^) (P: \Prop) (e: N.Nat^::zero = N.Nat^::succ n): P :=
    B.absurd P
      (sym!{B.Bool^} B.Bool^::true B.Bool^::false
        (congr!{N.Nat^ B.Bool^} Op.IsZero::[set] N.Nat^::zero (N.Nat^::succ n) e));

\definition succEqZeroElim (n: N.Nat^) (P: \Prop) (e: N.Nat^::succ n = N.Nat^::zero): P :=
    B.absurd P
      (congr!{N.Nat^ B.Bool^} Op.IsZero::[set] (N.Nat^::succ n) N.Nat^::zero e);

\definition mulSuccSucc (a, k: N.Nat^):
  \({ N.Nat^::succ a } "*" { N.Nat^::succ k }\) =
    N.Nat^::succ \(k "+" (a "*" { N.Nat^::succ k })\) :=
    trans!{N.Nat^} _ _ _ (mulSuccLeft a (N.Nat^::succ k))
      (addSuccLeft k \(a "*" { N.Nat^::succ k }\));

/* Multiplication by a successor is injective. */
\definition mulCancelRightSucc: \forall (k, a, b: N.Nat^) ->
  \(a "*" { N.Nat^::succ k }\) = \(b "*" { N.Nat^::succ k }\) -> a = b :=

  \fun (k: N.Nat^) =>
    \induction (a: N.Nat^) \return \forall (b: N.Nat^) ->
        \(a "*" { N.Nat^::succ k }\) = \(b "*" { N.Nat^::succ k }\) -> a = b \with {
      | zero : (\induction (b: N.Nat^) \return \({ N.Nat^::zero } "*" { N.Nat^::succ k }\) = \(b "*" { N.Nat^::succ k }\) ->
          N.Nat^::zero = b \with {
        | zero : (\fun (e: \({ N.Nat^::zero } "*" { N.Nat^::succ k }\) =
          \({ N.Nat^::zero } "*" { N.Nat^::succ k }\)) => \refl(N.Nat^::zero))
        | succ : (\fun (b: N.Nat^) =>
        \fun (unused: \({ N.Nat^::zero } "*" { N.Nat^::succ k }\) =
          \(b "*" { N.Nat^::succ k }\) -> N.Nat^::zero = b) =>
        \fun (e: \({ N.Nat^::zero } "*" { N.Nat^::succ k }\) =
          \({ N.Nat^::succ b } "*" { N.Nat^::succ k }\)) =>
          zeroEqSuccElim
            \(k "+" (b "*" { N.Nat^::succ k })\)
            (N.Nat^::zero = N.Nat^::succ b)
            (trans!{N.Nat^} _ _ _
              (sym!{N.Nat^} _ _ (mulZeroLeft (N.Nat^::succ k)))
              (trans!{N.Nat^} _ _ _ e (mulSuccSucc b k))))
        })
      | succ : (\fun (a: N.Nat^) =>
      \fun (ih: \forall (b: N.Nat^) ->
        \(a "*" { N.Nat^::succ k }\) = \(b "*" { N.Nat^::succ k }\) -> a = b) =>
        \induction (b: N.Nat^) \return \({ N.Nat^::succ a } "*" { N.Nat^::succ k }\) =
              \(b "*" { N.Nat^::succ k }\) -> N.Nat^::succ a = b \with {
        | zero : (\fun (e: \({ N.Nat^::succ a } "*" { N.Nat^::succ k }\) =
            \({ N.Nat^::zero } "*" { N.Nat^::succ k }\)) =>
            succEqZeroElim
              \(k "+" (a "*" { N.Nat^::succ k })\)
              (N.Nat^::succ a = N.Nat^::zero)
              (trans!{N.Nat^} _ _ _
                (sym!{N.Nat^} _ _ (mulSuccSucc a k))
                (trans!{N.Nat^} _ _ _ e (mulZeroLeft (N.Nat^::succ k)))))
        | succ : (\fun (b: N.Nat^) =>
          \fun (unused: \({ N.Nat^::succ a } "*" { N.Nat^::succ k }\) =
            \(b "*" { N.Nat^::succ k }\) -> N.Nat^::succ a = b) =>
          \fun (e: \({ N.Nat^::succ a } "*" { N.Nat^::succ k }\) =
            \({ N.Nat^::succ b } "*" { N.Nat^::succ k }\)) =>
            Op.succCong a b
              (ih b
                (addCancelLeft k
                  \(a "*" { N.Nat^::succ k }\)
                  \(b "*" { N.Nat^::succ k }\)
                  (succInjective
                    \(k "+" (a "*" { N.Nat^::succ k })\)
                    \(k "+" (b "*" { N.Nat^::succ k })\)
                    (trans!{N.Nat^} _ _ _
                      (sym!{N.Nat^} _ _ (mulSuccSucc a k))
                      (trans!{N.Nat^} _ _ _ e (mulSuccSucc b k)))))))
        })
      };

/* General Law views of the arithmetic theorems above. */
\definition addCommutative: Law.Commutative N.Nat^ Op.Add::[set] :=
  \fun (a, b: N.Nat^) => addComm a b;
\definition addAssociative: Law.Associative N.Nat^ Op.Add::[set] :=
  \fun (a, b, c: N.Nat^) => addAssoc a b c;
\definition mulCommutative: Law.Commutative N.Nat^ Op.Mul::[set] :=
  \fun (a, b: N.Nat^) => mulComm a b;
\definition mulAssociative: Law.Associative N.Nat^ Op.Mul::[set] :=
  \fun (a, b, c: N.Nat^) => mulAssoc a b c;
\definition mulLeftDistributive: Law.LeftDistributive N.Nat^ Op.Mul::[set] Op.Add::[set] :=
  mulDistribLeft;
\definition mulRightDistributive: Law.RightDistributive N.Nat^ Op.Mul::[set] Op.Add::[set] :=
  \fun (a, b, c: N.Nat^) => mulDistribRight a b c;

\definition leStep: \forall (b, a: N.Nat^) -> Le a b -> Le a (N.Nat^::succ b) :=
  \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Le a b -> Le a (N.Nat^::succ b) \with {
    | zero : (\induction (a: N.Nat^) \return Le a N.Nat^::zero -> Le a (N.Nat^::succ N.Nat^::zero) \with {
      | zero : (\fun (_: Le N.Nat^::zero N.Nat^::zero) => \refl(B.Bool^::true))
      | succ : (\fun (a: N.Nat^) => \fun (_: Le a N.Nat^::zero -> Le a (N.Nat^::succ N.Nat^::zero)) =>
        \fun (bad: Le (N.Nat^::succ a) N.Nat^::zero) => B.absurd (Le (N.Nat^::succ a) (N.Nat^::succ N.Nat^::zero)) bad)
      })
    | succ : (\fun (b: N.Nat^) => \fun (ih: \forall (a: N.Nat^) -> Le a b -> Le a (N.Nat^::succ b)) =>
      \induction (a: N.Nat^) \return Le a (N.Nat^::succ b) -> Le a (N.Nat^::succ (N.Nat^::succ b)) \with {
      | zero : (\fun (_: Le N.Nat^::zero (N.Nat^::succ b)) => \refl(B.Bool^::true))
      | succ : (\fun (a: N.Nat^) => \fun (_: Le a (N.Nat^::succ b) -> Le a (N.Nat^::succ (N.Nat^::succ b))) =>
          \fun (h: Le (N.Nat^::succ a) (N.Nat^::succ b)) => ih a h)
      })
    };
\definition leAddRight (a: N.Nat^): \forall (b: N.Nat^) -> Le a \(a "+" b\) :=
  \induction (b: N.Nat^) \return Le a \(a "+" b\) \with {
    | zero : (leRefl a)
    | succ : (\fun (b: N.Nat^) => \fun (ih: Le a \(a "+" b\)) =>
      \idelim N.Nat^::succ \(a "+" b\) = \(a "+" { N.Nat^::succ b }\)
        \with c: N.Nat^ => Le a c
        \by { base: leStep \(a "+" b\) a ih, equality: sym!{N.Nat^} _ _ (addSuccRight a b) })
    };
\definition leAddLeft (a, b: N.Nat^): Le b \(a "+" b\) :=
  \idelim \(b "+" a\) = \(a "+" b\) \with c: N.Nat^ => Le b c
    \by { base: leAddRight b a, equality: addComm b a };

