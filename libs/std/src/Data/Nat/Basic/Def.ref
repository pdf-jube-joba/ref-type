\import std.Data[].Nat[].Iteration[].Def[A := Nat^] \as NatIteration;
\import std.Logic[].Equality[] \as Equality;
\use Equality::congr;
\import std.Data[].Bool[] \as B;

\definition zero: Nat^ := Nat^::zero;
\definition one: Nat^ := Nat^::succ zero;

\definition succCong: \forall (a, b: Nat^) -> a = b -> Nat^::succ a = Nat^::succ b :=
  congr!{Nat^ Nat^} (\fun (n: Nat^) => Nat^::succ n);

\definition add: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) =>
  \induction (n: Nat^) \return Nat^ \with {
    | zero: a
    | succ: \fun (n: Nat^) (sum: _) => Nat^::succ sum
  } b;

\math-macro nat_add($x, "+", $y) := add $x $y;

\definition pred: Nat^ -> Nat^ := \fun (n: Nat^) =>
  \induction (n: Nat^) \return Nat^ \with {
    | zero: zero
    | succ: \fun (k: Nat^) (_: _) => k
  } n;

\definition isZero: Nat^ -> B.Bool^ := \fun (n: Nat^) =>
  \induction (n: Nat^) \return B.Bool^ \with {
    | zero: B.Bool^::true
    | succ: \fun (k: Nat^) (_: _) => B.Bool^::false
  } n;

\definition sub: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) =>
  \induction (n: Nat^) \return Nat^ -> Nat^ \with {
    | zero: \fun (a: Nat^) => a
    | succ: \fun (k: Nat^) (rec: _) (a: Nat^) =>
      \induction (a: Nat^) \return Nat^ \with {
        | zero: zero
        | succ: \fun (j: Nat^) (_: _) => rec j
      } a
  } b a;

\definition eqb: Nat^ -> Nat^ -> B.Bool^ := \fun (a, b: Nat^) =>
  \induction (n: Nat^) \return Nat^ -> B.Bool^ \with {
    | zero: isZero
    | succ: \fun (k: Nat^) (rec: _) (a: Nat^) =>
      \induction (a: Nat^) \return B.Bool^ \with {
        | zero: B.Bool^::false
        | succ: \fun (j: Nat^) (_: _) => rec j
      } a
  } b a;

\definition leb: Nat^ -> Nat^ -> B.Bool^ := \fun (a, b: Nat^) =>
  \induction (n: Nat^) \return Nat^ -> B.Bool^ \with {
    | zero: isZero
    | succ: \fun (k: Nat^) (rec: _) (a: Nat^) =>
      \induction (a: Nat^) \return B.Bool^ \with {
        | zero: B.Bool^::true
        | succ: \fun (j: Nat^) (_: _) => rec j
      } a
  } b a;

\definition ltb: Nat^ -> Nat^ -> B.Bool^ := \fun (a, b: Nat^) =>
  \induction (n: Nat^) \return Nat^ -> B.Bool^ \with {
    | zero: \fun (a: Nat^) => B.Bool^::false
    | succ: \fun (k: Nat^) (rec: _) (a: Nat^) =>
      \induction (a: Nat^) \return B.Bool^ \with {
        | zero: B.Bool^::true
        | succ: \fun (j: Nat^) (_: _) => rec j
      } a
  } b a;

\definition iter: (Nat^ -> Nat^) -> Nat^ -> Nat^ -> Nat^ := NatIteration.apply;

\definition mul: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) => iter (add a) zero b;

\math-macro nat_mul($x, "*", $y) := mul $x $y;

\definition pow: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) => iter (mul a) one b;

\definition choose: B.Bool^ -> Nat^ -> Nat^ -> Nat^ := \fun (test: B.Bool^) (yes, no: Nat^) => B.ite Nat^ test yes no;

\definition min: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) => choose (ltb a b) a b;
\definition max: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) => choose (ltb a b) b a;
