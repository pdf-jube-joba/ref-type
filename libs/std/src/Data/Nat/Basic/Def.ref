\import std.Program[] \as ProgramBundles;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;

\import std.Data[].Bool[] \as B;

\definition zero: Nat := Nat::zero;
\definition one: Nat := Nat::succ Nat::zero;

\inductive AddState: \VType :=
| running: Nat -> Nat -> AddState
;

\module AddLoopImplementation {
  \definition State: \VType := AddState;

  \definition Output: \VType := Nat;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: AddState) => \match state \in AddState \with {
      | running accumulator remaining :
          \match remaining \in Nat \with {
            | zero :
              \return(\finish[AddState, Nat](accumulator))
            | succ smaller :
              \return(\continue[AddState, Nat](AddState::running (Nat::succ accumulator) smaller))
          }
    });

  \import std.Logic[].Termination[State := AddState^, Output := Nat^,
      step := step^] \as Termination;

  \definition terminates:
      \forall (remaining: Nat^) -> \forall (accumulator: Nat^) ->
        Termination.Holds (AddState^::running accumulator remaining) :=
      \induction (n: Nat^) \return \forall (a: Nat^) -> Termination.Holds (AddState^::running a n) \with {
        | zero : (\fun (a: Nat^) => Termination.intro (AddState^::running a Nat^::zero) Termination.trivial)
        | succ : (\fun (n: Nat^) => \fun (ih: _) =>
          \fun (a: Nat^) => Termination.intro (AddState^::running a (Nat^::succ n)) (ih (Nat^::succ a)))
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: AddState^) \return
      Termination.Holds s \with {
        | running: \fun (accumulator, remaining: Nat^) => terminates remaining accumulator
      };
}
\import .AddLoopImplementation[] \as AddLoopParts;
\definition AddLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := AddLoopParts.State,
  Output := AddLoopParts.Output,
  step := AddLoopParts.step,
  terminates := AddLoopParts.certificate,
};
\definition AddLoopRunbox: \Box[AddLoop.State ~> \F(AddLoop.Output)] := \box[AddLoop.State ~> \F(AddLoop.Output)](\force AddLoop.run);

\definition succCong: \forall (a, b: Nat^) -> a = b -> Nat^::succ a = Nat^::succ b :=
  congr!{Nat^ Nat^} (\fun (n: Nat^) => Nat^::succ n);

\module AddImplementation {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: Nat -> Nat -> Nat := \fun (left, right: Nat) =>
      (\force AddLoop.run) (AddState::running left right);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      \induction (n: Nat^) \return Nat^ \with {
      | zero : a
      | succ : (\fun (n: Nat^) => \fun (sum: Nat^) => Nat^::succ sum)
    } b;

  \definition succLeft (a: Nat^):
      \forall (b: Nat^) -> specification (Nat^::succ a) b = Nat^::succ (specification a b) :=
      \induction (b: Nat^) \return specification (Nat^::succ a) b = Nat^::succ (specification a b) \with {
        | zero : (\refl(Nat^::succ a))
        | succ : (\fun (b: Nat^) => \fun (ih: _) =>
          succCong (specification (Nat^::succ a) b) (Nat^::succ (specification a b)) ih)
      };

  \math-macro nat_add($x, "+", $y) := program^ $x $y;

  \definition matches: \forall (b, a: Nat^) -> \(a "+" b\) = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> \(a "+" b\) = specification a b \with {
        | zero : (\fun (a: Nat^) => \refl(a))
        | succ : (\fun (b: Nat^) => \fun (ih: _) => \fun (a: Nat^) =>
          eq_reason!{
            \(a "+" { Nat^::succ b }\)
            "=" { specification (Nat^::succ a) b } "by" { ih (Nat^::succ a) }
            "=" { Nat^::succ (specification a b) } "by" { succLeft a b }
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}
\import .AddImplementation[] \as AddParts;
\definition Add: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := AddParts.T,
  program := \thunk (AddParts.program),
  specification := AddParts.specification,
  coherence := AddParts.coherence,
};

\math-macro nat_add($x, "+", $y) := Add.specification $x $y;

\module PredImplementation {
  \definition T: \VType := \U(Nat -> Nat);

  \definition program: Nat -> Nat := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return Nat::zero | succ k : \return k });

  \definition specification: T^ := \fun (n: Nat^) =>
      \induction (n: Nat^) \return Nat^ \with {
      | zero : Nat^::zero
      | succ : (\fun (k: Nat^) => \fun (_: _) => k)
    } n;

  \definition matches: \forall (n: Nat^) -> program^ n = specification n :=
      \induction (n: Nat^) \return program^ n = specification n \with {
        | zero : (\refl(Nat^::zero))
        | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(k))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (n: Nat^) => matches n);
}
\import .PredImplementation[] \as PredParts;
\definition Pred: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PredParts.T,
  program := \thunk (PredParts.program),
  specification := PredParts.specification,
  coherence := PredParts.coherence,
};

\module IsZeroImplementation {
  \definition T: \VType := \U(Nat -> B.Bool);

  \definition program: Nat -> B.Bool := (\cfun (n: Nat) => \match n \in Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false });

  \definition specification: T^ := \fun (n: Nat^) =>
      \induction (n: Nat^) \return B.Bool^ \with {
      | zero : B.Bool^::true
      | succ : (\fun (k: Nat^) => \fun (_: _) => B.Bool^::false)
    } n;

  \definition matches: \forall (n: Nat^) -> program^ n = specification n :=
      \induction (n: Nat^) \return program^ n = specification n \with {
        | zero : (\refl(B.Bool^::true))
        | succ : (\fun (k: Nat^) => \fun (ih: _) => \refl(B.Bool^::false))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (n: Nat^) => matches n);
}
\import .IsZeroImplementation[] \as IsZeroParts;
\definition IsZero: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := IsZeroParts.T,
  program := \thunk (IsZeroParts.program),
  specification := IsZeroParts.specification,
  coherence := IsZeroParts.coherence,
};

/* sub: both operands decrease on every continuing transition. */
\inductive SubState: \VType := | running: Nat -> Nat -> SubState;

\module SubLoopImplementation {
  \definition State: \VType := SubState;

  \definition Output: \VType := Nat;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: SubState) => \match state \in SubState \with { | running a b :
      \match b \in Nat \with {
        | zero : \return(\finish[SubState, Nat](a))
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[SubState, Nat](Nat::zero))
          | succ j : \return(\continue[SubState, Nat](SubState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := SubState^, Output := Nat^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (SubState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (SubState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (SubState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (SubState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (SubState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (SubState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (SubState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (SubState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: SubState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}
\import .SubLoopImplementation[] \as SubLoopParts;
\definition SubLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := SubLoopParts.State,
  Output := SubLoopParts.Output,
  step := SubLoopParts.step,
  terminates := SubLoopParts.certificate,
};
\definition SubLoopRunbox: \Box[SubLoop.State ~> \F(SubLoop.Output)] := \box[SubLoop.State ~> \F(SubLoop.Output)](\force SubLoop.run);

\module SubImplementation {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: Nat -> Nat -> Nat := \fun (a, b: Nat) =>
      (\force SubLoop.run) (SubState::running a b);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      \induction (b: Nat^) \return Nat^ -> Nat^ \with {
      | zero : (\fun (a: Nat^) => a)
      | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> Nat^) => \fun (a: Nat^) =>
        \induction (a: Nat^) \return Nat^ \with {
          | zero : Nat^::zero
          | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
        } a)
    } b a;

  \definition matches: \forall (b, a: Nat^) -> program^ a b = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> program^ a b = specification a b \with {
        | zero : (\induction (a: Nat^) \return program^ a Nat^::zero = specification a Nat^::zero \with {
          | zero : (\refl(specification Nat^::zero
          Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(specification
          (Nat^::succ j) Nat^::zero))
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return program^ a (Nat^::succ k) = specification a (Nat^::succ k) \with {
            | zero : (\refl(Nat^::zero))
            | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}
\import .SubImplementation[] \as SubParts;
\definition Sub: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SubParts.T,
  program := \thunk (SubParts.program),
  specification := SubParts.specification,
  coherence := SubParts.coherence,
};

/* eqb: both operands decrease on every continuing transition. */
\inductive EqbState: \VType := | running: Nat -> Nat -> EqbState;

\module EqbLoopImplementation {
  \definition State: \VType := EqbState;

  \definition Output: \VType := B.Bool;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: EqbState) => \match state \in EqbState \with { | running a b :
      \match b \in Nat \with {
        | zero : \match a \in Nat \with { | zero : \return(\finish[EqbState, B.Bool](B.Bool::true)) | succ k :
          \return(\finish[EqbState, B.Bool](B.Bool::false)) }
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[EqbState, B.Bool](B.Bool::false))
          | succ j : \return(\continue[EqbState, B.Bool](EqbState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := EqbState^, Output := B.Bool^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (EqbState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (EqbState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (EqbState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (EqbState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (EqbState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (EqbState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (EqbState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (EqbState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: EqbState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}
\import .EqbLoopImplementation[] \as EqbLoopParts;
\definition EqbLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := EqbLoopParts.State,
  Output := EqbLoopParts.Output,
  step := EqbLoopParts.step,
  terminates := EqbLoopParts.certificate,
};
\definition EqbLoopRunbox: \Box[EqbLoop.State ~> \F(EqbLoop.Output)] := \box[EqbLoop.State ~> \F(EqbLoop.Output)](\force EqbLoop.run);

\module EqbImplementation {
  \definition T: \VType := \U(Nat -> Nat -> B.Bool);

  \definition program: Nat -> Nat -> B.Bool := \fun (a, b: Nat) =>
      (\force EqbLoop.run) (EqbState::running a b);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      \induction (b: Nat^) \return Nat^ -> B.Bool^ \with {
      | zero : (\fun (a: Nat^) => IsZero.specification a)
      | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> B.Bool^) => \fun (a: Nat^) =>
        \induction (a: Nat^) \return B.Bool^ \with {
          | zero : B.Bool^::false
          | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
        } a)
    } b a;

  \definition matches: \forall (b, a: Nat^) -> program^ a b = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> program^ a b = specification a b \with {
        | zero : (\induction (a: Nat^) \return program^ a Nat^::zero = specification a Nat^::zero \with {
          | zero : (\refl(specification Nat^::zero
          Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(specification
          (Nat^::succ j) Nat^::zero))
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return program^ a (Nat^::succ k) = specification a (Nat^::succ k) \with {
            | zero : (\refl(B.Bool^::false))
            | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}
\import .EqbImplementation[] \as EqbParts;
\definition Eqb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := EqbParts.T,
  program := \thunk (EqbParts.program),
  specification := EqbParts.specification,
  coherence := EqbParts.coherence,
};

/* leb: both operands decrease on every continuing transition. */
\inductive LebState: \VType := | running: Nat -> Nat -> LebState;

\module LebLoopImplementation {
  \definition State: \VType := LebState;

  \definition Output: \VType := B.Bool;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: LebState) => \match state \in LebState \with { | running a b :
      \match b \in Nat \with {
        | zero : \match a \in Nat \with { | zero : \return(\finish[LebState, B.Bool](B.Bool::true)) | succ k :
          \return(\finish[LebState, B.Bool](B.Bool::false)) }
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[LebState, B.Bool](B.Bool::true))
          | succ j : \return(\continue[LebState, B.Bool](LebState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := LebState^, Output := B.Bool^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (LebState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (LebState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (LebState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (LebState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (LebState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (LebState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (LebState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (LebState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: LebState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}
\import .LebLoopImplementation[] \as LebLoopParts;
\definition LebLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := LebLoopParts.State,
  Output := LebLoopParts.Output,
  step := LebLoopParts.step,
  terminates := LebLoopParts.certificate,
};
\definition LebLoopRunbox: \Box[LebLoop.State ~> \F(LebLoop.Output)] := \box[LebLoop.State ~> \F(LebLoop.Output)](\force LebLoop.run);

\module LebImplementation {
  \definition T: \VType := \U(Nat -> Nat -> B.Bool);

  \definition program: Nat -> Nat -> B.Bool := \fun (a, b: Nat) =>
      (\force LebLoop.run) (LebState::running a b);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      \induction (b: Nat^) \return Nat^ -> B.Bool^ \with {
      | zero : (\fun (a: Nat^) => IsZero.specification a)
      | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> B.Bool^) => \fun (a: Nat^) =>
        \induction (a: Nat^) \return B.Bool^ \with {
          | zero : B.Bool^::true
          | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
        } a)
    } b a;

  \definition matches: \forall (b, a: Nat^) -> program^ a b = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> program^ a b = specification a b \with {
        | zero : (\induction (a: Nat^) \return program^ a Nat^::zero = specification a Nat^::zero \with {
          | zero : (\refl(specification Nat^::zero
          Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(specification
          (Nat^::succ j) Nat^::zero))
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return program^ a (Nat^::succ k) = specification a (Nat^::succ k) \with {
            | zero : (\refl(B.Bool^::true))
            | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}
\import .LebImplementation[] \as LebParts;
\definition Leb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := LebParts.T,
  program := \thunk (LebParts.program),
  specification := LebParts.specification,
  coherence := LebParts.coherence,
};

/* ltb: both operands decrease on every continuing transition. */
\inductive LtbState: \VType := | running: Nat -> Nat -> LtbState;

\module LtbLoopImplementation {
  \definition State: \VType := LtbState;

  \definition Output: \VType := B.Bool;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: LtbState) => \match state \in LtbState \with { | running a b :
      \match b \in Nat \with {
        | zero : \return(\finish[LtbState, B.Bool](B.Bool::false))
        | succ k : \match a \in Nat \with {
          | zero : \return(\finish[LtbState, B.Bool](B.Bool::true))
          | succ j : \return(\continue[LtbState, B.Bool](LtbState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := LtbState^, Output := B.Bool^,
      step := step^] \as Termination;

  \definition terminates: \forall (b, a: Nat^) -> Termination.Holds (LtbState^::running a b) :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> Termination.Holds (LtbState^::running a b) \with {
        | zero : (\induction (a: Nat^) \return Termination.Holds (LtbState^::running a Nat^::zero) \with {
          | zero : (Termination.intro (LtbState^::running Nat^::zero Nat^::zero) Termination.trivial)
          | succ : (\fun (j: Nat^) => \fun (unused: _) => Termination.intro (LtbState^::running
          (Nat^::succ j) Nat^::zero) Termination.trivial)
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return Termination.Holds (LtbState^::running a (Nat^::succ k)) \with {
            | zero : (Termination.intro (LtbState^::running Nat^::zero (Nat^::succ k)) Termination.trivial)
            | succ : (\fun (j: Nat^) => \fun (unused: _) =>
              Termination.intro (LtbState^::running (Nat^::succ j) (Nat^::succ k)) (ih j))
          })
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: LtbState^) \return
      Termination.Holds s \with {
        | running: \fun (a, b: Nat^) => terminates b a
      };
}
\import .LtbLoopImplementation[] \as LtbLoopParts;
\definition LtbLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := LtbLoopParts.State,
  Output := LtbLoopParts.Output,
  step := LtbLoopParts.step,
  terminates := LtbLoopParts.certificate,
};
\definition LtbLoopRunbox: \Box[LtbLoop.State ~> \F(LtbLoop.Output)] := \box[LtbLoop.State ~> \F(LtbLoop.Output)](\force LtbLoop.run);

\module LtbImplementation {
  \definition T: \VType := \U(Nat -> Nat -> B.Bool);

  \definition program: Nat -> Nat -> B.Bool := \fun (a, b: Nat) =>
      (\force LtbLoop.run) (LtbState::running a b);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      \induction (b: Nat^) \return Nat^ -> B.Bool^ \with {
      | zero : (\fun (a: Nat^) => B.Bool^::false)
      | succ : (\fun (k: Nat^) => \fun (rec: Nat^ -> B.Bool^) => \fun (a: Nat^) =>
        \induction (a: Nat^) \return B.Bool^ \with {
          | zero : B.Bool^::true
          | succ : (\fun (j: Nat^) => \fun (_: _) => rec j)
        } a)
    } b a;

  \definition matches: \forall (b, a: Nat^) -> program^ a b = specification a b :=
      \induction (b: Nat^) \return \forall (a: Nat^) -> program^ a b = specification a b \with {
        | zero : (\induction (a: Nat^) \return program^ a Nat^::zero = specification a Nat^::zero \with {
          | zero : (\refl(specification Nat^::zero
          Nat^::zero))
          | succ : (\fun (j: Nat^) => \fun (unused: _) => \refl(specification
          (Nat^::succ j) Nat^::zero))
        })
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \induction (a: Nat^) \return program^ a (Nat^::succ k) = specification a (Nat^::succ k) \with {
            | zero : (\refl(B.Bool^::true))
            | succ : (\fun (j: Nat^) => \fun (unused: _) => ih j)
          })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches b a));
}
\import .LtbImplementation[] \as LtbParts;
\definition Ltb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := LtbParts.T,
  program := \thunk (LtbParts.program),
  specification := LtbParts.specification,
  coherence := LtbParts.coherence,
};

/* A total iterator, shared by multiplication, powers and other finite loops. */
\inductive IterState: \VType :=
| running: \U(Nat -> Nat) -> Nat -> Nat -> IterState
;

\module IterLoopImplementation {
  \definition State: \VType := IterState;

  \definition Output: \VType := Nat;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: IterState) => \match state \in IterState \with {
      | running f value count : \match count \in Nat \with {
        | zero : \return(\finish[IterState, Nat](value))
        | succ k : \program {
          \bind next: Nat <- (\force f) value \then
          \return \continue[IterState, Nat](IterState::running f next k)
        }
      }
    });

  \import std.Logic[].Termination[State := IterState^, Output := Nat^,
      step := step^] \as Termination;

  \definition terminates: \forall (count: Nat^) (f: Nat^ -> Nat^) (value: Nat^) ->
      Termination.Holds (IterState^::running f value count) :=
      \induction (count: Nat^) \return \forall (f: Nat^ -> Nat^) (value: Nat^) ->
        Termination.Holds (IterState^::running f value count) \with {
        | zero: \fun (f: Nat^ -> Nat^) (value: Nat^) =>
          Termination.intro (IterState^::running f value Nat^::zero) Termination.trivial
        | succ: \fun (k: Nat^) (ih: _) (f: Nat^ -> Nat^) (value: Nat^) =>
          Termination.intro (IterState^::running f value (Nat^::succ k)) (ih f (f value))
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (s: IterState^) \return
      Termination.Holds s \with {
        | running: \fun (f: Nat^ -> Nat^) (value, count: Nat^) => terminates count f value
      };
}
\import .IterLoopImplementation[] \as IterLoopParts;
\definition IterLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := IterLoopParts.State,
  Output := IterLoopParts.Output,
  step := IterLoopParts.step,
  terminates := IterLoopParts.certificate,
};
\definition IterLoopRunbox: \Box[IterLoop.State ~> \F(IterLoop.Output)] := \box[IterLoop.State ~> \F(IterLoop.Output)](\force IterLoop.run);

\import std.Data[].Nat[].Iteration[].Def[A := Nat^] \as NatIteration;

\module IterImplementation {
  \definition T: \VType := \U(\U(Nat -> Nat) -> Nat -> Nat -> Nat);

  \definition program: \U(Nat -> Nat) -> Nat -> Nat -> Nat := \fun (f: \U(Nat -> Nat)) =>
      \fun (value, count: Nat) =>
        (\force IterLoop.run) (IterState::running f value count);

  \definition specification: T^ := NatIteration.specification #apply;

  \definition matches (f: Nat^ -> Nat^): \forall (count, value: Nat^) ->
      program^ f value count = specification f value count :=
      \induction (count: Nat^) \return \forall (value: Nat^) -> program^ f value count = specification f value count \with {
        | zero : (\fun (value: Nat^) => \refl(value))
        | succ : (\fun (k: Nat^) => \fun (ih: _) =>
          \fun (value: Nat^) =>
            \idelim specification f (f value) k = f (specification f value k)
              \with x: Nat^ => program^ f value (Nat^::succ k) = x
            \by { base: ih (f value), equality: (NatIteration.specification #advance) f k value })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (f: Nat^ -> Nat^) => \axiom:funext(program^ f, specification f,
        \fun (value: Nat^) => \axiom:funext(program^ f value, specification f value,
          \fun (count: Nat^) => matches f count value)));
}
\import .IterImplementation[] \as IterParts;
\definition Iter: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := IterParts.T,
  program := \thunk (IterParts.program),
  specification := IterParts.specification,
  coherence := IterParts.coherence,
};

\module MulImplementation {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: Nat -> Nat -> Nat := \fun (a, b: Nat) =>
      (\force IterLoop.run) (IterState::running
        \thunk(\cfun (current: Nat) => (\force AddLoop.run) (AddState::running a current))
        Nat::zero b);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      Iter.specification (Add.specification a) Nat^::zero b;

  \math-macro nat_mul($x, "*", $y) := program^ $x $y;

  \definition matches (a, b: Nat^): \(a "*" b\) = specification a b :=
      trans!{Nat^} _ _ _
        (congr!{Iter.T^ _} (\fun (f: _) => f (Add.program^ a) Nat^::zero b) _ _ Iter.coherence)
        (congr!{Add.T^ Nat^}
        (\fun (operation: _) => Iter.specification (operation a) Nat^::zero b) _ _ Add.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}
\import .MulImplementation[] \as MulParts;
\definition Mul: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MulParts.T,
  program := \thunk (MulParts.program),
  specification := MulParts.specification,
  coherence := MulParts.coherence,
};

\math-macro nat_mul($x, "*", $y) := Mul.specification $x $y;

\module PowImplementation {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: Nat -> Nat -> Nat := \fun (a, b: Nat) =>
      (\force IterLoop.run) (IterState::running
        \thunk(\cfun (current: Nat) => (\force IterLoop.run) (IterState::running
            \thunk(\cfun (next: Nat) => (\force AddLoop.run) (AddState::running a next))
            Nat::zero current))
        one b);

  \definition specification: T^ := \fun (a, b: Nat^) =>
      Iter.specification (Mul.specification a) (Nat^::succ Nat^::zero) b;

  \definition matches (a, b: Nat^): program^ a b = specification a b :=
      trans!{Nat^} _ _ _
        (congr!{Iter.T^ _} (\fun (f: _) => f (Mul.program^ a) (Nat^::succ Nat^::zero) b) _ _ Iter.coherence)
        (congr!{Mul.T^ Nat^}
        (\fun (operation: _) => Iter.specification (operation a) (Nat^::succ Nat^::zero) b) _ _ Mul.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}
\import .PowImplementation[] \as PowParts;
\definition Pow: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PowParts.T,
  program := \thunk (PowParts.program),
  specification := PowParts.specification,
  coherence := PowParts.coherence,
};

/* Selection is reflected once, then shared by min and max. */

\module ChooseImplementation {
  \definition T: \VType := \U(B.Bool -> Nat -> Nat -> Nat);

  \definition program: B.Bool -> Nat -> Nat -> Nat := \fun (test: B.Bool) =>
      \fun (yes, no: Nat) =>
        \match test \in B.Bool \with { | false : \return no | true : \return yes };

  \definition specification: T^ := \fun (test: B.Bool^) (yes, no: Nat^) =>
      B.ite Nat^ test yes no;

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: Nat^) -> program^ test yes no = specification test yes
      no :=
      \induction (test: B.Bool^) \return \forall (yes, no: Nat^) -> program^ test yes no = specification test yes no \with {
        | false : (\fun (yes, no: Nat^) => \refl(no))
        | true : (\fun (yes, no: Nat^) => \refl(yes))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (test: B.Bool^) => \axiom:funext(program^ test, specification test,
        \fun (yes: Nat^) => \axiom:funext(program^ test yes, specification test yes,
          \fun (no: Nat^) => matches test yes no)));
}
\import .ChooseImplementation[] \as ChooseParts;
\definition Choose: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := ChooseParts.T,
  program := \thunk (ChooseParts.program),
  specification := ChooseParts.specification,
  coherence := ChooseParts.coherence,
};

\module MinImplementation {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: Nat -> Nat -> Nat := \fun (a, b: Nat) => \program {
      \bind test: B.Bool <- (\force LtbLoop.run) (LtbState::running a b) \then
      \bind selected: Nat <- \match test \in B.Bool \with { | false : \return b | true : \return a } \then
      \return selected
    };

  \definition specification: T^ := \fun (a, b: Nat^) =>
      Choose.specification (Ltb.specification a b) a b;

  \definition matches: \forall (a, b: Nat^) -> program^ a b = specification a b :=
      \block {
        \fun (a, b: Nat^) \then
        \let testMatches: Ltb.program^ a b = Ltb.specification a b := (congr!{Ltb.T^ _} (\fun (f: _) => f a b) _ _ Ltb.coherence) \then
        \return
        \idelim Ltb.program^ a b = Ltb.specification a b
          \with test: B.Bool^ => program^ a b = Choose.specification test a b
        \by { base: (congr!{Choose.T^ _} (\fun (f: _) => f (Ltb.program^ a b) a b) _ _ Choose.coherence), equality: testMatches }
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}
\import .MinImplementation[] \as MinParts;
\definition Min: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MinParts.T,
  program := \thunk (MinParts.program),
  specification := MinParts.specification,
  coherence := MinParts.coherence,
};

\module MaxImplementation {
  \definition T: \VType := \U(Nat -> Nat -> Nat);

  \definition program: Nat -> Nat -> Nat := \fun (a, b: Nat) => \program {
      \bind test: B.Bool <- (\force LtbLoop.run) (LtbState::running a b) \then
      \bind selected: Nat <- \match test \in B.Bool \with { | false : \return a | true : \return b } \then
      \return selected
    };

  \definition specification: T^ := \fun (a, b: Nat^) =>
      Choose.specification (Ltb.specification a b) b a;

  \definition matches: \forall (a, b: Nat^) -> program^ a b = specification a b :=
      \block {
        \fun (a, b: Nat^) \then
        \let testMatches: Ltb.program^ a b = Ltb.specification a b := (congr!{Ltb.T^ _} (\fun (f: _) => f a b) _ _ Ltb.coherence) \then
        \return
        \idelim Ltb.program^ a b = Ltb.specification a b
          \with test: B.Bool^ => program^ a b = Choose.specification test b a
        \by { base: (congr!{Choose.T^ _} (\fun (f: _) => f (Ltb.program^ a b) b a) _ _ Choose.coherence), equality: testMatches }
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (a: Nat^) => \axiom:funext(program^ a, specification a,
        \fun (b: Nat^) => matches a b));
}
\import .MaxImplementation[] \as MaxParts;
\definition Max: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MaxParts.T,
  program := \thunk (MaxParts.program),
  specification := MaxParts.specification,
  coherence := MaxParts.coherence,
};

/* Pairs are Program data so that quotient/remainder and Euclidean states can
 * cross the reflection boundary together. */
