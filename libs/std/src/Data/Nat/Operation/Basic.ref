\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as L;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;

\import std.Data[].Bool[] \as B;
\import std.Data[].Pair[] \as P;

\definition zero: N.Nat := N.Nat::zero;
\definition one: N.Nat := N.Nat::succ N.Nat::zero;

/* Finite iteration and its computation laws, shared by both payload types. */
\structure Iteration[A: \Set]: \Set {
  apply: (A -> A) -> A -> N.Nat^ -> A,
} \where {
  zero: \forall (f: A -> A) (value: A) -> apply f value N.Nat^::zero = value,
  succ: \forall (f: A -> A) (value: A) (count: N.Nat^) ->
    apply f value (N.Nat^::succ count) = f (apply f value count),
  advance: \forall (f: A -> A) (count: N.Nat^) (value: A) ->
    apply f (f value) count = f (apply f value count),
}

\module FiniteIteration(A: \Set) {
  \definition apply (f: A -> A) (value: A) (count: N.Nat^): A :=
    \induction (n: N.Nat^) \return A \with {
      | zero: value
      | succ: \fun (k: N.Nat^) (previous: A) => f previous
    } count;

  \definition advance (f: A -> A): \forall (count: N.Nat^) (value: A) ->
    apply f (f value) count = f (apply f value count) :=
    \induction (count: N.Nat^) \return \forall (value: A) ->
      apply f (f value) count = f (apply f value count) \with {
        | zero: \fun (value: A) => \refl(f value)
        | succ: \fun (k: N.Nat^) (ih: _) (value: A) =>
        congr!{A A} f _ _ (ih value)
      };

  \definition specification: Iteration[A]::[Set] :=
    Iteration[A] { apply := apply } \with {
      zero := \fun (f: A -> A) (value: A) => \refl(value),
      succ := \fun (f: A -> A) (value: A) (count: N.Nat^) =>
        \refl(f (apply f value count)),
      advance := advance,
    };
}

\module RunTermination(State, Output: \Set, step: State -> \RunStep[State, Output]) {
  \definition ready: \RunStep[State, Output] -> \Prop :=
    \step-match t: \RunStep[State, Output] \return \Prop \with {
      | \continue s: \Acc[State, Output](step, s)
      | \finish result: L.True
    };

  \definition accIntro (s: State) (certificate: ready (step s)):
    \Acc[State, Output](step, s) :=
    \accintro[State, Output](step, s,
      \fun (next: _) (edge: _) =>
        \idelim step s = \continue[State, Output](next)
          \with t: \RunStep[State, Output] => ready t
          \by { base: certificate, equality: edge });
}

\inductive AddState: \VType :=
| running: N.Nat -> N.Nat -> AddState
;

\machine AddLoop {
  \State := AddState,
  \Output := N.Nat,
  \step := \thunk(\cfun (state: AddState) => \match state \in AddState \with {
    | running accumulator remaining :
        \match remaining \in N.Nat \with {
          | zero :
            \return(\finish[AddState, N.Nat](accumulator))
          | succ smaller :
            \return(\continue[AddState, N.Nat](AddState::running (N.Nat::succ accumulator) smaller))
        }
  }),

  \import RunTermination[State := AddState^, Output := N.Nat^,
    step := AddLoop::[step]^] \as Termination;
  \definition terminates:
    \forall (remaining: N.Nat^) -> \forall (accumulator: N.Nat^) ->
      \Acc[AddState^, N.Nat^](AddLoop::[step]^, AddState^::running accumulator remaining) :=
    \induction (n: N.Nat^) \return \forall (a: N.Nat^) -> \Acc[AddState^, N.Nat^](AddLoop::[step]^, AddState^::running a n) \with {
      | zero : (\fun (a: N.Nat^) => Termination.accIntro (AddState^::running a N.Nat^::zero) L.True::intro)
      | succ : (\fun (n: N.Nat^) => \fun (ih: _) =>
        \fun (a: N.Nat^) => Termination.accIntro (AddState^::running a (N.Nat^::succ n)) (ih (N.Nat^::succ a)))
    };
  \terminates := \induction (s: AddState^) \return
    \Acc[AddState^, N.Nat^](AddLoop::[step]^, s) \with {
      | running: \fun (accumulator, remaining: N.Nat^) => terminates remaining accumulator
    },
}

\definition succCong: \forall (a, b: N.Nat^) -> a = b -> N.Nat^::succ a = N.Nat^::succ b :=
  congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => N.Nat^::succ n);

\correspondence Add: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (left, right: N.Nat) =>
    AddLoop::[run] (AddState::running left right),
  \set := \fun (a, b: N.Nat^) =>
    \induction (n: N.Nat^) \return N.Nat^ \with {
    | zero : a
    | succ : (\fun (n: N.Nat^) => \fun (sum: N.Nat^) => N.Nat^::succ sum)
  } b,

  \definition succLeft (a: N.Nat^):
    \forall (b: N.Nat^) -> Add::[set] (N.Nat^::succ a) b = N.Nat^::succ (Add::[set] a b) :=
    \induction (b: N.Nat^) \return Add::[set] (N.Nat^::succ a) b = N.Nat^::succ (Add::[set] a b) \with {
      | zero : (\refl(N.Nat^::succ a))
      | succ : (\fun (b: N.Nat^) => \fun (ih: _) =>
        succCong (Add::[set] (N.Nat^::succ a) b) (N.Nat^::succ (Add::[set] a b)) ih)
    };
  \math-macro nat_add($x, "+", $y) := Add::[program]^ $x $y;

  \definition matches: \forall (b, a: N.Nat^) -> \(a "+" b\) = Add::[set] a b :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> \(a "+" b\) = Add::[set] a b \with {
      | zero : (\fun (a: N.Nat^) => \refl(a))
      | succ : (\fun (b: N.Nat^) => \fun (ih: _) => \fun (a: N.Nat^) =>
        eq_reason!{
          \(a "+" { N.Nat^::succ b }\)
          "=" { Add::[set] (N.Nat^::succ a) b } "by" { ih (N.Nat^::succ a) }
          "=" { N.Nat^::succ (Add::[set] a b) } "by" { succLeft a b }
        })
    };
  \coherence := \axiom:funext(Add::[program]^, Add::[set],
    \fun (a: N.Nat^) => \axiom:funext(Add::[program]^ a, Add::[set] a,
      \fun (b: N.Nat^) => matches b a)),
}

\math-macro nat_add($x, "+", $y) := Add::[set] $x $y;

\correspondence Pred: N.Nat -> N.Nat {
  \program := (\cfun (n: N.Nat) => \match n \in N.Nat \with { | zero : \return N.Nat::zero | succ k : \return k }),
  \set := \fun (n: N.Nat^) =>
    \induction (n: N.Nat^) \return N.Nat^ \with {
    | zero : N.Nat^::zero
    | succ : (\fun (k: N.Nat^) => \fun (_: _) => k)
  } n,

  \definition matches: \forall (n: N.Nat^) -> Pred::[program]^ n = Pred::[set] n :=
    \induction (n: N.Nat^) \return Pred::[program]^ n = Pred::[set] n \with {
      | zero : (\refl(N.Nat^::zero))
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) => \refl(k))
    };
  \coherence := \axiom:funext(Pred::[program]^, Pred::[set],
    \fun (n: N.Nat^) => matches n),
}

\correspondence IsZero: N.Nat -> B.Bool {
  \program := (\cfun (n: N.Nat) => \match n \in N.Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false }),
  \set := \fun (n: N.Nat^) =>
    \induction (n: N.Nat^) \return B.Bool^ \with {
    | zero : B.Bool^::true
    | succ : (\fun (k: N.Nat^) => \fun (_: _) => B.Bool^::false)
  } n,

  \definition matches: \forall (n: N.Nat^) -> IsZero::[program]^ n = IsZero::[set] n :=
    \induction (n: N.Nat^) \return IsZero::[program]^ n = IsZero::[set] n \with {
      | zero : (\refl(B.Bool^::true))
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) => \refl(B.Bool^::false))
    };
  \coherence := \axiom:funext(IsZero::[program]^, IsZero::[set],
    \fun (n: N.Nat^) => matches n),
}

/* sub: both operands decrease on every continuing transition. */
\inductive SubState: \VType := | running: N.Nat -> N.Nat -> SubState;
\machine SubLoop {
  \State := SubState,
  \Output := N.Nat,
  \step := \thunk(\cfun (state: SubState) => \match state \in SubState \with { | running a b :
    \match b \in N.Nat \with {
      | zero : \return(\finish[SubState, N.Nat](a))
      | succ k : \match a \in N.Nat \with {
        | zero : \return(\finish[SubState, N.Nat](N.Nat::zero))
        | succ j : \return(\continue[SubState, N.Nat](SubState::running j k))
      }
    }
  }),

  \import RunTermination[State := SubState^, Output := N.Nat^,
    step := SubLoop::[step]^] \as Termination;
  \definition terminates: \forall (b, a: N.Nat^) -> \Acc[SubState^, N.Nat^](SubLoop::[step]^, SubState^::running a b) :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> \Acc[SubState^, N.Nat^](SubLoop::[step]^, SubState^::running a b) \with {
      | zero : (\induction (a: N.Nat^) \return \Acc[SubState^, N.Nat^](SubLoop::[step]^, SubState^::running a N.Nat^::zero) \with {
        | zero : (Termination.accIntro (SubState^::running N.Nat^::zero N.Nat^::zero) L.True::intro)
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => Termination.accIntro (SubState^::running
        (N.Nat^::succ j) N.Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return \Acc[SubState^, N.Nat^](SubLoop::[step]^, SubState^::running a (N.Nat^::succ k)) \with {
          | zero : (Termination.accIntro (SubState^::running N.Nat^::zero (N.Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) =>
            Termination.accIntro (SubState^::running (N.Nat^::succ j) (N.Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: SubState^) \return
    \Acc[SubState^, N.Nat^](SubLoop::[step]^, s) \with {
      | running: \fun (a, b: N.Nat^) => terminates b a
    },
}

\correspondence Sub: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) =>
    SubLoop::[run] (SubState::running a b),
  \set := \fun (a, b: N.Nat^) =>
    \induction (b: N.Nat^) \return N.Nat^ -> N.Nat^ \with {
    | zero : (\fun (a: N.Nat^) => a)
    | succ : (\fun (k: N.Nat^) => \fun (rec: N.Nat^ -> N.Nat^) => \fun (a: N.Nat^) =>
      \induction (a: N.Nat^) \return N.Nat^ \with {
        | zero : N.Nat^::zero
        | succ : (\fun (j: N.Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: N.Nat^) -> Sub::[program]^ a b = Sub::[set] a b :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Sub::[program]^ a b = Sub::[set] a b \with {
      | zero : (\induction (a: N.Nat^) \return Sub::[program]^ a N.Nat^::zero = Sub::[set] a N.Nat^::zero \with {
        | zero : (\refl(Sub::[set] N.Nat^::zero
        N.Nat^::zero))
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => \refl(Sub::[set]
        (N.Nat^::succ j) N.Nat^::zero))
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return Sub::[program]^ a (N.Nat^::succ k) = Sub::[set] a (N.Nat^::succ k) \with {
          | zero : (\refl(N.Nat^::zero))
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Sub::[program]^, Sub::[set],
    \fun (a: N.Nat^) => \axiom:funext(Sub::[program]^ a, Sub::[set] a,
      \fun (b: N.Nat^) => matches b a)),
}

/* eqb: both operands decrease on every continuing transition. */
\inductive EqbState: \VType := | running: N.Nat -> N.Nat -> EqbState;
\machine EqbLoop {
  \State := EqbState,
  \Output := B.Bool,
  \step := \thunk(\cfun (state: EqbState) => \match state \in EqbState \with { | running a b :
    \match b \in N.Nat \with {
      | zero : \match a \in N.Nat \with { | zero : \return(\finish[EqbState, B.Bool](B.Bool::true)) | succ k :
        \return(\finish[EqbState, B.Bool](B.Bool::false)) }
      | succ k : \match a \in N.Nat \with {
        | zero : \return(\finish[EqbState, B.Bool](B.Bool::false))
        | succ j : \return(\continue[EqbState, B.Bool](EqbState::running j k))
      }
    }
  }),

  \import RunTermination[State := EqbState^, Output := B.Bool^,
    step := EqbLoop::[step]^] \as Termination;
  \definition terminates: \forall (b, a: N.Nat^) -> \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a b) :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a b) \with {
      | zero : (\induction (a: N.Nat^) \return \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a N.Nat^::zero) \with {
        | zero : (Termination.accIntro (EqbState^::running N.Nat^::zero N.Nat^::zero) L.True::intro)
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => Termination.accIntro (EqbState^::running
        (N.Nat^::succ j) N.Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, EqbState^::running a (N.Nat^::succ k)) \with {
          | zero : (Termination.accIntro (EqbState^::running N.Nat^::zero (N.Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) =>
            Termination.accIntro (EqbState^::running (N.Nat^::succ j) (N.Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: EqbState^) \return
    \Acc[EqbState^, B.Bool^](EqbLoop::[step]^, s) \with {
      | running: \fun (a, b: N.Nat^) => terminates b a
    },
}

\correspondence Eqb: N.Nat -> N.Nat -> B.Bool {
  \program := \fun (a, b: N.Nat) =>
    EqbLoop::[run] (EqbState::running a b),
  \set := \fun (a, b: N.Nat^) =>
    \induction (b: N.Nat^) \return N.Nat^ -> B.Bool^ \with {
    | zero : (\fun (a: N.Nat^) => IsZero::[set] a)
    | succ : (\fun (k: N.Nat^) => \fun (rec: N.Nat^ -> B.Bool^) => \fun (a: N.Nat^) =>
      \induction (a: N.Nat^) \return B.Bool^ \with {
        | zero : B.Bool^::false
        | succ : (\fun (j: N.Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: N.Nat^) -> Eqb::[program]^ a b = Eqb::[set] a b :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Eqb::[program]^ a b = Eqb::[set] a b \with {
      | zero : (\induction (a: N.Nat^) \return Eqb::[program]^ a N.Nat^::zero = Eqb::[set] a N.Nat^::zero \with {
        | zero : (\refl(Eqb::[set] N.Nat^::zero
        N.Nat^::zero))
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => \refl(Eqb::[set]
        (N.Nat^::succ j) N.Nat^::zero))
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return Eqb::[program]^ a (N.Nat^::succ k) = Eqb::[set] a (N.Nat^::succ k) \with {
          | zero : (\refl(B.Bool^::false))
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Eqb::[program]^, Eqb::[set],
    \fun (a: N.Nat^) => \axiom:funext(Eqb::[program]^ a, Eqb::[set] a,
      \fun (b: N.Nat^) => matches b a)),
}

/* leb: both operands decrease on every continuing transition. */
\inductive LebState: \VType := | running: N.Nat -> N.Nat -> LebState;
\machine LebLoop {
  \State := LebState,
  \Output := B.Bool,
  \step := \thunk(\cfun (state: LebState) => \match state \in LebState \with { | running a b :
    \match b \in N.Nat \with {
      | zero : \match a \in N.Nat \with { | zero : \return(\finish[LebState, B.Bool](B.Bool::true)) | succ k :
        \return(\finish[LebState, B.Bool](B.Bool::false)) }
      | succ k : \match a \in N.Nat \with {
        | zero : \return(\finish[LebState, B.Bool](B.Bool::true))
        | succ j : \return(\continue[LebState, B.Bool](LebState::running j k))
      }
    }
  }),

  \import RunTermination[State := LebState^, Output := B.Bool^,
    step := LebLoop::[step]^] \as Termination;
  \definition terminates: \forall (b, a: N.Nat^) -> \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a b) :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a b) \with {
      | zero : (\induction (a: N.Nat^) \return \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a N.Nat^::zero) \with {
        | zero : (Termination.accIntro (LebState^::running N.Nat^::zero N.Nat^::zero) L.True::intro)
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => Termination.accIntro (LebState^::running
        (N.Nat^::succ j) N.Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return \Acc[LebState^, B.Bool^](LebLoop::[step]^, LebState^::running a (N.Nat^::succ k)) \with {
          | zero : (Termination.accIntro (LebState^::running N.Nat^::zero (N.Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) =>
            Termination.accIntro (LebState^::running (N.Nat^::succ j) (N.Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: LebState^) \return
    \Acc[LebState^, B.Bool^](LebLoop::[step]^, s) \with {
      | running: \fun (a, b: N.Nat^) => terminates b a
    },
}

\correspondence Leb: N.Nat -> N.Nat -> B.Bool {
  \program := \fun (a, b: N.Nat) =>
    LebLoop::[run] (LebState::running a b),
  \set := \fun (a, b: N.Nat^) =>
    \induction (b: N.Nat^) \return N.Nat^ -> B.Bool^ \with {
    | zero : (\fun (a: N.Nat^) => IsZero::[set] a)
    | succ : (\fun (k: N.Nat^) => \fun (rec: N.Nat^ -> B.Bool^) => \fun (a: N.Nat^) =>
      \induction (a: N.Nat^) \return B.Bool^ \with {
        | zero : B.Bool^::true
        | succ : (\fun (j: N.Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: N.Nat^) -> Leb::[program]^ a b = Leb::[set] a b :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Leb::[program]^ a b = Leb::[set] a b \with {
      | zero : (\induction (a: N.Nat^) \return Leb::[program]^ a N.Nat^::zero = Leb::[set] a N.Nat^::zero \with {
        | zero : (\refl(Leb::[set] N.Nat^::zero
        N.Nat^::zero))
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => \refl(Leb::[set]
        (N.Nat^::succ j) N.Nat^::zero))
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return Leb::[program]^ a (N.Nat^::succ k) = Leb::[set] a (N.Nat^::succ k) \with {
          | zero : (\refl(B.Bool^::true))
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Leb::[program]^, Leb::[set],
    \fun (a: N.Nat^) => \axiom:funext(Leb::[program]^ a, Leb::[set] a,
      \fun (b: N.Nat^) => matches b a)),
}

/* ltb: both operands decrease on every continuing transition. */
\inductive LtbState: \VType := | running: N.Nat -> N.Nat -> LtbState;
\machine LtbLoop {
  \State := LtbState,
  \Output := B.Bool,
  \step := \thunk(\cfun (state: LtbState) => \match state \in LtbState \with { | running a b :
    \match b \in N.Nat \with {
      | zero : \return(\finish[LtbState, B.Bool](B.Bool::false))
      | succ k : \match a \in N.Nat \with {
        | zero : \return(\finish[LtbState, B.Bool](B.Bool::true))
        | succ j : \return(\continue[LtbState, B.Bool](LtbState::running j k))
      }
    }
  }),

  \import RunTermination[State := LtbState^, Output := B.Bool^,
    step := LtbLoop::[step]^] \as Termination;
  \definition terminates: \forall (b, a: N.Nat^) -> \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a b) :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a b) \with {
      | zero : (\induction (a: N.Nat^) \return \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a N.Nat^::zero) \with {
        | zero : (Termination.accIntro (LtbState^::running N.Nat^::zero N.Nat^::zero) L.True::intro)
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => Termination.accIntro (LtbState^::running
        (N.Nat^::succ j) N.Nat^::zero) L.True::intro)
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, LtbState^::running a (N.Nat^::succ k)) \with {
          | zero : (Termination.accIntro (LtbState^::running N.Nat^::zero (N.Nat^::succ k)) L.True::intro)
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) =>
            Termination.accIntro (LtbState^::running (N.Nat^::succ j) (N.Nat^::succ k)) (ih j))
        })
    };
  \terminates := \induction (s: LtbState^) \return
    \Acc[LtbState^, B.Bool^](LtbLoop::[step]^, s) \with {
      | running: \fun (a, b: N.Nat^) => terminates b a
    },
}

\correspondence Ltb: N.Nat -> N.Nat -> B.Bool {
  \program := \fun (a, b: N.Nat) =>
    LtbLoop::[run] (LtbState::running a b),
  \set := \fun (a, b: N.Nat^) =>
    \induction (b: N.Nat^) \return N.Nat^ -> B.Bool^ \with {
    | zero : (\fun (a: N.Nat^) => B.Bool^::false)
    | succ : (\fun (k: N.Nat^) => \fun (rec: N.Nat^ -> B.Bool^) => \fun (a: N.Nat^) =>
      \induction (a: N.Nat^) \return B.Bool^ \with {
        | zero : B.Bool^::true
        | succ : (\fun (j: N.Nat^) => \fun (_: _) => rec j)
      } a)
  } b a,

  \definition matches: \forall (b, a: N.Nat^) -> Ltb::[program]^ a b = Ltb::[set] a b :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Ltb::[program]^ a b = Ltb::[set] a b \with {
      | zero : (\induction (a: N.Nat^) \return Ltb::[program]^ a N.Nat^::zero = Ltb::[set] a N.Nat^::zero \with {
        | zero : (\refl(Ltb::[set] N.Nat^::zero
        N.Nat^::zero))
        | succ : (\fun (j: N.Nat^) => \fun (unused: _) => \refl(Ltb::[set]
        (N.Nat^::succ j) N.Nat^::zero))
      })
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \induction (a: N.Nat^) \return Ltb::[program]^ a (N.Nat^::succ k) = Ltb::[set] a (N.Nat^::succ k) \with {
          | zero : (\refl(B.Bool^::true))
          | succ : (\fun (j: N.Nat^) => \fun (unused: _) => ih j)
        })
    };
  \coherence := \axiom:funext(Ltb::[program]^, Ltb::[set],
    \fun (a: N.Nat^) => \axiom:funext(Ltb::[program]^ a, Ltb::[set] a,
      \fun (b: N.Nat^) => matches b a)),
}

/* A total iterator, shared by multiplication, powers and other finite loops. */
\inductive IterState: \VType :=
| running: \U(N.Nat -> N.Nat) -> N.Nat -> N.Nat -> IterState
;
\machine IterLoop {
  \State := IterState,
  \Output := N.Nat,
  \step := \thunk(\cfun (state: IterState) => \match state \in IterState \with {
    | running f value count : \match count \in N.Nat \with {
      | zero : \return(\finish[IterState, N.Nat](value))
      | succ k : \program {
        \bind next: N.Nat <- (\force f) value \then
        \return \continue[IterState, N.Nat](IterState::running f next k)
      }
    }
  }),

  \import RunTermination[State := IterState^, Output := N.Nat^,
    step := IterLoop::[step]^] \as Termination;
  \definition terminates: \forall (count: N.Nat^) (f: N.Nat^ -> N.Nat^) (value: N.Nat^) ->
    \Acc[IterState^, N.Nat^](IterLoop::[step]^, IterState^::running f value count) :=
    \induction (count: N.Nat^) \return \forall (f: N.Nat^ -> N.Nat^) (value: N.Nat^) ->
      \Acc[IterState^, N.Nat^](IterLoop::[step]^, IterState^::running f value count) \with {
      | zero: \fun (f: N.Nat^ -> N.Nat^) (value: N.Nat^) =>
        Termination.accIntro (IterState^::running f value N.Nat^::zero) L.True::intro
      | succ: \fun (k: N.Nat^) (ih: _) (f: N.Nat^ -> N.Nat^) (value: N.Nat^) =>
        Termination.accIntro (IterState^::running f value (N.Nat^::succ k)) (ih f (f value))
    };
  \terminates := \induction (s: IterState^) \return
    \Acc[IterState^, N.Nat^](IterLoop::[step]^, s) \with {
      | running: \fun (f: N.Nat^ -> N.Nat^) (value, count: N.Nat^) => terminates count f value
    },
}

\import FiniteIteration[A := N.Nat^] \as NatIteration;

\correspondence Iter: \U(N.Nat -> N.Nat) -> N.Nat -> N.Nat -> N.Nat {
  \program := \fun (f: \U(N.Nat -> N.Nat)) =>
    \fun (value, count: N.Nat) =>
      IterLoop::[run] (IterState::running f value count),
  \set := NatIteration.specification #apply,

  \definition matches (f: N.Nat^ -> N.Nat^): \forall (count, value: N.Nat^) ->
    Iter::[program]^ f value count = Iter::[set] f value count :=
    \induction (count: N.Nat^) \return \forall (value: N.Nat^) -> Iter::[program]^ f value count = Iter::[set] f value count \with {
      | zero : (\fun (value: N.Nat^) => \refl(value))
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \fun (value: N.Nat^) =>
          \idelim Iter::[set] f (f value) k = f (Iter::[set] f value k)
            \with x: N.Nat^ => Iter::[program]^ f value (N.Nat^::succ k) = x
          \by { base: ih (f value), equality: (NatIteration.specification #advance) f k value })
    };
  \coherence := \axiom:funext(Iter::[program]^, Iter::[set],
    \fun (f: N.Nat^ -> N.Nat^) => \axiom:funext(Iter::[program]^ f, Iter::[set] f,
      \fun (value: N.Nat^) => \axiom:funext(Iter::[program]^ f value, Iter::[set] f value,
        \fun (count: N.Nat^) => matches f count value))),
}

\correspondence Mul: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) =>
    IterLoop::[run] (IterState::running
      \thunk(\cfun (current: N.Nat) => AddLoop::[run] (AddState::running a current))
      N.Nat::zero b),
  \set := \fun (a, b: N.Nat^) =>
    Iter::[set] (Add::[set] a) N.Nat^::zero b,
  \math-macro nat_mul($x, "*", $y) := Mul::[program]^ $x $y;

  \definition matches (a, b: N.Nat^): \(a "*" b\) = Mul::[set] a b :=
    trans!{N.Nat^} _ _ _
      (congr!{Iter::[Type]^ _} (\fun (f: _) => f (Add::[program]^ a) N.Nat^::zero b) _ _ Iter::[coherence])
      (congr!{Add::[Type]^ N.Nat^}
      (\fun (operation: _) => Iter::[set] (operation a) N.Nat^::zero b) _ _ Add::[coherence]);
  \coherence := \axiom:funext(Mul::[program]^, Mul::[set],
    \fun (a: N.Nat^) => \axiom:funext(Mul::[program]^ a, Mul::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

\math-macro nat_mul($x, "*", $y) := Mul::[set] $x $y;

\correspondence Pow: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) =>
    IterLoop::[run] (IterState::running
      \thunk(\cfun (current: N.Nat) => IterLoop::[run] (IterState::running
          \thunk(\cfun (next: N.Nat) => AddLoop::[run] (AddState::running a next))
          N.Nat::zero current))
      one b),
  \set := \fun (a, b: N.Nat^) =>
    Iter::[set] (Mul::[set] a) (N.Nat^::succ N.Nat^::zero) b,

  \definition matches (a, b: N.Nat^): Pow::[program]^ a b = Pow::[set] a b :=
    trans!{N.Nat^} _ _ _
      (congr!{Iter::[Type]^ _} (\fun (f: _) => f (Mul::[program]^ a) (N.Nat^::succ N.Nat^::zero) b) _ _ Iter::[coherence])
      (congr!{Mul::[Type]^ N.Nat^}
      (\fun (operation: _) => Iter::[set] (operation a) (N.Nat^::succ N.Nat^::zero) b) _ _ Mul::[coherence]);
  \coherence := \axiom:funext(Pow::[program]^, Pow::[set],
    \fun (a: N.Nat^) => \axiom:funext(Pow::[program]^ a, Pow::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

/* Selection is reflected once, then shared by min and max. */
\correspondence Choose: B.Bool -> N.Nat -> N.Nat -> N.Nat {
  \program := \fun (test: B.Bool) =>
    \fun (yes, no: N.Nat) =>
      \match test \in B.Bool \with { | false : \return no | true : \return yes },
  \set := \fun (test: B.Bool^) (yes, no: N.Nat^) =>
    B.ite N.Nat^ test yes no,

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: N.Nat^) -> Choose::[program]^ test yes no = Choose::[set] test yes
    no :=
    \induction (test: B.Bool^) \return \forall (yes, no: N.Nat^) -> Choose::[program]^ test yes no = Choose::[set] test yes no \with {
      | false : (\fun (yes, no: N.Nat^) => \refl(no))
      | true : (\fun (yes, no: N.Nat^) => \refl(yes))
    };
  \coherence := \axiom:funext(Choose::[program]^, Choose::[set],
    \fun (test: B.Bool^) => \axiom:funext(Choose::[program]^ test, Choose::[set] test,
      \fun (yes: N.Nat^) => \axiom:funext(Choose::[program]^ test yes, Choose::[set] test yes,
        \fun (no: N.Nat^) => matches test yes no))),
}

\correspondence Min: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) => \program {
    \bind test: B.Bool <- LtbLoop::[run] (LtbState::running a b) \then
    \bind selected: N.Nat <- \match test \in B.Bool \with { | false : \return b | true : \return a } \then
    \return selected
  },
  \set := \fun (a, b: N.Nat^) =>
    Choose::[set] (Ltb::[set] a b) a b,

  \definition matches: \forall (a, b: N.Nat^) -> Min::[program]^ a b = Min::[set] a b :=
    \block {
      \fix (a, b: N.Nat^) \then
      \let testMatches: Ltb::[program]^ a b = Ltb::[set] a b := (congr!{Ltb::[Type]^ _} (\fun (f: _) => f a b) _ _ Ltb::[coherence]) \then
      \return
      \idelim Ltb::[program]^ a b = Ltb::[set] a b
        \with test: B.Bool^ => Min::[program]^ a b = Choose::[set] test a b
      \by { base: (congr!{Choose::[Type]^ _} (\fun (f: _) => f (Ltb::[program]^ a b) a b) _ _ Choose::[coherence]), equality: testMatches }
    };
  \coherence := \axiom:funext(Min::[program]^, Min::[set],
    \fun (a: N.Nat^) => \axiom:funext(Min::[program]^ a, Min::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

\correspondence Max: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) => \program {
    \bind test: B.Bool <- LtbLoop::[run] (LtbState::running a b) \then
    \bind selected: N.Nat <- \match test \in B.Bool \with { | false : \return a | true : \return b } \then
    \return selected
  },
  \set := \fun (a, b: N.Nat^) =>
    Choose::[set] (Ltb::[set] a b) b a,

  \definition matches: \forall (a, b: N.Nat^) -> Max::[program]^ a b = Max::[set] a b :=
    \block {
      \fix (a, b: N.Nat^) \then
      \let testMatches: Ltb::[program]^ a b = Ltb::[set] a b := (congr!{Ltb::[Type]^ _} (\fun (f: _) => f a b) _ _ Ltb::[coherence]) \then
      \return
      \idelim Ltb::[program]^ a b = Ltb::[set] a b
        \with test: B.Bool^ => Max::[program]^ a b = Choose::[set] test b a
      \by { base: (congr!{Choose::[Type]^ _} (\fun (f: _) => f (Ltb::[program]^ a b) b a) _ _ Choose::[coherence]), equality: testMatches }
    };
  \coherence := \axiom:funext(Max::[program]^, Max::[set],
    \fun (a: N.Nat^) => \axiom:funext(Max::[program]^ a, Max::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

/* Pairs are Program data so that quotient/remainder and Euclidean states can
 * cross the reflection boundary together. */
\definition NatPair: \Set := P.Times^[N.Nat^, N.Nat^];
\definition natPair: N.Nat^ -> N.Nat^ -> NatPair := P.pair N.Nat^ N.Nat^;
\definition natPairFirst: NatPair -> N.Nat^ := P.first N.Nat^ N.Nat^;
\definition natPairSecond: NatPair -> N.Nat^ := P.second N.Nat^ N.Nat^;
\definition natPairElim (Q: NatPair -> \Prop):
  (\forall (a, b: N.Nat^) -> Q (natPair a b)) -> \forall (p: NatPair) -> Q p :=
  \fun (pairCase: \forall (a, b: N.Nat^) -> Q (natPair a b)) =>
    \induction (p: P.Times^[N.Nat^, N.Nat^]) \return Q p \with {
      | pair : pairCase
    };

/* A pair-valued finite iterator. Its count, not the payload, proves totality. */
\inductive PairIterState: \VType :=
| running: \U(P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat]) -> P.Times[N.Nat, N.Nat] -> N.Nat -> PairIterState
;
\machine PairIterLoop {
  \State := PairIterState,
  \Output := P.Times[N.Nat, N.Nat],
  \step := \thunk(\cfun (state: PairIterState) => \match state \in PairIterState \with {
    | running f value count : \match count \in N.Nat \with {
      | zero : \return(\finish[PairIterState, P.Times[N.Nat, N.Nat]](value))
      | succ k : \program {
        \bind next: P.Times[N.Nat, N.Nat] <- (\force f) value \then
        \return \continue[PairIterState, P.Times[N.Nat, N.Nat]](PairIterState::running f next k)
      }
    }
  }),

  \import RunTermination[State := PairIterState^, Output := NatPair,
    step := PairIterLoop::[step]^] \as Termination;
  \definition terminates: \forall (count: N.Nat^) (f: NatPair -> NatPair) (value: NatPair) ->
    \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, PairIterState^::running f value count) :=
    \induction (count: N.Nat^) \return \forall (f: NatPair -> NatPair) (value: NatPair) ->
      \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, PairIterState^::running f value count) \with {
      | zero: \fun (f: NatPair -> NatPair) (value: NatPair) =>
        Termination.accIntro (PairIterState^::running f value N.Nat^::zero) L.True::intro
      | succ: \fun (k: N.Nat^) (ih: _) (f: NatPair -> NatPair) (value: NatPair) =>
        Termination.accIntro (PairIterState^::running f value (N.Nat^::succ k)) (ih f (f value))
    };
  \terminates := \induction (s: PairIterState^) \return
    \Acc[PairIterState^, NatPair](PairIterLoop::[step]^, s) \with {
      | running: \fun (f: NatPair -> NatPair) (value: NatPair) (count: N.Nat^) => terminates count f value
    },
}

\import FiniteIteration[A := NatPair] \as PairIteration;

\correspondence PairIter: \U(P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat]) -> P.Times[N.Nat, N.Nat] -> N.Nat -> P.Times[N.Nat, N.Nat] {
  \program := \fun (f: \U(P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat])) =>
    \fun (value: P.Times[N.Nat, N.Nat]) =>
      \fun (count: N.Nat) =>
        PairIterLoop::[run] (PairIterState::running f value count),
  \set := PairIteration.specification #apply,

  \definition matches (f: NatPair -> NatPair): \forall (count: N.Nat^) -> \forall (value: NatPair) ->
    PairIter::[program]^ f value count = PairIter::[set] f value count :=
    \induction (count: N.Nat^) \return \forall (value: NatPair) -> PairIter::[program]^ f value count = PairIter::[set] f value count \with {
      | zero : (\fun (value: NatPair) => \refl(value))
      | succ : (\fun (k: N.Nat^) => \fun (ih: _) =>
        \fun (value: NatPair) =>
          \idelim PairIter::[set] f (f value) k = f (PairIter::[set] f value k)
            \with x: NatPair => PairIter::[program]^ f value (N.Nat^::succ k) = x
          \by { base: ih (f value), equality: (PairIteration.specification #advance) f k value })
    };
  \coherence := \axiom:funext(PairIter::[program]^, PairIter::[set],
    \fun (f: NatPair -> NatPair) => \axiom:funext(PairIter::[program]^ f, PairIter::[set] f,
      \fun (value: NatPair) => \axiom:funext(PairIter::[program]^ f value, PairIter::[set] f value,
        \fun (count: N.Nat^) => matches f count value))),
}

\correspondence PairChoose: B.Bool -> P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat] {
  \program := \fun (test: B.Bool) =>
    \fun (yes, no: P.Times[N.Nat, N.Nat]) =>
      \match test \in B.Bool \with { | false : \return no | true : \return yes },
  \set := \fun (test: B.Bool^) (yes, no: NatPair) =>
    B.ite NatPair test yes no,

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: NatPair) ->
    PairChoose::[program]^ test yes no = PairChoose::[set] test yes no :=
    \induction (test: B.Bool^) \return \forall (yes, no: NatPair) -> PairChoose::[program]^ test yes no = PairChoose::[set] test yes no \with {
      | false : (\fun (yes, no: NatPair) => \refl(no))
      | true : (\fun (yes, no: NatPair) => \refl(yes))
    };
  \coherence := \axiom:funext(PairChoose::[program]^, PairChoose::[set],
    \fun (test: B.Bool^) => \axiom:funext(PairChoose::[program]^ test, PairChoose::[set] test,
      \fun (yes: NatPair) => \axiom:funext(PairChoose::[program]^ test yes, PairChoose::[set] test yes,
        \fun (no: NatPair) => matches test yes no))),
}

/* Consume one unit of the dividend. At a positive divisor's boundary the
 * remainder wraps to zero and the quotient increases. At divisor zero only
 * the remainder increases: div a 0 = 0, mod a 0 = a. */
\correspondence DivModNext: N.Nat -> P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat] {
  \program := \fun (b: N.Nat) =>
    \fun (p: P.Times[N.Nat, N.Nat]) =>
      \match p \in P.Times \with {
        | pair q r : \match b \in N.Nat \with {
          | zero : \return(P.Times[N.Nat, N.Nat]::pair q (N.Nat::succ r))
          | succ d :
          \program {
            \bind hit: B.Bool <- EqbLoop::[run] (EqbState::running r d) \then
            \bind pick: \U(P.Times[N.Nat, N.Nat] -> (P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat])) <- (PairChoose::[program] hit) \then
            \bind pickYes: \U(P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat]) <- (\force pick) (P.Times[N.Nat, N.Nat]::pair (N.Nat::succ q) N.Nat::zero) \then
            \bind next: P.Times[N.Nat, N.Nat] <- (\force pickYes) (P.Times[N.Nat, N.Nat]::pair q (N.Nat::succ r)) \then
            \return next
          }
        }
      },
  \set := \fun (b: N.Nat^) =>
    \induction (p: P.Times^[N.Nat^, N.Nat^]) \return NatPair \with {
    | pair : (\fun (q, r: N.Nat^) => \induction (b: N.Nat^) \return NatPair \with {
      | zero : (natPair q (N.Nat^::succ r))
      | succ : (\fun (d: N.Nat^) => \fun (_: _) => \match (Eqb::[set] r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => NatPair) \with {
        | false : (natPair q (N.Nat^::succ r))
        | true : (natPair (N.Nat^::succ q) N.Nat^::zero)
      })
    } b)
  },

  \definition matches (b: N.Nat^): \forall (p: NatPair) ->
    DivModNext::[program]^ b p = DivModNext::[set] b p :=
    \induction (p: P.Times^[N.Nat^, N.Nat^]) \return DivModNext::[program]^ b p = DivModNext::[set] b p \with {
      | pair : (\fun (q, r: N.Nat^) => \induction (b: N.Nat^) \return DivModNext::[program]^ b (natPair q r) = DivModNext::[set] b (natPair q r) \with {
        | zero : (\refl(natPair q (N.Nat^::succ r)))
        | succ : (\fun (d: N.Nat^) => \fun (_: _) => (trans!{NatPair} _ _ _
          (congr!{PairChoose::[Type]^ _} (\fun (f: _) => f (Eqb::[program]^ r d) (natPair (N.Nat^::succ q) N.Nat^::zero) (natPair q (N.Nat^::succ r))) _ _ PairChoose::[coherence])
          (congr!{Eqb::[Type]^ NatPair}
            (\fun (equal: _) => PairChoose::[set] (equal r d)
              (natPair (N.Nat^::succ q) N.Nat^::zero) (natPair q (N.Nat^::succ r)))
            _ _ Eqb::[coherence])))
      } b)
    };
  \coherence := \axiom:funext(DivModNext::[program]^, DivModNext::[set],
    \fun (b: N.Nat^) => \axiom:funext(DivModNext::[program]^ b, DivModNext::[set] b,
      \fun (p: NatPair) => matches b p)),
}

\correspondence DivMod: N.Nat -> N.Nat -> P.Times[N.Nat, N.Nat] {
  \program := \fun (a, b: N.Nat) => \program {
    \bind advance: \U(P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat]) <- (DivModNext::[program] b) \then
    \bind result: P.Times[N.Nat, N.Nat] <- PairIterLoop::[run] (PairIterState::running advance (P.Times[N.Nat, N.Nat]::pair N.Nat::zero N.Nat::zero) a) \then
    \return result
  },
  \set := \fun (a, b: N.Nat^) =>
    PairIter::[set] (DivModNext::[set] b) (natPair N.Nat^::zero N.Nat^::zero) a,

  \definition matches: \forall (a, b: N.Nat^) -> DivMod::[program]^ a b = DivMod::[set] a b :=
    \block {
      \fix (a, b: N.Nat^) \then
      \let iterationMatches:
        DivMod::[program]^ a b = PairIter::[set] (DivModNext::[program]^ b) (natPair N.Nat^::zero N.Nat^::zero) a :=
        (congr!{PairIter::[Type]^ _} (\fun (f: _) => f (DivModNext::[program]^ b) (natPair N.Nat^::zero N.Nat^::zero) a) _ _ PairIter::[coherence]) \then
      \let stepMatches:
        PairIter::[set] (DivModNext::[program]^ b) (natPair N.Nat^::zero N.Nat^::zero) a = DivMod::[set] a b :=
        congr!{DivModNext::[Type]^ NatPair}
          (\fun (next: _) => PairIter::[set] (next b) (natPair N.Nat^::zero N.Nat^::zero) a)
          _ _ DivModNext::[coherence] \then
      \return trans!{NatPair} _ _ _ iterationMatches stepMatches
    };
  \coherence := \axiom:funext(DivMod::[program]^, DivMod::[set],
    \fun (a: N.Nat^) => \axiom:funext(DivMod::[program]^ a, DivMod::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

\correspondence Div: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) => \program {
    \bind partial: \U(N.Nat -> P.Times[N.Nat, N.Nat]) <- (DivMod::[program] a) \then
    \bind result: P.Times[N.Nat, N.Nat] <- (\force partial) b \then
    \bind quotient: N.Nat <- (P.Times[N.Nat, N.Nat]::first result) \then
    \return quotient
  },
  \set := \fun (a, b: N.Nat^) =>
    P.Times[N.Nat, N.Nat]::first^ (DivMod::[set] a b),

  \definition matches (a, b: N.Nat^): Div::[program]^ a b = Div::[set] a b := congr!{NatPair N.Nat^} P.Times[N.Nat, N.Nat]::first^ _ _ ((congr!{DivMod::[Type]^ _} (\fun (f: _) => f a b) _ _ DivMod::[coherence]));
  \coherence := \axiom:funext(Div::[program]^, Div::[set],
    \fun (a: N.Nat^) => \axiom:funext(Div::[program]^ a, Div::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

\correspondence Mod: N.Nat -> N.Nat -> N.Nat {
  \program := \fun (a, b: N.Nat) => \program {
    \bind partial: \U(N.Nat -> P.Times[N.Nat, N.Nat]) <- (DivMod::[program] a) \then
    \bind result: P.Times[N.Nat, N.Nat] <- (\force partial) b \then
    \bind remainder: N.Nat <- (P.Times[N.Nat, N.Nat]::second result) \then
    \return remainder
  },
  \set := \fun (a, b: N.Nat^) =>
    P.Times[N.Nat, N.Nat]::second^ (DivMod::[set] a b),

  \definition matches (a, b: N.Nat^): Mod::[program]^ a b = Mod::[set] a b := congr!{NatPair N.Nat^} P.Times[N.Nat, N.Nat]::second^ _ _ ((congr!{DivMod::[Type]^ _} (\fun (f: _) => f a b) _ _ DivMod::[coherence]));
  \coherence := \axiom:funext(Mod::[program]^, Mod::[set],
    \fun (a: N.Nat^) => \axiom:funext(Mod::[program]^ a, Mod::[set] a,
      \fun (b: N.Nat^) => matches a b)),
}

/* Euclid's transition is stationary at (a,0). Starting at (a,b), b steps
 * suffice because each nonzero second component strictly decreases. */
\correspondence GcdNext: \U(P.Times[N.Nat, N.Nat] -> P.Times[N.Nat, N.Nat]) {
  \program := \thunk(\cfun (p: P.Times[N.Nat, N.Nat]) => \match p \in P.Times \with {
    | pair a b : \match b \in N.Nat \with {
      | zero : \return(P.Times[N.Nat, N.Nat]::pair a N.Nat::zero)
      | succ d : \program {
        \bind partial: \U(N.Nat -> N.Nat) <- (Mod::[program] a) \then
        \bind r: N.Nat <- (\force partial) (N.Nat::succ d) \then
        \return P.Times[N.Nat, N.Nat]::pair (N.Nat::succ d) r
      }
    }
  }),
  \set := \induction (p: P.Times^[N.Nat^, N.Nat^]) \return NatPair \with {
    | pair : (\fun (a, b: N.Nat^) => \induction (b: N.Nat^) \return NatPair \with {
      | zero : (natPair a N.Nat^::zero)
      | succ : (\fun (d: N.Nat^) => \fun (_: _) => natPair (N.Nat^::succ d) (Mod::[set] a (N.Nat^::succ d)))
    } b)
  },

  \definition matches: \forall (p: NatPair) -> GcdNext::[program]^ p = GcdNext::[set] p :=
    \induction (p: P.Times^[N.Nat^, N.Nat^]) \return GcdNext::[program]^ p = GcdNext::[set] p \with {
      | pair : (\fun (a, b: N.Nat^) => \induction (b: N.Nat^) \return GcdNext::[program]^ (natPair a b) = GcdNext::[set] (natPair a b) \with {
        | zero : (\refl(natPair a N.Nat^::zero))
        | succ : (\fun (d: N.Nat^) => \fun (_: _) => \idelim Mod::[program]^ a (N.Nat^::succ d) = Mod::[set] a (N.Nat^::succ d)
            \with r: N.Nat^ => natPair (N.Nat^::succ d) (Mod::[program]^ a (N.Nat^::succ d)) = natPair (N.Nat^::succ d) r
            \by { base: \refl(natPair (N.Nat^::succ d) (Mod::[program]^ a (N.Nat^::succ d))), equality: (congr!{Mod::[Type]^ _} (\fun (f: _) => f a (N.Nat^::succ d)) _ _ Mod::[coherence]) })
      } b)
    };
  \coherence := \axiom:funext(GcdNext::[program]^, GcdNext::[set],
    \fun (p: NatPair) => matches p),
}

\definition gcdByIteration (a, b: N.Nat^): N.Nat^ :=
  P.Times[N.Nat, N.Nat]::first^ (PairIter::[set] GcdNext::[set] (natPair a b) b);
