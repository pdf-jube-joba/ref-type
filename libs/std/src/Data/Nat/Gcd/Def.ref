\import std.Data[].Pair[] \as P;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
\import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
\import std.Data[].Nat[].Basic[].Prop[] \as Basic;
\import std.Data[].Nat[].Division[].Prop[] \as D;
\import std.Data[].Nat[].Iteration[].Def[A := NatPairDef.NatPair] \as PairIteration;
\import std.Data[].Nat[].Iteration[].Prop[A := NatPairDef.NatPair] \as PairIterationProp;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;

\definition NatPair: \Set := NatPairDef.NatPair;
\definition pair: Nat^ -> Nat^ -> NatPair := NatPairDef.natPair;
\definition first: NatPair -> Nat^ := P.Times[Nat, Nat]::first^;
\definition second: NatPair -> Nat^ := P.Times[Nat, Nat]::second^;

\definition CommonDivisor (d, a, b: Nat^): \Prop :=
  Logic.And[D.Divides d a, D.Divides d b];

\definition commonDivisorAt (d: Nat^) (p: NatPair): \Prop :=
  CommonDivisor d (first p) (second p);

\record IsGcd[a, b, g: Nat^]: \Prop := {
  dividesLeft: D.Divides g a,
  dividesRight: D.Divides g b,
  greatest: \forall (d: Nat^) -> D.Divides d a -> D.Divides d b -> D.Divides d g,
};

\definition gcdPropertyUnique (a, b, g, h: Nat^)
  (pg: IsGcd[a, b, g]) (ph: IsGcd[a, b, h]): g = h :=
  D.dividesAntisym g h
    ((ph #greatest) g (pg #dividesLeft) (pg #dividesRight))
    ((pg #greatest) h (ph #dividesLeft) (ph #dividesRight));

/* Euclid's transition is stationary at (a,0). */
\correspondence GcdNext: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) {
  \program := \fun (p: P.Times[Nat, Nat]) =>
    \match p \in P.Times \with {
      | pair a b: \match b \in Nat \with {
        | zero: \return P.Times[Nat, Nat]::pair a Nat::zero
        | succ d: \program {
            \bind partial: \U(Nat -> Nat) <- NatDivisionDef.Mod::[program] a \then
            \bind r: Nat <- (\force partial) (Nat::succ d) \then
            \return P.Times[Nat, Nat]::pair (Nat::succ d) r
          }
      }
    },
  \set := \induction (p: P.Times^[Nat^, Nat^]) \return NatPair \with {
    | pair: \fun (a, b: Nat^) =>
      \induction (b: Nat^) \return NatPair \with {
        | zero: pair a Nat^::zero
        | succ: \fun (d: Nat^) (unused: _) =>
          pair (Nat^::succ d) (NatDivisionDef.Mod::[set] a (Nat^::succ d))
      } b
  },

  \definition matches: \forall (p: NatPair) -> GcdNext::[program]^ p = GcdNext::[set] p :=
    \induction (p: P.Times^[Nat^, Nat^]) \return
      GcdNext::[program]^ p = GcdNext::[set] p \with {
      | pair: \fun (a, b: Nat^) =>
        \induction (b: Nat^) \return
          GcdNext::[program]^ (pair a b) = GcdNext::[set] (pair a b) \with {
          | zero: \refl(pair a Nat^::zero)
          | succ: \fun (d: Nat^) (unused: _) =>
            congr!{NatDivisionDef.Mod::[Type]^ NatPair}
              (\fun (mod: _) => pair (Nat^::succ d) (mod a (Nat^::succ d)))
              _ _ NatDivisionDef.Mod::[coherence]
        } b
    };
  \coherence := \axiom:funext(GcdNext::[program]^, GcdNext::[set],
    \fun (p: NatPair) => matches p),
}

\definition gcdIter: NatPair -> Nat^ -> NatPair := NatPairDef.PairIter::[set] GcdNext::[set];
\definition gcdFinal (a, b: Nat^): NatPair := gcdIter (pair a b) b;
\definition gcdByIteration (a, b: Nat^): Nat^ := first (gcdFinal a b);

/* Starting at (a,b), b steps suffice because each nonzero remainder decreases. */
\definition gcdIterZero: \forall (n, a: Nat^) ->
  gcdIter (pair a Nat^::zero) n = pair a Nat^::zero :=
  \induction (n: Nat^) \return \forall (a: Nat^) ->
    gcdIter (pair a Nat^::zero) n = pair a Nat^::zero \with {
    | zero: \fun (a: Nat^) => \refl(pair a Nat^::zero)
    | succ: \fun (n: Nat^) (ih: _) (a: Nat^) =>
      congr!{NatPair NatPair} GcdNext::[set] _ _ (ih a)
  };

\definition gcdIterSettles: \forall (n, a, b: Nat^) -> Basic.Le b n ->
  second (gcdIter (pair a b) n) = Nat^::zero :=
  \induction (n: Nat^) \return \forall (a, b: Nat^) -> Basic.Le b n ->
    second (gcdIter (pair a b) n) = Nat^::zero \with {
    | zero: \fun (a, b: Nat^) (h: _) => Basic.leZeroEq b h
    | succ: \fun (n: Nat^) (ih: _) (a: Nat^) =>
      \induction (b: Nat^) \return Basic.Le b (Nat^::succ n) ->
        second (gcdIter (pair a b) (Nat^::succ n)) = Nat^::zero \with {
        | zero: \fun (h: _) =>
          congr!{NatPair Nat^} second _ _ (gcdIterZero (Nat^::succ n) a)
        | succ: \fun (d: Nat^) (unused: _) (h: _) =>
          \idelim gcdIter (GcdNext::[set] (pair a (Nat^::succ d))) n =
              GcdNext::[set] (gcdIter (pair a (Nat^::succ d)) n)
            \with p: NatPair => second p = Nat^::zero
            \by {
              base: ih (Nat^::succ d) (NatDivisionDef.Mod::[set] a (Nat^::succ d))
                (Basic.leTrans (NatDivisionDef.Mod::[set] a (Nat^::succ d)) d n (D.modBound a d) h),
              equality: (PairIteration.specification #advance) GcdNext::[set] n (pair a (Nat^::succ d))
            }
      }
  };

\definition gcdFinalSecond (a, b: Nat^): second (gcdFinal a b) = Nat^::zero :=
  gcdIterSettles b a b (Basic.leRefl b);

\definition gcdNextPreserves (d: Nat^):
  \forall (p: NatPair) -> commonDivisorAt d p -> commonDivisorAt d (GcdNext::[set] p) :=
  NatPairDef.natPairElim
    (\fun (p: NatPair) => commonDivisorAt d p -> commonDivisorAt d (GcdNext::[set] p))
    (\fun (a, b: Nat^) =>
      \induction (b: Nat^) \return
        CommonDivisor d a b -> commonDivisorAt d (GcdNext::[set] (pair a b)) \with {
        | zero: \fun (h: _) => h
        | succ: \fun (k: Nat^) (unused: _) (h: CommonDivisor d a (Nat^::succ k)) =>
          Logic.And[_, _] {
            left := h #right,
            right := D.dividesMod d a (Nat^::succ k) (h #left) (h #right),
          }
      } b);

\definition gcdNextReflects (d: Nat^):
  \forall (p: NatPair) -> commonDivisorAt d (GcdNext::[set] p) -> commonDivisorAt d p :=
  NatPairDef.natPairElim
    (\fun (p: NatPair) => commonDivisorAt d (GcdNext::[set] p) -> commonDivisorAt d p)
    (\fun (a, b: Nat^) =>
      \induction (b: Nat^) \return
        commonDivisorAt d (GcdNext::[set] (pair a b)) -> CommonDivisor d a b \with {
        | zero: \fun (h: _) => h
        | succ: \fun (k: Nat^) (unused: _) (h: CommonDivisor d (Nat^::succ k) (NatDivisionDef.Mod::[set] a (Nat^::succ k))) =>
          Logic.And[_, _] {
            left := D.dividesOfMod d a (Nat^::succ k) (h #left) (h #right),
            right := h #left,
          }
      } b);

\definition gcdIterReflects (d, n: Nat^) (p: NatPair):
  commonDivisorAt d (gcdIter p n) -> commonDivisorAt d p :=
  PairIterationProp.reflects GcdNext::[set] (commonDivisorAt d) (gcdNextReflects d) n p;

\definition gcdByIterationCommonDivisor: \forall (a, b: Nat^) -> CommonDivisor (gcdByIteration a b) a b :=
  \block {
    \fun (a, b: Nat^) \then
    \let finalSecondDivides: D.Divides (gcdByIteration a b) (second (gcdFinal a b)) :=
      D.dividesTransport (gcdByIteration a b) Nat^::zero (second (gcdFinal a b))
        (sym!{Nat^} _ _ (gcdFinalSecond a b)) (D.dividesZero (gcdByIteration a b)) \then
    \let finalCommonDivisor:
      commonDivisorAt (gcdByIteration a b) (gcdFinal a b) :=
      Logic.And[_, _] {
        left := D.dividesSelf (gcdByIteration a b),
        right := finalSecondDivides,
      } \then
    \return gcdIterReflects (gcdByIteration a b) b (pair a b) finalCommonDivisor
  };
\definition gcdByIterationDividesLeft (a, b: Nat^): D.Divides (gcdByIteration a b) a :=
  (gcdByIterationCommonDivisor a b) #left;

\definition gcdByIterationDividesRight (a, b: Nat^): D.Divides (gcdByIteration a b) b :=
  (gcdByIterationCommonDivisor a b) #right;

\definition gcdByIterationGreatest: \forall (d, a, b: Nat^) -> D.Divides d a -> D.Divides d b -> D.Divides d (gcdByIteration a b) :=
  \block {
    \fun (d, a, b: Nat^) \then
    \fun (ha: D.Divides d a) (hb: D.Divides d b) \then
    \let finalCommonDivisor:
      commonDivisorAt d (gcdFinal a b) :=
      PairIterationProp.preserves GcdNext::[set]
        (commonDivisorAt d)
        (gcdNextPreserves d) b (pair a b)
        (Logic.And[_, _] { left := ha, right := hb }) \then
    \return finalCommonDivisor #left
  };

\definition gcdByIterationProperty (a, b: Nat^): IsGcd[a, b, gcdByIteration a b] :=
  IsGcd[a, b, gcdByIteration a b] {
    dividesLeft := gcdByIterationDividesLeft a b,
    dividesRight := gcdByIterationDividesRight a b,
    greatest := \fun (d: Nat^) => gcdByIterationGreatest d a b,
  };

\definition GcdSet (a, b: Nat^): \Pow Nat^ :=
  { g : Nat^ \where IsGcd[a, b, g] };

\definition GcdCandidate (a, b: Nat^): \Set := \Cast[Nat^] (GcdSet a b);

\definition gcdWitness (a, b: Nat^): GcdCandidate a b :=
  \into[Nat^](gcdByIteration a b, GcdSet a b)
    \by { gcdByIterationProperty a b };

\definition gcdExists (a, b: Nat^): \exists GcdCandidate a b :=
  \exact(gcdWitness a b, GcdCandidate a b);

\definition gcdUnique (a, b: Nat^) (g, h: GcdCandidate a b): g = h :=
  gcdPropertyUnique a b g h
    (\bysub(Nat^, GcdSet a b, g)) (\bysub(Nat^, GcdSet a b, h));

\definition gcd (a, b: Nat^): Nat^ :=
  \choice GcdCandidate a b
    \by { existence: gcdExists a b, uniqueness: gcdUnique a b };

\definition gcdMatchesIteration (a, b: Nat^): gcd a b = gcdByIteration a b :=
  sym!{Nat^} _ _ (\choiceeq gcdWitness a b \of GcdCandidate a b
    \by { existence: gcdExists a b, uniqueness: gcdUnique a b });

\correspondence Gcd: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind result: P.Times[Nat, Nat] <- NatPairDef.PairIterLoop::[run]
      (NatPairDef.PairIterState::running GcdNext::[program] (P.Times[Nat, Nat]::pair a b) b) \then
    \bind divisor: Nat <- (P.Times[Nat, Nat]::first result) \then
    \return divisor
  },
  \set := gcd,

  \definition matches: \forall (a, b: Nat^) -> Gcd::[program]^ a b = Gcd::[set] a b :=
    \block {
      \fun (a, b: Nat^) \then
      \let iterationMatches:
        NatPairDef.PairIter::[program]^ GcdNext::[program]^ (pair a b) b =
          NatPairDef.PairIter::[set] GcdNext::[program]^ (pair a b) b :=
        congr!{NatPairDef.PairIter::[Type]^ _} (\fun (f: _) => f GcdNext::[program]^ (pair a b) b) _ _ NatPairDef.PairIter::[coherence] \then
      \let stepMatches:
        NatPairDef.PairIter::[set] GcdNext::[program]^ (pair a b) b =
          gcdIter (pair a b) b :=
        congr!{GcdNext::[Type]^ NatPair}
          (\fun (next: _) => NatPairDef.PairIter::[set] next (pair a b) b)
          _ _ GcdNext::[coherence] \then
      \let resultMatches:
        NatPairDef.PairIter::[program]^ GcdNext::[program]^ (pair a b) b =
          gcdIter (pair a b) b :=
        trans!{NatPair} _ _ _ iterationMatches stepMatches \then
      \return trans!{Nat^} _ _ _
        (congr!{NatPair Nat^} first _ _ resultMatches)
        (sym!{Nat^} _ _ (gcdMatchesIteration a b))
    };
  \coherence := \axiom:funext(Gcd::[program]^, Gcd::[set],
    \fun (a: Nat^) => \axiom:funext(Gcd::[program]^ a, Gcd::[set] a,
      \fun (b: Nat^) => matches a b)),
}
