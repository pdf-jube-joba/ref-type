\import std.Data[].Nat[].Gcd[].Def[] \as G;
\import \parent.\parent.Division[].Prop[] \as D;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;

\definition gcd: Nat^ -> Nat^ -> Nat^ := G.Gcd.specification;

\definition gcdProperty(a, b: Nat^): G.IsGcd[a, b, gcd a b] :=
  \idelim G.gcdByIteration a b = gcd a b
    \with g: Nat^ => G.IsGcd[a, b, g]
    \by { base: G.gcdByIterationProperty a b, equality: sym!{Nat^} _ _ (G.gcdMatchesIteration a b) };

\definition gcdDividesLeft(a, b: Nat^): D.Divides (gcd a b) a :=
  (gcdProperty a b) #dividesLeft;

\definition gcdDividesRight(a, b: Nat^): D.Divides (gcd a b) b :=
  (gcdProperty a b) #dividesRight;

\definition gcdGreatest(d, a, b: Nat^): D.Divides d a -> D.Divides d b -> D.Divides d (gcd a b) :=
  ((gcdProperty a b) #greatest) d;

\definition gcdOfProperty(a, b, g: Nat^):
  G.IsGcd[a, b, g] ->
  gcd a b = g :=
  G.gcdPropertyUnique a b (gcd a b) g (gcdProperty a b);

\definition gcdZeroRight(a: Nat^): gcd a Nat^::zero = a :=
  gcdOfProperty a Nat^::zero a
    (G.IsGcd[a, Nat^::zero, a] {
      dividesLeft := D.dividesSelf a,
      dividesRight := D.dividesZero a,
      greatest := \fun (d: Nat^) (da: _) (dz: _) => da,
    });

\definition gcdComm(a, b: Nat^): gcd a b = gcd b a :=
  gcdOfProperty a b (gcd b a)
    (G.IsGcd[a, b, gcd b a] {
      dividesLeft := gcdDividesRight b a,
      dividesRight := gcdDividesLeft b a,
      greatest := \fun (d: Nat^) (da: _) (db: _) => gcdGreatest d b a db da,
    });

\definition gcdZeroLeft(b: Nat^): gcd Nat^::zero b = b :=
  trans!{Nat^} _ _ _ (gcdComm Nat^::zero b) (gcdZeroRight b);
