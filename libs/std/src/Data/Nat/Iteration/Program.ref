\import std.Program[] \as Programs;
\import \parent.Def[A := A^] \as Specification;
\definition State: \VType := IterationState[A];
\module LoopImplementation;
\machine Loop: Programs.Machine := Programs.Machine {
  State := State, Output := A, step := LoopImplementation[].step, terminates := LoopImplementation[].certificate,
};
\definition program: \U(\U(A -> A) -> A -> Nat -> A) :=
  \fun (f: \U(A -> A))(value: A)(count: Nat) => (\force Loop.run) (IterationState[A]::running f value count);
\module Correspondence;
\correspondence Iterate: Programs.Correspondence := Programs.Correspondence {
  T := \U(\U(A -> A) -> A -> Nat -> A), program := program,
  specification := Specification.apply, coherence := Correspondence[].coherence,
};
