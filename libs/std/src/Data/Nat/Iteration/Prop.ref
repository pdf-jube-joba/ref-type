\import \parent.Def[A := A] \as Def;

\definition preserves (f: A -> A) (P: A -> \Prop)
  (step: \forall (value: A) -> P value -> P (f value)):
  \forall (count: N.Nat^) (value: A) -> P value -> P (Def.apply f value count) :=
  \induction (count: N.Nat^) \return
    \forall (value: A) -> P value -> P (Def.apply f value count) \with {
    | zero: \fun (value: A) (h: _) => h
    | succ: \fun (count: N.Nat^) (ih: _) (value: A) (h: _) =>
      step (Def.apply f value count) (ih value h)
  };

\definition reflects (f: A -> A) (P: A -> \Prop)
  (step: \forall (value: A) -> P (f value) -> P value):
  \forall (count: N.Nat^) (value: A) -> P (Def.apply f value count) -> P value :=
  \induction (count: N.Nat^) \return
    \forall (value: A) -> P (Def.apply f value count) -> P value \with {
    | zero: \fun (value: A) (h: _) => h
    | succ: \fun (count: N.Nat^) (ih: _) (value: A) (h: _) =>
      ih value (step (Def.apply f value count) h)
  };

