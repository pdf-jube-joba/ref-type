\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;

\structure Iteration[A: \Set]: \Set {
  apply: (A -> A) -> A -> Nat^ -> A,
} \where {
  zero: \forall (f: A -> A) (value: A) -> apply f value Nat^::zero = value,
  succ: \forall (f: A -> A) (value: A) (count: Nat^) ->
    apply f value (Nat^::succ count) = f (apply f value count),
  advance: \forall (f: A -> A) (count: Nat^) (value: A) ->
    apply f (f value) count = f (apply f value count),
}

\module Def(A: \Set);
\module Prop(A: \Set);
