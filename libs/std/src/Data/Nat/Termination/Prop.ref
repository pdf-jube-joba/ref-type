\definition ready: \RunStep[State, Output] -> \Prop :=
  \step-match t: \RunStep[State, Output] \return \Prop \with {
    | \continue s: \Acc[State, Output](step, s)
    | \finish result: L.True
  };

\definition accIntro (s: State) (certificate: ready (step s)):
  \Acc[State, Output](step, s) :=
  \accintro[State, Output](step, s,
    \fun (next: _) (edge: _) =>
      \idelim step s = \continue[State, Output](next)
        \with t: \RunStep[State, Output] => ready t
        \by { base: certificate, equality: edge });
