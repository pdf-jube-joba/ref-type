\definition Earlier: \Prop := \forall (c: N.Nat^) -> Bounds.Lt c a -> \forall (d: N.Nat^) -> Bounded c d;
\definition Smaller: \Prop := \forall (d: N.Nat^) -> Bounds.Lt d b -> Bounded a d;
\definition following: Descending -> Earlier -> Smaller -> \forall (current: State) -> primary current = a -> secondary current = b ->
  \forall (next: State) -> step current = \continue[State, Output](next) -> Holds next :=
  \fun (descending: Descending)(earlier: Earlier)(smaller: Smaller)(current: State)(first: _)(second: _)(next: State)(edge: _) =>
    either!{{Bounds.Lt (primary next) (primary current)} "or" {SamePrimary[next, current]} "either" {Holds next}
      "lt:" {\fun (less: _) => earlier (primary next)
        (\idelim primary current = a \with value: N.Nat^ => Bounds.Lt (primary next) value \by { base: less, equality: first })
        (secondary next) next (\refl(primary next)) (\refl(secondary next))}
      "rt:" {\fun (same: SamePrimary[next, current]) => smaller (secondary next)
        (\idelim secondary current = b \with value: N.Nat^ => Bounds.Lt (secondary next) value \by { base: #secondary{same}, equality: second })
        next (trans!{N.Nat^} (primary next) (primary current) a #primary{same} first) (\refl(secondary next))}}
      (descending current next edge);
\definition ready: Descending -> Earlier -> Smaller -> \forall (current: State) -> primary current = a -> secondary current = b -> \forall (t: \RunStep[State, Output]) -> step current = t -> Ready Holds t :=
  \fun (descending: Descending)(earlier: Earlier)(smaller: Smaller)(current: State)(first: _)(second: _) =>
    \step-match t: \RunStep[State, Output] \return step current = t -> Ready Holds t \with {
      | \continue next: following descending earlier smaller current first second next
      | \finish result: \fun (edge: _) => Termination.trivial
    };
\definition law: Descending -> Earlier -> Smaller -> Bounded a b :=
  \fun (descending: Descending)(earlier: Earlier)(smaller: Smaller)(current: State)(first: _)(second: _) =>
    Termination.intro current (ready descending earlier smaller current first second (step current) (\refl(step current)));
