\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;

\import std.Data[].Bool[] \as B;
\import B.Prop[] \as BoolLaws;

\import std.Data[].Nat[].Basic[].Def[] \as Op;
\use Op.nat_add;
\use Op.nat_mul;

\import \parent.\parent.Basic[].Prop[] \as Basic;

/* Order lemmas used for rational comparisons and common sequence bounds. */
\import std.Logic[].Proposition[] \as Logic;
\use Logic.either;
\import std.Logic[].Order[] \as O;
\import std.Logic[].Classical[] \as Classical;
\definition Trichotomy(a, b: Nat^): \Prop := O.Trichotomy[Nat^, Basic.Lt, a, b];
\definition comparisonSucc(a, b: Nat^):
  Trichotomy a b ->
  Trichotomy (Nat^::succ a) (Nat^::succ b) :=
  \fun (h: Trichotomy a b) =>
    \match h \in O.Trichotomy \return (\fun (_: Trichotomy a b) =>
      Trichotomy (Nat^::succ a) (Nat^::succ b)) \with {
    | less ab : O.Trichotomy[Nat^, Basic.Lt, Nat^::succ a, Nat^::succ b]::less ab
    | equal ab : O.Trichotomy[Nat^, Basic.Lt, Nat^::succ a, Nat^::succ b]::equal (Op.succCong a b ab)
    | greater ba : O.Trichotomy[Nat^, Basic.Lt, Nat^::succ a, Nat^::succ b]::greater ba
    };
\definition trichotomy: \forall (a, b: Nat^) -> Trichotomy a b :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Trichotomy a b \with {
    | zero : (\induction (b: Nat^) \return Trichotomy Nat^::zero b \with {
      | zero : O.Trichotomy[Nat^, Basic.Lt, Nat^::zero, Nat^::zero]::equal (\refl(Nat^::zero))
      | succ : (\fun (b: Nat^) => \fun (_: Trichotomy Nat^::zero b) =>
        O.Trichotomy[Nat^, Basic.Lt, Nat^::zero, Nat^::succ b]::less (\refl(B.Bool^::true)))
      })
    | succ : (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> Trichotomy a b) =>
      \induction (b: Nat^) \return Trichotomy (Nat^::succ a) b \with {
      | zero : O.Trichotomy[Nat^, Basic.Lt, Nat^::succ a, Nat^::zero]::greater (\refl(B.Bool^::true))
      | succ : (\fun (b: Nat^) => \fun (_: Trichotomy (Nat^::succ a) b) => comparisonSucc a b (ih b))
      })
    };

\definition comparable: O.Comparable Nat^ Basic.Lt := trichotomy;

\definition ltZero: \forall (a: Nat^) -> Basic.Lt a Nat^::zero -> Logic.False :=
  \induction (a: Nat^) \return Basic.Lt a Nat^::zero -> Logic.False \with {
    | zero : BoolLaws.falseNeTrue
    | succ : (\fun (a: Nat^) => \fun (_: Basic.Lt a Nat^::zero -> Logic.False) =>
      BoolLaws.falseNeTrue)
    };

\definition zeroLtSucc(a: Nat^): Basic.Lt Nat^::zero (Nat^::succ a) :=
  \refl(B.Bool^::true);

\definition ltOfSuccSucc(a, b: Nat^):
  Basic.Lt (Nat^::succ a) (Nat^::succ b) ->
  Basic.Lt a b := \fun (h: _) =>
    h;

\definition ltStep: \forall (a, b: Nat^) -> Basic.Lt a b -> Basic.Lt a (Nat^::succ b) :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Basic.Lt a b -> Basic.Lt a (Nat^::succ b) \with {
    | zero : (\fun (b: Nat^) => \fun (_: Basic.Lt Nat^::zero b) => zeroLtSucc b)
    | succ : (\fun (a: Nat^) =>
      \fun (ih: \forall (b: Nat^) -> Basic.Lt a b -> Basic.Lt a (Nat^::succ b)) =>
        \induction (b: Nat^) \return Basic.Lt (Nat^::succ a) b -> Basic.Lt (Nat^::succ a) (Nat^::succ b) \with {
      | zero : (\fun (bad: Basic.Lt (Nat^::succ a) Nat^::zero) =>
            Logic.falseElim (Basic.Lt (Nat^::succ a) (Nat^::succ Nat^::zero))
              (ltZero (Nat^::succ a) bad))
      | succ : (\fun (b: Nat^) =>
            \fun (_: Basic.Lt (Nat^::succ a) b -> Basic.Lt (Nat^::succ a) (Nat^::succ b)) =>
              \fun (ab: Basic.Lt (Nat^::succ a) (Nat^::succ b)) =>
                Basic.ltSuccSucc a (Nat^::succ b) (ih b ab))
      })
    };

\definition zeroLtOfLt(b: Nat^):
  \forall (c: Nat^) ->
  Basic.Lt b c -> Basic.Lt Nat^::zero c :=
  \induction (c: Nat^) \return Basic.Lt b c -> Basic.Lt Nat^::zero c \with {
    | zero : (\fun (bad: Basic.Lt b Nat^::zero) =>
      Logic.falseElim (Basic.Lt Nat^::zero Nat^::zero) (ltZero b bad))
    | succ : (\fun (c: Nat^) => \fun (_: Basic.Lt b c -> Basic.Lt Nat^::zero c) =>
      \fun (_: Basic.Lt b (Nat^::succ c)) => zeroLtSucc c)
    };

\definition ltTrans: \forall (a, b, c: Nat^) -> Basic.Lt a b -> Basic.Lt b c -> Basic.Lt a c :=
  \induction (a: Nat^) \return \forall (b, c: Nat^) -> Basic.Lt a b -> Basic.Lt b c -> Basic.Lt a c \with {
    | zero : \fun (b, c: Nat^) (_: Basic.Lt Nat^::zero b) (bc: Basic.Lt b c) =>
        zeroLtOfLt b c bc
    | succ : \block {
        \fun (a: Nat^) \then
        \fun (ih: \forall (b, c: Nat^) -> Basic.Lt a b -> Basic.Lt b c -> Basic.Lt a c) \then
        \return \induction (b: Nat^) \return \forall (c: Nat^) ->
          Basic.Lt (Nat^::succ a) b -> Basic.Lt b c -> Basic.Lt (Nat^::succ a) c \with {
          | zero : \fun (c: Nat^) (bad: Basic.Lt (Nat^::succ a) Nat^::zero)
              (_: Basic.Lt Nat^::zero c) =>
              Logic.falseElim (Basic.Lt (Nat^::succ a) c) (ltZero (Nat^::succ a) bad)
          | succ : \block {
              \fun (b: Nat^) \then
              \fun (_: \forall (c: Nat^) -> Basic.Lt (Nat^::succ a) b ->
                Basic.Lt b c -> Basic.Lt (Nat^::succ a) c) \then
              \return \induction (c: Nat^) \return
                Basic.Lt (Nat^::succ a) (Nat^::succ b) -> Basic.Lt (Nat^::succ b) c ->
                  Basic.Lt (Nat^::succ a) c \with {
                | zero : \fun (_: Basic.Lt (Nat^::succ a) (Nat^::succ b))
                    (bad: Basic.Lt (Nat^::succ b) Nat^::zero) =>
                    Logic.falseElim (Basic.Lt (Nat^::succ a) Nat^::zero)
                      (ltZero (Nat^::succ b) bad)
                | succ : \block {
                    \fun (c: Nat^) \then
                    \fun (_: Basic.Lt (Nat^::succ a) (Nat^::succ b) ->
                      Basic.Lt (Nat^::succ b) c -> Basic.Lt (Nat^::succ a) c) \then
                    \fun (ab: Basic.Lt (Nat^::succ a) (Nat^::succ b)) \then
                    \fun (bc: Basic.Lt (Nat^::succ b) (Nat^::succ c)) \then
                    \return ih b c ab bc
                  }
                }
            }
          }
      }
    };

\definition ltAddRight(a, b: Nat^):
  \forall (c: Nat^) ->
  Basic.Lt a b -> Basic.Lt \(a "+" c\) \(b "+" c\) :=
  \induction (c: Nat^) \return Basic.Lt a b -> Basic.Lt \(a "+" c\) \(b "+" c\) \with {
    | zero : (\fun (ab: Basic.Lt a b) => ab)
    | succ : (\fun (c: Nat^) =>
      \fun (ih: Basic.Lt a b -> Basic.Lt \(a "+" c\) \(b "+" c\)) =>
        \fun (ab: Basic.Lt a b) =>
          \idelim Nat^::succ \(a "+" c\) = \(a "+" { Nat^::succ c }\)
            \with left: Nat^ => Basic.Lt left \(b "+" { Nat^::succ c }\)
            \by { base:
              \idelim Nat^::succ \(b "+" c\) = \(b "+" { Nat^::succ c }\)
                \with right: Nat^ => Basic.Lt (Nat^::succ \(a "+" c\)) right
                \by { base: Basic.ltSuccSucc \(a "+" c\) \(b "+" c\) (ih ab), equality:
                  sym!{Nat^} _ _ (Basic.addSuccRight b c) }, equality:
              sym!{Nat^} _ _ (Basic.addSuccRight a c) })
    };

\definition ltAddLeft(c, a, b: Nat^):
  Basic.Lt a b ->
  Basic.Lt \(c "+" a\) \(c "+" b\) :=
  \fun (ab: Basic.Lt a b) =>
    \idelim \(a "+" c\) = \(c "+" a\)
      \with left: Nat^ => Basic.Lt left \(c "+" b\)
      \by { base:
        \idelim \(b "+" c\) = \(c "+" b\)
          \with right: Nat^ => Basic.Lt \(a "+" c\) right
          \by { base: ltAddRight a b c ab, equality: Basic.addComm b c }, equality:
        Basic.addComm a c };

\definition ltRespects(a, b, c, d: Nat^):
  a = c -> b = d -> Basic.Lt a b ->
  Basic.Lt c d :=
  \fun (ac: a = c) (bd: b = d) (ab: Basic.Lt a b) =>
    \idelim a = c \with left: Nat^ => Basic.Lt left d
      \by { base:
        \idelim b = d \with right: Nat^ => Basic.Lt a right
          \by { base: ab, equality: bd }, equality:
        ac };

\definition ltCancelRight(a, b: Nat^):
  \forall (c: Nat^) ->
  Basic.Lt \(a "+" c\) \(b "+" c\) -> Basic.Lt a b :=
  \induction (c: Nat^) \return Basic.Lt \(a "+" c\) \(b "+" c\) -> Basic.Lt a b \with {
    | zero : (\fun (ab: Basic.Lt a b) => ab)
    | succ : (\fun (c: Nat^) =>
      \fun (ih: Basic.Lt \(a "+" c\) \(b "+" c\) -> Basic.Lt a b) =>
        \fun (ab: Basic.Lt \(a "+" { Nat^::succ c }\)
          \(b "+" { Nat^::succ c }\)) =>
            ih (ltOfSuccSucc \(a "+" c\) \(b "+" c\)
              (ltRespects
                \(a "+" { Nat^::succ c }\) \(b "+" { Nat^::succ c }\)
                (Nat^::succ \(a "+" c\)) (Nat^::succ \(b "+" c\))
                (Basic.addSuccRight a c) (Basic.addSuccRight b c) ab)))
    };

\definition ltCancelLeft(c, a, b: Nat^):
  Basic.Lt \(c "+" a\) \(c "+" b\) ->
  Basic.Lt a b :=
  \fun (ab: _) =>
    ltCancelRight a b c
      (ltRespects \(c "+" a\) \(c "+" b\)
        \(a "+" c\) \(b "+" c\)
        (Basic.addComm c a) (Basic.addComm c b) ab);

\definition addRotate(a, b, c: Nat^): \((a "+" b) "+" c\) = \((a "+" c) "+" b\) :=
  trans!{Nat^} _ _ _ (Basic.addAssoc a b c)
    (trans!{Nat^} _ _ _
      (congr!{Nat^ Nat^} (Op.add a) _ _ (Basic.addComm b c))
      (sym!{Nat^} _ _ (Basic.addAssoc a c b)));

\definition ltAsym(a, b: Nat^):
  Basic.Lt a b -> Basic.Lt b a ->
  Logic.False :=
  \fun (ab: _) (ba: _) =>
    Basic.ltIrrefl a (ltTrans a b a ab ba);
\definition ltNotEq(a, b: Nat^):
  Basic.Lt a b -> a = b ->
  Logic.False :=
  \fun (ab: _) (same: _) =>
    Basic.ltIrrefl a
      (ltRespects a b a a (\refl(a)) (sym!{Nat^} _ _ same) ab);

\definition ltAdd(a, b, c, d: Nat^):
  Basic.Lt a b -> Basic.Lt c d ->
  Basic.Lt \(a "+" c\) \(b "+" d\) :=
  \fun (ab: _) (cd: _) =>
    ltTrans \(a "+" c\) \(b "+" c\) \(b "+" d\)
      (ltAddRight a b c ab) (ltAddLeft b c d cd);

\definition ltMulSuccRight(a, b: Nat^):
  \forall (k: Nat^) ->
  Basic.Lt a b -> Basic.Lt \(a "*" { Nat^::succ k }\) \(b "*" { Nat^::succ k }\) :=
  \induction (k: Nat^) \return Basic.Lt a b ->
    Basic.Lt \(a "*" { Nat^::succ k }\) \(b "*" { Nat^::succ k }\) \with {
    | zero : (\fun (ab: Basic.Lt a b) =>
      ltRespects a b \(a "*" { Nat^::succ Nat^::zero }\)
        \(b "*" { Nat^::succ Nat^::zero }\)
        (sym!{Nat^} _ _ (Basic.mulOneRight a))
        (sym!{Nat^} _ _ (Basic.mulOneRight b)) ab)
    | succ : (\fun (k: Nat^) =>
      \fun (ih: Basic.Lt a b ->
        Basic.Lt \(a "*" { Nat^::succ k }\) \(b "*" { Nat^::succ k }\)) =>
        \fun (ab: Basic.Lt a b) =>
          ltRespects
            \(a "+" (a "*" { Nat^::succ k })\)
            \(b "+" (b "*" { Nat^::succ k })\)
            \(a "*" { Nat^::succ (Nat^::succ k) }\)
            \(b "*" { Nat^::succ (Nat^::succ k) }\)
            (sym!{Nat^} _ _ (Basic.mulSuccRight a (Nat^::succ k)))
            (sym!{Nat^} _ _ (Basic.mulSuccRight b (Nat^::succ k)))
            (ltAdd a b \(a "*" { Nat^::succ k }\)
              \(b "*" { Nat^::succ k }\) ab (ih ab)))
    };

\definition ltCancelMulSuccRight(a, b, k: Nat^):
  Basic.Lt \(a "*" { Nat^::succ k }\)
    \(b "*" { Nat^::succ k }\) ->
  Basic.Lt a b :=
  \fun (scaled: Basic.Lt \(a "*" { Nat^::succ k }\)
    \(b "*" { Nat^::succ k }\)) =>
    \match (trichotomy a b) \in O.Trichotomy
      \return (\fun (_: Trichotomy a b) => Basic.Lt a b) \with {
    | less ab : ab
    | equal ab :
            Logic.falseElim (Basic.Lt a b)
              (ltNotEq \(a "*" { Nat^::succ k }\)
                \(b "*" { Nat^::succ k }\) scaled
                (congr!{Nat^ Nat^} (\fun (n: Nat^) =>
                  \(n "*" { Nat^::succ k }\)) a b ab))
    | greater ba :
            Logic.falseElim (Basic.Lt a b)
              (ltAsym \(a "*" { Nat^::succ k }\)
                \(b "*" { Nat^::succ k }\) scaled
                (ltMulSuccRight b a k ba))
    };

\definition ltSelfSucc: \forall (a: Nat^) -> Basic.Lt a (Nat^::succ a) :=
  \induction (a: Nat^) \return Basic.Lt a (Nat^::succ a) \with {
    | zero : (zeroLtSucc Nat^::zero)
    | succ : (\fun (a: Nat^) => \fun (ih: Basic.Lt a (Nat^::succ a)) => ih)
    };

\definition ltSuccPlus(a: Nat^):
  \forall (c: Nat^) ->
  Basic.Lt a \({ Nat^::succ a } "+" c\) :=
  \induction (c: Nat^) \return Basic.Lt a \({ Nat^::succ a } "+" c\) \with {
    | zero : (ltSelfSucc a)
    | succ : (\fun (c: Nat^) =>
      \fun (ih: Basic.Lt a \({ Nat^::succ a } "+" c\)) =>
        ltRespects a (Nat^::succ \({ Nat^::succ a } "+" c\))
          a \({ Nat^::succ a } "+" { Nat^::succ c }\)
          (\refl(a)) (sym!{Nat^} _ _ (Basic.addSuccRight (Nat^::succ a) c))
          (ltStep a \({ Nat^::succ a } "+" c\) ih))
    };

\definition ltPositiveProduct(a, k: Nat^): Basic.Lt a \({ Nat^::succ k } "*" { Nat^::succ a }\) :=
  ltRespects a
    \({ Nat^::succ a } "+" ({ Nat^::succ a } "*" k)\)
    a \({ Nat^::succ k } "*" { Nat^::succ a }\)
    (\refl(a))
    (trans!{Nat^} _ _ _
      (sym!{Nat^} _ _ (Basic.mulSuccRight (Nat^::succ a) k))
      (Basic.mulComm (Nat^::succ a) (Nat^::succ k)))
    (ltSuccPlus a \({ Nat^::succ a } "*" k\));

\definition commonBound(m, n: Nat^): Nat^ :=
  Op.add m n;

\definition leftLeCommonBound(m, n: Nat^): Basic.Le m (commonBound m n) :=
  Basic.leAddRight m n;

\definition rightLeCommonBound(m, n: Nat^): Basic.Le n (commonBound m n) :=
  Basic.leAddLeft m n;

\definition fourBound(a, b, c, d: Nat^): Nat^ :=
  commonBound (commonBound a b) (commonBound c d);

\definition firstLeFourBound(a, b, c, d: Nat^): Basic.Le a (fourBound a b c d) :=
  Basic.leTrans a (commonBound a b) (fourBound a b c d)
    (leftLeCommonBound a b)
    (leftLeCommonBound (commonBound a b) (commonBound c d));

\definition secondLeFourBound(a, b, c, d: Nat^): Basic.Le b (fourBound a b c d) :=
  Basic.leTrans b (commonBound a b) (fourBound a b c d)
    (rightLeCommonBound a b)
    (leftLeCommonBound (commonBound a b) (commonBound c d));

\definition thirdLeFourBound(a, b, c, d: Nat^): Basic.Le c (fourBound a b c d) :=
  Basic.leTrans c (commonBound c d) (fourBound a b c d)
    (leftLeCommonBound c d)
    (rightLeCommonBound (commonBound a b) (commonBound c d));

\definition fourthLeFourBound(a, b, c, d: Nat^): Basic.Le d (fourBound a b c d) :=
  Basic.leTrans d (commonBound c d) (fourBound a b c d)
    (rightLeCommonBound c d)
    (rightLeCommonBound (commonBound a b) (commonBound c d));

\definition AdjacentBoundary(P: Nat^ -> \Prop): \Prop :=
  \exists { k : Nat^ \where Logic.And[P k, Logic.Not (P (Nat^::succ k))] };

\definition finiteBoundary(P: Nat^ -> \Prop):
  \forall (n: Nat^) -> P Nat^::zero ->
    Logic.Not (P n) -> AdjacentBoundary P :=
  \induction (n: Nat^) \return P Nat^::zero ->
      Logic.Not (P n) -> AdjacentBoundary P \with {
    | zero : (\fun (atZero: P Nat^::zero) =>
      \fun (notAtZero: Logic.Not (P Nat^::zero)) =>
        Logic.falseElim (AdjacentBoundary P) (notAtZero atZero))
    | succ : (\fun (n: Nat^) =>
      \fun (ih: P Nat^::zero ->
        Logic.Not (P n) -> AdjacentBoundary P) =>
      \fun (atZero: P Nat^::zero) =>
        \fun (notAtSucc: Logic.Not (P (Nat^::succ n))) =>
          either!{
            {P n} "or" {Logic.Not (P n)} "either" {AdjacentBoundary P}
            "lt:" {\fun (atN: P n) =>
              \exact(
                \into[Nat^](n, { k : Nat^ \where Logic.And[P k,
                      Logic.Not (P (Nat^::succ k))] }) \by { Logic.And[P n,
                    Logic.Not (P (Nat^::succ n))]::# atN notAtSucc },
                \Cast[Nat^] ({ k : Nat^ \where Logic.And[P k,
                      Logic.Not (P (Nat^::succ k))] }))}
            "rt:" {\fun (notAtN: Logic.Not (P n)) => ih atZero notAtN}
          }
            (Classical.excludedMiddle (P n)))
    };
