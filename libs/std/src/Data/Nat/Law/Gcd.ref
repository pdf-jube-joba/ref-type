\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Operation[].Gcd[] \as G;
\import \parent.Division[] \as D;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;

\definition gcd: N.Nat^ -> N.Nat^ -> N.Nat^ := G.Gcd::[set];

\definition gcdProperty (a, b: N.Nat^): G.IsGcd[a, b, gcd a b] :=
  \idelim G.gcdByIteration a b = gcd a b
    \with g: N.Nat^ => G.IsGcd[a, b, g]
    \by { base: G.gcdByIterationProperty a b, equality: sym!{N.Nat^} _ _ (G.gcdMatchesIteration a b) };

\definition gcdDividesLeft (a, b: N.Nat^): D.Divides (gcd a b) a :=
  (gcdProperty a b) #dividesLeft;

\definition gcdDividesRight (a, b: N.Nat^): D.Divides (gcd a b) b :=
  (gcdProperty a b) #dividesRight;

\definition gcdGreatest (d, a, b: N.Nat^):
  D.Divides d a -> D.Divides d b -> D.Divides d (gcd a b) :=
  ((gcdProperty a b) #greatest) d;

\definition gcdOfProperty (a, b, g: N.Nat^) (h: G.IsGcd[a, b, g]): gcd a b = g :=
  G.gcdPropertyUnique a b (gcd a b) g (gcdProperty a b) h;

\definition gcdZeroRight (a: N.Nat^): gcd a N.Nat^::zero = a :=
  gcdOfProperty a N.Nat^::zero a
    (G.IsGcd[a, N.Nat^::zero, a] {
      dividesLeft := D.dividesSelf a,
      dividesRight := D.dividesZero a,
      greatest := \fun (d: N.Nat^) (da: _) (dz: _) => da,
    });

\definition gcdComm (a, b: N.Nat^): gcd a b = gcd b a :=
  gcdOfProperty a b (gcd b a)
    (G.IsGcd[a, b, gcd b a] {
      dividesLeft := gcdDividesRight b a,
      dividesRight := gcdDividesLeft b a,
      greatest := \fun (d: N.Nat^) (da: _) (db: _) => gcdGreatest d b a db da,
    });

\definition gcdZeroLeft (b: N.Nat^): gcd N.Nat^::zero b = b :=
  trans!{N.Nat^} _ _ _ (gcdComm N.Nat^::zero b) (gcdZeroRight b);
