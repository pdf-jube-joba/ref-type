\import \parent.\parent.Basic[].Program[] \as OpProgram;
\import std.Data[].Nat[].Division[].Program[] \as NatDivisionProgram;
\import std.Data[].Bool[] \as B;

\definition two: Nat := Nat::succ (Nat::succ Nat::zero);

\definition even: \U(Nat -> B.Bool) :=
  \thunk (\fun (n: Nat) => \program {
      \bind partial: \U(Nat -> Nat) <- (\force NatDivisionProgram.mod) n \then
      \bind remainder: Nat <- (\force partial) two \then
      \bind result: B.Bool <- (\force OpProgram.isZero) remainder \then
      \return result
    });

\definition odd: \U(Nat -> B.Bool) :=
  \thunk (\fun (n: Nat) => \program {
      \bind partial: \U(Nat -> Nat) <- (\force NatDivisionProgram.mod) n \then
      \bind remainder: Nat <- (\force partial) two \then
      \bind test: \U(Nat -> B.Bool) <- (\force OpProgram.eqb) remainder \then
      \bind result: B.Bool <- (\force test) OpProgram.one \then
      \return result
    });
