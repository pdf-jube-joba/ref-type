\import \parent.\parent.Basic[].Def[] \as Op;
\import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
\import std.Data[].Bool[] \as B;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;

\definition two: Nat := Nat::succ (Nat::succ Nat::zero);

\correspondence Even: Nat -> B.Bool {
  \program := \fun (n: Nat) => \program {
    \bind partial: \U(Nat -> Nat) <- NatDivisionDef.Mod::[program] n \then
    \bind remainder: Nat <- (\force partial) two \then
    \bind result: B.Bool <- Op.IsZero::[program] remainder \then
    \return result
  },
  \set := \fun (n: Nat^) => Op.IsZero::[set] (NatDivisionDef.Mod::[set] n two^),

  \definition matches (n: Nat^): Even::[program]^ n = Even::[set] n :=
    trans!{B.Bool^} _ _ _
      (congr!{Op.IsZero::[Type]^ B.Bool^}
        (\fun (test: _) => test (NatDivisionDef.Mod::[program]^ n two^)) _ _ Op.IsZero::[coherence])
      (congr!{NatDivisionDef.Mod::[Type]^ B.Bool^}
        (\fun (mod: _) => Op.IsZero::[set] (mod n two^)) _ _ NatDivisionDef.Mod::[coherence]);
  \coherence := \axiom:funext(Even::[program]^, Even::[set], matches),
}

\correspondence Odd: Nat -> B.Bool {
  \program := \fun (n: Nat) => \program {
    \bind partial: \U(Nat -> Nat) <- NatDivisionDef.Mod::[program] n \then
    \bind remainder: Nat <- (\force partial) two \then
    \bind test: \U(Nat -> B.Bool) <- Op.Eqb::[program] remainder \then
    \bind result: B.Bool <- (\force test) Op.one \then
    \return result
  },
  \set := \fun (n: Nat^) => Op.Eqb::[set] (NatDivisionDef.Mod::[set] n two^) Op.one^,

  \definition matches (n: Nat^): Odd::[program]^ n = Odd::[set] n :=
    trans!{B.Bool^} _ _ _
      (congr!{Op.Eqb::[Type]^ B.Bool^}
        (\fun (test: _) => test (NatDivisionDef.Mod::[program]^ n two^) Op.one^) _ _ Op.Eqb::[coherence])
      (congr!{NatDivisionDef.Mod::[Type]^ B.Bool^}
        (\fun (mod: _) => Op.Eqb::[set] (mod n two^) Op.one^) _ _ NatDivisionDef.Mod::[coherence]);
  \coherence := \axiom:funext(Odd::[program]^, Odd::[set], matches),
}
