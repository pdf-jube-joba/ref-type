\definition T: \VType := \U(Nat -> Result -> Position);
\definition program: T := \thunk (\cfun (i: Nat) => \return(\thunk (\cfun (result: Result) => \match result \in Result \with {
  | missing: \return Position::empty
  | found j: \return(Position::position i j)
})));
\definition matches: \forall (i: Nat^)(result: Result^) -> program^ i result = chooseRow i result :=
  \fun (i: Nat^) => \induction (result: Result^) \return program^ i result = chooseRow i result \with {
    | missing: \refl(Position^::empty)
    | found: \fun (j: Nat^) => \refl(Position^::position i j)
  };
\definition coherence: program^ = chooseRow := \axiom:funext(program^, chooseRow,
  \fun (i: Nat^) => \axiom:funext(program^ i, chooseRow i, matches i));
