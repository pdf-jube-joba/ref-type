\definition T: \VType := \U(State -> Result);
\definition program: T := \thunk (\cfun (state: State) => \match state \in State \with { | scanning index result: \return result });
\definition matches: \forall (state: State^) -> program^ state = answer state :=
  \induction (state: State^) \return program^ state = answer state \with {
    | scanning: \fun (index: Nat^)(result: Result^) => \refl(result)
  };
\definition coherence: program^ = answer := \axiom:funext(program^, answer, matches);
