\definition T: \VType := \U(Result -> B.Bool);
\definition program: T := \thunk (\cfun (result: Result) => \match result \in Result \with {
  | missing: \return B.Bool::false
  | found index: \return B.Bool::true
});
\definition matches: \forall (result: Result^) -> program^ result = isFound result :=
  \induction (result: Result^) \return program^ result = isFound result \with {
    | missing: \refl(B.Bool^::false)
    | found: \fun (index: Nat^) => \refl(B.Bool^::true)
  };
\definition coherence: program^ = isFound := \axiom:funext(program^, isFound, matches);
