\import std.Data[].Bool[] \as B;
\import std.Data[].Pair[] \as P;
\import std.Data[].Nat[].Basic[].Def[] \as Basic;
\import std.Data[].Nat[].Pair[].Def[] \as Pair;

\definition divModNext: Nat^ -> Pair.NatPair -> Pair.NatPair := \fun (b: Nat^) =>
      \induction (p: P.Times^[Nat^, Nat^]) \return Pair.NatPair \with {
      | pair : (\fun (q, r: Nat^) => \induction (b: Nat^) \return Pair.NatPair \with {
        | zero : (Pair.natPair q (Nat^::succ r))
        | succ : (\fun (d: Nat^) => \fun (_: _) => \match (Basic.eqb r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Pair.NatPair) \with {
          | false : (Pair.natPair q (Nat^::succ r))
          | true : (Pair.natPair (Nat^::succ q) Nat^::zero)
        })
      } b)
    };

\definition divMod: Nat^ -> Nat^ -> Pair.NatPair := \fun (a, b: Nat^) =>
      Pair.pairIter (divModNext b) (Pair.natPair Nat^::zero Nat^::zero) a;

\definition div: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) =>
      P.Times[Nat, Nat]::first^ (divMod a b);

\definition mod: Nat^ -> Nat^ -> Nat^ := \fun (a, b: Nat^) =>
      P.Times[Nat, Nat]::second^ (divMod a b);
