\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;

\import std.Data[].Bool[] \as B;
\import std.Data[].Pair[] \as P;

\import std.Data[].Nat[].Basic[].Def[] \as Basic;
\import std.Data[].Nat[].Pair[].Def[] \as Pair;

\correspondence DivModNext: Nat -> P.Times[Nat, Nat] -> P.Times[Nat, Nat] {
  \program := \fun (b: Nat) =>
    \fun (p: P.Times[Nat, Nat]) =>
      \match p \in P.Times \with {
        | pair q r : \match b \in Nat \with {
          | zero : \return(P.Times[Nat, Nat]::pair q (Nat::succ r))
          | succ d :
          \program {
            \bind hit: B.Bool <- Basic.EqbLoop::[run] (Basic.EqbState::running r d) \then
            \bind pick: \U(P.Times[Nat, Nat] -> (P.Times[Nat, Nat] -> P.Times[Nat, Nat])) <- (Pair.PairChoose::[program] hit) \then
            \bind pickYes: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) <- (\force pick) (P.Times[Nat, Nat]::pair (Nat::succ q) Nat::zero) \then
            \bind next: P.Times[Nat, Nat] <- (\force pickYes) (P.Times[Nat, Nat]::pair q (Nat::succ r)) \then
            \return next
          }
        }
      },
  \set := \fun (b: Nat^) =>
    \induction (p: P.Times^[Nat^, Nat^]) \return Pair.NatPair \with {
    | pair : (\fun (q, r: Nat^) => \induction (b: Nat^) \return Pair.NatPair \with {
      | zero : (Pair.natPair q (Nat^::succ r))
      | succ : (\fun (d: Nat^) => \fun (_: _) => \match (Basic.Eqb::[set] r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Pair.NatPair) \with {
        | false : (Pair.natPair q (Nat^::succ r))
        | true : (Pair.natPair (Nat^::succ q) Nat^::zero)
      })
    } b)
  },

  \definition matches (b: Nat^): \forall (p: Pair.NatPair) ->
    DivModNext::[program]^ b p = DivModNext::[set] b p :=
    \induction (p: P.Times^[Nat^, Nat^]) \return DivModNext::[program]^ b p = DivModNext::[set] b p \with {
      | pair : (\fun (q, r: Nat^) => \induction (b: Nat^) \return DivModNext::[program]^ b (Pair.natPair q r) = DivModNext::[set] b (Pair.natPair q r) \with {
        | zero : (\refl(Pair.natPair q (Nat^::succ r)))
        | succ : (\fun (d: Nat^) => \fun (_: _) => (trans!{Pair.NatPair} _ _ _
          (congr!{Pair.PairChoose::[Type]^ _} (\fun (f: _) => f (Basic.Eqb::[program]^ r d) (Pair.natPair (Nat^::succ q) Nat^::zero) (Pair.natPair q (Nat^::succ r))) _ _ Pair.PairChoose::[coherence])
          (congr!{Basic.Eqb::[Type]^ Pair.NatPair}
            (\fun (equal: _) => Pair.PairChoose::[set] (equal r d)
              (Pair.natPair (Nat^::succ q) Nat^::zero) (Pair.natPair q (Nat^::succ r)))
            _ _ Basic.Eqb::[coherence])))
      } b)
    };
  \coherence := \axiom:funext(DivModNext::[program]^, DivModNext::[set],
    \fun (b: Nat^) => \axiom:funext(DivModNext::[program]^ b, DivModNext::[set] b,
      \fun (p: Pair.NatPair) => matches b p)),
}

\correspondence DivMod: Nat -> Nat -> P.Times[Nat, Nat] {
  \program := \fun (a, b: Nat) => \program {
    \bind advance: \U(P.Times[Nat, Nat] -> P.Times[Nat, Nat]) <- (DivModNext::[program] b) \then
    \bind result: P.Times[Nat, Nat] <- Pair.PairIterLoop::[run] (Pair.PairIterState::running advance (P.Times[Nat, Nat]::pair Nat::zero Nat::zero) a) \then
    \return result
  },
  \set := \fun (a, b: Nat^) =>
    Pair.PairIter::[set] (DivModNext::[set] b) (Pair.natPair Nat^::zero Nat^::zero) a,

  \definition matches: \forall (a, b: Nat^) -> DivMod::[program]^ a b = DivMod::[set] a b :=
    \block {
      \fun (a, b: Nat^) \then
      \let iterationMatches:
        DivMod::[program]^ a b = Pair.PairIter::[set] (DivModNext::[program]^ b) (Pair.natPair Nat^::zero Nat^::zero) a :=
        (congr!{Pair.PairIter::[Type]^ _} (\fun (f: _) => f (DivModNext::[program]^ b) (Pair.natPair Nat^::zero Nat^::zero) a) _ _ Pair.PairIter::[coherence]) \then
      \let stepMatches:
        Pair.PairIter::[set] (DivModNext::[program]^ b) (Pair.natPair Nat^::zero Nat^::zero) a = DivMod::[set] a b :=
        congr!{DivModNext::[Type]^ Pair.NatPair}
          (\fun (next: _) => Pair.PairIter::[set] (next b) (Pair.natPair Nat^::zero Nat^::zero) a)
          _ _ DivModNext::[coherence] \then
      \return trans!{Pair.NatPair} _ _ _ iterationMatches stepMatches
    };
  \coherence := \axiom:funext(DivMod::[program]^, DivMod::[set],
    \fun (a: Nat^) => \axiom:funext(DivMod::[program]^ a, DivMod::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\correspondence Div: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind partial: \U(Nat -> P.Times[Nat, Nat]) <- (DivMod::[program] a) \then
    \bind result: P.Times[Nat, Nat] <- (\force partial) b \then
    \bind quotient: Nat <- (P.Times[Nat, Nat]::first result) \then
    \return quotient
  },
  \set := \fun (a, b: Nat^) =>
    P.Times[Nat, Nat]::first^ (DivMod::[set] a b),

  \definition matches (a, b: Nat^): Div::[program]^ a b = Div::[set] a b := congr!{Pair.NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ ((congr!{DivMod::[Type]^ _} (\fun (f: _) => f a b) _ _ DivMod::[coherence]));
  \coherence := \axiom:funext(Div::[program]^, Div::[set],
    \fun (a: Nat^) => \axiom:funext(Div::[program]^ a, Div::[set] a,
      \fun (b: Nat^) => matches a b)),
}

\correspondence Mod: Nat -> Nat -> Nat {
  \program := \fun (a, b: Nat) => \program {
    \bind partial: \U(Nat -> P.Times[Nat, Nat]) <- (DivMod::[program] a) \then
    \bind result: P.Times[Nat, Nat] <- (\force partial) b \then
    \bind remainder: Nat <- (P.Times[Nat, Nat]::second result) \then
    \return remainder
  },
  \set := \fun (a, b: Nat^) =>
    P.Times[Nat, Nat]::second^ (DivMod::[set] a b),

  \definition matches (a, b: Nat^): Mod::[program]^ a b = Mod::[set] a b := congr!{Pair.NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ ((congr!{DivMod::[Type]^ _} (\fun (f: _) => f a b) _ _ DivMod::[coherence]));
  \coherence := \axiom:funext(Mod::[program]^, Mod::[set],
    \fun (a: Nat^) => \axiom:funext(Mod::[program]^ a, Mod::[set] a,
      \fun (b: Nat^) => matches a b)),
}
