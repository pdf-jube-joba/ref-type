\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.transport;

\import std.Data[].Bool[] \as B;
\import B.Prop[] \as BoolLaws;
\import std.Data[].Pair[] \as P;

\import std.Data[].Nat[].Basic[].Def[] \as Op;
\import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
\import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
\use Op.nat_add;
\use Op.nat_mul;

\import \parent.\parent.Basic[].Prop[] \as Basic;

\import std.Data[].Nat[].Iteration[].Prop[A := NatPairDef.NatPair] \as PairIterationProp;

\definition leSuccOfEqbFalse:
  \forall (d, r: Nat^) -> Basic.Le r d -> Op.Eqb.specification r d = B.Bool^::false -> Basic.Le (Nat^::succ r) d :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Basic.Le r d -> Op.Eqb.specification r d = B.Bool^::false -> Basic.Le (Nat^::succ r) d \with {
    | zero : (\induction (r: Nat^) \return Basic.Le r Nat^::zero -> Op.Eqb.specification r Nat^::zero = B.Bool^::false -> Basic.Le (Nat^::succ r) Nat^::zero \with {
      | zero : \fun (h: Basic.Le Nat^::zero Nat^::zero)
        (e: B.Bool^::true = B.Bool^::false) =>
        BoolLaws.absurd (Basic.Le (Nat^::succ Nat^::zero) Nat^::zero)
          (\idelim B.Bool^::true = B.Bool^::false \with t: B.Bool^ => t = B.Bool^::true
            \by { base: \refl(B.Bool^::true), equality: e })
      | succ : \block {
          \fun (r: Nat^) \then
          \fun (ih: Basic.Le r Nat^::zero -> Op.Eqb.specification r Nat^::zero = B.Bool^::false ->
            Basic.Le (Nat^::succ r) Nat^::zero) \then
          \fun (h: Basic.Le (Nat^::succ r) Nat^::zero) \then
          \fun (e: Op.Eqb.specification (Nat^::succ r) Nat^::zero = B.Bool^::false) \then
          \return BoolLaws.absurd (Basic.Le (Nat^::succ (Nat^::succ r)) Nat^::zero) h
        }
      })
    | succ : \block {
        \fun (d: Nat^) \then
        \fun (ih: \forall (r: Nat^) -> Basic.Le r d -> Op.Eqb.specification r d = B.Bool^::false ->
          Basic.Le (Nat^::succ r) d) \then
        \return \induction (r: Nat^) \return Basic.Le r (Nat^::succ d) ->
          Op.Eqb.specification r (Nat^::succ d) = B.Bool^::false ->
          Basic.Le (Nat^::succ r) (Nat^::succ d) \with {
          | zero : \fun (h: Basic.Le Nat^::zero (Nat^::succ d))
              (e: Op.Eqb.specification Nat^::zero (Nat^::succ d) = B.Bool^::false) => Basic.zeroLe d
          | succ : \block {
              \fun (r: Nat^) \then
              \fun (unused: Basic.Le r (Nat^::succ d) ->
                Op.Eqb.specification r (Nat^::succ d) = B.Bool^::false ->
                Basic.Le (Nat^::succ r) (Nat^::succ d)) \then
              \fun (h: Basic.Le (Nat^::succ r) (Nat^::succ d)) \then
              \fun (e: Op.Eqb.specification (Nat^::succ r) (Nat^::succ d) = B.Bool^::false) \then
              \return ih r h e
            }
          }
      }
    };
\definition divModNextBound:
  \forall (d: Nat^) -> \forall (p: NatPairDef.NatPair) -> Basic.Le (P.Times[Nat, Nat]::second^ p) d ->
  Basic.Le (P.Times[Nat, Nat]::second^ (NatDivisionDef.DivModNext.specification (Nat^::succ d) p)) d :=
  \fun (d: Nat^) => NatPairDef.natPairElim
    (\fun (p: NatPairDef.NatPair) => Basic.Le (P.Times[Nat, Nat]::second^ p) d -> Basic.Le (P.Times[Nat, Nat]::second^ (NatDivisionDef.DivModNext.specification (Nat^::succ d) p)) d)
    (\fun (q, r: Nat^) => \fun (h: Basic.Le r d) =>
      (\match (Op.Eqb.specification r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Op.Eqb.specification r d = hit ->
          Basic.Le (P.Times[Nat, Nat]::second^ (NatPairDef.PairChoose.specification hit (NatPairDef.natPair (Nat^::succ q) Nat^::zero) (NatPairDef.natPair q (Nat^::succ r)))) d) \with {
        | false : (\fun (e: Op.Eqb.specification r d = B.Bool^::false) => leSuccOfEqbFalse d r h e)
        | true : (\fun (e: Op.Eqb.specification r d = B.Bool^::true) => Basic.zeroLe d)
        }) (\refl(Op.Eqb.specification r d)));
\definition modBound(a, d: Nat^): Basic.Le (NatDivisionDef.Mod.specification a (Nat^::succ d)) d := PairIterationProp.preserves (NatDivisionDef.DivModNext.specification (Nat^::succ d))
    (\fun (p: NatPairDef.NatPair) => Basic.Le (P.Times[Nat, Nat]::second^ p) d) (divModNextBound d) a
    (NatPairDef.natPair Nat^::zero Nat^::zero) (Basic.zeroLe d);

/* Reconstruction holds even at divisor zero. */
\definition divModValue(b: Nat^) (p: NatPairDef.NatPair): Nat^ := \((b "*" { P.Times[Nat, Nat]::first^ p }) "+" { P.Times[Nat, Nat]::second^ p }\);
\definition divisionCarryValue:
  \forall (d, q: Nat^) ->
  divModValue (Nat^::succ d) (NatPairDef.natPair (Nat^::succ q) Nat^::zero) =
    Nat^::succ (divModValue (Nat^::succ d) (NatPairDef.natPair q d)) :=
  \block {
    \fun (d, q: Nat^) \then
    \let carryProduct:
      \({ Nat^::succ d } "*" { Nat^::succ q }\) =
        \({ Nat^::succ d } "+" ({ Nat^::succ d } "*" q)\) :=
      Basic.mulSuccRight (Nat^::succ d) q \then
    \let exposeSuccessor:
      \({ Nat^::succ d } "+" ({ Nat^::succ d } "*" q)\) =
        Nat^::succ \(d "+" ({ Nat^::succ d } "*" q)\) :=
      Basic.addSuccLeft d \({ Nat^::succ d } "*" q\) \then
    \return trans!{Nat^} _ _ _ carryProduct
      (trans!{Nat^} _ _ _ exposeSuccessor
        (Op.succCong _ _ (Basic.addComm d \({ Nat^::succ d } "*" q\))))
  };
\definition divModNextValue:
  \forall (b: Nat^) -> \forall (p: NatPairDef.NatPair) ->
  divModValue b (NatDivisionDef.DivModNext.specification b p) = Nat^::succ (divModValue b p) :=
  \fun (b: Nat^) => NatPairDef.natPairElim
    (\fun (p: NatPairDef.NatPair) => divModValue b (NatDivisionDef.DivModNext.specification b p) = Nat^::succ (divModValue b p))
    (\fun (q, r: Nat^) => \induction (b: Nat^) \return divModValue b (NatDivisionDef.DivModNext.specification b (NatPairDef.natPair q r)) = Nat^::succ (divModValue b (NatPairDef.natPair q r)) \with {
      | zero : (Basic.addSuccRight \({ Nat^::zero } "*" q\) r)
      | succ : (\fun (d: Nat^) => \fun (_: _) => (\match (Op.Eqb.specification r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Op.Eqb.specification r d = hit ->
            divModValue (Nat^::succ d) (NatPairDef.PairChoose.specification hit (NatPairDef.natPair (Nat^::succ q) Nat^::zero) (NatPairDef.natPair q (Nat^::succ r))) =
              Nat^::succ (divModValue (Nat^::succ d) (NatPairDef.natPair q r))) \with {
        | false : (\fun (e: Op.Eqb.specification r d = B.Bool^::false) => Basic.addSuccRight \({ Nat^::succ d } "*" q\) r)
        | true : (\fun (e: Op.Eqb.specification r d = B.Bool^::true) =>
            \idelim d = r \with x: Nat^ =>
              divModValue (Nat^::succ d) (NatPairDef.natPair (Nat^::succ q) Nat^::zero) =
                Nat^::succ (divModValue (Nat^::succ d) (NatPairDef.natPair q x))
              \by { base: divisionCarryValue d q, equality: sym!{Nat^} r d (Basic.eqOfEqbTrue d r e) })
        }) (\refl(Op.Eqb.specification r d)))
      } b);
\definition divModReconstructs:
  \forall (a, b: Nat^) -> divModValue b (NatDivisionDef.DivMod.specification a b) = a :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> divModValue b (NatDivisionDef.DivMod.specification a b) = a \with {
    | zero : (\fun (b: Nat^) => \refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> divModValue b (NatDivisionDef.DivMod.specification a b) = a) => \fun (b: Nat^) =>
      trans!{Nat^} _ _ _ (divModNextValue b (NatDivisionDef.DivMod.specification a b)) (Op.succCong _ _ (ih b)))
    };

/* Zero conventions and division of zero are universal equations. */
\definition divModZeroDivisor:
  \forall (a: Nat^) -> NatDivisionDef.DivMod.specification a Nat^::zero = NatPairDef.natPair Nat^::zero a :=
  \induction (a: Nat^) \return NatDivisionDef.DivMod.specification a Nat^::zero = NatPairDef.natPair Nat^::zero a \with {
    | zero : (\refl(NatPairDef.natPair Nat^::zero Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: NatDivisionDef.DivMod.specification a Nat^::zero = NatPairDef.natPair Nat^::zero a) =>
      congr!{NatPairDef.NatPair NatPairDef.NatPair} (NatDivisionDef.DivModNext.specification Nat^::zero) (NatDivisionDef.DivMod.specification a Nat^::zero) (NatPairDef.natPair Nat^::zero a) ih)
    };
\definition divZeroRight(a: Nat^): NatDivisionDef.Div.specification a Nat^::zero = Nat^::zero :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModZeroDivisor a);
\definition modZeroRight(a: Nat^): NatDivisionDef.Mod.specification a Nat^::zero = a :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModZeroDivisor a);
\definition divZeroLeft(b: Nat^): NatDivisionDef.Div.specification Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
\definition modZeroLeft(b: Nat^): NatDivisionDef.Mod.specification Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
/* Divisibility is constructive: a proof supplies a natural-number factor to
 * any propositional consumer (the usual existential encoding). */
\definition Divides(d, a: Nat^): \Prop := \forall (P: \Prop) -> (\forall (q: Nat^) -> a = \(d "*" q\) -> P) -> P;
\definition dividesIntro(d, a, q: Nat^):
  a = \(d "*" q\) ->
  Divides d a := \fun (e: a = \(d "*" q\)) (P: \Prop) (use: \forall (q: Nat^) -> a = \(d "*" q\) -> P) => use q e;
\definition dividesZero(d: Nat^): Divides d Nat^::zero := dividesIntro d Nat^::zero Nat^::zero (\refl(Nat^::zero));
\definition dividesSelf(d: Nat^): Divides d d := dividesIntro d d (Nat^::succ Nat^::zero) (sym!{Nat^} _ _ (Basic.mulOneRight d));
\definition dividesTransport(d: Nat^): \forall (a, b: Nat^) -> a = b -> Divides d a -> Divides d b :=
  transport!{Nat^} (Divides d);
\definition dividesAdd(d, a, b: Nat^):
  Divides d a -> Divides d b ->
  Divides d \(a "+" b\) :=
    \fun (ha: Divides d a) (hb: Divides d b) =>
    ha (Divides d \(a "+" b\)) (\fun (x: Nat^) => \fun (ex: a = \(d "*" x\)) =>
        hb (Divides d \(a "+" b\)) (\fun (y: Nat^) => \fun (ey: b = \(d "*" y\)) =>
          dividesIntro d \(a "+" b\) \(x "+" y\)
            (trans!{Nat^} _ _ _ (Basic.addCong _ _ _ _ ex ey) (sym!{Nat^} _ _ (Basic.mulDistribLeft d x y)))));
\definition dividesMul(d, a, b: Nat^):
  Divides d a ->
  Divides d \(a "*" b\) :=
    \fun (ha: Divides d a) =>
    ha (Divides d \(a "*" b\)) (\fun (x: Nat^) => \fun (ex: a = \(d "*" x\)) =>
        dividesIntro d \(a "*" b\) \(x "*" b\)
          (trans!{Nat^} _ _ _ (congr!{Nat^ Nat^} (\fun (n: Nat^) => \(n "*" b\)) _ _ ex) (Basic.mulAssoc d x b)));
\definition subCong:
  \forall (a, b, c, d: Nat^) -> a = b -> c = d -> Op.Sub.specification a c = Op.Sub.specification b d :=
  congr2!{Nat^ Nat^ Nat^} Op.Sub.specification;
\definition subAddBoth:
  \forall (c, a, b: Nat^) -> Op.Sub.specification \(a "+" c\) \(b "+" c\) = Op.Sub.specification a b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> Op.Sub.specification \(a "+" c\) \(b "+" c\) = Op.Sub.specification a b \with {
    | zero : (\fun (a, b: Nat^) => \refl(Op.Sub.specification a b))
    | succ : (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> Op.Sub.specification \(a "+" c\) \(b "+" c\) = Op.Sub.specification a b) =>
      \fun (a, b: Nat^) => trans!{Nat^} _ _ _
        (subCong _ _ _ _ (Basic.addSuccRight a c) (Basic.addSuccRight b c)) (ih a b))
    };
\definition mulSub(d: Nat^):
  \forall (b, a: Nat^) -> Op.Sub.specification \(d "*" a\) \(d "*" b\) = \(d "*" { Op.Sub.specification a b }\) :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Op.Sub.specification \(d "*" a\) \(d "*" b\) = \(d "*" { Op.Sub.specification a b }\) \with {
    | zero : (\fun (a: Nat^) => \refl(\(d "*" a\)))
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> Op.Sub.specification \(d "*" a\) \(d "*" b\) = \(d "*" { Op.Sub.specification a b }\)) =>
      \induction (a: Nat^) \return Op.Sub.specification \(d "*" a\) \(d "*" { Nat^::succ b }\) = \(d "*" { Op.Sub.specification a (Nat^::succ b) }\) \with {
      | zero : (trans!{Nat^} _ _ _ (Basic.subZeroLeft \(d "*" { Nat^::succ b }\))
          (sym!{Nat^} _ _ (congr!{Nat^ Nat^} (Op.Mul.specification d) _ _ (Basic.subZeroLeft (Nat^::succ b)))))
      | succ : (\fun (a: Nat^) => \fun (unused: Op.Sub.specification \(d "*" a\) \(d "*" { Nat^::succ b }\) = \(d "*" { Op.Sub.specification a (Nat^::succ b) }\)) =>
          trans!{Nat^} _ _ _ (subCong _ _ _ _ (Basic.mulSuccRight d a) (Basic.mulSuccRight d b))
            (trans!{Nat^} _ _ _ (subCong _ _ _ _ (Basic.addComm d \(d "*" a\)) (Basic.addComm d \(d "*" b\)))
              (trans!{Nat^} _ _ _ (subAddBoth d \(d "*" a\) \(d "*" b\)) (ih a))))
      })
    };
\definition dividesSub(d, a, b: Nat^):
  Divides d a -> Divides d b ->
  Divides d (Op.Sub.specification a b) :=
    \fun (ha: Divides d a) (hb: Divides d b) =>
    ha (Divides d (Op.Sub.specification a b)) (\fun (x: Nat^) => \fun (ex: a = \(d "*" x\)) =>
        hb (Divides d (Op.Sub.specification a b)) (\fun (y: Nat^) => \fun (ey: b = \(d "*" y\)) =>
          dividesIntro d (Op.Sub.specification a b) (Op.Sub.specification x y)
            (trans!{Nat^} _ _ _ (subCong _ _ _ _ ex ey) (mulSub d y x))));
\definition modAsSub:
  \forall (a, b: Nat^) -> NatDivisionDef.Mod.specification a b = Op.Sub.specification a \(b "*" { NatDivisionDef.Div.specification a b }\) :=
  \block {
    \fun (a, b: Nat^) \then
    \let reconstruction:
      \({ NatDivisionDef.Mod.specification a b } "+" (b "*" { NatDivisionDef.Div.specification a b })\) = a :=
      trans!{Nat^} _ _ _
        (Basic.addComm (NatDivisionDef.Mod.specification a b) \(b "*" { NatDivisionDef.Div.specification a b }\))
        (divModReconstructs a b) \then
    \let subtractReconstruction:
      Op.Sub.specification \({ NatDivisionDef.Mod.specification a b } "+" (b "*" { NatDivisionDef.Div.specification a b })\)
        \(b "*" { NatDivisionDef.Div.specification a b }\) =
      Op.Sub.specification a \(b "*" { NatDivisionDef.Div.specification a b }\) :=
      congr!{Nat^ Nat^} (\fun (x: Nat^) => Op.Sub.specification x \(b "*" { NatDivisionDef.Div.specification a b }\))
        _ _ reconstruction \then
    \return trans!{Nat^} _ _ _
      (sym!{Nat^} _ _ (Basic.subAddCancel \(b "*" { NatDivisionDef.Div.specification a b }\) (NatDivisionDef.Mod.specification a b)))
      subtractReconstruction
  };
\definition dividesMod:
  \forall (d, a, b: Nat^) -> Divides d a -> Divides d b -> Divides d (NatDivisionDef.Mod.specification a b) :=
  \block {
    \fun (d, a, b: Nat^) \then
    \fun (ha: Divides d a) (hb: Divides d b) \then
    \let productDivides: Divides d \(b "*" { NatDivisionDef.Div.specification a b }\) :=
      dividesMul d b (NatDivisionDef.Div.specification a b) hb \then
    \let differenceDivides: Divides d (Op.Sub.specification a \(b "*" { NatDivisionDef.Div.specification a b }\)) :=
      dividesSub d a \(b "*" { NatDivisionDef.Div.specification a b }\) ha productDivides \then
    \return dividesTransport d (Op.Sub.specification a \(b "*" { NatDivisionDef.Div.specification a b }\)) (NatDivisionDef.Mod.specification a b)
      (sym!{Nat^} _ _ (modAsSub a b)) differenceDivides
  };
\definition dividesOfMod:
  \forall (d, a, b: Nat^) -> Divides d b -> Divides d (NatDivisionDef.Mod.specification a b) -> Divides d a :=
  \block {
    \fun (d, a, b: Nat^) \then
    \fun (hb: Divides d b) (hr: Divides d (NatDivisionDef.Mod.specification a b)) \then
    \let quotientProductDivides: Divides d \(b "*" { NatDivisionDef.Div.specification a b }\) :=
      dividesMul d b (NatDivisionDef.Div.specification a b) hb \then
    \let reconstructionDivides:
      Divides d \((b "*" { NatDivisionDef.Div.specification a b }) "+" { NatDivisionDef.Mod.specification a b }\) :=
      dividesAdd d \(b "*" { NatDivisionDef.Div.specification a b }\) (NatDivisionDef.Mod.specification a b) quotientProductDivides hr \then
    \return dividesTransport d \((b "*" { NatDivisionDef.Div.specification a b }) "+" { NatDivisionDef.Mod.specification a b }\) a
      (divModReconstructs a b) reconstructionDivides
  };

\definition leToLtSucc: \forall (d, r: Nat^) -> Basic.Le r d -> Basic.Lt r (Nat^::succ d) :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Basic.Le r d -> Basic.Lt r (Nat^::succ d) \with {
    | zero : (\induction (r: Nat^) \return Basic.Le r Nat^::zero -> Basic.Lt r (Nat^::succ Nat^::zero) \with {
      | zero : (\fun (h: Basic.Le Nat^::zero Nat^::zero) => \refl(B.Bool^::true))
      | succ : (\fun (r: Nat^) => \fun (ih: Basic.Le r Nat^::zero -> Basic.Lt r (Nat^::succ Nat^::zero)) =>
        \fun (h: Basic.Le (Nat^::succ r) Nat^::zero) => BoolLaws.absurd (Basic.Lt (Nat^::succ r) (Nat^::succ Nat^::zero)) h)
      })
    | succ : (\fun (d: Nat^) => \fun (ih: \forall (r: Nat^) -> Basic.Le r d -> Basic.Lt r (Nat^::succ d)) =>
      \induction (r: Nat^) \return Basic.Le r (Nat^::succ d) -> Basic.Lt r (Nat^::succ (Nat^::succ d)) \with {
      | zero : (\fun (h: Basic.Le Nat^::zero (Nat^::succ d)) => \refl(B.Bool^::true))
      | succ : (\fun (r: Nat^) => \fun (unused: Basic.Le r (Nat^::succ d) -> Basic.Lt r (Nat^::succ (Nat^::succ d))) =>
          \fun (h: Basic.Le (Nat^::succ r) (Nat^::succ d)) => ih r h)
      })
    };
\definition modLt(a, d: Nat^): Basic.Lt (NatDivisionDef.Mod.specification a (Nat^::succ d)) (Nat^::succ d) := leToLtSucc d (NatDivisionDef.Mod.specification a (Nat^::succ d)) (modBound a d);
\definition divModOne:
  \forall (a: Nat^) -> NatDivisionDef.DivMod.specification a (Nat^::succ Nat^::zero) = NatPairDef.natPair a Nat^::zero :=
  \induction (a: Nat^) \return NatDivisionDef.DivMod.specification a (Nat^::succ Nat^::zero) = NatPairDef.natPair a Nat^::zero \with {
    | zero : (\refl(NatPairDef.natPair Nat^::zero Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: NatDivisionDef.DivMod.specification a (Nat^::succ Nat^::zero) = NatPairDef.natPair a Nat^::zero) =>
      congr!{NatPairDef.NatPair NatPairDef.NatPair} (NatDivisionDef.DivModNext.specification (Nat^::succ Nat^::zero))
        (NatDivisionDef.DivMod.specification a (Nat^::succ Nat^::zero)) (NatPairDef.natPair a Nat^::zero) ih)
    };
\definition divOne(a: Nat^): NatDivisionDef.Div.specification a (Nat^::succ Nat^::zero) = a :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModOne a);
\definition modOne(a: Nat^): NatDivisionDef.Mod.specification a (Nat^::succ Nat^::zero) = Nat^::zero :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModOne a);

\definition dividesZeroLeft(a: Nat^):
  Divides Nat^::zero a ->
  a = Nat^::zero :=
  \fun (h: Divides Nat^::zero a) =>
    h (a = Nat^::zero) (\fun (q: Nat^) (e: a = Op.Mul.specification Nat^::zero q) =>
      trans!{Nat^} _ _ _ e (Basic.mulZeroLeft q));

\definition dividesLeSucc(d, a: Nat^):
  Divides d (Nat^::succ a) ->
  Basic.Le d (Nat^::succ a) :=
  \fun (h: Divides d (Nat^::succ a)) =>
    h (Basic.Le d (Nat^::succ a))
      (\induction (q: Nat^) \return
        Nat^::succ a = Op.Mul.specification d q -> Basic.Le d (Nat^::succ a) \with {
        | zero: \fun (e: Nat^::succ a = Nat^::zero) =>
          Basic.succEqZeroElim a (Basic.Le d (Nat^::succ a)) e
        | succ: \fun (q: Nat^) (unused: _) (e: _) =>
          transport!{Nat^} (Basic.Le d) _ _ (sym!{Nat^} _ _ e)
            (Basic.leAddRight d (Op.Mul.specification d q))
      });

\definition dividesAntisym: \forall (a, b: Nat^) -> Divides a b -> Divides b a -> a = b :=
  \induction (a: Nat^) \return
    \forall (b: Nat^) -> Divides a b -> Divides b a -> a = b \with {
    | zero: \fun (b: Nat^) (ab: _) (ba: _) =>
      sym!{Nat^} _ _ (dividesZeroLeft b ab)
    | succ: \fun (a: Nat^) (unused: _) =>
      \induction (b: Nat^) \return
        Divides (Nat^::succ a) b -> Divides b (Nat^::succ a) -> Nat^::succ a = b \with {
        | zero: \fun (ab: _) (ba: _) => dividesZeroLeft (Nat^::succ a) ba
        | succ: \fun (b: Nat^) (unused: _) (ab: _) (ba: _) =>
          Basic.leAntisym (Nat^::succ a) (Nat^::succ b)
            (dividesLeSucc (Nat^::succ a) b ab)
            (dividesLeSucc (Nat^::succ b) a ba)
      }
  };
