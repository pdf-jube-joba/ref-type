\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.transport;

\import std.Data[].Bool[] \as B;
\import B.Prop[] \as BoolLaws;
\import std.Data[].Pair[] \as P;

\import std.Data[].Nat[].Basic[].Def[] \as Op;
\import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
\import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
\use Op.nat_add;
\use Op.nat_mul;

\import \parent.\parent.Basic[].Prop[] \as Basic;

\import std.Data[].Nat[].Iteration[].Prop[A := NatPairDef.NatPair] \as PairIterationProp;

\definition leSuccOfEqbFalse:
  \forall (d, r: Nat^) -> Basic.Le r d -> Op.eqb r d = B.Bool^::false -> Basic.Le (Nat^::succ r) d :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Basic.Le r d -> Op.eqb r d = B.Bool^::false -> Basic.Le (Nat^::succ r) d \with {
    | zero : (\induction (r: Nat^) \return Basic.Le r Nat^::zero -> Op.eqb r Nat^::zero = B.Bool^::false -> Basic.Le (Nat^::succ r) Nat^::zero \with {
      | zero : \fun (h: Basic.Le Nat^::zero Nat^::zero)
        (e: B.Bool^::true = B.Bool^::false) =>
        BoolLaws.absurd (Basic.Le (Nat^::succ Nat^::zero) Nat^::zero)
          (\idelim B.Bool^::true = B.Bool^::false \with t: B.Bool^ => t = B.Bool^::true
            \by { base: \refl(B.Bool^::true), equality: e })
      | succ : \block {
          \fun (r: Nat^) \then
          \fun (ih: Basic.Le r Nat^::zero -> Op.eqb r Nat^::zero = B.Bool^::false ->
            Basic.Le (Nat^::succ r) Nat^::zero) \then
          \fun (h: Basic.Le (Nat^::succ r) Nat^::zero) \then
          \fun (e: Op.eqb (Nat^::succ r) Nat^::zero = B.Bool^::false) \then
          \return BoolLaws.absurd (Basic.Le (Nat^::succ (Nat^::succ r)) Nat^::zero) h
        }
      })
    | succ : \block {
        \fun (d: Nat^) \then
        \fun (ih: \forall (r: Nat^) -> Basic.Le r d -> Op.eqb r d = B.Bool^::false ->
          Basic.Le (Nat^::succ r) d) \then
        \return \induction (r: Nat^) \return Basic.Le r (Nat^::succ d) ->
          Op.eqb r (Nat^::succ d) = B.Bool^::false ->
          Basic.Le (Nat^::succ r) (Nat^::succ d) \with {
          | zero : \fun (h: Basic.Le Nat^::zero (Nat^::succ d))
              (e: Op.eqb Nat^::zero (Nat^::succ d) = B.Bool^::false) => Basic.zeroLe d
          | succ : \block {
              \fun (r: Nat^) \then
              \fun (unused: Basic.Le r (Nat^::succ d) ->
                Op.eqb r (Nat^::succ d) = B.Bool^::false ->
                Basic.Le (Nat^::succ r) (Nat^::succ d)) \then
              \fun (h: Basic.Le (Nat^::succ r) (Nat^::succ d)) \then
              \fun (e: Op.eqb (Nat^::succ r) (Nat^::succ d) = B.Bool^::false) \then
              \return ih r h e
            }
          }
      }
    };
\definition divModNextBound:
  \forall (d: Nat^) -> \forall (p: NatPairDef.NatPair) -> Basic.Le (P.Times[Nat, Nat]::second^ p) d ->
  Basic.Le (P.Times[Nat, Nat]::second^ (NatDivisionDef.divModNext (Nat^::succ d) p)) d :=
  \fun (d: Nat^) => NatPairDef.natPairElim
    (\fun (p: NatPairDef.NatPair) => Basic.Le (P.Times[Nat, Nat]::second^ p) d -> Basic.Le (P.Times[Nat, Nat]::second^ (NatDivisionDef.divModNext (Nat^::succ d) p)) d)
    (\fun (q, r: Nat^) => \fun (h: Basic.Le r d) =>
      (\match (Op.eqb r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Op.eqb r d = hit ->
          Basic.Le (P.Times[Nat, Nat]::second^ (NatPairDef.pairChoose hit (NatPairDef.natPair (Nat^::succ q) Nat^::zero) (NatPairDef.natPair q (Nat^::succ r)))) d) \with {
        | false : (\fun (e: Op.eqb r d = B.Bool^::false) => leSuccOfEqbFalse d r h e)
        | true : (\fun (e: Op.eqb r d = B.Bool^::true) => Basic.zeroLe d)
        }) (\refl(Op.eqb r d)));
\definition modBound(a, d: Nat^): Basic.Le (NatDivisionDef.mod a (Nat^::succ d)) d := PairIterationProp.preserves (NatDivisionDef.divModNext (Nat^::succ d))
    (\fun (p: NatPairDef.NatPair) => Basic.Le (P.Times[Nat, Nat]::second^ p) d) (divModNextBound d) a
    (NatPairDef.natPair Nat^::zero Nat^::zero) (Basic.zeroLe d);

/* Reconstruction holds even at divisor zero. */
\definition divModValue(b: Nat^) (p: NatPairDef.NatPair): Nat^ := \((b "*" { P.Times[Nat, Nat]::first^ p }) "+" { P.Times[Nat, Nat]::second^ p }\);
\definition divisionCarryValue:
  \forall (d, q: Nat^) ->
  divModValue (Nat^::succ d) (NatPairDef.natPair (Nat^::succ q) Nat^::zero) =
    Nat^::succ (divModValue (Nat^::succ d) (NatPairDef.natPair q d)) :=
  \block {
    \fun (d, q: Nat^) \then
    \let carryProduct:
      \({ Nat^::succ d } "*" { Nat^::succ q }\) =
        \({ Nat^::succ d } "+" ({ Nat^::succ d } "*" q)\) :=
      Basic.mulSuccRight (Nat^::succ d) q \then
    \let exposeSuccessor:
      \({ Nat^::succ d } "+" ({ Nat^::succ d } "*" q)\) =
        Nat^::succ \(d "+" ({ Nat^::succ d } "*" q)\) :=
      Basic.addSuccLeft d \({ Nat^::succ d } "*" q\) \then
    \return trans!{Nat^} _ _ _ carryProduct
      (trans!{Nat^} _ _ _ exposeSuccessor
        (Op.succCong _ _ (Basic.addComm d \({ Nat^::succ d } "*" q\))))
  };
\definition divModNextValue:
  \forall (b: Nat^) -> \forall (p: NatPairDef.NatPair) ->
  divModValue b (NatDivisionDef.divModNext b p) = Nat^::succ (divModValue b p) :=
  \fun (b: Nat^) => NatPairDef.natPairElim
    (\fun (p: NatPairDef.NatPair) => divModValue b (NatDivisionDef.divModNext b p) = Nat^::succ (divModValue b p))
    (\fun (q, r: Nat^) => \induction (b: Nat^) \return divModValue b (NatDivisionDef.divModNext b (NatPairDef.natPair q r)) = Nat^::succ (divModValue b (NatPairDef.natPair q r)) \with {
      | zero : (Basic.addSuccRight \({ Nat^::zero } "*" q\) r)
      | succ : (\fun (d: Nat^) => \fun (_: _) => (\match (Op.eqb r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Op.eqb r d = hit ->
            divModValue (Nat^::succ d) (NatPairDef.pairChoose hit (NatPairDef.natPair (Nat^::succ q) Nat^::zero) (NatPairDef.natPair q (Nat^::succ r))) =
              Nat^::succ (divModValue (Nat^::succ d) (NatPairDef.natPair q r))) \with {
        | false : (\fun (e: Op.eqb r d = B.Bool^::false) => Basic.addSuccRight \({ Nat^::succ d } "*" q\) r)
        | true : (\fun (e: Op.eqb r d = B.Bool^::true) =>
            \idelim d = r \with x: Nat^ =>
              divModValue (Nat^::succ d) (NatPairDef.natPair (Nat^::succ q) Nat^::zero) =
                Nat^::succ (divModValue (Nat^::succ d) (NatPairDef.natPair q x))
              \by { base: divisionCarryValue d q, equality: sym!{Nat^} r d (Basic.eqOfEqbTrue d r e) })
        }) (\refl(Op.eqb r d)))
      } b);
\definition divModReconstructs:
  \forall (a, b: Nat^) -> divModValue b (NatDivisionDef.divMod a b) = a :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> divModValue b (NatDivisionDef.divMod a b) = a \with {
    | zero : (\fun (b: Nat^) => \refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> divModValue b (NatDivisionDef.divMod a b) = a) => \fun (b: Nat^) =>
      trans!{Nat^} _ _ _ (divModNextValue b (NatDivisionDef.divMod a b)) (Op.succCong _ _ (ih b)))
    };

/* Zero conventions and division of zero are universal equations. */
\definition divModZeroDivisor:
  \forall (a: Nat^) -> NatDivisionDef.divMod a Nat^::zero = NatPairDef.natPair Nat^::zero a :=
  \induction (a: Nat^) \return NatDivisionDef.divMod a Nat^::zero = NatPairDef.natPair Nat^::zero a \with {
    | zero : (\refl(NatPairDef.natPair Nat^::zero Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: NatDivisionDef.divMod a Nat^::zero = NatPairDef.natPair Nat^::zero a) =>
      congr!{NatPairDef.NatPair NatPairDef.NatPair} (NatDivisionDef.divModNext Nat^::zero) (NatDivisionDef.divMod a Nat^::zero) (NatPairDef.natPair Nat^::zero a) ih)
    };
\definition divZeroRight(a: Nat^): NatDivisionDef.div a Nat^::zero = Nat^::zero :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModZeroDivisor a);
\definition modZeroRight(a: Nat^): NatDivisionDef.mod a Nat^::zero = a :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModZeroDivisor a);
\definition divZeroLeft(b: Nat^): NatDivisionDef.div Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
\definition modZeroLeft(b: Nat^): NatDivisionDef.mod Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
/* Divisibility supplies a natural-number factor. */
\definition Factors(d, a: Nat^): \Set :=
  \Cast[Nat^] ({ q: Nat^ \where a = \(d "*" q\) });
\definition Divides(d, a: Nat^): \Prop := \exists Factors d a;
\definition factorEquation(d, a: Nat^)(q: Factors d a): a = \(d "*" q\) :=
  \bysub(Nat^, Factors d a, q);
\definition dividesIntro(d, a, q: Nat^):
  a = \(d "*" q\) -> Divides d a :=
  \fun (e: _) => \exact(\into[Nat^](q, Factors d a) \by { e }, Factors d a);
\definition dividesZero(d: Nat^): Divides d Nat^::zero := dividesIntro d Nat^::zero Nat^::zero (\refl(Nat^::zero));
\definition dividesSelf(d: Nat^): Divides d d := dividesIntro d d (Nat^::succ Nat^::zero) (sym!{Nat^} _ _ (Basic.mulOneRight d));
\definition dividesTransport(d: Nat^): \forall (a, b: Nat^) -> a = b -> Divides d a -> Divides d b :=
  transport!{Nat^} (Divides d);
\definition dividesAdd(d, a, b: Nat^):
  Divides d a -> Divides d b -> Divides d \(a "+" b\) := \block {
    \fun (ha: _) (hb: _) \then
    \takefrom x: Factors d a \by ha \then
    \takefrom y: Factors d b \by hb \then
    \return dividesIntro d \(a "+" b\) \(x "+" y\)
      (trans!{Nat^} _ _ _
        (Basic.addCong _ _ _ _ (factorEquation d a x) (factorEquation d b y))
        (sym!{Nat^} _ _ (Basic.mulDistribLeft d x y)))
  };
\definition dividesMul(d, a, b: Nat^):
  Divides d a -> Divides d \(a "*" b\) := \block {
    \fun (ha: _) \then
    \takefrom x: Factors d a \by ha \then
    \return dividesIntro d \(a "*" b\) \(x "*" b\)
      (trans!{Nat^} _ _ _
        (congr!{Nat^ Nat^} (\fun (n: _) => \(n "*" b\)) _ _ (factorEquation d a x))
        (Basic.mulAssoc d x b))
  };
\definition subCong:
  \forall (a, b, c, d: Nat^) -> a = b -> c = d -> Op.sub a c = Op.sub b d :=
  congr2!{Nat^ Nat^ Nat^} Op.sub;
\definition subAddBoth:
  \forall (c, a, b: Nat^) -> Op.sub \(a "+" c\) \(b "+" c\) = Op.sub a b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> Op.sub \(a "+" c\) \(b "+" c\) = Op.sub a b \with {
    | zero : (\fun (a, b: Nat^) => \refl(Op.sub a b))
    | succ : (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> Op.sub \(a "+" c\) \(b "+" c\) = Op.sub a b) =>
      \fun (a, b: Nat^) => trans!{Nat^} _ _ _
        (subCong _ _ _ _ (Basic.addSuccRight a c) (Basic.addSuccRight b c)) (ih a b))
    };
\definition mulSub(d: Nat^):
  \forall (b, a: Nat^) -> Op.sub \(d "*" a\) \(d "*" b\) = \(d "*" { Op.sub a b }\) :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Op.sub \(d "*" a\) \(d "*" b\) = \(d "*" { Op.sub a b }\) \with {
    | zero : (\fun (a: Nat^) => \refl(\(d "*" a\)))
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> Op.sub \(d "*" a\) \(d "*" b\) = \(d "*" { Op.sub a b }\)) =>
      \induction (a: Nat^) \return Op.sub \(d "*" a\) \(d "*" { Nat^::succ b }\) = \(d "*" { Op.sub a (Nat^::succ b) }\) \with {
      | zero : (trans!{Nat^} _ _ _ (Basic.subZeroLeft \(d "*" { Nat^::succ b }\))
          (sym!{Nat^} _ _ (congr!{Nat^ Nat^} (Op.mul d) _ _ (Basic.subZeroLeft (Nat^::succ b)))))
      | succ : (\fun (a: Nat^) => \fun (unused: Op.sub \(d "*" a\) \(d "*" { Nat^::succ b }\) = \(d "*" { Op.sub a (Nat^::succ b) }\)) =>
          trans!{Nat^} _ _ _ (subCong _ _ _ _ (Basic.mulSuccRight d a) (Basic.mulSuccRight d b))
            (trans!{Nat^} _ _ _ (subCong _ _ _ _ (Basic.addComm d \(d "*" a\)) (Basic.addComm d \(d "*" b\)))
              (trans!{Nat^} _ _ _ (subAddBoth d \(d "*" a\) \(d "*" b\)) (ih a))))
      })
    };
\definition dividesSub(d, a, b: Nat^):
  Divides d a -> Divides d b -> Divides d (Op.sub a b) := \block {
    \fun (ha: _) (hb: _) \then
    \takefrom x: Factors d a \by ha \then
    \takefrom y: Factors d b \by hb \then
    \return dividesIntro d (Op.sub a b) (Op.sub x y)
      (trans!{Nat^} _ _ _
        (subCong _ _ _ _ (factorEquation d a x) (factorEquation d b y)) (mulSub d y x))
  };
\definition modAsSub:
  \forall (a, b: Nat^) -> NatDivisionDef.mod a b = Op.sub a \(b "*" { NatDivisionDef.div a b }\) :=
  \block {
    \fun (a, b: Nat^) \then
    \let reconstruction:
      \({ NatDivisionDef.mod a b } "+" (b "*" { NatDivisionDef.div a b })\) = a :=
      trans!{Nat^} _ _ _
        (Basic.addComm (NatDivisionDef.mod a b) \(b "*" { NatDivisionDef.div a b }\))
        (divModReconstructs a b) \then
    \let subtractReconstruction:
      Op.sub \({ NatDivisionDef.mod a b } "+" (b "*" { NatDivisionDef.div a b })\)
        \(b "*" { NatDivisionDef.div a b }\) =
      Op.sub a \(b "*" { NatDivisionDef.div a b }\) :=
      congr!{Nat^ Nat^} (\fun (x: Nat^) => Op.sub x \(b "*" { NatDivisionDef.div a b }\))
        _ _ reconstruction \then
    \return trans!{Nat^} _ _ _
      (sym!{Nat^} _ _ (Basic.subAddCancel \(b "*" { NatDivisionDef.div a b }\) (NatDivisionDef.mod a b)))
      subtractReconstruction
  };
\definition dividesMod:
  \forall (d, a, b: Nat^) -> Divides d a -> Divides d b -> Divides d (NatDivisionDef.mod a b) :=
  \block {
    \fun (d, a, b: Nat^) \then
    \fun (ha: Divides d a) (hb: Divides d b) \then
    \let productDivides: Divides d \(b "*" { NatDivisionDef.div a b }\) :=
      dividesMul d b (NatDivisionDef.div a b) hb \then
    \let differenceDivides: Divides d (Op.sub a \(b "*" { NatDivisionDef.div a b }\)) :=
      dividesSub d a \(b "*" { NatDivisionDef.div a b }\) ha productDivides \then
    \return dividesTransport d (Op.sub a \(b "*" { NatDivisionDef.div a b }\)) (NatDivisionDef.mod a b)
      (sym!{Nat^} _ _ (modAsSub a b)) differenceDivides
  };
\definition dividesOfMod:
  \forall (d, a, b: Nat^) -> Divides d b -> Divides d (NatDivisionDef.mod a b) -> Divides d a :=
  \block {
    \fun (d, a, b: Nat^) \then
    \fun (hb: Divides d b) (hr: Divides d (NatDivisionDef.mod a b)) \then
    \let quotientProductDivides: Divides d \(b "*" { NatDivisionDef.div a b }\) :=
      dividesMul d b (NatDivisionDef.div a b) hb \then
    \let reconstructionDivides:
      Divides d \((b "*" { NatDivisionDef.div a b }) "+" { NatDivisionDef.mod a b }\) :=
      dividesAdd d \(b "*" { NatDivisionDef.div a b }\) (NatDivisionDef.mod a b) quotientProductDivides hr \then
    \return dividesTransport d \((b "*" { NatDivisionDef.div a b }) "+" { NatDivisionDef.mod a b }\) a
      (divModReconstructs a b) reconstructionDivides
  };

\definition leToLtSucc: \forall (d, r: Nat^) -> Basic.Le r d -> Basic.Lt r (Nat^::succ d) :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Basic.Le r d -> Basic.Lt r (Nat^::succ d) \with {
    | zero : (\induction (r: Nat^) \return Basic.Le r Nat^::zero -> Basic.Lt r (Nat^::succ Nat^::zero) \with {
      | zero : (\fun (h: Basic.Le Nat^::zero Nat^::zero) => \refl(B.Bool^::true))
      | succ : (\fun (r: Nat^) => \fun (ih: Basic.Le r Nat^::zero -> Basic.Lt r (Nat^::succ Nat^::zero)) =>
        \fun (h: Basic.Le (Nat^::succ r) Nat^::zero) => BoolLaws.absurd (Basic.Lt (Nat^::succ r) (Nat^::succ Nat^::zero)) h)
      })
    | succ : (\fun (d: Nat^) => \fun (ih: \forall (r: Nat^) -> Basic.Le r d -> Basic.Lt r (Nat^::succ d)) =>
      \induction (r: Nat^) \return Basic.Le r (Nat^::succ d) -> Basic.Lt r (Nat^::succ (Nat^::succ d)) \with {
      | zero : (\fun (h: Basic.Le Nat^::zero (Nat^::succ d)) => \refl(B.Bool^::true))
      | succ : (\fun (r: Nat^) => \fun (unused: Basic.Le r (Nat^::succ d) -> Basic.Lt r (Nat^::succ (Nat^::succ d))) =>
          \fun (h: Basic.Le (Nat^::succ r) (Nat^::succ d)) => ih r h)
      })
    };
\definition modLt(a, d: Nat^): Basic.Lt (NatDivisionDef.mod a (Nat^::succ d)) (Nat^::succ d) := leToLtSucc d (NatDivisionDef.mod a (Nat^::succ d)) (modBound a d);
\definition divModOne:
  \forall (a: Nat^) -> NatDivisionDef.divMod a (Nat^::succ Nat^::zero) = NatPairDef.natPair a Nat^::zero :=
  \induction (a: Nat^) \return NatDivisionDef.divMod a (Nat^::succ Nat^::zero) = NatPairDef.natPair a Nat^::zero \with {
    | zero : (\refl(NatPairDef.natPair Nat^::zero Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: NatDivisionDef.divMod a (Nat^::succ Nat^::zero) = NatPairDef.natPair a Nat^::zero) =>
      congr!{NatPairDef.NatPair NatPairDef.NatPair} (NatDivisionDef.divModNext (Nat^::succ Nat^::zero))
        (NatDivisionDef.divMod a (Nat^::succ Nat^::zero)) (NatPairDef.natPair a Nat^::zero) ih)
    };
\definition divOne(a: Nat^): NatDivisionDef.div a (Nat^::succ Nat^::zero) = a :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModOne a);
\definition modOne(a: Nat^): NatDivisionDef.mod a (Nat^::succ Nat^::zero) = Nat^::zero :=
  congr!{NatPairDef.NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModOne a);

\definition dividesZeroLeft(a: Nat^):
  Divides Nat^::zero a -> a = Nat^::zero := \block {
    \fun (h: _) \then
    \takefrom q: Factors Nat^::zero a \by h \then
    \let result: a = Nat^::zero :=
      trans!{Nat^} _ _ _ (factorEquation Nat^::zero a q) (Basic.mulZeroLeft q) \then
    \return result
  };

\definition dividesLeSucc(d, a: Nat^):
  Divides d (Nat^::succ a) -> Basic.Le d (Nat^::succ a) := \block {
    \fun (h: _) \then
    \takefrom q: Factors d (Nat^::succ a) \by h \then
    \return (\induction (q: Nat^) \return
      Nat^::succ a = Op.mul d q -> Basic.Le d (Nat^::succ a) \with {
      | zero: \fun (e: _) => Basic.succEqZeroElim a (Basic.Le d (Nat^::succ a)) e
      | succ: \fun (q: _) (unused: _) (e: _) =>
        transport!{Nat^} (Basic.Le d) _ _ (sym!{Nat^} _ _ e)
          (Basic.leAddRight d (Op.mul d q))
    }) q (factorEquation d (Nat^::succ a) q)
  };

\definition dividesAntisym: \forall (a, b: Nat^) -> Divides a b -> Divides b a -> a = b :=
  \induction (a: Nat^) \return
    \forall (b: Nat^) -> Divides a b -> Divides b a -> a = b \with {
    | zero: \fun (b: Nat^) (ab: _) (ba: _) =>
      sym!{Nat^} _ _ (dividesZeroLeft b ab)
    | succ: \fun (a: Nat^) (unused: _) =>
      \induction (b: Nat^) \return
        Divides (Nat^::succ a) b -> Divides b (Nat^::succ a) -> Nat^::succ a = b \with {
        | zero: \fun (ab: _) (ba: _) => dividesZeroLeft (Nat^::succ a) ba
        | succ: \fun (b: Nat^) (unused: _) (ab: _) (ba: _) =>
          Basic.leAntisym (Nat^::succ a) (Nat^::succ b)
            (dividesLeSucc (Nat^::succ a) b ab)
            (dividesLeSucc (Nat^::succ b) a ba)
      }
  };
