\definition bindAssoc (value: Option[A]) (f: A -> Option[C]) (g: C -> Option[D]):
  bind C D (bind A C value f) g =
    bind A D value (\fun (element: A) => bind C D (f element) g) :=
  \match value \in Option \return (\fun (current: Option[A]) =>
      bind C D (bind A C current f) g =
        bind A D current (\fun (element: A) => bind C D (f element) g)) \with {
    | none : (\refl(Option[D]::none))
    | some element : \refl(bind C D (f element) g)
    };
