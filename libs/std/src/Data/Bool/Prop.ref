/* Boolean algebra and equality laws. */
\import std.Logic[].Algebra[].Def[] \as Law;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;

\definition negInvolutive: \forall (x: Bool^) -> Neg.specification (Neg.specification x) = x :=
  cases (\fun (x: _) => Neg.specification (Neg.specification x) = x)
    (\refl(Bool^::false))
    (\refl(Bool^::true));

\definition andIdem: Law.Idempotent Bool^ And.specification :=
  cases (\fun (x: _) => And.specification x x = x)
    (\refl(Bool^::false))
    (\refl(Bool^::true));

\definition orIdem: Law.Idempotent Bool^ Or.specification :=
  cases (\fun (x: _) => Or.specification x x = x)
    (\refl(Bool^::false))
    (\refl(Bool^::true));

\definition xorSelf: \forall (x: Bool^) -> Xor.specification x x = Bool^::false :=
  cases (\fun (x: _) => Xor.specification x x = Bool^::false)
    (\refl(Bool^::false))
    (\refl(Bool^::false));

\definition eqbRefl: \forall (x: Bool^) -> Eqb.specification x x = Bool^::true :=
  cases (\fun (x: _) => Eqb.specification x x = Bool^::true)
    (\refl(Bool^::true))
    (\refl(Bool^::true));

\definition andComm: Law.Commutative Bool^ And.specification :=
  cases2 (\fun (x, y: _) => And.specification x y = And.specification y x)
    (\refl(And.specification Bool^::false Bool^::false))
    (\refl(And.specification Bool^::true Bool^::false))
    (\refl(And.specification Bool^::false Bool^::true))
    (\refl(And.specification Bool^::true Bool^::true));

\definition orComm: Law.Commutative Bool^ Or.specification :=
  cases2 (\fun (x, y: _) => Or.specification x y = Or.specification y x)
    (\refl(Or.specification Bool^::false Bool^::false))
    (\refl(Or.specification Bool^::true Bool^::false))
    (\refl(Or.specification Bool^::false Bool^::true))
    (\refl(Or.specification Bool^::true Bool^::true));

\definition xorComm: Law.Commutative Bool^ Xor.specification :=
  cases2 (\fun (x, y: _) => Xor.specification x y = Xor.specification y x)
    (\refl(Xor.specification Bool^::false Bool^::false))
    (\refl(Xor.specification Bool^::true Bool^::false))
    (\refl(Xor.specification Bool^::false Bool^::true))
    (\refl(Xor.specification Bool^::true Bool^::true));

\definition deMorganAnd:
  \forall (x, y: Bool^) -> Neg.specification (And.specification x y) = Or.specification (Neg.specification x) (Neg.specification y) :=
  cases2 (\fun (x, y: _) => Neg.specification (And.specification x y) = Or.specification (Neg.specification x) (Neg.specification y))
    (\refl(Or.specification (Neg.specification Bool^::false) (Neg.specification Bool^::false)))
    (\refl(Or.specification (Neg.specification Bool^::false) (Neg.specification Bool^::true)))
    (\refl(Or.specification (Neg.specification Bool^::true) (Neg.specification Bool^::false)))
    (\refl(Or.specification (Neg.specification Bool^::true) (Neg.specification Bool^::true)));

\definition deMorganOr:
  \forall (x, y: Bool^) -> Neg.specification (Or.specification x y) = And.specification (Neg.specification x) (Neg.specification y) :=
  cases2 (\fun (x, y: _) => Neg.specification (Or.specification x y) = And.specification (Neg.specification x) (Neg.specification y))
    (\refl(And.specification (Neg.specification Bool^::false) (Neg.specification Bool^::false)))
    (\refl(And.specification (Neg.specification Bool^::false) (Neg.specification Bool^::true)))
    (\refl(And.specification (Neg.specification Bool^::true) (Neg.specification Bool^::false)))
    (\refl(And.specification (Neg.specification Bool^::true) (Neg.specification Bool^::true)));

\definition andAbsorb: \forall (x, y: Bool^) -> And.specification x (Or.specification x y) = x :=
  cases (\fun (x: _) => \forall (y: Bool^) -> And.specification x (Or.specification x y) = x)
    (\fun (y: _) => \refl(Bool^::false))
    (\fun (y: _) => \refl(Bool^::true));

\definition orAbsorb: \forall (x, y: Bool^) -> Or.specification x (And.specification x y) = x :=
  cases (\fun (x: _) => \forall (y: Bool^) -> Or.specification x (And.specification x y) = x)
    (\fun (y: _) => \refl(Bool^::false))
    (\fun (y: _) => \refl(Bool^::true));

\definition andAssoc: Law.Associative Bool^ And.specification :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    And.specification (And.specification x y) z = And.specification x (And.specification y z))
    (\fun (y, z: _) => \refl(And.specification Bool^::false (And.specification y z)))
    (\fun (y, z: _) => \refl(And.specification Bool^::true (And.specification y z)));

\definition orAssoc: Law.Associative Bool^ Or.specification :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    Or.specification (Or.specification x y) z = Or.specification x (Or.specification y z))
    (\fun (y, z: _) => \refl(Or.specification Bool^::false (Or.specification y z)))
    (\fun (y, z: _) => \refl(Or.specification Bool^::true (Or.specification y z)));

\definition xorAssoc: Law.Associative Bool^ Xor.specification :=
  cases2 (\fun (x, y: _) => \forall (z: Bool^) ->
    Xor.specification (Xor.specification x y) z = Xor.specification x (Xor.specification y z))
    (\fun (z: _) => \refl(z))
    (\fun (z: _) => \refl(Neg.specification z))
    (\fun (z: _) => \refl(Neg.specification z))
    (\fun (z: _) => sym!{Bool^} _ _ (negInvolutive z));

\definition andDistrib: Law.LeftDistributive Bool^ And.specification Or.specification :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    And.specification x (Or.specification y z) = Or.specification (And.specification x y) (And.specification x z))
    (\fun (y, z: _) => \refl(Or.specification (And.specification Bool^::false y) (And.specification Bool^::false z)))
    (\fun (y, z: _) => \refl(Or.specification (And.specification Bool^::true y) (And.specification Bool^::true z)));

\definition orDistrib: Law.LeftDistributive Bool^ Or.specification And.specification :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    Or.specification x (And.specification y z) = And.specification (Or.specification x y) (Or.specification x z))
    (\fun (y, z: _) => \refl(And.specification (Or.specification Bool^::false y) (Or.specification Bool^::false z)))
    (\fun (y, z: _) => \refl(And.specification (Or.specification Bool^::true y) (Or.specification Bool^::true z)));

\definition falseNeTrue: NotEq Bool^::false Bool^::true :=
  \block {
    \fun (e: Bool^::false = Bool^::true) \then
    \return \idelim Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\match b \in Bool^ \return (\fun (b: Bool^) => \Pow Bool^) \with {
        | false : ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true : ({ x : Bool^ \where Logic.False })
        }) Bool^::false
    \by { base: \refl(Bool^::false), equality: e }
  };
\definition trueNeFalse: NotEq Bool^::true Bool^::false :=
  \block {
    \fun (e: Bool^::true = Bool^::false) \then
    \let reversed: Bool^::false = Bool^::true :=
      \idelim Bool^::true = Bool^::false \with b: Bool^ => b = Bool^::true
        \by { base: \refl(Bool^::true), equality: e } \then
    \return falseNeTrue reversed
  };
\definition absurd: \forall (P: \Prop) -> Bool^::false = Bool^::true -> P :=
  \fun (P: \Prop) (e: Bool^::false = Bool^::true) => Logic.falseElim P (falseNeTrue e);
\definition falseEqDecidable(y: Bool^): Logic.Or[Bool^::false = y, Logic.Not (Bool^::false = y)] :=
  \match y \in Bool^ \return (\fun (y: Bool^) => Logic.Or[
      Bool^::false = y, Logic.Not (Bool^::false = y)]) \with {
    | false : Logic.Or[
        Bool^::false = Bool^::false,
        Logic.Not (Bool^::false = Bool^::false)
      ]::left (\refl(Bool^::false))
    | true : Logic.Or[
        Bool^::false = Bool^::true,
        Logic.Not (Bool^::false = Bool^::true)
      ]::right falseNeTrue
    };

\definition trueEqDecidable(y: Bool^): Logic.Or[Bool^::true = y, Logic.Not (Bool^::true = y)] :=
  \match y \in Bool^ \return (\fun (y: Bool^) => Logic.Or[
      Bool^::true = y, Logic.Not (Bool^::true = y)]) \with {
    | false : Logic.Or[
        Bool^::true = Bool^::false,
        Logic.Not (Bool^::true = Bool^::false)
      ]::right trueNeFalse
    | true : Logic.Or[
        Bool^::true = Bool^::true,
        Logic.Not (Bool^::true = Bool^::true)
      ]::left (\refl(Bool^::true))
    };

\definition eqDecidable: \forall (x, y: Bool^) -> Logic.Or[x = y, Logic.Not (x = y)] :=
  \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (x: Bool^) =>
      \forall (y: Bool^) -> Logic.Or[x = y, Logic.Not (x = y)]) \with {
      | false : falseEqDecidable
      | true : trueEqDecidable
      } y;

\definition eqOfEqbTrue: \forall (a, b: Bool^) -> IsTrue (Eqb.specification a b) -> a = b :=
  cases2 (\fun (a, b: _) => IsTrue (Eqb.specification a b) -> a = b)
    (\fun (e: _) => \refl(Bool^::false))
    (\fun (e: _) => absurd (Bool^::false = Bool^::true) e)
    (\fun (e: _) => absurd (Bool^::true = Bool^::false) e)
    (\fun (e: _) => \refl(Bool^::true));
\definition eqbTrueOfEq: \forall (a, b: Bool^) -> a = b -> IsTrue (Eqb.specification a b) :=
  \block {
    \fun (a, b: Bool^) \then
    \fun (e: a = b) \then
    \return \idelim a = b \with x: Bool^ => IsTrue (Eqb.specification a x) \by { base: eqbRefl a, equality: e }
  };


\definition andTrueLeft: \forall (x, y: Bool^) -> And.specification x y = Bool^::true -> x = Bool^::true :=
  cases (\fun (x: Bool^) => \forall (y: Bool^) -> And.specification x y = Bool^::true -> x = Bool^::true)
    (\fun (y: Bool^)(bad: Bool^::false = Bool^::true) => absurd (Bool^::false = Bool^::true) bad)
    (\fun (y: Bool^)(equal: y = Bool^::true) => \refl(Bool^::true));
\definition andTrueRight: \forall (x, y: Bool^) -> And.specification x y = Bool^::true -> y = Bool^::true :=
  cases (\fun (x: Bool^) => \forall (y: Bool^) -> And.specification x y = Bool^::true -> y = Bool^::true)
    (\fun (y: Bool^)(bad: Bool^::false = Bool^::true) => absurd (y = Bool^::true) bad)
    (\fun (y: Bool^)(equal: y = Bool^::true) => equal);
\definition negTrue: \forall (x: Bool^) -> Neg.specification x = Bool^::true -> x = Bool^::false :=
  cases (\fun (x: Bool^) => Neg.specification x = Bool^::true -> x = Bool^::false)
    (\fun (equal: Bool^::true = Bool^::true) => \refl(Bool^::false))
    (\fun (bad: Bool^::false = Bool^::true) => absurd (Bool^::true = Bool^::false) bad);
\definition andFalseRight: \forall (x: Bool^) -> And.specification x Bool^::false = Bool^::false :=
  cases (\fun (x: Bool^) => And.specification x Bool^::false = Bool^::false)
    (\refl(Bool^::false)) (\refl(Bool^::false));
\definition negFalse: \forall (x: Bool^) -> Neg.specification x = Bool^::false -> x = Bool^::true :=
  cases (\fun (x: Bool^) => Neg.specification x = Bool^::false -> x = Bool^::true)
    (\fun (bad: Bool^::true = Bool^::false) => Logic.falseElim _ (trueNeFalse bad))
    (\fun (equal: Bool^::false = Bool^::false) => \refl(Bool^::true));
\definition andFalse: \forall (x, y: Bool^) -> And.specification x y = Bool^::false -> Logic.Or[x = Bool^::false, y = Bool^::false] :=
  cases (\fun (x: Bool^) => \forall (y: Bool^) -> And.specification x y = Bool^::false -> Logic.Or[x = Bool^::false, y = Bool^::false])
    (\fun (y: Bool^)(equal: Bool^::false = Bool^::false) => Logic.Or[_, _]::left (\refl(Bool^::false)))
    (\fun (y: Bool^)(equal: y = Bool^::false) => Logic.Or[_, _]::right equal);
