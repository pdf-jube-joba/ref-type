/* Boolean algebra and equality laws. */
\import std.Logic[].Algebra[].Def[] \as Law;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;

\definition negInvolutive: \forall (x: Bool^) -> Neg::[set] (Neg::[set] x) = x :=
  cases (\fun (x: _) => Neg::[set] (Neg::[set] x) = x)
    (\refl(Bool^::false))
    (\refl(Bool^::true));

\definition andIdem: Law.Idempotent Bool^ And::[set] :=
  cases (\fun (x: _) => And::[set] x x = x)
    (\refl(Bool^::false))
    (\refl(Bool^::true));

\definition orIdem: Law.Idempotent Bool^ Or::[set] :=
  cases (\fun (x: _) => Or::[set] x x = x)
    (\refl(Bool^::false))
    (\refl(Bool^::true));

\definition xorSelf: \forall (x: Bool^) -> Xor::[set] x x = Bool^::false :=
  cases (\fun (x: _) => Xor::[set] x x = Bool^::false)
    (\refl(Bool^::false))
    (\refl(Bool^::false));

\definition eqbRefl: \forall (x: Bool^) -> Eqb::[set] x x = Bool^::true :=
  cases (\fun (x: _) => Eqb::[set] x x = Bool^::true)
    (\refl(Bool^::true))
    (\refl(Bool^::true));

\definition andComm: Law.Commutative Bool^ And::[set] :=
  cases2 (\fun (x, y: _) => And::[set] x y = And::[set] y x)
    (\refl(And::[set] Bool^::false Bool^::false))
    (\refl(And::[set] Bool^::true Bool^::false))
    (\refl(And::[set] Bool^::false Bool^::true))
    (\refl(And::[set] Bool^::true Bool^::true));

\definition orComm: Law.Commutative Bool^ Or::[set] :=
  cases2 (\fun (x, y: _) => Or::[set] x y = Or::[set] y x)
    (\refl(Or::[set] Bool^::false Bool^::false))
    (\refl(Or::[set] Bool^::true Bool^::false))
    (\refl(Or::[set] Bool^::false Bool^::true))
    (\refl(Or::[set] Bool^::true Bool^::true));

\definition xorComm: Law.Commutative Bool^ Xor::[set] :=
  cases2 (\fun (x, y: _) => Xor::[set] x y = Xor::[set] y x)
    (\refl(Xor::[set] Bool^::false Bool^::false))
    (\refl(Xor::[set] Bool^::true Bool^::false))
    (\refl(Xor::[set] Bool^::false Bool^::true))
    (\refl(Xor::[set] Bool^::true Bool^::true));

\definition deMorganAnd:
  \forall (x, y: Bool^) -> Neg::[set] (And::[set] x y) = Or::[set] (Neg::[set] x) (Neg::[set] y) :=
  cases2 (\fun (x, y: _) => Neg::[set] (And::[set] x y) = Or::[set] (Neg::[set] x) (Neg::[set] y))
    (\refl(Or::[set] (Neg::[set] Bool^::false) (Neg::[set] Bool^::false)))
    (\refl(Or::[set] (Neg::[set] Bool^::false) (Neg::[set] Bool^::true)))
    (\refl(Or::[set] (Neg::[set] Bool^::true) (Neg::[set] Bool^::false)))
    (\refl(Or::[set] (Neg::[set] Bool^::true) (Neg::[set] Bool^::true)));

\definition deMorganOr:
  \forall (x, y: Bool^) -> Neg::[set] (Or::[set] x y) = And::[set] (Neg::[set] x) (Neg::[set] y) :=
  cases2 (\fun (x, y: _) => Neg::[set] (Or::[set] x y) = And::[set] (Neg::[set] x) (Neg::[set] y))
    (\refl(And::[set] (Neg::[set] Bool^::false) (Neg::[set] Bool^::false)))
    (\refl(And::[set] (Neg::[set] Bool^::false) (Neg::[set] Bool^::true)))
    (\refl(And::[set] (Neg::[set] Bool^::true) (Neg::[set] Bool^::false)))
    (\refl(And::[set] (Neg::[set] Bool^::true) (Neg::[set] Bool^::true)));

\definition andAbsorb: \forall (x, y: Bool^) -> And::[set] x (Or::[set] x y) = x :=
  cases (\fun (x: _) => \forall (y: Bool^) -> And::[set] x (Or::[set] x y) = x)
    (\fun (y: _) => \refl(Bool^::false))
    (\fun (y: _) => \refl(Bool^::true));

\definition orAbsorb: \forall (x, y: Bool^) -> Or::[set] x (And::[set] x y) = x :=
  cases (\fun (x: _) => \forall (y: Bool^) -> Or::[set] x (And::[set] x y) = x)
    (\fun (y: _) => \refl(Bool^::false))
    (\fun (y: _) => \refl(Bool^::true));

\definition andAssoc: Law.Associative Bool^ And::[set] :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    And::[set] (And::[set] x y) z = And::[set] x (And::[set] y z))
    (\fun (y, z: _) => \refl(And::[set] Bool^::false (And::[set] y z)))
    (\fun (y, z: _) => \refl(And::[set] Bool^::true (And::[set] y z)));

\definition orAssoc: Law.Associative Bool^ Or::[set] :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    Or::[set] (Or::[set] x y) z = Or::[set] x (Or::[set] y z))
    (\fun (y, z: _) => \refl(Or::[set] Bool^::false (Or::[set] y z)))
    (\fun (y, z: _) => \refl(Or::[set] Bool^::true (Or::[set] y z)));

\definition xorAssoc: Law.Associative Bool^ Xor::[set] :=
  cases2 (\fun (x, y: _) => \forall (z: Bool^) ->
    Xor::[set] (Xor::[set] x y) z = Xor::[set] x (Xor::[set] y z))
    (\fun (z: _) => \refl(z))
    (\fun (z: _) => \refl(Neg::[set] z))
    (\fun (z: _) => \refl(Neg::[set] z))
    (\fun (z: _) => sym!{Bool^} _ _ (negInvolutive z));

\definition andDistrib: Law.LeftDistributive Bool^ And::[set] Or::[set] :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    And::[set] x (Or::[set] y z) = Or::[set] (And::[set] x y) (And::[set] x z))
    (\fun (y, z: _) => \refl(Or::[set] (And::[set] Bool^::false y) (And::[set] Bool^::false z)))
    (\fun (y, z: _) => \refl(Or::[set] (And::[set] Bool^::true y) (And::[set] Bool^::true z)));

\definition orDistrib: Law.LeftDistributive Bool^ Or::[set] And::[set] :=
  cases (\fun (x: _) => \forall (y, z: Bool^) ->
    Or::[set] x (And::[set] y z) = And::[set] (Or::[set] x y) (Or::[set] x z))
    (\fun (y, z: _) => \refl(And::[set] (Or::[set] Bool^::false y) (Or::[set] Bool^::false z)))
    (\fun (y, z: _) => \refl(And::[set] (Or::[set] Bool^::true y) (Or::[set] Bool^::true z)));

\definition falseNeTrue: NotEq Bool^::false Bool^::true :=
  \block {
    \fun (e: Bool^::false = Bool^::true) \then
    \return \idelim Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\match b \in Bool^ \return (\fun (b: Bool^) => \Pow Bool^) \with {
        | false : ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true : ({ x : Bool^ \where Logic.False })
        }) Bool^::false
    \by { base: \refl(Bool^::false), equality: e }
  };
\definition trueNeFalse: NotEq Bool^::true Bool^::false :=
  \block {
    \fun (e: Bool^::true = Bool^::false) \then
    \let reversed: Bool^::false = Bool^::true :=
      \idelim Bool^::true = Bool^::false \with b: Bool^ => b = Bool^::true
        \by { base: \refl(Bool^::true), equality: e } \then
    \return falseNeTrue reversed
  };
\definition absurd: \forall (P: \Prop) -> Bool^::false = Bool^::true -> P :=
  \block {
    \fun (P: \Prop) \then
    \fun (e: Bool^::false = Bool^::true) \then
    \return \idelim Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\match b \in Bool^ \return (\fun (b: Bool^) => \Pow Bool^) \with {
        | false : ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true : ({ x : Bool^ \where P })
        }) Bool^::false
    \by { base: \refl(Bool^::false), equality: e }
  };
\definition falseEqDecidable(y: Bool^): Logic.Or[Bool^::false = y, Logic.Not (Bool^::false = y)] :=
  \match y \in Bool^ \return (\fun (y: Bool^) => Logic.Or[
      Bool^::false = y, Logic.Not (Bool^::false = y)]) \with {
    | false : Logic.Or[
        Bool^::false = Bool^::false,
        Logic.Not (Bool^::false = Bool^::false)
      ]::left (\refl(Bool^::false))
    | true : Logic.Or[
        Bool^::false = Bool^::true,
        Logic.Not (Bool^::false = Bool^::true)
      ]::right falseNeTrue
    };

\definition trueEqDecidable(y: Bool^): Logic.Or[Bool^::true = y, Logic.Not (Bool^::true = y)] :=
  \match y \in Bool^ \return (\fun (y: Bool^) => Logic.Or[
      Bool^::true = y, Logic.Not (Bool^::true = y)]) \with {
    | false : Logic.Or[
        Bool^::true = Bool^::false,
        Logic.Not (Bool^::true = Bool^::false)
      ]::right trueNeFalse
    | true : Logic.Or[
        Bool^::true = Bool^::true,
        Logic.Not (Bool^::true = Bool^::true)
      ]::left (\refl(Bool^::true))
    };

\definition eqDecidable: \forall (x, y: Bool^) -> Logic.Or[x = y, Logic.Not (x = y)] :=
  \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (x: Bool^) =>
      \forall (y: Bool^) -> Logic.Or[x = y, Logic.Not (x = y)]) \with {
      | false : falseEqDecidable
      | true : trueEqDecidable
      } y;

\definition eqOfEqbTrue: \forall (a, b: Bool^) -> IsTrue (Eqb::[set] a b) -> a = b :=
  \induction (a: Bool^) \return \forall (b: Bool^) -> IsTrue (Eqb::[set] a b) -> a = b \with {
    | false : (\induction (b: Bool^) \return IsTrue (Eqb::[set] Bool^::false b) -> Bool^::false = b \with {
      | false : (\fun (e: Bool^::true = Bool^::true) => \refl(Bool^::false))
      | true : (\fun (e: Bool^::false = Bool^::true) => absurd (Bool^::false = Bool^::true) e)
      })
    | true : (\induction (b: Bool^) \return IsTrue (Eqb::[set] Bool^::true b) -> Bool^::true = b \with {
      | false : (\fun (e: Bool^::false = Bool^::true) => absurd (Bool^::true = Bool^::false) e)
      | true : (\fun (e: Bool^::true = Bool^::true) => \refl(Bool^::true))
      })
    };
\definition eqbTrueOfEq: \forall (a, b: Bool^) -> a = b -> IsTrue (Eqb::[set] a b) :=
  \block {
    \fun (a, b: Bool^) \then
    \fun (e: a = b) \then
    \return \idelim a = b \with x: Bool^ => IsTrue (Eqb::[set] a x) \by { base: eqbRefl a, equality: e }
  };

