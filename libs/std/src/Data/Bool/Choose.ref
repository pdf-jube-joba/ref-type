\definition T: \VType := \U(Bool -> A -> A -> A);
\definition program: T := \thunk (\cfun (test: Bool) => \return(\thunk (\cfun (yes: A) => \return(\thunk (\cfun (no: A) =>
  \match test \in Bool \with {
    | false: \return no
    | true: \return yes
  })))));
\definition matches: \forall (test: Bool^)(yes, no: A^) -> program^ test yes no = ite A^ test yes no :=
  cases (\fun (test: Bool^) => \forall (yes, no: A^) -> program^ test yes no = ite A^ test yes no)
    (\fun (yes, no: A^) => \refl(no)) (\fun (yes, no: A^) => \refl(yes));
\definition coherence: program^ = ite A^ := \axiom:funext(program^, ite A^,
  \fun (test: Bool^) => \axiom:funext(program^ test, ite A^ test,
    \fun (yes: A^) => \axiom:funext(program^ test yes, ite A^ test yes, matches test yes)));
