/* Fin n is the canonical n-point Set. */
\import \root.Nat[] \as N;
\import .N.Laws[] \as NL;
\import \root.Data[].Bool[] \as B;

\definition Fin(n: N.Nat^): \Set :=
  \Cast[N.Nat^] ({ k : N.Nat^ \where NL.Lt k n });

\definition value(n: N.Nat^) (i: Fin n): N.Nat^ := i;

\definition bound(n: N.Nat^) (i: Fin n): NL.Lt (value n i) n :=
  \bysub(N.Nat^, { k : N.Nat^ \where NL.Lt k n }, i);

\definition zero(n: N.Nat^): Fin (N.Nat^::succ n) :=
  \into[N.Nat^](N.Nat^::zero, { k : N.Nat^ \where NL.Lt k (N.Nat^::succ n) }) \by { \refl(B.Bool^::true) };

\definition succ(n: N.Nat^) (i: Fin n): Fin (N.Nat^::succ n) :=
  \into[N.Nat^](N.Nat^::succ (value n i), { k : N.Nat^ \where NL.Lt k (N.Nat^::succ n) }) \by { NL.ltSuccSucc (value n i) n (bound n i) };
