/* Boolean operations and their certified Program implementations. */
\import std.Logic[].Proposition[] \as Logic;
\use Logic.not;
\definition False: \Prop := Logic.False;

\inductive Bool: \VType :=
| false: Bool
| true: Bool
;

\definition NotEq(x, y: Bool^): \Prop := not!{{ x = y }};
\definition IsTrue(b: Bool^): \Prop := b = Bool^::true;
\definition IsFalse(b: Bool^): \Prop := b = Bool^::false;

\definition cases(P: Bool^ -> \Prop): P Bool^::false -> P Bool^::true -> \forall (b: Bool^) -> P b :=
  \fun (onFalse: _) (onTrue: _) =>
    \induction (b: Bool^) \return P b \with {
    | false : onFalse
    | true : onTrue
    };

\definition cases2(P: Bool^ -> Bool^ -> \Prop):
  P Bool^::false Bool^::false -> P Bool^::false Bool^::true ->
  P Bool^::true Bool^::false -> P Bool^::true Bool^::true ->
  \forall (x, y: Bool^) -> P x y :=
  \fun (ff: _) (ft: _) (tf: _) (tt: _) =>
    cases (\fun (x: _) => \forall (y: Bool^) -> P x y)
      (cases (P Bool^::false) ff ft)
      (cases (P Bool^::true) tf tt);

\correspondence Neg: Bool -> Bool {
  \program := \fun (x: Bool) =>
    \match x \in Bool \with {
    | false : \return Bool::true
    | true : \return Bool::false
    },
  \set := \fun (x: Bool^) =>
    \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
    | false : Bool^::true
    | true : Bool^::false
    },

  \definition matches:
    \forall (x: Bool^) ->
    Neg::[program]^ x = Neg::[set] x :=
    cases (\fun (x: _) =>
      Neg::[program]^ x = Neg::[set] x)
      (\refl(Neg::[set] Bool^::false))
      (\refl(Neg::[set] Bool^::true));
  \coherence := \axiom:funext(Neg::[program]^, Neg::[set], matches),
}

\correspondence And: Bool -> Bool -> Bool {
  \program := \fun (x, y: Bool) =>
    \match x \in Bool \with {
    | false : \return Bool::false
    | true : \return y
    },
  \set := \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
    | false : Bool^::false
    | true : y
    },

  \definition matches:
    \forall (x, y: Bool^) ->
    And::[program]^ x y = And::[set] x y :=
    cases2 (\fun (x, y: _) =>
      And::[program]^ x y = And::[set] x y)
      (\refl(And::[set] Bool^::false Bool^::false))
      (\refl(And::[set] Bool^::false Bool^::true))
      (\refl(And::[set] Bool^::true Bool^::false))
      (\refl(And::[set] Bool^::true Bool^::true));
  \coherence := \axiom:funext(And::[program]^, And::[set],
    \fun (x: _) => \axiom:funext(And::[program]^ x, And::[set] x, matches x)),
}

\correspondence Or: Bool -> Bool -> Bool {
  \program := \fun (x, y: Bool) =>
    \match x \in Bool \with {
    | false : \return y
    | true : \return Bool::true
    },
  \set := \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
    | false : y
    | true : Bool^::true
    },

  \definition matches:
    \forall (x, y: Bool^) ->
    Or::[program]^ x y = Or::[set] x y :=
    cases2 (\fun (x, y: _) =>
      Or::[program]^ x y = Or::[set] x y)
      (\refl(Or::[set] Bool^::false Bool^::false))
      (\refl(Or::[set] Bool^::false Bool^::true))
      (\refl(Or::[set] Bool^::true Bool^::false))
      (\refl(Or::[set] Bool^::true Bool^::true));
  \coherence := \axiom:funext(Or::[program]^, Or::[set],
    \fun (x: _) => \axiom:funext(Or::[program]^ x, Or::[set] x, matches x)),
}

\correspondence Xor: Bool -> Bool -> Bool {
  \program := \fun (x, y: Bool) =>
    \match x \in Bool \with {
    | false : \return y
    | true : Neg::[program] y
    },
  \set := \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
    | false : y
    | true : Neg::[set] y
    },

  \definition matches:
    \forall (x, y: Bool^) ->
    Xor::[program]^ x y = Xor::[set] x y :=
    cases2 (\fun (x, y: _) =>
      Xor::[program]^ x y = Xor::[set] x y)
      (\refl(Xor::[set] Bool^::false Bool^::false))
      (\refl(Xor::[set] Bool^::false Bool^::true))
      (\refl(Xor::[set] Bool^::true Bool^::false))
      (\refl(Xor::[set] Bool^::true Bool^::true));
  \coherence := \axiom:funext(Xor::[program]^, Xor::[set],
    \fun (x: _) => \axiom:funext(Xor::[program]^ x, Xor::[set] x, matches x)),
}

\correspondence Implies: Bool -> Bool -> Bool {
  \program := \fun (x, y: Bool) =>
    \match x \in Bool \with {
    | false : \return Bool::true
    | true : \return y
    },
  \set := \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
    | false : Bool^::true
    | true : y
    },

  \definition matches:
    \forall (x, y: Bool^) ->
    Implies::[program]^ x y = Implies::[set] x y :=
    cases2 (\fun (x, y: _) =>
      Implies::[program]^ x y = Implies::[set] x y)
      (\refl(Implies::[set] Bool^::false Bool^::false))
      (\refl(Implies::[set] Bool^::false Bool^::true))
      (\refl(Implies::[set] Bool^::true Bool^::false))
      (\refl(Implies::[set] Bool^::true Bool^::true));
  \coherence := \axiom:funext(Implies::[program]^, Implies::[set],
    \fun (x: _) => \axiom:funext(Implies::[program]^ x, Implies::[set] x, matches x)),
}

\correspondence Eqb: Bool -> Bool -> Bool {
  \program := \fun (x, y: Bool) =>
    \match x \in Bool \with {
    | false : Neg::[program] y
    | true : \return y
    },
  \set := \fun (x, y: Bool^) =>
    \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
    | false : Neg::[set] y
    | true : y
    },

  \definition matches:
    \forall (x, y: Bool^) ->
    Eqb::[program]^ x y = Eqb::[set] x y :=
    cases2 (\fun (x, y: _) =>
      Eqb::[program]^ x y = Eqb::[set] x y)
      (\refl(Eqb::[set] Bool^::false Bool^::false))
      (\refl(Eqb::[set] Bool^::false Bool^::true))
      (\refl(Eqb::[set] Bool^::true Bool^::false))
      (\refl(Eqb::[set] Bool^::true Bool^::true));
  \coherence := \axiom:funext(Eqb::[program]^, Eqb::[set],
    \fun (x: _) => \axiom:funext(Eqb::[program]^ x, Eqb::[set] x, matches x)),
}

\definition ite(A: \Set) (test: Bool^) (yes, no: A): A :=
  \match test \in Bool^ \return (\fun (_: Bool^) => A) \with {
  | false : no
  | true : yes
  };

\module Prop;
\module ConditionalLaws(A: \Set);
