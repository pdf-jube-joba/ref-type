\import std.Program[] \as ProgramBundles;
/* Boolean operations and their certified Program implementations. */
\import std.Logic[].Proposition[] \as Logic;
\use Logic::not;
\definition False: \Prop := Logic.False;

\inductive Bool: \VType :=
| false: Bool
| true: Bool
;

\definition NotEq(x, y: Bool^): \Prop := not!{{ x = y }};
\definition IsTrue(b: Bool^): \Prop := b = Bool^::true;
\definition IsFalse(b: Bool^): \Prop := b = Bool^::false;

\definition cases(P: Bool^ -> \Prop): P Bool^::false -> P Bool^::true -> \forall (b: Bool^) -> P b :=
  \fun (onFalse: _) (onTrue: _) =>
    \induction (b: Bool^) \return P b \with {
    | false : onFalse
    | true : onTrue
    };

\definition cases2(P: Bool^ -> Bool^ -> \Prop):
  P Bool^::false Bool^::false -> P Bool^::false Bool^::true ->
  P Bool^::true Bool^::false -> P Bool^::true Bool^::true ->
  \forall (x, y: Bool^) -> P x y :=
  \fun (ff: _) (ft: _) (tf: _) (tt: _) =>
    cases (\fun (x: _) => \forall (y: Bool^) -> P x y)
      (cases (P Bool^::false) ff ft)
      (cases (P Bool^::true) tf tt);

\module NegImplementation {
  \definition T: \VType := \U(Bool -> Bool);

  \definition program: Bool -> Bool := \fun (x: Bool) =>
      \match x \in Bool \with {
      | false : \return Bool::true
      | true : \return Bool::false
      };

  \definition specification: T^ := \fun (x: Bool^) =>
      \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
      | false : Bool^::true
      | true : Bool^::false
      };

  \definition matches:
      \forall (x: Bool^) ->
      program^ x = specification x :=
      cases (\fun (x: _) =>
        program^ x = specification x)
        (\refl(specification Bool^::false))
        (\refl(specification Bool^::true));

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NegImplementation[] \as NegParts;
\definition Neg: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NegParts.T,
  program := \thunk (NegParts.program),
  specification := NegParts.specification,
  coherence := NegParts.coherence,
};

\module AndImplementation {
  \definition T: \VType := \U(Bool -> Bool -> Bool);

  \definition program: Bool -> Bool -> Bool := \fun (x, y: Bool) =>
      \match x \in Bool \with {
      | false : \return Bool::false
      | true : \return y
      };

  \definition specification: T^ := \fun (x, y: Bool^) =>
      \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
      | false : Bool^::false
      | true : y
      };

  \definition matches:
      \forall (x, y: Bool^) ->
      program^ x y = specification x y :=
      cases2 (\fun (x, y: _) =>
        program^ x y = specification x y)
        (\refl(specification Bool^::false Bool^::false))
        (\refl(specification Bool^::false Bool^::true))
        (\refl(specification Bool^::true Bool^::false))
        (\refl(specification Bool^::true Bool^::true));

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (x: _) => \axiom:funext(program^ x, specification x, matches x));
}
\import .AndImplementation[] \as AndParts;
\definition And: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := AndParts.T,
  program := \thunk (AndParts.program),
  specification := AndParts.specification,
  coherence := AndParts.coherence,
};

\module OrImplementation {
  \definition T: \VType := \U(Bool -> Bool -> Bool);

  \definition program: Bool -> Bool -> Bool := \fun (x, y: Bool) =>
      \match x \in Bool \with {
      | false : \return y
      | true : \return Bool::true
      };

  \definition specification: T^ := \fun (x, y: Bool^) =>
      \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
      | false : y
      | true : Bool^::true
      };

  \definition matches:
      \forall (x, y: Bool^) ->
      program^ x y = specification x y :=
      cases2 (\fun (x, y: _) =>
        program^ x y = specification x y)
        (\refl(specification Bool^::false Bool^::false))
        (\refl(specification Bool^::false Bool^::true))
        (\refl(specification Bool^::true Bool^::false))
        (\refl(specification Bool^::true Bool^::true));

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (x: _) => \axiom:funext(program^ x, specification x, matches x));
}
\import .OrImplementation[] \as OrParts;
\definition Or: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := OrParts.T,
  program := \thunk (OrParts.program),
  specification := OrParts.specification,
  coherence := OrParts.coherence,
};

\module XorImplementation {
  \definition T: \VType := \U(Bool -> Bool -> Bool);

  \definition program: Bool -> Bool -> Bool := \fun (x, y: Bool) =>
      \match x \in Bool \with {
      | false : \return y
      | true : (\force Neg.program) y
      };

  \definition specification: T^ := \fun (x, y: Bool^) =>
      \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
      | false : y
      | true : Neg.specification y
      };

  \definition matches:
      \forall (x, y: Bool^) ->
      program^ x y = specification x y :=
      cases2 (\fun (x, y: _) =>
        program^ x y = specification x y)
        (\refl(specification Bool^::false Bool^::false))
        (\refl(specification Bool^::false Bool^::true))
        (\refl(specification Bool^::true Bool^::false))
        (\refl(specification Bool^::true Bool^::true));

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (x: _) => \axiom:funext(program^ x, specification x, matches x));
}
\import .XorImplementation[] \as XorParts;
\definition Xor: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := XorParts.T,
  program := \thunk (XorParts.program),
  specification := XorParts.specification,
  coherence := XorParts.coherence,
};

\module ImpliesImplementation {
  \definition T: \VType := \U(Bool -> Bool -> Bool);

  \definition program: Bool -> Bool -> Bool := \fun (x, y: Bool) =>
      \match x \in Bool \with {
      | false : \return Bool::true
      | true : \return y
      };

  \definition specification: T^ := \fun (x, y: Bool^) =>
      \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
      | false : Bool^::true
      | true : y
      };

  \definition matches:
      \forall (x, y: Bool^) ->
      program^ x y = specification x y :=
      cases2 (\fun (x, y: _) =>
        program^ x y = specification x y)
        (\refl(specification Bool^::false Bool^::false))
        (\refl(specification Bool^::false Bool^::true))
        (\refl(specification Bool^::true Bool^::false))
        (\refl(specification Bool^::true Bool^::true));

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (x: _) => \axiom:funext(program^ x, specification x, matches x));
}
\import .ImpliesImplementation[] \as ImpliesParts;
\definition Implies: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := ImpliesParts.T,
  program := \thunk (ImpliesParts.program),
  specification := ImpliesParts.specification,
  coherence := ImpliesParts.coherence,
};

\module EqbImplementation {
  \definition T: \VType := \U(Bool -> Bool -> Bool);

  \definition program: Bool -> Bool -> Bool := \fun (x, y: Bool) =>
      \match x \in Bool \with {
      | false : (\force Neg.program) y
      | true : \return y
      };

  \definition specification: T^ := \fun (x, y: Bool^) =>
      \match x \in Bool^ \return (\fun (_: Bool^) => Bool^) \with {
      | false : Neg.specification y
      | true : y
      };

  \definition matches:
      \forall (x, y: Bool^) ->
      program^ x y = specification x y :=
      cases2 (\fun (x, y: _) =>
        program^ x y = specification x y)
        (\refl(specification Bool^::false Bool^::false))
        (\refl(specification Bool^::false Bool^::true))
        (\refl(specification Bool^::true Bool^::false))
        (\refl(specification Bool^::true Bool^::true));

  \definition coherence: program^ = specification := \axiom:funext(program^, specification,
      \fun (x: _) => \axiom:funext(program^ x, specification x, matches x));
}
\import .EqbImplementation[] \as EqbParts;
\definition Eqb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := EqbParts.T,
  program := \thunk (EqbParts.program),
  specification := EqbParts.specification,
  coherence := EqbParts.coherence,
};

\definition ite(A: \Set) (test: Bool^) (yes, no: A): A :=
  \match test \in Bool^ \return (\fun (_: Bool^) => A) \with {
  | false : no
  | true : yes
  };

\module Prop;
\module ConditionalLaws(A: \Set);

\module Choose(A: \VType);
