/* Results of a three-way comparison. */
\inductive Ordering: \VType :=
| Less: Ordering
| Equal: Ordering
| Greater: Ordering
;

\definition isLess (ordering: Ordering^): \Prop :=
  ordering = Ordering^::Less;

\definition isEqual (ordering: Ordering^): \Prop :=
  ordering = Ordering^::Equal;

\definition isGreater (ordering: Ordering^): \Prop :=
  ordering = Ordering^::Greater;
