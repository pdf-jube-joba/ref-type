/* A bijection bundles inverse functions with their two inverse laws. */
\structure BijectionData: \Set {
  forward: A -> B,
  backward: B -> A,
}

\structure BijectionLaws[data: BijectionData]: \Prop {
  leftInverse: \forall (a: A) -> data.backward (data.forward a) = a,
  rightInverse: \forall (b: B) -> data.forward (data.backward b) = b,
}

\definition Bijection: \Set :=
  \Cast[BijectionData] ({ data: BijectionData \where BijectionLaws[data] });

\definition LeftInverse(b: BijectionData): \Prop :=
  \forall (a: A) -> #backward{b} (#forward{b} a) = a;

\definition RightInverse(b: BijectionData): \Prop :=
  \forall (bValue: B) -> #forward{b} (#backward{b} bValue) = bValue;
