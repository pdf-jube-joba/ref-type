/* A bijection bundles inverse functions with their two inverse laws. */
\definition LeftInverse(forward: A -> B)(backward: B -> A): \Prop :=
  \forall (a: A) -> backward (forward a) = a;

\definition RightInverse(forward: A -> B)(backward: B -> A): \Prop :=
  \forall (b: B) -> forward (backward b) = b;

\structure Bijection: \Set {
  forward: A -> B,
  backward: B -> A,
  leftInverse: LeftInverse forward backward,
  rightInverse: RightInverse forward backward,
}
