/* A bijection bundles inverse functions with their two inverse laws. */
\structure Bijection: \Set {
  forward: A -> B,
  backward: B -> A,
} \where {
  leftInverse: \forall (a: A) -> backward (forward a) = a,
  rightInverse: \forall (b: B) -> forward (backward b) = b,
}

\definition LeftInverse(b: Bijection::[Raw]): \Prop :=
  \forall (a: A) -> #backward{b} (#forward{b} a) = a;

\definition RightInverse(b: Bijection::[Raw]): \Prop :=
  \forall (bValue: B) -> #forward{b} (#backward{b} bValue) = bValue;
