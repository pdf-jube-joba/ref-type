/* Optional values over an arbitrary Set carrier. */
\import std.Data[].Bool[] \as B;
\import std.Data[].List[] \as L;

\inductive Option[A: \Set]: \Set :=
| none: Option
| some: A -> Option
;

\definition map (A, C: \Set) (f: A -> C) (value: Option[A]): Option[C] :=
  \match value \in Option \return (\fun (value: Option[A]) => Option[C]) \with {
    | none : (Option[C]::none)
    | some element : Option[C]::some (f element)
    };

\definition bind (A, C: \Set) (value: Option[A]) (f: A -> Option[C]): Option[C] :=
  \match value \in Option \return (\fun (value: Option[A]) => Option[C]) \with {
    | none : (Option[C]::none)
    | some element : f element
    };

\definition filter (A: \Set) (predicate: A -> B.Bool^) (value: Option[A]): Option[A] :=
  \match value \in Option \return (\fun (value: Option[A]) => Option[A]) \with {
    | none : (Option[A]::none)
    | some element :
      \match predicate element \in B.Bool^ \return (\fun (result: B.Bool^) => Option[A]) \with {
        | false : (Option[A]::none)
        | true : (Option[A]::some element)
        }
    };

\definition toList (A: \Set) (value: Option[A]): L.List[A] :=
  \match value \in Option \return (\fun (value: Option[A]) => L.List[A]) \with {
    | none : (L.List[A]::nil)
    | some element : L.List[A]::cons element L.List[A]::nil
    };

\module Laws(A: \Set);
