\module At(k: N.Nat^, f: Fin (N.Nat^::succ k) -> Fin (N.Nat^::succ n));
\definition law: Existence n -> Existence (N.Nat^::succ n) :=
  \fun (previous: Existence n) => \induction (k: N.Nat^) \return \forall (f: Fin k -> Fin (N.Nat^::succ n)) ->
    Injective k (N.Nat^::succ n) f -> \exists Ordered k (N.Nat^::succ n) f \with {
      | zero: \fun (f: Fin N.Nat^::zero -> Fin (N.Nat^::succ n))(injection: Injective N.Nat^::zero (N.Nat^::succ n) f) =>
        \parent.Empty[n := N.Nat^::succ n].ordered f
      | succ: \fun (k: N.Nat^)(unused: \forall (f: Fin k -> Fin (N.Nat^::succ n)) -> Injective k (N.Nat^::succ n) f -> \exists Ordered k (N.Nat^::succ n) f)
        (f: Fin (N.Nat^::succ k) -> Fin (N.Nat^::succ n))(injection: Injective (N.Nat^::succ k) (N.Nat^::succ n) f) => At[k := k, f := f].law previous injection
    };
