\import \root.Data[].FinSet[].Permutations[n := N.Nat^::zero].Operations[] \as Permutations;
\definition increasing: \forall (f: Fin N.Nat^::zero -> Fin n) -> Increasing N.Nat^::zero n f :=
  \fun (f: Fin N.Nat^::zero -> Fin n)(i, j: Fin N.Nat^::zero)(less: NL.Lt i j) =>
    Logic.falseElim (NL.Lt (f i) (f j)) (zeroImpossible i (bound N.Nat^::zero i));
\definition ordered: \forall (f: Fin N.Nat^::zero -> Fin n) -> \exists Ordered N.Nat^::zero n f :=
  \fun (f: Fin N.Nat^::zero -> Fin n) => \exact(\into[PermutationType N.Nat^::zero](Permutations.identity,
    Ordered N.Nat^::zero n f) \by { increasing (\fun (i: Fin N.Nat^::zero) => f (#forward{Permutations.identity} i)) },
    Ordered N.Nat^::zero n f);
