\definition HasZero: \Prop := \exists ( pivot: Fin (N.Nat^::succ k) \where f pivot = zero n );
\import \parent.\parent.Reduction[k := N.Nat^::succ k, n := n, f := f] \as Reduction;
\definition avoids: Logic.Not HasZero -> Reduction.AvoidsZero :=
  \fun (none: Logic.Not HasZero)(i: Fin (N.Nat^::succ k))(same: f i = zero n) =>
    none (Logic.existsIntro[Fin (N.Nat^::succ k), { pivot: Fin (N.Nat^::succ k) \where f pivot = zero n }] i same);
\definition law: Existence n -> Injective (N.Nat^::succ k) (N.Nat^::succ n) f -> \exists Ordered (N.Nat^::succ k) (N.Nat^::succ n) f :=
  \fun (previous: Existence n)(injection: Injective (N.Nat^::succ k) (N.Nat^::succ n) f) =>
    either!{{(Classical.excludedMiddle HasZero)} {\exists Ordered (N.Nat^::succ k) (N.Nat^::succ n) f}
      {\block {
        \fun (exists: HasZero) \then
        \takefrom pivot: \Cast[Fin (N.Nat^::succ k)] ({ pivot: Fin (N.Nat^::succ k) \where f pivot = zero n }) \by exists \then
        \return \parent.\parent.Pivot[k := k, n := n, f := f, pivot := pivot].ordered previous injection
          (\bysub(Fin (N.Nat^::succ k), { pivot: Fin (N.Nat^::succ k) \where f pivot = zero n }, pivot))
      }}
      {\fun (none: Logic.Not HasZero) => Reduction.ordered previous (avoids none) injection}
    };
