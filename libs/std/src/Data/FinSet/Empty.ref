\definition existence: \forall (i: Fin N.Nat^::zero) -> \exists A :=
  \fun (i: Fin N.Nat^::zero) => Logic.falseElim (\exists A) (zeroImpossible i (bound N.Nat^::zero i));
\definition uniqueness: \forall (i: Fin N.Nat^::zero)(x, y: A) -> x = y :=
  \fun (i: Fin N.Nat^::zero)(x, y: A) => Logic.falseElim (x = y) (zeroImpossible i (bound N.Nat^::zero i));
\definition value(i: Fin N.Nat^::zero): A := \choice A \by { existence: existence i, uniqueness: uniqueness i };
\definition function: Fin N.Nat^::zero -> A := \fun (i: Fin N.Nat^::zero) => value i;
\definition unique: \forall (f, g: Fin N.Nat^::zero -> A) -> f = g :=
  \fun (f, g: Fin N.Nat^::zero -> A) => \axiom:funext(f, g, \fun (i: Fin N.Nat^::zero) => uniqueness i (f i) (g i));
