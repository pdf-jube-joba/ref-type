\definition Exists(n: N.Nat^): \Prop := \forall (p: \parent.Permutations[n := n].Permutation) ->
  \exists { word: \parent.Permutations[n := n].Word \where \parent.Permutations[n := n].Represents p word };
\definition empty: Exists N.Nat^::zero := \fun (p: \parent.Permutations[n := N.Nat^::zero].Permutation) =>
  \exact(\into[\parent.Permutations[n := N.Nat^::zero].Word](Lists.List[\parent.Permutations[n := N.Nat^::zero].Swap]::nil,
    { word: \parent.Permutations[n := N.Nat^::zero].Word \where \parent.Permutations[n := N.Nat^::zero].Represents p word }) \by {
      \axiom:funext((\fun (i: Fin N.Nat^::zero) => i), #forward{p},
        \fun (i: Fin N.Nat^::zero) => Logic.falseElim (i = #forward{p} i) (zeroImpossible i (bound N.Nat^::zero i)))
    }, \Cast[\parent.Permutations[n := N.Nat^::zero].Word]
      ({ word: \parent.Permutations[n := N.Nat^::zero].Word \where \parent.Permutations[n := N.Nat^::zero].Represents p word }));
\definition decomposition: \forall (n: N.Nat^) -> Exists n :=
  \induction (n: N.Nat^) \return Exists n \with {
    | zero: empty
    | succ: \fun (n: N.Nat^)(previous: Exists n)(p: \parent.Permutations[n := N.Nat^::succ n].Permutation) =>
      \parent.Permutations[n := n].Step[p := p].exists previous
  };
