\import \parent.\parent.Step[n := n] \as Recursion;
\definition law(previous: Property n): Property (N.Nat^::succ n) :=
  cases (N.Nat^::succ n)
    (\fun (i: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (j: Fin (N.Nat^::succ n)) -> NL.Le i j ->
      value (N.Nat^::succ (N.Nat^::succ n)) (apply (N.Nat^::succ n) i j) = N.Nat^::succ (value (N.Nat^::succ n) j))
    (\fun (j: Fin (N.Nat^::succ n))(ordered: NL.Le (zero (N.Nat^::succ n)) j) => Recursion.first j)
    (\fun (i: Fin (N.Nat^::succ n)) => cases n
      (\fun (j: Fin (N.Nat^::succ n)) => NL.Le (succ (N.Nat^::succ n) i) j ->
        value (N.Nat^::succ (N.Nat^::succ n)) (apply (N.Nat^::succ n) (succ (N.Nat^::succ n) i) j) = N.Nat^::succ (value (N.Nat^::succ n) j))
      (\fun (ordered: NL.Le (succ (N.Nat^::succ n) i) (zero n)) => BoolLaws.absurd _ ordered)
      (\fun (j: Fin n)(ordered: NL.Le (succ (N.Nat^::succ n) i) (succ n j)) => trans!{N.Nat^} _ _ _
        (Recursion.successorSuccessor i j) (congr!{N.Nat^ N.Nat^} (\fun (k: N.Nat^) => N.Nat^::succ k) _ _ (previous i j ordered))));
