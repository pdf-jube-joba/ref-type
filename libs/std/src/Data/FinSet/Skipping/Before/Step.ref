\import \parent.\parent.Step[n := n] \as Recursion;
\definition law[previous: Property n]: Property (N.Nat^::succ n) :=
  cases (N.Nat^::succ n)
    (\fun (i: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (j: Fin (N.Nat^::succ n)) -> NL.Lt j i ->
      value (N.Nat^::succ (N.Nat^::succ n)) (apply (N.Nat^::succ n) i j) = value (N.Nat^::succ n) j)
    (\fun (j: Fin (N.Nat^::succ n))(ordered: NL.Lt j (zero (N.Nat^::succ n))) => Logic.falseElim _ (zeroImpossible j ordered))
    (\fun (i: Fin (N.Nat^::succ n)) => cases n
      (\fun (j: Fin (N.Nat^::succ n)) => NL.Lt j (succ (N.Nat^::succ n) i) ->
        value (N.Nat^::succ (N.Nat^::succ n)) (apply (N.Nat^::succ n) (succ (N.Nat^::succ n) i) j) = value (N.Nat^::succ n) j)
      (\fun (ordered: NL.Lt (zero n) (succ (N.Nat^::succ n) i)) => Recursion.successorZero i)
      (\fun (j: Fin n)(ordered: NL.Lt (succ n j) (succ (N.Nat^::succ n) i)) => trans!{N.Nat^} _ _ _
        (Recursion.successorSuccessor i j) (congr!{N.Nat^ N.Nat^} (\fun (k: N.Nat^) => N.Nat^::succ k) _ _ (previous i j ordered))));
