\import \parent.\parent.Tuples[A := Fin (N.Nat^::succ (N.Nat^::succ n))] \as Tuples;
\import Tuples.Omission[] \as Omission;
\import \parent.\parent.Tuples[A := Fin (N.Nat^::succ n)].Mapping[B := Fin (N.Nat^::succ (N.Nat^::succ n))] \as Mapping;
\definition first: \forall (j: Fin (N.Nat^::succ n)) ->
  apply (N.Nat^::succ n) (zero (N.Nat^::succ n)) j = succ (N.Nat^::succ n) j :=
  \fun (j: Fin (N.Nat^::succ n)) => congr!{{Fin (N.Nat^::succ n) -> Fin (N.Nat^::succ (N.Nat^::succ n))} {Fin (N.Nat^::succ (N.Nat^::succ n))}}
    (\fun (f: Fin (N.Nat^::succ n) -> Fin (N.Nat^::succ (N.Nat^::succ n))) => f j) _ _
    (Omission.first n (\fun (k: Fin (N.Nat^::succ (N.Nat^::succ n))) => k));
\definition successorZero: \forall (i: Fin (N.Nat^::succ n)) ->
  apply (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (zero n) = zero (N.Nat^::succ n) :=
  \fun (i: Fin (N.Nat^::succ n)) => trans!{{Fin (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
    (congr!{{Fin (N.Nat^::succ n) -> Fin (N.Nat^::succ (N.Nat^::succ n))} {Fin (N.Nat^::succ (N.Nat^::succ n))}}
      (\fun (f: Fin (N.Nat^::succ n) -> Fin (N.Nat^::succ (N.Nat^::succ n))) => f (zero n)) _ _
      (Omission.successor n i (\fun (k: Fin (N.Nat^::succ (N.Nat^::succ n))) => k)))
    (Tuples.atZero n (zero (N.Nat^::succ n)) (Omission.omit n i (succ (N.Nat^::succ n))));
\definition successorSuccessor: \forall (i: Fin (N.Nat^::succ n))(j: Fin n) ->
  apply (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (succ n j) = succ (N.Nat^::succ n) (apply n i j) :=
  \fun (i: Fin (N.Nat^::succ n))(j: Fin n) => trans!{{Fin (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
    (congr!{{Fin (N.Nat^::succ n) -> Fin (N.Nat^::succ (N.Nat^::succ n))} {Fin (N.Nat^::succ (N.Nat^::succ n))}}
      (\fun (f: Fin (N.Nat^::succ n) -> Fin (N.Nat^::succ (N.Nat^::succ n))) => f (succ n j)) _ _
      (Omission.successor n i (\fun (k: Fin (N.Nat^::succ (N.Nat^::succ n))) => k)))
    (trans!{{Fin (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
      (Tuples.atSuccessor n (zero (N.Nat^::succ n)) (Omission.omit n i (succ (N.Nat^::succ n))) j)
      (sym!{{Fin (N.Nat^::succ (N.Nat^::succ n))}} _ _
        (congr!{{Fin n -> Fin (N.Nat^::succ (N.Nat^::succ n))} {Fin (N.Nat^::succ (N.Nat^::succ n))}}
          (\fun (f: Fin n -> Fin (N.Nat^::succ (N.Nat^::succ n))) => f j) _ _
          (Mapping.omitMap n i (succ (N.Nat^::succ n)) (\fun (k: Fin (N.Nat^::succ n)) => k)))));
