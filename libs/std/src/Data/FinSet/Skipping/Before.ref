\definition Property[n: N.Nat^]: \Prop := \forall (i: Fin (N.Nat^::succ n))(j: Fin n) -> NL.Lt j i ->
  value (N.Nat^::succ n) (apply n i j) = value n j;
\module Step(n: N.Nat^);
\definition law: \forall (n: N.Nat^) -> Property n := \induction (n: N.Nat^) \return Property n \with {
  | zero: \fun (i: Fin (N.Nat^::succ N.Nat^::zero))(j: Fin N.Nat^::zero)(ordered: NL.Lt j i) =>
      Logic.falseElim _ (zeroImpossible j (bound N.Nat^::zero j))
  | succ: \fun (n: N.Nat^)(previous: Property n) => Step[n := n].law previous
};
