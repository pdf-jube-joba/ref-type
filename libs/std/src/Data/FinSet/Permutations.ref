\import std.Logic[].Classical[] \as Classical;
\structure Data: \Set := {
  forward: Fin n -> Fin n,
  backward: Fin n -> Fin n,
};
\structure Laws[data: Data]: \Prop := {
  leftInverse: \forall (i: Fin n) -> data.backward (data.forward i) = i,
  rightInverse: \forall (i: Fin n) -> data.forward (data.backward i) = i,
};
\definition Permutation: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition laws[p: Permutation]: Laws[p] := \bysub(Data, { data: Data \where Laws[data] }, p);
\definition injective: \forall (p: Permutation)(i, j: Fin n) -> p.forward i = p.forward j -> i = j :=
  \fun (p: Permutation)(i, j: Fin n)(same: p.forward i = p.forward j) => trans!{{Fin n}} i (p.backward (p.forward i)) j
    (sym!{{Fin n}} (p.backward (p.forward i)) i ((laws p).leftInverse i))
    (trans!{{Fin n}} (p.backward (p.forward i)) (p.backward (p.forward j)) j
      (congr!{{Fin n} {Fin n}} p.backward (p.forward i) (p.forward j) same) ((laws p).leftInverse j));
\structure Swap: \Set := {
  first: Fin n,
  second: Fin n,
};
\definition swap[s: Swap][i: Fin n]: Fin n := \parent.Transposition[n := n, a := s.first, b := s.second].apply i;
\definition Word: \Set := Lists.List[Swap];
\definition action[word: Word]: Fin n -> Fin n := Lists.foldr Swap (Fin n -> Fin n)
  (\fun (s: Swap)(tail: Fin n -> Fin n)(i: Fin n) => tail (swap s i)) (\fun (i: Fin n) => i) word;
\definition Represents[p: Permutation][word: Word]: \Prop := action word = p.forward;
\definition PermutationType[k: N.Nat^]: \Set := \root.Data[].FinSet[].Permutations[n := k].Permutation;
\module Step(p: PermutationType (N.Nat^::succ n));
\module Operations;
\module Lifting;
