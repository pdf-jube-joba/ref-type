\definition step: \forall (head: A) -> list (Lists.length A tail) (tuple tail) = tail ->
  list (Lists.length A (Lists.List[A]::cons head tail)) (tuple (Lists.List[A]::cons head tail)) = Lists.List[A]::cons head tail := \block {
  \fun (head: A)(previous: list (Lists.length A tail) (tuple tail) = tail) \then
  \let n: N.Nat^ := Lists.length A tail \then
  \let t: Fin n -> A := tuple tail \then
  \let newTail: Fin n -> A := \fun (j: Fin n) => Tuples.extend n head t (succ n j) \then
  \let equal: newTail = t := \axiom:funext(newTail, t, \fun (j: Fin n) => Tuples.atSuccessor n head t j) \then
  \return congr2!{A {Lists.List[A]} {Lists.List[A]}} Lists.List[A]::cons
    (Tuples.extend n head t (zero n)) head (list n newTail) tail (Tuples.atZero n head t)
    (trans!{{Lists.List[A]}} (list n newTail) (list n t) tail (congr!{{Fin n -> A} {Lists.List[A]}} (list n) newTail t equal) previous)
};
