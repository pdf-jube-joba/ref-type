\import \parent.\parent.FromList[A := B] \as Target;
\definition listMap: \forall (n: N.Nat^)(f: A -> B)(arguments: Fin n -> A) -> Target.list n (\fun (i: Fin n) => f (arguments i)) = Lists.map A B f (list n arguments) :=
  \induction (n: N.Nat^) \return \forall (f: A -> B)(arguments: Fin n -> A) -> Target.list n (\fun (i: Fin n) => f (arguments i)) = Lists.map A B f (list n arguments) \with {
    | zero: \fun (f: A -> B)(arguments: Fin N.Nat^::zero -> A) => \refl(Lists.List[B]::nil)
    | succ: \fun (n: N.Nat^)(previous: \forall (f: A -> B)(arguments: Fin n -> A) -> Target.list n (\fun (i: Fin n) => f (arguments i)) = Lists.map A B f (list n arguments))
      (f: A -> B)(arguments: Fin (N.Nat^::succ n) -> A) => congr!{{Lists.List[B]} {Lists.List[B]}} (Lists.List[B]::cons (f (arguments (zero n)))) _ _
        (previous f (\fun (i: Fin n) => arguments (succ n i)))
  };
