\definition step: (\forall (f: Fin n -> A) -> at n (list n f) (listLength n f) = f) ->
  \forall (f: Fin (N.Nat^::succ n) -> A) -> at (N.Nat^::succ n) (list (N.Nat^::succ n) f) (listLength (N.Nat^::succ n) f) = f := \block {
  \fun (previous: \forall (f: Fin n -> A) -> at n (list n f) (listLength n f) = f)(f: Fin (N.Nat^::succ n) -> A) \then
  \let tail: Fin n -> A := \fun (j: Fin n) => f (succ n j) \then
  \let xs: Lists.List[A] := list n tail \then
  \let equal: Lists.length A xs = n := listLength n tail \then
  \let compatibility: \forall (m: N.Nat^)(e: Lists.length A xs = m)(h: A) ->
    at (N.Nat^::succ m) (Lists.List[A]::cons h xs) (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ (Lists.length A xs) m e) = Tuples.extend m h (at m xs e) :=
    \fun (m: N.Nat^)(e: Lists.length A xs = m) =>
      (\idelim Lists.length A xs = m \with r: N.Nat^ => \forall (law: Lists.length A xs = r)(h: A) ->
        at (N.Nat^::succ r) (Lists.List[A]::cons h xs) (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ (Lists.length A xs) r law) = Tuples.extend r h (at r xs law)
        \by { base: \fun (law: Lists.length A xs = Lists.length A xs)(h: A) => trans!{{Fin (N.Nat^::succ (Lists.length A xs)) -> A}}
          (at (N.Nat^::succ (Lists.length A xs)) (Lists.List[A]::cons h xs) (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ (Lists.length A xs) (Lists.length A xs) law))
          (Tuples.extend (Lists.length A xs) h (tuple xs)) (Tuples.extend (Lists.length A xs) h (at (Lists.length A xs) xs law))
            (atSelf (Lists.List[A]::cons h xs) (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ (Lists.length A xs) (Lists.length A xs) law))
            (congr!{{Fin (Lists.length A xs) -> A} {Fin (N.Nat^::succ (Lists.length A xs)) -> A}} (Tuples.extend (Lists.length A xs) h)
              (tuple xs) (at (Lists.length A xs) xs law) (sym!{{Fin (Lists.length A xs) -> A}} (at (Lists.length A xs) xs law) (tuple xs) (atSelf xs law))), equality: e }) e \then
  \return trans!{{Fin (N.Nat^::succ n) -> A}} (at (N.Nat^::succ n) (list (N.Nat^::succ n) f) (listLength (N.Nat^::succ n) f))
    (Tuples.extend n (f (zero n)) (at n xs equal)) f
    (compatibility n equal (f (zero n)))
    (trans!{{Fin (N.Nat^::succ n) -> A}} (Tuples.extend n (f (zero n)) (at n xs equal)) (Tuples.extend n (f (zero n)) tail) f
      (congr!{{Fin n -> A} {Fin (N.Nat^::succ n) -> A}} (Tuples.extend n (f (zero n))) (at n xs equal) tail (previous tail))
      (Tuples.recover n f))
};
