\definition law: (\forall (f: Fin n -> A)(i: Fin n) -> Membership.Occurs (f i) (list n f)) ->
  \forall (f: Fin (N.Nat^::succ n) -> A)(i: Fin (N.Nat^::succ n)) -> Membership.Occurs (f i) (list (N.Nat^::succ n) f) := \block {
  \fun (previous: \forall (f: Fin n -> A)(i: Fin n) -> Membership.Occurs (f i) (list n f))(f: Fin (N.Nat^::succ n) -> A)(i: Fin (N.Nat^::succ n)) \then
  \let cases: \forall (option: Option.Option[Fin n]) -> Membership.Occurs (f (inflate n option)) (list (N.Nat^::succ n) f) :=
    \induction (option: Option.Option[Fin n]) \return Membership.Occurs (f (inflate n option)) (list (N.Nat^::succ n) f) \with {
      | none: Logic.Or[_, _]::left (\refl(f (zero n)))
      | some: \fun (j: Fin n) => Logic.Or[_, _]::right (previous (\fun (k: Fin n) => f (succ n k)) j)
    } \then
  \return \idelim inflate n (split n i) = i \with j: Fin (N.Nat^::succ n) => Membership.Occurs (f j) (list (N.Nat^::succ n) f)
    \by { base: cases (split n i), equality: inflateSplit n i }
};
