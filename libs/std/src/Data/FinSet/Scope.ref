\import std.Set[].FiniteSubset[A := Fin n] \as Finite;
\import Finite.Enumeration[] \as Enumeration;
\definition Whole: \Pow (Fin n) := { i: Fin n \where i = i };
\definition finiteWhole: Finite.Finite Whole := Enumeration.finiteOfEnumeration Whole (elements n)
  (Enumeration.Enumerates[Whole, elements n] {
    included := \fun (i: Fin n) (member: _) => \refl(i),
    exhaustive := \fun (i: Fin n) (whole: _) => exhaustive n i,
  });
\definition finite: Finite.FiniteSubset := \into[\Pow (Fin n)](Whole, Finite.FiniteSubsetSet) \by { finiteWhole };
