\use Equality.eq_reason;
\definition beforeSuccessor: \parent.Mixed[n := n].Laws -> \forall (i, j: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A) -> NL.Le i j ->
  Before (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (succ (N.Nat^::succ n) j) f := \block {
  \fun (previous: _)(i, j: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(ordered: _) \then
  \let a: A := f (zero (N.Nat^::succ (N.Nat^::succ n))) \then
  \let tail: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A := \fun (k: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (succ (N.Nat^::succ (N.Nat^::succ n)) k) \then
  \return eq_reason!{
    {Omission.omit (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (widen (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ n) i))) (repeat (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j)) f)}
    "=" {Omission.omit (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (widen (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ n) i))) (extend (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) a (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) j) tail))} "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} (Omission.omit (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (widen (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ n) i)))) _ _ (successor (N.Nat^::succ n) (succ (N.Nat^::succ n) j) f) }
    "=" {extend (N.Nat^::succ (N.Nat^::succ n)) a (Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ n) i)) (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) j) tail))} "by" { Omission.onExtended (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ n) i)) a (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) j) tail) }
    "=" {extend (N.Nat^::succ (N.Nat^::succ n)) a (repeat n j (Omission.omit (N.Nat^::succ n) (widen (N.Nat^::succ n) i) tail))} "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} (extend (N.Nat^::succ (N.Nat^::succ n)) a) _ _ (#before{previous} i j tail ordered) }
    "=" {repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) j) (extend (N.Nat^::succ n) a (Omission.omit (N.Nat^::succ n) (widen (N.Nat^::succ n) i) tail))} "by" { sym!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} _ _ (onExtended n j a (Omission.omit (N.Nat^::succ n) (widen (N.Nat^::succ n) i) tail)) }
    "=" {repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) j) (Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) i)) f)} "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) j)) _ _ (sym!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A}} _ _ (Omission.successor (N.Nat^::succ n) (widen (N.Nat^::succ n) i) f)) }
  }
};
\definition afterSuccessor: \parent.Mixed[n := n].Laws -> \forall (i, j: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A) -> NL.Le i j ->
  After (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (succ (N.Nat^::succ n) j) f := \block {
  \fun (previous: _)(i, j: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(ordered: _) \then
  \let a: A := f (zero (N.Nat^::succ (N.Nat^::succ n))) \then
  \let tail: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A := \fun (k: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (succ (N.Nat^::succ (N.Nat^::succ n)) k) \then
  \return eq_reason!{
    {Omission.omit (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j))) (repeat (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) i)) f)}
    "=" {Omission.omit (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j))) (extend (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) a (repeat (N.Nat^::succ n) (widen (N.Nat^::succ n) i) tail))} "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} (Omission.omit (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j)))) _ _ (successor (N.Nat^::succ n) (widen (N.Nat^::succ n) i) f) }
    "=" {extend (N.Nat^::succ (N.Nat^::succ n)) a (Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j)) (repeat (N.Nat^::succ n) (widen (N.Nat^::succ n) i) tail))} "by" { Omission.onExtended (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j)) a (repeat (N.Nat^::succ n) (widen (N.Nat^::succ n) i) tail) }
    "=" {extend (N.Nat^::succ (N.Nat^::succ n)) a (repeat n i (Omission.omit (N.Nat^::succ n) (succ (N.Nat^::succ n) j) tail))} "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} (extend (N.Nat^::succ (N.Nat^::succ n)) a) _ _ (#after{previous} i j tail ordered) }
    "=" {repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (extend (N.Nat^::succ n) a (Omission.omit (N.Nat^::succ n) (succ (N.Nat^::succ n) j) tail))} "by" { sym!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} _ _ (onExtended n i a (Omission.omit (N.Nat^::succ n) (succ (N.Nat^::succ n) j) tail)) }
    "=" {repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) j)) f)} "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A}} (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i)) _ _ (sym!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A}} _ _ (Omission.successor (N.Nat^::succ n) (succ (N.Nat^::succ n) j) f)) }
  }
};
\definition law(previous: \parent.Mixed[n := n].Laws): \parent.Mixed[n := N.Nat^::succ n].Laws := \parent.Mixed[n := N.Nat^::succ n].Laws {
  before := cases (N.Nat^::succ n)
    (\fun (i: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (j: Fin (N.Nat^::succ (N.Nat^::succ n)))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A) -> NL.Le i j -> Before (N.Nat^::succ n) i j f)
    (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n)))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(ordered: _) => beforeHead (N.Nat^::succ n) j f)
    (\fun (i: Fin (N.Nat^::succ n)) => cases (N.Nat^::succ n)
      (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A) -> NL.Le (succ (N.Nat^::succ n) i) j -> Before (N.Nat^::succ n) (succ (N.Nat^::succ n) i) j f)
      (\fun (f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(ordered: _) => Logic.falseElim _ (NL.succNeZero i (NL.leZeroEq (N.Nat^::succ i) ordered)))
      (\fun (j: Fin (N.Nat^::succ n)) => beforeSuccessor previous i j)),
  after := cases (N.Nat^::succ n)
    (\fun (i: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (j: Fin (N.Nat^::succ (N.Nat^::succ n)))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A) -> NL.Le i j -> After (N.Nat^::succ n) i j f)
    (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n)))(f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(ordered: _) => afterHead (N.Nat^::succ n) j f)
    (\fun (i: Fin (N.Nat^::succ n)) => cases (N.Nat^::succ n)
      (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A) -> NL.Le (succ (N.Nat^::succ n) i) j -> After (N.Nat^::succ n) (succ (N.Nat^::succ n) i) j f)
      (\fun (f: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(ordered: _) => Logic.falseElim _ (NL.succNeZero i (NL.leZeroEq (N.Nat^::succ i) ordered)))
      (\fun (j: Fin (N.Nat^::succ n)) => afterSuccessor previous i j)),
};
