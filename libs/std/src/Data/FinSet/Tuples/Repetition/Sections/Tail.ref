\use std.Logic[].Equality[].eq_reason_in;
\definition tail[f: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A]: Fin (N.Nat^::succ n) -> A := \fun (j: Fin (N.Nat^::succ n)) => f (succ (N.Nat^::succ n) j);
\definition first: First n -> \forall (i: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
  Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) i)) (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i) f) = f :=
  \fun (previous: First n)(i: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) => eq_reason_in!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A} _
    "=" _ "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A} {Fin (N.Nat^::succ (N.Nat^::succ n)) -> A}}
      (Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (widen (N.Nat^::succ n) i))) _ _ (successor n i f) }
    "=" _ "by" { Omission.onExtended (N.Nat^::succ n) (widen (N.Nat^::succ n) i) (f (zero (N.Nat^::succ n))) (repeat n i (tail f)) }
    "=" _ "by" { congr!{{Fin (N.Nat^::succ n) -> A} {Fin (N.Nat^::succ (N.Nat^::succ n)) -> A}} (extend (N.Nat^::succ n) (f (zero (N.Nat^::succ n)))) _ _ (previous i (tail f)) }
    "=" _ "by" { recover (N.Nat^::succ n) f }
  };
\definition second: Second n -> \forall (i: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
  Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) i)) (repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i) f) = f :=
  \fun (previous: Second n)(i: Fin (N.Nat^::succ n))(f: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) => eq_reason_in!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> A} _
    "=" _ "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A} {Fin (N.Nat^::succ (N.Nat^::succ n)) -> A}}
      (Omission.omit (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ (N.Nat^::succ n)) (succ (N.Nat^::succ n) i))) _ _ (successor n i f) }
    "=" _ "by" { Omission.onExtended (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (f (zero (N.Nat^::succ n))) (repeat n i (tail f)) }
    "=" _ "by" { congr!{{Fin (N.Nat^::succ n) -> A} {Fin (N.Nat^::succ (N.Nat^::succ n)) -> A}} (extend (N.Nat^::succ n) (f (zero (N.Nat^::succ n)))) _ _ (previous i (tail f)) }
    "=" _ "by" { recover (N.Nat^::succ n) f }
  };
