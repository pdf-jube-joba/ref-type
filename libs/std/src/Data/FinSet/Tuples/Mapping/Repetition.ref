\use std.Logic[].Equality[].eq_reason_in;
\definition head: \forall (f: A -> B)(v: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
  (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (SourceRepetition.repeat (N.Nat^::succ n) (zero (N.Nat^::succ n)) v j)) =
  TargetRepetition.repeat (N.Nat^::succ n) (zero (N.Nat^::succ n)) (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (v j)) :=
  \fun (f: A -> B)(v: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) =>
    eq_reason_in!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B} _
      "=" _ "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B}}
        (\fun (g: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(j: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (g j)) _ _ (SourceRepetition.head (N.Nat^::succ n) v) }
      "=" _ "by" { extendMap (N.Nat^::succ (N.Nat^::succ n)) f (v (zero (N.Nat^::succ n))) v }
      "=" _ "by" { sym!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B}} _ _ (TargetRepetition.head (N.Nat^::succ n) (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (v j))) }
    };
\definition successorLaw:
  (\forall (i: Fin (N.Nat^::succ n))(f: A -> B)(v: Fin (N.Nat^::succ n) -> A) ->
    (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (SourceRepetition.repeat n i v j)) = TargetRepetition.repeat n i (\fun (j: Fin (N.Nat^::succ n)) => f (v j))) ->
  \forall (i: Fin (N.Nat^::succ n))(f: A -> B)(v: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
    (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (SourceRepetition.repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i) v j)) =
    TargetRepetition.repeat (N.Nat^::succ n) (succ (N.Nat^::succ n) i) (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (v j)) :=
  \fun (previous: _)(i: Fin (N.Nat^::succ n))(f: A -> B)(v: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) =>
    eq_reason_in!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B} _
      "=" _ "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B}}
        (\fun (g: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> A)(j: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (g j)) _ _ (SourceRepetition.successor n i v) }
      "=" _ "by" { extendMap (N.Nat^::succ (N.Nat^::succ n)) f (v (zero (N.Nat^::succ n))) (SourceRepetition.repeat n i (\fun (j: Fin (N.Nat^::succ n)) => v (succ (N.Nat^::succ n) j))) }
      "=" _ "by" { congr!{{Fin (N.Nat^::succ (N.Nat^::succ n)) -> B} {Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B}}
            (Target.extend (N.Nat^::succ (N.Nat^::succ n)) (f (v (zero (N.Nat^::succ n))))) _ _ (previous i f (\fun (j: Fin (N.Nat^::succ n)) => v (succ (N.Nat^::succ n) j))) }
      "=" _ "by" { sym!{{Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) -> B}} _ _
            (TargetRepetition.successor n i (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (v j))) }
    };
\definition law:
  (\forall (i: Fin (N.Nat^::succ n))(f: A -> B)(v: Fin (N.Nat^::succ n) -> A) ->
    (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (SourceRepetition.repeat n i v j)) = TargetRepetition.repeat n i (\fun (j: Fin (N.Nat^::succ n)) => f (v j))) ->
  \forall (i: Fin (N.Nat^::succ (N.Nat^::succ n)))(f: A -> B)(v: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
    (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (SourceRepetition.repeat (N.Nat^::succ n) i v j)) =
    TargetRepetition.repeat (N.Nat^::succ n) i (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (v j)) :=
  \fun (previous: _) => cases (N.Nat^::succ n)
    (\fun (i: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (f: A -> B)(v: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
      (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (SourceRepetition.repeat (N.Nat^::succ n) i v j)) = TargetRepetition.repeat (N.Nat^::succ n) i (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (v j)))
    head (\fun (i: Fin (N.Nat^::succ n)) => successorLaw previous i);
