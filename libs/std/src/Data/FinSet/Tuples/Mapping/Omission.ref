\use std.Logic[].Equality[].eq_reason_in;
\definition law:
  (\forall (i: Fin (N.Nat^::succ n))(f: A -> B)(vertices: Fin (N.Nat^::succ n) -> A) ->
    (\fun (j: Fin n) => f (SourceOmission.omit n i vertices j)) = TargetOmission.omit n i (\fun (j: Fin (N.Nat^::succ n)) => f (vertices j))) ->
  \forall (i: Fin (N.Nat^::succ (N.Nat^::succ n)))(f: A -> B)(vertices: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
    (\fun (j: Fin (N.Nat^::succ n)) => f (SourceOmission.omit (N.Nat^::succ n) i vertices j)) =
      TargetOmission.omit (N.Nat^::succ n) i (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (vertices j)) :=
  \fun (previous: _) => cases (N.Nat^::succ n) (\fun (i: Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (f: A -> B)(vertices: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) ->
    (\fun (j: Fin (N.Nat^::succ n)) => f (SourceOmission.omit (N.Nat^::succ n) i vertices j)) =
      TargetOmission.omit (N.Nat^::succ n) i (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (vertices j)))
    (\fun (f: A -> B)(vertices: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) => trans!{{Fin (N.Nat^::succ n) -> B}} _ _ _
      (congr!{{Fin (N.Nat^::succ n) -> A} {Fin (N.Nat^::succ n) -> B}}
        (\fun (v: Fin (N.Nat^::succ n) -> A) => \fun (j: Fin (N.Nat^::succ n)) => f (v j)) _ _ (SourceOmission.first n vertices))
      (sym!{{Fin (N.Nat^::succ n) -> B}} _ _ (TargetOmission.first n (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (vertices j)))))
    (\fun (i: Fin (N.Nat^::succ n))(f: A -> B)(vertices: Fin (N.Nat^::succ (N.Nat^::succ n)) -> A) => eq_reason_in!{{Fin (N.Nat^::succ n) -> B} _
      "=" _ "by" { congr!{{Fin (N.Nat^::succ n) -> A} {Fin (N.Nat^::succ n) -> B}}
        (\fun (v: Fin (N.Nat^::succ n) -> A) => \fun (j: Fin (N.Nat^::succ n)) => f (v j)) _ _ (SourceOmission.successor n i vertices) }
      "=" _ "by" { extendMap n f (vertices (zero (N.Nat^::succ n))) (SourceOmission.omit n i (\fun (j: Fin (N.Nat^::succ n)) => vertices (succ (N.Nat^::succ n) j))) }
      "=" _ "by" { congr!{{Fin n -> B} {Fin (N.Nat^::succ n) -> B}} (Target.extend n (f (vertices (zero (N.Nat^::succ n))))) _ _
            (previous i f (\fun (j: Fin (N.Nat^::succ n)) => vertices (succ (N.Nat^::succ n) j))) }
      "=" _ "by" { sym!{{Fin (N.Nat^::succ n) -> B}} _ _ (TargetOmission.successor n i (\fun (j: Fin (N.Nat^::succ (N.Nat^::succ n))) => f (vertices j))) }
    });
