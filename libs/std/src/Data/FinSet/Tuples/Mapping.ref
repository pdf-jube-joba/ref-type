\import \parent.\parent.Tuples[A := B] \as Target;
\definition extendMap: \forall (n: N.Nat^)(f: A -> B)(head: A)(tail: Fin n -> A) ->
  (\fun (i: Fin (N.Nat^::succ n)) => f (extend n head tail i)) = Target.extend n (f head) (\fun (i: Fin n) => f (tail i)) :=
  \fun (n: N.Nat^)(f: A -> B)(head: A)(tail: Fin n -> A) => Target.extensionality n _ _
    (trans!{B} _ _ _ (congr!{A B} f _ _ (atZero n head tail)) (sym!{B} _ _ (Target.atZero n (f head) (\fun (i: Fin n) => f (tail i)))))
    (\fun (i: Fin n) => trans!{B} _ _ _ (congr!{A B} f _ _ (atSuccessor n head tail i))
      (sym!{B} _ _ (Target.atSuccessor n (f head) (\fun (j: Fin n) => f (tail j)) i)));
