/* Arithmetic laws on the reflected operations. */
\import \root.Logic[].Rel[Carrier := Nat^] \as Rel;
\import \root.Logic[].Law[] \as Law;
\definition succInjective (a, b: Nat^) (e: Nat^::succ a = Nat^::succ b): a = b := congr!{Nat^ Nat^} pred^ (Nat^::succ a) (Nat^::succ b) e;
\definition predZero: pred^ Nat^::zero = Nat^::zero := \refl(Nat^::zero);
\definition predSucc (n: Nat^): pred^ (Nat^::succ n) = n := \refl(n);
\definition addZeroRight (a: Nat^): add^ a Nat^::zero = a := \refl(a);
\definition addSuccLeft: \forall (a, b: Nat^) -> add^ (Nat^::succ a) b = Nat^::succ (add^ a b) :=
  \block {
    \fix (a, b: Nat^) \then
    \let reflectedSuccessor:
      addPrec (Nat^::succ a) b = Nat^::succ (add^ a b) :=
      trans!{Nat^} _ _ _ (addPrecSuccLeft a b)
        (succCong _ _ (sym!{Nat^} _ _ (addMatchesPrec b a))) \then
    \return trans!{Nat^} _ _ _ (addMatchesPrec b (Nat^::succ a)) reflectedSuccessor
  };
\definition addSuccRight (a, b: Nat^): add^ a (Nat^::succ b) = Nat^::succ (add^ a b) := addSuccLeft a b;
\definition addZeroLeft: \forall (a: Nat^) -> add^ Nat^::zero a = a :=
  \induction (a: Nat^) \return add^ Nat^::zero a = a \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: add^ Nat^::zero a = a) =>
      trans!{Nat^} _ _ _ (addSuccRight Nat^::zero a) (succCong (add^ Nat^::zero a) a ih))
    };
\definition addComm (a: Nat^): \forall (b: Nat^) -> add^ a b = add^ b a :=
  \induction (b: Nat^) \return add^ a b = add^ b a \with {
    | zero => (sym!{Nat^} _ _ (addZeroLeft a))
    | succ => (\fun (b: Nat^) => \fun (ih: add^ a b = add^ b a) =>
      trans!{Nat^} _ _ _ (addSuccRight a b)
        (trans!{Nat^} _ _ _ (succCong (add^ a b) (add^ b a) ih) (sym!{Nat^} _ _ (addSuccLeft b a))))
    };
\definition addAssoc (a, b: Nat^): \forall (c: Nat^) -> add^ (add^ a b) c = add^ a (add^ b c) :=
  \induction (c: Nat^) \return add^ (add^ a b) c = add^ a (add^ b c) \with {
    | zero => (\refl(add^ a b))
    | succ => (\block {
      \fix (c: Nat^) \then
      \fix (ih: add^ (add^ a b) c = add^ a (add^ b c)) \then
      \let inductionUnderSuccessor:
        Nat^::succ (add^ (add^ a b) c) = Nat^::succ (add^ a (add^ b c)) :=
        succCong (add^ (add^ a b) c) (add^ a (add^ b c)) ih \then
      \let exposeOuterAddition:
        Nat^::succ (add^ a (add^ b c)) = add^ a (Nat^::succ (add^ b c)) :=
        sym!{Nat^} _ _ (addSuccRight a (add^ b c)) \then
      \let exposeInnerAddition:
        add^ a (Nat^::succ (add^ b c)) = add^ a (add^ b (Nat^::succ c)) :=
        congr!{Nat^ Nat^} (add^ a) _ _ (sym!{Nat^} _ _ (addSuccRight b c)) \then
      \return trans!{Nat^} _ _ _ (addSuccRight (add^ a b) c)
        (trans!{Nat^} _ _ _ inductionUnderSuccessor
          (trans!{Nat^} _ _ _ exposeOuterAddition exposeInnerAddition))
    })
    };
\definition addCancelRight: \forall (c, a, b: Nat^) -> add^ a c = add^ b c -> a = b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> add^ a c = add^ b c -> a = b \with {
    | zero => (\fun (a, b: Nat^) => \fun (e: a = b) => e)
    | succ => (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> add^ a c = add^ b c -> a = b) =>
      \fun (a, b: Nat^) => \fun (e: add^ a (Nat^::succ c) = add^ b (Nat^::succ c)) =>
        ih a b (succInjective _ _
          (trans!{Nat^} _ _ _ (sym!{Nat^} _ _ (addSuccRight a c))
            (trans!{Nat^} _ _ _ e (addSuccRight b c)))))
    };
\definition addCancelLeft: \forall (c, a, b: Nat^) -> add^ c a = add^ c b -> a = b :=
  \block {
    \fix (c, a, b: Nat^) \then
    \fix (e: add^ c a = add^ c b) \then
    \let rightSumsEqual: add^ a c = add^ b c :=
      trans!{Nat^} _ _ _ (addComm a c)
        (trans!{Nat^} _ _ _ e (addComm c b)) \then
    \return addCancelRight c a b rightSumsEqual
  };
\definition subZeroRight (a: Nat^): sub^ a Nat^::zero = a := \refl(a);
\definition subZeroLeft: \forall (a: Nat^) -> sub^ Nat^::zero a = Nat^::zero :=
  \induction (a: Nat^) \return sub^ Nat^::zero a = Nat^::zero \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: sub^ Nat^::zero a = Nat^::zero) => \refl(Nat^::zero))
    };
\definition subSuccSucc (a, b: Nat^): sub^ (Nat^::succ a) (Nat^::succ b) = sub^ a b := \refl(sub^ a b);
\definition subSelf: \forall (a: Nat^) -> sub^ a a = Nat^::zero :=
  \induction (a: Nat^) \return sub^ a a = Nat^::zero \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: sub^ a a = Nat^::zero) => ih)
    };
\definition subAddCancel: \forall (b, a: Nat^) -> sub^ (add^ a b) b = a :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> sub^ (add^ a b) b = a \with {
    | zero => (\fun (a: Nat^) => \refl(a))
    | succ => (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> sub^ (add^ a b) b = a) => \fun (a: Nat^) =>
      trans!{Nat^} _ _ _
        (congr!{Nat^ Nat^} (\fun (x: Nat^) => sub^ x (Nat^::succ b)) _ _ (addSuccRight a b)) (ih a))
    };
\definition mulZeroRight (a: Nat^): mul^ a Nat^::zero = Nat^::zero := \refl(Nat^::zero);
\definition mulSuccRight (a, b: Nat^): mul^ a (Nat^::succ b) = add^ a (mul^ a b) := trans!{Nat^} _ _ _ (mulMatchesPrec a (Nat^::succ b))
    (congr!{Nat^ Nat^} (add^ a) _ _ (sym!{Nat^} _ _ (mulMatchesPrec a b)));
\definition powZero (a: Nat^): pow^ a Nat^::zero = Nat^::succ Nat^::zero := \refl(Nat^::succ
  Nat^::zero);
\definition powSucc (a, b: Nat^): pow^ a (Nat^::succ b) = mul^ a (pow^ a b) := trans!{Nat^} _ _ _ (powMatchesPrec a (Nat^::succ b))
    (congr!{Nat^ Nat^} (mul^ a) _ _ (sym!{Nat^} _ _ (powMatchesPrec a b)));

/* Boolean decisions can be consumed directly as propositions. */
\definition zeroNeSucc (n: Nat^) (e: Nat^::zero = Nat^::succ n): B.False := B.trueNeFalse
    (\idelim(Nat^::zero = Nat^::succ n \with x: Nat^ => isZero^ Nat^::zero = isZero^ x)
      \by { base: \refl(B.Bool^::true), equality: e });
\definition succNeZero (n: Nat^) (e: Nat^::succ n = Nat^::zero): B.False := zeroNeSucc n (sym!{Nat^} _ _ e);
\definition eqbRefl: \forall (n: Nat^) -> eqb^ n n = B.Bool^::true :=
  \induction (n: Nat^) \return eqb^ n n = B.Bool^::true \with {
    | zero => (\refl(B.Bool^::true))
    | succ => (\fun (n: Nat^) => \fun (ih: eqb^ n n = B.Bool^::true) => ih)
    };
\definition eqOfEqbTrue: \forall (b, a: Nat^) -> eqb^ a b = B.Bool^::true -> a = b :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> eqb^ a b = B.Bool^::true -> a = b \with {
    | zero => (\induction (a: Nat^) \return eqb^ a Nat^::zero = B.Bool^::true -> a = Nat^::zero \with {
      | zero => (\fun (e: B.Bool^::true = B.Bool^::true) => \refl(Nat^::zero))
      | succ => (\fun (a: Nat^) => \fun (unused: eqb^ a Nat^::zero = B.Bool^::true -> a = Nat^::zero) =>
        \fun (e: B.Bool^::false = B.Bool^::true) => B.absurd (Nat^::succ a = Nat^::zero) e)
      })
    | succ => (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> eqb^ a b = B.Bool^::true -> a = b) =>
      \induction (a: Nat^) \return eqb^ a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b \with {
      | zero => (\fun (e: B.Bool^::false = B.Bool^::true) => B.absurd (Nat^::zero = Nat^::succ b) e)
      | succ => (\fun (a: Nat^) => \fun (unused: eqb^ a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b) =>
          \fun (e: eqb^ a b = B.Bool^::true) => succCong a b (ih a e))
      })
    };
\definition eqbTrueOfEq (a, b: Nat^) (e: a = b): eqb^ a b = B.Bool^::true :=
    \idelim(a = b \with x: Nat^ => eqb^ a x = B.Bool^::true) \by { base: eqbRefl a, equality: e };
\definition Le (a, b: Nat^): \Prop := leb^ a b = B.Bool^::true;
\definition Lt (a, b: Nat^): \Prop := ltb^ a b = B.Bool^::true;
\definition leRefl: Rel.Reflexive Le :=
  \induction (n: Nat^) \return Le n n \with {
    | zero => (\refl(B.Bool^::true))
    | succ => (\fun (n: Nat^) => \fun (ih: Le n n) => ih)
    };
\definition zeroLe: \forall (n: Nat^) -> Le Nat^::zero n :=
  \induction (n: Nat^) \return Le Nat^::zero n \with {
    | zero => (\refl(B.Bool^::true))
    | succ => (\fun (n: Nat^) => \fun (ih: Le Nat^::zero n) => \refl(B.Bool^::true))
    };
\definition ltIrrefl: Rel.Irreflexive Lt :=
  \induction (n: Nat^) \return Lt n n -> B.False \with {
    | zero => B.falseNeTrue
    | succ => (\fun (n: Nat^) => \fun (ih: Lt n n -> B.False) => ih)
    };
\definition leSuccSucc (a, b: Nat^) (e: Le a b): Le (Nat^::succ a) (Nat^::succ b) := e;
\definition leOfSuccSucc (a, b: Nat^) (e: Le (Nat^::succ a) (Nat^::succ b)): Le a b := e;
\definition ltSuccSucc (a, b: Nat^) (e: Lt a b): Lt (Nat^::succ a) (Nat^::succ b) := e;
\definition leZeroEq: \forall (a: Nat^) -> Le a Nat^::zero -> a = Nat^::zero :=
  \induction (a: Nat^) \return Le a Nat^::zero -> a = Nat^::zero \with {
    | zero => (\fun (e: Le Nat^::zero Nat^::zero) => \refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: Le a Nat^::zero -> a = Nat^::zero) => \fun (e: Le (Nat^::succ a) Nat^::zero) =>
      B.absurd (Nat^::succ a = Nat^::zero) e)
    };
\definition leAntisym: Rel.Antisymmetric Le :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Le a b -> Le b a -> a = b \with {
    | zero => (\fun (b: Nat^) => \fun (ab: Le Nat^::zero b) => \fun (ba: Le b Nat^::zero) => sym!{Nat^} b Nat^::zero (leZeroEq b ba))
    | succ => (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> Le a b -> Le b a -> a = b) =>
      \induction (b: Nat^) \return Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b \with {
      | zero => (\fun (ab: Le (Nat^::succ a) Nat^::zero) => \fun (ba: Le Nat^::zero (Nat^::succ a)) => leZeroEq (Nat^::succ a) ab)
      | succ => (\fun (b: Nat^) => \fun (unused: Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b) =>
          \fun (ab: Le (Nat^::succ a) (Nat^::succ b)) => \fun (ba: Le (Nat^::succ b) (Nat^::succ a)) =>
            succCong a b (ih b ab ba))
      })
    };
\definition leTrans: Rel.Transitive Le :=
  \induction (a: Nat^) \return \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c \with {
    | zero => (\fun (b, c: Nat^) => \fun (ab: Le Nat^::zero b) => \fun (bc: Le b c) => zeroLe c)
    | succ => (\fun (a: Nat^) => \fun (ih: \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c) =>
      \induction (b: Nat^) \return \forall (c: Nat^) -> Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c \with {
      | zero => (\fun (c: Nat^) => \fun (ab: Le (Nat^::succ a) Nat^::zero) => \fun (bc: Le Nat^::zero c) =>
          B.absurd (Le (Nat^::succ a) c) ab)
      | succ => (\fun (b: Nat^) => \fun (unused: \forall (c: Nat^) -> Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c) =>
          \induction (c: Nat^) \return Le (Nat^::succ a) (Nat^::succ b) -> Le (Nat^::succ b) c -> Le (Nat^::succ
            a) c \with {
        | zero => (\fun (ab: Le (Nat^::succ a) (Nat^::succ b)) => \fun (bc: Le (Nat^::succ b) Nat^::zero) => B.absurd (Le (Nat^::succ
              a) Nat^::zero) bc
            )
        | succ => (\fun (c: Nat^) => \fun (unusedC: Le (Nat^::succ a) (Nat^::succ b) -> Le (Nat^::succ b) c -> Le (Nat^::succ a) c)
              =>
              \fun (ab: Le (Nat^::succ a) (Nat^::succ b)) => \fun (bc: Le (Nat^::succ b) (Nat^::succ c)) => ih b c ab bc)
        })
      })
    };

\definition addCong: \forall (a, b, c, d: Nat^) -> a = b -> c = d -> add^ a c = add^ b d :=
  congr2!{Nat^ Nat^ Nat^} add^;
\definition addSwap: \forall (a, b, c: Nat^) -> add^ a (add^ b c) = add^ b (add^ a c) :=
  \block {
    \fix (a, b, c: Nat^) \then
    \let regroupLeft: add^ a (add^ b c) = add^ (add^ a b) c :=
      sym!{Nat^} _ _ (addAssoc a b c) \then
    \let swapLeft: add^ (add^ a b) c = add^ (add^ b a) c :=
      congr!{Nat^ Nat^} (\fun (x: Nat^) => add^ x c) _ _ (addComm a b) \then
    \return trans!{Nat^} _ _ _ regroupLeft
      (trans!{Nat^} _ _ _ swapLeft (addAssoc b a c))
  };
\definition addInterchange: \forall (a, b, c, d: Nat^) ->
  add^ (add^ a b) (add^ c d) = add^ (add^ a c) (add^ b d) :=
  \block {
    \fix (a, b, c, d: Nat^) \then
    \let regroupLeft:
      add^ (add^ a b) (add^ c d) = add^ a (add^ b (add^ c d)) :=
      addAssoc a b (add^ c d) \then
    \let swapMiddle:
      add^ a (add^ b (add^ c d)) = add^ a (add^ c (add^ b d)) :=
      congr!{Nat^ Nat^} (add^ a) _ _ (addSwap b c d) \then
    \return trans!{Nat^} _ _ _ regroupLeft
      (trans!{Nat^} _ _ _ swapMiddle (sym!{Nat^} _ _ (addAssoc a c (add^ b d))))
  };
\definition mulZeroLeft: \forall (a: Nat^) -> mul^ Nat^::zero a = Nat^::zero :=
  \induction (a: Nat^) \return mul^ Nat^::zero a = Nat^::zero \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: mul^ Nat^::zero a = Nat^::zero) =>
      trans!{Nat^} _ _ _ (mulSuccRight Nat^::zero a) (trans!{Nat^} (add^ Nat^::zero (mul^ Nat^::zero a)) (mul^
        Nat^::zero a) Nat^::zero (addZeroLeft (mul^ Nat^::zero a)) ih))
    };
\definition mulOneLeft: \forall (a: Nat^) -> mul^ (Nat^::succ Nat^::zero) a = a :=
  \induction (a: Nat^) \return mul^ (Nat^::succ Nat^::zero) a = a \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: mul^ (Nat^::succ Nat^::zero) a = a) =>
      trans!{Nat^} _ _ _ (mulSuccRight (Nat^::succ Nat^::zero) a)
        (trans!{Nat^} _ _ _ (addSuccLeft Nat^::zero (mul^ (Nat^::succ Nat^::zero) a))
          (succCong (add^ Nat^::zero (mul^ (Nat^::succ Nat^::zero) a)) a
            (trans!{Nat^} (add^ Nat^::zero (mul^ (Nat^::succ Nat^::zero) a)) (mul^ (Nat^::succ Nat^::zero) a) a
              (addZeroLeft (mul^ (Nat^::succ Nat^::zero) a)) ih))))
    };
\definition mulDistribRight (a, b: Nat^): \forall (c: Nat^) ->
  mul^ (add^ a b) c = add^ (mul^ a c) (mul^ b c) :=
  \induction (c: Nat^) \return mul^ (add^ a b) c = add^ (mul^ a c) (mul^ b c) \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\block {
      \fix (c: Nat^) \then
      \fix (ih: mul^ (add^ a b) c = add^ (mul^ a c) (mul^ b c)) \then
      \let inductionUnderAddition:
        add^ (add^ a b) (mul^ (add^ a b) c) =
          add^ (add^ a b) (add^ (mul^ a c) (mul^ b c)) :=
        congr!{Nat^ Nat^} (add^ (add^ a b))
          (mul^ (add^ a b) c) (add^ (mul^ a c) (mul^ b c)) ih \then
      \let interchange:
        add^ (add^ a b) (add^ (mul^ a c) (mul^ b c)) =
          add^ (add^ a (mul^ a c)) (add^ b (mul^ b c)) :=
        addInterchange a b (mul^ a c) (mul^ b c) \then
      \let foldSuccessors:
        add^ (add^ a (mul^ a c)) (add^ b (mul^ b c)) =
          add^ (mul^ a (Nat^::succ c)) (mul^ b (Nat^::succ c)) :=
        addCong _ _ _ _
          (sym!{Nat^} _ _ (mulSuccRight a c))
          (sym!{Nat^} _ _ (mulSuccRight b c)) \then
      \return trans!{Nat^} _ _ _ (mulSuccRight (add^ a b) c)
        (trans!{Nat^} _ _ _ inductionUnderAddition
          (trans!{Nat^} _ _ _ interchange foldSuccessors))
    })
    };
\definition mulSuccLeft: \forall (a, b: Nat^) -> mul^ (Nat^::succ a) b = add^ b (mul^ a b) :=
  \block {
    \fix (a, b: Nat^) \then
    \let removeOne:
      add^ (mul^ a b) (mul^ (Nat^::succ Nat^::zero) b) =
        add^ (mul^ a b) b :=
      congr!{Nat^ Nat^} (add^ (mul^ a b)) _ _ (mulOneLeft b) \then
    \return trans!{Nat^} _ _ _ (mulDistribRight a (Nat^::succ Nat^::zero) b)
      (trans!{Nat^} _ _ _ removeOne (addComm (mul^ a b) b))
  };
\definition mulComm (a: Nat^): \forall (b: Nat^) -> mul^ a b = mul^ b a :=
  \induction (b: Nat^) \return mul^ a b = mul^ b a \with {
    | zero => (sym!{Nat^} _ _ (mulZeroLeft a))
    | succ => (\fun (b: Nat^) => \fun (ih: mul^ a b = mul^ b a) =>
      trans!{Nat^} _ _ _ (mulSuccRight a b)
        (trans!{Nat^} _ _ _ (congr!{Nat^ Nat^} (add^ a) (mul^ a b) (mul^ b a) ih) (sym!{Nat^} _ _ (mulSuccLeft b a))))
    };
\definition mulOneRight (a: Nat^): mul^ a (Nat^::succ Nat^::zero) = a := trans!{Nat^} _ _ _ (mulComm a (Nat^::succ Nat^::zero)) (mulOneLeft a);
\definition mulDistribLeft: \forall (a, b, c: Nat^) ->
  mul^ a (add^ b c) = add^ (mul^ a b) (mul^ a c) :=
  \block {
    \fix (a, b, c: Nat^) \then
    \let distribute:
      mul^ (add^ b c) a = add^ (mul^ b a) (mul^ c a) :=
      mulDistribRight b c a \then
    \let commuteProducts:
      add^ (mul^ b a) (mul^ c a) = add^ (mul^ a b) (mul^ a c) :=
      addCong _ _ _ _ (mulComm b a) (mulComm c a) \then
    \return trans!{Nat^} _ _ _ (mulComm a (add^ b c))
      (trans!{Nat^} _ _ _ distribute commuteProducts)
  };
\definition mulAssoc (a, b: Nat^): \forall (c: Nat^) -> mul^ (mul^ a b) c = mul^ a (mul^ b c) :=
  \induction (c: Nat^) \return mul^ (mul^ a b) c = mul^ a (mul^ b c) \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\block {
      \fix (c: Nat^) \then
      \fix (ih: mul^ (mul^ a b) c = mul^ a (mul^ b c)) \then
      \let inductionUnderAddition:
        add^ (mul^ a b) (mul^ (mul^ a b) c) =
          add^ (mul^ a b) (mul^ a (mul^ b c)) :=
        congr!{Nat^ Nat^} (add^ (mul^ a b))
          (mul^ (mul^ a b) c) (mul^ a (mul^ b c)) ih \then
      \let factorLeft:
        add^ (mul^ a b) (mul^ a (mul^ b c)) =
          mul^ a (add^ b (mul^ b c)) :=
        sym!{Nat^} _ _ (mulDistribLeft a b (mul^ b c)) \then
      \let foldSuccessor:
        mul^ a (add^ b (mul^ b c)) = mul^ a (mul^ b (Nat^::succ c)) :=
        congr!{Nat^ Nat^} (mul^ a) _ _ (sym!{Nat^} _ _ (mulSuccRight b c)) \then
      \return trans!{Nat^} _ _ _ (mulSuccRight (mul^ a b) c)
        (trans!{Nat^} _ _ _ inductionUnderAddition
          (trans!{Nat^} _ _ _ factorLeft foldSuccessor))
    })
    };

\definition zeroEqSuccElim (n: Nat^) (P: \Prop) (e: Nat^::zero = Nat^::succ n): P :=
    B.absurd P
      (sym!{B.Bool^} B.Bool^::true B.Bool^::false
        (congr!{Nat^ B.Bool^} isZero^ Nat^::zero (Nat^::succ n) e));

\definition succEqZeroElim (n: Nat^) (P: \Prop) (e: Nat^::succ n = Nat^::zero): P :=
    B.absurd P
      (congr!{Nat^ B.Bool^} isZero^ (Nat^::succ n) Nat^::zero e);

\definition mulSuccSucc (a, k: Nat^):
  mul^ (Nat^::succ a) (Nat^::succ k) =
    Nat^::succ (add^ k (mul^ a (Nat^::succ k))) :=
    trans!{Nat^} _ _ _ (mulSuccLeft a (Nat^::succ k))
      (addSuccLeft k (mul^ a (Nat^::succ k)));

/* Multiplication by a successor is injective. */
\definition mulCancelRightSucc: \forall (k, a, b: Nat^) ->
  mul^ a (Nat^::succ k) = mul^ b (Nat^::succ k) -> a = b :=

  \fun (k: Nat^) =>
    \induction (a: Nat^) \return \forall (b: Nat^) ->
        mul^ a (Nat^::succ k) = mul^ b (Nat^::succ k) -> a = b \with {
      | zero => (\induction (b: Nat^) \return mul^ Nat^::zero (Nat^::succ k) = mul^ b (Nat^::succ k) ->
          Nat^::zero = b \with {
        | zero => (\fun (e: mul^ Nat^::zero (Nat^::succ k) =
          mul^ Nat^::zero (Nat^::succ k)) => \refl(Nat^::zero))
        | succ => (\fun (b: Nat^) =>
        \fun (unused: mul^ Nat^::zero (Nat^::succ k) =
          mul^ b (Nat^::succ k) -> Nat^::zero = b) =>
        \fun (e: mul^ Nat^::zero (Nat^::succ k) =
          mul^ (Nat^::succ b) (Nat^::succ k)) =>
          zeroEqSuccElim
            (add^ k (mul^ b (Nat^::succ k)))
            (Nat^::zero = Nat^::succ b)
            (trans!{Nat^} _ _ _
              (sym!{Nat^} _ _ (mulZeroLeft (Nat^::succ k)))
              (trans!{Nat^} _ _ _ e (mulSuccSucc b k))))
        })
      | succ => (\fun (a: Nat^) =>
      \fun (ih: \forall (b: Nat^) ->
        mul^ a (Nat^::succ k) = mul^ b (Nat^::succ k) -> a = b) =>
        \induction (b: Nat^) \return mul^ (Nat^::succ a) (Nat^::succ k) =
              mul^ b (Nat^::succ k) -> Nat^::succ a = b \with {
        | zero => (\fun (e: mul^ (Nat^::succ a) (Nat^::succ k) =
            mul^ Nat^::zero (Nat^::succ k)) =>
            succEqZeroElim
              (add^ k (mul^ a (Nat^::succ k)))
              (Nat^::succ a = Nat^::zero)
              (trans!{Nat^} _ _ _
                (sym!{Nat^} _ _ (mulSuccSucc a k))
                (trans!{Nat^} _ _ _ e (mulZeroLeft (Nat^::succ k)))))
        | succ => (\fun (b: Nat^) =>
          \fun (unused: mul^ (Nat^::succ a) (Nat^::succ k) =
            mul^ b (Nat^::succ k) -> Nat^::succ a = b) =>
          \fun (e: mul^ (Nat^::succ a) (Nat^::succ k) =
            mul^ (Nat^::succ b) (Nat^::succ k)) =>
            succCong a b
              (ih b
                (addCancelLeft k
                  (mul^ a (Nat^::succ k))
                  (mul^ b (Nat^::succ k))
                  (succInjective
                    (add^ k (mul^ a (Nat^::succ k)))
                    (add^ k (mul^ b (Nat^::succ k)))
                    (trans!{Nat^} _ _ _
                      (sym!{Nat^} _ _ (mulSuccSucc a k))
                      (trans!{Nat^} _ _ _ e (mulSuccSucc b k)))))))
        })
      };

/* General Law views of the arithmetic theorems above. */
\definition addCommutative: Law.Commutative Nat^ add^ :=
  \fun (a, b: Nat^) => addComm a b;
\definition addAssociative: Law.Associative Nat^ add^ :=
  \fun (a, b, c: Nat^) => addAssoc a b c;
\definition mulCommutative: Law.Commutative Nat^ mul^ :=
  \fun (a, b: Nat^) => mulComm a b;
\definition mulAssociative: Law.Associative Nat^ mul^ :=
  \fun (a, b, c: Nat^) => mulAssoc a b c;
\definition mulLeftDistributive: Law.LeftDistributive Nat^ mul^ add^ :=
  mulDistribLeft;
\definition mulRightDistributive: Law.RightDistributive Nat^ mul^ add^ :=
  \fun (a, b, c: Nat^) => mulDistribRight a b c;

\module Division;

\module Order;
