/* Arithmetic laws on the reflected operations. */
\import std.Logic[].Rel[] \as Rel;
\import std.Logic[].Law[] \as Law;
\definition succInjective (a, b: Nat^) (e: Nat^::succ a = Nat^::succ b): a = b := congr!{Nat^ Nat^} pred^ (Nat^::succ a) (Nat^::succ b) e;
\definition predZero: pred^ Nat^::zero = Nat^::zero := \refl(Nat^::zero);
\definition predSucc (n: Nat^): pred^ (Nat^::succ n) = n := \refl(n);
\definition addZeroRight (a: Nat^): \(a "+" { Nat^::zero }\) = a := \refl(a);
\definition addSuccLeft: \forall (a, b: Nat^) ->
  \({ Nat^::succ a } "+" b\) = Nat^::succ \(a "+" b\) :=
  \fun (a, b: Nat^) => eq_reason!{
    \({ Nat^::succ a } "+" b\)
    "=" { addPrec (Nat^::succ a) b } "by" { addMatchesPrec b (Nat^::succ a) }
    "=" { Nat^::succ (addPrec a b) } "by" { addPrecSuccLeft a b }
    "=" { Nat^::succ \(a "+" b\) }
    "by" { succCong _ _ (sym!{Nat^} _ _ (addMatchesPrec b a)) }
  };
\definition addSuccRight (a, b: Nat^): \(a "+" { Nat^::succ b }\) = Nat^::succ \(a "+" b\) := addSuccLeft a b;
\definition addZeroLeft: \forall (a: Nat^) -> \({ Nat^::zero } "+" a\) = a :=
  \induction (a: Nat^) \return \({ Nat^::zero } "+" a\) = a \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \({ Nat^::zero } "+" a\) = a) =>
      trans!{Nat^} _ _ _ (addSuccRight Nat^::zero a) (succCong \({ Nat^::zero } "+" a\) a ih))
    };
\definition addComm (a: Nat^): \forall (b: Nat^) -> \(a "+" b\) = \(b "+" a\) :=
  \induction (b: Nat^) \return \(a "+" b\) = \(b "+" a\) \with {
    | zero : sym!{Nat^} _ _ (addZeroLeft a)
    | succ : \fun (b: Nat^) (ih: \(a "+" b\) = \(b "+" a\)) => eq_reason!{
        \(a "+" { Nat^::succ b }\)
        "=" { Nat^::succ \(a "+" b\) } "by" { addSuccRight a b }
        "=" { Nat^::succ \(b "+" a\) } "by" { succCong _ _ ih }
        "=" \({ Nat^::succ b } "+" a\) "by" { sym!{Nat^} _ _ (addSuccLeft b a) }
      }
  };
\definition addAssoc (a, b: Nat^): \forall (c: Nat^) ->
  \((a "+" b) "+" c\) = \(a "+" (b "+" c)\) :=
  \induction (c: Nat^) \return \((a "+" b) "+" c\) = \(a "+" (b "+" c)\) \with {
    | zero : \refl(\(a "+" b\))
    | succ : \fun (c: Nat^) (ih: \((a "+" b) "+" c\) = \(a "+" (b "+" c)\)) =>
      eq_reason!{
        \((a "+" b) "+" { Nat^::succ c }\)
        "=" { Nat^::succ \((a "+" b) "+" c\) } "by" { addSuccRight \(a "+" b\) c }
        "=" { Nat^::succ \(a "+" (b "+" c)\) } "by" { succCong _ _ ih }
        "=" \(a "+" { Nat^::succ \(b "+" c\) }\)
        "by" { sym!{Nat^} _ _ (addSuccRight a \(b "+" c\)) }
        "=" \(a "+" (b "+" { Nat^::succ c })\)
        "by" { congr!{Nat^ Nat^} (add^ a) _ _ (sym!{Nat^} _ _ (addSuccRight b c)) }
      }
  };
\definition addCancelRight: \forall (c, a, b: Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b \with {
    | zero : (\fun (a, b: Nat^) => \fun (e: a = b) => e)
    | succ : (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> \(a "+" c\) = \(b "+" c\) -> a = b) =>
      \fun (a, b: Nat^) => \fun (e: \(a "+" { Nat^::succ c }\) = \(b "+" { Nat^::succ c }\)) =>
        ih a b (succInjective _ _
          (trans!{Nat^} _ _ _ (sym!{Nat^} _ _ (addSuccRight a c))
            (trans!{Nat^} _ _ _ e (addSuccRight b c)))))
    };
\definition addCancelLeft: \forall (c, a, b: Nat^) -> \(c "+" a\) = \(c "+" b\) -> a = b :=
  \fun (c, a, b: Nat^) (e: \(c "+" a\) = \(c "+" b\)) =>
    addCancelRight c a b eq_reason!{
      \(a "+" c\) "=" \(c "+" a\) "by" { addComm a c }
      "=" \(c "+" b\) "by" e
      "=" \(b "+" c\) "by" { addComm c b }
    };
\definition subZeroRight (a: Nat^): sub^ a Nat^::zero = a := \refl(a);
\definition subZeroLeft: \forall (a: Nat^) -> sub^ Nat^::zero a = Nat^::zero :=
  \induction (a: Nat^) \return sub^ Nat^::zero a = Nat^::zero \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: sub^ Nat^::zero a = Nat^::zero) => \refl(Nat^::zero))
    };
\definition subSuccSucc (a, b: Nat^): sub^ (Nat^::succ a) (Nat^::succ b) = sub^ a b := \refl(sub^ a b);
\definition subSelf: \forall (a: Nat^) -> sub^ a a = Nat^::zero :=
  \induction (a: Nat^) \return sub^ a a = Nat^::zero \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: sub^ a a = Nat^::zero) => ih)
    };
\definition subAddCancel: \forall (b, a: Nat^) -> sub^ \(a "+" b\) b = a :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> sub^ \(a "+" b\) b = a \with {
    | zero : (\fun (a: Nat^) => \refl(a))
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> sub^ \(a "+" b\) b = a) => \fun (a: Nat^) =>
      trans!{Nat^} _ _ _
        (congr!{Nat^ Nat^} (\fun (x: Nat^) => sub^ x (Nat^::succ b)) _ _ (addSuccRight a b)) (ih a))
    };
\definition mulZeroRight (a: Nat^): \(a "*" { Nat^::zero }\) = Nat^::zero := \refl(Nat^::zero);
\definition mulSuccRight (a, b: Nat^): \(a "*" { Nat^::succ b }\) = \(a "+" (a "*" b)\) := trans!{Nat^} _ _ _ (mulMatchesPrec a (Nat^::succ b))
    (congr!{Nat^ Nat^} (add^ a) _ _ (sym!{Nat^} _ _ (mulMatchesPrec a b)));
\definition powZero (a: Nat^): pow^ a Nat^::zero = Nat^::succ Nat^::zero := \refl(Nat^::succ
  Nat^::zero);
\definition powSucc (a, b: Nat^): pow^ a (Nat^::succ b) = \(a "*" { pow^ a b }\) := trans!{Nat^} _ _ _ (powMatchesPrec a (Nat^::succ b))
    (congr!{Nat^ Nat^} (mul^ a) _ _ (sym!{Nat^} _ _ (powMatchesPrec a b)));

/* Boolean decisions can be consumed directly as propositions. */
\definition zeroNeSucc (n: Nat^) (e: Nat^::zero = Nat^::succ n): B.False := B.trueNeFalse
    (\idelim(Nat^::zero = Nat^::succ n \with x: Nat^ => isZero^ Nat^::zero = isZero^ x)
      \by { base: \refl(B.Bool^::true), equality: e });
\definition succNeZero (n: Nat^) (e: Nat^::succ n = Nat^::zero): B.False := zeroNeSucc n (sym!{Nat^} _ _ e);
\definition eqbRefl: \forall (n: Nat^) -> eqb^ n n = B.Bool^::true :=
  \induction (n: Nat^) \return eqb^ n n = B.Bool^::true \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: Nat^) => \fun (ih: eqb^ n n = B.Bool^::true) => ih)
    };
\definition eqOfEqbTrue: \forall (b, a: Nat^) -> eqb^ a b = B.Bool^::true -> a = b :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> eqb^ a b = B.Bool^::true -> a = b \with {
    | zero : (\induction (a: Nat^) \return eqb^ a Nat^::zero = B.Bool^::true -> a = Nat^::zero \with {
      | zero : (\fun (e: B.Bool^::true = B.Bool^::true) => \refl(Nat^::zero))
      | succ : \block {
          \fix (a: Nat^) \then
          \fix (unused: eqb^ a Nat^::zero = B.Bool^::true -> a = Nat^::zero) \then
          \fix (e: B.Bool^::false = B.Bool^::true) \then
          \return B.absurd (Nat^::succ a = Nat^::zero) e
        }
      })
    | succ : \block {
        \fix (b: Nat^) \then
        \fix (ih: \forall (a: Nat^) -> eqb^ a b = B.Bool^::true -> a = b) \then
        \return \induction (a: Nat^) \return
          eqb^ a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b \with {
          | zero : \fun (e: B.Bool^::false = B.Bool^::true) =>
              B.absurd (Nat^::zero = Nat^::succ b) e
          | succ : \block {
              \fix (a: Nat^) \then
              \fix (unused: eqb^ a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b) \then
              \fix (e: eqb^ a b = B.Bool^::true) \then
              \return succCong a b (ih a e)
            }
          }
      }
    };
\definition eqbTrueOfEq (a, b: Nat^) (e: a = b): eqb^ a b = B.Bool^::true :=
    \idelim(a = b \with x: Nat^ => eqb^ a x = B.Bool^::true) \by { base: eqbRefl a, equality: e };
\definition Le (a, b: Nat^): \Prop := leb^ a b = B.Bool^::true;
\definition Lt (a, b: Nat^): \Prop := ltb^ a b = B.Bool^::true;
\definition leRefl: Rel.Reflexive Nat^ Le :=
  \induction (n: Nat^) \return Le n n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: Nat^) => \fun (ih: Le n n) => ih)
    };
\definition zeroLe: \forall (n: Nat^) -> Le Nat^::zero n :=
  \induction (n: Nat^) \return Le Nat^::zero n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: Nat^) => \fun (ih: Le Nat^::zero n) => \refl(B.Bool^::true))
    };
\definition ltIrrefl: Rel.Irreflexive Nat^ Lt :=
  \induction (n: Nat^) \return Lt n n -> B.False \with {
    | zero : B.falseNeTrue
    | succ : (\fun (n: Nat^) => \fun (ih: Lt n n -> B.False) => ih)
    };
\definition leSuccSucc (a, b: Nat^) (e: Le a b): Le (Nat^::succ a) (Nat^::succ b) := e;
\definition leOfSuccSucc (a, b: Nat^) (e: Le (Nat^::succ a) (Nat^::succ b)): Le a b := e;
\definition ltSuccSucc (a, b: Nat^) (e: Lt a b): Lt (Nat^::succ a) (Nat^::succ b) := e;
\definition leZeroEq: \forall (a: Nat^) -> Le a Nat^::zero -> a = Nat^::zero :=
  \induction (a: Nat^) \return Le a Nat^::zero -> a = Nat^::zero \with {
    | zero : (\fun (e: Le Nat^::zero Nat^::zero) => \refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: Le a Nat^::zero -> a = Nat^::zero) => \fun (e: Le (Nat^::succ a) Nat^::zero) =>
      B.absurd (Nat^::succ a = Nat^::zero) e)
    };
\definition leAntisym: Rel.Antisymmetric Nat^ Le :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Le a b -> Le b a -> a = b \with {
    | zero : \block {
        \fix (b: Nat^) \then
        \fix (ab: Le Nat^::zero b) \then
        \fix (ba: Le b Nat^::zero) \then
        \return sym!{Nat^} b Nat^::zero (leZeroEq b ba)
      }
    | succ : \block {
        \fix (a: Nat^) \then
        \fix (ih: \forall (b: Nat^) -> Le a b -> Le b a -> a = b) \then
        \return \induction (b: Nat^) \return
          Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b \with {
          | zero : \fun (ab: Le (Nat^::succ a) Nat^::zero)
            (ba: Le Nat^::zero (Nat^::succ a)) => leZeroEq (Nat^::succ a) ab
          | succ : \block {
              \fix (b: Nat^) \then
              \fix (unused: Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b) \then
              \fix (ab: Le (Nat^::succ a) (Nat^::succ b)) \then
              \fix (ba: Le (Nat^::succ b) (Nat^::succ a)) \then
              \return succCong a b (ih b ab ba)
            }
          }
      }
    };
\definition leTrans: Rel.Transitive Nat^ Le :=
  \induction (a: Nat^) \return \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c \with {
    | zero : \fun (b, c: Nat^) (ab: Le Nat^::zero b) (bc: Le b c) => zeroLe c
    | succ : \block {
        \fix (a: Nat^) \then
        \fix (ih: \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c) \then
        \return \induction (b: Nat^) \return \forall (c: Nat^) ->
          Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c \with {
          | zero : \fun (c: Nat^) (ab: Le (Nat^::succ a) Nat^::zero)
              (bc: Le Nat^::zero c) => B.absurd (Le (Nat^::succ a) c) ab
          | succ : \block {
              \fix (b: Nat^) \then
              \fix (unused: \forall (c: Nat^) ->
                Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c) \then
              \return \induction (c: Nat^) \return
                Le (Nat^::succ a) (Nat^::succ b) -> Le (Nat^::succ b) c ->
                  Le (Nat^::succ a) c \with {
                | zero : \fun (ab: Le (Nat^::succ a) (Nat^::succ b))
                    (bc: Le (Nat^::succ b) Nat^::zero) =>
                    B.absurd (Le (Nat^::succ a) Nat^::zero) bc
                | succ : \block {
                    \fix (c: Nat^) \then
                    \fix (unusedC: Le (Nat^::succ a) (Nat^::succ b) ->
                      Le (Nat^::succ b) c -> Le (Nat^::succ a) c) \then
                    \fix (ab: Le (Nat^::succ a) (Nat^::succ b)) \then
                    \fix (bc: Le (Nat^::succ b) (Nat^::succ c)) \then
                    \return ih b c ab bc
                  }
                }
            }
          }
      }
    };

\definition addCong: \forall (a, b, c, d: Nat^) -> a = b -> c = d -> \(a "+" c\) = \(b "+" d\) :=
  congr2!{Nat^ Nat^ Nat^} add^;
\definition addSwap: \forall (a, b, c: Nat^) -> \(a "+" (b "+" c)\) = \(b "+" (a "+" c)\) :=
  \fun (a, b, c: Nat^) => eq_reason!{
    \(a "+" (b "+" c)\)
    "=" \((a "+" b) "+" c\) "by" { sym!{Nat^} _ _ (addAssoc a b c) }
    "=" \((b "+" a) "+" c\)
    "by" { congr!{Nat^ Nat^} (\fun (n: Nat^) => \(n "+" c\)) _ _ (addComm a b) }
    "=" \(b "+" (a "+" c)\) "by" { addAssoc b a c }
  };
\definition addInterchange: \forall (a, b, c, d: Nat^) ->
  \((a "+" b) "+" (c "+" d)\) = \((a "+" c) "+" (b "+" d)\) :=
  \fun (a, b, c, d: Nat^) => eq_reason!{
    \((a "+" b) "+" (c "+" d)\)
    "=" \(a "+" (b "+" (c "+" d))\) "by" { addAssoc a b \(c "+" d\) }
    "=" \(a "+" (c "+" (b "+" d))\)
    "by" { congr!{Nat^ Nat^} (add^ a) _ _ (addSwap b c d) }
    "=" \((a "+" c) "+" (b "+" d)\) "by" { sym!{Nat^} _ _ (addAssoc a c \(b "+" d\)) }
  };
\definition mulZeroLeft: \forall (a: Nat^) -> \({ Nat^::zero } "*" a\) = Nat^::zero :=
  \induction (a: Nat^) \return \({ Nat^::zero } "*" a\) = Nat^::zero \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \({ Nat^::zero } "*" a\) = Nat^::zero) =>
      trans!{Nat^} _ _ _ (mulSuccRight Nat^::zero a) (trans!{Nat^} \({ Nat^::zero } "+" ({ Nat^::zero } "*" a)\) \({ Nat^::zero } "*" a\) Nat^::zero (addZeroLeft \({ Nat^::zero } "*" a\)) ih))
    };
\definition mulOneLeft: \forall (a: Nat^) -> \({ Nat^::succ Nat^::zero } "*" a\) = a :=
  \induction (a: Nat^) \return \({ Nat^::succ Nat^::zero } "*" a\) = a \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \({ Nat^::succ Nat^::zero } "*" a\) = a) =>
      trans!{Nat^} _ _ _ (mulSuccRight (Nat^::succ Nat^::zero) a)
        (trans!{Nat^} _ _ _ (addSuccLeft Nat^::zero \({ Nat^::succ Nat^::zero } "*" a\))
          (succCong \({ Nat^::zero } "+" ({ Nat^::succ Nat^::zero } "*" a)\) a
            (trans!{Nat^} \({ Nat^::zero } "+" ({ Nat^::succ Nat^::zero } "*" a)\) \({ Nat^::succ Nat^::zero } "*" a\) a
              (addZeroLeft \({ Nat^::succ Nat^::zero } "*" a\)) ih))))
    };
\definition mulDistribRight (a, b: Nat^): \forall (c: Nat^) ->
  \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\) :=
  \induction (c: Nat^) \return \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\) \with {
    | zero : \refl(Nat^::zero)
    | succ : \fun (c: Nat^) (ih: \((a "+" b) "*" c\) = \((a "*" c) "+" (b "*" c)\)) =>
      eq_reason!{
        \((a "+" b) "*" { Nat^::succ c }\)
        "=" \((a "+" b) "+" ((a "+" b) "*" c)\) "by" { mulSuccRight \(a "+" b\) c }
        "=" \((a "+" b) "+" ((a "*" c) "+" (b "*" c))\)
        "by" { congr!{Nat^ Nat^} (add^ \(a "+" b\)) _ _ ih }
        "=" \((a "+" (a "*" c)) "+" (b "+" (b "*" c))\)
        "by" { addInterchange a b \(a "*" c\) \(b "*" c\) }
        "=" \((a "*" { Nat^::succ c }) "+" (b "*" { Nat^::succ c })\)
        "by" { congr2!{Nat^ Nat^ Nat^} add^ _ _ _ _
          (sym!{Nat^} _ _ (mulSuccRight a c)) (sym!{Nat^} _ _ (mulSuccRight b c)) }
      }
  };
\definition mulSuccLeft: \forall (a, b: Nat^) -> \({ Nat^::succ a } "*" b\) = \(b "+" (a "*" b)\) :=
  \fun (a, b: Nat^) => eq_reason!{
    \({ Nat^::succ a } "*" b\)
    "=" \((a "*" b) "+" ({ Nat^::succ Nat^::zero } "*" b)\)
    "by" { mulDistribRight a (Nat^::succ Nat^::zero) b }
    "=" \((a "*" b) "+" b\)
    "by" { congr!{Nat^ Nat^} (add^ \(a "*" b\)) _ _ (mulOneLeft b) }
    "=" \(b "+" (a "*" b)\) "by" { addComm \(a "*" b\) b }
  };
\definition mulComm (a: Nat^): \forall (b: Nat^) -> \(a "*" b\) = \(b "*" a\) :=
  \induction (b: Nat^) \return \(a "*" b\) = \(b "*" a\) \with {
    | zero : sym!{Nat^} _ _ (mulZeroLeft a)
    | succ : \fun (b: Nat^) (ih: \(a "*" b\) = \(b "*" a\)) => eq_reason!{
        \(a "*" { Nat^::succ b }\)
        "=" \(a "+" (a "*" b)\) "by" { mulSuccRight a b }
        "=" \(a "+" (b "*" a)\) "by" { congr!{Nat^ Nat^} (add^ a) _ _ ih }
        "=" \({ Nat^::succ b } "*" a\) "by" { sym!{Nat^} _ _ (mulSuccLeft b a) }
      }
  };
\definition mulOneRight (a: Nat^): \(a "*" { Nat^::succ Nat^::zero }\) = a :=
  eq_reason!{
    \(a "*" { Nat^::succ Nat^::zero }\)
    "=" \({ Nat^::succ Nat^::zero } "*" a\) "by" { mulComm a (Nat^::succ Nat^::zero) }
    "=" a "by" { mulOneLeft a }
  };
\definition mulDistribLeft: \forall (a, b, c: Nat^) ->
  \(a "*" (b "+" c)\) = \((a "*" b) "+" (a "*" c)\) :=
  \fun (a, b, c: Nat^) => eq_reason!{
    \(a "*" (b "+" c)\)
    "=" \((b "+" c) "*" a\) "by" { mulComm a \(b "+" c\) }
    "=" \((b "*" a) "+" (c "*" a)\) "by" { mulDistribRight b c a }
    "=" \((a "*" b) "+" (a "*" c)\)
    "by" { congr2!{Nat^ Nat^ Nat^} add^ _ _ _ _ (mulComm b a) (mulComm c a) }
  };
\definition mulAssoc (a, b: Nat^): \forall (c: Nat^) ->
  \((a "*" b) "*" c\) = \(a "*" (b "*" c)\) :=
  \induction (c: Nat^) \return \((a "*" b) "*" c\) = \(a "*" (b "*" c)\) \with {
    | zero : \refl(Nat^::zero)
    | succ : \fun (c: Nat^) (ih: \((a "*" b) "*" c\) = \(a "*" (b "*" c)\)) =>
      eq_reason!{
        \((a "*" b) "*" { Nat^::succ c }\)
        "=" \((a "*" b) "+" ((a "*" b) "*" c)\) "by" { mulSuccRight \(a "*" b\) c }
        "=" \((a "*" b) "+" (a "*" (b "*" c))\)
        "by" { congr!{Nat^ Nat^} (add^ \(a "*" b\)) _ _ ih }
        "=" \(a "*" (b "+" (b "*" c))\) "by" { sym!{Nat^} _ _ (mulDistribLeft a b \(b "*" c\)) }
        "=" \(a "*" (b "*" { Nat^::succ c })\)
        "by" { congr!{Nat^ Nat^} (mul^ a) _ _ (sym!{Nat^} _ _ (mulSuccRight b c)) }
      }
  };

\definition zeroEqSuccElim (n: Nat^) (P: \Prop) (e: Nat^::zero = Nat^::succ n): P :=
    B.absurd P
      (sym!{B.Bool^} B.Bool^::true B.Bool^::false
        (congr!{Nat^ B.Bool^} isZero^ Nat^::zero (Nat^::succ n) e));

\definition succEqZeroElim (n: Nat^) (P: \Prop) (e: Nat^::succ n = Nat^::zero): P :=
    B.absurd P
      (congr!{Nat^ B.Bool^} isZero^ (Nat^::succ n) Nat^::zero e);

\definition mulSuccSucc (a, k: Nat^):
  \({ Nat^::succ a } "*" { Nat^::succ k }\) =
    Nat^::succ \(k "+" (a "*" { Nat^::succ k })\) :=
    trans!{Nat^} _ _ _ (mulSuccLeft a (Nat^::succ k))
      (addSuccLeft k \(a "*" { Nat^::succ k }\));

/* Multiplication by a successor is injective. */
\definition mulCancelRightSucc: \forall (k, a, b: Nat^) ->
  \(a "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) -> a = b :=

  \fun (k: Nat^) =>
    \induction (a: Nat^) \return \forall (b: Nat^) ->
        \(a "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) -> a = b \with {
      | zero : (\induction (b: Nat^) \return \({ Nat^::zero } "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) ->
          Nat^::zero = b \with {
        | zero : (\fun (e: \({ Nat^::zero } "*" { Nat^::succ k }\) =
          \({ Nat^::zero } "*" { Nat^::succ k }\)) => \refl(Nat^::zero))
        | succ : (\fun (b: Nat^) =>
        \fun (unused: \({ Nat^::zero } "*" { Nat^::succ k }\) =
          \(b "*" { Nat^::succ k }\) -> Nat^::zero = b) =>
        \fun (e: \({ Nat^::zero } "*" { Nat^::succ k }\) =
          \({ Nat^::succ b } "*" { Nat^::succ k }\)) =>
          zeroEqSuccElim
            \(k "+" (b "*" { Nat^::succ k })\)
            (Nat^::zero = Nat^::succ b)
            (trans!{Nat^} _ _ _
              (sym!{Nat^} _ _ (mulZeroLeft (Nat^::succ k)))
              (trans!{Nat^} _ _ _ e (mulSuccSucc b k))))
        })
      | succ : (\fun (a: Nat^) =>
      \fun (ih: \forall (b: Nat^) ->
        \(a "*" { Nat^::succ k }\) = \(b "*" { Nat^::succ k }\) -> a = b) =>
        \induction (b: Nat^) \return \({ Nat^::succ a } "*" { Nat^::succ k }\) =
              \(b "*" { Nat^::succ k }\) -> Nat^::succ a = b \with {
        | zero : (\fun (e: \({ Nat^::succ a } "*" { Nat^::succ k }\) =
            \({ Nat^::zero } "*" { Nat^::succ k }\)) =>
            succEqZeroElim
              \(k "+" (a "*" { Nat^::succ k })\)
              (Nat^::succ a = Nat^::zero)
              (trans!{Nat^} _ _ _
                (sym!{Nat^} _ _ (mulSuccSucc a k))
                (trans!{Nat^} _ _ _ e (mulZeroLeft (Nat^::succ k)))))
        | succ : (\fun (b: Nat^) =>
          \fun (unused: \({ Nat^::succ a } "*" { Nat^::succ k }\) =
            \(b "*" { Nat^::succ k }\) -> Nat^::succ a = b) =>
          \fun (e: \({ Nat^::succ a } "*" { Nat^::succ k }\) =
            \({ Nat^::succ b } "*" { Nat^::succ k }\)) =>
            succCong a b
              (ih b
                (addCancelLeft k
                  \(a "*" { Nat^::succ k }\)
                  \(b "*" { Nat^::succ k }\)
                  (succInjective
                    \(k "+" (a "*" { Nat^::succ k })\)
                    \(k "+" (b "*" { Nat^::succ k })\)
                    (trans!{Nat^} _ _ _
                      (sym!{Nat^} _ _ (mulSuccSucc a k))
                      (trans!{Nat^} _ _ _ e (mulSuccSucc b k)))))))
        })
      };

/* General Law views of the arithmetic theorems above. */
\definition addCommutative: Law.Commutative Nat^ add^ :=
  \fun (a, b: Nat^) => addComm a b;
\definition addAssociative: Law.Associative Nat^ add^ :=
  \fun (a, b, c: Nat^) => addAssoc a b c;
\definition mulCommutative: Law.Commutative Nat^ mul^ :=
  \fun (a, b: Nat^) => mulComm a b;
\definition mulAssociative: Law.Associative Nat^ mul^ :=
  \fun (a, b, c: Nat^) => mulAssoc a b c;
\definition mulLeftDistributive: Law.LeftDistributive Nat^ mul^ add^ :=
  mulDistribLeft;
\definition mulRightDistributive: Law.RightDistributive Nat^ mul^ add^ :=
  \fun (a, b, c: Nat^) => mulDistribRight a b c;

\module Division;

\module Order;
