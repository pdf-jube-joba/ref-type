/* Order lemmas used for rational comparisons and common sequence bounds. */
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Order[] \as O;
\import std.Logic[].Classical[] \as Classical;
\definition Trichotomy (a, b: Nat^): \Prop := O.Trichotomy[Nat^, Lt, a, b];
\definition comparisonSucc (a, b: Nat^) (h: Trichotomy a b):
  Trichotomy (Nat^::succ a) (Nat^::succ b) :=
  \match h \in O.Trichotomy \return (\fun (_: Trichotomy a b) =>
    Trichotomy (Nat^::succ a) (Nat^::succ b)) \with {
  | less ab : O.Trichotomy[Nat^, Lt, Nat^::succ a, Nat^::succ b]::less ab
  | equal ab : O.Trichotomy[Nat^, Lt, Nat^::succ a, Nat^::succ b]::equal (succCong a b ab)
  | greater ba : O.Trichotomy[Nat^, Lt, Nat^::succ a, Nat^::succ b]::greater ba
  };
\definition trichotomy: \forall (a, b: Nat^) -> Trichotomy a b :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Trichotomy a b \with {
    | zero : (\induction (b: Nat^) \return Trichotomy Nat^::zero b \with {
      | zero : O.Trichotomy[Nat^, Lt, Nat^::zero, Nat^::zero]::equal (\refl(Nat^::zero))
      | succ : (\fun (b: Nat^) => \fun (_: Trichotomy Nat^::zero b) =>
        O.Trichotomy[Nat^, Lt, Nat^::zero, Nat^::succ b]::less (\refl(B.Bool^::true)))
      })
    | succ : (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> Trichotomy a b) =>
      \induction (b: Nat^) \return Trichotomy (Nat^::succ a) b \with {
      | zero : O.Trichotomy[Nat^, Lt, Nat^::succ a, Nat^::zero]::greater (\refl(B.Bool^::true))
      | succ : (\fun (b: Nat^) => \fun (_: Trichotomy (Nat^::succ a) b) => comparisonSucc a b (ih b))
      })
    };

\definition comparable: O.Comparable Nat^ Lt := trichotomy;

\definition leStep: \forall (b, a: Nat^) -> Le a b -> Le a (Nat^::succ b) :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Le a b -> Le a (Nat^::succ b) \with {
    | zero : (\induction (a: Nat^) \return Le a Nat^::zero -> Le a (Nat^::succ Nat^::zero) \with {
      | zero : (\fun (_: Le Nat^::zero Nat^::zero) => \refl(B.Bool^::true))
      | succ : (\fun (a: Nat^) => \fun (_: Le a Nat^::zero -> Le a (Nat^::succ Nat^::zero)) =>
        \fun (bad: Le (Nat^::succ a) Nat^::zero) => B.absurd (Le (Nat^::succ a) (Nat^::succ Nat^::zero)) bad)
      })
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> Le a b -> Le a (Nat^::succ b)) =>
      \induction (a: Nat^) \return Le a (Nat^::succ b) -> Le a (Nat^::succ (Nat^::succ b)) \with {
      | zero : (\fun (_: Le Nat^::zero (Nat^::succ b)) => \refl(B.Bool^::true))
      | succ : (\fun (a: Nat^) => \fun (_: Le a (Nat^::succ b) -> Le a (Nat^::succ (Nat^::succ b))) =>
          \fun (h: Le (Nat^::succ a) (Nat^::succ b)) => ih a h)
      })
    };
\definition leAddRight (a: Nat^): \forall (b: Nat^) -> Le a \(a "+" b\) :=
  \induction (b: Nat^) \return Le a \(a "+" b\) \with {
    | zero : (leRefl a)
    | succ : (\fun (b: Nat^) => \fun (ih: Le a \(a "+" b\)) =>
      \idelim(Nat^::succ \(a "+" b\) = \(a "+" { Nat^::succ b }\)
        \with c: Nat^ => Le a c)
        \by { base: leStep \(a "+" b\) a ih, equality: sym!{Nat^} _ _ (addSuccRight a b) })
    };
\definition leAddLeft (a, b: Nat^): Le b \(a "+" b\) :=
  \idelim(\(b "+" a\) = \(a "+" b\) \with c: Nat^ => Le b c)
    \by { base: leAddRight b a, equality: addComm b a };

\definition ltZero: \forall (a: Nat^) -> Lt a Nat^::zero -> Logic.False :=
  \induction (a: Nat^) \return Lt a Nat^::zero -> Logic.False \with {
    | zero : B.falseNeTrue
    | succ : (\fun (a: Nat^) => \fun (_: Lt a Nat^::zero -> Logic.False) =>
      B.falseNeTrue)
    };

\definition zeroLtSucc (a: Nat^): Lt Nat^::zero (Nat^::succ a) :=
  \refl(B.Bool^::true);

\definition ltOfSuccSucc (a, b: Nat^)
  (h: Lt (Nat^::succ a) (Nat^::succ b)): Lt a b := h;

\definition ltStep: \forall (a, b: Nat^) -> Lt a b -> Lt a (Nat^::succ b) :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Lt a b -> Lt a (Nat^::succ b) \with {
    | zero : (\fun (b: Nat^) => \fun (_: Lt Nat^::zero b) => zeroLtSucc b)
    | succ : (\fun (a: Nat^) =>
      \fun (ih: \forall (b: Nat^) -> Lt a b -> Lt a (Nat^::succ b)) =>
        \induction (b: Nat^) \return Lt (Nat^::succ a) b -> Lt (Nat^::succ a) (Nat^::succ b) \with {
      | zero : (\fun (bad: Lt (Nat^::succ a) Nat^::zero) =>
            Logic.falseElim (Lt (Nat^::succ a) (Nat^::succ Nat^::zero))
              (ltZero (Nat^::succ a) bad))
      | succ : (\fun (b: Nat^) =>
            \fun (_: Lt (Nat^::succ a) b -> Lt (Nat^::succ a) (Nat^::succ b)) =>
              \fun (ab: Lt (Nat^::succ a) (Nat^::succ b)) =>
                ltSuccSucc a (Nat^::succ b) (ih b ab))
      })
    };

\definition zeroLtOfLt (b: Nat^): \forall (c: Nat^) ->
  Lt b c -> Lt Nat^::zero c :=
  \induction (c: Nat^) \return Lt b c -> Lt Nat^::zero c \with {
    | zero : (\fun (bad: Lt b Nat^::zero) =>
      Logic.falseElim (Lt Nat^::zero Nat^::zero) (ltZero b bad))
    | succ : (\fun (c: Nat^) => \fun (_: Lt b c -> Lt Nat^::zero c) =>
      \fun (_: Lt b (Nat^::succ c)) => zeroLtSucc c)
    };

\definition ltTrans: \forall (a, b, c: Nat^) -> Lt a b -> Lt b c -> Lt a c :=
  \induction (a: Nat^) \return \forall (b, c: Nat^) -> Lt a b -> Lt b c -> Lt a c \with {
    | zero : \fun (b, c: Nat^) (_: Lt Nat^::zero b) (bc: Lt b c) =>
        zeroLtOfLt b c bc
    | succ : \block {
        \fix (a: Nat^) \then
        \fix (ih: \forall (b, c: Nat^) -> Lt a b -> Lt b c -> Lt a c) \then
        \return \induction (b: Nat^) \return \forall (c: Nat^) ->
          Lt (Nat^::succ a) b -> Lt b c -> Lt (Nat^::succ a) c \with {
          | zero : \fun (c: Nat^) (bad: Lt (Nat^::succ a) Nat^::zero)
              (_: Lt Nat^::zero c) =>
              Logic.falseElim (Lt (Nat^::succ a) c) (ltZero (Nat^::succ a) bad)
          | succ : \block {
              \fix (b: Nat^) \then
              \fix (_: \forall (c: Nat^) -> Lt (Nat^::succ a) b ->
                Lt b c -> Lt (Nat^::succ a) c) \then
              \return \induction (c: Nat^) \return
                Lt (Nat^::succ a) (Nat^::succ b) -> Lt (Nat^::succ b) c ->
                  Lt (Nat^::succ a) c \with {
                | zero : \fun (_: Lt (Nat^::succ a) (Nat^::succ b))
                    (bad: Lt (Nat^::succ b) Nat^::zero) =>
                    Logic.falseElim (Lt (Nat^::succ a) Nat^::zero)
                      (ltZero (Nat^::succ b) bad)
                | succ : \block {
                    \fix (c: Nat^) \then
                    \fix (_: Lt (Nat^::succ a) (Nat^::succ b) ->
                      Lt (Nat^::succ b) c -> Lt (Nat^::succ a) c) \then
                    \fix (ab: Lt (Nat^::succ a) (Nat^::succ b)) \then
                    \fix (bc: Lt (Nat^::succ b) (Nat^::succ c)) \then
                    \return ih b c ab bc
                  }
                }
            }
          }
      }
    };

\definition ltAddRight (a, b: Nat^): \forall (c: Nat^) ->
  Lt a b -> Lt \(a "+" c\) \(b "+" c\) :=
  \induction (c: Nat^) \return Lt a b -> Lt \(a "+" c\) \(b "+" c\) \with {
    | zero : (\fun (ab: Lt a b) => ab)
    | succ : (\fun (c: Nat^) =>
      \fun (ih: Lt a b -> Lt \(a "+" c\) \(b "+" c\)) =>
        \fun (ab: Lt a b) =>
          \idelim(Nat^::succ \(a "+" c\) = \(a "+" { Nat^::succ c }\)
            \with left: Nat^ => Lt left \(b "+" { Nat^::succ c }\))
            \by { base:
              \idelim(Nat^::succ \(b "+" c\) = \(b "+" { Nat^::succ c }\)
                \with right: Nat^ => Lt (Nat^::succ \(a "+" c\)) right)
                \by { base: ltSuccSucc \(a "+" c\) \(b "+" c\) (ih ab), equality:
                  sym!{Nat^} _ _ (addSuccRight b c) }, equality:
              sym!{Nat^} _ _ (addSuccRight a c) })
    };

\definition ltAddLeft (c, a, b: Nat^) (ab: Lt a b):
  Lt \(c "+" a\) \(c "+" b\) :=
  \idelim(\(a "+" c\) = \(c "+" a\)
    \with left: Nat^ => Lt left \(c "+" b\))
    \by { base:
      \idelim(\(b "+" c\) = \(c "+" b\)
        \with right: Nat^ => Lt \(a "+" c\) right)
        \by { base: ltAddRight a b c ab, equality: addComm b c }, equality:
      addComm a c };

\definition ltRespects (a, b, c, d: Nat^) (ac: a = c) (bd: b = d)
  (ab: Lt a b): Lt c d :=
  \idelim(a = c \with left: Nat^ => Lt left d)
    \by { base:
      \idelim(b = d \with right: Nat^ => Lt a right)
        \by { base: ab, equality: bd }, equality:
      ac };

\definition ltCancelRight (a, b: Nat^): \forall (c: Nat^) ->
  Lt \(a "+" c\) \(b "+" c\) -> Lt a b :=
  \induction (c: Nat^) \return Lt \(a "+" c\) \(b "+" c\) -> Lt a b \with {
    | zero : (\fun (ab: Lt a b) => ab)
    | succ : (\fun (c: Nat^) =>
      \fun (ih: Lt \(a "+" c\) \(b "+" c\) -> Lt a b) =>
        \fun (ab: Lt \(a "+" { Nat^::succ c }\)
          \(b "+" { Nat^::succ c }\)) =>
            ih (ltOfSuccSucc \(a "+" c\) \(b "+" c\)
              (ltRespects
                \(a "+" { Nat^::succ c }\) \(b "+" { Nat^::succ c }\)
                (Nat^::succ \(a "+" c\)) (Nat^::succ \(b "+" c\))
                (addSuccRight a c) (addSuccRight b c) ab)))
    };

\definition ltCancelLeft (c, a, b: Nat^)
  (ab: Lt \(c "+" a\) \(c "+" b\)): Lt a b :=
  ltCancelRight a b c
    (ltRespects \(c "+" a\) \(c "+" b\)
      \(a "+" c\) \(b "+" c\)
      (addComm c a) (addComm c b) ab);

\definition addRotate (a, b, c: Nat^):
  \((a "+" b) "+" c\) = \((a "+" c) "+" b\) :=
  trans!{Nat^} _ _ _ (addAssoc a b c)
    (trans!{Nat^} _ _ _
      (congr!{Nat^ Nat^} (add^ a) _ _ (addComm b c))
      (sym!{Nat^} _ _ (addAssoc a c b)));

\definition ltAsym (a, b: Nat^) (ab: Lt a b) (ba: Lt b a): Logic.False :=
  ltIrrefl a (ltTrans a b a ab ba);
\definition ltNotEq (a, b: Nat^) (ab: Lt a b) (same: a = b): Logic.False :=
  ltIrrefl a
    (ltRespects a b a a (\refl(a)) (sym!{Nat^} _ _ same) ab);

\definition ltAdd (a, b, c, d: Nat^) (ab: Lt a b) (cd: Lt c d):
  Lt \(a "+" c\) \(b "+" d\) :=
  ltTrans \(a "+" c\) \(b "+" c\) \(b "+" d\)
    (ltAddRight a b c ab) (ltAddLeft b c d cd);

\definition ltMulSuccRight (a, b: Nat^): \forall (k: Nat^) ->
  Lt a b -> Lt \(a "*" { Nat^::succ k }\) \(b "*" { Nat^::succ k }\) :=
  \induction (k: Nat^) \return Lt a b ->
    Lt \(a "*" { Nat^::succ k }\) \(b "*" { Nat^::succ k }\) \with {
    | zero : (\fun (ab: Lt a b) =>
      ltRespects a b \(a "*" { Nat^::succ Nat^::zero }\)
        \(b "*" { Nat^::succ Nat^::zero }\)
        (sym!{Nat^} _ _ (mulOneRight a))
        (sym!{Nat^} _ _ (mulOneRight b)) ab)
    | succ : (\fun (k: Nat^) =>
      \fun (ih: Lt a b ->
        Lt \(a "*" { Nat^::succ k }\) \(b "*" { Nat^::succ k }\)) =>
        \fun (ab: Lt a b) =>
          ltRespects
            \(a "+" (a "*" { Nat^::succ k })\)
            \(b "+" (b "*" { Nat^::succ k })\)
            \(a "*" { Nat^::succ (Nat^::succ k) }\)
            \(b "*" { Nat^::succ (Nat^::succ k) }\)
            (sym!{Nat^} _ _ (mulSuccRight a (Nat^::succ k)))
            (sym!{Nat^} _ _ (mulSuccRight b (Nat^::succ k)))
            (ltAdd a b \(a "*" { Nat^::succ k }\)
              \(b "*" { Nat^::succ k }\) ab (ih ab)))
    };

\definition ltCancelMulSuccRight (a, b, k: Nat^)
  (scaled: Lt \(a "*" { Nat^::succ k }\)
    \(b "*" { Nat^::succ k }\)): Lt a b :=
  \match (trichotomy a b) \in O.Trichotomy
    \return (\fun (_: Trichotomy a b) => Lt a b) \with {
  | less ab : ab
  | equal ab :
          Logic.falseElim (Lt a b)
            (ltNotEq \(a "*" { Nat^::succ k }\)
              \(b "*" { Nat^::succ k }\) scaled
              (congr!{Nat^ Nat^} (\fun (n: Nat^) =>
                \(n "*" { Nat^::succ k }\)) a b ab))
  | greater ba :
          Logic.falseElim (Lt a b)
            (ltAsym \(a "*" { Nat^::succ k }\)
              \(b "*" { Nat^::succ k }\) scaled
              (ltMulSuccRight b a k ba))
  };

\definition ltSelfSucc: \forall (a: Nat^) -> Lt a (Nat^::succ a) :=
  \induction (a: Nat^) \return Lt a (Nat^::succ a) \with {
    | zero : (zeroLtSucc Nat^::zero)
    | succ : (\fun (a: Nat^) => \fun (ih: Lt a (Nat^::succ a)) => ih)
    };

\definition ltSuccPlus (a: Nat^): \forall (c: Nat^) ->
  Lt a \({ Nat^::succ a } "+" c\) :=
  \induction (c: Nat^) \return Lt a \({ Nat^::succ a } "+" c\) \with {
    | zero : (ltSelfSucc a)
    | succ : (\fun (c: Nat^) =>
      \fun (ih: Lt a \({ Nat^::succ a } "+" c\)) =>
        ltRespects a (Nat^::succ \({ Nat^::succ a } "+" c\))
          a \({ Nat^::succ a } "+" { Nat^::succ c }\)
          (\refl(a)) (sym!{Nat^} _ _ (addSuccRight (Nat^::succ a) c))
          (ltStep a \({ Nat^::succ a } "+" c\) ih))
    };

\definition ltPositiveProduct (a, k: Nat^):
  Lt a \({ Nat^::succ k } "*" { Nat^::succ a }\) :=
  ltRespects a
    \({ Nat^::succ a } "+" ({ Nat^::succ a } "*" k)\)
    a \({ Nat^::succ k } "*" { Nat^::succ a }\)
    (\refl(a))
    (trans!{Nat^} _ _ _
      (sym!{Nat^} _ _ (mulSuccRight (Nat^::succ a) k))
      (mulComm (Nat^::succ a) (Nat^::succ k)))
    (ltSuccPlus a \({ Nat^::succ a } "*" k\));

\definition commonBound (m, n: Nat^): Nat^ :=
  add^ m n;

\definition leftLeCommonBound (m, n: Nat^): Le m (commonBound m n) :=
  leAddRight m n;

\definition rightLeCommonBound (m, n: Nat^): Le n (commonBound m n) :=
  leAddLeft m n;

\definition fourBound (a, b, c, d: Nat^): Nat^ :=
  commonBound (commonBound a b) (commonBound c d);

\definition firstLeFourBound (a, b, c, d: Nat^):
    Le a (fourBound a b c d) :=
  leTrans a (commonBound a b) (fourBound a b c d)
    (leftLeCommonBound a b)
    (leftLeCommonBound (commonBound a b) (commonBound c d));

\definition secondLeFourBound (a, b, c, d: Nat^):
    Le b (fourBound a b c d) :=
  leTrans b (commonBound a b) (fourBound a b c d)
    (rightLeCommonBound a b)
    (leftLeCommonBound (commonBound a b) (commonBound c d));

\definition thirdLeFourBound (a, b, c, d: Nat^):
    Le c (fourBound a b c d) :=
  leTrans c (commonBound c d) (fourBound a b c d)
    (leftLeCommonBound c d)
    (rightLeCommonBound (commonBound a b) (commonBound c d));

\definition fourthLeFourBound (a, b, c, d: Nat^):
    Le d (fourBound a b c d) :=
  leTrans d (commonBound c d) (fourBound a b c d)
    (rightLeCommonBound c d)
    (rightLeCommonBound (commonBound a b) (commonBound c d));

\definition AdjacentBoundary (P: Nat^ -> \Prop): \Prop :=
  \exists { k : Nat^ \where Logic.And[P k, Logic.Not (P (Nat^::succ k))] };

\definition finiteBoundary (P: Nat^ -> \Prop):
  \forall (n: Nat^) -> P Nat^::zero ->
    Logic.Not (P n) -> AdjacentBoundary P :=
  \induction (n: Nat^) \return P Nat^::zero ->
      Logic.Not (P n) -> AdjacentBoundary P \with {
    | zero : (\fun (atZero: P Nat^::zero) =>
      \fun (notAtZero: Logic.Not (P Nat^::zero)) =>
        Logic.falseElim (AdjacentBoundary P) (notAtZero atZero))
    | succ : (\fun (n: Nat^) =>
      \fun (ih: P Nat^::zero ->
        Logic.Not (P n) -> AdjacentBoundary P) =>
      \fun (atZero: P Nat^::zero) =>
        \fun (notAtSucc: Logic.Not (P (Nat^::succ n))) =>
          Logic.orElim (P n) (Logic.Not (P n)) (AdjacentBoundary P)
            (\fun (atN: P n) =>
              \exact(
                \into[Nat^](n, { k : Nat^ \where Logic.And[P k,
                      Logic.Not (P (Nat^::succ k))] }) \by { Logic.And[P n,
                    Logic.Not (P (Nat^::succ n))]::# atN notAtSucc },
                \Cast[Nat^] ({ k : Nat^ \where Logic.And[P k,
                      Logic.Not (P (Nat^::succ k))] })))
            (\fun (notAtN: Logic.Not (P n)) => ih atZero notAtN)
            (Classical.excludedMiddle (P n)))
    };
