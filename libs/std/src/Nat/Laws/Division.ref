/* Projection specifications and reusable invariants for finite iterations. */
\import std.Logic[].Proposition[] \as Logic;
\definition firstMatchesPrec: \forall (p: NatPair) -> P.Times[Nat, Nat]::first^ p = natPairFirst p :=
  natPairElim (\fun (p: NatPair) => P.Times[Nat, Nat]::first^ p = natPairFirst p) (\fun (a, b: Nat^) => \refl(a));
\definition secondMatchesPrec: \forall (p: NatPair) -> P.Times[Nat, Nat]::second^ p = natPairSecond p :=
  natPairElim (\fun (p: NatPair) => P.Times[Nat, Nat]::second^ p = natPairSecond p) (\fun (a, b: Nat^) => \refl(b));
\definition pairIterInvariant (f: NatPair -> NatPair) (P: NatPair -> \Prop):
  (\forall (p: NatPair) -> P p -> P (f p)) -> \forall (n: Nat^) ->
    \forall (p: NatPair) -> P p -> P (PairIter::[set] f p n) :=
  \block {
    \fix (step: \forall (p: NatPair) -> P p -> P (f p)) \then
    \return \induction (n: Nat^) \return \forall (p: NatPair) ->
      P p -> P (PairIter::[set] f p n) \with {
      | zero : \fun (p: NatPair) (h: P p) => h
      | succ : \block {
          \fix (n: Nat^) \then
          \fix (ih: \forall (p: NatPair) -> P p -> P (PairIter::[set] f p n)) \then
          \fix (p: NatPair) \then
          \fix (h: P p) \then
          \return step (PairIter::[set] f p n) (ih p h)
        }
      }
  };
\definition leSuccOfEqbFalse: \forall (d, r: Nat^) -> Le r d -> Eqb::[set] r d = B.Bool^::false -> Le (Nat^::succ r) d :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Le r d -> Eqb::[set] r d = B.Bool^::false -> Le (Nat^::succ r) d \with {
    | zero : (\induction (r: Nat^) \return Le r Nat^::zero -> Eqb::[set] r Nat^::zero = B.Bool^::false -> Le (Nat^::succ r) Nat^::zero \with {
      | zero : \fun (h: Le Nat^::zero Nat^::zero)
        (e: B.Bool^::true = B.Bool^::false) =>
        B.absurd (Le (Nat^::succ Nat^::zero) Nat^::zero)
          (\idelim B.Bool^::true = B.Bool^::false \with t: B.Bool^ => t = B.Bool^::true
            \by { base: \refl(B.Bool^::true), equality: e })
      | succ : \block {
          \fix (r: Nat^) \then
          \fix (ih: Le r Nat^::zero -> Eqb::[set] r Nat^::zero = B.Bool^::false ->
            Le (Nat^::succ r) Nat^::zero) \then
          \fix (h: Le (Nat^::succ r) Nat^::zero) \then
          \fix (e: Eqb::[set] (Nat^::succ r) Nat^::zero = B.Bool^::false) \then
          \return B.absurd (Le (Nat^::succ (Nat^::succ r)) Nat^::zero) h
        }
      })
    | succ : \block {
        \fix (d: Nat^) \then
        \fix (ih: \forall (r: Nat^) -> Le r d -> Eqb::[set] r d = B.Bool^::false ->
          Le (Nat^::succ r) d) \then
        \return \induction (r: Nat^) \return Le r (Nat^::succ d) ->
          Eqb::[set] r (Nat^::succ d) = B.Bool^::false ->
          Le (Nat^::succ r) (Nat^::succ d) \with {
          | zero : \fun (h: Le Nat^::zero (Nat^::succ d))
              (e: Eqb::[set] Nat^::zero (Nat^::succ d) = B.Bool^::false) => zeroLe d
          | succ : \block {
              \fix (r: Nat^) \then
              \fix (unused: Le r (Nat^::succ d) ->
                Eqb::[set] r (Nat^::succ d) = B.Bool^::false ->
                Le (Nat^::succ r) (Nat^::succ d)) \then
              \fix (h: Le (Nat^::succ r) (Nat^::succ d)) \then
              \fix (e: Eqb::[set] (Nat^::succ r) (Nat^::succ d) = B.Bool^::false) \then
              \return ih r h e
            }
          }
      }
    };
\definition divModNextBound: \forall (d: Nat^) -> \forall (p: NatPair) -> Le (P.Times[Nat, Nat]::second^ p) d ->
  Le (P.Times[Nat, Nat]::second^ (DivModNext::[set] (Nat^::succ d) p)) d :=
  \fun (d: Nat^) => natPairElim
    (\fun (p: NatPair) => Le (P.Times[Nat, Nat]::second^ p) d -> Le (P.Times[Nat, Nat]::second^ (DivModNext::[set] (Nat^::succ d) p)) d)
    (\fun (q, r: Nat^) => \fun (h: Le r d) =>
      (\match (Eqb::[set] r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Eqb::[set] r d = hit ->
          Le (P.Times[Nat, Nat]::second^ (PairChoose::[set] hit (natPair (Nat^::succ q) Nat^::zero) (natPair q (Nat^::succ r)))) d) \with {
        | false : (\fun (e: Eqb::[set] r d = B.Bool^::false) => leSuccOfEqbFalse d r h e)
        | true : (\fun (e: Eqb::[set] r d = B.Bool^::true) => zeroLe d)
        }) (\refl(Eqb::[set] r d)));
\definition modBound (a, d: Nat^): Le (Mod::[set] a (Nat^::succ d)) d := pairIterInvariant (DivModNext::[set] (Nat^::succ d))
    (\fun (p: NatPair) => Le (P.Times[Nat, Nat]::second^ p) d) (divModNextBound d) a
    (natPair Nat^::zero Nat^::zero) (zeroLe d);

/* Reconstruction holds even at divisor zero. */
\definition divModValue (b: Nat^) (p: NatPair): Nat^ := \((b "*" { P.Times[Nat, Nat]::first^ p }) "+" { P.Times[Nat, Nat]::second^ p }\);
\definition divisionCarryValue: \forall (d, q: Nat^) ->
  divModValue (Nat^::succ d) (natPair (Nat^::succ q) Nat^::zero) =
    Nat^::succ (divModValue (Nat^::succ d) (natPair q d)) :=
  \block {
    \fix (d, q: Nat^) \then
    \let carryProduct:
      \({ Nat^::succ d } "*" { Nat^::succ q }\) =
        \({ Nat^::succ d } "+" ({ Nat^::succ d } "*" q)\) :=
      mulSuccRight (Nat^::succ d) q \then
    \let exposeSuccessor:
      \({ Nat^::succ d } "+" ({ Nat^::succ d } "*" q)\) =
        Nat^::succ \(d "+" ({ Nat^::succ d } "*" q)\) :=
      addSuccLeft d \({ Nat^::succ d } "*" q\) \then
    \return trans!{Nat^} _ _ _ carryProduct
      (trans!{Nat^} _ _ _ exposeSuccessor
        (succCong _ _ (addComm d \({ Nat^::succ d } "*" q\))))
  };
\definition divModNextValue: \forall (b: Nat^) -> \forall (p: NatPair) ->
  divModValue b (DivModNext::[set] b p) = Nat^::succ (divModValue b p) :=
  \fun (b: Nat^) => natPairElim
    (\fun (p: NatPair) => divModValue b (DivModNext::[set] b p) = Nat^::succ (divModValue b p))
    (\fun (q, r: Nat^) => \induction (b: Nat^) \return divModValue b (DivModNext::[set] b (natPair q r)) = Nat^::succ (divModValue b (natPair q r)) \with {
      | zero : (addSuccRight \({ Nat^::zero } "*" q\) r)
      | succ : (\fun (d: Nat^) => \fun (_: _) => (\match (Eqb::[set] r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => Eqb::[set] r d = hit ->
            divModValue (Nat^::succ d) (PairChoose::[set] hit (natPair (Nat^::succ q) Nat^::zero) (natPair q (Nat^::succ r))) =
              Nat^::succ (divModValue (Nat^::succ d) (natPair q r))) \with {
        | false : (\fun (e: Eqb::[set] r d = B.Bool^::false) => addSuccRight \({ Nat^::succ d } "*" q\) r)
        | true : (\fun (e: Eqb::[set] r d = B.Bool^::true) =>
            \idelim d = r \with x: Nat^ =>
              divModValue (Nat^::succ d) (natPair (Nat^::succ q) Nat^::zero) =
                Nat^::succ (divModValue (Nat^::succ d) (natPair q x))
              \by { base: divisionCarryValue d q, equality: sym!{Nat^} r d (eqOfEqbTrue d r e) })
        }) (\refl(Eqb::[set] r d)))
      } b);
\definition divModReconstructs: \forall (a, b: Nat^) -> divModValue b (DivMod::[set] a b) = a :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> divModValue b (DivMod::[set] a b) = a \with {
    | zero : (\fun (b: Nat^) => \refl(Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> divModValue b (DivMod::[set] a b) = a) => \fun (b: Nat^) =>
      trans!{Nat^} _ _ _ (divModNextValue b (DivMod::[set] a b)) (succCong _ _ (ih b)))
    };

/* The Euclidean loop's bound is proved, rather than assumed as fuel. */
\definition gcdIterZero: \forall (n, a: Nat^) ->
  PairIter::[set] GcdNext::[set] (natPair a Nat^::zero) n = natPair a Nat^::zero :=
  \induction (n: Nat^) \return \forall (a: Nat^) -> PairIter::[set] GcdNext::[set] (natPair a Nat^::zero) n = natPair a Nat^::zero \with {
    | zero : (\fun (a: Nat^) => \refl(natPair a Nat^::zero))
    | succ : (\fun (n: Nat^) => \fun (ih: \forall (a: Nat^) -> PairIter::[set] GcdNext::[set] (natPair a Nat^::zero) n = natPair a Nat^::zero) =>
      \fun (a: Nat^) => congr!{NatPair NatPair} GcdNext::[set] _ _ (ih a))
    };
\definition gcdIterSettles: \forall (n, a, b: Nat^) -> Le b n ->
  P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] (natPair a b) n) = Nat^::zero :=
  \induction (n: Nat^) \return \forall (a, b: Nat^) -> Le b n -> P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] (natPair a b) n) = Nat^::zero \with {
    | zero : (\fun (a, b: Nat^) => \fun (h: Le b Nat^::zero) => leZeroEq b h)
    | succ : (\fun (n: Nat^) => \fun (ih: \forall (a, b: Nat^) -> Le b n -> P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] (natPair a b) n) = Nat^::zero) =>
      \fun (a: Nat^) => \induction (b: Nat^) \return Le b (Nat^::succ n) -> P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] (natPair a b) (Nat^::succ n)) = Nat^::zero \with {
      | zero : (\fun (h: Le Nat^::zero (Nat^::succ n)) => congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (gcdIterZero (Nat^::succ n) a))
      | succ : (\fun (d: Nat^) => \fun (unused: Le d (Nat^::succ n) -> P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] (natPair a d) (Nat^::succ n)) = Nat^::zero) =>
          \fun (h: Le (Nat^::succ d) (Nat^::succ n)) =>
            \idelim PairIter::[set] GcdNext::[set] (GcdNext::[set] (natPair a (Nat^::succ d))) n =
                GcdNext::[set] (PairIter::[set] GcdNext::[set] (natPair a (Nat^::succ d)) n)
              \with p: NatPair => P.Times[Nat, Nat]::second^ p = Nat^::zero
              \by { base: ih (Nat^::succ d) (Mod::[set] a (Nat^::succ d))
                (leTrans (Mod::[set] a (Nat^::succ d)) d n (modBound a d) h), equality:
                (PairIteration.specification #advance) GcdNext::[set] n (natPair a (Nat^::succ d)) })
      })
    };
\definition gcdRemainderZero: \forall (a, b: Nat^) ->
  P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] (natPair a b) b) = Nat^::zero :=
  \fun (a, b: Nat^) => gcdIterSettles b a b (leRefl b);

/* Zero conventions and division of zero are universal equations. */
\definition divModZeroDivisor: \forall (a: Nat^) -> DivMod::[set] a Nat^::zero = natPair Nat^::zero a :=
  \induction (a: Nat^) \return DivMod::[set] a Nat^::zero = natPair Nat^::zero a \with {
    | zero : (\refl(natPair Nat^::zero Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: DivMod::[set] a Nat^::zero = natPair Nat^::zero a) =>
      congr!{NatPair NatPair} (DivModNext::[set] Nat^::zero) (DivMod::[set] a Nat^::zero) (natPair Nat^::zero a) ih)
    };
\definition divZeroRight (a: Nat^): Div::[set] a Nat^::zero = Nat^::zero :=
  congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModZeroDivisor a);
\definition modZeroRight (a: Nat^): Mod::[set] a Nat^::zero = a :=
  congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModZeroDivisor a);
\definition divZeroLeft (b: Nat^): Div::[set] Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
\definition modZeroLeft (b: Nat^): Mod::[set] Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
\definition gcdZeroRight (a: Nat^): Gcd::[set] a Nat^::zero = a := \refl(a);
\definition gcdZeroLeft: \forall (b: Nat^) -> Gcd::[set] Nat^::zero b = b :=
  \induction (b: Nat^) \return Gcd::[set] Nat^::zero b = b \with {
    | zero : (\refl(Nat^::zero))
    | succ : (\fun (d: Nat^) => \fun (ih: Gcd::[set] Nat^::zero d = d) => trans!{Nat^} _ _ _
      (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (sym!{NatPair} _ _ ((PairIteration.specification #advance)
        GcdNext::[set] d (natPair Nat^::zero (Nat^::succ d)))))
      (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (gcdIterZero d (Nat^::succ d))))
    };

/* Divisibility is constructive: a proof supplies a natural-number factor to
 * any propositional consumer (the usual existential encoding). */
\definition Divides (d, a: Nat^): \Prop := \forall (P: \Prop) -> (\forall (q: Nat^) -> a = \(d "*" q\) -> P) -> P;
\definition dividesIntro (d, a, q: Nat^) (e: a = \(d "*" q\)): Divides d a := \fun (P: \Prop) =>
    \fun (use: \forall (q: Nat^) -> a = \(d "*" q\) -> P) => use q e;
\definition dividesZero (d: Nat^): Divides d Nat^::zero := dividesIntro d Nat^::zero Nat^::zero (\refl(Nat^::zero));
\definition dividesSelf (d: Nat^): Divides d d := dividesIntro d d (Nat^::succ Nat^::zero) (sym!{Nat^} _ _ (mulOneRight d));
\definition dividesTransport (d: Nat^): \forall (a, b: Nat^) -> a = b -> Divides d a -> Divides d b :=
  transport!{Nat^} (Divides d);
\definition dividesAdd (d, a, b: Nat^) (ha: Divides d a) (hb: Divides d b): Divides d \(a "+" b\) :=
    ha (Divides d \(a "+" b\)) (\fun (x: Nat^) => \fun (ex: a = \(d "*" x\)) =>
      hb (Divides d \(a "+" b\)) (\fun (y: Nat^) => \fun (ey: b = \(d "*" y\)) =>
        dividesIntro d \(a "+" b\) \(x "+" y\)
          (trans!{Nat^} _ _ _ (addCong _ _ _ _ ex ey) (sym!{Nat^} _ _ (mulDistribLeft d x y)))));
\definition dividesMul (d, a, b: Nat^) (ha: Divides d a): Divides d \(a "*" b\) :=
    ha (Divides d \(a "*" b\)) (\fun (x: Nat^) => \fun (ex: a = \(d "*" x\)) =>
      dividesIntro d \(a "*" b\) \(x "*" b\)
        (trans!{Nat^} _ _ _ (congr!{Nat^ Nat^} (\fun (n: Nat^) => \(n "*" b\)) _ _ ex) (mulAssoc d x b)));
\definition subCong: \forall (a, b, c, d: Nat^) -> a = b -> c = d -> Sub::[set] a c = Sub::[set] b d :=
  congr2!{Nat^ Nat^ Nat^} Sub::[set];
\definition subAddBoth: \forall (c, a, b: Nat^) -> Sub::[set] \(a "+" c\) \(b "+" c\) = Sub::[set] a b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> Sub::[set] \(a "+" c\) \(b "+" c\) = Sub::[set] a b \with {
    | zero : (\fun (a, b: Nat^) => \refl(Sub::[set] a b))
    | succ : (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> Sub::[set] \(a "+" c\) \(b "+" c\) = Sub::[set] a b) =>
      \fun (a, b: Nat^) => trans!{Nat^} _ _ _
        (subCong _ _ _ _ (addSuccRight a c) (addSuccRight b c)) (ih a b))
    };
\definition mulSub (d: Nat^): \forall (b, a: Nat^) -> Sub::[set] \(d "*" a\) \(d "*" b\) = \(d "*" { Sub::[set] a b }\) :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> Sub::[set] \(d "*" a\) \(d "*" b\) = \(d "*" { Sub::[set] a b }\) \with {
    | zero : (\fun (a: Nat^) => \refl(\(d "*" a\)))
    | succ : (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> Sub::[set] \(d "*" a\) \(d "*" b\) = \(d "*" { Sub::[set] a b }\)) =>
      \induction (a: Nat^) \return Sub::[set] \(d "*" a\) \(d "*" { Nat^::succ b }\) = \(d "*" { Sub::[set] a (Nat^::succ b) }\) \with {
      | zero : (trans!{Nat^} _ _ _ (subZeroLeft \(d "*" { Nat^::succ b }\))
          (sym!{Nat^} _ _ (congr!{Nat^ Nat^} (Mul::[set] d) _ _ (subZeroLeft (Nat^::succ b)))))
      | succ : (\fun (a: Nat^) => \fun (unused: Sub::[set] \(d "*" a\) \(d "*" { Nat^::succ b }\) = \(d "*" { Sub::[set] a (Nat^::succ b) }\)) =>
          trans!{Nat^} _ _ _ (subCong _ _ _ _ (mulSuccRight d a) (mulSuccRight d b))
            (trans!{Nat^} _ _ _ (subCong _ _ _ _ (addComm d \(d "*" a\)) (addComm d \(d "*" b\)))
              (trans!{Nat^} _ _ _ (subAddBoth d \(d "*" a\) \(d "*" b\)) (ih a))))
      })
    };
\definition dividesSub (d, a, b: Nat^) (ha: Divides d a) (hb: Divides d b): Divides d (Sub::[set] a b) :=
    ha (Divides d (Sub::[set] a b)) (\fun (x: Nat^) => \fun (ex: a = \(d "*" x\)) =>
      hb (Divides d (Sub::[set] a b)) (\fun (y: Nat^) => \fun (ey: b = \(d "*" y\)) =>
        dividesIntro d (Sub::[set] a b) (Sub::[set] x y)
          (trans!{Nat^} _ _ _ (subCong _ _ _ _ ex ey) (mulSub d y x))));
\definition modAsSub: \forall (a, b: Nat^) -> Mod::[set] a b = Sub::[set] a \(b "*" { Div::[set] a b }\) :=
  \block {
    \fix (a, b: Nat^) \then
    \let reconstruction:
      \({ Mod::[set] a b } "+" (b "*" { Div::[set] a b })\) = a :=
      trans!{Nat^} _ _ _
        (addComm (Mod::[set] a b) \(b "*" { Div::[set] a b }\))
        (divModReconstructs a b) \then
    \let subtractReconstruction:
      Sub::[set] \({ Mod::[set] a b } "+" (b "*" { Div::[set] a b })\)
        \(b "*" { Div::[set] a b }\) =
      Sub::[set] a \(b "*" { Div::[set] a b }\) :=
      congr!{Nat^ Nat^} (\fun (x: Nat^) => Sub::[set] x \(b "*" { Div::[set] a b }\))
        _ _ reconstruction \then
    \return trans!{Nat^} _ _ _
      (sym!{Nat^} _ _ (subAddCancel \(b "*" { Div::[set] a b }\) (Mod::[set] a b)))
      subtractReconstruction
  };
\definition dividesMod: \forall (d, a, b: Nat^) -> Divides d a -> Divides d b -> Divides d (Mod::[set] a b) :=
  \block {
    \fix (d, a, b: Nat^) \then
    \fix (ha: Divides d a) (hb: Divides d b) \then
    \let productDivides: Divides d \(b "*" { Div::[set] a b }\) :=
      dividesMul d b (Div::[set] a b) hb \then
    \let differenceDivides: Divides d (Sub::[set] a \(b "*" { Div::[set] a b }\)) :=
      dividesSub d a \(b "*" { Div::[set] a b }\) ha productDivides \then
    \return dividesTransport d (Sub::[set] a \(b "*" { Div::[set] a b }\)) (Mod::[set] a b)
      (sym!{Nat^} _ _ (modAsSub a b)) differenceDivides
  };
\definition dividesOfMod: \forall (d, a, b: Nat^) -> Divides d b -> Divides d (Mod::[set] a b) -> Divides d a :=
  \block {
    \fix (d, a, b: Nat^) \then
    \fix (hb: Divides d b) (hr: Divides d (Mod::[set] a b)) \then
    \let quotientProductDivides: Divides d \(b "*" { Div::[set] a b }\) :=
      dividesMul d b (Div::[set] a b) hb \then
    \let reconstructionDivides:
      Divides d \((b "*" { Div::[set] a b }) "+" { Mod::[set] a b }\) :=
      dividesAdd d \(b "*" { Div::[set] a b }\) (Mod::[set] a b) quotientProductDivides hr \then
    \return dividesTransport d \((b "*" { Div::[set] a b }) "+" { Mod::[set] a b }\) a
      (divModReconstructs a b) reconstructionDivides
  };

\definition CommonDivisor (d, a, b: Nat^): \Prop :=
  Logic.And[Divides d a, Divides d b];

\definition gcdNextPreserves: \forall (d: Nat^) -> \forall (p: NatPair) -> CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) ->
  CommonDivisor d (P.Times[Nat, Nat]::first^ (GcdNext::[set] p)) (P.Times[Nat, Nat]::second^ (GcdNext::[set] p)) :=
  \fun (d: Nat^) => natPairElim
    (\fun (p: NatPair) => CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ (GcdNext::[set] p)) (P.Times[Nat, Nat]::second^ (GcdNext::[set] p)))
    (\fun (a, b: Nat^) => \induction (b: Nat^) \return CommonDivisor d a b ->
        CommonDivisor d (P.Times[Nat, Nat]::first^ (GcdNext::[set] (natPair a b))) (P.Times[Nat, Nat]::second^ (GcdNext::[set] (natPair a b))) \with {
          | zero : (\fun (h: CommonDivisor d a Nat^::zero) => h)
          | succ : \block {
              \fix (k: Nat^) \then
              \fix (_: _) \then
              \fix (h: CommonDivisor d a (Nat^::succ k)) \then
              \return Logic.And[_, _] {
                left := #right{h},
                right := dividesMod d a (Nat^::succ k) (#left{h}) (#right{h}),
              }
            }
          } b);
\definition gcdNextReflects: \forall (d: Nat^) -> \forall (p: NatPair) ->
  CommonDivisor d (P.Times[Nat, Nat]::first^ (GcdNext::[set] p)) (P.Times[Nat, Nat]::second^ (GcdNext::[set] p)) -> CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) :=
  \fun (d: Nat^) => natPairElim
    (\fun (p: NatPair) => CommonDivisor d (P.Times[Nat, Nat]::first^ (GcdNext::[set] p)) (P.Times[Nat, Nat]::second^ (GcdNext::[set] p)) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p))
    (\fun (a, b: Nat^) => \induction (b: Nat^) \return CommonDivisor d (P.Times[Nat, Nat]::first^ (GcdNext::[set] (natPair a b))) (P.Times[Nat, Nat]::second^ (GcdNext::[set] (natPair a b))) ->
        CommonDivisor d a b \with {
          | zero : (\fun (h: CommonDivisor d a Nat^::zero) => h)
          | succ : \block {
              \fix (k: Nat^) \then
              \fix (_: _) \then
              \fix (h: CommonDivisor d (Nat^::succ k) (Mod::[set] a (Nat^::succ k))) \then
              \return Logic.And[_, _] {
                left := dividesOfMod d a (Nat^::succ k) (#left{h}) (#right{h}),
                right := #left{h},
              }
            }
          } b);
\definition gcdIterReflects: \forall (d, n: Nat^) -> \forall (p: NatPair) ->
  CommonDivisor d (P.Times[Nat, Nat]::first^ (PairIter::[set] GcdNext::[set] p n)) (P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] p n)) ->
    CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) :=
  \block {
    \fix (d: Nat^) \then
    \return \induction (n: Nat^) \return \forall (p: NatPair) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ (PairIter::[set] GcdNext::[set] p n))
        (P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] p n)) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) \with {
      | zero : \fun (p: NatPair)
          (h: CommonDivisor d (P.Times[Nat, Nat]::first^ p)
            (P.Times[Nat, Nat]::second^ p)) => h
      | succ : \block {
          \fix (n: Nat^) \then
          \fix (ih: \forall (p: NatPair) ->
            CommonDivisor d (P.Times[Nat, Nat]::first^ (PairIter::[set] GcdNext::[set] p n))
              (P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] p n)) ->
            CommonDivisor d (P.Times[Nat, Nat]::first^ p)
              (P.Times[Nat, Nat]::second^ p)) \then
          \fix (p: NatPair) \then
          \fix (h: CommonDivisor d
            (P.Times[Nat, Nat]::first^ (PairIter::[set] GcdNext::[set] p (Nat^::succ n)))
            (P.Times[Nat, Nat]::second^ (PairIter::[set] GcdNext::[set] p (Nat^::succ n)))) \then
          \return ih p (gcdNextReflects d (PairIter::[set] GcdNext::[set] p n) h)
        }
      }
  };
\definition gcdFinal (a, b: Nat^): NatPair := PairIter::[set] GcdNext::[set] (natPair a b) b;
\definition gcdFinalFirst (a, b: Nat^): P.Times[Nat, Nat]::first^ (gcdFinal a b) = Gcd::[set] a b :=
  \refl(Gcd::[set] a b);
\definition gcdFinalSecond (a, b: Nat^): P.Times[Nat, Nat]::second^ (gcdFinal a b) = Nat^::zero := gcdIterSettles b a b (leRefl b);
\definition gcdCommonDivisor: \forall (a, b: Nat^) -> CommonDivisor (Gcd::[set] a b) a b :=
  \block {
    \fix (a, b: Nat^) \then
    \let finalFirstDivides: Divides (Gcd::[set] a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b)) :=
      dividesTransport (Gcd::[set] a b) (Gcd::[set] a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b))
        (sym!{Nat^} _ _ (gcdFinalFirst a b)) (dividesSelf (Gcd::[set] a b)) \then
    \let finalSecondDivides: Divides (Gcd::[set] a b) (P.Times[Nat, Nat]::second^ (gcdFinal a b)) :=
      dividesTransport (Gcd::[set] a b) Nat^::zero (P.Times[Nat, Nat]::second^ (gcdFinal a b))
        (sym!{Nat^} _ _ (gcdFinalSecond a b)) (dividesZero (Gcd::[set] a b)) \then
    \let finalCommonDivisor:
      CommonDivisor (Gcd::[set] a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b)) (P.Times[Nat, Nat]::second^ (gcdFinal a b)) :=
      Logic.And[_, _] {
        left := finalFirstDivides,
        right := finalSecondDivides,
      } \then
    \return gcdIterReflects (Gcd::[set] a b) b (natPair a b) finalCommonDivisor
  };
\definition gcdDividesLeft (a, b: Nat^): Divides (Gcd::[set] a b) a :=
  #left{(gcdCommonDivisor a b)};
\definition gcdDividesRight (a, b: Nat^): Divides (Gcd::[set] a b) b :=
  #right{(gcdCommonDivisor a b)};
\definition gcdGreatest: \forall (d, a, b: Nat^) -> Divides d a -> Divides d b -> Divides d (Gcd::[set] a b) :=
  \block {
    \fix (d, a, b: Nat^) \then
    \fix (ha: Divides d a) (hb: Divides d b) \then
    \let finalCommonDivisor:
      CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdFinal a b)) (P.Times[Nat, Nat]::second^ (gcdFinal a b)) :=
      pairIterInvariant GcdNext::[set]
        (\fun (p: NatPair) => CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p))
        (gcdNextPreserves d) b (natPair a b)
        (Logic.And[_, _] { left := ha, right := hb }) \then
    \return dividesTransport d (P.Times[Nat, Nat]::first^ (gcdFinal a b)) (Gcd::[set] a b)
      (gcdFinalFirst a b) (#left{finalCommonDivisor})
  };

\definition leToLtSucc: \forall (d, r: Nat^) -> Le r d -> Lt r (Nat^::succ d) :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Le r d -> Lt r (Nat^::succ d) \with {
    | zero : (\induction (r: Nat^) \return Le r Nat^::zero -> Lt r (Nat^::succ Nat^::zero) \with {
      | zero : (\fun (h: Le Nat^::zero Nat^::zero) => \refl(B.Bool^::true))
      | succ : (\fun (r: Nat^) => \fun (ih: Le r Nat^::zero -> Lt r (Nat^::succ Nat^::zero)) =>
        \fun (h: Le (Nat^::succ r) Nat^::zero) => B.absurd (Lt (Nat^::succ r) (Nat^::succ Nat^::zero)) h)
      })
    | succ : (\fun (d: Nat^) => \fun (ih: \forall (r: Nat^) -> Le r d -> Lt r (Nat^::succ d)) =>
      \induction (r: Nat^) \return Le r (Nat^::succ d) -> Lt r (Nat^::succ (Nat^::succ d)) \with {
      | zero : (\fun (h: Le Nat^::zero (Nat^::succ d)) => \refl(B.Bool^::true))
      | succ : (\fun (r: Nat^) => \fun (unused: Le r (Nat^::succ d) -> Lt r (Nat^::succ (Nat^::succ d))) =>
          \fun (h: Le (Nat^::succ r) (Nat^::succ d)) => ih r h)
      })
    };
\definition modLt (a, d: Nat^): Lt (Mod::[set] a (Nat^::succ d)) (Nat^::succ d) := leToLtSucc d (Mod::[set] a (Nat^::succ d)) (modBound a d);
\definition divModOne: \forall (a: Nat^) -> DivMod::[set] a (Nat^::succ Nat^::zero) = natPair a Nat^::zero :=
  \induction (a: Nat^) \return DivMod::[set] a (Nat^::succ Nat^::zero) = natPair a Nat^::zero \with {
    | zero : (\refl(natPair Nat^::zero Nat^::zero))
    | succ : (\fun (a: Nat^) => \fun (ih: DivMod::[set] a (Nat^::succ Nat^::zero) = natPair a Nat^::zero) =>
      congr!{NatPair NatPair} (DivModNext::[set] (Nat^::succ Nat^::zero))
        (DivMod::[set] a (Nat^::succ Nat^::zero)) (natPair a Nat^::zero) ih)
    };
\definition divOne (a: Nat^): Div::[set] a (Nat^::succ Nat^::zero) = a :=
  congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModOne a);
\definition modOne (a: Nat^): Mod::[set] a (Nat^::succ Nat^::zero) = Nat^::zero :=
  congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModOne a);
