\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Fractions[] \as Fractions;
\import N.Pair[].Def[] \as Pair;
\import N.Pair[].Enumeration[] \as Pairs;
\definition integerValue[p: Pair.NatPair]: I.Integer := I.integer (Pair.natPairFirst p) (Pair.natPairSecond p);
\definition integer[k: N.Nat^]: I.Integer := integerValue (Pairs.enumerate k);
\definition IntegerOccurs[x: I.Integer]: \Prop := \exists ( k: N.Nat^ \where integer k = x );
\definition integerExhaustive: \forall (x: I.Integer) -> IntegerOccurs x :=
  \induction (x: I.Int^) \return IntegerOccurs x \with {
    | ofNat: \block {
      \fun (a: N.Nat^) \then
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Pairs.enumerate k = Pair.natPair a N.Nat^::zero }) \by Pairs.exhaustive a N.Nat^::zero \then
      \let found: Pairs.enumerate k = Pair.natPair a N.Nat^::zero := \bysub(N.Nat^,
        { k: N.Nat^ \where Pairs.enumerate k = Pair.natPair a N.Nat^::zero }, k) \then
      \return Logic.existsIntro[N.Nat^, { l: N.Nat^ \where integer l = I.Int^::ofNat a }] k
        (trans!{I.Integer} _ _ _ (congr!{Pair.NatPair I.Integer} integerValue _ _ found) (sym!{I.Integer} _ _ (I.ofNatAsInteger a)))
    }
    | negSucc: \block {
      \fun (a: N.Nat^) \then
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Pairs.enumerate k = Pair.natPair N.Nat^::zero (N.Nat^::succ a) }) \by Pairs.exhaustive N.Nat^::zero (N.Nat^::succ a) \then
      \let found: Pairs.enumerate k = Pair.natPair N.Nat^::zero (N.Nat^::succ a) := \bysub(N.Nat^,
        { k: N.Nat^ \where Pairs.enumerate k = Pair.natPair N.Nat^::zero (N.Nat^::succ a) }, k) \then
      \return Logic.existsIntro[N.Nat^, { l: N.Nat^ \where integer l = I.Int^::negSucc a }] k
        (trans!{I.Integer} _ _ _ (congr!{Pair.NatPair I.Integer} integerValue _ _ found)
          (I.integerEqOfFields (I.integer N.Nat^::zero (N.Nat^::succ a)) (I.Int^::negSucc a) (\refl(N.Nat^::zero)) (\refl(N.Nat^::succ a))))
    }
  };
\definition fractionValue[p: Pair.NatPair]: Fractions.Fraction := Fractions.Fraction {
  numerator := integer (Pair.natPairFirst p), denominatorIndex := Pair.natPairSecond p,
};
\definition fraction[k: N.Nat^]: Fractions.Fraction := fractionValue (Pairs.enumerate k);
\definition eta: \forall (x: Fractions.Fraction) -> Fractions.Fraction::# (x.numerator) (x.denominatorIndex) = x :=
  \induction (x: Fractions.Fraction) \return Fractions.Fraction::# (x.numerator) (x.denominatorIndex) = x \with {
    | # : \fun (a: I.Integer)(b: N.Nat^) => \refl(Fractions.Fraction::# a b)
  };
\definition exhaustive: \forall (x: Fractions.Fraction) -> \exists ( k: N.Nat^ \where fraction k = x ) := \block {
  \fun (x: _) \then
  \takefrom a: \Cast[N.Nat^] ({ k: N.Nat^ \where integer k = x.numerator }) \by integerExhaustive (x.numerator) \then
  \let numeratorLaw: integer a = x.numerator := \bysub(N.Nat^, { k: N.Nat^ \where integer k = x.numerator }, a) \then
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Pairs.enumerate k = Pair.natPair a (x.denominatorIndex) }) \by Pairs.exhaustive a (x.denominatorIndex) \then
  \let found: Pairs.enumerate k = Pair.natPair a (x.denominatorIndex) := \bysub(N.Nat^,
    { k: N.Nat^ \where Pairs.enumerate k = Pair.natPair a (x.denominatorIndex) }, k) \then
  \return Logic.existsIntro[N.Nat^, { l: N.Nat^ \where fraction l = x }] k
    (eq_reason_in!{Fractions.Fraction _
      "=" _ "by" { congr!{Pair.NatPair Fractions.Fraction} fractionValue _ _ found }
      "=" _ "by" { congr!{I.Integer Fractions.Fraction} (\fun (z: I.Integer) => Fractions.Fraction { numerator := z, denominatorIndex := x.denominatorIndex })
        (integer a) (x.numerator) numeratorLaw }
      "=" _ "by" { eta x }
    })
};
\import std.Set[].Countability[A := Fractions.Fraction] \as Countability;
\definition enumerator: Countability.Enumerator := Countability.Enumerator {
  sequence := fraction, exhaustive := exhaustive,
};
