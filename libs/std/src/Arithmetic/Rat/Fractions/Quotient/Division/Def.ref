\import \parent.Prop[] \as Prop;

\definition div(x: Rat) (y: NonZeroRat): Rat :=
  \into[\Pow Fraction](DivClass x y, ClassSet) \by { Prop.divClassIsClass x y };

\definition divOfRepresentatives(x: Rat) (y: NonZeroRat) (a, b: Fraction):
  x = ClassOf a -> y = ClassOf b ->
  div x y = class (ArithmeticDef.mul a (ArithmeticDef.reciprocal b)) :=
  Prop.divClassOfRepresentatives x y a b;
