\use Logic::either;
\import \parent.Def[] \as Def;

\definition fractionAddZeroRight(x: Fraction): FractionEq (Def.add x zero) x :=
    fractionEqOfParts
      (#numerator{(Def.add x zero)})
      (#numerator{x})
      (#denominatorIndex{(Def.add x zero)})
      (#denominatorIndex{x})
      (equiv_reason_terms!{I.integerEqTrans { #numerator{(Def.add x zero)} }
        "~" { I.addInteger (#numerator{x}) I.zeroInteger } "by" { I.addIntegerRespects
          (I.mulInteger (#numerator{x}) (denominator zero))
          (#numerator{x})
          (I.mulInteger I.zeroInteger (denominator x))
          I.zeroInteger
          (I.mulIntegerOneRight (#numerator{x}))
          (I.mulIntegerZeroLeft (denominator x)) }
        "~" { #numerator{x} } "by" { I.addIntegerZeroRight (#numerator{x}) }})
      (denominatorProductIndexZeroRight
        (#denominatorIndex{x}));

\definition fractionAddZeroLeft(x: Fraction): FractionEq (Def.add zero x) x :=
    fractionEqOfParts
      (#numerator{(Def.add zero x)})
      (#numerator{x})
      (#denominatorIndex{(Def.add zero x)})
      (#denominatorIndex{x})
      (equiv_reason_terms!{I.integerEqTrans { #numerator{(Def.add zero x)} }
        "~" { I.addInteger I.zeroInteger (#numerator{x}) } "by" { I.addIntegerRespects
          (I.mulInteger I.zeroInteger (denominator x))
          I.zeroInteger
          (I.mulInteger (#numerator{x}) (denominator zero))
          (#numerator{x})
          (I.mulIntegerZeroLeft (denominator x))
          (I.mulIntegerOneRight (#numerator{x})) }
        "~" { #numerator{x} } "by" { I.addIntegerZeroLeft (#numerator{x}) }})
      (denominatorProductIndexZeroLeft
        (#denominatorIndex{x}));

\definition fractionAddComm(x, y: Fraction): FractionEq (Def.add x y) (Def.add y x) :=
    fractionEqOfParts
      (#numerator{(Def.add x y)})
      (#numerator{(Def.add y x)})
      (#denominatorIndex{(Def.add x y)})
      (#denominatorIndex{(Def.add y x)})
      (I.addIntegerComm
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (#numerator{y}) (denominator x)))
      (denominatorProductIndexComm
        (#denominatorIndex{x}) (#denominatorIndex{y}));

\definition denominatorAdd(x, y: Fraction):
  denominator (Def.add x y) =
      I.mulInteger (denominator x) (denominator y) :=

    equiv_reason_terms!{I.integerEqTrans { denominator (Def.add x y) }
      "~" { I.integer
        (NatOp.mul
          (I.natSucc (#denominatorIndex{x}))
          (I.natSucc (#denominatorIndex{y})))
        I.zeroNat } "by" { I.integerEqOfParts
        (I.natSucc (denominatorProductIndex
          (#denominatorIndex{x}) (#denominatorIndex{y})))
        I.zeroNat
        (NatOp.mul
          (I.natSucc (#denominatorIndex{x}))
          (I.natSucc (#denominatorIndex{y})))
        I.zeroNat
        (denominatorProductIndexSucc
          (#denominatorIndex{x}) (#denominatorIndex{y}))
        (\refl(I.zeroNat)) }
      "~" { I.mulInteger (denominator x) (denominator y) } "by" { I.integerEqSym _ _
        (equiv_reason_terms!{I.integerEqTrans { I.mulInteger (denominator x) (denominator y) }
          "~" { I.scaleInteger
            (denominator x) (I.natSucc (#denominatorIndex{y})) } "by" { I.mulIntegerNatural
            (denominator x) (I.natSucc (#denominatorIndex{y})) }
          "~" { I.integer
            (NatOp.mul
              (I.natSucc (#denominatorIndex{x}))
              (I.natSucc (#denominatorIndex{y})))
            I.zeroNat } "by" { I.scaleIntegerNatural
            (I.natSucc (#denominatorIndex{x}))
            (I.natSucc (#denominatorIndex{y})) }}) }};

\definition addFirstCrossTerm(x, y, u, v: Fraction):
  FractionEq x y ->
  I.mulInteger
      (I.mulInteger (#numerator{x}) (denominator u))
      (I.mulInteger (denominator y) (denominator v)) =
      I.mulInteger
      (I.mulInteger (#numerator{y}) (denominator v))
      (I.mulInteger (denominator x) (denominator u)) :=
   \fun (xy: FractionEq x y) =>
    equiv_reason!{I.integerEqTrans
       "by" { I.mulIntegerInterchange (#numerator{x}) (denominator u)
         (denominator y) (denominator v) }
       "by" { I.mulIntegerRespects
         (I.mulInteger (#numerator{x}) (denominator y))
         (I.mulInteger (#numerator{y}) (denominator x))
         (I.mulInteger (denominator u) (denominator v))
         (I.mulInteger (denominator u) (denominator v))
         xy (I.integerEqRefl _) }
       "by" { I.mulIntegerRespects
         (I.mulInteger (#numerator{y}) (denominator x))
         (I.mulInteger (#numerator{y}) (denominator x))
         (I.mulInteger (denominator u) (denominator v))
         (I.mulInteger (denominator v) (denominator u))
         (I.integerEqRefl _)
         (I.mulIntegerComm (denominator u) (denominator v)) }
       "by" { I.integerEqSym _ _
         (I.mulIntegerInterchange (#numerator{y}) (denominator v)
           (denominator x) (denominator u)) }};

\definition addSecondCrossTerm(x, y, u, v: Fraction):
  FractionEq u v ->
  I.mulInteger
      (I.mulInteger (#numerator{u}) (denominator x))
      (I.mulInteger (denominator y) (denominator v)) =
    I.mulInteger
      (I.mulInteger (#numerator{v}) (denominator y))
      (I.mulInteger (denominator x) (denominator u)) :=

  \fun (uv: FractionEq u v) =>
    equiv_reason!{I.integerEqTrans
      "by" { I.mulIntegerRespects
        (I.mulInteger (#numerator{u}) (denominator x))
        (I.mulInteger (#numerator{u}) (denominator x))
        (I.mulInteger (denominator y) (denominator v))
        (I.mulInteger (denominator v) (denominator y))
        (I.integerEqRefl _)
        (I.mulIntegerComm (denominator y) (denominator v)) }
      "by" { I.mulIntegerInterchange (#numerator{u}) (denominator x)
        (denominator v) (denominator y) }
      "by" { I.mulIntegerRespects
        (I.mulInteger (#numerator{u}) (denominator v))
        (I.mulInteger (#numerator{v}) (denominator u))
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y))
        uv (I.integerEqRefl _) }
      "by" { I.mulIntegerRespects
        (I.mulInteger (#numerator{v}) (denominator u))
        (I.mulInteger (#numerator{v}) (denominator u))
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator y) (denominator x))
        (I.integerEqRefl _)
        (I.mulIntegerComm (denominator x) (denominator y)) }
      "by" { I.integerEqSym _ _
        (I.mulIntegerInterchange (#numerator{v}) (denominator y)
          (denominator u) (denominator x)) }
      "by" { I.mulIntegerRespects
        (I.mulInteger (#numerator{v}) (denominator y))
        (I.mulInteger (#numerator{v}) (denominator y))
        (I.mulInteger (denominator u) (denominator x))
        (I.mulInteger (denominator x) (denominator u))
        (I.integerEqRefl _)
        (I.mulIntegerComm (denominator u) (denominator x)) }};

\definition fractionAddRespects(x, y, u, v: Fraction):
  FractionEq x y -> FractionEq u v ->
  FractionEq (Def.add x u) (Def.add y v) :=
   \fun (xy: FractionEq x y) (uv: FractionEq u v) =>
    equiv_reason!{I.integerEqTrans
       "by" { I.mulIntegerRespects
         (#numerator{(Def.add x u)}) (#numerator{(Def.add x u)})
         (denominator (Def.add y v))
         (I.mulInteger (denominator y) (denominator v))
         (I.integerEqRefl _) (denominatorAdd y v) }
       "by" { I.mulIntegerDistribRight
         (I.mulInteger (#numerator{x}) (denominator u))
         (I.mulInteger (#numerator{u}) (denominator x))
         (I.mulInteger (denominator y) (denominator v)) }
       "by" { I.addIntegerRespects _ _ _ _
         (addFirstCrossTerm x y u v xy)
         (addSecondCrossTerm x y u v uv) }
       "by" { I.integerEqSym _ _
         (I.mulIntegerDistribRight
           (I.mulInteger (#numerator{y}) (denominator v))
           (I.mulInteger (#numerator{v}) (denominator y))
           (I.mulInteger (denominator x) (denominator u))) }
       "by" { I.mulIntegerRespects
         (#numerator{(Def.add y v)}) (#numerator{(Def.add y v)})
         (I.mulInteger (denominator x) (denominator u))
         (denominator (Def.add x u))
         (I.integerEqRefl _)
         (I.integerEqSym _ _ (denominatorAdd x u)) }};

\definition fractionEqOfNumeratorDenominator(x, y: Fraction):
  #numerator{x} = #numerator{y} -> denominator x = denominator y ->
  FractionEq x y :=
  \fun (num: _) (den: _) =>
    I.mulIntegerRespects _ _ _ _ num (I.integerEqSym _ _ den);

\definition mulIntegerSwapRight(a, b, c: I.Integer):
  I.mulInteger (I.mulInteger a b) c =
    I.mulInteger (I.mulInteger a c) b :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerAssoc a b c }
    "by" { I.mulIntegerRespects a a (I.mulInteger b c) (I.mulInteger c b)
      (I.integerEqRefl a) (I.mulIntegerComm b c) }
    "by" { I.integerEqSym _ _ (I.mulIntegerAssoc a c b) }};

\definition mulIntegerFourSwap(a, b, c, d: I.Integer):
  I.mulInteger (I.mulInteger a b) (I.mulInteger c d) =
    I.mulInteger (I.mulInteger a d) (I.mulInteger b c) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
      (I.mulIntegerComm c d) }
    "by" { I.mulIntegerInterchange a b d c }};

\definition mulIntegerSwapNested(a, b, r: I.Integer):
  I.mulInteger a (I.mulInteger b r) =
    I.mulInteger b (I.mulInteger a r) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.integerEqSym _ _ (I.mulIntegerAssoc a b r) }
    "by" { I.mulIntegerRespects (I.mulInteger a b) (I.mulInteger b a) r r
      (I.mulIntegerComm a b) (I.integerEqRefl r) }
    "by" { I.mulIntegerAssoc b a r }};

\definition mulIntegerDistributiveTerm(a, b, d, e, f, h: I.Integer):
  I.mulInteger (I.mulInteger a (I.mulInteger b h))
      (I.mulInteger (I.mulInteger d e) (I.mulInteger d f)) =
    I.mulInteger
      (I.mulInteger (I.mulInteger a b) (I.mulInteger d h))
      (I.mulInteger d (I.mulInteger e f)) :=
  \block {
    \let sourceCanonical: I.mulInteger (I.mulInteger a (I.mulInteger b h))
          (I.mulInteger (I.mulInteger d e) (I.mulInteger d f)) =
        I.mulInteger a (I.mulInteger b (I.mulInteger h
          (I.mulInteger d (I.mulInteger e (I.mulInteger d f))))) :=
      equiv_reason!{I.integerEqTrans
        "by" { I.mulIntegerAssoc a (I.mulInteger b h)
          (I.mulInteger (I.mulInteger d e) (I.mulInteger d f)) }
        "by" { I.mulIntegerRespects a a _ _ (I.integerEqRefl a)
          (I.mulIntegerAssoc b h
            (I.mulInteger (I.mulInteger d e) (I.mulInteger d f))) }
        "by" { I.mulIntegerRespects a a _ _ (I.integerEqRefl a)
          (I.mulIntegerRespects b b _ _ (I.integerEqRefl b)
            (I.mulIntegerRespects h h _ _ (I.integerEqRefl h)
              (I.mulIntegerAssoc d e (I.mulInteger d f)))) }} \then
    \let targetCanonical: I.mulInteger
          (I.mulInteger (I.mulInteger a b) (I.mulInteger d h))
          (I.mulInteger d (I.mulInteger e f)) =
        I.mulInteger a (I.mulInteger b (I.mulInteger h
          (I.mulInteger d (I.mulInteger e (I.mulInteger d f))))) :=
      equiv_reason!{I.integerEqTrans
        "by" { I.mulIntegerAssoc (I.mulInteger a b) (I.mulInteger d h)
          (I.mulInteger d (I.mulInteger e f)) }
        "by" { I.mulIntegerRespects (I.mulInteger a b) (I.mulInteger a b) _ _
          (I.integerEqRefl (I.mulInteger a b))
          (I.mulIntegerAssoc d h (I.mulInteger d (I.mulInteger e f))) }
        "by" { I.mulIntegerAssoc a b
          (I.mulInteger d (I.mulInteger h
            (I.mulInteger d (I.mulInteger e f)))) }
        "by" { I.mulIntegerRespects a a _ _ (I.integerEqRefl a)
          (I.mulIntegerRespects b b _ _ (I.integerEqRefl b)
            (mulIntegerSwapNested d h
              (I.mulInteger d (I.mulInteger e f)))) }
        "by" { I.mulIntegerRespects a a _ _ (I.integerEqRefl a)
          (I.mulIntegerRespects b b _ _ (I.integerEqRefl b)
            (I.mulIntegerRespects h h _ _ (I.integerEqRefl h)
              (I.mulIntegerRespects d d _ _ (I.integerEqRefl d)
                (mulIntegerSwapNested d e f)))) }} \then
    \return equiv_reason!{I.integerEqTrans
      "by" { sourceCanonical }
      "by" { I.integerEqSym _ _ targetCanonical }}
  };

\definition addAssocNumerator(x, y, z: Fraction):
  #numerator{(Def.add (Def.add x y) z)} =
    #numerator{(Def.add x (Def.add y z))} :=

  equiv_reason!{I.integerEqTrans
    "by" { I.addIntegerRespects _ _ _ _
      (I.mulIntegerDistribRight
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (#numerator{y}) (denominator x))
        (denominator z))
      (I.mulIntegerRespects
        (#numerator{z}) (#numerator{z})
        (denominator (Def.add x y))
        (I.mulInteger (denominator x) (denominator y))
        (I.integerEqRefl _)
        (denominatorAdd x y)) }
    "by" { I.addIntegerRespects _ _ _ _
      (I.addIntegerRespects _ _ _ _
        (I.mulIntegerAssoc (#numerator{x}) (denominator y) (denominator z))
        (mulIntegerSwapRight (#numerator{y}) (denominator x) (denominator z)))
      (equiv_reason!{I.integerEqTrans
        "by" { I.mulIntegerRespects (#numerator{z}) (#numerator{z})
          (I.mulInteger (denominator x) (denominator y))
          (I.mulInteger (denominator y) (denominator x))
          (I.integerEqRefl _)
          (I.mulIntegerComm (denominator x) (denominator y)) }
        "by" { I.integerEqSym _ _
          (I.mulIntegerAssoc (#numerator{z}) (denominator y) (denominator x)) }}) }
    "by" { I.addIntegerAssoc
      (I.mulInteger (#numerator{x})
        (I.mulInteger (denominator y) (denominator z)))
      (I.mulInteger (I.mulInteger (#numerator{y}) (denominator z))
        (denominator x))
      (I.mulInteger (I.mulInteger (#numerator{z}) (denominator y))
        (denominator x)) }
    "by" { I.addIntegerRespects _ _ _ _ (I.integerEqRefl _)
      (I.integerEqSym _ _
        (I.mulIntegerDistribRight
          (I.mulInteger (#numerator{y}) (denominator z))
          (I.mulInteger (#numerator{z}) (denominator y))
          (denominator x))) }
    "by" { I.addIntegerRespects _ _ _ _
      (I.mulIntegerRespects
        (#numerator{x}) (#numerator{x})
        (I.mulInteger (denominator y) (denominator z))
        (denominator (Def.add y z))
        (I.integerEqRefl _)
        (I.integerEqSym _ _ (denominatorAdd y z)))
      (I.integerEqRefl _) }};

\definition addAssocDenominator(x, y, z: Fraction):
  denominator (Def.add (Def.add x y) z) =
    denominator (Def.add x (Def.add y z)) :=
  equiv_reason!{I.integerEqTrans
    "by" { denominatorAdd (Def.add x y) z }
    "by" { I.mulIntegerRespects _ _ _ _ (denominatorAdd x y)
      (I.integerEqRefl (denominator z)) }
    "by" { I.mulIntegerAssoc (denominator x) (denominator y) (denominator z) }
    "by" { I.mulIntegerRespects _ _ _ _ (I.integerEqRefl (denominator x))
      (I.integerEqSym _ _ (denominatorAdd y z)) }
    "by" { I.integerEqSym _ _ (denominatorAdd x (Def.add y z)) }};

\definition fractionAddAssoc(x, y, z: Fraction):
  FractionEq (Def.add (Def.add x y) z) (Def.add x (Def.add y z)) :=
  fractionEqOfNumeratorDenominator _ _
    (addAssocNumerator x y z) (addAssocDenominator x y z);

\definition numeratorNonZeroNeg(x: Fraction):
  NumeratorNonZero x ->
  NumeratorNonZero (Def.neg x) :=
    I.integerNonZeroNeg (#numerator{x});

\definition fractionNegRespects(x, y: Fraction):
  FractionEq x y ->
  FractionEq (Def.neg x) (Def.neg y) :=
    \fun (xy: FractionEq x y) =>
    equiv_reason_terms!{I.integerEqTrans { I.mulInteger (I.negInteger (#numerator{x})) (denominator y) }
        "~" { I.negInteger (I.mulInteger (#numerator{x}) (denominator y)) } "by" { I.mulIntegerNegLeft (#numerator{x}) (denominator y) }
        "~" { I.negInteger (I.mulInteger (#numerator{y}) (denominator x)) } "by" { I.negIntegerRespects
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x)) xy }
        "~" { I.mulInteger (I.negInteger (#numerator{y})) (denominator x) } "by" { I.integerEqSym
          (I.mulInteger (I.negInteger (#numerator{y})) (denominator x))
          (I.negInteger (I.mulInteger (#numerator{y}) (denominator x)))
          (I.mulIntegerNegLeft (#numerator{y}) (denominator x)) }};

\definition fractionNegInvolutive(x: Fraction): FractionEq (Def.neg (Def.neg x)) x :=
    fractionEqOfParts
      (#numerator{(Def.neg (Def.neg x))}) (#numerator{x})
      (#denominatorIndex{(Def.neg (Def.neg x))}) (#denominatorIndex{x})
      (I.negIntegerInvolutive (#numerator{x}))
      (\refl(#denominatorIndex{x}));

\definition fractionNegZero: Def.neg zero = zero :=
  \refl(zero);

\definition fractionAddNegRight(x: Fraction): FractionEq (Def.add x (Def.neg x)) zero :=
    fractionEqZeroOfNumerator (Def.add x (Def.neg x))
      (equiv_reason_terms!{I.integerEqTrans { #numerator{(Def.add x (Def.neg x))} }
        "~" { I.addInteger
          (I.mulInteger (#numerator{x}) (denominator x))
          (I.negInteger
            (I.mulInteger (#numerator{x}) (denominator x))) } "by" { I.addIntegerRespects
          (I.mulInteger (#numerator{x}) (denominator (Def.neg x)))
          (I.mulInteger (#numerator{x}) (denominator x))
          (I.mulInteger (I.negInteger (#numerator{x})) (denominator x))
          (I.negInteger
            (I.mulInteger (#numerator{x}) (denominator x)))
          (I.integerEqRefl
            (I.mulInteger (#numerator{x}) (denominator x)))
          (I.mulIntegerNegLeft
            (#numerator{x}) (denominator x)) }
        "~" { I.zeroInteger } "by" { I.addIntegerNegRight
          (I.mulInteger (#numerator{x}) (denominator x)) }});

\definition fractionAddNegLeft(x: Fraction): FractionEq (Def.add (Def.neg x) x) zero :=
    fractionEqZeroOfNumerator (Def.add (Def.neg x) x)
      (equiv_reason_terms!{I.integerEqTrans { #numerator{(Def.add (Def.neg x) x)} }
        "~" { I.addInteger
          (I.negInteger
            (I.mulInteger (#numerator{x}) (denominator x)))
          (I.mulInteger (#numerator{x}) (denominator x)) } "by" { I.addIntegerRespects
          (I.mulInteger (I.negInteger (#numerator{x})) (denominator x))
          (I.negInteger
            (I.mulInteger (#numerator{x}) (denominator x)))
          (I.mulInteger (#numerator{x}) (denominator (Def.neg x)))
          (I.mulInteger (#numerator{x}) (denominator x))
          (I.mulIntegerNegLeft
            (#numerator{x}) (denominator x))
          (I.integerEqRefl
            (I.mulInteger (#numerator{x}) (denominator x))) }
        "~" { I.zeroInteger } "by" { I.addIntegerNegLeft
          (I.mulInteger (#numerator{x}) (denominator x)) }});

\definition fractionSubZeroRight(x: Fraction): FractionEq (Def.sub x zero) x := fractionAddZeroRight x;

\definition fractionSubSelf(x: Fraction): FractionEq (Def.sub x x) zero := fractionAddNegRight x;

\definition numeratorMul(x, y: Fraction):
  #numerator{(Def.mul x y)} =
      I.mulInteger (#numerator{x}) (#numerator{y}) :=
  I.integerEqRefl (#numerator{(Def.mul x y)});

\definition denominatorMul(x, y: Fraction):
  denominator (Def.mul x y) =
      I.mulInteger (denominator x) (denominator y) :=

    equiv_reason_terms!{I.integerEqTrans { denominator (Def.mul x y) }
      "~" { I.integer
        (NatOp.mul
          (I.natSucc (#denominatorIndex{x}))
          (I.natSucc (#denominatorIndex{y})))
        I.zeroNat } "by" { I.integerEqOfParts
        (I.natSucc (denominatorProductIndex
          (#denominatorIndex{x}) (#denominatorIndex{y})))
        I.zeroNat
        (NatOp.mul
          (I.natSucc (#denominatorIndex{x}))
          (I.natSucc (#denominatorIndex{y})))
        I.zeroNat
        (denominatorProductIndexSucc
          (#denominatorIndex{x}) (#denominatorIndex{y}))
        (\refl(I.zeroNat)) }
      "~" { I.mulInteger (denominator x) (denominator y) } "by" { I.integerEqSym _ _
        (equiv_reason_terms!{I.integerEqTrans { I.mulInteger (denominator x) (denominator y) }
          "~" { I.scaleInteger
            (denominator x) (I.natSucc (#denominatorIndex{y})) } "by" { I.mulIntegerNatural
            (denominator x) (I.natSucc (#denominatorIndex{y})) }
          "~" { I.integer
            (NatOp.mul
              (I.natSucc (#denominatorIndex{x}))
              (I.natSucc (#denominatorIndex{y})))
            I.zeroNat } "by" { I.scaleIntegerNatural
            (I.natSucc (#denominatorIndex{x}))
            (I.natSucc (#denominatorIndex{y})) }}) }};

\definition fractionMulRespects(x, y, u, v: Fraction):
  FractionEq x y -> FractionEq u v ->
  FractionEq (Def.mul x u) (Def.mul y v) :=

    \fun (xy: FractionEq x y) (uv: FractionEq u v) =>
    equiv_reason_terms!{I.integerEqTrans { I.mulInteger
          (#numerator{(Def.mul x u)})
          (denominator (Def.mul y v)) }
        "~" { I.mulInteger
          (I.mulInteger (#numerator{x}) (#numerator{u}))
          (I.mulInteger (denominator y) (denominator v)) } "by" { I.mulIntegerRespects
          (I.mulInteger (#numerator{x}) (#numerator{u}))
          (I.mulInteger (#numerator{x}) (#numerator{u}))
          (denominator (Def.mul y v))
          (I.mulInteger (denominator y) (denominator v))
          (I.integerEqRefl
            (I.mulInteger (#numerator{x}) (#numerator{u})))
          (denominatorMul y v) }
        "~" { I.mulInteger
            (I.mulInteger (#numerator{x}) (denominator y))
            (I.mulInteger (#numerator{u}) (denominator v)) } "by" { I.mulIntegerInterchange
          (#numerator{x}) (#numerator{u})
          (denominator y) (denominator v) }
        "~" { I.mulInteger
              (I.mulInteger (#numerator{y}) (denominator x))
              (I.mulInteger (#numerator{v}) (denominator u)) } "by" { I.mulIntegerRespects
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (#numerator{u}) (denominator v))
          (I.mulInteger (#numerator{v}) (denominator u))
          xy uv }
        "~" { I.mulInteger
                (I.mulInteger (#numerator{y}) (#numerator{v}))
                (I.mulInteger (denominator x) (denominator u)) } "by" { I.integerEqSym
          (I.mulInteger
            (I.mulInteger (#numerator{y}) (#numerator{v}))
            (I.mulInteger (denominator x) (denominator u)))
          (I.mulInteger
            (I.mulInteger (#numerator{y}) (denominator x))
            (I.mulInteger (#numerator{v}) (denominator u)))
          (I.mulIntegerInterchange
            (#numerator{y}) (#numerator{v})
            (denominator x) (denominator u)) }
        "~" { I.mulInteger
          (#numerator{(Def.mul y v)})
          (denominator (Def.mul x u)) } "by" { I.mulIntegerRespects
          (I.mulInteger (#numerator{y}) (#numerator{v}))
          (I.mulInteger (#numerator{y}) (#numerator{v}))
          (I.mulInteger (denominator x) (denominator u))
          (denominator (Def.mul x u))
          (I.integerEqRefl
            (I.mulInteger (#numerator{y}) (#numerator{v})))
          (I.integerEqSym
            (denominator (Def.mul x u))
            (I.mulInteger (denominator x) (denominator u))
            (denominatorMul x u)) }};

\definition fractionMulZeroRight(x: Fraction): FractionEq (Def.mul x zero) zero :=
    fractionEqZeroOfNumerator (Def.mul x zero)
      (I.mulIntegerZeroRight (#numerator{x}));

\definition fractionMulZeroLeft(x: Fraction): FractionEq (Def.mul zero x) zero :=
    fractionEqZeroOfNumerator (Def.mul zero x)
      (I.mulIntegerZeroLeft (#numerator{x}));

\definition fractionMulOneRight(x: Fraction): FractionEq (Def.mul x one) x :=
    fractionEqOfParts
      (#numerator{(Def.mul x one)})
      (#numerator{x})
      (#denominatorIndex{(Def.mul x one)})
      (#denominatorIndex{x})
      (I.mulIntegerOneRight (#numerator{x}))
      (denominatorProductIndexZeroRight
        (#denominatorIndex{x}));

\definition fractionMulOneLeft(x: Fraction): FractionEq (Def.mul one x) x :=
    fractionEqOfParts
      (#numerator{(Def.mul one x)})
      (#numerator{x})
      (#denominatorIndex{(Def.mul one x)})
      (#denominatorIndex{x})
      (I.mulIntegerOneLeft (#numerator{x}))
      (denominatorProductIndexZeroLeft
        (#denominatorIndex{x}));

\definition fractionMulComm(x, y: Fraction): FractionEq (Def.mul x y) (Def.mul y x) :=
    fractionEqOfParts
      (#numerator{(Def.mul x y)})
      (#numerator{(Def.mul y x)})
      (#denominatorIndex{(Def.mul x y)})
      (#denominatorIndex{(Def.mul y x)})
      (I.mulIntegerComm (#numerator{x}) (#numerator{y}))
      (denominatorProductIndexComm
        (#denominatorIndex{x}) (#denominatorIndex{y}));

\definition fractionEqOneOfEqualNumeratorDenominator(x: Fraction):
  #numerator{x} = denominator x ->
  FractionEq x one :=
  \fun (same: #numerator{x} = denominator x) =>
    equiv_reason!{I.integerEqTrans
      "by" { I.mulIntegerOneRight (#numerator{x}) }
      "by" { same }
      "by" { I.integerEqSym _ _ (I.mulIntegerOneLeft (denominator x)) }};

/* The reciprocal is total, with reciprocal zero = zero.  For a nonzero
 * canonical numerator, swapping its magnitude with the denominator keeps
 * the denominator positive. */
\definition positiveReciprocalLaw(d, k: I.Nat):
  FractionEq
    (Def.mul
      (Fraction::# (I.Int^::ofNat (I.natSucc k)) d)
      (Fraction::# (denominator (Fraction::# (I.Int^::ofNat (I.natSucc k)) d)) k))
    one :=
  \block {
    \let x: Fraction := Fraction::# (I.Int^::ofNat (I.natSucc k)) d \then
    \let r: Fraction := Fraction::# (denominator x) k \then
    \return fractionEqOneOfEqualNumeratorDenominator (Def.mul x r)
      (equiv_reason_terms!{I.integerEqTrans { #numerator{(Def.mul x r)} }
        "~" { I.mulInteger (#numerator{x}) (#numerator{r}) } "by" { numeratorMul x r }
        "~" { I.mulInteger (#numerator{r}) (#numerator{x}) } "by" { I.mulIntegerComm (#numerator{x}) (#numerator{r}) }
        "~" { I.mulInteger (denominator x) (denominator r) } "by" { I.mulIntegerRespects _ _ _ _
          (I.integerEqRefl (denominator x))
          (I.ofNatAsInteger (I.natSucc k)) }
        "~" { denominator (Def.mul x r) } "by" { I.integerEqSym _ _ (denominatorMul x r) }})
  };

\definition negativeReciprocalLaw(d, k: I.Nat):
  FractionEq
    (Def.mul
      (Fraction::# (I.Int^::negSucc k) d)
      (Fraction::# (I.negInteger (denominator (Fraction::# (I.Int^::negSucc k) d))) k))
    one :=
  \block {
    \let x: Fraction := Fraction::# (I.Int^::negSucc k) d \then
    \let r: Fraction := Fraction::# (I.negInteger (denominator x)) k \then
    \let n: I.Integer := I.integer (I.natSucc k) I.zeroNat \then
    \let dn: #numerator{x} = I.negInteger n :=
      I.negSuccAsNegNatural k \then
    \let dr: #numerator{r} = I.negInteger (denominator x) :=
      I.integerEqRefl (#numerator{r}) \then
    \return fractionEqOneOfEqualNumeratorDenominator (Def.mul x r)
      (equiv_reason_terms!{I.integerEqTrans { #numerator{(Def.mul x r)} }
        "~" { I.mulInteger (#numerator{x}) (#numerator{r}) } "by" { numeratorMul x r }
        "~" { I.mulInteger (I.negInteger n)
            (I.negInteger (denominator x)) } "by" { I.mulIntegerRespects _ _ _ _ dn dr }
        "~" { I.negInteger
              (I.mulInteger n (I.negInteger (denominator x))) } "by" { I.mulIntegerNegLeft n (I.negInteger (denominator x)) }
        "~" { I.negInteger (I.negInteger
                (I.mulInteger n (denominator x))) } "by" { I.negIntegerRespects _ _
          (I.mulIntegerNegRight n (denominator x)) }
        "~" { I.mulInteger (denominator x) n } "by" { equiv_reason!{I.integerEqTrans
          "by" { I.negIntegerInvolutive
            (I.mulInteger n (denominator x)) }
          "by" { I.mulIntegerComm n (denominator x) }} }
        "~" { denominator (Def.mul x r) } "by" { I.integerEqSym _ _ (denominatorMul x r) }})
  };

\definition fractionMulReciprocal(x: Fraction):
  NumeratorNonZero x ->
  FractionEq (Def.mul x (Def.reciprocal x)) one :=
  \fun (nonzero: NumeratorNonZero x) =>
    \induction (n: I.Int^) \return \forall (d: I.Nat) -> I.IntegerNonZero n ->
          FractionEq
            (Def.mul (Fraction::# n d) (Def.reciprocal (Fraction::# n d))) one \with {
      | ofNat : (\fun (n: I.Nat) =>
        \induction (n: N.Nat^) \return \forall (d: I.Nat) ->
              I.IntegerNonZero (I.Int^::ofNat n) ->
              FractionEq
                (Def.mul (Fraction::# (I.Int^::ofNat n) d)
                  (Def.reciprocal (Fraction::# (I.Int^::ofNat n) d))) one \with {
                    | zero : (\fun (d: I.Nat) =>
            \fun (impossible: I.IntegerNonZero I.zeroInteger) =>
              Logic.falseElim _ (impossible (I.integerEqRefl I.zeroInteger)))
                    | succ : (\fun (k: I.Nat) => \fun (_: _) => \fun (d: I.Nat) =>
            \fun (_: I.IntegerNonZero (I.Int^::ofNat (I.natSucc k))) =>
              positiveReciprocalLaw d k)
                    } n)
      | negSucc : (\fun (k: I.Nat) => \fun (d: I.Nat) =>
        \fun (_: I.IntegerNonZero (I.Int^::negSucc k)) =>
          negativeReciprocalLaw d k)
      } (#numerator{x}) (#denominatorIndex{x}) nonzero;

\definition mulAssocDenominator(x, y, z: Fraction):
  denominator (Def.mul (Def.mul x y) z) =
      denominator (Def.mul x (Def.mul y z)) :=
  equiv_reason!{I.integerEqTrans
    "by" { denominatorMul (Def.mul x y) z }
    "by" { I.mulIntegerRespects _ _ _ _ (denominatorMul x y)
      (I.integerEqRefl (denominator z)) }
    "by" { I.mulIntegerAssoc (denominator x) (denominator y) (denominator z) }
    "by" { I.mulIntegerRespects _ _ _ _ (I.integerEqRefl (denominator x))
      (I.integerEqSym _ _ (denominatorMul y z)) }
    "by" { I.integerEqSym _ _ (denominatorMul x (Def.mul y z)) }};

\definition fractionMulAssoc(x, y, z: Fraction):
  FractionEq (Def.mul (Def.mul x y) z) (Def.mul x (Def.mul y z)) :=
  fractionEqOfNumeratorDenominator (Def.mul (Def.mul x y) z) (Def.mul x (Def.mul y z))
    (I.mulIntegerAssoc (#numerator{x}) (#numerator{y}) (#numerator{z}))
    (mulAssocDenominator x y z);

\definition fractionMulAddLeft(x, y, z: Fraction):
  FractionEq (Def.mul x (Def.add y z)) (Def.add (Def.mul x y) (Def.mul x z)) :=
  \block {
    \let leftDenominator: denominator (Def.add (Def.mul x y) (Def.mul x z)) =
        I.mulInteger
          (I.mulInteger (denominator x) (denominator y))
          (I.mulInteger (denominator x) (denominator z)) :=
      equiv_reason!{I.integerEqTrans
        "by" { denominatorAdd (Def.mul x y) (Def.mul x z) }
        "by" { I.mulIntegerRespects _ _ _ _
          (denominatorMul x y) (denominatorMul x z) }} \then
    \let rightNumerator: #numerator{(Def.add (Def.mul x y) (Def.mul x z))} =
        I.addInteger
          (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{y}))
            (I.mulInteger (denominator x) (denominator z)))
          (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{z}))
            (I.mulInteger (denominator x) (denominator y))) :=
      I.addIntegerRespects _ _ _ _
        (I.mulIntegerRespects _ _ _ _ (numeratorMul x y)
          (denominatorMul x z))
        (I.mulIntegerRespects _ _ _ _ (numeratorMul x z)
          (denominatorMul x y)) \then
    \let rightDenominator: denominator (Def.mul x (Def.add y z)) =
        I.mulInteger (denominator x)
          (I.mulInteger (denominator y) (denominator z)) :=
      equiv_reason!{I.integerEqTrans
        "by" { denominatorMul x (Def.add y z) }
        "by" { I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
          (denominatorAdd y z) }} \then
    \let leftNormalized: I.mulInteger (#numerator{(Def.mul x (Def.add y z))})
          (denominator (Def.add (Def.mul x y) (Def.mul x z))) =
        I.mulInteger
          (I.mulInteger (#numerator{x})
            (I.addInteger
              (I.mulInteger (#numerator{y}) (denominator z))
              (I.mulInteger (#numerator{z}) (denominator y))))
          (I.mulInteger
            (I.mulInteger (denominator x) (denominator y))
            (I.mulInteger (denominator x) (denominator z))) :=
      I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _) leftDenominator \then
    \let rightNormalized: I.mulInteger (#numerator{(Def.add (Def.mul x y) (Def.mul x z))})
          (denominator (Def.mul x (Def.add y z))) =
        I.mulInteger
          (I.addInteger
            (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{y}))
              (I.mulInteger (denominator x) (denominator z)))
            (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{z}))
              (I.mulInteger (denominator x) (denominator y))))
          (I.mulInteger (denominator x)
            (I.mulInteger (denominator y) (denominator z))) :=
      I.mulIntegerRespects _ _ _ _ rightNumerator rightDenominator \then
    \let common: I.Integer :=
      I.mulInteger (denominator x)
        (I.mulInteger (denominator y) (denominator z)) \then
    \let expanded: I.mulInteger
          (I.mulInteger (#numerator{x})
            (I.addInteger
              (I.mulInteger (#numerator{y}) (denominator z))
              (I.mulInteger (#numerator{z}) (denominator y))))
          (I.mulInteger
            (I.mulInteger (denominator x) (denominator y))
            (I.mulInteger (denominator x) (denominator z))) =
        I.mulInteger
          (I.addInteger
            (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{y}))
              (I.mulInteger (denominator x) (denominator z)))
            (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{z}))
              (I.mulInteger (denominator x) (denominator y)))) common :=
      equiv_reason!{I.integerEqTrans
        "by" { I.mulIntegerRespects _ _ _ _
          (I.mulIntegerDistribLeft (#numerator{x})
            (I.mulInteger (#numerator{y}) (denominator z))
            (I.mulInteger (#numerator{z}) (denominator y)))
          (I.integerEqRefl _) }
        "by" { I.mulIntegerDistribRight
          (I.mulInteger (#numerator{x})
            (I.mulInteger (#numerator{y}) (denominator z)))
          (I.mulInteger (#numerator{x})
            (I.mulInteger (#numerator{z}) (denominator y)))
          (I.mulInteger
            (I.mulInteger (denominator x) (denominator y))
            (I.mulInteger (denominator x) (denominator z))) }
        "by" { I.addIntegerRespects _ _ _ _
          (mulIntegerDistributiveTerm (#numerator{x}) (#numerator{y})
            (denominator x) (denominator y) (denominator z)
            (denominator z))
          (mulIntegerDistributiveTerm (#numerator{x}) (#numerator{z})
            (denominator x) (denominator y) (denominator z)
            (denominator y)) }
        "by" { I.integerEqSym _ _
          (I.mulIntegerDistribRight
            (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{y}))
              (I.mulInteger (denominator x) (denominator z)))
            (I.mulInteger (I.mulInteger (#numerator{x}) (#numerator{z}))
              (I.mulInteger (denominator x) (denominator y))) common) }} \then
    \return equiv_reason!{I.integerEqTrans
      "by" { leftNormalized }
      "by" { expanded }
      "by" { I.integerEqSym _ _ rightNormalized }}
  };

\definition fractionMulNegLeft(x, y: Fraction):
  FractionEq (Def.mul (Def.neg x) y) (Def.neg (Def.mul x y)) :=
    fractionEqOfParts
      (#numerator{(Def.mul (Def.neg x) y)})
      (#numerator{(Def.neg (Def.mul x y))})
      (#denominatorIndex{(Def.mul (Def.neg x) y)})
      (#denominatorIndex{(Def.neg (Def.mul x y))})
      (I.mulIntegerNegLeft (#numerator{x}) (#numerator{y}))
      (\refl(#denominatorIndex{(Def.mul x y)}));

\definition fractionMulNegRight(x, y: Fraction):
  FractionEq (Def.mul x (Def.neg y)) (Def.neg (Def.mul x y)) :=
    fractionEqOfParts
      (#numerator{(Def.mul x (Def.neg y))})
      (#numerator{(Def.neg (Def.mul x y))})
      (#denominatorIndex{(Def.mul x (Def.neg y))})
      (#denominatorIndex{(Def.neg (Def.mul x y))})
      (I.mulIntegerNegRight (#numerator{x}) (#numerator{y}))
      (\refl(#denominatorIndex{(Def.mul x y)}));

\definition ltNegReverse(x, y: Fraction):
  lt x y ->
  lt (Def.neg y) (Def.neg x) :=
  \fun (xy: lt x y) =>
    IntegerOrder.ltRespects
      (I.negInteger (I.mulInteger (#numerator{y}) (denominator x)))
      (I.mulInteger (I.negInteger (#numerator{y})) (denominator x))
      (I.negInteger (I.mulInteger (#numerator{x}) (denominator y)))
      (I.mulInteger (I.negInteger (#numerator{x})) (denominator y))
      (I.integerEqSym _ _
        (I.mulIntegerNegLeft (#numerator{y}) (denominator x)))
      (I.integerEqSym _ _
        (I.mulIntegerNegLeft (#numerator{x}) (denominator y)))
      (IntegerOrder.ltNegReverse
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (#numerator{y}) (denominator x)) xy);

\definition ltOfNegLtNeg(x, y: Fraction):
  lt (Def.neg x) (Def.neg y) ->
  lt y x :=
  \fun (xy: _) =>
    FractionOrder.ltRespects
      (Def.neg (Def.neg y)) y (Def.neg (Def.neg x)) x
      (fractionNegInvolutive y) (fractionNegInvolutive x)
      (ltNegReverse (Def.neg x) (Def.neg y) xy);

\definition belowLt(x: Fraction): lt (Def.below x) x :=
  FractionOrder.ltMulDenominator
    (I.addInteger (#numerator{x}) (I.negInteger I.oneInteger))
    (#numerator{x}) (#denominatorIndex{x})
    (IntegerOrder.ltPredecessor (#numerator{x}));

\definition ltAbove(x: Fraction): lt x (Def.above x) :=
  FractionOrder.ltMulDenominator
    (#numerator{x}) (I.addInteger (#numerator{x}) I.oneInteger)
    (#denominatorIndex{x})
    (IntegerOrder.ltSuccessor (#numerator{x}));

\definition commonDenominatorIndexSucc(x, y: Fraction):
  I.natSucc (Def.commonDenominatorIndex x y) = Def.commonDenominatorNat x y :=
  denominatorProductIndexSucc (#denominatorIndex{x}) (#denominatorIndex{y});

\definition midpointDenominatorNat(x, y: Fraction):
  I.natSucc (Def.midpointDenominatorIndex x y) =
    NatOp.add (Def.commonDenominatorNat x y) (Def.commonDenominatorNat x y) :=
  trans!{I.Nat} _ _ _
    (sym!{I.Nat} _ _
      (NL.addSuccLeft (Def.commonDenominatorIndex x y)
        (I.natSucc (Def.commonDenominatorIndex x y))))
    (congr2!{I.Nat I.Nat I.Nat} NatOp.add
      (I.natSucc (Def.commonDenominatorIndex x y))
      (Def.commonDenominatorNat x y)
      (I.natSucc (Def.commonDenominatorIndex x y))
      (Def.commonDenominatorNat x y)
      (commonDenominatorIndexSucc x y)
      (commonDenominatorIndexSucc x y));

\definition productDenominatorNatural(x, y: Fraction):
  I.mulInteger (denominator x) (denominator y) =
    I.integer (Def.commonDenominatorNat x y) I.zeroNat :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerNatural
      (denominator x) (I.natSucc (#denominatorIndex{y})) }
    "by" { I.scaleIntegerNatural
      (I.natSucc (#denominatorIndex{x}))
      (I.natSucc (#denominatorIndex{y})) }};

\definition midpointDenominator(x, y: Fraction):
  denominator (Def.midpoint x y) =
    I.addInteger
      (I.mulInteger (denominator x) (denominator y))
      (I.mulInteger (denominator x) (denominator y)) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.integerEqOfParts
      (I.natSucc (Def.midpointDenominatorIndex x y)) I.zeroNat
      (NatOp.add (Def.commonDenominatorNat x y) (Def.commonDenominatorNat x y))
      I.zeroNat (midpointDenominatorNat x y) (\refl(I.zeroNat)) }
    "by" { I.integerEqSym _ _
      (I.addIntegerNatural
        (Def.commonDenominatorNat x y) (Def.commonDenominatorNat x y)) }
    "by" { I.addIntegerRespects _ _ _ _
      (I.integerEqSym _ _ (productDenominatorNatural x y))
      (I.integerEqSym _ _ (productDenominatorNatural x y)) }};

\definition doubleMul(a, b: I.Integer):
  I.mulInteger (I.addInteger a a) b =
    I.mulInteger a (I.addInteger b b) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerDistribRight a a b }
    "by" { I.integerEqSym _ _
      (I.mulIntegerDistribLeft a b b) }};

\definition midpointDouble(x, y: Fraction):
  FractionEq (Def.add (Def.midpoint x y) (Def.midpoint x y))
    (Def.add x y) :=
  \block {
    \let m: Fraction := Def.midpoint x y \then
    \let d: I.Integer := I.mulInteger (denominator x) (denominator y) \then
    \let twice: I.Integer := I.addInteger d d \then
    \let n: I.Integer := #numerator{(Def.add x y)} \then
    \return equiv_reason_terms!{I.integerEqTrans {
      I.mulInteger (#numerator{(Def.add m m)})
        (denominator (Def.add x y)) }
      "~" { I.mulInteger
        (I.addInteger (I.mulInteger n (denominator m))
          (I.mulInteger n (denominator m))) d }
        "by" { I.mulIntegerRespects _ _ _ _
          (I.integerEqRefl _) (denominatorAdd x y) }
      "~" { I.mulInteger
        (I.addInteger (I.mulInteger n twice)
          (I.mulInteger n twice)) d }
        "by" { I.mulIntegerRespects _ _ _ _
          (I.addIntegerRespects _ _ _ _
            (I.mulIntegerRespects _ _ _ _
              (I.integerEqRefl n) (midpointDenominator x y))
            (I.mulIntegerRespects _ _ _ _
              (I.integerEqRefl n) (midpointDenominator x y)))
          (I.integerEqRefl d) }
      "~" { I.mulInteger (I.mulInteger n (I.addInteger twice twice)) d }
        "by" { I.mulIntegerRespects _ _ _ _
          (I.integerEqSym _ _ (I.mulIntegerDistribLeft n twice twice))
          (I.integerEqRefl d) }
      "~" { I.mulInteger n (I.mulInteger (I.addInteger twice twice) d) }
        "by" { I.mulIntegerAssoc n (I.addInteger twice twice) d }
      "~" { I.mulInteger n (I.mulInteger twice twice) }
        "by" { I.mulIntegerRespects _ _ _ _
          (I.integerEqRefl n) (doubleMul twice d) }
      "~" { I.mulInteger n
        (I.mulInteger (denominator m) (denominator m)) }
        "by" { I.integerEqSym _ _
          (I.mulIntegerRespects _ _ _ _
            (I.integerEqRefl n)
            (I.mulIntegerRespects _ _ _ _
              (midpointDenominator x y) (midpointDenominator x y))) }
      "~" { I.mulInteger n (denominator (Def.add m m)) }
        "by" { I.integerEqSym _ _
          (I.mulIntegerRespects _ _ _ _
            (I.integerEqRefl n) (denominatorAdd m m)) }}
  };

\definition midpointLeftTerm(x, y: Fraction):
  I.mulInteger (#numerator{x})
      (I.mulInteger (denominator x) (denominator y)) =
    I.mulInteger
      (I.mulInteger (#numerator{x}) (denominator y))
      (denominator x) :=
  equiv_reason_terms!{I.integerEqTrans { I.mulInteger (#numerator{x})
      (I.mulInteger (denominator x) (denominator y)) }
    "~" { I.mulInteger (#numerator{x})
      (I.mulInteger (denominator y) (denominator x)) } "by" { I.mulIntegerRespects
      (#numerator{x}) (#numerator{x})
      (I.mulInteger (denominator x) (denominator y))
      (I.mulInteger (denominator y) (denominator x))
      (I.integerEqRefl _) (I.mulIntegerComm (denominator x) (denominator y)) }
    "~" { I.mulInteger
      (I.mulInteger (#numerator{x}) (denominator y))
      (denominator x) } "by" { I.integerEqSym _ _
      (I.mulIntegerAssoc (#numerator{x}) (denominator y) (denominator x)) }};

\definition midpointLeftAlignment(x, y: Fraction):
  I.mulInteger (#numerator{x}) (denominator (Def.midpoint x y)) =
    I.mulInteger
      (I.addInteger
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (#numerator{x}) (denominator y)))
      (denominator x) :=

  equiv_reason_terms!{I.integerEqTrans { I.mulInteger (#numerator{x}) (denominator (Def.midpoint x y)) }
    "~" { I.mulInteger (#numerator{x})
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y))) } "by" { I.mulIntegerRespects
      (#numerator{x}) (#numerator{x})
      (denominator (Def.midpoint x y))
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)))
      (I.integerEqRefl _) (midpointDenominator x y) }
    "~" { I.mulInteger
      (I.addInteger
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (#numerator{x}) (denominator y)))
      (denominator x) } "by" { equiv_reason!{I.integerEqTrans
      "by" { I.mulIntegerDistribLeft (#numerator{x})
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)) }
      "by" { I.addIntegerRespects _ _ _ _
        (midpointLeftTerm x y) (midpointLeftTerm x y) }
      "by" { I.integerEqSym _ _
        (I.mulIntegerDistribRight
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{x}) (denominator y))
          (denominator x)) }} }};

\definition midpointRightAlignment(x, y: Fraction):
  I.mulInteger (#numerator{y}) (denominator (Def.midpoint x y)) =
    I.mulInteger
      (I.addInteger
        (I.mulInteger (#numerator{y}) (denominator x))
        (I.mulInteger (#numerator{y}) (denominator x)))
      (denominator y) :=

  equiv_reason_terms!{I.integerEqTrans { I.mulInteger (#numerator{y}) (denominator (Def.midpoint x y)) }
    "~" { I.mulInteger (#numerator{y})
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y))) } "by" { I.mulIntegerRespects
      (#numerator{y}) (#numerator{y})
      (denominator (Def.midpoint x y))
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)))
      (I.integerEqRefl _) (midpointDenominator x y) }
    "~" { I.mulInteger
      (I.addInteger
        (I.mulInteger (#numerator{y}) (denominator x))
        (I.mulInteger (#numerator{y}) (denominator x)))
      (denominator y) } "by" { equiv_reason!{I.integerEqTrans
      "by" { I.mulIntegerDistribLeft (#numerator{y})
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)) }
      "by" { I.addIntegerRespects _ _ _ _
        (I.integerEqSym _ _
          (I.mulIntegerAssoc (#numerator{y}) (denominator x) (denominator y)))
        (I.integerEqSym _ _
          (I.mulIntegerAssoc (#numerator{y}) (denominator x) (denominator y))) }
      "by" { I.integerEqSym _ _
        (I.mulIntegerDistribRight
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (#numerator{y}) (denominator x))
          (denominator y)) }} }};

\definition ltMidpoint(x, y: Fraction):
  lt x y ->
  lt x (Def.midpoint x y) :=
  \fun (xy: lt x y) =>
    IntegerOrder.ltRespects
      (I.mulInteger
        (I.addInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{x}) (denominator y)))
        (denominator x))
      (I.mulInteger (#numerator{x}) (denominator (Def.midpoint x y)))
      (I.mulInteger
        (I.addInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x)))
        (denominator x))
      (I.mulInteger (#numerator{(Def.midpoint x y)}) (denominator x))
      (I.integerEqSym _ _ (midpointLeftAlignment x y))
      (I.integerEqRefl _)
      (FractionOrder.ltMulDenominator
        (I.addInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{x}) (denominator y)))
        (I.addInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x)))
        (#denominatorIndex{x})
        (IntegerOrder.ltAddLeft
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x)) xy));

\definition midpointLt(x, y: Fraction):
  lt x y ->
  lt (Def.midpoint x y) y :=
  \fun (xy: lt x y) =>
    IntegerOrder.ltRespects
      (I.mulInteger
        (I.addInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x)))
        (denominator y))
      (I.mulInteger (#numerator{(Def.midpoint x y)}) (denominator y))
      (I.mulInteger
        (I.addInteger
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (#numerator{y}) (denominator x)))
        (denominator y))
      (I.mulInteger (#numerator{y}) (denominator (Def.midpoint x y)))
      (I.integerEqRefl _)
      (I.integerEqSym _ _ (midpointRightAlignment x y))
      (FractionOrder.ltMulDenominator
        (I.addInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x)))
        (I.addInteger
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (#numerator{y}) (denominator x)))
        (#denominatorIndex{y})
        (IntegerOrder.ltAddRight
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (#numerator{y}) (denominator x)) xy));

\definition ltScaleByTwoDenominators(x, y, u, v: Fraction):
  lt x y ->
  I.IntegerLt
    (I.mulInteger
      (I.mulInteger (#numerator{x}) (denominator y))
      (I.mulInteger (denominator u) (denominator v)))
    (I.mulInteger
      (I.mulInteger (#numerator{y}) (denominator x))
      (I.mulInteger (denominator u) (denominator v))) :=

  \fun (xy: lt x y) =>
    IntegerOrder.ltRespects
      (I.mulInteger
        (I.mulInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (denominator u)) (denominator v))
      (I.mulInteger
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (denominator u) (denominator v)))
      (I.mulInteger
        (I.mulInteger
          (I.mulInteger (#numerator{y}) (denominator x))
          (denominator u)) (denominator v))
      (I.mulInteger
        (I.mulInteger (#numerator{y}) (denominator x))
        (I.mulInteger (denominator u) (denominator v)))
      (I.mulIntegerAssoc
        (I.mulInteger (#numerator{x}) (denominator y))
        (denominator u) (denominator v))
      (I.mulIntegerAssoc
        (I.mulInteger (#numerator{y}) (denominator x))
        (denominator u) (denominator v))
      (FractionOrder.ltMulDenominator
        (I.mulInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (denominator u))
        (I.mulInteger
          (I.mulInteger (#numerator{y}) (denominator x))
          (denominator u))
        (#denominatorIndex{v})
        (FractionOrder.ltMulDenominator
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x))
          (#denominatorIndex{u}) xy));

\definition addOrderLeftAlignment(x, u, y, v: Fraction):
  I.mulInteger (#numerator{(Def.add x u)}) (denominator (Def.add y v)) =
    I.addInteger
      (I.mulInteger
        (I.mulInteger (#numerator{x}) (denominator y))
        (I.mulInteger (denominator u) (denominator v)))
      (I.mulInteger
        (I.mulInteger (#numerator{u}) (denominator v))
        (I.mulInteger (denominator x) (denominator y))) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
      (denominatorAdd y v) }
    "by" { I.mulIntegerDistribRight
      (I.mulInteger (#numerator{x}) (denominator u))
      (I.mulInteger (#numerator{u}) (denominator x))
      (I.mulInteger (denominator y) (denominator v)) }
    "by" { I.addIntegerRespects _ _ _ _
      (I.mulIntegerInterchange
        (#numerator{x}) (denominator u)
        (denominator y) (denominator v))
      (mulIntegerFourSwap
        (#numerator{u}) (denominator x)
        (denominator y) (denominator v)) }};

\definition ltAdd(x, y, u, v: Fraction):
  lt x y -> lt u v ->
  lt (Def.add x u) (Def.add y v) :=
   \fun (xy: lt x y) (uv: lt u v) =>
    IntegerOrder.ltRespects
      (I.addInteger
        (I.mulInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (denominator u) (denominator v)))
        (I.mulInteger
          (I.mulInteger (#numerator{u}) (denominator v))
          (I.mulInteger (denominator x) (denominator y))))
      (I.mulInteger (#numerator{(Def.add x u)}) (denominator (Def.add y v)))
      (I.addInteger
        (I.mulInteger
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (denominator u) (denominator v)))
        (I.mulInteger
          (I.mulInteger (#numerator{v}) (denominator u))
          (I.mulInteger (denominator x) (denominator y))))
      (I.mulInteger (#numerator{(Def.add y v)}) (denominator (Def.add x u)))
      (I.integerEqSym _ _ (addOrderLeftAlignment x u y v))
      (equiv_reason!{I.integerEqTrans
        "by" { I.addIntegerRespects _ _ _ _
          (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
            (I.mulIntegerComm (denominator u) (denominator v)))
          (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
            (I.mulIntegerComm (denominator x) (denominator y))) }
        "by" { I.integerEqSym _ _ (addOrderLeftAlignment y v x u) }})
      (IntegerOrder.ltAdd _ _ _ _
        (ltScaleByTwoDenominators x y u v xy)
        (ltScaleByTwoDenominators u v x y uv));

\definition ltAddRight(x, y, z: Fraction):
  lt x y ->
  lt (Def.add x z) (Def.add y z) :=
  \fun (xy: lt x y) =>
    IntegerOrder.ltRespects
      (I.addInteger
        (I.mulInteger
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (denominator z) (denominator z)))
        (I.mulInteger
          (I.mulInteger (#numerator{z}) (denominator z))
          (I.mulInteger (denominator x) (denominator y))))
      (I.mulInteger (#numerator{(Def.add x z)}) (denominator (Def.add y z)))
      (I.addInteger
        (I.mulInteger
          (I.mulInteger (#numerator{y}) (denominator x))
          (I.mulInteger (denominator z) (denominator z)))
        (I.mulInteger
          (I.mulInteger (#numerator{z}) (denominator z))
          (I.mulInteger (denominator x) (denominator y))))
      (I.mulInteger (#numerator{(Def.add y z)}) (denominator (Def.add x z)))
      (I.integerEqSym _ _ (addOrderLeftAlignment x z y z))
      (equiv_reason!{I.integerEqTrans
        "by" { I.addIntegerRespects _ _ _ _
          (I.integerEqRefl _)
          (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
            (I.mulIntegerComm (denominator x) (denominator y))) }
        "by" { I.integerEqSym _ _ (addOrderLeftAlignment y z x z) }})
      (IntegerOrder.ltAddRight _ _ _
        (ltScaleByTwoDenominators x y z z xy));

\definition ltAddLeft(z, x, y: Fraction):
  lt x y ->
  lt (Def.add z x) (Def.add z y) :=
  \fun (xy: _) =>
    FractionOrder.ltRespects
      (Def.add x z) (Def.add z x) (Def.add y z) (Def.add z y)
      (fractionAddComm x z) (fractionAddComm y z)
      (ltAddRight x y z xy);

\definition adjustmentLtZero(q, a: Fraction):
  lt q a ->
  lt (Def.adjustment q a) zero :=
  \fun (qa: _) =>
    FractionOrder.ltReplaceRight
      (Def.adjustment q a)
      (Def.add (Def.midpoint q a) (Def.neg (Def.midpoint q a))) zero
      (fractionAddNegRight (Def.midpoint q a))
      (ltAddRight q (Def.midpoint q a) (Def.neg (Def.midpoint q a))
        (ltMidpoint q a qa));

\definition addAdjustmentEq(q, a: Fraction):
  FractionEq (Def.add (Def.midpoint q a) (Def.adjustment q a)) q :=
  equiv_reason!{fractionEqTrans
    "by" { fractionEqSym _ _
      (fractionAddAssoc (Def.midpoint q a) q (Def.neg (Def.midpoint q a))) }
    "by" { fractionAddRespects
      (Def.add (Def.midpoint q a) q) (Def.add q (Def.midpoint q a))
      (Def.neg (Def.midpoint q a)) (Def.neg (Def.midpoint q a))
      (fractionAddComm (Def.midpoint q a) q) (fractionEqRefl _) }
    "by" { fractionAddAssoc q (Def.midpoint q a) (Def.neg (Def.midpoint q a)) }
    "by" { fractionAddRespects q q
      (Def.add (Def.midpoint q a) (Def.neg (Def.midpoint q a))) zero
      (fractionEqRefl q) (fractionAddNegRight (Def.midpoint q a)) }
    "by" { fractionAddZeroRight q }};

\definition fractionAddCancelRightSimplify(x, z: Fraction):
  FractionEq (Def.add (Def.add x z) (Def.neg z)) x :=
  equiv_reason!{fractionEqTrans
    "by" { fractionAddAssoc x z (Def.neg z) }
    "by" { fractionAddRespects x x (Def.add z (Def.neg z)) zero
      (fractionEqRefl x) (fractionAddNegRight z) }
    "by" { fractionAddZeroRight x }};

\definition fractionAddCancelRight(x, y, z: Fraction):
  FractionEq (Def.add x z) (Def.add y z) ->
  FractionEq x y :=
  \fun (same: _) =>
    equiv_reason!{fractionEqTrans
      "by" { fractionEqSym _ _ (fractionAddCancelRightSimplify x z) }
      "by" { fractionAddRespects (Def.add x z) (Def.add y z)
        (Def.neg z) (Def.neg z) same (fractionEqRefl _) }
      "by" { fractionAddCancelRightSimplify y z }};

\definition ltAddAdjustment(q, a: Fraction):
  lt q a ->
  lt q (Def.add a (Def.adjustment q a)) :=
  \fun (qa: _) =>
    FractionOrder.ltReplaceLeft
      (Def.add (Def.midpoint q a) (Def.adjustment q a)) q
      (Def.add a (Def.adjustment q a))
      (addAdjustmentEq q a)
      (ltAddRight (Def.midpoint q a) a (Def.adjustment q a)
        (midpointLt q a qa));

\definition zeroLtNumerator(e: Fraction):
  lt zero e ->
  I.IntegerLt I.zeroInteger (#numerator{e}) :=
  \fun (positive: lt zero e) =>
    IntegerOrder.ltRespects
      (I.mulInteger I.zeroInteger (denominator e)) I.zeroInteger
      (I.mulInteger (#numerator{e}) I.oneInteger) (#numerator{e})
      (I.mulIntegerZeroLeft (denominator e))
      (I.mulIntegerOneRight (#numerator{e})) positive;

\definition zeroLtOfNumerator(e: Fraction):
  I.IntegerLt I.zeroInteger (#numerator{e}) ->
  lt zero e :=
  \fun (positive: I.IntegerLt I.zeroInteger (#numerator{e})) =>
    IntegerOrder.ltRespects
      I.zeroInteger
      (I.mulInteger I.zeroInteger (denominator e))
      (#numerator{e})
      (I.mulInteger (#numerator{e}) I.oneInteger)
      (I.integerEqSym
        (I.mulInteger I.zeroInteger (denominator e)) I.zeroInteger
        (I.mulIntegerZeroLeft (denominator e)))
      (I.integerEqSym
        (I.mulInteger (#numerator{e}) I.oneInteger) (#numerator{e})
        (I.mulIntegerOneRight (#numerator{e})))
      positive;

\definition zeroLtTimesDenominator(x: I.Integer) (d: I.Nat):
  I.IntegerLt I.zeroInteger x ->
  I.IntegerLt I.zeroInteger
    (I.mulInteger x (I.integer (I.natSucc d) I.zeroNat)) :=
  \fun (positive: _) =>
    IntegerOrder.ltRespects
      (I.mulInteger I.zeroInteger
        (I.integer (I.natSucc d) I.zeroNat)) I.zeroInteger
      (I.mulInteger x (I.integer (I.natSucc d) I.zeroNat))
      (I.mulInteger x (I.integer (I.natSucc d) I.zeroNat))
      (I.mulIntegerZeroLeft (I.integer (I.natSucc d) I.zeroNat))
      (I.integerEqRefl _)
      (FractionOrder.ltMulDenominator I.zeroInteger x d positive);

\definition naturalTranslateDenominator(a, e: Fraction) (n: I.Nat):
  denominator (Def.naturalTranslate a e n) =
    I.mulInteger (denominator a) (denominator e) :=
  denominatorAdd a e;

\definition scaleFractionSucc(e: Fraction) (n: I.Nat):
  FractionEq (Def.scaleFraction e (I.natSucc n))
    (Def.add (Def.scaleFraction e n) e) :=
  \block {
    \let previous: I.Integer := I.scaleInteger (#numerator{e}) n \then
    \let next: I.Integer := I.scaleInteger (#numerator{e}) (I.natSucc n) \then
    \let d: I.Integer := denominator e \then
    \let numeratorStep:
        next = I.addInteger previous (#numerator{e}) :=
      equiv_reason!{I.integerEqTrans
        "by" { I.scaleIntegerSucc (#numerator{e}) n }
        "by" { I.addIntegerComm (#numerator{e}) previous }} \then
    \let leftAlignment:
        I.mulInteger next (denominator (Def.add (Def.scaleFraction e n) e)) =
          I.mulInteger
            (I.addInteger previous (#numerator{e}))
            (I.mulInteger d d) :=
      I.mulIntegerRespects next (I.addInteger previous (#numerator{e}))
        (denominator (Def.add (Def.scaleFraction e n) e))
        (I.mulInteger d d) numeratorStep
        (denominatorAdd (Def.scaleFraction e n) e) \then
    \let rightAlignment:
        I.mulInteger (#numerator{(Def.add (Def.scaleFraction e n) e)}) d =
          I.mulInteger
            (I.addInteger previous (#numerator{e}))
            (I.mulInteger d d) :=
      equiv_reason!{I.integerEqTrans
        "by" { I.mulIntegerRespects _ _ d d
          (I.integerEqSym _ _
            (I.mulIntegerDistribRight previous (#numerator{e}) d))
          (I.integerEqRefl d) }
        "by" { I.mulIntegerAssoc
          (I.addInteger previous (#numerator{e})) d d }} \then
    \return equiv_reason!{I.integerEqTrans
      "by" { leftAlignment }
      "by" { I.integerEqSym _ _ rightAlignment }}
  };

\definition naturalTranslateNumeratorAsAdd(a, e: Fraction) (n: I.Nat):
  #numerator{(Def.naturalTranslate a e n)} =
    #numerator{(Def.add a (Def.scaleFraction e n))} :=
  I.addIntegerRespects
    (I.mulInteger (#numerator{a}) (denominator e))
    (I.mulInteger (#numerator{a}) (denominator (Def.scaleFraction e n)))
    (I.scaleInteger
      (I.mulInteger (#numerator{e}) (denominator a)) n)
    (I.mulInteger (I.scaleInteger (#numerator{e}) n) (denominator a))
    (I.integerEqRefl _)
    (I.scaleIntegerMulRight (#numerator{e}) (denominator a) n);

\definition naturalTranslateAsAdd(a, e: Fraction) (n: I.Nat):
  FractionEq (Def.naturalTranslate a e n) (Def.add a (Def.scaleFraction e n)) :=
  fractionEqOfNumeratorDenominator
    (Def.naturalTranslate a e n) (Def.add a (Def.scaleFraction e n))
    (naturalTranslateNumeratorAsAdd a e n)
    (equiv_reason!{I.integerEqTrans
      "by" { naturalTranslateDenominator a e n }
      "by" { I.integerEqSym _ _ (denominatorAdd a (Def.scaleFraction e n)) }});

\definition scaleFractionZero(e: Fraction): FractionEq (Def.scaleFraction e I.zeroNat) zero :=
  fractionEqZeroOfNumerator (Def.scaleFraction e I.zeroNat)
    (I.scaleIntegerByZero (#numerator{e}));

\definition gridZero(a, e: Fraction): FractionEq (Def.grid a e I.zeroNat) a :=
  equiv_reason!{fractionEqTrans
    "by" { fractionAddRespects a a (Def.scaleFraction e I.zeroNat) zero
      (fractionEqRefl a) (scaleFractionZero e) }
    "by" { fractionAddZeroRight a }};

\definition gridSucc(a, e: Fraction) (n: I.Nat):
  FractionEq (Def.grid a e (I.natSucc n)) (Def.add (Def.grid a e n) e) :=
  equiv_reason!{fractionEqTrans
    "by" { fractionAddRespects a a
      (Def.scaleFraction e (I.natSucc n)) (Def.add (Def.scaleFraction e n) e)
      (fractionEqRefl a) (scaleFractionSucc e n) }
    "by" { fractionEqSym _ _
      (fractionAddAssoc a (Def.scaleFraction e n) e) }};

\definition naturalTranslateAsGrid(a, e: Fraction) (n: I.Nat):
  FractionEq (Def.naturalTranslate a e n) (Def.grid a e n) :=
  naturalTranslateAsAdd a e n;

\definition naturalTranslateAbove(a, e, b: Fraction):
  lt zero e ->
  Def.NaturalTranslateAbove a e b :=
  \block {
    \fun (positive: lt zero e) \then
    \let base: I.Integer :=
      I.mulInteger (#numerator{a}) (denominator e) \then
    \let increment: I.Integer :=
      I.mulInteger (#numerator{e}) (denominator a) \then
    \let scaledIncrement: I.Integer :=
      I.mulInteger increment (denominator b) \then
    \let leftCross: I.Integer :=
      I.mulInteger (#numerator{b})
        (I.mulInteger (denominator a) (denominator e)) \then
    \let baseCross: I.Integer :=
      I.mulInteger base (denominator b) \then
    \let difference: I.Integer :=
      I.addInteger leftCross (I.negInteger baseCross) \then
    \let incrementPositive: I.IntegerLt I.zeroInteger increment :=
      zeroLtTimesDenominator (#numerator{e}) (#denominatorIndex{a})
        (zeroLtNumerator e positive) \then
    \let scaledIncrementPositive:
        I.IntegerLt I.zeroInteger scaledIncrement :=
      zeroLtTimesDenominator increment (#denominatorIndex{b})
        incrementPositive \then
    \return
      \take (n: \Cast[I.Nat] ({ n : I.Nat \where I.IntegerLt difference
            (I.scaleInteger scaledIncrement n) })) =>
        \block {
          \let archBound:
              I.IntegerLt difference
                (I.scaleInteger scaledIncrement n) :=
            \bysub(I.Nat,
              { n : I.Nat \where I.IntegerLt difference
                  (I.scaleInteger scaledIncrement n) }, n) \then
          \let withBase:
              I.IntegerLt (I.addInteger difference baseCross)
                (I.addInteger
                  (I.scaleInteger scaledIncrement n) baseCross) :=
            IntegerOrder.ltAddRight difference
              (I.scaleInteger scaledIncrement n) baseCross archBound \then
          \let lowerAlignment:
              I.addInteger difference baseCross =
                I.mulInteger (#numerator{b})
                  (denominator (Def.naturalTranslate a e n)) :=
            equiv_reason!{I.integerEqTrans
              "by" { I.addIntegerSubCancelRight leftCross baseCross }
              "by" { I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
                (I.integerEqSym _ _
                  (naturalTranslateDenominator a e n)) }} \then
          \let upperAlignment:
              I.addInteger
                  (I.scaleInteger scaledIncrement n) baseCross =
                I.mulInteger (#numerator{(Def.naturalTranslate a e n)})
                  (denominator b) :=
            equiv_reason!{I.integerEqTrans
              "by" { I.addIntegerRespects _ _ _ _
                (I.scaleIntegerMulRight increment (denominator b) n)
                (I.integerEqRefl baseCross) }
              "by" { I.addIntegerComm
                (I.mulInteger (I.scaleInteger increment n)
                  (denominator b)) baseCross }
              "by" { I.integerEqSym _ _
                (I.mulIntegerDistribRight base
                  (I.scaleInteger increment n) (denominator b)) }} \then
          \let rationalBound: lt b (Def.naturalTranslate a e n) :=
            IntegerOrder.ltRespects
              (I.addInteger difference baseCross)
              (I.mulInteger (#numerator{b})
                (denominator (Def.naturalTranslate a e n)))
              (I.addInteger (I.scaleInteger scaledIncrement n) baseCross)
              (I.mulInteger (#numerator{(Def.naturalTranslate a e n)})
                (denominator b))
              lowerAlignment upperAlignment withBase \then
          \return \exact(
            \into[I.Nat](n, { n : I.Nat \where lt b (Def.naturalTranslate a e n) }) \by { rationalBound },
            \Cast[I.Nat] ({ n : I.Nat \where lt b (Def.naturalTranslate a e n) }))
        }
      \by { IntegerOrder.positiveMultipleAbove scaledIncrement
        scaledIncrementPositive difference }
  };

/* The quotient is fixed to the proved FractionEq equivalence relation. */
\definition addCommEquality(x, y: Fraction): Def.add x y = Def.add y x :=
  congr2!{I.Integer I.Nat Fraction} Fraction::# (#numerator{(Def.add x y)}) (#numerator{(Def.add y x)})
    (#denominatorIndex{(Def.add x y)}) (#denominatorIndex{(Def.add y x)})
    (I.addIntegerComm
      (I.mulInteger (#numerator{x}) (denominator y))
      (I.mulInteger (#numerator{y}) (denominator x)))
    (denominatorProductIndexComm (#denominatorIndex{x}) (#denominatorIndex{y}));
\definition subFieldsLeft(x, y, z: Fraction):
  #numerator{x} = #numerator{z} ->
  #denominatorIndex{x} = #denominatorIndex{z} ->
  Def.sub x y = Def.sub z y :=
  \fun (num: #numerator{x} = #numerator{z}) (den: #denominatorIndex{x} = #denominatorIndex{z}) =>
    congr2!{I.Integer I.Nat Fraction} (\fun (n: I.Integer) => \fun (d: I.Nat) => Def.sub (Fraction::# n d) y)
      (#numerator{x}) (#numerator{z}) (#denominatorIndex{x}) (#denominatorIndex{z}) num den;
\definition subFieldsRight(x, y, z: Fraction):
  #numerator{y} = #numerator{z} ->
  #denominatorIndex{y} = #denominatorIndex{z} ->
  Def.sub x y = Def.sub x z :=
  \fun (num: #numerator{y} = #numerator{z}) (den: #denominatorIndex{y} = #denominatorIndex{z}) =>
    congr2!{I.Integer I.Nat Fraction} (\fun (n: I.Integer) => \fun (d: I.Nat) => Def.sub x (Fraction::# n d))
      (#numerator{y}) (#numerator{z}) (#denominatorIndex{y}) (#denominatorIndex{z}) num den;
\definition negInvolutiveNumerator(x: Fraction): #numerator{(Def.neg (Def.neg x))} = #numerator{x} :=
  I.negIntegerInvolutive (#numerator{x});
\definition subNegEquality(x, y: Fraction): Def.sub (Def.neg x) (Def.neg y) = Def.sub y x :=
  trans!{Fraction} _ _ _
    (congr!{I.Integer Fraction}
      (\fun (n: I.Integer) => Def.add (Def.neg x) (Fraction::# n (#denominatorIndex{y})))
      (I.negInteger (I.negInteger (#numerator{y}))) (#numerator{y})
      (negInvolutiveNumerator y))
    (addCommEquality (Def.neg x) y);

/* Cancellation and reassociation lemmas used by dense cut arithmetic. */
\definition fractionAddCancelRightEq(x, y, z: Fraction):
  FractionEq (Def.add x z) (Def.add y z) ->
  FractionEq x y :=
  \fun (same: _) =>
    equiv_reason!{fractionEqTrans
      "by" { fractionEqSym _ _ (fractionAddZeroRight x) }
      "by" { fractionAddRespects x x zero (Def.add z (Def.neg z))
        (fractionEqRefl x)
        (fractionEqSym _ _ (fractionAddNegRight z)) }
      "by" { fractionEqSym _ _ (fractionAddAssoc x z (Def.neg z)) }
      "by" { fractionAddRespects (Def.add x z) (Def.add y z)
        (Def.neg z) (Def.neg z) same (fractionEqRefl (Def.neg z)) }
      "by" { fractionAddAssoc y z (Def.neg z) }
      "by" { fractionAddRespects y y (Def.add z (Def.neg z)) zero
        (fractionEqRefl y) (fractionAddNegRight z) }
      "by" { fractionAddZeroRight y }};

\definition fractionAddRotate(a, b, c: Fraction):
  FractionEq (Def.add (Def.add a b) c) (Def.add (Def.add a c) b) :=
  equiv_reason!{fractionEqTrans
    "by" { fractionAddAssoc a b c }
    "by" { fractionAddRespects a a (Def.add b c) (Def.add c b)
      (fractionEqRefl a) (fractionAddComm b c) }
    "by" { fractionEqSym _ _ (fractionAddAssoc a c b) }};

\definition fractionNegAddLeft(x, y: Fraction):
  FractionEq (Def.add (Def.neg (Def.add x y)) x) (Def.neg y) :=
  fractionAddCancelRightEq (Def.add (Def.neg (Def.add x y)) x) (Def.neg y) y
    (equiv_reason!{fractionEqTrans
      "by" { fractionAddAssoc (Def.neg (Def.add x y)) x y }
      "by" { fractionAddNegLeft (Def.add x y) }
      "by" { fractionEqSym _ _ (fractionAddNegLeft y) }});

\definition perturbLeftLt(q, a, b: Fraction):
  lt q (Def.add a b) ->
  lt (Def.perturbLeft q a b) a :=
  \fun (qab: _) =>
    FractionOrder.ltReplaceRight
      (Def.perturbLeft q a b) (Def.add a zero) a
      (fractionAddZeroRight a)
      (ltAddLeft a (Def.adjustment q (Def.add a b)) zero
        (adjustmentLtZero q (Def.add a b) qab));

\definition ltPerturbedSum(q, a, b: Fraction):
  lt q (Def.add a b) ->
  lt q (Def.add (Def.perturbLeft q a b) b) :=
  \fun (qab: _) =>
    FractionOrder.ltReplaceRight q
      (Def.add (Def.add a b) (Def.adjustment q (Def.add a b)))
      (Def.add (Def.perturbLeft q a b) b)
      (fractionAddRotate a b (Def.adjustment q (Def.add a b)))
      (ltAddAdjustment q (Def.add a b) qab);

\definition mulOrderLeftAlignment(x, y, z: Fraction):
  I.mulInteger
      (I.mulInteger
        (I.mulInteger (#numerator{x}) (denominator y)) (#numerator{z}))
      (denominator z) =
    I.mulInteger (#numerator{(Def.mul x z)}) (denominator (Def.mul y z)) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerAssoc
      (I.mulInteger (#numerator{x}) (denominator y))
      (#numerator{z}) (denominator z) }
    "by" { I.mulIntegerInterchange (#numerator{x}) (denominator y)
      (#numerator{z}) (denominator z) }
    "by" { I.mulIntegerRespects _ _ _ _
      (I.integerEqRefl (#numerator{(Def.mul x z)}))
      (I.integerEqSym _ _ (denominatorMul y z)) }};

\definition mulOrderRightAlignment(x, y, z: Fraction):
  I.mulInteger
      (I.mulInteger
        (I.mulInteger (#numerator{y}) (denominator x)) (#numerator{z}))
      (denominator z) =
    I.mulInteger (#numerator{(Def.mul y z)}) (denominator (Def.mul x z)) :=
  equiv_reason!{I.integerEqTrans
    "by" { I.mulIntegerAssoc
      (I.mulInteger (#numerator{y}) (denominator x))
      (#numerator{z}) (denominator z) }
    "by" { I.mulIntegerInterchange (#numerator{y}) (denominator x)
      (#numerator{z}) (denominator z) }
    "by" { I.mulIntegerRespects _ _ _ _
      (I.integerEqRefl (#numerator{(Def.mul y z)}))
      (I.integerEqSym _ _ (denominatorMul x z)) }};

\definition ltMulPositiveRight(x, y, z: Fraction):
  lt zero z -> lt x y ->
  lt (Def.mul x z) (Def.mul y z) :=
  \fun (positive: lt zero z) (xy: lt x y) =>
    IntegerOrder.ltRespects _ _ _ _
      (mulOrderLeftAlignment x y z)
      (mulOrderRightAlignment x y z)
      (IntegerOrder.ltMulPositiveRight
        (I.mulInteger
          (I.mulInteger (#numerator{x}) (denominator y)) (#numerator{z}))
        (I.mulInteger
          (I.mulInteger (#numerator{y}) (denominator x)) (#numerator{z}))
        (denominator z) (denominatorPositive z)
        (IntegerOrder.ltMulPositiveRight
          (I.mulInteger (#numerator{x}) (denominator y))
          (I.mulInteger (#numerator{y}) (denominator x))
          (#numerator{z}) (zeroLtNumerator z positive) xy));

\definition ltMulPositiveLeft(z, x, y: Fraction):
  lt zero z -> lt x y ->
  lt (Def.mul z x) (Def.mul z y) :=
  \fun (positive: _) (xy: _) =>
    FractionOrder.ltRespects
      (Def.mul x z) (Def.mul z x) (Def.mul y z) (Def.mul z y)
      (fractionMulComm x z) (fractionMulComm y z)
      (ltMulPositiveRight x y z positive xy);

\definition negMulNegAlignment(x, z: Fraction):
  FractionEq (Def.neg (Def.mul x (Def.neg z))) (Def.mul x z) :=
  equiv_reason!{fractionEqTrans
    "by" { fractionNegRespects (Def.mul x (Def.neg z)) (Def.neg (Def.mul x z))
      (fractionMulNegRight x z) }
    "by" { fractionNegInvolutive (Def.mul x z) }};

\definition ltMulNegativeRight(x, y, z: Fraction):
  lt z zero -> lt x y ->
  lt (Def.mul y z) (Def.mul x z) :=
  \block {
    \fun (negative: lt z zero) (xy: lt x y) \then
    \let positiveNeg: lt zero (Def.neg z) :=
      FractionOrder.ltReplaceLeft (Def.neg zero) zero (Def.neg z)
        (fractionEqRefl zero)
        (ltNegReverse z zero negative) \then
    \let scaled: lt (Def.mul x (Def.neg z)) (Def.mul y (Def.neg z)) :=
      ltMulPositiveRight x y (Def.neg z) positiveNeg xy \then
    \let reversed:
        lt (Def.neg (Def.mul y (Def.neg z))) (Def.neg (Def.mul x (Def.neg z))) :=
      ltNegReverse (Def.mul x (Def.neg z)) (Def.mul y (Def.neg z)) scaled \then
    \return FractionOrder.ltRespects
      (Def.neg (Def.mul y (Def.neg z))) (Def.mul y z)
      (Def.neg (Def.mul x (Def.neg z))) (Def.mul x z)
      (negMulNegAlignment y z) (negMulNegAlignment x z) reversed
  };

\definition ltMulNegativeLeft(z, x, y: Fraction):
  lt z zero -> lt x y ->
  lt (Def.mul z y) (Def.mul z x) :=
  \fun (negative: _) (xy: _) =>
    FractionOrder.ltRespects
      (Def.mul y z) (Def.mul z y) (Def.mul x z) (Def.mul z x)
      (fractionMulComm y z) (fractionMulComm x z)
      (ltMulNegativeRight x y z negative xy);

\definition leRefl(x: Fraction): Def.Le x x :=
  Logic.Or[FractionEq x x, lt x x]::left (fractionEqRefl x);

\definition leOfEq(x, y: Fraction):
  FractionEq x y ->
  Def.Le x y :=
  Logic.Or[FractionEq x y, lt x y]::left;

\definition leOfLt(x, y: Fraction):
  lt x y ->
  Def.Le x y :=
  Logic.Or[FractionEq x y, lt x y]::right;

\definition leTrans(x, y, z: Fraction):
  Def.Le x y -> Def.Le y z ->
  Def.Le x z :=
  \fun (xy: Def.Le x y) (yz: Def.Le y z) =>
    either!{
      {FractionEq x y} "or" {lt x y} "either" {Def.Le x z}
      "lt:" {\fun (sameXY: FractionEq x y) =>
        either!{
          {FractionEq y z} "or" {lt y z} "either" {Def.Le x z}
          "lt:" {\fun (sameYZ: FractionEq y z) =>
            leOfEq x z (equiv_reason_terms!{fractionEqTrans { x }
              "~" { y } "by" { sameXY }
              "~" { z } "by" { sameYZ }})}
          "rt:" {\fun (lessYZ: lt y z) =>
            leOfLt x z
              (FractionOrder.ltReplaceLeft y x z
                (fractionEqSym x y sameXY) lessYZ)}
        }
          yz}
      "rt:" {\fun (lessXY: lt x y) =>
        either!{
          {FractionEq y z} "or" {lt y z} "either" {Def.Le x z}
          "lt:" {\fun (sameYZ: FractionEq y z) =>
            leOfLt x z
              (FractionOrder.ltReplaceRight x y z sameYZ lessXY)}
          "rt:" {\fun (lessYZ: lt y z) =>
            leOfLt x z (FractionOrder.ltTrans x y z lessXY lessYZ)}
        }
          yz}
    }
      xy;

\definition ltLeTrans(x, y, z: Fraction):
  lt x y -> Def.Le y z ->
  lt x z :=
  \fun (xy: lt x y) (yz: Def.Le y z) =>
    either!{
      {FractionEq y z} "or" {lt y z} "either" {lt x z}
      "lt:" {\fun (same: FractionEq y z) =>
        FractionOrder.ltReplaceRight x y z same xy}
      "rt:" {\fun (less: lt y z) => FractionOrder.ltTrans x y z xy less}
    }
      yz;

\definition leLtTrans(x, y, z: Fraction):
  Def.Le x y -> lt y z ->
  lt x z :=
  \fun (xy: Def.Le x y) (yz: lt y z) =>
    either!{
      {FractionEq x y} "or" {lt x y} "either" {lt x z}
      "lt:" {\fun (same: FractionEq x y) =>
        FractionOrder.ltReplaceLeft y x z (fractionEqSym x y same) yz}
      "rt:" {\fun (less: lt x y) => FractionOrder.ltTrans x y z less yz}
    }
      xy;

\definition leMulPositiveRight(x, y, z: Fraction):
  lt zero z -> Def.Le x y ->
  Def.Le (Def.mul x z) (Def.mul y z) :=
  \fun (positive: lt zero z) (xy: Def.Le x y) =>
    either!{
      {FractionEq x y} "or" {lt x y} "either" {Def.Le (Def.mul x z) (Def.mul y z)}
      "lt:" {\fun (same: FractionEq x y) =>
        leOfEq (Def.mul x z) (Def.mul y z)
          (fractionMulRespects x y z z same (fractionEqRefl z))}
      "rt:" {\fun (less: lt x y) =>
        leOfLt (Def.mul x z) (Def.mul y z)
          (ltMulPositiveRight x y z positive less)}
    }
      xy;

\definition leMulPositiveLeft(z, x, y: Fraction):
  lt zero z -> Def.Le x y ->
  Def.Le (Def.mul z x) (Def.mul z y) :=
  \fun (positive: lt zero z) (xy: Def.Le x y) =>
    either!{
      {FractionEq x y} "or" {lt x y} "either" {Def.Le (Def.mul z x) (Def.mul z y)}
      "lt:" {\fun (same: FractionEq x y) =>
        leOfEq (Def.mul z x) (Def.mul z y)
          (fractionMulRespects z z x y (fractionEqRefl z) same)}
      "rt:" {\fun (less: lt x y) =>
        leOfLt (Def.mul z x) (Def.mul z y)
          (ltMulPositiveLeft z x y positive less)}
    }
      xy;

\definition leMulNegativeRight(x, y, z: Fraction):
  lt z zero -> Def.Le x y ->
  Def.Le (Def.mul y z) (Def.mul x z) :=
  \fun (negative: lt z zero) (xy: Def.Le x y) =>
    either!{
      {FractionEq x y} "or" {lt x y} "either" {Def.Le (Def.mul y z) (Def.mul x z)}
      "lt:" {\fun (same: FractionEq x y) =>
        leOfEq (Def.mul y z) (Def.mul x z)
          (fractionMulRespects y x z z
            (fractionEqSym x y same) (fractionEqRefl z))}
      "rt:" {\fun (less: lt x y) =>
        leOfLt (Def.mul y z) (Def.mul x z)
          (ltMulNegativeRight x y z negative less)}
    }
      xy;

\definition leMulNegativeLeft(z, x, y: Fraction):
  lt z zero -> Def.Le x y ->
  Def.Le (Def.mul z y) (Def.mul z x) :=
  \fun (negative: lt z zero) (xy: Def.Le x y) =>
    either!{
      {FractionEq x y} "or" {lt x y} "either" {Def.Le (Def.mul z y) (Def.mul z x)}
      "lt:" {\fun (same: FractionEq x y) =>
        leOfEq (Def.mul z y) (Def.mul z x)
          (fractionMulRespects z z y x
            (fractionEqRefl z) (fractionEqSym x y same))}
      "rt:" {\fun (less: lt x y) =>
        leOfLt (Def.mul z y) (Def.mul z x)
          (ltMulNegativeLeft z x y negative less)}
    }
      xy;

\definition leMulNonnegativeLeft(z, x, y: Fraction):
  Def.Le zero z -> Def.Le x y ->
  Def.Le (Def.mul z x) (Def.mul z y) :=
  \fun (nonnegative: Def.Le zero z) (xy: Def.Le x y) =>
    either!{
      {FractionEq zero z} "or" {lt zero z} "either" {Def.Le (Def.mul z x) (Def.mul z y)}
      "lt:" {\fun (zeroZ: FractionEq zero z) =>
        leOfEq (Def.mul z x) (Def.mul z y)
          (equiv_reason_terms!{fractionEqTrans { Def.mul z x }
            "~" { zero } "by" { equiv_reason_terms!{fractionEqTrans { Def.mul z x }
              "~" { Def.mul zero x } "by" { fractionMulRespects z zero x x
                (fractionEqSym _ _ zeroZ) (fractionEqRefl x) }
              "~" { zero } "by" { fractionMulZeroLeft x }} }
            "~" { Def.mul z y } "by" { fractionEqSym _ _
              (equiv_reason_terms!{fractionEqTrans { Def.mul z y }
                "~" { Def.mul zero y } "by" { fractionMulRespects z zero y y
                  (fractionEqSym _ _ zeroZ) (fractionEqRefl y) }
                "~" { zero } "by" { fractionMulZeroLeft y }}) }})}
      "rt:" {\fun (positive: lt zero z) =>
        leMulPositiveLeft z x y positive xy}
    }
      nonnegative;

\definition leMulNonnegativeRight(x, y, z: Fraction):
  Def.Le zero z -> Def.Le x y ->
  Def.Le (Def.mul x z) (Def.mul y z) :=
  \fun (nonnegative: Def.Le zero z) (xy: Def.Le x y) =>
    either!{
      {FractionEq zero z} "or" {lt zero z} "either" {Def.Le (Def.mul x z) (Def.mul y z)}
      "lt:" {\fun (zeroZ: FractionEq zero z) =>
        leOfEq (Def.mul x z) (Def.mul y z)
          (equiv_reason_terms!{fractionEqTrans { Def.mul x z }
            "~" { zero } "by" { equiv_reason_terms!{fractionEqTrans { Def.mul x z }
              "~" { Def.mul x zero } "by" { fractionMulRespects x x z zero
                (fractionEqRefl x) (fractionEqSym _ _ zeroZ) }
              "~" { zero } "by" { fractionMulZeroRight x }} }
            "~" { Def.mul y z } "by" { fractionEqSym _ _
              (equiv_reason_terms!{fractionEqTrans { Def.mul y z }
                "~" { Def.mul y zero } "by" { fractionMulRespects y y z zero
                  (fractionEqRefl y) (fractionEqSym _ _ zeroZ) }
                "~" { zero } "by" { fractionMulZeroRight y }}) }})}
      "rt:" {\fun (positive: lt zero z) =>
        leMulPositiveRight x y z positive xy}
    }
      nonnegative;

\definition leMulNonpositiveLeft(z, x, y: Fraction):
  Def.Le z zero -> Def.Le x y ->
  Def.Le (Def.mul z y) (Def.mul z x) :=
  \fun (nonpositive: Def.Le z zero) (xy: Def.Le x y) =>
    either!{
      {FractionEq z zero} "or" {lt z zero} "either" {Def.Le (Def.mul z y) (Def.mul z x)}
      "lt:" {\fun (zZero: FractionEq z zero) =>
        leOfEq (Def.mul z y) (Def.mul z x)
          (equiv_reason_terms!{fractionEqTrans { Def.mul z y }
            "~" { zero } "by" { equiv_reason_terms!{fractionEqTrans { Def.mul z y }
              "~" { Def.mul zero y } "by" { fractionMulRespects z zero y y zZero (fractionEqRefl y) }
              "~" { zero } "by" { fractionMulZeroLeft y }} }
            "~" { Def.mul z x } "by" { fractionEqSym _ _
              (equiv_reason_terms!{fractionEqTrans { Def.mul z x }
                "~" { Def.mul zero x } "by" { fractionMulRespects z zero x x zZero (fractionEqRefl x) }
                "~" { zero } "by" { fractionMulZeroLeft x }}) }})}
      "rt:" {\fun (negative: lt z zero) =>
        leMulNegativeLeft z x y negative xy}
    }
      nonpositive;

\definition leMulNonpositiveRight(x, y, z: Fraction):
  Def.Le z zero -> Def.Le x y ->
  Def.Le (Def.mul y z) (Def.mul x z) :=
  \fun (nonpositive: Def.Le z zero) (xy: Def.Le x y) =>
    either!{
      {FractionEq z zero} "or" {lt z zero} "either" {Def.Le (Def.mul y z) (Def.mul x z)}
      "lt:" {\fun (zZero: FractionEq z zero) =>
        leOfEq (Def.mul y z) (Def.mul x z)
          (equiv_reason_terms!{fractionEqTrans { Def.mul y z }
            "~" { zero } "by" { equiv_reason_terms!{fractionEqTrans { Def.mul y z }
              "~" { Def.mul y zero } "by" { fractionMulRespects y y z zero
                (fractionEqRefl y) zZero }
              "~" { zero } "by" { fractionMulZeroRight y }} }
            "~" { Def.mul x z } "by" { fractionEqSym _ _
              (equiv_reason_terms!{fractionEqTrans { Def.mul x z }
                "~" { Def.mul x zero } "by" { fractionMulRespects x x z zero
                  (fractionEqRefl x) zZero }
                "~" { zero } "by" { fractionMulZeroRight x }}) }})}
      "rt:" {\fun (negative: lt z zero) =>
        leMulNegativeRight x y z negative xy}
    }
      nonpositive;

\definition nonnegativeOrNegative(x: Fraction): Logic.Or[Def.Le zero x, lt x zero] :=
  either!{
    {lt zero x} "or" {Logic.Or[FractionEq zero x, lt x zero]} "either" {Logic.Or[Def.Le zero x, lt x zero]}
    "lt:" {\fun (positive: lt zero x) =>
      Logic.Or[Def.Le zero x, lt x zero]::left (leOfLt zero x positive)}
    "rt:" {\fun (rest: Logic.Or[FractionEq zero x, lt x zero]) =>
      either!{
        {FractionEq zero x} "or" {lt x zero} "either" {Logic.Or[Def.Le zero x, lt x zero]}
        "lt:" {\fun (same: FractionEq zero x) =>
          Logic.Or[Def.Le zero x, lt x zero]::left (leOfEq zero x same)}
        "rt:" {\fun (negative: lt x zero) =>
          Logic.Or[Def.Le zero x, lt x zero]::right negative}
      }
        rest}
  }
    (FractionOrder.trichotomy zero x);

\definition leOfNotLtReverse(x, y: Fraction):
  Logic.Not (lt y x) ->
  Def.Le x y :=
  \fun (notReverse: Logic.Not (lt y x)) =>
    either!{
      {lt x y} "or" {Logic.Or[FractionEq x y, lt y x]} "either" {Def.Le x y}
      "lt:" {\fun (less: lt x y) => leOfLt x y less}
      "rt:" {\fun (rest: Logic.Or[FractionEq x y, lt y x]) =>
        either!{
          {FractionEq x y} "or" {lt y x} "either" {Def.Le x y}
          "lt:" {\fun (same: FractionEq x y) => leOfEq x y same}
          "rt:" {\fun (reverse: lt y x) =>
            Logic.falseElim (Def.Le x y) (notReverse reverse)}
        }
          rest}
    }
      (FractionOrder.trichotomy x y);

\definition productInteriorAbove(q, l, u, c, v, x, y: Fraction):
  Def.Le l x -> Def.Le x u -> Def.Le c y ->
  Def.Le y v -> lt q (Def.mul l c) -> lt q (Def.mul l v) ->
  lt q (Def.mul u c) -> lt q (Def.mul u v) ->
  lt q (Def.mul x y) :=
  \fun (lx: Def.Le l x) (xu: Def.Le x u) (cy: Def.Le c y) (yv: Def.Le y v) (qlc: lt q (Def.mul l c))
    (qlv: lt q (Def.mul l v)) (quc: lt q (Def.mul u c)) (quv: lt q (Def.mul u v)) =>
    either!{
      {Def.Le zero y} "or" {lt y zero} "either" {lt q (Def.mul x y)}
      "lt:" {\fun (yNonnegative: Def.Le zero y) =>
        \block {
          \let lyxy: Def.Le (Def.mul l y) (Def.mul x y) :=
            leMulNonnegativeRight l x y yNonnegative lx \then
          \return either!{
            {Def.Le zero l} "or" {lt l zero} "either" {lt q (Def.mul x y)}
            "lt:" {\fun (lNonnegative: Def.Le zero l) =>
              ltLeTrans q (Def.mul l c) (Def.mul x y) qlc
                (leTrans (Def.mul l c) (Def.mul l y) (Def.mul x y)
                  (leMulNonnegativeLeft l c y lNonnegative cy) lyxy)}
            "rt:" {\fun (lNegative: lt l zero) =>
              ltLeTrans q (Def.mul l v) (Def.mul x y) qlv
                (leTrans (Def.mul l v) (Def.mul l y) (Def.mul x y)
                  (leMulNegativeLeft l y v lNegative yv) lyxy)}
          }
            (nonnegativeOrNegative l)
        }}
      "rt:" {\fun (yNegative: lt y zero) =>
        \block {
          \let uyxy: Def.Le (Def.mul u y) (Def.mul x y) :=
            leMulNegativeRight x u y yNegative xu \then
          \return either!{
            {Def.Le zero u} "or" {lt u zero} "either" {lt q (Def.mul x y)}
            "lt:" {\fun (uNonnegative: Def.Le zero u) =>
              ltLeTrans q (Def.mul u c) (Def.mul x y) quc
                (leTrans (Def.mul u c) (Def.mul u y) (Def.mul x y)
                  (leMulNonnegativeLeft u c y uNonnegative cy) uyxy)}
            "rt:" {\fun (uNegative: lt u zero) =>
              ltLeTrans q (Def.mul u v) (Def.mul x y) quv
                (leTrans (Def.mul u v) (Def.mul u y) (Def.mul x y)
                  (leMulNegativeLeft u y v uNegative yv) uyxy)}
          }
            (nonnegativeOrNegative u)
        }}
    }
      (nonnegativeOrNegative y);

\definition zeroLtMulPositive(x, y: Fraction):
  lt zero x -> lt zero y ->
  lt zero (Def.mul x y) :=
  \fun (xPositive: _) (yPositive: _) =>
    FractionOrder.ltReplaceLeft (Def.mul zero y) zero (Def.mul x y)
      (fractionMulZeroLeft y)
      (ltMulPositiveRight zero x y yPositive xPositive);

\definition zeroLtMulNegative(x, y: Fraction):
  lt x zero -> lt y zero ->
  lt zero (Def.mul x y) :=
  \fun (xNegative: _) (yNegative: _) =>
    FractionOrder.ltReplaceLeft (Def.mul zero y) zero (Def.mul x y)
      (fractionMulZeroLeft y)
      (ltMulNegativeRight x zero y yNegative xNegative);

\definition mulLtZeroPositiveNegative(x, y: Fraction):
  lt zero x -> lt y zero ->
  lt (Def.mul x y) zero :=
  \fun (xPositive: _) (yNegative: _) =>
    FractionOrder.ltReplaceRight (Def.mul x y) (Def.mul x zero) zero
      (fractionMulZeroRight x)
      (ltMulPositiveLeft x y zero xPositive yNegative);

\definition mulLtZeroNegativePositive(x, y: Fraction):
  lt x zero -> lt zero y ->
  lt (Def.mul x y) zero :=
  \fun (xNegative: _) (yPositive: _) =>
    FractionOrder.ltReplaceRight (Def.mul x y) (Def.mul zero y) zero
      (fractionMulZeroLeft y)
      (ltMulPositiveRight x zero y yPositive xNegative);

\definition numeratorNonZeroOfZeroLt(x: Fraction):
  lt zero x ->
  NumeratorNonZero x :=
  \fun (positive: lt zero x) (numeratorZero: #numerator{x} = I.zeroInteger) =>
      FractionOrder.ltIrrefl zero
        (FractionOrder.ltReplaceRight zero x zero
          (fractionEqZeroOfNumerator x numeratorZero) positive);

\definition numeratorNonZeroOfLtZero(x: Fraction):
  lt x zero ->
  NumeratorNonZero x :=
  \fun (negative: lt x zero) (numeratorZero: #numerator{x} = I.zeroInteger) =>
      FractionOrder.ltIrrefl zero
        (FractionOrder.ltReplaceLeft x zero zero
          (fractionEqZeroOfNumerator x numeratorZero) negative);

\definition ltMulPositiveCancelLeft(z, x, y: Fraction):
  lt zero z -> lt (Def.mul z x) (Def.mul z y) ->
  lt x y :=
  \fun (positive: lt zero z) (scaled: lt (Def.mul z x) (Def.mul z y)) =>
    either!{
      {lt x y} "or" {Logic.Or[FractionEq x y, lt y x]} "either" {lt x y}
      "lt:" {\fun (xy: lt x y) => xy}
      "rt:" {\fun (rest: Logic.Or[FractionEq x y, lt y x]) =>
        either!{
          {FractionEq x y} "or" {lt y x} "either" {lt x y}
          "lt:" {\fun (same: FractionEq x y) =>
            Logic.falseElim (lt x y)
              (FractionOrder.ltIrrefl (Def.mul z x)
                (FractionOrder.ltReplaceRight
                  (Def.mul z x) (Def.mul z y) (Def.mul z x)
                  (fractionEqSym _ _
                    (fractionMulRespects z z x y
                      (fractionEqRefl z) same)) scaled))}
          "rt:" {\fun (yx: lt y x) =>
            Logic.falseElim (lt x y)
              (FractionOrder.ltIrrefl (Def.mul z x)
                (FractionOrder.ltTrans (Def.mul z x) (Def.mul z y) (Def.mul z x)
                  scaled (ltMulPositiveLeft z y x positive yx)))}
        }
          rest}
    }
      (FractionOrder.trichotomy x y);

\definition positiveOfPositiveProductOne(b, r: Fraction):
  lt zero b -> FractionEq (Def.mul b r) one ->
  lt zero r :=
  \fun (positive: lt zero b) (law: FractionEq (Def.mul b r) one) =>
    either!{
      {lt zero r} "or" {Logic.Or[FractionEq zero r, lt r zero]} "either" {lt zero r}
      "lt:" {\fun (result: lt zero r) => result}
      "rt:" {\fun (rest: Logic.Or[FractionEq zero r, lt r zero]) =>
        either!{
          {FractionEq zero r} "or" {lt r zero} "either" {lt zero r}
          "lt:" {\fun (zeroR: FractionEq zero r) =>
            Logic.falseElim (lt zero r)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltReplaceRight zero one zero
                  (equiv_reason_terms!{fractionEqTrans { one }
                    "~" { Def.mul b r } "by" { fractionEqSym _ _ law }
                    "~" { Def.mul b zero } "by" { fractionMulRespects b b r zero
                      (fractionEqRefl b) (fractionEqSym _ _ zeroR) }
                    "~" { zero } "by" { fractionMulZeroRight b }})
                  FractionOrder.zeroLtOne))}
          "rt:" {\fun (negative: lt r zero) =>
            Logic.falseElim (lt zero r)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltTrans zero one zero FractionOrder.zeroLtOne
                  (FractionOrder.ltReplaceLeft (Def.mul b r) one zero law
                    (mulLtZeroPositiveNegative b r positive negative))))}
        }
          rest}
    }
      (FractionOrder.trichotomy zero r);

\definition negativeOfNegativeProductOne(b, r: Fraction):
  lt b zero -> FractionEq (Def.mul b r) one ->
  lt r zero :=
  \fun (negative: lt b zero) (law: FractionEq (Def.mul b r) one) =>
    either!{
      {lt r zero} "or" {Logic.Or[FractionEq r zero, lt zero r]} "either" {lt r zero}
      "lt:" {\fun (result: lt r zero) => result}
      "rt:" {\fun (rest: Logic.Or[FractionEq r zero, lt zero r]) =>
        either!{
          {FractionEq r zero} "or" {lt zero r} "either" {lt r zero}
          "lt:" {\fun (rZero: FractionEq r zero) =>
            Logic.falseElim (lt r zero)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltReplaceRight zero one zero
                  (equiv_reason_terms!{fractionEqTrans { one }
                    "~" { Def.mul b r } "by" { fractionEqSym _ _ law }
                    "~" { Def.mul b zero } "by" { fractionMulRespects b b r zero
                      (fractionEqRefl b) rZero }
                    "~" { zero } "by" { fractionMulZeroRight b }})
                  FractionOrder.zeroLtOne))}
          "rt:" {\fun (positive: lt zero r) =>
            Logic.falseElim (lt r zero)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltTrans zero one zero FractionOrder.zeroLtOne
                  (FractionOrder.ltReplaceLeft (Def.mul b r) one zero law
                    (mulLtZeroNegativePositive b r negative positive))))}
        }
          rest}
    }
      (FractionOrder.trichotomy r zero);

\definition positiveRightOfPositiveProduct(a, b: Fraction):
  lt zero a -> lt zero (Def.mul a b) ->
  lt zero b :=
  \fun (aPositive: lt zero a) (productPositive: lt zero (Def.mul a b)) =>
    either!{
      {lt zero b} "or" {Logic.Or[FractionEq zero b, lt b zero]} "either" {lt zero b}
      "lt:" {\fun (positive: lt zero b) => positive}
      "rt:" {\fun (rest: Logic.Or[FractionEq zero b, lt b zero]) =>
        either!{
          {FractionEq zero b} "or" {lt b zero} "either" {lt zero b}
          "lt:" {\fun (zeroB: FractionEq zero b) =>
            Logic.falseElim (lt zero b)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltReplaceRight zero (Def.mul a b) zero
                  (equiv_reason_terms!{fractionEqTrans { Def.mul a b }
                    "~" { Def.mul a zero } "by" { fractionMulRespects a a b zero
                      (fractionEqRefl a) (fractionEqSym _ _ zeroB) }
                    "~" { zero } "by" { fractionMulZeroRight a }}) productPositive))}
          "rt:" {\fun (negative: lt b zero) =>
            Logic.falseElim (lt zero b)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltTrans zero (Def.mul a b) zero productPositive
                  (mulLtZeroPositiveNegative a b aPositive negative)))}
        }
          rest}
    }
      (FractionOrder.trichotomy zero b);

\definition negativeRightOfPositiveProduct(a, b: Fraction):
  lt a zero -> lt zero (Def.mul a b) ->
  lt b zero :=
  \fun (aNegative: lt a zero) (productPositive: lt zero (Def.mul a b)) =>
    either!{
      {lt b zero} "or" {Logic.Or[FractionEq b zero, lt zero b]} "either" {lt b zero}
      "lt:" {\fun (negative: lt b zero) => negative}
      "rt:" {\fun (rest: Logic.Or[FractionEq b zero, lt zero b]) =>
        either!{
          {FractionEq b zero} "or" {lt zero b} "either" {lt b zero}
          "lt:" {\fun (bZero: FractionEq b zero) =>
            Logic.falseElim (lt b zero)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltReplaceRight zero (Def.mul a b) zero
                  (equiv_reason_terms!{fractionEqTrans { Def.mul a b }
                    "~" { Def.mul a zero } "by" { fractionMulRespects a a b zero
                      (fractionEqRefl a) bZero }
                    "~" { zero } "by" { fractionMulZeroRight a }}) productPositive))}
          "rt:" {\fun (positive: lt zero b) =>
            Logic.falseElim (lt b zero)
              (FractionOrder.ltIrrefl zero
                (FractionOrder.ltTrans zero (Def.mul a b) zero productPositive
                  (mulLtZeroNegativePositive a b aNegative positive)))}
        }
          rest}
    }
      (FractionOrder.trichotomy b zero);

\definition reciprocalOrderPositive(a, b, r, s: Fraction):
  lt zero a -> lt a b -> FractionEq (Def.mul b r) one ->
  FractionEq (Def.mul a s) one ->
  lt r s :=
  \block {
    \fun (aPositive: lt zero a) (ab: lt a b) (br: FractionEq (Def.mul b r) one)
      (as: FractionEq (Def.mul a s) one) \then
    \let rPositive: lt zero r :=
      positiveOfPositiveProductOne b r
        (FractionOrder.ltTrans zero a b aPositive ab) br \then
    \let arbr: lt (Def.mul a r) (Def.mul b r) :=
      ltMulPositiveRight a b r rPositive ab \then
    \let arOne: lt (Def.mul a r) one :=
      FractionOrder.ltReplaceRight (Def.mul a r) (Def.mul b r) one br arbr \then
    \let ars: lt (Def.mul a r) (Def.mul a s) :=
      FractionOrder.ltReplaceRight (Def.mul a r) one (Def.mul a s)
        (fractionEqSym _ _ as) arOne \then
    \return ltMulPositiveCancelLeft a r s aPositive ars
  };

\definition contractingFactor(q, c: Fraction):
  lt q c ->
  Def.ContractingFactor q c :=
  \block {
    \fun (qc: lt q c) \then
    \let half: Fraction := Def.midpoint zero one \then
    \let halfPositive: lt zero half := ltMidpoint zero one FractionOrder.zeroLtOne \then
    \let halfBelowOne: lt half one := midpointLt zero one FractionOrder.zeroLtOne \then
    \return either!{
      {lt zero c} "or" {Logic.Or[FractionEq zero c, lt c zero]} "either" {Def.ContractingFactor q c}
      "lt:" {\fun (cPositive: lt zero c) =>
        either!{
          {lt zero q} "or" {Logic.Or[FractionEq zero q, lt q zero]} "either" {Def.ContractingFactor q c}
          "lt:" {\fun (qPositive: lt zero q) =>
            \block {
              \let r: Fraction := Def.reciprocal c \then
              \let law: FractionEq (Def.mul c r) one :=
                fractionMulReciprocal c
                  (numeratorNonZeroOfZeroLt c cPositive) \then
              \let rPositive: lt zero r :=
                positiveOfPositiveProductOne c r cPositive law \then
              \let qrOne: lt (Def.mul q r) one :=
                FractionOrder.ltReplaceRight (Def.mul q r) (Def.mul c r) one law
                  (ltMulPositiveRight q c r rPositive qc) \then
              \let a: Fraction := Def.midpoint (Def.mul q r) one \then
              \let qra: lt (Def.mul q r) a :=
                ltMidpoint (Def.mul q r) one qrOne \then
              \let aOne: lt a one := midpointLt (Def.mul q r) one qrOne \then
              \let qrPositive: lt zero (Def.mul q r) :=
                zeroLtMulPositive q r qPositive rPositive \then
              \let aPositive: lt zero a :=
                FractionOrder.ltTrans zero (Def.mul q r) a qrPositive qra \then
              \let leftEq: FractionEq (Def.mul (Def.mul q r) c) q :=
                equiv_reason_terms!{fractionEqTrans { Def.mul (Def.mul q r) c }
                  "~" { Def.mul q (Def.mul r c) } "by" { fractionMulAssoc q r c }
                  "~" { Def.mul q one } "by" { fractionMulRespects q q (Def.mul r c) one
                    (fractionEqRefl q)
                    (equiv_reason_terms!{fractionEqTrans { Def.mul r c }
                      "~" { Def.mul c r } "by" { fractionMulComm r c }
                      "~" { one } "by" { law }}) }
                  "~" { q } "by" { fractionMulOneRight q }} \then
              \let qac: lt q (Def.mul a c) :=
                FractionOrder.ltReplaceLeft (Def.mul (Def.mul q r) c) q
                  (Def.mul a c) leftEq
                  (ltMulPositiveRight (Def.mul q r) a c cPositive qra) \then
              \return \exact(
                \into[Fraction](a, { a : Fraction \where Def.ContractingFactorLaw[q, c, a] }) \by { Def.ContractingFactorLaw[q, c, a]::# aPositive aOne qac },
                \Cast[Fraction] ({ a : Fraction \where Def.ContractingFactorLaw[q, c, a] }))
            }}
          "rt:" {\fun (restQ: Logic.Or[FractionEq zero q, lt q zero]) =>
            \block {
              \let productPositive: lt zero (Def.mul half c) :=
                zeroLtMulPositive half c halfPositive cPositive \then
              \let qProduct: lt q (Def.mul half c) :=
                either!{
                  {FractionEq zero q} "or" {lt q zero} "either" {lt q (Def.mul half c)}
                  "lt:" {\fun (zeroQ: FractionEq zero q) =>
                    FractionOrder.ltReplaceLeft zero q (Def.mul half c)
                      zeroQ productPositive}
                  "rt:" {\fun (qNegative: lt q zero) =>
                    FractionOrder.ltTrans q zero (Def.mul half c)
                      qNegative productPositive}
                }
                  restQ \then
              \return \exact(
                \into[Fraction](half, { a : Fraction \where Def.ContractingFactorLaw[q, c, a] }) \by { Def.ContractingFactorLaw[q, c, half]::# halfPositive halfBelowOne qProduct },
                \Cast[Fraction] ({ a : Fraction \where Def.ContractingFactorLaw[q, c, a] }))
            }}
        }
          (FractionOrder.trichotomy zero q)}
      "rt:" {\fun (restC: Logic.Or[FractionEq zero c, lt c zero]) =>
        either!{
          {FractionEq zero c} "or" {lt c zero} "either" {Def.ContractingFactor q c}
          "lt:" {\fun (zeroC: FractionEq zero c) =>
            \block {
              \let qZero: lt q zero :=
                FractionOrder.ltReplaceRight q c zero
                  (fractionEqSym _ _ zeroC) qc \then
              \let halfCZero: FractionEq (Def.mul half c) zero :=
                equiv_reason_terms!{fractionEqTrans { Def.mul half c }
                  "~" { Def.mul half zero } "by" { fractionMulRespects half half c zero
                    (fractionEqRefl half)
                    (fractionEqSym _ _ zeroC) }
                  "~" { zero } "by" { fractionMulZeroRight half }} \then
              \let qProduct: lt q (Def.mul half c) :=
                FractionOrder.ltReplaceRight q zero (Def.mul half c)
                  (fractionEqSym _ _ halfCZero) qZero \then
              \return \exact(
                \into[Fraction](half, { a : Fraction \where Def.ContractingFactorLaw[q, c, a] }) \by { Def.ContractingFactorLaw[q, c, half]::# halfPositive halfBelowOne qProduct },
                \Cast[Fraction] ({ a : Fraction \where Def.ContractingFactorLaw[q, c, a] }))
            }}
          "rt:" {\fun (cNegative: lt c zero) =>
            \block {
              \let cHalf: lt c (Def.mul half c) :=
                FractionOrder.ltRespects
                  (Def.mul c one) c (Def.mul c half) (Def.mul half c)
                  (fractionMulOneRight c) (fractionMulComm c half)
                  (ltMulNegativeLeft c half one cNegative halfBelowOne) \then
              \let qProduct: lt q (Def.mul half c) :=
                FractionOrder.ltTrans q c (Def.mul half c) qc cHalf \then
              \return \exact(
                \into[Fraction](half, { a : Fraction \where Def.ContractingFactorLaw[q, c, a] }) \by { Def.ContractingFactorLaw[q, c, half]::# halfPositive halfBelowOne qProduct },
                \Cast[Fraction] ({ a : Fraction \where Def.ContractingFactorLaw[q, c, a] }))
            }}
        }
          restC}
    }
      (FractionOrder.trichotomy zero c)
  };

\definition smallNegativeProduct(q, u: Fraction):
  lt q zero -> lt zero u ->
  Def.SmallNegativeProduct q u :=
  \block {
    \fun (qNegative: lt q zero) (uPositive: lt zero u) \then
    \let half: Fraction := Def.midpoint zero one \then
    \let halfPositive: lt zero half :=
      ltMidpoint zero one FractionOrder.zeroLtOne \then
    \let halfBelowOne: lt half one :=
      midpointLt zero one FractionOrder.zeroLtOne \then
    \let t: Fraction := Def.neg q \then
    \let tPositive: lt zero t := ltNegReverse q zero qNegative \then
    \let r: Fraction := Def.reciprocal u \then
    \let law: FractionEq (Def.mul u r) one :=
      fractionMulReciprocal u (numeratorNonZeroOfZeroLt u uPositive) \then
    \let rPositive: lt zero r :=
      positiveOfPositiveProductOne u r uPositive law \then
    \let halfT: Fraction := Def.mul half t \then
    \let halfTPositive: lt zero halfT :=
      zeroLtMulPositive half t halfPositive tPositive \then
    \let e: Fraction := Def.mul halfT r \then
    \let ePositive: lt zero e :=
      zeroLtMulPositive halfT r halfTPositive rPositive \then
    \let euEq: FractionEq (Def.mul e u) halfT :=
      equiv_reason_terms!{fractionEqTrans { Def.mul (Def.mul halfT r) u }
        "~" { Def.mul halfT (Def.mul r u) } "by" { fractionMulAssoc halfT r u }
        "~" { Def.mul halfT one } "by" { fractionMulRespects halfT halfT (Def.mul r u) one
          (fractionEqRefl halfT)
          (equiv_reason_terms!{fractionEqTrans { Def.mul r u }
            "~" { Def.mul u r } "by" { fractionMulComm r u }
            "~" { one } "by" { law }}) }
        "~" { halfT } "by" { fractionMulOneRight halfT }} \then
    \let halfTLtT: lt halfT t :=
      FractionOrder.ltReplaceRight (Def.mul half t) (Def.mul one t) t
        (fractionMulOneLeft t)
        (ltMulPositiveRight half one t tPositive halfBelowOne) \then
    \let euLtT: lt (Def.mul e u) t :=
      FractionOrder.ltReplaceLeft halfT (Def.mul e u) t
        (fractionEqSym _ _ euEq) halfTLtT \then
    \let negated: lt (Def.neg t) (Def.neg (Def.mul e u)) :=
      ltNegReverse (Def.mul e u) t euLtT \then
    \let result: lt q (Def.mul (Def.neg e) u) :=
      FractionOrder.ltRespects
        (Def.neg t) q (Def.neg (Def.mul e u)) (Def.mul (Def.neg e) u)
        (fractionNegInvolutive q)
        (fractionEqSym _ _ (fractionMulNegLeft e u)) negated \then
    \return \exact(
      \into[Fraction](e, { e : Fraction \where Logic.And[lt zero e, lt q (Def.mul (Def.neg e) u)] }) \by { Logic.And[lt zero e, lt q (Def.mul (Def.neg e) u)]::# ePositive result },
      \Cast[Fraction] ({ e : Fraction \where Logic.And[lt zero e, lt q (Def.mul (Def.neg e) u)] }))
  };

\definition fractionMulNegBoth(x, y: Fraction):
  FractionEq (Def.mul (Def.neg x) (Def.neg y)) (Def.mul x y) :=
  equiv_reason!{fractionEqTrans
    "by" { fractionMulNegLeft x (Def.neg y) }
    "by" { fractionNegRespects (Def.mul x (Def.neg y)) (Def.neg (Def.mul x y))
      (fractionMulNegRight x y) }
    "by" { fractionNegInvolutive (Def.mul x y) }};

\definition fractionAddSubRight(x, y: Fraction): FractionEq (Def.add x (Def.sub y x)) y :=
  equiv_reason!{fractionEqTrans
    "by" { fractionEqSym _ _ (fractionAddAssoc x y (Def.neg x)) }
    "by" { fractionAddRespects (Def.add x y) (Def.add y x) (Def.neg x) (Def.neg x)
      (fractionAddComm x y) (fractionEqRefl (Def.neg x)) }
    "by" { fractionAddAssoc y x (Def.neg x) }
    "by" { fractionAddRespects y y (Def.add x (Def.neg x)) zero
      (fractionEqRefl y) (fractionAddNegRight x) }
    "by" { fractionAddZeroRight y }};

\definition midpointGapsEqual(x, y: Fraction):
  FractionEq
    (Def.sub (Def.midpoint x y) x)
    (Def.sub y (Def.midpoint x y)) :=
  \block {
    \let m: Fraction := Def.midpoint x y \then
    \let gap: Fraction := Def.sub y m \then
    \let decomposition: FractionEq (Def.add x gap) m :=
      equiv_reason!{fractionEqTrans
        "by" { fractionEqSym _ _ (fractionAddAssoc x y (Def.neg m)) }
        "by" { fractionAddRespects (Def.add x y) (Def.add m m)
          (Def.neg m) (Def.neg m)
          (fractionEqSym _ _ (midpointDouble x y))
          (fractionEqRefl _) }
        "by" { fractionAddCancelRightSimplify m m }} \then
    \return equiv_reason!{fractionEqTrans
      "by" { fractionAddRespects m (Def.add x gap)
        (Def.neg x) (Def.neg x)
        (fractionEqSym _ _ decomposition) (fractionEqRefl _) }
      "by" { fractionAddRespects (Def.add x gap) (Def.add gap x)
        (Def.neg x) (Def.neg x)
        (fractionAddComm x gap) (fractionEqRefl _) }
      "by" { fractionAddCancelRightSimplify gap x }}
  };

\definition fractionSubCombine(x, m, y: Fraction):
  FractionEq (Def.add (Def.sub m x) (Def.sub y m)) (Def.sub y x) :=
  equiv_reason!{fractionEqTrans
    "by" { fractionAddComm (Def.sub m x) (Def.sub y m) }
    "by" { fractionEqSym _ _
      (fractionAddAssoc (Def.sub y m) m (Def.neg x)) }
    "by" { fractionAddRespects (Def.add (Def.sub y m) m)
      (Def.add m (Def.sub y m))
      (Def.neg x) (Def.neg x)
      (fractionAddComm (Def.sub y m) m) (fractionEqRefl _) }
    "by" { fractionAddRespects (Def.add m (Def.sub y m)) y
      (Def.neg x) (Def.neg x)
      (fractionAddSubRight m y) (fractionEqRefl _) }};

\definition midpointWidthDouble(x, y: Fraction):
  FractionEq
    (Def.add (Def.sub (Def.midpoint x y) x)
      (Def.sub (Def.midpoint x y) x))
    (Def.sub y x) :=
  equiv_reason!{fractionEqTrans
    "by" { fractionAddRespects
      (Def.sub (Def.midpoint x y) x)
      (Def.sub (Def.midpoint x y) x)
      (Def.sub (Def.midpoint x y) x)
      (Def.sub y (Def.midpoint x y))
      (fractionEqRefl _) (midpointGapsEqual x y) }
    "by" { fractionSubCombine x (Def.midpoint x y) y }};

\definition fractionDoubleInjective(x, y: Fraction):
  FractionEq (Def.add x x) (Def.add y y) ->
  FractionEq x y :=
  \fun (same: FractionEq (Def.add x x) (Def.add y y)) =>
    either!{
      {lt x y} "or" {Logic.Or[FractionEq x y, lt y x]} "either" {FractionEq x y}
      "lt:" {\fun (xy: lt x y) =>
        Logic.falseElim (FractionEq x y)
          (FractionOrder.ltIrrefl (Def.add x x)
            (FractionOrder.ltReplaceRight
              (Def.add x x) (Def.add y y) (Def.add x x)
              (fractionEqSym _ _ same)
              (ltAdd x y x y xy xy)))}
      "rt:" {\fun (other: Logic.Or[FractionEq x y, lt y x]) =>
        either!{
          {FractionEq x y} "or" {lt y x} "either" {FractionEq x y}
          "lt:" {\fun (eq: FractionEq x y) => eq}
          "rt:" {\fun (yx: lt y x) =>
            Logic.falseElim (FractionEq x y)
              (FractionOrder.ltIrrefl (Def.add y y)
                (FractionOrder.ltReplaceRight
                  (Def.add y y) (Def.add x x) (Def.add y y)
                  same (ltAdd y x y x yx yx)))}
        }
          other}
    }
      (FractionOrder.trichotomy x y);

\definition subPositive(x, y: Fraction):
  lt x y ->
  lt zero (Def.sub y x) :=
  \fun (xy: _) =>
    FractionOrder.ltReplaceLeft (Def.add x (Def.neg x)) zero (Def.sub y x)
      (fractionAddNegRight x)
      (ltAddRight x y (Def.neg x) xy);

\definition ltAddCancelRightOrder(x, y, z: Fraction):
  lt (Def.add x z) (Def.add y z) ->
  lt x y :=
  \fun (same: _) =>
    FractionOrder.ltRespects
      (Def.add (Def.add x z) (Def.neg z)) x
      (Def.add (Def.add y z) (Def.neg z)) y
      (fractionAddCancelRightSimplify x z)
      (fractionAddCancelRightSimplify y z)
      (ltAddRight (Def.add x z) (Def.add y z) (Def.neg z) same);

\definition scaledBracketInterior(t, a, c, e: Fraction):
  lt t one -> lt a (Def.add c e) ->
  lt (Def.add (Def.mul t a) e) a ->
  lt (Def.mul t (Def.add c e)) c :=
  \block {
    \fun (tOne: lt t one) (aOutside: lt a (Def.add c e)) (base: lt (Def.add (Def.mul t a) e) a) \then
    \let d: Fraction := Def.add c e \then
    \let h: Fraction := Def.sub d a \then
    \let hPositive: lt zero h := subPositive a d aOutside \then
    \let ahd: FractionEq (Def.add a h) d := fractionAddSubRight a d \then
    \let thh: lt (Def.mul t h) h :=
      FractionOrder.ltReplaceRight (Def.mul t h) (Def.mul one h) h
        (fractionMulOneLeft h)
        (ltMulPositiveRight t one h hPositive tOne) \then
    \let left: FractionEq (Def.add (Def.mul t d) e)
        (Def.add (Def.add (Def.mul t a) e) (Def.mul t h)) :=
      equiv_reason!{fractionEqTrans
        "by" { fractionAddRespects (Def.mul t d) (Def.mul t (Def.add a h)) e e
          (fractionMulRespects t t d (Def.add a h)
            (fractionEqRefl t) (fractionEqSym _ _ ahd))
          (fractionEqRefl e) }
        "by" { fractionAddRespects (Def.mul t (Def.add a h))
          (Def.add (Def.mul t a) (Def.mul t h)) e e
          (fractionMulAddLeft t a h) (fractionEqRefl e) }
        "by" { fractionAddRotate (Def.mul t a) (Def.mul t h) e }} \then
    \let withE: lt (Def.add (Def.mul t d) e) d :=
      FractionOrder.ltReplaceRight (Def.add (Def.mul t d) e) (Def.add a h) d ahd
        (FractionOrder.ltReplaceLeft
          (Def.add (Def.add (Def.mul t a) e) (Def.mul t h))
          (Def.add (Def.mul t d) e) (Def.add a h)
          (fractionEqSym _ _ left)
          (ltAdd (Def.add (Def.mul t a) e) a (Def.mul t h) h base thh)) \then
    \return ltAddCancelRightOrder (Def.mul t d) c e withE
  };
