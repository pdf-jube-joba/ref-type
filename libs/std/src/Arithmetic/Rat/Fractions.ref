/*
 * A fraction stores a numerator and the predecessor of a positive natural
 * denominator.  Thus every denominator is nonzero by construction and the
 * arithmetic operations below need no multiplicative-closure parameter.
 */

\structure Fraction: \Set := {
  numerator: I.Integer,
  denominatorIndex: I.Nat,
};

\definition denominator[x: Fraction]: I.Integer :=
    I.integer (I.natSucc (x.denominatorIndex)) I.zeroNat;

\definition denominatorPositive[x: Fraction]: I.IntegerLt I.zeroInteger (denominator x) :=
  IntegerOrder.zeroLtNaturalSucc (x.denominatorIndex);

\definition mulIntegerDenominator[x: I.Integer] [d: I.Nat]:
  I.mulInteger x (I.integer (I.natSucc d) I.zeroNat) =
      I.scaleInteger x (I.natSucc d) :=
    I.mulIntegerNatural x (I.natSucc d);

/* (d + 1)(e + 1) = (de + d + e) + 1. */
\definition denominatorProductIndex[d, e: I.Nat]: I.Nat := NatOp.add (NatOp.add (NatOp.mul d e) d) e;

\definition denominatorProductIndexZeroRight[d: I.Nat]: denominatorProductIndex d I.zeroNat = d :=
    trans_reason!{trans!{I.Nat}
      "by" { congr!{I.Nat I.Nat}
        (\fun (p: I.Nat) => NatOp.add (NatOp.add p d) I.zeroNat)
        _ _ (NL.mulZeroRight d) }
      "by" { congr!{I.Nat I.Nat}
        (\fun (s: I.Nat) => NatOp.add s I.zeroNat)
        _ _ (NL.addZeroLeft d) }
      "by" { NL.addZeroRight d }};

\definition denominatorProductIndexZeroLeft[d: I.Nat]: denominatorProductIndex I.zeroNat d = d :=
    trans_reason!{trans!{I.Nat}
      "by" { congr!{I.Nat I.Nat}
        (\fun (p: I.Nat) => NatOp.add (NatOp.add p I.zeroNat) d)
        _ _ (NL.mulZeroLeft d) }
      "by" { congr!{I.Nat I.Nat}
        (\fun (s: I.Nat) => NatOp.add s d)
        _ _ (NL.addZeroRight I.zeroNat) }
      "by" { NL.addZeroLeft d }};

\definition denominatorProductIndexComm[d, e: I.Nat]:
  denominatorProductIndex d e = denominatorProductIndex e d :=
    trans_reason!{trans!{I.Nat}
      "by" { congr!{I.Nat I.Nat}
        (\fun (p: I.Nat) => NatOp.add (NatOp.add p d) e)
        _ _ (NL.mulComm d e) }
      "by" { congr!{I.Nat I.Nat}
        (\fun (tail: I.Nat) =>
          NatOp.add (NatOp.add (NatOp.mul e d) d) tail)
        _ _ (sym!{I.Nat} _ _ (NL.addZeroLeft e)) }
      "by" { I.integerAddShuffle
        (NatOp.mul e d) d I.zeroNat e }
      "by" { congr!{I.Nat I.Nat}
        (\fun (tail: I.Nat) =>
          NatOp.add (NatOp.add (NatOp.mul e d) e) tail)
        _ _ (NL.addZeroLeft d) }};

\definition denominatorProductIndexSucc[d, e: I.Nat]:
  I.natSucc (denominatorProductIndex d e) =
      NatOp.mul (I.natSucc d) (I.natSucc e) :=
    trans!{I.Nat} _ _ _
      (congr!{I.Nat I.Nat} I.natSucc _ _
        (trans_reason!{trans!{I.Nat}
          "by" { NL.addComm
            (NatOp.add (NatOp.mul d e) d) e }
          "by" { congr!{I.Nat I.Nat}
            (NatOp.add e) _ _ (NL.addComm (NatOp.mul d e) d) }
          "by" { congr!{I.Nat I.Nat}
            (NatOp.add e) _ _
            (sym!{I.Nat} _ _ (NL.mulSuccRight d e)) }}))
      (sym!{I.Nat} _ _ (NL.mulSuccSucc d e));

\definition zero: Fraction := Fraction::# I.zeroInteger I.zeroNat;

\definition one: Fraction := Fraction::# I.oneInteger I.zeroNat;

\definition lt[x, y: Fraction]: \Prop :=
    I.IntegerLt
      (I.mulInteger (x.numerator) (denominator y))
      (I.mulInteger (y.numerator) (denominator x));

/* Equality before quotienting is equality after cross multiplication. */
\definition FractionEq[x, y: Fraction]: \Prop :=
    I.mulInteger (x.numerator) (denominator y) =
      I.mulInteger (y.numerator) (denominator x);

\definition fractionEqRefl[x: Fraction]: FractionEq x x :=
    \refl(I.mulInteger (x.numerator) (denominator x));

\definition fractionEqSameIndex[n, m: I.Integer] [d: I.Nat]:
  n = m ->
  FractionEq (Fraction::# n d) (Fraction::# m d) :=
    \fun (nm: _) =>
    I.mulIntegerRespects
        n m
        (I.integer (I.natSucc d) I.zeroNat)
        (I.integer (I.natSucc d) I.zeroNat)
        nm
        (\refl(I.integer (I.natSucc d) I.zeroNat));

\definition fractionEqOfParts[n, m: I.Integer] [d, e: I.Nat]:
  n = m -> d = e ->
  FractionEq (Fraction::# n d) (Fraction::# m e) :=
    \fun (nm: n = m) (de: d = e) =>
    (\idelim d = e
        \with k: I.Nat =>
          n = m ->
          FractionEq (Fraction::# n d) (Fraction::# m k)
        \by { base: fractionEqSameIndex n m d, equality: de }) nm;

\definition fractionEqSym[x, y: Fraction]:
  FractionEq x y ->
  FractionEq y x :=
    sym!{I.Integer}
      _ _;

\definition fractionEqAsScales[x, y: Fraction]:
  FractionEq x y ->
  I.scaleInteger (x.numerator) (I.natSucc (y.denominatorIndex)) =
      I.scaleInteger (y.numerator) (I.natSucc (x.denominatorIndex)) :=
    \fun (xy: FractionEq x y) =>
    trans_reason_terms!{trans!{I.Integer} { I.scaleInteger (x.numerator) (I.natSucc (y.denominatorIndex)) }
        "~" { I.mulInteger (x.numerator) (denominator y) } "by" { sym!{I.Integer}
          _ _
          (mulIntegerDenominator (x.numerator) (y.denominatorIndex)) }
        "~" { I.mulInteger (y.numerator) (denominator x) } "by" { xy }
        "~" { I.scaleInteger (y.numerator) (I.natSucc (x.denominatorIndex)) } "by" { mulIntegerDenominator (y.numerator) (x.denominatorIndex) }};

\definition fractionEqTrans[x, y, z: Fraction]:
  FractionEq x y -> FractionEq y z ->
  FractionEq x z :=

    \fun (xy: FractionEq x y) (yz: FractionEq y z) =>
    trans_reason_terms!{trans!{I.Integer} { I.mulInteger (x.numerator) (denominator z) }
        "~" { I.scaleInteger (x.numerator) (I.natSucc (z.denominatorIndex)) } "by" { mulIntegerDenominator (x.numerator) (z.denominatorIndex) }
        "~" { I.scaleInteger (z.numerator) (I.natSucc (x.denominatorIndex)) } "by" { I.scaleIntegerCancelPositive
          (I.scaleInteger (x.numerator) (I.natSucc (z.denominatorIndex)))
          (I.scaleInteger (z.numerator) (I.natSucc (x.denominatorIndex)))
          (y.denominatorIndex)
          (trans_reason_terms!{trans!{I.Integer} { I.scaleInteger
              (I.scaleInteger (x.numerator) (I.natSucc (z.denominatorIndex)))
              (I.natSucc (y.denominatorIndex)) }
            "~" { I.scaleInteger
              (I.scaleInteger (x.numerator) (I.natSucc (y.denominatorIndex)))
              (I.natSucc (z.denominatorIndex)) } "by" { I.scaleIntegerSwap (x.numerator)
              (I.natSucc (z.denominatorIndex))
              (I.natSucc (y.denominatorIndex)) }
            "~" { I.scaleInteger
                (I.scaleInteger (y.numerator) (I.natSucc (x.denominatorIndex)))
                (I.natSucc (z.denominatorIndex)) } "by" { I.scaleIntegerRespects _ _ _ (fractionEqAsScales x y xy) }
            "~" { I.scaleInteger
                  (I.scaleInteger (y.numerator) (I.natSucc (z.denominatorIndex)))
                  (I.natSucc (x.denominatorIndex)) } "by" { I.scaleIntegerSwap (y.numerator)
              (I.natSucc (x.denominatorIndex))
              (I.natSucc (z.denominatorIndex)) }
            "~" { I.scaleInteger
                    (I.scaleInteger (z.numerator) (I.natSucc (y.denominatorIndex)))
                    (I.natSucc (x.denominatorIndex)) } "by" { I.scaleIntegerRespects _ _ _ (fractionEqAsScales y z yz) }
            "~" { I.scaleInteger
              (I.scaleInteger (z.numerator) (I.natSucc (x.denominatorIndex)))
              (I.natSucc (y.denominatorIndex)) } "by" { I.scaleIntegerSwap (z.numerator)
              (I.natSucc (y.denominatorIndex))
              (I.natSucc (x.denominatorIndex)) }}) }
        "~" { I.mulInteger (z.numerator) (denominator x) } "by" { sym!{I.Integer}
          _ _
          (mulIntegerDenominator (z.numerator) (x.denominatorIndex)) }};

\definition NumeratorNonZero[x: Fraction]: \Prop := I.IntegerNonZero (x.numerator);

\definition fractionEqZeroOfNumerator[x: Fraction]:
  x.numerator = I.zeroInteger ->
  FractionEq x zero :=
    \fun (numeratorZero: x.numerator = I.zeroInteger) =>
    trans_reason_terms!{trans!{I.Integer} { I.mulInteger (x.numerator) (denominator zero) }
        "~" { x.numerator } "by" { I.mulIntegerOneRight (x.numerator) }
        "~" { I.zeroInteger } "by" { numeratorZero }
        "~" { I.mulInteger I.zeroInteger (denominator x) } "by" { sym!{I.Integer}
          _ _
          (I.mulIntegerZeroLeft (denominator x)) }};

\definition numeratorNonZeroRespects[x, y: Fraction]:
  FractionEq x y -> NumeratorNonZero x ->
  NumeratorNonZero y :=

  \fun (xy: FractionEq x y) (xNonZero: NumeratorNonZero x) (yZero: y.numerator = I.zeroInteger) =>
      xNonZero
        (I.scaleIntegerCancelPositive
          (x.numerator) I.zeroInteger (y.denominatorIndex)
          (trans_reason_terms!{trans!{I.Integer} { I.scaleInteger
              (x.numerator) (I.natSucc (y.denominatorIndex)) }
            "~" { I.scaleInteger
              (y.numerator) (I.natSucc (x.denominatorIndex)) } "by" { fractionEqAsScales x y xy }
            "~" { I.zeroInteger } "by" { trans_reason_terms!{trans!{I.Integer} { I.scaleInteger
                (y.numerator) (I.natSucc (x.denominatorIndex)) }
              "~" { I.scaleInteger
                I.zeroInteger (I.natSucc (x.denominatorIndex)) } "by" { I.scaleIntegerRespects
                (y.numerator) I.zeroInteger
                (I.natSucc (x.denominatorIndex)) yZero }
              "~" { I.zeroInteger } "by" { I.scaleIntegerZero
                (I.natSucc (x.denominatorIndex)) }} }
            "~" { I.scaleInteger
              I.zeroInteger (I.natSucc (y.denominatorIndex)) } "by" { sym!{I.Integer}
              _ _
              (I.scaleIntegerZero
                (I.natSucc (y.denominatorIndex))) }}));

\module Order;
\module Arithmetic;
\module Quotient;
