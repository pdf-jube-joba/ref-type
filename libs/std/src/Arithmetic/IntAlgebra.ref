/* Algebraic structures carried by the concrete integer implementation. */
\import std.Arithmetic[].Int[] \as I;
\import I.Math[] \as IM;
\import IM.Specification[] \as Specification;
\import Specification.Def[] \as IS;
\import Specification.Prop[] \as IL;
\import std.Alg[].Alg[] \as A;
\import std.Alg[].Monoid[] \as M;

\definition Int: \Set := I.Int^;
\definition Group: \Set := A.Group[I.Int^]::[Set];
\definition CommutativeGroup: \Set := A.CommutativeGroup[I.Int^]::[Set];

\definition additiveRaw: A.Group[I.Int^]::[Raw] :=
  A.Group[I.Int^]::[Raw]::# I.Zero::[set] I.Add::[set] I.Neg::[set];

\definition additiveGroupLaws: A.Group[I.Int^]::[Law][additiveRaw] :=
  A.Group[I.Int^]::[Law][additiveRaw] {
    monoid := M.Monoid[I.Int^]::[Law][A.groupMonoid I.Int^ additiveRaw] {
      leftIdentity := IL.addZeroLeft,
      rightIdentity := IL.addZeroRight,
      associative := IL.addAssoc,
    },
    leftInverse := IL.negInverse,
    rightInverse := IL.negInverseRight,
  };

\definition additiveGroup: A.Group[I.Int^]::[Set] :=
  \into[A.Group[I.Int^]::[Raw]](additiveRaw, A.Group[I.Int^]) \by { additiveGroupLaws };

\definition additiveCommutativeGroupLaws:
  A.CommutativeGroup[I.Int^]::[Law][A.CommutativeGroup[I.Int^]::[Raw]::# (additiveRaw)] :=
  A.CommutativeGroup[I.Int^]::[Law][A.CommutativeGroup[I.Int^]::[Raw]::# (additiveRaw)] {
    group := additiveGroupLaws,
    commutative := IL.addComm,
  };

\definition additiveCommutativeGroup: A.CommutativeGroup[I.Int^]::[Set] :=
  \into[A.CommutativeGroup[I.Int^]::[Raw]](A.CommutativeGroup[I.Int^]::[Raw]::# (additiveRaw), A.CommutativeGroup[I.Int^])
    \by { additiveCommutativeGroupLaws };
