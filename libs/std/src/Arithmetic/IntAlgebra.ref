/* Algebraic structures carried by the concrete integer implementation. */
\import std.Arithmetic[].Int[] \as I;
\import I.Math[].Specification[].Prop[] \as IL;
\import std.Alg[].Alg[] \as A;
\import std.Alg[].Monoid[] \as M;

\definition Int: \Set := I.Int^;
\definition Group: \Set := A.Group[I.Int^];
\definition CommutativeGroup: \Set := A.CommutativeGroup[I.Int^];

\definition additiveRaw: A.GroupData[I.Int^] :=
  A.GroupData[I.Int^]::# I.Zero.specification I.Add.specification I.Neg.specification;

\definition additiveGroupLaws: A.GroupLaws[I.Int^, additiveRaw] :=
  A.GroupLaws[I.Int^, additiveRaw] {
    monoid := M.MonoidLaws[I.Int^, A.groupMonoid I.Int^ additiveRaw] {
      leftIdentity := IL.addZeroLeft,
      rightIdentity := IL.addZeroRight,
      associative := IL.addAssoc,
    },
    leftInverse := IL.negInverse,
    rightInverse := IL.negInverseRight,
  };

\definition additiveGroup: A.Group[I.Int^] :=
  \into[A.GroupData[I.Int^]](additiveRaw, A.Group[I.Int^]) \by { additiveGroupLaws };

\definition additiveCommutativeGroupLaws:
  A.CommutativeGroupLaws[I.Int^, A.CommutativeGroupData[I.Int^]::# (additiveRaw)] :=
  A.CommutativeGroupLaws[I.Int^, A.CommutativeGroupData[I.Int^]::# (additiveRaw)] {
    group := additiveGroupLaws,
    commutative := IL.addComm,
  };

\definition additiveCommutativeGroup: A.CommutativeGroup[I.Int^] :=
  \into[A.CommutativeGroupData[I.Int^]](A.CommutativeGroupData[I.Int^]::# (additiveRaw), A.CommutativeGroup[I.Int^])
    \by { additiveCommutativeGroupLaws };
\module Ring;
\module Calculation;
\module IntegralDomain;
