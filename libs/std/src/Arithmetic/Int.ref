\import std.Program[] \as ProgramBundles;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;
\use Equality.congr2;
\use Equality.congr3;
\import std.Logic[].Equivalence[] \as Equivalence;
\use Equivalence.equiv_reason;
\use Equivalence.equiv_reason_terms;

/* Integers: Nat + Nat in Program, with negSucc n denoting -(n+1).
 * The mathematical carrier below is the Grothendieck quotient of (Nat,+,0).
 */
\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Basic[].Def[] \as NatOp;
\import std.Data[].Nat[].Parity[].Def[] \as NP;
\import std.Data[].Nat[].Basic[].Prop[] \as NL;
\import std.Data[].Bool[] \as B;
\import std.Logic[].Proposition[] \as L;
\use L.not;
\import std.Data[].Pair[] \as P;

/* Expose the imported instances, including Program constructor notation. */
\definition Nat: \Set := N.Nat^;
\definition Bool: \Set := B.Bool^;
\macro natZero() := N.Nat^::zero;
\macro natSucc($n) := N.Nat^::succ $n;
\macro boolTrue() := B.Bool^::true;
\macro boolFalse() := B.Bool^::false;

\inductive Int: \VType :=
| ofNat: N.Nat -> Int
| negSucc: N.Nat -> Int
;

\inductive DiffState: \VType := | running: N.Nat -> N.Nat -> DiffState;

\module DiffLoopImplementation {
  \definition State: \VType := DiffState;

  \definition Output: \VType := Int;

  \definition step: \U(State ~> \F(\RunStep[State, Output])) := \thunk(\cfun (state: DiffState) => \match state \in DiffState \with { | running a b :
      \match b \in N.Nat \with {
      | zero : \return(\finish[DiffState, Int](Int::ofNat a))
      | succ k : \match a \in N.Nat \with {
        | zero : \return(\finish[DiffState, Int](Int::negSucc k))
        | succ j : \return(\continue[DiffState, Int](DiffState::running j k))
        }
      }
    });

  \import std.Logic[].Termination[State := DiffState^, Output := Int^,
      step := step^] \as Termination;

  \definition terminates:
      \forall (b, a: N.Nat^) ->
      Termination.Holds (DiffState^::running a b) :=
      \induction (b: N.Nat^) \return \forall (a: N.Nat^) ->
        Termination.Holds (DiffState^::running a b) \with {
        | zero: \fun (a: N.Nat^) =>
          Termination.intro (DiffState^::running a N.Nat^::zero) Termination.trivial
        | succ: \fun (k: N.Nat^) (ih: _) =>
          \induction (a: N.Nat^) \return
            Termination.Holds (DiffState^::running a (N.Nat^::succ k)) \with {
            | zero: Termination.intro (DiffState^::running N.Nat^::zero (N.Nat^::succ k)) Termination.trivial
            | succ: \fun (j: N.Nat^) (_: _) =>
              Termination.intro (DiffState^::running (N.Nat^::succ j) (N.Nat^::succ k)) (ih j)
          }
      };

  \definition certificate: \forall (s: State^) -> ProgramBundles.Terminates State^ Output^ step^ s := \induction (state: DiffState^) \return
      Termination.Holds state \with {
        | running: \fun (a, b: N.Nat^) => terminates b a
      };
}
\import .DiffLoopImplementation[] \as DiffLoopParts;
\definition DiffLoop: ProgramBundles.Machine := ProgramBundles.Machine {
  State := DiffLoopParts.State,
  Output := DiffLoopParts.Output,
  step := DiffLoopParts.step,
  terminates := DiffLoopParts.certificate,
};
\definition DiffLoopRunbox: \Box[DiffLoop.State ~> \F(DiffLoop.Output)] := \box[DiffLoop.State ~> \F(DiffLoop.Output)](\force DiffLoop.run);

\module DiffImplementation {
  \definition T: \VType := \U((N.Nat -> (N.Nat -> Int)));

  \definition program: (N.Nat -> (N.Nat -> Int)) := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => (\force DiffLoop.run) (DiffState::running a b))));

  \definition specification: T^ := \fun (a, b: N.Nat^) =>
    \induction (b: N.Nat^) \return N.Nat^ -> Int^ \with {
      | zero : (\fun (a: N.Nat^) => Int^::ofNat a)
      | succ : (\fun (k: N.Nat^) => \fun (rec: N.Nat^ -> Int^) => \fun (a: N.Nat^) =>
        \induction (a: N.Nat^) \return Int^ \with {
          | zero : (Int^::negSucc k)
          | succ : (\fun (j: N.Nat^) => \fun (_: _) => rec j)
          } a)
      } b a;

  \definition matches: \forall (b, a: N.Nat^) -> program^ a b = specification a b :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> program^ a b = specification a b \with {
      | zero : (\induction (a: N.Nat^) \return program^ a N.Nat^::zero = specification a N.Nat^::zero \with {
        | zero : (\refl(Int^::ofNat N.Nat^::zero))
        | succ : (\fun (a: N.Nat^) => \fun (ih: program^ a N.Nat^::zero = specification a N.Nat^::zero) => \refl(Int^::ofNat (N.Nat^::succ
      a)))
        })
      | succ : (\fun (b: N.Nat^) => \fun (ih: \forall (a: N.Nat^) -> program^ a b = specification a b) =>
        \induction (a: N.Nat^) \return program^ a (N.Nat^::succ b) = specification a (N.Nat^::succ b) \with {
        | zero : (\refl(Int^::negSucc b))
        | succ : (\fun (a: N.Nat^) => \fun (unused: program^ a (N.Nat^::succ b) = specification a (N.Nat^::succ b)) => ih a)
        })
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: N.Nat^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: N.Nat^) => matches arg1 arg0));
}
\import .DiffImplementation[] \as DiffParts;
\definition Diff: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := DiffParts.T,
  program := \thunk (DiffParts.program),
  specification := DiffParts.specification,
  coherence := DiffParts.coherence,
};

/* A Set-only normal form, independent of Program reflection. */

\module PositiveImplementation {
  \definition T: \VType := \U((Int -> N.Nat));

  \definition program: (Int -> N.Nat) := (\cfun (z: Int) => \match z \in Int \with { | ofNat n : \return n | negSucc n : \return N.Nat::zero });

  \definition specification: T^ := \induction (z: Int^) \return N.Nat^ \with {
    | ofNat : (\fun (n: N.Nat^) => n)
    | negSucc : (\fun (n: N.Nat^) => N.Nat^::zero)
    };

  \definition matches: \forall (z: Int^) -> program^ z = specification z :=
    \induction (z: Int^) \return program^ z = specification z \with {
      | ofNat : (\fun (n: N.Nat^) => \refl(n))
      | negSucc : (\fun (n: N.Nat^) => \refl(N.Nat^::zero))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .PositiveImplementation[] \as PositiveParts;
\definition Positive: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PositiveParts.T,
  program := \thunk (PositiveParts.program),
  specification := PositiveParts.specification,
  coherence := PositiveParts.coherence,
};

\module NegativeImplementation {
  \definition T: \VType := \U((Int -> N.Nat));

  \definition program: (Int -> N.Nat) := (\cfun (z: Int) => \match z \in Int \with { | ofNat n : \return N.Nat::zero | negSucc n : \return(N.Nat::succ n) });

  \definition specification: T^ := \induction (z: Int^) \return N.Nat^ \with {
    | ofNat : (\fun (n: N.Nat^) => N.Nat^::zero)
    | negSucc : (\fun (n: N.Nat^) => N.Nat^::succ n)
    };

  \definition matches: \forall (z: Int^) -> program^ z = specification z :=
    \induction (z: Int^) \return program^ z = specification z \with {
      | ofNat : (\fun (n: N.Nat^) => \refl(N.Nat^::zero))
      | negSucc : (\fun (n: N.Nat^) => \refl(N.Nat^::succ n))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NegativeImplementation[] \as NegativeParts;
\definition Negative: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NegativeParts.T,
  program := \thunk (NegativeParts.program),
  specification := NegativeParts.specification,
  coherence := NegativeParts.coherence,
};

\definition diffCanonical:
  \forall (z: Int^) -> Diff.specification (Positive.specification z) (Negative.specification z) = z :=
  \induction (z: Int^) \return Diff.specification (Positive.specification z) (Negative.specification z) = z \with {
    | ofNat : (\fun (n: N.Nat^) => \refl(Int^::ofNat n))
    | negSucc : (\fun (n: N.Nat^) => \refl(Int^::negSucc n))
    };

/* Formal differences in the cancellative commutative monoid (Nat,+,0). */
\definition Difference: \Set := P.Times^[N.Nat^, N.Nat^];
\definition pair: N.Nat^ -> N.Nat^ -> Difference := P.pair N.Nat^ N.Nat^;
\definition pos: Difference -> N.Nat^ := P.first N.Nat^ N.Nat^;
\definition negPart: Difference -> N.Nat^ := P.second N.Nat^ N.Nat^;
/* Computational operations and their Set specifications use the certified
 * Nat arithmetic above, joined by correspondence coherence. */

\module ZeroImplementation {
  \definition T: \VType := Int;

  \definition program: Int := (Int::ofNat N.Nat::zero);

  \definition specification: T^ := (Int^::ofNat N.Nat^::zero);

  \definition matches: program^ = specification := \refl(Int^::ofNat N.Nat^::zero);

  \definition coherence: program^ = specification := matches;
}
\import .ZeroImplementation[] \as ZeroParts;
\definition Zero: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := ZeroParts.T,
  program := ZeroParts.program,
  specification := ZeroParts.specification,
  coherence := ZeroParts.coherence,
};

\module OneImplementation {
  \definition T: \VType := Int;

  \definition program: Int := (Int::ofNat (N.Nat::succ N.Nat::zero));

  \definition specification: T^ := (Int^::ofNat (N.Nat^::succ N.Nat^::zero));

  \definition matches: program^ = specification := \refl(Int^::ofNat (N.Nat^::succ N.Nat^::zero));

  \definition coherence: program^ = specification := matches;
}
\import .OneImplementation[] \as OneParts;
\definition One: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := OneParts.T,
  program := OneParts.program,
  specification := OneParts.specification,
  coherence := OneParts.coherence,
};

\module MinusOneImplementation {
  \definition T: \VType := Int;

  \definition program: Int := (Int::negSucc N.Nat::zero);

  \definition specification: T^ := (Int^::negSucc N.Nat^::zero);

  \definition matches: program^ = specification := \refl(Int^::negSucc N.Nat^::zero);

  \definition coherence: program^ = specification := matches;
}
\import .MinusOneImplementation[] \as MinusOneParts;
\definition MinusOne: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MinusOneParts.T,
  program := MinusOneParts.program,
  specification := MinusOneParts.specification,
  coherence := MinusOneParts.coherence,
};

/* Nat imports its own Bool instance. Convert its decisions through Nat.choose
 * so that Int consistently exposes the Bool instance imported here. */

\module NatIsZeroImplementation {
  \definition T: \VType := \U((N.Nat -> B.Bool));

  \definition program: (N.Nat -> B.Bool) := (\cfun (n: N.Nat) => \match n \in N.Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false });

  \definition specification: T^ := \induction (n: N.Nat^) \return B.Bool^ \with {
      | zero : B.Bool^::true
      | succ : (\fun (n: N.Nat^) => \fun (ih: B.Bool^) => B.Bool^::false)
      };

  \definition matches: \forall (n: N.Nat^) -> program^ n = specification n :=
    \induction (n: N.Nat^) \return program^ n = specification n \with {
      | zero : (\refl(B.Bool^::true))
      | succ : (\fun (n: N.Nat^) => \fun (ih: program^ n = specification n) => \refl(B.Bool^::false))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NatIsZeroImplementation[] \as NatIsZeroParts;
\definition NatIsZero: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatIsZeroParts.T,
  program := \thunk (NatIsZeroParts.program),
  specification := NatIsZeroParts.specification,
  coherence := NatIsZeroParts.coherence,
};

\module NatEqbImplementation {
  \definition T: \VType := \U((N.Nat -> (N.Nat -> B.Bool)));

  \definition program: (N.Nat -> (N.Nat -> B.Bool)) := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => \program {
    \bind f: _ <- ((\force NatOp.Eqb.program) a) \then
    \bind test: _ <- (\force f) b \then
    \bind yes: _ <- ((\force NatOp.Choose.program) test) \then
    \bind no: _ <- (\force yes) N.Nat::zero \then
    \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
    \bind result: B.Bool <- ((\force NatIsZero.program) number) \then
    \return result
  })));

  \definition specification: T^ := \fun (a, b: N.Nat^) => NatIsZero.specification (NatOp.Choose.specification (NatOp.Eqb.specification a b)
      N.Nat^::zero (N.Nat^::succ N.Nat^::zero));

  \definition matches(a, b: N.Nat^): program^ a b = specification a b :=
    trans!{B.Bool^} _ _ _
      (congr!{NatIsZero.T^ _} (\fun (f: _) => f (NatOp.Choose.program^ (NatOp.Eqb.program^ a b) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero.coherence)
      (congr2!{NatOp.Choose.T^ NatOp.Eqb.T^ B.Bool^}
        (\fun (choose: _) (test: _) => NatIsZero.specification (choose (test a b)
      N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
        _ _ _ _ NatOp.Choose.coherence NatOp.Eqb.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: N.Nat^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: N.Nat^) => matches arg0 arg1));
}
\import .NatEqbImplementation[] \as NatEqbParts;
\definition NatEqb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatEqbParts.T,
  program := \thunk (NatEqbParts.program),
  specification := NatEqbParts.specification,
  coherence := NatEqbParts.coherence,
};

\module NatLebImplementation {
  \definition T: \VType := \U((N.Nat -> (N.Nat -> B.Bool)));

  \definition program: (N.Nat -> (N.Nat -> B.Bool)) := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => \program {
    \bind f: _ <- ((\force NatOp.Leb.program) a) \then
    \bind test: _ <- (\force f) b \then
    \bind yes: _ <- ((\force NatOp.Choose.program) test) \then
    \bind no: _ <- (\force yes) N.Nat::zero \then
    \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
    \bind result: B.Bool <- ((\force NatIsZero.program) number) \then
    \return result
  })));

  \definition specification: T^ := \fun (a, b: N.Nat^) => NatIsZero.specification (NatOp.Choose.specification (NatOp.Leb.specification a b)
      N.Nat^::zero (N.Nat^::succ N.Nat^::zero));

  \definition matches(a, b: N.Nat^): program^ a b = specification a b :=
    trans!{B.Bool^} _ _ _
      (congr!{NatIsZero.T^ _} (\fun (f: _) => f (NatOp.Choose.program^ (NatOp.Leb.program^ a b) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero.coherence)
      (congr2!{NatOp.Choose.T^ NatOp.Leb.T^ B.Bool^}
        (\fun (choose: _) (test: _) => NatIsZero.specification (choose (test a b)
      N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
        _ _ _ _ NatOp.Choose.coherence NatOp.Leb.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: N.Nat^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: N.Nat^) => matches arg0 arg1));
}
\import .NatLebImplementation[] \as NatLebParts;
\definition NatLeb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatLebParts.T,
  program := \thunk (NatLebParts.program),
  specification := NatLebParts.specification,
  coherence := NatLebParts.coherence,
};

\module NatLtbImplementation {
  \definition T: \VType := \U((N.Nat -> (N.Nat -> B.Bool)));

  \definition program: (N.Nat -> (N.Nat -> B.Bool)) := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => \program {
    \bind f: _ <- ((\force NatOp.Ltb.program) a) \then
    \bind test: _ <- (\force f) b \then
    \bind yes: _ <- ((\force NatOp.Choose.program) test) \then
    \bind no: _ <- (\force yes) N.Nat::zero \then
    \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
    \bind result: B.Bool <- ((\force NatIsZero.program) number) \then
    \return result
  })));

  \definition specification: T^ := \fun (a, b: N.Nat^) => NatIsZero.specification (NatOp.Choose.specification (NatOp.Ltb.specification a b)
      N.Nat^::zero (N.Nat^::succ N.Nat^::zero));

  \definition matches(a, b: N.Nat^): program^ a b = specification a b :=
    trans!{B.Bool^} _ _ _
      (congr!{NatIsZero.T^ _} (\fun (f: _) => f (NatOp.Choose.program^ (NatOp.Ltb.program^ a b) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero.coherence)
      (congr2!{NatOp.Choose.T^ NatOp.Ltb.T^ B.Bool^}
        (\fun (choose: _) (test: _) => NatIsZero.specification (choose (test a b)
      N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
        _ _ _ _ NatOp.Choose.coherence NatOp.Ltb.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: N.Nat^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: N.Nat^) => matches arg0 arg1));
}
\import .NatLtbImplementation[] \as NatLtbParts;
\definition NatLtb: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatLtbParts.T,
  program := \thunk (NatLtbParts.program),
  specification := NatLtbParts.specification,
  coherence := NatLtbParts.coherence,
};

\module NatEvenImplementation {
  \definition T: \VType := \U((N.Nat -> B.Bool));

  \definition program: (N.Nat -> B.Bool) := (\cfun (a: N.Nat) => \program {
    \bind test: _ <- ((\force NP.Even.program) a) \then
    \bind yes: _ <- ((\force NatOp.Choose.program) test) \then
    \bind no: _ <- (\force yes) N.Nat::zero \then
    \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
    \bind result: B.Bool <- ((\force NatIsZero.program) number) \then
    \return result
  });

  \definition specification: T^ := \fun (a: N.Nat^) => NatIsZero.specification (NatOp.Choose.specification (NP.Even.specification a) N.Nat^::zero
      (N.Nat^::succ N.Nat^::zero));

  \definition matches(a: N.Nat^): program^ a = specification a :=
    trans!{B.Bool^} _ _ _
      (congr!{NatIsZero.T^ _} (\fun (f: _) => f (NatOp.Choose.program^ (NP.Even.program^ a) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero.coherence)
      (congr2!{NatOp.Choose.T^ NP.Even.T^ B.Bool^}
        (\fun (choose: _) (test: _) => NatIsZero.specification (choose (test a) N.Nat^::zero
      (N.Nat^::succ N.Nat^::zero)))
        _ _ _ _ NatOp.Choose.coherence NP.Even.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NatEvenImplementation[] \as NatEvenParts;
\definition NatEven: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatEvenParts.T,
  program := \thunk (NatEvenParts.program),
  specification := NatEvenParts.specification,
  coherence := NatEvenParts.coherence,
};

\module NatOddImplementation {
  \definition T: \VType := \U((N.Nat -> B.Bool));

  \definition program: (N.Nat -> B.Bool) := (\cfun (a: N.Nat) => \program {
    \bind test: _ <- ((\force NP.Odd.program) a) \then
    \bind yes: _ <- ((\force NatOp.Choose.program) test) \then
    \bind no: _ <- (\force yes) N.Nat::zero \then
    \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
    \bind result: B.Bool <- ((\force NatIsZero.program) number) \then
    \return result
  });

  \definition specification: T^ := \fun (a: N.Nat^) => NatIsZero.specification (NatOp.Choose.specification (NP.Odd.specification a) N.Nat^::zero
      (N.Nat^::succ N.Nat^::zero));

  \definition matches(a: N.Nat^): program^ a = specification a :=
    trans!{B.Bool^} _ _ _
      (congr!{NatIsZero.T^ _} (\fun (f: _) => f (NatOp.Choose.program^ (NP.Odd.program^ a) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero.coherence)
      (congr2!{NatOp.Choose.T^ NP.Odd.T^ B.Bool^}
        (\fun (choose: _) (test: _) => NatIsZero.specification (choose (test a) N.Nat^::zero
      (N.Nat^::succ N.Nat^::zero)))
        _ _ _ _ NatOp.Choose.coherence NP.Odd.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NatOddImplementation[] \as NatOddParts;
\definition NatOdd: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatOddParts.T,
  program := \thunk (NatOddParts.program),
  specification := NatOddParts.specification,
  coherence := NatOddParts.coherence,
};

\module ChooseImplementation {
  \definition T: \VType := \U((B.Bool -> (Int -> (Int -> Int))));

  \definition program: (B.Bool -> (Int -> (Int -> Int))) := (\cfun (test: B.Bool) => \return(\thunk(\cfun (yes: Int) => \return(\thunk(\cfun (no: Int) => \match test \in B.Bool \with { | false : \return no | true : \return yes })))));

  \definition specification: T^ := B.ite Int^;

  \definition matches:
      \forall (test: B.Bool^) -> \forall (yes, no: Int^) ->
    program^ test yes no = specification test yes no :=
    \induction (test: B.Bool^) \return \forall (yes, no: Int^) ->
      program^ test yes no = specification test yes no \with {
      | false : (\fun (yes, no: Int^) => \refl(no))
      | true : (\fun (yes, no: Int^) => \refl(yes))
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: B.Bool^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => \axiom:funext(program^ arg0 arg1, specification arg0 arg1, \fun (arg2: Int^) => matches arg0 arg1 arg2)));
}
\import .ChooseImplementation[] \as ChooseParts;
\definition Choose: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := ChooseParts.T,
  program := \thunk (ChooseParts.program),
  specification := ChooseParts.specification,
  coherence := ChooseParts.coherence,
};

\module OfNatImplementation {
  \definition T: \VType := \U((N.Nat -> Int));

  \definition program: (N.Nat -> Int) := (\cfun (n: N.Nat) => \return(Int::ofNat n));

  \definition specification: T^ := \fun (n: N.Nat^) => (Int^::ofNat n);

  \definition matches(n: N.Nat^): program^ n = specification n := \refl(Int^::ofNat n);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .OfNatImplementation[] \as OfNatParts;
\definition OfNat: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := OfNatParts.T,
  program := \thunk (OfNatParts.program),
  specification := OfNatParts.specification,
  coherence := OfNatParts.coherence,
};

\module NegOfNatImplementation {
  \definition T: \VType := \U((N.Nat -> Int));

  \definition program: (N.Nat -> Int) := (\cfun (n: N.Nat) => \program {
    \bind v1: Int <- (\force DiffLoop.run) (DiffState::running N.Nat::zero n) \then
    \return v1
  });

  \definition specification: T^ := \fun (n: N.Nat^) => (Diff.specification N.Nat^::zero n);

  \definition matches(n: N.Nat^): program^ n = specification n := congr!{Diff.T^ _} (\fun (f: _) => f N.Nat^::zero n) _ _ Diff.coherence;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NegOfNatImplementation[] \as NegOfNatParts;
\definition NegOfNat: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NegOfNatParts.T,
  program := \thunk (NegOfNatParts.program),
  specification := NegOfNatParts.specification,
  coherence := NegOfNatParts.coherence,
};

\module NegImplementation {
  \definition T: \VType := \U((Int -> Int));

  \definition program: (Int -> Int) := (\cfun (x: Int) => \program {
    \bind v2: N.Nat <- ((\force Negative.program) x) \then
    \bind v4: N.Nat <- ((\force Positive.program) x) \then
    \bind v5: Int <- (\force DiffLoop.run) (DiffState::running v2
      v4) \then
    \return v5
  });

  \definition specification: T^ := \fun (x: Int^) => (Diff.specification (Negative.specification x) (Positive.specification x));

  \definition matches: \forall (x: Int^) -> program^ x = specification x :=
    \block {
      \fun (x: Int^) \then
      \let componentsMatch:
        Diff.program^ (Negative.program^ x) (Positive.program^ x) = Diff.program^ (Negative.specification x) (Positive.specification x) :=
        congr2!{N.Nat^ N.Nat^ Int^} Diff.program^
          (Negative.program^ x) (Negative.specification x) (Positive.program^ x) (Positive.specification x)
          (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence) (congr!{Positive.T^ _} (\fun (f: _) => f x) _ _ Positive.coherence) \then
      \return trans!{Int^} _ _ _ componentsMatch
        (congr!{Diff.T^ _} (\fun (f: _) => f (Negative.specification x) (Positive.specification x)) _ _ Diff.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NegImplementation[] \as NegParts;
\definition Neg: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NegParts.T,
  program := \thunk (NegParts.program),
  specification := NegParts.specification,
  coherence := NegParts.coherence,
};

\module AddImplementation {
  \definition T: \VType := \U((Int -> (Int -> Int)));

  \definition program: (Int -> (Int -> Int)) := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
    \bind v2: N.Nat <- ((\force Positive.program) x) \then
    \bind v4: N.Nat <- ((\force Positive.program) y) \then
    \bind v5: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running v2 v4) \then
    \bind v7: N.Nat <- ((\force Negative.program) x) \then
    \bind v9: N.Nat <- ((\force Negative.program) y) \then
    \bind v10: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running v7 v9) \then
    \bind v11: Int <- (\force DiffLoop.run) (DiffState::running v5 v10) \then
    \return v11
  })));

  \definition specification: T^ := \fun (x: Int^) (y: Int^) => (Diff.specification (NatOp.Add.specification (Positive.specification x)
      (Positive.specification y)) (NatOp.Add.specification (Negative.specification x) (Negative.specification y)));

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> program^ x y = specification x y :=
    \block {
      \fun (x, y: Int^) \then
      \let positivesMatch:
        NatOp.Add.program^ (Positive.program^ x) (Positive.program^ y) =
          NatOp.Add.program^ (Positive.specification x) (Positive.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^
          (Positive.program^ x) (Positive.specification x) (Positive.program^ y) (Positive.specification y)
          (congr!{Positive.T^ _} (\fun (f: _) => f x) _ _ Positive.coherence) (congr!{Positive.T^ _} (\fun (f: _) => f y) _ _ Positive.coherence) \then
      \let negativesMatch:
        NatOp.Add.program^ (Negative.program^ x) (Negative.program^ y) =
          NatOp.Add.program^ (Negative.specification x) (Negative.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^
          (Negative.program^ x) (Negative.specification x) (Negative.program^ y) (Negative.specification y)
          (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence) (congr!{Negative.T^ _} (\fun (f: _) => f y) _ _ Negative.coherence) \then
      \let componentsMatch:
        Diff.program^ (NatOp.Add.program^ (Positive.program^ x) (Positive.program^ y))
          (NatOp.Add.program^ (Negative.program^ x) (Negative.program^ y)) =
        Diff.program^ (NatOp.Add.program^ (Positive.specification x) (Positive.specification y))
          (NatOp.Add.program^ (Negative.specification x) (Negative.specification y)) :=
        congr2!{N.Nat^ N.Nat^ Int^} Diff.program^
          _ _ _ _ positivesMatch negativesMatch \then
      \return trans!{Int^} _ _ _
        (trans!{Int^} _ _ _ componentsMatch
        (congr!{Diff.T^ _} (\fun (f: _) => f (NatOp.Add.program^ (Positive.specification x) (Positive.specification y)) (NatOp.Add.program^ (Negative.specification x) (Negative.specification y))) _ _ Diff.coherence))
        (congr!{NatOp.Add.T^ Int^} (\fun (addOperation: NatOp.Add.T^) => (Diff.specification (addOperation (Positive.specification x)
      (Positive.specification y)) (addOperation (Negative.specification x) (Negative.specification y))))
        _ _ NatOp.Add.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
}
\import .AddImplementation[] \as AddParts;
\definition Add: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := AddParts.T,
  program := \thunk (AddParts.program),
  specification := AddParts.specification,
  coherence := AddParts.coherence,
};

\module SubImplementation {
  \definition T: \VType := \U((Int -> (Int -> Int)));

  \definition program: (Int -> (Int -> Int)) := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
    \bind v2: Int <- ((\force Neg.program) y) \then
    \bind v3: \U(Int -> Int) <- ((\force Add.program) x) \then
    \bind v5: Int <- (\force v3) v2 \then
    \return v5
  })));

  \definition specification: T^ := \fun (x: Int^) (y: Int^) => (Add.specification x (Neg.specification y));

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> program^ x y = specification x y :=
    \block {
      \fun (x, y: Int^) \then
      \let argumentMatches: Add.program^ x (Neg.program^ y) = Add.program^ x (Neg.specification y) :=
        congr2!{Int^ Int^ Int^} Add.program^
          x x (Neg.program^ y) (Neg.specification y) (\refl(x)) (congr!{Neg.T^ _} (\fun (f: _) => f y) _ _ Neg.coherence) \then
      \return trans!{Int^} _ _ _ argumentMatches (congr!{Add.T^ _} (\fun (f: _) => f x (Neg.specification y)) _ _ Add.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
}
\import .SubImplementation[] \as SubParts;
\definition Sub: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SubParts.T,
  program := \thunk (SubParts.program),
  specification := SubParts.specification,
  coherence := SubParts.coherence,
};

\module MulImplementation {
  \definition T: \VType := \U((Int -> (Int -> Int)));

  \definition program: (Int -> (Int -> Int)) := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
    \bind v2: N.Nat <- ((\force Positive.program) x) \then
    \bind v4: N.Nat <- ((\force Positive.program) y) \then
    \bind v5: N.Nat <- (\force NatOp.IterLoop.run) (NatOp.IterState::running \thunk(\cfun (current: N.Nat) => (\force NatOp.AddLoop.run) (NatOp.AddState::running v2 current))
      N.Nat::zero v4) \then
    \bind v7: N.Nat <- ((\force Negative.program) x) \then
    \bind v9: N.Nat <- ((\force Negative.program) y) \then
    \bind v10: N.Nat <- (\force NatOp.IterLoop.run) (NatOp.IterState::running \thunk(\cfun (current: N.Nat) => (\force NatOp.AddLoop.run) (NatOp.AddState::running
      v7 current)) N.Nat::zero v9) \then
    \bind v11: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running v5 v10) \then
    \bind v12: N.Nat <- (\force NatOp.IterLoop.run) (NatOp.IterState::running
      \thunk(\cfun (current: N.Nat) => (\force NatOp.AddLoop.run) (NatOp.AddState::running v2 current)) N.Nat::zero v9) \then
    \bind v13: N.Nat <- (\force NatOp.IterLoop.run) (NatOp.IterState::running \thunk(\cfun (current: N.Nat) => (\force NatOp.AddLoop.run) (NatOp.AddState::running v7 current))
      N.Nat::zero v4) \then
    \bind v14: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running v12 v13) \then
    \bind v15: Int <- (\force DiffLoop.run) (DiffState::running v11 v14) \then
    \return v15
  })));

  \definition specification: T^ := \fun (x: Int^) (y: Int^) => (Diff.specification (NatOp.Add.specification (NatOp.Mul.specification (Positive.specification
      x) (Positive.specification y)) (NatOp.Mul.specification (Negative.specification x) (Negative.specification y))) (NatOp.Add.specification (NatOp.Mul.specification (Positive.specification x)
      (Negative.specification y)) (NatOp.Mul.specification (Negative.specification x) (Positive.specification y))));

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> program^ x y = specification x y :=
    \block {
      \fun (x, y: Int^) \then
      \let ppMatches:
        NatOp.Mul.program^ (Positive.program^ x) (Positive.program^ y) =
          NatOp.Mul.program^ (Positive.specification x) (Positive.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Mul.program^
          (Positive.program^ x) (Positive.specification x) (Positive.program^ y) (Positive.specification y)
          (congr!{Positive.T^ _} (\fun (f: _) => f x) _ _ Positive.coherence) (congr!{Positive.T^ _} (\fun (f: _) => f y) _ _ Positive.coherence) \then
      \let nnMatches:
        NatOp.Mul.program^ (Negative.program^ x) (Negative.program^ y) =
          NatOp.Mul.program^ (Negative.specification x) (Negative.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Mul.program^
          (Negative.program^ x) (Negative.specification x) (Negative.program^ y) (Negative.specification y)
          (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence) (congr!{Negative.T^ _} (\fun (f: _) => f y) _ _ Negative.coherence) \then
      \let pnMatches:
        NatOp.Mul.program^ (Positive.program^ x) (Negative.program^ y) =
          NatOp.Mul.program^ (Positive.specification x) (Negative.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Mul.program^
          (Positive.program^ x) (Positive.specification x) (Negative.program^ y) (Negative.specification y)
          (congr!{Positive.T^ _} (\fun (f: _) => f x) _ _ Positive.coherence) (congr!{Negative.T^ _} (\fun (f: _) => f y) _ _ Negative.coherence) \then
      \let npMatches:
        NatOp.Mul.program^ (Negative.program^ x) (Positive.program^ y) =
          NatOp.Mul.program^ (Negative.specification x) (Positive.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Mul.program^
          (Negative.program^ x) (Negative.specification x) (Positive.program^ y) (Positive.specification y)
          (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence) (congr!{Positive.T^ _} (\fun (f: _) => f y) _ _ Positive.coherence) \then
      \let positiveTermsMatch:
        NatOp.Add.program^
          (NatOp.Mul.program^ (Positive.program^ x) (Positive.program^ y))
          (NatOp.Mul.program^ (Negative.program^ x) (Negative.program^ y)) =
        NatOp.Add.program^
          (NatOp.Mul.program^ (Positive.specification x) (Positive.specification y))
          (NatOp.Mul.program^ (Negative.specification x) (Negative.specification y)) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^
          _ _ _ _ ppMatches nnMatches \then
      \let negativeTermsMatch:
        NatOp.Add.program^
          (NatOp.Mul.program^ (Positive.program^ x) (Negative.program^ y))
          (NatOp.Mul.program^ (Negative.program^ x) (Positive.program^ y)) =
        NatOp.Add.program^
          (NatOp.Mul.program^ (Positive.specification x) (Negative.specification y))
          (NatOp.Mul.program^ (Negative.specification x) (Positive.specification y)) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^
          _ _ _ _ pnMatches npMatches \then
      \let componentsMatch:
        Diff.program^
          (NatOp.Add.program^ (NatOp.Mul.program^ (Positive.program^ x) (Positive.program^ y))
            (NatOp.Mul.program^ (Negative.program^ x) (Negative.program^ y)))
          (NatOp.Add.program^ (NatOp.Mul.program^ (Positive.program^ x) (Negative.program^ y))
            (NatOp.Mul.program^ (Negative.program^ x) (Positive.program^ y))) =
        Diff.program^
          (NatOp.Add.program^ (NatOp.Mul.program^ (Positive.specification x) (Positive.specification y))
            (NatOp.Mul.program^ (Negative.specification x) (Negative.specification y)))
          (NatOp.Add.program^ (NatOp.Mul.program^ (Positive.specification x) (Negative.specification y))
            (NatOp.Mul.program^ (Negative.specification x) (Positive.specification y))) :=
        congr2!{N.Nat^ N.Nat^ Int^} Diff.program^
          _ _ _ _ positiveTermsMatch negativeTermsMatch \then
      \return trans!{Int^} _ _ _
        (trans!{Int^} _ _ _ componentsMatch
        (congr!{Diff.T^ _} (\fun (f: _) => f (NatOp.Add.program^ (NatOp.Mul.program^ (Positive.specification x) (Positive.specification y))
            (NatOp.Mul.program^ (Negative.specification x) (Negative.specification y))) (NatOp.Add.program^ (NatOp.Mul.program^ (Positive.specification x) (Negative.specification y))
            (NatOp.Mul.program^ (Negative.specification x) (Positive.specification y)))) _ _ Diff.coherence))
        (congr2!{NatOp.Add.T^ NatOp.Mul.T^ Int^}
        (\fun (addOperation: NatOp.Add.T^) (mulOperation: NatOp.Mul.T^) => (Diff.specification (addOperation (mulOperation (Positive.specification
      x) (Positive.specification y)) (mulOperation (Negative.specification x) (Negative.specification y))) (addOperation (mulOperation (Positive.specification x)
      (Negative.specification y)) (mulOperation (Negative.specification x) (Positive.specification y)))))
        _ _ _ _ NatOp.Add.coherence NatOp.Mul.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
}
\import .MulImplementation[] \as MulParts;
\definition Mul: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MulParts.T,
  program := \thunk (MulParts.program),
  specification := MulParts.specification,
  coherence := MulParts.coherence,
};

\module SuccImplementation {
  \definition T: \VType := \U((Int -> Int));

  \definition program: (Int -> Int) := (\cfun (x: Int) => \program {
    \bind v1: \U(Int -> Int) <- ((\force Add.program) x) \then
    \bind v3: Int <- (\force v1) (Int::ofNat (N.Nat::succ N.Nat::zero)) \then
    \return v3
  });

  \definition specification: T^ := \fun (x: Int^) => (Add.specification x (Int^::ofNat (N.Nat^::succ N.Nat^::zero)));

  \definition matches(x: Int^): program^ x = specification x := congr!{Add.T^ _} (\fun (f: _) => f x (Int^::ofNat (N.Nat^::succ N.Nat^::zero))) _ _ Add.coherence;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .SuccImplementation[] \as SuccParts;
\definition Succ: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SuccParts.T,
  program := \thunk (SuccParts.program),
  specification := SuccParts.specification,
  coherence := SuccParts.coherence,
};

\module PredImplementation {
  \definition T: \VType := \U((Int -> Int));

  \definition program: (Int -> Int) := (\cfun (x: Int) => \program {
    \bind v1: \U(Int -> Int) <- ((\force Sub.program) x) \then
    \bind v3: Int <- (\force v1) (Int::ofNat (N.Nat::succ N.Nat::zero)) \then
    \return v3
  });

  \definition specification: T^ := \fun (x: Int^) => (Sub.specification x (Int^::ofNat (N.Nat^::succ N.Nat^::zero)));

  \definition matches(x: Int^): program^ x = specification x := congr!{Sub.T^ _} (\fun (f: _) => f x (Int^::ofNat (N.Nat^::succ N.Nat^::zero))) _ _ Sub.coherence;

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .PredImplementation[] \as PredParts;
\definition Pred: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PredParts.T,
  program := \thunk (PredParts.program),
  specification := PredParts.specification,
  coherence := PredParts.coherence,
};

\module NatAbsImplementation {
  \definition T: \VType := \U((Int -> N.Nat));

  \definition program: (Int -> N.Nat) := (\cfun (x: Int) => \program {
    \bind v2: N.Nat <- ((\force Positive.program) x) \then
    \bind v4: N.Nat <- ((\force Negative.program) x) \then
    \bind v5: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running
      v2 v4) \then
    \return v5
  });

  \definition specification: T^ := \fun (x: Int^) => (NatOp.Add.specification (Positive.specification x) (Negative.specification x));

  \definition matches(x: Int^): program^ x = specification x :=
    trans!{N.Nat^} _ _ _
      (congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^ (Positive.program^ x) (Positive.specification x) (Negative.program^ x) (Negative.specification x)
      (congr!{Positive.T^ _} (\fun (f: _) => f x) _ _ Positive.coherence) (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence))
      (congr!{NatOp.Add.T^ N.Nat^}
        (\fun (addition: _) => addition (Positive.specification x) (Negative.specification x))
        _ _ NatOp.Add.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .NatAbsImplementation[] \as NatAbsParts;
\definition NatAbs: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := NatAbsParts.T,
  program := \thunk (NatAbsParts.program),
  specification := NatAbsParts.specification,
  coherence := NatAbsParts.coherence,
};

\module AbsImplementation {
  \definition T: \VType := \U((Int -> Int));

  \definition program: (Int -> Int) := (\cfun (x: Int) => \program {
    \bind v2: N.Nat <- ((\force NatAbs.program) x) \then
    \bind v4: Int <- ((\force OfNat.program) v2) \then
    \return v4
  });

  \definition specification: T^ := \fun (x: Int^) => (OfNat.specification (NatAbs.specification x));

  \definition matches(x: Int^): program^ x = specification x := trans!{Int^} _ _ _ (congr!{N.Nat^ Int^} OfNat.program^ (NatAbs.program^ x) (NatAbs.specification x) (congr!{NatAbs.T^ _} (\fun (f: _) => f x) _ _ NatAbs.coherence))
      (congr!{OfNat.T^ _} (\fun (f: _) => f (NatAbs.specification x)) _ _ OfNat.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .AbsImplementation[] \as AbsParts;
\definition Abs: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := AbsParts.T,
  program := \thunk (AbsParts.program),
  specification := AbsParts.specification,
  coherence := AbsParts.coherence,
};

\module IsZeroImplementation {
  \definition T: \VType := \U((Int -> B.Bool));

  \definition program: (Int -> B.Bool) := (\cfun (x: Int) => \program {
    \bind v2: N.Nat <- ((\force NatAbs.program) x) \then
    \bind v4: B.Bool <- ((\force NatIsZero.program) v2) \then
    \return v4
  });

  \definition specification: T^ := \fun (x: Int^) => (NatIsZero.specification (NatAbs.specification x));

  \definition matches(x: Int^): program^ x = specification x := trans!{B.Bool^} _ _ _ (congr!{N.Nat^ B.Bool^} NatIsZero.program^ (NatAbs.program^ x) (NatAbs.specification x) (congr!{NatAbs.T^ _} (\fun (f: _) => f x) _ _ NatAbs.coherence))
      (congr!{NatIsZero.T^ _} (\fun (f: _) => f (NatAbs.specification x)) _ _ NatIsZero.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .IsZeroImplementation[] \as IsZeroParts;
\definition IsZero: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := IsZeroParts.T,
  program := \thunk (IsZeroParts.program),
  specification := IsZeroParts.specification,
  coherence := IsZeroParts.coherence,
};

\module EqbImplementation {
  \definition T: \VType := \U((Int -> (Int -> B.Bool)));

  \definition program: (Int -> (Int -> B.Bool)) := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
    \bind v2: N.Nat <- ((\force Positive.program) x) \then
    \bind v4: N.Nat <- ((\force Negative.program) y) \then
    \bind v5: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running v2 v4) \then
    \bind v7: N.Nat <- ((\force Positive.program) y) \then
    \bind v9: N.Nat <- ((\force Negative.program) x) \then
    \bind v10: N.Nat <- (\force NatOp.AddLoop.run) (NatOp.AddState::running v7 v9) \then
    \bind v11: \U(N.Nat -> B.Bool) <- ((\force NatEqb.program) v5) \then
    \bind v13: B.Bool <- (\force v11) v10 \then
    \return v13
  })));

  \definition specification: T^ := \fun (x: Int^) (y: Int^) => (NatEqb.specification (NatOp.Add.specification (Positive.specification x)
      (Negative.specification y)) (NatOp.Add.specification (Positive.specification y) (Negative.specification x)));

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> program^ x y = specification x y :=
    \block {
      \fun (x, y: Int^) \then
      \let leftMatches:
        NatOp.Add.program^ (Positive.program^ x) (Negative.program^ y) = NatOp.Add.program^ (Positive.specification x) (Negative.specification y) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^
          (Positive.program^ x) (Positive.specification x) (Negative.program^ y) (Negative.specification y)
          (congr!{Positive.T^ _} (\fun (f: _) => f x) _ _ Positive.coherence) (congr!{Negative.T^ _} (\fun (f: _) => f y) _ _ Negative.coherence) \then
      \let rightMatches:
        NatOp.Add.program^ (Positive.program^ y) (Negative.program^ x) = NatOp.Add.program^ (Positive.specification y) (Negative.specification x) :=
        congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add.program^
          (Positive.program^ y) (Positive.specification y) (Negative.program^ x) (Negative.specification x)
          (congr!{Positive.T^ _} (\fun (f: _) => f y) _ _ Positive.coherence) (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence) \then
      \let argumentsMatch:
        NatEqb.program^ (NatOp.Add.program^ (Positive.program^ x) (Negative.program^ y)) (NatOp.Add.program^ (Positive.program^ y) (Negative.program^ x)) =
        NatEqb.program^ (NatOp.Add.program^ (Positive.specification x) (Negative.specification y)) (NatOp.Add.program^ (Positive.specification y) (Negative.specification x)) :=
        congr2!{N.Nat^ N.Nat^ B.Bool^} NatEqb.program^ _ _ _ _ leftMatches rightMatches \then
      \return trans!{B.Bool^} _ _ _
        (trans!{B.Bool^} _ _ _ argumentsMatch
        (congr!{NatEqb.T^ _} (\fun (f: _) => f (NatOp.Add.program^ (Positive.specification x) (Negative.specification y)) (NatOp.Add.program^ (Positive.specification y) (Negative.specification x))) _ _ NatEqb.coherence))
        (congr!{NatOp.Add.T^ B.Bool^}
        (\fun (addition: _) => (NatEqb.specification (addition (Positive.specification x)
      (Negative.specification y)) (addition (Positive.specification y) (Negative.specification x)))) _ _ NatOp.Add.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
}
