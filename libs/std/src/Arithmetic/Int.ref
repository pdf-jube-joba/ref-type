\module MinImplementation {
  \definition T: \VType := \U((Int -> (Int -> Int)));

  \definition program: (Int -> (Int -> Int)) := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
    \bind v1: \U(Int -> B.Bool) <- ((\force Leb.program) x) \then
    \bind v3: B.Bool <- (\force v1) y \then
    \bind v4: \U(Int -> (Int -> Int)) <- ((\force Choose.program) v3) \then
    \bind v5: \U(Int -> Int) <- (\force v4) x \then
    \bind v7: Int <- (\force v5) y \then
    \return v7
  })));

  \definition specification: T^ := \fun (x: Int^) (y: Int^) => (Choose.specification (Leb.specification x y) x y);

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> program^ x y = specification x y :=
    \block {
      \fun (x, y: Int^) \then
      \let argumentsMatch:
        Choose.program^ (Leb.program^ x y) x y = Choose.program^ (Leb.specification x y) x y :=
        congr3!{B.Bool^ Int^ Int^ Int^} Choose.program^
          (Leb.program^ x y) (Leb.specification x y) x x y y
          (congr!{Leb.T^ _} (\fun (f: _) => f x y) _ _ Leb.coherence) (\refl(x)) (\refl(y)) \then
      \return trans!{Int^} _ _ _ argumentsMatch (congr!{Choose.T^ _} (\fun (f: _) => f (Leb.specification x y) x y) _ _ Choose.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
}
\import .MinImplementation[] \as MinParts;
\definition Min: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := MinParts.T,
  program := \thunk (MinParts.program),
  specification := MinParts.specification,
  coherence := MinParts.coherence,
};

\module MaxImplementation {
  \definition T: \VType := \U((Int -> (Int -> Int)));

  \definition program: (Int -> (Int -> Int)) := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
    \bind v1: \U(Int -> B.Bool) <- ((\force Leb.program) x) \then
    \bind v3: B.Bool <- (\force v1) y \then
    \bind v4: \U(Int -> (Int -> Int)) <- ((\force Choose.program) v3) \then
    \bind v5: \U(Int -> Int) <- (\force v4) y \then
    \bind v7: Int <- (\force v5) x \then
    \return v7
  })));

  \definition specification: T^ := \fun (x: Int^) (y: Int^) => (Choose.specification (Leb.specification x y) y x);

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> program^ x y = specification x y :=
    \block {
      \fun (x, y: Int^) \then
      \let argumentsMatch:
        Choose.program^ (Leb.program^ x y) y x = Choose.program^ (Leb.specification x y) y x :=
        congr3!{B.Bool^ Int^ Int^ Int^} Choose.program^
          (Leb.program^ x y) (Leb.specification x y) y y x x
          (congr!{Leb.T^ _} (\fun (f: _) => f x y) _ _ Leb.coherence) (\refl(y)) (\refl(x)) \then
      \return trans!{Int^} _ _ _ argumentsMatch (congr!{Choose.T^ _} (\fun (f: _) => f (Leb.specification x y) y x) _ _ Choose.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
}
