      \let argumentsMatch:
        NatLtb.program^ (NatOp.Add.program^ (Positive.program^ x) (Negative.program^ y)) (NatOp.Add.program^ (Positive.program^ y) (Negative.program^ x)) =
        NatLtb.program^ (NatOp.Add.program^ (Positive.specification x) (Negative.specification y)) (NatOp.Add.program^ (Positive.specification y) (Negative.specification x)) :=
        congr2!{N.Nat^ N.Nat^ B.Bool^} NatLtb.program^ _ _ _ _ leftMatches rightMatches \then
      \return trans!{B.Bool^} _ _ _
        (trans!{B.Bool^} _ _ _ argumentsMatch
        (congr!{NatLtb.T^ _} (\fun (f: _) => f (NatOp.Add.program^ (Positive.specification x) (Negative.specification y)) (NatOp.Add.program^ (Positive.specification y) (Negative.specification x))) _ _ NatLtb.coherence))
        (congr!{NatOp.Add.T^ B.Bool^}
        (\fun (addition: _) => (NatLtb.specification (addition (Positive.specification x)
      (Negative.specification y)) (addition (Positive.specification y) (Negative.specification x)))) _ _ NatOp.Add.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: Int^) => matches arg0 arg1));
