\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason;
\use Equality.congr;
\use Equality.congr2;
\use Equality.congr3;
\import std.Logic[].Equivalence[] \as Equivalence;
\use Equivalence.equiv_reason;
\use Equivalence.equiv_reason_terms;

/* Integers: Nat + Nat in Program, with negSucc n denoting -(n+1).
 * The mathematical carrier below is the Grothendieck quotient of (Nat,+,0).
 */
\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Operation[].Basic[] \as NatOp;
\import std.Data[].Nat[].Operation[].Parity[] \as NP;
\import std.Data[].Nat[].Law[].Basic[] \as NL;
\import std.Data[].Bool[] \as B;
\import std.Logic[].Proposition[] \as L;
\use L.not;
\import std.Data[].Pair[] \as P;

/* Expose the imported instances, including Program constructor notation. */
\definition Nat: \Set := N.Nat^;
\definition Bool: \Set := B.Bool^;
\macro natZero() := N.Nat^::zero;
\macro natSucc($n) := N.Nat^::succ $n;
\macro boolTrue() := B.Bool^::true;
\macro boolFalse() := B.Bool^::false;

\inductive Int: \VType :=
| ofNat: N.Nat -> Int
| negSucc: N.Nat -> Int
;

\inductive DiffState: \VType := | running: N.Nat -> N.Nat -> DiffState;
\machine DiffLoop {
  \State := DiffState,
  \Output := Int,
  \step := \thunk(\cfun (state: DiffState) => \match state \in DiffState \with { | running a b :
    \match b \in N.Nat \with {
    | zero : \return(\finish[DiffState, Int](Int::ofNat a))
    | succ k : \match a \in N.Nat \with {
      | zero : \return(\finish[DiffState, Int](Int::negSucc k))
      | succ j : \return(\continue[DiffState, Int](DiffState::running j k))
      }
    }
  }),

  \definition ready: \RunStep[DiffState^, Int^] -> \Prop :=
    \step-match t: \RunStep[DiffState^, Int^] \return \Prop \with {
      | \continue s: \Acc[DiffState^, Int^](DiffLoop::[step]^, s)
      | \finish result: L.True
    };
  \definition accIntro (s: DiffState^) (certificate: ready (DiffLoop::[step]^ s)):
    \Acc[DiffState^, Int^](DiffLoop::[step]^, s) :=
    \accintro[DiffState^, Int^](DiffLoop::[step]^, s,
      \fun (next: _) (edge: _) =>
        \idelim DiffLoop::[step]^ s = \continue[DiffState^, Int^](next)
          \with t: \RunStep[DiffState^, Int^] => ready t
          \by { base: certificate, equality: edge });
  \definition terminates: \forall (b, a: N.Nat^) ->
    \Acc[DiffState^, Int^](DiffLoop::[step]^, DiffState^::running a b) :=
    \induction (b: N.Nat^) \return \forall (a: N.Nat^) ->
      \Acc[DiffState^, Int^](DiffLoop::[step]^, DiffState^::running a b) \with {
      | zero: \fun (a: N.Nat^) =>
        accIntro (DiffState^::running a N.Nat^::zero) L.True::intro
      | succ: \fun (k: N.Nat^) (ih: _) =>
        \induction (a: N.Nat^) \return
          \Acc[DiffState^, Int^](DiffLoop::[step]^, DiffState^::running a (N.Nat^::succ k)) \with {
          | zero: accIntro (DiffState^::running N.Nat^::zero (N.Nat^::succ k)) L.True::intro
          | succ: \fun (j: N.Nat^) (_: _) =>
            accIntro (DiffState^::running (N.Nat^::succ j) (N.Nat^::succ k)) (ih j)
        }
    };
  \terminates := \induction (state: DiffState^) \return
    \Acc[DiffState^, Int^](DiffLoop::[step]^, state) \with {
      | running: \fun (a, b: N.Nat^) => terminates b a
    },
}

\correspondence Diff: (N.Nat -> (N.Nat -> Int)) {
  \program := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => DiffLoop::[run] (DiffState::running a b)))),
  \set := \fun (a, b: N.Nat^) =>
  \induction (b: N.Nat^) \return N.Nat^ -> Int^ \with {
    | zero : (\fun (a: N.Nat^) => Int^::ofNat a)
    | succ : (\fun (k: N.Nat^) => \fun (rec: N.Nat^ -> Int^) => \fun (a: N.Nat^) =>
      \induction (a: N.Nat^) \return Int^ \with {
        | zero : (Int^::negSucc k)
        | succ : (\fun (j: N.Nat^) => \fun (_: _) => rec j)
        } a)
    } b a,

  \definition matches: \forall (b, a: N.Nat^) -> Diff::[program]^ a b = Diff::[set] a b :=
  \induction (b: N.Nat^) \return \forall (a: N.Nat^) -> Diff::[program]^ a b = Diff::[set] a b \with {
    | zero : (\induction (a: N.Nat^) \return Diff::[program]^ a N.Nat^::zero = Diff::[set] a N.Nat^::zero \with {
      | zero : (\refl(Int^::ofNat N.Nat^::zero))
      | succ : (\fun (a: N.Nat^) => \fun (ih: Diff::[program]^ a N.Nat^::zero = Diff::[set] a N.Nat^::zero) => \refl(Int^::ofNat (N.Nat^::succ
    a)))
      })
    | succ : (\fun (b: N.Nat^) => \fun (ih: \forall (a: N.Nat^) -> Diff::[program]^ a b = Diff::[set] a b) =>
      \induction (a: N.Nat^) \return Diff::[program]^ a (N.Nat^::succ b) = Diff::[set] a (N.Nat^::succ b) \with {
      | zero : (\refl(Int^::negSucc b))
      | succ : (\fun (a: N.Nat^) => \fun (unused: Diff::[program]^ a (N.Nat^::succ b) = Diff::[set] a (N.Nat^::succ b)) => ih a)
      })
    };
  \coherence := \axiom:funext(Diff::[program]^, Diff::[set], \fun (arg0: N.Nat^) => \axiom:funext(Diff::[program]^ arg0, Diff::[set] arg0, \fun (arg1: N.Nat^) => matches arg1 arg0)),
}

/* A Set-only normal form, independent of Program reflection. */

\correspondence Positive: (Int -> N.Nat) {
  \program := (\cfun (z: Int) => \match z \in Int \with { | ofNat n : \return n | negSucc n : \return N.Nat::zero }),
  \set := \induction (z: Int^) \return N.Nat^ \with {
  | ofNat : (\fun (n: N.Nat^) => n)
  | negSucc : (\fun (n: N.Nat^) => N.Nat^::zero)
  },

  \definition matches: \forall (z: Int^) -> Positive::[program]^ z = Positive::[set] z :=
  \induction (z: Int^) \return Positive::[program]^ z = Positive::[set] z \with {
    | ofNat : (\fun (n: N.Nat^) => \refl(n))
    | negSucc : (\fun (n: N.Nat^) => \refl(N.Nat^::zero))
    };
  \coherence := \axiom:funext(Positive::[program]^, Positive::[set], matches),
}

\correspondence Negative: (Int -> N.Nat) {
  \program := (\cfun (z: Int) => \match z \in Int \with { | ofNat n : \return N.Nat::zero | negSucc n : \return(N.Nat::succ n) }),
  \set := \induction (z: Int^) \return N.Nat^ \with {
  | ofNat : (\fun (n: N.Nat^) => N.Nat^::zero)
  | negSucc : (\fun (n: N.Nat^) => N.Nat^::succ n)
  },

  \definition matches: \forall (z: Int^) -> Negative::[program]^ z = Negative::[set] z :=
  \induction (z: Int^) \return Negative::[program]^ z = Negative::[set] z \with {
    | ofNat : (\fun (n: N.Nat^) => \refl(N.Nat^::zero))
    | negSucc : (\fun (n: N.Nat^) => \refl(N.Nat^::succ n))
    };
  \coherence := \axiom:funext(Negative::[program]^, Negative::[set], matches),
}

\definition diffCanonical: \forall (z: Int^) -> Diff::[set] (Positive::[set] z) (Negative::[set] z) = z :=
  \induction (z: Int^) \return Diff::[set] (Positive::[set] z) (Negative::[set] z) = z \with {
    | ofNat : (\fun (n: N.Nat^) => \refl(Int^::ofNat n))
    | negSucc : (\fun (n: N.Nat^) => \refl(Int^::negSucc n))
    };

/* Formal differences in the cancellative commutative monoid (Nat,+,0). */
\definition Difference: \Set := P.Times^[N.Nat^, N.Nat^];
\definition pair: N.Nat^ -> N.Nat^ -> Difference := P.pair N.Nat^ N.Nat^;
\definition pos: Difference -> N.Nat^ := P.first N.Nat^ N.Nat^;
\definition negPart: Difference -> N.Nat^ := P.second N.Nat^ N.Nat^;
/* Computational operations and their Set specifications use the certified
 * Nat arithmetic above, joined by correspondence coherence. */

\correspondence Zero: Int {
  \program := (Int::ofNat N.Nat::zero),
  \set := (Int^::ofNat N.Nat^::zero),

  \definition matches: Zero::[program]^ = Zero::[set] := \refl(Int^::ofNat N.Nat^::zero);
  \coherence := matches,
}

\correspondence One: Int {
  \program := (Int::ofNat (N.Nat::succ N.Nat::zero)),
  \set := (Int^::ofNat (N.Nat^::succ N.Nat^::zero)),

  \definition matches: One::[program]^ = One::[set] := \refl(Int^::ofNat (N.Nat^::succ N.Nat^::zero));
  \coherence := matches,
}

\correspondence MinusOne: Int {
  \program := (Int::negSucc N.Nat::zero),
  \set := (Int^::negSucc N.Nat^::zero),

  \definition matches: MinusOne::[program]^ = MinusOne::[set] := \refl(Int^::negSucc N.Nat^::zero);
  \coherence := matches,
}

/* Nat imports its own Bool instance. Convert its decisions through Nat.choose
 * so that Int consistently exposes the Bool instance imported here. */
\correspondence NatIsZero: (N.Nat -> B.Bool) {
  \program := (\cfun (n: N.Nat) => \match n \in N.Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false }),
  \set := \induction (n: N.Nat^) \return B.Bool^ \with {
    | zero : B.Bool^::true
    | succ : (\fun (n: N.Nat^) => \fun (ih: B.Bool^) => B.Bool^::false)
    },

  \definition matches: \forall (n: N.Nat^) -> NatIsZero::[program]^ n = NatIsZero::[set] n :=
  \induction (n: N.Nat^) \return NatIsZero::[program]^ n = NatIsZero::[set] n \with {
    | zero : (\refl(B.Bool^::true))
    | succ : (\fun (n: N.Nat^) => \fun (ih: NatIsZero::[program]^ n = NatIsZero::[set] n) => \refl(B.Bool^::false))
    };
  \coherence := \axiom:funext(NatIsZero::[program]^, NatIsZero::[set], matches),
}

\correspondence NatEqb: (N.Nat -> (N.Nat -> B.Bool)) {
  \program := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => \program {
  \bind f: _ <- (NatOp.Eqb::[program] a) \then
  \bind test: _ <- (\force f) b \then
  \bind yes: _ <- (NatOp.Choose::[program] test) \then
  \bind no: _ <- (\force yes) N.Nat::zero \then
  \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
  \bind result: B.Bool <- (NatIsZero::[program] number) \then
  \return result
}))),
  \set := \fun (a, b: N.Nat^) => NatIsZero::[set] (NatOp.Choose::[set] (NatOp.Eqb::[set] a b)
    N.Nat^::zero (N.Nat^::succ N.Nat^::zero)),

  \definition matches (a, b: N.Nat^): NatEqb::[program]^ a b = NatEqb::[set] a b :=
  trans!{B.Bool^} _ _ _
    (congr!{NatIsZero::[Type]^ _} (\fun (f: _) => f (NatOp.Choose::[program]^ (NatOp.Eqb::[program]^ a b) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero::[coherence])
    (congr2!{NatOp.Choose::[Type]^ NatOp.Eqb::[Type]^ B.Bool^}
      (\fun (choose: _) (test: _) => NatIsZero::[set] (choose (test a b)
    N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
      _ _ _ _ NatOp.Choose::[coherence] NatOp.Eqb::[coherence]);
  \coherence := \axiom:funext(NatEqb::[program]^, NatEqb::[set], \fun (arg0: N.Nat^) => \axiom:funext(NatEqb::[program]^ arg0, NatEqb::[set] arg0, \fun (arg1: N.Nat^) => matches arg0 arg1)),
}

\correspondence NatLeb: (N.Nat -> (N.Nat -> B.Bool)) {
  \program := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => \program {
  \bind f: _ <- (NatOp.Leb::[program] a) \then
  \bind test: _ <- (\force f) b \then
  \bind yes: _ <- (NatOp.Choose::[program] test) \then
  \bind no: _ <- (\force yes) N.Nat::zero \then
  \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
  \bind result: B.Bool <- (NatIsZero::[program] number) \then
  \return result
}))),
  \set := \fun (a, b: N.Nat^) => NatIsZero::[set] (NatOp.Choose::[set] (NatOp.Leb::[set] a b)
    N.Nat^::zero (N.Nat^::succ N.Nat^::zero)),

  \definition matches (a, b: N.Nat^): NatLeb::[program]^ a b = NatLeb::[set] a b :=
  trans!{B.Bool^} _ _ _
    (congr!{NatIsZero::[Type]^ _} (\fun (f: _) => f (NatOp.Choose::[program]^ (NatOp.Leb::[program]^ a b) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero::[coherence])
    (congr2!{NatOp.Choose::[Type]^ NatOp.Leb::[Type]^ B.Bool^}
      (\fun (choose: _) (test: _) => NatIsZero::[set] (choose (test a b)
    N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
      _ _ _ _ NatOp.Choose::[coherence] NatOp.Leb::[coherence]);
  \coherence := \axiom:funext(NatLeb::[program]^, NatLeb::[set], \fun (arg0: N.Nat^) => \axiom:funext(NatLeb::[program]^ arg0, NatLeb::[set] arg0, \fun (arg1: N.Nat^) => matches arg0 arg1)),
}

\correspondence NatLtb: (N.Nat -> (N.Nat -> B.Bool)) {
  \program := (\cfun (a: N.Nat) => \return(\thunk(\cfun (b: N.Nat) => \program {
  \bind f: _ <- (NatOp.Ltb::[program] a) \then
  \bind test: _ <- (\force f) b \then
  \bind yes: _ <- (NatOp.Choose::[program] test) \then
  \bind no: _ <- (\force yes) N.Nat::zero \then
  \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
  \bind result: B.Bool <- (NatIsZero::[program] number) \then
  \return result
}))),
  \set := \fun (a, b: N.Nat^) => NatIsZero::[set] (NatOp.Choose::[set] (NatOp.Ltb::[set] a b)
    N.Nat^::zero (N.Nat^::succ N.Nat^::zero)),

  \definition matches (a, b: N.Nat^): NatLtb::[program]^ a b = NatLtb::[set] a b :=
  trans!{B.Bool^} _ _ _
    (congr!{NatIsZero::[Type]^ _} (\fun (f: _) => f (NatOp.Choose::[program]^ (NatOp.Ltb::[program]^ a b) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero::[coherence])
    (congr2!{NatOp.Choose::[Type]^ NatOp.Ltb::[Type]^ B.Bool^}
      (\fun (choose: _) (test: _) => NatIsZero::[set] (choose (test a b)
    N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
      _ _ _ _ NatOp.Choose::[coherence] NatOp.Ltb::[coherence]);
  \coherence := \axiom:funext(NatLtb::[program]^, NatLtb::[set], \fun (arg0: N.Nat^) => \axiom:funext(NatLtb::[program]^ arg0, NatLtb::[set] arg0, \fun (arg1: N.Nat^) => matches arg0 arg1)),
}

\correspondence NatEven: (N.Nat -> B.Bool) {
  \program := (\cfun (a: N.Nat) => \program {
  \bind test: _ <- (NP.Even::[program] a) \then
  \bind yes: _ <- (NatOp.Choose::[program] test) \then
  \bind no: _ <- (\force yes) N.Nat::zero \then
  \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
  \bind result: B.Bool <- (NatIsZero::[program] number) \then
  \return result
}),
  \set := \fun (a: N.Nat^) => NatIsZero::[set] (NatOp.Choose::[set] (NP.Even::[set] a) N.Nat^::zero
    (N.Nat^::succ N.Nat^::zero)),

  \definition matches (a: N.Nat^): NatEven::[program]^ a = NatEven::[set] a :=
  trans!{B.Bool^} _ _ _
    (congr!{NatIsZero::[Type]^ _} (\fun (f: _) => f (NatOp.Choose::[program]^ (NP.Even::[program]^ a) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero::[coherence])
    (congr2!{NatOp.Choose::[Type]^ NP.Even::[Type]^ B.Bool^}
      (\fun (choose: _) (test: _) => NatIsZero::[set] (choose (test a) N.Nat^::zero
    (N.Nat^::succ N.Nat^::zero)))
      _ _ _ _ NatOp.Choose::[coherence] NP.Even::[coherence]);
  \coherence := \axiom:funext(NatEven::[program]^, NatEven::[set], matches),
}

\correspondence NatOdd: (N.Nat -> B.Bool) {
  \program := (\cfun (a: N.Nat) => \program {
  \bind test: _ <- (NP.Odd::[program] a) \then
  \bind yes: _ <- (NatOp.Choose::[program] test) \then
  \bind no: _ <- (\force yes) N.Nat::zero \then
  \bind number: N.Nat <- (\force no) (N.Nat::succ N.Nat::zero) \then
  \bind result: B.Bool <- (NatIsZero::[program] number) \then
  \return result
}),
  \set := \fun (a: N.Nat^) => NatIsZero::[set] (NatOp.Choose::[set] (NP.Odd::[set] a) N.Nat^::zero
    (N.Nat^::succ N.Nat^::zero)),

  \definition matches (a: N.Nat^): NatOdd::[program]^ a = NatOdd::[set] a :=
  trans!{B.Bool^} _ _ _
    (congr!{NatIsZero::[Type]^ _} (\fun (f: _) => f (NatOp.Choose::[program]^ (NP.Odd::[program]^ a) N.Nat^::zero (N.Nat^::succ N.Nat^::zero))) _ _ NatIsZero::[coherence])
    (congr2!{NatOp.Choose::[Type]^ NP.Odd::[Type]^ B.Bool^}
      (\fun (choose: _) (test: _) => NatIsZero::[set] (choose (test a) N.Nat^::zero
    (N.Nat^::succ N.Nat^::zero)))
      _ _ _ _ NatOp.Choose::[coherence] NP.Odd::[coherence]);
  \coherence := \axiom:funext(NatOdd::[program]^, NatOdd::[set], matches),
}

\correspondence Choose: (B.Bool -> (Int -> (Int -> Int))) {
  \program := (\cfun (test: B.Bool) => \return(\thunk(\cfun (yes: Int) => \return(\thunk(\cfun (no: Int) => \match test \in B.Bool \with { | false : \return no | true : \return yes }))))),
  \set := B.ite Int^,

  \definition matches: \forall (test: B.Bool^) -> \forall (yes, no: Int^) ->
  Choose::[program]^ test yes no = Choose::[set] test yes no :=
  \induction (test: B.Bool^) \return \forall (yes, no: Int^) ->
    Choose::[program]^ test yes no = Choose::[set] test yes no \with {
    | false : (\fun (yes, no: Int^) => \refl(no))
    | true : (\fun (yes, no: Int^) => \refl(yes))
    };
  \coherence := \axiom:funext(Choose::[program]^, Choose::[set], \fun (arg0: B.Bool^) => \axiom:funext(Choose::[program]^ arg0, Choose::[set] arg0, \fun (arg1: Int^) => \axiom:funext(Choose::[program]^ arg0 arg1, Choose::[set] arg0 arg1, \fun (arg2: Int^) => matches arg0 arg1 arg2))),
}

\correspondence OfNat: (N.Nat -> Int) {
  \program := (\cfun (n: N.Nat) => \return(Int::ofNat n)),
  \set := \fun (n: N.Nat^) => (Int^::ofNat n),

  \definition matches (n: N.Nat^): OfNat::[program]^ n = OfNat::[set] n := \refl(Int^::ofNat n);
  \coherence := \axiom:funext(OfNat::[program]^, OfNat::[set], matches),
}

\correspondence NegOfNat: (N.Nat -> Int) {
  \program := (\cfun (n: N.Nat) => \program {
  \bind v1: Int <- DiffLoop::[run] (DiffState::running N.Nat::zero n) \then
  \return v1
}),
  \set := \fun (n: N.Nat^) => (Diff::[set] N.Nat^::zero n),

  \definition matches (n: N.Nat^): NegOfNat::[program]^ n = NegOfNat::[set] n := congr!{Diff::[Type]^ _} (\fun (f: _) => f N.Nat^::zero n) _ _ Diff::[coherence];
  \coherence := \axiom:funext(NegOfNat::[program]^, NegOfNat::[set], matches),
}

\correspondence Neg: (Int -> Int) {
  \program := (\cfun (x: Int) => \program {
  \bind v2: N.Nat <- (Negative::[program] x) \then
  \bind v4: N.Nat <- (Positive::[program] x) \then
  \bind v5: Int <- DiffLoop::[run] (DiffState::running v2
    v4) \then
  \return v5
}),
  \set := \fun (x: Int^) => (Diff::[set] (Negative::[set] x) (Positive::[set] x)),

  \definition matches: \forall (x: Int^) -> Neg::[program]^ x = Neg::[set] x :=
  \block {
    \fun (x: Int^) \then
    \let componentsMatch:
      Diff::[program]^ (Negative::[program]^ x) (Positive::[program]^ x) = Diff::[program]^ (Negative::[set] x) (Positive::[set] x) :=
      congr2!{N.Nat^ N.Nat^ Int^} Diff::[program]^
        (Negative::[program]^ x) (Negative::[set] x) (Positive::[program]^ x) (Positive::[set] x)
        (congr!{Negative::[Type]^ _} (\fun (f: _) => f x) _ _ Negative::[coherence]) (congr!{Positive::[Type]^ _} (\fun (f: _) => f x) _ _ Positive::[coherence]) \then
    \return trans!{Int^} _ _ _ componentsMatch
      (congr!{Diff::[Type]^ _} (\fun (f: _) => f (Negative::[set] x) (Positive::[set] x)) _ _ Diff::[coherence])
  };
  \coherence := \axiom:funext(Neg::[program]^, Neg::[set], matches),
}

\correspondence Add: (Int -> (Int -> Int)) {
  \program := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
  \bind v2: N.Nat <- (Positive::[program] x) \then
  \bind v4: N.Nat <- (Positive::[program] y) \then
  \bind v5: N.Nat <- NatOp.AddLoop::[run] (NatOp.AddState::running v2 v4) \then
  \bind v7: N.Nat <- (Negative::[program] x) \then
  \bind v9: N.Nat <- (Negative::[program] y) \then
  \bind v10: N.Nat <- NatOp.AddLoop::[run] (NatOp.AddState::running v7 v9) \then
  \bind v11: Int <- DiffLoop::[run] (DiffState::running v5 v10) \then
  \return v11
}))),
  \set := \fun (x: Int^) (y: Int^) => (Diff::[set] (NatOp.Add::[set] (Positive::[set] x)
    (Positive::[set] y)) (NatOp.Add::[set] (Negative::[set] x) (Negative::[set] y))),

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> Add::[program]^ x y = Add::[set] x y :=
  \block {
    \fun (x, y: Int^) \then
    \let positivesMatch:
      NatOp.Add::[program]^ (Positive::[program]^ x) (Positive::[program]^ y) =
        NatOp.Add::[program]^ (Positive::[set] x) (Positive::[set] y) :=
      congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add::[program]^
        (Positive::[program]^ x) (Positive::[set] x) (Positive::[program]^ y) (Positive::[set] y)
        (congr!{Positive::[Type]^ _} (\fun (f: _) => f x) _ _ Positive::[coherence]) (congr!{Positive::[Type]^ _} (\fun (f: _) => f y) _ _ Positive::[coherence]) \then
    \let negativesMatch:
      NatOp.Add::[program]^ (Negative::[program]^ x) (Negative::[program]^ y) =
        NatOp.Add::[program]^ (Negative::[set] x) (Negative::[set] y) :=
      congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add::[program]^
