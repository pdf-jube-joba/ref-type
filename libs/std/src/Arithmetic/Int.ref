\module SignImplementation {
  \definition T: \VType := \U((Int -> Int));

  \definition program: (Int -> Int) := (\cfun (x: Int) => \program {
    \bind v2: B.Bool <- ((\force IsZero.program) x) \then
    \bind v4: N.Nat <- ((\force Negative.program) x) \then
    \bind v6: B.Bool <- ((\force NatIsZero.program) v4) \then
    \bind v7: \U(Int -> (Int -> Int)) <- ((\force Choose.program) v6) \then
    \bind v8: \U(Int -> Int) <- (\force v7) (Int::ofNat (N.Nat::succ N.Nat::zero)) \then
    \bind v10: Int <- (\force v8) (Int::negSucc N.Nat::zero) \then
    \bind v11: \U(Int -> (Int -> Int)) <- ((\force Choose.program) v2) \then
    \bind v12: \U(Int -> Int) <- (\force v11) (Int::ofNat N.Nat::zero) \then
    \bind v14: Int <- (\force v12) v10 \then
    \return v14
  });

  \definition specification: T^ := \fun (x: Int^) => (Choose.specification (IsZero.specification x) (Int^::ofNat N.Nat^::zero)
      (Choose.specification (NatIsZero.specification (Negative.specification x)) (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc
      N.Nat^::zero)));

  \definition matches: \forall (x: Int^) -> program^ x = specification x :=
    \block {
      \fun (x: Int^) \then
      \let negativeTestMatches:
        NatIsZero.program^ (Negative.program^ x) = NatIsZero.specification (Negative.specification x) :=
        trans!{B.Bool^} _ _ _
          (congr!{N.Nat^ B.Bool^} NatIsZero.program^
            (Negative.program^ x) (Negative.specification x) (congr!{Negative.T^ _} (\fun (f: _) => f x) _ _ Negative.coherence))
          (congr!{NatIsZero.T^ _} (\fun (f: _) => f (Negative.specification x)) _ _ NatIsZero.coherence) \then
      \let innerArgumentsMatch:
        Choose.program^ (NatIsZero.program^ (Negative.program^ x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) =
        Choose.program^ (NatIsZero.specification (Negative.specification x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) :=
        congr3!{B.Bool^ Int^ Int^ Int^} Choose.program^
          (NatIsZero.program^ (Negative.program^ x)) (NatIsZero.specification (Negative.specification x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::ofNat (N.Nat^::succ N.Nat^::zero))
          (Int^::negSucc N.Nat^::zero) (Int^::negSucc N.Nat^::zero)
          negativeTestMatches (\refl(Int^::ofNat (N.Nat^::succ N.Nat^::zero)))
          (\refl(Int^::negSucc N.Nat^::zero)) \then
      \let innerMatches:
        Choose.program^ (NatIsZero.program^ (Negative.program^ x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) =
        Choose.specification (NatIsZero.specification (Negative.specification x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) :=
        trans!{Int^} _ _ _ innerArgumentsMatch
          (congr!{Choose.T^ _} (\fun (f: _) => f (NatIsZero.specification (Negative.specification x)) (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero)) _ _ Choose.coherence) \then
      \let outerArgumentsMatch:
        Choose.program^ (IsZero.program^ x) (Int^::ofNat N.Nat^::zero)
          (Choose.program^ (NatIsZero.program^ (Negative.program^ x))
            (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero)) =
        Choose.program^ (IsZero.specification x) (Int^::ofNat N.Nat^::zero)
          (Choose.specification (NatIsZero.specification (Negative.specification x))
            (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero)) :=
        congr3!{B.Bool^ Int^ Int^ Int^} Choose.program^
          _ _ _ _ _ _ (congr!{IsZero.T^ _} (\fun (f: _) => f x) _ _ IsZero.coherence)
          (\refl(Int^::ofNat N.Nat^::zero)) innerMatches \then
      \return trans!{Int^} _ _ _ outerArgumentsMatch
        (congr!{Choose.T^ _} (\fun (f: _) => f (IsZero.specification x) (Int^::ofNat N.Nat^::zero) (Choose.specification (NatIsZero.specification (Negative.specification x))
            (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero))) _ _ Choose.coherence)
    };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .SignImplementation[] \as SignParts;
\definition Sign: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := SignParts.T,
  program := \thunk (SignParts.program),
  specification := SignParts.specification,
  coherence := SignParts.coherence,
};

\module EvenImplementation {
  \definition T: \VType := \U((Int -> B.Bool));

  \definition program: (Int -> B.Bool) := (\cfun (x: Int) => \program {
    \bind v2: N.Nat <- ((\force NatAbs.program) x) \then
    \bind v4: B.Bool <- ((\force NatEven.program) v2) \then
    \return v4
  });

  \definition specification: T^ := \fun (x: Int^) => (NatEven.specification (NatAbs.specification x));

  \definition matches(x: Int^): program^ x = specification x := trans!{B.Bool^} _ _ _ (congr!{N.Nat^ B.Bool^} NatEven.program^ (NatAbs.program^ x) (NatAbs.specification x) (congr!{NatAbs.T^ _} (\fun (f: _) => f x) _ _ NatAbs.coherence))
      (congr!{NatEven.T^ _} (\fun (f: _) => f (NatAbs.specification x)) _ _ NatEven.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
