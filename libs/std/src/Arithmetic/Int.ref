  \set := \fun (x: Int^) (y: Int^) => (NatLtb::[set] (NatOp.Add::[set] (Positive::[set] x)
    (Negative::[set] y)) (NatOp.Add::[set] (Positive::[set] y) (Negative::[set] x))),

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> Ltb::[program]^ x y = Ltb::[set] x y :=
  \block {
    \fun (x, y: Int^) \then
    \let leftMatches:
      NatOp.Add::[program]^ (Positive::[program]^ x) (Negative::[program]^ y) = NatOp.Add::[program]^ (Positive::[set] x) (Negative::[set] y) :=
      congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add::[program]^
        (Positive::[program]^ x) (Positive::[set] x) (Negative::[program]^ y) (Negative::[set] y)
        (congr!{Positive::[Type]^ _} (\fun (f: _) => f x) _ _ Positive::[coherence]) (congr!{Negative::[Type]^ _} (\fun (f: _) => f y) _ _ Negative::[coherence]) \then
    \let rightMatches:
      NatOp.Add::[program]^ (Positive::[program]^ y) (Negative::[program]^ x) = NatOp.Add::[program]^ (Positive::[set] y) (Negative::[set] x) :=
      congr2!{N.Nat^ N.Nat^ N.Nat^} NatOp.Add::[program]^
        (Positive::[program]^ y) (Positive::[set] y) (Negative::[program]^ x) (Negative::[set] x)
        (congr!{Positive::[Type]^ _} (\fun (f: _) => f y) _ _ Positive::[coherence]) (congr!{Negative::[Type]^ _} (\fun (f: _) => f x) _ _ Negative::[coherence]) \then
    \let argumentsMatch:
      NatLtb::[program]^ (NatOp.Add::[program]^ (Positive::[program]^ x) (Negative::[program]^ y)) (NatOp.Add::[program]^ (Positive::[program]^ y) (Negative::[program]^ x)) =
      NatLtb::[program]^ (NatOp.Add::[program]^ (Positive::[set] x) (Negative::[set] y)) (NatOp.Add::[program]^ (Positive::[set] y) (Negative::[set] x)) :=
      congr2!{N.Nat^ N.Nat^ B.Bool^} NatLtb::[program]^ _ _ _ _ leftMatches rightMatches \then
    \return trans!{B.Bool^} _ _ _
      (trans!{B.Bool^} _ _ _ argumentsMatch
      (congr!{NatLtb::[Type]^ _} (\fun (f: _) => f (NatOp.Add::[program]^ (Positive::[set] x) (Negative::[set] y)) (NatOp.Add::[program]^ (Positive::[set] y) (Negative::[set] x))) _ _ NatLtb::[coherence]))
      (congr!{NatOp.Add::[Type]^ B.Bool^}
      (\fun (addition: _) => (NatLtb::[set] (addition (Positive::[set] x)
    (Negative::[set] y)) (addition (Positive::[set] y) (Negative::[set] x)))) _ _ NatOp.Add::[coherence])
  };
  \coherence := \axiom:funext(Ltb::[program]^, Ltb::[set], \fun (arg0: Int^) => \axiom:funext(Ltb::[program]^ arg0, Ltb::[set] arg0, \fun (arg1: Int^) => matches arg0 arg1)),
}

\correspondence Min: (Int -> (Int -> Int)) {
  \program := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
  \bind v1: \U(Int -> B.Bool) <- (Leb::[program] x) \then
  \bind v3: B.Bool <- (\force v1) y \then
  \bind v4: \U(Int -> (Int -> Int)) <- (Choose::[program] v3) \then
  \bind v5: \U(Int -> Int) <- (\force v4) x \then
  \bind v7: Int <- (\force v5) y \then
  \return v7
}))),
  \set := \fun (x: Int^) (y: Int^) => (Choose::[set] (Leb::[set] x y) x y),

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> Min::[program]^ x y = Min::[set] x y :=
  \block {
    \fun (x, y: Int^) \then
    \let argumentsMatch:
      Choose::[program]^ (Leb::[program]^ x y) x y = Choose::[program]^ (Leb::[set] x y) x y :=
      congr3!{B.Bool^ Int^ Int^ Int^} Choose::[program]^
        (Leb::[program]^ x y) (Leb::[set] x y) x x y y
        (congr!{Leb::[Type]^ _} (\fun (f: _) => f x y) _ _ Leb::[coherence]) (\refl(x)) (\refl(y)) \then
    \return trans!{Int^} _ _ _ argumentsMatch (congr!{Choose::[Type]^ _} (\fun (f: _) => f (Leb::[set] x y) x y) _ _ Choose::[coherence])
  };
  \coherence := \axiom:funext(Min::[program]^, Min::[set], \fun (arg0: Int^) => \axiom:funext(Min::[program]^ arg0, Min::[set] arg0, \fun (arg1: Int^) => matches arg0 arg1)),
}

\correspondence Max: (Int -> (Int -> Int)) {
  \program := (\cfun (x: Int) => \return(\thunk(\cfun (y: Int) => \program {
  \bind v1: \U(Int -> B.Bool) <- (Leb::[program] x) \then
  \bind v3: B.Bool <- (\force v1) y \then
  \bind v4: \U(Int -> (Int -> Int)) <- (Choose::[program] v3) \then
  \bind v5: \U(Int -> Int) <- (\force v4) y \then
  \bind v7: Int <- (\force v5) x \then
  \return v7
}))),
  \set := \fun (x: Int^) (y: Int^) => (Choose::[set] (Leb::[set] x y) y x),

  \definition matches: \forall (x: Int^) -> \forall (y: Int^) -> Max::[program]^ x y = Max::[set] x y :=
  \block {
    \fun (x, y: Int^) \then
    \let argumentsMatch:
      Choose::[program]^ (Leb::[program]^ x y) y x = Choose::[program]^ (Leb::[set] x y) y x :=
      congr3!{B.Bool^ Int^ Int^ Int^} Choose::[program]^
        (Leb::[program]^ x y) (Leb::[set] x y) y y x x
        (congr!{Leb::[Type]^ _} (\fun (f: _) => f x y) _ _ Leb::[coherence]) (\refl(y)) (\refl(x)) \then
    \return trans!{Int^} _ _ _ argumentsMatch (congr!{Choose::[Type]^ _} (\fun (f: _) => f (Leb::[set] x y) y x) _ _ Choose::[coherence])
  };
  \coherence := \axiom:funext(Max::[program]^, Max::[set], \fun (arg0: Int^) => \axiom:funext(Max::[program]^ arg0, Max::[set] arg0, \fun (arg1: Int^) => matches arg0 arg1)),
}

\correspondence Sign: (Int -> Int) {
  \program := (\cfun (x: Int) => \program {
  \bind v2: B.Bool <- (IsZero::[program] x) \then
  \bind v4: N.Nat <- (Negative::[program] x) \then
  \bind v6: B.Bool <- (NatIsZero::[program] v4) \then
  \bind v7: \U(Int -> (Int -> Int)) <- (Choose::[program] v6) \then
  \bind v8: \U(Int -> Int) <- (\force v7) (Int::ofNat (N.Nat::succ N.Nat::zero)) \then
  \bind v10: Int <- (\force v8) (Int::negSucc N.Nat::zero) \then
  \bind v11: \U(Int -> (Int -> Int)) <- (Choose::[program] v2) \then
  \bind v12: \U(Int -> Int) <- (\force v11) (Int::ofNat N.Nat::zero) \then
  \bind v14: Int <- (\force v12) v10 \then
  \return v14
}),
  \set := \fun (x: Int^) => (Choose::[set] (IsZero::[set] x) (Int^::ofNat N.Nat^::zero)
    (Choose::[set] (NatIsZero::[set] (Negative::[set] x)) (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc
    N.Nat^::zero))),

  \definition matches: \forall (x: Int^) -> Sign::[program]^ x = Sign::[set] x :=
  \block {
    \fun (x: Int^) \then
    \let negativeTestMatches:
      NatIsZero::[program]^ (Negative::[program]^ x) = NatIsZero::[set] (Negative::[set] x) :=
      trans!{B.Bool^} _ _ _
        (congr!{N.Nat^ B.Bool^} NatIsZero::[program]^
          (Negative::[program]^ x) (Negative::[set] x) (congr!{Negative::[Type]^ _} (\fun (f: _) => f x) _ _ Negative::[coherence]))
        (congr!{NatIsZero::[Type]^ _} (\fun (f: _) => f (Negative::[set] x)) _ _ NatIsZero::[coherence]) \then
    \let innerArgumentsMatch:
      Choose::[program]^ (NatIsZero::[program]^ (Negative::[program]^ x))
        (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) =
      Choose::[program]^ (NatIsZero::[set] (Negative::[set] x))
        (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) :=
      congr3!{B.Bool^ Int^ Int^ Int^} Choose::[program]^
        (NatIsZero::[program]^ (Negative::[program]^ x)) (NatIsZero::[set] (Negative::[set] x))
        (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::ofNat (N.Nat^::succ N.Nat^::zero))
        (Int^::negSucc N.Nat^::zero) (Int^::negSucc N.Nat^::zero)
        negativeTestMatches (\refl(Int^::ofNat (N.Nat^::succ N.Nat^::zero)))
        (\refl(Int^::negSucc N.Nat^::zero)) \then
    \let innerMatches:
      Choose::[program]^ (NatIsZero::[program]^ (Negative::[program]^ x))
        (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) =
      Choose::[set] (NatIsZero::[set] (Negative::[set] x))
        (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero) :=
      trans!{Int^} _ _ _ innerArgumentsMatch
        (congr!{Choose::[Type]^ _} (\fun (f: _) => f (NatIsZero::[set] (Negative::[set] x)) (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero)) _ _ Choose::[coherence]) \then
    \let outerArgumentsMatch:
      Choose::[program]^ (IsZero::[program]^ x) (Int^::ofNat N.Nat^::zero)
        (Choose::[program]^ (NatIsZero::[program]^ (Negative::[program]^ x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero)) =
      Choose::[program]^ (IsZero::[set] x) (Int^::ofNat N.Nat^::zero)
        (Choose::[set] (NatIsZero::[set] (Negative::[set] x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero)) :=
      congr3!{B.Bool^ Int^ Int^ Int^} Choose::[program]^
        _ _ _ _ _ _ (congr!{IsZero::[Type]^ _} (\fun (f: _) => f x) _ _ IsZero::[coherence])
        (\refl(Int^::ofNat N.Nat^::zero)) innerMatches \then
    \return trans!{Int^} _ _ _ outerArgumentsMatch
      (congr!{Choose::[Type]^ _} (\fun (f: _) => f (IsZero::[set] x) (Int^::ofNat N.Nat^::zero) (Choose::[set] (NatIsZero::[set] (Negative::[set] x))
          (Int^::ofNat (N.Nat^::succ N.Nat^::zero)) (Int^::negSucc N.Nat^::zero))) _ _ Choose::[coherence])
  };
  \coherence := \axiom:funext(Sign::[program]^, Sign::[set], matches),
}

\correspondence Even: (Int -> B.Bool) {
  \program := (\cfun (x: Int) => \program {
  \bind v2: N.Nat <- (NatAbs::[program] x) \then
  \bind v4: B.Bool <- (NatEven::[program] v2) \then
  \return v4
}),
  \set := \fun (x: Int^) => (NatEven::[set] (NatAbs::[set] x)),

  \definition matches (x: Int^): Even::[program]^ x = Even::[set] x := trans!{B.Bool^} _ _ _ (congr!{N.Nat^ B.Bool^} NatEven::[program]^ (NatAbs::[program]^ x) (NatAbs::[set] x) (congr!{NatAbs::[Type]^ _} (\fun (f: _) => f x) _ _ NatAbs::[coherence]))
    (congr!{NatEven::[Type]^ _} (\fun (f: _) => f (NatAbs::[set] x)) _ _ NatEven::[coherence]);
  \coherence := \axiom:funext(Even::[program]^, Even::[set], matches),
}

\correspondence Odd: (Int -> B.Bool) {
  \program := (\cfun (x: Int) => \program {
  \bind v2: N.Nat <- (NatAbs::[program] x) \then
  \bind v4: B.Bool <- (NatOdd::[program] v2) \then
  \return v4
}),
  \set := \fun (x: Int^) => (NatOdd::[set] (NatAbs::[set] x)),

  \definition matches (x: Int^): Odd::[program]^ x = Odd::[set] x := trans!{B.Bool^} _ _ _ (congr!{N.Nat^ B.Bool^} NatOdd::[program]^ (NatAbs::[program]^ x) (NatAbs::[set] x) (congr!{NatAbs::[Type]^ _} (\fun (f: _) => f x) _ _ NatAbs::[coherence]))
    (congr!{NatOdd::[Type]^ _} (\fun (f: _) => f (NatAbs::[set] x)) _ _ NatOdd::[coherence]);
  \coherence := \axiom:funext(Odd::[program]^, Odd::[set], matches),
}

/* Apply a Sign::[program] after computing the magnitude once. */
\correspondence PowerSign: (B.Bool -> (N.Nat -> Int)) {
  \program := (\cfun (test: B.Bool) => \return(\thunk(\cfun (magnitude: N.Nat) => \match test \in B.Bool \with {
    | false : \return(Int::ofNat magnitude)
    | true : (NegOfNat::[program] magnitude)
    }))),
  \set := \fun (test: B.Bool^) (magnitude: N.Nat^) =>
  B.ite Int^ test (NegOfNat::[set] magnitude) (Int^::ofNat magnitude),

  \definition matches: \forall (test: B.Bool^) -> \forall (magnitude: N.Nat^) ->
  PowerSign::[program]^ test magnitude = PowerSign::[set] test magnitude :=
  \induction (test: B.Bool^) \return \forall (magnitude: N.Nat^) ->
    PowerSign::[program]^ test magnitude = PowerSign::[set] test magnitude \with {
    | false : (\fun (magnitude: N.Nat^) => \refl(Int^::ofNat magnitude))
    | true : (\fun (n: _) => congr!{NegOfNat::[Type]^ _} (\fun (f: NegOfNat::[Type]^) => f n) _ _ NegOfNat::[coherence])
    };
  \coherence := \axiom:funext(PowerSign::[program]^, PowerSign::[set], \fun (arg0: B.Bool^) => \axiom:funext(PowerSign::[program]^ arg0, PowerSign::[set] arg0, \fun (arg1: N.Nat^) => matches arg0 arg1)),
}

\definition powerSignTestMatches (n, magnitude: N.Nat^):
  PowerSign::[program]^ (NatOdd::[program]^ n) magnitude = PowerSign::[set] (NatOdd::[set] n) magnitude :=
    \idelim NatOdd::[program]^ n = NatOdd::[set] n \with test: B.Bool^ =>
      PowerSign::[program]^ (NatOdd::[program]^ n) magnitude = PowerSign::[set] test magnitude
    \by { base: congr!{PowerSign::[Type]^ _} (\fun (f: _) => f (NatOdd::[program]^ n) magnitude) _ _ PowerSign::[coherence], equality: congr!{NatOdd::[Type]^ _} (\fun (f: _) => f n) _ _ NatOdd::[coherence] };

\correspondence Pow: (Int -> (N.Nat -> Int)) {
  \program := (\cfun (x: Int) => \return(\thunk(\cfun (n: N.Nat) => \match x \in Int \with {
    | ofNat a : \program {
  \bind f: \U(N.Nat -> N.Nat) <- (NatOp.Pow::[program] a) \then
  \bind magnitude: N.Nat <- (\force f) n \then
  \return Int::ofNat magnitude
}
    | negSucc a : \program {
  \bind f: \U(N.Nat -> N.Nat) <- (NatOp.Pow::[program] (N.Nat::succ a)) \then
  \bind magnitude: N.Nat <- (\force f) n \then
  \bind test: B.Bool <- (NatOdd::[program] n) \then
  \bind sign: \U(N.Nat -> Int) <- (PowerSign::[program] test) \then
  \bind result: Int <- (\force sign) magnitude \then
  \return result
}
    }))),
  \set := \induction (x: Int^) \return N.Nat^ -> Int^ \with {
    | ofNat : (\fun (a, n: N.Nat^) => Int^::ofNat (NatOp.Pow::[program]^ a n))
    | negSucc : (\fun (a, n: N.Nat^) => PowerSign::[set] (NatOdd::[set] n) (NatOp.Pow::[program]^ (N.Nat^::succ a) n))
    },

  \definition matches: \forall (x: Int^) -> \forall (n: N.Nat^) -> Pow::[program]^ x n = Pow::[set] x n :=
  \induction (x: Int^) \return \forall (n: N.Nat^) -> Pow::[program]^ x n = Pow::[set] x n \with {
    | ofNat : (\fun (a, n: N.Nat^) => \refl(Int^::ofNat (NatOp.Pow::[program]^ a n)))
    | negSucc : (\fun (a, n: N.Nat^) => powerSignTestMatches n (NatOp.Pow::[program]^ (N.Nat^::succ a) n))
    };
  \coherence := \axiom:funext(Pow::[program]^, Pow::[set], \fun (arg0: Int^) => \axiom:funext(Pow::[program]^ arg0, Pow::[set] arg0, \fun (arg1: N.Nat^) => matches arg0 arg1)),
}

\module Math;

/* Integer laws used by constructions such as the rationals. */
\import .Math[] \as IM;
\import IM.Ring[] \as IR;
\import IM.Specification[] \as IS;

\definition zeroNat: Nat := N.Nat^::zero;
\definition oneNat: Nat := N.Nat^::succ N.Nat^::zero;
/* Integer operations on the canonical OfNat::[program]/negSucc carrier. */
\definition Integer: \Set := Int^;
\definition integer (a, b: Nat): Integer := IM.normalize (pair a b);
\definition zeroInteger: Integer := integer zeroNat zeroNat;
\definition oneInteger: Integer := integer oneNat zeroNat;
\definition negInteger (x: Integer): Integer := IM.normalize (IM.negRep (IM.representative x));
\definition addInteger (x, y: Integer): Integer := IM.normalize (IM.addRep (IM.representative x) (IM.representative y));
\definition mulInteger (x, y: Integer): Integer := IM.normalize (IM.mulRep (IM.representative x) (IM.representative y));
\definition subInteger (x, y: Integer): Integer := addInteger x (negInteger y);
\definition scaleInteger (x: Integer) (n: Nat): Integer :=
    IM.normalize (IM.scaleRep (IM.representative x) n);

\math-macro int_add($x, "+", $y) := addInteger $x $y;
\math-macro int_mul($x, "*", $y) := mulInteger $x $y;

/* Representative relations are used only at the normalization boundary. */
\definition normalizedRepresentative (x: Difference):
  IM.Equivalent (IM.representative (IM.normalize x)) x :=
  IM.equivalentSym _ _ (IM.representativeNormalize x);
\definition eqOfRepresentatives (x, y: Integer)
  (xy: IM.Equivalent (IM.representative x) (IM.representative y)): x = y :=
  eq_reason!{
    x "=" { IM.normalize (IM.representative x) }
      "by" { sym!{Integer} _ _ (diffCanonical x) }
      "=" { IM.normalize (IM.representative y) }
      "by" { IM.normalizeRespects _ _ xy }
      "=" y "by" { diffCanonical y }
  };
\definition integerEqRefl (x: Integer): x = x := \refl(x);
\definition integerEqSym (x, y: Integer): x = y -> y = x := sym!{Integer} x y;
\definition integerEqTrans (x, y, z: Integer): x = y -> y = z -> x = z :=
  trans!{Integer} x y z;
\definition integerEqOfFields (x, y: Integer)
  (positive: Positive::[set] x = Positive::[set] y)
  (negative: Negative::[set] x = Negative::[set] y): x = y :=
  eqOfRepresentatives x y
    (IM.equivalentOfFields (IM.representative x) (IM.representative y) positive negative);
\definition ofNatAsInteger (n: Nat): Int^::ofNat n = integer n zeroNat :=
  integerEqOfFields (Int^::ofNat n) (integer n zeroNat) (\refl(n)) (\refl(zeroNat));
\definition negSuccAsNegNatural (n: Nat):
  Int^::negSucc n = negInteger (integer (N.Nat^::succ n) zeroNat) :=
  integerEqOfFields (Int^::negSucc n) (negInteger (integer (N.Nat^::succ n) zeroNat))
    (\refl(zeroNat)) (\refl(N.Nat^::succ n));
\definition integerEqOfParts (a, b, c, d: Nat) (ac: a = c) (bd: b = d):
  integer a b = integer c d := congr2!{Nat Nat Integer} integer a c b d ac bd;

\definition addIntegerRep (x, y: Integer):
  IM.Equivalent (IM.representative (addInteger x y))
    (IM.addRep (IM.representative x) (IM.representative y)) :=
  normalizedRepresentative (IM.addRep (IM.representative x) (IM.representative y));
\definition negIntegerRep (x: Integer):
  IM.Equivalent (IM.representative (negInteger x)) (IM.negRep (IM.representative x)) :=
  normalizedRepresentative (IM.negRep (IM.representative x));
\definition mulIntegerRep (x, y: Integer):
  IM.Equivalent (IM.representative (mulInteger x y))
    (IM.mulRep (IM.representative x) (IM.representative y)) :=
  normalizedRepresentative (IM.mulRep (IM.representative x) (IM.representative y));
\definition scaleIntegerRep (x: Integer) (n: Nat):
  IM.Equivalent (IM.representative (scaleInteger x n)) (IM.scaleRep (IM.representative x) n) :=
  normalizedRepresentative (IM.scaleRep (IM.representative x) n);

\definition addIntegerRespects (x, y, u, v: Integer) (xy: x = y) (uv: u = v):
  \(x "+" u\) = \(y "+" v\) := congr2!{Integer Integer Integer} addInteger x y u v xy uv;
\definition negIntegerRespects (x, y: Integer) (xy: x = y): negInteger x = negInteger y :=
  congr!{Integer Integer} negInteger x y xy;
\definition subIntegerRespects (x, y, u, v: Integer) (xy: x = y) (uv: u = v):
  subInteger x u = subInteger y v := congr2!{Integer Integer Integer} subInteger x y u v xy uv;
\definition mulIntegerRespects (x, y, u, v: Integer) (xy: x = y) (uv: u = v):
  \(x "*" u\) = \(y "*" v\) := congr2!{Integer Integer Integer} mulInteger x y u v xy uv;
\definition scaleIntegerRespects (x, y: Integer) (n: Nat) (xy: x = y):
  scaleInteger x n = scaleInteger y n :=
  congr!{Integer Integer} (\fun (z: Integer) => scaleInteger z n) x y xy;

\definition addIntegerZeroLeft (x: Integer): \(zeroInteger "+" x\) = x :=
  eq_reason!{
    \(zeroInteger "+" x\) "=" { IM.normalize (IM.representative x) }
    "by" { IM.normalizeRespects _ _ (IR.addIntegerZeroLeft (IM.representative x)) }
    "=" x "by" { diffCanonical x }
  };
\definition addIntegerZeroRight (x: Integer): \(x "+" zeroInteger\) = x :=
  eq_reason!{
    \(x "+" zeroInteger\) "=" { IM.normalize (IM.representative x) }
    "by" { IM.normalizeRespects _ _ (IR.addIntegerZeroRight (IM.representative x)) }
    "=" x "by" { diffCanonical x }
  };
\definition addIntegerComm (x, y: Integer): \(x "+" y\) = \(y "+" x\) :=
  IM.normalizeRespects _ _ (IR.addIntegerComm (IM.representative x) (IM.representative y));
\definition addIntegerAssoc (x, y, z: Integer):
  \((x "+" y) "+" z\) = \(x "+" (y "+" z)\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \let rz: _ := IM.representative z \then
    \return eq_reason!{
      \((x "+" y) "+" z\)
      "=" { IM.normalize (IM.addRep (IM.addRep rx ry) rz) }
      "by" { IM.normalizeRespects _ _
        (IM.addRepRespects _ _ _ _ (addIntegerRep x y) (IM.equivalentRefl rz)) }
      "=" { IM.normalize (IM.addRep rx (IM.addRep ry rz)) }
      "by" { IM.normalizeRespects _ _ (IR.addIntegerAssoc rx ry rz) }
      "=" \(x "+" (y "+" z)\)
      "by" { IM.normalizeRespects _ _
        (IM.addRepRespects _ _ _ _ (IM.equivalentRefl rx)
          (IM.equivalentSym _ _ (addIntegerRep y z))) }
    }
  };
\definition mulIntegerComm (x, y: Integer): \(x "*" y\) = \(y "*" x\) :=
  IM.normalizeRespects _ _ (IR.mulIntegerComm (IM.representative x) (IM.representative y));

\definition scaleIntegerZero (n: Nat): scaleInteger zeroInteger n = zeroInteger :=
  IM.normalizeRespects _ _ (IR.scaleIntegerZero n);
\definition scaleIntegerSwap (x: Integer) (a, b: Nat):
  scaleInteger (scaleInteger x a) b = scaleInteger (scaleInteger x b) a :=
  \block {
    \let rx: _ := IM.representative x \then
    \return eq_reason!{
      { scaleInteger (scaleInteger x a) b }
      "=" { IM.normalize (IM.scaleRep (IM.scaleRep rx a) b) }
      "by" { IM.normalizeRespects _ _ (IM.scaleRepRespects _ _ b (scaleIntegerRep x a)) }
      "=" { IM.normalize (IM.scaleRep (IM.scaleRep rx b) a) }
      "by" { IM.normalizeRespects _ _ (IR.scaleIntegerSwap rx a b) }
      "=" { scaleInteger (scaleInteger x b) a }
      "by" { IM.normalizeRespects _ _
        (IM.scaleRepRespects _ _ a (IM.equivalentSym _ _ (scaleIntegerRep x b))) }
    }
  };
\definition scaleIntegerCancelPositive (x, y: Integer) (k: Nat)
  (xy: scaleInteger x (N.Nat^::succ k) = scaleInteger y (N.Nat^::succ k)): x = y :=
  eqOfRepresentatives x y
    (IR.scaleIntegerCancelPositive (IM.representative x) (IM.representative y) k
      (IM.equivalentOfNormalize
        (IM.scaleRep (IM.representative x) (N.Nat^::succ k))
        (IM.scaleRep (IM.representative y) (N.Nat^::succ k)) xy));
\definition scaleIntegerNatural (a, n: Nat):
  scaleInteger (integer a zeroNat) n = integer (NatOp.Mul::[set] a n) zeroNat :=
  IM.normalizeRespects _ _
    (IM.equivalentOfFields (IM.scaleRep (pair a zeroNat) n)
      (pair (NatOp.Mul::[set] a n) zeroNat) (\refl(NatOp.Mul::[set] a n)) (NL.mulZeroLeft n));
\definition addIntegerNatural (a, b: Nat):
  \({ integer a zeroNat } "+" { integer b zeroNat }\) = integer (NatOp.Add::[set] a b) zeroNat :=
  \refl(integer (NatOp.Add::[set] a b) zeroNat);

\definition mulIntegerAssoc (x, y, z: Integer):
  \((x "*" y) "*" z\) = \(x "*" (y "*" z)\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \let rz: _ := IM.representative z \then
    \return eq_reason!{
      \((x "*" y) "*" z\)
      "=" { IM.normalize (IM.mulRep (IM.mulRep rx ry) rz) }
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (mulIntegerRep x y) (IM.equivalentRefl rz)) }
      "=" { IM.normalize (IM.mulRep rx (IM.mulRep ry rz)) }
      "by" { IM.normalizeRespects _ _ (IR.mulIntegerAssoc rx ry rz) }
      "=" \(x "*" (y "*" z)\)
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (IM.equivalentRefl rx)
          (IM.equivalentSym _ _ (mulIntegerRep y z))) }
    }
  };
\definition mulIntegerDistribLeft (x, y, z: Integer):
  \(x "*" (y "+" z)\) = \((x "*" y) "+" (x "*" z)\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \let rz: _ := IM.representative z \then
    \return eq_reason!{
      \(x "*" (y "+" z)\)
      "=" { IM.normalize (IM.mulRep rx (IM.addRep ry rz)) }
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (IM.equivalentRefl rx) (addIntegerRep y z)) }
      "=" { IM.normalize (IM.addRep (IM.mulRep rx ry) (IM.mulRep rx rz)) }
      "by" { IM.normalizeRespects _ _ (IR.mulIntegerDistribLeft rx ry rz) }
      "=" \((x "*" y) "+" (x "*" z)\)
      "by" { IM.normalizeRespects _ _
        (IM.addRepRespects _ _ _ _
          (IM.equivalentSym _ _ (mulIntegerRep x y))
          (IM.equivalentSym _ _ (mulIntegerRep x z))) }
    }
  };
\definition mulIntegerDistribRight (x, y, z: Integer):
  \((x "+" y) "*" z\) = \((x "*" z) "+" (y "*" z)\) :=
  eq_reason!{
    \((x "+" y) "*" z\)
    "=" \(z "*" (x "+" y)\) "by" { mulIntegerComm \(x "+" y\) z }
    "=" \((z "*" x) "+" (z "*" y)\) "by" { mulIntegerDistribLeft z x y }
    "=" \((x "*" z) "+" (y "*" z)\)
    "by" { congr2!{Integer Integer Integer} addInteger _ _ _ _
      (mulIntegerComm z x) (mulIntegerComm z y) }
  };
\definition mulIntegerCongRight (x, y, z: Integer) (yz: y = z):
  \(x "*" y\) = \(x "*" z\) := congr!{Integer Integer} (mulInteger x) y z yz;
\definition mulIntegerInterchange (a, b, c, d: Integer):
  \((a "*" b) "*" (c "*" d)\) = \((a "*" c) "*" (b "*" d)\) :=
  eq_reason!{
    \((a "*" b) "*" (c "*" d)\)
    "=" \(a "*" (b "*" (c "*" d))\) "by" { mulIntegerAssoc a b \(c "*" d\) }
    "=" \(a "*" ((b "*" c) "*" d)\)
    "by" { congr!{Integer Integer} (mulInteger a) _ _ (sym!{Integer} _ _ (mulIntegerAssoc b c d)) }
    "=" \(a "*" ((c "*" b) "*" d)\)
    "by" { congr!{Integer Integer} (\fun (n: Integer) => \(a "*" (n "*" d)\))
      _ _ (mulIntegerComm b c) }
    "=" \(a "*" (c "*" (b "*" d))\)
    "by" { congr!{Integer Integer} (mulInteger a) _ _ (mulIntegerAssoc c b d) }
    "=" \((a "*" c) "*" (b "*" d)\)
    "by" { sym!{Integer} _ _ (mulIntegerAssoc a c \(b "*" d\)) }
  };

\definition negIntegerInvolutive (x: Integer): negInteger (negInteger x) = x :=
  eq_reason!{
    { negInteger (negInteger x) }
    "=" { IM.normalize (IM.negRep (IM.negRep (IM.representative x))) }
    "by" { IM.normalizeRespects _ _ (IM.negRepRespects _ _ (negIntegerRep x)) }
    "=" x "by" { diffCanonical x }
  };
\definition addIntegerNegRight (x: Integer): \(x "+" { negInteger x }\) = zeroInteger :=
  eq_reason!{
    \(x "+" { negInteger x }\)
    "=" { IM.normalize (IM.addRep (IM.representative x) (IM.negRep (IM.representative x))) }
    "by" { IM.normalizeRespects _ _
      (IM.addRepRespects _ _ _ _ (IM.equivalentRefl (IM.representative x)) (negIntegerRep x)) }
    "=" zeroInteger "by" { IM.normalizeRespects _ _ (IR.addIntegerNegRight (IM.representative x)) }
  };
\definition addIntegerNegLeft (x: Integer): \({ negInteger x } "+" x\) = zeroInteger :=
  eq_reason!{
    \({ negInteger x } "+" x\) "=" \(x "+" { negInteger x }\)
    "by" { addIntegerComm (negInteger x) x }
    "=" zeroInteger "by" { addIntegerNegRight x }
  };
\definition mulIntegerZeroRight (x: Integer): \(x "*" zeroInteger\) = zeroInteger :=
  IM.normalizeRespects _ _ (IR.mulIntegerZeroRight (IM.representative x));
\definition mulIntegerZeroLeft (x: Integer): \(zeroInteger "*" x\) = zeroInteger :=
  eq_reason!{
    \(zeroInteger "*" x\) "=" \(x "*" zeroInteger\) "by" { mulIntegerComm zeroInteger x }
    "=" zeroInteger "by" { mulIntegerZeroRight x }
  };
\definition mulIntegerOneRight (x: Integer): \(x "*" oneInteger\) = x :=
  eq_reason!{
    \(x "*" oneInteger\) "=" { IM.normalize (IM.representative x) }
    "by" { IM.normalizeRespects _ _ (IR.mulIntegerOneRight (IM.representative x)) }
    "=" x "by" { diffCanonical x }
  };
\definition mulIntegerOneLeft (x: Integer): \(oneInteger "*" x\) = x :=
  eq_reason!{
    \(oneInteger "*" x\) "=" \(x "*" oneInteger\) "by" { mulIntegerComm oneInteger x }
    "=" x "by" { mulIntegerOneRight x }
  };
\definition mulIntegerNegLeft (x, y: Integer):
  \({ negInteger x } "*" y\) = negInteger \(x "*" y\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \return eq_reason!{
      \({ negInteger x } "*" y\)
      "=" { IM.normalize (IM.mulRep (IM.negRep rx) ry) }
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (negIntegerRep x) (IM.equivalentRefl ry)) }
      "=" { IM.normalize (IM.negRep (IM.mulRep rx ry)) }
      "by" { IM.normalizeRespects _ _ (IR.mulIntegerNegLeft rx ry) }
      "=" { negInteger \(x "*" y\) }
      "by" { IM.normalizeRespects _ _
        (IM.negRepRespects _ _ (IM.equivalentSym _ _ (mulIntegerRep x y))) }
    }
  };
\definition mulIntegerNegRight (x, y: Integer):
  \(x "*" { negInteger y }\) = negInteger \(x "*" y\) :=
  eq_reason!{
    \(x "*" { negInteger y }\)
    "=" \({ negInteger y } "*" x\) "by" { mulIntegerComm x (negInteger y) }
    "=" { negInteger \(y "*" x\) } "by" { mulIntegerNegLeft y x }
    "=" { negInteger \(x "*" y\) }
    "by" { congr!{Integer Integer} negInteger _ _ (mulIntegerComm y x) }
  };

\definition mulIntegerNatural (x: Integer) (n: Nat):
  \(x "*" { integer n zeroNat }\) = scaleInteger x n :=
  IM.normalizeRespects _ _
    (IM.equivalentOfFields
      (IM.mulRep (IM.representative x) (pair n zeroNat))
      (IM.scaleRep (IM.representative x) n)
      (\refl(NatOp.Mul::[set] (Positive::[set] x) n))
      (NL.addZeroLeft (NatOp.Mul::[set] (Negative::[set] x) n)));
\definition addIntegerSubCancelRight (x, y: Integer):
  \((x "+" { negInteger y }) "+" y\) = x :=
  eq_reason!{
    \((x "+" { negInteger y }) "+" y\)
    "=" \(x "+" ({ negInteger y } "+" y)\) "by" { addIntegerAssoc x (negInteger y) y }
    "=" \(x "+" zeroInteger\)
    "by" { congr!{Integer Integer} (addInteger x) _ _ (addIntegerNegLeft y) }
    "=" x "by" { addIntegerZeroRight x }
  };
\definition scaleIntegerMulRight (x, y: Integer) (n: Nat):
  scaleInteger \(x "*" y\) n = \({ scaleInteger x n } "*" y\) :=
  \block {
    \let k: _ := integer n zeroNat \then
    \return eq_reason!{
      { scaleInteger \(x "*" y\) n }
      "=" \((x "*" y) "*" k\) "by" { sym!{Integer} _ _ (mulIntegerNatural \(x "*" y\) n) }
      "=" \(x "*" (y "*" k)\) "by" { mulIntegerAssoc x y k }
      "=" \(x "*" (k "*" y)\)
      "by" { congr!{Integer Integer} (mulInteger x) _ _ (mulIntegerComm y k) }
      "=" \((x "*" k) "*" y\) "by" { sym!{Integer} _ _ (mulIntegerAssoc x k y) }
      "=" \({ scaleInteger x n } "*" y\)
      "by" { congr!{Integer Integer} (\fun (v: Integer) => \(v "*" y\)) _ _ (mulIntegerNatural x n) }
    }
  };
\definition integerSuccAsAdd (n: Nat):
  integer (N.Nat^::succ n) zeroNat = \(oneInteger "+" { integer n zeroNat }\) :=
  eq_reason!{
    { integer (N.Nat^::succ n) zeroNat }
    "=" { integer (NatOp.Add::[set] oneNat n) zeroNat }
    "by" { congr!{Nat Integer} (\fun (k: Nat) => integer k zeroNat) _ _
      (sym!{Nat} _ _ (eq_reason!{
        { NatOp.Add::[set] oneNat n } "=" { N.Nat^::succ (NatOp.Add::[set] zeroNat n) }
        "by" { NL.addSuccLeft zeroNat n }
        "=" { N.Nat^::succ n } "by" { NatOp.succCong _ _ (NL.addZeroLeft n) }
      })) }
    "=" \(oneInteger "+" { integer n zeroNat }\)
    "by" { sym!{Integer} _ _ (addIntegerNatural oneNat n) }
  };
\definition scaleIntegerSucc (x: Integer) (n: Nat):
  scaleInteger x (N.Nat^::succ n) = \(x "+" { scaleInteger x n }\) :=
  eq_reason!{
    { scaleInteger x (N.Nat^::succ n) }
    "=" \(x "*" { integer (N.Nat^::succ n) zeroNat }\)
    "by" { sym!{Integer} _ _ (mulIntegerNatural x (N.Nat^::succ n)) }
    "=" \(x "*" (oneInteger "+" { integer n zeroNat })\)
    "by" { congr!{Integer Integer} (mulInteger x) _ _ (integerSuccAsAdd n) }
    "=" \((x "*" oneInteger) "+" (x "*" { integer n zeroNat })\)
    "by" { mulIntegerDistribLeft x oneInteger (integer n zeroNat) }
    "=" \(x "+" { scaleInteger x n }\)
    "by" { congr2!{Integer Integer Integer} addInteger _ _ _ _
      (mulIntegerOneRight x) (mulIntegerNatural x n) }
  };
\definition scaleIntegerByZero (x: Integer): scaleInteger x zeroNat = zeroInteger :=
  eq_reason!{
    { scaleInteger x zeroNat } "=" \(x "*" zeroInteger\)
    "by" { sym!{Integer} _ _ (mulIntegerNatural x zeroNat) }
    "=" zeroInteger "by" { mulIntegerZeroRight x }
  };

\definition IntegerLt: Integer -> Integer -> \Prop := IS.Lt;
\definition IntegerNonZero (x: Integer): \Prop := not!{{ x = zeroInteger }};
\definition integerNonZeroNeg (x: Integer) (nonzero: IntegerNonZero x): IntegerNonZero (negInteger x) :=
  \fun (negZero: negInteger x = zeroInteger) =>
    nonzero eq_reason!{
      x "=" { negInteger (negInteger x) } "by" { sym!{Integer} _ _ (negIntegerInvolutive x) }
        "=" zeroInteger "by" { congr!{Integer Integer} negInteger _ _ negZero }
    };

\definition integerAddShuffle: \forall (a, b, c, d: Nat) ->
  NatOp.Add::[set] (NatOp.Add::[set] a b) (NatOp.Add::[set] c d) =
    NatOp.Add::[set] (NatOp.Add::[set] a d) (NatOp.Add::[set] c b) :=
  IM.addShuffle;

\definition natSucc: Nat -> Nat := N.Nat^::succ;

\module Order;
