/* Apply a (\force Sign.program) after computing the magnitude once. */

\module PowerSignImplementation {
  \definition T: \VType := \U((B.Bool -> (N.Nat -> Int)));

  \definition program: (B.Bool -> (N.Nat -> Int)) := (\cfun (test: B.Bool) => \return(\thunk(\cfun (magnitude: N.Nat) => \match test \in B.Bool \with {
      | false : \return(Int::ofNat magnitude)
      | true : ((\force NegOfNat.program) magnitude)
      })));

  \definition specification: T^ := \fun (test: B.Bool^) (magnitude: N.Nat^) =>
    B.ite Int^ test (NegOfNat.specification magnitude) (Int^::ofNat magnitude);

  \definition matches:
      \forall (test: B.Bool^) -> \forall (magnitude: N.Nat^) ->
    program^ test magnitude = specification test magnitude :=
    \induction (test: B.Bool^) \return \forall (magnitude: N.Nat^) ->
      program^ test magnitude = specification test magnitude \with {
      | false : (\fun (magnitude: N.Nat^) => \refl(Int^::ofNat magnitude))
      | true : (\fun (n: _) => congr!{NegOfNat.T^ _} (\fun (f: NegOfNat.T^) => f n) _ _ NegOfNat.coherence)
      };

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: B.Bool^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: N.Nat^) => matches arg0 arg1));
}
\import .PowerSignImplementation[] \as PowerSignParts;
\definition PowerSign: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PowerSignParts.T,
  program := \thunk (PowerSignParts.program),
  specification := PowerSignParts.specification,
  coherence := PowerSignParts.coherence,
};

\definition powerSignTestMatches(n, magnitude: N.Nat^):
  PowerSign.program^ (NatOdd.program^ n) magnitude = PowerSign.specification (NatOdd.specification n) magnitude :=
    \idelim NatOdd.program^ n = NatOdd.specification n \with test: B.Bool^ =>
      PowerSign.program^ (NatOdd.program^ n) magnitude = PowerSign.specification test magnitude
    \by { base: congr!{PowerSign.T^ _} (\fun (f: _) => f (NatOdd.program^ n) magnitude) _ _ PowerSign.coherence, equality: congr!{NatOdd.T^ _} (\fun (f: _) => f n) _ _ NatOdd.coherence };

\module PowImplementation {
  \definition T: \VType := \U((Int -> (N.Nat -> Int)));

  \definition program: (Int -> (N.Nat -> Int)) := (\cfun (x: Int) => \return(\thunk(\cfun (n: N.Nat) => \match x \in Int \with {
      | ofNat a : \program {
    \bind f: \U(N.Nat -> N.Nat) <- ((\force NatOp.Pow.program) a) \then
    \bind magnitude: N.Nat <- (\force f) n \then
    \return Int::ofNat magnitude
}
    | negSucc a : \program {
  \bind f: \U(N.Nat -> N.Nat) <- ((\force NatOp.Pow.program) (N.Nat::succ a)) \then
  \bind magnitude: N.Nat <- (\force f) n \then
  \bind test: B.Bool <- ((\force NatOdd.program) n) \then
  \bind sign: \U(N.Nat -> Int) <- ((\force PowerSign.program) test) \then
  \bind result: Int <- (\force sign) magnitude \then
  \return result
}
    })));

\definition specification: T^ := \induction (x: Int^) \return N.Nat^ -> Int^ \with {
    | ofNat : (\fun (a, n: N.Nat^) => Int^::ofNat (NatOp.Pow.program^ a n))
    | negSucc : (\fun (a, n: N.Nat^) => PowerSign.specification (NatOdd.specification n) (NatOp.Pow.program^ (N.Nat^::succ a) n))
    };

\definition matches: \forall (x: Int^) -> \forall (n: N.Nat^) -> program^ x n = specification x n :=
  \induction (x: Int^) \return \forall (n: N.Nat^) -> program^ x n = specification x n \with {
    | ofNat : (\fun (a, n: N.Nat^) => \refl(Int^::ofNat (NatOp.Pow.program^ a n)))
    | negSucc : (\fun (a, n: N.Nat^) => powerSignTestMatches n (NatOp.Pow.program^ (N.Nat^::succ a) n))
    };

\definition coherence: program^ = specification := \axiom:funext(program^, specification, \fun (arg0: Int^) => \axiom:funext(program^ arg0, specification arg0, \fun (arg1: N.Nat^) => matches arg0 arg1));
}
\import .PowImplementation[] \as PowParts;
\definition Pow: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
  T := PowParts.T,
  program := \thunk (PowParts.program),
  specification := PowParts.specification,
  coherence := PowParts.coherence,
};

\module Math;

/* Integer laws used by constructions such as the rationals. */
\import .Math[] \as IM;
\import IM.Ring[].Prop[] \as IR;
\import IM.Specification[].Def[] \as IS;

\definition zeroNat: Nat := N.Nat^::zero;
\definition oneNat: Nat := N.Nat^::succ N.Nat^::zero;
/* Integer operations on the canonical (\force OfNat.program)/negSucc carrier. */
\definition Integer: \Set := Int^;
\definition integer(a, b: Nat): Integer := IM.normalize (pair a b);
\definition zeroInteger: Integer := integer zeroNat zeroNat;
\definition oneInteger: Integer := integer oneNat zeroNat;
\definition negInteger(x: Integer): Integer := IM.normalize (IM.negRep (IM.representative x));
\definition addInteger(x, y: Integer): Integer := IM.normalize (IM.addRep (IM.representative x) (IM.representative y));
\definition mulInteger(x, y: Integer): Integer := IM.normalize (IM.mulRep (IM.representative x) (IM.representative y));
\definition subInteger(x, y: Integer): Integer := addInteger x (negInteger y);
\definition scaleInteger(x: Integer) (n: Nat): Integer :=
    IM.normalize (IM.scaleRep (IM.representative x) n);

\math-macro int_add($x, "+", $y) := addInteger $x $y;
\math-macro int_mul($x, "*", $y) := mulInteger $x $y;

/* Representative relations are used only at the normalization boundary. */
\definition normalizedRepresentative(x: Difference):
  IM.Equivalent (IM.representative (IM.normalize x)) x :=
  IM.equivalentSym _ _ (IM.representativeNormalize x);
\definition eqOfRepresentatives(x, y: Integer):
  IM.Equivalent (IM.representative x) (IM.representative y) ->
  x = y :=
  \fun (xy: _) =>
    eq_reason!{
      x "=" { IM.normalize (IM.representative x) }
        "by" { sym!{Integer} _ _ (diffCanonical x) }
        "=" { IM.normalize (IM.representative y) }
        "by" { IM.normalizeRespects _ _ xy }
        "=" y "by" { diffCanonical y }
    };
\definition integerEqRefl(x: Integer): x = x := \refl(x);
\definition integerEqSym(x, y: Integer): x = y -> y = x := sym!{Integer} x y;
\definition integerEqTrans(x, y, z: Integer): x = y -> y = z -> x = z :=
  trans!{Integer} x y z;
\definition integerEqOfFields(x, y: Integer):
  Positive.specification x = Positive.specification y ->
  Negative.specification x = Negative.specification y ->
  x = y :=
  \fun (positive: _) (negative: _) =>
    eqOfRepresentatives x y
      (IM.equivalentOfFields (IM.representative x) (IM.representative y) positive negative);
\definition ofNatAsInteger(n: Nat): Int^::ofNat n = integer n zeroNat :=
  integerEqOfFields (Int^::ofNat n) (integer n zeroNat) (\refl(n)) (\refl(zeroNat));
\definition negSuccAsNegNatural(n: Nat):
  Int^::negSucc n = negInteger (integer (N.Nat^::succ n) zeroNat) :=
  integerEqOfFields (Int^::negSucc n) (negInteger (integer (N.Nat^::succ n) zeroNat))
    (\refl(zeroNat)) (\refl(N.Nat^::succ n));
\definition integerEqOfParts(a, b, c, d: Nat):
  a = c -> b = d ->
  integer a b = integer c d := congr2!{Nat Nat Integer} integer a c b d;

\definition addIntegerRep(x, y: Integer):
  IM.Equivalent (IM.representative (addInteger x y))
    (IM.addRep (IM.representative x) (IM.representative y)) :=
  normalizedRepresentative (IM.addRep (IM.representative x) (IM.representative y));
\definition negIntegerRep(x: Integer):
  IM.Equivalent (IM.representative (negInteger x)) (IM.negRep (IM.representative x)) :=
  normalizedRepresentative (IM.negRep (IM.representative x));
\definition mulIntegerRep(x, y: Integer):
  IM.Equivalent (IM.representative (mulInteger x y))
    (IM.mulRep (IM.representative x) (IM.representative y)) :=
  normalizedRepresentative (IM.mulRep (IM.representative x) (IM.representative y));
\definition scaleIntegerRep(x: Integer) (n: Nat):
  IM.Equivalent (IM.representative (scaleInteger x n)) (IM.scaleRep (IM.representative x) n) :=
  normalizedRepresentative (IM.scaleRep (IM.representative x) n);

\definition addIntegerRespects(x, y, u, v: Integer):
  x = y -> u = v ->
  \(x "+" u\) = \(y "+" v\) := congr2!{Integer Integer Integer} addInteger x y u v;
\definition negIntegerRespects(x, y: Integer):
  x = y ->
  negInteger x = negInteger y :=
  congr!{Integer Integer} negInteger x y;
\definition subIntegerRespects(x, y, u, v: Integer):
  x = y -> u = v ->
  subInteger x u = subInteger y v := congr2!{Integer Integer Integer} subInteger x y u v;
\definition mulIntegerRespects(x, y, u, v: Integer):
  x = y -> u = v ->
  \(x "*" u\) = \(y "*" v\) := congr2!{Integer Integer Integer} mulInteger x y u v;
\definition scaleIntegerRespects(x, y: Integer) (n: Nat):
  x = y ->
  scaleInteger x n = scaleInteger y n :=
  \fun (xy: x = y) =>
    congr!{Integer Integer} (\fun (z: Integer) => scaleInteger z n) x y xy;

\definition addIntegerZeroLeft(x: Integer): \(zeroInteger "+" x\) = x :=
  eq_reason!{
    \(zeroInteger "+" x\) "=" { IM.normalize (IM.representative x) }
    "by" { IM.normalizeRespects _ _ (IR.addIntegerZeroLeft (IM.representative x)) }
    "=" x "by" { diffCanonical x }
  };
\definition addIntegerZeroRight(x: Integer): \(x "+" zeroInteger\) = x :=
  eq_reason!{
    \(x "+" zeroInteger\) "=" { IM.normalize (IM.representative x) }
    "by" { IM.normalizeRespects _ _ (IR.addIntegerZeroRight (IM.representative x)) }
    "=" x "by" { diffCanonical x }
  };
\definition addIntegerComm(x, y: Integer): \(x "+" y\) = \(y "+" x\) :=
  IM.normalizeRespects _ _ (IR.addIntegerComm (IM.representative x) (IM.representative y));
\definition addIntegerAssoc(x, y, z: Integer): \((x "+" y) "+" z\) = \(x "+" (y "+" z)\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \let rz: _ := IM.representative z \then
    \return eq_reason!{
      \((x "+" y) "+" z\)
      "=" { IM.normalize (IM.addRep (IM.addRep rx ry) rz) }
      "by" { IM.normalizeRespects _ _
        (IM.addRepRespects _ _ _ _ (addIntegerRep x y) (IM.equivalentRefl rz)) }
      "=" { IM.normalize (IM.addRep rx (IM.addRep ry rz)) }
      "by" { IM.normalizeRespects _ _ (IR.addIntegerAssoc rx ry rz) }
      "=" \(x "+" (y "+" z)\)
      "by" { IM.normalizeRespects _ _
        (IM.addRepRespects _ _ _ _ (IM.equivalentRefl rx)
          (IM.equivalentSym _ _ (addIntegerRep y z))) }
    }
  };
\definition mulIntegerComm(x, y: Integer): \(x "*" y\) = \(y "*" x\) :=
  IM.normalizeRespects _ _ (IR.mulIntegerComm (IM.representative x) (IM.representative y));

\definition scaleIntegerZero(n: Nat): scaleInteger zeroInteger n = zeroInteger :=
  IM.normalizeRespects _ _ (IR.scaleIntegerZero n);
\definition scaleIntegerSwap(x: Integer) (a, b: Nat):
  scaleInteger (scaleInteger x a) b = scaleInteger (scaleInteger x b) a :=
  \block {
    \let rx: _ := IM.representative x \then
    \return eq_reason!{
      { scaleInteger (scaleInteger x a) b }
      "=" { IM.normalize (IM.scaleRep (IM.scaleRep rx a) b) }
      "by" { IM.normalizeRespects _ _ (IM.scaleRepRespects _ _ b (scaleIntegerRep x a)) }
      "=" { IM.normalize (IM.scaleRep (IM.scaleRep rx b) a) }
      "by" { IM.normalizeRespects _ _ (IR.scaleIntegerSwap rx a b) }
      "=" { scaleInteger (scaleInteger x b) a }
      "by" { IM.normalizeRespects _ _
        (IM.scaleRepRespects _ _ a (IM.equivalentSym _ _ (scaleIntegerRep x b))) }
    }
  };
\definition scaleIntegerCancelPositive(x, y: Integer) (k: Nat):
  scaleInteger x (N.Nat^::succ k) = scaleInteger y (N.Nat^::succ k) ->
  x = y :=
  \fun (xy: _) =>
    eqOfRepresentatives x y
      (IR.scaleIntegerCancelPositive (IM.representative x) (IM.representative y) k
        (IM.equivalentOfNormalize
          (IM.scaleRep (IM.representative x) (N.Nat^::succ k))
          (IM.scaleRep (IM.representative y) (N.Nat^::succ k)) xy));
\definition scaleIntegerNatural(a, n: Nat):
  scaleInteger (integer a zeroNat) n = integer (NatOp.Mul.specification a n) zeroNat :=
  IM.normalizeRespects _ _
    (IM.equivalentOfFields (IM.scaleRep (pair a zeroNat) n)
      (pair (NatOp.Mul.specification a n) zeroNat) (\refl(NatOp.Mul.specification a n)) (NL.mulZeroLeft n));
\definition addIntegerNatural(a, b: Nat):
  \({ integer a zeroNat } "+" { integer b zeroNat }\) = integer (NatOp.Add.specification a b) zeroNat :=
  \refl(integer (NatOp.Add.specification a b) zeroNat);

\definition mulIntegerAssoc(x, y, z: Integer): \((x "*" y) "*" z\) = \(x "*" (y "*" z)\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \let rz: _ := IM.representative z \then
    \return eq_reason!{
      \((x "*" y) "*" z\)
      "=" { IM.normalize (IM.mulRep (IM.mulRep rx ry) rz) }
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (mulIntegerRep x y) (IM.equivalentRefl rz)) }
      "=" { IM.normalize (IM.mulRep rx (IM.mulRep ry rz)) }
      "by" { IM.normalizeRespects _ _ (IR.mulIntegerAssoc rx ry rz) }
      "=" \(x "*" (y "*" z)\)
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (IM.equivalentRefl rx)
          (IM.equivalentSym _ _ (mulIntegerRep y z))) }
    }
  };
\definition mulIntegerDistribLeft(x, y, z: Integer): \(x "*" (y "+" z)\) = \((x "*" y) "+" (x "*" z)\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \let rz: _ := IM.representative z \then
    \return eq_reason!{
      \(x "*" (y "+" z)\)
      "=" { IM.normalize (IM.mulRep rx (IM.addRep ry rz)) }
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (IM.equivalentRefl rx) (addIntegerRep y z)) }
      "=" { IM.normalize (IM.addRep (IM.mulRep rx ry) (IM.mulRep rx rz)) }
      "by" { IM.normalizeRespects _ _ (IR.mulIntegerDistribLeft rx ry rz) }
      "=" \((x "*" y) "+" (x "*" z)\)
      "by" { IM.normalizeRespects _ _
        (IM.addRepRespects _ _ _ _
          (IM.equivalentSym _ _ (mulIntegerRep x y))
          (IM.equivalentSym _ _ (mulIntegerRep x z))) }
    }
  };
\definition mulIntegerDistribRight(x, y, z: Integer):
  \((x "+" y) "*" z\) = \((x "*" z) "+" (y "*" z)\) :=
  eq_reason!{
    \((x "+" y) "*" z\)
    "=" \(z "*" (x "+" y)\) "by" { mulIntegerComm \(x "+" y\) z }
    "=" \((z "*" x) "+" (z "*" y)\) "by" { mulIntegerDistribLeft z x y }
    "=" \((x "*" z) "+" (y "*" z)\)
    "by" { congr2!{Integer Integer Integer} addInteger _ _ _ _
      (mulIntegerComm z x) (mulIntegerComm z y) }
  };
\definition mulIntegerCongRight(x, y, z: Integer):
  y = z ->
  \(x "*" y\) = \(x "*" z\) := congr!{Integer Integer} (mulInteger x) y z;
\definition mulIntegerInterchange(a, b, c, d: Integer):
  \((a "*" b) "*" (c "*" d)\) = \((a "*" c) "*" (b "*" d)\) :=
  eq_reason!{
    \((a "*" b) "*" (c "*" d)\)
    "=" \(a "*" (b "*" (c "*" d))\) "by" { mulIntegerAssoc a b \(c "*" d\) }
    "=" \(a "*" ((b "*" c) "*" d)\)
    "by" { congr!{Integer Integer} (mulInteger a) _ _ (sym!{Integer} _ _ (mulIntegerAssoc b c d)) }
    "=" \(a "*" ((c "*" b) "*" d)\)
    "by" { congr!{Integer Integer} (\fun (n: Integer) => \(a "*" (n "*" d)\))
      _ _ (mulIntegerComm b c) }
    "=" \(a "*" (c "*" (b "*" d))\)
    "by" { congr!{Integer Integer} (mulInteger a) _ _ (mulIntegerAssoc c b d) }
    "=" \((a "*" c) "*" (b "*" d)\)
    "by" { sym!{Integer} _ _ (mulIntegerAssoc a c \(b "*" d\)) }
  };

\definition negIntegerInvolutive(x: Integer): negInteger (negInteger x) = x :=
  eq_reason!{
    { negInteger (negInteger x) }
    "=" { IM.normalize (IM.negRep (IM.negRep (IM.representative x))) }
    "by" { IM.normalizeRespects _ _ (IM.negRepRespects _ _ (negIntegerRep x)) }
    "=" x "by" { diffCanonical x }
  };
\definition addIntegerNegRight(x: Integer): \(x "+" { negInteger x }\) = zeroInteger :=
  eq_reason!{
    \(x "+" { negInteger x }\)
    "=" { IM.normalize (IM.addRep (IM.representative x) (IM.negRep (IM.representative x))) }
    "by" { IM.normalizeRespects _ _
      (IM.addRepRespects _ _ _ _ (IM.equivalentRefl (IM.representative x)) (negIntegerRep x)) }
    "=" zeroInteger "by" { IM.normalizeRespects _ _ (IR.addIntegerNegRight (IM.representative x)) }
  };
\definition addIntegerNegLeft(x: Integer): \({ negInteger x } "+" x\) = zeroInteger :=
  eq_reason!{
    \({ negInteger x } "+" x\) "=" \(x "+" { negInteger x }\)
    "by" { addIntegerComm (negInteger x) x }
    "=" zeroInteger "by" { addIntegerNegRight x }
  };
\definition mulIntegerZeroRight(x: Integer): \(x "*" zeroInteger\) = zeroInteger :=
  IM.normalizeRespects _ _ (IR.mulIntegerZeroRight (IM.representative x));
\definition mulIntegerZeroLeft(x: Integer): \(zeroInteger "*" x\) = zeroInteger :=
  eq_reason!{
    \(zeroInteger "*" x\) "=" \(x "*" zeroInteger\) "by" { mulIntegerComm zeroInteger x }
    "=" zeroInteger "by" { mulIntegerZeroRight x }
  };
\definition mulIntegerOneRight(x: Integer): \(x "*" oneInteger\) = x :=
  eq_reason!{
    \(x "*" oneInteger\) "=" { IM.normalize (IM.representative x) }
    "by" { IM.normalizeRespects _ _ (IR.mulIntegerOneRight (IM.representative x)) }
    "=" x "by" { diffCanonical x }
  };
\definition mulIntegerOneLeft(x: Integer): \(oneInteger "*" x\) = x :=
  eq_reason!{
    \(oneInteger "*" x\) "=" \(x "*" oneInteger\) "by" { mulIntegerComm oneInteger x }
    "=" x "by" { mulIntegerOneRight x }
  };
\definition mulIntegerNegLeft(x, y: Integer): \({ negInteger x } "*" y\) = negInteger \(x "*" y\) :=
  \block {
    \let rx: _ := IM.representative x \then
    \let ry: _ := IM.representative y \then
    \return eq_reason!{
      \({ negInteger x } "*" y\)
      "=" { IM.normalize (IM.mulRep (IM.negRep rx) ry) }
      "by" { IM.normalizeRespects _ _
        (IM.mulRepRespects _ _ _ _ (negIntegerRep x) (IM.equivalentRefl ry)) }
      "=" { IM.normalize (IM.negRep (IM.mulRep rx ry)) }
      "by" { IM.normalizeRespects _ _ (IR.mulIntegerNegLeft rx ry) }
      "=" { negInteger \(x "*" y\) }
      "by" { IM.normalizeRespects _ _
        (IM.negRepRespects _ _ (IM.equivalentSym _ _ (mulIntegerRep x y))) }
    }
  };
\definition mulIntegerNegRight(x, y: Integer): \(x "*" { negInteger y }\) = negInteger \(x "*" y\) :=
  eq_reason!{
    \(x "*" { negInteger y }\)
    "=" \({ negInteger y } "*" x\) "by" { mulIntegerComm x (negInteger y) }
    "=" { negInteger \(y "*" x\) } "by" { mulIntegerNegLeft y x }
    "=" { negInteger \(x "*" y\) }
    "by" { congr!{Integer Integer} negInteger _ _ (mulIntegerComm y x) }
  };

\definition mulIntegerNatural(x: Integer) (n: Nat): \(x "*" { integer n zeroNat }\) = scaleInteger x n :=
  IM.normalizeRespects _ _
    (IM.equivalentOfFields
      (IM.mulRep (IM.representative x) (pair n zeroNat))
      (IM.scaleRep (IM.representative x) n)
      (\refl(NatOp.Mul.specification (Positive.specification x) n))
      (NL.addZeroLeft (NatOp.Mul.specification (Negative.specification x) n)));
\definition addIntegerSubCancelRight(x, y: Integer): \((x "+" { negInteger y }) "+" y\) = x :=
  eq_reason!{
    \((x "+" { negInteger y }) "+" y\)
    "=" \(x "+" ({ negInteger y } "+" y)\) "by" { addIntegerAssoc x (negInteger y) y }
    "=" \(x "+" zeroInteger\)
    "by" { congr!{Integer Integer} (addInteger x) _ _ (addIntegerNegLeft y) }
    "=" x "by" { addIntegerZeroRight x }
  };
\definition scaleIntegerMulRight(x, y: Integer) (n: Nat):
  scaleInteger \(x "*" y\) n = \({ scaleInteger x n } "*" y\) :=
  \block {
    \let k: _ := integer n zeroNat \then
    \return eq_reason!{
      { scaleInteger \(x "*" y\) n }
      "=" \((x "*" y) "*" k\) "by" { sym!{Integer} _ _ (mulIntegerNatural \(x "*" y\) n) }
      "=" \(x "*" (y "*" k)\) "by" { mulIntegerAssoc x y k }
      "=" \(x "*" (k "*" y)\)
      "by" { congr!{Integer Integer} (mulInteger x) _ _ (mulIntegerComm y k) }
      "=" \((x "*" k) "*" y\) "by" { sym!{Integer} _ _ (mulIntegerAssoc x k y) }
      "=" \({ scaleInteger x n } "*" y\)
      "by" { congr!{Integer Integer} (\fun (v: Integer) => \(v "*" y\)) _ _ (mulIntegerNatural x n) }
    }
  };
\definition integerSuccAsAdd(n: Nat):
  integer (N.Nat^::succ n) zeroNat = \(oneInteger "+" { integer n zeroNat }\) :=
  eq_reason!{
    { integer (N.Nat^::succ n) zeroNat }
    "=" { integer (NatOp.Add.specification oneNat n) zeroNat }
    "by" { congr!{Nat Integer} (\fun (k: Nat) => integer k zeroNat) _ _
      (sym!{Nat} _ _ (eq_reason!{
        { NatOp.Add.specification oneNat n } "=" { N.Nat^::succ (NatOp.Add.specification zeroNat n) }
        "by" { NL.addSuccLeft zeroNat n }
        "=" { N.Nat^::succ n } "by" { NatOp.succCong _ _ (NL.addZeroLeft n) }
      })) }
    "=" \(oneInteger "+" { integer n zeroNat }\)
    "by" { sym!{Integer} _ _ (addIntegerNatural oneNat n) }
  };
\definition scaleIntegerSucc(x: Integer) (n: Nat):
  scaleInteger x (N.Nat^::succ n) = \(x "+" { scaleInteger x n }\) :=
  eq_reason!{
    { scaleInteger x (N.Nat^::succ n) }
    "=" \(x "*" { integer (N.Nat^::succ n) zeroNat }\)
    "by" { sym!{Integer} _ _ (mulIntegerNatural x (N.Nat^::succ n)) }
    "=" \(x "*" (oneInteger "+" { integer n zeroNat })\)
    "by" { congr!{Integer Integer} (mulInteger x) _ _ (integerSuccAsAdd n) }
    "=" \((x "*" oneInteger) "+" (x "*" { integer n zeroNat })\)
    "by" { mulIntegerDistribLeft x oneInteger (integer n zeroNat) }
    "=" \(x "+" { scaleInteger x n }\)
    "by" { congr2!{Integer Integer Integer} addInteger _ _ _ _
      (mulIntegerOneRight x) (mulIntegerNatural x n) }
  };
\definition scaleIntegerByZero(x: Integer): scaleInteger x zeroNat = zeroInteger :=
  eq_reason!{
    { scaleInteger x zeroNat } "=" \(x "*" zeroInteger\)
    "by" { sym!{Integer} _ _ (mulIntegerNatural x zeroNat) }
    "=" zeroInteger "by" { mulIntegerZeroRight x }
  };

\definition IntegerLt: Integer -> Integer -> \Prop := IS.Lt;
\definition IntegerNonZero(x: Integer): \Prop := not!{{ x = zeroInteger }};
\definition integerNonZeroNeg(x: Integer):
  IntegerNonZero x ->
  IntegerNonZero (negInteger x) :=
  \fun (nonzero: IntegerNonZero x) (negZero: negInteger x = zeroInteger) =>
      nonzero eq_reason!{
        x "=" { negInteger (negInteger x) } "by" { sym!{Integer} _ _ (negIntegerInvolutive x) }
          "=" zeroInteger "by" { congr!{Integer Integer} negInteger _ _ negZero }
      };

\definition integerAddShuffle:
  \forall (a, b, c, d: Nat) ->
  NatOp.Add.specification (NatOp.Add.specification a b) (NatOp.Add.specification c d) =
    NatOp.Add.specification (NatOp.Add.specification a d) (NatOp.Add.specification c b) :=
  IM.addShuffle;

\definition natSucc: Nat -> Nat := N.Nat^::succ;

\module Order;
