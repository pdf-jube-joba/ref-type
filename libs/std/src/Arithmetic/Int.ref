  \definition program: (Int -> B.Bool) := (\cfun (x: Int) => \program {
    \bind v2: N.Nat <- ((\force NatAbs.program) x) \then
    \bind v4: B.Bool <- ((\force NatOdd.program) v2) \then
    \return v4
  });

  \definition specification: T^ := \fun (x: Int^) => (NatOdd.specification (NatAbs.specification x));

  \definition matches(x: Int^): program^ x = specification x := trans!{B.Bool^} _ _ _ (congr!{N.Nat^ B.Bool^} NatOdd.program^ (NatAbs.program^ x) (NatAbs.specification x) (congr!{NatAbs.T^ _} (\fun (f: _) => f x) _ _ NatAbs.coherence))
      (congr!{NatOdd.T^ _} (\fun (f: _) => f (NatAbs.specification x)) _ _ NatOdd.coherence);

  \definition coherence: program^ = specification := \axiom:funext(program^, specification, matches);
}
\import .OddImplementation[] \as OddParts;
\definition Odd: ProgramBundles.Correspondence := ProgramBundles.Correspondence {
