\import std.Alg[].Ring[] \as Rings;
\import I.Math[].Specification[].Prop[].Multiplication[] \as Product;
\definition ring: Rings.Ring[Int] := Rings.Ring[Int] {
  zero := I.Zero.specification, one := I.One.specification,
  add := I.Add.specification, neg := I.Neg.specification, mul := I.Mul.specification,
  semiring := A.SemiringLaws[Int, A.SemiringData[Int]::# I.Zero.specification I.One.specification I.Add.specification I.Mul.specification] {
    additive := M.CommutativeMonoidLaws[Int, M.CommutativeMonoidData[Int]::# (M.MonoidData[Int]::# I.Zero.specification I.Add.specification)] {
      monoid := #monoid{additiveGroupLaws}, commutative := IL.addComm,
    },
    multiplicative := M.MonoidLaws[Int, M.MonoidData[Int]::# I.One.specification I.Mul.specification] {
      leftIdentity := Product.mulOneLeft, rightIdentity := Product.mulOneRight, associative := Product.mulAssoc,
    },
    leftDistributive := Product.mulAdd, rightDistributive := Product.addMul,
    zeroAbsorbsLeft := Product.mulZeroLeft, zeroAbsorbsRight := Product.mulZeroRight,
  },
  additiveInverse := IL.negInverse,
};
\definition commutativeRing: Rings.CommutativeRing[Int] := Rings.CommutativeRing[Int] {
  base := Rings.RingData[Int]::# I.Zero.specification I.One.specification I.Add.specification I.Neg.specification I.Mul.specification,
  ring := \bysub(Rings.RingData[Int], Rings.Ring[Int], ring),
  mulCommutative := IL.mulComm,
};
