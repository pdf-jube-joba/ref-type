\import N.Gcd[].Prop[] \as Divisors;
\definition gcd: divisor (certificate a b) = Gcd.gcd (absolute a) (absolute b) := \parent.\parent.Projection[].gcd (absolute a) (absolute b);
\definition bezoutLaw: Arithmetic.add (Arithmetic.mul (firstCoefficient (certificate a b)) a) (Arithmetic.mul (secondCoefficient (certificate a b)) b) = natural (divisor (certificate a b)) :=
  trans!{I.Int^} _ _ _
    (congr2!{I.Int^ I.Int^ I.Int^} Arithmetic.add _ _ _ _
      (trans!{I.Int^} _ _ _ (Product.mulAssoc (first (result (absolute a) (absolute b))) (sign a) a)
        (congr!{I.Int^ I.Int^} (Arithmetic.mul (first (result (absolute a) (absolute b)))) _ _ (signTimesValue a)))
      (trans!{I.Int^} _ _ _ (Product.mulAssoc (second (result (absolute a) (absolute b))) (sign b) b)
        (congr!{I.Int^ I.Int^} (Arithmetic.mul (second (result (absolute a) (absolute b)))) _ _ (signTimesValue b))))
    (trans!{I.Int^} _ _ _ (bezout (absolute a) (absolute b))
      (sym!{I.Int^} _ _ (congr!{N.Nat^ I.Int^} natural _ _ gcd)));
\definition laws: Laws[a, b, certificate a b] := Laws[a, b, certificate a b] {
  gcd := gcd, bezout := bezoutLaw,
  dividesLeft := \idelim Gcd.gcd (absolute a) (absolute b) = divisor (certificate a b) \with d: N.Nat^ => Divides (natural d) a \by {
    base: naturalDivisor (Gcd.gcd (absolute a) (absolute b)) a (Divisors.gcdDividesLeft (absolute a) (absolute b)), equality: sym!{N.Nat^} _ _ gcd
  },
  dividesRight := \idelim Gcd.gcd (absolute a) (absolute b) = divisor (certificate a b) \with d: N.Nat^ => Divides (natural d) b \by {
    base: naturalDivisor (Gcd.gcd (absolute a) (absolute b)) b (Divisors.gcdDividesRight (absolute a) (absolute b)), equality: sym!{N.Nat^} _ _ gcd
  },
};
