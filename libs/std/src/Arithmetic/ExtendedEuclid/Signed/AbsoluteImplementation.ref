\definition T: \VType := \U(I.Int -> N.Nat);
\definition program: T := \thunk (\cfun (a: I.Int) => \match a \in I.Int \with {
  | ofNat n: \return n
  | negSucc n: \return(N.Nat::succ n)
});
\definition matches: \forall (a: I.Int^) -> program^ a = absolute a :=
  \induction (a: I.Int^) \return program^ a = absolute a \with {
    | ofNat: \fun (n: N.Nat^) => \refl(n)
    | negSucc: \fun (n: N.Nat^) => \refl(N.Nat^::succ n)
  };
\definition coherence: program^ = absolute := \axiom:funext(program^, absolute, matches);
