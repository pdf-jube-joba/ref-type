\definition T: \VType := \U(I.Int -> I.Int);
\definition program: T := \thunk (\cfun (a: I.Int) => \match a \in I.Int \with {
  | ofNat n: \return(I.Int::ofNat (N.Nat::succ N.Nat::zero))
  | negSucc n: \return(I.Int::negSucc N.Nat::zero)
});
\definition matches: \forall (a: I.Int^) -> program^ a = sign a :=
  \induction (a: I.Int^) \return program^ a = sign a \with {
    | ofNat: \fun (n: N.Nat^) => \refl(Arithmetic.one)
    | negSucc: \fun (n: N.Nat^) => \refl(Arithmetic.neg Arithmetic.one)
  };
\definition coherence: program^ = sign := \axiom:funext(program^, sign, matches);
