/* Transport a specification across the proved isomorphism once per signature. */
\definition agreementII: \forall (f, g: Int^ -> Int^) -> f = g -> \forall (a0: Int^) -> toMath (f a0) =
    toMath (g (fromMath (toMath a0))) :=
  \block {
    \fun (f, g: Int^ -> Int^) \then
    \fun (coherence: f = g) \then
    \fun (a0: Int^) \then
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int^ Int^} g a0 (fromMath (toMath a0)) (roundTripArg a0) \then
    \let resultMatches: f a0 = g (fromMath (toMath a0)) :=
      trans!{Int^} _ _ _ (congr!{_ Int^} (\fun (operation: Int^ -> Int^) => operation a0) f g coherence) argumentMatches \then
    \return toMathCong (f a0) (g (fromMath (toMath a0))) resultMatches
  };

\definition agreementIN: \forall (f, g: Int^ -> Nat) -> f = g -> \forall (a0: Int^) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  \block {
    \fun (f, g: Int^ -> Nat) \then
    \fun (coherence: f = g) \then
    \fun (a0: Int^) \then
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int^ Nat} g a0 (fromMath (toMath a0)) (roundTripArg a0) \then
    \return trans!{Nat} _ _ _ (congr!{_ Nat} (\fun (operation: Int^ -> Nat) => operation a0) f g coherence) argumentMatches
  };

\definition agreementIB: \forall (f, g: Int^ -> Bool) -> f = g -> \forall (a0: Int^) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  \block {
    \fun (f, g: Int^ -> Bool) \then
    \fun (coherence: f = g) \then
    \fun (a0: Int^) \then
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int^ Bool} g a0 (fromMath (toMath a0)) (roundTripArg a0) \then
    \return trans!{Bool} _ _ _ (congr!{_ Bool} (\fun (operation: Int^ -> Bool) => operation a0) f g coherence) argumentMatches
  };

\definition agreementIIB: \forall (f, g: Int^ -> Int^ -> Bool) -> f = g ->
    \forall (a0: Int^) -> \forall (a1: Int^) -> (f a0 a1) = (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  \block {
    \fun (f, g: Int^ -> Int^ -> Bool) \then
    \fun (coherence: f = g) \then
    \fun (a0, a1: Int^) \then
    \let argumentsMatch:
      g a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      congr2!{Int^ Int^ Bool} g
        a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1))
        (roundTripArg a0) (roundTripArg a1) \then
    \return trans!{Bool} _ _ _ (congr!{_ Bool} (\fun (operation: Int^ -> Int^ -> Bool) => operation a0 a1) f g coherence) argumentsMatch
  };

\definition agreementIII: \forall (f, g: Int^ -> Int^ -> Int^) -> f = g -> \forall (a0:
    Int^) -> \forall (a1: Int^) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  \block {
    \fun (f, g: Int^ -> Int^ -> Int^) \then
    \fun (coherence: f = g) \then
    \fun (a0, a1: Int^) \then
    \let argumentsMatch:
      g a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      congr2!{Int^ Int^ Int^} g
        a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1))
        (roundTripArg a0) (roundTripArg a1) \then
    \let resultMatches:
      f a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      trans!{Int^} _ _ _ (congr!{_ Int^} (\fun (operation: Int^ -> Int^ -> Int^) => operation a0 a1) f g coherence) argumentsMatch \then
    \return toMathCong (f a0 a1)
      (g (fromMath (toMath a0)) (fromMath (toMath a1))) resultMatches
  };

\definition agreementINI: \forall (f, g: Int^ -> Nat -> Int^) -> f = g ->
    \forall (a0: Int^) -> \forall (a1: Nat) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) a1) :=
  \block {
    \fun (f, g: Int^ -> Nat -> Int^) \then
    \fun (coherence: f = g) \then
    \fun (a0: Int^) (a1: Nat) \then
    \let argumentMatches: g a0 a1 = g (fromMath (toMath a0)) a1 :=
      congr!{Int^ Int^} (\fun (z: Int^) => g z a1)
        a0 (fromMath (toMath a0)) (roundTripArg a0) \then
    \let resultMatches: f a0 a1 = g (fromMath (toMath a0)) a1 :=
      trans!{Int^} _ _ _ (congr!{_ Int^} (\fun (operation: Int^ -> Nat -> Int^) => operation a0 a1) f g coherence) argumentMatches \then
    \return toMathCong (f a0 a1) (g (fromMath (toMath a0)) a1) resultMatches
  };

\definition agreementBIII: \forall (f, g: Bool -> Int^ -> Int^ -> Int^) -> f = g -> \forall (a0: Bool) -> \forall (a1: Int^) -> \forall (a2: Int^) -> toMath (f a0 a1 a2) = toMath (g a0
    (fromMath (toMath a1)) (fromMath (toMath a2))) :=
  \block {
    \fun (f, g: Bool -> Int^ -> Int^ -> Int^) \then
    \fun (coherence: f = g) \then
    \fun (a0: Bool) (a1, a2: Int^) \then
    \let argumentsMatch:
      g a0 a1 a2 = g a0 (fromMath (toMath a1)) (fromMath (toMath a2)) :=
      congr3!{Bool Int^ Int^ Int^} g
        a0 a0 a1 (fromMath (toMath a1)) a2 (fromMath (toMath a2))
        (\refl(a0)) (roundTripArg a1) (roundTripArg a2) \then
    \let resultMatches:
      f a0 a1 a2 = g a0 (fromMath (toMath a1)) (fromMath (toMath a2)) :=
      trans!{Int^} _ _ _ (congr!{_ Int^} (\fun (operation: Bool -> Int^ -> Int^ -> Int^) => operation a0 a1 a2) f g coherence) argumentsMatch \then
    \return toMathCong (f a0 a1 a2)
      (g a0 (fromMath (toMath a1)) (fromMath (toMath a2))) resultMatches
  };

/* Auxiliary operations on the quotient use its unique normal form. */
\definition ofNatMath (n: Nat): Grothendieck := toMath (OfNat::[set] n);

\definition ofNatMatchesMath (n: Nat): toMath (OfNat::[program]^ n) = ofNatMath n := toMathCong (OfNat::[program]^ n) (OfNat::[set] n) (congr!{OfNat::[Type]^ _} (\fun (f: _) => f n) _ _ OfNat::[coherence]);

\definition negOfNatMath (n: Nat): Grothendieck := toMath (NegOfNat::[set] n);

\definition negOfNatMatchesMath (n: Nat): toMath (NegOfNat::[program]^ n) = negOfNatMath n := toMathCong (NegOfNat::[program]^ n) (NegOfNat::[set] n) (congr!{NegOfNat::[Type]^ _} (\fun (f: _) => f n) _ _ NegOfNat::[coherence]);

\definition succMath (x: Grothendieck): Grothendieck := toMath (Succ::[set] (fromMath x));

\definition succMatchesMath (x: Int^): toMath (Succ::[program]^ x) = succMath (toMath x) := agreementII Succ::[program]^ Succ::[set] Succ::[coherence] x;

\definition predMath (x: Grothendieck): Grothendieck := toMath (Pred::[set] (fromMath x));

\definition predMatchesMath (x: Int^): toMath (Pred::[program]^ x) = predMath (toMath x) := agreementII Pred::[program]^ Pred::[set] Pred::[coherence] x;

\definition natAbsMath (x: Grothendieck): Nat := (NatAbs::[set] (fromMath x));

\definition natAbsMatchesMath (x: Int^): (NatAbs::[program]^ x) = natAbsMath (toMath x) := agreementIN NatAbs::[program]^ NatAbs::[set] NatAbs::[coherence] x;

\definition absMath (x: Grothendieck): Grothendieck := toMath (Abs::[set] (fromMath x));

\definition absMatchesMath (x: Int^): toMath (Abs::[program]^ x) = absMath (toMath x) := agreementII Abs::[program]^ Abs::[set] Abs::[coherence] x;

\definition isZeroMath (x: Grothendieck): Bool := (IsZero::[set] (fromMath x));

\definition isZeroMatchesMath (x: Int^): (IsZero::[program]^ x) = isZeroMath (toMath x) := agreementIB IsZero::[program]^ IsZero::[set] IsZero::[coherence] x;

\definition eqbMath (x: Grothendieck) (y: Grothendieck): Bool := (Eqb::[set] (fromMath x) (fromMath y));

\definition eqbMatchesMath (x: Int^) (y: Int^): (Eqb::[program]^ x y) = eqbMath (toMath x) (toMath y) := agreementIIB Eqb::[program]^ Eqb::[set] Eqb::[coherence] x y;

\definition lebMath (x: Grothendieck) (y: Grothendieck): Bool := (Leb::[set] (fromMath x) (fromMath y));

\definition lebMatchesMath (x: Int^) (y: Int^): (Leb::[program]^ x y) = lebMath (toMath x) (toMath y) := agreementIIB Leb::[program]^ Leb::[set] Leb::[coherence] x y;

\definition ltbMath (x: Grothendieck) (y: Grothendieck): Bool := (Ltb::[set] (fromMath x) (fromMath y));

\definition ltbMatchesMath (x: Int^) (y: Int^): (Ltb::[program]^ x y) = ltbMath (toMath x) (toMath y) := agreementIIB Ltb::[program]^ Ltb::[set] Ltb::[coherence] x y;

\definition minMath (x: Grothendieck) (y: Grothendieck): Grothendieck := toMath (Min::[set] (fromMath x) (fromMath y));

\definition minMatchesMath (x: Int^) (y: Int^): toMath (Min::[program]^ x y) = minMath (toMath x) (toMath y) := agreementIII Min::[program]^ Min::[set] Min::[coherence] x y;

\definition maxMath (x: Grothendieck) (y: Grothendieck): Grothendieck := toMath (Max::[set] (fromMath x) (fromMath y));

\definition maxMatchesMath (x: Int^) (y: Int^): toMath (Max::[program]^ x y) = maxMath (toMath x) (toMath y) := agreementIII Max::[program]^ Max::[set] Max::[coherence] x y;

\definition signMath (x: Grothendieck): Grothendieck := toMath (Sign::[set] (fromMath x));

\definition signMatchesMath (x: Int^): toMath (Sign::[program]^ x) = signMath (toMath x) := agreementII Sign::[program]^ Sign::[set] Sign::[coherence] x;

\definition evenMath (x: Grothendieck): Bool := (Even::[set] (fromMath x));

\definition evenMatchesMath (x: Int^): (Even::[program]^ x) = evenMath (toMath x) := agreementIB Even::[program]^ Even::[set] Even::[coherence] x;

\definition oddMath (x: Grothendieck): Bool := (Odd::[set] (fromMath x));

\definition oddMatchesMath (x: Int^): (Odd::[program]^ x) = oddMath (toMath x) := agreementIB Odd::[program]^ Odd::[set] Odd::[coherence] x;

\definition powMath (x: Grothendieck) (n: Nat): Grothendieck := toMath (Pow::[set] (fromMath x) n);

\definition powMatchesMath (x: Int^) (n: Nat): toMath (Pow::[program]^ x n) = powMath (toMath x) n := agreementINI Pow::[program]^ Pow::[set] Pow::[coherence] x n;

\definition positiveMath (x: Grothendieck): Nat := (Positive::[set] (fromMath x));

\definition positiveMatchesMath (x: Int^): (Positive::[program]^ x) = positiveMath (toMath x) := agreementIN Positive::[program]^ Positive::[set] Positive::[coherence] x;

\definition negativeMath (x: Grothendieck): Nat := (Negative::[set] (fromMath x));

\definition negativeMatchesMath (x: Int^): (Negative::[program]^ x) = negativeMath (toMath x) := agreementIN Negative::[program]^ Negative::[set] Negative::[coherence] x;

\definition chooseMath (test: Bool) (yes: Grothendieck) (no: Grothendieck): Grothendieck := toMath (Choose::[set] test (fromMath yes)
    (fromMath no));

\definition chooseMatchesMath (test: Bool) (yes: Int^) (no: Int^): toMath (Choose::[program]^ test yes no) =
    chooseMath test (toMath yes) (toMath no) := agreementBIII Choose::[program]^ Choose::[set] Choose::[coherence] test yes no;

\definition zeroMath: Grothendieck := toMath Zero::[set];
\definition zeroMatchesMath: toMath Zero::[program]^ = zeroMath := toMathCong Zero::[program]^ Zero::[set] Zero::[coherence];

\definition oneMath: Grothendieck := toMath One::[set];
\definition oneMatchesMath: toMath One::[program]^ = oneMath := toMathCong One::[program]^ One::[set] One::[coherence];

\definition minusOneMath: Grothendieck := toMath MinusOne::[set];
\definition minusOneMatchesMath: toMath MinusOne::[program]^ = minusOneMath := toMathCong MinusOne::[program]^ MinusOne::[set]
    MinusOne::[coherence];

\definition diffMath (a, b: Nat): Grothendieck := class (pair a b);
\definition diffMatchesMath (a, b: Nat): toMath (Diff::[program]^ a b) = diffMath a b := trans!{\Pow Difference} (toMath (Diff::[program]^ a b)) (toMath (Diff::[set] a b)) (class (pair a b))
    (toMathCong (Diff::[program]^ a b) (Diff::[set] a b) (congr!{Diff::[Type]^ _} (\fun (f: _) => f a b) _ _ Diff::[coherence])) (toFromClass (pair a b));
\definition Le (x, y: Int^): \Prop := Leb::[program]^ x y = boolTrue!{};
\definition Lt (x, y: Int^): \Prop := Ltb::[program]^ x y = boolTrue!{};
\definition LeMath (x, y: Grothendieck): \Prop := lebMath x y =
    boolTrue!{};
\definition LtMath (x, y: Grothendieck): \Prop := ltbMath x y =
    boolTrue!{};
