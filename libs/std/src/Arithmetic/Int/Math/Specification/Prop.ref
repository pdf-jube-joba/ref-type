\import \parent.Def[] \as Def;

\definition mathInduction(P: Grothendieck -> \Prop):
  (\forall (x: Difference) -> P (class x)) -> \forall (C: Grothendieck) -> P C :=
  Quotient.induction P;
\definition addMathCongLeft(x, y, z: Grothendieck):
  x = y ->
  addMath x z = addMath y z :=
    \fun (e: x = y) =>
    (\idelim x = y \with C: \Pow Difference =>
        \forall (hc: IsClass C) -> addMath x z = addMath (\into[\Pow Difference](C, ClassSet) \by { hc }) z
        \by { base: (\fun (hc: IsClass x) => \refl(addMath x z)), equality: e }) (classProperty y);
\definition addRepComm(x, y: Difference): Equivalent (addRep x y) (addRep y x) := equivalentOfFields (addRep x y) (addRep y x)
    (NL.addComm (pos x) (pos y)) (NL.addComm (negPart x) (negPart y));
\definition addRepAssoc(x, y, z: Difference):
  Equivalent (addRep (addRep x y) z) (addRep x (addRep y z)) := equivalentOfFields (addRep (addRep x y) z) (addRep x (addRep y z))
    (NL.addAssoc (pos x) (pos y) (pos z)) (NL.addAssoc (negPart x) (negPart y) (negPart z));
\definition addMathZeroLeft: \forall (x: Grothendieck) -> addMath Def.zeroMath x = x :=
  mathInduction (\fun (x: Grothendieck) => addMath Def.zeroMath x = x)
    (\fun (x: Difference) => trans!{\Pow Difference} _ _ _ (addMathClass (pair natZero!{} natZero!{}) x)
      (classOfEq (addRep (pair natZero!{} natZero!{}) x) x
        (equivalentOfFields (addRep (pair natZero!{} natZero!{}) x) x
          (NL.addZeroLeft (pos x)) (NL.addZeroLeft (negPart x)))));
\definition addMathComm: \forall (x, y: Grothendieck) -> addMath x y = addMath y x :=
  mathInduction (\fun (x: Grothendieck) => \forall (y: Grothendieck) -> addMath x y = addMath y x)
    (\fun (x: Difference) => mathInduction (\fun (y: Grothendieck) => addMath (class x) y = addMath y (class x))
      (\fun (y: Difference) => equiv_reason!{trans!{\Pow Difference}
        "by" { addMathClass x y }
        "by" { classOfEq (addRep x y) (addRep y x) (addRepComm x y) }
        "by" { sym!{\Pow Difference} _ _ (addMathClass y x) }}));
\definition mulMathComm: \forall (x, y: Grothendieck) -> mulMath x y = mulMath y x :=
  mathInduction (\fun (x: Grothendieck) =>
    \forall (y: Grothendieck) -> mulMath x y = mulMath y x)
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) =>
        mulMath (class x) y = mulMath y (class x))
        (\fun (y: Difference) =>
          equiv_reason!{trans!{\Pow Difference}
            "by" { mulMathClass x y }
            "by" { classOfEq (mulRep x y) (mulRep y x) (mulRepComm x y) }
            "by" { sym!{\Pow Difference} _ _ (mulMathClass y x) }}));
\definition addMathZeroRight(x: Grothendieck): addMath x Def.zeroMath = x := trans!{\Pow Difference} _ _ _ (addMathComm x Def.zeroMath) (addMathZeroLeft x);
\definition addMathAssoc:
  \forall (x, y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y z) :=
  mathInduction (\fun (x: Grothendieck) => \forall (y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y
    z))
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) => \forall (z: Grothendieck) ->
        addMath (addMath (class x) y) z = addMath (class x) (addMath y z))
        (\fun (y: Difference) =>
          mathInduction (\fun (z: Grothendieck) => addMath (addMath (class x) (class y)) z =
            addMath (class x) (addMath (class y) z))
            (\fun (z: Difference) => equiv_reason!{trans!{\Pow Difference}
              "by" { addMathCongLeft (addMath (class x) (class y)) (class (addRep x y)) (class z) (addMathClass x
                y) }
              "by" { addMathClass (addRep x y) z }
              "by" { classOfEq (addRep (addRep x y) z) (addRep x (addRep y z)) (addRepAssoc x y
                z) }
              "by" { sym!{\Pow Difference} _ _ (addMathClass x (addRep y z)) }
              "by" { addMathCongRight (class x) (class (addRep y z)) (addMath (class y) (class z))
                (sym!{\Pow Difference} _ _ (addMathClass y z)) }})));
\definition negMathInverse: \forall (x: Grothendieck) -> addMath (negMath x) x = Def.zeroMath :=
  mathInduction (\fun (x: Grothendieck) => addMath (negMath x) x = Def.zeroMath)
    (\fun (x: Difference) => equiv_reason!{trans!{\Pow Difference}
      "by" { addMathCongLeft (negMath (class x)) (class (negRep x)) (class x) (negMathClass x) }
      "by" { addMathClass (negRep x) x }
      "by" { classOfEq (addRep (negRep x) x) (pair natZero!{} natZero!{})
        (trans!{Nat} _ _ _ (NL.addComm (negPart x) (pos x))
          (sym!{Nat} _ _ (NL.addZeroLeft (NatOp.Add.specification (pos x) (negPart x))))) }});
\definition toMathInjective(x, y: Int^):
  toMath x = toMath y ->
  x = y :=
    \fun (e: toMath x = toMath y) =>
    trans!{Int^} x (fromMath (toMath x)) y (sym!{Int^} _ _ (fromTo x))
        ((\idelim toMath y = toMath x \with C: \Pow Difference =>
          \forall (hc: IsClass C) -> fromMath (\into[\Pow Difference](C, ClassSet) \by { hc }) = y
          \by { base: (\fun (hc: IsClass (toMath y)) => fromTo y), equality: sym!{\Pow Difference} (toMath x) (toMath y) e })
          (classProperty (toMath x)));
\definition addComm(x, y: Int^): Add.specification x y = Add.specification y x := toMathInjective (Add.specification x y) (Add.specification y x)
    (equiv_reason!{trans!{\Pow Difference}
      "by" { addSetMatchesMath x y }
      "by" { addMathComm (toMath x) (toMath y) }
      "by" { sym!{\Pow Difference} _ _ (addSetMatchesMath y x) }});
\definition mulComm(x, y: Int^): Mul.specification x y = Mul.specification y x := toMathInjective (Mul.specification x y) (Mul.specification y x)
    (equiv_reason!{trans!{\Pow Difference}
      "by" { mulSetMatchesMath x y }
      "by" { mulMathComm (toMath x) (toMath y) }
      "by" { sym!{\Pow Difference} _ _ (mulSetMatchesMath y x) }});
\definition addZeroLeft(x: Int^): Add.specification Zero.specification x = x := toMathInjective (Add.specification Zero.specification x) x
    (trans!{\Pow Difference} _ _ _ (addSetMatchesMath Zero.specification x) (addMathZeroLeft (toMath x)));
\definition addZeroRight(x: Int^): Add.specification x Zero.specification = x := trans!{Int^} _ _ _ (addComm x Zero.specification) (addZeroLeft x);
\definition negInverse(x: Int^): Add.specification (Neg.specification x) x = Zero.specification := toMathInjective (Add.specification (Neg.specification x) x) Zero.specification
    (equiv_reason!{trans!{\Pow Difference}
      "by" { addSetMatchesMath (Neg.specification x) x }
      "by" { addMathCongLeft (toMath (Neg.specification x)) (negMath (toMath x)) (toMath x) (negSetMatchesMath
        x) }
      "by" { negMathInverse (toMath x) }});

\definition addAssoc(x, y, z: Int^): Add.specification (Add.specification x y) z = Add.specification x (Add.specification y z) :=
    toMathInjective (Add.specification (Add.specification x y) z) (Add.specification x (Add.specification y z))
      (equiv_reason!{trans!{\Pow Difference}
        "by" { addSetMatchesMath (Add.specification x y) z }
        "by" { addMathCongLeft
          (toMath (Add.specification x y))
          (addMath (toMath x) (toMath y))
          (toMath z)
          (addSetMatchesMath x y) }
        "by" { addMathAssoc (toMath x) (toMath y) (toMath z) }
        "by" { addMathCongRight
          (toMath x)
          (addMath (toMath y) (toMath z))
          (toMath (Add.specification y z))
          (sym!{\Pow Difference} _ _ (addSetMatchesMath y z)) }
        "by" { sym!{\Pow Difference} _ _
          (addSetMatchesMath x (Add.specification y z)) }});

\definition negInverseRight(x: Int^): Add.specification x (Neg.specification x) = Zero.specification :=
    trans!{Int^} _ _ _ (addComm x (Neg.specification x)) (negInverse x);
