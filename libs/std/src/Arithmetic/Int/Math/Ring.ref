/* Ring laws for formal differences.  Rat uses these laws while its public
 * numerator carrier is the canonical Int type. */
\definition Integer: \Set := Difference;
\definition positive: Integer -> Nat := pos;
\definition negative: Integer -> Nat := negPart;
\definition integer: Nat -> Nat -> Integer := pair;
\definition zeroInteger: Integer := pair N.Nat^::zero N.Nat^::zero;
\definition oneInteger: Integer := pair (N.Nat^::succ N.Nat^::zero) N.Nat^::zero;
\definition negInteger: Integer -> Integer := negRep;
\definition addInteger: Integer -> Integer -> Integer := addRep;
\definition mulInteger: Integer -> Integer -> Integer := mulRep;
\definition subInteger: Integer -> Integer -> Integer := subRep;
\definition IntegerEq: Integer -> Integer -> \Prop := Equivalent;

\definition integerEqRefl (x: Integer): IntegerEq x x :=
    \refl(N.add^ (positive x) (negative x));

\definition integerEqSym (x, y: Integer) (xy: IntegerEq x y): IntegerEq y x :=
    sym!{Nat}
      (N.add^ (positive x) (negative y))
      (N.add^ (positive y) (negative x))
      xy;

/* Rearranging four summands is the normalization step used by transitivity. */
\definition integerAddShuffle (a, b, c, d: Nat):
  N.add^ (N.add^ a b) (N.add^ c d) =
    N.add^ (N.add^ a d) (N.add^ c b) :=
    equiv_reason!{trans!{Nat}
      "by" { NL.addInterchange a b c d }
      "by" { congr!{Nat Nat} (N.add^ (N.add^ a c)) _ _ (NL.addComm b d) }
      "by" { sym!{Nat} _ _ (NL.addInterchange a d c b) }};

\definition integerEqTrans (x, y, z: Integer) (xy: IntegerEq x y) (yz: IntegerEq y z): IntegerEq x z :=
    NL.addCancelRight
      (N.add^ (positive y) (negative y))
      (N.add^ (positive x) (negative z))
      (N.add^ (positive z) (negative x))
      (equiv_reason!{trans!{Nat}
         "by" { integerAddShuffle
           (positive x) (negative z) (positive y) (negative y) }
         "by" { congr2!{Nat Nat Nat} N.add^
           (N.add^ (positive x) (negative y))
           (N.add^ (positive y) (negative x))
           (N.add^ (positive y) (negative z))
           (N.add^ (positive z) (negative y))
           xy yz }
         "by" { NL.addInterchange
           (positive y) (negative x) (positive z) (negative y) }
         "by" { congr!{Nat Nat}
           (\fun (n: Nat) =>
             N.add^ n (N.add^ (negative x) (negative y)))
           _ _ (NL.addComm (positive y) (positive z)) }
         "by" { sym!{Nat} _ _
           (NL.addInterchange
             (positive z) (negative x)
             (positive y) (negative y)) }});

\definition integerEqOfFields (x, y: Integer) (p: positive x = positive y) (n: negative x = negative y): IntegerEq x y :=
    congr2!{Nat Nat Nat} N.add^
      _ _ _ _ p (sym!{Nat} _ _ n);

\definition addIntegerRespects (x, y, u, v: Integer) (xy: IntegerEq x y) (uv: IntegerEq u v):
    IntegerEq (addInteger x u) (addInteger y v) :=
    equiv_reason!{trans!{Nat}
      "by" { NL.addInterchange
        (positive x) (positive u) (negative y) (negative v) }
      "by" { congr2!{Nat Nat Nat} N.add^
        (N.add^ (positive x) (negative y))
        (N.add^ (positive y) (negative x))
        (N.add^ (positive u) (negative v))
        (N.add^ (positive v) (negative u))
        xy uv }
      "by" { sym!{Nat} _ _
        (NL.addInterchange
          (positive y) (positive v) (negative x) (negative u)) }};

\definition negIntegerRespects (x, y: Integer) (xy: IntegerEq x y): IntegerEq (negInteger x) (negInteger y) :=
    equiv_reason!{trans!{Nat}
      "by" { NL.addComm (negative x) (positive y) }
      "by" { sym!{Nat}
        (N.add^ (positive x) (negative y))
        (N.add^ (positive y) (negative x)) xy }
      "by" { NL.addComm (positive x) (negative y) }};

\definition subIntegerRespects (x, y, u, v: Integer) (xy: IntegerEq x y) (uv: IntegerEq u v):
    IntegerEq (subInteger x u) (subInteger y v) :=
    addIntegerRespects x y (negInteger u) (negInteger v)
      xy (negIntegerRespects u v uv);

\definition scaleInteger (x: Integer) (n: Nat): Integer :=
    integer (N.mul^ (positive x) n) (N.mul^ (negative x) n);

\definition scaleIntegerRespects (x, y: Integer) (n: Nat) (xy: IntegerEq x y): IntegerEq (scaleInteger x n) (scaleInteger y n) :=
    equiv_reason_terms!{trans!{Nat} { N.add^ (N.mul^ (positive x) n) (N.mul^ (negative y) n) }
      "~" { N.mul^ (N.add^ (positive x) (negative y)) n } "by" { sym!{Nat}
        (N.mul^ (N.add^ (positive x) (negative y)) n)
        (N.add^ (N.mul^ (positive x) n) (N.mul^ (negative y) n))
        (NL.mulDistribRight (positive x) (negative y) n) }
      "~" { N.mul^ (N.add^ (positive y) (negative x)) n } "by" { congr!{Nat Nat} (\fun (a: Nat) => N.mul^ a n)
        (N.add^ (positive x) (negative y))
        (N.add^ (positive y) (negative x)) xy }
      "~" { N.add^ (N.mul^ (positive y) n) (N.mul^ (negative x) n) } "by" { NL.mulDistribRight (positive y) (negative x) n }};

\definition scaleIntegerZero (n: Nat):
    IntegerEq (scaleInteger zeroInteger n) zeroInteger :=
    integerEqOfFields (scaleInteger zeroInteger n) zeroInteger
      (NL.mulZeroLeft n)
      (NL.mulZeroLeft n);

\definition scaleIntegerMul (x, y: Integer) (n: Nat):
    IntegerEq
      (scaleInteger (mulInteger x y) n)
      (mulInteger x (scaleInteger y n)) :=
    integerEqOfFields
      (scaleInteger (mulInteger x y) n)
      (mulInteger x (scaleInteger y n))
      (trans!{Nat} _ _ _
        (NL.mulDistribRight
          (N.mul^ (positive x) (positive y))
          (N.mul^ (negative x) (negative y))
          n)
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulAssoc (positive x) (positive y) n)
          (NL.mulAssoc (negative x) (negative y) n)))
      (trans!{Nat} _ _ _
        (NL.mulDistribRight
          (N.mul^ (positive x) (negative y))
          (N.mul^ (negative x) (positive y))
          n)
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulAssoc (positive x) (negative y) n)
          (NL.mulAssoc (negative x) (positive y) n)));

\definition natMulSwapRight (x, a, b: Nat):
  N.mul^ (N.mul^ x a) b = N.mul^ (N.mul^ x b) a :=
    equiv_reason!{trans!{Nat}
      "by" { NL.mulAssoc x a b }
      "by" { congr!{Nat Nat} (N.mul^ x) _ _ (NL.mulComm a b) }
      "by" { sym!{Nat} _ _ (NL.mulAssoc x b a) }};

\definition scaleIntegerSwap (x: Integer) (a, b: Nat):
    IntegerEq (scaleInteger (scaleInteger x a) b)
      (scaleInteger (scaleInteger x b) a) :=
    integerEqOfFields
      (scaleInteger (scaleInteger x a) b)
      (scaleInteger (scaleInteger x b) a)
      (natMulSwapRight (positive x) a b)
      (natMulSwapRight (negative x) a b);

\definition scaleIntegerCancelPositive (x, y: Integer) (k: Nat) (xy:
    IntegerEq
      (scaleInteger x (N.Nat^::succ k))
      (scaleInteger y (N.Nat^::succ k))):
    IntegerEq x y :=

    NL.mulCancelRightSucc k
      (N.add^ (positive x) (negative y))
      (N.add^ (positive y) (negative x))
      (equiv_reason_terms!{trans!{Nat} { N.mul^ (N.add^ (positive x) (negative y)) (N.Nat^::succ k) }
        "~" { N.add^
          (N.mul^ (positive x) (N.Nat^::succ k))
          (N.mul^ (negative y) (N.Nat^::succ k)) } "by" { NL.mulDistribRight (positive x) (negative y) (N.Nat^::succ k) }
        "~" { N.add^
            (N.mul^ (positive y) (N.Nat^::succ k))
            (N.mul^ (negative x) (N.Nat^::succ k)) } "by" { xy }
        "~" { N.mul^ (N.add^ (positive y) (negative x)) (N.Nat^::succ k) } "by" { sym!{Nat}
          (N.mul^ (N.add^ (positive y) (negative x)) (N.Nat^::succ k))
          (N.add^
            (N.mul^ (positive y) (N.Nat^::succ k))
            (N.mul^ (negative x) (N.Nat^::succ k)))
          (NL.mulDistribRight
            (positive y) (negative x) (N.Nat^::succ k)) }});

\definition mulIntegerAsSum (x, y: Integer):
    IntegerEq (mulInteger x y)
      (addInteger
        (scaleInteger x (positive y))
        (negInteger (scaleInteger x (negative y)))) :=
    integerEqOfFields (mulInteger x y)
      (addInteger
        (scaleInteger x (positive y))
        (negInteger (scaleInteger x (negative y))))
      (\refl(positive (mulInteger x y)))
      (NL.addComm
        (N.mul^ (positive x) (negative y))
        (N.mul^ (negative x) (positive y)));

\definition mulIntegerComm (x, y: Integer): IntegerEq (mulInteger x y) (mulInteger y x) :=
    integerEqOfFields (mulInteger x y) (mulInteger y x)
      (congr2!{Nat Nat Nat} N.add^ _ _ _ _
        (NL.mulComm (positive x) (positive y))
        (NL.mulComm (negative x) (negative y)))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulComm (positive x) (negative y))
          (NL.mulComm (negative x) (positive y)))
        (NL.addComm
          (N.mul^ (negative y) (positive x))
          (N.mul^ (positive y) (negative x))));

\definition mulIntegerNegLeft (x, y: Integer):
    IntegerEq (mulInteger (negInteger x) y)
      (negInteger (mulInteger x y)) :=
    integerEqOfFields
      (mulInteger (negInteger x) y)
      (negInteger (mulInteger x y))
      (NL.addComm
        (N.mul^ (negative x) (positive y))
        (N.mul^ (positive x) (negative y)))
      (NL.addComm
        (N.mul^ (negative x) (negative y))
        (N.mul^ (positive x) (positive y)));

\definition mulIntegerNegRight (x, y: Integer):
    IntegerEq (mulInteger x (negInteger y))
      (negInteger (mulInteger x y)) :=
  equiv_reason_terms!{integerEqTrans
    { mulInteger x (negInteger y) }
    "~" { mulInteger (negInteger y) x }
    "by" { mulIntegerComm x (negInteger y) }
    "~" { negInteger (mulInteger y x) }
    "by" { mulIntegerNegLeft y x }
    "~" { negInteger (mulInteger x y) }
    "by" { negIntegerRespects (mulInteger y x) (mulInteger x y)
      (mulIntegerComm y x) }};

\definition mulIntegerRespectsLeft (x, y, z: Integer) (xy: IntegerEq x y): IntegerEq (mulInteger x z) (mulInteger y z) :=
  equiv_reason_terms!{integerEqTrans
    { mulInteger x z }
    "~" { addInteger (scaleInteger x (positive z))
      (negInteger (scaleInteger x (negative z))) }
    "by" { mulIntegerAsSum x z }
    "~" { addInteger (scaleInteger y (positive z))
      (negInteger (scaleInteger y (negative z))) }
    "by" { addIntegerRespects
      (scaleInteger x (positive z)) (scaleInteger y (positive z))
      (negInteger (scaleInteger x (negative z)))
      (negInteger (scaleInteger y (negative z)))
      (scaleIntegerRespects x y (positive z) xy)
      (negIntegerRespects (scaleInteger x (negative z))
        (scaleInteger y (negative z)) (scaleIntegerRespects x y (negative z) xy)) }
    "~" { mulInteger y z }
    "by" { integerEqSym (mulInteger y z)
      (addInteger (scaleInteger y (positive z))
        (negInteger (scaleInteger y (negative z)))) (mulIntegerAsSum y z) }};

\definition mulIntegerRespects (x, y, u, v: Integer) (xy: IntegerEq x y) (uv: IntegerEq u v):
    IntegerEq (mulInteger x u) (mulInteger y v) :=
  equiv_reason_terms!{integerEqTrans
    { mulInteger x u }
    "~" { mulInteger y u } "by" { mulIntegerRespectsLeft x y u xy }
    "~" { mulInteger u y } "by" { mulIntegerComm y u }
    "~" { mulInteger v y } "by" { mulIntegerRespectsLeft u v y uv }
    "~" { mulInteger y v } "by" { mulIntegerComm v y }};

\definition addIntegerZeroLeft (x: Integer): IntegerEq (addInteger zeroInteger x) x :=
    integerEqOfFields (addInteger zeroInteger x) x
      (NL.addZeroLeft (positive x))
      (NL.addZeroLeft (negative x));

\definition addIntegerZeroRight (x: Integer): IntegerEq (addInteger x zeroInteger) x :=
    integerEqOfFields (addInteger x zeroInteger) x
      (NL.addZeroRight (positive x))
      (NL.addZeroRight (negative x));

\definition addIntegerComm (x, y: Integer):
    IntegerEq (addInteger x y) (addInteger y x) :=
    integerEqOfFields (addInteger x y) (addInteger y x)
      (NL.addComm (positive x) (positive y))
      (NL.addComm (negative x) (negative y));

\definition addIntegerAssoc (x, y, z: Integer):
    IntegerEq (addInteger (addInteger x y) z)
      (addInteger x (addInteger y z)) :=
    integerEqOfFields
      (addInteger (addInteger x y) z)
      (addInteger x (addInteger y z))
      (NL.addAssoc (positive x) (positive y) (positive z))
      (NL.addAssoc (negative x) (negative y) (negative z));

\definition mulIntegerDistribLeft (x, y, z: Integer):
    IntegerEq
      (mulInteger x (addInteger y z))
      (addInteger (mulInteger x y) (mulInteger x z)) :=
    integerEqOfFields
      (mulInteger x (addInteger y z))
      (addInteger (mulInteger x y) (mulInteger x z))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulDistribLeft
            (positive x) (positive y) (positive z))
          (NL.mulDistribLeft
            (negative x) (negative y) (negative z)))
        (NL.addInterchange
          (N.mul^ (positive x) (positive y))
          (N.mul^ (positive x) (positive z))
          (N.mul^ (negative x) (negative y))
          (N.mul^ (negative x) (negative z))))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulDistribLeft
            (positive x) (negative y) (negative z))
          (NL.mulDistribLeft
            (negative x) (positive y) (positive z)))
        (NL.addInterchange
          (N.mul^ (positive x) (negative y))
          (N.mul^ (positive x) (negative z))
          (N.mul^ (negative x) (positive y))
          (N.mul^ (negative x) (positive z))));

\definition mulIntegerDistribRight (x, y, z: Integer):
    IntegerEq
      (mulInteger (addInteger x y) z)
      (addInteger (mulInteger x z) (mulInteger y z)) :=
  equiv_reason_terms!{integerEqTrans
    { mulInteger (addInteger x y) z }
    "~" { mulInteger z (addInteger x y) }
    "by" { mulIntegerComm (addInteger x y) z }
    "~" { addInteger (mulInteger z x) (mulInteger z y) }
    "by" { mulIntegerDistribLeft z x y }
    "~" { addInteger (mulInteger x z) (mulInteger y z) }
    "by" { addIntegerRespects
      (mulInteger z x) (mulInteger x z)
      (mulInteger z y) (mulInteger y z)
      (mulIntegerComm z x) (mulIntegerComm z y) }};

\definition mulIntegerAssoc (x, y, z: Integer):
    IntegerEq
      (mulInteger (mulInteger x y) z)
      (mulInteger x (mulInteger y z)) :=

    integerEqTrans
      (mulInteger (mulInteger x y) z)
      (addInteger
        (scaleInteger (mulInteger x y) (positive z))
        (negInteger
          (scaleInteger (mulInteger x y) (negative z))))
      (mulInteger x (mulInteger y z))
      (mulIntegerAsSum (mulInteger x y) z)
      (integerEqTrans
        (addInteger
          (scaleInteger (mulInteger x y) (positive z))
          (negInteger
            (scaleInteger (mulInteger x y) (negative z))))
        (addInteger
          (mulInteger x (scaleInteger y (positive z)))
          (negInteger
            (mulInteger x (scaleInteger y (negative z)))))
        (mulInteger x (mulInteger y z))
        (addIntegerRespects
          (scaleInteger (mulInteger x y) (positive z))
          (mulInteger x (scaleInteger y (positive z)))
          (negInteger
            (scaleInteger (mulInteger x y) (negative z)))
          (negInteger
            (mulInteger x (scaleInteger y (negative z))))
          (scaleIntegerMul x y (positive z))
          (negIntegerRespects
            (scaleInteger (mulInteger x y) (negative z))
            (mulInteger x (scaleInteger y (negative z)))
            (scaleIntegerMul x y (negative z))))
        (integerEqTrans
          (addInteger
            (mulInteger x (scaleInteger y (positive z)))
            (negInteger
              (mulInteger x (scaleInteger y (negative z)))))
          (addInteger
            (mulInteger x (scaleInteger y (positive z)))
            (mulInteger x
              (negInteger (scaleInteger y (negative z)))))
          (mulInteger x (mulInteger y z))
          (addIntegerRespects
            (mulInteger x (scaleInteger y (positive z)))
            (mulInteger x (scaleInteger y (positive z)))
            (negInteger
              (mulInteger x (scaleInteger y (negative z))))
            (mulInteger x
              (negInteger (scaleInteger y (negative z))))
            (integerEqRefl
              (mulInteger x (scaleInteger y (positive z))))
            (integerEqSym
              (mulInteger x
                (negInteger (scaleInteger y (negative z))))
              (negInteger
                (mulInteger x (scaleInteger y (negative z))))
              (mulIntegerNegRight x
                (scaleInteger y (negative z)))))
          (integerEqTrans
            (addInteger
              (mulInteger x (scaleInteger y (positive z)))
              (mulInteger x
                (negInteger (scaleInteger y (negative z)))))
            (mulInteger x
              (addInteger
                (scaleInteger y (positive z))
                (negInteger (scaleInteger y (negative z)))))
            (mulInteger x (mulInteger y z))
            (integerEqSym
              (mulInteger x
                (addInteger
                  (scaleInteger y (positive z))
                  (negInteger (scaleInteger y (negative z)))))
              (addInteger
                (mulInteger x (scaleInteger y (positive z)))
                (mulInteger x
                  (negInteger (scaleInteger y (negative z)))))
              (mulIntegerDistribLeft x
                (scaleInteger y (positive z))
                (negInteger (scaleInteger y (negative z)))))
            (mulIntegerRespects
              x x
              (addInteger
                (scaleInteger y (positive z))
                (negInteger (scaleInteger y (negative z))))
              (mulInteger y z)
              (integerEqRefl x)
              (integerEqSym
                (mulInteger y z)
                (addInteger
                  (scaleInteger y (positive z))
                  (negInteger (scaleInteger y (negative z))))
                (mulIntegerAsSum y z))))));

\definition mulIntegerCongRight (x, y, z: Integer) (yz: IntegerEq y z):
    IntegerEq (mulInteger x y) (mulInteger x z) :=
    mulIntegerRespects
      x x y z (integerEqRefl x) yz;

\definition mulIntegerInterchange (a, b, c, d: Integer):
    IntegerEq
      (mulInteger (mulInteger a b) (mulInteger c d))
      (mulInteger (mulInteger a c) (mulInteger b d)) :=

    integerEqTrans
      (mulInteger (mulInteger a b) (mulInteger c d))
      (mulInteger a
        (mulInteger b (mulInteger c d)))
      (mulInteger (mulInteger a c) (mulInteger b d))
      (mulIntegerAssoc a b (mulInteger c d))
      (integerEqTrans
        (mulInteger a
          (mulInteger b (mulInteger c d)))
        (mulInteger a
          (mulInteger (mulInteger b c) d))
        (mulInteger (mulInteger a c) (mulInteger b d))
        (mulIntegerCongRight a
          (mulInteger b (mulInteger c d))
          (mulInteger (mulInteger b c) d)
          (integerEqSym
            (mulInteger (mulInteger b c) d)
            (mulInteger b (mulInteger c d))
            (mulIntegerAssoc b c d)))
        (integerEqTrans
          (mulInteger a
            (mulInteger (mulInteger b c) d))
          (mulInteger a
            (mulInteger (mulInteger c b) d))
          (mulInteger (mulInteger a c) (mulInteger b d))
          (mulIntegerCongRight a
            (mulInteger (mulInteger b c) d)
            (mulInteger (mulInteger c b) d)
            (mulIntegerRespects
              (mulInteger b c) (mulInteger c b)
              d d
              (mulIntegerComm b c)
              (integerEqRefl d)))
          (integerEqTrans
            (mulInteger a
              (mulInteger (mulInteger c b) d))
            (mulInteger a
              (mulInteger c (mulInteger b d)))
            (mulInteger (mulInteger a c) (mulInteger b d))
            (mulIntegerCongRight a
              (mulInteger (mulInteger c b) d)
              (mulInteger c (mulInteger b d))
              (mulIntegerAssoc c b d))
            (integerEqSym
              (mulInteger (mulInteger a c) (mulInteger b d))
              (mulInteger a
                (mulInteger c (mulInteger b d)))
              (mulIntegerAssoc a c (mulInteger b d))))));

\definition negIntegerInvolutive (x: Integer): IntegerEq (negInteger (negInteger x)) x := integerEqRefl x;

\definition addIntegerNegRight (x: Integer):
    IntegerEq (addInteger x (negInteger x)) zeroInteger :=
    equiv_reason!{trans!{Nat}
      "by" { NL.addZeroRight
        (N.add^ (positive x) (negative x)) }
      "by" { NL.addComm (positive x) (negative x) }
      "by" { sym!{Nat} _ _ (NL.addZeroLeft
        (N.add^ (negative x) (positive x))) }};

\definition addIntegerNegLeft (x: Integer):
    IntegerEq (addInteger (negInteger x) x) zeroInteger :=
    integerEqTrans
      (addInteger (negInteger x) x)
      (addInteger x (negInteger x))
      zeroInteger
      (addIntegerComm (negInteger x) x)
      (addIntegerNegRight x);

\definition mulIntegerZeroRight (x: Integer): IntegerEq (mulInteger x zeroInteger) zeroInteger :=
    integerEqOfFields (mulInteger x zeroInteger) zeroInteger
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulZeroRight (positive x))
          (NL.mulZeroRight (negative x)))
        (NL.addZeroLeft N.Nat^::zero))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulZeroRight (positive x))
          (NL.mulZeroRight (negative x)))
        (NL.addZeroLeft N.Nat^::zero));

\definition mulIntegerZeroLeft (x: Integer): IntegerEq (mulInteger zeroInteger x) zeroInteger :=
    integerEqTrans
      (mulInteger zeroInteger x)
      (mulInteger x zeroInteger)
      zeroInteger
      (mulIntegerComm zeroInteger x)
      (mulIntegerZeroRight x);

\definition mulIntegerOneRight (x: Integer): IntegerEq (mulInteger x oneInteger) x :=
    integerEqOfFields (mulInteger x oneInteger) x
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulOneRight (positive x))
          (NL.mulZeroRight (negative x)))
        (NL.addZeroRight (positive x)))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} N.add^ _ _ _ _
          (NL.mulZeroRight (positive x))
          (NL.mulOneRight (negative x)))
        (NL.addZeroLeft (negative x)));

\definition mulIntegerOneLeft (x: Integer): IntegerEq (mulInteger oneInteger x) x :=
    integerEqTrans
      (mulInteger oneInteger x)
      (mulInteger x oneInteger)
      x
      (mulIntegerComm oneInteger x)
      (mulIntegerOneRight x);
