/* Cancelling a common summand is the key to representative independence. */
\import std.Logic[].Rel[] \as Rel;
\definition diffAddCommon:
  \forall (k, a, b: Nat) ->
  Diff.specification (NatOp.Add.specification a k) (NatOp.Add.specification b k) = Diff.specification a b :=
  \induction (k: N.Nat^) \return \forall (a, b: Nat) -> Diff.specification (NatOp.Add.specification a k) (NatOp.Add.specification b k) = Diff.specification a b \with {
    | zero : (\fun (a, b: Nat) => \refl(Diff.specification a b))
    | succ : (\fun (k: Nat) => \fun (ih: \forall (a, b: Nat) -> Diff.specification (NatOp.Add.specification a k) (NatOp.Add.specification b k) = Diff.specification a b) =>
      \fun (a, b: Nat) => equiv_reason!{trans!{Int^}
        "by" { congr!{Nat Int^} (\fun (x: Nat) => Diff.specification x (NatOp.Add.specification b (N.Nat^::succ k))) _ _ (NL.addSuccRight a k) }
        "by" { congr!{Nat Int^} (Diff.specification (N.Nat^::succ (NatOp.Add.specification a k))) _ _ (NL.addSuccRight b k) }
        "by" { ih a b }})
    };
\definition diffRespects(a, b, c, d: Nat):
  NatOp.Add.specification a d = NatOp.Add.specification c b ->
  Diff.specification a b = Diff.specification c d :=
    \fun (e: NatOp.Add.specification a d = NatOp.Add.specification c b) =>
    equiv_reason!{trans!{Int^}
        "by" { sym!{Int^} _ _ (diffAddCommon d a b) }
        "by" { congr!{Nat Int^} (\fun (x: Nat) => Diff.specification x (NatOp.Add.specification b d)) _ _ e }
        "by" { congr!{Nat Int^} (Diff.specification (NatOp.Add.specification c b)) _ _ (NL.addComm b d) }
        "by" { diffAddCommon b c d }};

/* The normal form represents the original formal difference. */
\definition diffBalance:
  \forall (b, a: Nat) ->
  NatOp.Add.specification a (Negative.specification (Diff.specification a b)) = NatOp.Add.specification (Positive.specification (Diff.specification a b)) b :=
  \induction (b: N.Nat^) \return \forall (a: Nat) ->
      NatOp.Add.specification a (Negative.specification (Diff.specification a b)) = NatOp.Add.specification (Positive.specification (Diff.specification a b)) b \with {
    | zero : (\fun (a: Nat) => \refl(a))
    | succ : (\fun (b: Nat) => \fun (ih: \forall (a: Nat) ->
      NatOp.Add.specification a (Negative.specification (Diff.specification a b)) = NatOp.Add.specification (Positive.specification (Diff.specification a b)) b) =>
      \induction (a: N.Nat^) \return NatOp.Add.specification a (Negative.specification (Diff.specification a (N.Nat^::succ b))) =
          NatOp.Add.specification (Positive.specification (Diff.specification a (N.Nat^::succ b))) (N.Nat^::succ b) \with {
      | zero : (\refl(NatOp.Add.specification N.Nat^::zero (N.Nat^::succ b)))
      | succ : (\fun (a: Nat) => \fun (unused: NatOp.Add.specification a (Negative.specification (Diff.specification a (N.Nat^::succ b))) =
          NatOp.Add.specification (Positive.specification (Diff.specification a (N.Nat^::succ b))) (N.Nat^::succ b)) =>
          equiv_reason!{trans!{Nat}
            "by" { NL.addSuccLeft a (Negative.specification (Diff.specification a b)) }
            "by" { NatOp.succCong _ _ (ih a) }
            "by" { sym!{Nat} _ _ (NL.addSuccRight (Positive.specification (Diff.specification a b)) b) }})
      })
    };

\definition Equivalent(x, y: Difference): \Prop :=
  NatOp.Add.specification (pos x) (negPart y) = NatOp.Add.specification (pos y) (negPart x);
\definition equivalentRefl: Rel.Reflexive Difference Equivalent :=
  \fun (x: _) => \refl(NatOp.Add.specification (pos x) (negPart x));
\definition equivalentSym: Rel.Symmetric Difference Equivalent :=
  \fun (x, y: _) =>
    sym!{Nat} (NatOp.Add.specification (pos x) (negPart y)) (NatOp.Add.specification (pos y) (negPart x));
\definition addShuffle(a, b, c, d: Nat):
  NatOp.Add.specification (NatOp.Add.specification a b) (NatOp.Add.specification c d) = NatOp.Add.specification (NatOp.Add.specification a d) (NatOp.Add.specification c b) :=
  equiv_reason!{trans!{Nat}
    "by" { NL.addInterchange a b c d }
    "by" { congr!{Nat Nat} (NatOp.Add.specification (NatOp.Add.specification a c)) _ _ (NL.addComm b d) }
    "by" { sym!{Nat} _ _ (NL.addInterchange a d c b) }};
\definition equivalentTrans: Rel.Transitive Difference Equivalent :=
  \fun (x, y, z: Difference) (xy: Equivalent x y) (yz: Equivalent y z) =>
    NL.addCancelRight (NatOp.Add.specification (pos y) (negPart y))
      (NatOp.Add.specification (pos x) (negPart z)) (NatOp.Add.specification (pos z) (negPart x))
      eq_reason!{
        { NatOp.Add.specification (NatOp.Add.specification (pos x) (negPart z)) (NatOp.Add.specification (pos y) (negPart y)) }
        "=" { NatOp.Add.specification (NatOp.Add.specification (pos x) (negPart y)) (NatOp.Add.specification (pos y) (negPart z)) }
        "by" { addShuffle (pos x) (negPart z) (pos y) (negPart y) }
        "=" { NatOp.Add.specification (NatOp.Add.specification (pos y) (negPart x)) (NatOp.Add.specification (pos z) (negPart y)) }
        "by" { congr2!{Nat Nat Nat} NatOp.Add.specification
          (NatOp.Add.specification (pos x) (negPart y)) (NatOp.Add.specification (pos y) (negPart x))
          (NatOp.Add.specification (pos y) (negPart z)) (NatOp.Add.specification (pos z) (negPart y)) xy yz }
        "=" { NatOp.Add.specification (NatOp.Add.specification (pos y) (pos z)) (NatOp.Add.specification (negPart x) (negPart y)) }
        "by" { NL.addInterchange (pos y) (negPart x) (pos z) (negPart y) }
        "=" { NatOp.Add.specification (NatOp.Add.specification (pos z) (pos y)) (NatOp.Add.specification (negPart x) (negPart y)) }
        "by" { congr!{Nat Nat} (\fun (n: Nat) => NatOp.Add.specification n (NatOp.Add.specification (negPart x) (negPart y)))
          _ _ (NL.addComm (pos y) (pos z)) }
        "=" { NatOp.Add.specification (NatOp.Add.specification (pos z) (negPart x)) (NatOp.Add.specification (pos y) (negPart y)) }
        "by" { sym!{Nat} _ _ (NL.addInterchange (pos z) (negPart x) (pos y) (negPart y)) }
      };
\definition normalize(x: Difference): Int^ := Diff.specification (pos x) (negPart x);
\definition representative(z: Int^): Difference := pair (Positive.specification z) (Negative.specification z);
\definition normalizeRespects(x, y: Difference): Equivalent x y -> normalize x = normalize y := diffRespects (pos x) (negPart x) (pos y) (negPart y);
\definition representativeNormalize(x: Difference): Equivalent x (representative (normalize x)) := diffBalance (negPart x) (pos x);
\definition equivalentOfNormalize(x, y: Difference):
  normalize x = normalize y ->
  Equivalent x y :=
    \fun (e: normalize x = normalize y) =>
    equiv_reason_terms!{equivalentTrans { x }
        "~" { representative (normalize x) } "by" { representativeNormalize x }
        "~" { y } "by" { \idelim normalize y = normalize x \with z: Int^ => Equivalent (representative z) y
          \by { base: equivalentSym y (representative (normalize y)) (representativeNormalize y), equality: sym!{Int^} _ _ e } }};

/* Specialize the shared quotient implementation to formal differences. */
\import std.Set[].Quotient[A := Difference, Equivalent := Equivalent] \as Quotient;
\definition equivalenceLaws: Quotient.EquivalenceLaws := Quotient.EquivalenceLaws {
  reflexive := equivalentRefl,
  symmetric := equivalentSym,
  transitive := equivalentTrans,
};

/* Actual equivalence classes, not merely a setoid of representatives. */
\definition ClassOf(x: Difference): \Pow Difference :=
  Quotient.ClassOf x;
\definition classOfEq(x, y: Difference):
  Equivalent x y ->
  ClassOf x = ClassOf y :=
  Quotient.classOfEq equivalenceLaws x y;
\definition equivalentOfClassEq(x, y: Difference):
  ClassOf x = ClassOf y ->
  Equivalent x y :=
  Quotient.equivalentOfClassEq equivalenceLaws x y;
\definition Representatives(C: \Pow Difference): \Pow Difference := { x : Difference \where C = ClassOf x };
\definition IsClass(C: \Pow Difference): \Prop :=
  Quotient.IsClass C;
\definition ClassSet: \Pow (\Pow Difference) :=
  Quotient.ClassSet;
\definition Grothendieck: \Set :=
  Quotient.Carrier;
\definition class(x: Difference): Grothendieck :=
  Quotient.class x;
\definition toMath(z: Int^): Grothendieck := class (representative z);
\definition classProperty(C: Grothendieck): IsClass C :=
  Quotient.classProperty C;
\definition representativesExist(C: Grothendieck): \exists \Cast[Difference] (Representatives C) := classProperty C (\exists \Cast[Difference] (Representatives C))
    (\fun (x: Difference) => \fun (cx: C = ClassOf x) =>
      \exact(\into[Difference](x, Representatives C) \by { cx }, \Cast[Difference] (Representatives C)));
\definition sameClassNormal(C: \Pow Difference) (x, y: Difference):
  C = ClassOf x -> C = ClassOf y ->
  normalize x = normalize y :=
      \fun (cx: C = ClassOf x) (cy: C = ClassOf y) =>
    normalizeRespects x y (equivalentOfClassEq x y
          (\idelim C = ClassOf x \with D: \Pow Difference => D = ClassOf y \by { base: cy, equality: cx }));
\definition normalFormsUnique(C: Grothendieck) (x: \Cast[Difference] (Representatives C))
  (y: \Cast[Difference] (Representatives C)):
  normalize x =
    normalize y :=
    sameClassNormal C x y (\bysub(Difference, Representatives C, x)) (\bysub(Difference, Representatives C,
    y));
\definition NormalForms(C: Grothendieck): \Pow Int^ :=
  { z : Int^ \where \exists { x : \Cast[Difference] (Representatives C) \where normalize x = z } };
\definition NormalForm(C: Grothendieck): \Set := \Cast[Int^] (NormalForms C);
\definition normalFormWitness(C: Grothendieck) (x: \Cast[Difference] (Representatives C)):
  NormalForm C :=
  \into[Int^](normalize x, NormalForms C) \by {
    \exact(\into[\Cast[Difference] (Representatives C)](x,
      { y : \Cast[Difference] (Representatives C) \where normalize y = normalize x })
      \by { \refl(normalize x) },
      \Cast[\Cast[Difference] (Representatives C)]
        ({ y : \Cast[Difference] (Representatives C) \where normalize y = normalize x })) };
\definition normalFormExists(C: Grothendieck): \exists NormalForm C :=
  \take (x: \Cast[Difference] (Representatives C)) =>
    \exact(normalFormWitness C x, NormalForm C)
    \by { representativesExist C };
\definition normalFormUnique(C: Grothendieck) (u, v: NormalForm C): u = v :=
  \block {
    \takefrom x: \Cast[\Cast[Difference] (Representatives C)]
      ({ x : \Cast[Difference] (Representatives C) \where normalize x = u })
      \by \bysub(Int^, NormalForms C, u) \then
    \takefrom y: \Cast[\Cast[Difference] (Representatives C)]
      ({ y : \Cast[Difference] (Representatives C) \where normalize y = v })
      \by \bysub(Int^, NormalForms C, v) \then
    \return trans!{Int^} u (normalize x) v
      (sym!{Int^} _ _ (\bysub(\Cast[Difference] (Representatives C),
        { x : \Cast[Difference] (Representatives C) \where normalize x = u }, x)))
      (trans!{Int^} (normalize x) (normalize y) v (normalFormsUnique C x y)
        (\bysub(\Cast[Difference] (Representatives C),
          { y : \Cast[Difference] (Representatives C) \where normalize y = v }, y)))
  };
\definition fromMath(C: Grothendieck): Int^ :=
  \choice NormalForm C
    \by { existence: normalFormExists C, uniqueness: normalFormUnique C };
\definition normalFormEquals(C: Grothendieck) (x: \Cast[Difference] (Representatives C)):
  normalize x = fromMath C :=
  \choiceeq normalFormWitness C x \of NormalForm C
    \by { existence: normalFormExists C, uniqueness: normalFormUnique C };
\definition fromClass(x: Difference): fromMath (class x) = normalize x :=
  sym!{Int^} _ _ (normalFormEquals (class x)
    (\into[Difference](x, Representatives (class x)) \by { \refl(ClassOf x) }));
\definition fromTo(z: Int^): fromMath (toMath z) = z := trans!{Int^} _ _ _ (fromClass (representative z)) (diffCanonical z);
\definition toFromClass(x: Difference): toMath (normalize x) = class x := classOfEq (representative (normalize x)) x
    (equivalentSym x (representative (normalize x)) (representativeNormalize x));
\definition toFrom(C: Grothendieck): toMath (fromMath C) = C :=
    \take (x: \Cast[Difference] (Representatives C)) =>
      \block {
        \let normalized: normalize x = fromMath C :=
          normalFormEquals C x \then
        \let mathClass: toMath (fromMath C) = ClassOf x :=
          \idelim normalize x = fromMath C \with z: Int^ => toMath z = ClassOf x
            \by { base: toFromClass x, equality: normalized } \then
        \let chosenClass: ClassOf x = C :=
          sym!{\Pow Difference} _ _ (\bysub(Difference, Representatives C, x)) \then
        \return \idelim ClassOf x = C \with D: \Pow Difference =>
          toMath (fromMath C) = D
          \by { base: mathClass, equality: chosenClass }
      }
    \by { representativesExist C };

\definition addRep(x, y: Difference): Difference :=
  pair (NatOp.Add.specification (pos x) (pos y)) (NatOp.Add.specification (negPart x) (negPart y));
\definition negRep(x: Difference): Difference := pair (negPart x) (pos x);
\definition subRep(x, y: Difference): Difference := addRep x (negRep y);
\definition scaleRep(x: Difference) (n: Nat): Difference :=
  pair (NatOp.Mul.specification (pos x) n) (NatOp.Mul.specification (negPart x) n);
\definition mulRep(x, y: Difference): Difference :=
  pair (NatOp.Add.specification (NatOp.Mul.specification (pos x) (pos y)) (NatOp.Mul.specification (negPart x) (negPart y)))
       (NatOp.Add.specification (NatOp.Mul.specification (pos x) (negPart y)) (NatOp.Mul.specification (negPart x) (pos y)));
\definition equivalentOfFields(x, y: Difference):
  pos x = pos y -> negPart x = negPart y ->
  Equivalent x y :=
    \fun (p: _) (n: _) =>
    NL.addCong (pos x) (pos y) (negPart y) (negPart x) p (sym!{Nat} _ _ n);
\definition addRepRespects(x, y, u, v: Difference):
  Equivalent x y -> Equivalent u v ->
  Equivalent (addRep x u) (addRep y v) :=
    \fun (xy: _) (uv: _) =>
    equiv_reason!{trans!{Nat}
        "by" { NL.addInterchange (pos x) (pos u) (negPart y) (negPart v) }
        "by" { NL.addCong (NatOp.Add.specification (pos x) (negPart y)) (NatOp.Add.specification (pos y) (negPart x))
          (NatOp.Add.specification (pos u) (negPart v)) (NatOp.Add.specification (pos v) (negPart u)) xy uv }
        "by" { sym!{Nat} _ _ (NL.addInterchange (pos y) (pos v) (negPart x) (negPart u)) }};
\definition negRepRespects(x, y: Difference):
  Equivalent x y ->
  Equivalent (negRep x) (negRep y) :=
    \fun (xy: _) =>
    trans!{Nat} _ _ _ (NL.addComm (negPart x) (pos y))
        (trans!{Nat} (NatOp.Add.specification (pos y) (negPart x)) (NatOp.Add.specification (pos x) (negPart y))
          (NatOp.Add.specification (negPart y) (pos x))
          (sym!{Nat} (NatOp.Add.specification (pos x) (negPart y)) (NatOp.Add.specification (pos y) (negPart x)) xy)
          (NL.addComm (pos x) (negPart y)));
\definition subRepRespects(x, y, u, v: Difference):
  Equivalent x y -> Equivalent u v ->
  Equivalent (subRep x u) (subRep y v) :=
    \fun (xy: _) (uv: _) =>
    addRepRespects x y (negRep u) (negRep v) xy (negRepRespects u v uv);
\definition scaleRepRespects(x, y: Difference) (n: Nat):
  Equivalent x y ->
  Equivalent (scaleRep x n) (scaleRep y n) :=
    \fun (xy: Equivalent x y) =>
    equiv_reason!{trans!{Nat}
        "by" { sym!{Nat} _ _ (NL.mulDistribRight (pos x) (negPart y) n) }
        "by" { congr!{Nat Nat} (\fun (a: Nat) => NatOp.Mul.specification a n)
          (NatOp.Add.specification (pos x) (negPart y)) (NatOp.Add.specification (pos y) (negPart x)) xy }
        "by" { NL.mulDistribRight (pos y) (negPart x) n }};
\definition mulRepAsSum(x, y: Difference):
  Equivalent (mulRep x y) (addRep (scaleRep x (pos y)) (negRep (scaleRep x (negPart y)))) := equivalentOfFields (mulRep x y)
    (addRep (scaleRep x (pos y)) (negRep (scaleRep x (negPart y))))
    (\refl(pos (mulRep x y))) (NL.addComm (NatOp.Mul.specification (pos x) (negPart y)) (NatOp.Mul.specification (negPart x) (pos y)));
\definition mulRepComm(x, y: Difference): Equivalent (mulRep x y) (mulRep y x) := equivalentOfFields (mulRep x y) (mulRep y x)
    (NL.addCong _ _ _ _ (NL.mulComm (pos x) (pos y)) (NL.mulComm (negPart x) (negPart y)))
    (trans!{Nat} _ _ _
      (NL.addCong _ _ _ _ (NL.mulComm (pos x) (negPart y)) (NL.mulComm (negPart x) (pos y)))
      (NL.addComm (NatOp.Mul.specification (negPart y) (pos x)) (NatOp.Mul.specification (pos y) (negPart x))));
\definition mulRepRespectsLeft(x, y, z: Difference):
  Equivalent x y ->
  Equivalent (mulRep x z) (mulRep y z) :=
  \fun (xy: _) =>
    equiv_reason_terms!{equivalentTrans
      { mulRep x z }
      "~" { addRep (scaleRep x (pos z)) (negRep (scaleRep x (negPart z))) }
      "by" { mulRepAsSum x z }
      "~" { addRep (scaleRep y (pos z)) (negRep (scaleRep y (negPart z))) }
      "by" { addRepRespects (scaleRep x (pos z)) (scaleRep y (pos z))
        (negRep (scaleRep x (negPart z))) (negRep (scaleRep y (negPart z)))
        (scaleRepRespects x y (pos z) xy)
        (negRepRespects (scaleRep x (negPart z)) (scaleRep y (negPart z))
          (scaleRepRespects x y (negPart z) xy)) }
      "~" { mulRep y z }
      "by" { equivalentSym (mulRep y z)
        (addRep (scaleRep y (pos z)) (negRep (scaleRep y (negPart z)))) (mulRepAsSum y z) }};
\definition mulRepRespects(x, y, u, v: Difference):
  Equivalent x y -> Equivalent u v ->
  Equivalent (mulRep x u) (mulRep y v) :=
  \fun (xy: _) (uv: _) =>
    equiv_reason_terms!{equivalentTrans
      { mulRep x u }
      "~" { mulRep y u } "by" { mulRepRespectsLeft x y u xy }
      "~" { mulRep u y } "by" { mulRepComm y u }
      "~" { mulRep v y } "by" { mulRepRespectsLeft u v y uv }
      "~" { mulRep y v } "by" { mulRepComm v y }};

\definition toMathCong(x, y: Int^):
  x = y ->
  toMath x = toMath y :=
    \fun (e: x = y) =>
    \idelim x = y \with z: Int^ => toMath x = toMath z \by { base: \refl(toMath x), equality: e };

/* Relational images define operations without choosing representatives. */
\definition UnaryRespects(f: Difference -> Difference): \Prop :=
  Quotient.UnaryRespects f;
\definition BinaryRespects(f: Difference -> Difference -> Difference): \Prop :=
  Quotient.BinaryRespects f;
\definition sameClassRelated(C: \Pow Difference) (x, y: Difference):
  C = ClassOf x -> C = ClassOf y ->
  Equivalent x y :=
  Quotient.sameClassRelated equivalenceLaws C x y;
\definition UnaryImage(f: Difference -> Difference) (C: \Pow Difference): \Pow Difference :=
  Quotient.UnaryImage f C;
\definition unaryImageClass(f: Difference -> Difference):
  UnaryRespects f -> \forall (C: \Pow Difference) -> \forall (x: Difference) ->
  C = ClassOf x ->
  UnaryImage f C = ClassOf (f x) :=
  Quotient.unaryImageClass equivalenceLaws f;
\definition unaryImageClosed(f: Difference -> Difference):
  UnaryRespects f -> \forall (C: Grothendieck) ->
  IsClass (UnaryImage f C) :=
  Quotient.unaryImageClosed equivalenceLaws f;
\definition BinaryImage(f: Difference -> Difference -> Difference) (C, D: \Pow Difference):
  \Pow Difference :=
  Quotient.BinaryImage f C D;
\definition binaryImageClass(f: Difference -> Difference -> Difference):
  BinaryRespects f -> \forall (C, D: \Pow Difference) ->
  \forall (x, y: Difference) -> C = ClassOf x -> D = ClassOf y ->
  BinaryImage f C D = ClassOf (f x y) :=
  Quotient.binaryImageClass equivalenceLaws f;
\definition binaryImageClosed(f: Difference -> Difference -> Difference):
  BinaryRespects f -> \forall (C, D: Grothendieck) ->
  IsClass (BinaryImage f C D) :=
  Quotient.binaryImageClosed equivalenceLaws f;

/* Addition and multiplication use the formulas on formal differences. */
\definition addMath(C, D: Grothendieck): Grothendieck :=
  \into[\Pow Difference](BinaryImage addRep C D, ClassSet) \by { binaryImageClosed addRep addRepRespects C
    D };
\definition negMath(C: Grothendieck): Grothendieck :=
  \into[\Pow Difference](UnaryImage negRep C, ClassSet) \by { unaryImageClosed negRep negRepRespects C };
\definition mulMath(C, D: Grothendieck): Grothendieck :=
  \into[\Pow Difference](BinaryImage mulRep C D, ClassSet) \by { binaryImageClosed mulRep mulRepRespects C
    D };
\definition subMath(x, y: Grothendieck): Grothendieck := addMath x
    (negMath y);
\definition addMathClass(x, y: Difference): addMath (class x) (class y) = class (addRep x y) := binaryImageClass addRep addRepRespects (class x) (class y) x y (\refl(ClassOf x))
    (\refl(ClassOf y));
\definition negMathClass(x: Difference): negMath (class x) = class (negRep x) := unaryImageClass negRep negRepRespects (class x) x (\refl(ClassOf x));
\definition mulMathClass(x, y: Difference): mulMath (class x) (class y) = class (mulRep x y) := binaryImageClass mulRep mulRepRespects (class x) (class y) x y (\refl(ClassOf x))
    (\refl(ClassOf y));
\definition addMathCongRight(x, y, z: Grothendieck):
  y = z ->
  addMath x y = addMath x z :=
    \fun (e: y = z) =>
    (\idelim y = z \with C: \Pow Difference =>
        \forall (hc: IsClass C) -> addMath x y = addMath x (\into[\Pow Difference](C, ClassSet) \by { hc })
        \by { base: (\fun (hc: IsClass y) => \refl(addMath x y)), equality: e }) (classProperty z);
\definition subMathClass(x, y: Difference): subMath (class x) (class y) = class (subRep x y) := trans!{\Pow Difference} (subMath (class x) (class y)) (addMath (class x) (class (negRep y))) (class
    (subRep x y))
    (addMathCongRight (class x) (negMath (class y)) (class (negRep y)) (negMathClass y))
    (addMathClass x (negRep y));
\definition addSetMatchesMath(x, y: Int^): toMath (Add.specification x y) = addMath (toMath x) (toMath y) :=
  trans!{\Pow Difference} _ _ _ (toFromClass (addRep (representative x) (representative y)))
    (sym!{\Pow Difference} _ _ (addMathClass (representative x) (representative y)));

\definition addMatchesMath(x, y: Int^): toMath (Add.program^ x y) = addMath (toMath x) (toMath y) :=
  trans!{\Pow Difference} _ _ _
    (toMathCong (Add.program^ x y) (Add.specification x y)
      (congr!{Add.T^ _} (\fun (operation: _) => operation x y) _ _ Add.coherence))
    (addSetMatchesMath x y);
\definition negSetMatchesMath(x: Int^): toMath (Neg.specification x) = negMath (toMath x) :=
  trans!{\Pow Difference} _ _ _ (toFromClass (negRep (representative x)))
    (sym!{\Pow Difference} _ _ (negMathClass (representative x)));

\definition negMatchesMath(x: Int^): toMath (Neg.program^ x) = negMath (toMath x) :=
  trans!{\Pow Difference} _ _ _
    (toMathCong (Neg.program^ x) (Neg.specification x)
      (congr!{Neg.T^ _} (\fun (operation: _) => operation x) _ _ Neg.coherence))
    (negSetMatchesMath x);
\definition mulSetMatchesMath(x, y: Int^): toMath (Mul.specification x y) = mulMath (toMath x) (toMath y) :=
  trans!{\Pow Difference} _ _ _ (toFromClass (mulRep (representative x) (representative y)))
    (sym!{\Pow Difference} _ _ (mulMathClass (representative x) (representative y)));

\definition mulMatchesMath(x, y: Int^): toMath (Mul.program^ x y) = mulMath (toMath x) (toMath y) :=
  trans!{\Pow Difference} _ _ _
    (toMathCong (Mul.program^ x y) (Mul.specification x y)
      (congr!{Mul.T^ _} (\fun (operation: _) => operation x y) _ _ Mul.coherence))
    (mulSetMatchesMath x y);
\definition subMatchesMath(x, y: Int^): toMath (Sub.program^ x y) = subMath (toMath x) (toMath y) := trans!{\Pow Difference} (toMath (Sub.program^ x y)) (addMath (toMath x) (toMath (Neg.program^ y))) (subMath (toMath x)
    (toMath y)) (addMatchesMath x (Neg.program^ y))
    (addMathCongRight (toMath x) (toMath (Neg.program^ y)) (negMath (toMath y)) (negMatchesMath y));

\definition roundTripArg(x: Int^): x = fromMath (toMath x) := sym!{Int^} (fromMath (toMath x)) x (fromTo x);

\module Specification;
\module Ring;
