\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Logic.either;
\use Equality.sym;
\use Equality.trans;
\definition Carrier: \Set := \Cast[A] domain;
\definition Member[x: A]: \Prop := \In[A] domain x;
\definition Values[f: Carrier -> B][default: B][x: A]: \Pow B :=
  { y: B \where Logic.Or[
    Logic.And[Member x, \forall (z: Carrier) -> z = x -> y = f z],
    Logic.And[Logic.Not (Member x), y = default]] };
\definition Value[f: Carrier -> B][default: B][x: A]: \Set := \Cast[B] (Values f default x);
\definition existsValue: \forall (f: Carrier -> B)(default: B)(x: A) -> \exists Value f default x :=
  \fun (f: _)(default: _)(x: _) => either!{{(Classical.excludedMiddle (Member x))} {\exists Value f default x}
    {\fun (member: Member x) => \exact(\into[B](f (\into[A](x, domain) \by { member }), Values f default x) \by {
      Logic.Or[_, _]::left (Logic.And[_, _]::# member
        (\fun (z: Carrier)(equal: z = x) => \idelim (\into[A](x, domain) \by { member }) = z
          \with w: Carrier => f (\into[A](x, domain) \by { member }) = f w \by {
            base: \refl(f (\into[A](x, domain) \by { member })), equality: sym!{A} z x equal
          }))
    }, Value f default x)}
    {\fun (outside: _) => \exact(\into[B](default, Values f default x) \by {
      Logic.Or[_, _]::right (Logic.And[_, _]::# outside (\refl(default)))
    }, Value f default x)}
  };
\definition uniqueValue: \forall (f: Carrier -> B)(default: B)(x: A)(left, right: Value f default x) -> left = right :=
  \fun (f: _)(default: _)(x: _)(left, right: _) => either!{{(\bysub(B, Values f default x, left))} {left = right}
    {\fun (lp: Logic.And[Member x, \forall (z: Carrier) -> z = x -> left = f z]) => either!{{(\bysub(B, Values f default x, right))} {left = right}
      {\fun (rp: Logic.And[Member x, \forall (z: Carrier) -> z = x -> right = f z]) => trans!{B} left (f (\into[A](x, domain) \by { lp.left })) right
        (lp.right (\into[A](x, domain) \by { lp.left }) (\refl(x)))
        (sym!{B} right (f (\into[A](x, domain) \by { lp.left })) (rp.right (\into[A](x, domain) \by { lp.left }) (\refl(x))))}
      {\fun (rn: Logic.And[Logic.Not (Member x), right = default]) => Logic.falseElim (left = right) (rn.left (lp.left))}
    }}
    {\fun (ln: Logic.And[Logic.Not (Member x), left = default]) => either!{{(\bysub(B, Values f default x, right))} {left = right}
      {\fun (rp: Logic.And[Member x, \forall (z: Carrier) -> z = x -> right = f z]) => Logic.falseElim (left = right) (ln.left (rp.left))}
      {\fun (rn: Logic.And[Logic.Not (Member x), right = default]) => trans!{B} left default right (ln.right) (sym!{B} right default (rn.right))}
    }}
  };
\definition extend[f: Carrier -> B][default: B][x: A]: B :=
  \choice Value f default x \by { existence: existsValue f default x, uniqueness: uniqueValue f default x };
\definition inside: \forall (f: Carrier -> B)(default: B)(x: Carrier) -> extend f default x = f x :=
  \fun (f: _)(default: _)(x: _) => sym!{B} (f x) (extend f default x)
    (\choiceeq \into[B](f x, Values f default x) \by {
      Logic.Or[_, _]::left (Logic.And[_, _]::# (\bysub(A, domain, x))
        (\fun (z: Carrier)(equal: z = x) => \idelim x = z \with w: Carrier => f x = f w \by {
          base: \refl(f x), equality: sym!{A} z x equal
        }))
    } \of Value f default x \by { existence: existsValue f default x, uniqueness: uniqueValue f default x });
\definition outside: \forall (f: Carrier -> B)(default: B)(x: A) -> Logic.Not (Member x) -> extend f default x = default :=
  \fun (f: _)(default: _)(x: _)(notMember: _) => sym!{B} default (extend f default x)
    (\choiceeq \into[B](default, Values f default x) \by {
      Logic.Or[_, _]::right (Logic.And[_, _]::# notMember (\refl(default)))
    } \of Value f default x \by { existence: existsValue f default x, uniqueness: uniqueValue f default x });
\definition preserves: \forall (predicate: \Pow B)(f: Carrier -> B)(default: B) ->
  (\forall (x: Carrier) -> \In[B] predicate (f x)) -> \In[B] predicate default -> \forall (x: A) -> \In[B] predicate (extend f default x) :=
  \fun (predicate: _)(f: _)(default: _)(values: _)(atDefault: _)(x: _) => either!{{(Classical.excludedMiddle (Member x))} {\In[B] predicate (extend f default x)}
    {\fun (member: _) => \block {
      \let local: Carrier := \into[A](x, domain) \by { member } \then
      \return \idelim f local = extend f default x \with y: B => \In[B] predicate y \by {
        base: values local, equality: sym!{B} _ _ (inside f default local)
      }
    }}
    {\fun (notMember: _) => \idelim default = extend f default x \with y: B => \In[B] predicate y \by {
      base: atDefault, equality: sym!{B} _ _ (outside f default x notMember)
    }}
  };
