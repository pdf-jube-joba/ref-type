\import std.Logic[].Relation[] \as Rel;
\definition EquivalenceLaws: \Prop := Rel.Equivalence[A, Equivalent];

/* Equivalence classes and representative-independent operations. */
\import std.Logic[].Equality[] \as QuotientEquality;
\use QuotientEquality.sym;
\use QuotientEquality.trans;

/* The equivalence class represented by x. */
\definition ClassOf(x: A): \Pow A :=
  { y: A \where Equivalent x y };

/* Equivalent representatives determine the same subset. */
\definition classOfEq:
  EquivalenceLaws ->
  \forall (x, y: A) ->
  Equivalent x y ->
  ClassOf x = ClassOf y :=
  \fun (laws: EquivalenceLaws) (x, y: A) (xy: Equivalent x y) =>
    \axiom:setext(ClassOf x, ClassOf y,
      \fun (z: A)(xz: _) => #trans{laws} y x z (#sym{laws} x y xy) xz,
      \fun (z: A)(yz: _) => #trans{laws} x y z xy yz);

\definition Representative(C: \Pow A): \Set :=
  \Cast[A] ({ x: A \where C = ClassOf x });

\definition represents(C: \Pow A)(x: Representative C): C = ClassOf x :=
  \bysub(A, Representative C, x);

\definition IsClass(C: \Pow A): \Prop := \exists Representative C;

\definition isClassOf(C: \Pow A)(x: A): C = ClassOf x -> IsClass C :=
  \fun (same: _) => \exact(\into[A](x, Representative C) \by { same }, Representative C);

\definition ClassSet: \Pow (\Pow A) :=
  { C : \Pow A \where IsClass C };

/* The quotient A / Equivalent. */
\definition Carrier: \Set :=
  \Cast[\Pow A] ClassSet;

\definition mem(C: Carrier)(x: A): \Prop := \In[A] C x;

\definition underlying(x: Carrier): \Pow A := x;

/* Equality on the quotient is equality of its subsets. */
\definition Eq(x, y: Carrier): \Prop := x = y;

\definition eqByExt(x, y: Carrier):
  (\forall (z: A) -> mem x z -> mem y z) ->
  (\forall (z: A) -> mem y z -> mem x z) ->
  Eq x y := \fun (xy: _) (yx: _) =>
    \axiom:setext(underlying x, underlying y, xy, yx);

/* Every representative gives a genuine member of the quotient. */
\definition classIsClass(x: A): IsClass (ClassOf x) :=
  isClassOf (ClassOf x) x (\refl(ClassOf x));

\definition class(x: A): Carrier :=
  \into[\Pow A](ClassOf x, ClassSet) \by { classIsClass x };

\definition classMem(x, y: A):
  Equivalent x y -> mem (class x) y := \fun (xy: _) => xy;

\definition relatedOfClassMem(x, y: A):
  mem (class x) y -> Equivalent x y := \fun (xy: _) => xy;

\definition classProperty(C: Carrier): IsClass C := \bysub(\Pow A, ClassSet, C);

/* Propositions on the quotient are proved on representatives. */
\definition induction(P: Carrier -> \Prop):
  (\forall (x: A) -> P (class x)) -> \forall (C: Carrier) -> P C := \block {
    \fun (step: \forall (x: A) -> P (class x))(C: Carrier) \then
    \takefrom x: Representative C \by classProperty C \then
    \return \idelim class x = C \with D: Carrier => P D
      \by { base: step x, equality: sym!{Carrier} C (class x) (represents C x) }
  };

\definition equivalentOfClassEq:
  EquivalenceLaws ->
  \forall (x, y: A) ->
  ClassOf x = ClassOf y ->
  Equivalent x y :=
  \fun (laws: EquivalenceLaws) (x, y: A) (e: ClassOf x = ClassOf y) =>
    \idelim ClassOf y = ClassOf x \with C: \Pow A => \In[A] C y
      \by { base: #refl{laws} y, equality: sym!{\Pow A} (ClassOf x) (ClassOf y) e };

\definition sameClassRelated:
  EquivalenceLaws ->
  \forall (C: \Pow A) ->
  \forall (x, y: A) ->
  C = ClassOf x -> C = ClassOf y ->
  Equivalent x y :=
  \fun (laws: EquivalenceLaws) (C: \Pow A) (x, y: A) (cx: C = ClassOf x) (cy: C = ClassOf y) =>
    equivalentOfClassEq laws x y
      (trans!{\Pow A} (ClassOf x) C (ClassOf y)
        (sym!{\Pow A} C (ClassOf x) cx) cy);

/* Relational images lift representative-independent operations to the quotient. */
\definition UnaryRespects(f: A -> A): \Prop :=
  \forall (x, y: A) -> Equivalent x y -> Equivalent (f x) (f y);

\structure UnaryWitness[f: A -> A, C: \Pow A, z: A]: \Set {
  representative: Representative C,
  related: Equivalent (f representative) z,
}

\definition UnaryImage(f: A -> A)(C: \Pow A): \Pow A :=
  { z: A \where \exists UnaryWitness[f, C, z] };

\definition unaryImageClass:
  EquivalenceLaws -> \forall (f: A -> A) -> UnaryRespects f ->
  \forall (C: \Pow A)(x: A) -> C = ClassOf x ->
  UnaryImage f C = ClassOf (f x) := \block {
    \fun (laws: EquivalenceLaws)(f: A -> A)(respects: UnaryRespects f) \then
    \fun (C: \Pow A)(x: A)(cx: C = ClassOf x) \then
    \return \axiom:setext(UnaryImage f C, ClassOf (f x),
      \block {
        \fun (z: A)(member: \In[A] (UnaryImage f C) z) \then
        \takefrom witness: UnaryWitness[f, C, z] \by member \then
        \let y: Representative C := #representative{witness} \then
        \return #trans{laws} (f x) (f y) z
          (respects x y (sameClassRelated laws C x y cx (represents C y))) #related{witness}
      },
      \fun (z: A)(related: _) => \exact(UnaryWitness[f, C, z] {
        representative := \into[A](x, Representative C) \by { cx },
        related := related,
      }, UnaryWitness[f, C, z]))
  };

\definition unaryImageClosed:
  EquivalenceLaws -> \forall (f: A -> A) -> UnaryRespects f ->
  \forall (C: Carrier) -> IsClass (UnaryImage f C) := \block {
    \fun (laws: EquivalenceLaws)(f: A -> A)(respects: UnaryRespects f)(C: Carrier) \then
    \takefrom x: Representative C \by classProperty C \then
    \return isClassOf (UnaryImage f C) (f x)
      (unaryImageClass laws f respects C x (represents C x))
  };

\definition BinaryRespects(f: A -> A -> A): \Prop :=
  \forall (x, y, u, v: A) ->
    Equivalent x y -> Equivalent u v -> Equivalent (f x u) (f y v);

\structure BinaryWitness[f: A -> A -> A, C, D: \Pow A, z: A]: \Set {
  left: Representative C,
  right: Representative D,
  related: Equivalent (f left right) z,
}

\definition BinaryImage(f: A -> A -> A)(C, D: \Pow A): \Pow A :=
  { z: A \where \exists BinaryWitness[f, C, D, z] };

\definition binaryImageClass:
  EquivalenceLaws -> \forall (f: A -> A -> A) -> BinaryRespects f ->
  \forall (C, D: \Pow A)(x, y: A) -> C = ClassOf x -> D = ClassOf y ->
  BinaryImage f C D = ClassOf (f x y) := \block {
    \fun (laws: EquivalenceLaws)(f: A -> A -> A)(respects: BinaryRespects f) \then
    \fun (C, D: \Pow A)(x, y: A)(cx: C = ClassOf x)(dy: D = ClassOf y) \then
    \return \axiom:setext(BinaryImage f C D, ClassOf (f x y),
      \block {
        \fun (z: A)(member: \In[A] (BinaryImage f C D) z) \then
        \takefrom witness: BinaryWitness[f, C, D, z] \by member \then
        \let u: Representative C := #left{witness} \then
        \let v: Representative D := #right{witness} \then
        \return #trans{laws} (f x y) (f u v) z
          (respects x u y v
            (sameClassRelated laws C x u cx (represents C u))
            (sameClassRelated laws D y v dy (represents D v))) #related{witness}
      },
      \fun (z: A)(related: _) => \exact(BinaryWitness[f, C, D, z] {
        left := \into[A](x, Representative C) \by { cx },
        right := \into[A](y, Representative D) \by { dy },
        related := related,
      }, BinaryWitness[f, C, D, z]))
  };

\definition binaryImageClosed:
  EquivalenceLaws -> \forall (f: A -> A -> A) -> BinaryRespects f ->
  \forall (C, D: Carrier) -> IsClass (BinaryImage f C D) := \block {
    \fun (laws: EquivalenceLaws)(f: A -> A -> A)(respects: BinaryRespects f)(C, D: Carrier) \then
    \takefrom x: Representative C \by classProperty C \then
    \takefrom y: Representative D \by classProperty D \then
    \return isClassOf (BinaryImage f C D) (f x y)
      (binaryImageClass laws f respects C D x y (represents C x) (represents D y))
  };
