\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\structure Data: \Set {
  sequence: N.Nat^ -> A,
}
\structure Laws[data: Data]: \Prop {
  exhaustive: \forall (x: A) -> \exists { k: N.Nat^ \where data.sequence k = x },
}
\definition Enumerator: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition IsCountable: \Prop := \exists Enumerator;
\module FinitePowers;
