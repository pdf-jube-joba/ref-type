/* Finite subsets are subsets generated from empty by finitely many inserts. */
\import std.Logic[].Proposition[] \as Logic;

\definition Empty: \Pow A :=
  { x : A \where Logic.False };

\definition Insert(a: A) (X: \Pow A): \Pow A :=
  { x : A \where Logic.Or[x = a, \In[A] X x] };

\definition Singleton(a: A): \Pow A :=
  Insert a Empty;

/* This is {a, b}; it has at most two elements and collapses when a = b. */
\definition UnorderedPair(a, b: A): \Pow A :=
  Insert a (Singleton b);

/* Church induction characterizes the least class containing Empty and closed
 * under Insert, without requiring a recursive indexed datatype. */
\definition Finite(X: \Pow A): \Prop :=
  \forall (P: \Pow (\Pow A)) ->
    \In[\Pow A] P Empty ->
    (\forall (Y: \Pow A) -> \In[\Pow A] P Y ->
      \forall (a: A) -> \In[\Pow A] P (Insert a Y)) ->
    \In[\Pow A] P X;

\definition finiteEmpty: Finite Empty :=
  \fun (P: \Pow (\Pow A)) (empty: \In[\Pow A] P Empty)
    (insert: \forall (Y: \Pow A) -> \In[\Pow A] P Y ->
    \forall (a: A) -> \In[\Pow A] P (Insert a Y)) => empty;

\definition finiteInsert(a: A) (X: \Pow A):
  Finite X ->
  Finite (Insert a X) :=
  \fun (finite: Finite X) (P: \Pow (\Pow A)) (empty: \In[\Pow A] P Empty)
    (insert: \forall (Y: \Pow A) -> \In[\Pow A] P Y ->
      \forall (b: A) -> \In[\Pow A] P (Insert b Y)) =>
      insert X (finite P empty insert) a;

\definition FiniteSubsetSet: \Pow (\Pow A) :=
  { X : \Pow A \where Finite X };

\definition FiniteSubset: \Set :=
  \Cast[\Pow A] FiniteSubsetSet;

\definition underlying(X: FiniteSubset): \Pow A := X;

\definition finite(X: FiniteSubset): Finite (underlying X) :=
  \bysub(\Pow A, FiniteSubsetSet, X);

\definition induction:
  \forall (P: \Pow (\Pow A)) ->
    \In[\Pow A] P Empty ->
    (\forall (Y: \Pow A) -> \In[\Pow A] P Y ->
      \forall (a: A) -> \In[\Pow A] P (Insert a Y)) ->
    \forall (X: FiniteSubset) -> \In[\Pow A] P (underlying X) :=
  \fun (P: \Pow (\Pow A)) (empty: \In[\Pow A] P Empty)
    (insert: \forall (Y: \Pow A) -> \In[\Pow A] P Y ->
    \forall (a: A) -> \In[\Pow A] P (Insert a Y)) (X: FiniteSubset) => finite X P empty insert;

\definition empty: FiniteSubset :=
  \into[\Pow A](Empty, FiniteSubsetSet) \by { finiteEmpty };

\definition insert(a: A) (X: FiniteSubset): FiniteSubset :=
  \into[\Pow A](Insert a X, FiniteSubsetSet) \by { finiteInsert a X (finite X) };

\definition singleton(a: A): FiniteSubset :=
  \into[\Pow A](Singleton a, FiniteSubsetSet) \by { finiteInsert a Empty finiteEmpty };

/* This is {a, b}; it has at most two elements and collapses when a = b. */
\definition unorderedPair(a, b: A): FiniteSubset :=
  \into[\Pow A](UnorderedPair a b, FiniteSubsetSet) \by { finiteInsert a (Singleton b) (finiteInsert b Empty finiteEmpty) };

\definition Member(X: FiniteSubset) (x: A): \Prop :=
  \In[A] (underlying X) x;

\definition inInsertNew(a: A) (X: \Pow A): \In[A] (Insert a X) a :=
  Logic.Or[a = a, \In[A] X a]::left (\refl(a));

\definition inInsertOld(a: A) (X: \Pow A) (x: A):
  \In[A] X x ->
  \In[A] (Insert a X) x :=
  Logic.Or[x = a, \In[A] X x]::right;

\definition inSingleton(a: A): \In[A] (Singleton a) a :=
  inInsertNew a Empty;

\definition inUnorderedPairLeft(a, b: A): \In[A] (UnorderedPair a b) a :=
  inInsertNew a (Singleton b);

\definition inUnorderedPairRight(a, b: A): \In[A] (UnorderedPair a b) b :=
  inInsertOld a (Singleton b) b (inSingleton b);

\use Logic.either;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition Union(X, Y: \Pow A): \Pow A :=
  { x: A \where Logic.Or[\In[A] X x, \In[A] Y x] };
\definition unionEmpty(Y: \Pow A): Union Empty Y = Y :=
  \axiom:setext(Union Empty Y, Y,
    \fun (x: _) (member: _) => either!{{Logic.False} "or" {\In[A] Y x} "either" {\In[A] Y x}
      "lt:" {Logic.falseElim (\In[A] Y x)} "rt:" {\fun (h: _) => h}} member,
    \fun (x: _) (member: _) => Logic.Or[_, _]::right member);
\definition unionInsert(a: A) (X, Y: \Pow A): Union (Insert a X) Y = Insert a (Union X Y) :=
  \axiom:setext(Union (Insert a X) Y, Insert a (Union X Y),
    \fun (x: _) (member: _) => either!{{\In[A] (Insert a X) x} "or" {\In[A] Y x} "either" {\In[A] (Insert a (Union X Y)) x}
      "lt:" {\fun (h: _) => either!{{x = a} "or" {\In[A] X x} "either" {\In[A] (Insert a (Union X Y)) x}
        "lt:" {Logic.Or[_, _]::left}
        "rt:" {\fun (old: _) => Logic.Or[_, _]::right (Logic.Or[_, _]::left old)}} h}
      "rt:" {\fun (h: _) => Logic.Or[_, _]::right (Logic.Or[_, _]::right h)}} member,
    \fun (x: _) (member: _) => either!{{x = a} "or" {\In[A] (Union X Y) x} "either" {\In[A] (Union (Insert a X) Y) x}
      "lt:" {\fun (equal: _) => Logic.Or[_, _]::left (Logic.Or[_, _]::left equal)}
      "rt:" {\fun (h: _) => either!{{\In[A] X x} "or" {\In[A] Y x} "either" {\In[A] (Union (Insert a X) Y) x}
        "lt:" {\fun (old: _) => Logic.Or[_, _]::left (Logic.Or[_, _]::right old)}
        "rt:" {Logic.Or[_, _]::right}} h}} member);
\definition finiteUnion: \forall (X, Y: \Pow A) -> Finite X -> Finite Y -> Finite (Union X Y) :=
  \fun (X, Y: _) (finiteX: _) (finiteY: _) => finiteX
    ({ X: \Pow A \where Finite (Union X Y) })
    (\idelim Y = Union Empty Y \with Z: \Pow A => Finite Z
      \by { base: finiteY, equality: sym!{\Pow A} _ _ (unionEmpty Y) })
    (\fun (Z: _) (ih: _) (a: _) =>
      \idelim Insert a (Union Z Y) = Union (Insert a Z) Y \with W: \Pow A => Finite W
        \by { base: finiteInsert a (Union Z Y) ih, equality: sym!{\Pow A} _ _ (unionInsert a Z Y) });
\definition union(X, Y: FiniteSubset): FiniteSubset :=
  \into[\Pow A](Union X Y, FiniteSubsetSet) \by { finiteUnion X Y (finite X) (finite Y) };

\import std.Logic[].Classical[] \as Classical;
\definition Filter(X, Y: \Pow A): \Pow A := { x: A \where Logic.And[\In[A] X x, \In[A] Y x] };
\definition filterEmpty(Y: \Pow A): Filter Empty Y = Empty :=
  \axiom:setext(Filter Empty Y, Empty,
    \fun (x: A) (h: \In[A] (Filter Empty Y) x) => #left{h},
    \fun (x: A) (h: Logic.False) => Logic.falseElim (\In[A] (Filter Empty Y) x) h);
\definition filterInsertMember(a: A) (X, Y: \Pow A): \In[A] Y a ->
  Filter (Insert a X) Y = Insert a (Filter X Y) :=
  \fun (inY: _) => \axiom:setext(Filter (Insert a X) Y, Insert a (Filter X Y),
    \fun (x: A) (h: \In[A] (Filter (Insert a X) Y) x) =>
      either!{{x = a} "or" {\In[A] X x} "either" {\In[A] (Insert a (Filter X Y)) x}
        "lt:" {Logic.Or[_, _]::left}
        "rt:" {\fun (old: _) => Logic.Or[_, _]::right (Logic.And[_, _]::# old (#right{h}))}} (#left{h}),
    \fun (x: A) (h: \In[A] (Insert a (Filter X Y)) x) =>
      either!{{x = a} "or" {\In[A] (Filter X Y) x} "either" {\In[A] (Filter (Insert a X) Y) x}
        "lt:" {\fun (equal: _) => Logic.And[_, _]::# (Logic.Or[_, _]::left equal)
          (\idelim a = x \with b: A => \In[A] Y b \by { base: inY, equality: sym!{A} _ _ equal })}
        "rt:" {\fun (old: \In[A] (Filter X Y) x) => Logic.And[_, _]::# (Logic.Or[_, _]::right (#left{old})) (#right{old})}} h);
\definition filterInsertOutside(a: A) (X, Y: \Pow A): Logic.Not (\In[A] Y a) ->
  Filter (Insert a X) Y = Filter X Y :=
  \fun (outside: _) => \axiom:setext(Filter (Insert a X) Y, Filter X Y,
    \fun (x: A) (h: \In[A] (Filter (Insert a X) Y) x) =>
      either!{{x = a} "or" {\In[A] X x} "either" {\In[A] (Filter X Y) x}
        "lt:" {\fun (equal: _) => Logic.falseElim (\In[A] (Filter X Y) x)
          (outside (\idelim x = a \with b: A => \In[A] Y b \by { base: #right{h}, equality: equal }))}
        "rt:" {\fun (old: _) => Logic.And[_, _]::# old (#right{h})}} (#left{h}),
    \fun (x: A) (h: \In[A] (Filter X Y) x) =>
      Logic.And[_, _]::# (Logic.Or[_, _]::right (#left{h})) (#right{h}));
\definition finiteFilter: \forall (X, Y: \Pow A) -> Finite X -> Finite (Filter X Y) :=
  \fun (X, Y: _) (finiteX: _) => finiteX
    ({ X: \Pow A \where Finite (Filter X Y) })
    (\idelim Empty = Filter Empty Y \with Z: \Pow A => Finite Z
      \by { base: finiteEmpty, equality: sym!{\Pow A} _ _ (filterEmpty Y) })
    (\fun (Z: _) (ih: _) (a: _) => either!{{\In[A] Y a} "or" {Logic.Not (\In[A] Y a)} "either" {Finite (Filter (Insert a Z) Y)}
      "lt:" {\fun (member: _) => \idelim Insert a (Filter Z Y) = Filter (Insert a Z) Y
        \with W: \Pow A => Finite W
        \by { base: finiteInsert a (Filter Z Y) ih, equality: sym!{\Pow A} _ _ (filterInsertMember a Z Y member) }}
      "rt:" {\fun (outside: _) => \idelim Filter Z Y = Filter (Insert a Z) Y
        \with W: \Pow A => Finite W
        \by { base: ih, equality: sym!{\Pow A} _ _ (filterInsertOutside a Z Y outside) }}}
      (Classical.excludedMiddle (\In[A] Y a)));
\definition filter(X: FiniteSubset) (Y: \Pow A): FiniteSubset :=
  \into[\Pow A](Filter X Y, FiniteSubsetSet) \by { finiteFilter X Y (finite X) };
\module Selection(B: \Set);
\module Family;
\module Enumeration;
\module Image(B: \Set);
