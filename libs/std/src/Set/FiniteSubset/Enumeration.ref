\import std.Data[].List[] \as L;
\import L.Distinct[A := A] \as Distinct;
\definition Occurs(a: A) (xs: L.List[A]): \Prop :=
  \induction (xs: L.List[A]) \return \Prop \with {
    | nil: Logic.False
    | cons: \fun (head: A) (tail: L.List[A]) (rest: \Prop) => Logic.Or[a = head, rest]
  } xs;
\structure Enumerates[X: \Pow A, xs: L.List[A]]: \Prop {
  included: \forall (a: A) -> Occurs a xs -> \In[A] X a,
  exhaustive: \forall (a: A) -> \In[A] X a -> Occurs a xs,
}
\definition Enumeration[X: \Pow A]: \Set := \Cast[L.List[A]] ({ xs: L.List[A] \where Enumerates[X, xs] });
\definition existsEnumeration: \forall (X: FiniteSubset) -> \exists Enumeration[X] :=
  induction ({ X: \Pow A \where \exists Enumeration[X] })
    (\exact(\into[L.List[A]](L.List[A]::nil, Enumeration[Empty]) \by {
      Enumerates[Empty, L.List[A]::nil] {
        included := \fun (a: A) (empty: Logic.False) => empty,
        exhaustive := \fun (a: A) (empty: Logic.False) => empty,
      }
    }, Enumeration[Empty]))
    (\block {
      \fun (X: \Pow A) (ih: \exists Enumeration[X]) (a: A) \then
      \takefrom xs: Enumeration[X] \by ih \then
      \let data: Enumerates[X, xs] := \bysub(L.List[A], Enumeration[X], xs) \then
      \let result: L.List[A] := L.List[A]::cons a xs \then
      \return \exact(\into[L.List[A]](result, Enumeration[Insert a X]) \by {
        Enumerates[Insert a X, result] {
          included := \fun (b: A) (member: Occurs b result) => either!{{b = a} "or" {Occurs b xs} "either" {\In[A] (Insert a X) b}
            "lt:" {Logic.Or[_, _]::left}
            "rt:" {\fun (old: _) => inInsertOld a X b (#included{data} b old)}} member,
          exhaustive := \fun (b: A) (member: \In[A] (Insert a X) b) => either!{{b = a} "or" {\In[A] X b} "either" {Occurs b result}
            "lt:" {Logic.Or[_, _]::left}
            "rt:" {\fun (old: _) => Logic.Or[_, _]::right (#exhaustive{data} b old)}} member,
        }
      }, Enumeration[Insert a X])
    });
\definition Listed(xs: L.List[A]): \Pow A := { a: A \where Occurs a xs };
\definition listedFinite: \forall (xs: L.List[A]) -> Finite (Listed xs) :=
  \induction (xs: L.List[A]) \return Finite (Listed xs) \with {
    | nil: finiteEmpty
    | cons: \fun (a: A) (tail: L.List[A]) (ih: _) => finiteInsert a (Listed tail) ih
  };
\definition finiteOfEnumeration: \forall (X: \Pow A) (xs: L.List[A]) -> Enumerates[X, xs] -> Finite X :=
  \fun (X: \Pow A) (xs: L.List[A]) (laws: Enumerates[X, xs]) =>
    \idelim Listed xs = X \with Y: \Pow A => Finite Y \by {
      base: listedFinite xs,
      equality: \axiom:setext(Listed xs, X, #included{laws}, #exhaustive{laws})
    };
\structure DistinctEnumerationLaws[X: \Pow A, xs: L.List[A]]: \Prop {
  enumerates: Enumerates[X, xs],
  distinct: Distinct.Distinct xs,
}
\definition DistinctEnumeration[X: \Pow A]: \Set :=
  \Cast[L.List[A]] ({ xs: L.List[A] \where DistinctEnumerationLaws[X, xs] });
\definition existsDistinctEnumeration: \forall (X: FiniteSubset) -> \exists DistinctEnumeration[X] :=
  induction ({ X: \Pow A \where \exists DistinctEnumeration[X] })
    (\exact(\into[L.List[A]](L.List[A]::nil, DistinctEnumeration[Empty]) \by {
      DistinctEnumerationLaws[Empty, L.List[A]::nil] {
        enumerates := Enumerates[Empty, L.List[A]::nil] {
          included := \fun (a: A)(empty: Logic.False) => empty,
          exhaustive := \fun (a: A)(empty: Logic.False) => empty,
        },
        distinct := Distinct.nil,
      }
    }, DistinctEnumeration[Empty]))
    (\block {
      \fun (X: \Pow A)(previous: \exists DistinctEnumeration[X])(a: A) \then
      \takefrom xs: DistinctEnumeration[X] \by previous \then
      \let laws: DistinctEnumerationLaws[X, xs] := \bysub(L.List[A], DistinctEnumeration[X], xs) \then
      \let enumeration: Enumerates[X, xs] := #enumerates{laws} \then
      \return either!{{\In[A] X a} "or" {Logic.Not (\In[A] X a)} "either" {\exists DistinctEnumeration[Insert a X]}
        "lt:" {\fun (old: \In[A] X a) => \exact(\into[L.List[A]](xs, DistinctEnumeration[Insert a X]) \by {
          DistinctEnumerationLaws[Insert a X, xs] {
            enumerates := Enumerates[Insert a X, xs] {
              included := \fun (b: A)(occurs: Occurs b xs) => inInsertOld a X b (#included{enumeration} b occurs),
              exhaustive := \fun (b: A)(included: \In[A] (Insert a X) b) =>
                either!{{b = a} "or" {\In[A] X b} "either" {Occurs b xs}
                  "lt:" {\fun (equal: b = a) => #exhaustive{enumeration} b
                    (\idelim a = b \with c: A => \In[A] X c \by { base: old, equality: sym!{A} b a equal })}
                  "rt:" {\fun (member: \In[A] X b) => #exhaustive{enumeration} b member}} included,
            },
            distinct := #distinct{laws},
          }
        }, DistinctEnumeration[Insert a X])}
        "rt:" {\fun (fresh: Logic.Not (\In[A] X a)) => \exact(\into[L.List[A]](L.List[A]::cons a xs, DistinctEnumeration[Insert a X]) \by {
          DistinctEnumerationLaws[Insert a X, L.List[A]::cons a xs] {
            enumerates := Enumerates[Insert a X, L.List[A]::cons a xs] {
              included := \fun (b: A)(occurs: Occurs b (L.List[A]::cons a xs)) =>
                either!{{b = a} "or" {Occurs b xs} "either" {\In[A] (Insert a X) b}
                  "lt:" {Logic.Or[b = a, \In[A] X b]::left}
                  "rt:" {\fun (member: Occurs b xs) => inInsertOld a X b (#included{enumeration} b member)}} occurs,
              exhaustive := \fun (b: A)(included: \In[A] (Insert a X) b) =>
                either!{{b = a} "or" {\In[A] X b} "either" {Occurs b (L.List[A]::cons a xs)}
                  "lt:" {Logic.Or[b = a, Occurs b xs]::left}
                  "rt:" {\fun (member: \In[A] X b) => Logic.Or[b = a, Occurs b xs]::right (#exhaustive{enumeration} b member)}} included,
            },
            distinct := Distinct.cons a xs (\fun (occurs: Occurs a xs) => fresh (#included{enumeration} a occurs)) (#distinct{laws}),
          }
        }, DistinctEnumeration[Insert a X])}}
        (Classical.excludedMiddle (\In[A] X a))
    });
