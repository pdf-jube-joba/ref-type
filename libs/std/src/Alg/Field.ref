\import std.Logic[].Proposition[] \as Logic;
\import std.Alg[].Ring[] \as R;
\use Logic.not;

\structure Field[Carrier: \Set]: \Set {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
} \where {
  ring: R.CommutativeRing[Carrier].Law[R.CommutativeRing[Carrier].Raw::# ((R.Ring[Carrier].Raw::# zero one add neg mul))],
  nontrivial: (not!{{ zero = one }}),
  inverse: (\forall (x: Carrier) -> not!{{ x = zero }} -> mul (inv x) x = one),
}

\definition fieldRing (Carrier: \Set) (s: Field[Carrier].Raw): R.Ring[Carrier].Raw :=
  R.Ring[Carrier].Raw::# (#zero{s}) (#one{s}) (#add{s}) (#neg{s}) (#mul{s});
\definition FieldNonZero (Carrier: \Set) (s: Field[Carrier].Raw) (x: Carrier): \Prop :=
    not!{{ x = #zero{s} }};
\definition FieldNontrivial (Carrier: \Set) (s: Field[Carrier].Raw): \Prop :=
    not!{{ #zero{s} = #one{s} }};
\definition FieldInverseLaws (Carrier: \Set) (s: Field[Carrier].Raw): \Prop :=
    \forall (x: Carrier) -> FieldNonZero Carrier s x ->
      #mul{s} (#inv{s} x) x = #one{s};

\definition fieldAsCommutativeRing (Carrier: \Set) (s: Field[Carrier]): R.CommutativeRing[Carrier] :=
    \into[R.CommutativeRing[Carrier].Raw](R.CommutativeRing[Carrier].Raw::# (fieldRing Carrier s), R.CommutativeRing[Carrier]) \by {
      #ring{s}
    };
