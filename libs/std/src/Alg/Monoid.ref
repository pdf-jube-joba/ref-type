/* Algebraic structures keep Set-valued data separate from Prop-valued laws. */
\import std.Logic[].Law[] \as Law;

\structure Monoid[Carrier: \Set]: \Set {
  unit: Carrier,
  op: Carrier -> Carrier -> Carrier,
} \where {
  leftIdentity: Law.LeftUnital Carrier op unit,
  rightIdentity: Law.RightUnital Carrier op unit,
  associative: Law.Associative Carrier op,
}

\structure CommutativeMonoid[Carrier: \Set]: \Set {
  base: Monoid[Carrier]::[Raw],
} \where {
  monoid: Monoid[Carrier]::[Law][base],
  commutative: Law.Commutative Carrier (#op{base}),
}

\definition asMonoid (Carrier: \Set) (s: CommutativeMonoid[Carrier]::[Set]): Monoid[Carrier]::[Set] :=
  \into[Monoid[Carrier]::[Raw]](#base{s}, Monoid[Carrier]) \by { #monoid{s} };
