\import std.Alg[].Alg[] \as A;

\structure RingData[Carrier: \Set]: \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
};

\structure RingLaws[Carrier: \Set, data: RingData[Carrier]]: \Prop := {
  semiring: A.SemiringLaws[Carrier, (A.SemiringData[Carrier]::# data.zero data.one data.add data.mul)],
  additiveInverse: \forall (x: Carrier) ->
    data.add (data.neg x) x = data.zero,
};

\definition Ring[Carrier: \Set]: \Set :=
  \Cast[RingData[Carrier]] ({ data: RingData[Carrier] \where RingLaws[Carrier, data] });

\definition ringSemiring [Carrier: \Set] [s: RingData[Carrier]]: A.SemiringData[Carrier] :=
  A.SemiringData[Carrier]::# (s.zero) (s.one) (s.add) (s.mul);

\definition ringAsSemiring [Carrier: \Set] [s: Ring[Carrier]]: A.Semiring[Carrier] :=
    \into[A.SemiringData[Carrier]](ringSemiring Carrier s, A.Semiring[Carrier]) \by {
      s.semiring
    };

\structure CommutativeRingData[Carrier: \Set]: \Set := {
  base: RingData[Carrier],
};

\structure CommutativeRingLaws[Carrier: \Set, data: CommutativeRingData[Carrier]]: \Prop := {
  ring: RingLaws[Carrier, data.base],
  mulCommutative: \forall (x, y: Carrier) -> data.base.mul x y = data.base.mul y x,
};

\definition CommutativeRing[Carrier: \Set]: \Set :=
  \Cast[CommutativeRingData[Carrier]] ({ data: CommutativeRingData[Carrier] \where CommutativeRingLaws[Carrier, data] });

\definition commutativeRingAsRing [Carrier: \Set] [s: CommutativeRing[Carrier]]: Ring[Carrier] :=
  \into[RingData[Carrier]](s.base, Ring[Carrier]) \by { s.ring };

\structure RingModuleData[Scalars, Carrier: \Set, r: Ring[Scalars]]: \Set := {
  zero: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  smul: Scalars -> Carrier -> Carrier,
};

\structure RingModuleLaws[Scalars, Carrier: \Set, r: Ring[Scalars], data: RingModuleData[Scalars, Carrier, r]]: \Prop := {
  additive: A.CommutativeGroupLaws[Carrier,
    A.CommutativeGroupData[Carrier]::# (A.GroupData[Carrier]::# data.zero data.add data.neg)],
  scalarOne: \forall (x: Carrier) -> data.smul r.one x = x,
  scalarAssoc: \forall (a, b: Scalars) (x: Carrier) ->
    data.smul (r.mul a b) x = data.smul a (data.smul b x),
  scalarAdd: \forall (a, b: Scalars) (x: Carrier) ->
    data.smul (r.add a b) x = data.add (data.smul a x) (data.smul b x),
  vectorAdd: \forall (a: Scalars) (x, y: Carrier) ->
    data.smul a (data.add x y) = data.add (data.smul a x) (data.smul a y),
};

\definition RingModule[Scalars, Carrier: \Set, r: Ring[Scalars]]: \Set :=
  \Cast[RingModuleData[Scalars, Carrier, r]] ({ data: RingModuleData[Scalars, Carrier, r] \where RingModuleLaws[Scalars, Carrier, r, data] });

\definition ringModuleAsCommutativeGroup [Scalars, Carrier: \Set]
  [r: Ring[Scalars]] [m: RingModule[Scalars, Carrier, r]]:
  A.CommutativeGroup[Carrier] :=
  A.CommutativeGroup[Carrier] {
    base := A.GroupData[Carrier]::# (m.zero) (m.add) (m.neg),
 group := (m.additive).group, commutative := (m.additive).commutative };

\structure RingAlgebraData[Scalars, Carrier: \Set, r: CommutativeRing[Scalars]]: \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  smul: Scalars -> Carrier -> Carrier,
};

\structure RingAlgebraLaws[Scalars, Carrier: \Set, r: CommutativeRing[Scalars], data: RingAlgebraData[Scalars, Carrier, r]]: \Prop := {
  ring: RingLaws[Carrier, RingData[Carrier]::# data.zero data.one data.add data.neg data.mul],
  module: RingModuleLaws[Scalars, Carrier, commutativeRingAsRing Scalars r,
    RingModuleData[Scalars, Carrier, commutativeRingAsRing Scalars r]::# data.zero data.add data.neg data.smul],
  scalarMulLeft: \forall (s: Scalars) (x, y: Carrier) ->
    data.smul s (data.mul x y) = data.mul (data.smul s x) y,
  scalarMulRight: \forall (s: Scalars) (x, y: Carrier) ->
    data.smul s (data.mul x y) = data.mul x (data.smul s y),
};

\definition RingAlgebra[Scalars, Carrier: \Set, r: CommutativeRing[Scalars]]: \Set :=
  \Cast[RingAlgebraData[Scalars, Carrier, r]] ({ data: RingAlgebraData[Scalars, Carrier, r] \where RingAlgebraLaws[Scalars, Carrier, r, data] });

\definition ringAlgebraAsRing [Scalars, Carrier: \Set]
  [r: CommutativeRing[Scalars]] [a: RingAlgebra[Scalars, Carrier, r]]:
  Ring[Carrier] :=
  Ring[Carrier] {
    zero := a.zero, one := a.one, add := a.add, neg := a.neg, mul := a.mul,
 semiring := (a.ring).semiring, additiveInverse := (a.ring).additiveInverse };

\definition ringAlgebraAsModule [Scalars, Carrier: \Set]
  [r: CommutativeRing[Scalars]] [a: RingAlgebra[Scalars, Carrier, r]]:
  RingModule[Scalars, Carrier, commutativeRingAsRing Scalars r] :=
  RingModule[Scalars, Carrier, commutativeRingAsRing Scalars r] {
    zero := a.zero, add := a.add, neg := a.neg, smul := a.smul,

    additive := (a.module).additive,
    scalarOne := (a.module).scalarOne,
    scalarAssoc := (a.module).scalarAssoc,
    scalarAdd := (a.module).scalarAdd,
    vectorAdd := (a.module).vectorAdd,
  };

\import std.Alg[].Monoid[] \as M;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\definition additiveGroup[Carrier: \Set] [r: Ring[Carrier]]: A.CommutativeGroup[Carrier] :=
  A.CommutativeGroup[Carrier] {
    base := A.GroupData[Carrier]::# (r.zero) (r.add) (r.neg),
    group := A.GroupLaws[Carrier, (A.GroupData[Carrier]::# (r.zero) (r.add) (r.neg))] {
      monoid := ((r.semiring).additive).monoid,
      leftInverse := r.additiveInverse,
      rightInverse := \fun (x: _) => trans!{Carrier} _ _ _ (((r.semiring).additive).commutative x (r.neg x)) (r.additiveInverse x),
    },
    commutative := ((r.semiring).additive).commutative,
  };
