\import std.Alg[].Alg[] \as A;

\structure Ring[Carrier: \Set]: \Set {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
} \where {
  semiring: A.Semiring[Carrier].Law[(A.Semiring[Carrier].Raw::# zero one add mul)],
  additiveInverse: \forall (x: Carrier) ->
    add (neg x) x = zero,
}

\definition ringSemiring (Carrier: \Set) (s: Ring[Carrier].Raw): A.Semiring[Carrier].Raw :=
  A.Semiring[Carrier].Raw::# (#zero{s}) (#one{s}) (#add{s}) (#mul{s});

\definition ringAsSemiring (Carrier: \Set) (s: Ring[Carrier]): A.Semiring[Carrier] :=
    \into[A.Semiring[Carrier].Raw](ringSemiring Carrier s, A.Semiring[Carrier]) \by {
      #semiring{s}
    };

\structure CommutativeRing[Carrier: \Set]: \Set {
  base: Ring[Carrier].Raw,
} \where {
  ring: Ring[Carrier].Law[base],
  mulCommutative: \forall (x, y: Carrier) -> #mul{base} x y = #mul{base} y x,
}

\definition commutativeRingAsRing (Carrier: \Set) (s: CommutativeRing[Carrier]): Ring[Carrier] :=
  \into[Ring[Carrier].Raw](#base{s}, Ring[Carrier]) \by { #ring{s} };

\structure RingModule[Scalars, Carrier: \Set, r: Ring[Scalars]]: \Set {
  zero: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  smul: Scalars -> Carrier -> Carrier,
} \where {
  additive: A.CommutativeGroup[Carrier].Law[
    A.CommutativeGroup[Carrier].Raw::# (A.Group[Carrier].Raw::# zero add neg)],
  scalarOne: \forall (x: Carrier) -> smul (#one{r}) x = x,
  scalarAssoc: \forall (a, b: Scalars) (x: Carrier) ->
    smul (#mul{r} a b) x = smul a (smul b x),
  scalarAdd: \forall (a, b: Scalars) (x: Carrier) ->
    smul (#add{r} a b) x = add (smul a x) (smul b x),
  vectorAdd: \forall (a: Scalars) (x, y: Carrier) ->
    smul a (add x y) = add (smul a x) (smul a y),
}

\definition ringModuleAsCommutativeGroup (Scalars, Carrier: \Set)
  (r: Ring[Scalars]) (m: RingModule[Scalars, Carrier, r]):
  A.CommutativeGroup[Carrier] :=
  A.CommutativeGroup[Carrier] {
    base := A.Group[Carrier].Raw::# (#zero{m}) (#add{m}) (#neg{m}),
 group := #group{(#additive{m})}, commutative := #commutative{(#additive{m})} };

\structure RingAlgebra[Scalars, Carrier: \Set, r: CommutativeRing[Scalars]]: \Set {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  smul: Scalars -> Carrier -> Carrier,
} \where {
  ring: Ring[Carrier].Law[Ring[Carrier].Raw::# zero one add neg mul],
  module: RingModule[Scalars, Carrier, commutativeRingAsRing Scalars r].Law[
    RingModule[Scalars, Carrier, commutativeRingAsRing Scalars r].Raw::# zero add neg smul],
  scalarMulLeft: \forall (s: Scalars) (x, y: Carrier) ->
    smul s (mul x y) = mul (smul s x) y,
  scalarMulRight: \forall (s: Scalars) (x, y: Carrier) ->
    smul s (mul x y) = mul x (smul s y),
}

\definition ringAlgebraAsRing (Scalars, Carrier: \Set)
  (r: CommutativeRing[Scalars]) (a: RingAlgebra[Scalars, Carrier, r]):
  Ring[Carrier] :=
  Ring[Carrier] {
    zero := #zero{a}, one := #one{a}, add := #add{a}, neg := #neg{a}, mul := #mul{a},
 semiring := #semiring{(#ring{a})}, additiveInverse := #additiveInverse{(#ring{a})} };

\definition ringAlgebraAsModule (Scalars, Carrier: \Set)
  (r: CommutativeRing[Scalars]) (a: RingAlgebra[Scalars, Carrier, r]):
  RingModule[Scalars, Carrier, commutativeRingAsRing Scalars r] :=
  RingModule[Scalars, Carrier, commutativeRingAsRing Scalars r] {
    zero := #zero{a}, add := #add{a}, neg := #neg{a}, smul := #smul{a},

    additive := #additive{(#module{a})},
    scalarOne := #scalarOne{(#module{a})},
    scalarAssoc := #scalarAssoc{(#module{a})},
    scalarAdd := #scalarAdd{(#module{a})},
    vectorAdd := #vectorAdd{(#module{a})},
  };
