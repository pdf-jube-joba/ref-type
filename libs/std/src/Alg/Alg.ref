/* Groups and semirings over arbitrary carriers. */
\import std.Logic[].Proposition[] \as Logic;
\import std.Alg[].Monoid[] \as M;
\import std.Logic[].Algebra[].Def[] \as Law;
\use Logic.not;

\structure Group[Carrier: \Set]: \Set {
  unit: Carrier,
  op: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
} \where {
  monoid: M.Monoid[Carrier]::[Law][(M.Monoid[Carrier]::[Raw]::# unit op)],
  leftInverse: Law.LeftInvertible Carrier op unit inv,
  rightInverse: Law.RightInvertible Carrier op unit inv,
}

\definition groupMonoid (Carrier: \Set) (s: Group[Carrier]::[Raw]): M.Monoid[Carrier]::[Raw] :=
  M.Monoid[Carrier]::[Raw]::# (#unit{s}) (#op{s});

\structure CommutativeGroup[Carrier: \Set]: \Set {
  base: Group[Carrier]::[Raw],
} \where {
  group: Group[Carrier]::[Law][base],
  commutative: Law.Commutative Carrier (#op{base}),
}

\structure Semiring[Carrier: \Set]: \Set {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
} \where {
  additive: M.CommutativeMonoid[Carrier]::[Law][M.CommutativeMonoid[Carrier]::[Raw]::# (M.Monoid[Carrier]::[Raw]::# zero add)],
  multiplicative: M.Monoid[Carrier]::[Law][(M.Monoid[Carrier]::[Raw]::# one mul)],
  leftDistributive: Law.LeftDistributive Carrier mul add,
  rightDistributive: Law.RightDistributive Carrier mul add,
  zeroAbsorbsLeft: \forall (x: Carrier) -> mul zero x = zero,
  zeroAbsorbsRight: \forall (x: Carrier) -> mul x zero = zero,
}

\definition additiveMonoid (Carrier: \Set) (s: Semiring[Carrier]::[Raw]): M.Monoid[Carrier]::[Raw] :=
  M.Monoid[Carrier]::[Raw]::# (#zero{s}) (#add{s});
\definition multiplicativeMonoid (Carrier: \Set) (s: Semiring[Carrier]::[Raw]): M.Monoid[Carrier]::[Raw] :=
  M.Monoid[Carrier]::[Raw]::# (#one{s}) (#mul{s});

\definition asGroup (Carrier: \Set) (s: CommutativeGroup[Carrier]::[Set]): Group[Carrier]::[Set] :=
  \into[Group[Carrier]::[Raw]](#base{s}, Group[Carrier]) \by { #group{s} };
