/* Three-way comparison results and their propositional forms. */
\import \root.Logic[].Proposition[] \as Logic;

\inductive Ordering: \VType :=
| Less: Ordering
| Equal: Ordering
| Greater: Ordering
;

\definition isLess (ordering: Ordering^): \Prop :=
  ordering = Ordering^::Less;

\definition isEqual (ordering: Ordering^): \Prop :=
  ordering = Ordering^::Equal;

\definition isGreater (ordering: Ordering^): \Prop :=
  ordering = Ordering^::Greater;

\definition LessOrEqual(equal, less: \Prop): \Prop :=
  Logic.Or[equal, less];

\definition GreaterOrEqual(equal, greater: \Prop): \Prop :=
  Logic.Or[equal, greater];

\definition Trichotomy(less, equal, greater: \Prop): \Prop :=
  Logic.Or[less, Logic.Or[equal, greater]];

\definition Comparison(less, equal, greater: \Prop): \Prop :=
  Trichotomy less equal greater;
