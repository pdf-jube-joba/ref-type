/* Equality is independent of arithmetic. Proof templates specialize the carrier
 * before elaboration: this avoids quantifying a proposition over Set, and keeps
 * local datatypes valid when their enclosing module is instantiated again. */
\macro sym($A) :=
  (\fun (law: \forall (a, b: $A) -> a = b -> b = a) => law)
  (\fun (a, b: $A) => \fun (e: a = b) =>
    \idelim a = b \with x: $A => x = a \by { base: \refl(a), equality: e });

\macro trans($A) :=
  (\fun (law: \forall (a, b, c: $A) -> a = b -> b = c -> a = c) => law)
  (\fun (a, b, c: $A) => \fun (ab: a = b) => \fun (bc: b = c) =>
    \idelim b = c \with x: $A => a = x \by { base: ab, equality: bc });

\macro eq_reason($a, ..steps) := \tmatch steps {
  | () => \refl($a)
  | ("=", $b, "by", $h, ..rest) =>
      \idelim $b = _ \with x: _ => $a = x
      \by { base: $h, equality: eq_reason!{$b ..rest} }
};

\macro transport($A) :=
  (\fun (law: \forall (P: $A -> \Prop) -> \forall (a, b: $A) -> a = b -> P a -> P b) => law)
  (\fun (P: $A -> \Prop) => \fun (a, b: $A) => \fun (e: a = b) => \fun (p: P a) =>
    \idelim a = b \with x: $A => P x \by { base: p, equality: e });

/* Congruence folds equality of applications; function extensionality is not needed. */
\macro congr_apply($A, $f, $g, $p, $a, $b, $q) :=
  \idelim $a = $b \with x: $A => $f $a = $g x \by {
    base: \idelim $f = $g \with h: _ => $f $a = h $a
      \by { base: \refl($f $a), equality: $p },
    equality: $q
  };

\macro congr_steps($f, $g, $p, ..args) := \tmatch args {
  | () => $p
  | ("and", ..rest) => congr_steps!{$f $g $p ..rest}
  | ($a, "=", $b, "in", $A, "by", $q, ..rest) =>
      congr_steps!{{ $f $a } { $g $b } { congr_apply!{$A $f $g $p $a $b $q} } ..rest}
  | ($a, "=", $b, "by", $q, ..rest) =>
      congr_steps!{{ $f $a } { $g $b } { congr_apply!{_ $f $g $p $a $b $q} } ..rest}
};

\macro congr_type($A, ..types) := \tmatch types {
  | () => $A
  | ($B, ..rest) => $A -> congr_type!{$B ..rest}
};

\macro congr_arguments($f, (..pairs), $A, ..types) := \tmatch types {
  | () => congr_proofs!{$f (..pairs) ()}
  | ($B, ..rest) => \fun (a, b: $A) =>
      congr_arguments!{$f (..pairs ($A a b)) $B ..rest}
};

\macro congr_proofs($f, (..pairs), (..steps)) := \tmatch pairs {
  | () => congr_steps!{$f $f {\refl($f)} ..steps}
  | (($A, $a, $b), ..rest) => \fun (e: $a = $b) =>
      congr_proofs!{$f (..rest) (..steps $a "=" $b "in" $A "by" e)}
};

\macro congr($head, ..args) := \tmatch args {
  | () => \refl($head)
  | ($a, "=", $b, "in", $A, "by", $p, ..rest) =>
      congr_steps!{$head $head {\refl($head)} $a "=" $b "in" $A "by" $p ..rest}
  | ($a, "=", $b, "by", $p, ..rest) =>
      congr_steps!{$head $head {\refl($head)} $a "=" $b "by" $p ..rest}
  | ($B, ..types) => \fun (f: congr_type!{$head $B ..types}) =>
      congr_arguments!{f () $head $B ..types}
};

/* A checked, named API is also available for a fixed carrier. */
\module Prop(A: \Set);
\module Transport(A: \Set);

/* Fix the ambient carrier when intermediate terms have refinement types. */
\macro eq_reason_in($A, $a, ..steps) := \tmatch steps {
  | () => \refl($a)
  | ("=", $b, "by", $h, ..rest) =>
      trans!{$A} $a $b _ $h (eq_reason_in!{$A $b ..rest})
};
