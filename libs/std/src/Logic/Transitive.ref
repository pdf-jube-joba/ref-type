/* Nonempty chains need only transitivity, including for strict orders. */
\macro trans_reason_terms($trans, $a, ..steps) := \tmatch steps {
  | ("~", $b, "by", $h) => $h
  | ("~", $b, "by", $h, "~", $c, "by", $next, ..rest) =>
      trans_reason_terms!{$trans $a "~" $c "by"
        { $trans $a $b $c $h $next } ..rest}
};

\macro trans_reason($trans, ..steps) := \tmatch steps {
  | ("by", $h) => $h
  | ("by", $h, ..rest) =>
      $trans _ _ _ $h (trans_reason!{$trans ..rest})
};
