/* Boolean reflection of propositions and predicates. */
\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Bool[] \as B;
\import std.Nat[] \as N;

\definition Reflect(P: \Prop) (b: B.Bool^): \Prop :=
  Logic.PropEquiv[B.IsTrue b, P];

\definition reflectTrue(P: \Prop) (proof: P): Reflect P B.Bool^::true :=
  Logic.PropEquiv[B.IsTrue B.Bool^::true, P]::#
    (\fun (_: B.IsTrue B.Bool^::true) => proof)
    (\fun (_: P) => \refl(B.Bool^::true));

\definition reflectFalse(P: \Prop) (refute: Logic.Not P):
    Reflect P B.Bool^::false :=
  Logic.PropEquiv[B.IsTrue B.Bool^::false, P]::# (B.absurd P) (\fun (proof: P) =>
      Logic.falseElim (B.IsTrue B.Bool^::false) (refute proof));

\definition Decidable(P: \Prop): \Prop :=
  \exists { b : B.Bool^ \where Reflect P b };

\definition Decides(A: \Set) (test: A -> B.Bool^) (P: A -> \Prop): \Prop :=
  \forall (x: A) -> Reflect (P x) (test x);

\definition Semidecision: \Set := N.Nat^ -> B.Bool^;

\definition Accepts(test: Semidecision): \Prop :=
  \exists { n : N.Nat^ \where B.IsTrue (test n) };

\definition SemiReflect(P: \Prop) (test: Semidecision): \Prop :=
  Logic.PropEquiv[Accepts test, P];

\definition Semidecidable(P: \Prop): \Prop :=
  \exists { test : Semidecision \where SemiReflect P test };

\definition Semidecides(A: \Set) (test: A -> Semidecision)
    (P: A -> \Prop): \Prop :=
  \forall (x: A) -> SemiReflect (P x) (test x);
