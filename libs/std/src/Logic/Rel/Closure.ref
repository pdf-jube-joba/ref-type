/* Closures are intersections of all extensions having the requested law. */
\definition ReflexiveClosure(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Reflexive Carrier S -> S x y;

\definition SymmetricClosure(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Symmetric Carrier S -> S x y;

\definition TransitiveClosure(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Transitive Carrier S -> S x y;

\definition ReflexiveTransitiveClosure(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Reflexive Carrier S -> Transitive Carrier S -> S x y;

\definition EquivalenceClosure(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Reflexive Carrier S -> Symmetric Carrier S -> Transitive Carrier S -> S x y;

\definition reflexiveClosureOf(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier):
  R x y -> ReflexiveClosure Carrier R x y :=
  \fun (edge: _) (S: Relation[Carrier]) (included: _) (reflexive: _) => included x y edge;

\definition reflexiveClosureRefl(Carrier: \Set) (R: Relation[Carrier]):
  Reflexive Carrier (ReflexiveClosure Carrier R) :=
  \fun (x: _) (S: Relation[Carrier]) (included: _) (reflexive: _) => reflexive x;

\definition symmetricClosureOf(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier):
  R x y -> SymmetricClosure Carrier R x y :=
  \fun (edge: _) (S: Relation[Carrier]) (included: _) (symmetric: _) => included x y edge;

\definition symmetricClosureSym(Carrier: \Set) (R: Relation[Carrier]):
  Symmetric Carrier (SymmetricClosure Carrier R) :=
  \fun (x, y: _) (edge: _) (S: Relation[Carrier]) (included: _) (symmetric: _) =>
      symmetric x y (edge S included symmetric);

\definition transitiveClosureOf(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier):
  R x y -> TransitiveClosure Carrier R x y :=
  \fun (edge: _) (S: Relation[Carrier]) (included: _) (transitive: _) => included x y edge;

\definition transitiveClosureTrans(Carrier: \Set) (R: Relation[Carrier]):
  Transitive Carrier (TransitiveClosure Carrier R) :=
  \fun (x, y, z: _) (left: _) (right: _) (S: Relation[Carrier]) (included: _) (transitive: _) =>
      transitive x y z (left S included transitive) (right S included transitive);

\definition reflexiveTransitiveClosureOf(Carrier: \Set) (R: Relation[Carrier]) (x, y: Carrier):
  R x y -> ReflexiveTransitiveClosure Carrier R x y :=
  \fun (edge: _) (S: Relation[Carrier]) (included: _) (reflexive: _) (transitive: _) => included x y edge;

\definition reflexiveTransitiveClosureRefl(Carrier: \Set) (R: Relation[Carrier]):
  Reflexive Carrier (ReflexiveTransitiveClosure Carrier R) :=
  \fun (x: _) (S: Relation[Carrier]) (included: _) (reflexive: _) (transitive: _) => reflexive x;

\definition reflexiveTransitiveClosureTrans(Carrier: \Set) (R: Relation[Carrier]):
  Transitive Carrier (ReflexiveTransitiveClosure Carrier R) :=
  \fun (x, y, z: _) (left: _) (right: _) (S: Relation[Carrier]) (included: _) (reflexive: _)
    (transitive: _) =>
      transitive x y z (left S included reflexive transitive) (right S included reflexive transitive);
