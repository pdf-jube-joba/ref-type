/* Closures are intersections of all extensions having the requested law. */
\definition ReflexiveClosure(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Reflexive Carrier S -> S x y;

\definition SymmetricClosure(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Symmetric Carrier S -> S x y;

\definition TransitiveClosure(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Transitive Carrier S -> S x y;

\definition ReflexiveTransitiveClosure(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Reflexive Carrier S -> Transitive Carrier S -> S x y;

\definition EquivalenceClosure(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier): \Prop :=
  \forall (S: Relation[Carrier]) -> Subrelation Carrier R S ->
    Reflexive Carrier S -> Symmetric Carrier S -> Transitive Carrier S -> S x y;

\definition reflexiveClosureOf(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier) (edge: R x y)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (reflexive: Reflexive Carrier S):
  S x y := included x y edge;

\definition reflexiveClosureRefl(Carrier: \Set)(R: Relation[Carrier]) (x: Carrier)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (reflexive: Reflexive Carrier S):
  S x x := reflexive x;

\definition symmetricClosureOf(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier) (edge: R x y)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (symmetric: Symmetric Carrier S):
  S x y := included x y edge;

\definition symmetricClosureSym(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier)
  (edge: SymmetricClosure Carrier R x y) (S: Relation[Carrier])
  (included: Subrelation Carrier R S) (symmetric: Symmetric Carrier S): S y x :=
    symmetric x y (edge S included symmetric);

\definition transitiveClosureOf(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier) (edge: R x y)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (transitive: Transitive Carrier S):
  S x y := included x y edge;

\definition transitiveClosureTrans(Carrier: \Set)(R: Relation[Carrier]) (x, y, z: Carrier)
  (left: TransitiveClosure Carrier R x y) (right: TransitiveClosure Carrier R y z)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (transitive: Transitive Carrier S):
  S x z :=
    transitive x y z (left S included transitive) (right S included transitive);

\definition reflexiveTransitiveClosureOf(Carrier: \Set)(R: Relation[Carrier]) (x, y: Carrier)
  (edge: R x y) (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (reflexive: Reflexive Carrier S) (transitive: Transitive Carrier S): S x y :=
    included x y edge;

\definition reflexiveTransitiveClosureRefl(Carrier: \Set)(R: Relation[Carrier]) (x: Carrier)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (reflexive: Reflexive Carrier S) (transitive: Transitive Carrier S): S x x := reflexive x;

\definition reflexiveTransitiveClosureTrans(Carrier: \Set)(R: Relation[Carrier]) (x, y, z: Carrier)
  (left: ReflexiveTransitiveClosure Carrier R x y)
  (right: ReflexiveTransitiveClosure Carrier R y z)
  (S: Relation[Carrier]) (included: Subrelation Carrier R S)
  (reflexive: Reflexive Carrier S) (transitive: Transitive Carrier S): S x z :=
    transitive x y z
      (left S included reflexive transitive)
      (right S included reflexive transitive);
