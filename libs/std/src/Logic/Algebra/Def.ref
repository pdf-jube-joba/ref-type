/* Reusable laws for operations on one carrier. */
\definition BinaryOperation(Carrier: \Set): \Set := Carrier -> Carrier -> Carrier;
\definition UnaryOperation(Carrier: \Set): \Set := Carrier -> Carrier;

\definition Associative(Carrier: \Set) (op: BinaryOperation Carrier): \Prop :=
  \forall (x, y, z: Carrier) -> op (op x y) z = op x (op y z);

\definition Commutative(Carrier: \Set) (op: BinaryOperation Carrier): \Prop :=
  \forall (x, y: Carrier) -> op x y = op y x;

\definition Idempotent(Carrier: \Set) (op: BinaryOperation Carrier): \Prop :=
  \forall (x: Carrier) -> op x x = x;

\definition LeftUnital(Carrier: \Set) (op: BinaryOperation Carrier) (unit: Carrier): \Prop :=
  \forall (x: Carrier) -> op unit x = x;

\definition RightUnital(Carrier: \Set) (op: BinaryOperation Carrier) (unit: Carrier): \Prop :=
  \forall (x: Carrier) -> op x unit = x;

\record Unital[Carrier: \Set, op: BinaryOperation Carrier, unit: Carrier]: \Prop := {
  left: LeftUnital Carrier op unit,
  right: RightUnital Carrier op unit,
};

\definition LeftInvertible(Carrier: \Set) (op: BinaryOperation Carrier) (unit: Carrier)
  (inverse: UnaryOperation Carrier): \Prop :=
  \forall (x: Carrier) -> op (inverse x) x = unit;

\definition RightInvertible(Carrier: \Set) (op: BinaryOperation Carrier) (unit: Carrier)
  (inverse: UnaryOperation Carrier): \Prop :=
  \forall (x: Carrier) -> op x (inverse x) = unit;

\record Invertible[Carrier: \Set, op: BinaryOperation Carrier, unit: Carrier,
  inverse: UnaryOperation Carrier]: \Prop := {
  left: LeftInvertible Carrier op unit inverse,
  right: RightInvertible Carrier op unit inverse,
};

\definition LeftDistributive(Carrier: \Set)
  (over, under: BinaryOperation Carrier): \Prop :=
  \forall (x, y, z: Carrier) ->
    over x (under y z) = under (over x y) (over x z);

\definition RightDistributive(Carrier: \Set)
  (over, under: BinaryOperation Carrier): \Prop :=
  \forall (x, y, z: Carrier) ->
    over (under x y) z = under (over x z) (over y z);

\record Distributive[Carrier: \Set, over, under: BinaryOperation Carrier]: \Prop := {
  left: LeftDistributive Carrier over under,
  right: RightDistributive Carrier over under,
};
