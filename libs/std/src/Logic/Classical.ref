/*
 * Classical principles used by the real-number developments.
 *
 * Excluded middle below is Diaconescu's construction from indefinite choice
 * and subset extensionality. Bool supplies the finite decidable carrier.
 */
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Bool[] \as B;

/* The two subsets used by Diaconescu's argument are supplied explicitly here:
 * a Set cannot be returned by a top-level function of a proposition. */
\definition Candidates(Left, Right: \Pow B.Bool^):
    \Pow (\Pow B.Bool^) :=
  { T : \Pow B.Bool^ \where Logic.Or[T = Left, T = Right] };

\definition Candidate(Left, Right: \Pow B.Bool^): \Set :=
  \Cast[\Pow B.Bool^] (Candidates Left Right);

\definition leftCandidate(Left, Right: \Pow B.Bool^):
    Candidate Left Right :=
  \into[\Pow B.Bool^](Left, Candidates Left Right) \by { Logic.Or[Left = Left, Left = Right]::left (\refl(Left)) };

\definition rightCandidate(Left, Right: \Pow B.Bool^):
    Candidate Left Right :=
  \into[\Pow B.Bool^](Right, Candidates Left Right) \by { Logic.Or[Right = Left, Right = Right]::right (\refl(Right)) };

\definition candidateInhabited(Left, Right: \Pow B.Bool^)
    (leftExists: \exists \Cast[B.Bool^] Left)
    (rightExists: \exists \Cast[B.Bool^] Right)
    (S: Candidate Left Right):
      \exists \Cast[B.Bool^] S :=
    Logic.orElim
      (S = Left) (S = Right)
      (\exists \Cast[B.Bool^] S)
      (\fun (e: S = Left) =>
        \idelim Left = S
          \with T: \Pow B.Bool^ => \exists \Cast[B.Bool^] T
          \by { base: leftExists, equality:
            sym!{\Pow B.Bool^} S Left e })
      (\fun (e: S = Right) =>
        \idelim Right = S
          \with T: \Pow B.Bool^ => \exists \Cast[B.Bool^] T
          \by { base: rightExists, equality:
            sym!{\Pow B.Bool^} S Right e })
      (\bysub(\Pow B.Bool^, Candidates Left Right, S));

\definition Selection(Left, Right: \Pow B.Bool^): \Set :=
  \forall (S: Candidate Left Right) ->
    \Cast[B.Bool^] S;

\definition selectionExists(Left, Right: \Pow B.Bool^)
    (leftExists: \exists \Cast[B.Bool^] Left)
    (rightExists: \exists \Cast[B.Bool^] Right):
    \exists Selection Left Right :=
  \axiom:classicalIndefiniteChoice(
    Candidate Left Right,
    (\fun (S: Candidate Left Right) =>
      \Cast[B.Bool^] S),
    candidateInhabited Left Right leftExists rightExists);

\definition leftSelected(Left, Right: \Pow B.Bool^)
    (select: Selection Left Right): \Cast[B.Bool^] Left :=
  select (leftCandidate Left Right);

\definition rightSelected(Left, Right: \Pow B.Bool^)
    (select: Selection Left Right): \Cast[B.Bool^] Right :=
  select (rightCandidate Left Right);

\definition choose(Left, Right: \Pow B.Bool^)
    (select: Selection Left Right) (S: Candidate Left Right): B.Bool^ :=
  select S;

\definition chooseLeft(Left, Right: \Pow B.Bool^)
    (select: Selection Left Right): B.Bool^ :=
  choose Left Right select (leftCandidate Left Right);

\definition chooseRight(Left, Right: \Pow B.Bool^)
    (select: Selection Left Right): B.Bool^ :=
  choose Left Right select (rightCandidate Left Right);

\definition equalChoicesGiveP(P: \Prop) (u, v: B.Bool^)
    (uMember: Logic.Or[u = B.Bool^::false, P])
    (vMember: Logic.Or[v = B.Bool^::true, P]) (uv: u = v): P :=
  Logic.orElim
    (u = B.Bool^::false) P P
    (\fun (uf: u = B.Bool^::false) =>
      Logic.orElim
        (v = B.Bool^::true) P P
        (\fun (vt: v = B.Bool^::true) =>
          B.absurd P
            (trans!{B.Bool^}
              B.Bool^::false v B.Bool^::true
              (trans!{B.Bool^}
                B.Bool^::false u v
                (sym!{B.Bool^} u B.Bool^::false uf)
                uv)
              vt))
        (\fun (p: P) => p) vMember)
    (\fun (p: P) => p) uMember;

\definition selectedEqual(Left, Right: \Pow B.Bool^)
    (select: Selection Left Right) (e: Left = Right):
    chooseLeft Left Right select = chooseRight Left Right select :=
  \idelim leftCandidate Left Right = rightCandidate Left Right
    \with S: Candidate Left Right =>
      chooseLeft Left Right select =
        choose Left Right select S
    \by { base: \refl(chooseLeft Left Right select), equality: e };

\definition excludedMiddleFromSelection(P: \Prop)
    (Left, Right: \Pow B.Bool^) (select: Selection Left Right)
    (leftMember: Logic.Or[chooseLeft Left Right select = B.Bool^::false, P])
    (rightMember: Logic.Or[chooseRight Left Right select = B.Bool^::true, P])
    (collapse: P -> Left = Right): Logic.Or[P, Logic.Not P] :=
  Logic.orElim
    (chooseLeft Left Right select = chooseRight Left Right select)
    (Logic.Not (
      chooseLeft Left Right select = chooseRight Left Right select))
    (Logic.Or[P, Logic.Not P])
    (\fun (equal:
        chooseLeft Left Right select = chooseRight Left Right select) =>
      Logic.Or[P, Logic.Not P]::left
        (equalChoicesGiveP P
          (chooseLeft Left Right select) (chooseRight Left Right select)
          leftMember rightMember equal))
    (\fun (unequal: Logic.Not (
        chooseLeft Left Right select = chooseRight Left Right select)) =>
      Logic.Or[P, Logic.Not P]::right
        (\fun (p: P) => unequal (selectedEqual Left Right select (collapse p))))
    (B.eqDecidable
      (chooseLeft Left Right select) (chooseRight Left Right select));

\definition excludedMiddle: \forall (P: \Prop) ->
    Logic.Or[P, Logic.Not P] :=
  \block {
    \fun (P: \Prop) \then
    \let Left: \Pow B.Bool^ :=
      { b : B.Bool^ \where Logic.Or[b = B.Bool^::false, P] } \then
    \let Right: \Pow B.Bool^ :=
      { b : B.Bool^ \where Logic.Or[b = B.Bool^::true, P] } \then
    \let leftExists: \exists \Cast[B.Bool^] Left :=
      \exact(
        \into[B.Bool^](B.Bool^::false, Left) \by { Logic.Or[B.Bool^::false = B.Bool^::false, P]::left
            (\refl(B.Bool^::false)) },
        \Cast[B.Bool^] Left) \then
    \let rightExists: \exists \Cast[B.Bool^] Right :=
      \exact(
        \into[B.Bool^](B.Bool^::true, Right) \by { Logic.Or[B.Bool^::true = B.Bool^::true, P]::left
            (\refl(B.Bool^::true)) },
        \Cast[B.Bool^] Right) \then
    \takefrom select: Selection Left Right
      \by selectionExists Left Right leftExists rightExists \then
    \return excludedMiddleFromSelection P Left Right select
      (\bysub(B.Bool^, Left, leftSelected Left Right select))
      (\bysub(B.Bool^, Right, rightSelected Left Right select))
      (\fun (p: P) =>
        \axiom:setext(Left, Right,
          (\fun (b: B.Bool^) =>
            \fun (_: Logic.Or[b = B.Bool^::false, P]) =>
              Logic.Or[b = B.Bool^::true, P]::right p),
          (\fun (b: B.Bool^) =>
            \fun (_: Logic.Or[b = B.Bool^::true, P]) =>
              Logic.Or[b = B.Bool^::false, P]::right p)))
  };
