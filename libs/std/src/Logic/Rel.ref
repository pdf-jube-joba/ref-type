/* Properties of homogeneous binary relations. */
\import std.Logic[].Proposition[] \as Logic;

\alias Relation[Carrier: \Set]: \PropKind := Carrier -> Carrier -> \Prop;

\definition Reflexive(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x: Carrier) -> R x x;

\definition Irreflexive(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x: Carrier) -> R x x -> Logic.False;

\definition Symmetric(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x, y: Carrier) -> R x y -> R y x;

\definition Antisymmetric(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x, y: Carrier) -> R x y -> R y x -> x = y;

\definition Asymmetric(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x, y: Carrier) -> R x y -> R y x -> Logic.False;

\definition Transitive(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x, y, z: Carrier) -> R x y -> R y z -> R x z;

\definition Total(Carrier: \Set)(R: Relation[Carrier]): \Prop :=
  \forall (x, y: Carrier) -> Logic.Or[R x y, R y x];

\definition Subrelation(Carrier: \Set)(R, S: Relation[Carrier]): \Prop :=
  \forall (x, y: Carrier) -> R x y -> S x y;

\module Closure;
