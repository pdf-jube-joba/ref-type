/* Shared propositional vocabulary for the real-number constructions. */
\inductive True: \Prop :=
| intro: True
;

\inductive False: \Prop :=
;

\definition Not (P: \Prop): \Prop := P -> False;

\definition falseElim (P: \Prop) (impossible: False): P :=
  \match impossible \in False \return (\fun (_: False) => P) \with {};

\record And[P, Q: \Prop]: \Prop := {
  left: P,
  right: Q,
};

\definition andElim(P, Q, R: \Prop) (curried: P -> Q -> R) (value: And[P, Q]): R := curried (value #left) (value #right);

\inductive Or[P, Q: \Prop]: \Prop :=
| left: P -> Or
| right: Q -> Or
;

\definition orElim(P, Q, R: \Prop) (onLeft: P -> R) (onRight: Q -> R) (value: Or[P, Q]): R :=
  \match value \in Or \return (\fun (_: Or[P, Q]) => R) \with {
  | left p : onLeft p
  | right q : onRight q
  };

/* Reusable surface notation for the propositional vocabulary above. */
\macro not($proposition) := Not $proposition;
\macro and($first, ..rest) := \tmatch rest {
  | ($last) => And[$first, $last]
  | ($next, ..tail) => And[$first, and!{$next ..tail}]
};
\macro or($first, ..rest) := \tmatch rest {
  | ($last) => Or[$first, $last]
  | ($next, ..tail) => Or[$first, or!{$next ..tail}]
};

\record PropEquiv[P, Q: \Prop]: \Prop := {
  ltr: P -> Q,
  rtl: Q -> P,
};

/* これは PropEquiv にしなくていい */
\definition andComm (P, Q: \Prop): And[P, Q] -> And[Q, P] := \fun (h: And[P, Q]) =>
  And[Q, P]::# (#right{h}) (#left{h});

\definition andAssoc (P, Q, R: \Prop): PropEquiv[And[And[P, Q], R] \assign _1, And[P, And[Q, R]] \assign _2] := PropEquiv[_1, _2] {
  ltr := \block {
    \fun (h: _1) \then
    \let p: P := h #left #left \then
    \let q: Q := h #left #right \then
    \let r: R := h #right \then
    \return And[_, _]::# p (And[_, _]::# q r)
  },
  rtl := \block {
    \fun (h: _2) \then
    \let p: P := h #left \then
    \let q: Q := h #right #left \then
    \let r: R := h #right #right \then
    \return And[_, _]::# (And[_, _]::# p q) r
  },
};

\definition orComm (P, Q: \Prop): Or[P, Q] -> Or[Q, P] := \fun (h: Or[P, Q]) =>
  \match h \in Or \return (\fun (_: Or[P, Q]) => Or[Q, P]) \with {
  | left p : Or[Q, P]::right p
  | right q : Or[Q, P]::left q
  };

\definition orAssoc (P, Q, R: \Prop): PropEquiv[Or[Or[P, Q], R] \assign _1, Or[P, Or[Q, R]] \assign _2] := PropEquiv[_1, _2] {
  ltr := \fun (h: _1) =>
    \match h \in Or \return (\fun (_: Or[Or[P, Q], R]) => Or[P, Or[Q, R]]) \with {
    | left inner :
        \match inner \in Or \return (\fun (_: Or[P, Q]) => Or[P, Or[Q, R]]) \with {
        | left p : Or[P, Or[Q, R]]::left p
        | right q : Or[P, Or[Q, R]]::right (Or[Q, R]::left q)
        }
    | right r : Or[P, Or[Q, R]]::right (Or[Q, R]::right r)
    },
  rtl := \fun (h: _2) =>
    \match h \in Or \return (\fun (_: Or[P, Or[Q, R]]) => Or[Or[P, Q], R]) \with {
    | left p : Or[_, _]::left (Or[_, _]::left p) 
    | right inner : 
        \match inner \in Or \return (\fun (_: Or[Q, R]) => Or[Or[P, Q], R]) \with {
        | left q : Or[_, _]::left (Or[_, _]::right q)
        | right r : Or[_, _]::right r
        }
    }
};

\definition andOrDistrb (P, Q, R: \Prop): PropEquiv[And[P, Or[Q, R]] \assign _1, Or[And[P, Q], And[P, R]] \assign _2] := PropEquiv[_1, _2] {
  ltr := \block {
    \fun (h: And[_, _]) \then
    \let p: P := h #left \then
    \return \match h #right \in Or \return \fun (_: _) => _2 \with {
        | left q: Or[_, _]::left (And[_, _]::# p q)
        | right r: Or[_, _]::right (And[_, _]::# p r)
    }
  },
  rtl := \fun (h: Or[_, _]) => \match h \in Or \return \fun (_: _) => _1 \with {
    | left pq: \block {
      \let p: P := pq #left \then
      \let q: Q := pq #right \then
      \return And[_, _]::# p (Or[_, _]::left q)
    }
    | right pr: \block {
      \let p: P := pr #left \then
      \let r: R := pr #right \then
      \return And[_, _]::# p (Or[_, _]::right r)
    }
  },
};
