/* Reasoning for a homogeneous equivalence relation. */
\macro equiv_reason_terms($trans, $a, ..steps) := \tmatch steps {
  | ("~", $b, "by", $h) => $h
  | ("~", $b, "by", $h, "~", $c, "by", $next, ..rest) =>
      equiv_reason_terms!{$trans $a "~" $c "by"
        { $trans $a $b $c $h $next } ..rest}
};

\macro equiv_reason($trans, ..steps) := \tmatch steps {
  | ("by", $h) => $h
  | ("by", $h, ..rest) =>
      $trans _ _ _ $h (equiv_reason!{$trans ..rest})
};
