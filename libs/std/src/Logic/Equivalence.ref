/* The relation and its laws are fixed by the enclosing module instance. */
\import std.Logic[].Transitive[] \as Transitive;
\use Transitive.trans_reason;

\macro equiv_reason(..steps) := trans_reason!{trans ..steps};

\macro equiv_reason_terms($a, ..steps) := \tmatch steps {
  | () => refl $a
  | ("~", $b, "by", $h) => ($h \of R $a $b)
  | ("~", $b, "by_sym", $h) => sym $b $a $h
  | ("~", $b, "by", $h, ..rest) =>
      trans $a $b _ $h (equiv_reason_terms!{$b ..rest})
  | ("~", $b, "by_sym", $h, ..rest) =>
      trans $a $b _ (sym $b $a $h) (equiv_reason_terms!{$b ..rest})
};
