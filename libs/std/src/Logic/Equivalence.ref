/* Reasoning for a homogeneous equivalence relation. */
\macro equiv_reason_terms($refl, $trans, $a, ..steps) := \tmatch steps {
  | () => $refl $a
  | ("~", $b, "by", $h) => $h
  | ("~", $b, "by", $h, ..rest) =>
      $trans $a $b _ $h (equiv_reason_terms!{$refl $trans $b ..rest})
};

\macro equiv_reason($trans, ..steps) := \tmatch steps {
  | ("by", $h) => $h
  | ("by", $h, ..rest) =>
      $trans _ _ _ $h (equiv_reason!{$trans ..rest})
};
