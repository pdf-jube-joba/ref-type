\definition left: IntegerMap :=
  \into[I.Int^ -> Carrier](\fun (a: I.Int^) => action (I.Mul.specification a b) x, IntegerMap) \by {
    IntegerMaps.MonoidLaws[integerDomain, target, \fun (a: I.Int^) => action (I.Mul.specification a b) x] {
      unit := trans!{Carrier} _ _ _
        (congr!{I.Int^ Carrier} (\fun (a: I.Int^) => action a x) _ _ (#zeroAbsorbsLeft{(#semiring{IntegerRing.ring})} b)) (scalarZero x),
      operation := \fun (a, c: I.Int^) => trans!{Carrier} _ _ _
        (congr!{I.Int^ Carrier} (\fun (d: I.Int^) => action d x) _ _ (#rightDistributive{(#semiring{IntegerRing.ring})} a c b))
        (scalarAdd (I.Mul.specification a b) (I.Mul.specification c b) x),
    }
  };
\definition right: IntegerMap := integerMap (action b x);
\definition equal: left = right := generatorExt left right
  (trans!{Carrier} _ _ _
    (congr!{I.Int^ Carrier} (\fun (a: I.Int^) => action a x) _ _ (#leftIdentity{(#multiplicative{(#semiring{IntegerRing.ring})})} b))
    (sym!{Carrier} _ _ (scalarOne (action b x))));
\definition law: \forall (a: I.Int^) -> action (I.Mul.specification a b) x = action a (action b x) :=
  \fun (a: I.Int^) => congr!{{I.Int^ -> Carrier} Carrier} (\fun (f: I.Int^ -> Carrier) => f a) _ _ equal;
