\definition Space(V: \Set): \Set := Ring.RingModule[R, V, ring];
\structure Bundle {
  Carrier: \Set,
  space: Space Carrier,
}
\structure Family[Index: \Set] {
  Carrier: Index -> \Set,
  space: \forall (i: Index) -> Space (Carrier i),
}
\definition scalarGroup: Alg.CommutativeGroup[R] := Alg.CommutativeGroup[R] {
  base := Alg.GroupData[R]::# (#zero{ring}) (#add{ring}) (#neg{ring}),
  group := Alg.GroupLaws[R, Alg.GroupData[R]::# (#zero{ring}) (#add{ring}) (#neg{ring})] {
    monoid := #monoid{(#additive{(#semiring{ring})})},
    leftInverse := #additiveInverse{ring},
    rightInverse := \fun (a: R) => trans!{R} _ _ _ (#commutative{(#additive{(#semiring{ring})})} a (#neg{ring} a)) (#additiveInverse{ring} a),
  },
  commutative := #commutative{(#additive{(#semiring{ring})})},
};
\import algebra.Group[].Of[Carrier := R, group := scalarGroup] \as Scalars;
\module Laws(V: \Set, space: Space V);
\module Submodule(V: \Set, space: Space V);
\module Of(V: \Set, space: Space V);
\module Hom(V, W: \Set, source: Space V, target: Space W);
\module End(V: \Set, space: Space V) {
  \import \parent.Hom[V := V, W := V, source := space, target := space] \as Maps;
  \definition identity: Maps.Map := Maps.Map {
    apply := \fun (x: V) => x,
    addition := \fun (x, y: V) => \refl(#add{space} x y),
    scalar := \fun (a: R)(x: V) => \refl(#smul{space} a x),
  };
}
\module Zero;
\definition scalarModule: Space R := Ring.RingModule[R, R, ring] {
  zero := #zero{ring}, add := #add{ring}, neg := #neg{ring}, smul := #mul{ring},
  additive := Alg.CommutativeGroupLaws[R, Alg.CommutativeGroupData[R]::# (Alg.GroupData[R]::# (#zero{ring}) (#add{ring}) (#neg{ring}))] {
    group := #group{scalarGroup}, commutative := #commutative{scalarGroup},
  },
  scalarOne := #leftIdentity{(#multiplicative{(#semiring{ring})})},
  scalarAssoc := #associative{(#multiplicative{(#semiring{ring})})},
  scalarAdd := #rightDistributive{(#semiring{ring})},
  vectorAdd := #leftDistributive{(#semiring{ring})},
};
\module Isomorphism(V, W: \Set, source: Space V, target: Space W);
\module Functions(X, V: \Set, target: Space V);
\definition MapBetween(A, B: Bundle): \Set := Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Map;
\definition Surjective(A, B: Bundle)(f: MapBetween A B): \Prop := \forall (y: B.Carrier) -> \exists { x: A.Carrier \where #apply{f} x = y };
\definition Injective(A, B: Bundle)(f: MapBetween A B): \Prop := \forall (x, y: A.Carrier) -> #apply{f} x = #apply{f} y -> x = y;
\definition Projective(P: Bundle): \Prop :=
  \forall (A, B: Bundle)(q: MapBetween A B) -> Surjective A B q -> \forall (f: MapBetween P B) ->
    \exists { g: MapBetween P A \where \forall (x: P.Carrier) -> #apply{q} (#apply{g} x) = #apply{f} x };
\module Presentation(Generators: \Set);
\module Free(Generators: \Set);
\module CanonicalFree(M: Bundle);
\module Tensor(V, W: \Set, left: Space V, right: Space W);
\module Product(Index: \Set, family: Family[Index]);
\module Biproduct(V, W: \Set, left: Space V, right: Space W);
\module FirstIsomorphism(V, W: \Set, source: Space V, target: Space W, f: \parent.Hom[V := V, W := W, source := source, target := target].Map);
\module FreeResolution(M: Bundle);
\module ShortExact(A, B, C: Bundle);
\module ProjectiveLaws;
\module Coordinates(I: \Set);
\module Sums(I: \Set);
\module DirectSum(Index: \Set, family: Family[Index]);
\module FinitelySupported(Index: \Set, family: Family[Index]);
\module ShortExactComparison(A, B, C, A1, B1, C1: Bundle);
\module ExactFive(A, B, C, D, E: Bundle);
\module FiveLemma(A, B, C, D, E, A1, B1, C1, D1, E1: Bundle);
\module Snake(A, B, C, A1, B1, C1: Bundle);
\module QuotientMapping(A, B: Bundle);

\module QuotientCorrespondence(V: \Set, space: Space V, S: \parent.Submodule[V := V, space := space].Submodule);
\module SurjectiveDescent(A, B, U: Bundle);
\module TensorDescent(B, C, N, U: Bundle);
\module RightExact(A, B, C: Bundle);
\module TensorRightExact(A, B, C, N: Bundle);
\module FiniteCoordinates(n: std.Data[].Nat[].Nat^);
\module KernelTransport(V, W, X, Y: \Set, vSpace: Space V, wSpace: Space W, xSpace: Space X, ySpace: Space Y,
  f: \parent.Hom[V := V, W := W, source := vSpace, target := wSpace].Map,
  g: \parent.Hom[V := X, W := Y, source := xSpace, target := ySpace].Map,
  domainIso: \parent.Isomorphism[V := V, W := X, source := vSpace, target := xSpace].Isomorphism,
  codomainIso: \parent.Isomorphism[V := W, W := Y, source := wSpace, target := ySpace].Isomorphism);

\module FamilyInjection(Index: \Set, family: Family[Index]);

\module SnakeNaturality(A, B, C, A1, B1, C1, A2, B2, C2, A3, B3, C3: Bundle);

\module ExactPair(A, B, C: Bundle);
\module TensorSplitShortExact(A, B, C, N: Bundle);
\module Pushout(A, B, C: Bundle);

\module DirectSumMapping(Index: \Set, sourceFamily, targetFamily: Family[Index]);
