\import \parent.Free[Generators := M.Carrier] \as Free;
\import Free.To[W := M.Carrier, target := M.space] \as Evaluation;
\definition Carrier: \Set := Free.Carrier;
\definition space: Space Carrier := Free.space;
\definition bundle: Bundle := Bundle { Carrier := Carrier, space := space };
\definition augmentation: MapBetween bundle M := Evaluation.extension (\fun (x: M.Carrier) => x);
\definition onto: Surjective bundle M augmentation := \fun (x: M.Carrier) =>
  \exact(\into[Carrier](Free.generator x, { y: Carrier \where #apply{augmentation} y = x }) \by {
    Evaluation.onGenerator (\fun (x: M.Carrier) => x) x
  }, \Cast[Carrier] ({ y: Carrier \where #apply{augmentation} y = x }));
\definition projective: Projective bundle := Free.projective;
\import \parent.Of[V := Carrier, space := space].Submodule[] \as Submodules;
\import Submodules.Kernel[W := M.Carrier, target := M.space] \as Kernels;
\definition kernel: Submodules.Submodule := Kernels.kernel augmentation;
\import Submodules.Of[S := kernel] \as Kernel;
\definition KernelCarrier: \Set := Kernel.Carrier;
\definition kernelSpace: Space KernelCarrier := Kernel.moduleSpace;
\definition kernelBundle: Bundle := Bundle { Carrier := KernelCarrier, space := kernelSpace };
\definition inclusion: MapBetween kernelBundle bundle := Kernel.inclusion;
\definition killed: \forall (x: KernelCarrier) -> #apply{augmentation} (#apply{inclusion} x) = #zero{M.space} :=
  \fun (x: KernelCarrier) => \bysub(Carrier, #carrier{kernel}, x);
