\import \parent.DirectSum[Index := Index, family := sourceFamily] \as Source;
\import \parent.DirectSum[Index := Index, family := targetFamily] \as Target;
\import Source.FiniteSupport[] \as SourceCoordinates;
\import Target.FiniteSupport[] \as TargetCoordinates;
\import \parent.Product[Index := Index, family := targetFamily] \as TargetProduct;
\module Component(i: Index) {
  \definition source: Bundle := Bundle { Carrier := sourceFamily.Carrier i, space := sourceFamily.space i };
  \definition target: Bundle := Bundle { Carrier := targetFamily.Carrier i, space := targetFamily.space i };
  \definition Map: \Set := MapBetween source target;
  \import \parent.\parent.Hom[V := sourceFamily.Carrier i, W := targetFamily.Carrier i, source := sourceFamily.space i, target := targetFamily.space i] \as Linear;
  \definition zero: \forall (f: Map) -> #apply{f} #zero{(sourceFamily.space i)} = #zero{(targetFamily.space i)} := Linear.zeroPreserved;
}
\definition Components: \Set := \forall (i: Index) -> Component[i := i].Map;
\module On(f: Components);
