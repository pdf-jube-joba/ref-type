\import SourceSub.Quotient[S := S] \as Source;
\import TargetSub.Quotient[S := T] \as Target;
\definition Compatible: \Prop := \forall (x: A.Carrier) -> SourceSub.Member S x -> TargetSub.Member T (#apply{f} x);
\import \parent.\parent.Hom[V := B.Carrier, W := Target.Carrier, source := B.space, target := Target.moduleSpace].Composition[U := A.Carrier, domain := A.space] \as Composition;
\import \parent.\parent.Hom[V := A.Carrier, W := Target.Carrier, source := A.space, target := Target.moduleSpace] \as Raw;
\definition raw: Raw.Map := Composition.compose Target.projection f;
\import Source.To[W := Target.Carrier, target := Target.moduleSpace] \as Descent;
\definition vanishes: Compatible -> Descent.Vanishes raw :=
  \fun (compatible: Compatible)(x: A.Carrier)(member: SourceSub.Member S x) => Target.classZero (#apply{f} x) (compatible x member);
\import \parent.\parent.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.moduleSpace, target := Target.moduleSpace] \as Maps;
\definition map(compatible: Compatible): Maps.Map := Descent.descend raw (vanishes compatible);
\definition onClass: \forall (compatible: Compatible)(x: A.Carrier) -> #apply{(map compatible)} (Source.class x) = Target.class (#apply{f} x) :=
  \fun (compatible: Compatible) => Descent.onClass raw (vanishes compatible);
\module Inverse(g: MapBetween B A);
