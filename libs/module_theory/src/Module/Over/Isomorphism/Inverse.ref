\import \parent.\parent.Isomorphism[V := W, W := V, source := target, target := source] \as Reverse;
\definition inverse(f: Isomorphism): Reverse.Isomorphism := Reverse.Isomorphism {
  forward := #backward{f}, backward := #forward{f}, leftInverse := #rightInverse{f}, rightInverse := #leftInverse{f},
};
