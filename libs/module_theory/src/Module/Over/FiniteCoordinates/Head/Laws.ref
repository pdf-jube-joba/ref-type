\definition extensionAddition: \forall (v, w: Smaller.Carrier) -> extension (#add{Smaller.space} v w) = #add{space} (extension v) (extension w) :=
  \fun (v, w: Smaller.Carrier) => \axiom:funext(extension (#add{Smaller.space} v w), #add{space} (extension v) (extension w),
    \fun (i: Index) => trans!{R} (extension (#add{Smaller.space} v w) i)
      (SmallSums.sum (Finite.elements rank) (\fun (j: Smaller.Index) => #add{ring}
        (#mul{ring} (NaturalDelta.delta i j) (v j)) (#mul{ring} (NaturalDelta.delta i j) (w j))))
      (#add{ring} (extension v i) (extension w i))
      (SumLaws.congruent (Finite.elements rank)
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i j) (#add{ring} (v j) (w j)))
        (\fun (j: Smaller.Index) => #add{ring} (#mul{ring} (NaturalDelta.delta i j) (v j)) (#mul{ring} (NaturalDelta.delta i j) (w j)))
        (\fun (j: Smaller.Index) => #leftDistributive{(#semiring{ring})} (NaturalDelta.delta i j) (v j) (w j)))
      (SumLaws.additive (Finite.elements rank)
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i j) (v j))
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i j) (w j))));
\definition scalarTerm: \forall (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) ->
  #mul{ring} (NaturalDelta.delta i j) (#mul{ring} a (v j)) =
  #mul{ring} a (#mul{ring} (NaturalDelta.delta i j) (v j)) :=
  \fun (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) =>
    trans!{R} (#mul{ring} (NaturalDelta.delta i j) (#mul{ring} a (v j)))
      (#mul{ring} (#mul{ring} (NaturalDelta.delta i j) a) (v j))
      (#mul{ring} a (#mul{ring} (NaturalDelta.delta i j) (v j)))
      (sym!{R} (#mul{ring} (#mul{ring} (NaturalDelta.delta i j) a) (v j))
        (#mul{ring} (NaturalDelta.delta i j) (#mul{ring} a (v j))) (#associative{(#multiplicative{(#semiring{ring})})} (NaturalDelta.delta i j) a (v j)))
      (trans!{R} (#mul{ring} (#mul{ring} (NaturalDelta.delta i j) a) (v j))
        (#mul{ring} (#mul{ring} a (NaturalDelta.delta i j)) (v j))
        (#mul{ring} a (#mul{ring} (NaturalDelta.delta i j) (v j)))
        (congr!{R R} (\fun (x: R) => #mul{ring} x (v j)) (#mul{ring} (NaturalDelta.delta i j) a)
          (#mul{ring} a (NaturalDelta.delta i j)) (sym!{R} (#mul{ring} a (NaturalDelta.delta i j)) (#mul{ring} (NaturalDelta.delta i j) a) (NaturalDelta.central i j a)))
        (#associative{(#multiplicative{(#semiring{ring})})} a (NaturalDelta.delta i j) (v j)));
\definition extensionScalar: \forall (a: R)(v: Smaller.Carrier) -> extension (#smul{Smaller.space} a v) = #smul{space} a (extension v) :=
  \fun (a: R)(v: Smaller.Carrier) => \axiom:funext(extension (#smul{Smaller.space} a v), #smul{space} a (extension v),
    \fun (i: Index) => trans!{R} (extension (#smul{Smaller.space} a v) i)
      (SmallSums.sum (Finite.elements rank) (\fun (j: Smaller.Index) => #mul{ring} a (#mul{ring} (NaturalDelta.delta i j) (v j))))
      (#mul{ring} a (extension v i))
      (SumLaws.congruent (Finite.elements rank)
        (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i j) (#mul{ring} a (v j)))
        (\fun (j: Smaller.Index) => #mul{ring} a (#mul{ring} (NaturalDelta.delta i j) (v j)))
        (\fun (j: Smaller.Index) => scalarTerm a v i j))
      (SumLaws.multiplyLeft (Finite.elements rank) a (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i j) (v j))));
