\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Bounds;
\import std.Data[].Bool[] \as B;
\import B.Prop[] \as BoolLaws;
\import Finite.Tail[n := n, start := start] \as Indices;
\import \parent.\parent.FiniteCoordinates[n := Nat.sub n start] \as Smaller;
\definition restriction(within: Bounds.Le start n)(v: Carrier): Smaller.Carrier :=
  \fun (i: Smaller.Index) => v (Indices.include within i);
\definition lower(i: Index)(outside: Nat.ltb i start = B.Bool^::false): Indices.Index :=
  \into[Index](i, { i: Index \where Bounds.Le start i }) \by { Bounds.leOfLtbFalse i start outside };
\import \parent.\parent.Sums[I := Smaller.Index] \as SmallSums;
\import SmallSums.Prop[] \as SumLaws;
\import SmallSums.Single[] \as Single;
\import \parent.\parent.Coordinates[I := N.Nat^].Kronecker[] \as NaturalDelta;
\import \parent.\parent.Coordinates[I := Smaller.Index].Kronecker[] \as SmallDelta;
\import std.Logic[].Classical[] \as Classical;
\definition extension(v: Smaller.Carrier): Carrier := \fun (i: Index) =>
  SmallSums.sum (Finite.elements (Nat.sub n start)) (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j));
\definition atEarly: \forall (v: Smaller.Carrier)(i: Index) -> Bounds.Lt i start -> extension v i = #zero{ring} :=
  \fun (v: Smaller.Carrier)(i: Index)(early: _) => trans!{R} (extension v i)
    (SmallSums.sum (Finite.elements (Nat.sub n start)) (\fun (j: Smaller.Index) => #zero{ring})) #zero{ring}
    (SumLaws.congruent (Finite.elements (Nat.sub n start))
      (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j))
      (\fun (j: Smaller.Index) => #zero{ring})
      (\fun (j: Smaller.Index) => trans!{R} (#mul{ring} (NaturalDelta.delta i (Nat.add start j)) (v j))
        (#mul{ring} #zero{ring} (v j)) #zero{ring}
        (congr!{R R} (\fun (x: R) => #mul{ring} x (v j)) (NaturalDelta.delta i (Nat.add start j)) #zero{ring}
          (NaturalDelta.different i (Nat.add start j) (Bounds.ltNe i (Nat.add start j) (Bounds.ltLeTrans i start (Nat.add start j) early (Bounds.leAddRight start j)))))
        (#zeroAbsorbsLeft{(#semiring{ring})} (v j))))
    (SumLaws.zeroSum (Finite.elements (Nat.sub n start)));
\definition shiftedDelta: \forall (i, j: Smaller.Index) -> NaturalDelta.delta (Nat.add start i) (Nat.add start j) = SmallDelta.delta i j :=
  \fun (i, j: Smaller.Index) => either!{{i = j} "or" {Logic.Not (i = j)} "either" {NaturalDelta.delta (Nat.add start i) (Nat.add start j) = SmallDelta.delta i j}
    "lt:" {\fun (equal: _) => trans!{R} (NaturalDelta.delta (Nat.add start i) (Nat.add start j)) #one{ring} (SmallDelta.delta i j)
      (NaturalDelta.equal (Nat.add start i) (Nat.add start j) (congr!{N.Nat^ N.Nat^} (Nat.add start) i j equal))
      (sym!{R} (SmallDelta.delta i j) #one{ring} (SmallDelta.equal i j equal))}
    "rt:" {\fun (ne: _) => trans!{R} (NaturalDelta.delta (Nat.add start i) (Nat.add start j)) #zero{ring} (SmallDelta.delta i j)
      (NaturalDelta.different (Nat.add start i) (Nat.add start j) (\fun (equal: _) => ne (Bounds.addCancelLeft start i j equal)))
      (sym!{R} (SmallDelta.delta i j) #zero{ring} (SmallDelta.different i j ne))}
  } (Classical.excludedMiddle (i = j));
\definition atIncluded: \forall (within: Bounds.Le start n)(v: Smaller.Carrier)(i: Smaller.Index) ->
  extension v (Indices.include within i) = v i :=
  \fun (within: Bounds.Le start n)(v: Smaller.Carrier)(i: Smaller.Index) => trans!{R} (extension v (Indices.include within i))
    (SmallSums.sum (Finite.elements (Nat.sub n start)) (\fun (j: Smaller.Index) => #mul{ring} (SmallDelta.delta i j) (v j))) (v i)
    (SumLaws.congruent (Finite.elements (Nat.sub n start))
      (\fun (j: Smaller.Index) => #mul{ring} (NaturalDelta.delta (Nat.add start i) (Nat.add start j)) (v j))
      (\fun (j: Smaller.Index) => #mul{ring} (SmallDelta.delta i j) (v j))
      (\fun (j: Smaller.Index) => congr!{R R} (\fun (x: R) => #mul{ring} x (v j)) (NaturalDelta.delta (Nat.add start i) (Nat.add start j)) (SmallDelta.delta i j) (shiftedDelta i j)))
    (Single.extract (Finite.elements (Nat.sub n start)) Smaller.distinct i (Smaller.covers i) v);
\definition restrictionExtension: \forall (within: Bounds.Le start n)(v: Smaller.Carrier) -> restriction within (extension v) = v :=
  \fun (within: Bounds.Le start n)(v: Smaller.Carrier) => \axiom:funext(restriction within (extension v), v, atIncluded within v);
\definition EarlyZero(v: Carrier): \Prop := \forall (i: Index) -> Bounds.Lt i start -> v i = #zero{ring};
\definition atLate: \forall (within: Bounds.Le start n)(v: Smaller.Carrier)(i: Indices.Index) ->
  extension v i = v (Indices.restrict i) :=
  \fun (within: Bounds.Le start n)(v: Smaller.Carrier)(i: Indices.Index) =>
    trans!{R} (extension v i) (extension v (Indices.include within (Indices.restrict i))) (v (Indices.restrict i))
      (congr!{Index R} (extension v) i (Indices.include within (Indices.restrict i))
        (sym!{Index} (Indices.include within (Indices.restrict i)) i (Indices.includeRestrict within i)))
      (atIncluded within v (Indices.restrict i));
\definition recover: \forall (within: Bounds.Le start n)(v: Carrier) -> EarlyZero v -> extension (restriction within v) = v :=
  \fun (within: Bounds.Le start n)(v: Carrier)(zero: EarlyZero v) =>
    \axiom:funext(extension (restriction within v), v, \fun (i: Index) =>
      (\induction (test: B.Bool^) \return Nat.ltb i start = test -> extension (restriction within v) i = v i \with {
        | false: \fun (outside: _) =>
          trans!{R} (extension (restriction within v) i) (v (Indices.include within (Indices.restrict (lower i outside)))) (v i)
            (atLate within (restriction within v) (lower i outside))
            (congr!{Index R} v (Indices.include within (Indices.restrict (lower i outside))) i (Indices.includeRestrict within (lower i outside)))
        | true: \fun (early: _) =>
          trans!{R} (extension (restriction within v) i) #zero{ring} (v i)
            (atEarly (restriction within v) i early)
            (sym!{R} (v i) #zero{ring} (zero i early))
      }) (Nat.ltb i start) (\refl(Nat.ltb i start)));
\definition basisEntry: \forall (j: Smaller.Index)(i: Index) -> extension (Smaller.basis j) i = NaturalDelta.delta i (Nat.add start j) :=
  \fun (j: Smaller.Index)(i: Index) =>
    trans!{R} (extension (Smaller.basis j) i)
      (SmallSums.sum (Finite.elements (Nat.sub n start)) (\fun (x: Smaller.Index) => #mul{ring} (SmallDelta.delta j x) (NaturalDelta.delta i (Nat.add start x))))
      (NaturalDelta.delta i (Nat.add start j))
      (SumLaws.congruent (Finite.elements (Nat.sub n start))
        (\fun (x: Smaller.Index) => #mul{ring} (NaturalDelta.delta i (Nat.add start x)) (SmallDelta.delta x j))
        (\fun (x: Smaller.Index) => #mul{ring} (SmallDelta.delta j x) (NaturalDelta.delta i (Nat.add start x)))
        (\fun (x: Smaller.Index) => trans!{R}
          (#mul{ring} (NaturalDelta.delta i (Nat.add start x)) (SmallDelta.delta x j))
          (#mul{ring} (NaturalDelta.delta i (Nat.add start x)) (SmallDelta.delta j x))
          (#mul{ring} (SmallDelta.delta j x) (NaturalDelta.delta i (Nat.add start x)))
          (congr!{R R} (#mul{ring} (NaturalDelta.delta i (Nat.add start x))) (SmallDelta.delta x j) (SmallDelta.delta j x) (SmallDelta.symmetric x j))
          (SmallDelta.central j x (NaturalDelta.delta i (Nat.add start x)))))
      (Single.extract (Finite.elements (Nat.sub n start)) Smaller.distinct j (Smaller.covers j)
        (\fun (x: Smaller.Index) => NaturalDelta.delta i (Nat.add start x)));
\definition deltaIncluded: \forall (within: Bounds.Le start n)(j: Smaller.Index)(i: Index) ->
  NaturalDelta.delta i (Nat.add start j) = Kronecker.delta i (Indices.include within j) :=
  \fun (within: Bounds.Le start n)(j: Smaller.Index)(i: Index) =>
    either!{{i = Nat.add start j} "or" {Logic.Not (i = Nat.add start j)} "either" {NaturalDelta.delta i (Nat.add start j) = Kronecker.delta i (Indices.include within j)}
      "lt:" {\fun (same: _) => trans!{R} (NaturalDelta.delta i (Nat.add start j)) #one{ring} (Kronecker.delta i (Indices.include within j))
        (NaturalDelta.equal i (Nat.add start j) same)
        (sym!{R} (Kronecker.delta i (Indices.include within j)) #one{ring} (Kronecker.equal i (Indices.include within j) same))}
      "rt:" {\fun (different: _) => trans!{R} (NaturalDelta.delta i (Nat.add start j)) #zero{ring} (Kronecker.delta i (Indices.include within j))
        (NaturalDelta.different i (Nat.add start j) different)
        (sym!{R} (Kronecker.delta i (Indices.include within j)) #zero{ring} (Kronecker.different i (Indices.include within j) different))}
    } (Classical.excludedMiddle (i = Nat.add start j));
\definition extensionBasis: \forall (within: Bounds.Le start n)(j: Smaller.Index) -> extension (Smaller.basis j) = basis (Indices.include within j) :=
  \fun (within: Bounds.Le start n)(j: Smaller.Index) => \axiom:funext(extension (Smaller.basis j), basis (Indices.include within j),
    \fun (i: Index) => trans!{R} (extension (Smaller.basis j) i) (NaturalDelta.delta i (Nat.add start j)) (basis (Indices.include within j) i)
      (basisEntry j i) (deltaIncluded within j i));
\module Laws;
\module ZeroBefore;
