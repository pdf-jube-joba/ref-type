\module Repro {
  \structure Category { Object: \Set, Hom: Object -> Object -> \Set, identity: \forall (u: Object) -> Hom u u, }
  \module On(C: Category) {
    \structure Diagram { Carrier: C.Object -> \Set, }
    \definition hom(u: C.Object): Diagram := Diagram { Carrier := \fun (v: C.Object) => C.Hom u v };
    \module Transformations(P, Q: Diagram) {
      \definition Family: \Set := \forall (v: C.Object) -> P.Carrier v -> Q.Carrier v;
      \definition Naturality(a: Family): \Prop := \forall (v: C.Object)(x: P.Carrier v) -> a v x = a v x;
      \definition Transformation: \Set := \Cast[Family] ({ a: Family \where Naturality a });
    }
    \module Yoneda(P: Diagram, u: C.Object) {
      \import \root.Repro[].On[C := C].Transformations[P := hom u, Q := P] \as Maps;
      \definition evaluate(a: Maps.Transformation): P.Carrier u := a u (C.identity u);
    }
  }
  \inductive Unit: \Set := | unit: Unit;
  \definition C: Category := Category {
    Object := Unit,
    Hom := \fun (u, v: Unit) => Unit,
    identity := \fun (u: Unit) => Unit::unit,
  };
  \module Consumer {
    \import \root.Repro[].On[C := C] \as O;
    \import O.Yoneda[P := O.hom Unit::unit, u := Unit::unit] \as Y;
    \import O.Transformations[P := O.hom Unit::unit, Q := O.hom Unit::unit] \as T;
    \definition identity: T.Transformation := \into[T.Family](\fun (v: Unit)(x: Unit) => x, T.Transformation)
      \by { \fun (v: Unit)(x: Unit) => \refl(x) };
    \definition value: Unit := Y.evaluate identity;
  }
}
