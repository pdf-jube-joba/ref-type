\module Repro(A: \Set) {
  \structure Data: \Set { value: A, }
  \structure Laws[relation: A -> A -> \Prop, data: Data]: \Prop {
    related: relation data.value data.value,
  }
  \definition Selection[relation: A -> A -> \Prop]: \Set :=
    \Cast[Data] ({ data: Data \where Laws[relation, data] });
}
