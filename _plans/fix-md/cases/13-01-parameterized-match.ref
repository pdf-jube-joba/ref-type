\module Repro(A: \Set) {
  \inductive List[A: \Set]: \Set := | nil: List | cons: A -> List -> List;
  \inductive Bool: \Set := | false: Bool | true: Bool;
  \definition isEmpty(xs: List[A]): Bool :=
    \match xs \in List \return Bool \with {
      | nil: Bool::true
      | cons x rest: Bool::false
    };
}
