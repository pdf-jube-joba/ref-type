\module Repro {
  \inductive List[A: \Set]: \Set := | nil: List | cons: A -> List -> List;
  \inductive Coordinate: \Set := | zero: Coordinate;
  \definition Directions: \Set := List[Coordinate];
  \definition empty: Directions := Directions::nil;
}
/* expect-error: Expected inductive constructor or record type in base of associated access */
