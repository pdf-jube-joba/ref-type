\module Repro {
  \structure Category { Object: \Set, Hom: Object -> Object -> \Set, }
  \structure FunctorData[A, B: \Set, HomA: A -> A -> \Set, HomB: B -> B -> \Set]: \Set {
    object: A -> B,
    map: \forall (u, v: A) -> HomA u v -> HomB (object u) (object v),
  }
  \definition Functor(C, D: Category): \Set := FunctorData[C.Object, D.Object, C.Hom, D.Hom];
  \definition identity(C: Category): Functor C C := FunctorData[C.Object, C.Object, C.Hom, C.Hom] {
    object := \fun (u: C.Object) => u,
    map := \fun (u, v: C.Object)(f: C.Hom u v) => f,
  };
}
