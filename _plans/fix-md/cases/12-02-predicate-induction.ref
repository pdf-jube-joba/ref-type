\module Repro {
  \inductive Nat: \Set := | zero: Nat | succ: Nat -> Nat;
  \definition Valid: Nat -> \Prop :=
    \induction (n: Nat) \return \Prop \with {
      | zero: Nat::zero = Nat::zero
      | succ: \fun (n: Nat)(previous: \Prop) => previous
    };
}
/* expect-error: upper sort has no classifier */
