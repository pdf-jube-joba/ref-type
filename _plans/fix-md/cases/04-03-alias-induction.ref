\module Repro {
  \inductive List[A: \Set]: \Set := | nil: List | cons: A -> List -> List;
  \inductive Coordinate: \Set := | zero: Coordinate;
  \definition Directions: \Set := List[Coordinate];
  \definition copy: Directions -> Directions :=
    \induction (xs: Directions) \return Directions \with {
      | nil: List[Coordinate]::nil
      | cons: \fun (x: Coordinate)(xs, previous: Directions) => List[Coordinate]::cons x previous
    };
}
