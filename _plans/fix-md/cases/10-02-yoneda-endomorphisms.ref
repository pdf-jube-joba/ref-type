\module Repro {
  \structure Category { Object: \Set, }
  \module On(C: Category) {
    \definition Hom: \Set := C.Object -> C.Object;
    \module Transformations {
      \definition Family: \Set := C.Object -> Hom -> Hom;
      \definition Naturality(a: Family): \Prop :=
        \forall (v, w: C.Object)(g, f: Hom) ->
          (\fun (x: C.Object) => g (a v f x)) = a w (\fun (x: C.Object) => g (f x));
      \definition Transformation: \Set := \Cast[Family] ({ a: Family \where Naturality a });
    }
    \module Yoneda(u: C.Object) {
      \import \root.Repro[].On[C := C].Transformations[] \as Maps;
      \definition evaluate(a: Maps.Transformation): Hom := a u (\fun (x: C.Object) => x);
    }
  }
  \inductive Unit: \Set := | unit: Unit;
  \definition C: Category := Category { Object := Unit };
  \module Consumer {
    \import \root.Repro[].On[C := C].Transformations[] \as T;
    \import \root.Repro[].On[C := C].Yoneda[u := Unit::unit] \as Y;
    \definition fromElement(p: Unit -> Unit): T.Transformation :=
      \into[T.Family](\fun (v: Unit)(f: Unit -> Unit)(x: Unit) => f (p x), T.Transformation)
        \by { \fun (v, w: Unit)(g, f: Unit -> Unit) => \refl(\fun (x: Unit) => g (f (p x))) };
    \definition evaluateFromElement(p: Unit -> Unit): Y.evaluate (fromElement p) = p :=
      \axiom:funext(\fun (x: Unit) => p x, p, \fun (x: Unit) => \refl(p x));
  }
}
