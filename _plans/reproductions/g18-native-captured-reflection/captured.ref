\module M {
  \inductive Unit: \VType := | unit: Unit;
  \module Family(A: \VType) {
    \inductive Box: \VType := | box: A -> Box;
    \definition reflexive: \forall (x: Box^) -> x = x :=
      \induction (x: Box^) \return x = x \with {
        | box: \fun (a: A^) => \refl(Box^::box a)
      };
  }
  \import Family[A := Unit] \as Closed;
  \definition proof: \forall (x: Closed.Box^) -> x = x := Closed.reflexive;
}
