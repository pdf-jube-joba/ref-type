\module M {
  \inductive Unit: \VType := | unit: Unit;
  \inductive Box[A: \VType]: \VType := | box: A -> Box;
  \module Family(A: \VType) {
    \definition reflexive: \forall (x: Box^[A^]) -> x = x :=
      \induction (x: Box^[A^]) \return x = x \with {
        | box: \fun (a: A^) => \refl(Box^[A^]::box a)
      };
  }
  \import Family[A := Unit] \as Closed;
  \definition proof: \forall (x: Box^[Unit^]) -> x = x := Closed.reflexive;
}
