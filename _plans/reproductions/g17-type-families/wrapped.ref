\module TypeIteration(A: \Set, step: \Set -> \Set) {
  \inductive Nat: \Set := | zero: Nat | succ: Nat -> Nat;
  \structure Type: \Set(1) { Carrier: \Set }
  \definition wrapped: Nat -> Type :=
    \induction (n: Nat) \return Type \with {
      | zero: Type { Carrier := A }
      | succ: \fun (n: Nat)(previous: Type) => Type { Carrier := step previous.Carrier }
    };
  \definition family(n: Nat): \Set := (wrapped n).Carrier;
}
