\module Structures {
  \definition Space(V: \Set): \Set := V -> V;
  \structure Packed: \Set(1) {
    Carrier: \Set,
    spaceLift: \forall (X: \Set) -> (Space Carrier -> X) -> X,
  }
  \definition lower(p: Packed): Space p.Carrier := p.spaceLift (Space p.Carrier) (\fun (m: Space p.Carrier) => m);
  \definition pack(A: \Set)(space: Space A): Packed := Packed {
    Carrier := A, spaceLift := \fun (X: \Set)(f: Space A -> X) => f space,
  };
}
