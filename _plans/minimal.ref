\module Test {
  \inductive Unit: \Set := | unit: Unit; ;
  \inductive Pair(A, B: \Set): \Set := | pair: A -> B -> Pair; ;
  \definition first (A, B: \Set) (p: Pair[A, B]): A :=
    \prec(\Set, Pair[A, B]) (\fun (p: Pair[A, B]) => A)
      (\fun (a: A) => \fun (b: B) => a) p;
  \definition T0: \Set := Unit;
  \definition T1: \Set := Pair[T0, T0];
  \definition T2: \Set := Pair[T1, T1];
  \definition T3: \Set := Pair[T2, T2];
  \definition T4: \Set := Pair[T3, T3];
  \definition T5: \Set := Pair[T4, T4];
  \definition T6: \Set := Pair[T5, T5];
  \definition T7: \Set := Pair[T6, T6];
  \definition T8: \Set := Pair[T7, T7];
  \definition T9: \Set := Pair[T8, T8];
  \definition T10: \Set := Pair[T9, T9];
  \definition project0 (x: T0): first T0 T0 (Pair[T0, T0]::pair x x) = x := \refl(x);
  \definition project2 (x: T2): first T2 T2 (Pair[T2, T2]::pair x x) = x := \refl(x);
  \definition project4 (x: T4): first T4 T4 (Pair[T4, T4]::pair x x) = x := \refl(x);
  \definition project6 (x: T6): first T6 T6 (Pair[T6, T6]::pair x x) = x := \refl(x);
  \definition project8 (x: T8): first T8 T8 (Pair[T8, T8]::pair x x) = x := \refl(x);
  \definition project10 (x: T10): first T10 T10 (Pair[T10, T10]::pair x x) = x := \refl(x);
}
