\module Types {
  \structure Object := { Carrier: \Set, point: Carrier };
  \definition Every: \Prop := \forall (M: Object) -> M.point = M.point;
  \structure Evidence: \Set := { proof: Every };
  \module On(M: Object) {
    \definition reflexive[e: Evidence]: M.point = M.point := e.proof M.Carrier M.point;
  }
}
