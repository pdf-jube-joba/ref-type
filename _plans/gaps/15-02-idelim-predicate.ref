\module Example {
  \inductive Bit: \Set := | zero: Bit | one: Bit;
  \structure Entry: \Set := { value: Bit, same: value = value };
  \definition transport[P: Entry -> \Prop][a, b: Entry][same: a = b][base: P a]: P b :=
    \idelim a = b \with entry: Entry => P entry \by { base: base, equality: same };
  \definition equality[a, b: Entry][same: a = b]: a.value = b.value :=
    transport (\fun (entry: Entry) => a.value = entry.value) a b same (\refl(a.value));
}
