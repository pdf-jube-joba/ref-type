\import std.Data[].Nat[] \as N;
\import std.Alg[].Ring[] \as Ring;
\module Example(R: \Set, ring: Ring.Ring[R]) {
  \import module_theory.Module[].Over[R := R, ring := ring] \as M;
  \definition ranks: N.Nat^ -> N.Nat^ := \induction (n: N.Nat^) \return N.Nat^ \with {
    | zero: N.Nat^::succ N.Nat^::zero
    | succ: \fun (n: N.Nat^)(previous: N.Nat^) => N.Nat^::zero
  };
  \module Term(n: N.Nat^) {
    \import M.FiniteCoordinates[n := ranks n] \as Coordinates;
    \definition Carrier: \Set := Coordinates.Carrier;
    \definition space: M.Space Carrier := Coordinates.space;
  }
}
