\module Repro(Index: \Set) {
  \structure Family { Carrier: \Set, point: Carrier }
  \structure Complex { family: Family }
  \module View(C: Complex) {
    \definition Carrier: \Set := C.family.Carrier;
  }
  \module Current(terms: Index -> Complex) {
    \module At(i: Index) {
      \import \parent.\parent.View[C := terms i] \as Native;
      \definition Carrier: \Set := Native.Carrier;
    }
    \definition Carrier(i: Index): \Set := At[i := i].Carrier;
  }
}
