\module Repro {
  \structure Machine { State: \VType, run: \U(State ~> \F(State)), }
  \inductive Unit: \VType := | unit: Unit;
  \definition machine: Machine := Machine { State := Unit, run := \thunk (\cfun (s: Unit) => \return s) };
  \definition runBox(machine: Machine): \Box[machine.State ~> \F(machine.State)] :=
    \box[machine.State ~> \F(machine.State)](\force machine.run);
}
