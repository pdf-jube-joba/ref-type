\module Current {
\structure Object { Carrier: \Set, element: Carrier }
\module Make(A: \Set, a: A) {
  \definition object: Object := Object { Carrier := A, element := a };
}
\module Use(O: Object) { \definition Value: \Set := O.Carrier; }
\module Read(A: \Set, a: A) {
  \import \parent.Make[A := A, a := a] \as Source;
  \import \parent.Use[O := Source.object] \as Result;
  \definition Value: \Set := Result.Value;
}
\definition chosen(A: \Set)(a: A): \Set := \root.Current[].Read[A := A, a := a].Value;
}
