\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import cohomology_examples.Circle[] \as Circle;
\import Circle.Geometry[] \as Geometry;
\module On(z: I.Int^, coefficients: Modules.Bundle) {
  \import singular_finite_algebra.Integer[].Finite[X := Geometry.Carrier,
    topology := Geometry.topology, model := Circle.complex] \as Transfer;
  \definition checked: Logic.True := \block {
    \takefrom e: Transfer.Comparison \by Geometry.FiniteComparison[].existence \then
    \let sequence: _ := Transfer.Compared[comparison := e].At[z := z, coefficients := coefficients].universalCoefficient \then
    \return Logic.True::intro
  };
  \import homological_algebra.Finite[].Bounded[].Of[C := Circle.complex].At[z := z]
    .UniversalCoefficient[A := coefficients].Tensor[].Projection[].Exactness[] \as TensorExact;
  \import TensorExact.Derived[] \as Derived;
  \definition tor: Modules.Bundle := Derived.torBundle;
}
