\module Demo {
  \structure Point[A: \Set]: \Set := { zero: A };
  \definition copied[A: \Set][p: Point[A]]: Point[A] := Point[A] { zero := p.zero };
  \structure Action[R: \Set, p: Point[R], A: \Set]: \Set := {
    scalar: R -> A -> A,
    zeroLaw: \forall (x: A) -> scalar p.zero x = x,
  };
  \module Modules(R: \Set, p: Point[R]) {
    \structure Bundle := { Carrier: \Set, action: Action[R, p, Carrier] };
  }
  \module Wrapper(R: \Set, p: Point[R]) {
    \definition ordinary: Point[R] := copied R p;
    \import \parent.Modules[R := R, p := copied R p] \as M;
    \module Of(N: M.Bundle) { \definition Carrier: \Set := N.Carrier; }
  }
  \module Example(R: \Set, p: Point[R]) {
    \import \parent.Modules[R := R, p := copied R p] \as M;
    \module Use(N: M.Bundle) {
      \import \parent.\parent.Wrapper[R := R, p := p].Of[N := N] \as Imported;
      \definition Carrier: \Set := Imported.Carrier;
    }
  }
}
