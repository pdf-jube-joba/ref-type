\module Repro(A, B: \Set) {
  \macro map_eq($f, $a, $b, $same) :=
    (\fun (left, right: A)(equal: left = right) =>
      \idelim left = right \with x: A => $f left = $f x
        \by { base: \refl($f left), equality: equal }) $a $b $same;
  \definition law[f: A -> B][a, b: A][same: a = b]: f a = f b :=
    map_eq!{f _ _ same};
}
