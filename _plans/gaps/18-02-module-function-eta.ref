\module Repro {
\inductive Point: \Set := | a: Point | b: Point;
\module Family(j: Point) {
  \definition value[i: Point]: Point := j;
}
\definition apply[f: Point -> Point]: Point := f Point::a;
\definition wanted: \forall (j: Point) -> apply (\fun (i: Point) => Family[j := j].value i) = j :=
  \fun (j: Point) => \refl(j);
}
