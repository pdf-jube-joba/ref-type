\module Repro {
  \inductive Point: \Set := | a: Point;
  \definition Singleton: \Set := \Cast[Point] ({ x: Point \where x = Point::a });
  \definition refined: Singleton := \into[Point](Point::a, Singleton) \by { \refl(Point::a) };
  \macro chain($A, $a, ..steps) := \tmatch steps {
    | () => \refl($a)
    | ("=", $b, "by", $h, ..rest) =>
      \idelim $b = _ \with x: $A => $a = x
      \by { base: $h, equality: chain!{$A $b ..rest} }
  };
  \definition working: Point::a = Point::a := chain!{Point {Point::a}
    "=" refined "by" {\refl(Point::a)}
    "=" {Point::a} "by" {\refl(Point::a)}};
}
