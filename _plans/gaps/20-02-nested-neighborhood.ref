\module Example(A: \Set) {
  \definition Included[U, V: \Pow A]: \Prop := \forall (x: A) -> \In[A] U x -> \In[A] V x;
  \definition Carrier[U: \Pow A]: \Set := \Cast[A] U;
  \definition inclusion[U, V: \Pow A][included: Included U V][x: Carrier U]: Carrier V :=
    \into[A](x, V) \by { included x (\bysub(A, U, x)) };
  \structure Neighborhood[U: \Pow A]: \Set := {
    domain: \Pow A,
    included: Included domain U,
  };
  \structure Actual[U: \Pow A, P: Carrier U -> \Set]: \Set := {
    neighborhood: Neighborhood[U],
    value: \forall (x: Carrier neighborhood.domain) -> P (inclusion neighborhood.domain U neighborhood.included x),
  };
}
