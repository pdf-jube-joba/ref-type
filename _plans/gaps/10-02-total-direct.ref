\import std.Alg[].Ring[] \as Ring;
\module Example(R: \Set, ring: Ring.CommutativeRing[R]) {
  \import module_theory.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
  \import double_complexes.NonnegativeChain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
  \module Of(M, N: Modules.Bundle, P, Q: Chains.Complex) {
    \import double_complexes.DoubleComplex[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Doubles;
    \import Doubles.Tensor[C := P, D := Q] \as Tensor;
    \import Doubles.Total[C := Tensor.complex] \as Total;
    \definition complex: Chains.Complex := Total.complex;
  }
}
