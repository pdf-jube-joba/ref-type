\import std.Data[].Nat[] \as N;
\import std.Alg[].Ring[] \as Ring;
\module Example(R: \Set, ring: Ring.Ring[R]) {
  \import module_theory.Module[].Over[R := R, ring := ring] \as M;
  \import M.Zero[] \as Zero;
  \definition term(n: N.Nat^): M.Bundle :=
    (\induction (k: N.Nat^) \return M.Bundle \with {
      | zero: M.Bundle { Carrier := R, space := M.scalarModule }
      | succ: \fun (k: N.Nat^)(previous: M.Bundle) => M.Bundle { Carrier := Zero.Carrier, space := Zero.moduleSpace }
    }) n;
}
