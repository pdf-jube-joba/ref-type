\module Test {
  \inductive Unit: \Set := | unit: Unit; ;
  \structure Both(P, Q: \Prop): \Prop := { left: P, right: Q, };
  \definition identity (x: Unit): Unit := x;
  \definition P0 (x: Unit): \Prop := x = x;
  \definition P1 (x: Unit): \Prop := Both[P0 x, P0 x];
  \definition P2 (x: Unit): \Prop := Both[P1 x, P1 x];
  \definition P3 (x: Unit): \Prop := Both[P2 x, P2 x];
  \definition P4 (x: Unit): \Prop := Both[P3 x, P3 x];
  \definition P5 (x: Unit): \Prop := Both[P4 x, P4 x];
  \definition P6 (x: Unit): \Prop := Both[P5 x, P5 x];
  \definition P7 (x: Unit): \Prop := Both[P6 x, P6 x];
  \definition P8 (x: Unit): \Prop := Both[P7 x, P7 x];
  \definition P9 (x: Unit): \Prop := Both[P8 x, P8 x];
  \definition P10 (x: Unit): \Prop := Both[P9 x, P9 x];
  \definition P11 (x: Unit): \Prop := Both[P10 x, P10 x];
  \definition P12 (x: Unit): \Prop := Both[P11 x, P11 x];
  \definition P13 (x: Unit): \Prop := Both[P12 x, P12 x];
  \definition P14 (x: Unit): \Prop := Both[P13 x, P13 x];
  \definition alias8 (x: Unit) (h: P8 (identity x)): P8 x := h;
  \definition alias10 (x: Unit) (h: P10 (identity x)): P10 x := h;
  \definition alias12 (x: Unit) (h: P12 (identity x)): P12 x := h;
  \definition alias14 (x: Unit) (h: P14 (identity x)): P14 x := h;
}
