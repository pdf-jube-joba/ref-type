\module Repro {
  \structure Machine { State: \VType, Output: \VType, run: \U(State ~> \F(Output)), }
  \inductive Unit: \VType := | unit: Unit;
  \definition machine: Machine := Machine {
    State := Unit, Output := Unit, run := \thunk (\cfun (s: Unit) => \return s),
  };
  \definition runBox: \Box[Unit ~> \F(Unit)] := \box[_](\force machine.run);
}
