\module Repro {
  \inductive Nat: \Set := | zero: Nat | succ: Nat -> Nat;
  \definition validSet: Nat -> \Pow Nat :=
    \induction (n: Nat) \return \Pow Nat \with {
      | zero: { x: Nat \where x = x }
      | succ: \fun (n: Nat)(previous: \Pow Nat) => previous
    };
  \definition Valid(n: Nat): \Prop := \In[Nat] (validSet n) Nat::zero;
  \definition base: Valid Nat::zero := \refl(Nat::zero);
}
