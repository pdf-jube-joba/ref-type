\module Repro {
  \module Category {
    \structure CategoryData[Object: \Set, Hom: Object -> Object -> \Set]: \Set {
      identity: \forall (x: Object) -> Hom x x,
      compose: \forall (x, y, z: Object) -> Hom y z -> Hom x y -> Hom x z,
    }

    \structure CategoryLaws[Object: \Set, Hom: Object -> Object -> \Set, data: CategoryData[Object, Hom]]: \Prop {
      leftIdentity: \forall (x, y: Object) -> \forall (f: Hom x y) ->
        data.compose x y y (data.identity y) f = f,
      rightIdentity: \forall (x, y: Object) -> \forall (f: Hom x y) ->
        data.compose x x y f (data.identity x) = f,
      associative: \forall (w, x, y, z: Object) ->
        \forall (h: Hom y z) -> \forall (g: Hom x y) -> \forall (f: Hom w x) ->
        data.compose w y z h (data.compose w x y g f) =
          data.compose w x z (data.compose x y z h g) f,
    }

    \structure Category {
      Object: \Set,
      Hom: Object -> Object -> \Set,
      structure: CategoryData[Object, Hom],
      laws: CategoryLaws[Object, Hom, structure],
    }

  }
  \import \root.Repro[].Category[] \as Cat;
  \definition sym(A: \Set)(x, y: A)(e: x = y): y = x :=
    \idelim x = y \with z: A => z = x \by { base: \refl(x), equality: e };
  \module On(C: Cat.Category) {
    \structure Action[Carrier: C.Object -> \Set]: \Set {
      map: \forall (u, v: C.Object) -> C.Hom u v -> Carrier u -> Carrier v,
    }

    \structure ActionLaws[Carrier: C.Object -> \Set, action: Action[Carrier]]: \Prop {
      mapIdentity: \forall (u: C.Object) -> \forall (p: Carrier u) -> action.map u u (C.structure.identity u) p = p,
      mapCompose: \forall (u, v, w: C.Object) -> \forall (g: C.Hom v w) -> \forall (f: C.Hom u v) ->
        \forall (p: Carrier u) -> action.map u w (C.structure.compose u v w g f) p =
          action.map v w g (action.map u v f p),
    }

    \structure Diagram {
      Carrier: C.Object -> \Set,
      action: Action[Carrier],
      laws: ActionLaws[Carrier, action],
    }

    \definition HomCarrier(u: C.Object): C.Object -> \Set := \fun (v: C.Object) => C.Hom u v;

    \definition homAction(u: C.Object): Action[HomCarrier u] := Action[HomCarrier u] {
      map := \fun (v, w: C.Object) (f: C.Hom v w) (h: C.Hom u v) => C.structure.compose u v w f h,
    };

    \definition hom(u: C.Object): Diagram := Diagram {
      Carrier := HomCarrier u,
      action := homAction u,
      laws := ActionLaws[HomCarrier u, homAction u] {
        mapIdentity := \fun (v: C.Object) (h: C.Hom u v) => C.laws.leftIdentity u v h,
        mapCompose := \fun (v, w, t: C.Object) (g: C.Hom w t) (f: C.Hom v w) (h: C.Hom u v) =>
          sym (C.Hom u t)
            (C.structure.compose u w t g (C.structure.compose u v w f h))
            (C.structure.compose u v t (C.structure.compose v w t g f) h)
            (C.laws.associative u v w t g f h),
      },
    };

    \module Transformations(P, Q: Diagram) {
      \definition Family: \Set := \forall (u: C.Object) -> P.Carrier u -> Q.Carrier u;

      \definition Naturality(a: Family): \Prop := \forall (u, v: C.Object) ->
        \forall (f: C.Hom u v) -> \forall (p: P.Carrier u) ->
        Q.action.map u v f (a u p) = a v (P.action.map u v f p);

      \definition Transformation: \Set := \Cast[Family] ({ a: Family \where Naturality a });
    }

    \module Yoneda(P: Diagram, u: C.Object) {
      \import \root.Repro[].On[C := C].Transformations[P := hom u, Q := P] \as Maps;

      \definition evaluate(a: Maps.Transformation): P.Carrier u := a u (C.structure.identity u);

      \definition fromElement(p: P.Carrier u): Maps.Transformation :=
        \into[Maps.Family](\fun (v: C.Object) (f: C.Hom u v) => P.action.map u v f p,
          Maps.Transformation) \by {
          \fun (v, w: C.Object) (f: C.Hom v w) (h: C.Hom u v) =>
            sym (P.Carrier w) _ _ (P.laws.mapCompose u v w f h p)
        };

      \definition evaluateFromElement: \forall (p: P.Carrier u) -> evaluate (fromElement p) = p :=
        \fun (p: P.Carrier u) => P.laws.mapIdentity u p;

    }
  }
  \inductive Unit: \Set := | unit: Unit;
  \definition Hom(u, v: Unit): \Set := Unit -> Unit;
  \definition data: Cat.CategoryData[Unit, Hom] := Cat.CategoryData[Unit, Hom] {
    identity := \fun (u: Unit)(x: Unit) => x,
    compose := \fun (u, v, w: Unit)(g, f: Unit -> Unit)(x: Unit) => g (f x),
  };
  \definition C: Cat.Category := Cat.Category {
    Object := Unit, Hom := Hom, structure := data,
    laws := Cat.CategoryLaws[Unit, Hom, data] {
      leftIdentity := \fun (u, v: Unit)(f: Unit -> Unit) => \axiom:funext(\fun (x: Unit) => f x, f, \fun (x: Unit) => \refl(f x)),
      rightIdentity := \fun (u, v: Unit)(f: Unit -> Unit) => \axiom:funext(\fun (x: Unit) => f x, f, \fun (x: Unit) => \refl(f x)),
      associative := \fun (u, v, w, t: Unit)(h, g, f: Unit -> Unit) => \refl(\fun (x: Unit) => h (g (f x))),
    },
  };
  \module Consumer {
    \import \root.Repro[].On[C := C] \as O;
    \import O.Yoneda[P := O.hom Unit::unit, u := Unit::unit] \as Y;
    \definition p: Unit -> Unit := \fun (x: Unit) => x;
    \definition law: Y.evaluate (Y.fromElement p) = p := Y.evaluateFromElement p;
  }
}
