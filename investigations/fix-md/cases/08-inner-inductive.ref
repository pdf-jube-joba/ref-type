\module Repro {
  \module Space(K: \Set) {
    \module Coordinates(I: \Set) {
      \definition Vector: \Set := I -> K;
      \definition identity(v: Vector): Vector := v;
      \structure SpaceLaws: \Prop { identity: \forall (v: Vector) -> identity v = v, }
      \definition laws: SpaceLaws := SpaceLaws { identity := \fun (v: Vector) => \refl(v) };
      \definition law(v: Vector): identity v = v := laws.identity v;
    }
  }
  \module Example(K: \Set) {
    \import \root.Repro[].Space[K := K] \as Algebra;
    \inductive Unit: \Set := | unit: Unit;
    \import Algebra.Coordinates[I := Unit] \as Coordinates;
    \definition identity(v: Unit -> K): Unit -> K := Coordinates.identity v;
    \definition law(v: Unit -> K): identity v = v := Coordinates.law v;
  }
  \inductive Scalar: \Set := | zero: Scalar;
  \module Consumer {
    \import \root.Repro[].Example[K := Scalar] \as E;
    \definition vector(x: E.Unit): Scalar := Scalar::zero;
    \definition law: E.identity vector = vector := E.law vector;
  }
}
