\module Repro {
  \structure Category { Object: \Set, }
  \structure FunctorMap[A, B: \Set]: \Set { object: A -> B, }
  \definition Functor(C, D: Category): \Set := FunctorMap[C.Object, D.Object];
  \definition identity(C: Category): Functor C C := FunctorMap[C.Object, C.Object] {
    object := \fun (u: _) => u,
  };
  \module Along(C: Category, K: Functor C C) { \definition value: Functor C C := K; }
  \inductive Unit: \Set := | unit: Unit;
  \definition C: Category := Category { Object := Unit };
  \definition bound: Functor C C := identity C;
  \import \root.Repro[].Along[C := C, K := bound] \as Extension;
  \definition value: Functor C C := Extension.value;
}
