/* Fixed carriers for Program operations; Times is inherited from this Pair instance. */
\definition make(a: A, b: B): \F(Times[A, B]) := Times[A, B]::make a b;
\definition first(p: Times[A, B]): \F(A) := Times[A, B]::first p;
\definition second(p: Times[A, B]): \F(B) := Times[A, B]::second p;
\definition swap(p: Times[A, B]): \F(Times[B, A]) := Times[A, B]::swap p;

\module Mapping(C, D: \VType);
\module Functions(C: \VType);
