/* Boolean computation lives in Program; Set operations are certified reflections. */
\import \root.Logic[].Proposition[] \as Logic;
\use Logic.not;
\definition False: \Prop := Logic.False;

\inductive Bool: \VType :=
| false: Bool;
| true: Bool;
;

\import \root.Logic[].Law[] \as Law;

\definition NotEq (x, y: Bool^): \Prop := not!{{ x = y }};

\definition neg: Bool -> Bool := (\cfun (x: Bool) => \match x \in Bool \with { | false => \return Bool::true |
  true => \return Bool::false });

\definition negPrec (x: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => Bool^::true
  | true => Bool^::false
  };
\definition negMatchesPrec: \forall (x: Bool^) -> neg^ x = negPrec x :=
  \block {
    \fix (x: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => neg^ x = negPrec x) {
      | false => (\refl(negPrec Bool^::false))
      | true => (\refl(negPrec Bool^::true))
      }
  };

\definition and: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk(\cfun (y: Bool) => \match x \in Bool \with { | false => \return Bool::false | true => \return y })));

\definition andPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => Bool^::false
  | true => y
  };
\definition andMatchesPrec: \forall (x, y: Bool^) -> and^ x y = andPrec x y :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: and^ Bool^::false y = andPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::false y = andPrec Bool^::false y) {
        | false => (\refl(andPrec Bool^::false Bool^::false))
        | true => (\refl(andPrec Bool^::false Bool^::true))
        } \then
    \let trueCase: and^ Bool^::true y = andPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::true y = andPrec Bool^::true y) {
        | false => (\refl(andPrec Bool^::true Bool^::false))
        | true => (\refl(andPrec Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => and^ x y = andPrec x y) {
      | false => falseCase
      | true => trueCase
      }
  };

\definition or: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk(\cfun (y: Bool) => \match x \in Bool \with { | false => \return y | true => \return Bool::true })));

\definition orPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => y
  | true => Bool^::true
  };
\definition orMatchesPrec: \forall (x, y: Bool^) -> or^ x y = orPrec x y :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: or^ Bool^::false y = orPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::false y = orPrec Bool^::false y) {
        | false => (\refl(orPrec Bool^::false Bool^::false))
        | true => (\refl(orPrec Bool^::false Bool^::true))
        } \then
    \let trueCase: or^ Bool^::true y = orPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::true y = orPrec Bool^::true y) {
        | false => (\refl(orPrec Bool^::true Bool^::false))
        | true => (\refl(orPrec Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => or^ x y = orPrec x y) {
      | false => falseCase
      | true => trueCase
      }
  };

\definition xor: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk(\cfun (y: Bool) => \match x \in Bool \with { | false => \return y | true => (neg y) })));

\definition xorPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => y
  | true => (negPrec
  y)
  };
\definition xorMatchesPrec: \forall (x, y: Bool^) -> xor^ x y = xorPrec x y :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: xor^ Bool^::false y = xorPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xor^ Bool^::false y = xorPrec Bool^::false y) {
        | false => (\refl(xorPrec Bool^::false Bool^::false))
        | true => (\refl(xorPrec Bool^::false Bool^::true))
        } \then
    \let trueCase: xor^ Bool^::true y = xorPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xor^ Bool^::true y = xorPrec Bool^::true y) {
        | false => (\refl(xorPrec Bool^::true Bool^::false))
        | true => (\refl(xorPrec Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xor^ x y = xorPrec x y) {
      | false => falseCase
      | true => trueCase
      }
  };

\definition implies: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk(\cfun (y: Bool) => \match x \in Bool \with { | false => \return Bool::true | true => \return y })));

\definition impliesPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => Bool^::true
  | true => y
  };
\definition impliesMatchesPrec: \forall (x, y: Bool^) -> implies^ x y = impliesPrec x y :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: implies^ Bool^::false y = impliesPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => implies^ Bool^::false y = impliesPrec Bool^::false y) {
        | false => (\refl(impliesPrec Bool^::false Bool^::false))
        | true => (\refl(impliesPrec Bool^::false Bool^::true))
        } \then
    \let trueCase: implies^ Bool^::true y = impliesPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => implies^ Bool^::true y = impliesPrec Bool^::true y) {
        | false => (\refl(impliesPrec Bool^::true Bool^::false))
        | true => (\refl(impliesPrec Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => implies^ x y = impliesPrec x y) {
      | false => falseCase
      | true => trueCase
      }
  };

\definition eqb: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk(\cfun (y: Bool) => \match x \in Bool \with { | false => (neg y) | true => \return y })));

\definition eqbPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (negPrec y)
  | true => y
  };
\definition eqbMatchesPrec: \forall (x, y: Bool^) -> eqb^ x y = eqbPrec x y :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: eqb^ Bool^::false y = eqbPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => eqb^ Bool^::false y = eqbPrec Bool^::false y) {
        | false => (\refl(eqbPrec Bool^::false Bool^::false))
        | true => (\refl(eqbPrec Bool^::false Bool^::true))
        } \then
    \let trueCase: eqb^ Bool^::true y = eqbPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => eqb^ Bool^::true y = eqbPrec Bool^::true y) {
        | false => (\refl(eqbPrec Bool^::true Bool^::false))
        | true => (\refl(eqbPrec Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => eqb^ x y = eqbPrec x y) {
      | false => falseCase
      | true => trueCase
      }
  };
\definition negInvolutive: \forall (x: Bool^) -> neg^ (neg^ x) = x :=
  \block {
    \fix (x: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => neg^ (neg^ x) = x) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::true))
      }
  };
\definition andComm: Law.Commutative Bool^ and^ :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: and^ Bool^::false y = and^ y Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::false y = and^ y Bool^::false) {
        | false => (\refl(and^ Bool^::false Bool^::false))
        | true => (\refl(and^ Bool^::true Bool^::false))
        } \then
    \let trueCase: and^ Bool^::true y = and^ y Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::true y = and^ y Bool^::true) {
        | false => (\refl(and^ Bool^::false Bool^::true))
        | true => (\refl(and^ Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => and^ x y = and^ y x) {
      | false => falseCase
      | true => trueCase
      }
  };
\definition orComm: Law.Commutative Bool^ or^ :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: or^ Bool^::false y = or^ y Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::false y = or^ y Bool^::false) {
        | false => (\refl(or^ Bool^::false Bool^::false))
        | true => (\refl(or^ Bool^::true Bool^::false))
        } \then
    \let trueCase: or^ Bool^::true y = or^ y Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::true y = or^ y Bool^::true) {
        | false => (\refl(or^ Bool^::false Bool^::true))
        | true => (\refl(or^ Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => or^ x y = or^ y x) {
      | false => falseCase
      | true => trueCase
      }
  };
\definition xorComm: Law.Commutative Bool^ xor^ :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: xor^ Bool^::false y = xor^ y Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xor^ Bool^::false y = xor^ y Bool^::false) {
        | false => (\refl(xor^ Bool^::false Bool^::false))
        | true => (\refl(xor^ Bool^::true Bool^::false))
        } \then
    \let trueCase: xor^ Bool^::true y = xor^ y Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xor^ Bool^::true y = xor^ y Bool^::true) {
        | false => (\refl(xor^ Bool^::false Bool^::true))
        | true => (\refl(xor^ Bool^::true Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xor^ x y = xor^ y x) {
      | false => falseCase
      | true => trueCase
      }
  };
\definition andAssoc: Law.Associative Bool^ and^ :=
  \block {
    \fix (x, y, z: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => and^ (and^ x y) z = and^ x (and^ y z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => and^ (and^ Bool^::false y) z = and^ Bool^::false (and^ y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => and^
  (and^ Bool^::false Bool^::false) z = and^ Bool^::false (and^ Bool^::false z)) {
          | false => (\refl(and^ Bool^::false
  (and^ Bool^::false Bool^::false)))
          | true => (\refl(and^ Bool^::false (and^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ (and^ Bool^::false Bool^::true) z = and^ Bool^::false (and^
  Bool^::true z)) {
          | false => (\refl(and^ Bool^::false (and^ Bool^::true Bool^::false)))
          | true => (\refl(and^ Bool^::false (and^
  Bool^::true Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => and^ (and^ Bool^::true y) z = and^
  Bool^::true (and^ y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ (and^ Bool^::true Bool^::false) z = and^
  Bool^::true (and^ Bool^::false z)) {
          | false => (\refl(and^ Bool^::true (and^ Bool^::false Bool^::false)))
          | true => (\refl(and^
  Bool^::true (and^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ (and^ Bool^::true
  Bool^::true) z = and^ Bool^::true (and^ Bool^::true z)) {
          | false => (\refl(and^ Bool^::true (and^ Bool^::true
  Bool^::false)))
          | true => (\refl(and^ Bool^::true (and^ Bool^::true Bool^::true)))
          })
        })
      }
  };
\definition orAssoc: Law.Associative Bool^ or^ :=
  \block {
    \fix (x, y, z: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => or^ (or^ x y) z = or^ x (or^ y z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => or^ (or^ Bool^::false y) z = or^ Bool^::false (or^ y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ (or^
  Bool^::false Bool^::false) z = or^ Bool^::false (or^ Bool^::false z)) {
          | false => (\refl(or^ Bool^::false (or^
  Bool^::false Bool^::false)))
          | true => (\refl(or^ Bool^::false (or^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ (or^ Bool^::false Bool^::true) z = or^ Bool^::false (or^ Bool^::true z)) {
          | false => (\refl(or^
  Bool^::false (or^ Bool^::true Bool^::false)))
          | true => (\refl(or^ Bool^::false (or^ Bool^::true Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => or^ (or^ Bool^::true y) z = or^ Bool^::true (or^ y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ (or^ Bool^::true Bool^::false) z = or^ Bool^::true (or^ Bool^::false z)) {
          | false => (\refl(or^ Bool^::true (or^ Bool^::false Bool^::false)))
          | true => (\refl(or^ Bool^::true (or^ Bool^::false
  Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ (or^ Bool^::true Bool^::true) z = or^ Bool^::true
  (or^ Bool^::true z)) {
          | false => (\refl(or^ Bool^::true (or^ Bool^::true Bool^::false)))
          | true => (\refl(or^ Bool^::true (or^
  Bool^::true Bool^::true)))
          })
        })
      }
  };
\definition xorAssoc: Law.Associative Bool^ xor^ :=
  \block {
    \fix (x, y, z: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xor^ (xor^ x y) z = xor^ x (xor^ y z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => xor^ (xor^ Bool^::false y) z = xor^ Bool^::false (xor^ y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => xor^
  (xor^ Bool^::false Bool^::false) z = xor^ Bool^::false (xor^ Bool^::false z)) {
          | false => (\refl(xor^ Bool^::false
  (xor^ Bool^::false Bool^::false)))
          | true => (\refl(xor^ Bool^::false (xor^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => xor^ (xor^ Bool^::false Bool^::true) z = xor^ Bool^::false (xor^
  Bool^::true z)) {
          | false => (\refl(xor^ Bool^::false (xor^ Bool^::true Bool^::false)))
          | true => (\refl(xor^ Bool^::false (xor^
  Bool^::true Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => xor^ (xor^ Bool^::true y) z = xor^
  Bool^::true (xor^ y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => xor^ (xor^ Bool^::true Bool^::false) z = xor^
  Bool^::true (xor^ Bool^::false z)) {
          | false => (\refl(xor^ Bool^::true (xor^ Bool^::false Bool^::false)))
          | true => (\refl(xor^
  Bool^::true (xor^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => xor^ (xor^ Bool^::true
  Bool^::true) z = xor^ Bool^::true (xor^ Bool^::true z)) {
          | false => (\refl(xor^ Bool^::true (xor^ Bool^::true
  Bool^::false)))
          | true => (\refl(xor^ Bool^::true (xor^ Bool^::true Bool^::true)))
          })
        })
      }
  };
\definition andIdem: Law.Idempotent Bool^ and^ :=
  \block {
    \fix (x: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => and^ x x = x) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::true))
      }
  };
\definition orIdem: Law.Idempotent Bool^ or^ :=
  \block {
    \fix (x: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => or^ x x = x) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::true))
      }
  };
\definition xorSelf: \forall (x: Bool^) -> xor^ x x = Bool^::false :=
  \block {
    \fix (x: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xor^ x x = Bool^::false) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::false))
      }
  };
\definition eqbRefl: \forall (x: Bool^) -> eqb^ x x = Bool^::true :=
  \block {
    \fix (x: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => eqb^ x x = Bool^::true) {
      | false => (\refl(Bool^::true))
      | true => (\refl(Bool^::true))
      }
  };
\definition deMorganAnd: \forall (x, y: Bool^) -> neg^ (and^ x y) = or^ (neg^ x) (neg^ y) :=
  \block {
    \fix (x, y: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => neg^ (and^ x y) = or^ (neg^ x) (neg^ y)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => neg^ (and^ Bool^::false y) = or^ (neg^ Bool^::false) (neg^ y)) {
        | false => (\refl(or^ (neg^
  Bool^::false) (neg^ Bool^::false)))
        | true => (\refl(or^ (neg^ Bool^::false) (neg^ Bool^::true)))
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => neg^ (and^ Bool^::true y) = or^ (neg^ Bool^::true) (neg^ y)) {
        | false => (\refl(or^ (neg^
  Bool^::true) (neg^ Bool^::false)))
        | true => (\refl(or^ (neg^ Bool^::true) (neg^ Bool^::true)))
        })
      }
  };
\definition deMorganOr: \forall (x, y: Bool^) -> neg^ (or^ x y) = and^ (neg^ x) (neg^ y) :=
  \block {
    \fix (x, y: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => neg^ (or^ x y) = and^ (neg^ x) (neg^ y)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => neg^ (or^ Bool^::false y) = and^ (neg^ Bool^::false) (neg^ y)) {
        | false => (\refl(and^ (neg^
  Bool^::false) (neg^ Bool^::false)))
        | true => (\refl(and^ (neg^ Bool^::false) (neg^ Bool^::true)))
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => neg^ (or^ Bool^::true y) = and^ (neg^ Bool^::true) (neg^ y)) {
        | false => (\refl(and^ (neg^
  Bool^::true) (neg^ Bool^::false)))
        | true => (\refl(and^ (neg^ Bool^::true) (neg^ Bool^::true)))
        })
      }
  };
\definition andDistrib: Law.LeftDistributive Bool^ and^ or^ :=
  \block {
    \fix (x, y, z: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => and^ x (or^ y z) = or^ (and^ x y) (and^ x z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::false (or^ y z) = or^ (and^ Bool^::false y) (and^
  Bool^::false z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ Bool^::false (or^ Bool^::false z) = or^ (and^
  Bool^::false Bool^::false) (and^ Bool^::false z)) {
          | false => (\refl(or^ (and^ Bool^::false Bool^::false) (and^
  Bool^::false Bool^::false)))
          | true => (\refl(or^ (and^ Bool^::false Bool^::false) (and^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ Bool^::false (or^ Bool^::true z) = or^ (and^ Bool^::false
  Bool^::true) (and^ Bool^::false z)) {
          | false => (\refl(or^ (and^ Bool^::false Bool^::true) (and^ Bool^::false
  Bool^::false)))
          | true => (\refl(or^ (and^ Bool^::false Bool^::true) (and^ Bool^::false Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::true (or^ y z) = or^ (and^ Bool^::true y) (and^
  Bool^::true z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ Bool^::true (or^ Bool^::false z) = or^ (and^
  Bool^::true Bool^::false) (and^ Bool^::true z)) {
          | false => (\refl(or^ (and^ Bool^::true Bool^::false) (and^ Bool^::true
  Bool^::false)))
          | true => (\refl(or^ (and^ Bool^::true Bool^::false) (and^ Bool^::true Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => and^ Bool^::true (or^ Bool^::true z) = or^ (and^ Bool^::true Bool^::true) (and^
  Bool^::true z)) {
          | false => (\refl(or^ (and^ Bool^::true Bool^::true) (and^ Bool^::true Bool^::false)))
          | true => (\refl(or^
  (and^ Bool^::true Bool^::true) (and^ Bool^::true Bool^::true)))
          })
        })
      }
  };
\definition orDistrib: Law.LeftDistributive Bool^ or^ and^ :=
  \block {
    \fix (x, y, z: Bool^) \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => or^ x (and^ y z) = and^ (or^ x y) (or^ x z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::false (and^ y z) = and^ (or^ Bool^::false y) (or^ Bool^::false z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ Bool^::false (and^ Bool^::false z) = and^ (or^ Bool^::false
  Bool^::false) (or^ Bool^::false z)) {
          | false => (\refl(and^ (or^ Bool^::false Bool^::false) (or^ Bool^::false
  Bool^::false)))
          | true => (\refl(and^ (or^ Bool^::false Bool^::false) (or^ Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ Bool^::false (and^ Bool^::true z) = and^ (or^ Bool^::false Bool^::true) (or^
  Bool^::false z)) {
          | false => (\refl(and^ (or^ Bool^::false Bool^::true) (or^ Bool^::false Bool^::false)))
          | true => (\refl(and^
  (or^ Bool^::false Bool^::true) (or^ Bool^::false Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => or^
  Bool^::true (and^ y z) = and^ (or^ Bool^::true y) (or^ Bool^::true z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ Bool^::true (and^ Bool^::false z) = and^ (or^ Bool^::true Bool^::false) (or^ Bool^::true z)) {
          | false => (\refl(and^ (or^ Bool^::true Bool^::false) (or^ Bool^::true Bool^::false)))
          | true => (\refl(and^ (or^ Bool^::true
  Bool^::false) (or^ Bool^::true Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => or^ Bool^::true (and^
  Bool^::true z) = and^ (or^ Bool^::true Bool^::true) (or^ Bool^::true z)) {
          | false => (\refl(and^ (or^ Bool^::true
  Bool^::true) (or^ Bool^::true Bool^::false)))
          | true => (\refl(and^ (or^ Bool^::true Bool^::true) (or^ Bool^::true
  Bool^::true)))
          })
        })
      }
  };
\definition andAbsorb: \forall (x, y: Bool^) -> and^ x (or^ x y) = x :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: and^ Bool^::false (or^ Bool^::false y) = Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::false (or^ Bool^::false y) = Bool^::false) {
        | false => (\refl(Bool^::false))
        | true => (\refl(Bool^::false))
        } \then
    \let trueCase: and^ Bool^::true (or^ Bool^::true y) = Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => and^ Bool^::true (or^ Bool^::true y) = Bool^::true) {
        | false => (\refl(Bool^::true))
        | true => (\refl(Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => and^ x (or^ x y) = x) {
      | false => falseCase
      | true => trueCase
      }
  };
\definition orAbsorb: \forall (x, y: Bool^) -> or^ x (and^ x y) = x :=
  \block {
    \fix (x, y: Bool^) \then
    \let falseCase: or^ Bool^::false (and^ Bool^::false y) = Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::false (and^ Bool^::false y) = Bool^::false) {
        | false => (\refl(Bool^::false))
        | true => (\refl(Bool^::false))
        } \then
    \let trueCase: or^ Bool^::true (and^ Bool^::true y) = Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => or^ Bool^::true (and^ Bool^::true y) = Bool^::true) {
        | false => (\refl(Bool^::true))
        | true => (\refl(Bool^::true))
        } \then
    \return \case x \in Bool^ \return (\fun (x: Bool^) => or^ x (and^ x y) = x) {
      | false => falseCase
      | true => trueCase
      }
  };

/* Propositional views and elimination of impossible Boolean equalities. */
\definition IsTrue (b: Bool^): \Prop := b = Bool^::true;
\definition IsFalse (b: Bool^): \Prop := b = Bool^::false;
\definition falseNeTrue: NotEq Bool^::false Bool^::true :=
  \block {
    \fix (e: Bool^::false = Bool^::true) \then
    \return \idelim(Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\case b \in Bool^ \return (\fun (b: Bool^) => \Pow Bool^) {
        | false => ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true => ({ x : Bool^ \where Logic.False })
        }) Bool^::false)
    \by { base: \refl(Bool^::false), equality: e }
  };
\definition trueNeFalse: NotEq Bool^::true Bool^::false :=
  \block {
    \fix (e: Bool^::true = Bool^::false) \then
    \let reversed: Bool^::false = Bool^::true :=
      \idelim(Bool^::true = Bool^::false \with b: Bool^ => b = Bool^::true)
        \by { base: \refl(Bool^::true), equality: e } \then
    \return falseNeTrue reversed
  };
\definition absurd: \forall (P: \Prop) -> Bool^::false = Bool^::true -> P :=
  \block {
    \fix (P: \Prop) \then
    \fix (e: Bool^::false = Bool^::true) \then
    \return \idelim(Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\case b \in Bool^ \return (\fun (b: Bool^) => \Pow Bool^) {
        | false => ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true => ({ x : Bool^ \where P })
        }) Bool^::false)
    \by { base: \refl(Bool^::false), equality: e }
  };
\definition eqOfEqbTrue: \forall (a, b: Bool^) -> IsTrue (eqb^ a b) -> a = b :=
  \induction (a: Bool^) \return \forall (b: Bool^) -> IsTrue (eqb^ a b) -> a = b \with {
    | false => (\induction (b: Bool^) \return IsTrue (eqb^ Bool^::false b) -> Bool^::false = b \with {
      | false => (\fun (e: Bool^::true = Bool^::true) => \refl(Bool^::false))
      | true => (\fun (e: Bool^::false = Bool^::true) => absurd (Bool^::false = Bool^::true) e)
      })
    | true => (\induction (b: Bool^) \return IsTrue (eqb^ Bool^::true b) -> Bool^::true = b \with {
      | false => (\fun (e: Bool^::false = Bool^::true) => absurd (Bool^::true = Bool^::false) e)
      | true => (\fun (e: Bool^::true = Bool^::true) => \refl(Bool^::true))
      })
    };
\definition eqbTrueOfEq: \forall (a, b: Bool^) -> a = b -> IsTrue (eqb^ a b) :=
  \block {
    \fix (a, b: Bool^) \then
    \fix (e: a = b) \then
    \return \idelim(a = b \with x: Bool^ => IsTrue (eqb^ a x)) \by { base: eqbRefl a, equality: e }
  };

/* Set-polymorphic selection: a box requires a closed Program type,
 * so this universe-polymorphic wrapper uses prec directly. */
\definition ite (A: \Set) (test: Bool^) (yes: A) (no: A): A :=
    \case test \in Bool^ \return (\fun (b: Bool^) => A) {
      | false => no
      | true => yes
      };
\module ConditionalLaws(A: \Set) {
  \definition iteTrue (yes, no: A): ite A Bool^::true yes no = yes := \refl(yes);
  \definition iteFalse (yes, no: A): ite A Bool^::false yes no = no := \refl(no);
  \definition iteSame: \forall (test: Bool^) -> \forall (value: A) -> ite A test value value = value :=
    \induction (test: Bool^) \return \forall (value: A) -> ite A test value value = value \with {
      | false => (\fun (value: A) => \refl(value))
      | true => (\fun (value: A) => \refl(value))
      };
}
