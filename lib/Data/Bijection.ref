/* A raw bijection consists of two candidate inverse functions. */
\record RawBijection: \Set := {
  forward: A -> B,
  backward: B -> A,
};

\definition LeftInverse(b: RawBijection): \Prop :=
  \forall (a: A) -> #backward{b} (#forward{b} a) = a;

\definition RightInverse(b: RawBijection): \Prop :=
  \forall (bValue: B) -> #forward{b} (#backward{b} bValue) = bValue;

\record BijectionLaws(b: RawBijection): \Prop := {
  leftInverse: LeftInverse b,
  rightInverse: RightInverse b,
};

\definition BijectionSet: \Pow (RawBijection) :=
  { b: RawBijection \where BijectionLaws[b] };

\definition Bijection: \Set := \Cast[RawBijection] (BijectionSet);

\definition raw(b: Bijection): RawBijection := b;

\definition laws(b: Bijection): BijectionLaws[raw b] :=
  \bysub(RawBijection, BijectionSet, b);

\definition leftInverse(b: Bijection) (a: A): #backward{(raw b)} (#forward{(raw b)} a) = a :=
  #leftInverse{(laws b)} a;

\definition rightInverse(b: Bijection) (bValue: B): #forward{(raw b)} (#backward{(raw b)} bValue) = bValue :=
  #rightInverse{(laws b)} bValue;
