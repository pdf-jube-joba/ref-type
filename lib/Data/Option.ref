/* Optional values over an arbitrary Set carrier. */
\import \root.Data[].Bool[] \as B;
\import \root.Data[].List[] \as L;

\inductive Option(A: \Set): \Set :=
| none: Option;
| some: A -> Option;
;

\definition map (A, C: \Set) (f: A -> C) (value: Option[A]): Option[C] :=
  \case value \in Option \return (\fun (value: Option[A]) => Option[C]) {
    | none => (Option[C]::none)
    | some => (\fun (element: A) => Option[C]::some (f element))
    };

\definition bind (A, C: \Set) (value: Option[A]) (f: A -> Option[C]): Option[C] :=
  \case value \in Option \return (\fun (value: Option[A]) => Option[C]) {
    | none => (Option[C]::none)
    | some => f
    };

\definition filter (A: \Set) (predicate: A -> B.Bool^) (value: Option[A]): Option[A] :=
  \case value \in Option \return (\fun (value: Option[A]) => Option[A]) {
    | none => (Option[A]::none)
    | some => (\fun (element: A) =>
      \case predicate element \in B.Bool^ \return (\fun (result: B.Bool^) => Option[A]) {
        | false => (Option[A]::none)
        | true => (Option[A]::some element)
        })
    };

\definition toList (A: \Set) (value: Option[A]): L.List[A] :=
  \case value \in Option \return (\fun (value: Option[A]) => L.List[A]) {
    | none => (L.List[A]::nil)
    | some => (\fun (element: A) => L.List[A]::cons element L.List[A]::nil)
    };

\module Laws(A: \Set);
