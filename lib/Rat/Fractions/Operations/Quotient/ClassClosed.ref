\definition add (x, y: Rat): Rat :=
    \subsetinto(
      \Power(Fraction), ClassSet,
      AddClass x y, addClassIsClass x y);

\definition sub (x, y: Rat): Rat := add x (neg y);

\definition mul: Rat -> Rat -> Rat :=
  mulRat;

\definition mulClass:
  \forall (x, y: Fraction) ->
    mul (class x) (class y) = class (mulFraction x y) :=
  mulRatClass;

\definition div (x: Rat) (y: NonZeroRat): Rat :=
    \subsetinto(
      \Power(Fraction), ClassSet,
      DivClass x y, divClassIsClass x y);
