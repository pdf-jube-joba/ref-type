\definition add: Rat -> Rat -> Rat :=
  \fun (x, y: Rat) =>
    \subsetinto(
      \Power(Fraction), ClassSet,
      AddClass x y, addClassIsClass x y);

\definition sub: Rat -> Rat -> Rat :=
  \fun (x, y: Rat) => add x (neg y);

\definition mul: Rat -> Rat -> Rat :=
  mulRat;

\definition mulClass:
  \forall (x, y: Fraction) ->
    mul (class x) (class y) = class (mulFraction x y) :=
  mulRatClass;

\definition div: Rat -> NonZeroRat -> Rat :=
  \fun (x: Rat) => \fun (y: NonZeroRat) =>
    \subsetinto(
      \Power(Fraction), ClassSet,
      DivClass x y, divClassIsClass x y);
