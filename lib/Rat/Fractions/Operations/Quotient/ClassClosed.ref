\definition add (x, y: Rat): Rat :=
    \subsetinto(
      \Power(Fraction), ClassSet,
      AddClass x y, addClassIsClass x y);

\definition sub (x, y: Rat): Rat := add x (neg y);

\definition mul: Rat -> Rat -> Rat :=
  mulRat;

\definition mulClass:
  \forall (x, y: Fraction) ->
    mul (class x) (class y) = class (mulFraction x y) :=
  mulRatClass;

\definition div (x: Rat) (y: NonZeroRat): Rat :=
    \subsetinto(
      \Power(Fraction), ClassSet,
      DivClass x y, divClassIsClass x y);
/*
 * The relational definitions deliberately do not choose representatives.
 * Once their closure proofs are supplied, they can be packaged as quotient
 * values.  Keeping these constructors in the child module also means clients
 * only need the closure obligations when they actually want these operations.
 */
\definition addRat (x, y: Rat): Rat :=
  \subsetinto(
    \Power(Fraction), ClassSet,
    AddClass x y, addClassIsClass x y);

\definition subRat (x, y: Rat): Rat := addRat x (neg y);

\definition divRat (x: Rat) (y: NonZeroRat): Rat :=
  \subsetinto(
    \Power(Fraction), ClassSet,
    DivClass x y, divClassIsClass x y);
