\import \root.Logic() \as QuotientLogic;

\import \root.Quotient(
  A := Fraction, Equivalent := FractionEq,
  equivalentRefl := fractionEqRefl, equivalentSym := fractionEqSym, equivalentTrans := fractionEqTrans
) \as Q;

\definition ClassOf: Fraction -> \Power(Fraction) := Q.ClassOf;
\definition classOfEq: \forall (x, y: Fraction) -> FractionEq x y -> ClassOf x = ClassOf y := Q.classOfEq;
\definition IsClass: \Power(Fraction) -> \Prop := Q.IsClass;
\definition ClassSet: \Power(\Power(Fraction)) := Q.ClassSet;
\definition Rat: \Set := Q.Carrier;
\definition mem: Rat -> Fraction -> \Prop := Q.mem;
\definition underlying: Rat -> \Power(Fraction) := Q.underlying;
\definition Eq: Rat -> Rat -> \Prop := Q.Eq;
\definition eqByExt: \forall (x, y: Rat) ->
  (\forall (a: Fraction) -> mem x a -> mem y a) -> (\forall (a: Fraction) -> mem y a -> mem x a) -> Eq x y := Q.eqByExt;
\definition classIsClass: \forall (x: Fraction) -> IsClass (ClassOf x) := Q.classIsClass;
\definition class: Fraction -> Rat := Q.class;

\definition quotientInduction: \forall (P: Rat -> \Prop) ->
  (\forall (x: Fraction) -> P (class x)) -> \forall (x: Rat) -> P x :=
  Q.induction;

\definition IntegerCarrier: \Set := I.Integer;
\definition integerNeg: IntegerCarrier -> IntegerCarrier := I.negInteger;
\definition ofInteger (n: I.Integer): Rat := class (fraction n I.zeroNat);
\definition ofNat (n: I.Nat): Rat := ofInteger (I.integer n I.zeroNat);

\definition zeroRat: Rat := ofInteger I.zeroInteger;
\definition oneRat: Rat := ofInteger I.oneInteger;

\definition negFraction: Fraction -> Fraction := neg;
\definition NegClass (x: Rat): \Power(Fraction) := Q.UnaryImage negFraction x;
\definition negClassIsClass:
  \forall (x: Rat) -> IsClass (NegClass x) :=
  Q.unaryImageClosed negFraction fractionNegRespects;
\definition negClassOf (x: Fraction): NegClass (class x) = ClassOf (negFraction x) :=
    Q.unaryImageClass negFraction fractionNegRespects
      (class x) x (\refl(ClassOf x));
\definition neg (x: Rat): Rat :=
    \subsetinto(\Power(Fraction), ClassSet,
      NegClass x, negClassIsClass x);

\definition negClass (x: Fraction): neg (class x) = class (negFraction x) := negClassOf x;

\definition negOfInteger (n: IntegerCarrier):
    neg (ofInteger n) = ofInteger (integerNeg n) := negClass (fraction n I.zeroNat);

\definition negInvolutive:
  \forall (x: Rat) -> neg (neg x) = x :=
  quotientInduction (\fun (x: Rat) => neg (neg x) = x)
    (\fun (x: Fraction) =>
      trans!{Rat}
        (neg (neg (class x)))
        (neg (class (negFraction x)))
        (class x)
        (congr!{Rat Rat} neg
          (neg (class x)) (class (negFraction x))
          (negClass x))
        (trans!{Rat}
          (neg (class (negFraction x)))
          (class (negFraction (negFraction x)))
          (class x)
          (negClass (negFraction x))
          (classOfEq
            (negFraction (negFraction x)) x
            (fractionNegInvolutive x))));

\definition negZero: neg zeroRat = zeroRat :=
  trans!{Rat} _ _ _ (negClass zero)
    (congr!{Fraction Rat} class (negFraction zero) zero fractionNegZero);

\definition IsNonZero (x: Rat): \Prop :=
    \forall (a: Fraction) -> mem x a -> NumeratorNonZero a;

\definition NonZeroRatSet: \Power(Rat) :=
  \Subset(x, Rat, IsNonZero x);

\definition NonZeroRat: \Set :=
  \Ty(Rat, NonZeroRatSet);

\definition classIsNonZero (x: Fraction) (nonzero: NumeratorNonZero x):
    IsNonZero (class x) :=
  \fun (a: Fraction) => \fun (xa: mem (class x) a) =>
    numeratorNonZeroRespects x a
      (Q.relatedOfClassMem x a xa) nonzero;

\definition nonZeroProperty (x: NonZeroRat): IsNonZero x :=
    \bysub(Rat, NonZeroRatSet, x);

\definition AddClass (x, y: Rat): \Power(Fraction) :=
    \Subset(z, Fraction,
      \exists \Ty(Fraction,
        \Subset(a, Fraction,
          QuotientLogic.And[mem x a,
            \exists \Ty(Fraction,
              \Subset(b, Fraction,
                QuotientLogic.And[mem y b,
                  FractionEq z (add a b)]))])));

\definition mulFraction: Fraction -> Fraction -> Fraction := mul;

\definition MulClass (x, y: Rat): \Power(Fraction) := Q.BinaryImage mulFraction x y;

\definition mulClassIsClass:
  \forall (x, y: Rat) -> IsClass (MulClass x y) :=
  Q.binaryImageClosed mulFraction fractionMulRespects;

\definition mulRat (x, y: Rat): Rat :=
    \subsetinto(
      \Power(Fraction), ClassSet,
      MulClass x y, mulClassIsClass x y);

\definition mulRatClass (x, y: Fraction):
    mulRat (class x) (class y) = class (mulFraction x y) :=
    Q.binaryImageClass mulFraction fractionMulRespects
      (class x) (class y) x y
      (\refl(ClassOf x)) (\refl(ClassOf y));

\definition mulRatZeroRight:
  \forall (x: Rat) -> mulRat x zeroRat = zeroRat :=
  quotientInduction
    (\fun (x: Rat) => mulRat x zeroRat = zeroRat)
    (\fun (x: Fraction) =>
      trans!{Rat}
        (mulRat (class x) zeroRat)
        (class (mulFraction x zero))
        zeroRat
        (mulRatClass x zero)
        (classOfEq (mulFraction x zero) zero
          (fractionMulZeroRight x)));

\definition mulRatZeroLeft:
  \forall (x: Rat) -> mulRat zeroRat x = zeroRat :=
  quotientInduction
    (\fun (x: Rat) => mulRat zeroRat x = zeroRat)
    (\fun (x: Fraction) =>
      trans!{Rat}
        (mulRat zeroRat (class x))
        (class (mulFraction zero x))
        zeroRat
        (mulRatClass zero x)
        (classOfEq (mulFraction zero x) zero
          (fractionMulZeroLeft x)));

\definition mulRatOneRight:
  \forall (x: Rat) -> mulRat x oneRat = x :=
  quotientInduction
    (\fun (x: Rat) => mulRat x oneRat = x)
    (\fun (x: Fraction) =>
      trans!{Rat}
        (mulRat (class x) oneRat)
        (class (mulFraction x one))
        (class x)
        (mulRatClass x one)
        (classOfEq (mulFraction x one) x
          (fractionMulOneRight x)));

\definition mulRatOneLeft:
  \forall (x: Rat) -> mulRat oneRat x = x :=
  quotientInduction
    (\fun (x: Rat) => mulRat oneRat x = x)
    (\fun (x: Fraction) =>
      trans!{Rat}
        (mulRat oneRat (class x))
        (class (mulFraction one x))
        (class x)
        (mulRatClass one x)
        (classOfEq (mulFraction one x) x
          (fractionMulOneLeft x)));

\definition mulRatComm:
  \forall (x, y: Rat) -> mulRat x y = mulRat y x :=
  quotientInduction
    (\fun (x: Rat) =>
      \forall (y: Rat) -> mulRat x y = mulRat y x)
    (\fun (x: Fraction) =>
      quotientInduction
        (\fun (y: Rat) =>
          mulRat (class x) y = mulRat y (class x))
        (\fun (y: Fraction) =>
          trans!{Rat}
            (mulRat (class x) (class y))
            (class (mulFraction x y))
            (mulRat (class y) (class x))
            (mulRatClass x y)
            (trans!{Rat}
              (class (mulFraction x y))
              (class (mulFraction y x))
              (mulRat (class y) (class x))
              (classOfEq
                (mulFraction x y) (mulFraction y x)
                (fractionMulComm x y))
              (sym!{Rat} _ _ (mulRatClass y x)))));

/* z is x/y exactly when z*y=x; y is separately refined as nonzero. */
\definition DivClass (x: Rat) (y: NonZeroRat): \Power(Fraction) :=
    \Subset(z, Fraction,
      \exists \Ty(Fraction,
        \Subset(a, Fraction,
          QuotientLogic.And[mem x a,
            \exists \Ty(Fraction,
              \Subset(b, Fraction,
                QuotientLogic.And[mem y b,
                  QuotientLogic.And[NumeratorNonZero b,
                    FractionEq (mul z b) a]]))])));

\module ClassClosed(
  addClassIsClass: \forall (x, y: Rat) -> IsClass (AddClass x y),
  divClassIsClass: \forall (x: Rat) -> \forall (y: NonZeroRat) ->
    IsClass (DivClass x y),
);
