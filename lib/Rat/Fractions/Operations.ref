/* Arithmetic on positive-denominator rational representatives. */
\definition add: Fraction -> Fraction -> Fraction :=
  \fun (x, y: Fraction) =>
    fraction
      (addInteger
        (mulInteger (numerator x) (denominator y))
        (mulInteger (numerator y) (denominator x)))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

\definition fractionAddZeroRight:
  \forall (x: Fraction) -> FractionEq (add x zero) x :=
  \fun (x: Fraction) =>
    fractionEqOfParts
      (numerator (add x zero))
      (numerator x)
      (denominatorIndex (add x zero))
      (denominatorIndex x)
      (integerEqTrans
        (numerator (add x zero))
        (addInteger (numerator x) zeroInteger)
        (numerator x)
        (addIntegerRespects
          (mulInteger (numerator x) (denominator zero))
          (numerator x)
          (mulInteger zeroInteger (denominator x))
          zeroInteger
          (mulIntegerOneRight (numerator x))
          (mulIntegerZeroLeft (denominator x)))
        (addIntegerZeroRight (numerator x)))
      (denominatorProductIndexZeroRight
        (denominatorIndex x));

\definition fractionAddZeroLeft:
  \forall (x: Fraction) -> FractionEq (add zero x) x :=
  \fun (x: Fraction) =>
    fractionEqOfParts
      (numerator (add zero x))
      (numerator x)
      (denominatorIndex (add zero x))
      (denominatorIndex x)
      (integerEqTrans
        (numerator (add zero x))
        (addInteger zeroInteger (numerator x))
        (numerator x)
        (addIntegerRespects
          (mulInteger zeroInteger (denominator x))
          zeroInteger
          (mulInteger (numerator x) (denominator zero))
          (numerator x)
          (mulIntegerZeroLeft (denominator x))
          (mulIntegerOneRight (numerator x)))
        (addIntegerZeroLeft (numerator x)))
      (denominatorProductIndexZeroLeft
        (denominatorIndex x));

\definition fractionAddComm:
  \forall (x, y: Fraction) -> FractionEq (add x y) (add y x) :=
  \fun (x, y: Fraction) =>
    fractionEqOfParts
      (numerator (add x y))
      (numerator (add y x))
      (denominatorIndex (add x y))
      (denominatorIndex (add y x))
      (addIntegerComm
        (mulInteger (numerator x) (denominator y))
        (mulInteger (numerator y) (denominator x)))
      (denominatorProductIndexComm
        (denominatorIndex x) (denominatorIndex y));

\definition neg: Fraction -> Fraction :=
  \fun (x: Fraction) =>
    fraction (negInteger (numerator x)) (denominatorIndex x);

\definition numeratorNonZeroNeg:
  \forall (x: Fraction) ->
    NumeratorNonZero x -> NumeratorNonZero (neg x) :=
  \fun (x: Fraction) => \fun (nonzero: NumeratorNonZero x) =>
    integerNonZeroNeg (numerator x) nonzero;

\definition fractionNegRespects:
  \forall (x, y: Fraction) ->
    FractionEq x y -> FractionEq (neg x) (neg y) :=
  \fun (x, y: Fraction) => \fun (xy: FractionEq x y) =>
    integerEqTrans
      (mulInteger (negInteger (numerator x)) (denominator y))
      (negInteger (mulInteger (numerator x) (denominator y)))
      (mulInteger (negInteger (numerator y)) (denominator x))
      (mulIntegerNegLeft (numerator x) (denominator y))
      (integerEqTrans
        (negInteger (mulInteger (numerator x) (denominator y)))
        (negInteger (mulInteger (numerator y) (denominator x)))
        (mulInteger (negInteger (numerator y)) (denominator x))
        (negIntegerRespects
          (mulInteger (numerator x) (denominator y))
          (mulInteger (numerator y) (denominator x)) xy)
        (integerEqSym
          (mulInteger (negInteger (numerator y)) (denominator x))
          (negInteger (mulInteger (numerator y) (denominator x)))
          (mulIntegerNegLeft (numerator y) (denominator x))));

\definition fractionNegInvolutive:
  \forall (x: Fraction) -> FractionEq (neg (neg x)) x :=
  \fun (x: Fraction) => fractionEqRefl x;

\definition fractionNegZero: neg zero = zero :=
  \refl(zero);

\definition fractionAddNegRight:
  \forall (x: Fraction) -> FractionEq (add x (neg x)) zero :=
  \fun (x: Fraction) =>
    fractionEqZeroOfNumerator (add x (neg x))
      (integerEqTrans
        (numerator (add x (neg x)))
        (addInteger
          (mulInteger (numerator x) (denominator x))
          (negInteger
            (mulInteger (numerator x) (denominator x))))
        zeroInteger
        (addIntegerRespects
          (mulInteger (numerator x) (denominator (neg x)))
          (mulInteger (numerator x) (denominator x))
          (mulInteger (negInteger (numerator x)) (denominator x))
          (negInteger
            (mulInteger (numerator x) (denominator x)))
          (integerEqRefl
            (mulInteger (numerator x) (denominator x)))
          (mulIntegerNegLeft
            (numerator x) (denominator x)))
        (addIntegerNegRight
          (mulInteger (numerator x) (denominator x))));

\definition fractionAddNegLeft:
  \forall (x: Fraction) -> FractionEq (add (neg x) x) zero :=
  \fun (x: Fraction) =>
    fractionEqZeroOfNumerator (add (neg x) x)
      (integerEqTrans
        (numerator (add (neg x) x))
        (addInteger
          (negInteger
            (mulInteger (numerator x) (denominator x)))
          (mulInteger (numerator x) (denominator x)))
        zeroInteger
        (addIntegerRespects
          (mulInteger (negInteger (numerator x)) (denominator x))
          (negInteger
            (mulInteger (numerator x) (denominator x)))
          (mulInteger (numerator x) (denominator (neg x)))
          (mulInteger (numerator x) (denominator x))
          (mulIntegerNegLeft
            (numerator x) (denominator x))
          (integerEqRefl
            (mulInteger (numerator x) (denominator x))))
        (addIntegerNegLeft
          (mulInteger (numerator x) (denominator x))));

\definition sub: Fraction -> Fraction -> Fraction :=
  \fun (x, y: Fraction) => add x (neg y);

\definition fractionSubZeroRight:
  \forall (x: Fraction) -> FractionEq (sub x zero) x :=
  \fun (x: Fraction) => fractionAddZeroRight x;

\definition fractionSubSelf:
  \forall (x: Fraction) -> FractionEq (sub x x) zero :=
  \fun (x: Fraction) => fractionAddNegRight x;

\definition mul: Fraction -> Fraction -> Fraction :=
  \fun (x, y: Fraction) =>
    fraction
      (mulInteger (numerator x) (numerator y))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

\definition denominatorMul:
  \forall (x, y: Fraction) ->
    IntegerEq
      (denominator (mul x y))
      (mulInteger (denominator x) (denominator y)) :=
  \fun (x, y: Fraction) =>
    integerEqOfFields
      (denominator (mul x y))
      (mulInteger (denominator x) (denominator y))
      (trans!{Nat} _ _ _
        (denominatorProductIndexSucc
          (denominatorIndex x) (denominatorIndex y))
        (sym!{Nat} _ _
          (trans!{Nat} _ _ _
            (congr2!{Nat Nat Nat} natAdd _ _ _ _
              (\refl(natMul
                (natSucc (denominatorIndex x))
                (natSucc (denominatorIndex y))))
              (natMulZeroRight zeroNat))
            (natAddZeroRight
              (natMul
                (natSucc (denominatorIndex x))
                (natSucc (denominatorIndex y)))))))
      (sym!{Nat} _ _
        (trans!{Nat} _ _ _
          (congr2!{Nat Nat Nat} natAdd _ _ _ _
            (natMulZeroRight
              (natSucc (denominatorIndex x)))
            (natMulZeroLeft
              (natSucc (denominatorIndex y))))
          (natAddZeroLeft zeroNat)));

\definition fractionMulRespects:
  \forall (x, y, u, v: Fraction) ->
    FractionEq x y -> FractionEq u v ->
    FractionEq (mul x u) (mul y v) :=
  \fun (x, y, u, v: Fraction) =>
  \fun (xy: FractionEq x y) =>
  \fun (uv: FractionEq u v) =>
    integerEqTrans
      (mulInteger
        (numerator (mul x u))
        (denominator (mul y v)))
      (mulInteger
        (mulInteger (numerator x) (numerator u))
        (mulInteger (denominator y) (denominator v)))
      (mulInteger
        (numerator (mul y v))
        (denominator (mul x u)))
      (mulIntegerRespects
        (mulInteger (numerator x) (numerator u))
        (mulInteger (numerator x) (numerator u))
        (denominator (mul y v))
        (mulInteger (denominator y) (denominator v))
        (integerEqRefl
          (mulInteger (numerator x) (numerator u)))
        (denominatorMul y v))
      (integerEqTrans
        (mulInteger
          (mulInteger (numerator x) (numerator u))
          (mulInteger (denominator y) (denominator v)))
        (mulInteger
          (mulInteger (numerator x) (denominator y))
          (mulInteger (numerator u) (denominator v)))
        (mulInteger
          (numerator (mul y v))
          (denominator (mul x u)))
        (mulIntegerInterchange
          (numerator x) (numerator u)
          (denominator y) (denominator v))
        (integerEqTrans
          (mulInteger
            (mulInteger (numerator x) (denominator y))
            (mulInteger (numerator u) (denominator v)))
          (mulInteger
            (mulInteger (numerator y) (denominator x))
            (mulInteger (numerator v) (denominator u)))
          (mulInteger
            (numerator (mul y v))
            (denominator (mul x u)))
          (mulIntegerRespects
            (mulInteger (numerator x) (denominator y))
            (mulInteger (numerator y) (denominator x))
            (mulInteger (numerator u) (denominator v))
            (mulInteger (numerator v) (denominator u))
            xy uv)
          (integerEqTrans
            (mulInteger
              (mulInteger (numerator y) (denominator x))
              (mulInteger (numerator v) (denominator u)))
            (mulInteger
              (mulInteger (numerator y) (numerator v))
              (mulInteger (denominator x) (denominator u)))
            (mulInteger
              (numerator (mul y v))
              (denominator (mul x u)))
            (integerEqSym
              (mulInteger
                (mulInteger (numerator y) (numerator v))
                (mulInteger (denominator x) (denominator u)))
              (mulInteger
                (mulInteger (numerator y) (denominator x))
                (mulInteger (numerator v) (denominator u)))
              (mulIntegerInterchange
                (numerator y) (numerator v)
                (denominator x) (denominator u)))
            (mulIntegerRespects
              (mulInteger (numerator y) (numerator v))
              (mulInteger (numerator y) (numerator v))
              (mulInteger (denominator x) (denominator u))
              (denominator (mul x u))
              (integerEqRefl
                (mulInteger (numerator y) (numerator v)))
              (integerEqSym
                (denominator (mul x u))
                (mulInteger (denominator x) (denominator u))
                (denominatorMul x u))))));

\definition fractionMulZeroRight:
  \forall (x: Fraction) -> FractionEq (mul x zero) zero :=
  \fun (x: Fraction) =>
    fractionEqZeroOfNumerator (mul x zero)
      (mulIntegerZeroRight (numerator x));

\definition fractionMulZeroLeft:
  \forall (x: Fraction) -> FractionEq (mul zero x) zero :=
  \fun (x: Fraction) =>
    fractionEqZeroOfNumerator (mul zero x)
      (mulIntegerZeroLeft (numerator x));

\definition fractionMulOneRight:
  \forall (x: Fraction) -> FractionEq (mul x one) x :=
  \fun (x: Fraction) =>
    fractionEqOfParts
      (numerator (mul x one))
      (numerator x)
      (denominatorIndex (mul x one))
      (denominatorIndex x)
      (mulIntegerOneRight (numerator x))
      (denominatorProductIndexZeroRight
        (denominatorIndex x));

\definition fractionMulOneLeft:
  \forall (x: Fraction) -> FractionEq (mul one x) x :=
  \fun (x: Fraction) =>
    fractionEqOfParts
      (numerator (mul one x))
      (numerator x)
      (denominatorIndex (mul one x))
      (denominatorIndex x)
      (mulIntegerOneLeft (numerator x))
      (denominatorProductIndexZeroLeft
        (denominatorIndex x));

\definition fractionMulComm:
  \forall (x, y: Fraction) -> FractionEq (mul x y) (mul y x) :=
  \fun (x, y: Fraction) =>
    fractionEqOfParts
      (numerator (mul x y))
      (numerator (mul y x))
      (denominatorIndex (mul x y))
      (denominatorIndex (mul y x))
      (mulIntegerComm (numerator x) (numerator y))
      (denominatorProductIndexComm
        (denominatorIndex x) (denominatorIndex y));

\definition fractionMulNegLeft:
  \forall (x, y: Fraction) ->
    FractionEq (mul (neg x) y) (neg (mul x y)) :=
  \fun (x, y: Fraction) =>
    fractionEqOfParts
      (numerator (mul (neg x) y))
      (numerator (neg (mul x y)))
      (denominatorIndex (mul (neg x) y))
      (denominatorIndex (neg (mul x y)))
      (mulIntegerNegLeft (numerator x) (numerator y))
      (\refl(denominatorIndex (mul x y)));

\definition fractionMulNegRight:
  \forall (x, y: Fraction) ->
    FractionEq (mul x (neg y)) (neg (mul x y)) :=
  \fun (x, y: Fraction) =>
    fractionEqOfParts
      (numerator (mul x (neg y)))
      (numerator (neg (mul x y)))
      (denominatorIndex (mul x (neg y)))
      (denominatorIndex (neg (mul x y)))
      (mulIntegerNegRight (numerator x) (numerator y))
      (\refl(denominatorIndex (mul x y)));

/* The quotient is fixed to the proved FractionEq equivalence relation. */
\module Quotient;
