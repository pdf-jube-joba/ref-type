/* Arithmetic on positive-denominator rational representatives. */
\definition add (x, y: Fraction): Fraction :=
    fraction
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

\definition fractionAddZeroRight (x: Fraction): FractionEq (add x zero) x :=
    fractionEqOfParts
      (numerator (add x zero))
      (numerator x)
      (denominatorIndex (add x zero))
      (denominatorIndex x)
      (I.integerEqTrans
        (numerator (add x zero))
        (I.addInteger (numerator x) I.zeroInteger)
        (numerator x)
        (I.addIntegerRespects
          (I.mulInteger (numerator x) (denominator zero))
          (numerator x)
          (I.mulInteger I.zeroInteger (denominator x))
          I.zeroInteger
          (I.mulIntegerOneRight (numerator x))
          (I.mulIntegerZeroLeft (denominator x)))
        (I.addIntegerZeroRight (numerator x)))
      (denominatorProductIndexZeroRight
        (denominatorIndex x));

\definition fractionAddZeroLeft (x: Fraction): FractionEq (add zero x) x :=
    fractionEqOfParts
      (numerator (add zero x))
      (numerator x)
      (denominatorIndex (add zero x))
      (denominatorIndex x)
      (I.integerEqTrans
        (numerator (add zero x))
        (I.addInteger I.zeroInteger (numerator x))
        (numerator x)
        (I.addIntegerRespects
          (I.mulInteger I.zeroInteger (denominator x))
          I.zeroInteger
          (I.mulInteger (numerator x) (denominator zero))
          (numerator x)
          (I.mulIntegerZeroLeft (denominator x))
          (I.mulIntegerOneRight (numerator x)))
        (I.addIntegerZeroLeft (numerator x)))
      (denominatorProductIndexZeroLeft
        (denominatorIndex x));

\definition fractionAddComm (x, y: Fraction): FractionEq (add x y) (add y x) :=
    fractionEqOfParts
      (numerator (add x y))
      (numerator (add y x))
      (denominatorIndex (add x y))
      (denominatorIndex (add y x))
      (I.addIntegerComm
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)))
      (denominatorProductIndexComm
        (denominatorIndex x) (denominatorIndex y));

\definition denominatorAdd (x, y: Fraction):
    I.IntegerEq (denominator (add x y))
      (I.mulInteger (denominator x) (denominator y)) :=
    I.integerEqTrans
      (denominator (add x y))
      (I.integer
        (I.natMul
          (I.natSucc (denominatorIndex x))
          (I.natSucc (denominatorIndex y)))
        I.zeroNat)
      (I.mulInteger (denominator x) (denominator y))
      (I.integerEqOfParts
        (I.natSucc (denominatorProductIndex
          (denominatorIndex x) (denominatorIndex y)))
        I.zeroNat
        (I.natMul
          (I.natSucc (denominatorIndex x))
          (I.natSucc (denominatorIndex y)))
        I.zeroNat
        (denominatorProductIndexSucc
          (denominatorIndex x) (denominatorIndex y))
        (\refl(I.zeroNat)))
      (I.integerEqSym _ _
        (I.integerEqTrans
          (I.mulInteger (denominator x) (denominator y))
          (I.scaleInteger
            (denominator x) (I.natSucc (denominatorIndex y)))
          (I.integer
            (I.natMul
              (I.natSucc (denominatorIndex x))
              (I.natSucc (denominatorIndex y)))
            I.zeroNat)
          (I.mulIntegerNatural
            (denominator x) (I.natSucc (denominatorIndex y)))
          (I.scaleIntegerNatural
            (I.natSucc (denominatorIndex x))
            (I.natSucc (denominatorIndex y)))));

\definition addFirstCrossTerm (x, y, u, v: Fraction)
  (xy: FractionEq x y):
  I.IntegerEq
    (I.mulInteger
      (I.mulInteger (numerator x) (denominator u))
      (I.mulInteger (denominator y) (denominator v)))
    (I.mulInteger
      (I.mulInteger (numerator y) (denominator v))
      (I.mulInteger (denominator x) (denominator u))) :=
  I.integerEqTrans _ _ _
    (I.mulIntegerInterchange (numerator x) (denominator u)
      (denominator y) (denominator v))
    (I.integerEqTrans _ _ _
      (I.mulIntegerRespects
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (denominator u) (denominator v))
        (I.mulInteger (denominator u) (denominator v))
        xy (I.integerEqRefl _))
      (I.integerEqTrans _ _ _
        (I.mulIntegerRespects
          (I.mulInteger (numerator y) (denominator x))
          (I.mulInteger (numerator y) (denominator x))
          (I.mulInteger (denominator u) (denominator v))
          (I.mulInteger (denominator v) (denominator u))
          (I.integerEqRefl _)
          (I.mulIntegerComm (denominator u) (denominator v)))
        (I.integerEqSym _ _
          (I.mulIntegerInterchange (numerator y) (denominator v)
            (denominator x) (denominator u)))));

\definition addSecondCrossTerm (x, y, u, v: Fraction)
  (uv: FractionEq u v):
  I.IntegerEq
    (I.mulInteger
      (I.mulInteger (numerator u) (denominator x))
      (I.mulInteger (denominator y) (denominator v)))
    (I.mulInteger
      (I.mulInteger (numerator v) (denominator y))
      (I.mulInteger (denominator x) (denominator u))) :=
  I.integerEqTrans _ _ _
    (I.mulIntegerRespects
      (I.mulInteger (numerator u) (denominator x))
      (I.mulInteger (numerator u) (denominator x))
      (I.mulInteger (denominator y) (denominator v))
      (I.mulInteger (denominator v) (denominator y))
      (I.integerEqRefl _)
      (I.mulIntegerComm (denominator y) (denominator v)))
    (I.integerEqTrans _ _ _
      (I.mulIntegerInterchange (numerator u) (denominator x)
        (denominator v) (denominator y))
      (I.integerEqTrans _ _ _
        (I.mulIntegerRespects
          (I.mulInteger (numerator u) (denominator v))
          (I.mulInteger (numerator v) (denominator u))
          (I.mulInteger (denominator x) (denominator y))
          (I.mulInteger (denominator x) (denominator y))
          uv (I.integerEqRefl _))
        (I.integerEqTrans _ _ _
          (I.mulIntegerRespects
            (I.mulInteger (numerator v) (denominator u))
            (I.mulInteger (numerator v) (denominator u))
            (I.mulInteger (denominator x) (denominator y))
            (I.mulInteger (denominator y) (denominator x))
            (I.integerEqRefl _)
            (I.mulIntegerComm (denominator x) (denominator y)))
          (I.integerEqTrans _ _ _
            (I.integerEqSym _ _
              (I.mulIntegerInterchange (numerator v) (denominator y)
                (denominator u) (denominator x)))
            (I.mulIntegerRespects
              (I.mulInteger (numerator v) (denominator y))
              (I.mulInteger (numerator v) (denominator y))
              (I.mulInteger (denominator u) (denominator x))
              (I.mulInteger (denominator x) (denominator u))
              (I.integerEqRefl _)
              (I.mulIntegerComm (denominator u) (denominator x)))))));

\definition fractionAddRespects (x, y, u, v: Fraction)
  (xy: FractionEq x y) (uv: FractionEq u v):
  FractionEq (add x u) (add y v) :=
  I.integerEqTrans _ _ _
    (I.mulIntegerRespects
      (numerator (add x u)) (numerator (add x u))
      (denominator (add y v))
      (I.mulInteger (denominator y) (denominator v))
      (I.integerEqRefl _) (denominatorAdd y v))
    (I.integerEqTrans _ _ _
      (I.mulIntegerDistribRight
        (I.mulInteger (numerator x) (denominator u))
        (I.mulInteger (numerator u) (denominator x))
        (I.mulInteger (denominator y) (denominator v)))
      (I.integerEqTrans _ _ _
        (I.addIntegerRespects _ _ _ _
          (addFirstCrossTerm x y u v xy)
          (addSecondCrossTerm x y u v uv))
        (I.integerEqTrans _ _ _
          (I.integerEqSym _ _
            (I.mulIntegerDistribRight
              (I.mulInteger (numerator y) (denominator v))
              (I.mulInteger (numerator v) (denominator y))
              (I.mulInteger (denominator x) (denominator u))))
          (I.mulIntegerRespects
            (numerator (add y v)) (numerator (add y v))
            (I.mulInteger (denominator x) (denominator u))
            (denominator (add x u))
            (I.integerEqRefl _)
            (I.integerEqSym _ _ (denominatorAdd x u))))));

\definition fractionEqOfNumeratorDenominator (x, y: Fraction)
  (num: I.IntegerEq (numerator x) (numerator y))
  (den: I.IntegerEq (denominator x) (denominator y)):
  FractionEq x y :=
  I.mulIntegerRespects _ _ _ _ num (I.integerEqSym _ _ den);

\definition mulIntegerSwapRight (a, b, c: I.Integer):
  I.IntegerEq (I.mulInteger (I.mulInteger a b) c)
    (I.mulInteger (I.mulInteger a c) b) :=
  I.integerEqTrans _ _ _ (I.mulIntegerAssoc a b c)
    (I.integerEqTrans _ _ _
      (I.mulIntegerRespects a a (I.mulInteger b c) (I.mulInteger c b)
        (I.integerEqRefl a) (I.mulIntegerComm b c))
      (I.integerEqSym _ _ (I.mulIntegerAssoc a c b)));

\definition mulIntegerFourSwap (a, b, c, d: I.Integer):
  I.IntegerEq
    (I.mulInteger (I.mulInteger a b) (I.mulInteger c d))
    (I.mulInteger (I.mulInteger a d) (I.mulInteger b c)) :=
  I.integerEqTrans _ _ _
    (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
      (I.mulIntegerComm c d))
    (I.mulIntegerInterchange a b d c);

\definition addAssocNumerator (x, y, z: Fraction):
  I.IntegerEq (numerator (add (add x y) z))
    (numerator (add x (add y z))) :=
  I.integerEqTrans _ _ _
    (I.addIntegerRespects _ _ _ _
      (I.mulIntegerDistribRight
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x))
        (denominator z))
      (I.mulIntegerRespects
        (numerator z) (numerator z)
        (denominator (add x y))
        (I.mulInteger (denominator x) (denominator y))
        (I.integerEqRefl _)
        (denominatorAdd x y)))
    (I.integerEqTrans _ _ _
      (I.addIntegerRespects _ _ _ _
        (I.addIntegerRespects _ _ _ _
          (I.mulIntegerAssoc (numerator x) (denominator y) (denominator z))
          (mulIntegerSwapRight (numerator y) (denominator x) (denominator z)))
        (I.integerEqTrans _ _ _
          (I.mulIntegerRespects (numerator z) (numerator z)
            (I.mulInteger (denominator x) (denominator y))
            (I.mulInteger (denominator y) (denominator x))
            (I.integerEqRefl _)
            (I.mulIntegerComm (denominator x) (denominator y)))
          (I.integerEqSym _ _
            (I.mulIntegerAssoc (numerator z) (denominator y) (denominator x)))))
      (I.integerEqTrans _ _ _
        (I.addIntegerAssoc
          (I.mulInteger (numerator x)
            (I.mulInteger (denominator y) (denominator z)))
          (I.mulInteger (I.mulInteger (numerator y) (denominator z))
            (denominator x))
          (I.mulInteger (I.mulInteger (numerator z) (denominator y))
            (denominator x)))
        (I.integerEqTrans _ _ _
          (I.addIntegerRespects _ _ _ _ (I.integerEqRefl _)
            (I.integerEqSym _ _
              (I.mulIntegerDistribRight
                (I.mulInteger (numerator y) (denominator z))
                (I.mulInteger (numerator z) (denominator y))
                (denominator x))))
          (I.addIntegerRespects _ _ _ _
            (I.mulIntegerRespects
              (numerator x) (numerator x)
              (I.mulInteger (denominator y) (denominator z))
              (denominator (add y z))
              (I.integerEqRefl _)
              (I.integerEqSym _ _ (denominatorAdd y z)))
            (I.integerEqRefl _)))));

\definition addAssocDenominator (x, y, z: Fraction):
  I.IntegerEq (denominator (add (add x y) z))
    (denominator (add x (add y z))) :=
  I.integerEqTrans _ _ _ (denominatorAdd (add x y) z)
    (I.integerEqTrans _ _ _
      (I.mulIntegerRespects _ _ _ _ (denominatorAdd x y)
        (I.integerEqRefl (denominator z)))
      (I.integerEqTrans _ _ _
        (I.mulIntegerAssoc (denominator x) (denominator y) (denominator z))
        (I.integerEqTrans _ _ _
          (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl (denominator x))
            (I.integerEqSym _ _ (denominatorAdd y z)))
          (I.integerEqSym _ _ (denominatorAdd x (add y z))))));

\definition fractionAddAssoc (x, y, z: Fraction):
  FractionEq (add (add x y) z) (add x (add y z)) :=
  fractionEqOfNumeratorDenominator _ _
    (addAssocNumerator x y z) (addAssocDenominator x y z);

\definition neg (x: Fraction): Fraction :=
    fraction (I.negInteger (numerator x)) (denominatorIndex x);

\definition numeratorNonZeroNeg (x: Fraction) (nonzero: NumeratorNonZero x): NumeratorNonZero (neg x) :=
    I.integerNonZeroNeg (numerator x) nonzero;

\definition fractionNegRespects (x, y: Fraction) (xy: FractionEq x y): FractionEq (neg x) (neg y) :=
    I.integerEqTrans
      (I.mulInteger (I.negInteger (numerator x)) (denominator y))
      (I.negInteger (I.mulInteger (numerator x) (denominator y)))
      (I.mulInteger (I.negInteger (numerator y)) (denominator x))
      (I.mulIntegerNegLeft (numerator x) (denominator y))
      (I.integerEqTrans
        (I.negInteger (I.mulInteger (numerator x) (denominator y)))
        (I.negInteger (I.mulInteger (numerator y) (denominator x)))
        (I.mulInteger (I.negInteger (numerator y)) (denominator x))
        (I.negIntegerRespects
          (I.mulInteger (numerator x) (denominator y))
          (I.mulInteger (numerator y) (denominator x)) xy)
        (I.integerEqSym
          (I.mulInteger (I.negInteger (numerator y)) (denominator x))
          (I.negInteger (I.mulInteger (numerator y) (denominator x)))
          (I.mulIntegerNegLeft (numerator y) (denominator x))));

\definition fractionNegInvolutive (x: Fraction): FractionEq (neg (neg x)) x :=
    fractionEqOfParts
      (numerator (neg (neg x))) (numerator x)
      (denominatorIndex (neg (neg x))) (denominatorIndex x)
      (I.negIntegerInvolutive (numerator x))
      (\refl(denominatorIndex x));

\definition fractionNegZero: neg zero = zero :=
  \refl(zero);

\definition fractionAddNegRight (x: Fraction): FractionEq (add x (neg x)) zero :=
    fractionEqZeroOfNumerator (add x (neg x))
      (I.integerEqTrans
        (numerator (add x (neg x)))
        (I.addInteger
          (I.mulInteger (numerator x) (denominator x))
          (I.negInteger
            (I.mulInteger (numerator x) (denominator x))))
        I.zeroInteger
        (I.addIntegerRespects
          (I.mulInteger (numerator x) (denominator (neg x)))
          (I.mulInteger (numerator x) (denominator x))
          (I.mulInteger (I.negInteger (numerator x)) (denominator x))
          (I.negInteger
            (I.mulInteger (numerator x) (denominator x)))
          (I.integerEqRefl
            (I.mulInteger (numerator x) (denominator x)))
          (I.mulIntegerNegLeft
            (numerator x) (denominator x)))
        (I.addIntegerNegRight
          (I.mulInteger (numerator x) (denominator x))));

\definition fractionAddNegLeft (x: Fraction): FractionEq (add (neg x) x) zero :=
    fractionEqZeroOfNumerator (add (neg x) x)
      (I.integerEqTrans
        (numerator (add (neg x) x))
        (I.addInteger
          (I.negInteger
            (I.mulInteger (numerator x) (denominator x)))
          (I.mulInteger (numerator x) (denominator x)))
        I.zeroInteger
        (I.addIntegerRespects
          (I.mulInteger (I.negInteger (numerator x)) (denominator x))
          (I.negInteger
            (I.mulInteger (numerator x) (denominator x)))
          (I.mulInteger (numerator x) (denominator (neg x)))
          (I.mulInteger (numerator x) (denominator x))
          (I.mulIntegerNegLeft
            (numerator x) (denominator x))
          (I.integerEqRefl
            (I.mulInteger (numerator x) (denominator x))))
        (I.addIntegerNegLeft
          (I.mulInteger (numerator x) (denominator x))));

\definition sub (x, y: Fraction): Fraction := add x (neg y);

\definition fractionSubZeroRight (x: Fraction): FractionEq (sub x zero) x := fractionAddZeroRight x;

\definition fractionSubSelf (x: Fraction): FractionEq (sub x x) zero := fractionAddNegRight x;

\definition mul (x, y: Fraction): Fraction :=
    fraction
      (I.mulInteger (numerator x) (numerator y))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

\definition denominatorMul (x, y: Fraction):
    I.IntegerEq
      (denominator (mul x y))
      (I.mulInteger (denominator x) (denominator y)) :=
    I.integerEqTrans
      (denominator (mul x y))
      (I.integer
        (I.natMul
          (I.natSucc (denominatorIndex x))
          (I.natSucc (denominatorIndex y)))
        I.zeroNat)
      (I.mulInteger (denominator x) (denominator y))
      (I.integerEqOfParts
        (I.natSucc (denominatorProductIndex
          (denominatorIndex x) (denominatorIndex y)))
        I.zeroNat
        (I.natMul
          (I.natSucc (denominatorIndex x))
          (I.natSucc (denominatorIndex y)))
        I.zeroNat
        (denominatorProductIndexSucc
          (denominatorIndex x) (denominatorIndex y))
        (\refl(I.zeroNat)))
      (I.integerEqSym _ _
        (I.integerEqTrans
          (I.mulInteger (denominator x) (denominator y))
          (I.scaleInteger
            (denominator x) (I.natSucc (denominatorIndex y)))
          (I.integer
            (I.natMul
              (I.natSucc (denominatorIndex x))
              (I.natSucc (denominatorIndex y)))
            I.zeroNat)
          (I.mulIntegerNatural
            (denominator x) (I.natSucc (denominatorIndex y)))
          (I.scaleIntegerNatural
            (I.natSucc (denominatorIndex x))
            (I.natSucc (denominatorIndex y)))));

\definition fractionMulRespects (x, y, u, v: Fraction) (xy: FractionEq x y) (uv: FractionEq u v):
    FractionEq (mul x u) (mul y v) :=
    I.integerEqTrans
      (I.mulInteger
        (numerator (mul x u))
        (denominator (mul y v)))
      (I.mulInteger
        (I.mulInteger (numerator x) (numerator u))
        (I.mulInteger (denominator y) (denominator v)))
      (I.mulInteger
        (numerator (mul y v))
        (denominator (mul x u)))
      (I.mulIntegerRespects
        (I.mulInteger (numerator x) (numerator u))
        (I.mulInteger (numerator x) (numerator u))
        (denominator (mul y v))
        (I.mulInteger (denominator y) (denominator v))
        (I.integerEqRefl
          (I.mulInteger (numerator x) (numerator u)))
        (denominatorMul y v))
      (I.integerEqTrans
        (I.mulInteger
          (I.mulInteger (numerator x) (numerator u))
          (I.mulInteger (denominator y) (denominator v)))
        (I.mulInteger
          (I.mulInteger (numerator x) (denominator y))
          (I.mulInteger (numerator u) (denominator v)))
        (I.mulInteger
          (numerator (mul y v))
          (denominator (mul x u)))
        (I.mulIntegerInterchange
          (numerator x) (numerator u)
          (denominator y) (denominator v))
        (I.integerEqTrans
          (I.mulInteger
            (I.mulInteger (numerator x) (denominator y))
            (I.mulInteger (numerator u) (denominator v)))
          (I.mulInteger
            (I.mulInteger (numerator y) (denominator x))
            (I.mulInteger (numerator v) (denominator u)))
          (I.mulInteger
            (numerator (mul y v))
            (denominator (mul x u)))
          (I.mulIntegerRespects
            (I.mulInteger (numerator x) (denominator y))
            (I.mulInteger (numerator y) (denominator x))
            (I.mulInteger (numerator u) (denominator v))
            (I.mulInteger (numerator v) (denominator u))
            xy uv)
          (I.integerEqTrans
            (I.mulInteger
              (I.mulInteger (numerator y) (denominator x))
              (I.mulInteger (numerator v) (denominator u)))
            (I.mulInteger
              (I.mulInteger (numerator y) (numerator v))
              (I.mulInteger (denominator x) (denominator u)))
            (I.mulInteger
              (numerator (mul y v))
              (denominator (mul x u)))
            (I.integerEqSym
              (I.mulInteger
                (I.mulInteger (numerator y) (numerator v))
                (I.mulInteger (denominator x) (denominator u)))
              (I.mulInteger
                (I.mulInteger (numerator y) (denominator x))
                (I.mulInteger (numerator v) (denominator u)))
              (I.mulIntegerInterchange
                (numerator y) (numerator v)
                (denominator x) (denominator u)))
            (I.mulIntegerRespects
              (I.mulInteger (numerator y) (numerator v))
              (I.mulInteger (numerator y) (numerator v))
              (I.mulInteger (denominator x) (denominator u))
              (denominator (mul x u))
              (I.integerEqRefl
                (I.mulInteger (numerator y) (numerator v)))
              (I.integerEqSym
                (denominator (mul x u))
                (I.mulInteger (denominator x) (denominator u))
                (denominatorMul x u))))));

\definition fractionMulZeroRight (x: Fraction): FractionEq (mul x zero) zero :=
    fractionEqZeroOfNumerator (mul x zero)
      (I.mulIntegerZeroRight (numerator x));

\definition fractionMulZeroLeft (x: Fraction): FractionEq (mul zero x) zero :=
    fractionEqZeroOfNumerator (mul zero x)
      (I.mulIntegerZeroLeft (numerator x));

\definition fractionMulOneRight (x: Fraction): FractionEq (mul x one) x :=
    fractionEqOfParts
      (numerator (mul x one))
      (numerator x)
      (denominatorIndex (mul x one))
      (denominatorIndex x)
      (I.mulIntegerOneRight (numerator x))
      (denominatorProductIndexZeroRight
        (denominatorIndex x));

\definition fractionMulOneLeft (x: Fraction): FractionEq (mul one x) x :=
    fractionEqOfParts
      (numerator (mul one x))
      (numerator x)
      (denominatorIndex (mul one x))
      (denominatorIndex x)
      (I.mulIntegerOneLeft (numerator x))
      (denominatorProductIndexZeroLeft
        (denominatorIndex x));

\definition fractionMulComm (x, y: Fraction): FractionEq (mul x y) (mul y x) :=
    fractionEqOfParts
      (numerator (mul x y))
      (numerator (mul y x))
      (denominatorIndex (mul x y))
      (denominatorIndex (mul y x))
      (I.mulIntegerComm (numerator x) (numerator y))
      (denominatorProductIndexComm
        (denominatorIndex x) (denominatorIndex y));

\definition mulAssocDenominator (x, y, z: Fraction):
    I.IntegerEq (denominator (mul (mul x y) z))
      (denominator (mul x (mul y z))) :=
  I.integerEqTrans _ _ _ (denominatorMul (mul x y) z)
    (I.integerEqTrans _ _ _
      (I.mulIntegerRespects _ _ _ _ (denominatorMul x y)
        (I.integerEqRefl (denominator z)))
      (I.integerEqTrans _ _ _
        (I.mulIntegerAssoc (denominator x) (denominator y) (denominator z))
        (I.integerEqTrans _ _ _
          (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl (denominator x))
            (I.integerEqSym _ _ (denominatorMul y z)))
          (I.integerEqSym _ _ (denominatorMul x (mul y z))))));

\definition fractionMulAssoc (x, y, z: Fraction):
    FractionEq (mul (mul x y) z) (mul x (mul y z)) :=
  fractionEqOfNumeratorDenominator (mul (mul x y) z) (mul x (mul y z))
    (I.mulIntegerAssoc (numerator x) (numerator y) (numerator z))
    (mulAssocDenominator x y z);

\definition fractionMulNegLeft (x, y: Fraction):
    FractionEq (mul (neg x) y) (neg (mul x y)) :=
    fractionEqOfParts
      (numerator (mul (neg x) y))
      (numerator (neg (mul x y)))
      (denominatorIndex (mul (neg x) y))
      (denominatorIndex (neg (mul x y)))
      (I.mulIntegerNegLeft (numerator x) (numerator y))
      (\refl(denominatorIndex (mul x y)));

\definition fractionMulNegRight (x, y: Fraction):
    FractionEq (mul x (neg y)) (neg (mul x y)) :=
    fractionEqOfParts
      (numerator (mul x (neg y)))
      (numerator (neg (mul x y)))
      (denominatorIndex (mul x (neg y)))
      (denominatorIndex (neg (mul x y)))
      (I.mulIntegerNegRight (numerator x) (numerator y))
      (\refl(denominatorIndex (mul x y)));

\import I.Order() \as IntegerOrder;
\import \parent.Order() \as FractionOrder;

\definition ltNegReverse (x, y: Fraction) (xy: lt x y):
  lt (neg y) (neg x) :=
  IntegerOrder.ltRespects
    (I.negInteger (I.mulInteger (numerator y) (denominator x)))
    (I.mulInteger (I.negInteger (numerator y)) (denominator x))
    (I.negInteger (I.mulInteger (numerator x) (denominator y)))
    (I.mulInteger (I.negInteger (numerator x)) (denominator y))
    (I.integerEqSym _ _
      (I.mulIntegerNegLeft (numerator y) (denominator x)))
    (I.integerEqSym _ _
      (I.mulIntegerNegLeft (numerator x) (denominator y)))
    (IntegerOrder.ltNegReverse
      (I.mulInteger (numerator x) (denominator y))
      (I.mulInteger (numerator y) (denominator x)) xy);

\definition ltOfNegLtNeg (x, y: Fraction)
  (xy: lt (neg x) (neg y)): lt y x :=
  FractionOrder.ltRespects
    (neg (neg y)) y (neg (neg x)) x
    (fractionNegInvolutive y) (fractionNegInvolutive x)
    (ltNegReverse (neg x) (neg y) xy);

\definition below (x: Fraction): Fraction :=
  fraction (I.addInteger (numerator x) (I.negInteger I.oneInteger))
    (denominatorIndex x);

\definition belowLt (x: Fraction): lt (below x) x :=
  FractionOrder.ltMulDenominator
    (I.addInteger (numerator x) (I.negInteger I.oneInteger))
    (numerator x) (denominatorIndex x)
    (IntegerOrder.ltPredecessor (numerator x));

\definition above (x: Fraction): Fraction :=
  fraction (I.addInteger (numerator x) I.oneInteger)
    (denominatorIndex x);

\definition ltAbove (x: Fraction): lt x (above x) :=
  FractionOrder.ltMulDenominator
    (numerator x) (I.addInteger (numerator x) I.oneInteger)
    (denominatorIndex x)
    (IntegerOrder.ltSuccessor (numerator x));

\definition commonDenominatorNat (x, y: Fraction): I.Nat :=
  I.natMul (I.natSucc (denominatorIndex x))
    (I.natSucc (denominatorIndex y));

\definition commonDenominatorIndex (x, y: Fraction): I.Nat :=
  denominatorProductIndex (denominatorIndex x) (denominatorIndex y);

\definition midpointDenominatorIndex (x, y: Fraction): I.Nat :=
  I.natAdd (commonDenominatorIndex x y)
    (I.natSucc (commonDenominatorIndex x y));

\definition midpoint (x, y: Fraction): Fraction :=
  fraction
    (I.addInteger
      (I.mulInteger (numerator x) (denominator y))
      (I.mulInteger (numerator y) (denominator x)))
    (midpointDenominatorIndex x y);

\definition commonDenominatorIndexSucc (x, y: Fraction):
  I.natSucc (commonDenominatorIndex x y) = commonDenominatorNat x y :=
  denominatorProductIndexSucc (denominatorIndex x) (denominatorIndex y);

\definition midpointDenominatorNat (x, y: Fraction):
  I.natSucc (midpointDenominatorIndex x y) =
    I.natAdd (commonDenominatorNat x y) (commonDenominatorNat x y) :=
  trans!{I.Nat} _ _ _
    (sym!{I.Nat} _ _
      (NL.addSuccLeft (commonDenominatorIndex x y)
        (I.natSucc (commonDenominatorIndex x y))))
    (congr2!{I.Nat I.Nat I.Nat} I.natAdd
      (I.natSucc (commonDenominatorIndex x y))
      (commonDenominatorNat x y)
      (I.natSucc (commonDenominatorIndex x y))
      (commonDenominatorNat x y)
      (commonDenominatorIndexSucc x y)
      (commonDenominatorIndexSucc x y));

\definition productDenominatorNatural (x, y: Fraction):
  I.IntegerEq
    (I.mulInteger (denominator x) (denominator y))
    (I.integer (commonDenominatorNat x y) I.zeroNat) :=
  I.integerEqTrans _ _ _
    (I.mulIntegerNatural
      (denominator x) (I.natSucc (denominatorIndex y)))
    (I.scaleIntegerNatural
      (I.natSucc (denominatorIndex x))
      (I.natSucc (denominatorIndex y)));

\definition midpointDenominator (x, y: Fraction):
  I.IntegerEq (denominator (midpoint x y))
    (I.addInteger
      (I.mulInteger (denominator x) (denominator y))
      (I.mulInteger (denominator x) (denominator y))) :=
  I.integerEqTrans _ _ _
    (I.integerEqOfParts
      (I.natSucc (midpointDenominatorIndex x y)) I.zeroNat
      (I.natAdd (commonDenominatorNat x y) (commonDenominatorNat x y))
      I.zeroNat (midpointDenominatorNat x y) (\refl(I.zeroNat)))
    (I.integerEqTrans _ _ _
      (I.integerEqSym _ _
        (I.addIntegerNatural
          (commonDenominatorNat x y) (commonDenominatorNat x y)))
      (I.addIntegerRespects _ _ _ _
        (I.integerEqSym _ _ (productDenominatorNatural x y))
        (I.integerEqSym _ _ (productDenominatorNatural x y))));

\definition midpointLeftTerm (x, y: Fraction):
  I.IntegerEq
    (I.mulInteger (numerator x)
      (I.mulInteger (denominator x) (denominator y)))
    (I.mulInteger
      (I.mulInteger (numerator x) (denominator y))
      (denominator x)) :=
  I.integerEqTrans
    (I.mulInteger (numerator x)
      (I.mulInteger (denominator x) (denominator y)))
    (I.mulInteger (numerator x)
      (I.mulInteger (denominator y) (denominator x)))
    (I.mulInteger
      (I.mulInteger (numerator x) (denominator y))
      (denominator x))
    (I.mulIntegerRespects
      (numerator x) (numerator x)
      (I.mulInteger (denominator x) (denominator y))
      (I.mulInteger (denominator y) (denominator x))
      (I.integerEqRefl _) (I.mulIntegerComm (denominator x) (denominator y)))
    (I.integerEqSym _ _
      (I.mulIntegerAssoc (numerator x) (denominator y) (denominator x)));

\definition midpointLeftAlignment (x, y: Fraction):
  I.IntegerEq
    (I.mulInteger (numerator x) (denominator (midpoint x y)))
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator x) (denominator y)))
      (denominator x)) :=
  I.integerEqTrans
    (I.mulInteger (numerator x) (denominator (midpoint x y)))
    (I.mulInteger (numerator x)
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y))))
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator x) (denominator y)))
      (denominator x))
    (I.mulIntegerRespects
      (numerator x) (numerator x)
      (denominator (midpoint x y))
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)))
      (I.integerEqRefl _) (midpointDenominator x y))
    (I.integerEqTrans _ _ _
      (I.mulIntegerDistribLeft (numerator x)
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)))
      (I.integerEqTrans _ _ _
        (I.addIntegerRespects _ _ _ _
          (midpointLeftTerm x y) (midpointLeftTerm x y))
        (I.integerEqSym _ _
          (I.mulIntegerDistribRight
            (I.mulInteger (numerator x) (denominator y))
            (I.mulInteger (numerator x) (denominator y))
            (denominator x)))));

\definition midpointRightAlignment (x, y: Fraction):
  I.IntegerEq
    (I.mulInteger (numerator y) (denominator (midpoint x y)))
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (numerator y) (denominator x)))
      (denominator y)) :=
  I.integerEqTrans
    (I.mulInteger (numerator y) (denominator (midpoint x y)))
    (I.mulInteger (numerator y)
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y))))
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (numerator y) (denominator x)))
      (denominator y))
    (I.mulIntegerRespects
      (numerator y) (numerator y)
      (denominator (midpoint x y))
      (I.addInteger
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)))
      (I.integerEqRefl _) (midpointDenominator x y))
    (I.integerEqTrans _ _ _
      (I.mulIntegerDistribLeft (numerator y)
        (I.mulInteger (denominator x) (denominator y))
        (I.mulInteger (denominator x) (denominator y)))
      (I.integerEqTrans _ _ _
        (I.addIntegerRespects _ _ _ _
          (I.integerEqSym _ _
            (I.mulIntegerAssoc (numerator y) (denominator x) (denominator y)))
          (I.integerEqSym _ _
            (I.mulIntegerAssoc (numerator y) (denominator x) (denominator y))))
        (I.integerEqSym _ _
          (I.mulIntegerDistribRight
            (I.mulInteger (numerator y) (denominator x))
            (I.mulInteger (numerator y) (denominator x))
            (denominator y)))));

\definition ltMidpoint (x, y: Fraction) (xy: lt x y):
  lt x (midpoint x y) :=
  IntegerOrder.ltRespects
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator x) (denominator y)))
      (denominator x))
    (I.mulInteger (numerator x) (denominator (midpoint x y)))
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)))
      (denominator x))
    (I.mulInteger (numerator (midpoint x y)) (denominator x))
    (I.integerEqSym _ _ (midpointLeftAlignment x y))
    (I.integerEqRefl _)
    (FractionOrder.ltMulDenominator
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator x) (denominator y)))
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)))
      (denominatorIndex x)
      (IntegerOrder.ltAddLeft
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)) xy));

\definition midpointLt (x, y: Fraction) (xy: lt x y):
  lt (midpoint x y) y :=
  IntegerOrder.ltRespects
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)))
      (denominator y))
    (I.mulInteger (numerator (midpoint x y)) (denominator y))
    (I.mulInteger
      (I.addInteger
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (numerator y) (denominator x)))
      (denominator y))
    (I.mulInteger (numerator y) (denominator (midpoint x y)))
    (I.integerEqRefl _)
    (I.integerEqSym _ _ (midpointRightAlignment x y))
    (FractionOrder.ltMulDenominator
      (I.addInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x)))
      (I.addInteger
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (numerator y) (denominator x)))
      (denominatorIndex y)
      (IntegerOrder.ltAddRight
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (numerator y) (denominator x)) xy));

\definition ltScaleByTwoDenominators (x, y, u, v: Fraction)
  (xy: lt x y):
  I.IntegerLt
    (I.mulInteger
      (I.mulInteger (numerator x) (denominator y))
      (I.mulInteger (denominator u) (denominator v)))
    (I.mulInteger
      (I.mulInteger (numerator y) (denominator x))
      (I.mulInteger (denominator u) (denominator v))) :=
  IntegerOrder.ltRespects
    (I.mulInteger
      (I.mulInteger
        (I.mulInteger (numerator x) (denominator y))
        (denominator u)) (denominator v))
    (I.mulInteger
      (I.mulInteger (numerator x) (denominator y))
      (I.mulInteger (denominator u) (denominator v)))
    (I.mulInteger
      (I.mulInteger
        (I.mulInteger (numerator y) (denominator x))
        (denominator u)) (denominator v))
    (I.mulInteger
      (I.mulInteger (numerator y) (denominator x))
      (I.mulInteger (denominator u) (denominator v)))
    (I.mulIntegerAssoc
      (I.mulInteger (numerator x) (denominator y))
      (denominator u) (denominator v))
    (I.mulIntegerAssoc
      (I.mulInteger (numerator y) (denominator x))
      (denominator u) (denominator v))
    (FractionOrder.ltMulDenominator
      (I.mulInteger
        (I.mulInteger (numerator x) (denominator y))
        (denominator u))
      (I.mulInteger
        (I.mulInteger (numerator y) (denominator x))
        (denominator u))
      (denominatorIndex v)
      (FractionOrder.ltMulDenominator
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x))
        (denominatorIndex u) xy));

\definition addOrderLeftAlignment (x, u, y, v: Fraction):
  I.IntegerEq
    (I.mulInteger (numerator (add x u)) (denominator (add y v)))
    (I.addInteger
      (I.mulInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (denominator u) (denominator v)))
      (I.mulInteger
        (I.mulInteger (numerator u) (denominator v))
        (I.mulInteger (denominator x) (denominator y)))) :=
  I.integerEqTrans _ _ _
    (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
      (denominatorAdd y v))
    (I.integerEqTrans _ _ _
      (I.mulIntegerDistribRight
        (I.mulInteger (numerator x) (denominator u))
        (I.mulInteger (numerator u) (denominator x))
        (I.mulInteger (denominator y) (denominator v)))
      (I.addIntegerRespects _ _ _ _
        (I.mulIntegerInterchange
          (numerator x) (denominator u)
          (denominator y) (denominator v))
        (mulIntegerFourSwap
          (numerator u) (denominator x)
          (denominator y) (denominator v))));

\definition ltAdd (x, y, u, v: Fraction)
  (xy: lt x y) (uv: lt u v): lt (add x u) (add y v) :=
  IntegerOrder.ltRespects
    (I.addInteger
      (I.mulInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (denominator u) (denominator v)))
      (I.mulInteger
        (I.mulInteger (numerator u) (denominator v))
        (I.mulInteger (denominator x) (denominator y))))
    (I.mulInteger (numerator (add x u)) (denominator (add y v)))
    (I.addInteger
      (I.mulInteger
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (denominator u) (denominator v)))
      (I.mulInteger
        (I.mulInteger (numerator v) (denominator u))
        (I.mulInteger (denominator x) (denominator y))))
    (I.mulInteger (numerator (add y v)) (denominator (add x u)))
    (I.integerEqSym _ _ (addOrderLeftAlignment x u y v))
    (I.integerEqTrans _ _ _
      (I.addIntegerRespects _ _ _ _
        (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
          (I.mulIntegerComm (denominator u) (denominator v)))
        (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
          (I.mulIntegerComm (denominator x) (denominator y))))
      (I.integerEqSym _ _ (addOrderLeftAlignment y v x u)))
    (IntegerOrder.ltAdd _ _ _ _
      (ltScaleByTwoDenominators x y u v xy)
      (ltScaleByTwoDenominators u v x y uv));

\definition ltAddRight (x, y, z: Fraction) (xy: lt x y):
  lt (add x z) (add y z) :=
  IntegerOrder.ltRespects
    (I.addInteger
      (I.mulInteger
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (denominator z) (denominator z)))
      (I.mulInteger
        (I.mulInteger (numerator z) (denominator z))
        (I.mulInteger (denominator x) (denominator y))))
    (I.mulInteger (numerator (add x z)) (denominator (add y z)))
    (I.addInteger
      (I.mulInteger
        (I.mulInteger (numerator y) (denominator x))
        (I.mulInteger (denominator z) (denominator z)))
      (I.mulInteger
        (I.mulInteger (numerator z) (denominator z))
        (I.mulInteger (denominator x) (denominator y))))
    (I.mulInteger (numerator (add y z)) (denominator (add x z)))
    (I.integerEqSym _ _ (addOrderLeftAlignment x z y z))
    (I.integerEqTrans _ _ _
      (I.addIntegerRespects _ _ _ _
        (I.integerEqRefl _)
        (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
          (I.mulIntegerComm (denominator x) (denominator y))))
      (I.integerEqSym _ _ (addOrderLeftAlignment y z x z)))
    (IntegerOrder.ltAddRight _ _ _
      (ltScaleByTwoDenominators x y z z xy));

\definition ltAddLeft (z, x, y: Fraction) (xy: lt x y):
  lt (add z x) (add z y) :=
  FractionOrder.ltRespects
    (add x z) (add z x) (add y z) (add z y)
    (fractionAddComm x z) (fractionAddComm y z)
    (ltAddRight x y z xy);

\definition adjustment (q, a: Fraction): Fraction :=
  add q (neg (midpoint q a));

\definition adjustmentLtZero (q, a: Fraction) (qa: lt q a):
  lt (adjustment q a) zero :=
  FractionOrder.ltReplaceRight
    (adjustment q a)
    (add (midpoint q a) (neg (midpoint q a))) zero
    (fractionAddNegRight (midpoint q a))
    (ltAddRight q (midpoint q a) (neg (midpoint q a))
      (ltMidpoint q a qa));

\definition addAdjustmentEq (q, a: Fraction):
  FractionEq (add (midpoint q a) (adjustment q a)) q :=
  fractionEqTrans _ _ _
    (fractionEqSym _ _
      (fractionAddAssoc (midpoint q a) q (neg (midpoint q a))))
    (fractionEqTrans _ _ _
      (fractionAddRespects
        (add (midpoint q a) q) (add q (midpoint q a))
        (neg (midpoint q a)) (neg (midpoint q a))
        (fractionAddComm (midpoint q a) q) (fractionEqRefl _))
      (fractionEqTrans _ _ _
        (fractionAddAssoc q (midpoint q a) (neg (midpoint q a)))
        (fractionEqTrans _ _ _
          (fractionAddRespects q q
            (add (midpoint q a) (neg (midpoint q a))) zero
            (fractionEqRefl q) (fractionAddNegRight (midpoint q a)))
          (fractionAddZeroRight q))));

\definition fractionAddCancelRightSimplify (x, z: Fraction):
  FractionEq (add (add x z) (neg z)) x :=
  fractionEqTrans _ _ _ (fractionAddAssoc x z (neg z))
    (fractionEqTrans _ _ _
      (fractionAddRespects x x (add z (neg z)) zero
        (fractionEqRefl x) (fractionAddNegRight z))
      (fractionAddZeroRight x));

\definition fractionAddCancelRight (x, y, z: Fraction)
  (same: FractionEq (add x z) (add y z)): FractionEq x y :=
  fractionEqTrans _ _ _
    (fractionEqSym _ _ (fractionAddCancelRightSimplify x z))
    (fractionEqTrans _ _ _
      (fractionAddRespects (add x z) (add y z)
        (neg z) (neg z) same (fractionEqRefl _))
      (fractionAddCancelRightSimplify y z));

\definition ltAddAdjustment (q, a: Fraction) (qa: lt q a):
  lt q (add a (adjustment q a)) :=
  FractionOrder.ltReplaceLeft
    (add (midpoint q a) (adjustment q a)) q
    (add a (adjustment q a))
    (addAdjustmentEq q a)
    (ltAddRight (midpoint q a) a (adjustment q a)
      (midpointLt q a qa));

\definition zeroLtNumerator (e: Fraction) (positive: lt zero e):
  I.IntegerLt I.zeroInteger (numerator e) :=
  IntegerOrder.ltRespects
    (I.mulInteger I.zeroInteger (denominator e)) I.zeroInteger
    (I.mulInteger (numerator e) I.oneInteger) (numerator e)
    (I.mulIntegerZeroLeft (denominator e))
    (I.mulIntegerOneRight (numerator e)) positive;

\definition zeroLtTimesDenominator (x: I.Integer) (d: I.Nat)
  (positive: I.IntegerLt I.zeroInteger x):
  I.IntegerLt I.zeroInteger
    (I.mulInteger x (I.integer (I.natSucc d) I.zeroNat)) :=
  IntegerOrder.ltRespects
    (I.mulInteger I.zeroInteger
      (I.integer (I.natSucc d) I.zeroNat)) I.zeroInteger
    (I.mulInteger x (I.integer (I.natSucc d) I.zeroNat))
    (I.mulInteger x (I.integer (I.natSucc d) I.zeroNat))
    (I.mulIntegerZeroLeft (I.integer (I.natSucc d) I.zeroNat))
    (I.integerEqRefl _)
    (FractionOrder.ltMulDenominator I.zeroInteger x d positive);

\definition naturalTranslate (a, e: Fraction) (n: I.Nat): Fraction :=
  fraction
    (I.addInteger
      (I.mulInteger (numerator a) (denominator e))
      (I.scaleInteger
        (I.mulInteger (numerator e) (denominator a)) n))
    (denominatorProductIndex
      (denominatorIndex a) (denominatorIndex e));

\definition scaleFraction (e: Fraction) (n: I.Nat): Fraction :=
  fraction (I.scaleInteger (numerator e) n) (denominatorIndex e);

\definition naturalTranslateDenominator (a, e: Fraction) (n: I.Nat):
  I.IntegerEq (denominator (naturalTranslate a e n))
    (I.mulInteger (denominator a) (denominator e)) :=
  denominatorAdd a e;

\definition scaleFractionSucc (e: Fraction) (n: I.Nat):
  FractionEq (scaleFraction e (I.natSucc n))
    (add (scaleFraction e n) e) :=
  \block {
    \let previous: I.Integer := I.scaleInteger (numerator e) n;
    \let next: I.Integer := I.scaleInteger (numerator e) (I.natSucc n);
    \let d: I.Integer := denominator e;
    \let numeratorStep:
        I.IntegerEq next (I.addInteger previous (numerator e)) :=
      I.integerEqTrans _ _ _ (I.scaleIntegerSucc (numerator e) n)
        (I.addIntegerComm (numerator e) previous);
    \let leftAlignment:
        I.IntegerEq
          (I.mulInteger next (denominator (add (scaleFraction e n) e)))
          (I.mulInteger
            (I.addInteger previous (numerator e))
            (I.mulInteger d d)) :=
      I.mulIntegerRespects next (I.addInteger previous (numerator e))
        (denominator (add (scaleFraction e n) e))
        (I.mulInteger d d) numeratorStep
        (denominatorAdd (scaleFraction e n) e);
    \let rightAlignment:
        I.IntegerEq
          (I.mulInteger (numerator (add (scaleFraction e n) e)) d)
          (I.mulInteger
            (I.addInteger previous (numerator e))
            (I.mulInteger d d)) :=
      I.integerEqTrans _ _ _
        (I.mulIntegerRespects _ _ d d
          (I.integerEqSym _ _
            (I.mulIntegerDistribRight previous (numerator e) d))
          (I.integerEqRefl d))
        (I.mulIntegerAssoc
          (I.addInteger previous (numerator e)) d d);
    \return I.integerEqTrans _ _ _ leftAlignment
      (I.integerEqSym _ _ rightAlignment);
  };

\definition naturalTranslateNumeratorAsAdd (a, e: Fraction) (n: I.Nat):
  I.IntegerEq (numerator (naturalTranslate a e n))
    (numerator (add a (scaleFraction e n))) :=
  I.addIntegerRespects
    (I.mulInteger (numerator a) (denominator e))
    (I.mulInteger (numerator a) (denominator (scaleFraction e n)))
    (I.scaleInteger
      (I.mulInteger (numerator e) (denominator a)) n)
    (I.mulInteger (I.scaleInteger (numerator e) n) (denominator a))
    (I.integerEqRefl _)
    (I.scaleIntegerMulRight (numerator e) (denominator a) n);

\definition naturalTranslateAsAdd (a, e: Fraction) (n: I.Nat):
  FractionEq (naturalTranslate a e n) (add a (scaleFraction e n)) :=
  fractionEqOfNumeratorDenominator
    (naturalTranslate a e n) (add a (scaleFraction e n))
    (naturalTranslateNumeratorAsAdd a e n)
    (I.integerEqTrans _ _ _
      (naturalTranslateDenominator a e n)
      (I.integerEqSym _ _ (denominatorAdd a (scaleFraction e n))));

\definition scaleFractionZero (e: Fraction):
  FractionEq (scaleFraction e I.zeroNat) zero :=
  fractionEqZeroOfNumerator (scaleFraction e I.zeroNat)
    (I.scaleIntegerByZero (numerator e));

\definition grid (a, e: Fraction) (n: I.Nat): Fraction :=
  add a (scaleFraction e n);

\definition gridZero (a, e: Fraction): FractionEq (grid a e I.zeroNat) a :=
  fractionEqTrans _ _ _
    (fractionAddRespects a a (scaleFraction e I.zeroNat) zero
      (fractionEqRefl a) (scaleFractionZero e))
    (fractionAddZeroRight a);

\definition gridSucc (a, e: Fraction) (n: I.Nat):
  FractionEq (grid a e (I.natSucc n)) (add (grid a e n) e) :=
  fractionEqTrans _ _ _
    (fractionAddRespects a a
      (scaleFraction e (I.natSucc n)) (add (scaleFraction e n) e)
      (fractionEqRefl a) (scaleFractionSucc e n))
    (fractionEqSym _ _
      (fractionAddAssoc a (scaleFraction e n) e));

\definition naturalTranslateAsGrid (a, e: Fraction) (n: I.Nat):
  FractionEq (naturalTranslate a e n) (grid a e n) :=
  naturalTranslateAsAdd a e n;

\definition NaturalTranslateAbove (a, e, b: Fraction): \Prop :=
  \exists \Ty(I.Nat,
    \Subset(n, I.Nat, lt b (naturalTranslate a e n)));

\definition naturalTranslateAbove (a, e, b: Fraction)
  (positive: lt zero e): NaturalTranslateAbove a e b :=
  \block {
    \let base: I.Integer :=
      I.mulInteger (numerator a) (denominator e);
    \let increment: I.Integer :=
      I.mulInteger (numerator e) (denominator a);
    \let scaledIncrement: I.Integer :=
      I.mulInteger increment (denominator b);
    \let leftCross: I.Integer :=
      I.mulInteger (numerator b)
        (I.mulInteger (denominator a) (denominator e));
    \let baseCross: I.Integer :=
      I.mulInteger base (denominator b);
    \let difference: I.Integer :=
      I.addInteger leftCross (I.negInteger baseCross);
    \let incrementPositive: I.IntegerLt I.zeroInteger increment :=
      zeroLtTimesDenominator (numerator e) (denominatorIndex a)
        (zeroLtNumerator e positive);
    \let scaledIncrementPositive:
        I.IntegerLt I.zeroInteger scaledIncrement :=
      zeroLtTimesDenominator increment (denominatorIndex b)
        incrementPositive;
    \return
      \take (n: \Ty(I.Nat,
        \Subset(n, I.Nat,
          I.IntegerLt difference
            (I.scaleInteger scaledIncrement n)))) =>
        \block {
          \let archBound:
              I.IntegerLt difference
                (I.scaleInteger scaledIncrement n) :=
            \bysub(I.Nat,
              \Subset(n, I.Nat,
                I.IntegerLt difference
                  (I.scaleInteger scaledIncrement n)), n);
          \let withBase:
              I.IntegerLt (I.addInteger difference baseCross)
                (I.addInteger
                  (I.scaleInteger scaledIncrement n) baseCross) :=
            IntegerOrder.ltAddRight difference
              (I.scaleInteger scaledIncrement n) baseCross archBound;
          \let lowerAlignment:
              I.IntegerEq (I.addInteger difference baseCross)
                (I.mulInteger (numerator b)
                  (denominator (naturalTranslate a e n))) :=
            I.integerEqTrans _ _ _
              (I.addIntegerSubCancelRight leftCross baseCross)
              (I.mulIntegerRespects _ _ _ _ (I.integerEqRefl _)
                (I.integerEqSym _ _
                  (naturalTranslateDenominator a e n)));
          \let upperAlignment:
              I.IntegerEq
                (I.addInteger
                  (I.scaleInteger scaledIncrement n) baseCross)
                (I.mulInteger (numerator (naturalTranslate a e n))
                  (denominator b)) :=
            I.integerEqTrans _ _ _
              (I.addIntegerRespects _ _ _ _
                (I.scaleIntegerMulRight increment (denominator b) n)
                (I.integerEqRefl baseCross))
              (I.integerEqTrans _ _ _
                (I.addIntegerComm
                  (I.mulInteger (I.scaleInteger increment n)
                    (denominator b)) baseCross)
                (I.integerEqSym _ _
                  (I.mulIntegerDistribRight base
                    (I.scaleInteger increment n) (denominator b))));
          \let rationalBound: lt b (naturalTranslate a e n) :=
            IntegerOrder.ltRespects
              (I.addInteger difference baseCross)
              (I.mulInteger (numerator b)
                (denominator (naturalTranslate a e n)))
              (I.addInteger (I.scaleInteger scaledIncrement n) baseCross)
              (I.mulInteger (numerator (naturalTranslate a e n))
                (denominator b))
              lowerAlignment upperAlignment withBase;
          \return \exact(
            \subsetinto(I.Nat,
              \Subset(n, I.Nat, lt b (naturalTranslate a e n)),
              n, rationalBound),
            \Ty(I.Nat,
              \Subset(n, I.Nat, lt b (naturalTranslate a e n))));
        }
      \by (IntegerOrder.positiveMultipleAbove scaledIncrement
        scaledIncrementPositive difference);
  };

/* The quotient is fixed to the proved FractionEq equivalence relation. */
\definition addCommEquality (x, y: Fraction): add x y = add y x :=
  congr2!{I.Integer I.Nat Fraction} fraction
    (numerator (add x y)) (numerator (add y x))
    (denominatorIndex (add x y)) (denominatorIndex (add y x))
    (I.integerEqToEquality _ _
      (I.addIntegerComm
        (I.mulInteger (numerator x) (denominator y))
        (I.mulInteger (numerator y) (denominator x))))
    (denominatorProductIndexComm (denominatorIndex x) (denominatorIndex y));
\definition subFieldsLeft (x, y, z: Fraction)
  (num: numerator x = numerator z) (den: denominatorIndex x = denominatorIndex z):
  sub x y = sub z y :=
  congr2!{I.Integer I.Nat Fraction} (\fun (n: I.Integer) => \fun (d: I.Nat) => sub (fraction n d) y)
    (numerator x) (numerator z) (denominatorIndex x) (denominatorIndex z) num den;
\definition subFieldsRight (x, y, z: Fraction)
  (num: numerator y = numerator z) (den: denominatorIndex y = denominatorIndex z):
  sub x y = sub x z :=
  congr2!{I.Integer I.Nat Fraction} (\fun (n: I.Integer) => \fun (d: I.Nat) => sub x (fraction n d))
    (numerator y) (numerator z) (denominatorIndex y) (denominatorIndex z) num den;
\definition negInvolutiveNumerator (x: Fraction): numerator (neg (neg x)) = numerator x :=
  I.integerEqToEquality _ _ (I.negIntegerInvolutive (numerator x));
\definition subNegEquality (x, y: Fraction): sub (neg x) (neg y) = sub y x :=
  trans!{Fraction} _ _ _
    (congr!{I.Integer Fraction}
      (\fun (n: I.Integer) => add (neg x) (fraction n (denominatorIndex y)))
      (I.negInteger (I.negInteger (numerator y))) (numerator y)
      (negInvolutiveNumerator y))
    (addCommEquality (neg x) y);

\module Quotient;
