\import I.Order() \as IO;
\definition Comparison (x, y: Fraction): \Prop :=
  Logic.Or[lt x y, Logic.Or[FractionEq x y, lt y x]];
\definition trichotomy (x, y: Fraction): Comparison x y :=
  IO.trichotomy
    (I.mulInteger (numerator x) (denominator y))
    (I.mulInteger (numerator y) (denominator x));
\definition ltIrrefl (x: Fraction): Logic.Not (lt x x) :=
  IO.ltIrrefl (I.mulInteger (numerator x) (denominator x));
