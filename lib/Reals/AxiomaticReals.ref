/*
 * Bourbaki-style real structures.
 *
 * RawRealStructure contains data only.  Laws are imposed afterwards by the
 * refinement AxiomaticRealStructure, so no proof is stored in an inductive
 * value.  The order is represented by a subset of Carrier times Carrier
 * rather than a Prop-valued field; this keeps every constructor argument in
 * Set and exposes the usual Bourbaki representation of a binary relation.
 */
\import \root.Logic[].Proposition[] \as Logic;
\import \root.Data[].Pair[] \as Pair;
\import \root.Logic[].Rel[Carrier := Carrier] \as Rel;
\import \root.Logic[].Law[] \as Law;
\use Logic.not;
\use Logic.and;
\use Logic.or;

\record RawRealStructure[Carrier: \Set]: \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
  leRelation: \Pow (Pair.Times^[Carrier, Carrier]),
};

\definition Le (s: RawRealStructure[Carrier]) (x, y: Carrier): \Prop :=
    \In[Pair.Times^[Carrier, Carrier]] (#leRelation{s}) (Pair.pair _ _ x y);

\definition NonZero (s: RawRealStructure[Carrier]) (x: Carrier): \Prop :=
    not!{{ x = #zero{s} }};

\record FieldLaws[s: RawRealStructure[Carrier]]: \Prop := {
  zeroNeOne: not!{{ #zero{s} = #one{s} }},
  addLeftIdentity: Law.LeftUnital Carrier (#add{s}) (#zero{s}),
  addLeftInverse: Law.LeftInvertible Carrier (#add{s}) (#zero{s}) (#neg{s}),
  addCommutative: Law.Commutative Carrier (#add{s}),
  addAssociative: Law.Associative Carrier (#add{s}),
  mulLeftIdentity: Law.LeftUnital Carrier (#mul{s}) (#one{s}),
  mulCommutative: Law.Commutative Carrier (#mul{s}),
  mulAssociative: Law.Associative Carrier (#mul{s}),
  leftDistributive: Law.LeftDistributive Carrier (#mul{s}) (#add{s}),
  inverse: \forall (x: Carrier) -> NonZero s x -> #mul{s} (#inv{s} x) x = #one{s},
};

\record LinearOrderLaws[s: RawRealStructure[Carrier]]: \Prop := {
  reflexive: Rel.Reflexive (Le s),
  transitive: Rel.Transitive (Le s),
  antisymmetric: Rel.Antisymmetric (Le s),
  total: Rel.Total (Le s),
};

\record OrderedFieldLaws[s: RawRealStructure[Carrier]]: \Prop := {
  addMonotone: \forall (x, y, z: Carrier) -> Le s x y ->
    Le s (#add{s} z x) (#add{s} z y),
  nonnegativeMul: \forall (x, y: Carrier) ->
    Le s (#zero{s}) x -> Le s (#zero{s}) y ->
      Le s (#zero{s}) (#mul{s} x y),
};

\definition In (A: \Pow Carrier) (x: Carrier): \Prop := \In[Carrier] A x;

\definition Inhabited (A: \Pow Carrier): \Prop :=
    \exists { x : Carrier \where In A x };

\definition IsUpperBound (s: RawRealStructure[Carrier]) (A: \Pow Carrier) (u: Carrier): \Prop :=
    \forall (x: Carrier) -> In A x -> Le s x u;

\definition BoundedAbove (s: RawRealStructure[Carrier]) (A: \Pow Carrier): \Prop :=
    \exists { u : Carrier \where IsUpperBound s A u };

\definition IsLeastUpperBound (s: RawRealStructure[Carrier]) (A: \Pow Carrier) (u: Carrier): \Prop :=
    and!{{ IsUpperBound s A u }
      { \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v }};

\definition HasLeastUpperBound (s: RawRealStructure[Carrier]) (A: \Pow Carrier): \Prop :=
    \exists { u : Carrier \where IsLeastUpperBound s A u };

\definition Completeness (s: RawRealStructure[Carrier]): \Prop :=
    \forall (A: \Pow Carrier) -> Inhabited A -> BoundedAbove s A ->
      HasLeastUpperBound s A;

\definition IsAxiomaticRealStructure (s: RawRealStructure[Carrier]): \Prop :=
  and!{{ FieldLaws[s] } { LinearOrderLaws[s] }
    { OrderedFieldLaws[s] } { Completeness s }};

\definition AxiomaticRealStructureSet:
  \Pow (RawRealStructure[Carrier]) :=
  { s : RawRealStructure[Carrier] \where IsAxiomaticRealStructure s };

\definition AxiomaticRealStructure: \Set :=
  \Cast[RawRealStructure[Carrier]] AxiomaticRealStructureSet;

\definition laws (s: AxiomaticRealStructure): IsAxiomaticRealStructure s :=
  \bysub(RawRealStructure[Carrier], AxiomaticRealStructureSet, s);

\definition realLawsIntro (s: RawRealStructure[Carrier])
  (field: FieldLaws[s]) (order: LinearOrderLaws[s])
  (compatible: OrderedFieldLaws[s]) (complete: Completeness s): IsAxiomaticRealStructure s :=
  Logic.And[FieldLaws[s],
    Logic.And[LinearOrderLaws[s], Logic.And[OrderedFieldLaws[s], Completeness s]]]::# field (Logic.And[LinearOrderLaws[s], Logic.And[OrderedFieldLaws[s], Completeness s]]::# order (Logic.And[OrderedFieldLaws[s], Completeness s]::# compatible complete));

\definition linearOrderIntro (s: RawRealStructure[Carrier])
  (reflexive: Rel.Reflexive (Le s)) (transitive: Rel.Transitive (Le s))
  (antisymmetric: Rel.Antisymmetric (Le s)) (total: Rel.Total (Le s)): LinearOrderLaws[s] :=
  LinearOrderLaws[s]::# reflexive transitive antisymmetric total;

\definition leastUpperBoundIntro (s: RawRealStructure[Carrier]) (A: \Pow Carrier) (u: Carrier)
  (upper: IsUpperBound s A u)
  (least: \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v): IsLeastUpperBound s A u :=
  Logic.And[IsUpperBound s A u, \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v]::# upper least;
\definition lubUpper (s: RawRealStructure[Carrier]) (A: \Pow Carrier) (u: Carrier)
  (h: IsLeastUpperBound s A u): IsUpperBound s A u :=
  #left{h};
\definition lubLeast (s: RawRealStructure[Carrier]) (A: \Pow Carrier) (u: Carrier)
  (h: IsLeastUpperBound s A u): \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v :=
  #right{h};

\module Laws;
