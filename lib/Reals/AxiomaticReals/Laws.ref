\import \root.Logic[].Equality[] \as Equality;
\use Equality.sym;

\definition leAntisym (s: AxiomaticRealStructure): Rel.Antisymmetric (Le s) :=
  #antisymmetric{(#left{(#right{(laws s)})})};
\definition leastUpperBoundUnique (s: AxiomaticRealStructure) (A: \Pow Carrier) (u, v: Carrier)
  (hu: IsLeastUpperBound s A u) (hv: IsLeastUpperBound s A v): u = v :=
  leAntisym s u v (lubLeast s A u hu v (lubUpper s A v hv))
    (lubLeast s A v hv u (lubUpper s A u hu));

\definition SupDomainSet (s: AxiomaticRealStructure): \Pow (\Pow Carrier) :=
  { A : \Pow Carrier \where Logic.And[Inhabited A, BoundedAbove s A] };
\definition SupDomain (s: AxiomaticRealStructure): \Set :=
  \Cast[\Pow Carrier] (SupDomainSet s);
\definition domainInhabited (s: AxiomaticRealStructure) (A: SupDomain s): Inhabited A :=
  #left{(\bysub(\Pow Carrier, SupDomainSet s, A))};
\definition domainBounded (s: AxiomaticRealStructure) (A: SupDomain s): BoundedAbove s A :=
  #right{(\bysub(\Pow Carrier, SupDomainSet s, A))};
\definition Candidates (s: AxiomaticRealStructure) (A: \Pow Carrier): \Set :=
  \Cast[Carrier] ({ u : Carrier \where IsLeastUpperBound s A u });
\definition candidateLaw (s: AxiomaticRealStructure) (A: \Pow Carrier) (u: Candidates s A):
  IsLeastUpperBound s A u := \bysub(Carrier, { u : Carrier \where IsLeastUpperBound s A u }, u);
\definition candidateValue (s: AxiomaticRealStructure) (A: \Pow Carrier) (u: Candidates s A): Carrier := u;
\definition candidatesUnique (s: AxiomaticRealStructure) (A: \Pow Carrier) (u, v: Candidates s A):
  candidateValue s A u = candidateValue s A v :=
  leastUpperBoundUnique s A u v (candidateLaw s A u) (candidateLaw s A v);
\definition supremum (s: AxiomaticRealStructure) (A: SupDomain s): Carrier :=
  \take (u: Candidates s A) => candidateValue s A u
  \by { existence: #right{(#right{(#right{(laws s)})})} A (domainInhabited s A) (domainBounded s A), uniqueness: candidatesUnique s A };
\definition supremumLaw (s: AxiomaticRealStructure) (A: SupDomain s): IsLeastUpperBound s A (supremum s A) :=
  \take (u: Candidates s A) =>
    \idelim(candidateValue s A u = supremum s A \with v: Carrier => IsLeastUpperBound s A v)
      \by { base: candidateLaw s A u, equality:
        sym!{Carrier} _ _
          (\takeelim(\fun (v: Candidates s A) => candidateValue s A v, u, Candidates s A, Carrier)
            \by { existence: #right{(#right{(#right{(laws s)})})} A (domainInhabited s A) (domainBounded s A), uniqueness: candidatesUnique s A }) }
  \by { #right{(#right{(#right{(laws s)})})} A (domainInhabited s A) (domainBounded s A) };
