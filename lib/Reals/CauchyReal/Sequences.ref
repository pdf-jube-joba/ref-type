/* Concrete sequence constructions with no additional analytic assumptions. */
\definition pointwiseEquivalent (x, y: CauchySeq)
  (same: \forall (n: Nat) -> at x n = at y n)
  (eps: Rat) (positive: Positive eps):
  \exists \Cast[Nat] ({ k : Nat \where EquivalentAt x y eps k }) :=
  \take (k: \Cast[Nat] ({ k : Nat \where CauchyAt x eps k })) =>
    \exact(
      \into[Nat](k, { j : Nat \where EquivalentAt x y eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
          \idelim(at x n = at y n \with a: Rat => Close (at x n) a eps)
            \by { base: (\bysub(Nat, { j : Nat \where CauchyAt x eps j }, k)) n n kn kn, equality: same n } },
      \Cast[Nat] ({ j : Nat \where EquivalentAt x y eps j }))
  \by { cauchyProperty x eps positive };

\definition ConstSeq (a: Rat) (n: Nat): Rat := a;
\definition constCauchyOf (a: Rat)
  (selfClose: \forall (eps: Rat) -> Positive eps -> Close a a eps)
  (eps: Rat) (positive: Positive eps):
  \exists \Cast[Nat] ({ k : Nat \where CauchyAt (ConstSeq a) eps k }) :=
  \exact(
    \into[Nat](N.Nat^::zero, { k : Nat \where CauchyAt (ConstSeq a) eps k }) \by { \fun (m, n: Nat) => \fun (_: NatLe N.Nat^::zero m) =>
      \fun (_: NatLe N.Nat^::zero n) => selfClose eps positive },
    \Cast[Nat] ({ k : Nat \where CauchyAt (ConstSeq a) eps k }));
\definition zeroClose (eps: Rat) (positive: Positive eps): Close zeroRat zeroRat eps :=
  Logic.And[ltRat (subRat zeroRat zeroRat) eps, ltRat (subRat zeroRat zeroRat) eps]::# (positive) (positive);
\definition oneClose (eps: Rat) (positive: Positive eps): Close oneRat oneRat eps :=
  Logic.And[ltRat (subRat oneRat oneRat) eps, ltRat (subRat oneRat oneRat) eps]::# (positive) (positive);
\definition zeroCauchy: IsCauchy (ConstSeq zeroRat) := constCauchyOf zeroRat zeroClose;
\definition oneCauchy: IsCauchy (ConstSeq oneRat) := constCauchyOf oneRat oneClose;
\definition zero: CauchySeq :=
  \into[Sequence](ConstSeq zeroRat, CauchySet) \by { zeroCauchy };
\definition one: CauchySeq :=
  \into[Sequence](ConstSeq oneRat, CauchySet) \by { oneCauchy };

\definition closeNeg (x, y, eps: Rat) (h: Close x y eps): Close (negRat x) (negRat y) eps :=
  Logic.And[ltRat (subRat (negRat x) (negRat y)) eps,
    ltRat (subRat (negRat y) (negRat x)) eps]::# (\idelim(subRat y x = subRat (negRat x) (negRat y) \with a: Rat => ltRat a eps)
        \by { base: #right{h}, equality:
          sym!{Rat} _ _ (RationalOperations.subNegEquality x y) }) (\idelim(subRat x y = subRat (negRat y) (negRat x) \with a: Rat => ltRat a eps)
        \by { base: #left{h}, equality:
          sym!{Rat} _ _ (RationalOperations.subNegEquality y x) });
\definition NegSeq (x: CauchySeq) (n: Nat): Rat := negRat (at x n);
\definition negCauchy (x: CauchySeq) (eps: Rat) (positive: Positive eps):
  \exists \Cast[Nat] ({ k : Nat \where CauchyAt (NegSeq x) eps k }) :=
  \take (k: \Cast[Nat] ({ k : Nat \where CauchyAt x eps k })) =>
    \exact(
      \into[Nat](k, { j : Nat \where CauchyAt (NegSeq x) eps j }) \by { \fun (m, n: Nat) => \fun (km: NatLe k m) => \fun (kn: NatLe k n) =>
          closeNeg (at x m) (at x n) eps
            ((\bysub(Nat, { j : Nat \where CauchyAt x eps j }, k)) m n km kn) },
      \Cast[Nat] ({ j : Nat \where CauchyAt (NegSeq x) eps j }))
  \by { cauchyProperty x eps positive };
\definition neg (x: CauchySeq): CauchySeq :=
  \into[Sequence](NegSeq x, CauchySet) \by { negCauchy x };
\definition negRespects (x, y: CauchySeq) (xy: Equivalent x y) (eps: Rat) (positive: Positive eps):
  \exists \Cast[Nat] ({ k : Nat \where EquivalentAt (neg x) (neg y) eps k }) :=
  \take (k: \Cast[Nat] ({ k : Nat \where EquivalentAt x y eps k })) =>
    \exact(
      \into[Nat](k, { j : Nat \where EquivalentAt (neg x) (neg y) eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
          closeNeg (at x n) (at y n) eps
            ((\bysub(Nat, { j : Nat \where EquivalentAt x y eps j }, k)) n kn) },
      \Cast[Nat] ({ j : Nat \where EquivalentAt (neg x) (neg y) eps j }))
  \by { xy eps positive };
\definition negInvolutive (x: CauchySeq): Equivalent (neg (neg x)) x :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \take (k: \Cast[Nat] ({ k : Nat \where EquivalentAt x x eps k })) =>
      \exact(
        \into[Nat](k, { j : Nat \where EquivalentAt (neg (neg x)) x eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
            Logic.And[
              ltRat (subRat (at (neg (neg x)) n) (at x n)) eps,
              ltRat (subRat (at x n) (at (neg (neg x)) n)) eps]::# (\idelim(subRat (at x n) (at x n) = subRat (at (neg (neg x)) n) (at x n)
                \with q: Rat => ltRat q eps)
                \by { base: #left{((\bysub(Nat, { j : Nat \where EquivalentAt x x eps j }, k)) n kn)}, equality:
                  sym!{Rat} _ _ (RationalOperations.subFieldsLeft
                    (at (neg (neg x)) n) (at x n) (at x n)
                    (RationalOperations.negInvolutiveNumerator (at x n))
                    (\refl(#denominatorIndex{(at x n)}))) }) (\idelim(subRat (at x n) (at x n) = subRat (at x n) (at (neg (neg x)) n)
                \with q: Rat => ltRat q eps)
                \by { base: #right{((\bysub(Nat, { j : Nat \where EquivalentAt x x eps j }, k)) n kn)}, equality:
                  sym!{Rat} _ _ (RationalOperations.subFieldsRight
                    (at x n) (at (neg (neg x)) n) (at x n)
                    (RationalOperations.negInvolutiveNumerator (at x n))
                    (\refl(#denominatorIndex{(at x n)}))) }) },
        \Cast[Nat] ({ j : Nat \where EquivalentAt (neg (neg x)) x eps j }))
    \by { equivalentRefl x eps positive };
\definition negZero: Equivalent (neg zero) zero :=
  pointwiseEquivalent (neg zero) zero (\fun (n: Nat) => RationalOperations.fractionNegZero);
