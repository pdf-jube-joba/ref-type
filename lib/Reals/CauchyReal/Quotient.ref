\import \root.Set[].Quotient[
  A := CauchySeq, Equivalent := Equivalent,
  equivalentRefl := equivalentRefl, equivalentSym := equivalentSym, equivalentTrans := equivalentTrans
] \as Q;

\definition ClassOf: CauchySeq -> \Pow (CauchySeq) := Q.ClassOf;
\definition classOfEq: \forall (x, y: CauchySeq) -> Equivalent x y -> ClassOf x = ClassOf y := Q.classOfEq;
\definition IsClass: \Pow (CauchySeq) -> \Prop := Q.IsClass;
\definition ClassSet: \Pow (\Pow (CauchySeq)) := Q.ClassSet;
\definition Real: \Set := Q.Carrier;
\definition mem: Real -> CauchySeq -> \Prop := Q.mem;
\definition underlying: Real -> \Pow (CauchySeq) := Q.underlying;
\definition Eq: Real -> Real -> \Prop := Q.Eq;
\definition eqByExt: \forall (x, y: Real) ->
  (\forall (a: CauchySeq) -> mem x a -> mem y a) -> (\forall (a: CauchySeq) -> mem y a -> mem x a) -> Eq x y := Q.eqByExt;
\definition classIsClass: \forall (x: CauchySeq) -> IsClass (ClassOf x) := Q.classIsClass;
\definition class: CauchySeq -> Real := Q.class;
\definition classMem: \forall (x, y: CauchySeq) ->
  Equivalent x y -> mem (class x) y := Q.classMem;
\definition relatedOfClassMem: \forall (x, y: CauchySeq) ->
  mem (class x) y -> Equivalent x y := Q.relatedOfClassMem;
\definition equivalentOfClassEq: \forall (x, y: CauchySeq) ->
  ClassOf x = ClassOf y -> Equivalent x y := Q.equivalentOfClassEq;

\definition quotientInduction: \forall (P: Real -> \Prop) ->
  (\forall (x: CauchySeq) -> P (class x)) ->
  \forall (x: Real) -> P x :=
  Q.induction;

\definition UnaryImage: (CauchySeq -> CauchySeq) ->
  \Pow (CauchySeq) -> \Pow (CauchySeq) := Q.UnaryImage;
\definition BinaryImage: (CauchySeq -> CauchySeq -> CauchySeq) ->
  \Pow (CauchySeq) -> \Pow (CauchySeq) -> \Pow (CauchySeq) := Q.BinaryImage;
\definition unaryImageClosed: \forall (f: CauchySeq -> CauchySeq) ->
  Q.UnaryRespects f -> \forall (x: Real) -> IsClass (UnaryImage f x) :=
  Q.unaryImageClosed;
\definition binaryImageClosed: \forall (f: CauchySeq -> CauchySeq -> CauchySeq) ->
  Q.BinaryRespects f -> \forall (x, y: Real) -> IsClass (BinaryImage f x y) :=
  Q.binaryImageClosed;
\definition unaryImageClass: \forall (f: CauchySeq -> CauchySeq) ->
  \forall (respects: Q.UnaryRespects f) -> \forall (x: CauchySeq) ->
    UnaryImage f (class x) = ClassOf (f x) :=
  \fun (f: CauchySeq -> CauchySeq) =>
    \fun (respects: Q.UnaryRespects f) => \fun (x: CauchySeq) =>
      Q.unaryImageClass f respects (class x) x (\refl(ClassOf x));
\definition binaryImageClass: \forall (f: CauchySeq -> CauchySeq -> CauchySeq) ->
  \forall (respects: Q.BinaryRespects f) -> \forall (x, y: CauchySeq) ->
    BinaryImage f (class x) (class y) = ClassOf (f x y) :=
  \fun (f: CauchySeq -> CauchySeq -> CauchySeq) =>
    \fun (respects: Q.BinaryRespects f) => \fun (x, y: CauchySeq) =>
      Q.binaryImageClass f respects (class x) (class y) x y
        (\refl(ClassOf x)) (\refl(ClassOf y));

/*
 * Arithmetic is first formed as a relational image of whole classes.
 * No representative is selected.  The closure obligations state that
 * these images are again single equivalence classes.
 */
\module Operations;
