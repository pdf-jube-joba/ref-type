\import \root.Logic[].Proposition[] \as Logic;

\definition ConstCauchy (a: Rat): CauchySeq :=
    \into[Sequence](ConstSeq a, CauchySet) \by { constCauchy a };

\definition AddCauchy (x, y: CauchySeq): CauchySeq :=
    \into[Sequence](AddSeq x y, CauchySet) \by { addCauchy x y };

\definition MulCauchy (x, y: CauchySeq): CauchySeq :=
    \into[Sequence](MulSeq x y, CauchySet) \by { mulCauchy x y };

\definition NegCauchy (x: CauchySeq): CauchySeq :=
    \into[Sequence](NegSeq x, CauchySet) \by { negCauchy x };

\definition AddClass (x, y: Real): \Pow (CauchySeq) :=
    { z : CauchySeq \where \exists \Cast[CauchySeq] ({ a : CauchySeq \where Logic.And[mem x a,
            \exists \Cast[CauchySeq] ({ b : CauchySeq \where Logic.And[mem y b,
                  Equivalent z (AddCauchy a b)] })] }) };

\definition NegClass (x: Real): \Pow (CauchySeq) :=
    { z : CauchySeq \where \exists \Cast[CauchySeq] ({ a : CauchySeq \where Logic.And[mem x a, Equivalent z (NegCauchy a)] }) };

\definition MulClass (x, y: Real): \Pow (CauchySeq) :=
    { z : CauchySeq \where \exists \Cast[CauchySeq] ({ a : CauchySeq \where Logic.And[mem x a,
            \exists \Cast[CauchySeq] ({ b : CauchySeq \where Logic.And[mem y b,
                  Equivalent z (MulCauchy a b)] })] }) };

\module ClassClosed(
  addClassIsClass: \forall (x, y: Real) ->
    IsClass (AddClass x y),
  negClassIsClass: \forall (x: Real) ->
    IsClass (NegClass x),
  mulClassIsClass: \forall (x, y: Real) ->
    IsClass (MulClass x y),
);
