\import \parent.\parent.Sequences[] \as S;

\definition ConstSeq (a: Rat): Sequence := S.ConstSeq a;

\definition AddSeq (x, y: CauchySeq): Sequence := \fun (n: Nat) =>
    S.AddSeq x y n;

\definition MulSeq (x, y: CauchySeq): Sequence := \fun (n: Nat) =>
    S.MulSeq x y n;

\definition NegSeq (x: CauchySeq): Sequence := \fun (n: Nat) => negRat (at x n);

\definition constCauchy: \forall (a: Rat) ->
  \In[Sequence] (CauchySet) (ConstSeq a) := S.constCauchy;
\definition addCauchy: \forall (x, y: CauchySeq) ->
  \In[Sequence] (CauchySet) (AddSeq x y) := S.addCauchy;
\definition mulCauchy: \forall (x, y: CauchySeq) ->
  \In[Sequence] (CauchySet) (MulSeq x y) := S.mulCauchy;
\definition negCauchy: \forall (x: CauchySeq) ->
  \In[Sequence] (CauchySet) (NegSeq x) := S.negCauchy;

\module SequenceClosed;
