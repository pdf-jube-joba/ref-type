\import \parent.\parent.\parent.Order[] \as CutOrder;
\import \root.Reals[].AxiomaticReals[Carrier := Real] \as AR;
\import \parent.Laws[] \as Laws;

\definition raw: AR.RawRealStructure[Real] :=
  CutOrder.withOrder zero one add neg Laws.fieldMul Laws.fieldInv;

\definition linearOrder: AR.LinearOrderLaws[raw] :=
  CutOrder.linearOrder zero one add neg Laws.fieldMul Laws.fieldInv;

\definition completeness: AR.Completeness raw :=
  CutOrder.completeness zero one add neg Laws.fieldMul Laws.fieldInv;

\definition fieldLaws: AR.FieldLaws[raw] :=
  AR.FieldLaws[raw]::#
    (Laws.zeroNeOne)
    (Laws.addZeroLeft)
    (Laws.addNegLeft)
    (Laws.addComm)
    (Laws.addAssoc)
    (Laws.fieldMulOneLeft)
    (Laws.fieldMulComm)
    (Laws.fieldMulAssoc)
    (Laws.fieldMulAdd)
    (Laws.fieldInverseNonzero);

\definition orderedFieldLaws: AR.OrderedFieldLaws[raw] :=
  AR.OrderedFieldLaws[raw]::#
    (Laws.addMonotoneLeft)
    (Laws.fieldMulNonnegative);

\definition axiomaticLaws: AR.IsAxiomaticRealStructure raw :=
  AR.realLawsIntro raw fieldLaws linearOrder orderedFieldLaws completeness;

\definition axiomaticReal: AR.AxiomaticRealStructure :=
  \into[AR.RawRealStructure[Real]]
    (raw, AR.AxiomaticRealStructureSet) \by { axiomaticLaws };
