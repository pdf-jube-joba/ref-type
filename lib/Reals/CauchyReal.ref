/*
 * Cauchy reals over the concrete rational representatives from Arithmetic/Rat.ref.
 *
 * A real is not a chosen Cauchy sequence.  It is an actual equivalence
 * class: a subset of CauchySeq containing exactly the sequences equivalent
 * to one representative.  Kernel equality is therefore the right equality
 * for reals once extensionality of subsets of CauchySeq is supplied.
 */
\import \root.Logic[].Proposition[] \as Logic;
\import \root.Nat[] \as N;
\import N.Laws[] \as NL;
\import NL.Order[] \as NatOrder;
\import \root.Arithmetic[].Rat[] \as Rational;
\import Rational.Fractions[] \as RationalFractions;
\import RationalFractions.Operations[] \as RationalOperations;
\import RationalFractions.Order[] \as RationalOrder;
\import \root.Arithmetic[].Int[] \as Integer;
\import Integer.Order[] \as IntegerOrder;
\import \root.Logic[].Classical[] \as Classical;
\use Logic.and;
\import \root.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;

\definition Rat: \Set := RationalFractions.Fraction;

\definition zeroRat: Rat := RationalFractions.zero;

\definition oneRat: Rat := RationalFractions.one;

\definition addRat (x, y: Rat): Rat := RationalOperations.add x y;

\definition mulRat (x, y: Rat): Rat := RationalOperations.mul x y;

\definition negRat (x: Rat): Rat := RationalOperations.neg x;

\definition subRat (x, y: Rat): Rat := RationalOperations.sub x y;

\definition twoRat: Rat := addRat oneRat oneRat;

\definition halfRat: Rat := RationalOperations.reciprocal twoRat;

\definition ltRat (x, y: Rat): \Prop := RationalFractions.lt x y;

\definition byContradiction (P: \Prop)
    (h: Logic.Not P -> Logic.False): P :=
  Classical.orElim P (Logic.Not P) P
    (\fun (p: P) => p)
    (\fun (notP: Logic.Not P) => Logic.falseElim P (h notP))
    (Classical.excludedMiddle P);

\definition leNegReverse (x, y: Rat)
    (xy: RationalOperations.Le x y):
    RationalOperations.Le (negRat y) (negRat x) :=
  Classical.orElim (RationalFractions.FractionEq x y) (ltRat x y)
    (RationalOperations.Le (negRat y) (negRat x))
    (\fun (same: RationalFractions.FractionEq x y) =>
      RationalOperations.leOfEq (negRat y) (negRat x)
        (RationalOperations.fractionNegRespects y x
          (RationalFractions.fractionEqSym _ _ same)))
    (\fun (less: ltRat x y) =>
      RationalOperations.leOfLt (negRat y) (negRat x)
        (RationalOperations.ltNegReverse x y less))
    xy;

\definition leAddRight (x, y, z: Rat)
    (xy: RationalOperations.Le x y):
    RationalOperations.Le (addRat x z) (addRat y z) :=
  Classical.orElim (RationalFractions.FractionEq x y) (ltRat x y)
    (RationalOperations.Le (addRat x z) (addRat y z))
    (\fun (same: RationalFractions.FractionEq x y) =>
      RationalOperations.leOfEq (addRat x z) (addRat y z)
        (RationalOperations.fractionAddRespects x y z z same
          (RationalFractions.fractionEqRefl z)))
    (\fun (less: ltRat x y) =>
      RationalOperations.leOfLt (addRat x z) (addRat y z)
        (RationalOperations.ltAddRight x y z less))
    xy;

\definition leAddLeft (z, x, y: Rat)
    (xy: RationalOperations.Le x y):
    RationalOperations.Le (addRat z x) (addRat z y) :=
  RationalOperations.leTrans (addRat z x) (addRat x z) (addRat z y)
    (RationalOperations.leOfEq (addRat z x) (addRat x z)
      (RationalOperations.fractionAddComm z x))
    (RationalOperations.leTrans (addRat x z) (addRat y z)
      (addRat z y) (leAddRight x y z xy)
      (RationalOperations.leOfEq (addRat y z) (addRat z y)
        (RationalOperations.fractionAddComm y z)));

\definition leAdd (x, y, u, v: Rat)
    (xy: RationalOperations.Le x y)
    (uv: RationalOperations.Le u v):
    RationalOperations.Le (addRat x u) (addRat y v) :=
  RationalOperations.leTrans (addRat x u) (addRat y u) (addRat y v)
    (leAddRight x y u xy) (leAddLeft y u v uv);

\definition leRespects (x, x2, y, y2: Rat)
    (xx: RationalFractions.FractionEq x x2)
    (yy: RationalFractions.FractionEq y y2)
    (xy: RationalOperations.Le x y): RationalOperations.Le x2 y2 :=
  Classical.orElim (RationalFractions.FractionEq x y) (ltRat x y)
    (RationalOperations.Le x2 y2)
    (\fun (same: RationalFractions.FractionEq x y) =>
      RationalOperations.leOfEq x2 y2
        (RationalFractions.fractionEqTrans x2 x y2
          (RationalFractions.fractionEqSym _ _ xx)
          (RationalFractions.fractionEqTrans x y y2 same yy)))
    (\fun (less: ltRat x y) =>
      RationalOperations.leOfLt x2 y2
        (RationalOrder.ltRespects x x2 y y2 xx yy less))
    xy;

\definition ltOfSubPositive (x, y: Rat)
    (positive: ltRat zeroRat (subRat y x)): ltRat x y :=
  RationalOrder.ltReplaceRight x (addRat (subRat y x) x) y
    (RationalFractions.fractionEqTrans _ _ _
      (RationalOperations.fractionAddComm (subRat y x) x)
      (RationalOperations.fractionAddSubRight x y))
    (RationalOrder.ltReplaceLeft (addRat zeroRat x) x
      (addRat (subRat y x) x)
      (RationalOperations.fractionAddZeroLeft x)
      (RationalOperations.ltAddRight zeroRat (subRat y x) x positive));

\definition absNat (x: Integer.Int^): N.Nat^ :=
  Integer.natAbsPrec x;

\definition absInteger (x: Integer.Int^): Integer.Int^ :=
  Integer.Int^::ofNat (absNat x);

\definition magnitudeInteger (x: Integer.Int^): Integer.Int^ :=
  Integer.Int^::ofNat (N.Nat^::succ (absNat x));

\definition naturalLtConstructors (a, b: N.Nat^) (ab: NL.Lt a b):
    Integer.IntegerLt (Integer.Int^::ofNat a) (Integer.Int^::ofNat b) :=
  IntegerOrder.ltRespects
    (Integer.integer a Integer.zeroNat) (Integer.Int^::ofNat a)
    (Integer.integer b Integer.zeroNat) (Integer.Int^::ofNat b)
    (Integer.integerEqSym _ _ (Integer.ofNatAsInteger a))
    (Integer.integerEqSym _ _ (Integer.ofNatAsInteger b))
    (IntegerOrder.ltNatural a b ab);

\definition zeroLtConstructorSucc (n: N.Nat^):
    Integer.IntegerLt Integer.zeroInteger
      (Integer.Int^::ofNat (N.Nat^::succ n)) :=
  IntegerOrder.ltRespects
    Integer.zeroInteger Integer.zeroInteger
    (Integer.integer (N.Nat^::succ n) Integer.zeroNat)
    (Integer.Int^::ofNat (N.Nat^::succ n))
    (Integer.integerEqRefl Integer.zeroInteger)
    (Integer.integerEqSym _ _
      (Integer.ofNatAsInteger (N.Nat^::succ n)))
    (IntegerOrder.zeroLtNaturalSucc n);

\definition negConstructorEq (n: N.Nat^): Integer.IntegerEq
    (Integer.negInteger (Integer.Int^::ofNat (N.Nat^::succ n)))
    (Integer.Int^::negSucc n) :=
  Integer.integerEqTrans _ _ _
    (Integer.negIntegerRespects
      (Integer.Int^::ofNat (N.Nat^::succ n))
      (Integer.integer (N.Nat^::succ n) Integer.zeroNat)
      (Integer.ofNatAsInteger (N.Nat^::succ n)))
    (Integer.integerEqSym _ _ (Integer.negSuccAsNegNatural n));

\definition magnitudeOfNat (n: N.Nat^): Integer.IntegerEq
    (magnitudeInteger (Integer.Int^::ofNat n))
    (Integer.Int^::ofNat (N.Nat^::succ n)) :=
  Integer.integerEqOfEquality _ _
    (congr!{N.Nat^ Integer.Int^}
      (\fun (k: N.Nat^) => Integer.Int^::ofNat (N.Nat^::succ k))
      (N.add^ n N.Nat^::zero) n (NL.addZeroRight n));

\definition magnitudeOfNegSucc (n: N.Nat^): Integer.IntegerEq
    (magnitudeInteger (Integer.Int^::negSucc n))
    (Integer.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n))) :=
  Integer.integerEqOfEquality _ _
    (congr!{N.Nat^ Integer.Int^}
      (\fun (k: N.Nat^) => Integer.Int^::ofNat (N.Nat^::succ k))
      (N.add^ N.Nat^::zero (N.Nat^::succ n))
      (N.Nat^::succ n) (NL.addZeroLeft (N.Nat^::succ n)));

\definition belowMagnitude: \forall (x: Integer.Int^) ->
    Integer.IntegerLt x (magnitudeInteger x) :=

  \induction (x: Integer.Int^)
    \return Integer.IntegerLt x (magnitudeInteger x) \with {
    | ofNat => (\fun (n: N.Nat^) =>
        IntegerOrder.ltRespects
          (Integer.Int^::ofNat n) (Integer.Int^::ofNat n)
          (Integer.Int^::ofNat (N.Nat^::succ n))
          (magnitudeInteger (Integer.Int^::ofNat n))
          (Integer.integerEqRefl _)
          (Integer.integerEqOfEquality _ _
            (congr!{N.Nat^ Integer.Int^}
              (\fun (k: N.Nat^) => Integer.Int^::ofNat (N.Nat^::succ k))
              n (N.add^ n N.Nat^::zero)
              (sym!{N.Nat^} _ _ (NL.addZeroRight n))))
          (naturalLtConstructors n (N.Nat^::succ n)
            (NatOrder.ltSelfSucc n)))
    | negSucc => (\fun (n: N.Nat^) =>
        IntegerOrder.ltRespects
          (Integer.Int^::negSucc n)
          (Integer.Int^::negSucc n)
          (Integer.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))
          (magnitudeInteger (Integer.Int^::negSucc n))
          (Integer.integerEqRefl _)
          (Integer.integerEqOfEquality _ _
            (congr!{N.Nat^ Integer.Int^}
              (\fun (k: N.Nat^) => Integer.Int^::ofNat (N.Nat^::succ k))
              (N.Nat^::succ n) (N.add^ N.Nat^::zero (N.Nat^::succ n))
              (sym!{N.Nat^} _ _ (NL.addZeroLeft (N.Nat^::succ n)))))
          (IntegerOrder.ltTrans (Integer.Int^::negSucc n)
            Integer.zeroInteger
            (Integer.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))
            (IntegerOrder.negativeLtZero n)
            (zeroLtConstructorSucc (N.Nat^::succ n))))
    };

