/* Arithmetic laws on the reflected operations. */
\import \root.Logic[].Rel[Carrier := Nat^] \as Rel;
\import \root.Logic[].Law[] \as Law;
\definition succInjective (a, b: Nat^) (e: Nat^::succ a = Nat^::succ b): a = b := congr!{Nat^ Nat^} predSet (Nat^::succ a) (Nat^::succ b) e;
\definition predZero: predSet Nat^::zero = Nat^::zero := \refl(Nat^::zero);
\definition predSucc (n: Nat^): predSet (Nat^::succ n) = n := \refl(n);
\definition addZeroRight (a: Nat^): addSet a Nat^::zero = a := \refl(a);
\definition addSuccLeft: \forall (a, b: Nat^) -> addSet (Nat^::succ a) b = Nat^::succ (addSet a b) :=
  \block {
    \fix (a, b: Nat^);
    \let reflectedSuccessor:
      addPrec (Nat^::succ a) b = Nat^::succ (addSet a b) :=
      trans!{Nat^} _ _ _ (addPrecSuccLeft a b)
        (succCong _ _ (sym!{Nat^} _ _ (addMatchesPrec b a)));
    \return trans!{Nat^} _ _ _ (addMatchesPrec b (Nat^::succ a)) reflectedSuccessor;
  };
\definition addSuccRight (a, b: Nat^): addSet a (Nat^::succ b) = Nat^::succ (addSet a b) := addSuccLeft a b;
\definition addZeroLeft: \forall (a: Nat^) -> addSet Nat^::zero a = a :=
  \induction (a: Nat^) \return addSet Nat^::zero a = a \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: addSet Nat^::zero a = a) =>
      trans!{Nat^} _ _ _ (addSuccRight Nat^::zero a) (succCong (addSet Nat^::zero a) a ih))
    };
\definition addComm (a: Nat^): \forall (b: Nat^) -> addSet a b = addSet b a :=
  \induction (b: Nat^) \return addSet a b = addSet b a \with {
    | zero => (sym!{Nat^} _ _ (addZeroLeft a))
    | succ => (\fun (b: Nat^) => \fun (ih: addSet a b = addSet b a) =>
      trans!{Nat^} _ _ _ (addSuccRight a b)
        (trans!{Nat^} _ _ _ (succCong (addSet a b) (addSet b a) ih) (sym!{Nat^} _ _ (addSuccLeft b a))))
    };
\definition addAssoc (a, b: Nat^): \forall (c: Nat^) -> addSet (addSet a b) c = addSet a (addSet b c) :=
  \induction (c: Nat^) \return addSet (addSet a b) c = addSet a (addSet b c) \with {
    | zero => (\refl(addSet a b))
    | succ => (\block {
      \fix (c: Nat^);
      \fix (ih: addSet (addSet a b) c = addSet a (addSet b c));
      \let inductionUnderSuccessor:
        Nat^::succ (addSet (addSet a b) c) = Nat^::succ (addSet a (addSet b c)) :=
        succCong (addSet (addSet a b) c) (addSet a (addSet b c)) ih;
      \let exposeOuterAddition:
        Nat^::succ (addSet a (addSet b c)) = addSet a (Nat^::succ (addSet b c)) :=
        sym!{Nat^} _ _ (addSuccRight a (addSet b c));
      \let exposeInnerAddition:
        addSet a (Nat^::succ (addSet b c)) = addSet a (addSet b (Nat^::succ c)) :=
        congr!{Nat^ Nat^} (addSet a) _ _ (sym!{Nat^} _ _ (addSuccRight b c));
      \return trans!{Nat^} _ _ _ (addSuccRight (addSet a b) c)
        (trans!{Nat^} _ _ _ inductionUnderSuccessor
          (trans!{Nat^} _ _ _ exposeOuterAddition exposeInnerAddition));
    })
    };
\definition addCancelRight: \forall (c, a, b: Nat^) -> addSet a c = addSet b c -> a = b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> addSet a c = addSet b c -> a = b \with {
    | zero => (\fun (a, b: Nat^) => \fun (e: a = b) => e)
    | succ => (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> addSet a c = addSet b c -> a = b) =>
      \fun (a, b: Nat^) => \fun (e: addSet a (Nat^::succ c) = addSet b (Nat^::succ c)) =>
        ih a b (succInjective _ _
          (trans!{Nat^} _ _ _ (sym!{Nat^} _ _ (addSuccRight a c))
            (trans!{Nat^} _ _ _ e (addSuccRight b c)))))
    };
\definition addCancelLeft: \forall (c, a, b: Nat^) -> addSet c a = addSet c b -> a = b :=
  \block {
    \fix (c, a, b: Nat^);
    \fix (e: addSet c a = addSet c b);
    \let rightSumsEqual: addSet a c = addSet b c :=
      trans!{Nat^} _ _ _ (addComm a c)
        (trans!{Nat^} _ _ _ e (addComm c b));
    \return addCancelRight c a b rightSumsEqual;
  };
\definition subZeroRight (a: Nat^): subSet a Nat^::zero = a := \refl(a);
\definition subZeroLeft: \forall (a: Nat^) -> subSet Nat^::zero a = Nat^::zero :=
  \induction (a: Nat^) \return subSet Nat^::zero a = Nat^::zero \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: subSet Nat^::zero a = Nat^::zero) => \refl(Nat^::zero))
    };
\definition subSuccSucc (a, b: Nat^): subSet (Nat^::succ a) (Nat^::succ b) = subSet a b := \refl(subSet a b);
\definition subSelf: \forall (a: Nat^) -> subSet a a = Nat^::zero :=
  \induction (a: Nat^) \return subSet a a = Nat^::zero \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: subSet a a = Nat^::zero) => ih)
    };
\definition subAddCancel: \forall (b, a: Nat^) -> subSet (addSet a b) b = a :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> subSet (addSet a b) b = a \with {
    | zero => (\fun (a: Nat^) => \refl(a))
    | succ => (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> subSet (addSet a b) b = a) => \fun (a: Nat^) =>
      trans!{Nat^} _ _ _
        (congr!{Nat^ Nat^} (\fun (x: Nat^) => subSet x (Nat^::succ b)) _ _ (addSuccRight a b)) (ih a))
    };
\definition mulZeroRight (a: Nat^): mulSet a Nat^::zero = Nat^::zero := \refl(Nat^::zero);
\definition mulSuccRight (a, b: Nat^): mulSet a (Nat^::succ b) = addSet a (mulSet a b) := trans!{Nat^} _ _ _ (mulMatchesPrec a (Nat^::succ b))
    (congr!{Nat^ Nat^} (addSet a) _ _ (sym!{Nat^} _ _ (mulMatchesPrec a b)));
\definition powZero (a: Nat^): powSet a Nat^::zero = Nat^::succ Nat^::zero := \refl(Nat^::succ
  Nat^::zero);
\definition powSucc (a, b: Nat^): powSet a (Nat^::succ b) = mulSet a (powSet a b) := trans!{Nat^} _ _ _ (powMatchesPrec a (Nat^::succ b))
    (congr!{Nat^ Nat^} (mulSet a) _ _ (sym!{Nat^} _ _ (powMatchesPrec a b)));

/* Boolean decisions can be consumed directly as propositions. */
\definition zeroNeSucc (n: Nat^) (e: Nat^::zero = Nat^::succ n): B.False := B.trueNeFalse
    (\idelim(Nat^::zero = Nat^::succ n \with x: Nat^ => isZeroSet Nat^::zero = isZeroSet x)
      \by { base: \refl(B.Bool^::true), equality: e });
\definition succNeZero (n: Nat^) (e: Nat^::succ n = Nat^::zero): B.False := zeroNeSucc n (sym!{Nat^} _ _ e);
\definition eqbRefl: \forall (n: Nat^) -> eqbSet n n = B.Bool^::true :=
  \induction (n: Nat^) \return eqbSet n n = B.Bool^::true \with {
    | zero => (\refl(B.Bool^::true))
    | succ => (\fun (n: Nat^) => \fun (ih: eqbSet n n = B.Bool^::true) => ih)
    };
\definition eqOfEqbTrue: \forall (b, a: Nat^) -> eqbSet a b = B.Bool^::true -> a = b :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> eqbSet a b = B.Bool^::true -> a = b \with {
    | zero => (\induction (a: Nat^) \return eqbSet a Nat^::zero = B.Bool^::true -> a = Nat^::zero \with {
      | zero => (\fun (e: B.Bool^::true = B.Bool^::true) => \refl(Nat^::zero))
      | succ => (\fun (a: Nat^) => \fun (unused: eqbSet a Nat^::zero = B.Bool^::true -> a = Nat^::zero) =>
        \fun (e: B.Bool^::false = B.Bool^::true) => B.absurd (Nat^::succ a = Nat^::zero) e)
      })
    | succ => (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> eqbSet a b = B.Bool^::true -> a = b) =>
      \induction (a: Nat^) \return eqbSet a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b \with {
      | zero => (\fun (e: B.Bool^::false = B.Bool^::true) => B.absurd (Nat^::zero = Nat^::succ b) e)
      | succ => (\fun (a: Nat^) => \fun (unused: eqbSet a (Nat^::succ b) = B.Bool^::true -> a = Nat^::succ b) =>
          \fun (e: eqbSet a b = B.Bool^::true) => succCong a b (ih a e))
      })
    };
\definition eqbTrueOfEq (a, b: Nat^) (e: a = b): eqbSet a b = B.Bool^::true :=
    \idelim(a = b \with x: Nat^ => eqbSet a x = B.Bool^::true) \by { base: eqbRefl a, equality: e };
\definition Le (a, b: Nat^): \Prop := lebSet a b = B.Bool^::true;
\definition Lt (a, b: Nat^): \Prop := ltbSet a b = B.Bool^::true;
\definition leRefl: Rel.Reflexive Le :=
  \induction (n: Nat^) \return Le n n \with {
    | zero => (\refl(B.Bool^::true))
    | succ => (\fun (n: Nat^) => \fun (ih: Le n n) => ih)
    };
\definition zeroLe: \forall (n: Nat^) -> Le Nat^::zero n :=
  \induction (n: Nat^) \return Le Nat^::zero n \with {
    | zero => (\refl(B.Bool^::true))
    | succ => (\fun (n: Nat^) => \fun (ih: Le Nat^::zero n) => \refl(B.Bool^::true))
    };
\definition ltIrrefl: Rel.Irreflexive Lt :=
  \induction (n: Nat^) \return Lt n n -> B.False \with {
    | zero => B.falseNeTrue
    | succ => (\fun (n: Nat^) => \fun (ih: Lt n n -> B.False) => ih)
    };
\definition leSuccSucc (a, b: Nat^) (e: Le a b): Le (Nat^::succ a) (Nat^::succ b) := e;
\definition leOfSuccSucc (a, b: Nat^) (e: Le (Nat^::succ a) (Nat^::succ b)): Le a b := e;
\definition ltSuccSucc (a, b: Nat^) (e: Lt a b): Lt (Nat^::succ a) (Nat^::succ b) := e;
\definition leZeroEq: \forall (a: Nat^) -> Le a Nat^::zero -> a = Nat^::zero :=
  \induction (a: Nat^) \return Le a Nat^::zero -> a = Nat^::zero \with {
    | zero => (\fun (e: Le Nat^::zero Nat^::zero) => \refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: Le a Nat^::zero -> a = Nat^::zero) => \fun (e: Le (Nat^::succ a) Nat^::zero) =>
      B.absurd (Nat^::succ a = Nat^::zero) e)
    };
\definition leAntisym: Rel.Antisymmetric Le :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> Le a b -> Le b a -> a = b \with {
    | zero => (\fun (b: Nat^) => \fun (ab: Le Nat^::zero b) => \fun (ba: Le b Nat^::zero) => sym!{Nat^} b Nat^::zero (leZeroEq b ba))
    | succ => (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> Le a b -> Le b a -> a = b) =>
      \induction (b: Nat^) \return Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b \with {
      | zero => (\fun (ab: Le (Nat^::succ a) Nat^::zero) => \fun (ba: Le Nat^::zero (Nat^::succ a)) => leZeroEq (Nat^::succ a) ab)
      | succ => (\fun (b: Nat^) => \fun (unused: Le (Nat^::succ a) b -> Le b (Nat^::succ a) -> Nat^::succ a = b) =>
          \fun (ab: Le (Nat^::succ a) (Nat^::succ b)) => \fun (ba: Le (Nat^::succ b) (Nat^::succ a)) =>
            succCong a b (ih b ab ba))
      })
    };
\definition leTrans: Rel.Transitive Le :=
  \induction (a: Nat^) \return \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c \with {
    | zero => (\fun (b, c: Nat^) => \fun (ab: Le Nat^::zero b) => \fun (bc: Le b c) => zeroLe c)
    | succ => (\fun (a: Nat^) => \fun (ih: \forall (b, c: Nat^) -> Le a b -> Le b c -> Le a c) =>
      \induction (b: Nat^) \return \forall (c: Nat^) -> Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c \with {
      | zero => (\fun (c: Nat^) => \fun (ab: Le (Nat^::succ a) Nat^::zero) => \fun (bc: Le Nat^::zero c) =>
          B.absurd (Le (Nat^::succ a) c) ab)
      | succ => (\fun (b: Nat^) => \fun (unused: \forall (c: Nat^) -> Le (Nat^::succ a) b -> Le b c -> Le (Nat^::succ a) c) =>
          \induction (c: Nat^) \return Le (Nat^::succ a) (Nat^::succ b) -> Le (Nat^::succ b) c -> Le (Nat^::succ
            a) c \with {
        | zero => (\fun (ab: Le (Nat^::succ a) (Nat^::succ b)) => \fun (bc: Le (Nat^::succ b) Nat^::zero) => B.absurd (Le (Nat^::succ
              a) Nat^::zero) bc
            )
        | succ => (\fun (c: Nat^) => \fun (unusedC: Le (Nat^::succ a) (Nat^::succ b) -> Le (Nat^::succ b) c -> Le (Nat^::succ a) c)
              =>
              \fun (ab: Le (Nat^::succ a) (Nat^::succ b)) => \fun (bc: Le (Nat^::succ b) (Nat^::succ c)) => ih b c ab bc)
        })
      })
    };

\definition addCong: \forall (a, b, c, d: Nat^) -> a = b -> c = d -> addSet a c = addSet b d :=
  congr2!{Nat^ Nat^ Nat^} addSet;
\definition addSwap: \forall (a, b, c: Nat^) -> addSet a (addSet b c) = addSet b (addSet a c) :=
  \block {
    \fix (a, b, c: Nat^);
    \let regroupLeft: addSet a (addSet b c) = addSet (addSet a b) c :=
      sym!{Nat^} _ _ (addAssoc a b c);
    \let swapLeft: addSet (addSet a b) c = addSet (addSet b a) c :=
      congr!{Nat^ Nat^} (\fun (x: Nat^) => addSet x c) _ _ (addComm a b);
    \return trans!{Nat^} _ _ _ regroupLeft
      (trans!{Nat^} _ _ _ swapLeft (addAssoc b a c));
  };
\definition addInterchange: \forall (a, b, c, d: Nat^) ->
  addSet (addSet a b) (addSet c d) = addSet (addSet a c) (addSet b d) :=
  \block {
    \fix (a, b, c, d: Nat^);
    \let regroupLeft:
      addSet (addSet a b) (addSet c d) = addSet a (addSet b (addSet c d)) :=
      addAssoc a b (addSet c d);
    \let swapMiddle:
      addSet a (addSet b (addSet c d)) = addSet a (addSet c (addSet b d)) :=
      congr!{Nat^ Nat^} (addSet a) _ _ (addSwap b c d);
    \return trans!{Nat^} _ _ _ regroupLeft
      (trans!{Nat^} _ _ _ swapMiddle (sym!{Nat^} _ _ (addAssoc a c (addSet b d))));
  };
\definition mulZeroLeft: \forall (a: Nat^) -> mulSet Nat^::zero a = Nat^::zero :=
  \induction (a: Nat^) \return mulSet Nat^::zero a = Nat^::zero \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: mulSet Nat^::zero a = Nat^::zero) =>
      trans!{Nat^} _ _ _ (mulSuccRight Nat^::zero a) (trans!{Nat^} (addSet Nat^::zero (mulSet Nat^::zero a)) (mulSet
        Nat^::zero a) Nat^::zero (addZeroLeft (mulSet Nat^::zero a)) ih))
    };
\definition mulOneLeft: \forall (a: Nat^) -> mulSet (Nat^::succ Nat^::zero) a = a :=
  \induction (a: Nat^) \return mulSet (Nat^::succ Nat^::zero) a = a \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: mulSet (Nat^::succ Nat^::zero) a = a) =>
      trans!{Nat^} _ _ _ (mulSuccRight (Nat^::succ Nat^::zero) a)
        (trans!{Nat^} _ _ _ (addSuccLeft Nat^::zero (mulSet (Nat^::succ Nat^::zero) a))
          (succCong (addSet Nat^::zero (mulSet (Nat^::succ Nat^::zero) a)) a
            (trans!{Nat^} (addSet Nat^::zero (mulSet (Nat^::succ Nat^::zero) a)) (mulSet (Nat^::succ Nat^::zero) a) a
              (addZeroLeft (mulSet (Nat^::succ Nat^::zero) a)) ih))))
    };
\definition mulDistribRight (a, b: Nat^): \forall (c: Nat^) ->
  mulSet (addSet a b) c = addSet (mulSet a c) (mulSet b c) :=
  \induction (c: Nat^) \return mulSet (addSet a b) c = addSet (mulSet a c) (mulSet b c) \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\block {
      \fix (c: Nat^);
      \fix (ih: mulSet (addSet a b) c = addSet (mulSet a c) (mulSet b c));
      \let inductionUnderAddition:
        addSet (addSet a b) (mulSet (addSet a b) c) =
          addSet (addSet a b) (addSet (mulSet a c) (mulSet b c)) :=
        congr!{Nat^ Nat^} (addSet (addSet a b))
          (mulSet (addSet a b) c) (addSet (mulSet a c) (mulSet b c)) ih;
      \let interchange:
        addSet (addSet a b) (addSet (mulSet a c) (mulSet b c)) =
          addSet (addSet a (mulSet a c)) (addSet b (mulSet b c)) :=
        addInterchange a b (mulSet a c) (mulSet b c);
      \let foldSuccessors:
        addSet (addSet a (mulSet a c)) (addSet b (mulSet b c)) =
          addSet (mulSet a (Nat^::succ c)) (mulSet b (Nat^::succ c)) :=
        addCong _ _ _ _
          (sym!{Nat^} _ _ (mulSuccRight a c))
          (sym!{Nat^} _ _ (mulSuccRight b c));
      \return trans!{Nat^} _ _ _ (mulSuccRight (addSet a b) c)
        (trans!{Nat^} _ _ _ inductionUnderAddition
          (trans!{Nat^} _ _ _ interchange foldSuccessors));
    })
    };
\definition mulSuccLeft: \forall (a, b: Nat^) -> mulSet (Nat^::succ a) b = addSet b (mulSet a b) :=
  \block {
    \fix (a, b: Nat^);
    \let removeOne:
      addSet (mulSet a b) (mulSet (Nat^::succ Nat^::zero) b) =
        addSet (mulSet a b) b :=
      congr!{Nat^ Nat^} (addSet (mulSet a b)) _ _ (mulOneLeft b);
    \return trans!{Nat^} _ _ _ (mulDistribRight a (Nat^::succ Nat^::zero) b)
      (trans!{Nat^} _ _ _ removeOne (addComm (mulSet a b) b));
  };
\definition mulComm (a: Nat^): \forall (b: Nat^) -> mulSet a b = mulSet b a :=
  \induction (b: Nat^) \return mulSet a b = mulSet b a \with {
    | zero => (sym!{Nat^} _ _ (mulZeroLeft a))
    | succ => (\fun (b: Nat^) => \fun (ih: mulSet a b = mulSet b a) =>
      trans!{Nat^} _ _ _ (mulSuccRight a b)
        (trans!{Nat^} _ _ _ (congr!{Nat^ Nat^} (addSet a) (mulSet a b) (mulSet b a) ih) (sym!{Nat^} _ _ (mulSuccLeft b a))))
    };
\definition mulOneRight (a: Nat^): mulSet a (Nat^::succ Nat^::zero) = a := trans!{Nat^} _ _ _ (mulComm a (Nat^::succ Nat^::zero)) (mulOneLeft a);
\definition mulDistribLeft: \forall (a, b, c: Nat^) ->
  mulSet a (addSet b c) = addSet (mulSet a b) (mulSet a c) :=
  \block {
    \fix (a, b, c: Nat^);
    \let distribute:
      mulSet (addSet b c) a = addSet (mulSet b a) (mulSet c a) :=
      mulDistribRight b c a;
    \let commuteProducts:
      addSet (mulSet b a) (mulSet c a) = addSet (mulSet a b) (mulSet a c) :=
      addCong _ _ _ _ (mulComm b a) (mulComm c a);
    \return trans!{Nat^} _ _ _ (mulComm a (addSet b c))
      (trans!{Nat^} _ _ _ distribute commuteProducts);
  };
\definition mulAssoc (a, b: Nat^): \forall (c: Nat^) -> mulSet (mulSet a b) c = mulSet a (mulSet b c) :=
  \induction (c: Nat^) \return mulSet (mulSet a b) c = mulSet a (mulSet b c) \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\block {
      \fix (c: Nat^);
      \fix (ih: mulSet (mulSet a b) c = mulSet a (mulSet b c));
      \let inductionUnderAddition:
        addSet (mulSet a b) (mulSet (mulSet a b) c) =
          addSet (mulSet a b) (mulSet a (mulSet b c)) :=
        congr!{Nat^ Nat^} (addSet (mulSet a b))
          (mulSet (mulSet a b) c) (mulSet a (mulSet b c)) ih;
      \let factorLeft:
        addSet (mulSet a b) (mulSet a (mulSet b c)) =
          mulSet a (addSet b (mulSet b c)) :=
        sym!{Nat^} _ _ (mulDistribLeft a b (mulSet b c));
      \let foldSuccessor:
        mulSet a (addSet b (mulSet b c)) = mulSet a (mulSet b (Nat^::succ c)) :=
        congr!{Nat^ Nat^} (mulSet a) _ _ (sym!{Nat^} _ _ (mulSuccRight b c));
      \return trans!{Nat^} _ _ _ (mulSuccRight (mulSet a b) c)
        (trans!{Nat^} _ _ _ inductionUnderAddition
          (trans!{Nat^} _ _ _ factorLeft foldSuccessor));
    })
    };

\definition zeroEqSuccElim (n: Nat^) (P: \Prop) (e: Nat^::zero = Nat^::succ n): P :=
    B.absurd P
      (sym!{B.Bool^} B.Bool^::true B.Bool^::false
        (congr!{Nat^ B.Bool^} isZeroSet Nat^::zero (Nat^::succ n) e));

\definition succEqZeroElim (n: Nat^) (P: \Prop) (e: Nat^::succ n = Nat^::zero): P :=
    B.absurd P
      (congr!{Nat^ B.Bool^} isZeroSet (Nat^::succ n) Nat^::zero e);

\definition mulSuccSucc (a, k: Nat^):
  mulSet (Nat^::succ a) (Nat^::succ k) =
    Nat^::succ (addSet k (mulSet a (Nat^::succ k))) :=
    trans!{Nat^} _ _ _ (mulSuccLeft a (Nat^::succ k))
      (addSuccLeft k (mulSet a (Nat^::succ k)));

/* Multiplication by a successor is injective. */
\definition mulCancelRightSucc: \forall (k, a, b: Nat^) ->
  mulSet a (Nat^::succ k) = mulSet b (Nat^::succ k) -> a = b :=
  \fun (k: Nat^) =>
    \induction (a: Nat^) \return \forall (b: Nat^) ->
        mulSet a (Nat^::succ k) = mulSet b (Nat^::succ k) -> a = b \with {
      | zero => (\induction (b: Nat^) \return mulSet Nat^::zero (Nat^::succ k) = mulSet b (Nat^::succ k) ->
          Nat^::zero = b \with {
        | zero => (\fun (e: mulSet Nat^::zero (Nat^::succ k) =
          mulSet Nat^::zero (Nat^::succ k)) => \refl(Nat^::zero))
        | succ => (\fun (b: Nat^) =>
        \fun (unused: mulSet Nat^::zero (Nat^::succ k) =
          mulSet b (Nat^::succ k) -> Nat^::zero = b) =>
        \fun (e: mulSet Nat^::zero (Nat^::succ k) =
          mulSet (Nat^::succ b) (Nat^::succ k)) =>
          zeroEqSuccElim
            (addSet k (mulSet b (Nat^::succ k)))
            (Nat^::zero = Nat^::succ b)
            (trans!{Nat^} _ _ _
              (sym!{Nat^} _ _ (mulZeroLeft (Nat^::succ k)))
              (trans!{Nat^} _ _ _ e (mulSuccSucc b k))))
        })
      | succ => (\fun (a: Nat^) =>
      \fun (ih: \forall (b: Nat^) ->
        mulSet a (Nat^::succ k) = mulSet b (Nat^::succ k) -> a = b) =>
        \induction (b: Nat^) \return mulSet (Nat^::succ a) (Nat^::succ k) =
              mulSet b (Nat^::succ k) -> Nat^::succ a = b \with {
        | zero => (\fun (e: mulSet (Nat^::succ a) (Nat^::succ k) =
            mulSet Nat^::zero (Nat^::succ k)) =>
            succEqZeroElim
              (addSet k (mulSet a (Nat^::succ k)))
              (Nat^::succ a = Nat^::zero)
              (trans!{Nat^} _ _ _
                (sym!{Nat^} _ _ (mulSuccSucc a k))
                (trans!{Nat^} _ _ _ e (mulZeroLeft (Nat^::succ k)))))
        | succ => (\fun (b: Nat^) =>
          \fun (unused: mulSet (Nat^::succ a) (Nat^::succ k) =
            mulSet b (Nat^::succ k) -> Nat^::succ a = b) =>
          \fun (e: mulSet (Nat^::succ a) (Nat^::succ k) =
            mulSet (Nat^::succ b) (Nat^::succ k)) =>
            succCong a b
              (ih b
                (addCancelLeft k
                  (mulSet a (Nat^::succ k))
                  (mulSet b (Nat^::succ k))
                  (succInjective
                    (addSet k (mulSet a (Nat^::succ k)))
                    (addSet k (mulSet b (Nat^::succ k)))
                    (trans!{Nat^} _ _ _
                      (sym!{Nat^} _ _ (mulSuccSucc a k))
                      (trans!{Nat^} _ _ _ e (mulSuccSucc b k)))))))
        })
      };

/* General Law views of the arithmetic theorems above. */
\definition addCommutative: Law.Commutative Nat^ addSet :=
  \fun (a, b: Nat^) => addComm a b;
\definition addAssociative: Law.Associative Nat^ addSet :=
  \fun (a, b, c: Nat^) => addAssoc a b c;
\definition mulCommutative: Law.Commutative Nat^ mulSet :=
  \fun (a, b: Nat^) => mulComm a b;
\definition mulAssociative: Law.Associative Nat^ mulSet :=
  \fun (a, b, c: Nat^) => mulAssoc a b c;
\definition mulLeftDistributive: Law.LeftDistributive Nat^ mulSet addSet :=
  mulDistribLeft;
\definition mulRightDistributive: Law.RightDistributive Nat^ mulSet addSet :=
  \fun (a, b, c: Nat^) => mulDistribRight a b c;

\module Division;

\module Order;
