/* Projection specifications and reusable invariants for finite iterations. */
\definition firstMatchesPrec: \forall (p: NatPair) -> P.Times[Nat, Nat]::first^ p = natPairFirst p :=
  natPairElim (\fun (p: NatPair) => P.Times[Nat, Nat]::first^ p = natPairFirst p) (\fun (a, b: Nat^) => \refl(a));
\definition secondMatchesPrec: \forall (p: NatPair) -> P.Times[Nat, Nat]::second^ p = natPairSecond p :=
  natPairElim (\fun (p: NatPair) => P.Times[Nat, Nat]::second^ p = natPairSecond p) (\fun (a, b: Nat^) => \refl(b));
\definition pairIterInvariant (f: NatPair -> NatPair) (P: NatPair -> \Prop):
  (\forall (p: NatPair) -> P p -> P (f p)) -> \forall (n: Nat^) -> \forall (p: NatPair) -> P p -> P (pairIterPrec f p n) := \fun (step: \forall (p: NatPair) -> P p -> P (f p)) =>
    \induction (n: Nat^) \return \forall (p: NatPair) -> P p -> P (pairIterPrec f p n) \with {
      | zero => (\fun (p: NatPair) => \fun (h: P p) => h)
      | succ => (\fun (n: Nat^) => \fun (ih: \forall (p: NatPair) -> P p -> P (pairIterPrec f p n)) =>
        \fun (p: NatPair) => \fun (h: P p) => step (pairIterPrec f p n) (ih p h))
      };
\definition leSuccOfEqbFalse: \forall (d, r: Nat^) -> Le r d -> eqb^ r d = B.Bool^::false -> Le (Nat^::succ r) d :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Le r d -> eqb^ r d = B.Bool^::false -> Le (Nat^::succ r) d \with {
    | zero => (\induction (r: Nat^) \return Le r Nat^::zero -> eqb^ r Nat^::zero = B.Bool^::false -> Le (Nat^::succ r) Nat^::zero \with {
      | zero => (\fun (h: Le Nat^::zero Nat^::zero) => \fun (e: B.Bool^::true = B.Bool^::false) =>
        B.absurd (Le (Nat^::succ Nat^::zero) Nat^::zero)
          (\idelim(B.Bool^::true = B.Bool^::false \with t: B.Bool^ => t = B.Bool^::true) \by { base: \refl(B.Bool^::true), equality: e }))
      | succ => (\fun (r: Nat^) => \fun (ih: Le r Nat^::zero -> eqb^ r Nat^::zero = B.Bool^::false -> Le (Nat^::succ r) Nat^::zero) =>
        \fun (h: Le (Nat^::succ r) Nat^::zero) => \fun (e: eqb^ (Nat^::succ r) Nat^::zero = B.Bool^::false) =>
          B.absurd (Le (Nat^::succ (Nat^::succ r)) Nat^::zero) h)
      })
    | succ => (\fun (d: Nat^) => \fun (ih: \forall (r: Nat^) -> Le r d -> eqb^ r d = B.Bool^::false -> Le (Nat^::succ r) d) =>
      \induction (r: Nat^) \return Le r (Nat^::succ d) -> eqb^ r (Nat^::succ d) = B.Bool^::false -> Le (Nat^::succ r) (Nat^::succ d) \with {
      | zero => (\fun (h: Le Nat^::zero (Nat^::succ d)) => \fun (e: eqb^ Nat^::zero (Nat^::succ d) = B.Bool^::false) => zeroLe d)
      | succ => (\fun (r: Nat^) => \fun (unused: Le r (Nat^::succ d) -> eqb^ r (Nat^::succ d) = B.Bool^::false -> Le (Nat^::succ r) (Nat^::succ d)) =>
          \fun (h: Le (Nat^::succ r) (Nat^::succ d)) => \fun (e: eqb^ (Nat^::succ r) (Nat^::succ d) = B.Bool^::false) => ih r h e)
      })
    };
\definition divModNextBound: \forall (d: Nat^) -> \forall (p: NatPair) -> Le (P.Times[Nat, Nat]::second^ p) d ->
  Le (P.Times[Nat, Nat]::second^ (divModNextPrec (Nat^::succ d) p)) d :=
  \fun (d: Nat^) => natPairElim
    (\fun (p: NatPair) => Le (P.Times[Nat, Nat]::second^ p) d -> Le (P.Times[Nat, Nat]::second^ (divModNextPrec (Nat^::succ d) p)) d)
    (\fun (q, r: Nat^) => \fun (h: Le r d) =>
      (\case (eqb^ r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => eqb^ r d = hit ->
          Le (P.Times[Nat, Nat]::second^ (pairChoosePrec hit (natPair (Nat^::succ q) Nat^::zero) (natPair q (Nat^::succ r)))) d) {
        | false => (\fun (e: eqb^ r d = B.Bool^::false) => leSuccOfEqbFalse d r h e)
        | true => (\fun (e: eqb^ r d = B.Bool^::true) => zeroLe d)
        }) (\refl(eqb^ r d)));
\definition modPrecBound (a, d: Nat^): Le (modPrec a (Nat^::succ d)) d := pairIterInvariant (divModNextPrec (Nat^::succ d))
    (\fun (p: NatPair) => Le (P.Times[Nat, Nat]::second^ p) d) (divModNextBound d) a
    (natPair Nat^::zero Nat^::zero) (zeroLe d);
\definition modBound (a, d: Nat^): Le (mod^ a (Nat^::succ d)) d :=
    \idelim(modPrec a (Nat^::succ d) = mod^ a (Nat^::succ d) \with r: Nat^ => Le r d)
      \by { base: modPrecBound a d, equality: sym!{Nat^} _ _ (modMatchesPrec a (Nat^::succ d)) };

/* Reconstruction holds even at divisor zero. */
\definition divModValue (b: Nat^) (p: NatPair): Nat^ := add^ (mul^ b (P.Times[Nat, Nat]::first^ p)) (P.Times[Nat, Nat]::second^ p);
\definition divisionCarryValue: \forall (d, q: Nat^) ->
  divModValue (Nat^::succ d) (natPair (Nat^::succ q) Nat^::zero) =
    Nat^::succ (divModValue (Nat^::succ d) (natPair q d)) :=
  \block {
    \fix (d, q: Nat^);
    \let carryProduct:
      mul^ (Nat^::succ d) (Nat^::succ q) =
        add^ (Nat^::succ d) (mul^ (Nat^::succ d) q) :=
      mulSuccRight (Nat^::succ d) q;
    \let exposeSuccessor:
      add^ (Nat^::succ d) (mul^ (Nat^::succ d) q) =
        Nat^::succ (add^ d (mul^ (Nat^::succ d) q)) :=
      addSuccLeft d (mul^ (Nat^::succ d) q);
    \return trans!{Nat^} _ _ _ carryProduct
      (trans!{Nat^} _ _ _ exposeSuccessor
        (succCong _ _ (addComm d (mul^ (Nat^::succ d) q))));
  };
\definition divModNextValue: \forall (b: Nat^) -> \forall (p: NatPair) ->
  divModValue b (divModNextPrec b p) = Nat^::succ (divModValue b p) :=
  \fun (b: Nat^) => natPairElim
    (\fun (p: NatPair) => divModValue b (divModNextPrec b p) = Nat^::succ (divModValue b p))
    (\fun (q, r: Nat^) => \induction (b: Nat^) \return divModValue b (divModNextPrec b (natPair q r)) = Nat^::succ (divModValue b (natPair q r)) \with {
      | zero => (addSuccRight (mul^ Nat^::zero q) r)
      | succ => (\fun (d: Nat^) => \fun (_: _) => (\case (eqb^ r d) \in B.Bool^ \return (\fun (hit: B.Bool^) => eqb^ r d = hit ->
            divModValue (Nat^::succ d) (pairChoosePrec hit (natPair (Nat^::succ q) Nat^::zero) (natPair q (Nat^::succ r))) =
              Nat^::succ (divModValue (Nat^::succ d) (natPair q r))) {
        | false => (\fun (e: eqb^ r d = B.Bool^::false) => addSuccRight (mul^ (Nat^::succ d) q) r)
        | true => (\fun (e: eqb^ r d = B.Bool^::true) =>
            \idelim(d = r \with x: Nat^ =>
              divModValue (Nat^::succ d) (natPair (Nat^::succ q) Nat^::zero) =
                Nat^::succ (divModValue (Nat^::succ d) (natPair q x)))
              \by { base: divisionCarryValue d q, equality: sym!{Nat^} r d (eqOfEqbTrue d r e) })
        }) (\refl(eqb^ r d)))
      } b);
\definition divModPrecReconstructs: \forall (a, b: Nat^) -> divModValue b (divModPrec a b) = a :=
  \induction (a: Nat^) \return \forall (b: Nat^) -> divModValue b (divModPrec a b) = a \with {
    | zero => (\fun (b: Nat^) => \refl(Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: \forall (b: Nat^) -> divModValue b (divModPrec a b) = a) => \fun (b: Nat^) =>
      trans!{Nat^} _ _ _ (divModNextValue b (divModPrec a b)) (succCong _ _ (ih b)))
    };
\definition divModReconstructs: \forall (a, b: Nat^) -> add^ (mul^ b (div^ a b)) (mod^ a b) = a :=
  \block {
    \fix (a, b: Nat^);
    \let representationMatches:
      divModValue b (divMod^ a b) = divModValue b (divModPrec a b) :=
      congr!{NatPair Nat^} (divModValue b) _ _ (divModMatchesPrec a b);
    \return trans!{Nat^} _ _ _ representationMatches (divModPrecReconstructs a b);
  };

/* The Euclidean loop's bound is proved, rather than assumed as fuel. */
\definition gcdIterZero: \forall (n, a: Nat^) ->
  pairIterPrec gcdNext^ (natPair a Nat^::zero) n = natPair a Nat^::zero :=
  \induction (n: Nat^) \return \forall (a: Nat^) -> pairIterPrec gcdNext^ (natPair a Nat^::zero) n = natPair a Nat^::zero \with {
    | zero => (\fun (a: Nat^) => \refl(natPair a Nat^::zero))
    | succ => (\fun (n: Nat^) => \fun (ih: \forall (a: Nat^) -> pairIterPrec gcdNext^ (natPair a Nat^::zero) n = natPair a Nat^::zero) =>
      \fun (a: Nat^) => congr!{NatPair NatPair} gcdNext^ _ _ (ih a))
    };
\definition gcdIterSettles: \forall (n, a, b: Nat^) -> Le b n ->
  P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ (natPair a b) n) = Nat^::zero :=
  \induction (n: Nat^) \return \forall (a, b: Nat^) -> Le b n -> P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ (natPair a b) n) = Nat^::zero \with {
    | zero => (\fun (a, b: Nat^) => \fun (h: Le b Nat^::zero) => leZeroEq b h)
    | succ => (\fun (n: Nat^) => \fun (ih: \forall (a, b: Nat^) -> Le b n -> P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ (natPair a b) n) = Nat^::zero) =>
      \fun (a: Nat^) => \induction (b: Nat^) \return Le b (Nat^::succ n) -> P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ (natPair a b) (Nat^::succ n)) = Nat^::zero \with {
      | zero => (\fun (h: Le Nat^::zero (Nat^::succ n)) => congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (gcdIterZero (Nat^::succ n) a))
      | succ => (\fun (d: Nat^) => \fun (unused: Le d (Nat^::succ n) -> P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ (natPair a d) (Nat^::succ n)) = Nat^::zero) =>
          \fun (h: Le (Nat^::succ d) (Nat^::succ n)) =>
            \idelim(pairIterPrec gcdNext^ (gcdNext^ (natPair a (Nat^::succ d))) n =
                gcdNext^ (pairIterPrec gcdNext^ (natPair a (Nat^::succ d)) n)
              \with p: NatPair => P.Times[Nat, Nat]::second^ p = Nat^::zero)
              \by { base: ih (Nat^::succ d) (mod^ a (Nat^::succ d))
                (leTrans (mod^ a (Nat^::succ d)) d n (modBound a d) h), equality:
                pairIterPrecStep gcdNext^ n (natPair a (Nat^::succ d)) })
      })
    };
\definition gcdRemainderZero: \forall (a, b: Nat^) ->
  P.Times[Nat, Nat]::second^ (pairIter^ gcdNext^ (natPair a b) b) = Nat^::zero :=
  \block {
    \fix (a, b: Nat^);
    \let iterationMatches:
      P.Times[Nat, Nat]::second^ (pairIter^ gcdNext^ (natPair a b) b) =
        P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ (natPair a b) b) :=
      congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _
        (pairIterMatchesPrec gcdNext^ b (natPair a b));
    \return trans!{Nat^} _ _ _ iterationMatches
      (gcdIterSettles b a b (leRefl b));
  };

/* Zero conventions and division of zero are universal equations. */
\definition divModZeroDivisor: \forall (a: Nat^) -> divModPrec a Nat^::zero = natPair Nat^::zero a :=
  \induction (a: Nat^) \return divModPrec a Nat^::zero = natPair Nat^::zero a \with {
    | zero => (\refl(natPair Nat^::zero Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: divModPrec a Nat^::zero = natPair Nat^::zero a) =>
      congr!{NatPair NatPair} (divModNextPrec Nat^::zero) (divModPrec a Nat^::zero) (natPair Nat^::zero a) ih)
    };
\definition divZeroRight (a: Nat^): div^ a Nat^::zero = Nat^::zero := trans!{Nat^} _ _ _ (divMatchesPrec a Nat^::zero) (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModZeroDivisor a));
\definition modZeroRight (a: Nat^): mod^ a Nat^::zero = a := trans!{Nat^} _ _ _ (modMatchesPrec a Nat^::zero) (congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModZeroDivisor a));
\definition divZeroLeft (b: Nat^): div^ Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
\definition modZeroLeft (b: Nat^): mod^ Nat^::zero b = Nat^::zero := \refl(Nat^::zero);
\definition gcdZeroRight (a: Nat^): gcd^ a Nat^::zero = a := \refl(a);
\definition gcdZeroLeft: \forall (b: Nat^) -> gcd^ Nat^::zero b = b :=
  \induction (b: Nat^) \return gcd^ Nat^::zero b = b \with {
    | zero => (\refl(Nat^::zero))
    | succ => (\fun (d: Nat^) => \fun (ih: gcd^ Nat^::zero d = d) => trans!{Nat^} _ _ _
      (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (pairIterMatchesPrec gcdNext^ d (natPair (Nat^::succ d) Nat^::zero)))
      (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (gcdIterZero d (Nat^::succ d))))
    };

/* Divisibility is constructive: a proof supplies a natural-number factor to
 * any propositional consumer (the usual existential encoding). */
\definition Divides (d, a: Nat^): \Prop := \forall (P: \Prop) -> (\forall (q: Nat^) -> a = mul^ d q -> P) -> P;
\definition dividesIntro (d, a, q: Nat^) (e: a = mul^ d q): Divides d a := \fun (P: \Prop) =>
    \fun (use: \forall (q: Nat^) -> a = mul^ d q -> P) => use q e;
\definition dividesZero (d: Nat^): Divides d Nat^::zero := dividesIntro d Nat^::zero Nat^::zero (\refl(Nat^::zero));
\definition dividesSelf (d: Nat^): Divides d d := dividesIntro d d (Nat^::succ Nat^::zero) (sym!{Nat^} _ _ (mulOneRight d));
\definition dividesTransport (d: Nat^): \forall (a, b: Nat^) -> a = b -> Divides d a -> Divides d b :=
  transport!{Nat^} (Divides d);
\definition dividesAdd (d, a, b: Nat^) (ha: Divides d a) (hb: Divides d b): Divides d (add^ a b) :=
    ha (Divides d (add^ a b)) (\fun (x: Nat^) => \fun (ex: a = mul^ d x) =>
      hb (Divides d (add^ a b)) (\fun (y: Nat^) => \fun (ey: b = mul^ d y) =>
        dividesIntro d (add^ a b) (add^ x y)
          (trans!{Nat^} _ _ _ (addCong _ _ _ _ ex ey) (sym!{Nat^} _ _ (mulDistribLeft d x y)))));
\definition dividesMul (d, a, b: Nat^) (ha: Divides d a): Divides d (mul^ a b) :=
    ha (Divides d (mul^ a b)) (\fun (x: Nat^) => \fun (ex: a = mul^ d x) =>
      dividesIntro d (mul^ a b) (mul^ x b)
        (trans!{Nat^} _ _ _ (congr!{Nat^ Nat^} (\fun (n: Nat^) => mul^ n b) _ _ ex) (mulAssoc d x b)));
\definition subCong: \forall (a, b, c, d: Nat^) -> a = b -> c = d -> sub^ a c = sub^ b d :=
  congr2!{Nat^ Nat^ Nat^} sub^;
\definition subAddBoth: \forall (c, a, b: Nat^) -> sub^ (add^ a c) (add^ b c) = sub^ a b :=
  \induction (c: Nat^) \return \forall (a, b: Nat^) -> sub^ (add^ a c) (add^ b c) = sub^ a b \with {
    | zero => (\fun (a, b: Nat^) => \refl(sub^ a b))
    | succ => (\fun (c: Nat^) => \fun (ih: \forall (a, b: Nat^) -> sub^ (add^ a c) (add^ b c) = sub^ a b) =>
      \fun (a, b: Nat^) => trans!{Nat^} _ _ _
        (subCong _ _ _ _ (addSuccRight a c) (addSuccRight b c)) (ih a b))
    };
\definition mulSub (d: Nat^): \forall (b, a: Nat^) -> sub^ (mul^ d a) (mul^ d b) = mul^ d (sub^ a b) :=
  \induction (b: Nat^) \return \forall (a: Nat^) -> sub^ (mul^ d a) (mul^ d b) = mul^ d (sub^ a b) \with {
    | zero => (\fun (a: Nat^) => \refl(mul^ d a))
    | succ => (\fun (b: Nat^) => \fun (ih: \forall (a: Nat^) -> sub^ (mul^ d a) (mul^ d b) = mul^ d (sub^ a b)) =>
      \induction (a: Nat^) \return sub^ (mul^ d a) (mul^ d (Nat^::succ b)) = mul^ d (sub^ a (Nat^::succ b)) \with {
      | zero => (trans!{Nat^} _ _ _ (subZeroLeft (mul^ d (Nat^::succ b)))
          (sym!{Nat^} _ _ (congr!{Nat^ Nat^} (mul^ d) _ _ (subZeroLeft (Nat^::succ b)))))
      | succ => (\fun (a: Nat^) => \fun (unused: sub^ (mul^ d a) (mul^ d (Nat^::succ b)) = mul^ d (sub^ a (Nat^::succ b))) =>
          trans!{Nat^} _ _ _ (subCong _ _ _ _ (mulSuccRight d a) (mulSuccRight d b))
            (trans!{Nat^} _ _ _ (subCong _ _ _ _ (addComm d (mul^ d a)) (addComm d (mul^ d b)))
              (trans!{Nat^} _ _ _ (subAddBoth d (mul^ d a) (mul^ d b)) (ih a))))
      })
    };
\definition dividesSub (d, a, b: Nat^) (ha: Divides d a) (hb: Divides d b): Divides d (sub^ a b) :=
    ha (Divides d (sub^ a b)) (\fun (x: Nat^) => \fun (ex: a = mul^ d x) =>
      hb (Divides d (sub^ a b)) (\fun (y: Nat^) => \fun (ey: b = mul^ d y) =>
        dividesIntro d (sub^ a b) (sub^ x y)
          (trans!{Nat^} _ _ _ (subCong _ _ _ _ ex ey) (mulSub d y x))));
\definition modAsSub: \forall (a, b: Nat^) -> mod^ a b = sub^ a (mul^ b (div^ a b)) :=
  \block {
    \fix (a, b: Nat^);
    \let reconstruction:
      add^ (mod^ a b) (mul^ b (div^ a b)) = a :=
      trans!{Nat^} _ _ _
        (addComm (mod^ a b) (mul^ b (div^ a b)))
        (divModReconstructs a b);
    \let subtractReconstruction:
      sub^ (add^ (mod^ a b) (mul^ b (div^ a b)))
        (mul^ b (div^ a b)) =
      sub^ a (mul^ b (div^ a b)) :=
      congr!{Nat^ Nat^} (\fun (x: Nat^) => sub^ x (mul^ b (div^ a b)))
        _ _ reconstruction;
    \return trans!{Nat^} _ _ _
      (sym!{Nat^} _ _ (subAddCancel (mul^ b (div^ a b)) (mod^ a b)))
      subtractReconstruction;
  };
\definition dividesMod: \forall (d, a, b: Nat^) -> Divides d a -> Divides d b -> Divides d (mod^ a b) :=
  \block {
    \fix (d, a, b: Nat^);
    \fix (ha: Divides d a), (hb: Divides d b);
    \let productDivides: Divides d (mul^ b (div^ a b)) :=
      dividesMul d b (div^ a b) hb;
    \let differenceDivides: Divides d (sub^ a (mul^ b (div^ a b))) :=
      dividesSub d a (mul^ b (div^ a b)) ha productDivides;
    \return dividesTransport d (sub^ a (mul^ b (div^ a b))) (mod^ a b)
      (sym!{Nat^} _ _ (modAsSub a b)) differenceDivides;
  };
\definition dividesOfMod: \forall (d, a, b: Nat^) -> Divides d b -> Divides d (mod^ a b) -> Divides d a :=
  \block {
    \fix (d, a, b: Nat^);
    \fix (hb: Divides d b), (hr: Divides d (mod^ a b));
    \let quotientProductDivides: Divides d (mul^ b (div^ a b)) :=
      dividesMul d b (div^ a b) hb;
    \let reconstructionDivides:
      Divides d (add^ (mul^ b (div^ a b)) (mod^ a b)) :=
      dividesAdd d (mul^ b (div^ a b)) (mod^ a b) quotientProductDivides hr;
    \return dividesTransport d (add^ (mul^ b (div^ a b)) (mod^ a b)) a
      (divModReconstructs a b) reconstructionDivides;
  };

\definition CommonDivisor (d, a, b: Nat^): \Prop := \forall (P: \Prop) -> (Divides d a -> Divides d b -> P) -> P;
\definition commonDivisorIntro (d, a, b: Nat^) (ha: Divides d a) (hb: Divides d b): CommonDivisor d a b :=
    \fun (P: \Prop) => \fun (use: Divides d a -> Divides d b -> P) => use ha hb;
\definition gcdNextPreserves: \forall (d: Nat^) -> \forall (p: NatPair) -> CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) ->
  CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdNext^ p)) (P.Times[Nat, Nat]::second^ (gcdNext^ p)) :=
  \fun (d: Nat^) => natPairElim
    (\fun (p: NatPair) => CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdNext^ p)) (P.Times[Nat, Nat]::second^ (gcdNext^ p)))
    (\fun (a, b: Nat^) => \induction (b: Nat^) \return CommonDivisor d a b ->
        CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdNext^ (natPair a b))) (P.Times[Nat, Nat]::second^ (gcdNext^ (natPair a b))) \with {
          | zero => (\fun (h: CommonDivisor d a Nat^::zero) => h)
          | succ => (\fun (k: Nat^) => \fun (_: _) => \fun (h: CommonDivisor d a (Nat^::succ k)) => h (CommonDivisor d (Nat^::succ k) (mod^ a (Nat^::succ k)))
          (\fun (ha: Divides d a) => \fun (hb: Divides d (Nat^::succ k)) =>
            commonDivisorIntro d (Nat^::succ k) (mod^ a (Nat^::succ k)) hb (dividesMod d a (Nat^::succ k) ha hb)))
          } b);
\definition gcdNextReflects: \forall (d: Nat^) -> \forall (p: NatPair) ->
  CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdNext^ p)) (P.Times[Nat, Nat]::second^ (gcdNext^ p)) -> CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) :=
  \fun (d: Nat^) => natPairElim
    (\fun (p: NatPair) => CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdNext^ p)) (P.Times[Nat, Nat]::second^ (gcdNext^ p)) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p))
    (\fun (a, b: Nat^) => \induction (b: Nat^) \return CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdNext^ (natPair a b))) (P.Times[Nat, Nat]::second^ (gcdNext^ (natPair a b))) ->
        CommonDivisor d a b \with {
          | zero => (\fun (h: CommonDivisor d a Nat^::zero) => h)
          | succ => (\fun (k: Nat^) => \fun (_: _) => \fun (h: CommonDivisor d (Nat^::succ k) (mod^ a (Nat^::succ k))) => h (CommonDivisor d a (Nat^::succ k))
          (\fun (hb: Divides d (Nat^::succ k)) => \fun (hr: Divides d (mod^ a (Nat^::succ k))) =>
            commonDivisorIntro d a (Nat^::succ k) (dividesOfMod d a (Nat^::succ k) hb hr) hb))
          } b);
\definition gcdIterReflects: \forall (d, n: Nat^) -> \forall (p: NatPair) ->
  CommonDivisor d (P.Times[Nat, Nat]::first^ (pairIterPrec gcdNext^ p n)) (P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ p n)) ->
    CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) :=
  \fun (d: Nat^) => \induction (n: Nat^) \return \forall (p: NatPair) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ (pairIterPrec gcdNext^ p n)) (P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ p n)) ->
        CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p) \with {
    | zero => (\fun (p: NatPair) => \fun (h: CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p)) => h)
    | succ => (\fun (n: Nat^) => \fun (ih: \forall (p: NatPair) ->
      CommonDivisor d (P.Times[Nat, Nat]::first^ (pairIterPrec gcdNext^ p n)) (P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ p n)) ->
        CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p)) =>
      \fun (p: NatPair) => \fun (h: CommonDivisor d (P.Times[Nat, Nat]::first^ (pairIterPrec gcdNext^ p (Nat^::succ n)))
        (P.Times[Nat, Nat]::second^ (pairIterPrec gcdNext^ p (Nat^::succ n)))) =>
          ih p (gcdNextReflects d (pairIterPrec gcdNext^ p n) h))
    };
\definition gcdFinal (a, b: Nat^): NatPair := pairIterPrec gcdNext^ (natPair a b) b;
\definition gcdFinalFirst (a, b: Nat^): P.Times[Nat, Nat]::first^ (gcdFinal a b) = gcd^ a b := sym!{Nat^} _ _ (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (pairIterMatchesPrec gcdNext^ b (natPair a b)));
\definition gcdFinalSecond (a, b: Nat^): P.Times[Nat, Nat]::second^ (gcdFinal a b) = Nat^::zero := gcdIterSettles b a b (leRefl b);
\definition gcdCommonDivisor: \forall (a, b: Nat^) -> CommonDivisor (gcd^ a b) a b :=
  \block {
    \fix (a, b: Nat^);
    \let finalFirstDivides: Divides (gcd^ a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b)) :=
      dividesTransport (gcd^ a b) (gcd^ a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b))
        (sym!{Nat^} _ _ (gcdFinalFirst a b)) (dividesSelf (gcd^ a b));
    \let finalSecondDivides: Divides (gcd^ a b) (P.Times[Nat, Nat]::second^ (gcdFinal a b)) :=
      dividesTransport (gcd^ a b) Nat^::zero (P.Times[Nat, Nat]::second^ (gcdFinal a b))
        (sym!{Nat^} _ _ (gcdFinalSecond a b)) (dividesZero (gcd^ a b));
    \let finalCommonDivisor:
      CommonDivisor (gcd^ a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b)) (P.Times[Nat, Nat]::second^ (gcdFinal a b)) :=
      commonDivisorIntro (gcd^ a b) (P.Times[Nat, Nat]::first^ (gcdFinal a b))
        (P.Times[Nat, Nat]::second^ (gcdFinal a b)) finalFirstDivides finalSecondDivides;
    \return gcdIterReflects (gcd^ a b) b (natPair a b) finalCommonDivisor;
  };
\definition gcdDividesLeft (a, b: Nat^): Divides (gcd^ a b) a := gcdCommonDivisor a b (Divides (gcd^ a b) a)
    (\fun (ha: Divides (gcd^ a b) a) => \fun (hb: Divides (gcd^ a b) b) => ha);
\definition gcdDividesRight (a, b: Nat^): Divides (gcd^ a b) b := gcdCommonDivisor a b (Divides (gcd^ a b) b)
    (\fun (ha: Divides (gcd^ a b) a) => \fun (hb: Divides (gcd^ a b) b) => hb);
\definition gcdGreatest: \forall (d, a, b: Nat^) -> Divides d a -> Divides d b -> Divides d (gcd^ a b) :=
  \block {
    \fix (d, a, b: Nat^);
    \fix (ha: Divides d a), (hb: Divides d b);
    \let finalCommonDivisor:
      CommonDivisor d (P.Times[Nat, Nat]::first^ (gcdFinal a b)) (P.Times[Nat, Nat]::second^ (gcdFinal a b)) :=
      pairIterInvariant gcdNext^
        (\fun (p: NatPair) => CommonDivisor d (P.Times[Nat, Nat]::first^ p) (P.Times[Nat, Nat]::second^ p))
        (gcdNextPreserves d) b (natPair a b) (commonDivisorIntro d a b ha hb);
    \return finalCommonDivisor (Divides d (gcd^ a b))
      (\fun (hfirst: Divides d (P.Times[Nat, Nat]::first^ (gcdFinal a b))) =>
        \fun (hsecond: Divides d (P.Times[Nat, Nat]::second^ (gcdFinal a b))) =>
          dividesTransport d (P.Times[Nat, Nat]::first^ (gcdFinal a b)) (gcd^ a b)
            (gcdFinalFirst a b) hfirst);
  };

\definition leToLtSucc: \forall (d, r: Nat^) -> Le r d -> Lt r (Nat^::succ d) :=
  \induction (d: Nat^) \return \forall (r: Nat^) -> Le r d -> Lt r (Nat^::succ d) \with {
    | zero => (\induction (r: Nat^) \return Le r Nat^::zero -> Lt r (Nat^::succ Nat^::zero) \with {
      | zero => (\fun (h: Le Nat^::zero Nat^::zero) => \refl(B.Bool^::true))
      | succ => (\fun (r: Nat^) => \fun (ih: Le r Nat^::zero -> Lt r (Nat^::succ Nat^::zero)) =>
        \fun (h: Le (Nat^::succ r) Nat^::zero) => B.absurd (Lt (Nat^::succ r) (Nat^::succ Nat^::zero)) h)
      })
    | succ => (\fun (d: Nat^) => \fun (ih: \forall (r: Nat^) -> Le r d -> Lt r (Nat^::succ d)) =>
      \induction (r: Nat^) \return Le r (Nat^::succ d) -> Lt r (Nat^::succ (Nat^::succ d)) \with {
      | zero => (\fun (h: Le Nat^::zero (Nat^::succ d)) => \refl(B.Bool^::true))
      | succ => (\fun (r: Nat^) => \fun (unused: Le r (Nat^::succ d) -> Lt r (Nat^::succ (Nat^::succ d))) =>
          \fun (h: Le (Nat^::succ r) (Nat^::succ d)) => ih r h)
      })
    };
\definition modLt (a, d: Nat^): Lt (mod^ a (Nat^::succ d)) (Nat^::succ d) := leToLtSucc d (mod^ a (Nat^::succ d)) (modBound a d);
\definition divModOne: \forall (a: Nat^) -> divModPrec a (Nat^::succ Nat^::zero) = natPair a Nat^::zero :=
  \induction (a: Nat^) \return divModPrec a (Nat^::succ Nat^::zero) = natPair a Nat^::zero \with {
    | zero => (\refl(natPair Nat^::zero Nat^::zero))
    | succ => (\fun (a: Nat^) => \fun (ih: divModPrec a (Nat^::succ Nat^::zero) = natPair a Nat^::zero) =>
      congr!{NatPair NatPair} (divModNextPrec (Nat^::succ Nat^::zero))
        (divModPrec a (Nat^::succ Nat^::zero)) (natPair a Nat^::zero) ih)
    };
\definition divOne (a: Nat^): div^ a (Nat^::succ Nat^::zero) = a := trans!{Nat^} _ _ _ (divMatchesPrec a (Nat^::succ Nat^::zero)) (congr!{NatPair Nat^} P.Times[Nat, Nat]::first^ _ _ (divModOne a));
\definition modOne (a: Nat^): mod^ a (Nat^::succ Nat^::zero) = Nat^::zero := trans!{Nat^} _ _ _ (modMatchesPrec a (Nat^::succ Nat^::zero)) (congr!{NatPair Nat^} P.Times[Nat, Nat]::second^ _ _ (divModOne a));
