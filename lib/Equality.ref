/* Equality is independent of arithmetic. Proof templates specialize the carrier
 * before elaboration: this avoids quantifying a proposition over Set, and keeps
 * local datatypes valid when their enclosing module is instantiated again. */
\macro sym($A) :=
  (\fun (law: \forall (a, b: $A) -> a = b -> b = a) => law)
  (\fun (a, b: $A) => \fun (e: a = b) =>
    \idelim(a = b \with x: $A => x = a) \by (\refl(a), e));

\macro trans($A) :=
  (\fun (law: \forall (a, b, c: $A) -> a = b -> b = c -> a = c) => law)
  (\fun (a, b, c: $A) => \fun (ab: a = b) => \fun (bc: b = c) =>
    \idelim(b = c \with x: $A => a = x) \by (ab, bc));

\macro transport($A) :=
  (\fun (law: \forall (P: $A -> \Prop) -> \forall (a, b: $A) -> a = b -> P a -> P b) => law)
  (\fun (P: $A -> \Prop) => \fun (a, b: $A) => \fun (e: a = b) => \fun (p: P a) =>
    \idelim(a = b \with x: $A => P x) \by (p, e));

\macro congr($A, $B) :=
  (\fun (law: \forall (f: $A -> $B) -> \forall (a, b: $A) -> a = b -> f a = f b) => law)
  (\fun (f: $A -> $B) => \fun (a, b: $A) => \fun (e: a = b) =>
      \idelim(a = b \with x: $A => f a = f x) \by (\refl(f a), e));

\macro congr2($A, $B, $C) :=
  (\fun (law: \forall (f: $A -> $B -> $C) -> \forall (a, b: $A) -> \forall (c, d: $B) -> a = b -> c = d -> f a c = f b d) => law)
  (\fun (f: $A -> $B -> $C) => \fun (a, b: $A) => \fun (c, d: $B) => \fun (ab: a = b) => \fun (cd: c = d) =>
      \idelim(c = d \with y: $B => f a c = f b y)
      \by (\idelim(a = b \with x: $A => f a c = f x c)
        \by (\refl(f a c), ab), cd));

\macro congr3($A, $B, $C, $D) :=
  (\fun (law: \forall (f: $A -> $B -> $C -> $D) -> \forall (a, b: $A) -> \forall (c, d: $B) -> \forall (e, g: $C) -> a = b -> c = d -> e = g -> f a c e = f b d g) => law)
  (\fun (f: $A -> $B -> $C -> $D) => \fun (a, b: $A) => \fun (c, d: $B) => \fun (e, g: $C) =>
      \fun (ab: a = b) => \fun (cd: c = d) => \fun (eg: e = g) =>
        \idelim(e = g \with z: $C => f a c e = f b d z)
        \by (\idelim(c = d \with y: $B => f a c e = f b y e)
          \by (\idelim(a = b \with x: $A => f a c e = f x c e)
            \by (\refl(f a c e), ab), cd), eg));

/* A checked, named API is also available for a fixed carrier. */
\module Laws(A: \Set);
