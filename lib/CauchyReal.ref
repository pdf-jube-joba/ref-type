/*
 * Cauchy reals over the concrete rational representatives from Rat.ref.
 *
 * A real is not a chosen Cauchy sequence.  It is an actual equivalence
 * class: a subset of CauchySeq containing exactly the sequences equivalent
 * to one representative.  Kernel equality is therefore the right equality
 * for reals once extensionality of subsets of CauchySeq is supplied.
 */
  \import \root.Logic() \as Logic;
  \import \root.Rat() \as Rational;
  \use Logic.and;

  \definition Rat: \Set := Rational.Fraction;

  \definition zeroRat: Rat := Rational.zero;

  \definition addRat: Rat -> Rat -> Rat :=
    (x, y: Rat) => Rational.add x y;

  \definition negRat: Rat -> Rat :=
    (x: Rat) => Rational.neg x;

  \definition subRat: Rat -> Rat -> Rat :=
    (x, y: Rat) => Rational.sub x y;

  \definition ltRat: Rat -> Rat -> \Prop :=
    (x, y: Rat) => Rational.lt x y;

  /* Sequence indices share the natural-number foundation from Rat.ref. */
  \definition Nat: \Set := Rational.Nat;

  \definition NatLe: Nat -> Nat -> \Prop :=
    (lower, upper: Nat) => Rational.NatLe lower upper;

  \definition Positive: Rat -> \Prop :=
    (eps: Rat) => ltRat zeroRat eps;

  /* |x-y| < eps, stated without a separate absolute-value operation. */
  \definition Close: Rat -> Rat -> Rat -> \Prop :=
    (x, y: Rat) => (eps: Rat) =>
      and!{(ltRat (subRat x y) eps) (ltRat (subRat y x) eps)};

  \definition Sequence: \Set := Nat -> Rat;

  /* N witnesses that all entries after N are eps-close. */
  \definition CauchyAt: Sequence -> Rat -> Nat -> \Prop :=
    (seq: Sequence) => (eps: Rat) => (N: Nat) =>
      (m, n: Nat) -> NatLe N m -> NatLe N n ->
        Close (seq m) (seq n) eps;

  \definition IsCauchy: Sequence -> \Prop :=
    (seq: Sequence) =>
      (eps: Rat) -> Positive eps ->
        \exists \Ty(Nat, \Subset(N, Nat, CauchyAt seq eps N));

  \definition CauchySet: \Power(Sequence) :=
    \Subset(seq, Sequence, IsCauchy seq);

  \definition CauchySeq: \Set :=
    \Ty(Sequence, CauchySet);

  \definition at: CauchySeq -> Nat -> Rat :=
    (x: CauchySeq) => (n: Nat) => x n;

  /* The difference of two representatives tends to zero. */
  \definition EquivalentAt:
    CauchySeq -> CauchySeq -> Rat -> Nat -> \Prop :=
    (x, y: CauchySeq) => (eps: Rat) => (N: Nat) =>
      (n: Nat) -> NatLe N n ->
        Close (at x n) (at y n) eps;

  \definition Equivalent: CauchySeq -> CauchySeq -> \Prop :=
    (x, y: CauchySeq) =>
      (eps: Rat) -> Positive eps ->
        \exists \Ty(Nat, \Subset(N, Nat, EquivalentAt x y eps N));

  /*
   * The metric laws must make Equivalent an equivalence relation.  Subset
   * extensionality is supplied by the kernel axiom; the metric laws do not
   * follow merely from the names of the rational operations.
   */
  \module Quotient(
    equivalentRefl:
      (x: CauchySeq) -> Equivalent x x,
    equivalentSym:
      (x, y: CauchySeq) -> Equivalent x y -> Equivalent y x,
    equivalentTrans:
      (x, y, z: CauchySeq) ->
        Equivalent x y -> Equivalent y z -> Equivalent x z,
  ) {
    /* The equivalence class represented by x. */
    \definition ClassOf: CauchySeq -> \Power(CauchySeq) :=
      (x: CauchySeq) =>
        \Subset(y, CauchySeq, Equivalent x y);

    /* Equivalent representatives determine the same subset. */
    \definition classOfEq:
      (x, y: CauchySeq) -> Equivalent x y -> ClassOf x = ClassOf y :=
      (x, y: CauchySeq) => (xy: Equivalent x y) =>
        \axiom:setext(ClassOf x, ClassOf y,
          ((z: CauchySeq) => (xz: Equivalent x z) =>
            equivalentTrans y x z (equivalentSym x y xy) xz),
          ((z: CauchySeq) => (yz: Equivalent y z) =>
            equivalentTrans x y z xy yz));

    /*
     * IsClass is the impredicative existential
     *   exists x: CauchySeq, C = ClassOf x.
     * Thus ClassSet is precisely the image of ClassOf.
     */
    \definition IsClass: \Power(CauchySeq) -> \Prop :=
      (C: \Power(CauchySeq)) =>
        (P: \Prop) ->
          ((x: CauchySeq) -> C = ClassOf x -> P) -> P;

    \definition ClassSet: \Power(\Power(CauchySeq)) :=
      \Subset(C, \Power(CauchySeq), IsClass C);

    /* The quotient CauchySeq / Equivalent. */
    \definition Real: \Set :=
      \Ty(\Power(CauchySeq), ClassSet);

    \definition mem: Real -> CauchySeq -> \Prop :=
      (x: Real) => (seq: CauchySeq) =>
        \Pred(CauchySeq, x, seq);

    \definition underlying: Real -> \Power(CauchySeq) :=
      (x: Real) => x;

    /* Equality of reals is kernel equality of their equivalence classes. */
    \definition Eq: Real -> Real -> \Prop :=
      (x, y: Real) => x = y;

    \definition eqByExt:
      (x, y: Real) ->
        ((seq: CauchySeq) -> mem x seq -> mem y seq) ->
        ((seq: CauchySeq) -> mem y seq -> mem x seq) ->
        Eq x y :=
      (x, y: Real) =>
        (xy: (seq: CauchySeq) -> mem x seq -> mem y seq) =>
        (yx: (seq: CauchySeq) -> mem y seq -> mem x seq) =>
          \axiom:setext(underlying x, underlying y, xy, yx);

    /* Every representative gives a genuine member of the quotient. */
    \definition classIsClass:
      (x: CauchySeq) -> IsClass (ClassOf x) :=
      (x: CauchySeq) =>
        (P: \Prop) =>
        (intro: (y: CauchySeq) -> ClassOf x = ClassOf y -> P) =>
          intro x (\refl(ClassOf x));

    \definition class: CauchySeq -> Real :=
      (x: CauchySeq) =>
        \subsetinto(\Power(CauchySeq), ClassSet, ClassOf x, classIsClass x);

    /*
     * Arithmetic is first formed as a relational image of whole classes.
     * No representative is selected.  The closure obligations state that
     * these images are again single equivalence classes.
     */
    \module Operations {
      \definition ConstSeq: Rat -> Sequence :=
        (a: Rat) => (n: Nat) => a;

      \definition AddSeq: CauchySeq -> CauchySeq -> Sequence :=
        (x, y: CauchySeq) => (n: Nat) =>
          addRat (at x n) (at y n);

      \definition NegSeq: CauchySeq -> Sequence :=
        (x: CauchySeq) => (n: Nat) => negRat (at x n);

      \module SequenceClosed(
        constCauchy: (a: Rat) ->
          \Pred(Sequence, CauchySet, ConstSeq a),
        addCauchy: (x, y: CauchySeq) ->
          \Pred(Sequence, CauchySet, AddSeq x y),
        negCauchy: (x: CauchySeq) ->
          \Pred(Sequence, CauchySet, NegSeq x),
      ) {
        \import \root.Logic() \as Logic;

        \definition ConstCauchy: Rat -> CauchySeq :=
          (a: Rat) =>
            \subsetinto(Sequence, CauchySet, ConstSeq a, constCauchy a);

        \definition AddCauchy: CauchySeq -> CauchySeq -> CauchySeq :=
          (x, y: CauchySeq) =>
            \subsetinto(Sequence, CauchySet, AddSeq x y, addCauchy x y);

        \definition NegCauchy: CauchySeq -> CauchySeq :=
          (x: CauchySeq) =>
            \subsetinto(Sequence, CauchySet, NegSeq x, negCauchy x);

        \definition AddClass:
          Real -> Real -> \Power(CauchySeq) :=
          (x, y: Real) =>
            \Subset(z, CauchySeq,
              \exists \Ty(CauchySeq,
                \Subset(a, CauchySeq,
                  Logic.And[mem x a,
                    \exists \Ty(CauchySeq,
                      \Subset(b, CauchySeq,
                        Logic.And[mem y b,
                          Equivalent z (AddCauchy a b)]))])));

        \definition NegClass: Real -> \Power(CauchySeq) :=
          (x: Real) =>
            \Subset(z, CauchySeq,
              \exists \Ty(CauchySeq,
                \Subset(a, CauchySeq,
                  Logic.And[mem x a, Equivalent z (NegCauchy a)])));

        \module ClassClosed(
          addClassIsClass: (x, y: Real) ->
            IsClass (AddClass x y),
          negClassIsClass: (x: Real) ->
            IsClass (NegClass x),
        ) {
          \definition ofRat: Rat -> Real :=
            (a: Rat) => class (ConstCauchy a);

          \definition add: Real -> Real -> Real :=
            (x, y: Real) =>
              \subsetinto(
                \Power(CauchySeq), ClassSet,
                AddClass x y, addClassIsClass x y);

          \definition neg: Real -> Real :=
            (x: Real) =>
              \subsetinto(
                \Power(CauchySeq), ClassSet,
                NegClass x, negClassIsClass x);

          \definition sub: Real -> Real -> Real :=
            (x, y: Real) => add x (neg y);

          \definition zero: Real := ofRat zeroRat;
        }
      }
    }
  }
