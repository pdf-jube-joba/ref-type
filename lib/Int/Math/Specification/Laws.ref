/* Elimination out of the quotient only uses unique-value take. */
\definition mathInduction (P: Grothendieck -> \Prop)
  (step: \forall (x: Difference) -> P (class x)) (C: Grothendieck): P C :=
    \take (x: \Ty(Difference, Representatives C)) =>
      (\idelim(class x = C \with D: \Power(Difference) =>
        \forall (hd: IsClass D) -> P (\subsetinto(\Power(Difference), ClassSet, D, hd)))
      \by ((\fun (hd: IsClass (class x)) => step x),
        \idelim(C = ClassOf x \with D: \Power(Difference) => D = C)
          \by (\refl(C), \bysub(Difference, Representatives C, x)))) (classProperty C)
    \by (representativesExist C);
\definition addMathCongLeft (x, y, z: Grothendieck) (e: x = y): addMath x z = addMath y z :=
    (\idelim(x = y \with C: \Power(Difference) =>
      \forall (hc: IsClass C) -> addMath x z = addMath (\subsetinto(\Power(Difference), ClassSet, C, hc)) z)
      \by ((\fun (hc: IsClass x) => \refl(addMath x z)), e)) (classProperty y);
\definition addRepComm (x, y: Difference): Equivalent (addRep x y) (addRep y x) := equivalentOfFields (addRep x y) (addRep y x)
    (NL.addComm (pos x) (pos y)) (NL.addComm (negPart x) (negPart y));
\definition addRepAssoc (x, y, z: Difference): Equivalent (addRep (addRep x y) z) (addRep x (addRep y z))
    := equivalentOfFields (addRep (addRep x y) z) (addRep x (addRep y z))
    (NL.addAssoc (pos x) (pos y) (pos z)) (NL.addAssoc (negPart x) (negPart y) (negPart z));
\definition addMathZeroLeft: \forall (x: Grothendieck) -> addMath zeroMath x = x :=
  mathInduction (\fun (x: Grothendieck) => addMath zeroMath x = x)
    (\fun (x: Difference) => trans!{\Power(Difference)} _ _ _ (addMathClass (pair natZero!{} natZero!{}) x)
      (classOfEq (addRep (pair natZero!{} natZero!{}) x) x
        (equivalentOfFields (addRep (pair natZero!{} natZero!{}) x) x
          (NL.addZeroLeft (pos x)) (NL.addZeroLeft (negPart x)))));
\definition addMathComm: \forall (x, y: Grothendieck) -> addMath x y = addMath y x :=
  mathInduction (\fun (x: Grothendieck) => \forall (y: Grothendieck) -> addMath x y = addMath y x)
    (\fun (x: Difference) => mathInduction (\fun (y: Grothendieck) => addMath (class x) y = addMath y (class x))
      (\fun (y: Difference) => trans!{\Power(Difference)} _ _ _ (addMathClass x y)
        (trans!{\Power(Difference)} _ _ _ (classOfEq (addRep x y) (addRep y x) (addRepComm x y))
          (sym!{\Power(Difference)} _ _ (addMathClass y x)))));
\definition mulMathComm: \forall (x, y: Grothendieck) -> mulMath x y = mulMath y x :=
  mathInduction (\fun (x: Grothendieck) =>
    \forall (y: Grothendieck) -> mulMath x y = mulMath y x)
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) =>
        mulMath (class x) y = mulMath y (class x))
        (\fun (y: Difference) =>
          trans!{\Power(Difference)} _ _ _ (mulMathClass x y)
            (trans!{\Power(Difference)} _ _ _
              (classOfEq (mulRep x y) (mulRep y x) (mulRepComm x y))
              (sym!{\Power(Difference)} _ _ (mulMathClass y x)))));
\definition addMathZeroRight (x: Grothendieck): addMath x zeroMath = x := trans!{\Power(Difference)} _ _ _ (addMathComm x zeroMath) (addMathZeroLeft x);
\definition addMathAssoc: \forall (x, y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y z) :=
  mathInduction (\fun (x: Grothendieck) => \forall (y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y
    z))
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) => \forall (z: Grothendieck) ->
        addMath (addMath (class x) y) z = addMath (class x) (addMath y z))
        (\fun (y: Difference) =>
          mathInduction (\fun (z: Grothendieck) => addMath (addMath (class x) (class y)) z =
            addMath (class x) (addMath (class y) z))
            (\fun (z: Difference) => trans!{\Power(Difference)} _ _ _
              (addMathCongLeft (addMath (class x) (class y)) (class (addRep x y)) (class z) (addMathClass x
    y))
              (trans!{\Power(Difference)} _ _ _ (addMathClass (addRep x y) z)
                (trans!{\Power(Difference)} _ _ _ (classOfEq (addRep (addRep x y) z) (addRep x (addRep y z)) (addRepAssoc x y
    z))
                  (trans!{\Power(Difference)} _ _ _ (sym!{\Power(Difference)} _ _ (addMathClass x (addRep y z)))
                    (addMathCongRight (class x) (class (addRep y z)) (addMath (class y) (class z))
                      (sym!{\Power(Difference)} _ _ (addMathClass y z)))))))));
\definition negMathInverse: \forall (x: Grothendieck) -> addMath (negMath x) x = zeroMath :=
  mathInduction (\fun (x: Grothendieck) => addMath (negMath x) x = zeroMath)
    (\fun (x: Difference) => trans!{\Power(Difference)} _ _ _
      (addMathCongLeft (negMath (class x)) (class (negRep x)) (class x) (negMathClass x))
      (trans!{\Power(Difference)} _ _ _ (addMathClass (negRep x) x)
        (classOfEq (addRep (negRep x) x) (pair natZero!{} natZero!{})
          (trans!{Nat} _ _ _ (NL.addComm (negPart x) (pos x))
            (sym!{Nat} _ _ (NL.addZeroLeft (N.addSet (pos x) (negPart x))))))));
\definition toMathInjective (x, y: Int^) (e: toMath x = toMath y): x = y :=
    trans!{Int^} x (fromMath (toMath x)) y (sym!{Int^} _ _ (fromTo x))
      ((\idelim(toMath y = toMath x \with C: \Power(Difference) =>
        \forall (hc: IsClass C) -> fromMath (\subsetinto(\Power(Difference), ClassSet, C, hc)) = y)
        \by ((\fun (hc: IsClass (toMath y)) => fromTo y), sym!{\Power(Difference)} (toMath x) (toMath y) e))
        (classProperty (toMath x)));
\definition addComm (x, y: Int^): addSet x y = addSet y x := toMathInjective (addSet x y) (addSet y x)
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath x y)
      (trans!{\Power(Difference)} _ _ _ (addMathComm (toMath x) (toMath y)) (sym!{\Power(Difference)} _ _ (addMatchesMath y x))));
\definition mulComm (x, y: Int^): mulSet x y = mulSet y x := toMathInjective (mulSet x y) (mulSet y x)
    (trans!{\Power(Difference)} _ _ _ (mulMatchesMath x y)
      (trans!{\Power(Difference)} _ _ _
        (mulMathComm (toMath x) (toMath y))
        (sym!{\Power(Difference)} _ _ (mulMatchesMath y x))));
\definition addZeroLeft (x: Int^): addSet zeroSet x = x := toMathInjective (addSet zeroSet x) x
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath zeroSet x) (addMathZeroLeft (toMath x)));
\definition addZeroRight (x: Int^): addSet x zeroSet = x := trans!{Int^} _ _ _ (addComm x zeroSet) (addZeroLeft x);
\definition negInverse (x: Int^): addSet (negSet x) x = zeroSet := toMathInjective (addSet (negSet x) x) zeroSet
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath (negSet x) x)
      (trans!{\Power(Difference)} _ _ _ (addMathCongLeft (toMath (negSet x)) (negMath (toMath x)) (toMath x) (negMatchesMath
    x))
        (negMathInverse (toMath x))));

\definition addAssoc (x, y, z: Int^):
  addSet (addSet x y) z = addSet x (addSet y z) :=
    toMathInjective (addSet (addSet x y) z) (addSet x (addSet y z))
      (trans!{\Power(Difference)} _ _ _ (addMatchesMath (addSet x y) z)
        (trans!{\Power(Difference)} _ _ _
          (addMathCongLeft
            (toMath (addSet x y))
            (addMath (toMath x) (toMath y))
            (toMath z)
            (addMatchesMath x y))
          (trans!{\Power(Difference)} _ _ _
            (addMathAssoc (toMath x) (toMath y) (toMath z))
            (trans!{\Power(Difference)} _ _ _
              (addMathCongRight
                (toMath x)
                (addMath (toMath y) (toMath z))
                (toMath (addSet y z))
                (sym!{\Power(Difference)} _ _ (addMatchesMath y z)))
              (sym!{\Power(Difference)} _ _
                (addMatchesMath x (addSet y z)))))));

\definition negInverseRight (x: Int^):
  addSet x (negSet x) = zeroSet :=
    trans!{Int^} _ _ _ (addComm x (negSet x)) (negInverse x);
