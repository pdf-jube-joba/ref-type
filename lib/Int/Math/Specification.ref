/* Transport a specification across the proved isomorphism once per signature. */
\definition agreementII: \forall (f, g: Int^ -> Int^) -> (\forall (a0: Int^) -> f a0 = g a0) -> \forall (a0: Int^) -> toMath (f a0) =
    toMath (g (fromMath (toMath a0))) :=
  \block {
    \fix (f, g: Int^ -> Int^);
    \fix (matches: \forall (a0: Int^) -> f a0 = g a0);
    \fix (a0: Int^);
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int^ Int^} g a0 (fromMath (toMath a0)) (roundTripArg a0);
    \let resultMatches: f a0 = g (fromMath (toMath a0)) :=
      trans!{Int^} _ _ _ (matches a0) argumentMatches;
    \return toMathCong (f a0) (g (fromMath (toMath a0))) resultMatches;
  };

\definition agreementIN: \forall (f, g: Int^ -> Nat) -> (\forall (a0: Int^) -> f a0 = g a0) -> \forall (a0: Int^) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  \block {
    \fix (f, g: Int^ -> Nat);
    \fix (matches: \forall (a0: Int^) -> f a0 = g a0);
    \fix (a0: Int^);
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int^ Nat} g a0 (fromMath (toMath a0)) (roundTripArg a0);
    \return trans!{Nat} _ _ _ (matches a0) argumentMatches;
  };

\definition agreementIB: \forall (f, g: Int^ -> Bool) -> (\forall (a0: Int^) -> f a0 = g a0) -> \forall (a0: Int^) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  \block {
    \fix (f, g: Int^ -> Bool);
    \fix (matches: \forall (a0: Int^) -> f a0 = g a0);
    \fix (a0: Int^);
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int^ Bool} g a0 (fromMath (toMath a0)) (roundTripArg a0);
    \return trans!{Bool} _ _ _ (matches a0) argumentMatches;
  };

\definition agreementIIB: \forall (f, g: Int^ -> Int^ -> Bool) -> (\forall (a0: Int^) -> \forall (a1: Int^) -> f a0 a1 = g a0 a1) ->
    \forall (a0: Int^) -> \forall (a1: Int^) -> (f a0 a1) = (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  \block {
    \fix (f, g: Int^ -> Int^ -> Bool);
    \fix (matches: \forall (a0: Int^) -> \forall (a1: Int^) -> f a0 a1 = g a0 a1);
    \fix (a0, a1: Int^);
    \let argumentsMatch:
      g a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      congr2!{Int^ Int^ Bool} g
        a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1))
        (roundTripArg a0) (roundTripArg a1);
    \return trans!{Bool} _ _ _ (matches a0 a1) argumentsMatch;
  };

\definition agreementIII: \forall (f, g: Int^ -> Int^ -> Int^) -> (\forall (a0: Int^) -> \forall (a1: Int^) -> f a0 a1 = g a0 a1) -> \forall (a0:
    Int^) -> \forall (a1: Int^) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  \block {
    \fix (f, g: Int^ -> Int^ -> Int^);
    \fix (matches: \forall (a0: Int^) -> \forall (a1: Int^) -> f a0 a1 = g a0 a1);
    \fix (a0, a1: Int^);
    \let argumentsMatch:
      g a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      congr2!{Int^ Int^ Int^} g
        a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1))
        (roundTripArg a0) (roundTripArg a1);
    \let resultMatches:
      f a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      trans!{Int^} _ _ _ (matches a0 a1) argumentsMatch;
    \return toMathCong (f a0 a1)
      (g (fromMath (toMath a0)) (fromMath (toMath a1))) resultMatches;
  };

\definition agreementINI: \forall (f, g: Int^ -> Nat -> Int^) -> (\forall (a0: Int^) -> \forall (a1: Nat) -> f a0 a1 = g a0 a1) ->
    \forall (a0: Int^) -> \forall (a1: Nat) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) a1) :=
  \block {
    \fix (f, g: Int^ -> Nat -> Int^);
    \fix (matches: \forall (a0: Int^) -> \forall (a1: Nat) -> f a0 a1 = g a0 a1);
    \fix (a0: Int^), (a1: Nat);
    \let argumentMatches: g a0 a1 = g (fromMath (toMath a0)) a1 :=
      congr!{Int^ Int^} (\fun (z: Int^) => g z a1)
        a0 (fromMath (toMath a0)) (roundTripArg a0);
    \let resultMatches: f a0 a1 = g (fromMath (toMath a0)) a1 :=
      trans!{Int^} _ _ _ (matches a0 a1) argumentMatches;
    \return toMathCong (f a0 a1) (g (fromMath (toMath a0)) a1) resultMatches;
  };

\definition agreementBIII: \forall (f, g: Bool -> Int^ -> Int^ -> Int^) -> (\forall (a0: Bool) -> \forall (a1: Int^) -> \forall (a2: Int^) -> f
    a0 a1 a2 = g a0 a1 a2) -> \forall (a0: Bool) -> \forall (a1: Int^) -> \forall (a2: Int^) -> toMath (f a0 a1 a2) = toMath (g a0
    (fromMath (toMath a1)) (fromMath (toMath a2))) :=
  \block {
    \fix (f, g: Bool -> Int^ -> Int^ -> Int^);
    \fix (matches: \forall (a0: Bool) -> \forall (a1: Int^) -> \forall (a2: Int^) -> f a0 a1 a2 = g a0 a1 a2);
    \fix (a0: Bool), (a1, a2: Int^);
    \let argumentsMatch:
      g a0 a1 a2 = g a0 (fromMath (toMath a1)) (fromMath (toMath a2)) :=
      congr3!{Bool Int^ Int^ Int^} g
        a0 a0 a1 (fromMath (toMath a1)) a2 (fromMath (toMath a2))
        (\refl(a0)) (roundTripArg a1) (roundTripArg a2);
    \let resultMatches:
      f a0 a1 a2 = g a0 (fromMath (toMath a1)) (fromMath (toMath a2)) :=
      trans!{Int^} _ _ _ (matches a0 a1 a2) argumentsMatch;
    \return toMathCong (f a0 a1 a2)
      (g a0 (fromMath (toMath a1)) (fromMath (toMath a2))) resultMatches;
  };

/* Auxiliary operations on the quotient use its unique normal form. */
\definition ofNatMath (n: Nat): Grothendieck := toMath (ofNatPrec n);

\definition ofNatMatchesMath (n: Nat): toMath (ofNatSet n) = ofNatMath n := toMathCong (ofNatSet n) (ofNatPrec n) (ofNatMatchesPrec n);

\definition negOfNatMath (n: Nat): Grothendieck := toMath (negOfNatPrec n);

\definition negOfNatMatchesMath (n: Nat): toMath (negOfNatSet n) = negOfNatMath n := toMathCong (negOfNatSet n) (negOfNatPrec n) (negOfNatMatchesPrec n);

\definition succMath (x: Grothendieck): Grothendieck := toMath (succPrec (fromMath x));

\definition succMatchesMath (x: Int^): toMath (succSet x) = succMath (toMath x) := agreementII succSet succPrec succMatchesPrec x;

\definition predMath (x: Grothendieck): Grothendieck := toMath (predPrec (fromMath x));

\definition predMatchesMath (x: Int^): toMath (predSet x) = predMath (toMath x) := agreementII predSet predPrec predMatchesPrec x;

\definition natAbsMath (x: Grothendieck): Nat := (natAbsPrec (fromMath x));

\definition natAbsMatchesMath (x: Int^): (natAbsSet x) = natAbsMath (toMath x) := agreementIN natAbsSet natAbsPrec natAbsMatchesPrec x;

\definition absMath (x: Grothendieck): Grothendieck := toMath (absPrec (fromMath x));

\definition absMatchesMath (x: Int^): toMath (absSet x) = absMath (toMath x) := agreementII absSet absPrec absMatchesPrec x;

\definition isZeroMath (x: Grothendieck): Bool := (isZeroPrec (fromMath x));

\definition isZeroMatchesMath (x: Int^): (isZeroSet x) = isZeroMath (toMath x) := agreementIB isZeroSet isZeroPrec isZeroMatchesPrec x;

\definition eqbMath (x: Grothendieck) (y: Grothendieck): Bool := (eqbPrec (fromMath x) (fromMath y));

\definition eqbMatchesMath (x: Int^) (y: Int^): (eqbSet x y) = eqbMath (toMath x) (toMath y) := agreementIIB eqbSet eqbPrec eqbMatchesPrec x y;

\definition lebMath (x: Grothendieck) (y: Grothendieck): Bool := (lebPrec (fromMath x) (fromMath y));

\definition lebMatchesMath (x: Int^) (y: Int^): (lebSet x y) = lebMath (toMath x) (toMath y) := agreementIIB lebSet lebPrec lebMatchesPrec x y;

\definition ltbMath (x: Grothendieck) (y: Grothendieck): Bool := (ltbPrec (fromMath x) (fromMath y));

\definition ltbMatchesMath (x: Int^) (y: Int^): (ltbSet x y) = ltbMath (toMath x) (toMath y) := agreementIIB ltbSet ltbPrec ltbMatchesPrec x y;

\definition minMath (x: Grothendieck) (y: Grothendieck): Grothendieck := toMath (minPrec (fromMath x) (fromMath y));

\definition minMatchesMath (x: Int^) (y: Int^): toMath (minSet x y) = minMath (toMath x) (toMath y) := agreementIII minSet minPrec minMatchesPrec x y;

\definition maxMath (x: Grothendieck) (y: Grothendieck): Grothendieck := toMath (maxPrec (fromMath x) (fromMath y));

\definition maxMatchesMath (x: Int^) (y: Int^): toMath (maxSet x y) = maxMath (toMath x) (toMath y) := agreementIII maxSet maxPrec maxMatchesPrec x y;

\definition signMath (x: Grothendieck): Grothendieck := toMath (signPrec (fromMath x));

\definition signMatchesMath (x: Int^): toMath (signSet x) = signMath (toMath x) := agreementII signSet signPrec signMatchesPrec x;

\definition evenMath (x: Grothendieck): Bool := (evenPrec (fromMath x));

\definition evenMatchesMath (x: Int^): (evenSet x) = evenMath (toMath x) := agreementIB evenSet evenPrec evenMatchesPrec x;

\definition oddMath (x: Grothendieck): Bool := (oddPrec (fromMath x));

\definition oddMatchesMath (x: Int^): (oddSet x) = oddMath (toMath x) := agreementIB oddSet oddPrec oddMatchesPrec x;

\definition powMath (x: Grothendieck) (n: Nat): Grothendieck := toMath (powPrec (fromMath x) n);

\definition powMatchesMath (x: Int^) (n: Nat): toMath (powSet x n) = powMath (toMath x) n := agreementINI powSet powPrec powMatchesPrec x n;

\definition positiveMath (x: Grothendieck): Nat := (positivePrec (fromMath x));

\definition positiveMatchesMath (x: Int^): (positiveSet x) = positiveMath (toMath x) := agreementIN positiveSet positivePrec positiveMatchesPrec x;

\definition negativeMath (x: Grothendieck): Nat := (negativePrec (fromMath x));

\definition negativeMatchesMath (x: Int^): (negativeSet x) = negativeMath (toMath x) := agreementIN negativeSet negativePrec negativeMatchesPrec x;

\definition chooseMath (test: Bool) (yes: Grothendieck) (no: Grothendieck): Grothendieck := toMath (choosePrec test (fromMath yes)
    (fromMath no));

\definition chooseMatchesMath (test: Bool) (yes: Int^) (no: Int^): toMath (chooseSet test yes no) =
    chooseMath test (toMath yes) (toMath no) := agreementBIII chooseSet choosePrec chooseMatchesPrec test yes
    no;

\definition zeroMath: Grothendieck := toMath zeroPrec^;
\definition zeroMatchesMath: toMath zeroSet = zeroMath := toMathCong zeroSet zeroPrec^ zeroMatchesPrec;

\definition oneMath: Grothendieck := toMath onePrec^;
\definition oneMatchesMath: toMath oneSet = oneMath := toMathCong oneSet onePrec^ oneMatchesPrec;

\definition minusOneMath: Grothendieck := toMath minusOnePrec^;
\definition minusOneMatchesMath: toMath minusOneSet = minusOneMath := toMathCong minusOneSet minusOnePrec^
    minusOneMatchesPrec;

\definition diffMath (a, b: Nat): Grothendieck := class (pair a b);
\definition diffMatchesMath (a, b: Nat): toMath (diffSet a b) = diffMath a b := trans!{\Pow (Difference)} (toMath (diffSet a b)) (toMath (diffPrec a b)) (class (pair a b))
    (toMathCong (diffSet a b) (diffPrec a b) (diffMatchesPrec b a)) (toFromClass (pair a b));
\definition Le (x, y: Int^): \Prop := lebSet x y = boolTrue!{};
\definition Lt (x, y: Int^): \Prop := ltbSet x y = boolTrue!{};
\definition LeMath (x, y: Grothendieck): \Prop := lebMath x y =
    boolTrue!{};
\definition LtMath (x, y: Grothendieck): \Prop := ltbMath x y =
    boolTrue!{};

\module Laws;

