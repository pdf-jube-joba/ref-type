\import N.Laws().Order() \as NO;
\definition crossLeft (x, y: Integer): Nat := N.addSet (positivePrec x) (negativePrec y);
\definition natLtbAgrees (a, b: Nat): natLtbPrec a b = N.ltbSet a b :=
  \prec(\Prop, B.Bool^)
    (\fun (flag: B.Bool^) =>
      natIsZeroPrec (N.chooseSet flag N.Nat^::zero (N.Nat^::succ N.Nat^::zero)) = flag)
    (\refl(B.Bool^::false)) (\refl(B.Bool^::true)) (N.ltbSet a b);
\definition ltbAsCross (x, y: Integer):
  ltbSet x y = N.ltbSet (crossLeft x y) (crossLeft y x) :=
  trans!{B.Bool^} _ _ _ (ltbMatchesPrec x y)
    (natLtbAgrees (crossLeft x y) (crossLeft y x));
\definition ltOfCross (x, y: Integer)
  (h: NL.Lt (crossLeft x y) (crossLeft y x)): IntegerLt x y :=
  \idelim(ltbPrec x y = ltbSet x y \with flag: B.Bool^ => flag = B.Bool^::true)
    \by (congr!{B.Bool^ B.Bool^}
      (\fun (flag: B.Bool^) => natIsZeroPrec (N.chooseSet flag N.Nat^::zero (N.Nat^::succ N.Nat^::zero)))
      (N.ltbSet (crossLeft x y) (crossLeft y x)) B.Bool^::true h,
      sym!{B.Bool^} _ _ (ltbMatchesPrec x y));
\definition crossOfLt (x, y: Integer) (h: IntegerLt x y):
  NL.Lt (crossLeft x y) (crossLeft y x) :=
  \idelim(ltbSet x y = N.ltbSet (crossLeft x y) (crossLeft y x)
    \with flag: B.Bool^ => flag = B.Bool^::true)
    \by (h, ltbAsCross x y);
\definition Comparison (x, y: Integer): \Prop :=
  L.Or[IntegerLt x y, L.Or[IntegerEq x y, IntegerLt y x]];
\definition trichotomy (x, y: Integer): Comparison x y :=
  \elim (NO.trichotomy (crossLeft x y) (crossLeft y x)) \in L.Or
    \return (\fun (_: NO.Comparison (crossLeft x y) (crossLeft y x)) => Comparison x y) {
  | left => \fun (h: NL.Lt (crossLeft x y) (crossLeft y x)) =>
      L.Or[IntegerLt x y, L.Or[IntegerEq x y, IntegerLt y x]]::left (ltOfCross x y h)
  | right => \fun (rest: L.Or[crossLeft x y = crossLeft y x, NL.Lt (crossLeft y x) (crossLeft x y)]) =>
      L.Or[IntegerLt x y, L.Or[IntegerEq x y, IntegerLt y x]]::right
        (\elim rest \in L.Or
          \return (\fun (_: L.Or[crossLeft x y = crossLeft y x, NL.Lt (crossLeft y x) (crossLeft x y)]) =>
            L.Or[IntegerEq x y, IntegerLt y x]) {
        | left => \fun (e: crossLeft x y = crossLeft y x) => L.Or[IntegerEq x y, IntegerLt y x]::left e
        | right => \fun (h: NL.Lt (crossLeft y x) (crossLeft x y)) =>
            L.Or[IntegerEq x y, IntegerLt y x]::right (ltOfCross y x h)
        })
  };
\definition ltIrrefl (x: Integer) (h: IntegerLt x x): L.False :=
  NL.ltIrrefl (crossLeft x x) (crossOfLt x x h);

\definition rawCross (x, y: Difference): Nat :=
  N.addSet (pos x) (negPart y);
\definition RawLt (x, y: Difference): \Prop :=
  NL.Lt (rawCross x y) (rawCross y x);

\definition integerLtAsRaw (x, y: Integer):
  IntegerLt x y -> RawLt (IM.representative x) (IM.representative y) :=
  crossOfLt x y;
\definition integerLtOfRaw (x, y: Integer):
  RawLt (IM.representative x) (IM.representative y) -> IntegerLt x y :=
  ltOfCross x y;

\definition rawShuffle (x, y, z: Difference):
  N.addSet (rawCross x y) (rawCross y z) =
    N.addSet (rawCross x z) (N.addSet (pos y) (negPart y)) :=
  integerAddShuffle (pos x) (negPart y) (pos y) (negPart z);

\definition rawLtTrans (x, y, z: Difference)
  (xy: RawLt x y) (yz: RawLt y z): RawLt x z :=
  \block {
    \let leftStep: NL.Lt
      (N.addSet (rawCross x y) (rawCross y z))
      (N.addSet (rawCross y x) (rawCross y z)) :=
      NO.ltAddRight (rawCross x y) (rawCross y x) (rawCross y z) xy;
    \let rightStep: NL.Lt
      (N.addSet (rawCross y x) (rawCross y z))
      (N.addSet (rawCross z y) (rawCross y x)) :=
      NO.ltRespects
        (N.addSet (rawCross y z) (rawCross y x))
        (N.addSet (rawCross z y) (rawCross y x))
        (N.addSet (rawCross y x) (rawCross y z))
        (N.addSet (rawCross z y) (rawCross y x))
        (NL.addComm (rawCross y z) (rawCross y x))
        (\refl(N.addSet (rawCross z y) (rawCross y x)))
        (NO.ltAddRight (rawCross y z) (rawCross z y)
          (rawCross y x) yz);
    \let enlarged: NL.Lt
      (N.addSet (rawCross x y) (rawCross y z))
      (N.addSet (rawCross z y) (rawCross y x)) :=
      NO.ltTrans _ _ _ leftStep rightStep;
    \let aligned: NL.Lt
      (N.addSet (rawCross x z) (N.addSet (pos y) (negPart y)))
      (N.addSet (rawCross z x) (N.addSet (pos y) (negPart y))) :=
      NO.ltRespects _ _ _ _
        (rawShuffle x y z) (rawShuffle z y x) enlarged;
    \return NO.ltCancelRight (rawCross x z) (rawCross z x)
      (N.addSet (pos y) (negPart y)) aligned;
  };

\definition rawEquivalentEquation (x, y: Difference)
  (xy: IM.Equivalent x y):
  N.addSet (pos x) (negPart y) = N.addSet (pos y) (negPart x) := xy;
\definition rawEquivalentUnderAdd (x, x2, y: Difference)
  (xx: IM.Equivalent x x2):
  N.addSet (N.addSet (pos x) (negPart x2)) (negPart y) =
    N.addSet (N.addSet (pos x2) (negPart x)) (negPart y) :=
  congr!{Nat Nat} (\fun (n: Nat) => N.addSet n (negPart y)) _ _
    (rawEquivalentEquation x x2 xx);

\definition rawReplaceLeftLower (x, x2, y: Difference)
  (xx: IM.Equivalent x x2):
  N.addSet (rawCross x y) (negPart x2) =
    N.addSet (rawCross x2 y) (negPart x) :=
  trans!{Nat} _ _ _
    (NO.addRotate (pos x) (negPart y) (negPart x2))
    (trans!{Nat} _ _ _
      (rawEquivalentUnderAdd x x2 y xx)
      (NO.addRotate (pos x2) (negPart x) (negPart y)));
\definition rawReplaceLeftUpper (x, x2, y: Difference):
  N.addSet (rawCross y x) (negPart x2) =
    N.addSet (rawCross y x2) (negPart x) :=
  NO.addRotate (pos y) (negPart x) (negPart x2);

\definition rawLtReplaceLeft (x, x2, y: Difference)
  (xx: IM.Equivalent x x2) (xy: RawLt x y): RawLt x2 y :=
  NO.ltCancelRight (rawCross x2 y) (rawCross y x2) (negPart x)
    (NO.ltRespects
      (N.addSet (rawCross x y) (negPart x2))
      (N.addSet (rawCross y x) (negPart x2))
      (N.addSet (rawCross x2 y) (negPart x))
      (N.addSet (rawCross y x2) (negPart x))
      (rawReplaceLeftLower x x2 y xx)
      (rawReplaceLeftUpper x x2 y)
      (NO.ltAddRight (rawCross x y) (rawCross y x)
        (negPart x2) xy));

\definition rawReplaceRightLower (x, y, y2: Difference):
  N.addSet (rawCross x y) (negPart y2) =
    N.addSet (rawCross x y2) (negPart y) :=
  NO.addRotate (pos x) (negPart y) (negPart y2);
\definition rawReplaceRightUpper (x, y, y2: Difference)
  (yy: IM.Equivalent y y2):
  N.addSet (rawCross y x) (negPart y2) =
    N.addSet (rawCross y2 x) (negPart y) :=
  trans!{Nat} _ _ _
    (NO.addRotate (pos y) (negPart x) (negPart y2))
    (trans!{Nat} _ _ _
      (rawEquivalentUnderAdd y y2 x yy)
      (NO.addRotate (pos y2) (negPart y) (negPart x)));

\definition rawLtReplaceRight (x, y, y2: Difference)
  (yy: IM.Equivalent y y2) (xy: RawLt x y): RawLt x y2 :=
  NO.ltCancelRight (rawCross x y2) (rawCross y2 x) (negPart y)
    (NO.ltRespects
      (N.addSet (rawCross x y) (negPart y2))
      (N.addSet (rawCross y x) (negPart y2))
      (N.addSet (rawCross x y2) (negPart y))
      (N.addSet (rawCross y2 x) (negPart y))
      (rawReplaceRightLower x y y2)
      (rawReplaceRightUpper x y y2 yy)
      (NO.ltAddRight (rawCross x y) (rawCross y x)
        (negPart y2) xy));

\definition rawLtRespects (x, x2, y, y2: Difference)
  (xx: IM.Equivalent x x2) (yy: IM.Equivalent y y2)
  (xy: RawLt x y): RawLt x2 y2 :=
  rawLtReplaceRight x2 y y2 yy (rawLtReplaceLeft x x2 y xx xy);

\definition rawAddCross (z, x, y: Difference):
  N.addSet (rawCross x y) (rawCross z z) =
    rawCross (IM.addRep z x) (IM.addRep z y) :=
  trans!{Nat} _ _ _
    (NL.addComm (rawCross x y) (rawCross z z))
    (sym!{Nat} _ _
      (NL.addInterchange (pos z) (pos x)
        (negPart z) (negPart y)));

\definition rawLtAddLeft (z, x, y: Difference)
  (xy: RawLt x y): RawLt (IM.addRep z x) (IM.addRep z y) :=
  NO.ltRespects
    (N.addSet (rawCross x y) (rawCross z z))
    (N.addSet (rawCross y x) (rawCross z z))
    (rawCross (IM.addRep z x) (IM.addRep z y))
    (rawCross (IM.addRep z y) (IM.addRep z x))
    (rawAddCross z x y)
    (rawAddCross z y x)
    (NO.ltAddRight (rawCross x y) (rawCross y x) (rawCross z z) xy);

\definition ltTrans (x, y, z: Integer)
  (xy: IntegerLt x y) (yz: IntegerLt y z): IntegerLt x z :=
  integerLtOfRaw x z
    (rawLtTrans (IM.representative x) (IM.representative y)
      (IM.representative z) (integerLtAsRaw x y xy)
      (integerLtAsRaw y z yz));

\definition ltRespects (x, x2, y, y2: Integer)
  (xx: IntegerEq x x2) (yy: IntegerEq y y2)
  (xy: IntegerLt x y): IntegerLt x2 y2 :=
  integerLtOfRaw x2 y2
    (rawLtRespects (IM.representative x) (IM.representative x2)
      (IM.representative y) (IM.representative y2)
      xx yy (integerLtAsRaw x y xy));

\definition ltAddLeft (z, x, y: Integer) (xy: IntegerLt x y):
  IntegerLt (addInteger z x) (addInteger z y) :=
  integerLtOfRaw (addInteger z x) (addInteger z y)
    (rawLtRespects
      (IM.addRep (IM.representative z) (IM.representative x))
      (IM.representative (addInteger z x))
      (IM.addRep (IM.representative z) (IM.representative y))
      (IM.representative (addInteger z y))
      (IM.equivalentSym _ _ (addIntegerRep z x))
      (IM.equivalentSym _ _ (addIntegerRep z y))
      (rawLtAddLeft (IM.representative z) (IM.representative x)
        (IM.representative y) (integerLtAsRaw x y xy)));
\definition ltAddRight (x, y, z: Integer) (xy: IntegerLt x y):
  IntegerLt (addInteger x z) (addInteger y z) :=
  ltRespects (addInteger z x) (addInteger x z)
    (addInteger z y) (addInteger y z)
    (addIntegerComm z x) (addIntegerComm z y)
    (ltAddLeft z x y xy);
\definition ltAdd (a, b, c, d: Integer)
  (ab: IntegerLt a b) (cd: IntegerLt c d):
  IntegerLt (addInteger a c) (addInteger b d) :=
  ltTrans (addInteger a c) (addInteger b c) (addInteger b d)
    (ltAddRight a b c ab) (ltAddLeft b c d cd);

\definition ltAsym (x, y: Integer)
  (xy: IntegerLt x y) (yx: IntegerLt y x): L.False :=
  ltIrrefl x (ltTrans x y x xy yx);

\definition ltNotEq (x, y: Integer)
  (xy: IntegerLt x y) (same: IntegerEq x y): L.False :=
  ltIrrefl x
    (ltRespects x x y x (integerEqRefl x)
      (integerEqSym x y same) xy);

\definition ltCancelAddRight (x, y, z: Integer)
  (xy: IntegerLt (addInteger x z) (addInteger y z)): IntegerLt x y :=
  \elim (trichotomy x y) \in L.Or
    \return (\fun (_: Comparison x y) => IntegerLt x y) {
  | left => \fun (direct: IntegerLt x y) => direct
  | right => \fun (rest: L.Or[IntegerEq x y, IntegerLt y x]) =>
      \elim rest \in L.Or
        \return (\fun (_: L.Or[IntegerEq x y, IntegerLt y x]) => IntegerLt x y) {
      | left => \fun (same: IntegerEq x y) =>
          L.falseElim (IntegerLt x y)
            (ltNotEq (addInteger x z) (addInteger y z) xy
              (addIntegerRespects x y z z same (integerEqRefl z)))
      | right => \fun (reverse: IntegerLt y x) =>
          L.falseElim (IntegerLt x y)
            (ltAsym (addInteger x z) (addInteger y z) xy
              (ltAddRight y x z reverse))
      }
  };

\definition ltCancelAddLeft (z, x, y: Integer)
  (xy: IntegerLt (addInteger z x) (addInteger z y)): IntegerLt x y :=
  ltCancelAddRight x y z
    (ltRespects (addInteger z x) (addInteger x z)
      (addInteger z y) (addInteger y z)
      (addIntegerComm z x) (addIntegerComm z y) xy);

\definition rawLtNegReverse (x, y: Difference)
  (xy: RawLt x y): RawLt (IM.negRep y) (IM.negRep x) :=
  NO.ltRespects
    (rawCross x y) (rawCross y x)
    (rawCross (IM.negRep y) (IM.negRep x))
    (rawCross (IM.negRep x) (IM.negRep y))
    (NL.addComm (pos x) (negPart y))
    (NL.addComm (pos y) (negPart x)) xy;

\definition ltNegReverse (x, y: Integer) (xy: IntegerLt x y):
  IntegerLt (negInteger y) (negInteger x) :=
  integerLtOfRaw (negInteger y) (negInteger x)
    (rawLtRespects
      (IM.negRep (IM.representative y))
      (IM.representative (negInteger y))
      (IM.negRep (IM.representative x))
      (IM.representative (negInteger x))
      (IM.equivalentSym _ _ (negIntegerRep y))
      (IM.equivalentSym _ _ (negIntegerRep x))
      (rawLtNegReverse (IM.representative x) (IM.representative y)
        (integerLtAsRaw x y xy)));

\definition zeroLtOne: IntegerLt zeroInteger oneInteger :=
  ltOfCross zeroInteger oneInteger (NO.zeroLtSucc N.Nat^::zero);

\definition negZero: IntegerEq (negInteger zeroInteger) zeroInteger :=
  integerEqTrans _ _ _
    (integerEqSym _ _ (addIntegerZeroLeft (negInteger zeroInteger)))
    (addIntegerNegRight zeroInteger);

\definition negOneLtZero: IntegerLt (negInteger oneInteger) zeroInteger :=
  ltRespects (negInteger oneInteger) (negInteger oneInteger)
    (negInteger zeroInteger) zeroInteger
    (integerEqRefl _) negZero
    (ltNegReverse zeroInteger oneInteger zeroLtOne);

\definition ltPredecessor (x: Integer):
  IntegerLt (addInteger x (negInteger oneInteger)) x :=
  ltRespects
    (addInteger x (negInteger oneInteger))
    (addInteger x (negInteger oneInteger))
    (addInteger x zeroInteger) x
    (integerEqRefl _) (addIntegerZeroRight x)
    (ltAddLeft x (negInteger oneInteger) zeroInteger negOneLtZero);

\definition ltSuccessor (x: Integer):
  IntegerLt x (addInteger x oneInteger) :=
  ltRespects
    (addInteger x zeroInteger) x
    (addInteger x oneInteger) (addInteger x oneInteger)
    (addIntegerZeroRight x) (integerEqRefl _)
    (ltAddLeft x zeroInteger oneInteger zeroLtOne);

\definition rawLtScaleSucc (x, y: Difference) (k: Nat)
  (xy: RawLt x y): RawLt (IM.scaleRep x (N.Nat^::succ k))
    (IM.scaleRep y (N.Nat^::succ k)) :=
  NO.ltRespects
    (N.mulSet (rawCross x y) (N.Nat^::succ k))
    (N.mulSet (rawCross y x) (N.Nat^::succ k))
    (rawCross (IM.scaleRep x (N.Nat^::succ k))
      (IM.scaleRep y (N.Nat^::succ k)))
    (rawCross (IM.scaleRep y (N.Nat^::succ k))
      (IM.scaleRep x (N.Nat^::succ k)))
    (NL.mulDistribRight (pos x) (negPart y) (N.Nat^::succ k))
    (NL.mulDistribRight (pos y) (negPart x) (N.Nat^::succ k))
    (NO.ltMulSuccRight (rawCross x y) (rawCross y x) k xy);

\definition rawLtCancelScaleSucc (x, y: Difference) (k: Nat)
  (xy: RawLt (IM.scaleRep x (N.Nat^::succ k))
    (IM.scaleRep y (N.Nat^::succ k))): RawLt x y :=
  NO.ltCancelMulSuccRight (rawCross x y) (rawCross y x) k
    (NO.ltRespects
      (rawCross (IM.scaleRep x (N.Nat^::succ k))
        (IM.scaleRep y (N.Nat^::succ k)))
      (rawCross (IM.scaleRep y (N.Nat^::succ k))
        (IM.scaleRep x (N.Nat^::succ k)))
      (N.mulSet (rawCross x y) (N.Nat^::succ k))
      (N.mulSet (rawCross y x) (N.Nat^::succ k))
      (sym!{Nat} _ _
        (NL.mulDistribRight (pos x) (negPart y) (N.Nat^::succ k)))
      (sym!{Nat} _ _
        (NL.mulDistribRight (pos y) (negPart x) (N.Nat^::succ k))) xy);

\definition ltScaleSucc (x, y: Integer) (k: Nat) (xy: IntegerLt x y):
  IntegerLt (scaleInteger x (N.Nat^::succ k))
    (scaleInteger y (N.Nat^::succ k)) :=
  integerLtOfRaw (scaleInteger x (N.Nat^::succ k))
    (scaleInteger y (N.Nat^::succ k))
    (rawLtRespects
      (IM.scaleRep (IM.representative x) (N.Nat^::succ k))
      (IM.representative (scaleInteger x (N.Nat^::succ k)))
      (IM.scaleRep (IM.representative y) (N.Nat^::succ k))
      (IM.representative (scaleInteger y (N.Nat^::succ k)))
      (IM.equivalentSym _ _ (scaleIntegerRep x (N.Nat^::succ k)))
      (IM.equivalentSym _ _ (scaleIntegerRep y (N.Nat^::succ k)))
      (rawLtScaleSucc (IM.representative x) (IM.representative y) k
        (integerLtAsRaw x y xy)));

\definition ltCancelScaleSucc (x, y: Integer) (k: Nat)
  (xy: IntegerLt (scaleInteger x (N.Nat^::succ k))
    (scaleInteger y (N.Nat^::succ k))): IntegerLt x y :=
  integerLtOfRaw x y
    (rawLtCancelScaleSucc (IM.representative x) (IM.representative y) k
      (rawLtRespects
        (IM.representative (scaleInteger x (N.Nat^::succ k)))
        (IM.scaleRep (IM.representative x) (N.Nat^::succ k))
        (IM.representative (scaleInteger y (N.Nat^::succ k)))
        (IM.scaleRep (IM.representative y) (N.Nat^::succ k))
        (scaleIntegerRep x (N.Nat^::succ k))
        (scaleIntegerRep y (N.Nat^::succ k))
        (integerLtAsRaw _ _ xy)));

\definition ltNatural (a, b: Nat) (ab: NL.Lt a b):
  IntegerLt (integer a zeroNat) (integer b zeroNat) :=
  ltOfCross (integer a zeroNat) (integer b zeroNat) ab;

\definition negativeLtZero (a: Nat):
  IntegerLt (Int^::negSucc a) zeroInteger :=
  ltOfCross (Int^::negSucc a) zeroInteger
    (NO.ltRespects zeroNat (N.Nat^::succ a)
      (crossLeft (Int^::negSucc a) zeroInteger)
      (crossLeft zeroInteger (Int^::negSucc a))
      (sym!{Nat} _ _ (NL.addZeroLeft zeroNat))
      (sym!{Nat} _ _ (NL.addZeroLeft (N.Nat^::succ a)))
      (NO.zeroLtSucc a));

\definition zeroLtNaturalSucc (a: Nat):
  IntegerLt zeroInteger (integer (N.Nat^::succ a) zeroNat) :=
  ltOfCross zeroInteger (integer (N.Nat^::succ a) zeroNat)
    (NO.ltRespects zeroNat (N.Nat^::succ a)
      (crossLeft zeroInteger (integer (N.Nat^::succ a) zeroNat))
      (crossLeft (integer (N.Nat^::succ a) zeroNat) zeroInteger)
      (sym!{Nat} _ _ (NL.addZeroLeft zeroNat))
      (sym!{Nat} _ _ (NL.addZeroRight (N.Nat^::succ a)))
      (NO.zeroLtSucc a));

\definition PositiveMultipleAbove (x, e: Integer): \Prop :=
  \exists \Ty(Nat,
    \Subset(n, Nat, IntegerLt x (scaleInteger e n)));

\definition positiveNaturalMultipleAboveNatural (k, a: Nat):
  PositiveMultipleAbove (Int^::ofNat a)
    (Int^::ofNat (N.Nat^::succ k)) :=
  \block {
    \let n: Nat := N.Nat^::succ a;
    \let product: Nat := N.mulSet (N.Nat^::succ k) n;
    \let belowProduct:
        IntegerLt (Int^::ofNat a) (integer product zeroNat) :=
      ltNatural a product (NO.ltPositiveProduct a k);
    \let productIsScale:
        IntegerEq (integer product zeroNat)
          (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n) :=
      integerEqSym _ _
        (scaleIntegerNatural (N.Nat^::succ k) n);
    \let bound:
        IntegerLt (Int^::ofNat a)
          (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n) :=
      ltRespects (Int^::ofNat a) (Int^::ofNat a)
        (integer product zeroNat)
        (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n)
        (integerEqRefl _) productIsScale belowProduct;
    \return \exact(
      \subsetinto(Nat,
        \Subset(n, Nat,
          IntegerLt (Int^::ofNat a)
            (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n)),
        n, bound),
      \Ty(Nat,
        \Subset(n, Nat,
          IntegerLt (Int^::ofNat a)
            (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n))));
  };

\definition positiveNaturalMultipleAboveNegative (k, a: Nat):
  PositiveMultipleAbove (Int^::negSucc a)
    (Int^::ofNat (N.Nat^::succ k)) :=
  \block {
    \let n: Nat := N.Nat^::succ N.Nat^::zero;
    \let positiveScale:
        IntegerLt zeroInteger
          (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n) :=
      ltRespects zeroInteger zeroInteger
        (integer (N.Nat^::succ k) zeroNat)
        (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n)
        (integerEqRefl _)
        (integerEqSym _ _
          (integerEqTrans _ _ _
            (scaleIntegerNatural (N.Nat^::succ k) n)
            (integerEqOfParts _ _ _ _
              (NL.mulOneRight (N.Nat^::succ k))
              (\refl(zeroNat)))))
        (zeroLtNaturalSucc k);
    \let bound:
        IntegerLt (Int^::negSucc a)
          (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n) :=
      ltTrans (Int^::negSucc a) zeroInteger
        (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n)
        (negativeLtZero a) positiveScale;
    \return \exact(
      \subsetinto(Nat,
        \Subset(n, Nat,
          IntegerLt (Int^::negSucc a)
            (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n)),
        n, bound),
      \Ty(Nat,
        \Subset(n, Nat,
          IntegerLt (Int^::negSucc a)
            (scaleInteger (Int^::ofNat (N.Nat^::succ k)) n))));
  };

\definition positiveNaturalMultipleAbove (k: Nat):
  \forall (x: Integer) ->
    PositiveMultipleAbove x (Int^::ofNat (N.Nat^::succ k)) :=
  \prec(\Prop, Int^)
    (\fun (x: Int^) =>
      PositiveMultipleAbove x (Int^::ofNat (N.Nat^::succ k)))
    (positiveNaturalMultipleAboveNatural k)
    (positiveNaturalMultipleAboveNegative k);

\definition naturalPositiveMultipleAbove:
  \forall (n: Nat) -> IntegerLt zeroInteger (Int^::ofNat n) ->
    \forall (x: Integer) -> PositiveMultipleAbove x (Int^::ofNat n) :=
  \prec(\Prop, N.Nat^)
    (\fun (n: N.Nat^) => IntegerLt zeroInteger (Int^::ofNat n) ->
      \forall (x: Integer) -> PositiveMultipleAbove x (Int^::ofNat n))
    (\fun (positive: IntegerLt zeroInteger zeroInteger) =>
      \fun (x: Integer) =>
        L.falseElim (PositiveMultipleAbove x zeroInteger)
          (ltIrrefl zeroInteger positive))
    (\fun (k: Nat) =>
      \fun (_: IntegerLt zeroInteger (Int^::ofNat k) ->
        \forall (x: Integer) -> PositiveMultipleAbove x (Int^::ofNat k)) =>
      \fun (_: IntegerLt zeroInteger (Int^::ofNat (N.Nat^::succ k))) =>
        positiveNaturalMultipleAbove k);

\definition positiveMultipleAbove:
  \forall (e: Integer) -> IntegerLt zeroInteger e ->
    \forall (x: Integer) -> PositiveMultipleAbove x e :=
  \prec(\Prop, Int^)
    (\fun (e: Int^) => IntegerLt zeroInteger e ->
      \forall (x: Integer) -> PositiveMultipleAbove x e)
    naturalPositiveMultipleAbove
    (\fun (a: Nat) =>
      \fun (positive: IntegerLt zeroInteger (Int^::negSucc a)) =>
        \fun (x: Integer) =>
          L.falseElim (PositiveMultipleAbove x (Int^::negSucc a))
            (ltAsym zeroInteger (Int^::negSucc a) positive
              (negativeLtZero a)));
