/* Rational representatives with an integer numerator and positive denominator. */
\import \root.Logic() \as Logic;

\inductive Nat: \Set :=
| zero: Nat;
| succ: Nat -> Nat;
;

\definition natAdd: Nat -> Nat -> Nat :=
  (m, n: Nat) =>
    \prec(\Set, Nat)
      ((k: Nat) => Nat)
      n
      ((k: Nat) => (sum: Nat) => Nat#succ sum)
      m;

\definition natMul: Nat -> Nat -> Nat :=
  (m, n: Nat) =>
    \prec(\Set, Nat)
      ((k: Nat) => Nat)
      Nat#zero
      ((k: Nat) => (product: Nat) => natAdd n product)
      m;

\definition zeroNat: Nat := Nat#zero;

\definition oneNat: Nat := Nat#succ Nat#zero;

\inductive NatLt: (lower: Nat) -> (upper: Nat) -> \Prop :=
| zeroSucc: (n: Nat) -> NatLt Nat#zero (Nat#succ n);
| succSucc: (lower, upper: Nat) ->
    NatLt lower upper -> NatLt (Nat#succ lower) (Nat#succ upper);
;

/* The pair (a,b) represents a-b. */
\inductive Integer: \Set :=
| pair: Nat -> Nat -> Integer;
;

\definition positive: Integer -> Nat :=
  (z: Integer) =>
    \prec(\Set, Integer)
      ((z: Integer) => Nat)
      ((a, b: Nat) => a)
      z;

\definition negative: Integer -> Nat :=
  (z: Integer) =>
    \prec(\Set, Integer)
      ((z: Integer) => Nat)
      ((a, b: Nat) => b)
      z;

\definition integer: Nat -> Nat -> Integer :=
  (a, b: Nat) => Integer#pair a b;

\definition zeroInteger: Integer := integer zeroNat zeroNat;

\definition oneInteger: Integer := integer oneNat zeroNat;

\definition negInteger: Integer -> Integer :=
  (x: Integer) => integer (negative x) (positive x);

\definition addInteger: Integer -> Integer -> Integer :=
  (x, y: Integer) =>
    integer
      (natAdd (positive x) (positive y))
      (natAdd (negative x) (negative y));

/* (a-b)(c-d) = (ac+bd) - (ad+bc). */
\definition mulInteger: Integer -> Integer -> Integer :=
  (x, y: Integer) =>
    integer
      (natAdd
        (natMul (positive x) (positive y))
        (natMul (negative x) (negative y)))
      (natAdd
        (natMul (positive x) (negative y))
        (natMul (negative x) (positive y)));

\definition subInteger: Integer -> Integer -> Integer :=
  (x, y: Integer) => addInteger x (negInteger y);

\definition IntegerEq: Integer -> Integer -> \Prop :=
  (x, y: Integer) =>
    natAdd (positive x) (negative y) =
      natAdd (positive y) (negative x);

\definition natEqSym:
  (x, y: Nat) -> x = y -> y = x :=
  (x, y: Nat) => (xy: x = y) =>
    \idelim(x = y
      \with z: Nat => z = x)
    \by (\refl(x), xy);

\definition integerEqRefl:
  (x: Integer) -> IntegerEq x x :=
  (x: Integer) =>
    \refl(natAdd (positive x) (negative x));

\definition integerEqSym:
  (x, y: Integer) -> IntegerEq x y -> IntegerEq y x :=
  (x, y: Integer) => (xy: IntegerEq x y) =>
    natEqSym
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x))
      xy;

\definition IntegerLt: Integer -> Integer -> \Prop :=
  (x, y: Integer) =>
    NatLt
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x));

\definition IntegerNonZero: Integer -> \Prop :=
  (x: Integer) => Logic.Not (IntegerEq x zeroInteger);

/*
 * A fraction stores a numerator and the predecessor of a positive natural
 * denominator.  Thus every denominator is nonzero by construction and the
 * arithmetic operations below need no multiplicative-closure parameter.
 */
\inductive Fraction: \Set :=
| fraction: Integer -> Nat -> Fraction;
;

\definition numerator: Fraction -> Integer :=
  (x: Fraction) =>
    \prec(\Set, Fraction)
      ((x: Fraction) => Integer)
      ((n: Integer) => (d: Nat) => n)
      x;

\definition denominatorIndex: Fraction -> Nat :=
  (x: Fraction) =>
    \prec(\Set, Fraction)
      ((x: Fraction) => Nat)
      ((n: Integer) => (d: Nat) => d)
      x;

\definition denominator: Fraction -> Integer :=
  (x: Fraction) =>
    integer (Nat#succ (denominatorIndex x)) zeroNat;

\definition fraction: Integer -> Nat -> Fraction :=
  (n: Integer) => (d: Nat) => Fraction#fraction n d;

/* (d + 1)(e + 1) = (de + d + e) + 1. */
\definition denominatorProductIndex: Nat -> Nat -> Nat :=
  (d, e: Nat) => natAdd (natAdd (natMul d e) d) e;

\definition zero: Fraction := fraction zeroInteger zeroNat;

\definition one: Fraction := fraction oneInteger zeroNat;

\definition lt: Fraction -> Fraction -> \Prop :=
  (x, y: Fraction) =>
    IntegerLt
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x));

/* Equality before quotienting is equality after cross multiplication. */
\definition FractionEq: Fraction -> Fraction -> \Prop :=
  (x, y: Fraction) =>
    IntegerEq
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x));

\definition fractionEqRefl:
  (x: Fraction) -> FractionEq x x :=
  (x: Fraction) =>
    integerEqRefl
      (mulInteger (numerator x) (denominator x));

\definition fractionEqSym:
  (x, y: Fraction) -> FractionEq x y -> FractionEq y x :=
  (x, y: Fraction) => (xy: FractionEq x y) =>
    integerEqSym
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x))
      xy;

\definition NumeratorNonZero: Fraction -> \Prop :=
  (x: Fraction) => IntegerNonZero (numerator x);

\definition add: Fraction -> Fraction -> Fraction :=
  (x, y: Fraction) =>
    fraction
      (addInteger
        (mulInteger (numerator x) (denominator y))
        (mulInteger (numerator y) (denominator x)))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

\definition neg: Fraction -> Fraction :=
  (x: Fraction) =>
    fraction (negInteger (numerator x)) (denominatorIndex x);

\definition sub: Fraction -> Fraction -> Fraction :=
  (x, y: Fraction) => add x (neg y);

\definition mul: Fraction -> Fraction -> Fraction :=
  (x, y: Fraction) =>
    fraction
      (mulInteger (numerator x) (numerator y))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

/*
 * The quotient is fixed to FractionEq.  The remaining parameters are the
 * arithmetic transitivity proof and subset extensionality.
 */
\module Quotient(
    setExt:
      (A, B: \Power(Fraction)) ->
        ((x: Fraction) ->
          \Pred(Fraction, A, x) -> \Pred(Fraction, B, x)) ->
        ((x: Fraction) ->
          \Pred(Fraction, B, x) -> \Pred(Fraction, A, x)) ->
        A = B,
    fractionEqTrans:
      (x, y, z: Fraction) ->
        FractionEq x y -> FractionEq y z -> FractionEq x z,
  ) {
    \import \root.Logic() \as QuotientLogic;

    \definition ClassOf: Fraction -> \Power(Fraction) :=
      (x: Fraction) => \Subset(y, Fraction, FractionEq x y);

    \definition classOfEq:
      (x, y: Fraction) -> FractionEq x y -> ClassOf x = ClassOf y :=
      (x, y: Fraction) => (xy: FractionEq x y) =>
        setExt (ClassOf x) (ClassOf y)
          ((z: Fraction) => (xz: FractionEq x z) =>
            fractionEqTrans y x z (fractionEqSym x y xy) xz)
          ((z: Fraction) => (yz: FractionEq y z) =>
            fractionEqTrans x y z xy yz);

    \definition IsClass: \Power(Fraction) -> \Prop :=
      (C: \Power(Fraction)) =>
        (P: \Prop) -> ((x: Fraction) -> C = ClassOf x -> P) -> P;

    \definition ClassSet: \Power(\Power(Fraction)) :=
      \Subset(C, \Power(Fraction), IsClass C);

    \definition Rat: \Set :=
      \Ty(\Power(Fraction), ClassSet);

    \definition mem: Rat -> Fraction -> \Prop :=
      (x: Rat) => (a: Fraction) => \Pred(Fraction, x, a);

    \definition Eq: Rat -> Rat -> \Prop :=
      (x, y: Rat) => x = y;

    \definition eqByExt:
      (x, y: Rat) ->
        ((a: Fraction) -> mem x a -> mem y a) ->
        ((a: Fraction) -> mem y a -> mem x a) -> Eq x y :=
      (x, y: Rat) =>
        (xy: (a: Fraction) -> mem x a -> mem y a) =>
        (yx: (a: Fraction) -> mem y a -> mem x a) =>
          setExt x y xy yx;

    \definition classIsClass:
      (x: Fraction) -> IsClass (ClassOf x) :=
      (x: Fraction) =>
        (P: \Prop) =>
        (intro: (y: Fraction) -> ClassOf x = ClassOf y -> P) =>
          intro x (\refl(ClassOf x));

    \definition class: Fraction -> Rat :=
      (x: Fraction) =>
        \subsetinto(
          \Power(Fraction), ClassSet,
          ClassOf x, classIsClass x);

    \definition IsNonZero: Rat -> \Prop :=
      (x: Rat) =>
        (a: Fraction) -> mem x a -> NumeratorNonZero a;

    \definition NonZeroRatSet: \Power(Rat) :=
      \Subset(x, Rat, IsNonZero x);

    \definition NonZeroRat: \Set :=
      \Ty(Rat, NonZeroRatSet);

    \definition AddClass: Rat -> Rat -> \Power(Fraction) :=
      (x, y: Rat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      FractionEq z (add a b)]))])));

    \definition SubClass: Rat -> Rat -> \Power(Fraction) :=
      (x, y: Rat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      FractionEq z (sub a b)]))])));

    \definition MulClass: Rat -> Rat -> \Power(Fraction) :=
      (x, y: Rat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      FractionEq z (mul a b)]))])));

    /* z is x/y exactly when z*y=x; y is separately refined as nonzero. */
    \definition DivClass: Rat -> NonZeroRat -> \Power(Fraction) :=
      (x: Rat) => (y: NonZeroRat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      QuotientLogic.And[NumeratorNonZero b,
                        FractionEq (mul z b) a]]))])));

    \module ClassClosed(
      addClassIsClass: (x, y: Rat) -> IsClass (AddClass x y),
      subClassIsClass: (x, y: Rat) -> IsClass (SubClass x y),
      mulClassIsClass: (x, y: Rat) -> IsClass (MulClass x y),
      divClassIsClass: (x: Rat) -> (y: NonZeroRat) ->
        IsClass (DivClass x y),
    ) {
      \definition add: Rat -> Rat -> Rat :=
        (x, y: Rat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            AddClass x y, addClassIsClass x y);

      \definition sub: Rat -> Rat -> Rat :=
        (x, y: Rat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            SubClass x y, subClassIsClass x y);

      \definition mul: Rat -> Rat -> Rat :=
        (x, y: Rat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            MulClass x y, mulClassIsClass x y);

      \definition div: Rat -> NonZeroRat -> Rat :=
        (x: Rat) => (y: NonZeroRat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            DivClass x y, divClassIsClass x y);
    }
}
