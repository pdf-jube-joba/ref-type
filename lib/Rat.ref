\import \root.Equality() \as Equality;
\use Equality.sym;

/* Rational representatives with an integer numerator and positive denominator. */
\import \root.Logic() \as Logic;
\import \root.Pair() \as P;
\use Logic.not;

/* Use the certified natural-number carrier, arithmetic and order. */
\import \root.Nat() \as N;
\definition Nat: \Set := N.Nat;
\definition natAdd: Nat -> Nat -> Nat := N.addSet;
\definition natMul: Nat -> Nat -> Nat := N.mulSet;
\definition zeroNat: Nat := N.zeroSet;
\definition oneNat: Nat := N.oneSet;
\definition NatLt: Nat -> Nat -> \Prop := N.Lt;
\definition NatLe: Nat -> Nat -> \Prop := N.Le;
\definition natLeRefl: \forall (n: Nat) -> NatLe n n := N.leRefl;
\definition natLeTrans: \forall (a, b, c: Nat) -> NatLe a b -> NatLe b c -> NatLe a c := N.leTrans;

/* The pair (a,b) represents a-b. */
\definition Integer: \Set := P.Times[Nat, Nat];
\definition positive: Integer -> Nat := P.first Nat Nat;
\definition negative: Integer -> Nat := P.second Nat Nat;
\definition integer: Nat -> Nat -> Integer := P.pair Nat Nat;

\definition zeroInteger: Integer := integer zeroNat zeroNat;

\definition oneInteger: Integer := integer oneNat zeroNat;

\definition negInteger: Integer -> Integer :=
  \fun (x: Integer) => integer (negative x) (positive x);

\definition addInteger: Integer -> Integer -> Integer :=
  \fun (x, y: Integer) =>
    integer
      (natAdd (positive x) (positive y))
      (natAdd (negative x) (negative y));

/* (a-b)(c-d) = (ac+bd) - (ad+bc). */
\definition mulInteger: Integer -> Integer -> Integer :=
  \fun (x, y: Integer) =>
    integer
      (natAdd
        (natMul (positive x) (positive y))
        (natMul (negative x) (negative y)))
      (natAdd
        (natMul (positive x) (negative y))
        (natMul (negative x) (positive y)));

\definition subInteger: Integer -> Integer -> Integer :=
  \fun (x, y: Integer) => addInteger x (negInteger y);

\definition IntegerEq: Integer -> Integer -> \Prop :=
  \fun (x, y: Integer) =>
    natAdd (positive x) (negative y) =
      natAdd (positive y) (negative x);

\definition integerEqRefl:
  \forall (x: Integer) -> IntegerEq x x :=
  \fun (x: Integer) =>
    \refl(natAdd (positive x) (negative x));

\definition integerEqSym:
  \forall (x, y: Integer) -> IntegerEq x y -> IntegerEq y x :=
  \fun (x, y: Integer) => \fun (xy: IntegerEq x y) =>
    sym!{N.Nat}
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x))
      xy;

\definition IntegerLt: Integer -> Integer -> \Prop :=
  \fun (x, y: Integer) =>
    NatLt
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x));

\definition IntegerNonZero: Integer -> \Prop :=
  \fun (x: Integer) => not!{{ IntegerEq x zeroInteger }};

/*
 * A fraction stores a numerator and the predecessor of a positive natural
 * denominator.  Thus every denominator is nonzero by construction and the
 * arithmetic operations below need no multiplicative-closure parameter.
 */
\structure Fraction: \Set := {
  numerator: Integer,
  denominatorIndex: Nat,
};

\definition numerator: Fraction -> Integer :=
  \fun (x: Fraction) => Fraction::numerator x;

\definition denominatorIndex: Fraction -> Nat :=
  \fun (x: Fraction) => Fraction::denominatorIndex x;

\definition denominator: Fraction -> Integer :=
  \fun (x: Fraction) =>
    integer (N.Nat::succ (denominatorIndex x)) zeroNat;

\definition fraction: Integer -> Nat -> Fraction :=
  \fun (n: Integer) => \fun (d: Nat) =>
    \record Fraction { numerator := n, denominatorIndex := d };

/* (d + 1)(e + 1) = (de + d + e) + 1. */
\definition denominatorProductIndex: Nat -> Nat -> Nat :=
  \fun (d, e: Nat) => natAdd (natAdd (natMul d e) d) e;

\definition zero: Fraction := fraction zeroInteger zeroNat;

\definition one: Fraction := fraction oneInteger zeroNat;

\definition lt: Fraction -> Fraction -> \Prop :=
  \fun (x, y: Fraction) =>
    IntegerLt
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x));

/* Equality before quotienting is equality after cross multiplication. */
\definition FractionEq: Fraction -> Fraction -> \Prop :=
  \fun (x, y: Fraction) =>
    IntegerEq
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x));

\definition fractionEqRefl:
  \forall (x: Fraction) -> FractionEq x x :=
  \fun (x: Fraction) =>
    integerEqRefl
      (mulInteger (numerator x) (denominator x));

\definition fractionEqSym:
  \forall (x, y: Fraction) -> FractionEq x y -> FractionEq y x :=
  \fun (x, y: Fraction) => \fun (xy: FractionEq x y) =>
    integerEqSym
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x))
      xy;

\definition NumeratorNonZero: Fraction -> \Prop :=
  \fun (x: Fraction) => IntegerNonZero (numerator x);

\definition add: Fraction -> Fraction -> Fraction :=
  \fun (x, y: Fraction) =>
    fraction
      (addInteger
        (mulInteger (numerator x) (denominator y))
        (mulInteger (numerator y) (denominator x)))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

\definition neg: Fraction -> Fraction :=
  \fun (x: Fraction) =>
    fraction (negInteger (numerator x)) (denominatorIndex x);

\definition sub: Fraction -> Fraction -> Fraction :=
  \fun (x, y: Fraction) => add x (neg y);

\definition mul: Fraction -> Fraction -> Fraction :=
  \fun (x, y: Fraction) =>
    fraction
      (mulInteger (numerator x) (numerator y))
      (denominatorProductIndex
        (denominatorIndex x) (denominatorIndex y));

/*
 * The quotient is fixed to FractionEq.  Its remaining parameter is the
 * arithmetic transitivity proof; subset extensionality is supplied by the
 * kernel axiom.
 */
\module Quotient(
    fractionEqTrans:
      \forall (x, y, z: Fraction) ->
        FractionEq x y -> FractionEq y z -> FractionEq x z,
  );
