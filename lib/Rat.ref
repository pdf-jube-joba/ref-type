\import \root.Equality() \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;

/* Rational representatives with an integer numerator and positive denominator. */
\import \root.Logic() \as Logic;
\import \root.Pair() \as P;
\use Logic.not;

/* Use the certified natural-number carrier, arithmetic and order. */
\import \root.Nat() \as N;
\import N.Laws() \as NL;
\definition Nat: \Set := N.Nat;
\definition natAdd: Nat -> Nat -> Nat := N.addSet;
\definition natMul: Nat -> Nat -> Nat := N.mulSet;
\definition zeroNat: Nat := N.zeroSet;
\definition oneNat: Nat := N.oneSet;
\definition NatLt: Nat -> Nat -> \Prop := NL.Lt;
\definition NatLe: Nat -> Nat -> \Prop := NL.Le;
\definition natLeRefl: \forall (n: Nat) -> NatLe n n := NL.leRefl;
\definition natLeTrans: \forall (a, b, c: Nat) -> NatLe a b -> NatLe b c -> NatLe a c := NL.leTrans;

/* The pair (a,b) represents a-b. */
\definition Integer: \Set := P.Times[Nat, Nat];
\definition positive: Integer -> Nat := P.first Nat Nat;
\definition negative: Integer -> Nat := P.second Nat Nat;
\definition integer: Nat -> Nat -> Integer := P.pair Nat Nat;

\definition zeroInteger: Integer := integer zeroNat zeroNat;

\definition oneInteger: Integer := integer oneNat zeroNat;

\definition negInteger: Integer -> Integer :=
  \fun (x: Integer) => integer (negative x) (positive x);

\definition addInteger: Integer -> Integer -> Integer :=
  \fun (x, y: Integer) =>
    integer
      (natAdd (positive x) (positive y))
      (natAdd (negative x) (negative y));

/* (a-b)(c-d) = (ac+bd) - (ad+bc). */
\definition mulInteger: Integer -> Integer -> Integer :=
  \fun (x, y: Integer) =>
    integer
      (natAdd
        (natMul (positive x) (positive y))
        (natMul (negative x) (negative y)))
      (natAdd
        (natMul (positive x) (negative y))
        (natMul (negative x) (positive y)));

\definition subInteger: Integer -> Integer -> Integer :=
  \fun (x, y: Integer) => addInteger x (negInteger y);

\definition IntegerEq: Integer -> Integer -> \Prop :=
  \fun (x, y: Integer) =>
    natAdd (positive x) (negative y) =
      natAdd (positive y) (negative x);

\definition integerEqRefl:
  \forall (x: Integer) -> IntegerEq x x :=
  \fun (x: Integer) =>
    \refl(natAdd (positive x) (negative x));

\definition integerEqSym:
  \forall (x, y: Integer) -> IntegerEq x y -> IntegerEq y x :=
  \fun (x, y: Integer) => \fun (xy: IntegerEq x y) =>
    sym!{N.Nat}
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x))
      xy;

/* Rearranging four summands is the normalization step used by transitivity. */
\definition integerAddShuffle: \forall (a, b, c, d: Nat) ->
  natAdd (natAdd a b) (natAdd c d) =
    natAdd (natAdd a d) (natAdd c b) :=
  \fun (a, b, c, d: Nat) =>
    trans!{Nat} _ _ _ (NL.addInterchange a b c d)
      (trans!{Nat} _ _ _
        (congr!{Nat Nat} (natAdd (natAdd a c)) _ _ (NL.addComm b d))
        (sym!{Nat} _ _ (NL.addInterchange a d c b)));

\definition integerEqTrans:
  \forall (x, y, z: Integer) ->
    IntegerEq x y -> IntegerEq y z -> IntegerEq x z :=
  \fun (x, y, z: Integer) =>
  \fun (xy: IntegerEq x y) =>
  \fun (yz: IntegerEq y z) =>
    NL.addCancelRight
      (natAdd (positive y) (negative y))
      (natAdd (positive x) (negative z))
      (natAdd (positive z) (negative x))
      (trans!{Nat} _ _ _
        (integerAddShuffle
          (positive x) (negative z) (positive y) (negative y))
        (trans!{Nat} _ _ _
          (congr2!{Nat Nat Nat} natAdd
            (natAdd (positive x) (negative y))
            (natAdd (positive y) (negative x))
            (natAdd (positive y) (negative z))
            (natAdd (positive z) (negative y))
            xy yz)
          (trans!{Nat} _ _ _
            (NL.addInterchange
              (positive y) (negative x) (positive z) (negative y))
            (trans!{Nat} _ _ _
              (congr!{Nat Nat}
                (\fun (n: Nat) =>
                  natAdd n (natAdd (negative x) (negative y)))
                _ _ (NL.addComm (positive y) (positive z)))
              (sym!{Nat} _ _
                (NL.addInterchange
                  (positive z) (negative x)
                  (positive y) (negative y)))))));

\definition integerEqOfFields:
  \forall (x, y: Integer) ->
    positive x = positive y -> negative x = negative y -> IntegerEq x y :=
  \fun (x, y: Integer) =>
  \fun (p: positive x = positive y) =>
  \fun (n: negative x = negative y) =>
    congr2!{Nat Nat Nat} natAdd
      _ _ _ _ p (sym!{Nat} _ _ n);

\definition addIntegerRespects:
  \forall (x, y, u, v: Integer) ->
    IntegerEq x y -> IntegerEq u v ->
    IntegerEq (addInteger x u) (addInteger y v) :=
  \fun (x, y, u, v: Integer) =>
  \fun (xy: IntegerEq x y) =>
  \fun (uv: IntegerEq u v) =>
    trans!{Nat} _ _ _
      (NL.addInterchange
        (positive x) (positive u) (negative y) (negative v))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd
          (natAdd (positive x) (negative y))
          (natAdd (positive y) (negative x))
          (natAdd (positive u) (negative v))
          (natAdd (positive v) (negative u))
          xy uv)
        (sym!{Nat} _ _
          (NL.addInterchange
            (positive y) (positive v) (negative x) (negative u))));

\definition negIntegerRespects:
  \forall (x, y: Integer) ->
    IntegerEq x y -> IntegerEq (negInteger x) (negInteger y) :=
  \fun (x, y: Integer) => \fun (xy: IntegerEq x y) =>
    trans!{Nat} _ _ _ (NL.addComm (negative x) (positive y))
      (trans!{Nat}
        (natAdd (positive y) (negative x))
        (natAdd (positive x) (negative y))
        (natAdd (negative y) (positive x))
        (sym!{Nat}
          (natAdd (positive x) (negative y))
          (natAdd (positive y) (negative x)) xy)
        (NL.addComm (positive x) (negative y)));

\definition subIntegerRespects:
  \forall (x, y, u, v: Integer) ->
    IntegerEq x y -> IntegerEq u v ->
    IntegerEq (subInteger x u) (subInteger y v) :=
  \fun (x, y, u, v: Integer) =>
  \fun (xy: IntegerEq x y) =>
  \fun (uv: IntegerEq u v) =>
    addIntegerRespects x y (negInteger u) (negInteger v)
      xy (negIntegerRespects u v uv);

\definition scaleInteger: Integer -> Nat -> Integer :=
  \fun (x: Integer) => \fun (n: Nat) =>
    integer (natMul (positive x) n) (natMul (negative x) n);

\definition scaleIntegerRespects:
  \forall (x, y: Integer) -> \forall (n: Nat) ->
    IntegerEq x y -> IntegerEq (scaleInteger x n) (scaleInteger y n) :=
  \fun (x, y: Integer) => \fun (n: Nat) => \fun (xy: IntegerEq x y) =>
    trans!{Nat}
      (natAdd (natMul (positive x) n) (natMul (negative y) n))
      (natMul (natAdd (positive x) (negative y)) n)
      (natAdd (natMul (positive y) n) (natMul (negative x) n))
      (sym!{Nat}
        (natMul (natAdd (positive x) (negative y)) n)
        (natAdd (natMul (positive x) n) (natMul (negative y) n))
        (NL.mulDistribRight (positive x) (negative y) n))
      (trans!{Nat}
        (natMul (natAdd (positive x) (negative y)) n)
        (natMul (natAdd (positive y) (negative x)) n)
        (natAdd (natMul (positive y) n) (natMul (negative x) n))
        (congr!{Nat Nat} (\fun (a: Nat) => natMul a n)
          (natAdd (positive x) (negative y))
          (natAdd (positive y) (negative x)) xy)
        (NL.mulDistribRight (positive y) (negative x) n));

\definition scaleIntegerZero:
  \forall (n: Nat) ->
    IntegerEq (scaleInteger zeroInteger n) zeroInteger :=
  \fun (n: Nat) =>
    integerEqOfFields (scaleInteger zeroInteger n) zeroInteger
      (NL.mulZeroLeft n)
      (NL.mulZeroLeft n);

\definition scaleIntegerMul:
  \forall (x, y: Integer) -> \forall (n: Nat) ->
    IntegerEq
      (scaleInteger (mulInteger x y) n)
      (mulInteger x (scaleInteger y n)) :=
  \fun (x, y: Integer) => \fun (n: Nat) =>
    integerEqOfFields
      (scaleInteger (mulInteger x y) n)
      (mulInteger x (scaleInteger y n))
      (trans!{Nat} _ _ _
        (NL.mulDistribRight
          (natMul (positive x) (positive y))
          (natMul (negative x) (negative y))
          n)
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulAssoc (positive x) (positive y) n)
          (NL.mulAssoc (negative x) (negative y) n)))
      (trans!{Nat} _ _ _
        (NL.mulDistribRight
          (natMul (positive x) (negative y))
          (natMul (negative x) (positive y))
          n)
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulAssoc (positive x) (negative y) n)
          (NL.mulAssoc (negative x) (positive y) n)));

\definition natMulSwapRight: \forall (x, a, b: Nat) ->
  natMul (natMul x a) b = natMul (natMul x b) a :=
  \fun (x, a, b: Nat) =>
    trans!{Nat} _ _ _ (NL.mulAssoc x a b)
      (trans!{Nat} _ _ _
        (congr!{Nat Nat} (natMul x) _ _ (NL.mulComm a b))
        (sym!{Nat} _ _ (NL.mulAssoc x b a)));

\definition scaleIntegerSwap:
  \forall (x: Integer) -> \forall (a, b: Nat) ->
    IntegerEq (scaleInteger (scaleInteger x a) b)
      (scaleInteger (scaleInteger x b) a) :=
  \fun (x: Integer) => \fun (a, b: Nat) =>
    integerEqOfFields
      (scaleInteger (scaleInteger x a) b)
      (scaleInteger (scaleInteger x b) a)
      (natMulSwapRight (positive x) a b)
      (natMulSwapRight (negative x) a b);

\definition scaleIntegerCancelPositive:
  \forall (x, y: Integer) -> \forall (k: Nat) ->
    IntegerEq
      (scaleInteger x (N.Nat::succ k))
      (scaleInteger y (N.Nat::succ k)) ->
    IntegerEq x y :=
  \fun (x, y: Integer) => \fun (k: Nat) =>
  \fun (xy:
    IntegerEq
      (scaleInteger x (N.Nat::succ k))
      (scaleInteger y (N.Nat::succ k))) =>
    NL.mulCancelRightSucc k
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x))
      (trans!{Nat}
        (natMul (natAdd (positive x) (negative y)) (N.Nat::succ k))
        (natAdd
          (natMul (positive x) (N.Nat::succ k))
          (natMul (negative y) (N.Nat::succ k)))
        (natMul (natAdd (positive y) (negative x)) (N.Nat::succ k))
        (NL.mulDistribRight (positive x) (negative y) (N.Nat::succ k))
        (trans!{Nat}
          (natAdd
            (natMul (positive x) (N.Nat::succ k))
            (natMul (negative y) (N.Nat::succ k)))
          (natAdd
            (natMul (positive y) (N.Nat::succ k))
            (natMul (negative x) (N.Nat::succ k)))
          (natMul (natAdd (positive y) (negative x)) (N.Nat::succ k))
          xy
          (sym!{Nat}
            (natMul (natAdd (positive y) (negative x)) (N.Nat::succ k))
            (natAdd
              (natMul (positive y) (N.Nat::succ k))
              (natMul (negative x) (N.Nat::succ k)))
            (NL.mulDistribRight
              (positive y) (negative x) (N.Nat::succ k)))));

\definition mulIntegerAsSum:
  \forall (x, y: Integer) ->
    IntegerEq (mulInteger x y)
      (addInteger
        (scaleInteger x (positive y))
        (negInteger (scaleInteger x (negative y)))) :=
  \fun (x, y: Integer) =>
    integerEqOfFields (mulInteger x y)
      (addInteger
        (scaleInteger x (positive y))
        (negInteger (scaleInteger x (negative y))))
      (\refl(positive (mulInteger x y)))
      (NL.addComm
        (natMul (positive x) (negative y))
        (natMul (negative x) (positive y)));

\definition mulIntegerComm:
  \forall (x, y: Integer) -> IntegerEq (mulInteger x y) (mulInteger y x) :=
  \fun (x, y: Integer) =>
    integerEqOfFields (mulInteger x y) (mulInteger y x)
      (congr2!{Nat Nat Nat} natAdd _ _ _ _
        (NL.mulComm (positive x) (positive y))
        (NL.mulComm (negative x) (negative y)))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulComm (positive x) (negative y))
          (NL.mulComm (negative x) (positive y)))
        (NL.addComm
          (natMul (negative y) (positive x))
          (natMul (positive y) (negative x))));

\definition mulIntegerNegLeft:
  \forall (x, y: Integer) ->
    IntegerEq (mulInteger (negInteger x) y)
      (negInteger (mulInteger x y)) :=
  \fun (x, y: Integer) =>
    integerEqOfFields
      (mulInteger (negInteger x) y)
      (negInteger (mulInteger x y))
      (NL.addComm
        (natMul (negative x) (positive y))
        (natMul (positive x) (negative y)))
      (NL.addComm
        (natMul (negative x) (negative y))
        (natMul (positive x) (positive y)));

\definition mulIntegerNegRight:
  \forall (x, y: Integer) ->
    IntegerEq (mulInteger x (negInteger y))
      (negInteger (mulInteger x y)) :=
  \fun (x, y: Integer) =>
    integerEqTrans
      (mulInteger x (negInteger y))
      (mulInteger (negInteger y) x)
      (negInteger (mulInteger x y))
      (mulIntegerComm x (negInteger y))
      (integerEqTrans
        (mulInteger (negInteger y) x)
        (negInteger (mulInteger y x))
        (negInteger (mulInteger x y))
        (mulIntegerNegLeft y x)
        (negIntegerRespects
          (mulInteger y x) (mulInteger x y)
          (mulIntegerComm y x)));

\definition mulIntegerRespectsLeft:
  \forall (x, y, z: Integer) ->
    IntegerEq x y -> IntegerEq (mulInteger x z) (mulInteger y z) :=
  \fun (x, y, z: Integer) => \fun (xy: IntegerEq x y) =>
    integerEqTrans (mulInteger x z)
      (addInteger
        (scaleInteger x (positive z))
        (negInteger (scaleInteger x (negative z))))
      (mulInteger y z)
      (mulIntegerAsSum x z)
      (integerEqTrans
        (addInteger
          (scaleInteger x (positive z))
          (negInteger (scaleInteger x (negative z))))
        (addInteger
          (scaleInteger y (positive z))
          (negInteger (scaleInteger y (negative z))))
        (mulInteger y z)
        (addIntegerRespects
          (scaleInteger x (positive z)) (scaleInteger y (positive z))
          (negInteger (scaleInteger x (negative z)))
          (negInteger (scaleInteger y (negative z)))
          (scaleIntegerRespects x y (positive z) xy)
          (negIntegerRespects
            (scaleInteger x (negative z))
            (scaleInteger y (negative z))
            (scaleIntegerRespects x y (negative z) xy)))
        (integerEqSym (mulInteger y z)
          (addInteger
            (scaleInteger y (positive z))
            (negInteger (scaleInteger y (negative z))))
          (mulIntegerAsSum y z)));

\definition mulIntegerRespects:
  \forall (x, y, u, v: Integer) ->
    IntegerEq x y -> IntegerEq u v ->
    IntegerEq (mulInteger x u) (mulInteger y v) :=
  \fun (x, y, u, v: Integer) =>
  \fun (xy: IntegerEq x y) =>
  \fun (uv: IntegerEq u v) =>
    integerEqTrans (mulInteger x u) (mulInteger y u) (mulInteger y v)
      (mulIntegerRespectsLeft x y u xy)
      (integerEqTrans (mulInteger y u) (mulInteger u y) (mulInteger y v)
        (mulIntegerComm y u)
        (integerEqTrans (mulInteger u y) (mulInteger v y) (mulInteger y v)
          (mulIntegerRespectsLeft u v y uv)
          (mulIntegerComm v y)));

\definition addIntegerZeroLeft:
  \forall (x: Integer) -> IntegerEq (addInteger zeroInteger x) x :=
  \fun (x: Integer) =>
    integerEqOfFields (addInteger zeroInteger x) x
      (NL.addZeroLeft (positive x))
      (NL.addZeroLeft (negative x));

\definition addIntegerZeroRight:
  \forall (x: Integer) -> IntegerEq (addInteger x zeroInteger) x :=
  \fun (x: Integer) =>
    integerEqOfFields (addInteger x zeroInteger) x
      (NL.addZeroRight (positive x))
      (NL.addZeroRight (negative x));

\definition addIntegerComm:
  \forall (x, y: Integer) ->
    IntegerEq (addInteger x y) (addInteger y x) :=
  \fun (x, y: Integer) =>
    integerEqOfFields (addInteger x y) (addInteger y x)
      (NL.addComm (positive x) (positive y))
      (NL.addComm (negative x) (negative y));

\definition addIntegerAssoc:
  \forall (x, y, z: Integer) ->
    IntegerEq (addInteger (addInteger x y) z)
      (addInteger x (addInteger y z)) :=
  \fun (x, y, z: Integer) =>
    integerEqOfFields
      (addInteger (addInteger x y) z)
      (addInteger x (addInteger y z))
      (NL.addAssoc (positive x) (positive y) (positive z))
      (NL.addAssoc (negative x) (negative y) (negative z));

\definition mulIntegerDistribLeft:
  \forall (x, y, z: Integer) ->
    IntegerEq
      (mulInteger x (addInteger y z))
      (addInteger (mulInteger x y) (mulInteger x z)) :=
  \fun (x, y, z: Integer) =>
    integerEqOfFields
      (mulInteger x (addInteger y z))
      (addInteger (mulInteger x y) (mulInteger x z))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulDistribLeft
            (positive x) (positive y) (positive z))
          (NL.mulDistribLeft
            (negative x) (negative y) (negative z)))
        (NL.addInterchange
          (natMul (positive x) (positive y))
          (natMul (positive x) (positive z))
          (natMul (negative x) (negative y))
          (natMul (negative x) (negative z))))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulDistribLeft
            (positive x) (negative y) (negative z))
          (NL.mulDistribLeft
            (negative x) (positive y) (positive z)))
        (NL.addInterchange
          (natMul (positive x) (negative y))
          (natMul (positive x) (negative z))
          (natMul (negative x) (positive y))
          (natMul (negative x) (positive z))));

\definition mulIntegerDistribRight:
  \forall (x, y, z: Integer) ->
    IntegerEq
      (mulInteger (addInteger x y) z)
      (addInteger (mulInteger x z) (mulInteger y z)) :=
  \fun (x, y, z: Integer) =>
    integerEqTrans
      (mulInteger (addInteger x y) z)
      (mulInteger z (addInteger x y))
      (addInteger (mulInteger x z) (mulInteger y z))
      (mulIntegerComm (addInteger x y) z)
      (integerEqTrans
        (mulInteger z (addInteger x y))
        (addInteger (mulInteger z x) (mulInteger z y))
        (addInteger (mulInteger x z) (mulInteger y z))
        (mulIntegerDistribLeft z x y)
        (addIntegerRespects
          (mulInteger z x) (mulInteger x z)
          (mulInteger z y) (mulInteger y z)
          (mulIntegerComm z x)
          (mulIntegerComm z y)));

\definition mulIntegerAssoc:
  \forall (x, y, z: Integer) ->
    IntegerEq
      (mulInteger (mulInteger x y) z)
      (mulInteger x (mulInteger y z)) :=
  \fun (x, y, z: Integer) =>
    integerEqTrans
      (mulInteger (mulInteger x y) z)
      (addInteger
        (scaleInteger (mulInteger x y) (positive z))
        (negInteger
          (scaleInteger (mulInteger x y) (negative z))))
      (mulInteger x (mulInteger y z))
      (mulIntegerAsSum (mulInteger x y) z)
      (integerEqTrans
        (addInteger
          (scaleInteger (mulInteger x y) (positive z))
          (negInteger
            (scaleInteger (mulInteger x y) (negative z))))
        (addInteger
          (mulInteger x (scaleInteger y (positive z)))
          (negInteger
            (mulInteger x (scaleInteger y (negative z)))))
        (mulInteger x (mulInteger y z))
        (addIntegerRespects
          (scaleInteger (mulInteger x y) (positive z))
          (mulInteger x (scaleInteger y (positive z)))
          (negInteger
            (scaleInteger (mulInteger x y) (negative z)))
          (negInteger
            (mulInteger x (scaleInteger y (negative z))))
          (scaleIntegerMul x y (positive z))
          (negIntegerRespects
            (scaleInteger (mulInteger x y) (negative z))
            (mulInteger x (scaleInteger y (negative z)))
            (scaleIntegerMul x y (negative z))))
        (integerEqTrans
          (addInteger
            (mulInteger x (scaleInteger y (positive z)))
            (negInteger
              (mulInteger x (scaleInteger y (negative z)))))
          (addInteger
            (mulInteger x (scaleInteger y (positive z)))
            (mulInteger x
              (negInteger (scaleInteger y (negative z)))))
          (mulInteger x (mulInteger y z))
          (addIntegerRespects
            (mulInteger x (scaleInteger y (positive z)))
            (mulInteger x (scaleInteger y (positive z)))
            (negInteger
              (mulInteger x (scaleInteger y (negative z))))
            (mulInteger x
              (negInteger (scaleInteger y (negative z))))
            (integerEqRefl
              (mulInteger x (scaleInteger y (positive z))))
            (integerEqSym
              (mulInteger x
                (negInteger (scaleInteger y (negative z))))
              (negInteger
                (mulInteger x (scaleInteger y (negative z))))
              (mulIntegerNegRight x
                (scaleInteger y (negative z)))))
          (integerEqTrans
            (addInteger
              (mulInteger x (scaleInteger y (positive z)))
              (mulInteger x
                (negInteger (scaleInteger y (negative z)))))
            (mulInteger x
              (addInteger
                (scaleInteger y (positive z))
                (negInteger (scaleInteger y (negative z)))))
            (mulInteger x (mulInteger y z))
            (integerEqSym
              (mulInteger x
                (addInteger
                  (scaleInteger y (positive z))
                  (negInteger (scaleInteger y (negative z)))))
              (addInteger
                (mulInteger x (scaleInteger y (positive z)))
                (mulInteger x
                  (negInteger (scaleInteger y (negative z)))))
              (mulIntegerDistribLeft x
                (scaleInteger y (positive z))
                (negInteger (scaleInteger y (negative z)))))
            (mulIntegerRespects
              x x
              (addInteger
                (scaleInteger y (positive z))
                (negInteger (scaleInteger y (negative z))))
              (mulInteger y z)
              (integerEqRefl x)
              (integerEqSym
                (mulInteger y z)
                (addInteger
                  (scaleInteger y (positive z))
                  (negInteger (scaleInteger y (negative z))))
                (mulIntegerAsSum y z))))));

\definition mulIntegerCongRight:
  \forall (x, y, z: Integer) ->
    IntegerEq y z ->
    IntegerEq (mulInteger x y) (mulInteger x z) :=
  \fun (x, y, z: Integer) => \fun (yz: IntegerEq y z) =>
    mulIntegerRespects
      x x y z (integerEqRefl x) yz;

\definition mulIntegerInterchange:
  \forall (a, b, c, d: Integer) ->
    IntegerEq
      (mulInteger (mulInteger a b) (mulInteger c d))
      (mulInteger (mulInteger a c) (mulInteger b d)) :=
  \fun (a, b, c, d: Integer) =>
    integerEqTrans
      (mulInteger (mulInteger a b) (mulInteger c d))
      (mulInteger a
        (mulInteger b (mulInteger c d)))
      (mulInteger (mulInteger a c) (mulInteger b d))
      (mulIntegerAssoc a b (mulInteger c d))
      (integerEqTrans
        (mulInteger a
          (mulInteger b (mulInteger c d)))
        (mulInteger a
          (mulInteger (mulInteger b c) d))
        (mulInteger (mulInteger a c) (mulInteger b d))
        (mulIntegerCongRight a
          (mulInteger b (mulInteger c d))
          (mulInteger (mulInteger b c) d)
          (integerEqSym
            (mulInteger (mulInteger b c) d)
            (mulInteger b (mulInteger c d))
            (mulIntegerAssoc b c d)))
        (integerEqTrans
          (mulInteger a
            (mulInteger (mulInteger b c) d))
          (mulInteger a
            (mulInteger (mulInteger c b) d))
          (mulInteger (mulInteger a c) (mulInteger b d))
          (mulIntegerCongRight a
            (mulInteger (mulInteger b c) d)
            (mulInteger (mulInteger c b) d)
            (mulIntegerRespects
              (mulInteger b c) (mulInteger c b)
              d d
              (mulIntegerComm b c)
              (integerEqRefl d)))
          (integerEqTrans
            (mulInteger a
              (mulInteger (mulInteger c b) d))
            (mulInteger a
              (mulInteger c (mulInteger b d)))
            (mulInteger (mulInteger a c) (mulInteger b d))
            (mulIntegerCongRight a
              (mulInteger (mulInteger c b) d)
              (mulInteger c (mulInteger b d))
              (mulIntegerAssoc c b d))
            (integerEqSym
              (mulInteger (mulInteger a c) (mulInteger b d))
              (mulInteger a
                (mulInteger c (mulInteger b d)))
              (mulIntegerAssoc a c (mulInteger b d))))));

\definition negIntegerInvolutive:
  \forall (x: Integer) -> IntegerEq (negInteger (negInteger x)) x :=
  \fun (x: Integer) => integerEqRefl x;

\definition addIntegerNegRight:
  \forall (x: Integer) ->
    IntegerEq (addInteger x (negInteger x)) zeroInteger :=
  \fun (x: Integer) =>
    trans!{Nat} _ _ _
      (NL.addZeroRight
        (natAdd (positive x) (negative x)))
      (trans!{Nat} _ _ _
        (NL.addComm (positive x) (negative x))
        (sym!{Nat} _ _ (NL.addZeroLeft
          (natAdd (negative x) (positive x)))));

\definition addIntegerNegLeft:
  \forall (x: Integer) ->
    IntegerEq (addInteger (negInteger x) x) zeroInteger :=
  \fun (x: Integer) =>
    integerEqTrans
      (addInteger (negInteger x) x)
      (addInteger x (negInteger x))
      zeroInteger
      (addIntegerComm (negInteger x) x)
      (addIntegerNegRight x);

\definition mulIntegerZeroRight:
  \forall (x: Integer) -> IntegerEq (mulInteger x zeroInteger) zeroInteger :=
  \fun (x: Integer) =>
    integerEqOfFields (mulInteger x zeroInteger) zeroInteger
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulZeroRight (positive x))
          (NL.mulZeroRight (negative x)))
        (NL.addZeroLeft zeroNat))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulZeroRight (positive x))
          (NL.mulZeroRight (negative x)))
        (NL.addZeroLeft zeroNat));

\definition mulIntegerZeroLeft:
  \forall (x: Integer) -> IntegerEq (mulInteger zeroInteger x) zeroInteger :=
  \fun (x: Integer) =>
    integerEqTrans
      (mulInteger zeroInteger x)
      (mulInteger x zeroInteger)
      zeroInteger
      (mulIntegerComm zeroInteger x)
      (mulIntegerZeroRight x);

\definition mulIntegerOneRight:
  \forall (x: Integer) -> IntegerEq (mulInteger x oneInteger) x :=
  \fun (x: Integer) =>
    integerEqOfFields (mulInteger x oneInteger) x
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulOneRight (positive x))
          (NL.mulZeroRight (negative x)))
        (NL.addZeroRight (positive x)))
      (trans!{Nat} _ _ _
        (congr2!{Nat Nat Nat} natAdd _ _ _ _
          (NL.mulZeroRight (positive x))
          (NL.mulOneRight (negative x)))
        (NL.addZeroLeft (negative x)));

\definition mulIntegerOneLeft:
  \forall (x: Integer) -> IntegerEq (mulInteger oneInteger x) x :=
  \fun (x: Integer) =>
    integerEqTrans
      (mulInteger oneInteger x)
      (mulInteger x oneInteger)
      x
      (mulIntegerComm oneInteger x)
      (mulIntegerOneRight x);

\definition IntegerLt: Integer -> Integer -> \Prop :=
  \fun (x, y: Integer) =>
    NatLt
      (natAdd (positive x) (negative y))
      (natAdd (positive y) (negative x));

\definition IntegerNonZero: Integer -> \Prop :=
  \fun (x: Integer) => not!{{ IntegerEq x zeroInteger }};

\definition integerNonZeroNeg:
  \forall (x: Integer) ->
    IntegerNonZero x -> IntegerNonZero (negInteger x) :=
  \fun (x: Integer) => \fun (nonzero: IntegerNonZero x) =>
  \fun (negZero: IntegerEq (negInteger x) zeroInteger) =>
    nonzero
      (integerEqTrans
        x
        (negInteger (negInteger x))
        zeroInteger
        (integerEqSym
          (negInteger (negInteger x)) x
          (negIntegerInvolutive x))
        (integerEqTrans
          (negInteger (negInteger x))
          (negInteger zeroInteger)
          zeroInteger
          (negIntegerRespects
            (negInteger x) zeroInteger negZero)
          (integerEqRefl zeroInteger)));

/* The fraction layer only depends on this narrow natural-number API. */
\definition natSucc: Nat -> Nat := N.Nat::succ;
\definition natMulZeroRight:
  \forall (n: Nat) -> natMul n zeroNat = zeroNat :=
  NL.mulZeroRight;
\definition natMulZeroLeft:
  \forall (n: Nat) -> natMul zeroNat n = zeroNat :=
  NL.mulZeroLeft;
\definition natMulComm:
  \forall (a, b: Nat) -> natMul a b = natMul b a :=
  NL.mulComm;
\definition natMulSuccRight:
  \forall (a, b: Nat) ->
    natMul a (natSucc b) = natAdd a (natMul a b) :=
  NL.mulSuccRight;
\definition natMulSuccSucc:
  \forall (a, b: Nat) ->
    natMul (natSucc a) (natSucc b) =
      natSucc (natAdd b (natMul a (natSucc b))) :=
  NL.mulSuccSucc;
\definition natAddComm:
  \forall (a, b: Nat) -> natAdd a b = natAdd b a :=
  NL.addComm;
\definition natAddZeroRight:
  \forall (n: Nat) -> natAdd n zeroNat = n :=
  NL.addZeroRight;
\definition natAddZeroLeft:
  \forall (n: Nat) -> natAdd zeroNat n = n :=
  NL.addZeroLeft;

\module Fractions;
