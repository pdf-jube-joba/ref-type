\import \root.Equality() \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;

\import \root.Logic() \as Logic;
\use Logic.not;
\import \root.Int() \as I;
\import I.Math() \as IM;
\import IM.Ring() \as IR;
\import IM.Specification() \as IS;

\definition Nat: \Set := I.Nat;
\definition natAdd: Nat -> Nat -> Nat := I.natAdd;
\definition natMul: Nat -> Nat -> Nat := I.natMul;
\definition zeroNat: Nat := I.zeroNat;
\definition oneNat: Nat := I.oneNat;
\definition NatLt: Nat -> Nat -> \Prop := I.NatLt;
\definition NatLe: Nat -> Nat -> \Prop := I.NatLe;
\definition natLeRefl: \forall (n: Nat) -> NatLe n n := I.natLeRefl;
\definition natLeTrans: \forall (a, b, c: Nat) -> NatLe a b -> NatLe b c -> NatLe a c := I.natLeTrans;
\definition Integer: \Set := I.Integer;
\definition positive: Integer -> Nat := I.positivePrec;
\definition negative: Integer -> Nat := I.negativePrec;
\definition integer: Nat -> Nat -> Integer := I.integer;
\definition zeroInteger: Integer := I.zeroInteger;
\definition oneInteger: Integer := I.oneInteger;
\definition negInteger: Integer -> Integer := I.negInteger;
\definition addInteger: Integer -> Integer -> Integer := I.addInteger;
\definition mulInteger: Integer -> Integer -> Integer := I.mulInteger;
\definition subInteger: Integer -> Integer -> Integer := I.subInteger;
\definition scaleInteger: Integer -> Nat -> Integer := I.scaleInteger;
\definition IntegerEq: Integer -> Integer -> \Prop := I.IntegerEq;
\definition normalizedRepresentative:
  \forall (x: I.Difference) ->
    IM.Equivalent (IM.representative (IM.normalize x)) x := I.normalizedRepresentative;
\definition integerEqRefl: \forall (x: Integer) -> IntegerEq x x := I.integerEqRefl;
\definition integerEqSym:
  \forall (x, y: Integer) -> IntegerEq x y -> IntegerEq y x := I.integerEqSym;
\definition integerEqTrans:
  \forall (x, y, z: Integer) -> IntegerEq x y -> IntegerEq y z -> IntegerEq x z := I.integerEqTrans;
\definition integerEqToEquality:
  \forall (x, y: Integer) -> IntegerEq x y -> x = y := I.integerEqToEquality;
\definition integerEqOfEquality:
  \forall (x, y: Integer) -> x = y -> IntegerEq x y := I.integerEqOfEquality;
\definition integerEqOfFields:
  \forall (x, y: Integer) ->
    positive x = positive y -> negative x = negative y -> IntegerEq x y := I.integerEqOfFields;
\definition integerEqOfParts:
  \forall (a, b, c, d: Nat) -> a = c -> b = d ->
    IntegerEq (integer a b) (integer c d) := I.integerEqOfParts;
\definition addIntegerRep: \forall (x, y: Integer) ->
  IM.Equivalent (IM.representative (addInteger x y))
    (IM.addRep (IM.representative x) (IM.representative y)) := I.addIntegerRep;
\definition negIntegerRep: \forall (x: Integer) ->
  IM.Equivalent (IM.representative (negInteger x)) (IM.negRep (IM.representative x)) := I.negIntegerRep;
\definition mulIntegerRep: \forall (x, y: Integer) ->
  IM.Equivalent (IM.representative (mulInteger x y))
    (IM.mulRep (IM.representative x) (IM.representative y)) := I.mulIntegerRep;
\definition scaleIntegerRep: \forall (x: Integer) -> \forall (n: Nat) ->
  IM.Equivalent (IM.representative (scaleInteger x n))
    (IM.scaleRep (IM.representative x) n) := I.scaleIntegerRep;
\definition addIntegerRespects:
  \forall (x, y, u, v: Integer) -> IntegerEq x y -> IntegerEq u v ->
    IntegerEq (addInteger x u) (addInteger y v) := I.addIntegerRespects;
\definition negIntegerRespects:
  \forall (x, y: Integer) -> IntegerEq x y -> IntegerEq (negInteger x) (negInteger y) := I.negIntegerRespects;
\definition subIntegerRespects:
  \forall (x, y, u, v: Integer) -> IntegerEq x y -> IntegerEq u v ->
    IntegerEq (subInteger x u) (subInteger y v) := I.subIntegerRespects;
\definition mulIntegerRespects:
  \forall (x, y, u, v: Integer) -> IntegerEq x y -> IntegerEq u v ->
    IntegerEq (mulInteger x u) (mulInteger y v) := I.mulIntegerRespects;
\definition scaleIntegerRespects:
  \forall (x, y: Integer) -> \forall (n: Nat) ->
    IntegerEq x y -> IntegerEq (scaleInteger x n) (scaleInteger y n) := I.scaleIntegerRespects;
\definition addIntegerZeroLeft: \forall (x: Integer) -> IntegerEq (addInteger zeroInteger x) x := I.addIntegerZeroLeft;
\definition addIntegerZeroRight: \forall (x: Integer) -> IntegerEq (addInteger x zeroInteger) x := I.addIntegerZeroRight;
\definition addIntegerComm:
  \forall (x, y: Integer) -> IntegerEq (addInteger x y) (addInteger y x) := I.addIntegerComm;
\definition mulIntegerComm:
  \forall (x, y: Integer) -> IntegerEq (mulInteger x y) (mulInteger y x) := I.mulIntegerComm;
\definition scaleIntegerZero: \forall (n: Nat) -> IntegerEq (scaleInteger zeroInteger n) zeroInteger := I.scaleIntegerZero;
\definition scaleIntegerSwap:
  \forall (x: Integer) -> \forall (a, b: Nat) ->
    IntegerEq (scaleInteger (scaleInteger x a) b) (scaleInteger (scaleInteger x b) a) := I.scaleIntegerSwap;
\definition scaleIntegerCancelPositive:
  \forall (x, y: Integer) -> \forall (k: Nat) ->
    IntegerEq (scaleInteger x (I.natSuccSet k)) (scaleInteger y (I.natSuccSet k)) ->
    IntegerEq x y := I.scaleIntegerCancelPositive;
\definition scaleIntegerNatural:
  \forall (a, n: Nat) ->
    IntegerEq (scaleInteger (integer a zeroNat) n)
      (integer (natMul a n) zeroNat) := I.scaleIntegerNatural;
\definition mulIntegerAssoc:
  \forall (x, y, z: Integer) ->
    IntegerEq (mulInteger (mulInteger x y) z) (mulInteger x (mulInteger y z)) := I.mulIntegerAssoc;
\definition mulIntegerCongRight:
  \forall (x, y, z: Integer) -> IntegerEq y z ->
    IntegerEq (mulInteger x y) (mulInteger x z) := I.mulIntegerCongRight;
\definition mulIntegerInterchange:
  \forall (a, b, c, d: Integer) ->
    IntegerEq (mulInteger (mulInteger a b) (mulInteger c d))
      (mulInteger (mulInteger a c) (mulInteger b d)) := I.mulIntegerInterchange;
\definition negIntegerInvolutive:
  \forall (x: Integer) -> IntegerEq (negInteger (negInteger x)) x := I.negIntegerInvolutive;
\definition addIntegerNegRight:
  \forall (x: Integer) -> IntegerEq (addInteger x (negInteger x)) zeroInteger := I.addIntegerNegRight;
\definition addIntegerNegLeft:
  \forall (x: Integer) -> IntegerEq (addInteger (negInteger x) x) zeroInteger := I.addIntegerNegLeft;
\definition mulIntegerZeroRight:
  \forall (x: Integer) -> IntegerEq (mulInteger x zeroInteger) zeroInteger := I.mulIntegerZeroRight;
\definition mulIntegerZeroLeft:
  \forall (x: Integer) -> IntegerEq (mulInteger zeroInteger x) zeroInteger := I.mulIntegerZeroLeft;
\definition mulIntegerOneRight:
  \forall (x: Integer) -> IntegerEq (mulInteger x oneInteger) x := I.mulIntegerOneRight;
\definition mulIntegerOneLeft:
  \forall (x: Integer) -> IntegerEq (mulInteger oneInteger x) x := I.mulIntegerOneLeft;
\definition mulIntegerNegLeft:
  \forall (x, y: Integer) ->
    IntegerEq (mulInteger (negInteger x) y) (negInteger (mulInteger x y)) := I.mulIntegerNegLeft;
\definition mulIntegerNegRight:
  \forall (x, y: Integer) ->
    IntegerEq (mulInteger x (negInteger y)) (negInteger (mulInteger x y)) := I.mulIntegerNegRight;
\definition mulIntegerNatural:
  \forall (x: Integer) -> \forall (n: Nat) ->
    IntegerEq (mulInteger x (integer n zeroNat)) (scaleInteger x n) := I.mulIntegerNatural;
\definition IntegerLt: Integer -> Integer -> \Prop := I.IntegerLt;
\definition IntegerNonZero: Integer -> \Prop := I.IntegerNonZero;
\definition integerNonZeroNeg:
  \forall (x: Integer) -> IntegerNonZero x -> IntegerNonZero (negInteger x) := I.integerNonZeroNeg;
\definition integerAddShuffle: \forall (a, b, c, d: Nat) ->
  natAdd (natAdd a b) (natAdd c d) =
    natAdd (natAdd a d) (natAdd c b) := I.integerAddShuffle;
\definition natSucc: Nat -> Nat := I.natSucc;
\definition natMulZeroRight:
  \forall (n: Nat) -> natMul n zeroNat = zeroNat := I.natMulZeroRight;
\definition natMulZeroLeft:
  \forall (n: Nat) -> natMul zeroNat n = zeroNat := I.natMulZeroLeft;
\definition natMulComm:
  \forall (a, b: Nat) -> natMul a b = natMul b a := I.natMulComm;
\definition natMulSuccRight:
  \forall (a, b: Nat) ->
    natMul a (natSucc b) = natAdd a (natMul a b) := I.natMulSuccRight;
\definition natMulSuccSucc:
  \forall (a, b: Nat) ->
    natMul (natSucc a) (natSucc b) =
      natSucc (natAdd b (natMul a (natSucc b))) := I.natMulSuccSucc;
\definition natAddComm:
  \forall (a, b: Nat) -> natAdd a b = natAdd b a := I.natAddComm;
\definition natAddZeroRight:
  \forall (n: Nat) -> natAdd n zeroNat = n := I.natAddZeroRight;
\definition natAddZeroLeft:
  \forall (n: Nat) -> natAdd zeroNat n = n := I.natAddZeroLeft;

/* Integer infrastructure is defined in Int; these aliases expose it to
 * Rat child modules, which do not inherit module-import aliases. */
\module Fractions;
