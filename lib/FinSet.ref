/* Fin n is the canonical n-point Set. */
\import \root.Nat[] \as N;
\import N.Laws[] \as NL;
\import \root.Bool[] \as B;

\definition Fin(n: N.Nat^): \Set :=
  \Ty(N.Nat^, \Subset(k, N.Nat^, NL.Lt k n));

\definition value(n: N.Nat^) (i: Fin n): N.Nat^ := i;

\definition bound(n: N.Nat^) (i: Fin n): NL.Lt (value n i) n :=
  \bysub(N.Nat^, \Subset(k, N.Nat^, NL.Lt k n), i);

\definition zero(n: N.Nat^): Fin (N.Nat^::succ n) :=
  \subsetinto(N.Nat^,
    \Subset(k, N.Nat^, NL.Lt k (N.Nat^::succ n)),
    N.Nat^::zero, \refl(B.Bool^::true));

\definition succ(n: N.Nat^) (i: Fin n): Fin (N.Nat^::succ n) :=
  \subsetinto(N.Nat^,
    \Subset(k, N.Nat^, NL.Lt k (N.Nat^::succ n)),
    N.Nat^::succ (value n i),
    NL.ltSuccSucc (value n i) n (bound n i));
