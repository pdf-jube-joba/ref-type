/* A named two-element container used by finite-set constructions. */
\structure FinitePair(A: \Set): \Set := {
  first: A,
  second: A,
};

\definition FinitePair(A: \Set)::pair(first: A)(second: A): FinitePair[A] :=
  FinitePair[A] { first := first, second := second };

\definition make:
  (A: \Set) -> A -> A -> FinitePair[A] :=
  (A: \Set) => (a: A) => (b: A) =>
    FinitePair::pair a b;

\definition first:
  (A: \Set) -> FinitePair[A] -> A :=
  (A: \Set) => (p: FinitePair[A]) =>
    FinitePair::first p;

\definition second:
  (A: \Set) -> FinitePair[A] -> A :=
  (A: \Set) => (p: FinitePair[A]) =>
    FinitePair::second p;
