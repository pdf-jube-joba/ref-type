/* Elementary finite subsets use Power directly, rather than another pair type. */
\import \root.Logic() \as Logic;
\use Logic.or;

\definition singleton (a: A): \Power(A) := \Subset(x, A, x = a);

\definition pair (a, b: A): \Power(A) := \Subset(x, A, or!{{ x = a } { x = b }});

\definition inSingleton (a: A): \Pred(A, singleton a, a) := \refl(a);

\definition inPairLeft (a, b: A): \Pred(A, pair a b, a) := Logic.Or[a = a, a = b]::left (\refl(a));

\definition inPairRight (a, b: A): \Pred(A, pair a b, b) := Logic.Or[b = a, b = b]::right (\refl(b));
