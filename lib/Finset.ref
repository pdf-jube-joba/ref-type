/* Elementary finite subsets use Power directly, rather than another pair type. */
\import \root.Logic() \as Logic;
\use Logic.or;

\definition singleton: A -> \Power(A) :=
  (a: A) => \Subset(x, A, x = a);

\definition pair: A -> A -> \Power(A) :=
  (a, b: A) => \Subset(x, A, or!{(x = a) (x = b)});

\definition inSingleton: (a: A) -> \Pred(A, singleton a, a) :=
  (a: A) => \refl(a);

\definition inPairLeft: (a, b: A) -> \Pred(A, pair a b, a) :=
  (a, b: A) => Logic.Or[a = a, a = b]::left (\refl(a));

\definition inPairRight: (a, b: A) -> \Pred(A, pair a b, b) :=
  (a, b: A) => Logic.Or[b = a, b = b]::right (\refl(b));
