/* Elementary finite subsets use Power directly, rather than another pair type. */
\import \root.Logic() \as Logic;
\use Logic.or;

\definition singleton: A -> \Power(A) :=
  \fun (a: A) => \Subset(x, A, x = a);

\definition pair: A -> A -> \Power(A) :=
  \fun (a, b: A) => \Subset(x, A, or!{\expr { x = a } \expr { x = b }});

\definition inSingleton: \forall (a: A) -> \Pred(A, singleton a, a) :=
  \fun (a: A) => \refl(a);

\definition inPairLeft: \forall (a, b: A) -> \Pred(A, pair a b, a) :=
  \fun (a, b: A) => Logic.Or[a = a, a = b]::left (\refl(a));

\definition inPairRight: \forall (a, b: A) -> \Pred(A, pair a b, b) :=
  \fun (a, b: A) => Logic.Or[b = a, b = b]::right (\refl(b));
