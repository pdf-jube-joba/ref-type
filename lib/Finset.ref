/* Small finite sets, represented inductively so they live in Set. */
\import \root.Logic() \as Logic;
\inductive FinitePair(A: \Set): \Set :=
| pair: A -> A -> FinitePair;
;

\definition make:
  (A: \Set) -> A -> A -> FinitePair[A] :=
  (A: \Set) => (a: A) => (b: A) =>
    FinitePair[A]::pair a b;

\definition first:
  (A: \Set) -> FinitePair[A] -> A :=
  (A: \Set) => (p: FinitePair[A]) =>
    \prec(\Set, FinitePair[A])
      ((q: FinitePair[A]) => A)
      ((a: A) => (b: A) => a)
      p;

\definition second:
  (A: \Set) -> FinitePair[A] -> A :=
  (A: \Set) => (p: FinitePair[A]) =>
    \prec(\Set, FinitePair[A])
      ((q: FinitePair[A]) => A)
      ((a: A) => (b: A) => b)
      p;
