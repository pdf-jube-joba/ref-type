/* Boolean computation lives in Program; Set operations are certified reflections. */
\import \root.Logic[] \as Logic;
\use Logic.not;
\definition False: \Prop := Logic.False;

\inductive Bool: \VType :=
| false: Bool;
| true: Bool;
;

\import \root.Law[Carrier := Bool^] \as Law;

\definition NotEq (x, y: Bool^): \Prop := not!{{ x = y }};

\definition neg: Bool -> Bool := (\cfun (x: Bool) => \match (x) \in Bool \with { | false => \return(Bool::true) |
  true => \return(Bool::false) });
\definition negSet: Bool^ -> Bool^ := \force[Bool -> Bool](\box[Bool -> Bool](neg));
\definition negPrec (x: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (Bool^::true)
  | true => (Bool^::false)
  };
\definition negMatchesPrec: \forall (x: Bool^) -> negSet x = negPrec x :=
  \block {
    \fix (x: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => negSet x = negPrec x) {
      | false => (\refl(negPrec Bool^::false))
      | true => (\refl(negPrec Bool^::true))
      };
  };

\definition and: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk((\cfun (y: Bool) => \match (x) \in Bool \with { | false => \return(Bool::false) | true => \return(y) }))));
\definition andSet: Bool^ -> Bool^ -> Bool^ := \force[Bool -> Bool -> Bool](\box[Bool -> Bool -> Bool](and));
\definition andPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (Bool^::false)
  | true => (y)
  };
\definition andMatchesPrec: \forall (x, y: Bool^) -> andSet x y = andPrec x y :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: andSet Bool^::false y = andPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::false y = andPrec Bool^::false y) {
        | false => (\refl(andPrec Bool^::false Bool^::false))
        | true => (\refl(andPrec Bool^::false Bool^::true))
        };
    \let trueCase: andSet Bool^::true y = andPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::true y = andPrec Bool^::true y) {
        | false => (\refl(andPrec Bool^::true Bool^::false))
        | true => (\refl(andPrec Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => andSet x y = andPrec x y) {
      | false => falseCase
      | true => trueCase
      };
  };

\definition or: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk((\cfun (y: Bool) => \match (x) \in Bool \with { | false => \return(y) | true => \return(Bool::true) }))));
\definition orSet: Bool^ -> Bool^ -> Bool^ := \force[Bool -> Bool -> Bool](\box[Bool -> Bool -> Bool](or));
\definition orPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (y)
  | true => (Bool^::true)
  };
\definition orMatchesPrec: \forall (x, y: Bool^) -> orSet x y = orPrec x y :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: orSet Bool^::false y = orPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::false y = orPrec Bool^::false y) {
        | false => (\refl(orPrec Bool^::false Bool^::false))
        | true => (\refl(orPrec Bool^::false Bool^::true))
        };
    \let trueCase: orSet Bool^::true y = orPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::true y = orPrec Bool^::true y) {
        | false => (\refl(orPrec Bool^::true Bool^::false))
        | true => (\refl(orPrec Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => orSet x y = orPrec x y) {
      | false => falseCase
      | true => trueCase
      };
  };

\definition xor: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk((\cfun (y: Bool) => \match (x) \in Bool \with { | false => \return(y) | true => (neg y) }))));
\definition xorSet: Bool^ -> Bool^ -> Bool^ := \force[Bool -> Bool -> Bool](\box[Bool -> Bool -> Bool](xor));
\definition xorPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (y)
  | true => (negPrec
  y)
  };
\definition xorMatchesPrec: \forall (x, y: Bool^) -> xorSet x y = xorPrec x y :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: xorSet Bool^::false y = xorPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xorSet Bool^::false y = xorPrec Bool^::false y) {
        | false => (\refl(xorPrec Bool^::false Bool^::false))
        | true => (\refl(xorPrec Bool^::false Bool^::true))
        };
    \let trueCase: xorSet Bool^::true y = xorPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xorSet Bool^::true y = xorPrec Bool^::true y) {
        | false => (\refl(xorPrec Bool^::true Bool^::false))
        | true => (\refl(xorPrec Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xorSet x y = xorPrec x y) {
      | false => falseCase
      | true => trueCase
      };
  };

\definition implies: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk((\cfun (y: Bool) => \match (x) \in Bool \with { | false => \return(Bool::true) | true => \return(y) }))));
\definition impliesSet: Bool^ -> Bool^ -> Bool^ := \force[Bool -> Bool -> Bool](\box[Bool -> Bool -> Bool](implies));
\definition impliesPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (Bool^::true)
  | true => (y)
  };
\definition impliesMatchesPrec: \forall (x, y: Bool^) -> impliesSet x y = impliesPrec x y :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: impliesSet Bool^::false y = impliesPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => impliesSet Bool^::false y = impliesPrec Bool^::false y) {
        | false => (\refl(impliesPrec Bool^::false Bool^::false))
        | true => (\refl(impliesPrec Bool^::false Bool^::true))
        };
    \let trueCase: impliesSet Bool^::true y = impliesPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => impliesSet Bool^::true y = impliesPrec Bool^::true y) {
        | false => (\refl(impliesPrec Bool^::true Bool^::false))
        | true => (\refl(impliesPrec Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => impliesSet x y = impliesPrec x y) {
      | false => falseCase
      | true => trueCase
      };
  };

\definition eqb: Bool -> Bool -> Bool := (\cfun (x: Bool) => \return(\thunk((\cfun (y: Bool) => \match (x) \in Bool \with { | false => (neg y) | true => \return(y) }))));
\definition eqbSet: Bool^ -> Bool^ -> Bool^ := \force[Bool -> Bool -> Bool](\box[Bool -> Bool -> Bool](eqb));
\definition eqbPrec (x, y: Bool^): Bool^ := \case x \in Bool^ \return (\fun (b: Bool^) => Bool^) {
  | false => (negPrec y)
  | true => (y)
  };
\definition eqbMatchesPrec: \forall (x, y: Bool^) -> eqbSet x y = eqbPrec x y :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: eqbSet Bool^::false y = eqbPrec Bool^::false y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => eqbSet Bool^::false y = eqbPrec Bool^::false y) {
        | false => (\refl(eqbPrec Bool^::false Bool^::false))
        | true => (\refl(eqbPrec Bool^::false Bool^::true))
        };
    \let trueCase: eqbSet Bool^::true y = eqbPrec Bool^::true y :=
      \case y \in Bool^ \return (\fun (y: Bool^) => eqbSet Bool^::true y = eqbPrec Bool^::true y) {
        | false => (\refl(eqbPrec Bool^::true Bool^::false))
        | true => (\refl(eqbPrec Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => eqbSet x y = eqbPrec x y) {
      | false => falseCase
      | true => trueCase
      };
  };
\definition negInvolutive: \forall (x: Bool^) -> negSet (negSet x) = x :=
  \block {
    \fix (x: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => negSet (negSet x) = x) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::true))
      };
  };
\definition andComm: Law.Commutative andSet :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: andSet Bool^::false y = andSet y Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::false y = andSet y Bool^::false) {
        | false => (\refl(andSet Bool^::false Bool^::false))
        | true => (\refl(andSet Bool^::true Bool^::false))
        };
    \let trueCase: andSet Bool^::true y = andSet y Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::true y = andSet y Bool^::true) {
        | false => (\refl(andSet Bool^::false Bool^::true))
        | true => (\refl(andSet Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => andSet x y = andSet y x) {
      | false => falseCase
      | true => trueCase
      };
  };
\definition orComm: Law.Commutative orSet :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: orSet Bool^::false y = orSet y Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::false y = orSet y Bool^::false) {
        | false => (\refl(orSet Bool^::false Bool^::false))
        | true => (\refl(orSet Bool^::true Bool^::false))
        };
    \let trueCase: orSet Bool^::true y = orSet y Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::true y = orSet y Bool^::true) {
        | false => (\refl(orSet Bool^::false Bool^::true))
        | true => (\refl(orSet Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => orSet x y = orSet y x) {
      | false => falseCase
      | true => trueCase
      };
  };
\definition xorComm: Law.Commutative xorSet :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: xorSet Bool^::false y = xorSet y Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xorSet Bool^::false y = xorSet y Bool^::false) {
        | false => (\refl(xorSet Bool^::false Bool^::false))
        | true => (\refl(xorSet Bool^::true Bool^::false))
        };
    \let trueCase: xorSet Bool^::true y = xorSet y Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => xorSet Bool^::true y = xorSet y Bool^::true) {
        | false => (\refl(xorSet Bool^::false Bool^::true))
        | true => (\refl(xorSet Bool^::true Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xorSet x y = xorSet y x) {
      | false => falseCase
      | true => trueCase
      };
  };
\definition andAssoc: Law.Associative andSet :=
  \block {
    \fix (x, y, z: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => andSet (andSet x y) z = andSet x (andSet y z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => andSet (andSet Bool^::false y) z = andSet Bool^::false (andSet y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet
  (andSet Bool^::false Bool^::false) z = andSet Bool^::false (andSet Bool^::false z)) {
          | false => (\refl(andSet Bool^::false
  (andSet Bool^::false Bool^::false)))
          | true => (\refl(andSet Bool^::false (andSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet (andSet Bool^::false Bool^::true) z = andSet Bool^::false (andSet
  Bool^::true z)) {
          | false => (\refl(andSet Bool^::false (andSet Bool^::true Bool^::false)))
          | true => (\refl(andSet Bool^::false (andSet
  Bool^::true Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => andSet (andSet Bool^::true y) z = andSet
  Bool^::true (andSet y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet (andSet Bool^::true Bool^::false) z = andSet
  Bool^::true (andSet Bool^::false z)) {
          | false => (\refl(andSet Bool^::true (andSet Bool^::false Bool^::false)))
          | true => (\refl(andSet
  Bool^::true (andSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet (andSet Bool^::true
  Bool^::true) z = andSet Bool^::true (andSet Bool^::true z)) {
          | false => (\refl(andSet Bool^::true (andSet Bool^::true
  Bool^::false)))
          | true => (\refl(andSet Bool^::true (andSet Bool^::true Bool^::true)))
          })
        })
      };
  };
\definition orAssoc: Law.Associative orSet :=
  \block {
    \fix (x, y, z: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => orSet (orSet x y) z = orSet x (orSet y z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => orSet (orSet Bool^::false y) z = orSet Bool^::false (orSet y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet (orSet
  Bool^::false Bool^::false) z = orSet Bool^::false (orSet Bool^::false z)) {
          | false => (\refl(orSet Bool^::false (orSet
  Bool^::false Bool^::false)))
          | true => (\refl(orSet Bool^::false (orSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet (orSet Bool^::false Bool^::true) z = orSet Bool^::false (orSet Bool^::true z)) {
          | false => (\refl(orSet
  Bool^::false (orSet Bool^::true Bool^::false)))
          | true => (\refl(orSet Bool^::false (orSet Bool^::true Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => orSet (orSet Bool^::true y) z = orSet Bool^::true (orSet y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet (orSet Bool^::true Bool^::false) z = orSet Bool^::true (orSet Bool^::false z)) {
          | false => (\refl(orSet Bool^::true (orSet Bool^::false Bool^::false)))
          | true => (\refl(orSet Bool^::true (orSet Bool^::false
  Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet (orSet Bool^::true Bool^::true) z = orSet Bool^::true
  (orSet Bool^::true z)) {
          | false => (\refl(orSet Bool^::true (orSet Bool^::true Bool^::false)))
          | true => (\refl(orSet Bool^::true (orSet
  Bool^::true Bool^::true)))
          })
        })
      };
  };
\definition xorAssoc: Law.Associative xorSet :=
  \block {
    \fix (x, y, z: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xorSet (xorSet x y) z = xorSet x (xorSet y z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => xorSet (xorSet Bool^::false y) z = xorSet Bool^::false (xorSet y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => xorSet
  (xorSet Bool^::false Bool^::false) z = xorSet Bool^::false (xorSet Bool^::false z)) {
          | false => (\refl(xorSet Bool^::false
  (xorSet Bool^::false Bool^::false)))
          | true => (\refl(xorSet Bool^::false (xorSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => xorSet (xorSet Bool^::false Bool^::true) z = xorSet Bool^::false (xorSet
  Bool^::true z)) {
          | false => (\refl(xorSet Bool^::false (xorSet Bool^::true Bool^::false)))
          | true => (\refl(xorSet Bool^::false (xorSet
  Bool^::true Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => xorSet (xorSet Bool^::true y) z = xorSet
  Bool^::true (xorSet y z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => xorSet (xorSet Bool^::true Bool^::false) z = xorSet
  Bool^::true (xorSet Bool^::false z)) {
          | false => (\refl(xorSet Bool^::true (xorSet Bool^::false Bool^::false)))
          | true => (\refl(xorSet
  Bool^::true (xorSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => xorSet (xorSet Bool^::true
  Bool^::true) z = xorSet Bool^::true (xorSet Bool^::true z)) {
          | false => (\refl(xorSet Bool^::true (xorSet Bool^::true
  Bool^::false)))
          | true => (\refl(xorSet Bool^::true (xorSet Bool^::true Bool^::true)))
          })
        })
      };
  };
\definition andIdem: Law.Idempotent andSet :=
  \block {
    \fix (x: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => andSet x x = x) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::true))
      };
  };
\definition orIdem: Law.Idempotent orSet :=
  \block {
    \fix (x: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => orSet x x = x) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::true))
      };
  };
\definition xorSelf: \forall (x: Bool^) -> xorSet x x = Bool^::false :=
  \block {
    \fix (x: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => xorSet x x = Bool^::false) {
      | false => (\refl(Bool^::false))
      | true => (\refl(Bool^::false))
      };
  };
\definition eqbRefl: \forall (x: Bool^) -> eqbSet x x = Bool^::true :=
  \block {
    \fix (x: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => eqbSet x x = Bool^::true) {
      | false => (\refl(Bool^::true))
      | true => (\refl(Bool^::true))
      };
  };
\definition deMorganAnd: \forall (x, y: Bool^) -> negSet (andSet x y) = orSet (negSet x) (negSet y) :=
  \block {
    \fix (x, y: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => negSet (andSet x y) = orSet (negSet x) (negSet y)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => negSet (andSet Bool^::false y) = orSet (negSet Bool^::false) (negSet y)) {
        | false => (\refl(orSet (negSet
  Bool^::false) (negSet Bool^::false)))
        | true => (\refl(orSet (negSet Bool^::false) (negSet Bool^::true)))
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => negSet (andSet Bool^::true y) = orSet (negSet Bool^::true) (negSet y)) {
        | false => (\refl(orSet (negSet
  Bool^::true) (negSet Bool^::false)))
        | true => (\refl(orSet (negSet Bool^::true) (negSet Bool^::true)))
        })
      };
  };
\definition deMorganOr: \forall (x, y: Bool^) -> negSet (orSet x y) = andSet (negSet x) (negSet y) :=
  \block {
    \fix (x, y: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => negSet (orSet x y) = andSet (negSet x) (negSet y)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => negSet (orSet Bool^::false y) = andSet (negSet Bool^::false) (negSet y)) {
        | false => (\refl(andSet (negSet
  Bool^::false) (negSet Bool^::false)))
        | true => (\refl(andSet (negSet Bool^::false) (negSet Bool^::true)))
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => negSet (orSet Bool^::true y) = andSet (negSet Bool^::true) (negSet y)) {
        | false => (\refl(andSet (negSet
  Bool^::true) (negSet Bool^::false)))
        | true => (\refl(andSet (negSet Bool^::true) (negSet Bool^::true)))
        })
      };
  };
\definition andDistrib: Law.LeftDistributive andSet orSet :=
  \block {
    \fix (x, y, z: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => andSet x (orSet y z) = orSet (andSet x y) (andSet x z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::false (orSet y z) = orSet (andSet Bool^::false y) (andSet
  Bool^::false z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet Bool^::false (orSet Bool^::false z) = orSet (andSet
  Bool^::false Bool^::false) (andSet Bool^::false z)) {
          | false => (\refl(orSet (andSet Bool^::false Bool^::false) (andSet
  Bool^::false Bool^::false)))
          | true => (\refl(orSet (andSet Bool^::false Bool^::false) (andSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet Bool^::false (orSet Bool^::true z) = orSet (andSet Bool^::false
  Bool^::true) (andSet Bool^::false z)) {
          | false => (\refl(orSet (andSet Bool^::false Bool^::true) (andSet Bool^::false
  Bool^::false)))
          | true => (\refl(orSet (andSet Bool^::false Bool^::true) (andSet Bool^::false Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::true (orSet y z) = orSet (andSet Bool^::true y) (andSet
  Bool^::true z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet Bool^::true (orSet Bool^::false z) = orSet (andSet
  Bool^::true Bool^::false) (andSet Bool^::true z)) {
          | false => (\refl(orSet (andSet Bool^::true Bool^::false) (andSet Bool^::true
  Bool^::false)))
          | true => (\refl(orSet (andSet Bool^::true Bool^::false) (andSet Bool^::true Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => andSet Bool^::true (orSet Bool^::true z) = orSet (andSet Bool^::true Bool^::true) (andSet
  Bool^::true z)) {
          | false => (\refl(orSet (andSet Bool^::true Bool^::true) (andSet Bool^::true Bool^::false)))
          | true => (\refl(orSet
  (andSet Bool^::true Bool^::true) (andSet Bool^::true Bool^::true)))
          })
        })
      };
  };
\definition orDistrib: Law.LeftDistributive orSet andSet :=
  \block {
    \fix (x, y, z: Bool^);
    \return \case x \in Bool^ \return (\fun (x: Bool^) => orSet x (andSet y z) = andSet (orSet x y) (orSet x z)) {
      | false => (\case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::false (andSet y z) = andSet (orSet Bool^::false y) (orSet Bool^::false z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet Bool^::false (andSet Bool^::false z) = andSet (orSet Bool^::false
  Bool^::false) (orSet Bool^::false z)) {
          | false => (\refl(andSet (orSet Bool^::false Bool^::false) (orSet Bool^::false
  Bool^::false)))
          | true => (\refl(andSet (orSet Bool^::false Bool^::false) (orSet Bool^::false Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet Bool^::false (andSet Bool^::true z) = andSet (orSet Bool^::false Bool^::true) (orSet
  Bool^::false z)) {
          | false => (\refl(andSet (orSet Bool^::false Bool^::true) (orSet Bool^::false Bool^::false)))
          | true => (\refl(andSet
  (orSet Bool^::false Bool^::true) (orSet Bool^::false Bool^::true)))
          })
        })
      | true => (\case y \in Bool^ \return (\fun (y: Bool^) => orSet
  Bool^::true (andSet y z) = andSet (orSet Bool^::true y) (orSet Bool^::true z)) {
        | false => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet Bool^::true (andSet Bool^::false z) = andSet (orSet Bool^::true Bool^::false) (orSet Bool^::true z)) {
          | false => (\refl(andSet (orSet Bool^::true Bool^::false) (orSet Bool^::true Bool^::false)))
          | true => (\refl(andSet (orSet Bool^::true
  Bool^::false) (orSet Bool^::true Bool^::true)))
          })
        | true => (\case z \in Bool^ \return (\fun (z: Bool^) => orSet Bool^::true (andSet
  Bool^::true z) = andSet (orSet Bool^::true Bool^::true) (orSet Bool^::true z)) {
          | false => (\refl(andSet (orSet Bool^::true
  Bool^::true) (orSet Bool^::true Bool^::false)))
          | true => (\refl(andSet (orSet Bool^::true Bool^::true) (orSet Bool^::true
  Bool^::true)))
          })
        })
      };
  };
\definition andAbsorb: \forall (x, y: Bool^) -> andSet x (orSet x y) = x :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: andSet Bool^::false (orSet Bool^::false y) = Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::false (orSet Bool^::false y) = Bool^::false) {
        | false => (\refl(Bool^::false))
        | true => (\refl(Bool^::false))
        };
    \let trueCase: andSet Bool^::true (orSet Bool^::true y) = Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => andSet Bool^::true (orSet Bool^::true y) = Bool^::true) {
        | false => (\refl(Bool^::true))
        | true => (\refl(Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => andSet x (orSet x y) = x) {
      | false => falseCase
      | true => trueCase
      };
  };
\definition orAbsorb: \forall (x, y: Bool^) -> orSet x (andSet x y) = x :=
  \block {
    \fix (x, y: Bool^);
    \let falseCase: orSet Bool^::false (andSet Bool^::false y) = Bool^::false :=
      \case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::false (andSet Bool^::false y) = Bool^::false) {
        | false => (\refl(Bool^::false))
        | true => (\refl(Bool^::false))
        };
    \let trueCase: orSet Bool^::true (andSet Bool^::true y) = Bool^::true :=
      \case y \in Bool^ \return (\fun (y: Bool^) => orSet Bool^::true (andSet Bool^::true y) = Bool^::true) {
        | false => (\refl(Bool^::true))
        | true => (\refl(Bool^::true))
        };
    \return \case x \in Bool^ \return (\fun (x: Bool^) => orSet x (andSet x y) = x) {
      | false => falseCase
      | true => trueCase
      };
  };

/* Propositional views and elimination of impossible Boolean equalities. */
\definition IsTrue (b: Bool^): \Prop := b = Bool^::true;
\definition IsFalse (b: Bool^): \Prop := b = Bool^::false;
\definition falseNeTrue: NotEq Bool^::false Bool^::true :=
  \block {
    \fix (e: Bool^::false = Bool^::true);
    \return \idelim(Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\case b \in Bool^ \return (\fun (b: Bool^) => \Pow (Bool^)) {
        | false => ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true => ({ x : Bool^ \where Logic.False })
        }) (Bool^::false))
    \by { base: \refl(Bool^::false), equality: e };
  };
\definition trueNeFalse: NotEq Bool^::true Bool^::false :=
  \block {
    \fix (e: Bool^::true = Bool^::false);
    \let reversed: Bool^::false = Bool^::true :=
      \idelim(Bool^::true = Bool^::false \with b: Bool^ => b = Bool^::true)
        \by { base: \refl(Bool^::true), equality: e };
    \return falseNeTrue reversed;
  };
\definition absurd: \forall (P: \Prop) -> Bool^::false = Bool^::true -> P :=
  \block {
    \fix (P: \Prop);
    \fix (e: Bool^::false = Bool^::true);
    \return \idelim(Bool^::false = Bool^::true
      \with b: Bool^ => \In[Bool^] (\case b \in Bool^ \return (\fun (b: Bool^) => \Pow (Bool^)) {
        | false => ({ x : Bool^ \where Bool^::false = Bool^::false })
        | true => ({ x : Bool^ \where P })
        }) (Bool^::false))
    \by { base: \refl(Bool^::false), equality: e };
  };
\definition eqOfEqbTrue: \forall (a, b: Bool^) -> IsTrue (eqbSet a b) -> a = b :=
  \block {
    \fix (a, b: Bool^);
    \fix (e: IsTrue (eqbSet a b));
    \let byCases: \forall (a, b: Bool^) -> IsTrue (eqbSet a b) -> a = b :=
      \induction (a: Bool^) \return \forall (b: Bool^) -> IsTrue (eqbSet a b) -> a = b \with {
        | false => (\induction (b: Bool^) \return IsTrue (eqbSet Bool^::false b) -> Bool^::false = b \with {
          | false => (\fun (e: Bool^::true = Bool^::true) => \refl(Bool^::false))
          | true => (\fun (e: Bool^::false = Bool^::true) => absurd (Bool^::false = Bool^::true) e)
          })
        | true => (\induction (b: Bool^) \return IsTrue (eqbSet Bool^::true b) -> Bool^::true = b \with {
          | false => (\fun (e: Bool^::false = Bool^::true) => absurd (Bool^::true = Bool^::false) e)
          | true => (\fun (e: Bool^::true = Bool^::true) => \refl(Bool^::true))
          })
        };
    \return byCases a b e;
  };
\definition eqbTrueOfEq: \forall (a, b: Bool^) -> a = b -> IsTrue (eqbSet a b) :=
  \block {
    \fix (a, b: Bool^);
    \fix (e: a = b);
    \return \idelim(a = b \with x: Bool^ => IsTrue (eqbSet a x)) \by { base: eqbRefl a, equality: e };
  };

/* Set-polymorphic selection: a box requires a closed Program type,
 * so this universe-polymorphic wrapper uses prec directly. */
\definition ite (A: \Set) (test: Bool^) (yes: A) (no: A): A :=
    \case test \in Bool^ \return (\fun (b: Bool^) => A) {
      | false => no
      | true => yes
      };
\module ConditionalLaws(A: \Set) {
  \definition iteTrue (yes, no: A): ite A Bool^::true yes no = yes := \refl(yes);
  \definition iteFalse (yes, no: A): ite A Bool^::false yes no = no := \refl(no);
  \definition iteSame: \forall (test: Bool^) -> \forall (value: A) -> ite A test value value = value :=
    \induction (test: Bool^) \return \forall (value: A) -> ite A test value value = value \with {
      | false => (\fun (value: A) => \refl(value))
      | true => (\fun (value: A) => \refl(value))
      };
}
