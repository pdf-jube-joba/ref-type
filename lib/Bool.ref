/* Boolean computation lives in Program; Set operations are certified reflections. */
\import \root.Logic() \as Logic;
\use Logic.not;
\definition False: \Prop := Logic.False;

\inductive Bool: \VType :=
| false: Bool;
| true: Bool;
;

\definition NotEq: Bool -> Bool -> \Prop := (x, y: Bool) => not!{(x = y)};

\cdefinition neg: \CFun(Bool, \F(Bool)) := \clam(x, Bool, \vcase(Bool, x) { | false() => \return(Bool::true); |
  true() => \return(Bool::false); });
\definition negSet: Bool -> Bool := \Force(\CFun(Bool, \F(Bool)), \box(\CFun(Bool, \F(Bool)), neg));
\definition negPrec: Bool -> Bool := (x: Bool) => \prec(\Set, Bool) ((b: Bool) => Bool) (Bool::true)
  (Bool::false) x;
\definition negMatchesPrec: (x: Bool) -> negSet x = negPrec x := (x: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  negSet x = negPrec x) (\refl(negPrec Bool::false)) (\refl(negPrec Bool::true)) x;

\cdefinition and: \CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))) := \clam(x, Bool, \return(\thunk(\clam(y, Bool,
  \vcase(Bool, x) { | false() => \return(Bool::false); | true() => \return(y); }))));
\definition andSet: Bool -> Bool -> Bool := \Force(\CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))), \box(\CFun(Bool,
  \F(\U(\CFun(Bool, \F(Bool))))), and));
\definition andPrec: Bool -> Bool -> Bool := (x, y: Bool) => \prec(\Set, Bool) ((b: Bool) => Bool) (Bool::false)
  (y) x;
\definition andMatchesPrec: (x, y: Bool) -> andSet x y = andPrec x y := (x, y: Bool) => \prec(\Prop, Bool) ((x:
  Bool) => andSet x y = andPrec x y) (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::false y = andPrec
  Bool::false y) (\refl(andPrec Bool::false Bool::false)) (\refl(andPrec Bool::false Bool::true)) y)
  (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::true y = andPrec Bool::true y) (\refl(andPrec Bool::true
  Bool::false)) (\refl(andPrec Bool::true Bool::true)) y) x;

\cdefinition or: \CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))) := \clam(x, Bool, \return(\thunk(\clam(y, Bool,
  \vcase(Bool, x) { | false() => \return(y); | true() => \return(Bool::true); }))));
\definition orSet: Bool -> Bool -> Bool := \Force(\CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))), \box(\CFun(Bool,
  \F(\U(\CFun(Bool, \F(Bool))))), or));
\definition orPrec: Bool -> Bool -> Bool := (x, y: Bool) => \prec(\Set, Bool) ((b: Bool) => Bool) (y)
  (Bool::true) x;
\definition orMatchesPrec: (x, y: Bool) -> orSet x y = orPrec x y := (x, y: Bool) => \prec(\Prop, Bool) ((x:
  Bool) => orSet x y = orPrec x y) (\prec(\Prop, Bool) ((y: Bool) => orSet Bool::false y = orPrec Bool::false y)
  (\refl(orPrec Bool::false Bool::false)) (\refl(orPrec Bool::false Bool::true)) y) (\prec(\Prop, Bool) ((y:
  Bool) => orSet Bool::true y = orPrec Bool::true y) (\refl(orPrec Bool::true Bool::false)) (\refl(orPrec
  Bool::true Bool::true)) y) x;

\cdefinition xor: \CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))) := \clam(x, Bool, \return(\thunk(\clam(y, Bool,
  \vcase(Bool, x) { | false() => \return(y); | true() => \capp(neg, y); }))));
\definition xorSet: Bool -> Bool -> Bool := \Force(\CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))), \box(\CFun(Bool,
  \F(\U(\CFun(Bool, \F(Bool))))), xor));
\definition xorPrec: Bool -> Bool -> Bool := (x, y: Bool) => \prec(\Set, Bool) ((b: Bool) => Bool) (y) (negPrec
  y) x;
\definition xorMatchesPrec: (x, y: Bool) -> xorSet x y = xorPrec x y := (x, y: Bool) => \prec(\Prop, Bool) ((x:
  Bool) => xorSet x y = xorPrec x y) (\prec(\Prop, Bool) ((y: Bool) => xorSet Bool::false y = xorPrec
  Bool::false y) (\refl(xorPrec Bool::false Bool::false)) (\refl(xorPrec Bool::false Bool::true)) y)
  (\prec(\Prop, Bool) ((y: Bool) => xorSet Bool::true y = xorPrec Bool::true y) (\refl(xorPrec Bool::true
  Bool::false)) (\refl(xorPrec Bool::true Bool::true)) y) x;

\cdefinition implies: \CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))) := \clam(x, Bool, \return(\thunk(\clam(y, Bool,
  \vcase(Bool, x) { | false() => \return(Bool::true); | true() => \return(y); }))));
\definition impliesSet: Bool -> Bool -> Bool := \Force(\CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))),
  \box(\CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))), implies));
\definition impliesPrec: Bool -> Bool -> Bool := (x, y: Bool) => \prec(\Set, Bool) ((b: Bool) => Bool)
  (Bool::true) (y) x;
\definition impliesMatchesPrec: (x, y: Bool) -> impliesSet x y = impliesPrec x y := (x, y: Bool) => \prec(\Prop,
  Bool) ((x: Bool) => impliesSet x y = impliesPrec x y) (\prec(\Prop, Bool) ((y: Bool) => impliesSet Bool::false
  y = impliesPrec Bool::false y) (\refl(impliesPrec Bool::false Bool::false)) (\refl(impliesPrec Bool::false
  Bool::true)) y) (\prec(\Prop, Bool) ((y: Bool) => impliesSet Bool::true y = impliesPrec Bool::true y)
  (\refl(impliesPrec Bool::true Bool::false)) (\refl(impliesPrec Bool::true Bool::true)) y) x;

\cdefinition eqb: \CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))) := \clam(x, Bool, \return(\thunk(\clam(y, Bool,
  \vcase(Bool, x) { | false() => \capp(neg, y); | true() => \return(y); }))));
\definition eqbSet: Bool -> Bool -> Bool := \Force(\CFun(Bool, \F(\U(\CFun(Bool, \F(Bool))))), \box(\CFun(Bool,
  \F(\U(\CFun(Bool, \F(Bool))))), eqb));
\definition eqbPrec: Bool -> Bool -> Bool := (x, y: Bool) => \prec(\Set, Bool) ((b: Bool) => Bool) (negPrec y)
  (y) x;
\definition eqbMatchesPrec: (x, y: Bool) -> eqbSet x y = eqbPrec x y := (x, y: Bool) => \prec(\Prop, Bool) ((x:
  Bool) => eqbSet x y = eqbPrec x y) (\prec(\Prop, Bool) ((y: Bool) => eqbSet Bool::false y = eqbPrec
  Bool::false y) (\refl(eqbPrec Bool::false Bool::false)) (\refl(eqbPrec Bool::false Bool::true)) y)
  (\prec(\Prop, Bool) ((y: Bool) => eqbSet Bool::true y = eqbPrec Bool::true y) (\refl(eqbPrec Bool::true
  Bool::false)) (\refl(eqbPrec Bool::true Bool::true)) y) x;
\definition negInvolutive: (x: Bool) -> negSet (negSet x) = x := (x: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  negSet (negSet x) = x) (\refl(Bool::false)) (\refl(Bool::true)) x;
\definition andComm: (x, y: Bool) -> andSet x y = andSet y x := (x, y: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  andSet x y = andSet y x) (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::false y = andSet y Bool::false)
  (\refl(andSet Bool::false Bool::false)) (\refl(andSet Bool::true Bool::false)) y) (\prec(\Prop, Bool) ((y:
  Bool) => andSet Bool::true y = andSet y Bool::true) (\refl(andSet Bool::false Bool::true)) (\refl(andSet
  Bool::true Bool::true)) y) x;
\definition orComm: (x, y: Bool) -> orSet x y = orSet y x := (x, y: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  orSet x y = orSet y x) (\prec(\Prop, Bool) ((y: Bool) => orSet Bool::false y = orSet y Bool::false)
  (\refl(orSet Bool::false Bool::false)) (\refl(orSet Bool::true Bool::false)) y) (\prec(\Prop, Bool) ((y: Bool)
  => orSet Bool::true y = orSet y Bool::true) (\refl(orSet Bool::false Bool::true)) (\refl(orSet Bool::true
  Bool::true)) y) x;
\definition xorComm: (x, y: Bool) -> xorSet x y = xorSet y x := (x, y: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  xorSet x y = xorSet y x) (\prec(\Prop, Bool) ((y: Bool) => xorSet Bool::false y = xorSet y Bool::false)
  (\refl(xorSet Bool::false Bool::false)) (\refl(xorSet Bool::true Bool::false)) y) (\prec(\Prop, Bool) ((y:
  Bool) => xorSet Bool::true y = xorSet y Bool::true) (\refl(xorSet Bool::false Bool::true)) (\refl(xorSet
  Bool::true Bool::true)) y) x;
\definition andAssoc: (x, y, z: Bool) -> andSet (andSet x y) z = andSet x (andSet y z) := (x, y, z: Bool) =>
  \prec(\Prop, Bool) ((x: Bool) => andSet (andSet x y) z = andSet x (andSet y z)) (\prec(\Prop, Bool) ((y: Bool)
  => andSet (andSet Bool::false y) z = andSet Bool::false (andSet y z)) (\prec(\Prop, Bool) ((z: Bool) => andSet
  (andSet Bool::false Bool::false) z = andSet Bool::false (andSet Bool::false z)) (\refl(andSet Bool::false
  (andSet Bool::false Bool::false))) (\refl(andSet Bool::false (andSet Bool::false Bool::true))) z)
  (\prec(\Prop, Bool) ((z: Bool) => andSet (andSet Bool::false Bool::true) z = andSet Bool::false (andSet
  Bool::true z)) (\refl(andSet Bool::false (andSet Bool::true Bool::false))) (\refl(andSet Bool::false (andSet
  Bool::true Bool::true))) z) y) (\prec(\Prop, Bool) ((y: Bool) => andSet (andSet Bool::true y) z = andSet
  Bool::true (andSet y z)) (\prec(\Prop, Bool) ((z: Bool) => andSet (andSet Bool::true Bool::false) z = andSet
  Bool::true (andSet Bool::false z)) (\refl(andSet Bool::true (andSet Bool::false Bool::false))) (\refl(andSet
  Bool::true (andSet Bool::false Bool::true))) z) (\prec(\Prop, Bool) ((z: Bool) => andSet (andSet Bool::true
  Bool::true) z = andSet Bool::true (andSet Bool::true z)) (\refl(andSet Bool::true (andSet Bool::true
  Bool::false))) (\refl(andSet Bool::true (andSet Bool::true Bool::true))) z) y) x;
\definition orAssoc: (x, y, z: Bool) -> orSet (orSet x y) z = orSet x (orSet y z) := (x, y, z: Bool) =>
  \prec(\Prop, Bool) ((x: Bool) => orSet (orSet x y) z = orSet x (orSet y z)) (\prec(\Prop, Bool) ((y: Bool) =>
  orSet (orSet Bool::false y) z = orSet Bool::false (orSet y z)) (\prec(\Prop, Bool) ((z: Bool) => orSet (orSet
  Bool::false Bool::false) z = orSet Bool::false (orSet Bool::false z)) (\refl(orSet Bool::false (orSet
  Bool::false Bool::false))) (\refl(orSet Bool::false (orSet Bool::false Bool::true))) z) (\prec(\Prop, Bool)
  ((z: Bool) => orSet (orSet Bool::false Bool::true) z = orSet Bool::false (orSet Bool::true z)) (\refl(orSet
  Bool::false (orSet Bool::true Bool::false))) (\refl(orSet Bool::false (orSet Bool::true Bool::true))) z) y)
  (\prec(\Prop, Bool) ((y: Bool) => orSet (orSet Bool::true y) z = orSet Bool::true (orSet y z)) (\prec(\Prop,
  Bool) ((z: Bool) => orSet (orSet Bool::true Bool::false) z = orSet Bool::true (orSet Bool::false z))
  (\refl(orSet Bool::true (orSet Bool::false Bool::false))) (\refl(orSet Bool::true (orSet Bool::false
  Bool::true))) z) (\prec(\Prop, Bool) ((z: Bool) => orSet (orSet Bool::true Bool::true) z = orSet Bool::true
  (orSet Bool::true z)) (\refl(orSet Bool::true (orSet Bool::true Bool::false))) (\refl(orSet Bool::true (orSet
  Bool::true Bool::true))) z) y) x;
\definition xorAssoc: (x, y, z: Bool) -> xorSet (xorSet x y) z = xorSet x (xorSet y z) := (x, y, z: Bool) =>
  \prec(\Prop, Bool) ((x: Bool) => xorSet (xorSet x y) z = xorSet x (xorSet y z)) (\prec(\Prop, Bool) ((y: Bool)
  => xorSet (xorSet Bool::false y) z = xorSet Bool::false (xorSet y z)) (\prec(\Prop, Bool) ((z: Bool) => xorSet
  (xorSet Bool::false Bool::false) z = xorSet Bool::false (xorSet Bool::false z)) (\refl(xorSet Bool::false
  (xorSet Bool::false Bool::false))) (\refl(xorSet Bool::false (xorSet Bool::false Bool::true))) z)
  (\prec(\Prop, Bool) ((z: Bool) => xorSet (xorSet Bool::false Bool::true) z = xorSet Bool::false (xorSet
  Bool::true z)) (\refl(xorSet Bool::false (xorSet Bool::true Bool::false))) (\refl(xorSet Bool::false (xorSet
  Bool::true Bool::true))) z) y) (\prec(\Prop, Bool) ((y: Bool) => xorSet (xorSet Bool::true y) z = xorSet
  Bool::true (xorSet y z)) (\prec(\Prop, Bool) ((z: Bool) => xorSet (xorSet Bool::true Bool::false) z = xorSet
  Bool::true (xorSet Bool::false z)) (\refl(xorSet Bool::true (xorSet Bool::false Bool::false))) (\refl(xorSet
  Bool::true (xorSet Bool::false Bool::true))) z) (\prec(\Prop, Bool) ((z: Bool) => xorSet (xorSet Bool::true
  Bool::true) z = xorSet Bool::true (xorSet Bool::true z)) (\refl(xorSet Bool::true (xorSet Bool::true
  Bool::false))) (\refl(xorSet Bool::true (xorSet Bool::true Bool::true))) z) y) x;
\definition andIdem: (x: Bool) -> andSet x x = x := (x: Bool) => \prec(\Prop, Bool) ((x: Bool) => andSet x x =
  x) (\refl(Bool::false)) (\refl(Bool::true)) x;
\definition orIdem: (x: Bool) -> orSet x x = x := (x: Bool) => \prec(\Prop, Bool) ((x: Bool) => orSet x x = x)
  (\refl(Bool::false)) (\refl(Bool::true)) x;
\definition xorSelf: (x: Bool) -> xorSet x x = Bool::false := (x: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  xorSet x x = Bool::false) (\refl(Bool::false)) (\refl(Bool::false)) x;
\definition eqbRefl: (x: Bool) -> eqbSet x x = Bool::true := (x: Bool) => \prec(\Prop, Bool) ((x: Bool) =>
  eqbSet x x = Bool::true) (\refl(Bool::true)) (\refl(Bool::true)) x;
\definition deMorganAnd: (x, y: Bool) -> negSet (andSet x y) = orSet (negSet x) (negSet y) := (x, y: Bool) =>
  \prec(\Prop, Bool) ((x: Bool) => negSet (andSet x y) = orSet (negSet x) (negSet y)) (\prec(\Prop, Bool) ((y:
  Bool) => negSet (andSet Bool::false y) = orSet (negSet Bool::false) (negSet y)) (\refl(orSet (negSet
  Bool::false) (negSet Bool::false))) (\refl(orSet (negSet Bool::false) (negSet Bool::true))) y) (\prec(\Prop,
  Bool) ((y: Bool) => negSet (andSet Bool::true y) = orSet (negSet Bool::true) (negSet y)) (\refl(orSet (negSet
  Bool::true) (negSet Bool::false))) (\refl(orSet (negSet Bool::true) (negSet Bool::true))) y) x;
\definition deMorganOr: (x, y: Bool) -> negSet (orSet x y) = andSet (negSet x) (negSet y) := (x, y: Bool) =>
  \prec(\Prop, Bool) ((x: Bool) => negSet (orSet x y) = andSet (negSet x) (negSet y)) (\prec(\Prop, Bool) ((y:
  Bool) => negSet (orSet Bool::false y) = andSet (negSet Bool::false) (negSet y)) (\refl(andSet (negSet
  Bool::false) (negSet Bool::false))) (\refl(andSet (negSet Bool::false) (negSet Bool::true))) y) (\prec(\Prop,
  Bool) ((y: Bool) => negSet (orSet Bool::true y) = andSet (negSet Bool::true) (negSet y)) (\refl(andSet (negSet
  Bool::true) (negSet Bool::false))) (\refl(andSet (negSet Bool::true) (negSet Bool::true))) y) x;
\definition andDistrib: (x, y, z: Bool) -> andSet x (orSet y z) = orSet (andSet x y) (andSet x z) := (x, y, z:
  Bool) => \prec(\Prop, Bool) ((x: Bool) => andSet x (orSet y z) = orSet (andSet x y) (andSet x z))
  (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::false (orSet y z) = orSet (andSet Bool::false y) (andSet
  Bool::false z)) (\prec(\Prop, Bool) ((z: Bool) => andSet Bool::false (orSet Bool::false z) = orSet (andSet
  Bool::false Bool::false) (andSet Bool::false z)) (\refl(orSet (andSet Bool::false Bool::false) (andSet
  Bool::false Bool::false))) (\refl(orSet (andSet Bool::false Bool::false) (andSet Bool::false Bool::true))) z)
  (\prec(\Prop, Bool) ((z: Bool) => andSet Bool::false (orSet Bool::true z) = orSet (andSet Bool::false
  Bool::true) (andSet Bool::false z)) (\refl(orSet (andSet Bool::false Bool::true) (andSet Bool::false
  Bool::false))) (\refl(orSet (andSet Bool::false Bool::true) (andSet Bool::false Bool::true))) z) y)
  (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::true (orSet y z) = orSet (andSet Bool::true y) (andSet
  Bool::true z)) (\prec(\Prop, Bool) ((z: Bool) => andSet Bool::true (orSet Bool::false z) = orSet (andSet
  Bool::true Bool::false) (andSet Bool::true z)) (\refl(orSet (andSet Bool::true Bool::false) (andSet Bool::true
  Bool::false))) (\refl(orSet (andSet Bool::true Bool::false) (andSet Bool::true Bool::true))) z) (\prec(\Prop,
  Bool) ((z: Bool) => andSet Bool::true (orSet Bool::true z) = orSet (andSet Bool::true Bool::true) (andSet
  Bool::true z)) (\refl(orSet (andSet Bool::true Bool::true) (andSet Bool::true Bool::false))) (\refl(orSet
  (andSet Bool::true Bool::true) (andSet Bool::true Bool::true))) z) y) x;
\definition orDistrib: (x, y, z: Bool) -> orSet x (andSet y z) = andSet (orSet x y) (orSet x z) := (x, y, z:
  Bool) => \prec(\Prop, Bool) ((x: Bool) => orSet x (andSet y z) = andSet (orSet x y) (orSet x z)) (\prec(\Prop,
  Bool) ((y: Bool) => orSet Bool::false (andSet y z) = andSet (orSet Bool::false y) (orSet Bool::false z))
  (\prec(\Prop, Bool) ((z: Bool) => orSet Bool::false (andSet Bool::false z) = andSet (orSet Bool::false
  Bool::false) (orSet Bool::false z)) (\refl(andSet (orSet Bool::false Bool::false) (orSet Bool::false
  Bool::false))) (\refl(andSet (orSet Bool::false Bool::false) (orSet Bool::false Bool::true))) z) (\prec(\Prop,
  Bool) ((z: Bool) => orSet Bool::false (andSet Bool::true z) = andSet (orSet Bool::false Bool::true) (orSet
  Bool::false z)) (\refl(andSet (orSet Bool::false Bool::true) (orSet Bool::false Bool::false))) (\refl(andSet
  (orSet Bool::false Bool::true) (orSet Bool::false Bool::true))) z) y) (\prec(\Prop, Bool) ((y: Bool) => orSet
  Bool::true (andSet y z) = andSet (orSet Bool::true y) (orSet Bool::true z)) (\prec(\Prop, Bool) ((z: Bool) =>
  orSet Bool::true (andSet Bool::false z) = andSet (orSet Bool::true Bool::false) (orSet Bool::true z))
  (\refl(andSet (orSet Bool::true Bool::false) (orSet Bool::true Bool::false))) (\refl(andSet (orSet Bool::true
  Bool::false) (orSet Bool::true Bool::true))) z) (\prec(\Prop, Bool) ((z: Bool) => orSet Bool::true (andSet
  Bool::true z) = andSet (orSet Bool::true Bool::true) (orSet Bool::true z)) (\refl(andSet (orSet Bool::true
  Bool::true) (orSet Bool::true Bool::false))) (\refl(andSet (orSet Bool::true Bool::true) (orSet Bool::true
  Bool::true))) z) y) x;
\definition andAbsorb: (x, y: Bool) -> andSet x (orSet x y) = x := (x, y: Bool) => \prec(\Prop, Bool) ((x: Bool)
  => andSet x (orSet x y) = x) (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::false (orSet Bool::false y) =
  Bool::false) (\refl(Bool::false)) (\refl(Bool::false)) y) (\prec(\Prop, Bool) ((y: Bool) => andSet Bool::true
  (orSet Bool::true y) = Bool::true) (\refl(Bool::true)) (\refl(Bool::true)) y) x;
\definition orAbsorb: (x, y: Bool) -> orSet x (andSet x y) = x := (x, y: Bool) => \prec(\Prop, Bool) ((x: Bool)
  => orSet x (andSet x y) = x) (\prec(\Prop, Bool) ((y: Bool) => orSet Bool::false (andSet Bool::false y) =
  Bool::false) (\refl(Bool::false)) (\refl(Bool::false)) y) (\prec(\Prop, Bool) ((y: Bool) => orSet Bool::true
  (andSet Bool::true y) = Bool::true) (\refl(Bool::true)) (\refl(Bool::true)) y) x;

/* Propositional views and elimination of impossible Boolean equalities. */
\definition IsTrue: Bool -> \Prop := (b: Bool) => b = Bool::true;
\definition IsFalse: Bool -> \Prop := (b: Bool) => b = Bool::false;
\definition falseNeTrue: NotEq Bool::false Bool::true :=
  (e: Bool::false = Bool::true) =>
    \idelim(Bool::false = Bool::true
      \with b: Bool => \Pred(Bool,
        \prec(\Set, Bool) ((b: Bool) => \Power(Bool))
          (\Subset(x, Bool, Bool::false = Bool::false))
          (\Subset(x, Bool, Logic.False)) b, Bool::false))
    \by (\refl(Bool::false), e);
\definition trueNeFalse: NotEq Bool::true Bool::false :=
  (e: Bool::true = Bool::false) => falseNeTrue
    (\idelim(Bool::true = Bool::false \with b: Bool => b = Bool::true) \by (\refl(Bool::true), e));
\definition absurd: (P: \Prop) -> Bool::false = Bool::true -> P :=
  (P: \Prop) => (e: Bool::false = Bool::true) =>
    \idelim(Bool::false = Bool::true
      \with b: Bool => \Pred(Bool,
        \prec(\Set, Bool) ((b: Bool) => \Power(Bool))
          (\Subset(x, Bool, Bool::false = Bool::false))
          (\Subset(x, Bool, P)) b, Bool::false))
    \by (\refl(Bool::false), e);
\definition eqOfEqbTrue: (a, b: Bool) -> IsTrue (eqbSet a b) -> a = b :=
  \prec(\Prop, Bool) ((a: Bool) => (b: Bool) -> IsTrue (eqbSet a b) -> a = b)
    (\prec(\Prop, Bool) ((b: Bool) => IsTrue (eqbSet Bool::false b) -> Bool::false = b)
      ((e: Bool::true = Bool::true) => \refl(Bool::false))
      ((e: Bool::false = Bool::true) => absurd (Bool::false = Bool::true) e))
    (\prec(\Prop, Bool) ((b: Bool) => IsTrue (eqbSet Bool::true b) -> Bool::true = b)
      ((e: Bool::false = Bool::true) => absurd (Bool::true = Bool::false) e)
      ((e: Bool::true = Bool::true) => \refl(Bool::true)));
\definition eqbTrueOfEq: (a, b: Bool) -> a = b -> IsTrue (eqbSet a b) :=
  (a, b: Bool) => (e: a = b) =>
    \idelim(a = b \with x: Bool => IsTrue (eqbSet a x)) \by (eqbRefl a, e);

/* Set-polymorphic selection: a box requires a closed Program type,
 * so this universe-polymorphic wrapper uses prec directly. */
\definition ite: (A: \Set) -> Bool -> A -> A -> A :=
  (A: \Set) => (test: Bool) => (yes: A) => (no: A) =>
    \prec(\Set, Bool) ((b: Bool) => A) no yes test;
\module ConditionalLaws(A: \Set) {
  \definition iteTrue: (yes, no: A) -> ite A Bool::true yes no = yes :=
    (yes, no: A) => \refl(yes);
  \definition iteFalse: (yes, no: A) -> ite A Bool::false yes no = no :=
    (yes, no: A) => \refl(no);
  \definition iteSame: (test: Bool) -> (value: A) -> ite A test value value = value :=
    \prec(\Prop, Bool) ((test: Bool) => (value: A) -> ite A test value value = value)
      ((value: A) => \refl(value)) ((value: A) => \refl(value));
}
