/* Algebraic structures keep Set-valued data separate from Prop-valued laws. */
\import \root.Logic[].Law[Carrier := Carrier] \as Law;

\record RawMonoid: \Set := {
  unit: Carrier,
  op: Carrier -> Carrier -> Carrier,
};

\record MonoidLaws(s: RawMonoid): \Prop := {
  leftIdentity: Law.LeftUnital (#op{s}) (#unit{s}),
  rightIdentity: Law.RightUnital (#op{s}) (#unit{s}),
  associative: Law.Associative (#op{s}),
};

\definition monoidLawsIntro (s: RawMonoid)
  (left: \forall (x: Carrier) -> #op{s} (#unit{s}) x = x)
  (right: \forall (x: Carrier) -> #op{s} x (#unit{s}) = x)
  (assoc: \forall (x, y, z: Carrier) ->
    #op{s} (#op{s} x y) z = #op{s} x (#op{s} y z)):
  MonoidLaws[s] :=
    MonoidLaws[s]::# (left) (right) (assoc);

\definition MonoidSet: \Pow (RawMonoid) :=
  { s : RawMonoid \where MonoidLaws[s] };

\definition Monoid: \Set :=
  \Cast[RawMonoid] (MonoidSet);

\definition raw (s: Monoid): RawMonoid := s;

\definition laws (s: Monoid): MonoidLaws[s] := \bysub(RawMonoid, MonoidSet, s);

\definition leftIdentity (s: Monoid) (x: Carrier):
  #op{(raw s)} (#unit{(raw s)}) x = x := #leftIdentity{(laws s)} x;

\definition rightIdentity (s: Monoid) (x: Carrier):
  #op{(raw s)} x (#unit{(raw s)}) = x := #rightIdentity{(laws s)} x;

\definition associative (s: Monoid) (x, y, z: Carrier):
  #op{(raw s)} (#op{(raw s)} x y) z = #op{(raw s)} x (#op{(raw s)} y z) :=
  #associative{(laws s)} x y z;

\record CommutativeMonoidLaws(s: RawMonoid): \Prop := {
  monoid: MonoidLaws[s],
  commutative: Law.Commutative (#op{s}),
};

\definition commutativeMonoidLawsIntro (s: RawMonoid)
  (base: MonoidLaws[s])
  (comm: \forall (x, y: Carrier) -> #op{s} x y = #op{s} y x):
  CommutativeMonoidLaws[s] :=
    CommutativeMonoidLaws[s]::# (base) (comm);

\definition CommutativeMonoidSet: \Pow (RawMonoid) :=
  { s : RawMonoid \where CommutativeMonoidLaws[s] };

\definition CommutativeMonoid: \Set :=
  \Cast[RawMonoid] (CommutativeMonoidSet);

\definition commutativeLaws (s: CommutativeMonoid): CommutativeMonoidLaws[s] :=
    \bysub(RawMonoid, CommutativeMonoidSet, s);

\definition asMonoid (s: CommutativeMonoid): Monoid :=
    \into[RawMonoid](s, MonoidSet) \by { #monoid{(commutativeLaws s)} };

\definition commutative (s: CommutativeMonoid) (x, y: Carrier):
  #op{(raw (asMonoid s))} x y = #op{(raw (asMonoid s))} y x :=
  #commutative{(commutativeLaws s)} x y;
