/* Groups, semirings, rings and fields over one fixed carrier. */
\import \root.Logic[].Proposition[] \as Logic;
\import \root.Algebra[].Monoid[Carrier := Carrier] \as M;
\import \root.Logic[].Law[Carrier := Carrier] \as Law;
\use Logic.not;

\record RawGroup: \Set := {
  unit: Carrier,
  op: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
};

\definition groupMonoid (s: RawGroup): M.RawMonoid := M.RawMonoid::# (#unit{s}) (#op{s});

\record GroupLaws(s: RawGroup): \Prop := {
  monoid: M.MonoidLaws[groupMonoid s],
  leftInverse: Law.LeftInvertible (#op{s}) (#unit{s}) (#inv{s}),
  rightInverse: Law.RightInvertible (#op{s}) (#unit{s}) (#inv{s}),
};

\definition groupLawsIntro (s: RawGroup)
  (left: \forall (x: Carrier) -> #op{s} (#unit{s}) x = x)
  (right: \forall (x: Carrier) -> #op{s} x (#unit{s}) = x)
  (assoc: \forall (x, y, z: Carrier) ->
    #op{s} (#op{s} x y) z = #op{s} x (#op{s} y z))
  (leftInv: \forall (x: Carrier) -> #op{s} (#inv{s} x) x = #unit{s})
  (rightInv: \forall (x: Carrier) -> #op{s} x (#inv{s} x) = #unit{s}):
  GroupLaws[s] :=
    GroupLaws[s]::# (M.monoidLawsIntro (groupMonoid s) left right assoc) (leftInv) (rightInv);

\definition GroupSet: \Pow (RawGroup) :=
  { s : RawGroup \where GroupLaws[s] };
\definition Group: \Set := \Cast[RawGroup] (GroupSet);
\definition groupLaws (s: Group): GroupLaws[s] := \bysub(RawGroup, GroupSet, s);

\record CommutativeGroupLaws(s: RawGroup): \Prop := {
  group: GroupLaws[s],
  commutative: Law.Commutative (#op{s}),
};

\definition commutativeGroupLawsIntro
  (s: RawGroup)
  (base: GroupLaws[s])
  (comm: \forall (x, y: Carrier) -> #op{s} x y = #op{s} y x):
  CommutativeGroupLaws[s] :=
  CommutativeGroupLaws[s]::# (base) (comm);

\definition CommutativeGroupSet: \Pow (RawGroup) :=
  { s : RawGroup \where CommutativeGroupLaws[s] };
\definition CommutativeGroup: \Set :=
  \Cast[RawGroup] (CommutativeGroupSet);
\definition commutativeGroupLaws (s: CommutativeGroup): CommutativeGroupLaws[s] :=
    \bysub(RawGroup, CommutativeGroupSet, s);
\definition asGroup (s: CommutativeGroup): Group :=
    \into[RawGroup](s, GroupSet) \by { #group{(commutativeGroupLaws s)} };

\record RawSemiring: \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
};

\definition additiveMonoid (s: RawSemiring): M.RawMonoid := M.RawMonoid::# (#zero{s}) (#add{s});
\definition multiplicativeMonoid (s: RawSemiring): M.RawMonoid := M.RawMonoid::# (#one{s}) (#mul{s});

\record SemiringLaws(s: RawSemiring): \Prop := {
  additive: M.CommutativeMonoidLaws[additiveMonoid s],
  multiplicative: M.MonoidLaws[multiplicativeMonoid s],
  leftDistributive: Law.LeftDistributive (#mul{s}) (#add{s}),
  rightDistributive: Law.RightDistributive (#mul{s}) (#add{s}),
  zeroAbsorbsLeft: \forall (x: Carrier) -> #mul{s} (#zero{s}) x = #zero{s},
  zeroAbsorbsRight: \forall (x: Carrier) -> #mul{s} x (#zero{s}) = #zero{s},
};

\definition semiringLawsIntro (s: RawSemiring)
  (addLeft: \forall (x: Carrier) -> #add{s} (#zero{s}) x = x)
  (addRight: \forall (x: Carrier) -> #add{s} x (#zero{s}) = x)
  (addAssoc: \forall (x, y, z: Carrier) -> #add{s} (#add{s} x y) z = #add{s} x (#add{s} y z))
  (addComm: \forall (x, y: Carrier) -> #add{s} x y = #add{s} y x)
  (mulLeft: \forall (x: Carrier) -> #mul{s} (#one{s}) x = x)
  (mulRight: \forall (x: Carrier) -> #mul{s} x (#one{s}) = x)
  (mulAssoc: \forall (x, y, z: Carrier) -> #mul{s} (#mul{s} x y) z = #mul{s} x (#mul{s} y z))
  (distribLeft: \forall (x, y, z: Carrier) -> #mul{s} x (#add{s} y z) = #add{s} (#mul{s} x y) (#mul{s} x z))
  (distribRight: \forall (x, y, z: Carrier) -> #mul{s} (#add{s} x y) z = #add{s} (#mul{s} x z) (#mul{s} y z))
  (absorbLeft: \forall (x: Carrier) -> #mul{s} (#zero{s}) x = #zero{s})
  (absorbRight: \forall (x: Carrier) -> #mul{s} x (#zero{s}) = #zero{s}):
  SemiringLaws[s] :=
  SemiringLaws[s]::# (M.commutativeMonoidLawsIntro (additiveMonoid s)
        (M.monoidLawsIntro (additiveMonoid s)
          addLeft addRight addAssoc) addComm) (M.monoidLawsIntro (multiplicativeMonoid s)
        mulLeft mulRight mulAssoc) (distribLeft) (distribRight) (absorbLeft) (absorbRight);

\definition SemiringSet: \Pow (RawSemiring) :=
  { s : RawSemiring \where SemiringLaws[s] };
\definition Semiring: \Set := \Cast[RawSemiring] (SemiringSet);
\definition semiringLaws (s: Semiring): SemiringLaws[s] := \bysub(RawSemiring, SemiringSet, s);

\record RawRing: \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
};

\definition ringSemiring (s: RawRing): RawSemiring := RawSemiring::# (#zero{s}) (#one{s}) (#add{s}) (#mul{s});

\record RingLaws(s: RawRing): \Prop := {
  semiring: SemiringLaws[ringSemiring s],
  additiveInverse: \forall (x: Carrier) ->
    #add{s} (#neg{s} x) x = #zero{s},
};

\definition ringLawsIntro (s: RawRing)
  (base: SemiringLaws[ringSemiring s])
  (inverse: \forall (x: Carrier) -> #add{s} (#neg{s} x) x = #zero{s}):
  RingLaws[s] :=
    RingLaws[s]::# (base) (inverse);

\definition RingSet: \Pow (RawRing) :=
  { s : RawRing \where RingLaws[s] };
\definition Ring: \Set := \Cast[RawRing] (RingSet);
\definition ringLaws (s: Ring): RingLaws[s] := \bysub(RawRing, RingSet, s);
\definition ringAsSemiring (s: Ring): Semiring :=
    \into[RawSemiring](ringSemiring s, SemiringSet) \by { #semiring{(ringLaws s)} };

\record CommutativeRingLaws(s: RawRing): \Prop := {
  ring: RingLaws[s],
  mulCommutative: \forall (x, y: Carrier) ->
    #mul{s} x y = #mul{s} y x,
};

\definition commutativeRingLawsIntro (s: RawRing)
  (base: RingLaws[s])
  (comm: \forall (x, y: Carrier) -> #mul{s} x y = #mul{s} y x):
  CommutativeRingLaws[s] :=
    CommutativeRingLaws[s]::# (base) (comm);

\definition CommutativeRingSet: \Pow (RawRing) :=
  { s : RawRing \where CommutativeRingLaws[s] };
\definition CommutativeRing: \Set :=
  \Cast[RawRing] (CommutativeRingSet);
\definition commutativeRingLaws (s: CommutativeRing): CommutativeRingLaws[s] :=
    \bysub(RawRing, CommutativeRingSet, s);
\definition commutativeRingAsRing (s: CommutativeRing): Ring :=
    \into[RawRing](s, RingSet) \by { #ring{(commutativeRingLaws s)} };

\record RawField: \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
};

\definition fieldRing (s: RawField): RawRing := RawRing::# (#zero{s}) (#one{s}) (#add{s}) (#neg{s}) (#mul{s});
\definition FieldNonZero (s: RawField) (x: Carrier): \Prop :=
    not!{{ x = #zero{s} }};
\definition FieldNontrivial (s: RawField): \Prop := not!{{ #zero{s} = #one{s} }};
\definition FieldInverseLaws (s: RawField): \Prop :=
    \forall (x: Carrier) -> FieldNonZero s x ->
      #mul{s} (#inv{s} x) x = #one{s};

\definition FieldLaws (s: RawField): \Prop :=
    Logic.And[CommutativeRingLaws[fieldRing s],
      Logic.And[FieldNontrivial s, FieldInverseLaws s]];

\definition fieldLawsIntro (s: RawField) (ring: CommutativeRingLaws[fieldRing s]) (nontrivial: FieldNontrivial s) (inverse: FieldInverseLaws s): FieldLaws s :=
    Logic.And[
      CommutativeRingLaws[fieldRing s],
      Logic.And[FieldNontrivial s, FieldInverseLaws s]
    ]::# (ring) (Logic.And[FieldNontrivial s, FieldInverseLaws s]::# (nontrivial) (inverse));

\definition FieldSet: \Pow (RawField) :=
  { s : RawField \where FieldLaws s };
\definition Field: \Set := \Cast[RawField] (FieldSet);
\definition fieldLaws (s: Field): FieldLaws s := \bysub(RawField, FieldSet, s);
\definition fieldCommutativeRingLaws (s: Field): CommutativeRingLaws[fieldRing s] :=
    (\fun (h: Logic.And[
      CommutativeRingLaws[fieldRing s],
      Logic.And[FieldNontrivial s, FieldInverseLaws s]
    ]) => #left{h}) (fieldLaws s);
\definition fieldNontrivial (s: Field): FieldNontrivial s :=
    (\fun (h: Logic.And[FieldNontrivial s, FieldInverseLaws s]) =>
      #left{h})
      ((\fun (h: Logic.And[
        CommutativeRingLaws[fieldRing s],
        Logic.And[FieldNontrivial s, FieldInverseLaws s]
      ]) => #right{h}) (fieldLaws s));
\definition fieldInverse (s: Field): FieldInverseLaws s :=
    (\fun (h: Logic.And[FieldNontrivial s, FieldInverseLaws s]) =>
      #right{h})
      ((\fun (h: Logic.And[
        CommutativeRingLaws[fieldRing s],
        Logic.And[FieldNontrivial s, FieldInverseLaws s]
      ]) => #right{h}) (fieldLaws s));
\definition fieldAsCommutativeRing (s: Field): CommutativeRing :=
    \into[RawRing](fieldRing s, CommutativeRingSet) \by { fieldCommutativeRingLaws s };
