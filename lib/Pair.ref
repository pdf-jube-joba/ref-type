/* A proof-free Cartesian product and its basic equations. */
\inductive Times(A, B: \VType): \VType :=
| pair: A -> B -> Times;
;

\definition pair:
  \forall (A, B: \Set) -> A -> B -> Times[A, B] :=
  \fun (A, B: \Set) => \fun (a: A) => \fun (b: B) =>
    Times[A, B]::pair a b;

\definition first:
  \forall (A, B: \Set) -> Times[A, B] -> A :=
  \fun (A, B: \Set) => \fun (p: Times[A, B]) =>
    \prec(\Set, Times[A, B])
      (\fun (p: Times[A, B]) => A)
      (\fun (a: A) => \fun (b: B) => a)
      p;

\definition second:
  \forall (A, B: \Set) -> Times[A, B] -> B :=
  \fun (A, B: \Set) => \fun (p: Times[A, B]) =>
    \prec(\Set, Times[A, B])
      (\fun (p: Times[A, B]) => B)
      (\fun (a: A) => \fun (b: B) => b)
      p;

\definition swap: \forall (A, B: \Set) -> Times[A, B] -> Times[B, A] :=
  \fun (A, B: \Set) => \fun (p: Times[A, B]) =>
    pair B A (second A B p) (first A B p);

\definition map: \forall (A, B, C, D: \Set) -> (A -> C) -> (B -> D) -> Times[A, B] -> Times[C, D] :=
  \fun (A, B, C, D: \Set) => \fun (f: A -> C) => \fun (g: B -> D) => \fun (p: Times[A, B]) =>
    pair C D (f (first A B p)) (g (second A B p));

\definition curry: \forall (A, B, C: \Set) -> (Times[A, B] -> C) -> A -> B -> C :=
  \fun (A, B, C: \Set) => \fun (f: Times[A, B] -> C) => \fun (a: A) => \fun (b: B) =>
    f (pair A B a b);

\definition uncurry: \forall (A, B, C: \Set) -> (A -> B -> C) -> Times[A, B] -> C :=
  \fun (A, B, C: \Set) => \fun (f: A -> B -> C) => \fun (p: Times[A, B]) =>
    f (first A B p) (second A B p);

/* Laws quantify over elements; their carrier universes are module parameters. */
\module Laws(A, B: \Set);
\module MapLaws(A, B, C, D: \Set);
\module FunctionLaws(A, B, C: \Set);
