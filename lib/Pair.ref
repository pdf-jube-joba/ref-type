/* One Cartesian product for Program values and arbitrary Set carriers. */
\inductive Times(A, B: \VType): \VType :=
| pair: A -> B -> Times;
;

/* Associated computations infer their carrier arguments from the values. */
\definition Times(A, B: \VType)::make(a: A, b: B): \F(Times[A, B]) :=
  \return Times[A, B]::pair a b;

\definition Times(A, B: \VType)::first(p: Times[A, B]): \F(A) :=
  \match p \in Times \with { | pair a b => \return a };

\definition Times(A, B: \VType)::second(p: Times[A, B]): \F(B) :=
  \match p \in Times \with { | pair a b => \return b };

\definition Times(A, B: \VType)::swap(p: Times[A, B]): \F(Times[B, A]) :=
  \match p \in Times \with { | pair a b => \return Times[B, A]::pair b a };

/* The Set API also works when A and B have no Program representation. */
\definition pair (A, B: \Set) (a: A) (b: B): Times^[A, B] :=
    Times^[A, B]::pair a b;

\definition first (A, B: \Set) (p: Times^[A, B]): A :=
    \prec[Times^[A, B], \fun (p: Times^[A, B]) => A]
      (\fun (a: A) => \fun (b: B) => a)
      p;

\definition second (A, B: \Set) (p: Times^[A, B]): B :=
    \prec[Times^[A, B], \fun (p: Times^[A, B]) => B]
      (\fun (a: A) => \fun (b: B) => b)
      p;

\definition swap (A, B: \Set) (p: Times^[A, B]): Times^[B, A] :=
    pair B A (second A B p) (first A B p);

\definition map (A, B, C, D: \Set) (f: A -> C) (g: B -> D) (p: Times^[A, B]): Times^[C, D] :=
    pair C D (f (first A B p)) (g (second A B p));

\definition mapFirst (A, B, C: \Set) (f: A -> C): Times^[A, B] -> Times^[C, B] :=
    map A B C B f (\fun (b: B) => b);

\definition mapSecond (A, B, C: \Set) (g: B -> C): Times^[A, B] -> Times^[A, C] :=
    map A B A C (\fun (a: A) => a) g;

\definition curry (A, B, C: \Set) (f: Times^[A, B] -> C) (a: A) (b: B): C :=
    f (pair A B a b);

\definition uncurry (A, B, C: \Set) (f: A -> B -> C) (p: Times^[A, B]): C :=
    f (first A B p) (second A B p);

\definition assoc (A, B, C: \Set) (p: Times^[Times^[A, B], C]): Times^[A, Times^[B, C]] :=
    pair A Times^[B, C] (first A B (first Times^[A, B] C p))
      (pair B C (second A B (first Times^[A, B] C p)) (second Times^[A, B] C p));

\definition unassoc (A, B, C: \Set) (p: Times^[A, Times^[B, C]]): Times^[Times^[A, B], C] :=
    pair Times^[A, B] C
      (pair A B (first A Times^[B, C] p) (first B C (second A Times^[B, C] p)))
      (second B C (second A Times^[B, C] p));

/* Laws quantify over elements; their carrier universes are module parameters. */
\module Laws(A, B: \Set);
\module MapLaws(A, B, C, D: \Set);
\module FunctionLaws(A, B, C: \Set);

/* Open this child from an existing Pair instance to share its Times type. */
\module Program(A, B: \VType);
