/* A proof-free Cartesian product and its basic equations. */
\inductive Times(A, B: \VType): \VType :=
| pair: A -> B -> Times;
;

\definition pair:
  (A, B: \Set) -> A -> B -> Times[A, B] :=
  (A, B: \Set) => (a: A) => (b: B) =>
    Times[A, B]::pair a b;

\definition first:
  (A, B: \Set) -> Times[A, B] -> A :=
  (A, B: \Set) => (p: Times[A, B]) =>
    \prec(\Set, Times[A, B])
      ((p: Times[A, B]) => A)
      ((a: A) => (b: B) => a)
      p;

\definition second:
  (A, B: \Set) -> Times[A, B] -> B :=
  (A, B: \Set) => (p: Times[A, B]) =>
    \prec(\Set, Times[A, B])
      ((p: Times[A, B]) => B)
      ((a: A) => (b: B) => b)
      p;

\definition swap: (A, B: \Set) -> Times[A, B] -> Times[B, A] :=
  (A, B: \Set) => (p: Times[A, B]) =>
    pair B A (second A B p) (first A B p);

\definition map: (A, B, C, D: \Set) -> (A -> C) -> (B -> D) -> Times[A, B] -> Times[C, D] :=
  (A, B, C, D: \Set) => (f: A -> C) => (g: B -> D) => (p: Times[A, B]) =>
    pair C D (f (first A B p)) (g (second A B p));

\definition curry: (A, B, C: \Set) -> (Times[A, B] -> C) -> A -> B -> C :=
  (A, B, C: \Set) => (f: Times[A, B] -> C) => (a: A) => (b: B) =>
    f (pair A B a b);

\definition uncurry: (A, B, C: \Set) -> (A -> B -> C) -> Times[A, B] -> C :=
  (A, B, C: \Set) => (f: A -> B -> C) => (p: Times[A, B]) =>
    f (first A B p) (second A B p);

/* Laws quantify over elements; their carrier universes are module parameters. */
\module Laws(A, B: \Set);
\module MapLaws(A, B, C, D: \Set);
\module FunctionLaws(A, B, C: \Set);
