/*
 * Constructive real numbers as located, rounded Dedekind cuts.
 *
 * The rational carrier and its strict order come from Rat.ref.  The carrier
 * is the positive-denominator representative type; FractionEq records the
 * equality that the remaining rational lemmas must respect.
 */
\import \root.Logic() \as Logic;
\import \root.Rat() \as Rational;

  \definition Rat: \Set := Rational.Fraction;

  \definition lt: Rat -> Rat -> \Prop :=
    (x, y: Rat) => Rational.lt x y;

  \definition addRat: Rat -> Rat -> Rat :=
    (x, y: Rat) => Rational.add x y;

  \definition negRat: Rat -> Rat :=
    (x: Rat) => Rational.neg x;

  \definition zeroRat: Rat := Rational.zero;

  /* Membership in a rational lower set. */
  \definition In: \Power(Rat) -> Rat -> \Prop :=
    (L: \Power(Rat)) => (q: Rat) => \Pred(Rat, L, q);

  /* A lower set is inhabited and proper. */
  \definition Inhabited: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      \exists \Ty(Rat, \Subset(q, Rat, In L q));

  \definition Proper: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      \exists \Ty(Rat, \Subset(q, Rat, Logic.Not (In L q)));

  /* It is downward closed and has no greatest member. */
  \definition Lower: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      (p, q: Rat) -> lt p q -> In L q -> In L p;

  \definition Rounded: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      (p: Rat) -> In L p ->
        \exists \Ty(Rat, \Subset(q, Rat, Logic.And[In L q, lt p q]));

  /* Locatedness is the constructive replacement for deciding membership. */
  \definition Located: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      (p, q: Rat) -> lt p q -> Logic.Or[In L p, Logic.Not (In L q)];

  /* Membership must not depend on the chosen fraction representative. */
  \definition RespectsFractionEq: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      (p, q: Rat) -> Rational.FractionEq p q -> In L p -> In L q;

  \definition IsCut: \Power(Rat) -> \Prop :=
    (L: \Power(Rat)) =>
      Logic.And[Inhabited L,
        Logic.And[Proper L,
          Logic.And[Lower L,
            Logic.And[Rounded L,
              Logic.And[Located L, RespectsFractionEq L]]]]];

  /* Real is the refinement of rational lower sets by the cut laws. */
  \definition CutSet: \Power(\Power(Rat)) :=
    \Subset(L, \Power(Rat), IsCut L);

  \definition Real: \Set :=
    \Ty(\Power(Rat), CutSet);

  /* A real weakens to its underlying rational lower set. */
  \definition mem: Real -> Rat -> \Prop :=
    (x: Real) => (q: Rat) => In x q;

  /* Inclusion is available without any extensionality principle. */
  \definition Le: Real -> Real -> \Prop :=
    (x, y: Real) => (q: Rat) -> mem x q -> mem y q;

  \definition Eq: Real -> Real -> \Prop :=
    (x, y: Real) => x = y;

  \definition leRefl: (x: Real) -> Le x x :=
    (x: Real) => (q: Rat) => (qx: mem x q) => qx;

  \definition leTrans:
    (x, y, z: Real) -> Le x y -> Le y z -> Le x z :=
    (x, y, z: Real) => (xy: Le x y) => (yz: Le y z) =>
      (q: Rat) => (qx: mem x q) => yz q (xy q qx);

  /* Kernel equality of cuts additionally needs subset extensionality. */
  \module Extensionality(
    setExt:
      (A, B: \Power(Rat)) ->
        ((q: Rat) -> \Pred(Rat, A, q) -> \Pred(Rat, B, q)) ->
        ((q: Rat) -> \Pred(Rat, B, q) -> \Pred(Rat, A, q)) ->
        A = B,
  ) {
    \definition eqByExt:
      (x, y: Real) -> Le x y -> Le y x -> Eq x y :=
      (x, y: Real) => (xy: Le x y) => (yx: Le y x) =>
        setExt x y xy yx;

    \definition leAntisym:
      (x, y: Real) -> Le x y -> Le y x -> x = y :=
      (x, y: Real) => (xy: Le x y) => (yx: Le y x) =>
        eqByExt x y xy yx;
  }

  \definition Lt: Real -> Real -> \Prop :=
    (x, y: Real) =>
      \exists \Ty(Rat,
        \Subset(q, Rat, Logic.And[Logic.Not (mem x q), mem y q]));

  /*
   * Arithmetic lower sets.  The nested Closed module asks for exactly the
   * closure lemmas needed to refine these sets back to Real.  This keeps the
   * construction honest while the concrete rational laws are being proved.
   */
  \module Operations {
    \import \root.Logic() \as Logic;

    \definition RatLower: Rat -> \Power(Rat) :=
      (a: Rat) => \Subset(q, Rat, lt q a);

    \definition SumLower: Real -> Real -> \Power(Rat) :=
      (x, y: Real) =>
        \Subset(q, Rat,
          \exists \Ty(Rat,
            \Subset(a, Rat,
              Logic.And[mem x a,
                \exists \Ty(Rat,
                  \Subset(b, Rat,
                    Logic.And[mem y b, lt q (addRat a b)]))])));

    \definition NegLower: Real -> \Power(Rat) :=
      (x: Real) =>
        \Subset(q, Rat,
          \exists \Ty(Rat,
            \Subset(r, Rat,
              Logic.And[Logic.Not (mem x r), lt q (negRat r)])));

    \module Closed(
      ratCut: (a: Rat) ->
        \Pred(\Power(Rat), CutSet, RatLower a),
      sumCut: (x, y: Real) ->
        \Pred(\Power(Rat), CutSet, SumLower x y),
      negCut: (x: Real) ->
        \Pred(\Power(Rat), CutSet, NegLower x),
    ) {
      \definition ofRat: Rat -> Real :=
        (a: Rat) =>
          \subsetinto(\Power(Rat), CutSet, RatLower a, ratCut a);

      \definition add: Real -> Real -> Real :=
        (x, y: Real) =>
          \subsetinto(\Power(Rat), CutSet, SumLower x y, sumCut x y);

      \definition neg: Real -> Real :=
        (x: Real) =>
          \subsetinto(\Power(Rat), CutSet, NegLower x, negCut x);

      \definition sub: Real -> Real -> Real :=
        (x, y: Real) => add x (neg y);

      \definition zero: Real := ofRat zeroRat;

    }
  }
