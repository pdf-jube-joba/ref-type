/*
 * Constructive real numbers as located, rounded Dedekind cuts.
 *
 * The rational carrier and its strict order come from Rat.ref.  The carrier
 * is the positive-denominator representative type; FractionEq records the
 * equality that the remaining rational lemmas must respect.
 */
\import \root.Logic[] \as Logic;
\import \root.Rat[] \as Rational;
\import Rational.Fractions[] \as RationalFractions;
\import RationalFractions.Operations[] \as RationalOperations;
\use Logic.not;
\use Logic.and;
\use Logic.or;

  \definition Rat: \Set := RationalFractions.Fraction;

  \definition lt (x, y: Rat): \Prop := RationalFractions.lt x y;

  \definition addRat (x, y: Rat): Rat := RationalOperations.add x y;

  \definition negRat (x: Rat): Rat := RationalOperations.neg x;

  \definition zeroRat: Rat := RationalFractions.zero;

  \definition oneRat: Rat := RationalFractions.one;

  \definition mulRat (x, y: Rat): Rat := RationalOperations.mul x y;

  /* Membership in a rational lower set. */
  \definition In (L: \Power(Rat)) (q: Rat): \Prop := \Pred(Rat, L, q);

  /* A lower set is inhabited and proper. */
  \definition Inhabited (L: \Power(Rat)): \Prop :=
      \exists \Ty(Rat, \Subset(q, Rat, In L q));

  \definition Proper (L: \Power(Rat)): \Prop :=
      \exists \Ty(Rat, \Subset(q, Rat, not!{{ In L q }}));

  /* It is downward closed and has no greatest member. */
  \definition Lower (L: \Power(Rat)): \Prop :=
      \forall (p, q: Rat) -> lt p q -> In L q -> In L p;

  \definition Rounded (L: \Power(Rat)): \Prop :=
      \forall (p: Rat) -> In L p ->
        \exists \Ty(Rat, \Subset(q, Rat, and!{{ In L q } { lt p q }}));

  /* Locatedness is the constructive replacement for deciding membership. */
  \definition Located (L: \Power(Rat)): \Prop :=
      \forall (p, q: Rat) -> lt p q -> or!{{ In L p } { not!{{ In L q }} }};

  /* Membership must not depend on the chosen fraction representative. */
  \definition RespectsFractionEq (L: \Power(Rat)): \Prop :=
      \forall (p, q: Rat) ->
        RationalFractions.FractionEq p q -> In L p -> In L q;

  \definition IsCut (L: \Power(Rat)): \Prop :=
      and!{{ Inhabited L } { Proper L } { Lower L }
        { Rounded L } { Located L } { RespectsFractionEq L }};

  /* Real is the refinement of rational lower sets by the cut laws. */
  \definition CutSet: \Power(\Power(Rat)) :=
    \Subset(L, \Power(Rat), IsCut L);

  \definition Real: \Set :=
    \Ty(\Power(Rat), CutSet);

  \definition cutProperty (x: Real): IsCut x :=
    \bysub(\Power(Rat), CutSet, x);

  \definition cutInhabited (x: Real): Inhabited x :=
    Logic.And[Inhabited x, Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]]::left (cutProperty x);
  \definition cutProper (x: Real): Proper x :=
    Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]::left (Logic.And[Inhabited x, Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]]::right (cutProperty x));
  \definition cutLower (x: Real): Lower x :=
    Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]::left (Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]::right (Logic.And[Inhabited x, Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]]::right (cutProperty x)));
  \definition cutRounded (x: Real): Rounded x :=
    Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]::left (Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]::right (Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]::right (Logic.And[Inhabited x, Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]]::right (cutProperty x))));
  \definition cutLocated (x: Real): Located x :=
    Logic.And[Located x, RespectsFractionEq x]::left (Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]::right (Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]::right (Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]::right (Logic.And[Inhabited x, Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]]::right (cutProperty x)))));
  \definition cutRespects (x: Real): RespectsFractionEq x :=
    Logic.And[Located x, RespectsFractionEq x]::right (Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]::right (Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]::right (Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]::right (Logic.And[Inhabited x, Logic.And[Proper x, Logic.And[Lower x, Logic.And[Rounded x, Logic.And[Located x, RespectsFractionEq x]]]]]::right (cutProperty x)))));


  /* A real weakens to its underlying rational lower set. */
  \definition mem (x: Real) (q: Rat): \Prop := In x q;

  \definition underlying (x: Real): \Power(Rat) := x;

  /* Inclusion is available without any extensionality principle. */
  \definition Le (x, y: Real): \Prop := \forall (q: Rat) -> mem x q -> mem y q;

  \definition Eq (x, y: Real): \Prop := x = y;

  \definition leRefl (x: Real): Le x x := \fun (q: Rat) => \fun (qx: mem x q) => qx;

  \definition leTrans (x, y, z: Real) (xy: Le x y) (yz: Le y z): Le x z :=
      \fun (q: Rat) => \fun (qx: mem x q) => yz q (xy q qx);

  \definition leReplaceLeft (x, x2, y: Real) (same: x = x2)
    (xy: Le x y): Le x2 y :=
    \idelim(x = x2 \with z: Real => Le z y) \by (xy, same);

  \definition leReplaceRight (x, y, y2: Real) (same: y = y2)
    (xy: Le x y): Le x y2 :=
    \idelim(y = y2 \with z: Real => Le x z) \by (xy, same);

  \definition leReplace (x, x2, y, y2: Real)
    (left: x = x2) (right: y = y2) (xy: Le x y): Le x2 y2 :=
    leReplaceRight x2 y y2 right (leReplaceLeft x x2 y left xy);

  /* Kernel equality of cuts follows from the trusted subset extensionality. */
  \definition eqByExt (x, y: Real) (xy: Le x y) (yx: Le y x): Eq x y :=
      \axiom:setext(underlying x, underlying y, xy, yx);

  \definition leAntisym (x, y: Real) (xy: Le x y) (yx: Le y x): x = y :=
      eqByExt x y xy yx;


  \definition Lt (x, y: Real): \Prop :=
      \exists \Ty(Rat,
        \Subset(q, Rat, and!{{ not!{{ mem x q }} } { mem y q }}));

  \definition ltReplaceLeft (x, x2, y: Real) (same: x = x2)
    (xy: Lt x y): Lt x2 y :=
    \idelim(x = x2 \with z: Real => Lt z y) \by (xy, same);

  \definition ltReplaceRight (x, y, y2: Real) (same: y = y2)
    (xy: Lt x y): Lt x y2 :=
    \idelim(y = y2 \with z: Real => Lt x z) \by (xy, same);

  \definition ltIrrefl (x: Real): not!{{ Lt x x }} := \fun (xx: Lt x x) =>
      \take (q: \Ty(Rat,
        \Subset(r, Rat, and!{{ not!{{ mem x r }} } { mem x r }}))) =>
          (\fun (h: Logic.And[not!{{ mem x q }}, mem x q]) =>
            (Logic.And::left h) (Logic.And::right h))
          (\bysub(
            Rat, \Subset(r, Rat,
              and!{{ not!{{ mem x r }} } { mem x r }}), q))
      \by { existence: xx };

  \definition ltNotLeReverse (x, y: Real) (xy: Lt x y): not!{{ Le y x }} := \fun (yx: Le y x) =>
      \take (q: \Ty(Rat,
        \Subset(r, Rat, and!{{ not!{{ mem x r }} } { mem y r }}))) =>
          (\fun (h: Logic.And[not!{{ mem x q }}, mem y q]) =>
            (Logic.And::left h) (yx q (Logic.And::right h)))
          (\bysub(
            Rat, \Subset(r, Rat,
              and!{{ not!{{ mem x r }} } { mem y r }}), q))
      \by { existence: xy };

  \definition ltLeTrans (x, y, z: Real) (xy: Lt x y) (yz: Le y z): Lt x z :=
      \take (q: \Ty(Rat,
        \Subset(r, Rat, and!{{ not!{{ mem x r }} } { mem y r }}))) =>
        \exact(
          \subsetinto(
            Rat, \Subset(r, Rat,
              and!{{ not!{{ mem x r }} } { mem z r }}), q,
            (\fun (h: Logic.And[not!{{ mem x q }}, mem y q]) =>
              \record Logic.And[not!{{ mem x q }}, mem z q] {
                left := Logic.And::left h,
                right := yz q (Logic.And::right h),
              })
            (\bysub(
              Rat, \Subset(r, Rat,
                and!{{ not!{{ mem x r }} } { mem y r }}), q))),
          \Ty(Rat, \Subset(r, Rat,
            and!{{ not!{{ mem x r }} } { mem z r }})))
      \by { existence: xy };

  \definition leLtTrans (x, y, z: Real) (xy: Le x y) (yz: Lt y z): Lt x z :=
      \take (q: \Ty(Rat,
        \Subset(r, Rat, and!{{ not!{{ mem y r }} } { mem z r }}))) =>
        \exact(
          \subsetinto(
            Rat, \Subset(r, Rat,
              and!{{ not!{{ mem x r }} } { mem z r }}), q,
            (\fun (h: Logic.And[not!{{ mem y q }}, mem z q]) =>
              \record Logic.And[not!{{ mem x q }}, mem z q] {
                left := \fun (qx: mem x q) =>
                  (Logic.And::left h) (xy q qx),
                right := Logic.And::right h,
              })
            (\bysub(
              Rat, \Subset(r, Rat,
                and!{{ not!{{ mem y r }} } { mem z r }}), q))),
          \Ty(Rat, \Subset(r, Rat,
            and!{{ not!{{ mem x r }} } { mem z r }})))
      \by { existence: yz };

  /*
   * Arithmetic lower sets.  The nested Closed module asks for exactly the
   * closure lemmas needed to refine these sets back to Real.  This keeps the
   * construction honest while the concrete rational laws are being proved.
   */
  \module Completeness;

  \module Order;

  \module Operations;
