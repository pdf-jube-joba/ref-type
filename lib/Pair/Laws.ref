\import \root.Equality() \as Equality;
\use Equality.congr2;

\definition firstPair:
  (a: A) -> (b: B) -> first A B (pair A B a b) = a :=
  (a: A) => (b: B) => \refl(a);

\definition secondPair:
  (a: A) -> (b: B) -> second A B (pair A B a b) = b :=
  (a: A) => (b: B) => \refl(b);

\definition eta:
  (p: Times[A, B]) -> pair A B (first A B p) (second A B p) = p :=
  (p: Times[A, B]) =>
    \prec(\Prop, Times[A, B])
      ((q: Times[A, B]) =>
        pair A B (first A B q) (second A B q) = q)
      ((a: A) => (b: B) => \refl(pair A B a b))
      p;

\definition ext:
  (p: Times[A, B]) -> (q: Times[A, B]) ->
    first A B p = first A B q ->
    second A B p = second A B q -> p = q :=
  (p: Times[A, B]) =>
    \prec(\Prop, Times[A, B])
      ((left: Times[A, B]) =>
        (right: Times[A, B]) ->
        first A B left = first A B right ->
        second A B left = second A B right ->
        left = right)
      ((a: A) => (b: B) => (q: Times[A, B]) =>
        \prec(\Prop, Times[A, B])
          ((right: Times[A, B]) =>
            first A B (pair A B a b) = first A B right ->
            second A B (pair A B a b) = second A B right ->
            pair A B a b = right)
          ((c: A) => (d: B) =>
            (ac: a = c) => (bd: b = d) =>
              congr2!{A B Times[A, B]} (pair A B) a c b d ac bd)
          q)
      p;

\definition swapPair: (a: A) -> (b: B) -> swap A B (pair A B a b) = pair B A b a :=
  (a: A) => (b: B) => \refl(pair B A b a);

\definition swapInvolutive: (p: Times[A, B]) -> swap B A (swap A B p) = p := eta;

\definition mapIdentity: (p: Times[A, B]) ->
  map A B A B ((a: A) => a) ((b: B) => b) p = p := eta;
