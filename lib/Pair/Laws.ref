\import \root.Equality() \as Equality;
\use Equality.congr2;
\use Equality.congr;

/* Dependent elimination without spelling out the primitive recursor. */
\definition induction (Q: Times^[A, B] -> \Prop):
  (\forall (a: A) -> \forall (b: B) -> Q (pair A B a b)) ->
  \forall (p: Times^[A, B]) -> Q p := \prec(\Prop, Times^[A, B]) Q;

\definition pairCong: \forall (a, c: A) -> \forall (b, d: B) ->
  a = c -> b = d -> pair A B a b = pair A B c d :=
  congr2!{A B Times^[A, B]} (pair A B);

\definition firstCong: \forall (p, q: Times^[A, B]) -> p = q -> first A B p = first A B q :=
  congr!{Times^[A, B] A} (first A B);

\definition secondCong: \forall (p, q: Times^[A, B]) -> p = q -> second A B p = second A B q :=
  congr!{Times^[A, B] B} (second A B);

\definition pairInjectiveFirst (a, c: A) (b, d: B):
  pair A B a b = pair A B c d -> a = c := firstCong (pair A B a b) (pair A B c d);

\definition pairInjectiveSecond (a, c: A) (b, d: B):
  pair A B a b = pair A B c d -> b = d := secondCong (pair A B a b) (pair A B c d);

\definition firstPair (a: A) (b: B): first A B (pair A B a b) = a := \refl(a);

\definition secondPair (a: A) (b: B): second A B (pair A B a b) = b := \refl(b);

\definition eta (p: Times^[A, B]): pair A B (first A B p) (second A B p) = p :=
    \prec(\Prop, Times^[A, B])
      (\fun (q: Times^[A, B]) =>
        pair A B (first A B q) (second A B q) = q)
      (\fun (a: A) => \fun (b: B) => \refl(pair A B a b))
      p;

\definition ext (p: Times^[A, B]):
  \forall (q: Times^[A, B]) ->
    first A B p = first A B q ->
    second A B p = second A B q -> p = q :=
    \prec(\Prop, Times^[A, B])
      (\fun (left: Times^[A, B]) =>
        \forall (right: Times^[A, B]) ->
        first A B left = first A B right ->
        second A B left = second A B right ->
        left = right)
      (\fun (a: A) => \fun (b: B) => \fun (q: Times^[A, B]) =>
        \prec(\Prop, Times^[A, B])
          (\fun (right: Times^[A, B]) =>
            first A B (pair A B a b) = first A B right ->
            second A B (pair A B a b) = second A B right ->
            pair A B a b = right)
          (\fun (c: A) => \fun (d: B) =>
            \fun (ac: a = c) => \fun (bd: b = d) =>
              congr2!{A B Times^[A, B]} (pair A B) a c b d ac bd)
          q)
      p;

\definition swapPair (a: A) (b: B): swap A B (pair A B a b) = pair B A b a := \refl(pair B A b a);

\definition swapInvolutive: \forall (p: Times^[A, B]) -> swap B A (swap A B p) = p := eta;

\definition mapIdentity: \forall (p: Times^[A, B]) ->
  map A B A B (\fun (a: A) => a) (\fun (b: B) => b) p = p := eta;

\definition mapFirstIdentity: \forall (p: Times^[A, B]) ->
  mapFirst A B A (\fun (a: A) => a) p = p := eta;

\definition mapSecondIdentity: \forall (p: Times^[A, B]) ->
  mapSecond A B B (\fun (b: B) => b) p = p := eta;
