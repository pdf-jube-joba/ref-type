/* Pointwise inverse laws need no function-extensionality axiom. */
\definition curryUncurry: \forall (f: A -> B -> C) -> \forall (a: A) -> \forall (b: B) ->
  curry A B C (uncurry A B C f) a b = f a b :=
  \fun (f: A -> B -> C) => \fun (a: A) => \fun (b: B) => \refl(f a b);

\definition uncurryCurry: \forall (f: Times[A, B] -> C) -> \forall (p: Times[A, B]) ->
  uncurry A B C (curry A B C f) p = f p :=
  \fun (f: Times[A, B] -> C) =>
    \prec(\Prop, Times[A, B])
      (\fun (p: Times[A, B]) => uncurry A B C (curry A B C f) p = f p)
      (\fun (a: A) => \fun (b: B) => \refl(f (pair A B a b)));

\definition assocPair: \forall (a: A) -> \forall (b: B) -> \forall (c: C) ->
  assoc A B C (pair Times[A, B] C (pair A B a b) c) = pair A Times[B, C] a (pair B C b c) :=
  \fun (a: A) => \fun (b: B) => \fun (c: C) => \refl(pair A Times[B, C] a (pair B C b c));

\definition unassocPair: \forall (a: A) -> \forall (b: B) -> \forall (c: C) ->
  unassoc A B C (pair A Times[B, C] a (pair B C b c)) = pair Times[A, B] C (pair A B a b) c :=
  \fun (a: A) => \fun (b: B) => \fun (c: C) => \refl(pair Times[A, B] C (pair A B a b) c);

\definition unassocAssoc: \forall (p: Times[Times[A, B], C]) -> unassoc A B C (assoc A B C p) = p :=
  \prec(\Prop, Times[Times[A, B], C])
    (\fun (p: Times[Times[A, B], C]) => unassoc A B C (assoc A B C p) = p)
    (\fun (ab: Times[A, B]) => \fun (c: C) =>
      \prec(\Prop, Times[A, B])
        (\fun (ab: Times[A, B]) => unassoc A B C (assoc A B C (pair Times[A, B] C ab c)) = pair Times[A, B] C ab c)
        (\fun (a: A) => \fun (b: B) => \refl(pair Times[A, B] C (pair A B a b) c)) ab);

\definition assocUnassoc: \forall (p: Times[A, Times[B, C]]) -> assoc A B C (unassoc A B C p) = p :=
  \prec(\Prop, Times[A, Times[B, C]])
    (\fun (p: Times[A, Times[B, C]]) => assoc A B C (unassoc A B C p) = p)
    (\fun (a: A) => \fun (bc: Times[B, C]) =>
      \prec(\Prop, Times[B, C])
        (\fun (bc: Times[B, C]) => assoc A B C (unassoc A B C (pair A Times[B, C] a bc)) = pair A Times[B, C] a bc)
        (\fun (b: B) => \fun (c: C) => \refl(pair A Times[B, C] a (pair B C b c))) bc);
