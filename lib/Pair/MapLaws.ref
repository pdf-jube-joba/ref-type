/* Mapping acts independently on the two components. */
\definition mapPair: (f: A -> C) -> (g: B -> D) -> (a: A) -> (b: B) ->
  map A B C D f g (pair A B a b) = pair C D (f a) (g b) :=
  (f: A -> C) => (g: B -> D) => (a: A) => (b: B) => \refl(pair C D (f a) (g b));

\definition firstMap: (f: A -> C) -> (g: B -> D) -> (p: Times[A, B]) ->
  first C D (map A B C D f g p) = f (first A B p) :=
  (f: A -> C) => (g: B -> D) => (p: Times[A, B]) => \refl(f (first A B p));

\definition secondMap: (f: A -> C) -> (g: B -> D) -> (p: Times[A, B]) ->
  second C D (map A B C D f g p) = g (second A B p) :=
  (f: A -> C) => (g: B -> D) => (p: Times[A, B]) => \refl(g (second A B p));

\definition swapMap: (f: A -> C) -> (g: B -> D) -> (p: Times[A, B]) ->
  swap C D (map A B C D f g p) = map B A D C g f (swap A B p) :=
  (f: A -> C) => (g: B -> D) => (p: Times[A, B]) =>
    \refl(pair D C (g (second A B p)) (f (first A B p)));

\module Composition(E, F: \Set) {
  \definition mapCompose: (f: A -> C) -> (g: B -> D) -> (h: C -> E) -> (k: D -> F) ->
    (p: Times[A, B]) -> map C D E F h k (map A B C D f g p) =
      map A B E F ((a: A) => h (f a)) ((b: B) => k (g b)) p :=
    (f: A -> C) => (g: B -> D) => (h: C -> E) => (k: D -> F) => (p: Times[A, B]) =>
      \refl(pair E F (h (f (first A B p))) (k (g (second A B p))));
}
