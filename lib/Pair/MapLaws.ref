/* Mapping acts independently on the two components. */
\definition mapFirstPair: \forall (f: A -> C) -> \forall (a: A) -> \forall (b: B) ->
  mapFirst A B C f (pair A B a b) = pair C B (f a) b :=
  \fun (f: A -> C) => \fun (a: A) => \fun (b: B) => \refl(pair C B (f a) b);

\definition mapSecondPair: \forall (g: B -> D) -> \forall (a: A) -> \forall (b: B) ->
  mapSecond A B D g (pair A B a b) = pair A D a (g b) :=
  \fun (g: B -> D) => \fun (a: A) => \fun (b: B) => \refl(pair A D a (g b));

\definition mapFirstSecond: \forall (f: A -> C) -> \forall (p: Times[A, B]) ->
  second C B (mapFirst A B C f p) = second A B p :=
  \fun (f: A -> C) => \fun (p: Times[A, B]) => \refl(second A B p);

\definition mapSecondFirst: \forall (g: B -> D) -> \forall (p: Times[A, B]) ->
  first A D (mapSecond A B D g p) = first A B p :=
  \fun (g: B -> D) => \fun (p: Times[A, B]) => \refl(first A B p);

\definition mapSeparate: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: Times[A, B]) ->
  mapSecond C B D g (mapFirst A B C f p) = map A B C D f g p :=
  \fun (f: A -> C) => \fun (g: B -> D) => \fun (p: Times[A, B]) =>
    \refl(pair C D (f (first A B p)) (g (second A B p)));

\definition mapSeparateReverse: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: Times[A, B]) ->
  mapFirst A D C f (mapSecond A B D g p) = map A B C D f g p :=
  \fun (f: A -> C) => \fun (g: B -> D) => \fun (p: Times[A, B]) =>
    \refl(pair C D (f (first A B p)) (g (second A B p)));

\definition mapPair: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (a: A) -> \forall (b: B) ->
  map A B C D f g (pair A B a b) = pair C D (f a) (g b) :=
  \fun (f: A -> C) => \fun (g: B -> D) => \fun (a: A) => \fun (b: B) => \refl(pair C D (f a) (g b));

\definition firstMap: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: Times[A, B]) ->
  first C D (map A B C D f g p) = f (first A B p) :=
  \fun (f: A -> C) => \fun (g: B -> D) => \fun (p: Times[A, B]) => \refl(f (first A B p));

\definition secondMap: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: Times[A, B]) ->
  second C D (map A B C D f g p) = g (second A B p) :=
  \fun (f: A -> C) => \fun (g: B -> D) => \fun (p: Times[A, B]) => \refl(g (second A B p));

\definition swapMap: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: Times[A, B]) ->
  swap C D (map A B C D f g p) = map B A D C g f (swap A B p) :=
  \fun (f: A -> C) => \fun (g: B -> D) => \fun (p: Times[A, B]) =>
    \refl(pair D C (g (second A B p)) (f (first A B p)));

\module Composition(E, F: \Set) {
  \definition mapCompose: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (h: C -> E) -> \forall (k: D -> F) ->
    \forall (p: Times[A, B]) -> map C D E F h k (map A B C D f g p) =
      map A B E F (\fun (a: A) => h (f a)) (\fun (b: B) => k (g b)) p :=
    \fun (f: A -> C) => \fun (g: B -> D) => \fun (h: C -> E) => \fun (k: D -> F) => \fun (p: Times[A, B]) =>
      \refl(pair E F (h (f (first A B p))) (k (g (second A B p))));
}
