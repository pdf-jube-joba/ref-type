/* The left computation runs before the right computation, once each. */
\cdefinition map(f: \U(A ~> \F(C)), g: \U(B ~> \F(D)), p: Times[A, B]): \F(Times[C, D]) :=
  \match p \in Times \with {
  | pair a b => \block {
      \bind c: C <- \force f a;
      \bind d: D <- \force g b;
      \return Times[C, D]::pair c d;
    };
  };

\cdefinition mapFirst(f: \U(A ~> \F(C)), p: Times[A, B]): \F(Times[C, B]) :=
  \match p \in Times \with {
  | pair a b => \block {
      \bind c: C <- \force f a;
      \return Times[C, B]::pair c b;
    };
  };

\cdefinition mapSecond(g: \U(B ~> \F(D)), p: Times[A, B]): \F(Times[A, D]) :=
  \match p \in Times \with {
  | pair a b => \block {
      \bind d: D <- \force g b;
      \return Times[A, D]::pair a d;
    };
  };
