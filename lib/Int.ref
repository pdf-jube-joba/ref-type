\import \root.Equality() \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.congr3;

/* Integers: Nat + Nat in Program, with negSucc n denoting -(n+1).
 * The mathematical carrier below is the Grothendieck quotient of (Nat,+,0).
 */
\import \root.Nat() \as N;
\import \root.Bool() \as B;
\import \root.Logic() \as L;
\import \root.Pair() \as P;

/* Expose the imported instances, including Program constructor notation. */
\definition Nat: \Set := N.Nat;
\definition Bool: \Set := B.Bool;
\macro natZero() := N.Nat::zero;
\macro natSucc($n) := N.Nat::succ $n;
\macro boolTrue() := B.Bool::true;
\macro boolFalse() := B.Bool::false;

\inductive Int: \VType :=
| ofNat: N.Nat -> Int;
| negSucc: N.Nat -> Int;
;

\inductive DiffState: \VType := | running: N.Nat -> N.Nat -> DiffState; ;
\vdefinition diffStep: \U((DiffState ~> \F(\PRunStep(DiffState, Int)))) := \thunk((\cfun (state: DiffState) => \match (state) \in DiffState \with { | running a b =>
    \match (b) \in N.Nat \with {
    | zero => \return(\Pfinish(DiffState, Int, Int::ofNat a));
    | succ k => \match (a) \in N.Nat \with {
      | zero => \return(\Pfinish(DiffState, Int, Int::negSucc k));
      | succ j => \return(\Pcontinue(DiffState, Int, DiffState::running j k));
      };
    };
  }));
\definition diffStepSet: DiffState -> \RunStep(DiffState, Int) := \Force(\U((DiffState ~> \F(\PRunStep(DiffState,
  Int)))), \box(\U((DiffState ~> \F(\PRunStep(DiffState, Int)))), diffStep));
\definition diffReady: \RunStep(DiffState, Int) -> \Prop :=
  \fun (t: \RunStep(DiffState, Int)) => \Pred(N.Nat,
    \runStepRec(DiffState, Int, (\fun (t: \RunStep(DiffState, Int)) => \Power(N.Nat)),
      (\fun (s: DiffState) => \Subset(n, N.Nat, \Acc(DiffState, Int, diffStepSet, s))),
      (\fun (r: Int) => \Subset(n, N.Nat, N.Nat::zero = N.Nat::zero)), t), N.Nat::zero);
\definition diffAccIntro: \forall (s: DiffState) -> diffReady (diffStepSet s) -> \Acc(DiffState, Int, diffStepSet, s)
    :=
  \fun (s: DiffState) => \fun (ready: diffReady (diffStepSet s)) =>
    \accintro(DiffState, Int, diffStepSet, s,
      \fun (next: DiffState) => \fun (edge: diffStepSet s = \continue(DiffState, Int, next)) =>
        \idelim(diffStepSet s = \continue(DiffState, Int, next)
          \with t: \RunStep(DiffState, Int) => diffReady t) \by (ready, edge));

\definition diffTerminates: \forall (b, a: N.Nat) -> \Acc(DiffState, Int, diffStepSet, DiffState::running (a) (b)) :=
  \prec(\Prop, N.Nat) (\fun (b: N.Nat) => \forall (a: N.Nat) -> \Acc(DiffState, Int, diffStepSet, DiffState::running (a)
    (b)))
    (\prec(\Prop, N.Nat) (\fun (a: N.Nat) => \Acc(DiffState, Int, diffStepSet, DiffState::running (a)
    (N.Nat::zero)))
      (diffAccIntro (DiffState::running N.Nat::zero N.Nat::zero) (\refl(N.Nat::zero))) (\fun (j: N.Nat) => \fun (unused:
      \Acc(DiffState, Int, diffStepSet, DiffState::running (j) (N.Nat::zero))) => diffAccIntro
    (DiffState::running
      (N.Nat::succ j) N.Nat::zero) (\refl(N.Nat::zero)))) (\fun (k: N.Nat) => \fun (ih: \forall (a: N.Nat) -> \Acc(DiffState,
    Int,
      diffStepSet, DiffState::running (a) (k))) =>
      \prec(\Prop, N.Nat) (\fun (a: N.Nat) => \Acc(DiffState, Int, diffStepSet, DiffState::running (a) (N.Nat::succ
    k)))
        (diffAccIntro (DiffState::running N.Nat::zero (N.Nat::succ k)) (\refl(N.Nat::zero)))
        (\fun (j: N.Nat) => \fun (unused: \Acc(DiffState, Int, diffStepSet, DiffState::running (j) (N.Nat::succ k))) =>
          diffAccIntro (DiffState::running (N.Nat::succ j) (N.Nat::succ k)) (ih j)));
\cdefinition diff: (N.Nat ~> \F(\U((N.Nat ~> \F(Int))))) := (\cfun (a: N.Nat) => \return(\thunk((\cfun (b: N.Nat) => \Prun(DiffState, Int, diffStep, DiffState::running a b) \by diffTerminates b a))));
\definition diffSet: N.Nat -> N.Nat -> Int :=
  \Force((N.Nat ~> \F(\U((N.Nat ~> \F(Int))))),
    \box((N.Nat ~> \F(\U((N.Nat ~> \F(Int))))), diff));

/* A Set-only normal form, independent of Program reflection. */
\definition diffPrec: N.Nat -> N.Nat -> Int := \fun (a, b: N.Nat) =>
  \prec(\Set, N.Nat) (\fun (b: N.Nat) => N.Nat -> Int)
    (\fun (a: N.Nat) => Int::ofNat a)
    (\fun (k: N.Nat) => \fun (rec: N.Nat -> Int) => \fun (a: N.Nat) =>
      \prec(\Set, N.Nat) (\fun (a: N.Nat) => Int) (Int::negSucc k)
        (\fun (j: N.Nat) => \fun (unused: Int) => rec j) a) b a;
\definition diffMatchesPrec: \forall (b, a: N.Nat) -> diffSet a b = diffPrec a b :=
  \prec(\Prop, N.Nat) (\fun (b: N.Nat) => \forall (a: N.Nat) -> diffSet a b = diffPrec a b)
    (\prec(\Prop, N.Nat) (\fun (a: N.Nat) => diffSet a N.Nat::zero = diffPrec a N.Nat::zero)
      (\refl(Int::ofNat N.Nat::zero))
      (\fun (a: N.Nat) => \fun (ih: diffSet a N.Nat::zero = diffPrec a N.Nat::zero) => \refl(Int::ofNat (N.Nat::succ
    a))))
    (\fun (b: N.Nat) => \fun (ih: \forall (a: N.Nat) -> diffSet a b = diffPrec a b) =>
      \prec(\Prop, N.Nat) (\fun (a: N.Nat) => diffSet a (N.Nat::succ b) = diffPrec a (N.Nat::succ b))
        (\refl(Int::negSucc b))
        (\fun (a: N.Nat) => \fun (unused: diffSet a (N.Nat::succ b) = diffPrec a (N.Nat::succ b)) => ih a));

\cdefinition positive: (Int ~> \F(N.Nat)) := (\cfun (z: Int) => \match (z) \in Int \with { | ofNat n => \return(n); | negSucc n => \return(N.Nat::zero); });
\definition positiveSet: Int -> N.Nat :=
  \Force((Int ~> \F(N.Nat)), \box((Int ~> \F(N.Nat)), positive));
\definition positivePrec: Int -> N.Nat := \prec(\Set, Int) (\fun (z: Int) => N.Nat)
  (\fun (n: N.Nat) => n) (\fun (n: N.Nat) => N.Nat::zero);
\definition positiveMatchesPrec: \forall (z: Int) -> positiveSet z = positivePrec z :=
  \prec(\Prop, Int) (\fun (z: Int) => positiveSet z = positivePrec z)
    (\fun (n: N.Nat) => \refl(n)) (\fun (n: N.Nat) => \refl(N.Nat::zero));

\cdefinition negative: (Int ~> \F(N.Nat)) := (\cfun (z: Int) => \match (z) \in Int \with { | ofNat n => \return(N.Nat::zero); | negSucc n => \return(N.Nat::succ n); });
\definition negativeSet: Int -> N.Nat :=
  \Force((Int ~> \F(N.Nat)), \box((Int ~> \F(N.Nat)), negative));
\definition negativePrec: Int -> N.Nat := \prec(\Set, Int) (\fun (z: Int) => N.Nat)
  (\fun (n: N.Nat) => N.Nat::zero) (\fun (n: N.Nat) => N.Nat::succ n);
\definition negativeMatchesPrec: \forall (z: Int) -> negativeSet z = negativePrec z :=
  \prec(\Prop, Int) (\fun (z: Int) => negativeSet z = negativePrec z)
    (\fun (n: N.Nat) => \refl(N.Nat::zero)) (\fun (n: N.Nat) => \refl(N.Nat::succ n));

\definition diffCanonical: \forall (z: Int) -> diffPrec (positivePrec z) (negativePrec z) = z :=
  \prec(\Prop, Int) (\fun (z: Int) => diffPrec (positivePrec z) (negativePrec z) = z)
    (\fun (n: N.Nat) => \refl(Int::ofNat n)) (\fun (n: N.Nat) => \refl(Int::negSucc n));

/* Cancelling a common summand is the key to representative independence. */
\definition diffAddCommon: \forall (k, a, b: N.Nat) ->
  diffPrec (N.addSet a k) (N.addSet b k) = diffPrec a b :=
  \prec(\Prop, N.Nat)
    (\fun (k: N.Nat) => \forall (a, b: N.Nat) -> diffPrec (N.addSet a k) (N.addSet b k) = diffPrec a b)
    (\fun (a, b: N.Nat) => \refl(diffPrec a b))
    (\fun (k: N.Nat) => \fun (ih: \forall (a, b: N.Nat) -> diffPrec (N.addSet a k) (N.addSet b k) = diffPrec a b) =>
      \fun (a, b: N.Nat) => trans!{Int} _ _ _
        (congr!{N.Nat Int} (\fun (x: N.Nat) => diffPrec x (N.addSet b (N.Nat::succ k))) _ _ (N.addSuccRight a k))
        (trans!{Int} _ _ _
          (congr!{N.Nat Int} (diffPrec (N.Nat::succ (N.addSet a k))) _ _ (N.addSuccRight b k)) (ih a b)));
\definition diffRespects: \forall (a, b, c, d: N.Nat) ->
  N.addSet a d = N.addSet c b -> diffPrec a b = diffPrec c d :=
  \fun (a, b, c, d: N.Nat) => \fun (e: N.addSet a d = N.addSet c b) =>
    trans!{Int} _ _ _ (sym!{Int} _ _ (diffAddCommon d a b))
      (trans!{Int} _ _ _ (congr!{N.Nat Int} (\fun (x: N.Nat) => diffPrec x (N.addSet b d)) _ _ e)
        (trans!{Int} _ _ _ (congr!{N.Nat Int} (diffPrec (N.addSet c b)) _ _ (N.addComm b d)) (diffAddCommon b c d)));

/* The normal form represents the original formal difference. */
\definition diffBalance: \forall (b, a: N.Nat) ->
  N.addSet a (negativePrec (diffPrec a b)) = N.addSet (positivePrec (diffPrec a b)) b :=
  \prec(\Prop, N.Nat)
    (\fun (b: N.Nat) => \forall (a: N.Nat) ->
      N.addSet a (negativePrec (diffPrec a b)) = N.addSet (positivePrec (diffPrec a b)) b)
    (\fun (a: N.Nat) => \refl(a))
    (\fun (b: N.Nat) => \fun (ih: \forall (a: N.Nat) ->
      N.addSet a (negativePrec (diffPrec a b)) = N.addSet (positivePrec (diffPrec a b)) b) =>
      \prec(\Prop, N.Nat)
        (\fun (a: N.Nat) => N.addSet a (negativePrec (diffPrec a (N.Nat::succ b))) =
          N.addSet (positivePrec (diffPrec a (N.Nat::succ b))) (N.Nat::succ b))
        (\refl(N.addSet N.Nat::zero (N.Nat::succ b)))
        (\fun (a: N.Nat) => \fun (unused: N.addSet a (negativePrec (diffPrec a (N.Nat::succ b))) =
          N.addSet (positivePrec (diffPrec a (N.Nat::succ b))) (N.Nat::succ b)) =>
          trans!{N.Nat} _ _ _ (N.addSuccLeft a (negativePrec (diffPrec a b)))
            (trans!{N.Nat} _ _ _ (N.succCong _ _ (ih a))
              (sym!{N.Nat} _ _ (N.addSuccRight (positivePrec (diffPrec a b)) b)))));

/* Formal differences in the cancellative commutative monoid (Nat,+,0). */
\definition Difference: \Set := P.Times[N.Nat, N.Nat];
\definition pair: N.Nat -> N.Nat -> Difference := P.pair N.Nat N.Nat;
\definition pos: Difference -> N.Nat := P.first N.Nat N.Nat;
\definition negPart: Difference -> N.Nat := P.second N.Nat N.Nat;
\definition Equivalent: Difference -> Difference -> \Prop := \fun (x, y: Difference) =>
  N.addSet (pos x) (negPart y) = N.addSet (pos y) (negPart x);
\definition equivalentRefl: \forall (x: Difference) -> Equivalent x x :=
  \fun (x: Difference) => \refl(N.addSet (pos x) (negPart x));
\definition equivalentSym: \forall (x, y: Difference) -> Equivalent x y -> Equivalent y x :=
  \fun (x, y: Difference) => \fun (e: Equivalent x y) => sym!{N.Nat} (N.addSet (pos x) (negPart y)) (N.addSet (pos y)
    (negPart x)) e;
\definition addShuffle: \forall (a, b, c, d: N.Nat) ->
  N.addSet (N.addSet a b) (N.addSet c d) = N.addSet (N.addSet a d) (N.addSet c b) :=
  \fun (a, b, c, d: N.Nat) => trans!{N.Nat} _ _ _ (N.addInterchange a b c d)
    (trans!{N.Nat} _ _ _ (congr!{N.Nat N.Nat} (N.addSet (N.addSet a c)) _ _ (N.addComm b d))
      (sym!{N.Nat} _ _ (N.addInterchange a d c b)));
\definition equivalentTrans: \forall (x, y, z: Difference) ->
  Equivalent x y -> Equivalent y z -> Equivalent x z :=
  \fun (x, y, z: Difference) => \fun (xy: Equivalent x y) => \fun (yz: Equivalent y z) =>
    N.addCancelRight (N.addSet (pos y) (negPart y)) (N.addSet (pos x) (negPart z)) (N.addSet (pos z) (negPart
    x))
      (trans!{N.Nat} _ _ _ (addShuffle (pos x) (negPart z) (pos y) (negPart y))
        (trans!{N.Nat} _ _ _ (N.addCong (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x))
          (N.addSet (pos y) (negPart z)) (N.addSet (pos z) (negPart y)) xy yz)
          (trans!{N.Nat} _ _ _ (N.addInterchange (pos y) (negPart x) (pos z) (negPart y))
            (trans!{N.Nat} _ _ _
              (congr!{N.Nat N.Nat} (\fun (n: N.Nat) => N.addSet n (N.addSet (negPart x) (negPart y))) _ _
                (N.addComm (pos y) (pos z)))
              (sym!{N.Nat} _ _ (N.addInterchange (pos z) (negPart x) (pos y) (negPart y)))))));
\definition normalize: Difference -> Int := \fun (x: Difference) => diffPrec (pos x) (negPart x);
\definition representative: Int -> Difference := \fun (z: Int) => pair (positivePrec z) (negativePrec z);
\definition normalizeRespects: \forall (x, y: Difference) -> Equivalent x y -> normalize x = normalize y :=
  \fun (x, y: Difference) => diffRespects (pos x) (negPart x) (pos y) (negPart y);
\definition representativeNormalize: \forall (x: Difference) -> Equivalent x (representative (normalize x)) :=
  \fun (x: Difference) => diffBalance (negPart x) (pos x);
\definition equivalentOfNormalize: \forall (x, y: Difference) -> normalize x = normalize y -> Equivalent x y :=
  \fun (x, y: Difference) => \fun (e: normalize x = normalize y) =>
    equivalentTrans x (representative (normalize x)) y (representativeNormalize x)
      (\idelim(normalize y = normalize x \with z: Int => Equivalent (representative z) y)
        \by (equivalentSym y (representative (normalize y)) (representativeNormalize y), sym!{Int} _ _ e));

/* Actual equivalence classes, not merely a setoid of representatives. */
\definition ClassOf: Difference -> \Power(Difference) :=
  \fun (x: Difference) => \Subset(y, Difference, Equivalent x y);
\definition classOfEq: \forall (x, y: Difference) -> Equivalent x y -> ClassOf x = ClassOf y :=
  \fun (x, y: Difference) => \fun (xy: Equivalent x y) =>
    \axiom:setext(ClassOf x, ClassOf y,
      (\fun (z: Difference) => \fun (xz: Equivalent x z) => equivalentTrans y x z (equivalentSym x y xy) xz),
      (\fun (z: Difference) => \fun (yz: Equivalent y z) => equivalentTrans x y z xy yz));
\definition equivalentOfClassEq: \forall (x, y: Difference) -> ClassOf x = ClassOf y -> Equivalent x y :=
  \fun (x, y: Difference) => \fun (e: ClassOf x = ClassOf y) =>
    \idelim(ClassOf y = ClassOf x \with C: \Power(Difference) => \Pred(Difference, C, y))
      \by (equivalentRefl y,
        \idelim(ClassOf x = ClassOf y \with C: \Power(Difference) => C = ClassOf x)
          \by (\refl(ClassOf x), e));
\definition Representatives: \Power(Difference) -> \Power(Difference) :=
  \fun (C: \Power(Difference)) => \Subset(x, Difference, C = ClassOf x);
\definition IsClass: \Power(Difference) -> \Prop :=
  \fun (C: \Power(Difference)) => \forall (P: \Prop) -> (\forall (x: Difference) -> C = ClassOf x -> P) -> P;
\definition ClassSet: \Power(\Power(Difference)) := \Subset(C, \Power(Difference), IsClass C);
\definition Grothendieck: \Set := \Ty(\Power(Difference), ClassSet);
\definition class: Difference -> Grothendieck := \fun (x: Difference) =>
  \subsetinto(\Power(Difference), ClassSet, ClassOf x,
    (\fun (P: \Prop) => \fun (step: \forall (y: Difference) -> ClassOf x = ClassOf y -> P) => step x (\refl(ClassOf x))));
\definition toMath: Int -> Grothendieck := \fun (z: Int) => class (representative z);
\definition classProperty: \forall (C: Grothendieck) -> IsClass C :=
  \fun (C: Grothendieck) => \bysub(\Power(Difference), ClassSet, C);
\definition representativesExist: \forall (C: Grothendieck) -> \exists \Ty(Difference, Representatives C) :=
  \fun (C: Grothendieck) => classProperty C (\exists \Ty(Difference, Representatives C))
    (\fun (x: Difference) => \fun (cx: C = ClassOf x) =>
      \exact(\subsetinto(Difference, Representatives C, x, cx), \Ty(Difference, Representatives C)));
\definition sameClassNormal: \forall (C: \Power(Difference)) -> \forall (x, y: Difference) ->
  C = ClassOf x -> C = ClassOf y -> normalize x = normalize y :=
  \fun (C: \Power(Difference)) => \fun (x, y: Difference) =>
    \fun (cx: C = ClassOf x) => \fun (cy: C = ClassOf y) =>
      normalizeRespects x y (equivalentOfClassEq x y
        (\idelim(C = ClassOf x \with D: \Power(Difference) => D = ClassOf y) \by (cy, cx)));
\definition normalFormsUnique: \forall (C: Grothendieck) ->
  \forall (x: \Ty(Difference, Representatives C)) -> \forall (y: \Ty(Difference, Representatives C)) -> normalize x =
    normalize y :=
  \fun (C: Grothendieck) => \fun (x: \Ty(Difference, Representatives C)) => \fun (y: \Ty(Difference, Representatives C)) =>
    sameClassNormal C x y (\bysub(Difference, Representatives C, x)) (\bysub(Difference, Representatives C,
    y));
\definition fromMath: Grothendieck -> Int := \fun (C: Grothendieck) =>
  \take (x: \Ty(Difference, Representatives C)) => normalize x
    \by (representativesExist C, normalFormsUnique C);
\definition fromClass: \forall (x: Difference) -> fromMath (class x) = normalize x :=
  \fun (x: Difference) =>
    \takeelim(\fun (y: \Ty(Difference, Representatives (class x))) => normalize y,
      \subsetinto(Difference, Representatives (class x), x, \refl(ClassOf x)),
      \Ty(Difference, Representatives (class x)), Int)
    \by (representativesExist (class x), normalFormsUnique (class x));
\definition fromTo: \forall (z: Int) -> fromMath (toMath z) = z :=
  \fun (z: Int) => trans!{Int} _ _ _ (fromClass (representative z)) (diffCanonical z);
\definition toFromClass: \forall (x: Difference) -> toMath (normalize x) = class x :=
  \fun (x: Difference) => classOfEq (representative (normalize x)) x
    (equivalentSym x (representative (normalize x)) (representativeNormalize x));
\definition toFrom: \forall (C: Grothendieck) -> toMath (fromMath C) = C :=
  \fun (C: Grothendieck) =>
    \take (x: \Ty(Difference, Representatives C)) =>
      \idelim(ClassOf x = C \with D: \Power(Difference) => toMath (fromMath C) = D)
      \by (
        \idelim(normalize x = fromMath C \with z: Int => toMath z = ClassOf x)
          \by (toFromClass x,
            sym!{Int} _ _ (\takeelim(\fun (y: \Ty(Difference, Representatives C)) => normalize y,
              x, \Ty(Difference, Representatives C), Int)
              \by (representativesExist C, normalFormsUnique C))),
        \idelim(C = ClassOf x \with D: \Power(Difference) => D = C)
          \by (\refl(C), \bysub(Difference, Representatives C, x)))
    \by (representativesExist C);

/* Computational operations and their Set specifications use the certified
 * Nat arithmetic above. Every exported computation has a MatchesPrec theorem. */

\vdefinition zero: Int := (Int::ofNat N.Nat::zero);
\definition zeroSet: Int := \Force(Int, \box(Int, zero));
\definition zeroPrec: Int := (Int::ofNat N.Nat::zero);
\definition zeroMatchesPrec: zeroSet = zeroPrec := \refl((Int::ofNat N.Nat::zero));

\vdefinition one: Int := (Int::ofNat (N.Nat::succ N.Nat::zero));
\definition oneSet: Int := \Force(Int, \box(Int, one));
\definition onePrec: Int := (Int::ofNat (N.Nat::succ N.Nat::zero));
\definition oneMatchesPrec: oneSet = onePrec := \refl((Int::ofNat (N.Nat::succ N.Nat::zero)));

\vdefinition minusOne: Int := (Int::negSucc N.Nat::zero);
\definition minusOneSet: Int := \Force(Int, \box(Int, minusOne));
\definition minusOnePrec: Int := (Int::negSucc N.Nat::zero);
\definition minusOneMatchesPrec: minusOneSet = minusOnePrec := \refl((Int::negSucc N.Nat::zero));

/* Nat imports its own Bool instance. Convert its decisions through Nat.choose
 * so that Int consistently exposes the Bool instance imported here. */
\cdefinition natIsZero: (N.Nat ~> \F(B.Bool)) := (\cfun (n: N.Nat) => \match (n) \in N.Nat \with { | zero => \return(B.Bool::true); | succ k => \return(B.Bool::false); });
\definition natIsZeroSet: N.Nat -> B.Bool :=
  \Force((N.Nat ~> \F(B.Bool)), \box((N.Nat ~> \F(B.Bool)), natIsZero));
\definition natIsZeroPrec: N.Nat -> B.Bool :=
  \prec(\Set, N.Nat) (\fun (n: N.Nat) => B.Bool) B.Bool::true (\fun (n: N.Nat) => \fun (ih: B.Bool) => B.Bool::false);
\definition natIsZeroMatchesPrec: \forall (n: N.Nat) -> natIsZeroSet n = natIsZeroPrec n :=
  \prec(\Prop, N.Nat) (\fun (n: N.Nat) => natIsZeroSet n = natIsZeroPrec n)
    (\refl(B.Bool::true)) (\fun (n: N.Nat) => \fun (ih: natIsZeroSet n = natIsZeroPrec n) => \refl(B.Bool::false));

\cdefinition natEqb: (N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))) := (\cfun (a: N.Nat) => \return(\thunk((\cfun (b: N.Nat) => (\bind test: _ <- (\bind f: _ <- (N.eqb a) \in ((\force(f)) b)) \in (\bind yes: _ <- (N.choose test) \in (\bind no: _ <- ((\force(yes)) N.Nat::zero) \in (\bind number: N.Nat <- ((\force(no)) (N.Nat::succ N.Nat::zero)) \in (natIsZero number)))))))));
\definition natEqbSet: N.Nat -> N.Nat -> B.Bool := \Force((N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))),
    \box((N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))), natEqb));
\definition natEqbPrec: N.Nat -> N.Nat -> B.Bool := \fun (a, b: N.Nat) => natIsZeroPrec (N.chooseSet (N.eqbSet a b)
    N.Nat::zero (N.Nat::succ N.Nat::zero));
\definition natEqbMatchesPrec: \forall (a, b: N.Nat) -> natEqbSet a b = natEqbPrec a b :=
  \fun (a, b: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.eqbSet a b) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natLeb: (N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))) := (\cfun (a: N.Nat) => \return(\thunk((\cfun (b: N.Nat) => (\bind test: _ <- (\bind f: _ <- (N.leb a) \in ((\force(f)) b)) \in (\bind yes: _ <- (N.choose test) \in (\bind no: _ <- ((\force(yes)) N.Nat::zero) \in (\bind number: N.Nat <- ((\force(no)) (N.Nat::succ N.Nat::zero)) \in (natIsZero number)))))))));
\definition natLebSet: N.Nat -> N.Nat -> B.Bool := \Force((N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))),
    \box((N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))), natLeb));
\definition natLebPrec: N.Nat -> N.Nat -> B.Bool := \fun (a, b: N.Nat) => natIsZeroPrec (N.chooseSet (N.lebSet a b)
    N.Nat::zero (N.Nat::succ N.Nat::zero));
\definition natLebMatchesPrec: \forall (a, b: N.Nat) -> natLebSet a b = natLebPrec a b :=
  \fun (a, b: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.lebSet a b) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natLtb: (N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))) := (\cfun (a: N.Nat) => \return(\thunk((\cfun (b: N.Nat) => (\bind test: _ <- (\bind f: _ <- (N.ltb a) \in ((\force(f)) b)) \in (\bind yes: _ <- (N.choose test) \in (\bind no: _ <- ((\force(yes)) N.Nat::zero) \in (\bind number: N.Nat <- ((\force(no)) (N.Nat::succ N.Nat::zero)) \in (natIsZero number)))))))));
\definition natLtbSet: N.Nat -> N.Nat -> B.Bool := \Force((N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))),
    \box((N.Nat ~> \F(\U((N.Nat ~> \F(B.Bool))))), natLtb));
\definition natLtbPrec: N.Nat -> N.Nat -> B.Bool := \fun (a, b: N.Nat) => natIsZeroPrec (N.chooseSet (N.ltbSet a b)
    N.Nat::zero (N.Nat::succ N.Nat::zero));
\definition natLtbMatchesPrec: \forall (a, b: N.Nat) -> natLtbSet a b = natLtbPrec a b :=
  \fun (a, b: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.ltbSet a b) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natEven: (N.Nat ~> \F(B.Bool)) := (\cfun (a: N.Nat) => (\bind test: _ <- (N.even a) \in (\bind yes: _ <- (N.choose test) \in (\bind no: _ <- ((\force(yes)) N.Nat::zero) \in (\bind number: N.Nat <- ((\force(no)) (N.Nat::succ N.Nat::zero)) \in (natIsZero number))))));
\definition natEvenSet: N.Nat -> B.Bool := \Force((N.Nat ~> \F(B.Bool)), \box((N.Nat ~> \F(B.Bool)),
    natEven));
\definition natEvenPrec: N.Nat -> B.Bool := \fun (a: N.Nat) => natIsZeroPrec (N.chooseSet (N.evenSet a) N.Nat::zero
    (N.Nat::succ N.Nat::zero));
\definition natEvenMatchesPrec: \forall (a: N.Nat) -> natEvenSet a = natEvenPrec a :=
  \fun (a: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.evenSet a) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natOdd: (N.Nat ~> \F(B.Bool)) := (\cfun (a: N.Nat) => (\bind test: _ <- (N.odd a) \in (\bind yes: _ <- (N.choose test) \in (\bind no: _ <- ((\force(yes)) N.Nat::zero) \in (\bind number: N.Nat <- ((\force(no)) (N.Nat::succ N.Nat::zero)) \in (natIsZero number))))));
\definition natOddSet: N.Nat -> B.Bool := \Force((N.Nat ~> \F(B.Bool)), \box((N.Nat ~> \F(B.Bool)),
    natOdd));
\definition natOddPrec: N.Nat -> B.Bool := \fun (a: N.Nat) => natIsZeroPrec (N.chooseSet (N.oddSet a) N.Nat::zero
    (N.Nat::succ N.Nat::zero));
\definition natOddMatchesPrec: \forall (a: N.Nat) -> natOddSet a = natOddPrec a :=
  \fun (a: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.oddSet a) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition choose: (B.Bool ~> \F(\U((Int ~> \F(\U((Int ~> \F(Int)))))))) :=
  (\cfun (test: B.Bool) => \return(\thunk((\cfun (yes: Int) => \return(\thunk((\cfun (no: Int) => \match (test) \in B.Bool \with { | false => \return(no); | true => \return(yes); })))))));
\definition chooseSet: B.Bool -> Int -> Int -> Int :=
  \Force((B.Bool ~> \F(\U((Int ~> \F(\U((Int ~> \F(Int)))))))), \box((B.Bool ~> \F(\U((Int ~> \F(\U((Int ~> \F(Int)))))))), choose));
\definition choosePrec: B.Bool -> Int -> Int -> Int := B.ite Int;
\definition chooseMatchesPrec: \forall (test: B.Bool) -> \forall (yes, no: Int) ->
  chooseSet test yes no = choosePrec test yes no :=
  \prec(\Prop, B.Bool) (\fun (test: B.Bool) => \forall (yes, no: Int) ->
    chooseSet test yes no = choosePrec test yes no)
    (\fun (yes, no: Int) => \refl(no)) (\fun (yes, no: Int) => \refl(yes));

\cdefinition ofNat: (N.Nat ~> \F(Int)) := (\cfun (n: N.Nat) => \return((Int::ofNat n)));
\definition ofNatSet: N.Nat -> Int := \Force((N.Nat ~> \F(Int)), \box((N.Nat ~> \F(Int)), ofNat));
\definition ofNatPrec: N.Nat -> Int := \fun (n: N.Nat) => (Int::ofNat n);
\definition ofNatMatchesPrec: \forall (n: N.Nat) -> ofNatSet n = ofNatPrec n :=
  \fun (n: N.Nat) => \refl((Int::ofNat n));

\cdefinition negOfNat: (N.Nat ~> \F(Int)) := (\cfun (n: N.Nat) => (\bind v1: Int <- \Prun(DiffState, Int, diffStep,
    DiffState::running N.Nat::zero n) \by diffTerminates n N.Nat::zero \in \return(v1)));
\definition negOfNatSet: N.Nat -> Int := \Force((N.Nat ~> \F(Int)), \box((N.Nat ~> \F(Int)), negOfNat));
\definition negOfNatPrec: N.Nat -> Int := \fun (n: N.Nat) => (diffPrec N.Nat::zero n);
\definition negOfNatMatchesPrec: \forall (n: N.Nat) -> negOfNatSet n = negOfNatPrec n :=
  \fun (n: N.Nat) => diffMatchesPrec n N.Nat::zero;

\cdefinition neg: (Int ~> \F(Int)) := (\cfun (x: Int) => (\bind v2: N.Nat <- (negative x) \in (\bind v4: N.Nat <- (positive x) \in (\bind v5: Int <- \Prun(DiffState, Int, diffStep, DiffState::running v2
    v4) \by diffTerminates v4 v2 \in \return(v5)))));
\definition negSet: Int -> Int := \Force((Int ~> \F(Int)), \box((Int ~> \F(Int)), neg));
\definition negPrec: Int -> Int := \fun (x: Int) => (diffPrec (negativePrec x) (positivePrec x));
\definition negMatchesPrec: \forall (x: Int) -> negSet x = negPrec x :=
  \block {
    \fix (x: Int);
    \let componentsMatch:
      diffSet (negativeSet x) (positiveSet x) = diffSet (negativePrec x) (positivePrec x) :=
      congr2!{N.Nat N.Nat Int} (diffSet)
        (negativeSet x) (negativePrec x) (positiveSet x) (positivePrec x)
        (negativeMatchesPrec x) (positiveMatchesPrec x);
    \return trans!{Int} _ _ _ componentsMatch
      (diffMatchesPrec (positivePrec x) (negativePrec x));
  };

\cdefinition add: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v2: N.Nat <- (positive x) \in (\bind v4: N.Nat <- (positive y) \in (\bind v5: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2 \in (\bind v7: N.Nat <- (negative x) \in (\bind v9: N.Nat <- (negative y) \in (\bind v10: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 v9) \by N.addTerminates v9 v7 \in (\bind v11: Int <- \Prun(DiffState, Int, diffStep, DiffState::running v5 v10) \by diffTerminates v10 v5 \in \return(v11))))))))))));
\definition addSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), add));
\definition addPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (diffPrec (N.addSet (positivePrec x)
    (positivePrec y)) (N.addSet (negativePrec x) (negativePrec y)));
\definition addMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> addSet x y = addPrec x y :=
  \block {
    \fix (x, y: Int);
    \let positivesMatch:
      N.addSet (positiveSet x) (positiveSet y) =
        N.addSet (positivePrec x) (positivePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet x) (positivePrec x) (positiveSet y) (positivePrec y)
        (positiveMatchesPrec x) (positiveMatchesPrec y);
    \let negativesMatch:
      N.addSet (negativeSet x) (negativeSet y) =
        N.addSet (negativePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (negativeSet x) (negativePrec x) (negativeSet y) (negativePrec y)
        (negativeMatchesPrec x) (negativeMatchesPrec y);
    \let componentsMatch:
      diffSet (N.addSet (positiveSet x) (positiveSet y))
        (N.addSet (negativeSet x) (negativeSet y)) =
      diffSet (N.addSet (positivePrec x) (positivePrec y))
        (N.addSet (negativePrec x) (negativePrec y)) :=
      congr2!{N.Nat N.Nat Int} (diffSet)
        _ _ _ _ positivesMatch negativesMatch;
    \return trans!{Int} _ _ _ componentsMatch
      (diffMatchesPrec
        (N.addSet (negativePrec x) (negativePrec y))
        (N.addSet (positivePrec x) (positivePrec y)));
  };

\cdefinition sub: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v2: Int <- (neg y) \in (\bind v3: \U((Int ~> \F(Int))) <- (add x) \in (\bind v5: Int <- ((\force(v3)) v2) \in \return(v5))))))));
\definition subSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), sub));
\definition subPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (addPrec x (negPrec y));
\definition subMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> subSet x y = subPrec x y :=
  \block {
    \fix (x, y: Int);
    \let argumentMatches: addSet x (negSet y) = addSet x (negPrec y) :=
      congr2!{Int Int Int} (addSet)
        x x (negSet y) (negPrec y) (\refl(x)) (negMatchesPrec y);
    \return trans!{Int} _ _ _ argumentMatches (addMatchesPrec x (negPrec y));
  };

\cdefinition mul: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v2: N.Nat <- (positive x) \in (\bind v4: N.Nat <- (positive y) \in (\bind v5: N.Nat <- \Prun(N.IterState, N.Nat, N.iterStep, N.IterState::running \thunk((\cfun (current: N.Nat) => \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 current) \by N.addTerminates current v2))
    N.Nat::zero v4) \by N.iterTerminates v4 (N.addSet v2) N.Nat::zero \in (\bind v7: N.Nat <- (negative x) \in (\bind v9: N.Nat <- (negative y) \in (\bind v10: N.Nat <- \Prun(N.IterState, N.Nat, N.iterStep,
    N.IterState::running \thunk((\cfun (current: N.Nat) => \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running
    v7 current) \by N.addTerminates current v7)) N.Nat::zero v9) \by N.iterTerminates v9 (N.addSet v7)
    N.Nat::zero \in (\bind v11: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v5 v10) \by
    N.addTerminates v10 v5 \in (\bind v12: N.Nat <- \Prun(N.IterState, N.Nat, N.iterStep, N.IterState::running
    \thunk((\cfun (current: N.Nat) => \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 current) \by
    N.addTerminates current v2)) N.Nat::zero v9) \by N.iterTerminates v9 (N.addSet v2) N.Nat::zero \in (\bind v13: N.Nat <- \Prun(N.IterState, N.Nat, N.iterStep, N.IterState::running \thunk((\cfun (current: N.Nat) => \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 current) \by N.addTerminates current v7))
    N.Nat::zero v4) \by N.iterTerminates v4 (N.addSet v7) N.Nat::zero \in (\bind v14: N.Nat <- \Prun(N.AddState,
    N.Nat, N.addStep, N.AddState::running v12 v13) \by N.addTerminates v13 v12 \in (\bind v15: Int <- \Prun(DiffState, Int, diffStep, DiffState::running v11 v14) \by diffTerminates v14 v11 \in \return(v15))))))))))))))));
\definition mulSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), mul));
\definition mulPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (diffPrec (N.addSet (N.mulSet (positivePrec
    x) (positivePrec y)) (N.mulSet (negativePrec x) (negativePrec y))) (N.addSet (N.mulSet (positivePrec x)
    (negativePrec y)) (N.mulSet (negativePrec x) (positivePrec y))));
\definition mulMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> mulSet x y = mulPrec x y :=
  \block {
    \fix (x, y: Int);
    \let ppMatches:
      N.mulSet (positiveSet x) (positiveSet y) =
        N.mulSet (positivePrec x) (positivePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.mulSet)
        (positiveSet x) (positivePrec x) (positiveSet y) (positivePrec y)
        (positiveMatchesPrec x) (positiveMatchesPrec y);
    \let nnMatches:
      N.mulSet (negativeSet x) (negativeSet y) =
        N.mulSet (negativePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.mulSet)
        (negativeSet x) (negativePrec x) (negativeSet y) (negativePrec y)
        (negativeMatchesPrec x) (negativeMatchesPrec y);
    \let pnMatches:
      N.mulSet (positiveSet x) (negativeSet y) =
        N.mulSet (positivePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.mulSet)
        (positiveSet x) (positivePrec x) (negativeSet y) (negativePrec y)
        (positiveMatchesPrec x) (negativeMatchesPrec y);
    \let npMatches:
      N.mulSet (negativeSet x) (positiveSet y) =
        N.mulSet (negativePrec x) (positivePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.mulSet)
        (negativeSet x) (negativePrec x) (positiveSet y) (positivePrec y)
        (negativeMatchesPrec x) (positiveMatchesPrec y);
    \let positiveTermsMatch:
      N.addSet
        (N.mulSet (positiveSet x) (positiveSet y))
        (N.mulSet (negativeSet x) (negativeSet y)) =
      N.addSet
        (N.mulSet (positivePrec x) (positivePrec y))
        (N.mulSet (negativePrec x) (negativePrec y)) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        _ _ _ _ ppMatches nnMatches;
    \let negativeTermsMatch:
      N.addSet
        (N.mulSet (positiveSet x) (negativeSet y))
        (N.mulSet (negativeSet x) (positiveSet y)) =
      N.addSet
        (N.mulSet (positivePrec x) (negativePrec y))
        (N.mulSet (negativePrec x) (positivePrec y)) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        _ _ _ _ pnMatches npMatches;
    \let componentsMatch:
      diffSet
        (N.addSet (N.mulSet (positiveSet x) (positiveSet y))
          (N.mulSet (negativeSet x) (negativeSet y)))
        (N.addSet (N.mulSet (positiveSet x) (negativeSet y))
          (N.mulSet (negativeSet x) (positiveSet y))) =
      diffSet
        (N.addSet (N.mulSet (positivePrec x) (positivePrec y))
          (N.mulSet (negativePrec x) (negativePrec y)))
        (N.addSet (N.mulSet (positivePrec x) (negativePrec y))
          (N.mulSet (negativePrec x) (positivePrec y))) :=
      congr2!{N.Nat N.Nat Int} (diffSet)
        _ _ _ _ positiveTermsMatch negativeTermsMatch;
    \return trans!{Int} _ _ _ componentsMatch
      (diffMatchesPrec
        (N.addSet (N.mulSet (positivePrec x) (negativePrec y))
          (N.mulSet (negativePrec x) (positivePrec y)))
        (N.addSet (N.mulSet (positivePrec x) (positivePrec y))
          (N.mulSet (negativePrec x) (negativePrec y))));
  };

\cdefinition succ: (Int ~> \F(Int)) := (\cfun (x: Int) => (\bind v1: \U((Int ~> \F(Int))) <- (add x) \in (\bind v3: Int <- ((\force(v1)) ((Int::ofNat (N.Nat::succ N.Nat::zero)))) \in \return(v3))));
\definition succSet: Int -> Int := \Force((Int ~> \F(Int)), \box((Int ~> \F(Int)), succ));
\definition succPrec: Int -> Int := \fun (x: Int) => (addPrec x (Int::ofNat (N.Nat::succ N.Nat::zero)));
\definition succMatchesPrec: \forall (x: Int) -> succSet x = succPrec x :=
  \fun (x: Int) => addMatchesPrec x (Int::ofNat (N.Nat::succ N.Nat::zero));

\cdefinition pred: (Int ~> \F(Int)) := (\cfun (x: Int) => (\bind v1: \U((Int ~> \F(Int))) <- (sub x) \in (\bind v3: Int <- ((\force(v1)) ((Int::ofNat (N.Nat::succ N.Nat::zero)))) \in \return(v3))));
\definition predSet: Int -> Int := \Force((Int ~> \F(Int)), \box((Int ~> \F(Int)), pred));
\definition predPrec: Int -> Int := \fun (x: Int) => (subPrec x (Int::ofNat (N.Nat::succ N.Nat::zero)));
\definition predMatchesPrec: \forall (x: Int) -> predSet x = predPrec x :=
  \fun (x: Int) => subMatchesPrec x (Int::ofNat (N.Nat::succ N.Nat::zero));

\cdefinition natAbs: (Int ~> \F(N.Nat)) := (\cfun (x: Int) => (\bind v2: N.Nat <- (positive x) \in (\bind v4: N.Nat <- (negative x) \in (\bind v5: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running
    v2 v4) \by N.addTerminates v4 v2 \in \return(v5)))));
\definition natAbsSet: Int -> N.Nat := \Force((Int ~> \F(N.Nat)), \box((Int ~> \F(N.Nat)), natAbs));
\definition natAbsPrec: Int -> N.Nat := \fun (x: Int) => (N.addSet (positivePrec x) (negativePrec x));
\definition natAbsMatchesPrec: \forall (x: Int) -> natAbsSet x = natAbsPrec x :=
  \fun (x: Int) => congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet x) (positivePrec x) (negativeSet x) (negativePrec x)
    (positiveMatchesPrec x) (negativeMatchesPrec x);

\cdefinition abs: (Int ~> \F(Int)) := (\cfun (x: Int) => (\bind v2: N.Nat <- (natAbs x) \in (\bind v4: Int <- (ofNat v2) \in \return(v4))));
\definition absSet: Int -> Int := \Force((Int ~> \F(Int)), \box((Int ~> \F(Int)), abs));
\definition absPrec: Int -> Int := \fun (x: Int) => (ofNatPrec (natAbsPrec x));
\definition absMatchesPrec: \forall (x: Int) -> absSet x = absPrec x :=
  \fun (x: Int) => trans!{Int} _ _ _ (congr!{N.Nat Int} (ofNatSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (ofNatMatchesPrec (natAbsPrec x));

\cdefinition isZero: (Int ~> \F(B.Bool)) := (\cfun (x: Int) => (\bind v2: N.Nat <- (natAbs x) \in (\bind v4: B.Bool <- (natIsZero v2) \in \return(v4))));
\definition isZeroSet: Int -> B.Bool := \Force((Int ~> \F(B.Bool)), \box((Int ~> \F(B.Bool)), isZero));
\definition isZeroPrec: Int -> B.Bool := \fun (x: Int) => (natIsZeroPrec (natAbsPrec x));
\definition isZeroMatchesPrec: \forall (x: Int) -> isZeroSet x = isZeroPrec x :=
  \fun (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natIsZeroSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natIsZeroMatchesPrec (natAbsPrec x));

\cdefinition eqb: (Int ~> \F(\U((Int ~> \F(B.Bool))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v2: N.Nat <- (positive x) \in (\bind v4: N.Nat <- (negative y) \in (\bind v5: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2 \in (\bind v7: N.Nat <- (positive y) \in (\bind v9: N.Nat <- (negative x) \in (\bind v10: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 v9) \by N.addTerminates v9 v7 \in (\bind v11: \U((N.Nat ~> \F(B.Bool))) <- (natEqb v5) \in (\bind v13: B.Bool <- ((\force(v11)) v10) \in \return(v13)))))))))))));
\definition eqbSet: Int -> Int -> B.Bool := \Force((Int ~> \F(\U((Int ~> \F(B.Bool))))), \box((Int ~> \F(\U((Int ~> \F(B.Bool))))), eqb));
\definition eqbPrec: Int -> Int -> B.Bool := \fun (x: Int) => \fun (y: Int) => (natEqbPrec (N.addSet (positivePrec x)
    (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)));
\definition eqbMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> eqbSet x y = eqbPrec x y :=
  \block {
    \fix (x, y: Int);
    \let leftMatches:
      N.addSet (positiveSet x) (negativeSet y) = N.addSet (positivePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet x) (positivePrec x) (negativeSet y) (negativePrec y)
        (positiveMatchesPrec x) (negativeMatchesPrec y);
    \let rightMatches:
      N.addSet (positiveSet y) (negativeSet x) = N.addSet (positivePrec y) (negativePrec x) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet y) (positivePrec y) (negativeSet x) (negativePrec x)
        (positiveMatchesPrec y) (negativeMatchesPrec x);
    \let argumentsMatch:
      natEqbSet (N.addSet (positiveSet x) (negativeSet y)) (N.addSet (positiveSet y) (negativeSet x)) =
      natEqbSet (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)) :=
      congr2!{N.Nat N.Nat B.Bool} (natEqbSet) _ _ _ _ leftMatches rightMatches;
    \return trans!{B.Bool} _ _ _ argumentsMatch
      (natEqbMatchesPrec
        (N.addSet (positivePrec x) (negativePrec y))
        (N.addSet (positivePrec y) (negativePrec x)));
  };

\cdefinition leb: (Int ~> \F(\U((Int ~> \F(B.Bool))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v2: N.Nat <- (positive x) \in (\bind v4: N.Nat <- (negative y) \in (\bind v5: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2 \in (\bind v7: N.Nat <- (positive y) \in (\bind v9: N.Nat <- (negative x) \in (\bind v10: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 v9) \by N.addTerminates v9 v7 \in (\bind v11: \U((N.Nat ~> \F(B.Bool))) <- (natLeb v5) \in (\bind v13: B.Bool <- ((\force(v11)) v10) \in \return(v13)))))))))))));
\definition lebSet: Int -> Int -> B.Bool := \Force((Int ~> \F(\U((Int ~> \F(B.Bool))))), \box((Int ~> \F(\U((Int ~> \F(B.Bool))))), leb));
\definition lebPrec: Int -> Int -> B.Bool := \fun (x: Int) => \fun (y: Int) => (natLebPrec (N.addSet (positivePrec x)
    (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)));
\definition lebMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> lebSet x y = lebPrec x y :=
  \block {
    \fix (x, y: Int);
    \let leftMatches:
      N.addSet (positiveSet x) (negativeSet y) = N.addSet (positivePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet x) (positivePrec x) (negativeSet y) (negativePrec y)
        (positiveMatchesPrec x) (negativeMatchesPrec y);
    \let rightMatches:
      N.addSet (positiveSet y) (negativeSet x) = N.addSet (positivePrec y) (negativePrec x) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet y) (positivePrec y) (negativeSet x) (negativePrec x)
        (positiveMatchesPrec y) (negativeMatchesPrec x);
    \let argumentsMatch:
      natLebSet (N.addSet (positiveSet x) (negativeSet y)) (N.addSet (positiveSet y) (negativeSet x)) =
      natLebSet (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)) :=
      congr2!{N.Nat N.Nat B.Bool} (natLebSet) _ _ _ _ leftMatches rightMatches;
    \return trans!{B.Bool} _ _ _ argumentsMatch
      (natLebMatchesPrec
        (N.addSet (positivePrec x) (negativePrec y))
        (N.addSet (positivePrec y) (negativePrec x)));
  };

\cdefinition ltb: (Int ~> \F(\U((Int ~> \F(B.Bool))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v2: N.Nat <- (positive x) \in (\bind v4: N.Nat <- (negative y) \in (\bind v5: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2 \in (\bind v7: N.Nat <- (positive y) \in (\bind v9: N.Nat <- (negative x) \in (\bind v10: N.Nat <- \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 v9) \by N.addTerminates v9 v7 \in (\bind v11: \U((N.Nat ~> \F(B.Bool))) <- (natLtb v5) \in (\bind v13: B.Bool <- ((\force(v11)) v10) \in \return(v13)))))))))))));
\definition ltbSet: Int -> Int -> B.Bool := \Force((Int ~> \F(\U((Int ~> \F(B.Bool))))), \box((Int ~> \F(\U((Int ~> \F(B.Bool))))), ltb));
\definition ltbPrec: Int -> Int -> B.Bool := \fun (x: Int) => \fun (y: Int) => (natLtbPrec (N.addSet (positivePrec x)
    (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)));
\definition ltbMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> ltbSet x y = ltbPrec x y :=
  \block {
    \fix (x, y: Int);
    \let leftMatches:
      N.addSet (positiveSet x) (negativeSet y) = N.addSet (positivePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet x) (positivePrec x) (negativeSet y) (negativePrec y)
        (positiveMatchesPrec x) (negativeMatchesPrec y);
    \let rightMatches:
      N.addSet (positiveSet y) (negativeSet x) = N.addSet (positivePrec y) (negativePrec x) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet y) (positivePrec y) (negativeSet x) (negativePrec x)
        (positiveMatchesPrec y) (negativeMatchesPrec x);
    \let argumentsMatch:
      natLtbSet (N.addSet (positiveSet x) (negativeSet y)) (N.addSet (positiveSet y) (negativeSet x)) =
      natLtbSet (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)) :=
      congr2!{N.Nat N.Nat B.Bool} (natLtbSet) _ _ _ _ leftMatches rightMatches;
    \return trans!{B.Bool} _ _ _ argumentsMatch
      (natLtbMatchesPrec
        (N.addSet (positivePrec x) (negativePrec y))
        (N.addSet (positivePrec y) (negativePrec x)));
  };

\cdefinition min: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v1: \U((Int ~> \F(B.Bool))) <- (leb x) \in (\bind v3: B.Bool <- ((\force(v1)) y) \in (\bind v4: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v3) \in (\bind v5: \U((Int ~> \F(Int))) <- ((\force(v4)) x) \in (\bind v7: Int <- ((\force(v5)) y) \in \return(v7))))))))));
\definition minSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), min));
\definition minPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (choosePrec (lebPrec x y) x y);
\definition minMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> minSet x y = minPrec x y :=
  \block {
    \fix (x, y: Int);
    \let argumentsMatch:
      chooseSet (lebSet x y) x y = chooseSet (lebPrec x y) x y :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        (lebSet x y) (lebPrec x y) x x y y
        (lebMatchesPrec x y) (\refl(x)) (\refl(y));
    \return trans!{Int} _ _ _ argumentsMatch (chooseMatchesPrec (lebPrec x y) x y);
  };

\cdefinition max: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => (\bind v1: \U((Int ~> \F(B.Bool))) <- (leb x) \in (\bind v3: B.Bool <- ((\force(v1)) y) \in (\bind v4: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v3) \in (\bind v5: \U((Int ~> \F(Int))) <- ((\force(v4)) y) \in (\bind v7: Int <- ((\force(v5)) x) \in \return(v7))))))))));
\definition maxSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), max));
\definition maxPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (choosePrec (lebPrec x y) y x);
\definition maxMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> maxSet x y = maxPrec x y :=
  \block {
    \fix (x, y: Int);
    \let argumentsMatch:
      chooseSet (lebSet x y) y x = chooseSet (lebPrec x y) y x :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        (lebSet x y) (lebPrec x y) y y x x
        (lebMatchesPrec x y) (\refl(y)) (\refl(x));
    \return trans!{Int} _ _ _ argumentsMatch (chooseMatchesPrec (lebPrec x y) y x);
  };

\cdefinition sign: (Int ~> \F(Int)) := (\cfun (x: Int) => (\bind v2: B.Bool <- (isZero x) \in (\bind v4: N.Nat <- (negative x) \in (\bind v6: B.Bool <- (natIsZero v4) \in (\bind v7: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v6) \in (\bind v8: \U((Int ~> \F(Int))) <- ((\force(v7)) ((Int::ofNat (N.Nat::succ N.Nat::zero)))) \in (\bind v10: Int <- ((\force(v8)) ((Int::negSucc N.Nat::zero))) \in (\bind v11: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v2) \in (\bind v12: \U((Int ~> \F(Int))) <- ((\force(v11)) ((Int::ofNat N.Nat::zero))) \in (\bind v14: Int <- ((\force(v12)) v10) \in \return(v14)))))))))));
\definition signSet: Int -> Int := \Force((Int ~> \F(Int)), \box((Int ~> \F(Int)), sign));
\definition signPrec: Int -> Int := \fun (x: Int) => (choosePrec (isZeroPrec x) (Int::ofNat N.Nat::zero)
    (choosePrec (natIsZeroPrec (negativePrec x)) (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc
    N.Nat::zero)));
\definition signMatchesPrec: \forall (x: Int) -> signSet x = signPrec x :=
  \block {
    \fix (x: Int);
    \let negativeTestMatches:
      natIsZeroSet (negativeSet x) = natIsZeroPrec (negativePrec x) :=
      trans!{B.Bool} _ _ _
        (congr!{N.Nat B.Bool} (natIsZeroSet)
          (negativeSet x) (negativePrec x) (negativeMatchesPrec x))
        (natIsZeroMatchesPrec (negativePrec x));
    \let innerArgumentsMatch:
      chooseSet (natIsZeroSet (negativeSet x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) =
      chooseSet (natIsZeroPrec (negativePrec x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        (natIsZeroSet (negativeSet x)) (natIsZeroPrec (negativePrec x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::ofNat (N.Nat::succ N.Nat::zero))
        (Int::negSucc N.Nat::zero) (Int::negSucc N.Nat::zero)
        negativeTestMatches (\refl((Int::ofNat (N.Nat::succ N.Nat::zero))))
        (\refl((Int::negSucc N.Nat::zero)));
    \let innerMatches:
      chooseSet (natIsZeroSet (negativeSet x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) =
      choosePrec (natIsZeroPrec (negativePrec x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) :=
      trans!{Int} _ _ _ innerArgumentsMatch
        (chooseMatchesPrec (natIsZeroPrec (negativePrec x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero));
    \let outerArgumentsMatch:
      chooseSet (isZeroSet x) (Int::ofNat N.Nat::zero)
        (chooseSet (natIsZeroSet (negativeSet x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)) =
      chooseSet (isZeroPrec x) (Int::ofNat N.Nat::zero)
        (choosePrec (natIsZeroPrec (negativePrec x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)) :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        _ _ _ _ _ _ (isZeroMatchesPrec x)
        (\refl((Int::ofNat N.Nat::zero))) innerMatches;
    \return trans!{Int} _ _ _ outerArgumentsMatch
      (chooseMatchesPrec (isZeroPrec x) (Int::ofNat N.Nat::zero)
        (choosePrec (natIsZeroPrec (negativePrec x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)));
  };

\cdefinition even: (Int ~> \F(B.Bool)) := (\cfun (x: Int) => (\bind v2: N.Nat <- (natAbs x) \in (\bind v4: B.Bool <- (natEven v2) \in \return(v4))));
\definition evenSet: Int -> B.Bool := \Force((Int ~> \F(B.Bool)), \box((Int ~> \F(B.Bool)), even));
\definition evenPrec: Int -> B.Bool := \fun (x: Int) => (natEvenPrec (natAbsPrec x));
\definition evenMatchesPrec: \forall (x: Int) -> evenSet x = evenPrec x :=
  \fun (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natEvenSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natEvenMatchesPrec (natAbsPrec x));

\cdefinition odd: (Int ~> \F(B.Bool)) := (\cfun (x: Int) => (\bind v2: N.Nat <- (natAbs x) \in (\bind v4: B.Bool <- (natOdd v2) \in \return(v4))));
\definition oddSet: Int -> B.Bool := \Force((Int ~> \F(B.Bool)), \box((Int ~> \F(B.Bool)), odd));
\definition oddPrec: Int -> B.Bool := \fun (x: Int) => (natOddPrec (natAbsPrec x));
\definition oddMatchesPrec: \forall (x: Int) -> oddSet x = oddPrec x :=
  \fun (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natOddSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natOddMatchesPrec (natAbsPrec x));

/* Apply a sign after computing the magnitude once. */
\cdefinition powerSign: (B.Bool ~> \F(\U((N.Nat ~> \F(Int))))) :=
  (\cfun (test: B.Bool) => \return(\thunk((\cfun (magnitude: N.Nat) => \match (test) \in B.Bool \with {
    | false => \return(Int::ofNat magnitude);
    | true => (negOfNat magnitude);
    }))));
\definition powerSignSet: B.Bool -> N.Nat -> Int :=
  \Force((B.Bool ~> \F(\U((N.Nat ~> \F(Int))))),
    \box((B.Bool ~> \F(\U((N.Nat ~> \F(Int))))), powerSign));
\definition powerSignPrec: B.Bool -> N.Nat -> Int := \fun (test: B.Bool) => \fun (magnitude: N.Nat) =>
  B.ite Int test (negOfNatPrec magnitude) (Int::ofNat magnitude);
\definition powerSignMatchesPrec: \forall (test: B.Bool) -> \forall (magnitude: N.Nat) ->
  powerSignSet test magnitude = powerSignPrec test magnitude :=
  \prec(\Prop, B.Bool) (\fun (test: B.Bool) => \forall (magnitude: N.Nat) ->
    powerSignSet test magnitude = powerSignPrec test magnitude)
    (\fun (magnitude: N.Nat) => \refl(Int::ofNat magnitude)) negOfNatMatchesPrec;
\cdefinition pow: (Int ~> \F(\U((N.Nat ~> \F(Int))))) :=
  (\cfun (x: Int) => \return(\thunk((\cfun (n: N.Nat) => \match (x) \in Int \with {
    | ofNat a => (\bind f: \U((N.Nat ~> \F(N.Nat))) <- (N.pow a) \in (\bind magnitude: N.Nat <- ((\force(f)) n) \in \return(Int::ofNat magnitude)));
    | negSucc a => (\bind f: \U((N.Nat ~> \F(N.Nat))) <- (N.pow (N.Nat::succ a)) \in (\bind magnitude: N.Nat <- ((\force(f)) n) \in (\bind test: B.Bool <- (natOdd n) \in (\bind sign: \U((N.Nat ~> \F(Int))) <- (powerSign test) \in ((\force(sign)) magnitude)))));
    }))));
\definition powSet: Int -> N.Nat -> Int :=
  \Force((Int ~> \F(\U((N.Nat ~> \F(Int))))),
    \box((Int ~> \F(\U((N.Nat ~> \F(Int))))), pow));
\definition powPrec: Int -> N.Nat -> Int :=
  \prec(\Set, Int) (\fun (x: Int) => N.Nat -> Int)
    (\fun (a, n: N.Nat) => Int::ofNat (N.powSet a n))
    (\fun (a, n: N.Nat) => powerSignPrec (natOddPrec n) (N.powSet (N.Nat::succ a) n));
\definition powerSignTestMatches: \forall (n, magnitude: N.Nat) ->
  powerSignSet (natOddSet n) magnitude = powerSignPrec (natOddPrec n) magnitude :=
  \fun (n, magnitude: N.Nat) =>
    \idelim(natOddSet n = natOddPrec n \with test: B.Bool =>
      powerSignSet (natOddSet n) magnitude = powerSignPrec test magnitude)
    \by (powerSignMatchesPrec (natOddSet n) magnitude, natOddMatchesPrec n);
\definition powMatchesPrec: \forall (x: Int) -> \forall (n: N.Nat) -> powSet x n = powPrec x n :=
  \prec(\Prop, Int) (\fun (x: Int) => \forall (n: N.Nat) -> powSet x n = powPrec x n)
    (\fun (a, n: N.Nat) => \refl(Int::ofNat (N.powSet a n)))
    (\fun (a, n: N.Nat) => powerSignTestMatches n (N.powSet (N.Nat::succ a) n));

/* Operations on formal differences, before passing to equivalence classes. */
\definition addRep: Difference -> Difference -> Difference := \fun (x, y: Difference) =>
  pair (N.addSet (pos x) (pos y)) (N.addSet (negPart x) (negPart y));
\definition negRep: Difference -> Difference := \fun (x: Difference) => pair (negPart x) (pos x);
\definition subRep: Difference -> Difference -> Difference := \fun (x, y: Difference) => addRep x (negRep y);
\definition scaleRep: Difference -> N.Nat -> Difference := \fun (x: Difference) => \fun (n: N.Nat) =>
  pair (N.mulSet (pos x) n) (N.mulSet (negPart x) n);
\definition mulRep: Difference -> Difference -> Difference := \fun (x, y: Difference) =>
  pair (N.addSet (N.mulSet (pos x) (pos y)) (N.mulSet (negPart x) (negPart y)))
       (N.addSet (N.mulSet (pos x) (negPart y)) (N.mulSet (negPart x) (pos y)));
\definition equivalentOfFields: \forall (x, y: Difference) -> pos x = pos y -> negPart x = negPart y -> Equivalent x y
    :=
  \fun (x, y: Difference) => \fun (p: pos x = pos y) => \fun (n: negPart x = negPart y) =>
    N.addCong (pos x) (pos y) (negPart y) (negPart x) p (sym!{N.Nat} _ _ n);
\definition addRepRespects: \forall (x, y, u, v: Difference) ->
  Equivalent x y -> Equivalent u v -> Equivalent (addRep x u) (addRep y v) :=
  \fun (x, y, u, v: Difference) => \fun (xy: Equivalent x y) => \fun (uv: Equivalent u v) =>
    trans!{N.Nat} _ _ _ (N.addInterchange (pos x) (pos u) (negPart y) (negPart v))
      (trans!{N.Nat} _ _ _
        (N.addCong (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x))
          (N.addSet (pos u) (negPart v)) (N.addSet (pos v) (negPart u)) xy uv)
        (sym!{N.Nat} _ _ (N.addInterchange (pos y) (pos v) (negPart x) (negPart u))));
\definition negRepRespects: \forall (x, y: Difference) -> Equivalent x y -> Equivalent (negRep x) (negRep y) :=
  \fun (x, y: Difference) => \fun (xy: Equivalent x y) =>
    trans!{N.Nat} _ _ _ (N.addComm (negPart x) (pos y))
      (trans!{N.Nat} (N.addSet (pos y) (negPart x)) (N.addSet (pos x) (negPart y))
        (N.addSet (negPart y) (pos x))
        (sym!{N.Nat} (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x)) xy)
        (N.addComm (pos x) (negPart y)));
\definition subRepRespects: \forall (x, y, u, v: Difference) ->
  Equivalent x y -> Equivalent u v -> Equivalent (subRep x u) (subRep y v) :=
  \fun (x, y, u, v: Difference) => \fun (xy: Equivalent x y) => \fun (uv: Equivalent u v) =>
    addRepRespects x y (negRep u) (negRep v) xy (negRepRespects u v uv);
\definition scaleRepRespects: \forall (x, y: Difference) -> \forall (n: N.Nat) ->
  Equivalent x y -> Equivalent (scaleRep x n) (scaleRep y n) :=
  \fun (x, y: Difference) => \fun (n: N.Nat) => \fun (xy: Equivalent x y) =>
    trans!{N.Nat} _ _ _ (sym!{N.Nat} _ _ (N.mulDistribRight (pos x) (negPart y) n))
      (trans!{N.Nat} _ _ _
        (congr!{N.Nat N.Nat} (\fun (a: N.Nat) => N.mulSet a n)
          (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x)) xy)
        (N.mulDistribRight (pos y) (negPart x) n));
\definition mulRepAsSum: \forall (x, y: Difference) ->
  Equivalent (mulRep x y) (addRep (scaleRep x (pos y)) (negRep (scaleRep x (negPart y)))) :=
  \fun (x, y: Difference) => equivalentOfFields (mulRep x y)
    (addRep (scaleRep x (pos y)) (negRep (scaleRep x (negPart y))))
    (\refl(pos (mulRep x y))) (N.addComm (N.mulSet (pos x) (negPart y)) (N.mulSet (negPart x) (pos y)));
\definition mulRepComm: \forall (x, y: Difference) -> Equivalent (mulRep x y) (mulRep y x) :=
  \fun (x, y: Difference) => equivalentOfFields (mulRep x y) (mulRep y x)
    (N.addCong _ _ _ _ (N.mulComm (pos x) (pos y)) (N.mulComm (negPart x) (negPart y)))
    (trans!{N.Nat} _ _ _
      (N.addCong _ _ _ _ (N.mulComm (pos x) (negPart y)) (N.mulComm (negPart x) (pos y)))
      (N.addComm (N.mulSet (negPart y) (pos x)) (N.mulSet (pos y) (negPart x))));
\definition mulRepRespectsLeft: \forall (x, y, z: Difference) ->
  Equivalent x y -> Equivalent (mulRep x z) (mulRep y z) :=
  \fun (x, y, z: Difference) => \fun (xy: Equivalent x y) =>
    equivalentTrans (mulRep x z)
      (addRep (scaleRep x (pos z)) (negRep (scaleRep x (negPart z)))) (mulRep y z)
      (mulRepAsSum x z)
      (equivalentTrans (addRep (scaleRep x (pos z)) (negRep (scaleRep x (negPart z))))
        (addRep (scaleRep y (pos z)) (negRep (scaleRep y (negPart z)))) (mulRep y z)
        (addRepRespects (scaleRep x (pos z)) (scaleRep y (pos z))
          (negRep (scaleRep x (negPart z))) (negRep (scaleRep y (negPart z)))
          (scaleRepRespects x y (pos z) xy)
          (negRepRespects (scaleRep x (negPart z)) (scaleRep y (negPart z))
            (scaleRepRespects x y (negPart z) xy)))
        (equivalentSym (mulRep y z)
          (addRep (scaleRep y (pos z)) (negRep (scaleRep y (negPart z)))) (mulRepAsSum y z)));
\definition mulRepRespects: \forall (x, y, u, v: Difference) ->
  Equivalent x y -> Equivalent u v -> Equivalent (mulRep x u) (mulRep y v) :=
  \fun (x, y, u, v: Difference) => \fun (xy: Equivalent x y) => \fun (uv: Equivalent u v) =>
    equivalentTrans (mulRep x u) (mulRep y u) (mulRep y v) (mulRepRespectsLeft x y u xy)
      (equivalentTrans (mulRep y u) (mulRep u y) (mulRep y v) (mulRepComm y u)
        (equivalentTrans (mulRep u y) (mulRep v y) (mulRep y v)
          (mulRepRespectsLeft u v y uv) (mulRepComm v y)));

\definition toMathCong: \forall (x, y: Int) -> x = y -> toMath x = toMath y :=
  \fun (x, y: Int) => \fun (e: x = y) =>
    \idelim(x = y \with z: Int => toMath x = toMath z) \by (\refl(toMath x), e);

/* Relational images define operations without choosing representatives. */
\definition UnaryRespects: (Difference -> Difference) -> \Prop := \fun (f: Difference -> Difference) =>
  \forall (x, y: Difference) -> Equivalent x y -> Equivalent (f x) (f y);
\definition BinaryRespects: (Difference -> Difference -> Difference) -> \Prop :=
  \fun (f: Difference -> Difference -> Difference) =>
    \forall (x, y, u, v: Difference) -> Equivalent x y -> Equivalent u v -> Equivalent (f x u) (f y v);
\definition sameClassRelated: \forall (C: \Power(Difference)) -> \forall (x, y: Difference) ->
  C = ClassOf x -> C = ClassOf y -> Equivalent x y :=
  \fun (C: \Power(Difference)) => \fun (x, y: Difference) => \fun (cx: C = ClassOf x) => \fun (cy: C = ClassOf y) =>
    equivalentOfClassEq x y (trans!{\Power(Difference)} (ClassOf x) C (ClassOf y) (sym!{\Power(Difference)} C (ClassOf x) cx) cy);
\definition UnaryImage: (Difference -> Difference) -> \Power(Difference) -> \Power(Difference) :=
  \fun (f: Difference -> Difference) => \fun (C: \Power(Difference)) =>
    \Subset(z, Difference, \forall (P: \Prop) ->
      (\forall (x: Difference) -> C = ClassOf x -> Equivalent (f x) z -> P) -> P);
\definition unaryImageClass: \forall (f: Difference -> Difference) -> UnaryRespects f ->
  \forall (C: \Power(Difference)) -> \forall (x: Difference) -> C = ClassOf x -> UnaryImage f C = ClassOf (f x) :=
  \fun (f: Difference -> Difference) => \fun (respects: UnaryRespects f) =>
    \fun (C: \Power(Difference)) => \fun (x: Difference) => \fun (cx: C = ClassOf x) =>
      \axiom:setext(UnaryImage f C, ClassOf (f x),
        (\fun (z: Difference) => \fun (hz: \Pred(Difference, UnaryImage f C, z)) =>
          hz (Equivalent (f x) z)
            (\fun (y: Difference) => \fun (cy: C = ClassOf y) => \fun (yz: Equivalent (f y) z) =>
              equivalentTrans (f x) (f y) z (respects x y (sameClassRelated C x y cx cy)) yz)),
        (\fun (z: Difference) => \fun (xz: Equivalent (f x) z) =>
          \fun (P: \Prop) => \fun (step: \forall (y: Difference) -> C = ClassOf y -> Equivalent (f y) z -> P) => step x cx xz));
\definition unaryImageClosed: \forall (f: Difference -> Difference) -> UnaryRespects f ->
  \forall (C: Grothendieck) -> IsClass (UnaryImage f C) :=
  \fun (f: Difference -> Difference) => \fun (respects: UnaryRespects f) => \fun (C: Grothendieck) =>
    classProperty C (IsClass (UnaryImage f C))
      (\fun (x: Difference) => \fun (cx: C = ClassOf x) =>
        \fun (P: \Prop) => \fun (step: \forall (y: Difference) -> UnaryImage f C = ClassOf y -> P) =>
          step (f x) (unaryImageClass f respects C x cx));
\definition BinaryImage: (Difference -> Difference -> Difference) ->
  \Power(Difference) -> \Power(Difference) -> \Power(Difference) :=
  \fun (f: Difference -> Difference -> Difference) => \fun (C, D: \Power(Difference)) =>
    \Subset(z, Difference, \forall (P: \Prop) ->
      (\forall (x, y: Difference) -> C = ClassOf x -> D = ClassOf y -> Equivalent (f x y) z -> P) -> P);
\definition binaryImageClass: \forall (f: Difference -> Difference -> Difference) -> BinaryRespects f ->
  \forall (C, D: \Power(Difference)) -> \forall (x, y: Difference) -> C = ClassOf x -> D = ClassOf y ->
  BinaryImage f C D = ClassOf (f x y) :=
  \fun (f: Difference -> Difference -> Difference) => \fun (respects: BinaryRespects f) =>
    \fun (C, D: \Power(Difference)) => \fun (x, y: Difference) => \fun (cx: C = ClassOf x) => \fun (dy: D = ClassOf y) =>
      \axiom:setext(BinaryImage f C D, ClassOf (f x y),
        (\fun (z: Difference) => \fun (hz: \Pred(Difference, BinaryImage f C D, z)) =>
          hz (Equivalent (f x y) z)
            (\fun (u, v: Difference) => \fun (cu: C = ClassOf u) => \fun (dv: D = ClassOf v) => \fun (uvz: Equivalent (f u v) z)
    =>
              equivalentTrans (f x y) (f u v) z
                (respects x u y v (sameClassRelated C x u cx cu) (sameClassRelated D y v dy dv)) uvz)),
        (\fun (z: Difference) => \fun (xyz: Equivalent (f x y) z) =>
          \fun (P: \Prop) => \fun (step: \forall (u, v: Difference) -> C = ClassOf u -> D = ClassOf v -> Equivalent (f u v) z ->
    P) =>
            step x y cx dy xyz));
\definition binaryImageClosed: \forall (f: Difference -> Difference -> Difference) -> BinaryRespects f ->
  \forall (C, D: Grothendieck) -> IsClass (BinaryImage f C D) :=
  \fun (f: Difference -> Difference -> Difference) => \fun (respects: BinaryRespects f) => \fun (C, D: Grothendieck) =>
    classProperty C (IsClass (BinaryImage f C D))
      (\fun (x: Difference) => \fun (cx: C = ClassOf x) =>
        classProperty D (IsClass (BinaryImage f C D))
          (\fun (y: Difference) => \fun (dy: D = ClassOf y) =>
            \fun (P: \Prop) => \fun (step: \forall (z: Difference) -> BinaryImage f C D = ClassOf z -> P) =>
              step (f x y) (binaryImageClass f respects C D x y cx dy)));

/* Addition and multiplication use the formulas on formal differences. */
\definition addMath: Grothendieck -> Grothendieck -> Grothendieck := \fun (C, D: Grothendieck) =>
  \subsetinto(\Power(Difference), ClassSet, BinaryImage addRep C D, binaryImageClosed addRep addRepRespects C
    D);
\definition negMath: Grothendieck -> Grothendieck := \fun (C: Grothendieck) =>
  \subsetinto(\Power(Difference), ClassSet, UnaryImage negRep C, unaryImageClosed negRep negRepRespects C);
\definition mulMath: Grothendieck -> Grothendieck -> Grothendieck := \fun (C, D: Grothendieck) =>
  \subsetinto(\Power(Difference), ClassSet, BinaryImage mulRep C D, binaryImageClosed mulRep mulRepRespects C
    D);
\definition subMath: Grothendieck -> Grothendieck -> Grothendieck := \fun (x, y: Grothendieck) => addMath x
    (negMath y);
\definition addMathClass: \forall (x, y: Difference) -> addMath (class x) (class y) = class (addRep x y) :=
  \fun (x, y: Difference) => binaryImageClass addRep addRepRespects (class x) (class y) x y (\refl(ClassOf x))
    (\refl(ClassOf y));
\definition negMathClass: \forall (x: Difference) -> negMath (class x) = class (negRep x) :=
  \fun (x: Difference) => unaryImageClass negRep negRepRespects (class x) x (\refl(ClassOf x));
\definition mulMathClass: \forall (x, y: Difference) -> mulMath (class x) (class y) = class (mulRep x y) :=
  \fun (x, y: Difference) => binaryImageClass mulRep mulRepRespects (class x) (class y) x y (\refl(ClassOf x))
    (\refl(ClassOf y));
\definition addMathCongRight: \forall (x, y, z: Grothendieck) -> y = z -> addMath x y = addMath x z :=
  \fun (x, y, z: Grothendieck) => \fun (e: y = z) =>
    (\idelim(y = z \with C: \Power(Difference) =>
      \forall (hc: IsClass C) -> addMath x y = addMath x (\subsetinto(\Power(Difference), ClassSet, C, hc)))
      \by ((\fun (hc: IsClass y) => \refl(addMath x y)), e)) (classProperty z);
\definition subMathClass: \forall (x, y: Difference) -> subMath (class x) (class y) = class (subRep x y) :=
  \fun (x, y: Difference) => trans!{\Power(Difference)} (subMath (class x) (class y)) (addMath (class x) (class (negRep y))) (class
    (subRep x y))
    (addMathCongRight (class x) (negMath (class y)) (class (negRep y)) (negMathClass y))
    (addMathClass x (negRep y));
\definition addMatchesMath: \forall (x, y: Int) -> toMath (addSet x y) = addMath (toMath x) (toMath y) :=
  \fun (x, y: Int) => trans!{\Power(Difference)} (toMath (addSet x y)) (toMath (addPrec x y)) (addMath (toMath x) (toMath y))
    (toMathCong (addSet x y) (addPrec x y) (addMatchesPrec x y))
    (trans!{\Power(Difference)} (toMath (addPrec x y)) (class (addRep (representative x) (representative y))) (addMath (toMath
    x) (toMath y))
      (toFromClass (addRep (representative x) (representative y)))
      (sym!{\Power(Difference)} (addMath (toMath x) (toMath y)) (class (addRep (representative x) (representative y)))
    (addMathClass (representative x) (representative y))));
\definition negMatchesMath: \forall (x: Int) -> toMath (negSet x) = negMath (toMath x) :=
  \fun (x: Int) => trans!{\Power(Difference)} (toMath (negSet x)) (toMath (negPrec x)) (negMath (toMath x))
    (toMathCong (negSet x) (negPrec x) (negMatchesPrec x))
    (trans!{\Power(Difference)} (toMath (negPrec x)) (class (negRep (representative x))) (negMath (toMath x))
      (toFromClass (negRep (representative x)))
      (sym!{\Power(Difference)} (negMath (toMath x)) (class (negRep (representative x))) (negMathClass (representative x))));
\definition mulMatchesMath: \forall (x, y: Int) -> toMath (mulSet x y) = mulMath (toMath x) (toMath y) :=
  \fun (x, y: Int) => trans!{\Power(Difference)} (toMath (mulSet x y)) (toMath (mulPrec x y)) (mulMath (toMath x) (toMath y))
    (toMathCong (mulSet x y) (mulPrec x y) (mulMatchesPrec x y))
    (trans!{\Power(Difference)} (toMath (mulPrec x y)) (class (mulRep (representative x) (representative y))) (mulMath (toMath
    x) (toMath y))
      (toFromClass (mulRep (representative x) (representative y)))
      (sym!{\Power(Difference)} (mulMath (toMath x) (toMath y)) (class (mulRep (representative x) (representative y)))
    (mulMathClass (representative x) (representative y))));
\definition subMatchesMath: \forall (x, y: Int) -> toMath (subSet x y) = subMath (toMath x) (toMath y) :=
  \fun (x, y: Int) => trans!{\Power(Difference)} (toMath (subSet x y)) (addMath (toMath x) (toMath (negSet y))) (subMath (toMath x)
    (toMath y)) (addMatchesMath x (negSet y))
    (addMathCongRight (toMath x) (toMath (negSet y)) (negMath (toMath y)) (negMatchesMath y));

\definition roundTripArg: \forall (x: Int) -> x = fromMath (toMath x) :=
  \fun (x: Int) => sym!{Int} (fromMath (toMath x)) x (fromTo x);

/* Transport a specification across the proved isomorphism once per signature. */
\definition agreementII: \forall (f, g: Int -> Int) -> (\forall (a0: Int) -> f a0 = g a0) -> \forall (a0: Int) -> toMath (f a0) =
    toMath (g (fromMath (toMath a0))) :=
  \block {
    \fix (f, g: Int -> Int);
    \fix (matches: \forall (a0: Int) -> f a0 = g a0);
    \fix (a0: Int);
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int Int} g a0 (fromMath (toMath a0)) (roundTripArg a0);
    \let resultMatches: f a0 = g (fromMath (toMath a0)) :=
      trans!{Int} _ _ _ (matches a0) argumentMatches;
    \return toMathCong (f a0) (g (fromMath (toMath a0))) resultMatches;
  };

\definition agreementIN: \forall (f, g: Int -> N.Nat) -> (\forall (a0: Int) -> f a0 = g a0) -> \forall (a0: Int) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  \block {
    \fix (f, g: Int -> N.Nat);
    \fix (matches: \forall (a0: Int) -> f a0 = g a0);
    \fix (a0: Int);
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int N.Nat} g a0 (fromMath (toMath a0)) (roundTripArg a0);
    \return trans!{N.Nat} _ _ _ (matches a0) argumentMatches;
  };

\definition agreementIB: \forall (f, g: Int -> B.Bool) -> (\forall (a0: Int) -> f a0 = g a0) -> \forall (a0: Int) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  \block {
    \fix (f, g: Int -> B.Bool);
    \fix (matches: \forall (a0: Int) -> f a0 = g a0);
    \fix (a0: Int);
    \let argumentMatches: g a0 = g (fromMath (toMath a0)) :=
      congr!{Int B.Bool} g a0 (fromMath (toMath a0)) (roundTripArg a0);
    \return trans!{B.Bool} _ _ _ (matches a0) argumentMatches;
  };

\definition agreementIIB: \forall (f, g: Int -> Int -> B.Bool) -> (\forall (a0: Int) -> \forall (a1: Int) -> f a0 a1 = g a0 a1) ->
    \forall (a0: Int) -> \forall (a1: Int) -> (f a0 a1) = (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  \block {
    \fix (f, g: Int -> Int -> B.Bool);
    \fix (matches: \forall (a0: Int) -> \forall (a1: Int) -> f a0 a1 = g a0 a1);
    \fix (a0, a1: Int);
    \let argumentsMatch:
      g a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      congr2!{Int Int B.Bool} g
        a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1))
        (roundTripArg a0) (roundTripArg a1);
    \return trans!{B.Bool} _ _ _ (matches a0 a1) argumentsMatch;
  };

\definition agreementIII: \forall (f, g: Int -> Int -> Int) -> (\forall (a0: Int) -> \forall (a1: Int) -> f a0 a1 = g a0 a1) -> \forall (a0:
    Int) -> \forall (a1: Int) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  \block {
    \fix (f, g: Int -> Int -> Int);
    \fix (matches: \forall (a0: Int) -> \forall (a1: Int) -> f a0 a1 = g a0 a1);
    \fix (a0, a1: Int);
    \let argumentsMatch:
      g a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      congr2!{Int Int Int} g
        a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1))
        (roundTripArg a0) (roundTripArg a1);
    \let resultMatches:
      f a0 a1 = g (fromMath (toMath a0)) (fromMath (toMath a1)) :=
      trans!{Int} _ _ _ (matches a0 a1) argumentsMatch;
    \return toMathCong (f a0 a1)
      (g (fromMath (toMath a0)) (fromMath (toMath a1))) resultMatches;
  };

\definition agreementINI: \forall (f, g: Int -> N.Nat -> Int) -> (\forall (a0: Int) -> \forall (a1: N.Nat) -> f a0 a1 = g a0 a1) ->
    \forall (a0: Int) -> \forall (a1: N.Nat) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) a1) :=
  \block {
    \fix (f, g: Int -> N.Nat -> Int);
    \fix (matches: \forall (a0: Int) -> \forall (a1: N.Nat) -> f a0 a1 = g a0 a1);
    \fix (a0: Int), (a1: N.Nat);
    \let argumentMatches: g a0 a1 = g (fromMath (toMath a0)) a1 :=
      congr!{Int Int} (\fun (z: Int) => g z a1)
        a0 (fromMath (toMath a0)) (roundTripArg a0);
    \let resultMatches: f a0 a1 = g (fromMath (toMath a0)) a1 :=
      trans!{Int} _ _ _ (matches a0 a1) argumentMatches;
    \return toMathCong (f a0 a1) (g (fromMath (toMath a0)) a1) resultMatches;
  };

\definition agreementBIII: \forall (f, g: B.Bool -> Int -> Int -> Int) -> (\forall (a0: B.Bool) -> \forall (a1: Int) -> \forall (a2: Int) -> f
    a0 a1 a2 = g a0 a1 a2) -> \forall (a0: B.Bool) -> \forall (a1: Int) -> \forall (a2: Int) -> toMath (f a0 a1 a2) = toMath (g a0
    (fromMath (toMath a1)) (fromMath (toMath a2))) :=
  \block {
    \fix (f, g: B.Bool -> Int -> Int -> Int);
    \fix (matches: \forall (a0: B.Bool) -> \forall (a1: Int) -> \forall (a2: Int) -> f a0 a1 a2 = g a0 a1 a2);
    \fix (a0: B.Bool), (a1, a2: Int);
    \let argumentsMatch:
      g a0 a1 a2 = g a0 (fromMath (toMath a1)) (fromMath (toMath a2)) :=
      congr3!{B.Bool Int Int Int} g
        a0 a0 a1 (fromMath (toMath a1)) a2 (fromMath (toMath a2))
        (\refl(a0)) (roundTripArg a1) (roundTripArg a2);
    \let resultMatches:
      f a0 a1 a2 = g a0 (fromMath (toMath a1)) (fromMath (toMath a2)) :=
      trans!{Int} _ _ _ (matches a0 a1 a2) argumentsMatch;
    \return toMathCong (f a0 a1 a2)
      (g a0 (fromMath (toMath a1)) (fromMath (toMath a2))) resultMatches;
  };

/* Auxiliary operations on the quotient use its unique normal form. */
\definition ofNatMath: N.Nat -> Grothendieck :=
  \fun (n: N.Nat) => toMath (ofNatPrec n);

\definition ofNatMatchesMath: \forall (n: N.Nat) -> toMath (ofNatSet n) = ofNatMath n :=
  \fun (n: N.Nat) => toMathCong (ofNatSet n) (ofNatPrec n) (ofNatMatchesPrec n);

\definition negOfNatMath: N.Nat -> Grothendieck :=
  \fun (n: N.Nat) => toMath (negOfNatPrec n);

\definition negOfNatMatchesMath: \forall (n: N.Nat) -> toMath (negOfNatSet n) = negOfNatMath n :=
  \fun (n: N.Nat) => toMathCong (negOfNatSet n) (negOfNatPrec n) (negOfNatMatchesPrec n);

\definition succMath: Grothendieck -> Grothendieck :=
  \fun (x: Grothendieck) => toMath (succPrec (fromMath x));

\definition succMatchesMath: \forall (x: Int) -> toMath (succSet x) = succMath (toMath x) :=
  \fun (x: Int) => agreementII succSet succPrec succMatchesPrec x;

\definition predMath: Grothendieck -> Grothendieck :=
  \fun (x: Grothendieck) => toMath (predPrec (fromMath x));

\definition predMatchesMath: \forall (x: Int) -> toMath (predSet x) = predMath (toMath x) :=
  \fun (x: Int) => agreementII predSet predPrec predMatchesPrec x;

\definition natAbsMath: Grothendieck -> N.Nat :=
  \fun (x: Grothendieck) => (natAbsPrec (fromMath x));

\definition natAbsMatchesMath: \forall (x: Int) -> (natAbsSet x) = natAbsMath (toMath x) :=
  \fun (x: Int) => agreementIN natAbsSet natAbsPrec natAbsMatchesPrec x;

\definition absMath: Grothendieck -> Grothendieck :=
  \fun (x: Grothendieck) => toMath (absPrec (fromMath x));

\definition absMatchesMath: \forall (x: Int) -> toMath (absSet x) = absMath (toMath x) :=
  \fun (x: Int) => agreementII absSet absPrec absMatchesPrec x;

\definition isZeroMath: Grothendieck -> B.Bool :=
  \fun (x: Grothendieck) => (isZeroPrec (fromMath x));

\definition isZeroMatchesMath: \forall (x: Int) -> (isZeroSet x) = isZeroMath (toMath x) :=
  \fun (x: Int) => agreementIB isZeroSet isZeroPrec isZeroMatchesPrec x;

\definition eqbMath: Grothendieck -> Grothendieck -> B.Bool :=
  \fun (x: Grothendieck) => \fun (y: Grothendieck) => (eqbPrec (fromMath x) (fromMath y));

\definition eqbMatchesMath: \forall (x: Int) -> \forall (y: Int) -> (eqbSet x y) = eqbMath (toMath x) (toMath y) :=
  \fun (x: Int) => \fun (y: Int) => agreementIIB eqbSet eqbPrec eqbMatchesPrec x y;

\definition lebMath: Grothendieck -> Grothendieck -> B.Bool :=
  \fun (x: Grothendieck) => \fun (y: Grothendieck) => (lebPrec (fromMath x) (fromMath y));

\definition lebMatchesMath: \forall (x: Int) -> \forall (y: Int) -> (lebSet x y) = lebMath (toMath x) (toMath y) :=
  \fun (x: Int) => \fun (y: Int) => agreementIIB lebSet lebPrec lebMatchesPrec x y;

\definition ltbMath: Grothendieck -> Grothendieck -> B.Bool :=
  \fun (x: Grothendieck) => \fun (y: Grothendieck) => (ltbPrec (fromMath x) (fromMath y));

\definition ltbMatchesMath: \forall (x: Int) -> \forall (y: Int) -> (ltbSet x y) = ltbMath (toMath x) (toMath y) :=
  \fun (x: Int) => \fun (y: Int) => agreementIIB ltbSet ltbPrec ltbMatchesPrec x y;

\definition minMath: Grothendieck -> Grothendieck -> Grothendieck :=
  \fun (x: Grothendieck) => \fun (y: Grothendieck) => toMath (minPrec (fromMath x) (fromMath y));

\definition minMatchesMath: \forall (x: Int) -> \forall (y: Int) -> toMath (minSet x y) = minMath (toMath x) (toMath y) :=
  \fun (x: Int) => \fun (y: Int) => agreementIII minSet minPrec minMatchesPrec x y;

\definition maxMath: Grothendieck -> Grothendieck -> Grothendieck :=
  \fun (x: Grothendieck) => \fun (y: Grothendieck) => toMath (maxPrec (fromMath x) (fromMath y));

\definition maxMatchesMath: \forall (x: Int) -> \forall (y: Int) -> toMath (maxSet x y) = maxMath (toMath x) (toMath y) :=
  \fun (x: Int) => \fun (y: Int) => agreementIII maxSet maxPrec maxMatchesPrec x y;

\definition signMath: Grothendieck -> Grothendieck :=
  \fun (x: Grothendieck) => toMath (signPrec (fromMath x));

\definition signMatchesMath: \forall (x: Int) -> toMath (signSet x) = signMath (toMath x) :=
  \fun (x: Int) => agreementII signSet signPrec signMatchesPrec x;

\definition evenMath: Grothendieck -> B.Bool :=
  \fun (x: Grothendieck) => (evenPrec (fromMath x));

\definition evenMatchesMath: \forall (x: Int) -> (evenSet x) = evenMath (toMath x) :=
  \fun (x: Int) => agreementIB evenSet evenPrec evenMatchesPrec x;

\definition oddMath: Grothendieck -> B.Bool :=
  \fun (x: Grothendieck) => (oddPrec (fromMath x));

\definition oddMatchesMath: \forall (x: Int) -> (oddSet x) = oddMath (toMath x) :=
  \fun (x: Int) => agreementIB oddSet oddPrec oddMatchesPrec x;

\definition powMath: Grothendieck -> N.Nat -> Grothendieck :=
  \fun (x: Grothendieck) => \fun (n: N.Nat) => toMath (powPrec (fromMath x) n);

\definition powMatchesMath: \forall (x: Int) -> \forall (n: N.Nat) -> toMath (powSet x n) = powMath (toMath x) n :=
  \fun (x: Int) => \fun (n: N.Nat) => agreementINI powSet powPrec powMatchesPrec x n;

\definition positiveMath: Grothendieck -> N.Nat :=
  \fun (x: Grothendieck) => (positivePrec (fromMath x));

\definition positiveMatchesMath: \forall (x: Int) -> (positiveSet x) = positiveMath (toMath x) :=
  \fun (x: Int) => agreementIN positiveSet positivePrec positiveMatchesPrec x;

\definition negativeMath: Grothendieck -> N.Nat :=
  \fun (x: Grothendieck) => (negativePrec (fromMath x));

\definition negativeMatchesMath: \forall (x: Int) -> (negativeSet x) = negativeMath (toMath x) :=
  \fun (x: Int) => agreementIN negativeSet negativePrec negativeMatchesPrec x;

\definition chooseMath: B.Bool -> Grothendieck -> Grothendieck -> Grothendieck :=
  \fun (test: B.Bool) => \fun (yes: Grothendieck) => \fun (no: Grothendieck) => toMath (choosePrec test (fromMath yes)
    (fromMath no));

\definition chooseMatchesMath: \forall (test: B.Bool) -> \forall (yes: Int) -> \forall (no: Int) -> toMath (chooseSet test yes no) =
    chooseMath test (toMath yes) (toMath no) :=
  \fun (test: B.Bool) => \fun (yes: Int) => \fun (no: Int) => agreementBIII chooseSet choosePrec chooseMatchesPrec test yes
    no;

\definition zeroMath: Grothendieck := toMath zeroPrec;
\definition zeroMatchesMath: toMath zeroSet = zeroMath := toMathCong zeroSet zeroPrec zeroMatchesPrec;

\definition oneMath: Grothendieck := toMath onePrec;
\definition oneMatchesMath: toMath oneSet = oneMath := toMathCong oneSet onePrec oneMatchesPrec;

\definition minusOneMath: Grothendieck := toMath minusOnePrec;
\definition minusOneMatchesMath: toMath minusOneSet = minusOneMath := toMathCong minusOneSet minusOnePrec
    minusOneMatchesPrec;

\definition diffMath: N.Nat -> N.Nat -> Grothendieck := \fun (a, b: N.Nat) => class (pair a b);
\definition diffMatchesMath: \forall (a, b: N.Nat) -> toMath (diffSet a b) = diffMath a b :=
  \fun (a, b: N.Nat) => trans!{\Power(Difference)} (toMath (diffSet a b)) (toMath (diffPrec a b)) (class (pair a b))
    (toMathCong (diffSet a b) (diffPrec a b) (diffMatchesPrec b a)) (toFromClass (pair a b));
\definition Le: Int -> Int -> \Prop := \fun (x, y: Int) => lebSet x y = B.Bool::true;
\definition Lt: Int -> Int -> \Prop := \fun (x, y: Int) => ltbSet x y = B.Bool::true;
\definition LeMath: Grothendieck -> Grothendieck -> \Prop := \fun (x, y: Grothendieck) => lebMath x y =
    B.Bool::true;
\definition LtMath: Grothendieck -> Grothendieck -> \Prop := \fun (x, y: Grothendieck) => ltbMath x y =
    B.Bool::true;

/* Elimination out of the quotient only uses unique-value take. */
\definition mathInduction: \forall (P: Grothendieck -> \Prop) ->
  (\forall (x: Difference) -> P (class x)) -> \forall (C: Grothendieck) -> P C :=
  \fun (P: Grothendieck -> \Prop) => \fun (step: \forall (x: Difference) -> P (class x)) => \fun (C: Grothendieck) =>
    \take (x: \Ty(Difference, Representatives C)) =>
      (\idelim(class x = C \with D: \Power(Difference) =>
        \forall (hd: IsClass D) -> P (\subsetinto(\Power(Difference), ClassSet, D, hd)))
      \by ((\fun (hd: IsClass (class x)) => step x),
        \idelim(C = ClassOf x \with D: \Power(Difference) => D = C)
          \by (\refl(C), \bysub(Difference, Representatives C, x)))) (classProperty C)
    \by (representativesExist C);
\definition addMathCongLeft: \forall (x, y, z: Grothendieck) -> x = y -> addMath x z = addMath y z :=
  \fun (x, y, z: Grothendieck) => \fun (e: x = y) =>
    (\idelim(x = y \with C: \Power(Difference) =>
      \forall (hc: IsClass C) -> addMath x z = addMath (\subsetinto(\Power(Difference), ClassSet, C, hc)) z)
      \by ((\fun (hc: IsClass x) => \refl(addMath x z)), e)) (classProperty y);
\definition addRepComm: \forall (x, y: Difference) -> Equivalent (addRep x y) (addRep y x) :=
  \fun (x, y: Difference) => equivalentOfFields (addRep x y) (addRep y x)
    (N.addComm (pos x) (pos y)) (N.addComm (negPart x) (negPart y));
\definition addRepAssoc: \forall (x, y, z: Difference) -> Equivalent (addRep (addRep x y) z) (addRep x (addRep y z))
    :=
  \fun (x, y, z: Difference) => equivalentOfFields (addRep (addRep x y) z) (addRep x (addRep y z))
    (N.addAssoc (pos x) (pos y) (pos z)) (N.addAssoc (negPart x) (negPart y) (negPart z));
\definition addMathZeroLeft: \forall (x: Grothendieck) -> addMath zeroMath x = x :=
  mathInduction (\fun (x: Grothendieck) => addMath zeroMath x = x)
    (\fun (x: Difference) => trans!{\Power(Difference)} _ _ _ (addMathClass (pair N.Nat::zero N.Nat::zero) x)
      (classOfEq (addRep (pair N.Nat::zero N.Nat::zero) x) x
        (equivalentOfFields (addRep (pair N.Nat::zero N.Nat::zero) x) x
          (N.addZeroLeft (pos x)) (N.addZeroLeft (negPart x)))));
\definition addMathComm: \forall (x, y: Grothendieck) -> addMath x y = addMath y x :=
  mathInduction (\fun (x: Grothendieck) => \forall (y: Grothendieck) -> addMath x y = addMath y x)
    (\fun (x: Difference) => mathInduction (\fun (y: Grothendieck) => addMath (class x) y = addMath y (class x))
      (\fun (y: Difference) => trans!{\Power(Difference)} _ _ _ (addMathClass x y)
        (trans!{\Power(Difference)} _ _ _ (classOfEq (addRep x y) (addRep y x) (addRepComm x y))
          (sym!{\Power(Difference)} _ _ (addMathClass y x)))));
\definition mulMathComm: \forall (x, y: Grothendieck) -> mulMath x y = mulMath y x :=
  mathInduction (\fun (x: Grothendieck) =>
    \forall (y: Grothendieck) -> mulMath x y = mulMath y x)
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) =>
        mulMath (class x) y = mulMath y (class x))
        (\fun (y: Difference) =>
          trans!{\Power(Difference)} _ _ _ (mulMathClass x y)
            (trans!{\Power(Difference)} _ _ _
              (classOfEq (mulRep x y) (mulRep y x) (mulRepComm x y))
              (sym!{\Power(Difference)} _ _ (mulMathClass y x)))));
\definition addMathZeroRight: \forall (x: Grothendieck) -> addMath x zeroMath = x :=
  \fun (x: Grothendieck) => trans!{\Power(Difference)} _ _ _ (addMathComm x zeroMath) (addMathZeroLeft x);
\definition addMathAssoc: \forall (x, y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y z) :=
  mathInduction (\fun (x: Grothendieck) => \forall (y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y
    z))
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) => \forall (z: Grothendieck) ->
        addMath (addMath (class x) y) z = addMath (class x) (addMath y z))
        (\fun (y: Difference) =>
          mathInduction (\fun (z: Grothendieck) => addMath (addMath (class x) (class y)) z =
            addMath (class x) (addMath (class y) z))
            (\fun (z: Difference) => trans!{\Power(Difference)} _ _ _
              (addMathCongLeft (addMath (class x) (class y)) (class (addRep x y)) (class z) (addMathClass x
    y))
              (trans!{\Power(Difference)} _ _ _ (addMathClass (addRep x y) z)
                (trans!{\Power(Difference)} _ _ _ (classOfEq (addRep (addRep x y) z) (addRep x (addRep y z)) (addRepAssoc x y
    z))
                  (trans!{\Power(Difference)} _ _ _ (sym!{\Power(Difference)} _ _ (addMathClass x (addRep y z)))
                    (addMathCongRight (class x) (class (addRep y z)) (addMath (class y) (class z))
                      (sym!{\Power(Difference)} _ _ (addMathClass y z)))))))));
\definition negMathInverse: \forall (x: Grothendieck) -> addMath (negMath x) x = zeroMath :=
  mathInduction (\fun (x: Grothendieck) => addMath (negMath x) x = zeroMath)
    (\fun (x: Difference) => trans!{\Power(Difference)} _ _ _
      (addMathCongLeft (negMath (class x)) (class (negRep x)) (class x) (negMathClass x))
      (trans!{\Power(Difference)} _ _ _ (addMathClass (negRep x) x)
        (classOfEq (addRep (negRep x) x) (pair N.Nat::zero N.Nat::zero)
          (trans!{N.Nat} _ _ _ (N.addComm (negPart x) (pos x))
            (sym!{N.Nat} _ _ (N.addZeroLeft (N.addSet (pos x) (negPart x))))))));
\definition toMathInjective: \forall (x, y: Int) -> toMath x = toMath y -> x = y :=
  \fun (x, y: Int) => \fun (e: toMath x = toMath y) =>
    trans!{Int} x (fromMath (toMath x)) y (sym!{Int} _ _ (fromTo x))
      ((\idelim(toMath y = toMath x \with C: \Power(Difference) =>
        \forall (hc: IsClass C) -> fromMath (\subsetinto(\Power(Difference), ClassSet, C, hc)) = y)
        \by ((\fun (hc: IsClass (toMath y)) => fromTo y), sym!{\Power(Difference)} (toMath x) (toMath y) e))
        (classProperty (toMath x)));
\definition addComm: \forall (x, y: Int) -> addSet x y = addSet y x :=
  \fun (x, y: Int) => toMathInjective (addSet x y) (addSet y x)
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath x y)
      (trans!{\Power(Difference)} _ _ _ (addMathComm (toMath x) (toMath y)) (sym!{\Power(Difference)} _ _ (addMatchesMath y x))));
\definition mulComm: \forall (x, y: Int) -> mulSet x y = mulSet y x :=
  \fun (x, y: Int) => toMathInjective (mulSet x y) (mulSet y x)
    (trans!{\Power(Difference)} _ _ _ (mulMatchesMath x y)
      (trans!{\Power(Difference)} _ _ _
        (mulMathComm (toMath x) (toMath y))
        (sym!{\Power(Difference)} _ _ (mulMatchesMath y x))));
\definition addZeroLeft: \forall (x: Int) -> addSet zeroSet x = x :=
  \fun (x: Int) => toMathInjective (addSet zeroSet x) x
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath zeroSet x) (addMathZeroLeft (toMath x)));
\definition addZeroRight: \forall (x: Int) -> addSet x zeroSet = x :=
  \fun (x: Int) => trans!{Int} _ _ _ (addComm x zeroSet) (addZeroLeft x);
\definition negInverse: \forall (x: Int) -> addSet (negSet x) x = zeroSet :=
  \fun (x: Int) => toMathInjective (addSet (negSet x) x) zeroSet
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath (negSet x) x)
      (trans!{\Power(Difference)} _ _ _ (addMathCongLeft (toMath (negSet x)) (negMath (toMath x)) (toMath x) (negMatchesMath
    x))
        (negMathInverse (toMath x))));

\definition addAssoc: \forall (x, y, z: Int) ->
  addSet (addSet x y) z = addSet x (addSet y z) :=
  \fun (x, y, z: Int) =>
    toMathInjective (addSet (addSet x y) z) (addSet x (addSet y z))
      (trans!{\Power(Difference)} _ _ _ (addMatchesMath (addSet x y) z)
        (trans!{\Power(Difference)} _ _ _
          (addMathCongLeft
            (toMath (addSet x y))
            (addMath (toMath x) (toMath y))
            (toMath z)
            (addMatchesMath x y))
          (trans!{\Power(Difference)} _ _ _
            (addMathAssoc (toMath x) (toMath y) (toMath z))
            (trans!{\Power(Difference)} _ _ _
              (addMathCongRight
                (toMath x)
                (addMath (toMath y) (toMath z))
                (toMath (addSet y z))
                (sym!{\Power(Difference)} _ _ (addMatchesMath y z)))
              (sym!{\Power(Difference)} _ _
                (addMatchesMath x (addSet y z)))))));

\definition negInverseRight: \forall (x: Int) ->
  addSet x (negSet x) = zeroSet :=
  \fun (x: Int) =>
    trans!{Int} _ _ _ (addComm x (negSet x)) (negInverse x);
