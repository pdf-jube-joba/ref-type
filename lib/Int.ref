\definition ltbSet: Int -> Int -> B.Bool := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(B.Bool))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(B.Bool))))), ltb));
\definition ltbPrec: Int -> Int -> B.Bool := (x: Int) => (y: Int) => (natLtbPrec (N.addSet (positivePrec x)
