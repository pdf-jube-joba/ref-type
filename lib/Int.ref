\definition lebMatchesPrec: (x: Int) -> (y: Int) -> lebSet x y = lebPrec x y :=
  (x: Int) => (y: Int) => trans!{B.Bool} _ _ _ (congr2!{N.Nat N.Nat B.Bool} (natLebSet) (N.addSet (positiveSet x) (negativeSet y))
    (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positiveSet y) (negativeSet x)) (N.addSet
    (positivePrec y) (negativePrec x)) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet x) (positivePrec x) (negativeSet y)
    (negativePrec y) (positiveMatchesPrec x) (negativeMatchesPrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet y)
    (positivePrec y) (negativeSet x) (negativePrec x) (positiveMatchesPrec y) (negativeMatchesPrec x)))
    (natLebMatchesPrec (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec
    x)));

\cdefinition ltb: \CFun(Int, \F(\U(\CFun(Int, \F(B.Bool))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(positive, x), v2, N.Nat, \sequence(\capp(negative, y), v4, N.Nat,
