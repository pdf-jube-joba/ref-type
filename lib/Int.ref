    (positivePrec y) (negativeSet x) (negativePrec x) (positiveMatchesPrec y) (negativeMatchesPrec x)))
    (natLtbMatchesPrec (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec
    x)));

\cdefinition min: \CFun(Int, \F(\U(\CFun(Int, \F(Int))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(leb, x), v1, \U(\CFun(Int, \F(B.Bool))), \sequence(\capp(\force(v1), y), v3, B.Bool,
    \sequence(\capp(choose, v3), v4, \U(\CFun(Int, \F(\U(\CFun(Int, \F(Int)))))), \sequence(\capp(\force(v4),
    x), v5, \U(\CFun(Int, \F(Int))), \sequence(\capp(\force(v5), y), v7, Int, \return(v7))))))))));
\definition minSet: Int -> Int -> Int := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(Int))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(Int))))), min));
\definition minPrec: Int -> Int -> Int := (x: Int) => (y: Int) => (choosePrec (lebPrec x y) x y);
\definition minMatchesPrec: (x: Int) -> (y: Int) -> minSet x y = minPrec x y :=
  (x: Int) => (y: Int) => trans!{Int} _ _ _ (congr3!{B.Bool Int Int Int} (chooseSet) (lebSet x y) (lebPrec x y) x x y y
    (lebMatchesPrec x y) (\refl(x)) (\refl(y))) (chooseMatchesPrec (lebPrec x y) x y);

\cdefinition max: \CFun(Int, \F(\U(\CFun(Int, \F(Int))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(leb, x), v1, \U(\CFun(Int, \F(B.Bool))), \sequence(\capp(\force(v1), y), v3, B.Bool,
    \sequence(\capp(choose, v3), v4, \U(\CFun(Int, \F(\U(\CFun(Int, \F(Int)))))), \sequence(\capp(\force(v4),
    y), v5, \U(\CFun(Int, \F(Int))), \sequence(\capp(\force(v5), x), v7, Int, \return(v7))))))))));
\definition maxSet: Int -> Int -> Int := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(Int))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(Int))))), max));
\definition maxPrec: Int -> Int -> Int := (x: Int) => (y: Int) => (choosePrec (lebPrec x y) y x);
\definition maxMatchesPrec: (x: Int) -> (y: Int) -> maxSet x y = maxPrec x y :=
  (x: Int) => (y: Int) => trans!{Int} _ _ _ (congr3!{B.Bool Int Int Int} (chooseSet) (lebSet x y) (lebPrec x y) y y x x
    (lebMatchesPrec x y) (\refl(y)) (\refl(x))) (chooseMatchesPrec (lebPrec x y) y x);

\cdefinition sign: \CFun(Int, \F(Int)) := \clam(x, Int, \sequence(\capp(isZero, x), v2, B.Bool,
    \sequence(\capp(negative, x), v4, N.Nat, \sequence(\capp(natIsZero, v4), v6, B.Bool,
    \sequence(\capp(choose, v6), v7, \U(\CFun(Int, \F(\U(\CFun(Int, \F(Int)))))), \sequence(\capp(\force(v7),
    (Int::ofNat (N.Nat::succ N.Nat::zero))), v8, \U(\CFun(Int, \F(Int))), \sequence(\capp(\force(v8),
    (Int::negSucc N.Nat::zero)), v10, Int, \sequence(\capp(choose, v2), v11, \U(\CFun(Int, \F(\U(\CFun(Int,
    \F(Int)))))), \sequence(\capp(\force(v11), (Int::ofNat N.Nat::zero)), v12, \U(\CFun(Int, \F(Int))),
    \sequence(\capp(\force(v12), v10), v14, Int, \return(v14)))))))))));
\definition signSet: Int -> Int := \Force(\CFun(Int, \F(Int)), \box(\CFun(Int, \F(Int)), sign));
\definition signPrec: Int -> Int := (x: Int) => (choosePrec (isZeroPrec x) (Int::ofNat N.Nat::zero)
    (choosePrec (natIsZeroPrec (negativePrec x)) (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc
    N.Nat::zero)));
\definition signMatchesPrec: (x: Int) -> signSet x = signPrec x :=
  (x: Int) => trans!{Int} _ _ _ (congr3!{B.Bool Int Int Int} (chooseSet) (isZeroSet x) (isZeroPrec x) (Int::ofNat N.Nat::zero)
    (Int::ofNat N.Nat::zero) (chooseSet (natIsZeroSet (negativeSet x)) (Int::ofNat (N.Nat::succ N.Nat::zero))
    (Int::negSucc N.Nat::zero)) (choosePrec (natIsZeroPrec (negativePrec x)) (Int::ofNat (N.Nat::succ
    N.Nat::zero)) (Int::negSucc N.Nat::zero)) (isZeroMatchesPrec x) (\refl((Int::ofNat N.Nat::zero))) (trans!{Int}
    _ _ _ (congr3!{B.Bool Int Int Int} (chooseSet) (natIsZeroSet (negativeSet x)) (natIsZeroPrec (negativePrec x)) (Int::ofNat
    (N.Nat::succ N.Nat::zero)) (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) (Int::negSucc
    N.Nat::zero) (trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natIsZeroSet) (negativeSet x) (negativePrec x) (negativeMatchesPrec
    x)) (natIsZeroMatchesPrec (negativePrec x))) (\refl((Int::ofNat (N.Nat::succ N.Nat::zero))))
    (\refl((Int::negSucc N.Nat::zero)))) (chooseMatchesPrec (natIsZeroPrec (negativePrec x)) (Int::ofNat
    (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)))) (chooseMatchesPrec (isZeroPrec x) (Int::ofNat
    N.Nat::zero) (choosePrec (natIsZeroPrec (negativePrec x)) (Int::ofNat (N.Nat::succ N.Nat::zero))
    (Int::negSucc N.Nat::zero)));

\cdefinition even: \CFun(Int, \F(B.Bool)) := \clam(x, Int, \sequence(\capp(natAbs, x), v2, N.Nat,
    \sequence(\capp(natEven, v2), v4, B.Bool, \return(v4))));
\definition evenSet: Int -> B.Bool := \Force(\CFun(Int, \F(B.Bool)), \box(\CFun(Int, \F(B.Bool)), even));
\definition evenPrec: Int -> B.Bool := (x: Int) => (natEvenPrec (natAbsPrec x));
\definition evenMatchesPrec: (x: Int) -> evenSet x = evenPrec x :=
  (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natEvenSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natEvenMatchesPrec (natAbsPrec x));

\cdefinition odd: \CFun(Int, \F(B.Bool)) := \clam(x, Int, \sequence(\capp(natAbs, x), v2, N.Nat,
    \sequence(\capp(natOdd, v2), v4, B.Bool, \return(v4))));
\definition oddSet: Int -> B.Bool := \Force(\CFun(Int, \F(B.Bool)), \box(\CFun(Int, \F(B.Bool)), odd));
\definition oddPrec: Int -> B.Bool := (x: Int) => (natOddPrec (natAbsPrec x));
\definition oddMatchesPrec: (x: Int) -> oddSet x = oddPrec x :=
  (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natOddSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natOddMatchesPrec (natAbsPrec x));

/* Apply a sign after computing the magnitude once. */
\cdefinition powerSign: \CFun(B.Bool, \F(\U(\CFun(N.Nat, \F(Int))))) :=
  \clam(test, B.Bool, \return(\thunk(\clam(magnitude, N.Nat,
    \vcase(B.Bool, test) {
    | false() => \return(Int::ofNat magnitude);
    | true() => \capp(negOfNat, magnitude);
    }))));
\definition powerSignSet: B.Bool -> N.Nat -> Int :=
  \Force(\CFun(B.Bool, \F(\U(\CFun(N.Nat, \F(Int))))),
    \box(\CFun(B.Bool, \F(\U(\CFun(N.Nat, \F(Int))))), powerSign));
\definition powerSignPrec: B.Bool -> N.Nat -> Int := (test: B.Bool) => (magnitude: N.Nat) =>
  B.ite Int test (negOfNatPrec magnitude) (Int::ofNat magnitude);
\definition powerSignMatchesPrec: (test: B.Bool) -> (magnitude: N.Nat) ->
  powerSignSet test magnitude = powerSignPrec test magnitude :=
  \prec(\Prop, B.Bool) ((test: B.Bool) => (magnitude: N.Nat) ->
    powerSignSet test magnitude = powerSignPrec test magnitude)
    ((magnitude: N.Nat) => \refl(Int::ofNat magnitude)) negOfNatMatchesPrec;
\cdefinition pow: \CFun(Int, \F(\U(\CFun(N.Nat, \F(Int))))) :=
  \clam(x, Int, \return(\thunk(\clam(n, N.Nat,
    \vcase(Int, x) {
    | ofNat(a) => \sequence(\capp(N.pow, a), f, \U(\CFun(N.Nat, \F(N.Nat))),
        \sequence(\capp(\force(f), n), magnitude, N.Nat, \return(Int::ofNat magnitude)));
    | negSucc(a) => \sequence(\capp(N.pow, N.Nat::succ a), f, \U(\CFun(N.Nat, \F(N.Nat))),
        \sequence(\capp(\force(f), n), magnitude, N.Nat,
          \sequence(\capp(natOdd, n), test, B.Bool,
            \sequence(\capp(powerSign, test), sign, \U(\CFun(N.Nat, \F(Int))),
              \capp(\force(sign), magnitude)))));
    }))));
\definition powSet: Int -> N.Nat -> Int :=
  \Force(\CFun(Int, \F(\U(\CFun(N.Nat, \F(Int))))),
    \box(\CFun(Int, \F(\U(\CFun(N.Nat, \F(Int))))), pow));
\definition powPrec: Int -> N.Nat -> Int :=
  \prec(\Set, Int) ((x: Int) => N.Nat -> Int)
    ((a, n: N.Nat) => Int::ofNat (N.powSet a n))
    ((a, n: N.Nat) => powerSignPrec (natOddPrec n) (N.powSet (N.Nat::succ a) n));
\definition powerSignTestMatches: (n, magnitude: N.Nat) ->
  powerSignSet (natOddSet n) magnitude = powerSignPrec (natOddPrec n) magnitude :=
  (n, magnitude: N.Nat) =>
    \idelim(natOddSet n = natOddPrec n \with test: B.Bool =>
      powerSignSet (natOddSet n) magnitude = powerSignPrec test magnitude)
    \by (powerSignMatchesPrec (natOddSet n) magnitude, natOddMatchesPrec n);
\definition powMatchesPrec: (x: Int) -> (n: N.Nat) -> powSet x n = powPrec x n :=
  \prec(\Prop, Int) ((x: Int) => (n: N.Nat) -> powSet x n = powPrec x n)
    ((a, n: N.Nat) => \refl(Int::ofNat (N.powSet a n)))
    ((a, n: N.Nat) => powerSignTestMatches n (N.powSet (N.Nat::succ a) n));

/* Operations on formal differences, before passing to equivalence classes. */
\definition addRep: Difference -> Difference -> Difference := (x, y: Difference) =>
  pair (N.addSet (pos x) (pos y)) (N.addSet (negPart x) (negPart y));
\definition negRep: Difference -> Difference := (x: Difference) => pair (negPart x) (pos x);
\definition subRep: Difference -> Difference -> Difference := (x, y: Difference) => addRep x (negRep y);
\definition scaleRep: Difference -> N.Nat -> Difference := (x: Difference) => (n: N.Nat) =>
  pair (N.mulSet (pos x) n) (N.mulSet (negPart x) n);
\definition mulRep: Difference -> Difference -> Difference := (x, y: Difference) =>
  pair (N.addSet (N.mulSet (pos x) (pos y)) (N.mulSet (negPart x) (negPart y)))
       (N.addSet (N.mulSet (pos x) (negPart y)) (N.mulSet (negPart x) (pos y)));
\definition equivalentOfFields: (x, y: Difference) -> pos x = pos y -> negPart x = negPart y -> Equivalent x y
    :=
  (x, y: Difference) => (p: pos x = pos y) => (n: negPart x = negPart y) =>
    N.addCong (pos x) (pos y) (negPart y) (negPart x) p (sym!{N.Nat} _ _ n);
\definition addRepRespects: (x, y, u, v: Difference) ->
  Equivalent x y -> Equivalent u v -> Equivalent (addRep x u) (addRep y v) :=
  (x, y, u, v: Difference) => (xy: Equivalent x y) => (uv: Equivalent u v) =>
    trans!{N.Nat} _ _ _ (N.addInterchange (pos x) (pos u) (negPart y) (negPart v))
      (trans!{N.Nat} _ _ _
        (N.addCong (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x))
          (N.addSet (pos u) (negPart v)) (N.addSet (pos v) (negPart u)) xy uv)
        (sym!{N.Nat} _ _ (N.addInterchange (pos y) (pos v) (negPart x) (negPart u))));
\definition negRepRespects: (x, y: Difference) -> Equivalent x y -> Equivalent (negRep x) (negRep y) :=
  (x, y: Difference) => (xy: Equivalent x y) =>
    trans!{N.Nat} _ _ _ (N.addComm (negPart x) (pos y))
      (trans!{N.Nat} (N.addSet (pos y) (negPart x)) (N.addSet (pos x) (negPart y))
        (N.addSet (negPart y) (pos x))
        (sym!{N.Nat} (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x)) xy)
        (N.addComm (pos x) (negPart y)));
\definition subRepRespects: (x, y, u, v: Difference) ->
  Equivalent x y -> Equivalent u v -> Equivalent (subRep x u) (subRep y v) :=
  (x, y, u, v: Difference) => (xy: Equivalent x y) => (uv: Equivalent u v) =>
    addRepRespects x y (negRep u) (negRep v) xy (negRepRespects u v uv);
\definition scaleRepRespects: (x, y: Difference) -> (n: N.Nat) ->
  Equivalent x y -> Equivalent (scaleRep x n) (scaleRep y n) :=
  (x, y: Difference) => (n: N.Nat) => (xy: Equivalent x y) =>
    trans!{N.Nat} _ _ _ (sym!{N.Nat} _ _ (N.mulDistribRight (pos x) (negPart y) n))
      (trans!{N.Nat} _ _ _
        (congr!{N.Nat N.Nat} ((a: N.Nat) => N.mulSet a n)
          (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x)) xy)
        (N.mulDistribRight (pos y) (negPart x) n));
\definition mulRepAsSum: (x, y: Difference) ->
  Equivalent (mulRep x y) (addRep (scaleRep x (pos y)) (negRep (scaleRep x (negPart y)))) :=
  (x, y: Difference) => equivalentOfFields (mulRep x y)
    (addRep (scaleRep x (pos y)) (negRep (scaleRep x (negPart y))))
    (\refl(pos (mulRep x y))) (N.addComm (N.mulSet (pos x) (negPart y)) (N.mulSet (negPart x) (pos y)));
\definition mulRepComm: (x, y: Difference) -> Equivalent (mulRep x y) (mulRep y x) :=
  (x, y: Difference) => equivalentOfFields (mulRep x y) (mulRep y x)
    (N.addCong _ _ _ _ (N.mulComm (pos x) (pos y)) (N.mulComm (negPart x) (negPart y)))
    (trans!{N.Nat} _ _ _
      (N.addCong _ _ _ _ (N.mulComm (pos x) (negPart y)) (N.mulComm (negPart x) (pos y)))
      (N.addComm (N.mulSet (negPart y) (pos x)) (N.mulSet (pos y) (negPart x))));
\definition mulRepRespectsLeft: (x, y, z: Difference) ->
  Equivalent x y -> Equivalent (mulRep x z) (mulRep y z) :=
  (x, y, z: Difference) => (xy: Equivalent x y) =>
    equivalentTrans (mulRep x z)
      (addRep (scaleRep x (pos z)) (negRep (scaleRep x (negPart z)))) (mulRep y z)
      (mulRepAsSum x z)
      (equivalentTrans (addRep (scaleRep x (pos z)) (negRep (scaleRep x (negPart z))))
        (addRep (scaleRep y (pos z)) (negRep (scaleRep y (negPart z)))) (mulRep y z)
        (addRepRespects (scaleRep x (pos z)) (scaleRep y (pos z))
          (negRep (scaleRep x (negPart z))) (negRep (scaleRep y (negPart z)))
          (scaleRepRespects x y (pos z) xy)
          (negRepRespects (scaleRep x (negPart z)) (scaleRep y (negPart z))
            (scaleRepRespects x y (negPart z) xy)))
        (equivalentSym (mulRep y z)
          (addRep (scaleRep y (pos z)) (negRep (scaleRep y (negPart z)))) (mulRepAsSum y z)));
\definition mulRepRespects: (x, y, u, v: Difference) ->
  Equivalent x y -> Equivalent u v -> Equivalent (mulRep x u) (mulRep y v) :=
  (x, y, u, v: Difference) => (xy: Equivalent x y) => (uv: Equivalent u v) =>
    equivalentTrans (mulRep x u) (mulRep y u) (mulRep y v) (mulRepRespectsLeft x y u xy)
      (equivalentTrans (mulRep y u) (mulRep u y) (mulRep y v) (mulRepComm y u)
        (equivalentTrans (mulRep u y) (mulRep v y) (mulRep y v)
          (mulRepRespectsLeft u v y uv) (mulRepComm v y)));

\definition toMathCong: (x, y: Int) -> x = y -> toMath x = toMath y :=
  (x, y: Int) => (e: x = y) =>
    \idelim(x = y \with z: Int => toMath x = toMath z) \by (\refl(toMath x), e);

/* Relational images define operations without choosing representatives. */
\definition UnaryRespects: (Difference -> Difference) -> \Prop := (f: Difference -> Difference) =>
  (x, y: Difference) -> Equivalent x y -> Equivalent (f x) (f y);
\definition BinaryRespects: (Difference -> Difference -> Difference) -> \Prop :=
  (f: Difference -> Difference -> Difference) =>
    (x, y, u, v: Difference) -> Equivalent x y -> Equivalent u v -> Equivalent (f x u) (f y v);
\definition sameClassRelated: (C: \Power(Difference)) -> (x, y: Difference) ->
  C = ClassOf x -> C = ClassOf y -> Equivalent x y :=
  (C: \Power(Difference)) => (x, y: Difference) => (cx: C = ClassOf x) => (cy: C = ClassOf y) =>
    equivalentOfClassEq x y (trans!{\Power(Difference)} (ClassOf x) C (ClassOf y) (sym!{\Power(Difference)} C (ClassOf x) cx) cy);
\definition UnaryImage: (Difference -> Difference) -> \Power(Difference) -> \Power(Difference) :=
  (f: Difference -> Difference) => (C: \Power(Difference)) =>
    \Subset(z, Difference, (P: \Prop) ->
      ((x: Difference) -> C = ClassOf x -> Equivalent (f x) z -> P) -> P);
\definition unaryImageClass: (f: Difference -> Difference) -> UnaryRespects f ->
  (C: \Power(Difference)) -> (x: Difference) -> C = ClassOf x -> UnaryImage f C = ClassOf (f x) :=
  (f: Difference -> Difference) => (respects: UnaryRespects f) =>
    (C: \Power(Difference)) => (x: Difference) => (cx: C = ClassOf x) =>
      \axiom:setext(UnaryImage f C, ClassOf (f x),
        ((z: Difference) => (hz: \Pred(Difference, UnaryImage f C, z)) =>
          hz (Equivalent (f x) z)
            ((y: Difference) => (cy: C = ClassOf y) => (yz: Equivalent (f y) z) =>
              equivalentTrans (f x) (f y) z (respects x y (sameClassRelated C x y cx cy)) yz)),
        ((z: Difference) => (xz: Equivalent (f x) z) =>
          (P: \Prop) => (step: (y: Difference) -> C = ClassOf y -> Equivalent (f y) z -> P) => step x cx xz));
\definition unaryImageClosed: (f: Difference -> Difference) -> UnaryRespects f ->
  (C: Grothendieck) -> IsClass (UnaryImage f C) :=
  (f: Difference -> Difference) => (respects: UnaryRespects f) => (C: Grothendieck) =>
    classProperty C (IsClass (UnaryImage f C))
      ((x: Difference) => (cx: C = ClassOf x) =>
        (P: \Prop) => (step: (y: Difference) -> UnaryImage f C = ClassOf y -> P) =>
          step (f x) (unaryImageClass f respects C x cx));
\definition BinaryImage: (Difference -> Difference -> Difference) ->
  \Power(Difference) -> \Power(Difference) -> \Power(Difference) :=
  (f: Difference -> Difference -> Difference) => (C, D: \Power(Difference)) =>
    \Subset(z, Difference, (P: \Prop) ->
      ((x, y: Difference) -> C = ClassOf x -> D = ClassOf y -> Equivalent (f x y) z -> P) -> P);
\definition binaryImageClass: (f: Difference -> Difference -> Difference) -> BinaryRespects f ->
  (C, D: \Power(Difference)) -> (x, y: Difference) -> C = ClassOf x -> D = ClassOf y ->
  BinaryImage f C D = ClassOf (f x y) :=
  (f: Difference -> Difference -> Difference) => (respects: BinaryRespects f) =>
    (C, D: \Power(Difference)) => (x, y: Difference) => (cx: C = ClassOf x) => (dy: D = ClassOf y) =>
      \axiom:setext(BinaryImage f C D, ClassOf (f x y),
        ((z: Difference) => (hz: \Pred(Difference, BinaryImage f C D, z)) =>
          hz (Equivalent (f x y) z)
            ((u, v: Difference) => (cu: C = ClassOf u) => (dv: D = ClassOf v) => (uvz: Equivalent (f u v) z)
    =>
              equivalentTrans (f x y) (f u v) z
                (respects x u y v (sameClassRelated C x u cx cu) (sameClassRelated D y v dy dv)) uvz)),
        ((z: Difference) => (xyz: Equivalent (f x y) z) =>
          (P: \Prop) => (step: (u, v: Difference) -> C = ClassOf u -> D = ClassOf v -> Equivalent (f u v) z ->
    P) =>
            step x y cx dy xyz));
\definition binaryImageClosed: (f: Difference -> Difference -> Difference) -> BinaryRespects f ->
  (C, D: Grothendieck) -> IsClass (BinaryImage f C D) :=
  (f: Difference -> Difference -> Difference) => (respects: BinaryRespects f) => (C, D: Grothendieck) =>
    classProperty C (IsClass (BinaryImage f C D))
      ((x: Difference) => (cx: C = ClassOf x) =>
        classProperty D (IsClass (BinaryImage f C D))
          ((y: Difference) => (dy: D = ClassOf y) =>
            (P: \Prop) => (step: (z: Difference) -> BinaryImage f C D = ClassOf z -> P) =>
              step (f x y) (binaryImageClass f respects C D x y cx dy)));

/* Addition and multiplication use the formulas on formal differences. */
\definition addMath: Grothendieck -> Grothendieck -> Grothendieck := (C, D: Grothendieck) =>
  \subsetinto(\Power(Difference), ClassSet, BinaryImage addRep C D, binaryImageClosed addRep addRepRespects C
    D);
\definition negMath: Grothendieck -> Grothendieck := (C: Grothendieck) =>
  \subsetinto(\Power(Difference), ClassSet, UnaryImage negRep C, unaryImageClosed negRep negRepRespects C);
\definition mulMath: Grothendieck -> Grothendieck -> Grothendieck := (C, D: Grothendieck) =>
  \subsetinto(\Power(Difference), ClassSet, BinaryImage mulRep C D, binaryImageClosed mulRep mulRepRespects C
    D);
\definition subMath: Grothendieck -> Grothendieck -> Grothendieck := (x, y: Grothendieck) => addMath x
    (negMath y);
\definition addMathClass: (x, y: Difference) -> addMath (class x) (class y) = class (addRep x y) :=
  (x, y: Difference) => binaryImageClass addRep addRepRespects (class x) (class y) x y (\refl(ClassOf x))
    (\refl(ClassOf y));
\definition negMathClass: (x: Difference) -> negMath (class x) = class (negRep x) :=
  (x: Difference) => unaryImageClass negRep negRepRespects (class x) x (\refl(ClassOf x));
\definition mulMathClass: (x, y: Difference) -> mulMath (class x) (class y) = class (mulRep x y) :=
  (x, y: Difference) => binaryImageClass mulRep mulRepRespects (class x) (class y) x y (\refl(ClassOf x))
    (\refl(ClassOf y));
\definition addMathCongRight: (x, y, z: Grothendieck) -> y = z -> addMath x y = addMath x z :=
  (x, y, z: Grothendieck) => (e: y = z) =>
    (\idelim(y = z \with C: \Power(Difference) =>
      (hc: IsClass C) -> addMath x y = addMath x (\subsetinto(\Power(Difference), ClassSet, C, hc)))
      \by (((hc: IsClass y) => \refl(addMath x y)), e)) (classProperty z);
\definition subMathClass: (x, y: Difference) -> subMath (class x) (class y) = class (subRep x y) :=
  (x, y: Difference) => trans!{\Power(Difference)} (subMath (class x) (class y)) (addMath (class x) (class (negRep y))) (class
    (subRep x y))
    (addMathCongRight (class x) (negMath (class y)) (class (negRep y)) (negMathClass y))
    (addMathClass x (negRep y));
\definition addMatchesMath: (x, y: Int) -> toMath (addSet x y) = addMath (toMath x) (toMath y) :=
  (x, y: Int) => trans!{\Power(Difference)} (toMath (addSet x y)) (toMath (addPrec x y)) (addMath (toMath x) (toMath y))
    (toMathCong (addSet x y) (addPrec x y) (addMatchesPrec x y))
    (trans!{\Power(Difference)} (toMath (addPrec x y)) (class (addRep (representative x) (representative y))) (addMath (toMath
    x) (toMath y))
      (toFromClass (addRep (representative x) (representative y)))
      (sym!{\Power(Difference)} (addMath (toMath x) (toMath y)) (class (addRep (representative x) (representative y)))
    (addMathClass (representative x) (representative y))));
\definition negMatchesMath: (x: Int) -> toMath (negSet x) = negMath (toMath x) :=
  (x: Int) => trans!{\Power(Difference)} (toMath (negSet x)) (toMath (negPrec x)) (negMath (toMath x))
    (toMathCong (negSet x) (negPrec x) (negMatchesPrec x))
    (trans!{\Power(Difference)} (toMath (negPrec x)) (class (negRep (representative x))) (negMath (toMath x))
      (toFromClass (negRep (representative x)))
      (sym!{\Power(Difference)} (negMath (toMath x)) (class (negRep (representative x))) (negMathClass (representative x))));
\definition mulMatchesMath: (x, y: Int) -> toMath (mulSet x y) = mulMath (toMath x) (toMath y) :=
  (x, y: Int) => trans!{\Power(Difference)} (toMath (mulSet x y)) (toMath (mulPrec x y)) (mulMath (toMath x) (toMath y))
    (toMathCong (mulSet x y) (mulPrec x y) (mulMatchesPrec x y))
    (trans!{\Power(Difference)} (toMath (mulPrec x y)) (class (mulRep (representative x) (representative y))) (mulMath (toMath
    x) (toMath y))
      (toFromClass (mulRep (representative x) (representative y)))
      (sym!{\Power(Difference)} (mulMath (toMath x) (toMath y)) (class (mulRep (representative x) (representative y)))
    (mulMathClass (representative x) (representative y))));
\definition subMatchesMath: (x, y: Int) -> toMath (subSet x y) = subMath (toMath x) (toMath y) :=
  (x, y: Int) => trans!{\Power(Difference)} (toMath (subSet x y)) (addMath (toMath x) (toMath (negSet y))) (subMath (toMath x)
    (toMath y)) (addMatchesMath x (negSet y))
    (addMathCongRight (toMath x) (toMath (negSet y)) (negMath (toMath y)) (negMatchesMath y));

\definition roundTripArg: (x: Int) -> x = fromMath (toMath x) :=
  (x: Int) => sym!{Int} (fromMath (toMath x)) x (fromTo x);

/* Transport a specification across the proved isomorphism once per signature. */
\definition agreementII: (f, g: Int -> Int) -> ((a0: Int) -> f a0 = g a0) -> (a0: Int) -> toMath (f a0) =
    toMath (g (fromMath (toMath a0))) :=
  (f, g: Int -> Int) => (matches: (a0: Int) -> f a0 = g a0) => (a0: Int) =>
    toMathCong (f a0) (g (fromMath (toMath a0))) (trans!{Int} (f a0) (g a0) (g (fromMath (toMath a0))) (matches a0) (congr!{Int Int} g a0 (fromMath (toMath a0)) (roundTripArg a0)));

\definition agreementIN: (f, g: Int -> N.Nat) -> ((a0: Int) -> f a0 = g a0) -> (a0: Int) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  (f, g: Int -> N.Nat) => (matches: (a0: Int) -> f a0 = g a0) => (a0: Int) =>
    trans!{N.Nat} (f a0) (g a0) (g (fromMath (toMath a0))) (matches a0) (congr!{Int N.Nat} g a0 (fromMath (toMath a0)) (roundTripArg a0));

\definition agreementIB: (f, g: Int -> B.Bool) -> ((a0: Int) -> f a0 = g a0) -> (a0: Int) -> (f a0) = (g
    (fromMath (toMath a0))) :=
  (f, g: Int -> B.Bool) => (matches: (a0: Int) -> f a0 = g a0) => (a0: Int) =>
    trans!{B.Bool} (f a0) (g a0) (g (fromMath (toMath a0))) (matches a0) (congr!{Int B.Bool} g a0 (fromMath (toMath a0)) (roundTripArg a0));

\definition agreementIIB: (f, g: Int -> Int -> B.Bool) -> ((a0: Int) -> (a1: Int) -> f a0 a1 = g a0 a1) ->
    (a0: Int) -> (a1: Int) -> (f a0 a1) = (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  (f, g: Int -> Int -> B.Bool) => (matches: (a0: Int) -> (a1: Int) -> f a0 a1 = g a0 a1) => (a0: Int) => (a1: Int) =>
    trans!{B.Bool} (f a0 a1) (g a0 a1) (g (fromMath (toMath a0)) (fromMath (toMath a1))) (matches a0 a1) (congr2!{Int Int B.Bool} g a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1)) (roundTripArg a0) (roundTripArg a1));

\definition agreementIII: (f, g: Int -> Int -> Int) -> ((a0: Int) -> (a1: Int) -> f a0 a1 = g a0 a1) -> (a0:
    Int) -> (a1: Int) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) (fromMath (toMath a1))) :=
  (f, g: Int -> Int -> Int) => (matches: (a0: Int) -> (a1: Int) -> f a0 a1 = g a0 a1) => (a0: Int) => (a1: Int) =>
    toMathCong (f a0 a1) (g (fromMath (toMath a0)) (fromMath (toMath a1))) (trans!{Int} (f a0 a1) (g a0 a1) (g (fromMath (toMath a0)) (fromMath (toMath a1))) (matches a0 a1) (congr2!{Int Int Int} g a0 (fromMath (toMath a0)) a1 (fromMath (toMath a1)) (roundTripArg a0) (roundTripArg a1)));

\definition agreementINI: (f, g: Int -> N.Nat -> Int) -> ((a0: Int) -> (a1: N.Nat) -> f a0 a1 = g a0 a1) ->
    (a0: Int) -> (a1: N.Nat) -> toMath (f a0 a1) = toMath (g (fromMath (toMath a0)) a1) :=
  (f, g: Int -> N.Nat -> Int) => (matches: (a0: Int) -> (a1: N.Nat) -> f a0 a1 = g a0 a1) => (a0: Int) => (a1: N.Nat) =>
    toMathCong (f a0 a1) (g (fromMath (toMath a0)) a1) (trans!{Int} (f a0 a1) (g a0 a1) (g (fromMath (toMath a0)) a1) (matches a0 a1) (congr!{Int Int} ((z: Int) => g z a1) a0 (fromMath (toMath a0)) (roundTripArg a0)));

\definition agreementBIII: (f, g: B.Bool -> Int -> Int -> Int) -> ((a0: B.Bool) -> (a1: Int) -> (a2: Int) -> f
    a0 a1 a2 = g a0 a1 a2) -> (a0: B.Bool) -> (a1: Int) -> (a2: Int) -> toMath (f a0 a1 a2) = toMath (g a0
    (fromMath (toMath a1)) (fromMath (toMath a2))) :=
  (f, g: B.Bool -> Int -> Int -> Int) => (matches: (a0: B.Bool) -> (a1: Int) -> (a2: Int) -> f a0 a1 a2 = g a0 a1 a2) => (a0: B.Bool) => (a1: Int) => (a2: Int) =>
    toMathCong (f a0 a1 a2) (g a0 (fromMath (toMath a1)) (fromMath (toMath a2))) (trans!{Int} (f a0 a1 a2) (g a0 a1 a2) (g a0 (fromMath (toMath a1)) (fromMath (toMath a2))) (matches a0 a1 a2) (congr3!{B.Bool Int Int Int} g a0 a0 a1 (fromMath (toMath a1)) a2 (fromMath (toMath a2)) (\refl(a0)) (roundTripArg a1) (roundTripArg a2)));

/* Auxiliary operations on the quotient use its unique normal form. */
\definition ofNatMath: N.Nat -> Grothendieck :=
  (n: N.Nat) => toMath (ofNatPrec n);

\definition ofNatMatchesMath: (n: N.Nat) -> toMath (ofNatSet n) = ofNatMath n :=
  (n: N.Nat) => toMathCong (ofNatSet n) (ofNatPrec n) (ofNatMatchesPrec n);

\definition negOfNatMath: N.Nat -> Grothendieck :=
  (n: N.Nat) => toMath (negOfNatPrec n);

\definition negOfNatMatchesMath: (n: N.Nat) -> toMath (negOfNatSet n) = negOfNatMath n :=
  (n: N.Nat) => toMathCong (negOfNatSet n) (negOfNatPrec n) (negOfNatMatchesPrec n);

\definition succMath: Grothendieck -> Grothendieck :=
  (x: Grothendieck) => toMath (succPrec (fromMath x));

\definition succMatchesMath: (x: Int) -> toMath (succSet x) = succMath (toMath x) :=
  (x: Int) => agreementII succSet succPrec succMatchesPrec x;

\definition predMath: Grothendieck -> Grothendieck :=
  (x: Grothendieck) => toMath (predPrec (fromMath x));

\definition predMatchesMath: (x: Int) -> toMath (predSet x) = predMath (toMath x) :=
  (x: Int) => agreementII predSet predPrec predMatchesPrec x;

\definition natAbsMath: Grothendieck -> N.Nat :=
  (x: Grothendieck) => (natAbsPrec (fromMath x));

\definition natAbsMatchesMath: (x: Int) -> (natAbsSet x) = natAbsMath (toMath x) :=
  (x: Int) => agreementIN natAbsSet natAbsPrec natAbsMatchesPrec x;

\definition absMath: Grothendieck -> Grothendieck :=
  (x: Grothendieck) => toMath (absPrec (fromMath x));

\definition absMatchesMath: (x: Int) -> toMath (absSet x) = absMath (toMath x) :=
  (x: Int) => agreementII absSet absPrec absMatchesPrec x;

\definition isZeroMath: Grothendieck -> B.Bool :=
  (x: Grothendieck) => (isZeroPrec (fromMath x));

\definition isZeroMatchesMath: (x: Int) -> (isZeroSet x) = isZeroMath (toMath x) :=
  (x: Int) => agreementIB isZeroSet isZeroPrec isZeroMatchesPrec x;

\definition eqbMath: Grothendieck -> Grothendieck -> B.Bool :=
  (x: Grothendieck) => (y: Grothendieck) => (eqbPrec (fromMath x) (fromMath y));

\definition eqbMatchesMath: (x: Int) -> (y: Int) -> (eqbSet x y) = eqbMath (toMath x) (toMath y) :=
  (x: Int) => (y: Int) => agreementIIB eqbSet eqbPrec eqbMatchesPrec x y;

\definition lebMath: Grothendieck -> Grothendieck -> B.Bool :=
  (x: Grothendieck) => (y: Grothendieck) => (lebPrec (fromMath x) (fromMath y));

\definition lebMatchesMath: (x: Int) -> (y: Int) -> (lebSet x y) = lebMath (toMath x) (toMath y) :=
  (x: Int) => (y: Int) => agreementIIB lebSet lebPrec lebMatchesPrec x y;

\definition ltbMath: Grothendieck -> Grothendieck -> B.Bool :=
  (x: Grothendieck) => (y: Grothendieck) => (ltbPrec (fromMath x) (fromMath y));

\definition ltbMatchesMath: (x: Int) -> (y: Int) -> (ltbSet x y) = ltbMath (toMath x) (toMath y) :=
  (x: Int) => (y: Int) => agreementIIB ltbSet ltbPrec ltbMatchesPrec x y;

\definition minMath: Grothendieck -> Grothendieck -> Grothendieck :=
  (x: Grothendieck) => (y: Grothendieck) => toMath (minPrec (fromMath x) (fromMath y));

\definition minMatchesMath: (x: Int) -> (y: Int) -> toMath (minSet x y) = minMath (toMath x) (toMath y) :=
  (x: Int) => (y: Int) => agreementIII minSet minPrec minMatchesPrec x y;

\definition maxMath: Grothendieck -> Grothendieck -> Grothendieck :=
  (x: Grothendieck) => (y: Grothendieck) => toMath (maxPrec (fromMath x) (fromMath y));

\definition maxMatchesMath: (x: Int) -> (y: Int) -> toMath (maxSet x y) = maxMath (toMath x) (toMath y) :=
  (x: Int) => (y: Int) => agreementIII maxSet maxPrec maxMatchesPrec x y;

\definition signMath: Grothendieck -> Grothendieck :=
  (x: Grothendieck) => toMath (signPrec (fromMath x));

\definition signMatchesMath: (x: Int) -> toMath (signSet x) = signMath (toMath x) :=
  (x: Int) => agreementII signSet signPrec signMatchesPrec x;

\definition evenMath: Grothendieck -> B.Bool :=
  (x: Grothendieck) => (evenPrec (fromMath x));

\definition evenMatchesMath: (x: Int) -> (evenSet x) = evenMath (toMath x) :=
  (x: Int) => agreementIB evenSet evenPrec evenMatchesPrec x;

\definition oddMath: Grothendieck -> B.Bool :=
  (x: Grothendieck) => (oddPrec (fromMath x));

\definition oddMatchesMath: (x: Int) -> (oddSet x) = oddMath (toMath x) :=
  (x: Int) => agreementIB oddSet oddPrec oddMatchesPrec x;

\definition powMath: Grothendieck -> N.Nat -> Grothendieck :=
  (x: Grothendieck) => (n: N.Nat) => toMath (powPrec (fromMath x) n);

\definition powMatchesMath: (x: Int) -> (n: N.Nat) -> toMath (powSet x n) = powMath (toMath x) n :=
  (x: Int) => (n: N.Nat) => agreementINI powSet powPrec powMatchesPrec x n;

\definition positiveMath: Grothendieck -> N.Nat :=
  (x: Grothendieck) => (positivePrec (fromMath x));

\definition positiveMatchesMath: (x: Int) -> (positiveSet x) = positiveMath (toMath x) :=
  (x: Int) => agreementIN positiveSet positivePrec positiveMatchesPrec x;

\definition negativeMath: Grothendieck -> N.Nat :=
  (x: Grothendieck) => (negativePrec (fromMath x));

\definition negativeMatchesMath: (x: Int) -> (negativeSet x) = negativeMath (toMath x) :=
  (x: Int) => agreementIN negativeSet negativePrec negativeMatchesPrec x;

\definition chooseMath: B.Bool -> Grothendieck -> Grothendieck -> Grothendieck :=
  (test: B.Bool) => (yes: Grothendieck) => (no: Grothendieck) => toMath (choosePrec test (fromMath yes)
    (fromMath no));

\definition chooseMatchesMath: (test: B.Bool) -> (yes: Int) -> (no: Int) -> toMath (chooseSet test yes no) =
    chooseMath test (toMath yes) (toMath no) :=
  (test: B.Bool) => (yes: Int) => (no: Int) => agreementBIII chooseSet choosePrec chooseMatchesPrec test yes
    no;

\definition zeroMath: Grothendieck := toMath zeroPrec;
\definition zeroMatchesMath: toMath zeroSet = zeroMath := toMathCong zeroSet zeroPrec zeroMatchesPrec;

\definition oneMath: Grothendieck := toMath onePrec;
\definition oneMatchesMath: toMath oneSet = oneMath := toMathCong oneSet onePrec oneMatchesPrec;

\definition minusOneMath: Grothendieck := toMath minusOnePrec;
\definition minusOneMatchesMath: toMath minusOneSet = minusOneMath := toMathCong minusOneSet minusOnePrec
    minusOneMatchesPrec;

\definition diffMath: N.Nat -> N.Nat -> Grothendieck := (a, b: N.Nat) => class (pair a b);
\definition diffMatchesMath: (a, b: N.Nat) -> toMath (diffSet a b) = diffMath a b :=
  (a, b: N.Nat) => trans!{\Power(Difference)} (toMath (diffSet a b)) (toMath (diffPrec a b)) (class (pair a b))
    (toMathCong (diffSet a b) (diffPrec a b) (diffMatchesPrec b a)) (toFromClass (pair a b));
\definition Le: Int -> Int -> \Prop := (x, y: Int) => lebSet x y = B.Bool::true;
\definition Lt: Int -> Int -> \Prop := (x, y: Int) => ltbSet x y = B.Bool::true;
\definition LeMath: Grothendieck -> Grothendieck -> \Prop := (x, y: Grothendieck) => lebMath x y =
    B.Bool::true;
\definition LtMath: Grothendieck -> Grothendieck -> \Prop := (x, y: Grothendieck) => ltbMath x y =
    B.Bool::true;

/* Elimination out of the quotient only uses unique-value take. */
\definition mathInduction: (P: Grothendieck -> \Prop) ->
  ((x: Difference) -> P (class x)) -> (C: Grothendieck) -> P C :=
  (P: Grothendieck -> \Prop) => (step: (x: Difference) -> P (class x)) => (C: Grothendieck) =>
    \take (x: \Ty(Difference, Representatives C)) =>
      (\idelim(class x = C \with D: \Power(Difference) =>
        (hd: IsClass D) -> P (\subsetinto(\Power(Difference), ClassSet, D, hd)))
      \by (((hd: IsClass (class x)) => step x),
        \idelim(C = ClassOf x \with D: \Power(Difference) => D = C)
          \by (\refl(C), \bysub(Difference, Representatives C, x)))) (classProperty C)
    \by (representativesExist C);
\definition addMathCongLeft: (x, y, z: Grothendieck) -> x = y -> addMath x z = addMath y z :=
  (x, y, z: Grothendieck) => (e: x = y) =>
    (\idelim(x = y \with C: \Power(Difference) =>
      (hc: IsClass C) -> addMath x z = addMath (\subsetinto(\Power(Difference), ClassSet, C, hc)) z)
      \by (((hc: IsClass x) => \refl(addMath x z)), e)) (classProperty y);
\definition addRepComm: (x, y: Difference) -> Equivalent (addRep x y) (addRep y x) :=
  (x, y: Difference) => equivalentOfFields (addRep x y) (addRep y x)
    (N.addComm (pos x) (pos y)) (N.addComm (negPart x) (negPart y));
\definition addRepAssoc: (x, y, z: Difference) -> Equivalent (addRep (addRep x y) z) (addRep x (addRep y z))
    :=
  (x, y, z: Difference) => equivalentOfFields (addRep (addRep x y) z) (addRep x (addRep y z))
    (N.addAssoc (pos x) (pos y) (pos z)) (N.addAssoc (negPart x) (negPart y) (negPart z));
\definition addMathZeroLeft: (x: Grothendieck) -> addMath zeroMath x = x :=
  mathInduction ((x: Grothendieck) => addMath zeroMath x = x)
    ((x: Difference) => trans!{\Power(Difference)} _ _ _ (addMathClass (pair N.Nat::zero N.Nat::zero) x)
      (classOfEq (addRep (pair N.Nat::zero N.Nat::zero) x) x
        (equivalentOfFields (addRep (pair N.Nat::zero N.Nat::zero) x) x
          (N.addZeroLeft (pos x)) (N.addZeroLeft (negPart x)))));
\definition addMathComm: (x, y: Grothendieck) -> addMath x y = addMath y x :=
  mathInduction ((x: Grothendieck) => (y: Grothendieck) -> addMath x y = addMath y x)
    ((x: Difference) => mathInduction ((y: Grothendieck) => addMath (class x) y = addMath y (class x))
      ((y: Difference) => trans!{\Power(Difference)} _ _ _ (addMathClass x y)
        (trans!{\Power(Difference)} _ _ _ (classOfEq (addRep x y) (addRep y x) (addRepComm x y))
          (sym!{\Power(Difference)} _ _ (addMathClass y x)))));
\definition addMathZeroRight: (x: Grothendieck) -> addMath x zeroMath = x :=
  (x: Grothendieck) => trans!{\Power(Difference)} _ _ _ (addMathComm x zeroMath) (addMathZeroLeft x);
\definition addMathAssoc: (x, y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y z) :=
  mathInduction ((x: Grothendieck) => (y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y
    z))
    ((x: Difference) =>
      mathInduction ((y: Grothendieck) => (z: Grothendieck) ->
        addMath (addMath (class x) y) z = addMath (class x) (addMath y z))
        ((y: Difference) =>
          mathInduction ((z: Grothendieck) => addMath (addMath (class x) (class y)) z =
            addMath (class x) (addMath (class y) z))
            ((z: Difference) => trans!{\Power(Difference)} _ _ _
              (addMathCongLeft (addMath (class x) (class y)) (class (addRep x y)) (class z) (addMathClass x
    y))
              (trans!{\Power(Difference)} _ _ _ (addMathClass (addRep x y) z)
                (trans!{\Power(Difference)} _ _ _ (classOfEq (addRep (addRep x y) z) (addRep x (addRep y z)) (addRepAssoc x y
    z))
                  (trans!{\Power(Difference)} _ _ _ (sym!{\Power(Difference)} _ _ (addMathClass x (addRep y z)))
                    (addMathCongRight (class x) (class (addRep y z)) (addMath (class y) (class z))
                      (sym!{\Power(Difference)} _ _ (addMathClass y z)))))))));
\definition negMathInverse: (x: Grothendieck) -> addMath (negMath x) x = zeroMath :=
  mathInduction ((x: Grothendieck) => addMath (negMath x) x = zeroMath)
    ((x: Difference) => trans!{\Power(Difference)} _ _ _
      (addMathCongLeft (negMath (class x)) (class (negRep x)) (class x) (negMathClass x))
      (trans!{\Power(Difference)} _ _ _ (addMathClass (negRep x) x)
        (classOfEq (addRep (negRep x) x) (pair N.Nat::zero N.Nat::zero)
          (trans!{N.Nat} _ _ _ (N.addComm (negPart x) (pos x))
            (sym!{N.Nat} _ _ (N.addZeroLeft (N.addSet (pos x) (negPart x))))))));
\definition toMathInjective: (x, y: Int) -> toMath x = toMath y -> x = y :=
  (x, y: Int) => (e: toMath x = toMath y) =>
    trans!{Int} x (fromMath (toMath x)) y (sym!{Int} _ _ (fromTo x))
      ((\idelim(toMath y = toMath x \with C: \Power(Difference) =>
        (hc: IsClass C) -> fromMath (\subsetinto(\Power(Difference), ClassSet, C, hc)) = y)
        \by (((hc: IsClass (toMath y)) => fromTo y), sym!{\Power(Difference)} (toMath x) (toMath y) e))
        (classProperty (toMath x)));
\definition addComm: (x, y: Int) -> addSet x y = addSet y x :=
  (x, y: Int) => toMathInjective (addSet x y) (addSet y x)
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath x y)
      (trans!{\Power(Difference)} _ _ _ (addMathComm (toMath x) (toMath y)) (sym!{\Power(Difference)} _ _ (addMatchesMath y x))));
\definition addZeroLeft: (x: Int) -> addSet zeroSet x = x :=
  (x: Int) => toMathInjective (addSet zeroSet x) x
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath zeroSet x) (addMathZeroLeft (toMath x)));
\definition addZeroRight: (x: Int) -> addSet x zeroSet = x :=
  (x: Int) => trans!{Int} _ _ _ (addComm x zeroSet) (addZeroLeft x);
\definition negInverse: (x: Int) -> addSet (negSet x) x = zeroSet :=
  (x: Int) => toMathInjective (addSet (negSet x) x) zeroSet
    (trans!{\Power(Difference)} _ _ _ (addMatchesMath (negSet x) x)
      (trans!{\Power(Difference)} _ _ _ (addMathCongLeft (toMath (negSet x)) (negMath (toMath x)) (toMath x) (negMatchesMath
    x))
        (negMathInverse (toMath x))));
