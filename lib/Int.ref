  \bind v11: \U((N.Nat ~> \F(B.Bool))) <- (natLtb v5);
  \bind v13: B.Bool <- ((\force(v11)) v10);
  \return v13;
}))));
\definition ltbSet: Int -> Int -> B.Bool := \Force((Int ~> \F(\U((Int ~> \F(B.Bool))))), \box((Int ~> \F(\U((Int ~> \F(B.Bool))))), ltb));
\definition ltbPrec: Int -> Int -> B.Bool := \fun (x: Int) => \fun (y: Int) => (natLtbPrec (N.addSet (positivePrec x)
    (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)));
\definition ltbMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> ltbSet x y = ltbPrec x y :=
  \block {
    \fix (x, y: Int);
    \let leftMatches:
      N.addSet (positiveSet x) (negativeSet y) = N.addSet (positivePrec x) (negativePrec y) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet x) (positivePrec x) (negativeSet y) (negativePrec y)
        (positiveMatchesPrec x) (negativeMatchesPrec y);
    \let rightMatches:
      N.addSet (positiveSet y) (negativeSet x) = N.addSet (positivePrec y) (negativePrec x) :=
      congr2!{N.Nat N.Nat N.Nat} (N.addSet)
        (positiveSet y) (positivePrec y) (negativeSet x) (negativePrec x)
        (positiveMatchesPrec y) (negativeMatchesPrec x);
    \let argumentsMatch:
      natLtbSet (N.addSet (positiveSet x) (negativeSet y)) (N.addSet (positiveSet y) (negativeSet x)) =
      natLtbSet (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)) :=
      congr2!{N.Nat N.Nat B.Bool} (natLtbSet) _ _ _ _ leftMatches rightMatches;
    \return trans!{B.Bool} _ _ _ argumentsMatch
      (natLtbMatchesPrec
        (N.addSet (positivePrec x) (negativePrec y))
        (N.addSet (positivePrec y) (negativePrec x)));
  };

\cdefinition min: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => \block {
  \bind v1: \U((Int ~> \F(B.Bool))) <- (leb x);
  \bind v3: B.Bool <- ((\force(v1)) y);
  \bind v4: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v3);
  \bind v5: \U((Int ~> \F(Int))) <- ((\force(v4)) x);
  \bind v7: Int <- ((\force(v5)) y);
  \return v7;
}))));
\definition minSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), min));
\definition minPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (choosePrec (lebPrec x y) x y);
\definition minMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> minSet x y = minPrec x y :=
  \block {
    \fix (x, y: Int);
    \let argumentsMatch:
      chooseSet (lebSet x y) x y = chooseSet (lebPrec x y) x y :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        (lebSet x y) (lebPrec x y) x x y y
        (lebMatchesPrec x y) (\refl(x)) (\refl(y));
    \return trans!{Int} _ _ _ argumentsMatch (chooseMatchesPrec (lebPrec x y) x y);
  };

\cdefinition max: (Int ~> \F(\U((Int ~> \F(Int))))) := (\cfun (x: Int) => \return(\thunk((\cfun (y: Int) => \block {
  \bind v1: \U((Int ~> \F(B.Bool))) <- (leb x);
  \bind v3: B.Bool <- ((\force(v1)) y);
  \bind v4: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v3);
  \bind v5: \U((Int ~> \F(Int))) <- ((\force(v4)) y);
  \bind v7: Int <- ((\force(v5)) x);
  \return v7;
}))));
\definition maxSet: Int -> Int -> Int := \Force((Int ~> \F(\U((Int ~> \F(Int))))), \box((Int ~> \F(\U((Int ~> \F(Int))))), max));
\definition maxPrec: Int -> Int -> Int := \fun (x: Int) => \fun (y: Int) => (choosePrec (lebPrec x y) y x);
\definition maxMatchesPrec: \forall (x: Int) -> \forall (y: Int) -> maxSet x y = maxPrec x y :=
  \block {
    \fix (x, y: Int);
    \let argumentsMatch:
      chooseSet (lebSet x y) y x = chooseSet (lebPrec x y) y x :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        (lebSet x y) (lebPrec x y) y y x x
        (lebMatchesPrec x y) (\refl(y)) (\refl(x));
    \return trans!{Int} _ _ _ argumentsMatch (chooseMatchesPrec (lebPrec x y) y x);
  };

\cdefinition sign: (Int ~> \F(Int)) := (\cfun (x: Int) => \block {
  \bind v2: B.Bool <- (isZero x);
  \bind v4: N.Nat <- (negative x);
  \bind v6: B.Bool <- (natIsZero v4);
  \bind v7: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v6);
  \bind v8: \U((Int ~> \F(Int))) <- ((\force(v7)) ((Int::ofNat (N.Nat::succ N.Nat::zero))));
  \bind v10: Int <- ((\force(v8)) ((Int::negSucc N.Nat::zero)));
  \bind v11: \U((Int ~> \F(\U((Int ~> \F(Int)))))) <- (choose v2);
  \bind v12: \U((Int ~> \F(Int))) <- ((\force(v11)) ((Int::ofNat N.Nat::zero)));
  \bind v14: Int <- ((\force(v12)) v10);
  \return v14;
});
\definition signSet: Int -> Int := \Force((Int ~> \F(Int)), \box((Int ~> \F(Int)), sign));
\definition signPrec: Int -> Int := \fun (x: Int) => (choosePrec (isZeroPrec x) (Int::ofNat N.Nat::zero)
    (choosePrec (natIsZeroPrec (negativePrec x)) (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc
    N.Nat::zero)));
\definition signMatchesPrec: \forall (x: Int) -> signSet x = signPrec x :=
  \block {
    \fix (x: Int);
    \let negativeTestMatches:
      natIsZeroSet (negativeSet x) = natIsZeroPrec (negativePrec x) :=
      trans!{B.Bool} _ _ _
        (congr!{N.Nat B.Bool} (natIsZeroSet)
          (negativeSet x) (negativePrec x) (negativeMatchesPrec x))
        (natIsZeroMatchesPrec (negativePrec x));
    \let innerArgumentsMatch:
      chooseSet (natIsZeroSet (negativeSet x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) =
      chooseSet (natIsZeroPrec (negativePrec x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        (natIsZeroSet (negativeSet x)) (natIsZeroPrec (negativePrec x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::ofNat (N.Nat::succ N.Nat::zero))
        (Int::negSucc N.Nat::zero) (Int::negSucc N.Nat::zero)
        negativeTestMatches (\refl((Int::ofNat (N.Nat::succ N.Nat::zero))))
        (\refl((Int::negSucc N.Nat::zero)));
    \let innerMatches:
      chooseSet (natIsZeroSet (negativeSet x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) =
      choosePrec (natIsZeroPrec (negativePrec x))
        (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero) :=
      trans!{Int} _ _ _ innerArgumentsMatch
        (chooseMatchesPrec (natIsZeroPrec (negativePrec x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero));
    \let outerArgumentsMatch:
      chooseSet (isZeroSet x) (Int::ofNat N.Nat::zero)
        (chooseSet (natIsZeroSet (negativeSet x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)) =
      chooseSet (isZeroPrec x) (Int::ofNat N.Nat::zero)
        (choosePrec (natIsZeroPrec (negativePrec x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)) :=
      congr3!{B.Bool Int Int Int} (chooseSet)
        _ _ _ _ _ _ (isZeroMatchesPrec x)
        (\refl((Int::ofNat N.Nat::zero))) innerMatches;
    \return trans!{Int} _ _ _ outerArgumentsMatch
      (chooseMatchesPrec (isZeroPrec x) (Int::ofNat N.Nat::zero)
        (choosePrec (natIsZeroPrec (negativePrec x))
          (Int::ofNat (N.Nat::succ N.Nat::zero)) (Int::negSucc N.Nat::zero)));
  };

\cdefinition even: (Int ~> \F(B.Bool)) := (\cfun (x: Int) => \block {
  \bind v2: N.Nat <- (natAbs x);
  \bind v4: B.Bool <- (natEven v2);
  \return v4;
});
\definition evenSet: Int -> B.Bool := \Force((Int ~> \F(B.Bool)), \box((Int ~> \F(B.Bool)), even));
\definition evenPrec: Int -> B.Bool := \fun (x: Int) => (natEvenPrec (natAbsPrec x));
\definition evenMatchesPrec: \forall (x: Int) -> evenSet x = evenPrec x :=
  \fun (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natEvenSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natEvenMatchesPrec (natAbsPrec x));

\cdefinition odd: (Int ~> \F(B.Bool)) := (\cfun (x: Int) => \block {
  \bind v2: N.Nat <- (natAbs x);
  \bind v4: B.Bool <- (natOdd v2);
  \return v4;
});
\definition oddSet: Int -> B.Bool := \Force((Int ~> \F(B.Bool)), \box((Int ~> \F(B.Bool)), odd));
\definition oddPrec: Int -> B.Bool := \fun (x: Int) => (natOddPrec (natAbsPrec x));
\definition oddMatchesPrec: \forall (x: Int) -> oddSet x = oddPrec x :=
  \fun (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natOddSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natOddMatchesPrec (natAbsPrec x));

/* Apply a sign after computing the magnitude once. */
\cdefinition powerSign: (B.Bool ~> \F(\U((N.Nat ~> \F(Int))))) :=
  (\cfun (test: B.Bool) => \return(\thunk((\cfun (magnitude: N.Nat) => \match (test) \in B.Bool \with {
    | false => \return(Int::ofNat magnitude);
    | true => (negOfNat magnitude);
    }))));
\definition powerSignSet: B.Bool -> N.Nat -> Int :=
  \Force((B.Bool ~> \F(\U((N.Nat ~> \F(Int))))),
    \box((B.Bool ~> \F(\U((N.Nat ~> \F(Int))))), powerSign));
\definition powerSignPrec: B.Bool -> N.Nat -> Int := \fun (test: B.Bool) => \fun (magnitude: N.Nat) =>
  B.ite Int test (negOfNatPrec magnitude) (Int::ofNat magnitude);
\definition powerSignMatchesPrec: \forall (test: B.Bool) -> \forall (magnitude: N.Nat) ->
  powerSignSet test magnitude = powerSignPrec test magnitude :=
  \prec(\Prop, B.Bool) (\fun (test: B.Bool) => \forall (magnitude: N.Nat) ->
    powerSignSet test magnitude = powerSignPrec test magnitude)
    (\fun (magnitude: N.Nat) => \refl(Int::ofNat magnitude)) negOfNatMatchesPrec;
\cdefinition pow: (Int ~> \F(\U((N.Nat ~> \F(Int))))) :=
  (\cfun (x: Int) => \return(\thunk((\cfun (n: N.Nat) => \match (x) \in Int \with {
    | ofNat a => \block {
  \bind f: \U((N.Nat ~> \F(N.Nat))) <- (N.pow a);
  \bind magnitude: N.Nat <- ((\force(f)) n);
  \return Int::ofNat magnitude;
};
    | negSucc a => \block {
  \bind f: \U((N.Nat ~> \F(N.Nat))) <- (N.pow (N.Nat::succ a));
  \bind magnitude: N.Nat <- ((\force(f)) n);
  \bind test: B.Bool <- (natOdd n);
  \bind sign: \U((N.Nat ~> \F(Int))) <- (powerSign test);
  \bind result: Int <- ((\force(sign)) magnitude);
  \return result;
};
    }))));
\definition powSet: Int -> N.Nat -> Int :=
  \Force((Int ~> \F(\U((N.Nat ~> \F(Int))))),
    \box((Int ~> \F(\U((N.Nat ~> \F(Int))))), pow));
\definition powPrec: Int -> N.Nat -> Int :=
  \prec(\Set, Int) (\fun (x: Int) => N.Nat -> Int)
    (\fun (a, n: N.Nat) => Int::ofNat (N.powSet a n))
    (\fun (a, n: N.Nat) => powerSignPrec (natOddPrec n) (N.powSet (N.Nat::succ a) n));
\definition powerSignTestMatches: \forall (n, magnitude: N.Nat) ->
  powerSignSet (natOddSet n) magnitude = powerSignPrec (natOddPrec n) magnitude :=
  \fun (n, magnitude: N.Nat) =>
    \idelim(natOddSet n = natOddPrec n \with test: B.Bool =>
      powerSignSet (natOddSet n) magnitude = powerSignPrec test magnitude)
    \by (powerSignMatchesPrec (natOddSet n) magnitude, natOddMatchesPrec n);
\definition powMatchesPrec: \forall (x: Int) -> \forall (n: N.Nat) -> powSet x n = powPrec x n :=
  \prec(\Prop, Int) (\fun (x: Int) => \forall (n: N.Nat) -> powSet x n = powPrec x n)
    (\fun (a, n: N.Nat) => \refl(Int::ofNat (N.powSet a n)))
    (\fun (a, n: N.Nat) => powerSignTestMatches n (N.powSet (N.Nat::succ a) n));

\module Math;
