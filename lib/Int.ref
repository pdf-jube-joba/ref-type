\definition lebSet: Int -> Int -> B.Bool := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(B.Bool))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(B.Bool))))), leb));
\definition lebPrec: Int -> Int -> B.Bool := (x: Int) => (y: Int) => (natLebPrec (N.addSet (positivePrec x)
