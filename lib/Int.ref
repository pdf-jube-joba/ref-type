\import \root.Equality() \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.congr3;

/* Integers: Nat + Nat in Program, with negSucc n denoting -(n+1).
 * The mathematical carrier below is the Grothendieck quotient of (Nat,+,0).
 */
\import \root.Nat() \as N;
\import \root.Bool() \as B;
\import \root.Logic() \as L;
\import \root.Pair() \as P;

/* Expose the imported instances, including Program constructor notation. */
\definition Nat: \Set := N.Nat;
\definition Bool: \Set := B.Bool;
\macro natZero() := N.Nat::zero;
\macro natSucc($n) := N.Nat::succ $n;
\macro boolTrue() := B.Bool::true;
\macro boolFalse() := B.Bool::false;

\inductive Int: \VType :=
| ofNat: N.Nat -> Int;
| negSucc: N.Nat -> Int;
;

\inductive DiffState: \VType := | running: N.Nat -> N.Nat -> DiffState; ;
\vdefinition diffStep: \U(\CFun(DiffState, \F(\PRunStep(DiffState, Int)))) := \thunk(\clam(state, DiffState,
  \vcase(DiffState, state) { | running(a, b) =>
    \vcase(N.Nat, b) {
    | zero() => \return(\Pfinish(DiffState, Int, Int::ofNat a));
    | succ(k) => \vcase(N.Nat, a) {
      | zero() => \return(\Pfinish(DiffState, Int, Int::negSucc k));
      | succ(j) => \return(\Pcontinue(DiffState, Int, DiffState::running j k));
      };
    };
  }));
\definition diffStepSet: DiffState -> \RunStep(DiffState, Int) := \Force(\U(\CFun(DiffState,
    \F(\PRunStep(DiffState,
  Int)))), \box(\U(\CFun(DiffState, \F(\PRunStep(DiffState, Int)))), diffStep));
\definition diffReady: \RunStep(DiffState, Int) -> \Prop :=
  (t: \RunStep(DiffState, Int)) => \Pred(N.Nat,
    \runStepRec(DiffState, Int, ((t: \RunStep(DiffState, Int)) => \Power(N.Nat)),
      ((s: DiffState) => \Subset(n, N.Nat, \Acc(DiffState, Int, diffStepSet, s))),
      ((r: Int) => \Subset(n, N.Nat, N.Nat::zero = N.Nat::zero)), t), N.Nat::zero);
\definition diffAccIntro: (s: DiffState) -> diffReady (diffStepSet s) -> \Acc(DiffState, Int, diffStepSet, s)
    :=
  (s: DiffState) => (ready: diffReady (diffStepSet s)) =>
    \accintro(DiffState, Int, diffStepSet, s,
      (next: DiffState) => (edge: diffStepSet s = \continue(DiffState, Int, next)) =>
        \idelim(diffStepSet s = \continue(DiffState, Int, next)
          \with t: \RunStep(DiffState, Int) => diffReady t) \by (ready, edge));

\definition diffTerminates: (b, a: N.Nat) -> \Acc(DiffState, Int, diffStepSet, DiffState::running (a) (b)) :=
  \prec(\Prop, N.Nat) ((b: N.Nat) => (a: N.Nat) -> \Acc(DiffState, Int, diffStepSet, DiffState::running (a)
    (b)))
    (\prec(\Prop, N.Nat) ((a: N.Nat) => \Acc(DiffState, Int, diffStepSet, DiffState::running (a)
    (N.Nat::zero)))
      (diffAccIntro (DiffState::running N.Nat::zero N.Nat::zero) (\refl(N.Nat::zero))) ((j: N.Nat) => (unused:
      \Acc(DiffState, Int, diffStepSet, DiffState::running (j) (N.Nat::zero))) => diffAccIntro
    (DiffState::running
      (N.Nat::succ j) N.Nat::zero) (\refl(N.Nat::zero)))) ((k: N.Nat) => (ih: (a: N.Nat) -> \Acc(DiffState,
    Int,
      diffStepSet, DiffState::running (a) (k))) =>
      \prec(\Prop, N.Nat) ((a: N.Nat) => \Acc(DiffState, Int, diffStepSet, DiffState::running (a) (N.Nat::succ
    k)))
        (diffAccIntro (DiffState::running N.Nat::zero (N.Nat::succ k)) (\refl(N.Nat::zero)))
        ((j: N.Nat) => (unused: \Acc(DiffState, Int, diffStepSet, DiffState::running (j) (N.Nat::succ k))) =>
          diffAccIntro (DiffState::running (N.Nat::succ j) (N.Nat::succ k)) (ih j)));
\cdefinition diff: \CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(Int))))) := \clam(a, N.Nat, \return(\thunk(\clam(b,
    N.Nat,
  \Prun(DiffState, Int, diffStep, DiffState::running a b) \by diffTerminates b a))));
\definition diffSet: N.Nat -> N.Nat -> Int :=
  \Force(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(Int))))),
    \box(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(Int))))), diff));

/* A Set-only normal form, independent of Program reflection. */
\definition diffPrec: N.Nat -> N.Nat -> Int := (a, b: N.Nat) =>
  \prec(\Set, N.Nat) ((b: N.Nat) => N.Nat -> Int)
    ((a: N.Nat) => Int::ofNat a)
    ((k: N.Nat) => (rec: N.Nat -> Int) => (a: N.Nat) =>
      \prec(\Set, N.Nat) ((a: N.Nat) => Int) (Int::negSucc k)
        ((j: N.Nat) => (unused: Int) => rec j) a) b a;
\definition diffMatchesPrec: (b, a: N.Nat) -> diffSet a b = diffPrec a b :=
  \prec(\Prop, N.Nat) ((b: N.Nat) => (a: N.Nat) -> diffSet a b = diffPrec a b)
    (\prec(\Prop, N.Nat) ((a: N.Nat) => diffSet a N.Nat::zero = diffPrec a N.Nat::zero)
      (\refl(Int::ofNat N.Nat::zero))
      ((a: N.Nat) => (ih: diffSet a N.Nat::zero = diffPrec a N.Nat::zero) => \refl(Int::ofNat (N.Nat::succ
    a))))
    ((b: N.Nat) => (ih: (a: N.Nat) -> diffSet a b = diffPrec a b) =>
      \prec(\Prop, N.Nat) ((a: N.Nat) => diffSet a (N.Nat::succ b) = diffPrec a (N.Nat::succ b))
        (\refl(Int::negSucc b))
        ((a: N.Nat) => (unused: diffSet a (N.Nat::succ b) = diffPrec a (N.Nat::succ b)) => ih a));

\cdefinition positive: \CFun(Int, \F(N.Nat)) := \clam(z, Int,
  \vcase(Int, z) { | ofNat(n) => \return(n); | negSucc(n) => \return(N.Nat::zero); });
\definition positiveSet: Int -> N.Nat :=
  \Force(\CFun(Int, \F(N.Nat)), \box(\CFun(Int, \F(N.Nat)), positive));
\definition positivePrec: Int -> N.Nat := \prec(\Set, Int) ((z: Int) => N.Nat)
  ((n: N.Nat) => n) ((n: N.Nat) => N.Nat::zero);
\definition positiveMatchesPrec: (z: Int) -> positiveSet z = positivePrec z :=
  \prec(\Prop, Int) ((z: Int) => positiveSet z = positivePrec z)
    ((n: N.Nat) => \refl(n)) ((n: N.Nat) => \refl(N.Nat::zero));

\cdefinition negative: \CFun(Int, \F(N.Nat)) := \clam(z, Int,
  \vcase(Int, z) { | ofNat(n) => \return(N.Nat::zero); | negSucc(n) => \return(N.Nat::succ n); });
\definition negativeSet: Int -> N.Nat :=
  \Force(\CFun(Int, \F(N.Nat)), \box(\CFun(Int, \F(N.Nat)), negative));
\definition negativePrec: Int -> N.Nat := \prec(\Set, Int) ((z: Int) => N.Nat)
  ((n: N.Nat) => N.Nat::zero) ((n: N.Nat) => N.Nat::succ n);
\definition negativeMatchesPrec: (z: Int) -> negativeSet z = negativePrec z :=
  \prec(\Prop, Int) ((z: Int) => negativeSet z = negativePrec z)
    ((n: N.Nat) => \refl(N.Nat::zero)) ((n: N.Nat) => \refl(N.Nat::succ n));

\definition diffCanonical: (z: Int) -> diffPrec (positivePrec z) (negativePrec z) = z :=
  \prec(\Prop, Int) ((z: Int) => diffPrec (positivePrec z) (negativePrec z) = z)
    ((n: N.Nat) => \refl(Int::ofNat n)) ((n: N.Nat) => \refl(Int::negSucc n));

/* Cancelling a common summand is the key to representative independence. */
\definition diffAddCommon: (k, a, b: N.Nat) ->
  diffPrec (N.addSet a k) (N.addSet b k) = diffPrec a b :=
  \prec(\Prop, N.Nat)
    ((k: N.Nat) => (a, b: N.Nat) -> diffPrec (N.addSet a k) (N.addSet b k) = diffPrec a b)
    ((a, b: N.Nat) => \refl(diffPrec a b))
    ((k: N.Nat) => (ih: (a, b: N.Nat) -> diffPrec (N.addSet a k) (N.addSet b k) = diffPrec a b) =>
      (a, b: N.Nat) => trans!{Int} _ _ _
        (congr!{N.Nat Int} ((x: N.Nat) => diffPrec x (N.addSet b (N.Nat::succ k))) _ _ (N.addSuccRight a k))
        (trans!{Int} _ _ _
          (congr!{N.Nat Int} (diffPrec (N.Nat::succ (N.addSet a k))) _ _ (N.addSuccRight b k)) (ih a b)));
\definition diffRespects: (a, b, c, d: N.Nat) ->
  N.addSet a d = N.addSet c b -> diffPrec a b = diffPrec c d :=
  (a, b, c, d: N.Nat) => (e: N.addSet a d = N.addSet c b) =>
    trans!{Int} _ _ _ (sym!{Int} _ _ (diffAddCommon d a b))
      (trans!{Int} _ _ _ (congr!{N.Nat Int} ((x: N.Nat) => diffPrec x (N.addSet b d)) _ _ e)
        (trans!{Int} _ _ _ (congr!{N.Nat Int} (diffPrec (N.addSet c b)) _ _ (N.addComm b d)) (diffAddCommon b c d)));

/* The normal form represents the original formal difference. */
\definition diffBalance: (b, a: N.Nat) ->
  N.addSet a (negativePrec (diffPrec a b)) = N.addSet (positivePrec (diffPrec a b)) b :=
  \prec(\Prop, N.Nat)
    ((b: N.Nat) => (a: N.Nat) ->
      N.addSet a (negativePrec (diffPrec a b)) = N.addSet (positivePrec (diffPrec a b)) b)
    ((a: N.Nat) => \refl(a))
    ((b: N.Nat) => (ih: (a: N.Nat) ->
      N.addSet a (negativePrec (diffPrec a b)) = N.addSet (positivePrec (diffPrec a b)) b) =>
      \prec(\Prop, N.Nat)
        ((a: N.Nat) => N.addSet a (negativePrec (diffPrec a (N.Nat::succ b))) =
          N.addSet (positivePrec (diffPrec a (N.Nat::succ b))) (N.Nat::succ b))
        (\refl(N.addSet N.Nat::zero (N.Nat::succ b)))
        ((a: N.Nat) => (unused: N.addSet a (negativePrec (diffPrec a (N.Nat::succ b))) =
          N.addSet (positivePrec (diffPrec a (N.Nat::succ b))) (N.Nat::succ b)) =>
          trans!{N.Nat} _ _ _ (N.addSuccLeft a (negativePrec (diffPrec a b)))
            (trans!{N.Nat} _ _ _ (N.succCong _ _ (ih a))
              (sym!{N.Nat} _ _ (N.addSuccRight (positivePrec (diffPrec a b)) b)))));

/* Formal differences in the cancellative commutative monoid (Nat,+,0). */
\definition Difference: \Set := P.Times[N.Nat, N.Nat];
\definition pair: N.Nat -> N.Nat -> Difference := P.pair N.Nat N.Nat;
\definition pos: Difference -> N.Nat := P.first N.Nat N.Nat;
\definition negPart: Difference -> N.Nat := P.second N.Nat N.Nat;
\definition Equivalent: Difference -> Difference -> \Prop := (x, y: Difference) =>
  N.addSet (pos x) (negPart y) = N.addSet (pos y) (negPart x);
\definition equivalentRefl: (x: Difference) -> Equivalent x x :=
  (x: Difference) => \refl(N.addSet (pos x) (negPart x));
\definition equivalentSym: (x, y: Difference) -> Equivalent x y -> Equivalent y x :=
  (x, y: Difference) => (e: Equivalent x y) => sym!{N.Nat} (N.addSet (pos x) (negPart y)) (N.addSet (pos y)
    (negPart x)) e;
\definition addShuffle: (a, b, c, d: N.Nat) ->
  N.addSet (N.addSet a b) (N.addSet c d) = N.addSet (N.addSet a d) (N.addSet c b) :=
  (a, b, c, d: N.Nat) => trans!{N.Nat} _ _ _ (N.addInterchange a b c d)
    (trans!{N.Nat} _ _ _ (congr!{N.Nat N.Nat} (N.addSet (N.addSet a c)) _ _ (N.addComm b d))
      (sym!{N.Nat} _ _ (N.addInterchange a d c b)));
\definition equivalentTrans: (x, y, z: Difference) ->
  Equivalent x y -> Equivalent y z -> Equivalent x z :=
  (x, y, z: Difference) => (xy: Equivalent x y) => (yz: Equivalent y z) =>
    N.addCancelRight (N.addSet (pos y) (negPart y)) (N.addSet (pos x) (negPart z)) (N.addSet (pos z) (negPart
    x))
      (trans!{N.Nat} _ _ _ (addShuffle (pos x) (negPart z) (pos y) (negPart y))
        (trans!{N.Nat} _ _ _ (N.addCong (N.addSet (pos x) (negPart y)) (N.addSet (pos y) (negPart x))
          (N.addSet (pos y) (negPart z)) (N.addSet (pos z) (negPart y)) xy yz)
          (trans!{N.Nat} _ _ _ (N.addInterchange (pos y) (negPart x) (pos z) (negPart y))
            (trans!{N.Nat} _ _ _
              (congr!{N.Nat N.Nat} ((n: N.Nat) => N.addSet n (N.addSet (negPart x) (negPart y))) _ _
                (N.addComm (pos y) (pos z)))
              (sym!{N.Nat} _ _ (N.addInterchange (pos z) (negPart x) (pos y) (negPart y)))))));
\definition normalize: Difference -> Int := (x: Difference) => diffPrec (pos x) (negPart x);
\definition representative: Int -> Difference := (z: Int) => pair (positivePrec z) (negativePrec z);
\definition normalizeRespects: (x, y: Difference) -> Equivalent x y -> normalize x = normalize y :=
  (x, y: Difference) => diffRespects (pos x) (negPart x) (pos y) (negPart y);
\definition representativeNormalize: (x: Difference) -> Equivalent x (representative (normalize x)) :=
  (x: Difference) => diffBalance (negPart x) (pos x);
\definition equivalentOfNormalize: (x, y: Difference) -> normalize x = normalize y -> Equivalent x y :=
  (x, y: Difference) => (e: normalize x = normalize y) =>
    equivalentTrans x (representative (normalize x)) y (representativeNormalize x)
      (\idelim(normalize y = normalize x \with z: Int => Equivalent (representative z) y)
        \by (equivalentSym y (representative (normalize y)) (representativeNormalize y), sym!{Int} _ _ e));

/* Actual equivalence classes, not merely a setoid of representatives. */
\definition ClassOf: Difference -> \Power(Difference) :=
  (x: Difference) => \Subset(y, Difference, Equivalent x y);
\definition classOfEq: (x, y: Difference) -> Equivalent x y -> ClassOf x = ClassOf y :=
  (x, y: Difference) => (xy: Equivalent x y) =>
    \axiom:setext(ClassOf x, ClassOf y,
      ((z: Difference) => (xz: Equivalent x z) => equivalentTrans y x z (equivalentSym x y xy) xz),
      ((z: Difference) => (yz: Equivalent y z) => equivalentTrans x y z xy yz));
\definition equivalentOfClassEq: (x, y: Difference) -> ClassOf x = ClassOf y -> Equivalent x y :=
  (x, y: Difference) => (e: ClassOf x = ClassOf y) =>
    \idelim(ClassOf y = ClassOf x \with C: \Power(Difference) => \Pred(Difference, C, y))
      \by (equivalentRefl y,
        \idelim(ClassOf x = ClassOf y \with C: \Power(Difference) => C = ClassOf x)
          \by (\refl(ClassOf x), e));
\definition Representatives: \Power(Difference) -> \Power(Difference) :=
  (C: \Power(Difference)) => \Subset(x, Difference, C = ClassOf x);
\definition IsClass: \Power(Difference) -> \Prop :=
  (C: \Power(Difference)) => (P: \Prop) -> ((x: Difference) -> C = ClassOf x -> P) -> P;
\definition ClassSet: \Power(\Power(Difference)) := \Subset(C, \Power(Difference), IsClass C);
\definition Grothendieck: \Set := \Ty(\Power(Difference), ClassSet);
\definition class: Difference -> Grothendieck := (x: Difference) =>
  \subsetinto(\Power(Difference), ClassSet, ClassOf x,
    ((P: \Prop) => (step: (y: Difference) -> ClassOf x = ClassOf y -> P) => step x (\refl(ClassOf x))));
\definition toMath: Int -> Grothendieck := (z: Int) => class (representative z);
\definition classProperty: (C: Grothendieck) -> IsClass C :=
  (C: Grothendieck) => \bysub(\Power(Difference), ClassSet, C);
\definition representativesExist: (C: Grothendieck) -> \exists \Ty(Difference, Representatives C) :=
  (C: Grothendieck) => classProperty C (\exists \Ty(Difference, Representatives C))
    ((x: Difference) => (cx: C = ClassOf x) =>
      \exact(\subsetinto(Difference, Representatives C, x, cx), \Ty(Difference, Representatives C)));
\definition sameClassNormal: (C: \Power(Difference)) -> (x, y: Difference) ->
  C = ClassOf x -> C = ClassOf y -> normalize x = normalize y :=
  (C: \Power(Difference)) => (x, y: Difference) =>
    (cx: C = ClassOf x) => (cy: C = ClassOf y) =>
      normalizeRespects x y (equivalentOfClassEq x y
        (\idelim(C = ClassOf x \with D: \Power(Difference) => D = ClassOf y) \by (cy, cx)));
\definition normalFormsUnique: (C: Grothendieck) ->
  (x: \Ty(Difference, Representatives C)) -> (y: \Ty(Difference, Representatives C)) -> normalize x =
    normalize y :=
  (C: Grothendieck) => (x: \Ty(Difference, Representatives C)) => (y: \Ty(Difference, Representatives C)) =>
    sameClassNormal C x y (\bysub(Difference, Representatives C, x)) (\bysub(Difference, Representatives C,
    y));
\definition fromMath: Grothendieck -> Int := (C: Grothendieck) =>
  \take (x: \Ty(Difference, Representatives C)) => normalize x
    \by (representativesExist C, normalFormsUnique C);
\definition fromClass: (x: Difference) -> fromMath (class x) = normalize x :=
  (x: Difference) =>
    \takeelim((y: \Ty(Difference, Representatives (class x))) => normalize y,
      \subsetinto(Difference, Representatives (class x), x, \refl(ClassOf x)),
      \Ty(Difference, Representatives (class x)), Int)
    \by (representativesExist (class x), normalFormsUnique (class x));
\definition fromTo: (z: Int) -> fromMath (toMath z) = z :=
  (z: Int) => trans!{Int} _ _ _ (fromClass (representative z)) (diffCanonical z);
\definition toFromClass: (x: Difference) -> toMath (normalize x) = class x :=
  (x: Difference) => classOfEq (representative (normalize x)) x
    (equivalentSym x (representative (normalize x)) (representativeNormalize x));
\definition toFrom: (C: Grothendieck) -> toMath (fromMath C) = C :=
  (C: Grothendieck) =>
    \take (x: \Ty(Difference, Representatives C)) =>
      \idelim(ClassOf x = C \with D: \Power(Difference) => toMath (fromMath C) = D)
      \by (
        \idelim(normalize x = fromMath C \with z: Int => toMath z = ClassOf x)
          \by (toFromClass x,
            sym!{Int} _ _ (\takeelim((y: \Ty(Difference, Representatives C)) => normalize y,
              x, \Ty(Difference, Representatives C), Int)
              \by (representativesExist C, normalFormsUnique C))),
        \idelim(C = ClassOf x \with D: \Power(Difference) => D = C)
          \by (\refl(C), \bysub(Difference, Representatives C, x)))
    \by (representativesExist C);

/* Computational operations and their Set specifications use the certified
 * Nat arithmetic above. Every exported computation has a MatchesPrec theorem. */

\vdefinition zero: Int := (Int::ofNat N.Nat::zero);
\definition zeroSet: Int := \Force(Int, \box(Int, zero));
\definition zeroPrec: Int := (Int::ofNat N.Nat::zero);
\definition zeroMatchesPrec: zeroSet = zeroPrec := \refl((Int::ofNat N.Nat::zero));

\vdefinition one: Int := (Int::ofNat (N.Nat::succ N.Nat::zero));
\definition oneSet: Int := \Force(Int, \box(Int, one));
\definition onePrec: Int := (Int::ofNat (N.Nat::succ N.Nat::zero));
\definition oneMatchesPrec: oneSet = onePrec := \refl((Int::ofNat (N.Nat::succ N.Nat::zero)));

\vdefinition minusOne: Int := (Int::negSucc N.Nat::zero);
\definition minusOneSet: Int := \Force(Int, \box(Int, minusOne));
\definition minusOnePrec: Int := (Int::negSucc N.Nat::zero);
\definition minusOneMatchesPrec: minusOneSet = minusOnePrec := \refl((Int::negSucc N.Nat::zero));

/* Nat imports its own Bool instance. Convert its decisions through Nat.choose
 * so that Int consistently exposes the Bool instance imported here. */
\cdefinition natIsZero: \CFun(N.Nat, \F(B.Bool)) := \clam(n, N.Nat,
  \vcase(N.Nat, n) { | zero() => \return(B.Bool::true); | succ(k) => \return(B.Bool::false); });
\definition natIsZeroSet: N.Nat -> B.Bool :=
  \Force(\CFun(N.Nat, \F(B.Bool)), \box(\CFun(N.Nat, \F(B.Bool)), natIsZero));
\definition natIsZeroPrec: N.Nat -> B.Bool :=
  \prec(\Set, N.Nat) ((n: N.Nat) => B.Bool) B.Bool::true ((n: N.Nat) => (ih: B.Bool) => B.Bool::false);
\definition natIsZeroMatchesPrec: (n: N.Nat) -> natIsZeroSet n = natIsZeroPrec n :=
  \prec(\Prop, N.Nat) ((n: N.Nat) => natIsZeroSet n = natIsZeroPrec n)
    (\refl(B.Bool::true)) ((n: N.Nat) => (ih: natIsZeroSet n = natIsZeroPrec n) => \refl(B.Bool::false));

\cdefinition natEqb: \CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))) := \clam(a, N.Nat, \return(\thunk(\clam(b,
    N.Nat, \sequence(\sequence(\capp(N.eqb, a), f, _, \capp(\force(f), b)), test, _,
    \sequence(\capp(N.choose, test), yes, _,
      \sequence(\capp(\force(yes), N.Nat::zero), no, _,
        \sequence(\capp(\force(no), N.Nat::succ N.Nat::zero), number, N.Nat, \capp(natIsZero, number)))))))));
\definition natEqbSet: N.Nat -> N.Nat -> B.Bool := \Force(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))),
    \box(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))), natEqb));
\definition natEqbPrec: N.Nat -> N.Nat -> B.Bool := (a, b: N.Nat) => natIsZeroPrec (N.chooseSet (N.eqbSet a b)
    N.Nat::zero (N.Nat::succ N.Nat::zero));
\definition natEqbMatchesPrec: (a, b: N.Nat) -> natEqbSet a b = natEqbPrec a b :=
  (a, b: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.eqbSet a b) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natLeb: \CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))) := \clam(a, N.Nat, \return(\thunk(\clam(b,
    N.Nat, \sequence(\sequence(\capp(N.leb, a), f, _, \capp(\force(f), b)), test, _,
    \sequence(\capp(N.choose, test), yes, _,
      \sequence(\capp(\force(yes), N.Nat::zero), no, _,
        \sequence(\capp(\force(no), N.Nat::succ N.Nat::zero), number, N.Nat, \capp(natIsZero, number)))))))));
\definition natLebSet: N.Nat -> N.Nat -> B.Bool := \Force(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))),
    \box(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))), natLeb));
\definition natLebPrec: N.Nat -> N.Nat -> B.Bool := (a, b: N.Nat) => natIsZeroPrec (N.chooseSet (N.lebSet a b)
    N.Nat::zero (N.Nat::succ N.Nat::zero));
\definition natLebMatchesPrec: (a, b: N.Nat) -> natLebSet a b = natLebPrec a b :=
  (a, b: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.lebSet a b) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natLtb: \CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))) := \clam(a, N.Nat, \return(\thunk(\clam(b,
    N.Nat, \sequence(\sequence(\capp(N.ltb, a), f, _, \capp(\force(f), b)), test, _,
    \sequence(\capp(N.choose, test), yes, _,
      \sequence(\capp(\force(yes), N.Nat::zero), no, _,
        \sequence(\capp(\force(no), N.Nat::succ N.Nat::zero), number, N.Nat, \capp(natIsZero, number)))))))));
\definition natLtbSet: N.Nat -> N.Nat -> B.Bool := \Force(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))),
    \box(\CFun(N.Nat, \F(\U(\CFun(N.Nat, \F(B.Bool))))), natLtb));
\definition natLtbPrec: N.Nat -> N.Nat -> B.Bool := (a, b: N.Nat) => natIsZeroPrec (N.chooseSet (N.ltbSet a b)
    N.Nat::zero (N.Nat::succ N.Nat::zero));
\definition natLtbMatchesPrec: (a, b: N.Nat) -> natLtbSet a b = natLtbPrec a b :=
  (a, b: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.ltbSet a b) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natEven: \CFun(N.Nat, \F(B.Bool)) := \clam(a, N.Nat, \sequence(\capp(N.even, a), test, _,
    \sequence(\capp(N.choose, test), yes, _,
      \sequence(\capp(\force(yes), N.Nat::zero), no, _,
        \sequence(\capp(\force(no), N.Nat::succ N.Nat::zero), number, N.Nat, \capp(natIsZero, number))))));
\definition natEvenSet: N.Nat -> B.Bool := \Force(\CFun(N.Nat, \F(B.Bool)), \box(\CFun(N.Nat, \F(B.Bool)),
    natEven));
\definition natEvenPrec: N.Nat -> B.Bool := (a: N.Nat) => natIsZeroPrec (N.chooseSet (N.evenSet a) N.Nat::zero
    (N.Nat::succ N.Nat::zero));
\definition natEvenMatchesPrec: (a: N.Nat) -> natEvenSet a = natEvenPrec a :=
  (a: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.evenSet a) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition natOdd: \CFun(N.Nat, \F(B.Bool)) := \clam(a, N.Nat, \sequence(\capp(N.odd, a), test, _,
    \sequence(\capp(N.choose, test), yes, _,
      \sequence(\capp(\force(yes), N.Nat::zero), no, _,
        \sequence(\capp(\force(no), N.Nat::succ N.Nat::zero), number, N.Nat, \capp(natIsZero, number))))));
\definition natOddSet: N.Nat -> B.Bool := \Force(\CFun(N.Nat, \F(B.Bool)), \box(\CFun(N.Nat, \F(B.Bool)),
    natOdd));
\definition natOddPrec: N.Nat -> B.Bool := (a: N.Nat) => natIsZeroPrec (N.chooseSet (N.oddSet a) N.Nat::zero
    (N.Nat::succ N.Nat::zero));
\definition natOddMatchesPrec: (a: N.Nat) -> natOddSet a = natOddPrec a :=
  (a: N.Nat) => natIsZeroMatchesPrec (N.chooseSet (N.oddSet a) N.Nat::zero (N.Nat::succ N.Nat::zero));

\cdefinition choose: \CFun(B.Bool, \F(\U(\CFun(Int, \F(\U(\CFun(Int, \F(Int)))))))) :=
  \clam(test, B.Bool, \return(\thunk(\clam(yes, Int, \return(\thunk(\clam(no, Int,
    \vcase(B.Bool, test) { | false() => \return(no); | true() => \return(yes); })))))));
\definition chooseSet: B.Bool -> Int -> Int -> Int :=
  \Force(\CFun(B.Bool, \F(\U(\CFun(Int, \F(\U(\CFun(Int, \F(Int)))))))), \box(\CFun(B.Bool, \F(\U(\CFun(Int,
    \F(\U(\CFun(Int, \F(Int)))))))), choose));
\definition choosePrec: B.Bool -> Int -> Int -> Int := B.ite Int;
\definition chooseMatchesPrec: (test: B.Bool) -> (yes, no: Int) ->
  chooseSet test yes no = choosePrec test yes no :=
  \prec(\Prop, B.Bool) ((test: B.Bool) => (yes, no: Int) ->
    chooseSet test yes no = choosePrec test yes no)
    ((yes, no: Int) => \refl(no)) ((yes, no: Int) => \refl(yes));

\cdefinition ofNat: \CFun(N.Nat, \F(Int)) := \clam(n, N.Nat, \return((Int::ofNat n)));
\definition ofNatSet: N.Nat -> Int := \Force(\CFun(N.Nat, \F(Int)), \box(\CFun(N.Nat, \F(Int)), ofNat));
\definition ofNatPrec: N.Nat -> Int := (n: N.Nat) => (Int::ofNat n);
\definition ofNatMatchesPrec: (n: N.Nat) -> ofNatSet n = ofNatPrec n :=
  (n: N.Nat) => \refl((Int::ofNat n));

\cdefinition negOfNat: \CFun(N.Nat, \F(Int)) := \clam(n, N.Nat, \sequence(\Prun(DiffState, Int, diffStep,
    DiffState::running N.Nat::zero n) \by diffTerminates n N.Nat::zero, v1, Int, \return(v1)));
\definition negOfNatSet: N.Nat -> Int := \Force(\CFun(N.Nat, \F(Int)), \box(\CFun(N.Nat, \F(Int)), negOfNat));
\definition negOfNatPrec: N.Nat -> Int := (n: N.Nat) => (diffPrec N.Nat::zero n);
\definition negOfNatMatchesPrec: (n: N.Nat) -> negOfNatSet n = negOfNatPrec n :=
  (n: N.Nat) => diffMatchesPrec n N.Nat::zero;

\cdefinition neg: \CFun(Int, \F(Int)) := \clam(x, Int, \sequence(\capp(negative, x), v2, N.Nat,
    \sequence(\capp(positive, x), v4, N.Nat, \sequence(\Prun(DiffState, Int, diffStep, DiffState::running v2
    v4) \by diffTerminates v4 v2, v5, Int, \return(v5)))));
\definition negSet: Int -> Int := \Force(\CFun(Int, \F(Int)), \box(\CFun(Int, \F(Int)), neg));
\definition negPrec: Int -> Int := (x: Int) => (diffPrec (negativePrec x) (positivePrec x));
\definition negMatchesPrec: (x: Int) -> negSet x = negPrec x :=
  (x: Int) => trans!{Int} _ _ _ (congr2!{N.Nat N.Nat Int} (diffSet) (negativeSet x) (negativePrec x) (positiveSet x) (positivePrec
    x) (negativeMatchesPrec x) (positiveMatchesPrec x)) (diffMatchesPrec (positivePrec x) (negativePrec x));

\cdefinition add: \CFun(Int, \F(\U(\CFun(Int, \F(Int))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(positive, x), v2, N.Nat, \sequence(\capp(positive, y), v4, N.Nat,
    \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2, v5,
    N.Nat, \sequence(\capp(negative, x), v7, N.Nat, \sequence(\capp(negative, y), v9, N.Nat,
    \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 v9) \by N.addTerminates v9 v7, v10,
    N.Nat, \sequence(\Prun(DiffState, Int, diffStep, DiffState::running v5 v10) \by diffTerminates v10 v5,
    v11, Int, \return(v11))))))))))));
\definition addSet: Int -> Int -> Int := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(Int))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(Int))))), add));
\definition addPrec: Int -> Int -> Int := (x: Int) => (y: Int) => (diffPrec (N.addSet (positivePrec x)
    (positivePrec y)) (N.addSet (negativePrec x) (negativePrec y)));
\definition addMatchesPrec: (x: Int) -> (y: Int) -> addSet x y = addPrec x y :=
  (x: Int) => (y: Int) => trans!{Int} _ _ _ (congr2!{N.Nat N.Nat Int} (diffSet) (N.addSet (positiveSet x) (positiveSet y))
    (N.addSet (positivePrec x) (positivePrec y)) (N.addSet (negativeSet x) (negativeSet y)) (N.addSet
    (negativePrec x) (negativePrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet x) (positivePrec x) (positiveSet y)
    (positivePrec y) (positiveMatchesPrec x) (positiveMatchesPrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (negativeSet x)
    (negativePrec x) (negativeSet y) (negativePrec y) (negativeMatchesPrec x) (negativeMatchesPrec y)))
    (diffMatchesPrec (N.addSet (negativePrec x) (negativePrec y)) (N.addSet (positivePrec x) (positivePrec
    y)));

\cdefinition sub: \CFun(Int, \F(\U(\CFun(Int, \F(Int))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(neg, y), v2, Int, \sequence(\capp(add, x), v3, \U(\CFun(Int, \F(Int))),
    \sequence(\capp(\force(v3), v2), v5, Int, \return(v5))))))));
\definition subSet: Int -> Int -> Int := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(Int))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(Int))))), sub));
\definition subPrec: Int -> Int -> Int := (x: Int) => (y: Int) => (addPrec x (negPrec y));
\definition subMatchesPrec: (x: Int) -> (y: Int) -> subSet x y = subPrec x y :=
  (x: Int) => (y: Int) => trans!{Int} _ _ _ (congr2!{Int Int Int} (addSet) x x (negSet y) (negPrec y) (\refl(x))
    (negMatchesPrec y)) (addMatchesPrec x (negPrec y));

\cdefinition mul: \CFun(Int, \F(\U(\CFun(Int, \F(Int))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(positive, x), v2, N.Nat, \sequence(\capp(positive, y), v4, N.Nat,
    \sequence(\Prun(N.IterState, N.Nat, N.iterStep, N.IterState::running \thunk(\clam(current, N.Nat,
    \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 current) \by N.addTerminates current v2))
    N.Nat::zero v4) \by N.iterTerminates v4 (N.addSet v2) N.Nat::zero, v5, N.Nat, \sequence(\capp(negative,
    x), v7, N.Nat, \sequence(\capp(negative, y), v9, N.Nat, \sequence(\Prun(N.IterState, N.Nat, N.iterStep,
    N.IterState::running \thunk(\clam(current, N.Nat, \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running
    v7 current) \by N.addTerminates current v7)) N.Nat::zero v9) \by N.iterTerminates v9 (N.addSet v7)
    N.Nat::zero, v10, N.Nat, \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v5 v10) \by
    N.addTerminates v10 v5, v11, N.Nat, \sequence(\Prun(N.IterState, N.Nat, N.iterStep, N.IterState::running
    \thunk(\clam(current, N.Nat, \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 current) \by
    N.addTerminates current v2)) N.Nat::zero v9) \by N.iterTerminates v9 (N.addSet v2) N.Nat::zero, v12,
    N.Nat, \sequence(\Prun(N.IterState, N.Nat, N.iterStep, N.IterState::running \thunk(\clam(current, N.Nat,
    \Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 current) \by N.addTerminates current v7))
    N.Nat::zero v4) \by N.iterTerminates v4 (N.addSet v7) N.Nat::zero, v13, N.Nat, \sequence(\Prun(N.AddState,
    N.Nat, N.addStep, N.AddState::running v12 v13) \by N.addTerminates v13 v12, v14, N.Nat,
    \sequence(\Prun(DiffState, Int, diffStep, DiffState::running v11 v14) \by diffTerminates v14 v11, v15,
    Int, \return(v15))))))))))))))));
\definition mulSet: Int -> Int -> Int := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(Int))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(Int))))), mul));
\definition mulPrec: Int -> Int -> Int := (x: Int) => (y: Int) => (diffPrec (N.addSet (N.mulSet (positivePrec
    x) (positivePrec y)) (N.mulSet (negativePrec x) (negativePrec y))) (N.addSet (N.mulSet (positivePrec x)
    (negativePrec y)) (N.mulSet (negativePrec x) (positivePrec y))));
\definition mulMatchesPrec: (x: Int) -> (y: Int) -> mulSet x y = mulPrec x y :=
  (x: Int) => (y: Int) => trans!{Int} _ _ _ (congr2!{N.Nat N.Nat Int} (diffSet) (N.addSet (N.mulSet (positiveSet x) (positiveSet
    y)) (N.mulSet (negativeSet x) (negativeSet y))) (N.addSet (N.mulSet (positivePrec x) (positivePrec y))
    (N.mulSet (negativePrec x) (negativePrec y))) (N.addSet (N.mulSet (positiveSet x) (negativeSet y))
    (N.mulSet (negativeSet x) (positiveSet y))) (N.addSet (N.mulSet (positivePrec x) (negativePrec y))
    (N.mulSet (negativePrec x) (positivePrec y))) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (N.mulSet (positiveSet x) (positiveSet
    y)) (N.mulSet (positivePrec x) (positivePrec y)) (N.mulSet (negativeSet x) (negativeSet y)) (N.mulSet
    (negativePrec x) (negativePrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.mulSet) (positiveSet x) (positivePrec x) (positiveSet y)
    (positivePrec y) (positiveMatchesPrec x) (positiveMatchesPrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.mulSet) (negativeSet x)
    (negativePrec x) (negativeSet y) (negativePrec y) (negativeMatchesPrec x) (negativeMatchesPrec y)))
    (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (N.mulSet (positiveSet x) (negativeSet y)) (N.mulSet (positivePrec x) (negativePrec
    y)) (N.mulSet (negativeSet x) (positiveSet y)) (N.mulSet (negativePrec x) (positivePrec y)) (congr2!{N.Nat N.Nat N.Nat}
    (N.mulSet) (positiveSet x) (positivePrec x) (negativeSet y) (negativePrec y) (positiveMatchesPrec x)
    (negativeMatchesPrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.mulSet) (negativeSet x) (negativePrec x) (positiveSet y)
    (positivePrec y) (negativeMatchesPrec x) (positiveMatchesPrec y)))) (diffMatchesPrec (N.addSet (N.mulSet
    (positivePrec x) (negativePrec y)) (N.mulSet (negativePrec x) (positivePrec y))) (N.addSet (N.mulSet
    (positivePrec x) (positivePrec y)) (N.mulSet (negativePrec x) (negativePrec y))));

\cdefinition succ: \CFun(Int, \F(Int)) := \clam(x, Int, \sequence(\capp(add, x), v1, \U(\CFun(Int, \F(Int))),
    \sequence(\capp(\force(v1), (Int::ofNat (N.Nat::succ N.Nat::zero))), v3, Int, \return(v3))));
\definition succSet: Int -> Int := \Force(\CFun(Int, \F(Int)), \box(\CFun(Int, \F(Int)), succ));
\definition succPrec: Int -> Int := (x: Int) => (addPrec x (Int::ofNat (N.Nat::succ N.Nat::zero)));
\definition succMatchesPrec: (x: Int) -> succSet x = succPrec x :=
  (x: Int) => addMatchesPrec x (Int::ofNat (N.Nat::succ N.Nat::zero));

\cdefinition pred: \CFun(Int, \F(Int)) := \clam(x, Int, \sequence(\capp(sub, x), v1, \U(\CFun(Int, \F(Int))),
    \sequence(\capp(\force(v1), (Int::ofNat (N.Nat::succ N.Nat::zero))), v3, Int, \return(v3))));
\definition predSet: Int -> Int := \Force(\CFun(Int, \F(Int)), \box(\CFun(Int, \F(Int)), pred));
\definition predPrec: Int -> Int := (x: Int) => (subPrec x (Int::ofNat (N.Nat::succ N.Nat::zero)));
\definition predMatchesPrec: (x: Int) -> predSet x = predPrec x :=
  (x: Int) => subMatchesPrec x (Int::ofNat (N.Nat::succ N.Nat::zero));

\cdefinition natAbs: \CFun(Int, \F(N.Nat)) := \clam(x, Int, \sequence(\capp(positive, x), v2, N.Nat,
    \sequence(\capp(negative, x), v4, N.Nat, \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running
    v2 v4) \by N.addTerminates v4 v2, v5, N.Nat, \return(v5)))));
\definition natAbsSet: Int -> N.Nat := \Force(\CFun(Int, \F(N.Nat)), \box(\CFun(Int, \F(N.Nat)), natAbs));
\definition natAbsPrec: Int -> N.Nat := (x: Int) => (N.addSet (positivePrec x) (negativePrec x));
\definition natAbsMatchesPrec: (x: Int) -> natAbsSet x = natAbsPrec x :=
  (x: Int) => congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet x) (positivePrec x) (negativeSet x) (negativePrec x)
    (positiveMatchesPrec x) (negativeMatchesPrec x);

\cdefinition abs: \CFun(Int, \F(Int)) := \clam(x, Int, \sequence(\capp(natAbs, x), v2, N.Nat,
    \sequence(\capp(ofNat, v2), v4, Int, \return(v4))));
\definition absSet: Int -> Int := \Force(\CFun(Int, \F(Int)), \box(\CFun(Int, \F(Int)), abs));
\definition absPrec: Int -> Int := (x: Int) => (ofNatPrec (natAbsPrec x));
\definition absMatchesPrec: (x: Int) -> absSet x = absPrec x :=
  (x: Int) => trans!{Int} _ _ _ (congr!{N.Nat Int} (ofNatSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (ofNatMatchesPrec (natAbsPrec x));

\cdefinition isZero: \CFun(Int, \F(B.Bool)) := \clam(x, Int, \sequence(\capp(natAbs, x), v2, N.Nat,
    \sequence(\capp(natIsZero, v2), v4, B.Bool, \return(v4))));
\definition isZeroSet: Int -> B.Bool := \Force(\CFun(Int, \F(B.Bool)), \box(\CFun(Int, \F(B.Bool)), isZero));
\definition isZeroPrec: Int -> B.Bool := (x: Int) => (natIsZeroPrec (natAbsPrec x));
\definition isZeroMatchesPrec: (x: Int) -> isZeroSet x = isZeroPrec x :=
  (x: Int) => trans!{B.Bool} _ _ _ (congr!{N.Nat B.Bool} (natIsZeroSet) (natAbsSet x) (natAbsPrec x) (natAbsMatchesPrec x))
    (natIsZeroMatchesPrec (natAbsPrec x));

\cdefinition eqb: \CFun(Int, \F(\U(\CFun(Int, \F(B.Bool))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(positive, x), v2, N.Nat, \sequence(\capp(negative, y), v4, N.Nat,
    \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2, v5,
    N.Nat, \sequence(\capp(positive, y), v7, N.Nat, \sequence(\capp(negative, x), v9, N.Nat,
    \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v7 v9) \by N.addTerminates v9 v7, v10,
    N.Nat, \sequence(\capp(natEqb, v5), v11, \U(\CFun(N.Nat, \F(B.Bool))), \sequence(\capp(\force(v11), v10),
    v13, B.Bool, \return(v13)))))))))))));
\definition eqbSet: Int -> Int -> B.Bool := \Force(\CFun(Int, \F(\U(\CFun(Int, \F(B.Bool))))), \box(\CFun(Int,
    \F(\U(\CFun(Int, \F(B.Bool))))), eqb));
\definition eqbPrec: Int -> Int -> B.Bool := (x: Int) => (y: Int) => (natEqbPrec (N.addSet (positivePrec x)
    (negativePrec y)) (N.addSet (positivePrec y) (negativePrec x)));
\definition eqbMatchesPrec: (x: Int) -> (y: Int) -> eqbSet x y = eqbPrec x y :=
  (x: Int) => (y: Int) => trans!{B.Bool} _ _ _ (congr2!{N.Nat N.Nat B.Bool} (natEqbSet) (N.addSet (positiveSet x) (negativeSet y))
    (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positiveSet y) (negativeSet x)) (N.addSet
    (positivePrec y) (negativePrec x)) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet x) (positivePrec x) (negativeSet y)
    (negativePrec y) (positiveMatchesPrec x) (negativeMatchesPrec y)) (congr2!{N.Nat N.Nat N.Nat} (N.addSet) (positiveSet y)
    (positivePrec y) (negativeSet x) (negativePrec x) (positiveMatchesPrec y) (negativeMatchesPrec x)))
    (natEqbMatchesPrec (N.addSet (positivePrec x) (negativePrec y)) (N.addSet (positivePrec y) (negativePrec
    x)));

\cdefinition leb: \CFun(Int, \F(\U(\CFun(Int, \F(B.Bool))))) := \clam(x, Int, \return(\thunk(\clam(y, Int,
    \sequence(\capp(positive, x), v2, N.Nat, \sequence(\capp(negative, y), v4, N.Nat,
    \sequence(\Prun(N.AddState, N.Nat, N.addStep, N.AddState::running v2 v4) \by N.addTerminates v4 v2, v5,
