\import \root.Equality() \as Equality;
\use Equality.sym;

\definition field (s: AxiomaticRealStructure): FieldLaws s :=
  Logic.andLeft (FieldLaws s)
    (Logic.And[LinearOrderLaws s, Logic.And[OrderedFieldLaws s, Completeness s]]) (laws s);
\definition order (s: AxiomaticRealStructure): LinearOrderLaws s :=
  Logic.andLeft (LinearOrderLaws s) (Logic.And[OrderedFieldLaws s, Completeness s])
    (Logic.andRight (FieldLaws s)
      (Logic.And[LinearOrderLaws s, Logic.And[OrderedFieldLaws s, Completeness s]]) (laws s));
\definition compatible (s: AxiomaticRealStructure): OrderedFieldLaws s :=
  Logic.andLeft (OrderedFieldLaws s) (Completeness s)
    (Logic.andRight (LinearOrderLaws s) (Logic.And[OrderedFieldLaws s, Completeness s])
      (Logic.andRight (FieldLaws s)
        (Logic.And[LinearOrderLaws s, Logic.And[OrderedFieldLaws s, Completeness s]]) (laws s)));
\definition complete (s: AxiomaticRealStructure): Completeness s :=
  Logic.andRight (OrderedFieldLaws s) (Completeness s)
    (Logic.andRight (LinearOrderLaws s) (Logic.And[OrderedFieldLaws s, Completeness s])
      (Logic.andRight (FieldLaws s)
        (Logic.And[LinearOrderLaws s, Logic.And[OrderedFieldLaws s, Completeness s]]) (laws s)));

\definition leAntisym (s: AxiomaticRealStructure): Rel.Antisymmetric (Le s) :=
  Logic.andLeft (Rel.Antisymmetric (Le s)) (Rel.Total (Le s))
    (Logic.andRight (Rel.Transitive (Le s))
      (Logic.And[Rel.Antisymmetric (Le s), Rel.Total (Le s)])
      (Logic.andRight (Rel.Reflexive (Le s))
        (Logic.And[Rel.Transitive (Le s), Logic.And[Rel.Antisymmetric (Le s), Rel.Total (Le s)]]) (order s)));
\definition leastUpperBoundUnique (s: AxiomaticRealStructure) (A: \Power(Carrier)) (u, v: Carrier)
  (hu: IsLeastUpperBound s A u) (hv: IsLeastUpperBound s A v): u = v :=
  leAntisym s u v (lubLeast s A u hu v (lubUpper s A v hv))
    (lubLeast s A v hv u (lubUpper s A u hu));

\definition SupDomainSet (s: AxiomaticRealStructure): \Power(\Power(Carrier)) :=
  \Subset(A, \Power(Carrier), Logic.And[Inhabited A, BoundedAbove s A]);
\definition SupDomain (s: AxiomaticRealStructure): \Set :=
  \Ty(\Power(Carrier), SupDomainSet s);
\definition domainInhabited (s: AxiomaticRealStructure) (A: SupDomain s): Inhabited A :=
  Logic.andLeft (Inhabited A) (BoundedAbove s A) (\bysub(\Power(Carrier), SupDomainSet s, A));
\definition domainBounded (s: AxiomaticRealStructure) (A: SupDomain s): BoundedAbove s A :=
  Logic.andRight (Inhabited A) (BoundedAbove s A) (\bysub(\Power(Carrier), SupDomainSet s, A));
\definition Candidates (s: AxiomaticRealStructure) (A: \Power(Carrier)): \Set :=
  \Ty(Carrier, \Subset(u, Carrier, IsLeastUpperBound s A u));
\definition candidateLaw (s: AxiomaticRealStructure) (A: \Power(Carrier)) (u: Candidates s A):
  IsLeastUpperBound s A u := \bysub(Carrier, \Subset(u, Carrier, IsLeastUpperBound s A u), u);
\definition candidateValue (s: AxiomaticRealStructure) (A: \Power(Carrier)) (u: Candidates s A): Carrier := u;
\definition candidatesUnique (s: AxiomaticRealStructure) (A: \Power(Carrier)) (u, v: Candidates s A):
  candidateValue s A u = candidateValue s A v :=
  leastUpperBoundUnique s A u v (candidateLaw s A u) (candidateLaw s A v);
\definition supremum (s: AxiomaticRealStructure) (A: SupDomain s): Carrier :=
  \take (u: Candidates s A) => candidateValue s A u
  \by (complete s A (domainInhabited s A) (domainBounded s A), candidatesUnique s A);
\definition supremumLaw (s: AxiomaticRealStructure) (A: SupDomain s): IsLeastUpperBound s A (supremum s A) :=
  \take (u: Candidates s A) =>
    \idelim(candidateValue s A u = supremum s A \with v: Carrier => IsLeastUpperBound s A v)
      \by (candidateLaw s A u,
        sym!{Carrier} _ _
          (\takeelim(\fun (v: Candidates s A) => candidateValue s A v, u, Candidates s A, Carrier)
            \by (complete s A (domainInhabited s A) (domainBounded s A), candidatesUnique s A)))
  \by (complete s A (domainInhabited s A) (domainBounded s A));
