/* The templates above are checked here for arbitrary carriers, even when a
 * client uses only the macro interface. */
\definition sym: \forall (a, b: A) -> a = b -> b = a := sym!{A};
\definition trans: \forall (a, b, c: A) -> a = b -> b = c -> a = c := trans!{A};
\definition transport: \forall (P: A -> \Prop) -> \forall (a, b: A) -> a = b -> P a -> P b := transport!{A};

\module Functions(B: \Set) {
  \definition congr: \forall (f: A -> B) -> \forall (a, b: A) -> a = b -> f a = f b := congr!{A B};
}

\module Binary(B, C: \Set) {
  \definition congr: \forall (f: A -> B -> C) -> \forall (a, b: A) -> \forall (c, d: B) ->
    a = b -> c = d -> f a c = f b d := congr2!{A B C};
}

\module Ternary(B, C, D: \Set) {
  \definition congr: \forall (f: A -> B -> C -> D) -> \forall (a, b: A) -> \forall (c, d: B) -> \forall (e, g: C) ->
    a = b -> c = d -> e = g -> f a c e = f b d g := congr3!{A B C D};
}
