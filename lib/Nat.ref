/*
 * Natural numbers in the Program universe.
 *
 * Recursive computation is expressed as a certified state machine.  No PTS
 * primitive recursor is used: AddState::running transfers one successor from
 * the remaining operand to the accumulator on every run step.
 */
\inductive Nat: \VType :=
| zero: Nat;
| succ: Nat -> Nat;
;

\vdefinition zero: Nat := Nat::zero;
\vdefinition one: Nat := Nat::succ Nat::zero;

\inductive AddState: \VType :=
| running: Nat -> Nat -> AddState;
;

\vdefinition addStep:
  \U(\CFun(AddState, \F(\PRunStep(AddState, Nat)))) :=
  \thunk(\clam(state, AddState,
    \vcase(AddState, state) {
    | running(accumulator, remaining) =>
        \vcase(Nat, remaining) {
        | zero() =>
            \return(\Pfinish(AddState, Nat, accumulator));
        | succ(smaller) =>
            \return(\Pcontinue(
              AddState,
              Nat,
              AddState::running (Nat::succ accumulator) smaller));
        };
    }));

/* Program run is intentionally partial; totality is required only when a
 * computation crosses into Set through a box. */
\cdefinition add:
  \CFun(Nat, \F(\U(\CFun(Nat, \F(Nat))))) :=
  \clam(left, Nat,
    \return(\thunk(\clam(right, Nat,
      \Prun(
        AddState,
        Nat,
        addStep,
        AddState::running left right)))));
