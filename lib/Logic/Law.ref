/* Reusable laws for operations on one carrier. */
\definition BinaryOperation: \Set := Carrier -> Carrier -> Carrier;
\definition UnaryOperation: \Set := Carrier -> Carrier;

\definition Associative(op: BinaryOperation): \Prop :=
  \forall (x, y, z: Carrier) -> op (op x y) z = op x (op y z);

\definition Commutative(op: BinaryOperation): \Prop :=
  \forall (x, y: Carrier) -> op x y = op y x;

\definition Idempotent(op: BinaryOperation): \Prop :=
  \forall (x: Carrier) -> op x x = x;

\definition LeftUnital(op: BinaryOperation) (unit: Carrier): \Prop :=
  \forall (x: Carrier) -> op unit x = x;

\definition RightUnital(op: BinaryOperation) (unit: Carrier): \Prop :=
  \forall (x: Carrier) -> op x unit = x;

\record Unital(op: BinaryOperation, unit: Carrier): \Prop := {
  left: LeftUnital op unit,
  right: RightUnital op unit,
};

\definition LeftInvertible(op: BinaryOperation) (unit: Carrier)
  (inverse: UnaryOperation): \Prop :=
  \forall (x: Carrier) -> op (inverse x) x = unit;

\definition RightInvertible(op: BinaryOperation) (unit: Carrier)
  (inverse: UnaryOperation): \Prop :=
  \forall (x: Carrier) -> op x (inverse x) = unit;

\record Invertible(op: BinaryOperation, unit: Carrier,
  inverse: UnaryOperation): \Prop := {
  left: LeftInvertible op unit inverse,
  right: RightInvertible op unit inverse,
};

\definition LeftDistributive(over, under: BinaryOperation): \Prop :=
  \forall (x, y, z: Carrier) ->
    over x (under y z) = under (over x y) (over x z);

\definition RightDistributive(over, under: BinaryOperation): \Prop :=
  \forall (x, y, z: Carrier) ->
    over (under x y) z = under (over x z) (over y z);

\record Distributive(over, under: BinaryOperation): \Prop := {
  left: LeftDistributive over under,
  right: RightDistributive over under,
};

