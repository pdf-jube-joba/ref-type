/* Closures are intersections of all extensions having the requested law. */
\definition ReflexiveClosure(R: Relation) (x, y: Carrier): \Prop :=
  \forall (S: Relation) -> Subrelation R S -> Reflexive S -> S x y;

\definition SymmetricClosure(R: Relation) (x, y: Carrier): \Prop :=
  \forall (S: Relation) -> Subrelation R S -> Symmetric S -> S x y;

\definition TransitiveClosure(R: Relation) (x, y: Carrier): \Prop :=
  \forall (S: Relation) -> Subrelation R S -> Transitive S -> S x y;

\definition ReflexiveTransitiveClosure(R: Relation) (x, y: Carrier): \Prop :=
  \forall (S: Relation) -> Subrelation R S -> Reflexive S -> Transitive S -> S x y;

\definition EquivalenceClosure(R: Relation) (x, y: Carrier): \Prop :=
  \forall (S: Relation) -> Subrelation R S -> Reflexive S -> Symmetric S ->
    Transitive S -> S x y;

\definition reflexiveClosureOf(R: Relation) (x, y: Carrier) (edge: R x y)
  (S: Relation) (included: Subrelation R S) (reflexive: Reflexive S):
  S x y := included x y edge;

\definition reflexiveClosureRefl(R: Relation) (x: Carrier)
  (S: Relation) (included: Subrelation R S) (reflexive: Reflexive S):
  S x x := reflexive x;

\definition symmetricClosureOf(R: Relation) (x, y: Carrier) (edge: R x y)
  (S: Relation) (included: Subrelation R S) (symmetric: Symmetric S):
  S x y := included x y edge;

\definition symmetricClosureSym(R: Relation) (x, y: Carrier)
  (edge: SymmetricClosure R x y) (S: Relation)
  (included: Subrelation R S) (symmetric: Symmetric S): S y x :=
    symmetric x y (edge S included symmetric);

\definition transitiveClosureOf(R: Relation) (x, y: Carrier) (edge: R x y)
  (S: Relation) (included: Subrelation R S) (transitive: Transitive S):
  S x y := included x y edge;

\definition transitiveClosureTrans(R: Relation) (x, y, z: Carrier)
  (left: TransitiveClosure R x y) (right: TransitiveClosure R y z)
  (S: Relation) (included: Subrelation R S) (transitive: Transitive S):
  S x z :=
    transitive x y z (left S included transitive) (right S included transitive);

\definition reflexiveTransitiveClosureOf(R: Relation) (x, y: Carrier)
  (edge: R x y) (S: Relation) (included: Subrelation R S)
  (reflexive: Reflexive S) (transitive: Transitive S): S x y :=
    included x y edge;

\definition reflexiveTransitiveClosureRefl(R: Relation) (x: Carrier)
  (S: Relation) (included: Subrelation R S)
  (reflexive: Reflexive S) (transitive: Transitive S): S x x := reflexive x;

\definition reflexiveTransitiveClosureTrans(R: Relation) (x, y, z: Carrier)
  (left: ReflexiveTransitiveClosure R x y)
  (right: ReflexiveTransitiveClosure R y z)
  (S: Relation) (included: Subrelation R S)
  (reflexive: Reflexive S) (transitive: Transitive S): S x z :=
    transitive x y z
      (left S included reflexive transitive)
      (right S included reflexive transitive);
