/* Finite subsets are subsets generated from empty by finitely many inserts. */
\import \root.Logic[] \as Logic;

\definition Empty: \Power(A) :=
  \Subset(x, A, Logic.False);

\definition Insert(a: A) (X: \Power(A)): \Power(A) :=
  \Subset(x, A, Logic.Or[x = a, \Pred(A, X, x)]);

\definition Singleton(a: A): \Power(A) :=
  Insert a Empty;

/* This is {a, b}; it has at most two elements and collapses when a = b. */
\definition UnorderedPair(a, b: A): \Power(A) :=
  Insert a (Singleton b);

/* Church induction characterizes the least class containing Empty and closed
 * under Insert, without requiring a recursive indexed datatype. */
\definition Finite(X: \Power(A)): \Prop :=
  \forall (P: \Power(\Power(A))) ->
    \Pred(\Power(A), P, Empty) ->
    (\forall (Y: \Power(A)) -> \Pred(\Power(A), P, Y) ->
      \forall (a: A) -> \Pred(\Power(A), P, Insert a Y)) ->
    \Pred(\Power(A), P, X);

\definition finiteEmpty: Finite Empty :=
  \fun (P: \Power(\Power(A))) =>
  \fun (empty: \Pred(\Power(A), P, Empty)) =>
  \fun (insert: \forall (Y: \Power(A)) -> \Pred(\Power(A), P, Y) ->
    \forall (a: A) -> \Pred(\Power(A), P, Insert a Y)) => empty;

\definition finiteInsert(a: A) (X: \Power(A)) (finite: Finite X):
  Finite (Insert a X) :=
  \fun (P: \Power(\Power(A))) =>
  \fun (empty: \Pred(\Power(A), P, Empty)) =>
  \fun (insert: \forall (Y: \Power(A)) -> \Pred(\Power(A), P, Y) ->
    \forall (b: A) -> \Pred(\Power(A), P, Insert b Y)) =>
    insert X (finite P empty insert) a;

\definition FiniteSubsetSet: \Power(\Power(A)) :=
  \Subset(X, \Power(A), Finite X);

\definition FiniteSubset: \Set :=
  \Ty(\Power(A), FiniteSubsetSet);

\definition underlying(X: FiniteSubset): \Power(A) := X;

\definition finite(X: FiniteSubset): Finite (underlying X) :=
  \bysub(\Power(A), FiniteSubsetSet, X);

\definition induction:
  \forall (P: \Power(\Power(A))) ->
    \Pred(\Power(A), P, Empty) ->
    (\forall (Y: \Power(A)) -> \Pred(\Power(A), P, Y) ->
      \forall (a: A) -> \Pred(\Power(A), P, Insert a Y)) ->
    \forall (X: FiniteSubset) -> \Pred(\Power(A), P, underlying X) :=
  \fun (P: \Power(\Power(A))) =>
  \fun (empty: \Pred(\Power(A), P, Empty)) =>
  \fun (insert: \forall (Y: \Power(A)) -> \Pred(\Power(A), P, Y) ->
    \forall (a: A) -> \Pred(\Power(A), P, Insert a Y)) =>
  \fun (X: FiniteSubset) => finite X P empty insert;

\definition empty: FiniteSubset :=
  \subsetinto(\Power(A), FiniteSubsetSet, Empty, finiteEmpty);

\definition insert(a: A) (X: FiniteSubset): FiniteSubset :=
  \subsetinto(\Power(A), FiniteSubsetSet, Insert a X,
    finiteInsert a X (finite X));

\definition singleton(a: A): FiniteSubset :=
  \subsetinto(\Power(A), FiniteSubsetSet, Singleton a,
    finiteInsert a Empty finiteEmpty);

/* This is {a, b}; it has at most two elements and collapses when a = b. */
\definition unorderedPair(a, b: A): FiniteSubset :=
  \subsetinto(\Power(A), FiniteSubsetSet, UnorderedPair a b,
    finiteInsert a (Singleton b) (finiteInsert b Empty finiteEmpty));

\definition Member(X: FiniteSubset) (x: A): \Prop :=
  \Pred(A, underlying X, x);

\definition inInsertNew(a: A) (X: \Power(A)):
  \Pred(A, Insert a X, a) :=
  Logic.Or[a = a, \Pred(A, X, a)]::left (\refl(a));

\definition inInsertOld(a: A) (X: \Power(A)) (x: A)
  (member: \Pred(A, X, x)): \Pred(A, Insert a X, x) :=
  Logic.Or[x = a, \Pred(A, X, x)]::right member;

\definition inSingleton(a: A): \Pred(A, Singleton a, a) :=
  inInsertNew a Empty;

\definition inUnorderedPairLeft(a, b: A): \Pred(A, UnorderedPair a b, a) :=
  inInsertNew a (Singleton b);

\definition inUnorderedPairRight(a, b: A): \Pred(A, UnorderedPair a b, b) :=
  inInsertOld a (Singleton b) b (inSingleton b);
