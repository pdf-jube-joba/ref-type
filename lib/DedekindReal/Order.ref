\import RationalFractions.Order() \as RationalOrder;
\import \root.Classical() \as Classical;
\import \root.Pair() \as Pair;
\import \root.AxiomaticReals(Carrier := Real) \as AR;
\import \parent.Completeness() \as Complete;

\definition byContradiction (P: \Prop) (h: Logic.Not P -> Logic.False): P :=
  Classical.orElim P (Logic.Not P) P
    (\fun (p: P) => p)
    (\fun (np: Logic.Not P) => Logic.falseElim P (h np))
    (Classical.excludedMiddle P);

/* A member of x below a known member of y is in y; the other two
 * rational comparison cases contradict that the latter is outside x. */
\definition separatedInclusion (x, y: Real) (q: Rat)
  (nq: Logic.Not (mem x q)) (yq: mem y q) (p: Rat) (xp: mem x p): mem y p :=
  Classical.orElim (lt p q) (Logic.Or[RationalFractions.FractionEq p q, lt q p]) (mem y p)
    (\fun (pq: lt p q) => cutLower y p q pq yq)
    (\fun (rest: Logic.Or[RationalFractions.FractionEq p q, lt q p]) =>
      Classical.orElim (RationalFractions.FractionEq p q) (lt q p) (mem y p)
        (\fun (pq: RationalFractions.FractionEq p q) =>
          Logic.falseElim (mem y p) (nq (cutRespects x p q pq xp)))
        (\fun (qp: lt q p) =>
          Logic.falseElim (mem y p) (nq (cutLower x q p qp xp)))
        rest)
    (RationalOrder.trichotomy p q);

\definition leTotal (x, y: Real): Logic.Or[Le x y, Le y x] :=
  Classical.orElim (Le x y) (Logic.Not (Le x y)) (Logic.Or[Le x y, Le y x])
    (\fun (xy: Le x y) => Logic.Or[Le x y, Le y x]::left xy)
    (\fun (nxy: Logic.Not (Le x y)) =>
      Logic.Or[Le x y, Le y x]::right
        (\fun (q: Rat) => \fun (yq: mem y q) =>
          byContradiction (mem x q)
            (\fun (nq: Logic.Not (mem x q)) => nxy (separatedInclusion x y q nq yq))))
    (Classical.excludedMiddle (Le x y));

\definition leOfLt (x, y: Real) (xy: Lt x y): Le x y :=
  \take (q: \Ty(Rat, \Subset(q, Rat, Logic.And[Logic.Not (mem x q), mem y q]))) =>
    separatedInclusion x y q
      (Logic.And[Logic.Not (mem x q), mem y q]::left
        (\bysub(Rat, \Subset(q, Rat, Logic.And[Logic.Not (mem x q), mem y q]), q)))
      (Logic.And[Logic.Not (mem x q), mem y q]::right
        (\bysub(Rat, \Subset(q, Rat, Logic.And[Logic.Not (mem x q), mem y q]), q)))
  \by (xy);
\definition ltTrans (x, y, z: Real) (xy: Lt x y) (yz: Lt y z): Lt x z :=
  ltLeTrans x y z xy (leOfLt y z yz);

/* This relation is used by every arithmetic structure on the cut carrier. */
\definition leRelation: \Power(Pair.Times^[Real, Real]) :=
  \Subset(p, Pair.Times^[Real, Real],
    Le (Pair.first Real Real p) (Pair.second Real Real p));
\definition withOrder (zero, one: Real) (add: Real -> Real -> Real)
  (neg: Real -> Real) (mul: Real -> Real -> Real) (inv: Real -> Real):
  AR.RawRealStructure[Real] :=
  \record AR.RawRealStructure[Real] {
    zero := zero, one := one, add := add, neg := neg,
    mul := mul, inv := inv, leRelation := leRelation,
  };
\definition linearOrder (zero, one: Real) (add: Real -> Real -> Real)
  (neg: Real -> Real) (mul: Real -> Real -> Real) (inv: Real -> Real):
  AR.LinearOrderLaws (withOrder zero one add neg mul inv) :=
  AR.linearOrderIntro (withOrder zero one add neg mul inv) leRefl leTrans leAntisym leTotal;
\definition completeness (zero, one: Real) (add: Real -> Real -> Real)
  (neg: Real -> Real) (mul: Real -> Real -> Real) (inv: Real -> Real):
  AR.Completeness (withOrder zero one add neg mul inv) := Complete.complete;
