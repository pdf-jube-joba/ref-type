\import \parent.CutLaws[] \as CutLaws;

\definition ofRat (a: Rat): Real :=
    \subsetinto(\Power(Rat), CutSet, RatLower a, CutLaws.ratCut a);

\definition add (x, y: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, SumLower x y, CutLaws.sumCut x y);

\definition neg (x: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, NegLower x, CutLaws.negCut x);

\definition mul (x, y: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, MulLower x y, CutLaws.mulCut x y);

\definition inv (x: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, InvLower x, CutLaws.invCut x);

\definition sub (x, y: Real): Real := add x (neg y);

\definition zero: Real := ofRat zeroRat;

\definition one: Real := ofRat oneRat;

\module Laws;

\module Field;
