\import \parent.CutLaws() \as CutLaws;

\definition ofRat (a: Rat): Real :=
    \subsetinto(\Power(Rat), CutSet, RatLower a, CutLaws.ratCut a);

\definition add (x, y: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, SumLower x y, CutLaws.sumCut x y);

\definition neg (x: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, NegLower x, CutLaws.negCut x);

\definition mul (x, y: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, MulLower x y, mulLower x y);

\definition inv (x: Real): Real :=
    \subsetinto(\Power(Rat), CutSet, InvLower x, invLower x);

\definition sub (x, y: Real): Real := add x (neg y);

\definition zero: Real := ofRat zeroRat;

\definition one: Real := ofRat oneRat;

\import \parent.\parent.Order() \as CutOrder;
\import \root.AxiomaticReals(Carrier := Real) \as AR;

\definition raw: AR.RawRealStructure[Real] :=
  CutOrder.withOrder zero one add neg mul inv;
\definition linearOrder: AR.LinearOrderLaws[raw] :=
  CutOrder.linearOrder zero one add neg mul inv;
\definition completeness: AR.Completeness raw :=
  CutOrder.completeness zero one add neg mul inv;

\module Laws;
