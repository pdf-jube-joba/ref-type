\import \parent.CutLaws[] \as CutLaws;

\definition ofRat (a: Rat): Real :=
    \into[\Pow (Rat)](RatLower a, CutSet) \by { CutLaws.ratCut a };

\definition add (x, y: Real): Real :=
    \into[\Pow (Rat)](SumLower x y, CutSet) \by { CutLaws.sumCut x y };

\definition neg (x: Real): Real :=
    \into[\Pow (Rat)](NegLower x, CutSet) \by { CutLaws.negCut x };

\definition mul (x, y: Real): Real :=
    \into[\Pow (Rat)](MulLower x y, CutSet) \by { CutLaws.mulCut x y };

\definition inv (x: Real): Real :=
    \into[\Pow (Rat)](InvLower x, CutSet) \by { CutLaws.invCut x };

\definition sub (x, y: Real): Real := add x (neg y);

\definition zero: Real := ofRat zeroRat;

\definition one: Real := ofRat oneRat;

\module Laws;

\module Field;
