\import \root.Classical[] \as Classical;
\import \root.Equality[] \as Equality;
\use Equality.sym;
\import \root.Nat[] \as Natural;
\import RationalFractions.Order[] \as RationalOrder;
\import \parent.\parent.Order[] \as CutOrder;

\definition AdjacentBoundary (P: Natural.Nat^ -> \Prop): \Prop :=
  \exists \Cast[Natural.Nat^] ({ k : Natural.Nat^ \where Logic.And[P k, Logic.Not (P (Natural.Nat^::succ k))] });

\definition finiteBoundary (P: Natural.Nat^ -> \Prop):
  \forall (n: Natural.Nat^) -> P Natural.Nat^::zero ->
    Logic.Not (P n) -> AdjacentBoundary P :=
  \prec[Natural.Nat^, \fun (n: Natural.Nat^) => P Natural.Nat^::zero ->
      Logic.Not (P n) -> AdjacentBoundary P]
    (\fun (atZero: P Natural.Nat^::zero) =>
      \fun (notAtZero: Logic.Not (P Natural.Nat^::zero)) =>
        Logic.falseElim (AdjacentBoundary P) (notAtZero atZero))
    (\fun (n: Natural.Nat^) =>
      \fun (ih: P Natural.Nat^::zero ->
        Logic.Not (P n) -> AdjacentBoundary P) =>
      \fun (atZero: P Natural.Nat^::zero) =>
        \fun (notAtSucc: Logic.Not (P (Natural.Nat^::succ n))) =>
          Classical.orElim (P n) (Logic.Not (P n)) (AdjacentBoundary P)
            (\fun (atN: P n) =>
              \exact(
                \into[Natural.Nat^](n, { k : Natural.Nat^ \where Logic.And[P k,
                      Logic.Not (P (Natural.Nat^::succ k))] }) \by { \record Logic.And[P n,
                    Logic.Not (P (Natural.Nat^::succ n))] {
                    left := atN, right := notAtSucc,
                  } },
                \Cast[Natural.Nat^] ({ k : Natural.Nat^ \where Logic.And[P k,
                      Logic.Not (P (Natural.Nat^::succ k))] })))
            (\fun (notAtN: Logic.Not (P n)) => ih atZero notAtN)
            (Classical.excludedMiddle (P n)));

\definition lowerLocated (L: \Pow (Rat)) (lower: Lower L): Located L :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    Classical.orElim (In L p) (Logic.Not (In L p))
      (Logic.Or[In L p, Logic.Not (In L q)])
      (\fun (lp: In L p) =>
        Logic.Or[In L p, Logic.Not (In L q)]::left lp)
      (\fun (np: Logic.Not (In L p)) =>
        Logic.Or[In L p, Logic.Not (In L q)]::right
          (\fun (lq: In L q) => np (lower p q pq lq)))
      (Classical.excludedMiddle (In L p));

\definition ratLowerInhabited (a: Rat): Inhabited (RatLower a) :=
  \exact(
    \into[Rat](RationalOperations.below a, { q : Rat \where In (RatLower a) q }) \by { RationalOperations.belowLt a },
    \Cast[Rat] ({ q : Rat \where In (RatLower a) q }));

\definition ratLowerProper (a: Rat): Proper (RatLower a) :=
  \exact(
    \into[Rat](a, { q : Rat \where Logic.Not (In (RatLower a) q) }) \by { RationalOrder.ltIrrefl a },
    \Cast[Rat] ({ q : Rat \where Logic.Not (In (RatLower a) q) }));

\definition ratLowerLower (a: Rat): Lower (RatLower a) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) => \fun (qa: lt q a) =>
    RationalOrder.ltTrans p q a pq qa;

\definition ratLowerRounded (a: Rat): Rounded (RatLower a) :=
  \fun (p: Rat) => \fun (pa: lt p a) =>
    \exact(
      \into[Rat](RationalOperations.midpoint p a, { q : Rat \where Logic.And[In (RatLower a) q, lt p q] }) \by { \record Logic.And[
          In (RatLower a) (RationalOperations.midpoint p a),
          lt p (RationalOperations.midpoint p a)] {
          left := RationalOperations.midpointLt p a pa,
          right := RationalOperations.ltMidpoint p a pa,
        } },
      \Cast[Rat] ({ q : Rat \where Logic.And[In (RatLower a) q, lt p q] }));

\definition ratLowerRespects (a: Rat): RespectsFractionEq (RatLower a) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (pa: lt p a) =>
        RationalOrder.ltReplaceLeft p q a pq pa;

\definition ratCut (a: Rat):
  \In[\Pow (Rat)] (CutSet) (RatLower a) :=
  \record Logic.And[Inhabited (RatLower a),
    Logic.And[Proper (RatLower a),
      Logic.And[Lower (RatLower a),
        Logic.And[Rounded (RatLower a),
          Logic.And[Located (RatLower a),
            RespectsFractionEq (RatLower a)]]]]] {
    left := ratLowerInhabited a,
    right := \record Logic.And[Proper (RatLower a),
      Logic.And[Lower (RatLower a),
        Logic.And[Rounded (RatLower a),
          Logic.And[Located (RatLower a),
            RespectsFractionEq (RatLower a)]]]] {
      left := ratLowerProper a,
      right := \record Logic.And[Lower (RatLower a),
        Logic.And[Rounded (RatLower a),
          Logic.And[Located (RatLower a),
            RespectsFractionEq (RatLower a)]]] {
        left := ratLowerLower a,
        right := \record Logic.And[Rounded (RatLower a),
          Logic.And[Located (RatLower a),
            RespectsFractionEq (RatLower a)]] {
          left := ratLowerRounded a,
          right := \record Logic.And[Located (RatLower a),
            RespectsFractionEq (RatLower a)] {
            left := lowerLocated (RatLower a) (ratLowerLower a),
            right := ratLowerRespects a,
          },
        },
      },
    },
  };

\definition memberLtOutside (x: Real) (a, b: Rat)
  (xa: mem x a) (xb: Logic.Not (mem x b)): lt a b :=
  Classical.orElim (lt a b)
    (Logic.Or[RationalFractions.FractionEq a b, lt b a]) (lt a b)
    (\fun (ab: lt a b) => ab)
    (\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
      Classical.orElim (RationalFractions.FractionEq a b) (lt b a) (lt a b)
        (\fun (ab: RationalFractions.FractionEq a b) =>
          Logic.falseElim (lt a b) (xb (cutRespects x a b ab xa)))
        (\fun (ba: lt b a) =>
          Logic.falseElim (lt a b) (xb (cutLower x b a ba xa)))
        rest)
    (RationalOrder.trichotomy a b);

\definition GridPredicate (x: Real) (a, e: Rat): Natural.Nat^ -> \Prop :=
  \fun (n: Natural.Nat^) => mem x (RationalOperations.grid a e n);

\definition GridBoundaryAt (x: Real) (a, e: Rat): \Prop :=
  AdjacentBoundary (GridPredicate x a e);

\definition GridBoundaryWitnesses (x: Real) (e: Rat): \Pow (Rat) :=
  { a : Rat \where GridBoundaryAt x a e };

\definition GridBoundary (x: Real) (e: Rat): \Prop :=
  \exists \Cast[Rat] (GridBoundaryWitnesses x e);

\definition gridBoundary (x: Real) (e: Rat) (positive: lt zeroRat e):
  GridBoundary x e :=
  \take (a: \Cast[Rat] ({ a : Rat \where mem x a })) =>
    \take (b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) })) =>
      \take (n: \Cast[Natural.Nat^] ({ n : Natural.Nat^ \where lt b (RationalOperations.naturalTranslate a e n) })) =>
        \block {
          \let P: Natural.Nat^ -> \Prop := GridPredicate x a e;
          \let xa: mem x a :=
            \bysub(Rat, { a : Rat \where mem x a }, a);
          \let xb: Logic.Not (mem x b) :=
            \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b);
          \let farReduced:
              lt b (RationalOperations.naturalTranslate a e n) :=
            \bysub(Natural.Nat^,
              { n : Natural.Nat^ \where lt b (RationalOperations.naturalTranslate a e n) }, n);
          \let far: lt b (RationalOperations.grid a e n) :=
            RationalOrder.ltReplaceRight b
              (RationalOperations.naturalTranslate a e n)
              (RationalOperations.grid a e n)
              (RationalOperations.naturalTranslateAsGrid a e n)
              farReduced;
          \let atZero: P Natural.Nat^::zero :=
            cutRespects x a
              (RationalOperations.grid a e Natural.Nat^::zero)
              (RationalFractions.fractionEqSym _ _
                (RationalOperations.gridZero a e)) xa;
          \let notAtN: Logic.Not (P n) :=
            \fun (atN: P n) => xb
              (cutLower x b (RationalOperations.grid a e n) far atN);
          \let boundary: AdjacentBoundary P :=
            finiteBoundary P n atZero notAtN;
          \return \exact(
            \into[Rat](a, GridBoundaryWitnesses x e) \by { boundary },
            \Cast[Rat] (GridBoundaryWitnesses x e));
        }
      \by { RationalOperations.naturalTranslateAbove a e b positive }
    \by { cutProper x }
  \by { cutInhabited x };

\definition Bracketed (x: Real) (e: Rat): \Prop :=
  \exists \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] });

\definition bracket (x: Real) (e: Rat) (positive: lt zeroRat e):
  Bracketed x e :=
  \take (base: \Cast[Rat] (GridBoundaryWitnesses x e)) =>
    \take (k: \Cast[Natural.Nat^] ({ k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
          Logic.Not (GridPredicate x base e (Natural.Nat^::succ k))] })) =>
      \block {
        \let a: Rat := RationalOperations.grid base e k;
        \let next: Rat :=
          RationalOperations.grid base e (Natural.Nat^::succ k);
        \let xa: mem x a :=
          Logic.And[GridPredicate x base e k,
            Logic.Not (GridPredicate x base e (Natural.Nat^::succ k))]::left
            (\bysub(Natural.Nat^,
              { k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
                  Logic.Not (GridPredicate x base e
                    (Natural.Nat^::succ k))] }, k));
        \let outsideNext: Logic.Not (mem x next) :=
          Logic.And[GridPredicate x base e k,
            Logic.Not (GridPredicate x base e (Natural.Nat^::succ k))]::right
            (\bysub(Natural.Nat^,
              { k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
                  Logic.Not (GridPredicate x base e
                    (Natural.Nat^::succ k))] }, k));
        \let outside: Logic.Not (mem x (addRat a e)) :=
          \fun (inside: mem x (addRat a e)) =>
            outsideNext
              (cutRespects x (addRat a e) next
                (RationalFractions.fractionEqSym _ _
                  (RationalOperations.gridSucc base e k)) inside);
        \return \exact(
          \into[Rat](a, { a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] }) \by { \record Logic.And[mem x a,
              Logic.Not (mem x (addRat a e))] {
              left := xa, right := outside,
            } },
          \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] }));
      }
    \by { \bysub(Rat, GridBoundaryWitnesses x e, base) }
  \by { gridBoundary x e positive };

\definition sumIntro (x, y: Real) (q, a, b: Rat)
  (xa: mem x a) (yb: mem y b) (qab: lt q (addRat a b)):
  In (SumLower x y) q :=
  \exact(
    \into[Rat](a, { a : Rat \where Logic.And[mem x a,
          \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }) \by { \record Logic.And[mem x a,
        \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] {
        left := xa,
        right := \exact(
          \into[Rat](b, { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }) \by { \record Logic.And[mem y b, lt q (addRat a b)] {
              left := yb, right := qab,
            } },
          \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })),
      } },
    \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
        \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }));

\definition sumElim (x, y: Real) (q: Rat) (member: In (SumLower x y) q)
  (P: \Prop)
  (use: \forall (a, b: Rat) ->
    mem x a -> mem y b -> lt q (addRat a b) -> P): P :=
  \take (a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
        \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] })) =>
    \take (b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })) =>
      use a b
        (Logic.And[mem x a,
          \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })]::left
          (\bysub(Rat,
            { a : Rat \where Logic.And[mem x a,
                \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }, a)))
        (Logic.And[mem y b, lt q (addRat a b)]::left
          (\bysub(Rat,
            { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b)))
        (Logic.And[mem y b, lt q (addRat a b)]::right
          (\bysub(Rat,
            { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b)))
    \by { Logic.And[mem x a,
      \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })]::right
      (\bysub(Rat,
        { a : Rat \where Logic.And[mem x a,
            \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }, a)) }
  \by { member };

\definition sumContainsAdd (x, y: Real) (a, b: Rat)
  (xa: mem x a) (yb: mem y b): In (SumLower x y) (addRat a b) :=
  \take (a2: \Cast[Rat] ({ a2 : Rat \where Logic.And[mem x a2, lt a a2] })) =>
    \take (b2: \Cast[Rat] ({ b2 : Rat \where Logic.And[mem y b2, lt b b2] })) =>
      sumIntro x y (addRat a b) a2 b2
        (Logic.And[mem x a2, lt a a2]::left
          (\bysub(Rat,
            { a2 : Rat \where Logic.And[mem x a2, lt a a2] }, a2)))
        (Logic.And[mem y b2, lt b b2]::left
          (\bysub(Rat,
            { b2 : Rat \where Logic.And[mem y b2, lt b b2] }, b2)))
        (RationalOperations.ltAdd a a2 b b2
          (Logic.And[mem x a2, lt a a2]::right
            (\bysub(Rat,
              { a2 : Rat \where Logic.And[mem x a2, lt a a2] }, a2)))
          (Logic.And[mem y b2, lt b b2]::right
            (\bysub(Rat,
              { b2 : Rat \where Logic.And[mem y b2, lt b b2] }, b2))))
    \by { cutRounded y b yb }
  \by { cutRounded x a xa };

\definition sumInhabited (x, y: Real): Inhabited (SumLower x y) :=
  \take (a: \Cast[Rat] ({ a : Rat \where mem x a })) =>
    \take (b: \Cast[Rat] ({ b : Rat \where mem y b })) =>
      \exact(
        \into[Rat](RationalOperations.below (addRat a b), { q : Rat \where In (SumLower x y) q }) \by { sumIntro x y (RationalOperations.below (addRat a b)) a b
            (\bysub(Rat, { a : Rat \where mem x a }, a))
            (\bysub(Rat, { b : Rat \where mem y b }, b))
            (RationalOperations.belowLt (addRat a b)) },
        \Cast[Rat] ({ q : Rat \where In (SumLower x y) q }))
    \by { cutInhabited y }
  \by { cutInhabited x };

\definition sumProperAt (x, y: Real) (u, v: Rat)
  (xu: Logic.Not (mem x u)) (yv: Logic.Not (mem y v)):
  Logic.Not (In (SumLower x y) (addRat u v)) :=
  \fun (member: In (SumLower x y) (addRat u v)) =>
    \take (a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
          \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b,
                lt (addRat u v) (addRat a b)] })] })) =>
      \take (b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt (addRat u v) (addRat a b)] })) =>
        (\block {
          \let xa: mem x a :=
            Logic.And[mem x a,
              \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] })]::left
              (\bysub(Rat,
                { a : Rat \where Logic.And[mem x a,
                    \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b,
                          lt (addRat u v) (addRat a b)] })] }, a));
          \let yb: mem y b :=
            Logic.And[mem y b, lt (addRat u v) (addRat a b)]::left
              (\bysub(Rat,
                { b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] }, b));
          \let boundLt: lt (addRat u v) (addRat a b) :=
            Logic.And[mem y b, lt (addRat u v) (addRat a b)]::right
              (\bysub(Rat,
                { b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] }, b));
          \return RationalOrder.ltIrrefl (addRat u v)
            (RationalOrder.ltTrans
              (addRat u v) (addRat a b) (addRat u v) boundLt
              (RationalOperations.ltAdd a u b v
                (memberLtOutside x a u xa xu)
                (memberLtOutside y b v yb yv)));
        })
      \by { Logic.And[mem x a,
        \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b,
              lt (addRat u v) (addRat a b)] })]::right
        (\bysub(Rat,
          { a : Rat \where Logic.And[mem x a,
              \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] })] }, a)) }
    \by { member };

\definition sumProper (x, y: Real): Proper (SumLower x y) :=
  \take (u: \Cast[Rat] ({ u : Rat \where Logic.Not (mem x u) })) =>
    \take (v: \Cast[Rat] ({ v : Rat \where Logic.Not (mem y v) })) =>
      \exact(
        \into[Rat](addRat u v, { q : Rat \where Logic.Not (In (SumLower x y) q) }) \by { sumProperAt x y u v
            (\bysub(Rat, { u : Rat \where Logic.Not (mem x u) }, u))
            (\bysub(Rat, { v : Rat \where Logic.Not (mem y v) }, v)) },
        \Cast[Rat] ({ q : Rat \where Logic.Not (In (SumLower x y) q) }))
    \by { cutProper y }
  \by { cutProper x };

\definition sumLower (x, y: Real): Lower (SumLower x y) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: In (SumLower x y) q) =>
      \take (a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
            \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] })) =>
        \take (b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })) =>
          sumIntro x y p a b
            (Logic.And[mem x a,
              \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })]::left
              (\bysub(Rat,
                { a : Rat \where Logic.And[mem x a,
                    \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }, a)))
            (Logic.And[mem y b, lt q (addRat a b)]::left
              (\bysub(Rat,
                { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b)))
            (RationalOrder.ltTrans p q (addRat a b) pq
              (Logic.And[mem y b, lt q (addRat a b)]::right
                (\bysub(Rat,
                  { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))))
        \by { Logic.And[mem x a,
          \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })]::right
          (\bysub(Rat,
            { a : Rat \where Logic.And[mem x a,
                \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }, a)) }
      \by { member };

\definition sumRounded (x, y: Real): Rounded (SumLower x y) :=
  \fun (q: Rat) => \fun (member: In (SumLower x y) q) =>
    \take (a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
          \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] })) =>
      \take (b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })) =>
        (\block {
          \let xa: mem x a :=
            Logic.And[mem x a,
              \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })]::left
              (\bysub(Rat,
                { a : Rat \where Logic.And[mem x a,
                    \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }, a));
          \let yb: mem y b :=
            Logic.And[mem y b, lt q (addRat a b)]::left
              (\bysub(Rat,
                { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b));
          \let qab: lt q (addRat a b) :=
            Logic.And[mem y b, lt q (addRat a b)]::right
              (\bysub(Rat,
                { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b));
          \let r: Rat := RationalOperations.midpoint q (addRat a b);
          \return \exact(
            \into[Rat](r, { r : Rat \where Logic.And[In (SumLower x y) r, lt q r] }) \by { \record Logic.And[In (SumLower x y) r, lt q r] {
                left := sumIntro x y r a b xa yb
                  (RationalOperations.midpointLt q (addRat a b) qab),
                right := RationalOperations.ltMidpoint q (addRat a b) qab,
              } },
            \Cast[Rat] ({ r : Rat \where Logic.And[In (SumLower x y) r, lt q r] }));
        })
      \by { Logic.And[mem x a,
        \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })]::right
        (\bysub(Rat,
          { a : Rat \where Logic.And[mem x a,
              \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] })] }, a)) }
    \by { member };

\definition sumRespects (x, y: Real): RespectsFractionEq (SumLower x y) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (member: In (SumLower x y) p) =>
        \take (a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
              \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] })] })) =>
          \take (b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] })) =>
            sumIntro x y q a b
              (Logic.And[mem x a,
                \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] })]::left
                (\bysub(Rat,
                  { a : Rat \where Logic.And[mem x a,
                      \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] })] }, a)))
              (Logic.And[mem y b, lt p (addRat a b)]::left
                (\bysub(Rat,
                  { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }, b)))
              (RationalOrder.ltReplaceLeft p q (addRat a b) pq
                (Logic.And[mem y b, lt p (addRat a b)]::right
                  (\bysub(Rat,
                    { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }, b))))
          \by { Logic.And[mem x a,
            \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] })]::right
            (\bysub(Rat,
              { a : Rat \where Logic.And[mem x a,
                  \exists \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] })] }, a)) }
        \by { member };

\definition sumCut (x, y: Real):
  \In[\Pow (Rat)] (CutSet) (SumLower x y) :=
  \record Logic.And[Inhabited (SumLower x y),
    Logic.And[Proper (SumLower x y),
      Logic.And[Lower (SumLower x y),
        Logic.And[Rounded (SumLower x y),
          Logic.And[Located (SumLower x y),
            RespectsFractionEq (SumLower x y)]]]]] {
    left := sumInhabited x y,
    right := \record Logic.And[Proper (SumLower x y),
      Logic.And[Lower (SumLower x y),
        Logic.And[Rounded (SumLower x y),
          Logic.And[Located (SumLower x y),
            RespectsFractionEq (SumLower x y)]]]] {
      left := sumProper x y,
      right := \record Logic.And[Lower (SumLower x y),
        Logic.And[Rounded (SumLower x y),
          Logic.And[Located (SumLower x y),
            RespectsFractionEq (SumLower x y)]]] {
        left := sumLower x y,
        right := \record Logic.And[Rounded (SumLower x y),
          Logic.And[Located (SumLower x y),
            RespectsFractionEq (SumLower x y)]] {
          left := sumRounded x y,
          right := \record Logic.And[Located (SumLower x y),
            RespectsFractionEq (SumLower x y)] {
            left := lowerLocated (SumLower x y) (sumLower x y),
            right := sumRespects x y,
          },
        },
      },
    },
  };

\definition negIntro (x: Real) (q, r: Rat)
  (xr: Logic.Not (mem x r)) (qr: lt q (negRat r)):
  In (NegLower x) q :=
  \exact(
    \into[Rat](r, { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by { \record Logic.And[Logic.Not (mem x r), lt q (negRat r)] {
        left := xr, right := qr,
      } },
    \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }));

\definition negElim (x: Real) (q: Rat) (member: In (NegLower x) q)
  (P: \Prop)
  (use: \forall (r: Rat) ->
    Logic.Not (mem x r) -> lt q (negRat r) -> P): P :=
  \take (r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] })) =>
    \block {
      \let xr: Logic.Not (mem x r) :=
        Logic.And[Logic.Not (mem x r), lt q (negRat r)]::left
          (\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r));
      \let qr: lt q (negRat r) :=
        Logic.And[Logic.Not (mem x r), lt q (negRat r)]::right
          (\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r));
      \return use r xr qr;
    }
  \by { member };

\definition negInhabited (x: Real): Inhabited (NegLower x) :=
  \take (r: \Cast[Rat] ({ r : Rat \where Logic.Not (mem x r) })) =>
    \exact(
      \into[Rat](RationalOperations.below (negRat r), { q : Rat \where In (NegLower x) q }) \by { negIntro x (RationalOperations.below (negRat r)) r
          (\bysub(Rat, { r : Rat \where Logic.Not (mem x r) }, r))
          (RationalOperations.belowLt (negRat r)) },
      \Cast[Rat] ({ q : Rat \where In (NegLower x) q }))
  \by { cutProper x };

\definition negProperAt (x: Real) (a: Rat) (xa: mem x a):
  Logic.Not (In (NegLower x) (negRat a)) :=
  \fun (member: In (NegLower x) (negRat a)) =>
    \take (r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt (negRat a) (negRat r)] })) =>
      (Logic.And[Logic.Not (mem x r), lt (negRat a) (negRat r)]::left
        (\bysub(Rat,
          { r : Rat \where Logic.And[Logic.Not (mem x r),
              lt (negRat a) (negRat r)] }, r)))
        (cutLower x r a
          (RationalOperations.ltOfNegLtNeg a r
            (Logic.And[Logic.Not (mem x r),
              lt (negRat a) (negRat r)]::right
              (\bysub(Rat,
                { r : Rat \where Logic.And[Logic.Not (mem x r),
                    lt (negRat a) (negRat r)] }, r)))) xa)
    \by { member };

\definition negProper (x: Real): Proper (NegLower x) :=
  \take (a: \Cast[Rat] ({ a : Rat \where mem x a })) =>
    \exact(
      \into[Rat](negRat a, { q : Rat \where Logic.Not (In (NegLower x) q) }) \by { negProperAt x a (\bysub(Rat, { a : Rat \where mem x a }, a)) },
      \Cast[Rat] ({ q : Rat \where Logic.Not (In (NegLower x) q) }))
  \by { cutInhabited x };

\definition negLower (x: Real): Lower (NegLower x) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: In (NegLower x) q) =>
      \take (r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] })) =>
        negIntro x p r
          (Logic.And[Logic.Not (mem x r), lt q (negRat r)]::left
            (\bysub(Rat,
              { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)))
          (RationalOrder.ltTrans p q (negRat r) pq
            (Logic.And[Logic.Not (mem x r), lt q (negRat r)]::right
              (\bysub(Rat,
                { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))))
      \by { member };

\definition negRounded (x: Real): Rounded (NegLower x) :=
  \fun (q: Rat) => \fun (member: In (NegLower x) q) =>
    \take (r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] })) =>
      \block {
        \let xr: Logic.Not (mem x r) :=
          Logic.And[Logic.Not (mem x r), lt q (negRat r)]::left
            (\bysub(Rat,
              { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r));
        \let qr: lt q (negRat r) :=
          Logic.And[Logic.Not (mem x r), lt q (negRat r)]::right
            (\bysub(Rat,
              { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r));
        \let p: Rat := RationalOperations.midpoint q (negRat r);
        \return \exact(
          \into[Rat](p, { p : Rat \where Logic.And[In (NegLower x) p, lt q p] }) \by { \record Logic.And[In (NegLower x) p, lt q p] {
              left := negIntro x p r xr
                (RationalOperations.midpointLt q (negRat r) qr),
              right := RationalOperations.ltMidpoint q (negRat r) qr,
            } },
          \Cast[Rat] ({ p : Rat \where Logic.And[In (NegLower x) p, lt q p] }));
      }
    \by { member };

\definition negRespects (x: Real): RespectsFractionEq (NegLower x) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (member: In (NegLower x) p) =>
        \take (r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] })) =>
          negIntro x q r
            (Logic.And[Logic.Not (mem x r), lt p (negRat r)]::left
              (\bysub(Rat,
                { r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }, r)))
            (RationalOrder.ltReplaceLeft p q (negRat r) pq
              (Logic.And[Logic.Not (mem x r), lt p (negRat r)]::right
                (\bysub(Rat,
                  { r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }, r))))
        \by { member };

\definition negCut (x: Real):
  \In[\Pow (Rat)] (CutSet) (NegLower x) :=
  \record Logic.And[Inhabited (NegLower x),
    Logic.And[Proper (NegLower x),
      Logic.And[Lower (NegLower x),
        Logic.And[Rounded (NegLower x),
          Logic.And[Located (NegLower x),
            RespectsFractionEq (NegLower x)]]]]] {
    left := negInhabited x,
    right := \record Logic.And[Proper (NegLower x),
      Logic.And[Lower (NegLower x),
        Logic.And[Rounded (NegLower x),
          Logic.And[Located (NegLower x),
            RespectsFractionEq (NegLower x)]]]] {
      left := negProper x,
      right := \record Logic.And[Lower (NegLower x),
        Logic.And[Rounded (NegLower x),
          Logic.And[Located (NegLower x),
            RespectsFractionEq (NegLower x)]]] {
        left := negLower x,
        right := \record Logic.And[Rounded (NegLower x),
          Logic.And[Located (NegLower x),
            RespectsFractionEq (NegLower x)]] {
          left := negRounded x,
          right := \record Logic.And[Located (NegLower x),
            RespectsFractionEq (NegLower x)] {
            left := lowerLocated (NegLower x) (negLower x),
            right := negRespects x,
          },
        },
      },
    },
  };

/* Rational density packaged for the finite endpoint arguments used below. */
\definition BelowBoth (a, b: Rat): \Prop :=
  \exists \Cast[Rat] ({ q : Rat \where Logic.And[lt q a, lt q b] });

\definition belowBoth (a, b: Rat): BelowBoth a b :=
  Classical.orElim (lt a b)
    (Logic.Or[RationalFractions.FractionEq a b, lt b a]) (BelowBoth a b)
    (\fun (ab: lt a b) =>
      \exact(
        \into[Rat](RationalOperations.below a, { q : Rat \where Logic.And[lt q a, lt q b] }) \by { \record Logic.And[
            lt (RationalOperations.below a) a,
            lt (RationalOperations.below a) b] {
            left := RationalOperations.belowLt a,
            right := RationalOrder.ltTrans
              (RationalOperations.below a) a b
              (RationalOperations.belowLt a) ab,
          } },
        \Cast[Rat] ({ q : Rat \where Logic.And[lt q a, lt q b] })))
    (\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
      Classical.orElim (RationalFractions.FractionEq a b) (lt b a)
        (BelowBoth a b)
        (\fun (ab: RationalFractions.FractionEq a b) =>
          \exact(
            \into[Rat](RationalOperations.below a, { q : Rat \where Logic.And[lt q a, lt q b] }) \by { \record Logic.And[
                lt (RationalOperations.below a) a,
                lt (RationalOperations.below a) b] {
                left := RationalOperations.belowLt a,
                right := RationalOrder.ltReplaceRight
                  (RationalOperations.below a) a b ab
                  (RationalOperations.belowLt a),
              } },
            \Cast[Rat] ({ q : Rat \where Logic.And[lt q a, lt q b] })))
        (\fun (ba: lt b a) =>
          \exact(
            \into[Rat](RationalOperations.below b, { q : Rat \where Logic.And[lt q a, lt q b] }) \by { \record Logic.And[
                lt (RationalOperations.below b) a,
                lt (RationalOperations.below b) b] {
                left := RationalOrder.ltTrans
                  (RationalOperations.below b) b a
                  (RationalOperations.belowLt b) ba,
                right := RationalOperations.belowLt b,
              } },
            \Cast[Rat] ({ q : Rat \where Logic.And[lt q a, lt q b] })))
        rest)
    (RationalOrder.trichotomy a b);

\definition AboveBoth (a, b: Rat): \Prop :=
  \exists \Cast[Rat] ({ q : Rat \where Logic.And[lt a q, lt b q] });

\definition aboveBoth (a, b: Rat): AboveBoth a b :=
  Classical.orElim (lt a b)
    (Logic.Or[RationalFractions.FractionEq a b, lt b a]) (AboveBoth a b)
    (\fun (ab: lt a b) =>
      \exact(
        \into[Rat](RationalOperations.above b, { q : Rat \where Logic.And[lt a q, lt b q] }) \by { \record Logic.And[
            lt a (RationalOperations.above b),
            lt b (RationalOperations.above b)] {
            left := RationalOrder.ltTrans a b
              (RationalOperations.above b) ab
              (RationalOperations.ltAbove b),
            right := RationalOperations.ltAbove b,
          } },
        \Cast[Rat] ({ q : Rat \where Logic.And[lt a q, lt b q] })))
    (\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
      Classical.orElim (RationalFractions.FractionEq a b) (lt b a)
        (AboveBoth a b)
        (\fun (ab: RationalFractions.FractionEq a b) =>
          \exact(
            \into[Rat](RationalOperations.above b, { q : Rat \where Logic.And[lt a q, lt b q] }) \by { \record Logic.And[
                lt a (RationalOperations.above b),
                lt b (RationalOperations.above b)] {
                left := RationalOrder.ltReplaceLeft b a
                  (RationalOperations.above b)
                  (RationalFractions.fractionEqSym _ _ ab)
                  (RationalOperations.ltAbove b),
                right := RationalOperations.ltAbove b,
              } },
            \Cast[Rat] ({ q : Rat \where Logic.And[lt a q, lt b q] })))
        (\fun (ba: lt b a) =>
          \exact(
            \into[Rat](RationalOperations.above a, { q : Rat \where Logic.And[lt a q, lt b q] }) \by { \record Logic.And[
                lt a (RationalOperations.above a),
                lt b (RationalOperations.above a)] {
                left := RationalOperations.ltAbove a,
                right := RationalOrder.ltTrans b a
                  (RationalOperations.above a) ba
                  (RationalOperations.ltAbove a),
              } },
            \Cast[Rat] ({ q : Rat \where Logic.And[lt a q, lt b q] })))
        rest)
    (RationalOrder.trichotomy a b);

\definition BetweenBoth (q, a, b: Rat): \Prop :=
  \exists \Cast[Rat] ({ r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] });

\definition betweenBoth (q, a, b: Rat) (qa: lt q a) (qb: lt q b):
  BetweenBoth q a b :=
  Classical.orElim (lt a b)
    (Logic.Or[RationalFractions.FractionEq a b, lt b a])
    (BetweenBoth q a b)
    (\fun (ab: lt a b) =>
      \exact(
        \into[Rat](RationalOperations.midpoint q a, { r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] }) \by { \record Logic.And[
            lt q (RationalOperations.midpoint q a),
            Logic.And[
              lt (RationalOperations.midpoint q a) a,
              lt (RationalOperations.midpoint q a) b]] {
            left := RationalOperations.ltMidpoint q a qa,
            right := \record Logic.And[
              lt (RationalOperations.midpoint q a) a,
              lt (RationalOperations.midpoint q a) b] {
              left := RationalOperations.midpointLt q a qa,
              right := RationalOrder.ltTrans
                (RationalOperations.midpoint q a) a b
                (RationalOperations.midpointLt q a qa) ab,
            },
          } },
        \Cast[Rat] ({ r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] })))
    (\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
      Classical.orElim (RationalFractions.FractionEq a b) (lt b a)
        (BetweenBoth q a b)
        (\fun (ab: RationalFractions.FractionEq a b) =>
          \exact(
            \into[Rat](RationalOperations.midpoint q a, { r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] }) \by { \record Logic.And[
                lt q (RationalOperations.midpoint q a),
                Logic.And[
                  lt (RationalOperations.midpoint q a) a,
                  lt (RationalOperations.midpoint q a) b]] {
                left := RationalOperations.ltMidpoint q a qa,
                right := \record Logic.And[
                  lt (RationalOperations.midpoint q a) a,
                  lt (RationalOperations.midpoint q a) b] {
                  left := RationalOperations.midpointLt q a qa,
                  right := RationalOrder.ltReplaceRight
                    (RationalOperations.midpoint q a) a b ab
                    (RationalOperations.midpointLt q a qa),
                },
              } },
            \Cast[Rat] ({ r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] })))
        (\fun (ba: lt b a) =>
          \exact(
            \into[Rat](RationalOperations.midpoint q b, { r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] }) \by { \record Logic.And[
                lt q (RationalOperations.midpoint q b),
                Logic.And[
                  lt (RationalOperations.midpoint q b) a,
                  lt (RationalOperations.midpoint q b) b]] {
                left := RationalOperations.ltMidpoint q b qb,
                right := \record Logic.And[
                  lt (RationalOperations.midpoint q b) a,
                  lt (RationalOperations.midpoint q b) b] {
                  left := RationalOrder.ltTrans
                    (RationalOperations.midpoint q b) b a
                    (RationalOperations.midpointLt q b qb) ba,
                  right := RationalOperations.midpointLt q b qb,
                },
              } },
            \Cast[Rat] ({ r : Rat \where Logic.And[lt q r, Logic.And[lt r a, lt r b]] })))
        rest)
    (RationalOrder.trichotomy a b);

\definition SymmetricBound (x: Real): \Prop :=
  \exists \Cast[Rat] ({ u : Rat \where Logic.And[lt zeroRat u,
        Logic.And[mem x (negRat u), Logic.Not (mem x u)]] });

\definition symmetricBound (x: Real): SymmetricBound x :=
  \take (a: \Cast[Rat] ({ a : Rat \where mem x a })) =>
    \take (b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) })) =>
      \take (u: \Cast[Rat] ({ u : Rat \where Logic.And[lt (negRat a) u, lt b u] })) =>
        \take (v: \Cast[Rat] ({ v : Rat \where Logic.And[lt u v, lt zeroRat v] })) =>
          \block {
            \let nua: lt (negRat a) v :=
              RationalOrder.ltTrans (negRat a) u v
                (Logic.And[lt (negRat a) u, lt b u]::left
                  (\bysub(Rat, { u : Rat \where Logic.And[lt (negRat a) u, lt b u] }, u)))
                (Logic.And[lt u v, lt zeroRat v]::left
                  (\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v)));
            \let nva: lt (negRat v) a :=
              RationalOrder.ltReplaceRight (negRat v)
                (negRat (negRat a)) a
                (RationalOperations.fractionNegInvolutive a)
                (RationalOperations.ltNegReverse (negRat a) v nua);
            \let bv: lt b v :=
              RationalOrder.ltTrans b u v
                (Logic.And[lt (negRat a) u, lt b u]::right
                  (\bysub(Rat, { u : Rat \where Logic.And[lt (negRat a) u, lt b u] }, u)))
                (Logic.And[lt u v, lt zeroRat v]::left
                  (\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v)));
            \let inside: mem x (negRat v) :=
              cutLower x (negRat v) a nva
                (\bysub(Rat, { a : Rat \where mem x a }, a));
            \let outside: Logic.Not (mem x v) :=
              \fun (xv: mem x v) =>
                (\bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b))
                  (cutLower x b v bv xv);
            \return \exact(
              \into[Rat](v, { v : Rat \where Logic.And[lt zeroRat v,
                  Logic.And[mem x (negRat v), Logic.Not (mem x v)]] }) \by { \record Logic.And[lt zeroRat v,
                  Logic.And[mem x (negRat v), Logic.Not (mem x v)]] {
                  left := Logic.And[lt u v, lt zeroRat v]::right
                    (\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v)),
                  right := \record Logic.And[
                    mem x (negRat v), Logic.Not (mem x v)] {
                    left := inside, right := outside,
                  },
                } },
              \Cast[Rat] ({ v : Rat \where Logic.And[lt zeroRat v,
                  Logic.And[mem x (negRat v), Logic.Not (mem x v)]] }));
          }
        \by { aboveBoth u zeroRat }
      \by { aboveBoth (negRat a) b }
    \by { cutProper x }
  \by { cutInhabited x };

\definition productBelowElim (x, y: Real) (q: Rat)
  (member: ProductBelow x y q) (P: \Prop)
  (use: \forall (a, b, c, d: Rat) ->
    mem x a -> Logic.Not (mem x b) ->
    mem y c -> Logic.Not (mem y d) ->
    lt q (mulRat a c) -> lt q (mulRat a d) ->
    lt q (mulRat b c) -> lt q (mulRat b d) -> P): P :=
  member P use;

\definition positiveCornersImpossible
  (u, v, a, b, c, d: Rat)
  (uPositive: lt zeroRat u) (vPositive: lt zeroRat v)
  (au: lt a u) (nub: lt (negRat u) b)
  (cv: lt c v) (nvd: lt (negRat v) d)
  (ac: lt (mulRat u v) (mulRat a c))
  (ad: lt (mulRat u v) (mulRat a d))
  (bc: lt (mulRat u v) (mulRat b c))
  (bd: lt (mulRat u v) (mulRat b d)): Logic.False :=
  \block {
    \let productPositive: lt zeroRat (mulRat u v) :=
      RationalOperations.zeroLtMulPositive u v uPositive vPositive;
    \return Classical.orElim (lt a zeroRat)
      (Logic.Or[RationalFractions.FractionEq a zeroRat, lt zeroRat a])
      Logic.False
      (\fun (aNegative: lt a zeroRat) =>
        \block {
          \let acPositive: lt zeroRat (mulRat a c) :=
            RationalOrder.ltTrans zeroRat (mulRat u v) (mulRat a c)
              productPositive ac;
          \let cNegative: lt c zeroRat :=
            Classical.orElim (lt c zeroRat)
              (Logic.Or[RationalFractions.FractionEq c zeroRat,
                lt zeroRat c]) (lt c zeroRat)
              (\fun (cNegative: lt c zeroRat) => cNegative)
              (\fun (rest: Logic.Or[RationalFractions.FractionEq c zeroRat,
                lt zeroRat c]) =>
                Classical.orElim (RationalFractions.FractionEq c zeroRat)
                  (lt zeroRat c) (lt c zeroRat)
                  (\fun (cz: RationalFractions.FractionEq c zeroRat) =>
                    Logic.falseElim (lt c zeroRat)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltReplaceRight zeroRat (mulRat a c)
                          zeroRat
                          (RationalFractions.fractionEqTrans _ _ _
                            (RationalOperations.fractionMulRespects
                              a a c zeroRat
                              (RationalFractions.fractionEqRefl a) cz)
                            (RationalOperations.fractionMulZeroRight a))
                          acPositive)))
                  (\fun (cPositive: lt zeroRat c) =>
                    Logic.falseElim (lt c zeroRat)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltTrans zeroRat (mulRat a c) zeroRat
                          acPositive
                          (RationalOperations.mulLtZeroNegativePositive
                            a c aNegative cPositive))))
                  rest)
              (RationalOrder.trichotomy c zeroRat);
          \let bcPositive: lt zeroRat (mulRat b c) :=
            RationalOrder.ltTrans zeroRat (mulRat u v) (mulRat b c)
              productPositive bc;
          \let bNegative: lt b zeroRat :=
            Classical.orElim (lt b zeroRat)
              (Logic.Or[RationalFractions.FractionEq b zeroRat,
                lt zeroRat b]) (lt b zeroRat)
              (\fun (bNegative: lt b zeroRat) => bNegative)
              (\fun (rest: Logic.Or[RationalFractions.FractionEq b zeroRat,
                lt zeroRat b]) =>
                Classical.orElim (RationalFractions.FractionEq b zeroRat)
                  (lt zeroRat b) (lt b zeroRat)
                  (\fun (bz: RationalFractions.FractionEq b zeroRat) =>
                    Logic.falseElim (lt b zeroRat)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltReplaceRight zeroRat (mulRat b c)
                          zeroRat
                          (RationalFractions.fractionEqTrans _ _ _
                            (RationalOperations.fractionMulRespects
                              b zeroRat c c bz
                              (RationalFractions.fractionEqRefl c))
                            (RationalOperations.fractionMulZeroLeft c))
                          bcPositive)))
                  (\fun (bPositive: lt zeroRat b) =>
                    Logic.falseElim (lt b zeroRat)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltTrans zeroRat (mulRat b c) zeroRat
                          bcPositive
                          (RationalOperations.mulLtZeroPositiveNegative
                            b c bPositive cNegative))))
                  rest)
              (RationalOrder.trichotomy b zeroRat);
          \let adPositive: lt zeroRat (mulRat a d) :=
            RationalOrder.ltTrans zeroRat (mulRat u v) (mulRat a d)
              productPositive ad;
          \let dNegative: lt d zeroRat :=
            Classical.orElim (lt d zeroRat)
              (Logic.Or[RationalFractions.FractionEq d zeroRat,
                lt zeroRat d]) (lt d zeroRat)
              (\fun (dNegative: lt d zeroRat) => dNegative)
              (\fun (rest: Logic.Or[RationalFractions.FractionEq d zeroRat,
                lt zeroRat d]) =>
                Classical.orElim (RationalFractions.FractionEq d zeroRat)
                  (lt zeroRat d) (lt d zeroRat)
                  (\fun (dz: RationalFractions.FractionEq d zeroRat) =>
                    Logic.falseElim (lt d zeroRat)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltReplaceRight zeroRat (mulRat a d)
                          zeroRat
                          (RationalFractions.fractionEqTrans _ _ _
                            (RationalOperations.fractionMulRespects
                              a a d zeroRat
                              (RationalFractions.fractionEqRefl a) dz)
                            (RationalOperations.fractionMulZeroRight a))
                          adPositive)))
                  (\fun (dPositive: lt zeroRat d) =>
                    Logic.falseElim (lt d zeroRat)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltTrans zeroRat (mulRat a d) zeroRat
                          adPositive
                          (RationalOperations.mulLtZeroNegativePositive
                            a d aNegative dPositive))))
                  rest)
              (RationalOrder.trichotomy d zeroRat);
          \let nuNegative: lt (negRat u) zeroRat :=
            RationalOrder.ltReplaceRight (negRat u) (negRat zeroRat) zeroRat
              (RationalFractions.fractionEqRefl zeroRat)
              (RationalOperations.ltNegReverse zeroRat u uPositive);
          \let first: lt (mulRat b d) (mulRat (negRat u) d) :=
            RationalOperations.ltMulNegativeRight
              (negRat u) b d dNegative nub;
          \let secondRaw:
              lt (mulRat (negRat u) d)
                (mulRat (negRat u) (negRat v)) :=
            RationalOperations.ltMulNegativeLeft
              (negRat u) (negRat v) d nuNegative nvd;
          \let bounded: lt (mulRat b d) (mulRat u v) :=
            RationalOrder.ltReplaceRight (mulRat b d)
              (mulRat (negRat u) (negRat v)) (mulRat u v)
              (RationalOperations.fractionMulNegBoth u v)
              (RationalOrder.ltTrans (mulRat b d)
                (mulRat (negRat u) d)
                (mulRat (negRat u) (negRat v)) first secondRaw);
          \return RationalOrder.ltIrrefl (mulRat u v)
            (RationalOrder.ltTrans (mulRat u v) (mulRat b d)
              (mulRat u v) bd bounded);
        })
      (\fun (rest: Logic.Or[RationalFractions.FractionEq a zeroRat,
        lt zeroRat a]) =>
        Classical.orElim (RationalFractions.FractionEq a zeroRat)
          (lt zeroRat a) Logic.False
          (\fun (az: RationalFractions.FractionEq a zeroRat) =>
            RationalOrder.ltIrrefl zeroRat
              (RationalOrder.ltTrans zeroRat (mulRat u v) zeroRat
                productPositive
                (RationalOrder.ltReplaceRight (mulRat u v) (mulRat a c)
                  zeroRat
                  (RationalFractions.fractionEqTrans _ _ _
                    (RationalOperations.fractionMulRespects
                      a zeroRat c c az
                      (RationalFractions.fractionEqRefl c))
                    (RationalOperations.fractionMulZeroLeft c)) ac)))
          (\fun (aPositive: lt zeroRat a) =>
            \block {
              \let acPositive: lt zeroRat (mulRat a c) :=
                RationalOrder.ltTrans zeroRat (mulRat u v) (mulRat a c)
                  productPositive ac;
              \let cPositive: lt zeroRat c :=
                Classical.orElim (lt c zeroRat)
                  (Logic.Or[RationalFractions.FractionEq c zeroRat,
                    lt zeroRat c]) (lt zeroRat c)
                  (\fun (cNegative: lt c zeroRat) =>
                    Logic.falseElim (lt zeroRat c)
                      (RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltTrans zeroRat (mulRat a c) zeroRat
                          acPositive
                          (RationalOperations.mulLtZeroPositiveNegative
                            a c aPositive cNegative))))
                  (\fun (cRest: Logic.Or[
                    RationalFractions.FractionEq c zeroRat, lt zeroRat c]) =>
                    Classical.orElim (RationalFractions.FractionEq c zeroRat)
                      (lt zeroRat c) (lt zeroRat c)
                      (\fun (cz: RationalFractions.FractionEq c zeroRat) =>
                        Logic.falseElim (lt zeroRat c)
                          (RationalOrder.ltIrrefl zeroRat
                            (RationalOrder.ltReplaceRight zeroRat (mulRat a c)
                              zeroRat
                              (RationalFractions.fractionEqTrans _ _ _
                                (RationalOperations.fractionMulRespects
                                  a a c zeroRat
                                  (RationalFractions.fractionEqRefl a) cz)
                                (RationalOperations.fractionMulZeroRight a))
                              acPositive)))
                      (\fun (cPositive: lt zeroRat c) => cPositive)
                      cRest)
                  (RationalOrder.trichotomy c zeroRat);
              \let first: lt (mulRat a c) (mulRat u c) :=
                RationalOperations.ltMulPositiveRight a u c cPositive au;
              \let second: lt (mulRat u c) (mulRat u v) :=
                RationalOperations.ltMulPositiveLeft u c v uPositive cv;
              \let bounded: lt (mulRat a c) (mulRat u v) :=
                RationalOrder.ltTrans (mulRat a c) (mulRat u c)
                  (mulRat u v) first second;
              \return RationalOrder.ltIrrefl (mulRat u v)
                (RationalOrder.ltTrans (mulRat u v) (mulRat a c)
                  (mulRat u v) ac bounded);
            })
          rest)
      (RationalOrder.trichotomy a zeroRat);
  };

\definition productInhabited (x, y: Real): Inhabited (MulLower x y) :=
  \take (a: \Cast[Rat] ({ a : Rat \where mem x a })) =>
    \take (b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) })) =>
      \take (c: \Cast[Rat] ({ c : Rat \where mem y c })) =>
        \take (d: \Cast[Rat] ({ d : Rat \where Logic.Not (mem y d) })) =>
          \take (u: \Cast[Rat] ({ u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] })) =>
            \take (v: \Cast[Rat] ({ v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] })) =>
              \take (q: \Cast[Rat] ({ q : Rat \where Logic.And[lt q u, lt q v] })) =>
                \block {
                  \let qu: lt q u := Logic.And[lt q u, lt q v]::left
                    (\bysub(Rat, { q : Rat \where Logic.And[lt q u, lt q v] }, q));
                  \let qv: lt q v := Logic.And[lt q u, lt q v]::right
                    (\bysub(Rat, { q : Rat \where Logic.And[lt q u, lt q v] }, q));
                  \let ac: lt q (mulRat a c) :=
                    RationalOrder.ltTrans q u (mulRat a c) qu
                      (Logic.And[lt u (mulRat a c), lt u (mulRat a d)]::left
                        (\bysub(Rat, { u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }, u)));
                  \let ad: lt q (mulRat a d) :=
                    RationalOrder.ltTrans q u (mulRat a d) qu
                      (Logic.And[lt u (mulRat a c), lt u (mulRat a d)]::right
                        (\bysub(Rat, { u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }, u)));
                  \let bc: lt q (mulRat b c) :=
                    RationalOrder.ltTrans q v (mulRat b c) qv
                      (Logic.And[lt v (mulRat b c), lt v (mulRat b d)]::left
                        (\bysub(Rat, { v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }, v)));
                  \let bd: lt q (mulRat b d) :=
                    RationalOrder.ltTrans q v (mulRat b d) qv
                      (Logic.And[lt v (mulRat b c), lt v (mulRat b d)]::right
                        (\bysub(Rat, { v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }, v)));
                  \return \exact(
                    \into[Rat](q, { q : Rat \where In (MulLower x y) q }) \by { productBelowIntro x y q a b c d
                        (\bysub(Rat, { a : Rat \where mem x a }, a))
                        (\bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b))
                        (\bysub(Rat, { c : Rat \where mem y c }, c))
                        (\bysub(Rat, { d : Rat \where Logic.Not (mem y d) }, d))
                        ac ad bc bd },
                    \Cast[Rat] ({ q : Rat \where In (MulLower x y) q }));
                }
              \by { belowBoth u v }
            \by { belowBoth (mulRat b c) (mulRat b d) }
          \by { belowBoth (mulRat a c) (mulRat a d) }
        \by { cutProper y }
      \by { cutInhabited y }
    \by { cutProper x }
  \by { cutInhabited x };


\definition productProper (x, y: Real): Proper (MulLower x y) :=
  \take (u: \Cast[Rat] ({ u : Rat \where Logic.And[lt zeroRat u,
      Logic.And[mem x (negRat u), Logic.Not (mem x u)]] })) =>
    \take (v: \Cast[Rat] ({ v : Rat \where Logic.And[lt zeroRat v,
        Logic.And[mem y (negRat v), Logic.Not (mem y v)]] })) =>
      \block {
        \let uLaw: Logic.And[lt zeroRat u,
            Logic.And[mem x (negRat u), Logic.Not (mem x u)]] :=
          \bysub(Rat, { u : Rat \where Logic.And[lt zeroRat u,
              Logic.And[mem x (negRat u), Logic.Not (mem x u)]] }, u);
        \let vLaw: Logic.And[lt zeroRat v,
            Logic.And[mem y (negRat v), Logic.Not (mem y v)]] :=
          \bysub(Rat, { v : Rat \where Logic.And[lt zeroRat v,
              Logic.And[mem y (negRat v), Logic.Not (mem y v)]] }, v);
        \return \exact(
          \into[Rat](mulRat u v, { q : Rat \where Logic.Not (In (MulLower x y) q) }) \by { \fun (member: ProductBelow x y (mulRat u v)) =>
              productBelowElim x y (mulRat u v) member Logic.False
                (\fun (a, b, c, d: Rat) =>
                  \fun (xa: mem x a) =>
                  \fun (xb: Logic.Not (mem x b)) =>
                  \fun (yc: mem y c) =>
                  \fun (yd: Logic.Not (mem y d)) =>
                  \fun (ac: lt (mulRat u v) (mulRat a c)) =>
                  \fun (ad: lt (mulRat u v) (mulRat a d)) =>
                  \fun (bc: lt (mulRat u v) (mulRat b c)) =>
                  \fun (bd: lt (mulRat u v) (mulRat b d)) =>
                    \block {
                      \let au: lt a u := memberLtOutside x a u xa
                        (Logic.And[mem x (negRat u),
                          Logic.Not (mem x u)]::right
                          (Logic.And[lt zeroRat u,
                            Logic.And[mem x (negRat u),
                              Logic.Not (mem x u)]]::right uLaw));
                      \let nub: lt (negRat u) b :=
                        memberLtOutside x (negRat u) b
                          (Logic.And[mem x (negRat u),
                            Logic.Not (mem x u)]::left
                            (Logic.And[lt zeroRat u,
                              Logic.And[mem x (negRat u),
                                Logic.Not (mem x u)]]::right uLaw)) xb;
                      \let cv: lt c v := memberLtOutside y c v yc
                        (Logic.And[mem y (negRat v),
                          Logic.Not (mem y v)]::right
                          (Logic.And[lt zeroRat v,
                            Logic.And[mem y (negRat v),
                              Logic.Not (mem y v)]]::right vLaw));
                      \let nvd: lt (negRat v) d :=
                        memberLtOutside y (negRat v) d
                          (Logic.And[mem y (negRat v),
                            Logic.Not (mem y v)]::left
                            (Logic.And[lt zeroRat v,
                              Logic.And[mem y (negRat v),
                                Logic.Not (mem y v)]]::right vLaw)) yd;
                      \return positiveCornersImpossible u v a b c d
                        (Logic.And[lt zeroRat u,
                          Logic.And[mem x (negRat u),
                            Logic.Not (mem x u)]]::left uLaw)
                        (Logic.And[lt zeroRat v,
                          Logic.And[mem y (negRat v),
                            Logic.Not (mem y v)]]::left vLaw)
                        au nub cv nvd ac ad bc bd;
                    }) },
          \Cast[Rat] ({ q : Rat \where Logic.Not (In (MulLower x y) q) }));
      }
    \by { symmetricBound y }
  \by { symmetricBound x };

\definition productLower (x, y: Real): Lower (MulLower x y) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: ProductBelow x y q) =>
      productBelowElim x y q member (ProductBelow x y p)
        (\fun (a, b, c, d: Rat) =>
          \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
          \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
          \fun (ac: lt q (mulRat a c)) =>
          \fun (ad: lt q (mulRat a d)) =>
          \fun (bc: lt q (mulRat b c)) =>
          \fun (bd: lt q (mulRat b d)) =>
            productBelowIntro x y p a b c d xa xb yc yd
              (RationalOrder.ltTrans p q (mulRat a c) pq ac)
              (RationalOrder.ltTrans p q (mulRat a d) pq ad)
              (RationalOrder.ltTrans p q (mulRat b c) pq bc)
              (RationalOrder.ltTrans p q (mulRat b d) pq bd));

\definition productRounded (x, y: Real): Rounded (MulLower x y) :=
  \fun (q: Rat) => \fun (member: ProductBelow x y q) =>
    productBelowElim x y q member
      (\exists \Cast[Rat] ({ r : Rat \where Logic.And[In (MulLower x y) r, lt q r] }))
      (\fun (a, b, c, d: Rat) =>
        \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
        \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
        \fun (ac: lt q (mulRat a c)) =>
        \fun (ad: lt q (mulRat a d)) =>
        \fun (bc: lt q (mulRat b c)) =>
        \fun (bd: lt q (mulRat b d)) =>
          \take (u: \Cast[Rat] ({ u : Rat \where Logic.And[lt q u,
              Logic.And[lt u (mulRat a c), lt u (mulRat a d)]] })) =>
            \take (v: \Cast[Rat] ({ v : Rat \where Logic.And[lt q v,
                Logic.And[lt v (mulRat b c), lt v (mulRat b d)]] })) =>
              \take (r: \Cast[Rat] ({ r : Rat \where Logic.And[lt q r, Logic.And[lt r u, lt r v]] })) =>
                \block {
                  \let qr: lt q r :=
                    Logic.And[lt q r, Logic.And[lt r u, lt r v]]::left
                      (\bysub(Rat, { r : Rat \where Logic.And[lt q r, Logic.And[lt r u, lt r v]] }, r));
                  \let ru: lt r u :=
                    Logic.And[lt r u, lt r v]::left
                      (Logic.And[lt q r, Logic.And[lt r u, lt r v]]::right
                        (\bysub(Rat, { r : Rat \where Logic.And[lt q r, Logic.And[lt r u, lt r v]] }, r)));
                  \let rv: lt r v :=
                    Logic.And[lt r u, lt r v]::right
                      (Logic.And[lt q r, Logic.And[lt r u, lt r v]]::right
                        (\bysub(Rat, { r : Rat \where Logic.And[lt q r, Logic.And[lt r u, lt r v]] }, r)));
                  \let uac: lt u (mulRat a c) :=
                    Logic.And[lt u (mulRat a c), lt u (mulRat a d)]::left
                      (Logic.And[lt q u,
                        Logic.And[lt u (mulRat a c), lt u (mulRat a d)]]::right
                        (\bysub(Rat, { u : Rat \where Logic.And[lt q u,
                            Logic.And[lt u (mulRat a c), lt u (mulRat a d)]] }, u)));
                  \let uad: lt u (mulRat a d) :=
                    Logic.And[lt u (mulRat a c), lt u (mulRat a d)]::right
                      (Logic.And[lt q u,
                        Logic.And[lt u (mulRat a c), lt u (mulRat a d)]]::right
                        (\bysub(Rat, { u : Rat \where Logic.And[lt q u,
                            Logic.And[lt u (mulRat a c), lt u (mulRat a d)]] }, u)));
                  \let vbc: lt v (mulRat b c) :=
                    Logic.And[lt v (mulRat b c), lt v (mulRat b d)]::left
                      (Logic.And[lt q v,
                        Logic.And[lt v (mulRat b c), lt v (mulRat b d)]]::right
                        (\bysub(Rat, { v : Rat \where Logic.And[lt q v,
                            Logic.And[lt v (mulRat b c), lt v (mulRat b d)]] }, v)));
                  \let vbd: lt v (mulRat b d) :=
                    Logic.And[lt v (mulRat b c), lt v (mulRat b d)]::right
                      (Logic.And[lt q v,
                        Logic.And[lt v (mulRat b c), lt v (mulRat b d)]]::right
                        (\bysub(Rat, { v : Rat \where Logic.And[lt q v,
                            Logic.And[lt v (mulRat b c), lt v (mulRat b d)]] }, v)));
                  \let rac: lt r (mulRat a c) :=
                    RationalOrder.ltTrans r u (mulRat a c) ru uac;
                  \let rad: lt r (mulRat a d) :=
                    RationalOrder.ltTrans r u (mulRat a d) ru uad;
                  \let rbc: lt r (mulRat b c) :=
                    RationalOrder.ltTrans r v (mulRat b c) rv vbc;
                  \let rbd: lt r (mulRat b d) :=
                    RationalOrder.ltTrans r v (mulRat b d) rv vbd;
                  \return \exact(
                    \into[Rat](r, { r : Rat \where Logic.And[In (MulLower x y) r, lt q r] }) \by { \record Logic.And[In (MulLower x y) r, lt q r] {
                        left := productBelowIntro x y r a b c d
                          xa xb yc yd rac rad rbc rbd,
                        right := qr,
                      } },
                    \Cast[Rat] ({ r : Rat \where Logic.And[In (MulLower x y) r, lt q r] }));
                }
              \by { betweenBoth q u v
                (Logic.And[lt q u,
                  Logic.And[lt u (mulRat a c), lt u (mulRat a d)]]::left
                  (\bysub(Rat, { u : Rat \where Logic.And[lt q u,
                      Logic.And[lt u (mulRat a c), lt u (mulRat a d)]] }, u)))
                (Logic.And[lt q v,
                  Logic.And[lt v (mulRat b c), lt v (mulRat b d)]]::left
                  (\bysub(Rat, { v : Rat \where Logic.And[lt q v,
                      Logic.And[lt v (mulRat b c), lt v (mulRat b d)]] }, v))) }
            \by { betweenBoth q (mulRat b c) (mulRat b d) bc bd }
          \by { betweenBoth q (mulRat a c) (mulRat a d) ac ad });

\definition productRespects (x, y: Real): RespectsFractionEq (MulLower x y) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (member: ProductBelow x y p) =>
        productBelowElim x y p member (ProductBelow x y q)
          (\fun (a, b, c, d: Rat) =>
            \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
            \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
            \fun (ac: lt p (mulRat a c)) =>
            \fun (ad: lt p (mulRat a d)) =>
            \fun (bc: lt p (mulRat b c)) =>
            \fun (bd: lt p (mulRat b d)) =>
              productBelowIntro x y q a b c d xa xb yc yd
                (RationalOrder.ltReplaceLeft p q (mulRat a c) pq ac)
                (RationalOrder.ltReplaceLeft p q (mulRat a d) pq ad)
                (RationalOrder.ltReplaceLeft p q (mulRat b c) pq bc)
                (RationalOrder.ltReplaceLeft p q (mulRat b d) pq bd));

\definition mulCut (x, y: Real):
  \In[\Pow (Rat)] (CutSet) (MulLower x y) :=
  \record Logic.And[Inhabited (MulLower x y),
    Logic.And[Proper (MulLower x y),
      Logic.And[Lower (MulLower x y),
        Logic.And[Rounded (MulLower x y),
          Logic.And[Located (MulLower x y),
            RespectsFractionEq (MulLower x y)]]]]] {
    left := productInhabited x y,
    right := \record Logic.And[Proper (MulLower x y),
      Logic.And[Lower (MulLower x y),
        Logic.And[Rounded (MulLower x y),
          Logic.And[Located (MulLower x y),
            RespectsFractionEq (MulLower x y)]]]] {
      left := productProper x y,
      right := \record Logic.And[Lower (MulLower x y),
        Logic.And[Rounded (MulLower x y),
          Logic.And[Located (MulLower x y),
            RespectsFractionEq (MulLower x y)]]] {
        left := productLower x y,
        right := \record Logic.And[Rounded (MulLower x y),
          Logic.And[Located (MulLower x y),
            RespectsFractionEq (MulLower x y)]] {
          left := productRounded x y,
          right := \record Logic.And[Located (MulLower x y),
            RespectsFractionEq (MulLower x y)] {
            left := lowerLocated (MulLower x y) (productLower x y),
            right := productRespects x y,
          },
        },
      },
    },
  };

\definition reciprocalBelowIntro (x: Real) (q, a, b, r: Rat)
  (xa: mem x a) (xb: Logic.Not (mem x b))
  (positive: lt zeroRat (mulRat a b))
  (law: RationalFractions.FractionEq (mulRat b r) oneRat)
  (qr: lt q r): ReciprocalBelow x q :=
  \fun (P: \Prop) =>
    \fun (use: \forall (a, b, r: Rat) -> mem x a ->
      Logic.Not (mem x b) -> lt zeroRat (mulRat a b) ->
      RationalFractions.FractionEq (mulRat b r) oneRat ->
      lt q r -> P) =>
      use a b r xa xb positive law qr;

\definition reciprocalBelowElim (x: Real) (q: Rat)
  (member: ReciprocalBelow x q) (P: \Prop)
  (use: \forall (a, b, r: Rat) -> mem x a ->
    Logic.Not (mem x b) -> lt zeroRat (mulRat a b) ->
    RationalFractions.FractionEq (mulRat b r) oneRat ->
    lt q r -> P): P :=
  member P use;

\definition zeroReal: Real :=
  \into[\Pow (Rat)](RatLower zeroRat, CutSet) \by { ratCut zeroRat };

\definition zeroRealMem (q: Rat) (negative: lt q zeroRat):
  mem zeroReal q :=
  \idelim(RatLower zeroRat = underlying zeroReal
    \with T: \Pow (Rat) => \In[Rat] (T) (q))
    \by { base: negative, equality: \refl(RatLower zeroRat) };

\definition zeroRealMemLt (q: Rat) (member: mem zeroReal q):
  lt q zeroRat :=
  \idelim(underlying zeroReal = RatLower zeroRat
    \with T: \Pow (Rat) => \In[Rat] (T) (q))
    \by { base: member, equality: \refl(RatLower zeroRat) };

\definition zeroLtOfNotNegativeLt (t, a: Rat)
  (notNegative: Logic.Not (lt t zeroRat)) (ta: lt t a):
  lt zeroRat a :=
  Classical.orElim (lt zeroRat t)
    (Logic.Or[RationalFractions.FractionEq zeroRat t, lt t zeroRat])
    (lt zeroRat a)
    (\fun (positive: lt zeroRat t) =>
      RationalOrder.ltTrans zeroRat t a positive ta)
    (\fun (rest: Logic.Or[
      RationalFractions.FractionEq zeroRat t, lt t zeroRat]) =>
      Classical.orElim (RationalFractions.FractionEq zeroRat t)
        (lt t zeroRat) (lt zeroRat a)
        (\fun (same: RationalFractions.FractionEq zeroRat t) =>
          RationalOrder.ltReplaceLeft t zeroRat a
            (RationalFractions.fractionEqSym _ _ same) ta)
        (\fun (negative: lt t zeroRat) =>
          Logic.falseElim (lt zeroRat a) (notNegative negative))
        rest)
    (RationalOrder.trichotomy zeroRat t);

\definition invInhabitedAboveZero (x: Real)
  (nonzero: Logic.Not (underlying x = RatLower zeroRat))
  (positive: Lt zeroReal x): Inhabited (InvLower x) :=
  \take (t: \Cast[Rat] ({ t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] })) =>
    \take (a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, lt t a] })) =>
      \take (b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) })) =>
        \block {
          \let separation: Logic.And[
              Logic.Not (mem zeroReal t), mem x t] :=
            \bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t);
          \let rounded: Logic.And[mem x a, lt t a] :=
            \bysub(Rat, { a : Rat \where Logic.And[mem x a, lt t a] }, a);
          \let xa: mem x a :=
            Logic.And[mem x a, lt t a]::left rounded;
          \let xb: Logic.Not (mem x b) :=
            \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b);
          \let notNegative: Logic.Not (lt t zeroRat) :=
            \fun (negative: lt t zeroRat) =>
              Logic.And[Logic.Not (mem zeroReal t), mem x t]::left
                separation (zeroRealMem t negative);
          \let aPositive: lt zeroRat a :=
            zeroLtOfNotNegativeLt t a notNegative
              (Logic.And[mem x a, lt t a]::right rounded);
          \let ab: lt a b := memberLtOutside x a b xa xb;
          \let bPositive: lt zeroRat b :=
            RationalOrder.ltTrans zeroRat a b aPositive ab;
          \let r: Rat := RationalOperations.reciprocal b;
          \let law: RationalFractions.FractionEq (mulRat b r) oneRat :=
            RationalOperations.fractionMulReciprocal b
              (RationalOperations.numeratorNonZeroOfZeroLt b bPositive);
          \let q: Rat := RationalOperations.below r;
          \return \exact(
            \into[Rat](q, { q : Rat \where In (InvLower x) q }) \by { Logic.Or[
                Logic.And[underlying x = RatLower zeroRat,
                  lt q zeroRat],
                Logic.And[Logic.Not (underlying x = RatLower zeroRat),
                  ReciprocalBelow x q]]::right
                (\record Logic.And[
                  Logic.Not (underlying x = RatLower zeroRat),
                  ReciprocalBelow x q] {
                    left := nonzero,
                    right := reciprocalBelowIntro x q a b r xa xb
                      (RationalOperations.zeroLtMulPositive a b
                        aPositive bPositive)
                      law (RationalOperations.belowLt r),
                }) },
            \Cast[Rat] ({ q : Rat \where In (InvLower x) q }));
        }
      \by { cutProper x }
    \by { cutRounded x t
      (Logic.And[Logic.Not (mem zeroReal t), mem x t]::right
        (\bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t))) }
  \by { positive };

\definition invInhabitedBelowZero (x: Real)
  (nonzero: Logic.Not (underlying x = RatLower zeroRat))
  (negative: Lt x zeroReal): Inhabited (InvLower x) :=
  \take (b: \Cast[Rat] ({ b : Rat \where Logic.And[Logic.Not (mem x b), mem zeroReal b] })) =>
    \take (a: \Cast[Rat] ({ a : Rat \where mem x a })) =>
      \block {
        \let separation: Logic.And[
            Logic.Not (mem x b), mem zeroReal b] :=
          \bysub(Rat, { b : Rat \where Logic.And[Logic.Not (mem x b), mem zeroReal b] }, b);
        \let xa: mem x a :=
          \bysub(Rat, { a : Rat \where mem x a }, a);
        \let xb: Logic.Not (mem x b) :=
          Logic.And[Logic.Not (mem x b), mem zeroReal b]::left separation;
        \let bNegative: lt b zeroRat := zeroRealMemLt b
          (Logic.And[Logic.Not (mem x b), mem zeroReal b]::right separation);
        \let ab: lt a b := memberLtOutside x a b xa xb;
        \let aNegative: lt a zeroRat :=
          RationalOrder.ltTrans a b zeroRat ab bNegative;
        \let r: Rat := RationalOperations.reciprocal b;
        \let law: RationalFractions.FractionEq (mulRat b r) oneRat :=
          RationalOperations.fractionMulReciprocal b
            (RationalOperations.numeratorNonZeroOfLtZero b bNegative);
        \let q: Rat := RationalOperations.below r;
        \return \exact(
          \into[Rat](q, { q : Rat \where In (InvLower x) q }) \by { Logic.Or[
              Logic.And[underlying x = RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x q]]::right
              (\record Logic.And[
                Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x q] {
                  left := nonzero,
                  right := reciprocalBelowIntro x q a b r xa xb
                    (RationalOperations.zeroLtMulNegative a b
                      aNegative bNegative)
                    law (RationalOperations.belowLt r),
              }) },
          \Cast[Rat] ({ q : Rat \where In (InvLower x) q }));
      }
    \by { cutInhabited x }
  \by { negative };

\definition invInhabited (x: Real): Inhabited (InvLower x) :=
  Classical.orElim (underlying x = RatLower zeroRat)
    (Logic.Not (underlying x = RatLower zeroRat))
    (Inhabited (InvLower x))
    (\fun (zero: underlying x = RatLower zeroRat) =>
      \exact(
        \into[Rat](RationalOperations.below zeroRat, { q : Rat \where In (InvLower x) q }) \by { Logic.Or[
            Logic.And[underlying x = RatLower zeroRat,
              lt (RationalOperations.below zeroRat) zeroRat],
            Logic.And[Logic.Not (underlying x = RatLower zeroRat),
              ReciprocalBelow x (RationalOperations.below zeroRat)]]::left
            (\record Logic.And[underlying x = RatLower zeroRat,
              lt (RationalOperations.below zeroRat) zeroRat] {
                left := zero,
                right := RationalOperations.belowLt zeroRat,
            }) },
        \Cast[Rat] ({ q : Rat \where In (InvLower x) q })))
    (\fun (nonzero: Logic.Not (underlying x = RatLower zeroRat)) =>
      Classical.orElim (Lt x zeroReal)
        (Logic.Or[x = zeroReal, Lt zeroReal x])
        (Inhabited (InvLower x))
        (\fun (negative: Lt x zeroReal) =>
          invInhabitedBelowZero x nonzero negative)
        (\fun (rest: Logic.Or[x = zeroReal, Lt zeroReal x]) =>
          Classical.orElim (x = zeroReal) (Lt zeroReal x)
            (Inhabited (InvLower x))
            (\fun (same: x = zeroReal) =>
              Logic.falseElim (Inhabited (InvLower x))
                (nonzero
                  (\idelim(zeroReal = x
                    \with z: Real => underlying z = RatLower zeroRat)
                    \by { base: \refl(RatLower zeroRat), equality:
                      sym!{Real} x zeroReal same })))
            (\fun (positive: Lt zeroReal x) =>
              invInhabitedAboveZero x nonzero positive)
            rest)
        (CutOrder.ltTrichotomy x zeroReal))
    (Classical.excludedMiddle (underlying x = RatLower zeroRat));

\definition invLower (x: Real): Lower (InvLower x) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: In (InvLower x) q) =>
      Classical.orElim
        (Logic.And[underlying x = RatLower zeroRat, lt q zeroRat])
        (Logic.And[Logic.Not (underlying x = RatLower zeroRat),
          ReciprocalBelow x q])
        (In (InvLower x) p)
        (\fun (atZero: Logic.And[
          underlying x = RatLower zeroRat, lt q zeroRat]) =>
          Logic.Or[
            Logic.And[underlying x = RatLower zeroRat, lt p zeroRat],
            Logic.And[Logic.Not (underlying x = RatLower zeroRat),
              ReciprocalBelow x p]]::left
            (\record Logic.And[
              underlying x = RatLower zeroRat, lt p zeroRat] {
                left := Logic.And[
                  underlying x = RatLower zeroRat, lt q zeroRat]::left atZero,
                right := RationalOrder.ltTrans p q zeroRat pq
                  (Logic.And[
                    underlying x = RatLower zeroRat,
                    lt q zeroRat]::right atZero),
            }))
        (\fun (away: Logic.And[
          Logic.Not (underlying x = RatLower zeroRat),
          ReciprocalBelow x q]) =>
          Logic.Or[
            Logic.And[underlying x = RatLower zeroRat, lt p zeroRat],
            Logic.And[Logic.Not (underlying x = RatLower zeroRat),
              ReciprocalBelow x p]]::right
            (\record Logic.And[
              Logic.Not (underlying x = RatLower zeroRat),
              ReciprocalBelow x p] {
                left := Logic.And[
                  Logic.Not (underlying x = RatLower zeroRat),
                  ReciprocalBelow x q]::left away,
                right := reciprocalBelowElim x q
                  (Logic.And[
                    Logic.Not (underlying x = RatLower zeroRat),
                    ReciprocalBelow x q]::right away)
                  (ReciprocalBelow x p)
                  (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
                    \fun (xb: Logic.Not (mem x b)) =>
                    \fun (positive: lt zeroRat (mulRat a b)) =>
                    \fun (law: RationalFractions.FractionEq
                      (mulRat b r) oneRat) =>
                    \fun (qr: lt q r) =>
                      reciprocalBelowIntro x p a b r xa xb positive law
                        (RationalOrder.ltTrans p q r pq qr)),
            }))
        member;

\definition invRounded (x: Real): Rounded (InvLower x) :=
  \fun (q: Rat) => \fun (member: In (InvLower x) q) =>
    Classical.orElim
      (Logic.And[underlying x = RatLower zeroRat, lt q zeroRat])
      (Logic.And[Logic.Not (underlying x = RatLower zeroRat),
        ReciprocalBelow x q])
      (\exists \Cast[Rat] ({ r : Rat \where Logic.And[In (InvLower x) r, lt q r] }))
      (\fun (atZero: Logic.And[
        underlying x = RatLower zeroRat, lt q zeroRat]) =>
        \block {
          \let r: Rat := RationalOperations.midpoint q zeroRat;
          \return \exact(
            \into[Rat](r, { r : Rat \where Logic.And[In (InvLower x) r, lt q r] }) \by { \record Logic.And[In (InvLower x) r, lt q r] {
                left := Logic.Or[
                  Logic.And[underlying x = RatLower zeroRat,
                    lt r zeroRat],
                  Logic.And[Logic.Not (underlying x = RatLower zeroRat),
                    ReciprocalBelow x r]]::left
                  (\record Logic.And[
                    underlying x = RatLower zeroRat, lt r zeroRat] {
                      left := Logic.And[
                        underlying x = RatLower zeroRat,
                        lt q zeroRat]::left atZero,
                      right := RationalOperations.midpointLt q zeroRat
                        (Logic.And[
                          underlying x = RatLower zeroRat,
                          lt q zeroRat]::right atZero),
                  }),
                right := RationalOperations.ltMidpoint q zeroRat
                  (Logic.And[
                    underlying x = RatLower zeroRat,
                    lt q zeroRat]::right atZero),
              } },
            \Cast[Rat] ({ r : Rat \where Logic.And[In (InvLower x) r, lt q r] }));
        })
      (\fun (away: Logic.And[
        Logic.Not (underlying x = RatLower zeroRat),
        ReciprocalBelow x q]) =>
        reciprocalBelowElim x q
          (Logic.And[
            Logic.Not (underlying x = RatLower zeroRat),
            ReciprocalBelow x q]::right away)
          (\exists \Cast[Rat] ({ s : Rat \where Logic.And[In (InvLower x) s, lt q s] }))
          (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
            \fun (xb: Logic.Not (mem x b)) =>
            \fun (positive: lt zeroRat (mulRat a b)) =>
            \fun (law: RationalFractions.FractionEq
              (mulRat b r) oneRat) =>
            \fun (qr: lt q r) =>
              \block {
                \let s: Rat := RationalOperations.midpoint q r;
                \return \exact(
                  \into[Rat](s, { s : Rat \where Logic.And[In (InvLower x) s, lt q s] }) \by { \record Logic.And[In (InvLower x) s, lt q s] {
                      left := Logic.Or[
                        Logic.And[underlying x = RatLower zeroRat,
                          lt s zeroRat],
                        Logic.And[
                          Logic.Not (underlying x = RatLower zeroRat),
                          ReciprocalBelow x s]]::right
                        (\record Logic.And[
                          Logic.Not (underlying x = RatLower zeroRat),
                          ReciprocalBelow x s] {
                            left := Logic.And[
                              Logic.Not
                                (underlying x = RatLower zeroRat),
                              ReciprocalBelow x q]::left away,
                            right := reciprocalBelowIntro x s a b r xa xb
                              positive law
                              (RationalOperations.midpointLt q r qr),
                        }),
                      right := RationalOperations.ltMidpoint q r qr,
                    } },
                  \Cast[Rat] ({ s : Rat \where Logic.And[In (InvLower x) s, lt q s] }));
              }))
      member;

\definition invRespects (x: Real): RespectsFractionEq (InvLower x) :=
  \fun (p, q: Rat) =>
    \fun (same: RationalFractions.FractionEq p q) =>
      \fun (member: In (InvLower x) p) =>
        Classical.orElim
          (Logic.And[underlying x = RatLower zeroRat, lt p zeroRat])
          (Logic.And[Logic.Not (underlying x = RatLower zeroRat),
            ReciprocalBelow x p])
          (In (InvLower x) q)
          (\fun (atZero: Logic.And[
            underlying x = RatLower zeroRat, lt p zeroRat]) =>
            Logic.Or[
              Logic.And[underlying x = RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x q]]::left
              (\record Logic.And[
                underlying x = RatLower zeroRat, lt q zeroRat] {
                  left := Logic.And[
                    underlying x = RatLower zeroRat,
                    lt p zeroRat]::left atZero,
                  right := RationalOrder.ltReplaceLeft p q zeroRat same
                    (Logic.And[
                      underlying x = RatLower zeroRat,
                      lt p zeroRat]::right atZero),
              }))
          (\fun (away: Logic.And[
            Logic.Not (underlying x = RatLower zeroRat),
            ReciprocalBelow x p]) =>
            Logic.Or[
              Logic.And[underlying x = RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x q]]::right
              (\record Logic.And[
                Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x q] {
                  left := Logic.And[
                    Logic.Not (underlying x = RatLower zeroRat),
                    ReciprocalBelow x p]::left away,
                  right := reciprocalBelowElim x p
                    (Logic.And[
                      Logic.Not (underlying x = RatLower zeroRat),
                      ReciprocalBelow x p]::right away)
                    (ReciprocalBelow x q)
                    (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
                      \fun (xb: Logic.Not (mem x b)) =>
                      \fun (positive: lt zeroRat (mulRat a b)) =>
                      \fun (law: RationalFractions.FractionEq
                        (mulRat b r) oneRat) =>
                      \fun (pr: lt p r) =>
                        reciprocalBelowIntro x q a b r xa xb positive law
                          (RationalOrder.ltReplaceLeft p q r same pr)),
              }))
          member;

\definition invProperAtZero (x: Real)
  (zero: underlying x = RatLower zeroRat): Proper (InvLower x) :=
  \exact(
    \into[Rat](zeroRat, { q : Rat \where Logic.Not (In (InvLower x) q) }) \by { \fun (member: In (InvLower x) zeroRat) =>
        Classical.orElim
          (Logic.And[underlying x = RatLower zeroRat,
            lt zeroRat zeroRat])
          (Logic.And[Logic.Not (underlying x = RatLower zeroRat),
            ReciprocalBelow x zeroRat])
          Logic.False
          (\fun (atZero: Logic.And[
            underlying x = RatLower zeroRat, lt zeroRat zeroRat]) =>
            RationalOrder.ltIrrefl zeroRat
              (Logic.And[
                underlying x = RatLower zeroRat,
                lt zeroRat zeroRat]::right atZero))
          (\fun (away: Logic.And[
            Logic.Not (underlying x = RatLower zeroRat),
            ReciprocalBelow x zeroRat]) =>
            Logic.And[
              Logic.Not (underlying x = RatLower zeroRat),
              ReciprocalBelow x zeroRat]::left away zero)
          member },
    \Cast[Rat] ({ q : Rat \where Logic.Not (In (InvLower x) q) }));

\definition invProperBelowZero (x: Real)
  (nonzero: Logic.Not (underlying x = RatLower zeroRat))
  (negative: Lt x zeroReal): Proper (InvLower x) :=
  \take (u: \Cast[Rat] ({ u : Rat \where Logic.And[Logic.Not (mem x u), mem zeroReal u] })) =>
    \block {
      \let separation: Logic.And[
          Logic.Not (mem x u), mem zeroReal u] :=
        \bysub(Rat, { u : Rat \where Logic.And[Logic.Not (mem x u), mem zeroReal u] }, u);
      \let xu: Logic.Not (mem x u) :=
        Logic.And[Logic.Not (mem x u), mem zeroReal u]::left separation;
      \let uNegative: lt u zeroRat := zeroRealMemLt u
        (Logic.And[Logic.Not (mem x u), mem zeroReal u]::right separation);
      \return \exact(
        \into[Rat](zeroRat, { q : Rat \where Logic.Not (In (InvLower x) q) }) \by { \fun (member: In (InvLower x) zeroRat) =>
            Classical.orElim
              (Logic.And[underlying x = RatLower zeroRat,
                lt zeroRat zeroRat])
              (Logic.And[Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x zeroRat])
              Logic.False
              (\fun (atZero: Logic.And[
                underlying x = RatLower zeroRat, lt zeroRat zeroRat]) =>
                nonzero (Logic.And[
                  underlying x = RatLower zeroRat,
                  lt zeroRat zeroRat]::left atZero))
              (\fun (away: Logic.And[
                Logic.Not (underlying x = RatLower zeroRat),
                ReciprocalBelow x zeroRat]) =>
                reciprocalBelowElim x zeroRat
                  (Logic.And[
                    Logic.Not (underlying x = RatLower zeroRat),
                    ReciprocalBelow x zeroRat]::right away)
                  Logic.False
                  (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
                    \fun (_: Logic.Not (mem x b)) =>
                    \fun (productPositive: lt zeroRat (mulRat a b)) =>
                    \fun (law: RationalFractions.FractionEq
                      (mulRat b r) oneRat) =>
                    \fun (zeroR: lt zeroRat r) =>
                      \block {
                        \let au: lt a u := memberLtOutside x a u xa xu;
                        \let aNegative: lt a zeroRat :=
                          RationalOrder.ltTrans a u zeroRat au uNegative;
                        \let bNegative: lt b zeroRat :=
                          RationalOperations.negativeRightOfPositiveProduct
                            a b aNegative productPositive;
                        \let rNegative: lt r zeroRat :=
                          RationalOperations.negativeOfNegativeProductOne
                            b r bNegative law;
                        \return RationalOrder.ltIrrefl zeroRat
                          (RationalOrder.ltTrans zeroRat r zeroRat
                            zeroR rNegative);
                      }))
              member },
          \Cast[Rat] ({ q : Rat \where Logic.Not (In (InvLower x) q) }));
    }
  \by { negative };

\definition invProperAboveZero (x: Real)
  (nonzero: Logic.Not (underlying x = RatLower zeroRat))
  (positive: Lt zeroReal x): Proper (InvLower x) :=
  \take (t: \Cast[Rat] ({ t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] })) =>
    \take (a0: \Cast[Rat] ({ a0 : Rat \where Logic.And[mem x a0, lt t a0] })) =>
      \block {
        \let separation: Logic.And[
            Logic.Not (mem zeroReal t), mem x t] :=
          \bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t);
        \let rounded: Logic.And[mem x a0, lt t a0] :=
          \bysub(Rat, { a0 : Rat \where Logic.And[mem x a0, lt t a0] }, a0);
        \let xa0: mem x a0 :=
          Logic.And[mem x a0, lt t a0]::left rounded;
        \let notNegative: Logic.Not (lt t zeroRat) :=
          \fun (negative: lt t zeroRat) =>
            Logic.And[Logic.Not (mem zeroReal t), mem x t]::left
              separation (zeroRealMem t negative);
        \let a0Positive: lt zeroRat a0 :=
          zeroLtOfNotNegativeLt t a0 notNegative
            (Logic.And[mem x a0, lt t a0]::right rounded);
        \let s: Rat := RationalOperations.reciprocal a0;
        \let a0Law: RationalFractions.FractionEq
            (mulRat a0 s) oneRat :=
          RationalOperations.fractionMulReciprocal a0
            (RationalOperations.numeratorNonZeroOfZeroLt a0 a0Positive);
        \return \exact(
          \into[Rat](s, { q : Rat \where Logic.Not (In (InvLower x) q) }) \by { \fun (member: In (InvLower x) s) =>
              Classical.orElim
                (Logic.And[underlying x = RatLower zeroRat,
                  lt s zeroRat])
                (Logic.And[
                  Logic.Not (underlying x = RatLower zeroRat),
                  ReciprocalBelow x s])
                Logic.False
                (\fun (atZero: Logic.And[
                  underlying x = RatLower zeroRat, lt s zeroRat]) =>
                  nonzero (Logic.And[
                    underlying x = RatLower zeroRat,
                    lt s zeroRat]::left atZero))
                (\fun (away: Logic.And[
                  Logic.Not (underlying x = RatLower zeroRat),
                  ReciprocalBelow x s]) =>
                  reciprocalBelowElim x s
                    (Logic.And[
                      Logic.Not (underlying x = RatLower zeroRat),
                      ReciprocalBelow x s]::right away)
                    Logic.False
                    (\fun (a, b, r: Rat) =>
                      \fun (unusedXa: mem x a) =>
                      \fun (xb: Logic.Not (mem x b)) =>
                      \fun (unusedPositive: lt zeroRat (mulRat a b)) =>
                      \fun (law: RationalFractions.FractionEq
                        (mulRat b r) oneRat) =>
                      \fun (sr: lt s r) =>
                        \block {
                          \let a0b: lt a0 b :=
                            memberLtOutside x a0 b xa0 xb;
                          \let rs: lt r s :=
                            RationalOperations.reciprocalOrderPositive
                              a0 b r s a0Positive a0b law a0Law;
                          \return RationalOrder.ltIrrefl s
                            (RationalOrder.ltTrans s r s sr rs);
                        }))
                member },
            \Cast[Rat] ({ q : Rat \where Logic.Not (In (InvLower x) q) }));
      }
    \by { cutRounded x t
      (Logic.And[Logic.Not (mem zeroReal t), mem x t]::right
        (\bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t))) }
  \by { positive };

\definition invProper (x: Real): Proper (InvLower x) :=
  Classical.orElim (underlying x = RatLower zeroRat)
    (Logic.Not (underlying x = RatLower zeroRat))
    (Proper (InvLower x))
    (\fun (zero: underlying x = RatLower zeroRat) =>
      invProperAtZero x zero)
    (\fun (nonzero: Logic.Not (underlying x = RatLower zeroRat)) =>
      Classical.orElim (Lt x zeroReal)
        (Logic.Or[x = zeroReal, Lt zeroReal x])
        (Proper (InvLower x))
        (\fun (negative: Lt x zeroReal) =>
          invProperBelowZero x nonzero negative)
        (\fun (rest: Logic.Or[x = zeroReal, Lt zeroReal x]) =>
          Classical.orElim (x = zeroReal) (Lt zeroReal x)
            (Proper (InvLower x))
            (\fun (same: x = zeroReal) =>
              Logic.falseElim (Proper (InvLower x))
                (nonzero
                  (\idelim(zeroReal = x
                    \with z: Real => underlying z = RatLower zeroRat)
                    \by { base: \refl(RatLower zeroRat), equality:
                      sym!{Real} x zeroReal same })))
            (\fun (positive: Lt zeroReal x) =>
              invProperAboveZero x nonzero positive)
            rest)
        (CutOrder.ltTrichotomy x zeroReal))
    (Classical.excludedMiddle (underlying x = RatLower zeroRat));

\definition invCut (x: Real):
  \In[\Pow (Rat)] (CutSet) (InvLower x) :=
  \record Logic.And[Inhabited (InvLower x),
    Logic.And[Proper (InvLower x),
      Logic.And[Lower (InvLower x),
        Logic.And[Rounded (InvLower x),
          Logic.And[Located (InvLower x),
            RespectsFractionEq (InvLower x)]]]]] {
    left := invInhabited x,
    right := \record Logic.And[Proper (InvLower x),
      Logic.And[Lower (InvLower x),
        Logic.And[Rounded (InvLower x),
          Logic.And[Located (InvLower x),
            RespectsFractionEq (InvLower x)]]]] {
      left := invProper x,
      right := \record Logic.And[Lower (InvLower x),
        Logic.And[Rounded (InvLower x),
          Logic.And[Located (InvLower x),
            RespectsFractionEq (InvLower x)]]] {
        left := invLower x,
        right := \record Logic.And[Rounded (InvLower x),
          Logic.And[Located (InvLower x),
            RespectsFractionEq (InvLower x)]] {
          left := invRounded x,
          right := \record Logic.And[Located (InvLower x),
            RespectsFractionEq (InvLower x)] {
            left := lowerLocated (InvLower x) (invLower x),
            right := invRespects x,
          },
        },
      },
    },
  };
