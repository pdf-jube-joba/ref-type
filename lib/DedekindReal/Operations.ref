\import \root.Logic() \as Logic;

\definition RatLower (a: Rat): \Power(Rat) := \Subset(q, Rat, lt q a);

\definition SumLower (x, y: Real): \Power(Rat) :=
    \Subset(q, Rat,
      \exists \Ty(Rat,
        \Subset(a, Rat,
          Logic.And[mem x a,
            \exists \Ty(Rat,
              \Subset(b, Rat,
                Logic.And[mem y b, lt q (addRat a b)]))])));

\definition NegLower (x: Real): \Power(Rat) :=
    \Subset(q, Rat,
      \exists \Ty(Rat,
        \Subset(r, Rat,
          Logic.And[Logic.Not (mem x r), lt q (negRat r)])));

\module Closed(
  ratCut: \forall (a: Rat) ->
    \Pred(\Power(Rat), CutSet, RatLower a),
  sumCut: \forall (x, y: Real) ->
    \Pred(\Power(Rat), CutSet, SumLower x y),
  negCut: \forall (x: Real) ->
    \Pred(\Power(Rat), CutSet, NegLower x),
);
