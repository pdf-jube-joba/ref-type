\import \root.Logic() \as Logic;

\definition RatLower (a: Rat): \Power(Rat) := \Subset(q, Rat, lt q a);

\definition SumLower (x, y: Real): \Power(Rat) :=
    \Subset(q, Rat,
      \exists \Ty(Rat,
        \Subset(a, Rat,
          Logic.And[mem x a,
            \exists \Ty(Rat,
              \Subset(b, Rat,
                Logic.And[mem y b, lt q (addRat a b)]))])));

\definition NegLower (x: Real): \Power(Rat) :=
    \Subset(q, Rat,
      \exists \Ty(Rat,
        \Subset(r, Rat,
                Logic.And[Logic.Not (mem x r), lt q (negRat r)])));

/* Multiplication and inversion are exposed with explicit closure
 * obligations.  Their lower-set formulas are intentionally parameters: the
 * sign cases are substantial, while the resulting Real-level API is uniform.
 */
\definition MulLower (x, y: Real): \Power(Rat) :=
    \Subset(q, Rat,
      \exists \Ty(Rat,
        \Subset(a, Rat,
          Logic.And[mem x a,
            \exists \Ty(Rat,
              \Subset(b, Rat,
                Logic.And[mem y b, lt q (mulRat a b)]))])));

\definition InvLower (x: Real): \Power(Rat) :=
    \Subset(q, Rat, Logic.False);

\module Closed(
  ratCut: \forall (a: Rat) ->
    \Pred(\Power(Rat), CutSet, RatLower a),
  sumCut: \forall (x, y: Real) ->
    \Pred(\Power(Rat), CutSet, SumLower x y),
  negCut: \forall (x: Real) ->
    \Pred(\Power(Rat), CutSet, NegLower x),
  mulLower: \forall (x, y: Real) ->
    \Pred(\Power(Rat), CutSet, MulLower x y),
  invLower: \forall (x: Real) ->
    \Pred(\Power(Rat), CutSet, InvLower x),
);
