/* A nonempty, bounded family of cuts has its union as least upper bound.
 * Classical.excludedMiddle uses the existing choice and setext axioms. */
\import \root.Classical[] \as Classical;
\import \root.AxiomaticReals[Carrier := Real] \as AR;

\definition Member (S: \Pow (Real)) (x: Real): \Prop := \In[Real] (S) (x);
\definition Nonempty (S: \Pow (Real)): \Prop :=
  \exists \Cast[Real] ({ x : Real \where Member S x });
\definition UpperBound (S: \Pow (Real)) (u: Real): \Prop :=
  \forall (x: Real) -> Member S x -> Le x u;
\definition Bounded (S: \Pow (Real)): \Prop :=
  \exists \Cast[Real] ({ u : Real \where UpperBound S u });
\definition LeastUpperBound (S: \Pow (Real)) (u: Real): \Prop :=
  Logic.And[UpperBound S u, \forall (v: Real) -> UpperBound S v -> Le u v];

/* Church existential: there is x in S containing q. */
\definition UnionMember (S: \Pow (Real)) (q: Rat): \Prop :=
  \forall (P: \Prop) -> (\forall (x: Real) -> Member S x -> mem x q -> P) -> P;
\definition Union (S: \Pow (Real)): \Pow (Rat) :=
  { q : Rat \where UnionMember S q };
\definition unionIntro (S: \Pow (Real)) (x: Real) (sx: Member S x)
  (q: Rat) (xq: mem x q) (P: \Prop)
  (use: \forall (y: Real) -> Member S y -> mem y q -> P): P := use x sx xq;

\definition unionInhabited (S: \Pow (Real)) (nonempty: Nonempty S): Inhabited (Union S) :=
  \take (x: \Cast[Real] ({ x : Real \where Member S x })) =>
    \take (q: \Cast[Rat] ({ q : Rat \where mem x q })) =>
      \exact(
        \into[Rat](q, Union S) \by { unionIntro S x (\bysub(Real, { x : Real \where Member S x }, x)) q
            (\bysub(Rat, { q : Rat \where mem x q }, q)) },
        \Cast[Rat] ({ q : Rat \where In (Union S) q }))
    \by { cutInhabited x }
  \by { nonempty };

\definition unionProper (S: \Pow (Real)) (bounded: Bounded S): Proper (Union S) :=
  \take (u: \Cast[Real] ({ u : Real \where UpperBound S u })) =>
    \take (q: \Cast[Rat] ({ q : Rat \where Logic.Not (mem u q) })) =>
      \exact(
        \into[Rat](q, { q : Rat \where Logic.Not (In (Union S) q) }) \by { \fun (sq: UnionMember S q) =>
            sq Logic.False
              (\fun (x: Real) => \fun (sx: Member S x) => \fun (xq: mem x q) =>
                (\bysub(Rat, { q : Rat \where Logic.Not (mem u q) }, q))
                  ((\bysub(Real, { u : Real \where UpperBound S u }, u)) x sx q xq)) },
        \Cast[Rat] ({ q : Rat \where Logic.Not (In (Union S) q) }))
    \by { cutProper u }
  \by { bounded };

\definition unionLower (S: \Pow (Real)) (p, q: Rat) (pq: lt p q)
  (sq: UnionMember S q): UnionMember S p :=
  sq (UnionMember S p)
    (\fun (x: Real) => \fun (sx: Member S x) => \fun (xq: mem x q) =>
      unionIntro S x sx p (cutLower x p q pq xq));

\definition unionRounded (S: \Pow (Real)) (p: Rat) (sp: UnionMember S p):
  \exists \Cast[Rat] ({ q : Rat \where Logic.And[In (Union S) q, lt p q] }) :=
  sp (\exists \Cast[Rat] ({ q : Rat \where Logic.And[In (Union S) q, lt p q] }))
    (\fun (x: Real) => \fun (sx: Member S x) => \fun (xp: mem x p) =>
      \take (q: \Cast[Rat] ({ q : Rat \where Logic.And[mem x q, lt p q] })) =>
        \exact(
          \into[Rat](q, { q : Rat \where Logic.And[In (Union S) q, lt p q] }) \by { \record Logic.And[In (Union S) q, lt p q] {
              left := unionIntro S x sx q
                (Logic.And[mem x q, lt p q]::left (\bysub(Rat, { q : Rat \where Logic.And[mem x q, lt p q] }, q))),
              right := Logic.And[mem x q, lt p q]::right (\bysub(Rat, { q : Rat \where Logic.And[mem x q, lt p q] }, q)),
            } },
          \Cast[Rat] ({ q : Rat \where Logic.And[In (Union S) q, lt p q] }))
      \by { cutRounded x p xp });

\definition unionLocated (S: \Pow (Real)) (p, q: Rat) (pq: lt p q):
  Logic.Or[In (Union S) p, Logic.Not (In (Union S) q)] :=
  Classical.orElim (UnionMember S q) (Logic.Not (UnionMember S q))
    (Logic.Or[In (Union S) p, Logic.Not (In (Union S) q)])
    (\fun (sq: UnionMember S q) =>
      Logic.Or[In (Union S) p, Logic.Not (In (Union S) q)]::left (unionLower S p q pq sq))
    (\fun (nq: Logic.Not (UnionMember S q)) =>
      Logic.Or[In (Union S) p, Logic.Not (In (Union S) q)]::right nq)
    (Classical.excludedMiddle (UnionMember S q));

\definition unionRespects (S: \Pow (Real)) (p, q: Rat)
  (pq: RationalFractions.FractionEq p q) (sp: UnionMember S p): UnionMember S q :=
  sp (UnionMember S q)
    (\fun (x: Real) => \fun (sx: Member S x) => \fun (xp: mem x p) =>
      unionIntro S x sx q (cutRespects x p q pq xp));

\definition unionCut (S: \Pow (Real)) (nonempty: Nonempty S) (bounded: Bounded S):
  IsCut (Union S) :=
  \record Logic.And[Inhabited (Union S),
    and!{{ Proper (Union S) } { Lower (Union S) } { Rounded (Union S) }
      { Located (Union S) } { RespectsFractionEq (Union S) }}] {
    left := unionInhabited S nonempty,
    right := \record Logic.And[Proper (Union S),
      and!{{ Lower (Union S) } { Rounded (Union S) }
        { Located (Union S) } { RespectsFractionEq (Union S) }}] {
      left := unionProper S bounded,
      right := \record Logic.And[Lower (Union S),
        and!{{ Rounded (Union S) } { Located (Union S) } { RespectsFractionEq (Union S) }}] {
        left := unionLower S,
        right := \record Logic.And[Rounded (Union S),
          Logic.And[Located (Union S), RespectsFractionEq (Union S)]] {
          left := unionRounded S,
          right := \record Logic.And[Located (Union S), RespectsFractionEq (Union S)] {
            left := unionLocated S,
            right := unionRespects S,
          },
        },
      },
    },
  };

/* Proofs constrain the input through a refinement, rather than a Prop -> Set product. */
\definition FamilySet: \Pow (\Pow (Real)) :=
  { S : \Pow (Real) \where Logic.And[Nonempty S, Bounded S] };
\definition Family: \Set := \Cast[\Pow (Real)] (FamilySet);
\definition familyNonempty (S: Family): Nonempty S :=
  Logic.And[Nonempty S, Bounded S]::left (\bysub(\Pow (Real), FamilySet, S));
\definition familyBounded (S: Family): Bounded S :=
  Logic.And[Nonempty S, Bounded S]::right (\bysub(\Pow (Real), FamilySet, S));
\definition supremum (S: Family): Real :=
  \into[\Pow (Rat)](Union S, CutSet) \by { unionCut S (familyNonempty S) (familyBounded S) };
\definition supremumUpper (S: Family) (x: Real) (sx: Member S x)
  (q: Rat) (xq: mem x q): mem (supremum S) q :=
  \idelim(Union S = underlying (supremum S)
    \with T: \Pow (Rat) => \In[Rat] (T) (q))
    \by { base: unionIntro S x sx q xq, equality: \refl(Union S) };
\definition supremumLeast (S: Family)
  (u: Real) (ub: UpperBound S u) (q: Rat) (sq: mem (supremum S) q): mem u q :=
  (\idelim(underlying (supremum S) = Union S
    \with T: \Pow (Rat) => \In[Rat] (T) (q))
    \by { base: sq, equality: \refl(Union S) })
    (mem u q) (\fun (x: Real) => \fun (sx: Member S x) => ub x sx q);
\definition supremumLaw (S: Family): LeastUpperBound S (supremum S) :=
  \record Logic.And[UpperBound S (supremum S),
    \forall (v: Real) -> UpperBound S v -> Le (supremum S) v] {
    left := supremumUpper S,
    right := supremumLeast S,
  };
\definition complete (S: \Pow (Real)) (ne: Nonempty S) (bd: Bounded S):
  \exists \Cast[Real] ({ u : Real \where LeastUpperBound S u }) :=
  \block {
    \let family: Family := \into[\Pow (Real)](S, FamilySet) \by { \record Logic.And[Nonempty S, Bounded S] { left := ne, right := bd } };
    \return \exact(\into[Real](supremum family, { u : Real \where LeastUpperBound S u }) \by { supremumLaw family },
      \Cast[Real] ({ u : Real \where LeastUpperBound S u }));
  };
\definition leastUpperBoundUnique (S: \Pow (Real)) (u, v: Real)
  (hu: LeastUpperBound S u) (hv: LeastUpperBound S v): u = v :=
  leAntisym u v
    ((Logic.andRight (UpperBound S u) (\forall (w: Real) -> UpperBound S w -> Le u w) hu)
      v (Logic.andLeft (UpperBound S v) (\forall (w: Real) -> UpperBound S w -> Le v w) hv))
    ((Logic.andRight (UpperBound S v) (\forall (w: Real) -> UpperBound S w -> Le v w) hv)
      u (Logic.andLeft (UpperBound S u) (\forall (w: Real) -> UpperBound S w -> Le u w) hu));

\definition LowerBound (S: \Pow (Real)) (l: Real): \Prop :=
  \forall (x: Real) -> Member S x -> Le l x;

\definition BoundedBelow (S: \Pow (Real)): \Prop :=
  \exists \Cast[Real] ({ l : Real \where LowerBound S l });

\definition GreatestLowerBound (S: \Pow (Real)) (l: Real): \Prop :=
  Logic.And[LowerBound S l,
    \forall (v: Real) -> LowerBound S v -> Le v l];

\definition LowerBounds (S: \Pow (Real)): \Pow (Real) :=
  { l : Real \where LowerBound S l };

\definition lowerBoundsNonempty (S: \Pow (Real)) (bounded: BoundedBelow S):
  Nonempty (LowerBounds S) := bounded;

\definition lowerBoundsBounded (S: \Pow (Real)) (nonempty: Nonempty S):
  Bounded (LowerBounds S) :=
  \take (x: \Cast[Real] ({ x : Real \where Member S x })) =>
    \exact(
      \into[Real](x, { u : Real \where UpperBound (LowerBounds S) u }) \by { \fun (l: Real) => \fun (lower: Member (LowerBounds S) l) =>
          lower x (\bysub(Real, { x : Real \where Member S x }, x)) },
      \Cast[Real] ({ u : Real \where UpperBound (LowerBounds S) u }))
  \by { nonempty };

\definition InfimumDomainSet: \Pow (\Pow (Real)) :=
  { S : \Pow (Real) \where Logic.And[Nonempty S, BoundedBelow S] };

\definition InfimumDomain: \Set :=
  \Cast[\Pow (Real)] (InfimumDomainSet);

\definition infimumDomainNonempty (S: InfimumDomain): Nonempty S :=
  Logic.And[Nonempty S, BoundedBelow S]::left
    (\bysub(\Pow (Real), InfimumDomainSet, S));

\definition infimumDomainBounded (S: InfimumDomain): BoundedBelow S :=
  Logic.And[Nonempty S, BoundedBelow S]::right
    (\bysub(\Pow (Real), InfimumDomainSet, S));

\definition lowerFamily (S: InfimumDomain): Family :=
  \into[\Pow (Real)](LowerBounds S, FamilySet) \by { \record Logic.And[Nonempty (LowerBounds S), Bounded (LowerBounds S)] {
      left := lowerBoundsNonempty S (infimumDomainBounded S),
      right := lowerBoundsBounded S (infimumDomainNonempty S),
    } };

\definition infimum (S: InfimumDomain): Real :=
  supremum (lowerFamily S);

\definition lowerFamilyMemberLower (S: InfimumDomain) (l: Real)
  (member: Member (lowerFamily S) l): LowerBound S l :=
  \idelim((lowerFamily S) = LowerBounds S
    \with T: \Pow (Real) => Member T l)
    \by { base: member, equality: \refl(LowerBounds S) };

\definition infimumLower (S: InfimumDomain):
  LowerBound S (infimum S) :=
  \fun (x: Real) => \fun (sx: Member S x) =>
    \fun (q: Rat) => \fun (iq: mem (infimum S) q) =>
      supremumLeast (lowerFamily S) x
        (\fun (l: Real) => \fun (lower: Member (lowerFamily S) l) =>
          \fun (r: Rat) => \fun (lr: mem l r) =>
            (lowerFamilyMemberLower S l lower) x sx r lr) q iq;

\definition infimumGreatest (S: InfimumDomain)
  (l: Real) (lower: LowerBound S l): Le l (infimum S) :=
  \fun (q: Rat) => \fun (lq: mem l q) =>
    supremumUpper (lowerFamily S) l
      (\idelim(LowerBounds S = (lowerFamily S)
        \with T: \Pow (Real) => Member T l)
        \by { base: lower, equality: \refl(LowerBounds S) }) q lq;

\definition infimumLaw (S: InfimumDomain):
  GreatestLowerBound S (infimum S) :=
  \record Logic.And[LowerBound S (infimum S),
    \forall (v: Real) -> LowerBound S v ->
      Le v (infimum S)] {
    left := infimumLower S,
    right := infimumGreatest S,
  };

\definition completeBelow (S: \Pow (Real))
  (nonempty: Nonempty S) (bounded: BoundedBelow S):
  \exists \Cast[Real] ({ l : Real \where GreatestLowerBound S l }) :=
  \block {
    \let domain: InfimumDomain :=
      \into[\Pow (Real)](S, InfimumDomainSet) \by { \record Logic.And[Nonempty S, BoundedBelow S] {
          left := nonempty, right := bounded,
        } };
    \return \exact(
      \into[Real](infimum domain, { l : Real \where GreatestLowerBound S l }) \by { infimumLaw domain },
      \Cast[Real] ({ l : Real \where GreatestLowerBound S l }));
  };

\definition greatestLowerBoundUnique (S: \Pow (Real)) (l, m: Real)
  (hl: GreatestLowerBound S l) (hm: GreatestLowerBound S m): l = m :=
  leAntisym l m
    ((Logic.andRight (LowerBound S m)
      (\forall (v: Real) -> LowerBound S v -> Le v m) hm)
      l (Logic.andLeft (LowerBound S l)
        (\forall (v: Real) -> LowerBound S v -> Le v l) hl))
    ((Logic.andRight (LowerBound S l)
      (\forall (v: Real) -> LowerBound S v -> Le v l) hl)
      m (Logic.andLeft (LowerBound S m)
        (\forall (v: Real) -> LowerBound S v -> Le v m) hm));
