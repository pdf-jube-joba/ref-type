/* Algebraic structures carried by the concrete integer implementation. */
\import \root.Int() \as I;
\import I.Math() \as IM;
\import IM.Specification() \as IS;
\import IS.Laws() \as IL;
\import \root.Algebra(Carrier := I.Int) \as A;

\definition Int: \Set := I.Int;
\definition Group: \Set := A.Group;
\definition CommutativeGroup: \Set := A.CommutativeGroup;

\definition additiveRaw: A.RawGroup :=
  \record A.RawGroup {
    unit := I.zeroSet,
    op := I.addSet,
    inv := I.negSet,
  };

\definition additiveGroupLaws: A.GroupLaws[additiveRaw] :=
  A.groupLawsIntro additiveRaw
    IL.addZeroLeft IL.addZeroRight IL.addAssoc
    IL.negInverse IL.negInverseRight;

\definition additiveGroup: A.Group :=
  \subsetinto(A.RawGroup, A.GroupSet,
    additiveRaw, additiveGroupLaws);

\definition additiveCommutativeGroupLaws:
  A.CommutativeGroupLaws[additiveRaw] :=
  A.commutativeGroupLawsIntro additiveRaw
    additiveGroupLaws IL.addComm;

\definition additiveCommutativeGroup: A.CommutativeGroup :=
  \subsetinto(A.RawGroup, A.CommutativeGroupSet,
    additiveRaw, additiveCommutativeGroupLaws);
