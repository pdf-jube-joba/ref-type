\import \root.Quotient(
  A := CauchySeq, Equivalent := Equivalent,
  equivalentRefl := equivalentRefl, equivalentSym := equivalentSym, equivalentTrans := equivalentTrans
) \as Q;

\definition ClassOf: CauchySeq -> \Power(CauchySeq) := Q.ClassOf;
\definition classOfEq: (x, y: CauchySeq) -> Equivalent x y -> ClassOf x = ClassOf y := Q.classOfEq;
\definition IsClass: \Power(CauchySeq) -> \Prop := Q.IsClass;
\definition ClassSet: \Power(\Power(CauchySeq)) := Q.ClassSet;
\definition Real: \Set := Q.Carrier;
\definition mem: Real -> CauchySeq -> \Prop := Q.mem;
\definition underlying: Real -> \Power(CauchySeq) := Q.underlying;
\definition Eq: Real -> Real -> \Prop := Q.Eq;
\definition eqByExt: (x, y: Real) ->
  ((a: CauchySeq) -> mem x a -> mem y a) -> ((a: CauchySeq) -> mem y a -> mem x a) -> Eq x y := Q.eqByExt;
\definition classIsClass: (x: CauchySeq) -> IsClass (ClassOf x) := Q.classIsClass;
\definition class: CauchySeq -> Real := Q.class;

/*
 * Arithmetic is first formed as a relational image of whole classes.
 * No representative is selected.  The closure obligations state that
 * these images are again single equivalence classes.
 */
\module Operations;
