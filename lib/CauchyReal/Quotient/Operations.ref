\definition ConstSeq (a: Rat): Sequence := \fun (n: Nat) => a;

\definition AddSeq (x, y: CauchySeq): Sequence := \fun (n: Nat) =>
    addRat (at x n) (at y n);

\definition MulSeq (x, y: CauchySeq): Sequence := \fun (n: Nat) =>
    mulRat (at x n) (at y n);

\definition NegSeq (x: CauchySeq): Sequence := \fun (n: Nat) => negRat (at x n);

\module SequenceClosed(
  constCauchy: \forall (a: Rat) ->
    \In[Sequence] (CauchySet) (ConstSeq a),
  addCauchy: \forall (x, y: CauchySeq) ->
    \In[Sequence] (CauchySet) (AddSeq x y),
  mulCauchy: \forall (x, y: CauchySeq) ->
    \In[Sequence] (CauchySet) (MulSeq x y),
  negCauchy: \forall (x: CauchySeq) ->
    \In[Sequence] (CauchySet) (NegSeq x),
);
