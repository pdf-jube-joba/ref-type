\definition ConstSeq: Rat -> Sequence :=
  \fun (a: Rat) => \fun (n: Nat) => a;

\definition AddSeq: CauchySeq -> CauchySeq -> Sequence :=
  \fun (x, y: CauchySeq) => \fun (n: Nat) =>
    addRat (at x n) (at y n);

\definition NegSeq: CauchySeq -> Sequence :=
  \fun (x: CauchySeq) => \fun (n: Nat) => negRat (at x n);

\module SequenceClosed(
  constCauchy: \forall (a: Rat) ->
    \Pred(Sequence, CauchySet, ConstSeq a),
  addCauchy: \forall (x, y: CauchySeq) ->
    \Pred(Sequence, CauchySet, AddSeq x y),
  negCauchy: \forall (x: CauchySeq) ->
    \Pred(Sequence, CauchySet, NegSeq x),
);
