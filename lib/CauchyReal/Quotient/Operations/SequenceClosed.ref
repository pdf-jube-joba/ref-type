\import \root.Logic() \as Logic;

\definition ConstCauchy: Rat -> CauchySeq :=
  \fun (a: Rat) =>
    \subsetinto(Sequence, CauchySet, ConstSeq a, constCauchy a);

\definition AddCauchy: CauchySeq -> CauchySeq -> CauchySeq :=
  \fun (x, y: CauchySeq) =>
    \subsetinto(Sequence, CauchySet, AddSeq x y, addCauchy x y);

\definition NegCauchy: CauchySeq -> CauchySeq :=
  \fun (x: CauchySeq) =>
    \subsetinto(Sequence, CauchySet, NegSeq x, negCauchy x);

\definition AddClass:
  Real -> Real -> \Power(CauchySeq) :=
  \fun (x, y: Real) =>
    \Subset(z, CauchySeq,
      \exists \Ty(CauchySeq,
        \Subset(a, CauchySeq,
          Logic.And[mem x a,
            \exists \Ty(CauchySeq,
              \Subset(b, CauchySeq,
                Logic.And[mem y b,
                  Equivalent z (AddCauchy a b)]))])));

\definition NegClass: Real -> \Power(CauchySeq) :=
  \fun (x: Real) =>
    \Subset(z, CauchySeq,
      \exists \Ty(CauchySeq,
        \Subset(a, CauchySeq,
          Logic.And[mem x a, Equivalent z (NegCauchy a)])));

\module ClassClosed(
  addClassIsClass: \forall (x, y: Real) ->
    IsClass (AddClass x y),
  negClassIsClass: \forall (x: Real) ->
    IsClass (NegClass x),
);
