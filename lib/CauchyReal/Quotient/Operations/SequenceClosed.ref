\import \root.Logic() \as Logic;

\definition ConstCauchy (a: Rat): CauchySeq :=
    \subsetinto(Sequence, CauchySet, ConstSeq a, constCauchy a);

\definition AddCauchy (x, y: CauchySeq): CauchySeq :=
    \subsetinto(Sequence, CauchySet, AddSeq x y, addCauchy x y);

\definition MulCauchy (x, y: CauchySeq): CauchySeq :=
    \subsetinto(Sequence, CauchySet, MulSeq x y, mulCauchy x y);

\definition NegCauchy (x: CauchySeq): CauchySeq :=
    \subsetinto(Sequence, CauchySet, NegSeq x, negCauchy x);

\definition AddClass (x, y: Real): \Power(CauchySeq) :=
    \Subset(z, CauchySeq,
      \exists \Ty(CauchySeq,
        \Subset(a, CauchySeq,
          Logic.And[mem x a,
            \exists \Ty(CauchySeq,
              \Subset(b, CauchySeq,
                Logic.And[mem y b,
                  Equivalent z (AddCauchy a b)]))])));

\definition NegClass (x: Real): \Power(CauchySeq) :=
    \Subset(z, CauchySeq,
      \exists \Ty(CauchySeq,
        \Subset(a, CauchySeq,
          Logic.And[mem x a, Equivalent z (NegCauchy a)])));

\definition MulClass (x, y: Real): \Power(CauchySeq) :=
    \Subset(z, CauchySeq,
      \exists \Ty(CauchySeq,
        \Subset(a, CauchySeq,
          Logic.And[mem x a,
            \exists \Ty(CauchySeq,
              \Subset(b, CauchySeq,
                Logic.And[mem y b,
                  Equivalent z (MulCauchy a b)]))])));

\module ClassClosed(
  addClassIsClass: \forall (x, y: Real) ->
    IsClass (AddClass x y),
  negClassIsClass: \forall (x: Real) ->
    IsClass (NegClass x),
  mulClassIsClass: \forall (x, y: Real) ->
    IsClass (MulClass x y),
);
