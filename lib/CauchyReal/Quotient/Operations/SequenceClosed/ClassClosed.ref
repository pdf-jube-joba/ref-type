\definition ofRat (a: Rat): Real := class (ConstCauchy a);

\definition one: Real := ofRat oneRat;

\definition add (x, y: Real): Real :=
    \into[\Pow (CauchySeq)](AddClass x y, ClassSet) \by { addClassIsClass x y };

\definition neg (x: Real): Real :=
    \into[\Pow (CauchySeq)](NegClass x, ClassSet) \by { negClassIsClass x };

\definition mul (x, y: Real): Real :=
    \into[\Pow (CauchySeq)](MulClass x y, ClassSet) \by { mulClassIsClass x y };

\definition sub (x, y: Real): Real := add x (neg y);

\definition zero: Real := ofRat zeroRat;
