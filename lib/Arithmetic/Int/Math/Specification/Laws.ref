/* Elimination out of the quotient only uses unique-value take. */
\definition mathInduction (P: Grothendieck -> \Prop)
  (step: \forall (x: Difference) -> P (class x)) (C: Grothendieck): P C :=
    \take (x: \Cast[Difference] (Representatives C)) =>
      (\idelim(class x = C \with D: \Pow Difference =>
        \forall (hd: IsClass D) -> P (\into[\Pow Difference](D, ClassSet) \by { hd }))
      \by { base: (\fun (hd: IsClass (class x)) => step x), equality:
        \idelim(C = ClassOf x \with D: \Pow Difference => D = C)
          \by { base: \refl(C), equality: \bysub(Difference, Representatives C, x) } }) (classProperty C)
    \by { representativesExist C };
\definition addMathCongLeft (x, y, z: Grothendieck) (e: x = y): addMath x z = addMath y z :=
    (\idelim(x = y \with C: \Pow Difference =>
      \forall (hc: IsClass C) -> addMath x z = addMath (\into[\Pow Difference](C, ClassSet) \by { hc }) z)
      \by { base: (\fun (hc: IsClass x) => \refl(addMath x z)), equality: e }) (classProperty y);
\definition addRepComm (x, y: Difference): Equivalent (addRep x y) (addRep y x) := equivalentOfFields (addRep x y) (addRep y x)
    (NL.addComm (pos x) (pos y)) (NL.addComm (negPart x) (negPart y));
\definition addRepAssoc (x, y, z: Difference): Equivalent (addRep (addRep x y) z) (addRep x (addRep y z))
    := equivalentOfFields (addRep (addRep x y) z) (addRep x (addRep y z))
    (NL.addAssoc (pos x) (pos y) (pos z)) (NL.addAssoc (negPart x) (negPart y) (negPart z));
\definition addMathZeroLeft: \forall (x: Grothendieck) -> addMath zeroMath x = x :=
  mathInduction (\fun (x: Grothendieck) => addMath zeroMath x = x)
    (\fun (x: Difference) => trans!{\Pow Difference} _ _ _ (addMathClass (pair natZero!{} natZero!{}) x)
      (classOfEq (addRep (pair natZero!{} natZero!{}) x) x
        (equivalentOfFields (addRep (pair natZero!{} natZero!{}) x) x
          (NL.addZeroLeft (pos x)) (NL.addZeroLeft (negPart x)))));
\definition addMathComm: \forall (x, y: Grothendieck) -> addMath x y = addMath y x :=
  mathInduction (\fun (x: Grothendieck) => \forall (y: Grothendieck) -> addMath x y = addMath y x)
    (\fun (x: Difference) => mathInduction (\fun (y: Grothendieck) => addMath (class x) y = addMath y (class x))
      (\fun (y: Difference) => trans!{\Pow Difference} _ _ _ (addMathClass x y)
        (trans!{\Pow Difference} _ _ _ (classOfEq (addRep x y) (addRep y x) (addRepComm x y))
          (sym!{\Pow Difference} _ _ (addMathClass y x)))));
\definition mulMathComm: \forall (x, y: Grothendieck) -> mulMath x y = mulMath y x :=
  mathInduction (\fun (x: Grothendieck) =>
    \forall (y: Grothendieck) -> mulMath x y = mulMath y x)
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) =>
        mulMath (class x) y = mulMath y (class x))
        (\fun (y: Difference) =>
          trans!{\Pow Difference} _ _ _ (mulMathClass x y)
            (trans!{\Pow Difference} _ _ _
              (classOfEq (mulRep x y) (mulRep y x) (mulRepComm x y))
              (sym!{\Pow Difference} _ _ (mulMathClass y x)))));
\definition addMathZeroRight (x: Grothendieck): addMath x zeroMath = x := trans!{\Pow Difference} _ _ _ (addMathComm x zeroMath) (addMathZeroLeft x);
\definition addMathAssoc: \forall (x, y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y z) :=
  mathInduction (\fun (x: Grothendieck) => \forall (y, z: Grothendieck) -> addMath (addMath x y) z = addMath x (addMath y
    z))
    (\fun (x: Difference) =>
      mathInduction (\fun (y: Grothendieck) => \forall (z: Grothendieck) ->
        addMath (addMath (class x) y) z = addMath (class x) (addMath y z))
        (\fun (y: Difference) =>
          mathInduction (\fun (z: Grothendieck) => addMath (addMath (class x) (class y)) z =
            addMath (class x) (addMath (class y) z))
            (\fun (z: Difference) => trans!{\Pow Difference} _ _ _
              (addMathCongLeft (addMath (class x) (class y)) (class (addRep x y)) (class z) (addMathClass x
    y))
              (trans!{\Pow Difference} _ _ _ (addMathClass (addRep x y) z)
                (trans!{\Pow Difference} _ _ _ (classOfEq (addRep (addRep x y) z) (addRep x (addRep y z)) (addRepAssoc x y
    z))
                  (trans!{\Pow Difference} _ _ _ (sym!{\Pow Difference} _ _ (addMathClass x (addRep y z)))
                    (addMathCongRight (class x) (class (addRep y z)) (addMath (class y) (class z))
                      (sym!{\Pow Difference} _ _ (addMathClass y z)))))))));
\definition negMathInverse: \forall (x: Grothendieck) -> addMath (negMath x) x = zeroMath :=
  mathInduction (\fun (x: Grothendieck) => addMath (negMath x) x = zeroMath)
    (\fun (x: Difference) => trans!{\Pow Difference} _ _ _
      (addMathCongLeft (negMath (class x)) (class (negRep x)) (class x) (negMathClass x))
      (trans!{\Pow Difference} _ _ _ (addMathClass (negRep x) x)
        (classOfEq (addRep (negRep x) x) (pair natZero!{} natZero!{})
          (trans!{Nat} _ _ _ (NL.addComm (negPart x) (pos x))
            (sym!{Nat} _ _ (NL.addZeroLeft (N.add^ (pos x) (negPart x))))))));
\definition toMathInjective (x, y: Int^) (e: toMath x = toMath y): x = y :=
    trans!{Int^} x (fromMath (toMath x)) y (sym!{Int^} _ _ (fromTo x))
      ((\idelim(toMath y = toMath x \with C: \Pow Difference =>
        \forall (hc: IsClass C) -> fromMath (\into[\Pow Difference](C, ClassSet) \by { hc }) = y)
        \by { base: (\fun (hc: IsClass (toMath y)) => fromTo y), equality: sym!{\Pow Difference} (toMath x) (toMath y) e })
        (classProperty (toMath x)));
\definition addComm (x, y: Int^): add^ x y = add^ y x := toMathInjective (add^ x y) (add^ y x)
    (trans!{\Pow Difference} _ _ _ (addMatchesMath x y)
      (trans!{\Pow Difference} _ _ _ (addMathComm (toMath x) (toMath y)) (sym!{\Pow Difference} _ _ (addMatchesMath y x))));
\definition mulComm (x, y: Int^): mul^ x y = mul^ y x := toMathInjective (mul^ x y) (mul^ y x)
    (trans!{\Pow Difference} _ _ _ (mulMatchesMath x y)
      (trans!{\Pow Difference} _ _ _
        (mulMathComm (toMath x) (toMath y))
        (sym!{\Pow Difference} _ _ (mulMatchesMath y x))));
\definition addZeroLeft (x: Int^): add^ zero^ x = x := toMathInjective (add^ zero^ x) x
    (trans!{\Pow Difference} _ _ _ (addMatchesMath zero^ x) (addMathZeroLeft (toMath x)));
\definition addZeroRight (x: Int^): add^ x zero^ = x := trans!{Int^} _ _ _ (addComm x zero^) (addZeroLeft x);
\definition negInverse (x: Int^): add^ (neg^ x) x = zero^ := toMathInjective (add^ (neg^ x) x) zero^
    (trans!{\Pow Difference} _ _ _ (addMatchesMath (neg^ x) x)
      (trans!{\Pow Difference} _ _ _ (addMathCongLeft (toMath (neg^ x)) (negMath (toMath x)) (toMath x) (negMatchesMath
    x))
        (negMathInverse (toMath x))));

\definition addAssoc (x, y, z: Int^):
  add^ (add^ x y) z = add^ x (add^ y z) :=
    toMathInjective (add^ (add^ x y) z) (add^ x (add^ y z))
      (trans!{\Pow Difference} _ _ _ (addMatchesMath (add^ x y) z)
        (trans!{\Pow Difference} _ _ _
          (addMathCongLeft
            (toMath (add^ x y))
            (addMath (toMath x) (toMath y))
            (toMath z)
            (addMatchesMath x y))
          (trans!{\Pow Difference} _ _ _
            (addMathAssoc (toMath x) (toMath y) (toMath z))
            (trans!{\Pow Difference} _ _ _
              (addMathCongRight
                (toMath x)
                (addMath (toMath y) (toMath z))
                (toMath (add^ y z))
                (sym!{\Pow Difference} _ _ (addMatchesMath y z)))
              (sym!{\Pow Difference} _ _
                (addMatchesMath x (add^ y z)))))));

\definition negInverseRight (x: Int^):
  add^ x (neg^ x) = zero^ :=
    trans!{Int^} _ _ _ (addComm x (neg^ x)) (negInverse x);
