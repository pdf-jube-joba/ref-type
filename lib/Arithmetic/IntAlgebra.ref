/* Algebraic structures carried by the concrete integer implementation. */
\import \root.Arithmetic[].Int[] \as I;
\import I.Math[] \as IM;
\import IM.Specification[] \as IS;
\import IS.Laws[] \as IL;
\import \root.Algebra[].Algebra[] \as A;

\definition Int: \Set := I.Int^;
\definition Group: \Set := A.Group I.Int^;
\definition CommutativeGroup: \Set := A.CommutativeGroup I.Int^;

\definition additiveRaw: A.RawGroup[I.Int^] :=
  A.RawGroup[I.Int^]::# I.zero^ I.add^ I.neg^;

\definition additiveGroupLaws: A.GroupLaws[I.Int^, additiveRaw] :=
  A.groupLawsIntro I.Int^ additiveRaw
    IL.addZeroLeft IL.addZeroRight IL.addAssoc
    IL.negInverse IL.negInverseRight;

\definition additiveGroup: A.Group I.Int^ :=
  \into[A.RawGroup[I.Int^]](additiveRaw, A.GroupSet I.Int^) \by { additiveGroupLaws };

\definition additiveCommutativeGroupLaws:
  A.CommutativeGroupLaws[I.Int^, additiveRaw] :=
  A.commutativeGroupLawsIntro I.Int^ additiveRaw
    additiveGroupLaws IL.addComm;

\definition additiveCommutativeGroup: A.CommutativeGroup I.Int^ :=
  \into[A.RawGroup[I.Int^]](additiveRaw, A.CommutativeGroupSet I.Int^)
    \by { additiveCommutativeGroupLaws };
