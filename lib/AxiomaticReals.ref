/*
 * Bourbaki-style real structures.
 *
 * RawRealStructure contains data only.  Laws are imposed afterwards by the
 * refinement AxiomaticRealStructure, so no proof is stored in an inductive
 * value.  The order is represented by a subset of Carrier times Carrier
 * rather than a Prop-valued field; this keeps every constructor argument in
 * Set and exposes the usual Bourbaki representation of a binary relation.
 */
\import \root.Logic() \as Logic;
\import \root.Pair() \as Pair;
\use Logic.not;
\use Logic.and;
\use Logic.and4;
\use Logic.and10;
\use Logic.or;

\structure RawRealStructure(Carrier: \Set): \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
  leRelation: \Power(Pair.Times[Carrier, Carrier]),
};

\definition zero: RawRealStructure[Carrier] -> Carrier :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::zero s;

\definition one: RawRealStructure[Carrier] -> Carrier :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::one s;

\definition add:
  RawRealStructure[Carrier] -> Carrier -> Carrier -> Carrier :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::add s;

\definition neg: RawRealStructure[Carrier] -> Carrier -> Carrier :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::neg s;

\definition mul:
  RawRealStructure[Carrier] -> Carrier -> Carrier -> Carrier :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::mul s;

\definition inv: RawRealStructure[Carrier] -> Carrier -> Carrier :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::inv s;

\definition leRelation:
  RawRealStructure[Carrier] ->
    \Power(Pair.Times[Carrier, Carrier]) :=
  \fun (s: RawRealStructure[Carrier]) =>
    RawRealStructure::leRelation s;

\definition Le:
  RawRealStructure[Carrier] -> Carrier -> Carrier -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) => \fun (x, y: Carrier) =>
    \Pred(
      Pair.Times[Carrier, Carrier],
      leRelation s,
      Pair.pair _ _ x y);

\definition NonZero:
  RawRealStructure[Carrier] -> Carrier -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) => \fun (x: Carrier) =>
    not!{\expr { x = zero s }};

\definition FieldLaws: RawRealStructure[Carrier] -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
    and10!{
      \expr { not!{\expr { zero s = one s }} }
      \expr { \forall (x: Carrier) -> add s (zero s) x = x }
      \expr { \forall (x: Carrier) -> add s (neg s x) x = zero s }
      \expr { \forall (x, y: Carrier) -> add s x y = add s y x }
      \expr { \forall (x, y, z: Carrier) ->
        add s (add s x y) z = add s x (add s y z) }
      \expr { \forall (x: Carrier) -> mul s (one s) x = x }
      \expr { \forall (x, y: Carrier) -> mul s x y = mul s y x }
      \expr { \forall (x, y, z: Carrier) ->
        mul s (mul s x y) z = mul s x (mul s y z) }
      \expr { \forall (x, y, z: Carrier) ->
        mul s x (add s y z) = add s (mul s x y) (mul s x z) }
      \expr { \forall (x: Carrier) -> NonZero s x -> mul s (inv s x) x = one s }
    };

\definition LinearOrderLaws: RawRealStructure[Carrier] -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
    and4!{
      \expr { \forall (x: Carrier) -> Le s x x }
      \expr { \forall (x, y, z: Carrier) -> Le s x y -> Le s y z -> Le s x z }
      \expr { \forall (x, y: Carrier) -> Le s x y -> Le s y x -> x = y }
      \expr { \forall (x, y: Carrier) -> or!{\expr { Le s x y } \expr { Le s y x }} }
    };

\definition OrderedFieldLaws: RawRealStructure[Carrier] -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
    and!{
      \expr { \forall (x, y, z: Carrier) -> Le s x y ->
        Le s (add s z x) (add s z y) }
      \expr { \forall (x, y: Carrier) ->
        Le s (zero s) x -> Le s (zero s) y ->
          Le s (zero s) (mul s x y) }
    };

\definition In:
  \Power(Carrier) -> Carrier -> \Prop :=
  \fun (A: \Power(Carrier)) => \fun (x: Carrier) => \Pred(Carrier, A, x);

\definition Inhabited: \Power(Carrier) -> \Prop :=
  \fun (A: \Power(Carrier)) =>
    \exists \Ty(Carrier, \Subset(x, Carrier, In A x));

\definition IsUpperBound:
  RawRealStructure[Carrier] -> \Power(Carrier) -> Carrier -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
  \fun (A: \Power(Carrier)) => \fun (u: Carrier) =>
    \forall (x: Carrier) -> In A x -> Le s x u;

\definition BoundedAbove:
  RawRealStructure[Carrier] -> \Power(Carrier) -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) => \fun (A: \Power(Carrier)) =>
    \exists \Ty(Carrier,
      \Subset(u, Carrier, IsUpperBound s A u));

\definition IsLeastUpperBound:
  RawRealStructure[Carrier] -> \Power(Carrier) -> Carrier -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
  \fun (A: \Power(Carrier)) => \fun (u: Carrier) =>
    and!{\expr { IsUpperBound s A u }
      \expr { \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v }};

\definition HasLeastUpperBound:
  RawRealStructure[Carrier] -> \Power(Carrier) -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) => \fun (A: \Power(Carrier)) =>
    \exists \Ty(Carrier,
      \Subset(u, Carrier, IsLeastUpperBound s A u));

\definition Completeness: RawRealStructure[Carrier] -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
    \forall (A: \Power(Carrier)) -> Inhabited A -> BoundedAbove s A ->
      HasLeastUpperBound s A;

\definition IsAxiomaticRealStructure:
  RawRealStructure[Carrier] -> \Prop :=
  \fun (s: RawRealStructure[Carrier]) =>
    and4!{\expr { FieldLaws s } \expr { LinearOrderLaws s }
      \expr { OrderedFieldLaws s } \expr { Completeness s }};

\definition AxiomaticRealStructureSet:
  \Power(RawRealStructure[Carrier]) :=
  \Subset(s, RawRealStructure[Carrier], IsAxiomaticRealStructure s);

\definition AxiomaticRealStructure: \Set :=
  \Ty(RawRealStructure[Carrier], AxiomaticRealStructureSet);
