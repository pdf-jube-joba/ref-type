/*
 * Bourbaki-style real structures.
 *
 * RawRealStructure contains data only.  Laws are imposed afterwards by the
 * refinement AxiomaticRealStructure, so no proof is stored in an inductive
 * value.  The order is represented by a subset of Carrier times Carrier
 * rather than a Prop-valued field; this keeps every constructor argument in
 * Set and exposes the usual Bourbaki representation of a binary relation.
 */
\import \root.Logic() \as Logic;
\import \root.Pair() \as Pair;
\import \root.Rel(Carrier := Carrier) \as Rel;
\import \root.Law(Carrier := Carrier) \as Law;
\use Logic.not;
\use Logic.and;
\use Logic.or;

\structure RawRealStructure(Carrier: \Set): \Set := {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
  leRelation: \Power(Pair.Times^[Carrier, Carrier]),
};

\definition zero (s: RawRealStructure[Carrier]): Carrier :=
    RawRealStructure::zero s;

\definition one (s: RawRealStructure[Carrier]): Carrier :=
    RawRealStructure::one s;

\definition add (s: RawRealStructure[Carrier]): Carrier -> Carrier -> Carrier :=
    RawRealStructure::add s;

\definition neg (s: RawRealStructure[Carrier]): Carrier -> Carrier :=
    RawRealStructure::neg s;

\definition mul (s: RawRealStructure[Carrier]): Carrier -> Carrier -> Carrier :=
    RawRealStructure::mul s;

\definition inv (s: RawRealStructure[Carrier]): Carrier -> Carrier :=
    RawRealStructure::inv s;

\definition leRelation (s: RawRealStructure[Carrier]):
    \Power(Pair.Times^[Carrier, Carrier]) :=
    RawRealStructure::leRelation s;

\definition Le (s: RawRealStructure[Carrier]) (x, y: Carrier): \Prop :=
    \Pred(
      Pair.Times^[Carrier, Carrier],
      leRelation s,
      Pair.pair _ _ x y);

\definition NonZero (s: RawRealStructure[Carrier]) (x: Carrier): \Prop :=
    not!{{ x = zero s }};

\definition FieldLaws (s: RawRealStructure[Carrier]): \Prop :=
    and!{
      { not!{{ zero s = one s }} }
      { Law.LeftUnital (add s) (zero s) }
      { Law.LeftInvertible (add s) (zero s) (neg s) }
      { Law.Commutative (add s) }
      { Law.Associative (add s) }
      { Law.LeftUnital (mul s) (one s) }
      { Law.Commutative (mul s) }
      { Law.Associative (mul s) }
      { Law.LeftDistributive (mul s) (add s) }
      { \forall (x: Carrier) -> NonZero s x -> mul s (inv s x) x = one s }
    };

\definition LinearOrderLaws (s: RawRealStructure[Carrier]): \Prop :=
    and!{
      { Rel.Reflexive (Le s) }
      { Rel.Transitive (Le s) }
      { Rel.Antisymmetric (Le s) }
      { Rel.Total (Le s) }
    };

\definition OrderedFieldLaws (s: RawRealStructure[Carrier]): \Prop :=
    and!{
      { \forall (x, y, z: Carrier) -> Le s x y ->
        Le s (add s z x) (add s z y) }
      { \forall (x, y: Carrier) ->
        Le s (zero s) x -> Le s (zero s) y ->
          Le s (zero s) (mul s x y) }
    };

\definition In (A: \Power(Carrier)) (x: Carrier): \Prop := \Pred(Carrier, A, x);

\definition Inhabited (A: \Power(Carrier)): \Prop :=
    \exists \Ty(Carrier, \Subset(x, Carrier, In A x));

\definition IsUpperBound (s: RawRealStructure[Carrier]) (A: \Power(Carrier)) (u: Carrier): \Prop :=
    \forall (x: Carrier) -> In A x -> Le s x u;

\definition BoundedAbove (s: RawRealStructure[Carrier]) (A: \Power(Carrier)): \Prop :=
    \exists \Ty(Carrier,
      \Subset(u, Carrier, IsUpperBound s A u));

\definition IsLeastUpperBound (s: RawRealStructure[Carrier]) (A: \Power(Carrier)) (u: Carrier): \Prop :=
    and!{{ IsUpperBound s A u }
      { \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v }};

\definition HasLeastUpperBound (s: RawRealStructure[Carrier]) (A: \Power(Carrier)): \Prop :=
    \exists \Ty(Carrier,
      \Subset(u, Carrier, IsLeastUpperBound s A u));

\definition Completeness (s: RawRealStructure[Carrier]): \Prop :=
    \forall (A: \Power(Carrier)) -> Inhabited A -> BoundedAbove s A ->
      HasLeastUpperBound s A;

\definition IsAxiomaticRealStructure (s: RawRealStructure[Carrier]): \Prop :=
    and!{{ FieldLaws s } { LinearOrderLaws s }
      { OrderedFieldLaws s } { Completeness s }};

\definition AxiomaticRealStructureSet:
  \Power(RawRealStructure[Carrier]) :=
  \Subset(s, RawRealStructure[Carrier], IsAxiomaticRealStructure s);

\definition AxiomaticRealStructure: \Set :=
  \Ty(RawRealStructure[Carrier], AxiomaticRealStructureSet);

\definition laws (s: AxiomaticRealStructure): IsAxiomaticRealStructure s :=
  \bysub(RawRealStructure[Carrier], AxiomaticRealStructureSet, s);

\definition realLawsIntro (s: RawRealStructure[Carrier])
  (field: FieldLaws s) (order: LinearOrderLaws s)
  (compatible: OrderedFieldLaws s) (complete: Completeness s): IsAxiomaticRealStructure s :=
  \record Logic.And[FieldLaws s,
    Logic.And[LinearOrderLaws s, Logic.And[OrderedFieldLaws s, Completeness s]]] {
    left := field,
    right := \record Logic.And[LinearOrderLaws s, Logic.And[OrderedFieldLaws s, Completeness s]] {
      left := order,
      right := \record Logic.And[OrderedFieldLaws s, Completeness s] {
        left := compatible, right := complete,
      },
    },
  };

\definition linearOrderIntro (s: RawRealStructure[Carrier])
  (reflexive: Rel.Reflexive (Le s)) (transitive: Rel.Transitive (Le s))
  (antisymmetric: Rel.Antisymmetric (Le s)) (total: Rel.Total (Le s)): LinearOrderLaws s :=
  \record Logic.And[Rel.Reflexive (Le s),
    Logic.And[Rel.Transitive (Le s), Logic.And[Rel.Antisymmetric (Le s), Rel.Total (Le s)]]] {
    left := reflexive,
    right := \record Logic.And[Rel.Transitive (Le s), Logic.And[Rel.Antisymmetric (Le s), Rel.Total (Le s)]] {
      left := transitive,
      right := \record Logic.And[Rel.Antisymmetric (Le s), Rel.Total (Le s)] {
        left := antisymmetric, right := total,
      },
    },
  };

\definition leastUpperBoundIntro (s: RawRealStructure[Carrier]) (A: \Power(Carrier)) (u: Carrier)
  (upper: IsUpperBound s A u)
  (least: \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v): IsLeastUpperBound s A u :=
  \record Logic.And[IsUpperBound s A u, \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v] {
    left := upper, right := least,
  };
\definition lubUpper (s: RawRealStructure[Carrier]) (A: \Power(Carrier)) (u: Carrier)
  (h: IsLeastUpperBound s A u): IsUpperBound s A u :=
  Logic.andLeft (IsUpperBound s A u) (\forall (v: Carrier) -> IsUpperBound s A v -> Le s u v) h;
\definition lubLeast (s: RawRealStructure[Carrier]) (A: \Power(Carrier)) (u: Carrier)
  (h: IsLeastUpperBound s A u): \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v :=
  Logic.andRight (IsUpperBound s A u) (\forall (v: Carrier) -> IsUpperBound s A v -> Le s u v) h;

\module Laws;
