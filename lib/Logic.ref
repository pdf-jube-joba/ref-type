/* Shared propositional vocabulary for the real-number constructions. */
\inductive False: \Prop :=
;

\definition Not: \Prop -> \Prop :=
  (P: \Prop) => P -> False;

\structure And(P, Q: \Prop): \Prop := {
  left: P,
  right: Q,
};

\definition And(P, Q: \Prop)::intro(left: P)(right: Q): And[P, Q] :=
  And[P, Q] { left := left, right := right };

\inductive Or(P, Q: \Prop): \Prop :=
| left: P -> Or;
| right: Q -> Or;
;

/* Reusable surface notation for the propositional vocabulary above. */
\macro not($proposition) := Not $proposition;
\macro and($left, $right) := And[$left, $right];
\macro or($left, $right) := Or[$left, $right];

/* Right-associated conjunctions keep collections of laws readable. */
\macro and3($first, $second, $third) :=
  And[$first, and!{$second $third}];
\macro and4($first, $second, $third, $fourth) :=
  And[$first, and3!{$second $third $fourth}];
\macro and5($first, $second, $third, $fourth, $fifth) :=
  And[$first, and4!{$second $third $fourth $fifth}];
\macro and6($first, $second, $third, $fourth, $fifth, $sixth) :=
  And[$first, and5!{$second $third $fourth $fifth $sixth}];
\macro and10($one, $two, $three, $four, $five,
             $six, $seven, $eight, $nine, $ten) :=
  And[$one,
    And[$two,
      And[$three,
        And[$four,
          And[$five,
            And[$six,
              And[$seven,
                And[$eight, And[$nine, $ten]]]]]]]]];
