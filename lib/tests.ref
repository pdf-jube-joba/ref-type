/* Concrete boundary cases supplement the universally quantified library laws. */
\module Logic;
\module Bool;
\module Nat;
\module ArithmeticExamples {
  \import \root.Nat() \as N;
  \definition z: N.Nat := N.Nat::zero;
  \definition one: N.Nat := N.Nat::succ z;
  \definition two: N.Nat := N.Nat::succ one;
  \definition three: N.Nat := N.Nat::succ two;
  \definition four: N.Nat := N.Nat::succ three;
  \definition six: N.Nat := N.Nat::succ (N.Nat::succ four);
  \definition eight: N.Nat := N.Nat::succ (N.Nat::succ six);
  \definition sum: N.addSet two three = N.Nat::succ four := \refl(N.Nat::succ four);
  \definition subtract: N.subSet three two = one := \refl(one);
  \definition truncated: N.subSet two three = z := \refl(z);
  \definition product: N.mulSet two three = six := \refl(six);
  \definition power: N.powSet two three = eight := \refl(eight);
  \definition zeroPowerZero: N.powSet z z = one := \refl(one);
  \definition minLeft: N.minSet two three = two := \refl(two);
  \definition minRight: N.minSet three two = two := \refl(two);
  \definition maxLeft: N.maxSet three two = three := \refl(three);
  \definition maxRight: N.maxSet two three = three := \refl(three);
  \definition minSame: N.minSet two two = two := \refl(two);
  \definition maxSame: N.maxSet two two = two := \refl(two);
  \definition less: N.Lt two three := \refl(N.ltbSet z one);
  \definition notLess: N.ltbSet three two = N.ltbSet z z := \refl(N.ltbSet z z);
  \definition notLe: N.lebSet three two = N.lebSet one z := \refl(N.lebSet one z);
  \definition equal: N.eqbSet two two = N.eqbSet z z := \refl(N.eqbSet z z);
  \definition unequal: N.eqbSet two three = N.eqbSet z one := \refl(N.eqbSet z one);
  \definition evenFour: N.evenSet four = N.evenSet z := \refl(N.evenSet z);
  \definition oddThree: N.oddSet three = N.oddSet one := \refl(N.oddSet one);
  \definition evenThree: N.evenSet three = N.evenSet one := \refl(N.evenSet one);
  \definition oddFour: N.oddSet four = N.oddSet z := \refl(N.oddSet z);
  \definition importedAddLaw: (a, b: N.Nat) -> N.addSet a b = N.addSet b a := N.addComm;
  \definition importedMulLaw: (a, b, c: N.Nat) ->
    N.mulSet (N.mulSet a b) c = N.mulSet a (N.mulSet b c) := N.mulAssoc;
  \definition importedSpecification: (a, b: N.Nat) -> N.mulSet a b = N.mulPrec a b :=
    N.mulMatchesPrec;
}

\module BooleanExamples {
  \import \root.Bool() \as B;
  \definition neg: B.negSet B.Bool::false = B.Bool::true := \refl(B.Bool::true);
  \definition xor: B.xorSet B.Bool::true B.Bool::true = B.Bool::false := \refl(B.Bool::false);
  \definition implication: B.impliesSet B.Bool::true B.Bool::false = B.Bool::false := \refl(B.Bool::false);
  \definition importedLaw: (a: B.Bool) -> B.negSet (B.negSet a) = a := B.negInvolutive;
}
