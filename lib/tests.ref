/* Concrete boundary cases supplement the universally quantified library laws. */
\module Logic;
\module Data;
\module Set;
\module Nat;
\module Algebra;
\module Arithmetic;
\module Reals;
\module Geometry;
\module ClassicalExamples {
  \import \root.Logic[].Proposition[] \as L;
  \import \root.Logic[].Classical[] \as C;
  \definition excludedMiddle(P: \Prop): L.Or[P, L.Not P] := C.excludedMiddle P;
}

\module NaturalExamples {
  \import \root.Nat[] \as N;
  \import N.Laws[] \as NL;
  \import NL.Division[] \as ND;
  \definition z: N.Nat := N.Nat::zero;
  \definition one: N.Nat := N.Nat::succ z;
  \definition two: N.Nat := N.Nat::succ one;
  \definition three: N.Nat := N.Nat::succ two;
  \definition four: N.Nat := N.Nat::succ three;
  \definition six: N.Nat := N.Nat::succ (N.Nat::succ four);
  \definition eight: N.Nat := N.Nat::succ (N.Nat::succ six);
  \definition sum: N.add^ two^ three^ = N.Nat^::succ four^ := \refl(N.Nat^::succ four^);
  \definition subtract: N.sub^ three^ two^ = one^ := \refl(one^);
  \definition truncated: N.sub^ two^ three^ = z^ := \refl(z^);
  \definition product: N.mul^ two^ three^ = six^ := \refl(six^);
  \definition power: N.pow^ two^ three^ = eight^ := \refl(eight^);
  \definition zeroPowerZero: N.pow^ z^ z^ = one^ := \refl(one^);
  \definition minLeft: N.min^ two^ three^ = two^ := \refl(two^);
  \definition minRight: N.min^ three^ two^ = two^ := \refl(two^);
  \definition maxLeft: N.max^ three^ two^ = three^ := \refl(three^);
  \definition maxRight: N.max^ two^ three^ = three^ := \refl(three^);
  \definition minSame: N.min^ two^ two^ = two^ := \refl(two^);
  \definition maxSame: N.max^ two^ two^ = two^ := \refl(two^);
  \definition less: NL.Lt two^ three^ := \refl(N.ltb^ z^ one^);
  \definition notLess: N.ltb^ three^ two^ = N.ltb^ z^ z^ := \refl(N.ltb^ z^ z^);
  \definition notLe: N.leb^ three^ two^ = N.leb^ one^ z^ := \refl(N.leb^ one^ z^);
  \definition equal: N.eqb^ two^ two^ = N.eqb^ z^ z^ := \refl(N.eqb^ z^ z^);
  \definition unequal: N.eqb^ two^ three^ = N.eqb^ z^ one^ := \refl(N.eqb^ z^ one^);
  \definition evenFour: N.even^ four^ = N.even^ z^ := \refl(N.even^ z^);
  \definition oddThree: N.odd^ three^ = N.odd^ one^ := \refl(N.odd^ one^);
  \definition evenThree: N.even^ three^ = N.even^ one^ := \refl(N.even^ one^);
  \definition oddFour: N.odd^ four^ = N.odd^ z^ := \refl(N.odd^ z^);
  /* Quotient/remainder boundaries and several Euclidean transitions. */
  \definition quotientExact: N.div^ six^ two^ = three^ := \refl(three^);
  \definition quotientInexact: N.div^ eight^ three^ = two^ := \refl(two^);
  \definition quotientSmall: N.div^ two^ three^ = z^ := \refl(z^);
  \definition remainderExact: N.mod^ six^ three^ = z^ := \refl(z^);
  \definition remainderInexact: N.mod^ eight^ three^ = two^ := \refl(two^);
  \definition remainderSmall: N.mod^ two^ three^ = two^ := \refl(two^);
  \definition divisionTogether: N.divMod^ eight^ three^ = N.natPair two^ two^ :=
    \refl(N.natPair two^ two^);
  \definition divisionByZero: N.div^ three^ z^ = z^ := \refl(z^);
  \definition remainderByZero: N.mod^ three^ z^ = three^ := \refl(three^);
  \definition divisionZeroZero: N.div^ z^ z^ = z^ := \refl(z^);
  \definition remainderZeroZero: N.mod^ z^ z^ = z^ := \refl(z^);
  \definition divisionByOne: N.div^ four^ one^ = four^ := \refl(four^);
  \definition remainderByOne: N.mod^ four^ one^ = z^ := \refl(z^);
  \definition divisionSelf: N.div^ three^ three^ = one^ := \refl(one^);
  \definition remainderSelf: N.mod^ three^ three^ = z^ := \refl(z^);
  \definition gcdNontrivial: N.gcd^ eight^ six^ = two^ := \refl(two^);
  \definition gcdReversed: N.gcd^ six^ eight^ = two^ := \refl(two^);
  \definition gcdCoprime: N.gcd^ eight^ three^ = one^ := \refl(one^);
  \definition gcdDivisible: N.gcd^ six^ three^ = three^ := \refl(three^);
  \definition gcdSame: N.gcd^ three^ three^ = three^ := \refl(three^);
  \definition gcdWithOne: N.gcd^ four^ one^ = one^ := \refl(one^);
  \definition gcdLeftZero: N.gcd^ z^ three^ = three^ := \refl(three^);
  \definition gcdRightZero: N.gcd^ three^ z^ = three^ := \refl(three^);
  \definition gcdBothZero: N.gcd^ z^ z^ = z^ := \refl(z^);
  \definition importedDivisionLaw: \forall (a, b: N.Nat^) ->
    N.add^ (N.mul^ b (N.div^ a b)) (N.mod^ a b) = a := ND.divModReconstructs;
  \definition importedRemainderBound: \forall (a, d: N.Nat^) ->
    NL.Lt (N.mod^ a (N.Nat^::succ d)) (N.Nat^::succ d) := ND.modLt;
  \definition importedGcdGreatest: \forall (d, a, b: N.Nat^) ->
    ND.Divides d a -> ND.Divides d b -> ND.Divides d (N.gcd^ a b) := ND.gcdGreatest;
  \definition importedMulLaw: \forall (a, b, c: N.Nat^) ->
    N.mul^ (N.mul^ a b) c = N.mul^ a (N.mul^ b c) := NL.mulAssoc;
  \definition importedPositiveCancellation: \forall (k, a, b: N.Nat^) ->
    N.mul^ a (N.Nat^::succ k) = N.mul^ b (N.Nat^::succ k) -> a = b :=
    NL.mulCancelRightSucc;
  \definition importedSpecification: \forall (a, b: N.Nat^) -> N.mul^ a b = N.mulPrec a b :=
    N.mulMatchesPrec;
  \import \root.Algebra[].Monoid[] \as M;
  \import \root.Algebra[].Algebra[] \as A;

  \definition additiveRaw: M.RawMonoid[N.Nat^] :=
    M.RawMonoid[N.Nat^]::# N.zero^ N.add^;
  \definition additiveLaws: M.MonoidLaws[N.Nat^, additiveRaw] :=
    M.monoidLawsIntro N.Nat^ additiveRaw
      NL.addZeroLeft NL.addZeroRight NL.addAssoc;
  \definition additiveMonoid: M.Monoid N.Nat^ :=
    \into[M.RawMonoid[N.Nat^]](additiveRaw, M.MonoidSet N.Nat^) \by { additiveLaws };
  \definition additiveIdentity: \forall (n: N.Nat^) ->
    #op{(M.raw N.Nat^ additiveMonoid)} (#unit{(M.raw N.Nat^ additiveMonoid)}) n = n :=
    M.leftIdentity N.Nat^ additiveMonoid;

  \definition naturalSemiringRaw: A.RawSemiring[N.Nat^] :=
    A.RawSemiring[N.Nat^]::# N.zero^ N.one^ N.add^ N.mul^;
  \definition naturalSemiringLaws: A.SemiringLaws[N.Nat^, naturalSemiringRaw] :=
    A.semiringLawsIntro N.Nat^ naturalSemiringRaw
      NL.addZeroLeft NL.addZeroRight NL.addAssoc NL.addComm
      NL.mulOneLeft NL.mulOneRight NL.mulAssoc
      NL.mulDistribLeft NL.mulDistribRight
      NL.mulZeroLeft NL.mulZeroRight;
  \definition naturalSemiring: A.Semiring N.Nat^ :=
    \into[A.RawSemiring[N.Nat^]](naturalSemiringRaw, A.SemiringSet N.Nat^)
      \by { naturalSemiringLaws };
}

\module IntegerExamples {
  \import \root.Arithmetic[].Int[] \as I;
  \import I.Math[] \as IM;
  \import IM.Specification[] \as IS;
  \import IS.Laws[] \as IL;
  \use I.natZero;
  \use I.natSucc;
  \use I.boolTrue;
  \use I.boolFalse;
  \definition z: I.Nat := natZero!{};
  \definition one: I.Nat := natSucc!{z};
  \definition two: I.Nat := natSucc!{one};
  \definition three: I.Nat := natSucc!{two};
  \definition four: I.Nat := natSucc!{three};
  \definition six: I.Nat := natSucc!{{ natSucc!{four} }};
  \definition eight: I.Nat := natSucc!{{ natSucc!{six} }};
  \definition p2: I.Int^ := I.Int^::ofNat two;
  \definition p3: I.Int^ := I.Int^::ofNat three;
  \definition m2: I.Int^ := I.Int^::negSucc one;
  \definition m3: I.Int^ := I.Int^::negSucc two;
  \definition zeroNegation: I.neg^ I.zero^ = I.zero^ := \refl(I.zero^);
  \definition negativeZero: I.negOfNat^ z = I.zero^ := \refl(I.zero^);
  \definition successorAcrossZero: I.succ^ I.minusOne^ = I.zero^ := \refl(I.zero^);
  \definition predecessorAcrossZero: I.pred^ I.zero^ = I.minusOne^ := \refl(I.minusOne^);
  \definition positiveSum: I.add^ p2 p3 = I.Int^::ofNat (natSucc!{four}) := \refl(I.Int^::ofNat (natSucc!{four}));
  \definition negativeSum: I.add^ m2 m3 = I.Int^::negSucc four := \refl(I.Int^::negSucc four);
  \definition mixedPositive: I.add^ p3 m2 = I.one^ := \refl(I.one^);
  \definition mixedNegative: I.add^ p2 m3 = I.minusOne^ := \refl(I.minusOne^);
  \definition cancel: I.add^ p3 m3 = I.zero^ := \refl(I.zero^);
  \definition signedSubtraction: I.sub^ m2 p3 = I.Int^::negSucc four := \refl(I.Int^::negSucc four);
  \definition negativeProduct: I.mul^ p2 m3 = I.Int^::negSucc (natSucc!{four}) := \refl(I.Int^::negSucc (natSucc!{four}));
  \definition positiveProduct: I.mul^ m2 m3 = I.Int^::ofNat six := \refl(I.Int^::ofNat six);
  \definition zeroProduct: I.mul^ I.zero^ m3 = I.zero^ := \refl(I.zero^);
  \definition oddPower: I.pow^ m2 three = I.Int^::negSucc (natSucc!{six}) := \refl(I.Int^::negSucc (natSucc!{six}));
  \definition evenPower: I.pow^ m2 two = I.Int^::ofNat four := \refl(I.Int^::ofNat four);
  \definition zeroPowerZero: I.pow^ I.zero^ z = I.one^ := \refl(I.one^);
  \definition absolute: I.abs^ m3 = p3 := \refl(p3);
  \definition magnitude: I.natAbs^ m3 = three := \refl(three);
  \definition signNegative: I.sign^ m3 = I.minusOne^ := \refl(I.minusOne^);
  \definition signZero: I.sign^ I.zero^ = I.zero^ := \refl(I.zero^);
  \definition signPositive: I.sign^ p3 = I.one^ := \refl(I.one^);
  \definition equalityTrue: I.eqb^ m3 m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition equalityFalse: I.eqb^ m3 p3 = boolFalse!{} := \refl(boolFalse!{});
  \definition negativeOrder: I.ltb^ m3 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition crossingOrder: I.leb^ m3 p2 = boolTrue!{} := \refl(boolTrue!{});
  \definition reversedOrder: I.leb^ p2 m3 = boolFalse!{} := \refl(boolFalse!{});
  \definition equalOrder: I.leb^ m2 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition strictEqual: I.ltb^ m2 m2 = boolFalse!{} := \refl(boolFalse!{});
  \definition minimum: I.min^ m3 p2 = m3 := \refl(m3);
  \definition maximum: I.max^ m3 m2 = m2 := \refl(m2);
  \definition negativeEven: I.even^ m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition negativeOdd: I.odd^ m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition reducedDifference: I.diff^ three two = I.one^ := \refl(I.one^);
  \definition quotientCancellation: IS.diffMath three two = IS.diffMath one z :=
    IM.classOfEq (I.pair three two) (I.pair one z) (\refl(three));
  \definition noncanonicalSum:
    IM.addMath (IM.class (I.pair three two)) (IM.class (I.pair two three)) =
      IM.class (IM.addRep (I.pair three two) (I.pair two three)) :=
    IM.addMathClass (I.pair three two) (I.pair two three);
  \definition additionAgreement: \forall (x, y: I.Int^) ->
    IM.toMath (I.add^ x y) = IM.addMath (IM.toMath x) (IM.toMath y) := IM.addMatchesMath;
  \definition multiplicationAgreement: \forall (x, y: I.Int^) ->
    IM.toMath (I.mul^ x y) = IM.mulMath (IM.toMath x) (IM.toMath y) := IM.mulMatchesMath;
  \definition additionAssociative: \forall (x, y, z: I.Int^) ->
    I.add^ (I.add^ x y) z = I.add^ x (I.add^ y z) := IL.addAssoc;
  \definition multiplicationCommutative: \forall (x, y: I.Int^) ->
    I.mul^ x y = I.mul^ y x := IL.mulComm;
}

\module IntegerAlgebraExamples {
  \import \root.Arithmetic[].IntAlgebra[] \as IA;
  \definition additiveGroup: IA.Group := IA.additiveGroup;
  \definition additiveCommutativeGroup: IA.CommutativeGroup :=
    IA.additiveCommutativeGroup;
}

/* Heterogeneous products share one Program datatype and Set mirror. */
\module PairExamples {
  \import \root.Data[].Pair[] \as P;
  \import \root.Data[].Bool[] \as B;
  \import \root.Nat[] \as N;
  \import P.Laws[A := B.Bool^, B := N.Nat^] \as PL;
  \import P.Program[A := B.Bool, B := N.Nat] \as PP;
  \import PP.Mapping[C := N.Nat, D := B.Bool] \as PM;
  \import PP.Functions[C := N.Nat] \as PF;

  \definition neg: B.neg^ B.Bool^::false = B.Bool^::true := \refl(B.Bool^::true);
  \definition xor: B.xor^ B.Bool^::true B.Bool^::true = B.Bool^::false := \refl(B.Bool^::false);
  \definition implication: B.implies^ B.Bool^::true B.Bool^::false = B.Bool^::false := \refl(B.Bool^::false);

  \definition value: P.Times[B.Bool, N.Nat] :=
    P.Times[_, _]::pair B.Bool::true (N.Nat::succ N.Nat::zero);
  \definition reflected: P.Times^[B.Bool^, N.Nat^] :=
    \squash[_](\box[_](\return value));
  \definition first: P.first B.Bool^ N.Nat^ reflected = B.Bool^::true := \refl(B.Bool^::true);
  \definition second: P.second B.Bool^ N.Nat^ reflected = N.one^ := \refl(N.one^);
  \definition swapped: P.swap B.Bool^ N.Nat^ reflected = P.pair N.Nat^ B.Bool^ N.one^ B.Bool^::true :=
    \refl(P.pair N.Nat^ B.Bool^ N.one^ B.Bool^::true);
  \definition mapped: P.map B.Bool^ N.Nat^ B.Bool^ N.Nat^ B.neg^ N.pred^ reflected =
      P.pair B.Bool^ N.Nat^ B.Bool^::false N.zero^ :=
    \refl(P.pair B.Bool^ N.Nat^ B.Bool^::false N.zero^);

  /* Reflect complete operations, then prove agreement for arbitrary arguments. */
  
  
  
  
  \definition makeAgrees (b: B.Bool^) (n: N.Nat^): PP.make^ b n = P.pair B.Bool^ N.Nat^ b n := \refl(P.pair B.Bool^ N.Nat^ b n);
  \definition firstAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PP.first^ p = P.first B.Bool^ N.Nat^ p :=
    PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PP.first^ p = P.first B.Bool^ N.Nat^ p)
      (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(b));
  \definition secondAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PP.second^ p = P.second B.Bool^ N.Nat^ p :=
    PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PP.second^ p = P.second B.Bool^ N.Nat^ p)
      (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(n));
  \definition swapAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PP.swap^ p = P.swap B.Bool^ N.Nat^ p :=
    PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PP.swap^ p = P.swap B.Bool^ N.Nat^ p)
      (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(P.pair N.Nat^ B.Bool^ n b));

  
  
  
  \definition mapAgrees (f: B.Bool^ -> N.Nat^) (g: N.Nat^ -> B.Bool^):
    \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PM.map^ f g p = P.map B.Bool^ N.Nat^ N.Nat^ B.Bool^ f g p :=
      PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PM.map^ f g p = P.map B.Bool^ N.Nat^ N.Nat^ B.Bool^ f g p)
        (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(P.pair N.Nat^ B.Bool^ (f b) (g n)));
  \definition mapFirstAgrees (f: B.Bool^ -> N.Nat^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PM.mapFirst^ f p = P.mapFirst B.Bool^ N.Nat^ N.Nat^ f p :=
      PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PM.mapFirst^ f p = P.mapFirst B.Bool^ N.Nat^ N.Nat^ f p)
        (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(P.pair N.Nat^ N.Nat^ (f b) n));
  \definition mapSecondAgrees (g: N.Nat^ -> B.Bool^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PM.mapSecond^ g p = P.mapSecond B.Bool^ N.Nat^ B.Bool^ g p :=
      PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PM.mapSecond^ g p = P.mapSecond B.Bool^ N.Nat^ B.Bool^ g p)
        (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(P.pair B.Bool^ B.Bool^ b (g n)));

  
  
  \definition curryAgrees (f: P.Times^[B.Bool^, N.Nat^] -> N.Nat^) (b: B.Bool^) (n: N.Nat^):
    PF.curry^ f b n = P.curry B.Bool^ N.Nat^ N.Nat^ f b n :=
      \refl(f (P.pair B.Bool^ N.Nat^ b n));
  \definition uncurryAgrees (f: B.Bool^ -> N.Nat^ -> N.Nat^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PF.uncurry^ f p = P.uncurry B.Bool^ N.Nat^ N.Nat^ f p :=
      PL.induction (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PF.uncurry^ f p = P.uncurry B.Bool^ N.Nat^ N.Nat^ f p)
        (\fun (b: B.Bool^) => \fun (n: N.Nat^) => \refl(f b n));

  
  
  \definition assocAgrees: \forall (p: P.Times^[P.Times^[B.Bool^, N.Nat^], N.Nat^]) ->
    PF.assoc^ p = P.assoc B.Bool^ N.Nat^ N.Nat^ p :=
    \induction (p: P.Times^[P.Times^[B.Bool^, N.Nat^], N.Nat^]) \return PF.assoc^ p = P.assoc B.Bool^ N.Nat^ N.Nat^ p \with {
      | pair => (\fun (p: P.Times^[B.Bool^, N.Nat^]) => \fun (n: N.Nat^) =>
        PL.induction
          (\fun (p: P.Times^[B.Bool^, N.Nat^]) => PF.assoc^ (P.pair _ _ p n) = P.assoc _ _ _ (P.pair _ _ p n))
          (\fun (b: B.Bool^) => \fun (m: N.Nat^) => \refl(P.pair _ _ b (P.pair _ _ m n))) p)
      };
  \definition unassocAgrees: \forall (p: P.Times^[B.Bool^, P.Times^[N.Nat^, N.Nat^]]) ->
    PF.unassoc^ p = P.unassoc B.Bool^ N.Nat^ N.Nat^ p :=
    \induction (p: P.Times^[B.Bool^, P.Times^[N.Nat^, N.Nat^]]) \return PF.unassoc^ p = P.unassoc B.Bool^ N.Nat^ N.Nat^ p \with {
      | pair => (\fun (b: B.Bool^) => \fun (p: P.Times^[N.Nat^, N.Nat^]) =>
        \induction (p: P.Times^[N.Nat^, N.Nat^]) \return PF.unassoc^ (P.pair _ _ b p) = P.unassoc _ _ _ (P.pair _ _ b p) \with {
        | pair => (\fun (m, n: N.Nat^) => \refl(P.pair _ _ (P.pair _ _ b m) n))
        } p)
      };

  /* Direct Program use: type inference, type-changing maps, and thunked callbacks. */
  \definition boolToNat(b: B.Bool): \F(N.Nat) :=
    \match b \in B.Bool \with {
    | false => \return N.Nat::zero
    | true => \return N.Nat::succ N.Nat::zero
    };
  \definition natToBool(n: N.Nat): \F(B.Bool) :=
    \match n \in N.Nat \with { | zero => \return B.Bool::true | succ k => \return B.Bool::false };
  \definition pipeline: \F(B.Bool) := \program {
    \bind input: P.Times[B.Bool, N.Nat] <- P.Times::make B.Bool::true (N.Nat::succ N.Nat::zero) \then
    \bind mapped: P.Times[N.Nat, B.Bool] <- PM.map (\thunk boolToNat) (\thunk natToBool) input \then
    \bind swapped: P.Times[B.Bool, N.Nat] <- P.Times::swap mapped \then
    \bind result: B.Bool <- P.Times::first swapped \then
    \return result
  };
  \definition pipelineResult: \squash[_](\box[_](pipeline)) = B.Bool^::false := \refl(B.Bool^::false);
  \definition changeFirst: \F(P.Times[N.Nat, N.Nat]) := PM.mapFirst (\thunk boolToNat) value;
  \definition changeSecond: \F(P.Times[B.Bool, B.Bool]) := PM.mapSecond (\thunk natToBool) value;
  \definition changedFirst: \squash[_](\box[_](changeFirst)) =
    P.pair _ _ N.one^ N.one^ := \refl(P.pair _ _ N.one^ N.one^);
  \definition changedSecond: \squash[_](\box[_](changeSecond)) =
    P.pair _ _ B.Bool^::true B.Bool^::false := \refl(P.pair _ _ B.Bool^::true B.Bool^::false);
  \definition curried: \F(N.Nat) := PF.curry (\thunk PP.second) B.Bool::false (N.Nat::succ N.Nat::zero);
  \definition choose(b: B.Bool, n: N.Nat): \F(N.Nat) :=
    \match b \in B.Bool \with { | false => \return N.Nat::zero | true => \return n };
  \definition uncurried: \F(N.Nat) := PF.uncurry (\thunk choose) value;
  \definition curriedResult: \squash[_](\box[_](curried)) = N.one^ := \refl(N.one^);
  \definition uncurriedResult: \squash[_](\box[_](uncurried)) = N.one^ := \refl(N.one^);
  \definition nestedRoundTrip: \F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]) := \program {
    \bind right: P.Times[B.Bool, P.Times[N.Nat, N.Nat]] <- PF.assoc (P.Times[_, _]::pair value N.Nat::zero) \then
    \bind left: P.Times[P.Times[B.Bool, N.Nat], N.Nat] <- PF.unassoc right \then
    \return left
  };
  \definition nestedResult:
    \squash[_](\box[_](nestedRoundTrip)) = P.pair _ _ reflected N.zero^ :=
    \refl(P.pair _ _ reflected N.zero^);
}

/* The Set API also accepts carriers that have no Program representation. */
\module AbstractPairExamples(A, B, C, D: \Set, a: A, b: B) {
  \import \root.Data[].Pair[] \as P;
  \import P.Laws[A := A, B := B] \as PL;
  \import P.MapLaws[A := A, B := B, C := C, D := D] \as ML;
  \import P.FunctionLaws[A := A, B := B, C := C] \as FL;
  \definition value: P.Times^[A, B] := P.pair A B a b;
  \definition first: P.first A B value = a := \refl(a);
  \definition second: P.second A B value = b := \refl(b);
  \definition uncurried: P.uncurry A B A (\fun (x: A) => \fun (y: B) => x) value = a := \refl(a);
  \definition equalComponents: \forall (p, q: P.Times^[A, B]) ->
    P.first _ _ p = P.first _ _ q -> P.second _ _ p = P.second _ _ q -> p = q := PL.ext;
  \definition injective (x: A) (y: B): value = P.pair A B x y -> a = x := PL.pairInjectiveFirst a x b y;
  \definition separateMaps: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: P.Times^[A, B]) ->
    P.mapSecond C B D g (P.mapFirst A B C f p) = P.map A B C D f g p := ML.mapSeparate;
  \definition leftRoundTrip: \forall (p: P.Times^[P.Times^[A, B], C]) -> P.unassoc A B C (P.assoc A B C p) = p :=
    FL.unassocAssoc;
  \definition rightRoundTrip: \forall (p: P.Times^[A, P.Times^[B, C]]) -> P.assoc A B C (P.unassoc A B C p) = p :=
    FL.assocUnassoc;
}

\module EqualityExamples(A, B: \Set, f: A -> B, a, b, c: A, ab: a = b, bc: b = c) {
  \import \root.Logic[].Equality[] \as E;
  \use E.sym;
  \use E.trans;
  \use E.congr;
  \import \root.Logic[].Equality[].Laws[A := A] \as Laws;
  \definition reverse: b = a := sym!{A} _ _ ab;
  \definition chained: a = c := trans!{A} _ _ _ ab bc;
  \definition mapped: f a = f c := congr!{A B} f _ _ (Laws.trans a b c ab bc);
}

\module FiniteSubsetExamples(A: \Set, a, b: A) {
  \import \root.Set[].FiniteSubset[A := A] \as F;
  \definition empty: F.FiniteSubset := F.empty;
  \definition singleton: F.FiniteSubset := F.singleton a;
  \definition pair: F.FiniteSubset := F.unorderedPair a b;
  \definition singletonMember: \In[A] (F.Singleton a) a := F.inSingleton a;
  \definition leftMember: \In[A] (F.UnorderedPair a b) a :=
    F.inUnorderedPairLeft a b;
  \definition rightMember: \In[A] (F.UnorderedPair a b) b :=
    F.inUnorderedPairRight a b;
}

\module SumExamples(A, B: \Set, a: A, b: B) {
  \import \root.Data[].Sum[] \as S;
  \definition left: S.Sum[A, B] := S.Sum[A, B]::inl a;
  \definition right: S.Sum[A, B] := S.Sum[A, B]::inr b;
}

\module FinSetExamples {
  \import \root.Nat[] \as N;
  \import \root.Data[].FinSet[] \as F;
  \definition one: F.Fin (N.Nat^::succ N.Nat^::zero) :=
    F.zero N.Nat^::zero;
  \definition two: F.Fin (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) :=
    F.succ (N.Nat^::succ N.Nat^::zero) one;
}

\module RelationExamples(A: \Set, R: A -> A -> \Prop) {
  \import \root.Logic[].Rel[Carrier := A] \as Rel;
  \import Rel.Closure[] \as Closure;
  \definition intoReflexiveClosure:
    \forall (x, y: A) -> R x y -> Closure.ReflexiveClosure R x y :=
    Closure.reflexiveClosureOf R;
  \definition closureReflexive:
    \forall (x: A) -> Closure.ReflexiveClosure R x x :=
    Closure.reflexiveClosureRefl R;
}

\module LawExamples(
  A: \Set,
  op, other: A -> A -> A,
  unit: A,
  inverse: A -> A,
  leftUnit: \forall (x: A) -> op unit x = x,
  rightUnit: \forall (x: A) -> op x unit = x,
  leftInverse: \forall (x: A) -> op (inverse x) x = unit,
  rightInverse: \forall (x: A) -> op x (inverse x) = unit,
  leftDistrib: \forall (x, y, z: A) ->
    op x (other y z) = other (op x y) (op x z),
  rightDistrib: \forall (x, y, z: A) ->
    op (other x y) z = other (op x z) (op y z),
) {
  \import \root.Logic[].Law[] \as Law;
  \definition unital: Law.Unital[A, op, unit] :=
    Law.Unital[A, op, unit]::# leftUnit rightUnit;
  \definition invertible: Law.Invertible[A, op, unit, inverse] :=
    Law.Invertible[A, op, unit, inverse]::# leftInverse rightInverse;
  \definition distributive: Law.Distributive[A, op, other] :=
    Law.Distributive[A, op, other]::# leftDistrib rightDistrib;
}

\module RationalExamples {
  \import \root.Arithmetic[].Rat[] \as R;
  \import R.Fractions[] \as RF;
  \import RF.Operations[] \as RO;
  \import RF.Order[] \as RFO;
  \definition fractionTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y z -> RF.FractionEq x z :=
    RF.fractionEqTrans;
  \definition fractionSymmetry:
    \forall (x, y: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y x :=
    RF.fractionEqSym;
  \definition fractionMultiplicationCompatibility:
    \forall (x, y, u, v: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq u v ->
      RF.FractionEq (RO.mul x u) (RO.mul y v) :=
    RO.fractionMulRespects;
  \definition reciprocalLaw:
    \forall (x: RF.Fraction) -> RF.NumeratorNonZero x ->
      RF.FractionEq (RO.mul x (RO.reciprocal x)) RF.one :=
    RO.fractionMulReciprocal;
  \definition fractionAdditionZero:
    \forall (x: RF.Fraction) ->
      RF.FractionEq (RO.add x RF.zero) x :=
    RO.fractionAddZeroRight;
  \definition fractionOrderTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.lt x y -> RF.lt y z -> RF.lt x z := RFO.ltTrans;
  \definition fractionOrderCompatibility:
    \forall (x, x2, y, y2: RF.Fraction) ->
      RF.FractionEq x x2 -> RF.FractionEq y y2 -> RF.lt x y ->
      RF.lt x2 y2 := RFO.ltRespects;
  \import RO.Quotient[] \as RQ;
  \definition quotientNegation: RQ.Rat -> RQ.Rat := RQ.neg;
  \definition quotientNegationInvolutive:
    \forall (x: RQ.Rat) -> RQ.neg (RQ.neg x) = x := RQ.negInvolutive;
  \definition quotientNegatesInteger:
    \forall (n: RQ.IntegerCarrier) ->
      RQ.neg (RQ.ofInteger n) = RQ.ofInteger (RQ.integerNeg n) :=
    RQ.negOfInteger;
  \definition quotientMultiplication:
    RQ.Rat -> RQ.Rat -> RQ.Rat := RQ.mulRat;
  \definition quotientMultiplicationCommutative:
    \forall (x, y: RQ.Rat) ->
      RQ.mulRat x y = RQ.mulRat y x :=
    RQ.mulRatComm;
}

\module DedekindRealExamples {
  \import \root.Reals[].DedekindReal[] \as D;
  \import D.Operations[] \as DO;
  \import DO.Closed[] \as DC;
  \import DC.Laws[] \as DL;
  \import DC.Field[] \as DF;
  \import \root.Reals[].AxiomaticReals[Carrier := D.Real] \as DAR;
  \import DO.CutLaws[] \as DCL;
  \import D.Completeness[] \as DComplete;
  \definition orderReflexive:
    \forall (x: D.Real) -> D.Le x x := D.leRefl;
  \definition additionAssociative:
    \forall (x, y, z: D.Real) ->
      DC.add (DC.add x y) z = DC.add x (DC.add y z) := DL.addAssoc;
  \definition additionInverse:
    \forall (x: D.Real) -> DC.add (DC.neg x) x = DC.zero := DL.addNegLeft;
  \definition rationalAddition:
    \forall (a, b: D.Rat) ->
      DC.add (DC.ofRat a) (DC.ofRat b) = DC.ofRat (D.addRat a b) :=
    DL.ofRatAdd;
  \definition rationalStrictOrder:
    \forall (a, b: D.Rat) -> D.lt a b -> D.Lt (DC.ofRat a) (DC.ofRat b) :=
    DL.ltOfRat;
  \definition additiveGroup: DL.CommutativeGroup :=
    DL.additiveCommutativeGroup;
  \definition multiplicationCommutative:
    \forall (x, y: D.Real) -> DC.mul x y = DC.mul y x := DL.mulComm;
  \definition multiplicationIdentity:
    \forall (x: D.Real) -> DC.mul DC.one x = x := DL.mulOneLeft;
  \definition multiplicationZero:
    \forall (x: D.Real) -> DC.mul DC.zero x = DC.zero := DL.mulZeroLeft;
  \definition inverse: D.Real -> D.Real := DC.inv;
  \definition inverseClosure:
    \forall (x: D.Real) ->
      \In[\Pow D.Rat] D.CutSet (DO.InvLower x) :=
    DCL.invCut;
  \definition lowerCompleteness:
    \forall (S: \Pow D.Real) -> DComplete.Nonempty S ->
      DComplete.BoundedBelow S ->
      \exists { l : D.Real \where DComplete.GreatestLowerBound S l } :=
    DComplete.completeBelow;
}

\module CauchyRealExamples {
  \import \root.Reals[].CauchyReal[] \as C;
  \import C.Completeness[] \as CComplete;
  \import C.Order[] \as COrder;
  \import C.Quotient[] \as CQ;
  \import CQ.Operations[] \as CO;
  \import CO.SequenceClosed[] \as CS;
  \import CS.ClassClosed[] \as CR;
  \definition closenessSymmetry:
    \forall (x, y, eps: C.Rat) ->
      C.Close x y eps -> C.Close y x eps :=
    C.closeSym;
  \definition sequenceEquivalenceSymmetry:
    \forall (x, y: C.CauchySeq) ->
      C.Equivalent x y -> C.Equivalent y x :=
    C.equivalentSym;
  \definition sequenceEquivalenceTransitivity:
    \forall (x, y, z: C.CauchySeq) ->
      C.Equivalent x y -> C.Equivalent y z -> C.Equivalent x z :=
    C.equivalentTrans;
  \definition additionAssociative:
    \forall (x, y, z: CQ.Real) ->
      CR.add (CR.add x y) z = CR.add x (CR.add y z) :=
    CR.addAssoc;
  \definition additionInverse:
    \forall (x: CQ.Real) -> CR.add (CR.neg x) x = CR.zero :=
    CR.addNegLeft;
  \definition negationInvolutive:
    \forall (x: CQ.Real) -> CR.neg (CR.neg x) = x :=
    CR.negInvolutive;
  \import \root.Reals[].AxiomaticReals[Carrier := CQ.Real] \as CAR;
  \definition completeness: CAR.Completeness COrder.raw :=
    CComplete.completeness;
  \definition axiomaticReal: CAR.AxiomaticRealStructure :=
    CComplete.axiomaticReal;
}

\module QuotientExamples(A: \Set, x, y: A, xy: x = y) {
  \import \root.Logic[].Equality[].Laws[A := A] \as E;
  \import \root.Set[].Quotient[
    A := A, Equivalent := (\fun (a, b: A) => a = b),
    equivalentRefl := (\fun (a: A) => \refl(a)), equivalentSym := E.sym, equivalentTrans := E.trans
  ] \as Q;
  \definition equalClasses: Q.ClassOf x = Q.ClassOf y := Q.classOfEq x y xy;
  \definition extensionality: \forall (a, b: Q.Carrier) ->
    (\forall (z: A) -> Q.mem a z -> Q.mem b z) -> (\forall (z: A) -> Q.mem b z -> Q.mem a z) -> a = b := Q.eqByExt;
  \definition identityRespects: Q.UnaryRespects (\fun (a: A) => a) :=
    \fun (a, b: A) => \fun (ab: a = b) => ab;
  \definition identityImageClosed:
    \forall (a: Q.Carrier) -> Q.IsClass (Q.UnaryImage (\fun (z: A) => z) a) :=
    Q.unaryImageClosed (\fun (z: A) => z) identityRespects;
}
