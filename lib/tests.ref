/* Concrete boundary cases supplement the universally quantified library laws. */
\module Logic;
\module Equality;

\module Quotient(
  A: \Set,
  Equivalent: A -> A -> \Prop,
  equivalentRefl: \forall (x: A) -> Equivalent x x,
  equivalentSym: \forall (x, y: A) -> Equivalent x y -> Equivalent y x,
  equivalentTrans: \forall (x, y, z: A) -> Equivalent x y -> Equivalent y z -> Equivalent x z,
);

\module Pair;
\module Bool;
\module Nat;
\module Int;

\module Monoid(Carrier: \Set);
\module Algebra(Carrier: \Set);
\module IntAlgebra;
\module ArithmeticExamples {
  \import \root.Nat() \as N;
  \import N.Laws() \as NL;
  \import NL.Division() \as ND;
  \definition z: N.Nat := N.Nat::zero;
  \definition one: N.Nat := N.Nat::succ z;
  \definition two: N.Nat := N.Nat::succ one;
  \definition three: N.Nat := N.Nat::succ two;
  \definition four: N.Nat := N.Nat::succ three;
  \definition six: N.Nat := N.Nat::succ (N.Nat::succ four);
  \definition eight: N.Nat := N.Nat::succ (N.Nat::succ six);
  \definition sum: N.addSet two three = N.Nat::succ four := \refl(N.Nat::succ four);
  \definition subtract: N.subSet three two = one := \refl(one);
  \definition truncated: N.subSet two three = z := \refl(z);
  \definition product: N.mulSet two three = six := \refl(six);
  \definition power: N.powSet two three = eight := \refl(eight);
  \definition zeroPowerZero: N.powSet z z = one := \refl(one);
  \definition minLeft: N.minSet two three = two := \refl(two);
  \definition minRight: N.minSet three two = two := \refl(two);
  \definition maxLeft: N.maxSet three two = three := \refl(three);
  \definition maxRight: N.maxSet two three = three := \refl(three);
  \definition minSame: N.minSet two two = two := \refl(two);
  \definition maxSame: N.maxSet two two = two := \refl(two);
  \definition less: NL.Lt two three := \refl(N.ltbSet z one);
  \definition notLess: N.ltbSet three two = N.ltbSet z z := \refl(N.ltbSet z z);
  \definition notLe: N.lebSet three two = N.lebSet one z := \refl(N.lebSet one z);
  \definition equal: N.eqbSet two two = N.eqbSet z z := \refl(N.eqbSet z z);
  \definition unequal: N.eqbSet two three = N.eqbSet z one := \refl(N.eqbSet z one);
  \definition evenFour: N.evenSet four = N.evenSet z := \refl(N.evenSet z);
  \definition oddThree: N.oddSet three = N.oddSet one := \refl(N.oddSet one);
  \definition evenThree: N.evenSet three = N.evenSet one := \refl(N.evenSet one);
  \definition oddFour: N.oddSet four = N.oddSet z := \refl(N.oddSet z);
  /* Quotient/remainder boundaries and several Euclidean transitions. */
  \definition quotientExact: N.divSet six two = three := \refl(three);
  \definition quotientInexact: N.divSet eight three = two := \refl(two);
  \definition quotientSmall: N.divSet two three = z := \refl(z);
  \definition remainderExact: N.modSet six three = z := \refl(z);
  \definition remainderInexact: N.modSet eight three = two := \refl(two);
  \definition remainderSmall: N.modSet two three = two := \refl(two);
  \definition divisionTogether: N.divModSet eight three = N.natPair two two :=
    \refl(N.natPair two two);
  \definition divisionByZero: N.divSet three z = z := \refl(z);
  \definition remainderByZero: N.modSet three z = three := \refl(three);
  \definition divisionZeroZero: N.divSet z z = z := \refl(z);
  \definition remainderZeroZero: N.modSet z z = z := \refl(z);
  \definition divisionByOne: N.divSet four one = four := \refl(four);
  \definition remainderByOne: N.modSet four one = z := \refl(z);
  \definition divisionSelf: N.divSet three three = one := \refl(one);
  \definition remainderSelf: N.modSet three three = z := \refl(z);
  \definition gcdNontrivial: N.gcdSet eight six = two := \refl(two);
  \definition gcdReversed: N.gcdSet six eight = two := \refl(two);
  \definition gcdCoprime: N.gcdSet eight three = one := \refl(one);
  \definition gcdDivisible: N.gcdSet six three = three := \refl(three);
  \definition gcdSame: N.gcdSet three three = three := \refl(three);
  \definition gcdWithOne: N.gcdSet four one = one := \refl(one);
  \definition gcdLeftZero: N.gcdSet z three = three := \refl(three);
  \definition gcdRightZero: N.gcdSet three z = three := \refl(three);
  \definition gcdBothZero: N.gcdSet z z = z := \refl(z);
  \definition importedDivSpecification: \forall (a, b: N.Nat) -> N.divSet a b = N.divPrec a b := N.divMatchesPrec;
  \definition importedModSpecification: \forall (a, b: N.Nat) -> N.modSet a b = N.modPrec a b := N.modMatchesPrec;
  \definition importedGcdSpecification: \forall (a, b: N.Nat) -> N.gcdSet a b = N.gcdPrec a b := N.gcdMatchesPrec;
  \definition importedDivisionLaw: \forall (a, b: N.Nat) ->
    N.addSet (N.mulSet b (N.divSet a b)) (N.modSet a b) = a := ND.divModReconstructs;
  \definition importedRemainderBound: \forall (a, d: N.Nat) ->
    NL.Lt (N.modSet a (N.Nat::succ d)) (N.Nat::succ d) := ND.modLt;
  \definition importedGcdDividesLeft: \forall (a, b: N.Nat) -> ND.Divides (N.gcdSet a b) a := ND.gcdDividesLeft;
  \definition importedGcdDividesRight: \forall (a, b: N.Nat) -> ND.Divides (N.gcdSet a b) b := ND.gcdDividesRight;
  \definition importedGcdGreatest: \forall (d, a, b: N.Nat) ->
    ND.Divides d a -> ND.Divides d b -> ND.Divides d (N.gcdSet a b) := ND.gcdGreatest;
  \definition importedAddLaw: \forall (a, b: N.Nat) -> N.addSet a b = N.addSet b a := NL.addComm;
  \definition importedMulLaw: \forall (a, b, c: N.Nat) ->
    N.mulSet (N.mulSet a b) c = N.mulSet a (N.mulSet b c) := NL.mulAssoc;
  \definition importedPositiveCancellation: \forall (k, a, b: N.Nat) ->
    N.mulSet a (N.Nat::succ k) = N.mulSet b (N.Nat::succ k) -> a = b :=
    NL.mulCancelRightSucc;
  \definition importedSpecification: \forall (a, b: N.Nat) -> N.mulSet a b = N.mulPrec a b :=
    N.mulMatchesPrec;
}

\module AlgebraExamples {
  \import \root.Nat() \as N;
  \import N.Laws() \as NL;
  \import \root.Monoid(Carrier := N.Nat) \as M;
  \import \root.Algebra(Carrier := N.Nat) \as A;

  \definition additiveRaw: M.RawMonoid := \record M.RawMonoid {
    unit := N.zeroSet,
    op := N.addSet,
  };
  \definition additiveLaws: M.MonoidLaws[additiveRaw] :=
    M.monoidLawsIntro additiveRaw
      NL.addZeroLeft NL.addZeroRight NL.addAssoc;
  \definition additiveMonoid: M.Monoid :=
    \subsetinto(M.RawMonoid, M.MonoidSet, additiveRaw, additiveLaws);
  \definition additiveIdentity: \forall (n: N.Nat) ->
    M.op additiveMonoid (M.unit additiveMonoid) n = n :=
    M.leftIdentity additiveMonoid;

  \definition naturalSemiringRaw: A.RawSemiring := \record A.RawSemiring {
    zero := N.zeroSet,
    one := N.oneSet,
    add := N.addSet,
    mul := N.mulSet,
  };
  \definition naturalSemiringLaws: A.SemiringLaws[naturalSemiringRaw] :=
    A.semiringLawsIntro naturalSemiringRaw
      NL.addZeroLeft NL.addZeroRight NL.addAssoc NL.addComm
      NL.mulOneLeft NL.mulOneRight NL.mulAssoc
      NL.mulDistribLeft NL.mulDistribRight
      NL.mulZeroLeft NL.mulZeroRight;
  \definition naturalSemiring: A.Semiring :=
    \subsetinto(A.RawSemiring, A.SemiringSet,
      naturalSemiringRaw, naturalSemiringLaws);
}

\module BooleanExamples {
  \import \root.Bool() \as B;
  \definition neg: B.negSet B.Bool::false = B.Bool::true := \refl(B.Bool::true);
  \definition xor: B.xorSet B.Bool::true B.Bool::true = B.Bool::false := \refl(B.Bool::false);
  \definition implication: B.impliesSet B.Bool::true B.Bool::false = B.Bool::false := \refl(B.Bool::false);
  \definition importedLaw: \forall (a: B.Bool) -> B.negSet (B.negSet a) = a := B.negInvolutive;
}

\module IntegerExamples {
  \import \root.Int() \as I;
  \import I.Math() \as IM;
  \import IM.Specification() \as IS;
  \import IS.Laws() \as IL;
  \use I.natZero;
  \use I.natSucc;
  \use I.boolTrue;
  \use I.boolFalse;
  \definition z: I.Nat := natZero!{};
  \definition one: I.Nat := natSucc!{z};
  \definition two: I.Nat := natSucc!{one};
  \definition three: I.Nat := natSucc!{two};
  \definition four: I.Nat := natSucc!{three};
  \definition six: I.Nat := natSucc!{{ natSucc!{four} }};
  \definition eight: I.Nat := natSucc!{{ natSucc!{six} }};
  \definition p2: I.Int := I.Int::ofNat two;
  \definition p3: I.Int := I.Int::ofNat three;
  \definition m2: I.Int := I.Int::negSucc one;
  \definition m3: I.Int := I.Int::negSucc two;
  \definition zeroNegation: I.negSet I.zeroSet = I.zeroSet := \refl(I.zeroSet);
  \definition negativeZero: I.negOfNatSet z = I.zeroSet := \refl(I.zeroSet);
  \definition successorAcrossZero: I.succSet I.minusOneSet = I.zeroSet := \refl(I.zeroSet);
  \definition predecessorAcrossZero: I.predSet I.zeroSet = I.minusOneSet := \refl(I.minusOneSet);
  \definition positiveSum: I.addSet p2 p3 = I.Int::ofNat (natSucc!{four}) := \refl(I.Int::ofNat (natSucc!{four}));
  \definition negativeSum: I.addSet m2 m3 = I.Int::negSucc four := \refl(I.Int::negSucc four);
  \definition mixedPositive: I.addSet p3 m2 = I.oneSet := \refl(I.oneSet);
  \definition mixedNegative: I.addSet p2 m3 = I.minusOneSet := \refl(I.minusOneSet);
  \definition cancel: I.addSet p3 m3 = I.zeroSet := \refl(I.zeroSet);
  \definition signedSubtraction: I.subSet m2 p3 = I.Int::negSucc four := \refl(I.Int::negSucc four);
  \definition negativeProduct: I.mulSet p2 m3 = I.Int::negSucc (natSucc!{four}) := \refl(I.Int::negSucc (natSucc!{four}));
  \definition positiveProduct: I.mulSet m2 m3 = I.Int::ofNat six := \refl(I.Int::ofNat six);
  \definition zeroProduct: I.mulSet I.zeroSet m3 = I.zeroSet := \refl(I.zeroSet);
  \definition oddPower: I.powSet m2 three = I.Int::negSucc (natSucc!{six}) := \refl(I.Int::negSucc (natSucc!{six}));
  \definition evenPower: I.powSet m2 two = I.Int::ofNat four := \refl(I.Int::ofNat four);
  \definition zeroPowerZero: I.powSet I.zeroSet z = I.oneSet := \refl(I.oneSet);
  \definition absolute: I.absSet m3 = p3 := \refl(p3);
  \definition magnitude: I.natAbsSet m3 = three := \refl(three);
  \definition signNegative: I.signSet m3 = I.minusOneSet := \refl(I.minusOneSet);
  \definition signZero: I.signSet I.zeroSet = I.zeroSet := \refl(I.zeroSet);
  \definition signPositive: I.signSet p3 = I.oneSet := \refl(I.oneSet);
  \definition equalityTrue: I.eqbSet m3 m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition equalityFalse: I.eqbSet m3 p3 = boolFalse!{} := \refl(boolFalse!{});
  \definition negativeOrder: I.ltbSet m3 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition crossingOrder: I.lebSet m3 p2 = boolTrue!{} := \refl(boolTrue!{});
  \definition reversedOrder: I.lebSet p2 m3 = boolFalse!{} := \refl(boolFalse!{});
  \definition equalOrder: I.lebSet m2 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition strictEqual: I.ltbSet m2 m2 = boolFalse!{} := \refl(boolFalse!{});
  \definition minimum: I.minSet m3 p2 = m3 := \refl(m3);
  \definition maximum: I.maxSet m3 m2 = m2 := \refl(m2);
  \definition negativeEven: I.evenSet m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition negativeOdd: I.oddSet m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition reducedDifference: I.diffSet three two = I.oneSet := \refl(I.oneSet);
  \definition quotientCancellation: IS.diffMath three two = IS.diffMath one z :=
    IM.classOfEq (I.pair three two) (I.pair one z) (\refl(three));
  \definition noncanonicalSum:
    IM.addMath (IM.class (I.pair three two)) (IM.class (I.pair two three)) =
      IM.class (IM.addRep (I.pair three two) (I.pair two three)) :=
    IM.addMathClass (I.pair three two) (I.pair two three);
  \definition roundTrip: \forall (x: I.Int) -> IM.fromMath (IM.toMath x) = x := IM.fromTo;
  \definition quotientRoundTrip: \forall (x: IM.Grothendieck) -> IM.toMath (IM.fromMath x) = x := IM.toFrom;
  \definition additionAgreement: \forall (x, y: I.Int) ->
    IM.toMath (I.addSet x y) = IM.addMath (IM.toMath x) (IM.toMath y) := IM.addMatchesMath;
  \definition multiplicationAgreement: \forall (x, y: I.Int) ->
    IM.toMath (I.mulSet x y) = IM.mulMath (IM.toMath x) (IM.toMath y) := IM.mulMatchesMath;
  \definition inverseLaw: \forall (x: I.Int) -> I.addSet (I.negSet x) x = I.zeroSet := IL.negInverse;
  \definition rightInverseLaw: \forall (x: I.Int) -> I.addSet x (I.negSet x) = I.zeroSet := IL.negInverseRight;
  \definition additionAssociative: \forall (x, y, z: I.Int) ->
    I.addSet (I.addSet x y) z = I.addSet x (I.addSet y z) := IL.addAssoc;
  \definition multiplicationCommutative: \forall (x, y: I.Int) ->
    I.mulSet x y = I.mulSet y x := IL.mulComm;
}

\module IntegerAlgebraExamples {
  \import \root.IntAlgebra() \as IA;
  \definition additiveGroup: IA.Group := IA.additiveGroup;
  \definition additiveCommutativeGroup: IA.CommutativeGroup :=
    IA.additiveCommutativeGroup;
}

/* Heterogeneous products share one Program datatype and Set mirror. */
\module PairExamples {
  \import \root.Pair() \as P;
  \import \root.Bool() \as B;
  \import \root.Nat() \as N;
  \import P.Laws(A := B.Bool, B := N.Nat) \as PL;
  \import P.Program(A := B.Bool, B := N.Nat) \as PP;
  \import PP.Mapping(C := N.Nat, D := B.Bool) \as PM;
  \import PP.Functions(C := N.Nat) \as PF;

  \vdefinition value: P.Times[B.Bool, N.Nat] :=
    P.Times[_, _]::pair B.Bool::true (N.Nat::succ N.Nat::zero);
  \definition reflected: P.Times[B.Bool, N.Nat] :=
    \Force(P.Times[B.Bool, N.Nat], \box(P.Times[B.Bool, N.Nat], value));
  \definition first: P.first B.Bool N.Nat reflected = B.Bool::true := \refl(B.Bool::true);
  \definition second: P.second B.Bool N.Nat reflected = N.oneSet := \refl(N.oneSet);
  \definition swapped: P.swap B.Bool N.Nat reflected = P.pair N.Nat B.Bool N.oneSet B.Bool::true :=
    \refl(P.pair N.Nat B.Bool N.oneSet B.Bool::true);
  \definition mapped: P.map B.Bool N.Nat B.Bool N.Nat B.negSet N.predSet reflected =
      P.pair B.Bool N.Nat B.Bool::false N.zeroSet :=
    \refl(P.pair B.Bool N.Nat B.Bool::false N.zeroSet);

  /* Reflect complete operations, then prove agreement for arbitrary arguments. */
  \definition makeSet: B.Bool -> N.Nat -> P.Times[B.Bool, N.Nat] :=
    \Force(B.Bool ~> N.Nat ~> \F(P.Times[B.Bool, N.Nat]),
      \box(B.Bool ~> N.Nat ~> \F(P.Times[B.Bool, N.Nat]), PP.make));
  \definition firstSet: P.Times[B.Bool, N.Nat] -> B.Bool :=
    \Force(P.Times[B.Bool, N.Nat] ~> \F(B.Bool),
      \box(P.Times[B.Bool, N.Nat] ~> \F(B.Bool), PP.first));
  \definition secondSet: P.Times[B.Bool, N.Nat] -> N.Nat :=
    \Force(P.Times[B.Bool, N.Nat] ~> \F(N.Nat),
      \box(P.Times[B.Bool, N.Nat] ~> \F(N.Nat), PP.second));
  \definition swapSet: P.Times[B.Bool, N.Nat] -> P.Times[N.Nat, B.Bool] :=
    \Force(P.Times[B.Bool, N.Nat] ~> \F(P.Times[N.Nat, B.Bool]),
      \box(P.Times[B.Bool, N.Nat] ~> \F(P.Times[N.Nat, B.Bool]), PP.swap));
  \definition makeAgrees: \forall (b: B.Bool) -> \forall (n: N.Nat) -> makeSet b n = P.pair B.Bool N.Nat b n :=
    \fun (b: B.Bool) => \fun (n: N.Nat) => \refl(P.pair B.Bool N.Nat b n);
  \definition firstAgrees: \forall (p: P.Times[B.Bool, N.Nat]) -> firstSet p = P.first B.Bool N.Nat p :=
    PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => firstSet p = P.first B.Bool N.Nat p)
      (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(b));
  \definition secondAgrees: \forall (p: P.Times[B.Bool, N.Nat]) -> secondSet p = P.second B.Bool N.Nat p :=
    PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => secondSet p = P.second B.Bool N.Nat p)
      (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(n));
  \definition swapAgrees: \forall (p: P.Times[B.Bool, N.Nat]) -> swapSet p = P.swap B.Bool N.Nat p :=
    PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => swapSet p = P.swap B.Bool N.Nat p)
      (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(P.pair N.Nat B.Bool n b));

  \definition mapSet: (B.Bool -> N.Nat) -> (N.Nat -> B.Bool) -> P.Times[B.Bool, N.Nat] -> P.Times[N.Nat, B.Bool] :=
    \Force(\U(B.Bool ~> \F(N.Nat)) ~> \U(N.Nat ~> \F(B.Bool)) ~> P.Times[B.Bool, N.Nat] ~> \F(P.Times[N.Nat, B.Bool]),
      \box(\U(B.Bool ~> \F(N.Nat)) ~> \U(N.Nat ~> \F(B.Bool)) ~> P.Times[B.Bool, N.Nat] ~> \F(P.Times[N.Nat, B.Bool]), PM.map));
  \definition mapFirstSet: (B.Bool -> N.Nat) -> P.Times[B.Bool, N.Nat] -> P.Times[N.Nat, N.Nat] :=
    \Force(\U(B.Bool ~> \F(N.Nat)) ~> P.Times[B.Bool, N.Nat] ~> \F(P.Times[N.Nat, N.Nat]),
      \box(\U(B.Bool ~> \F(N.Nat)) ~> P.Times[B.Bool, N.Nat] ~> \F(P.Times[N.Nat, N.Nat]), PM.mapFirst));
  \definition mapSecondSet: (N.Nat -> B.Bool) -> P.Times[B.Bool, N.Nat] -> P.Times[B.Bool, B.Bool] :=
    \Force(\U(N.Nat ~> \F(B.Bool)) ~> P.Times[B.Bool, N.Nat] ~> \F(P.Times[B.Bool, B.Bool]),
      \box(\U(N.Nat ~> \F(B.Bool)) ~> P.Times[B.Bool, N.Nat] ~> \F(P.Times[B.Bool, B.Bool]), PM.mapSecond));
  \definition mapAgrees: \forall (f: B.Bool -> N.Nat) -> \forall (g: N.Nat -> B.Bool) ->
    \forall (p: P.Times[B.Bool, N.Nat]) -> mapSet f g p = P.map B.Bool N.Nat N.Nat B.Bool f g p :=
    \fun (f: B.Bool -> N.Nat) => \fun (g: N.Nat -> B.Bool) =>
      PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => mapSet f g p = P.map B.Bool N.Nat N.Nat B.Bool f g p)
        (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(P.pair N.Nat B.Bool (f b) (g n)));
  \definition mapFirstAgrees: \forall (f: B.Bool -> N.Nat) -> \forall (p: P.Times[B.Bool, N.Nat]) ->
    mapFirstSet f p = P.mapFirst B.Bool N.Nat N.Nat f p :=
    \fun (f: B.Bool -> N.Nat) =>
      PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => mapFirstSet f p = P.mapFirst B.Bool N.Nat N.Nat f p)
        (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(P.pair N.Nat N.Nat (f b) n));
  \definition mapSecondAgrees: \forall (g: N.Nat -> B.Bool) -> \forall (p: P.Times[B.Bool, N.Nat]) ->
    mapSecondSet g p = P.mapSecond B.Bool N.Nat B.Bool g p :=
    \fun (g: N.Nat -> B.Bool) =>
      PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => mapSecondSet g p = P.mapSecond B.Bool N.Nat B.Bool g p)
        (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(P.pair B.Bool B.Bool b (g n)));

  \definition currySet: (P.Times[B.Bool, N.Nat] -> N.Nat) -> B.Bool -> N.Nat -> N.Nat :=
    \Force(\U(P.Times[B.Bool, N.Nat] ~> \F(N.Nat)) ~> B.Bool ~> N.Nat ~> \F(N.Nat),
      \box(\U(P.Times[B.Bool, N.Nat] ~> \F(N.Nat)) ~> B.Bool ~> N.Nat ~> \F(N.Nat), PF.curry));
  \definition uncurrySet: (B.Bool -> N.Nat -> N.Nat) -> P.Times[B.Bool, N.Nat] -> N.Nat :=
    \Force(\U(B.Bool ~> N.Nat ~> \F(N.Nat)) ~> P.Times[B.Bool, N.Nat] ~> \F(N.Nat),
      \box(\U(B.Bool ~> N.Nat ~> \F(N.Nat)) ~> P.Times[B.Bool, N.Nat] ~> \F(N.Nat), PF.uncurry));
  \definition curryAgrees: \forall (f: P.Times[B.Bool, N.Nat] -> N.Nat) -> \forall (b: B.Bool) -> \forall (n: N.Nat) ->
    currySet f b n = P.curry B.Bool N.Nat N.Nat f b n :=
    \fun (f: P.Times[B.Bool, N.Nat] -> N.Nat) => \fun (b: B.Bool) => \fun (n: N.Nat) =>
      \refl(f (P.pair B.Bool N.Nat b n));
  \definition uncurryAgrees: \forall (f: B.Bool -> N.Nat -> N.Nat) -> \forall (p: P.Times[B.Bool, N.Nat]) ->
    uncurrySet f p = P.uncurry B.Bool N.Nat N.Nat f p :=
    \fun (f: B.Bool -> N.Nat -> N.Nat) =>
      PL.induction (\fun (p: P.Times[B.Bool, N.Nat]) => uncurrySet f p = P.uncurry B.Bool N.Nat N.Nat f p)
        (\fun (b: B.Bool) => \fun (n: N.Nat) => \refl(f b n));

  \definition assocSet: P.Times[P.Times[B.Bool, N.Nat], N.Nat] -> P.Times[B.Bool, P.Times[N.Nat, N.Nat]] :=
    \Force(P.Times[P.Times[B.Bool, N.Nat], N.Nat] ~> \F(P.Times[B.Bool, P.Times[N.Nat, N.Nat]]),
      \box(P.Times[P.Times[B.Bool, N.Nat], N.Nat] ~> \F(P.Times[B.Bool, P.Times[N.Nat, N.Nat]]), PF.assoc));
  \definition unassocSet: P.Times[B.Bool, P.Times[N.Nat, N.Nat]] -> P.Times[P.Times[B.Bool, N.Nat], N.Nat] :=
    \Force(P.Times[B.Bool, P.Times[N.Nat, N.Nat]] ~> \F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]),
      \box(P.Times[B.Bool, P.Times[N.Nat, N.Nat]] ~> \F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]), PF.unassoc));
  \definition assocAgrees: \forall (p: P.Times[P.Times[B.Bool, N.Nat], N.Nat]) ->
    assocSet p = P.assoc B.Bool N.Nat N.Nat p :=
    \prec(\Prop, P.Times[P.Times[B.Bool, N.Nat], N.Nat])
      (\fun (p: P.Times[P.Times[B.Bool, N.Nat], N.Nat]) => assocSet p = P.assoc B.Bool N.Nat N.Nat p)
      (\fun (p: P.Times[B.Bool, N.Nat]) => \fun (n: N.Nat) =>
        PL.induction
          (\fun (p: P.Times[B.Bool, N.Nat]) => assocSet (P.pair _ _ p n) = P.assoc _ _ _ (P.pair _ _ p n))
          (\fun (b: B.Bool) => \fun (m: N.Nat) => \refl(P.pair _ _ b (P.pair _ _ m n))) p);
  \definition unassocAgrees: \forall (p: P.Times[B.Bool, P.Times[N.Nat, N.Nat]]) ->
    unassocSet p = P.unassoc B.Bool N.Nat N.Nat p :=
    \prec(\Prop, P.Times[B.Bool, P.Times[N.Nat, N.Nat]])
      (\fun (p: P.Times[B.Bool, P.Times[N.Nat, N.Nat]]) => unassocSet p = P.unassoc B.Bool N.Nat N.Nat p)
      (\fun (b: B.Bool) => \fun (p: P.Times[N.Nat, N.Nat]) =>
        \prec(\Prop, P.Times[N.Nat, N.Nat])
          (\fun (p: P.Times[N.Nat, N.Nat]) => unassocSet (P.pair _ _ b p) = P.unassoc _ _ _ (P.pair _ _ b p))
          (\fun (m, n: N.Nat) => \refl(P.pair _ _ (P.pair _ _ b m) n)) p);

  /* Direct Program use: type inference, type-changing maps, and thunked callbacks. */
  \cdefinition boolToNat(b: B.Bool): \F(N.Nat) :=
    \match b \in B.Bool \with {
    | false => \return N.Nat::zero;
    | true => \return N.Nat::succ N.Nat::zero;
    };
  \cdefinition natToBool(n: N.Nat): \F(B.Bool) :=
    \match n \in N.Nat \with { | zero => \return B.Bool::true; | succ k => \return B.Bool::false; };
  \cdefinition pipeline: \F(B.Bool) := \block {
    \bind input: P.Times[B.Bool, N.Nat] <- P.Times::make B.Bool::true (N.Nat::succ N.Nat::zero);
    \bind mapped: P.Times[N.Nat, B.Bool] <- PM.map (\thunk boolToNat) (\thunk natToBool) input;
    \bind swapped: P.Times[B.Bool, N.Nat] <- P.Times::swap mapped;
    \bind result: B.Bool <- P.Times::first swapped;
    \return result;
  };
  \definition pipelineResult: \Force(\F(B.Bool), \box(\F(B.Bool), pipeline)) = B.Bool::false := \refl(B.Bool::false);
  \cdefinition changeFirst: \F(P.Times[N.Nat, N.Nat]) := PM.mapFirst (\thunk boolToNat) value;
  \cdefinition changeSecond: \F(P.Times[B.Bool, B.Bool]) := PM.mapSecond (\thunk natToBool) value;
  \definition changedFirst: \Force(\F(P.Times[N.Nat, N.Nat]), \box(\F(P.Times[N.Nat, N.Nat]), changeFirst)) =
    P.pair _ _ N.oneSet N.oneSet := \refl(P.pair _ _ N.oneSet N.oneSet);
  \definition changedSecond: \Force(\F(P.Times[B.Bool, B.Bool]), \box(\F(P.Times[B.Bool, B.Bool]), changeSecond)) =
    P.pair _ _ B.Bool::true B.Bool::false := \refl(P.pair _ _ B.Bool::true B.Bool::false);
  \cdefinition curried: \F(N.Nat) := PF.curry (\thunk PP.second) B.Bool::false (N.Nat::succ N.Nat::zero);
  \cdefinition choose(b: B.Bool, n: N.Nat): \F(N.Nat) :=
    \match b \in B.Bool \with { | false => \return N.Nat::zero; | true => \return n; };
  \cdefinition uncurried: \F(N.Nat) := PF.uncurry (\thunk choose) value;
  \definition curriedResult: \Force(\F(N.Nat), \box(\F(N.Nat), curried)) = N.oneSet := \refl(N.oneSet);
  \definition uncurriedResult: \Force(\F(N.Nat), \box(\F(N.Nat), uncurried)) = N.oneSet := \refl(N.oneSet);
  \cdefinition nestedRoundTrip: \F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]) := \block {
    \bind right: P.Times[B.Bool, P.Times[N.Nat, N.Nat]] <- PF.assoc (P.Times[_, _]::pair value N.Nat::zero);
    \bind left: P.Times[P.Times[B.Bool, N.Nat], N.Nat] <- PF.unassoc right;
    \return left;
  };
  \definition nestedResult:
    \Force(\F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]),
      \box(\F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]), nestedRoundTrip)) = P.pair _ _ reflected N.zeroSet :=
    \refl(P.pair _ _ reflected N.zeroSet);
}

/* The Set API also accepts carriers that have no Program representation. */
\module AbstractPairExamples(A, B, C, D: \Set, a: A, b: B) {
  \import \root.Pair() \as P;
  \import P.Laws(A := A, B := B) \as PL;
  \import P.MapLaws(A := A, B := B, C := C, D := D) \as ML;
  \import P.FunctionLaws(A := A, B := B, C := C) \as FL;
  \definition value: P.Times[A, B] := P.pair A B a b;
  \definition first: P.first A B value = a := \refl(a);
  \definition second: P.second A B value = b := \refl(b);
  \definition uncurried: P.uncurry A B A (\fun (x: A) => \fun (y: B) => x) value = a := \refl(a);
  \definition rebuild: \forall (p: P.Times[A, B]) -> P.pair _ _ (P.first _ _ p) (P.second _ _ p) = p := PL.eta;
  \definition equalComponents: \forall (p, q: P.Times[A, B]) ->
    P.first _ _ p = P.first _ _ q -> P.second _ _ p = P.second _ _ q -> p = q := PL.ext;
  \definition injective: \forall (x: A) -> \forall (y: B) -> value = P.pair A B x y -> a = x :=
    \fun (x: A) => \fun (y: B) => PL.pairInjectiveFirst a x b y;
  \definition separateMaps: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: P.Times[A, B]) ->
    P.mapSecond C B D g (P.mapFirst A B C f p) = P.map A B C D f g p := ML.mapSeparate;
  \definition leftRoundTrip: \forall (p: P.Times[P.Times[A, B], C]) -> P.unassoc A B C (P.assoc A B C p) = p :=
    FL.unassocAssoc;
  \definition rightRoundTrip: \forall (p: P.Times[A, P.Times[B, C]]) -> P.assoc A B C (P.unassoc A B C p) = p :=
    FL.assocUnassoc;
}

\module EqualityExamples(A, B: \Set, f: A -> B, a, b, c: A, ab: a = b, bc: b = c) {
  \import \root.Equality() \as E;
  \use E.sym;
  \use E.trans;
  \use E.congr;
  \import \root.Equality().Laws(A := A) \as Laws;
  \definition reverse: b = a := sym!{A} _ _ ab;
  \definition chained: a = c := trans!{A} _ _ _ ab bc;
  \definition mapped: f a = f c := congr!{A B} f _ _ (Laws.trans a b c ab bc);
}

\module Finset(A: \Set);
\module FinsetExamples(A: \Set, a, b: A) {
  \import \root.Finset(A := A) \as F;
  \definition singletonMember: \Pred(A, F.singleton a, a) := F.inSingleton a;
  \definition leftMember: \Pred(A, F.pair a b, a) := F.inPairLeft a b;
  \definition rightMember: \Pred(A, F.pair a b, b) := F.inPairRight a b;
}

\module Rat;
\module DedekindReal;
\module CauchyReal;
\module RationalExamples {
  \import \root.Rat() \as R;
  \import R.Fractions() \as RF;
  \import RF.Operations() \as RO;
  \definition two: R.Nat := R.natAdd R.oneNat R.oneNat;
  \definition multiply: R.natMul two R.oneNat = two := \refl(two);
  \definition indexOrder: R.NatLe two two := R.natLeRefl two;
  \definition integerTransitivity:
    \forall (x, y, z: R.Integer) ->
      R.IntegerEq x y -> R.IntegerEq y z -> R.IntegerEq x z :=
    R.integerEqTrans;
  \definition integerAdditionCompatibility:
    \forall (x, y, u, v: R.Integer) ->
      R.IntegerEq x y -> R.IntegerEq u v ->
      R.IntegerEq (R.addInteger x u) (R.addInteger y v) :=
    R.addIntegerRespects;
  \definition integerMultiplicationCompatibility:
    \forall (x, y, u, v: R.Integer) ->
      R.IntegerEq x y -> R.IntegerEq u v ->
      R.IntegerEq (R.mulInteger x u) (R.mulInteger y v) :=
    R.mulIntegerRespects;
  \definition fractionTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y z -> RF.FractionEq x z :=
    RF.fractionEqTrans;
  \definition fractionSymmetry:
    \forall (x, y: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y x :=
    RF.fractionEqSym;
  \definition fractionMultiplicationCompatibility:
    \forall (x, y, u, v: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq u v ->
      RF.FractionEq (RO.mul x u) (RO.mul y v) :=
    RO.fractionMulRespects;
  \definition fractionAdditionZero:
    \forall (x: RF.Fraction) ->
      RF.FractionEq (RO.add x RF.zero) x :=
    RO.fractionAddZeroRight;
}

\module RationalQuotientExamples {
  \import \root.Rat() \as RB;
  \import RB.Fractions() \as RF;
  \import RF.Operations() \as RO;
  \import RO.Quotient() \as R;
  \definition quotientNegation: R.Rat -> R.Rat := R.neg;
  \definition quotientNegationInvolutive:
    \forall (x: R.Rat) -> R.neg (R.neg x) = x := R.negInvolutive;
  \definition quotientNegatesZero: R.neg R.zeroRat = R.zeroRat := R.negZero;
  \definition quotientNegatesInteger:
    \forall (n: R.IntegerCarrier) ->
      R.neg (R.ofInteger n) = R.ofInteger (R.integerNeg n) :=
    R.negOfInteger;
  \definition quotientMultiplication:
    R.Rat -> R.Rat -> R.Rat := R.mulRat;
  \definition quotientMultiplicationCommutative:
    \forall (x, y: R.Rat) ->
      R.mulRat x y = R.mulRat y x :=
    R.mulRatComm;
}

\module DedekindRealExamples {
  \import \root.DedekindReal() \as D;
  \definition orderReflexive:
    \forall (x: D.Real) -> D.Le x x := D.leRefl;
}

\module CauchyRealExamples {
  \import \root.CauchyReal() \as C;
  \definition closenessSymmetry:
    \forall (x, y, eps: C.Rat) ->
      C.Close x y eps -> C.Close y x eps :=
    C.closeSym;
  \definition sequenceEquivalenceSymmetry:
    \forall (x, y: C.CauchySeq) ->
      C.Equivalent x y -> C.Equivalent y x :=
    C.equivalentSym;
}

\module QuotientExamples(A: \Set, x, y: A, xy: x = y) {
  \import \root.Equality().Laws(A := A) \as E;
  \import \root.Quotient(
    A := A, Equivalent := (\fun (a, b: A) => a = b),
    equivalentRefl := (\fun (a: A) => \refl(a)), equivalentSym := E.sym, equivalentTrans := E.trans
  ) \as Q;
  \definition equalClasses: Q.ClassOf x = Q.ClassOf y := Q.classOfEq x y xy;
  \definition extensionality: \forall (a, b: Q.Carrier) ->
    (\forall (z: A) -> Q.mem a z -> Q.mem b z) -> (\forall (z: A) -> Q.mem b z -> Q.mem a z) -> a = b := Q.eqByExt;
  \definition identityRespects: Q.UnaryRespects (\fun (a: A) => a) :=
    \fun (a, b: A) => \fun (ab: a = b) => ab;
  \definition identityImageClosed:
    \forall (a: Q.Carrier) -> Q.IsClass (Q.UnaryImage (\fun (z: A) => z) a) :=
    Q.unaryImageClosed (\fun (z: A) => z) identityRespects;
}
