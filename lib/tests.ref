/* Concrete boundary cases supplement the universally quantified library laws. */
\module Logic;
\module Bool;
\module Nat;
\module Int;
\module ArithmeticExamples {
  \import \root.Nat() \as N;
  \definition z: N.Nat := N.Nat::zero;
  \definition one: N.Nat := N.Nat::succ z;
  \definition two: N.Nat := N.Nat::succ one;
  \definition three: N.Nat := N.Nat::succ two;
  \definition four: N.Nat := N.Nat::succ three;
  \definition six: N.Nat := N.Nat::succ (N.Nat::succ four);
  \definition eight: N.Nat := N.Nat::succ (N.Nat::succ six);
  \definition sum: N.addSet two three = N.Nat::succ four := \refl(N.Nat::succ four);
  \definition subtract: N.subSet three two = one := \refl(one);
  \definition truncated: N.subSet two three = z := \refl(z);
  \definition product: N.mulSet two three = six := \refl(six);
  \definition power: N.powSet two three = eight := \refl(eight);
  \definition zeroPowerZero: N.powSet z z = one := \refl(one);
  \definition minLeft: N.minSet two three = two := \refl(two);
  \definition minRight: N.minSet three two = two := \refl(two);
  \definition maxLeft: N.maxSet three two = three := \refl(three);
  \definition maxRight: N.maxSet two three = three := \refl(three);
  \definition minSame: N.minSet two two = two := \refl(two);
  \definition maxSame: N.maxSet two two = two := \refl(two);
  \definition less: N.Lt two three := \refl(N.ltbSet z one);
  \definition notLess: N.ltbSet three two = N.ltbSet z z := \refl(N.ltbSet z z);
  \definition notLe: N.lebSet three two = N.lebSet one z := \refl(N.lebSet one z);
  \definition equal: N.eqbSet two two = N.eqbSet z z := \refl(N.eqbSet z z);
  \definition unequal: N.eqbSet two three = N.eqbSet z one := \refl(N.eqbSet z one);
  \definition evenFour: N.evenSet four = N.evenSet z := \refl(N.evenSet z);
  \definition oddThree: N.oddSet three = N.oddSet one := \refl(N.oddSet one);
  \definition evenThree: N.evenSet three = N.evenSet one := \refl(N.evenSet one);
  \definition oddFour: N.oddSet four = N.oddSet z := \refl(N.oddSet z);
  /* Quotient/remainder boundaries and several Euclidean transitions. */
  \definition quotientExact: N.divSet six two = three := \refl(three);
  \definition quotientInexact: N.divSet eight three = two := \refl(two);
  \definition quotientSmall: N.divSet two three = z := \refl(z);
  \definition remainderExact: N.modSet six three = z := \refl(z);
  \definition remainderInexact: N.modSet eight three = two := \refl(two);
  \definition remainderSmall: N.modSet two three = two := \refl(two);
  \definition divisionTogether: N.divModSet eight three = N.NatPair::pair two two :=
    \refl(N.NatPair::pair two two);
  \definition divisionByZero: N.divSet three z = z := \refl(z);
  \definition remainderByZero: N.modSet three z = three := \refl(three);
  \definition divisionZeroZero: N.divSet z z = z := \refl(z);
  \definition remainderZeroZero: N.modSet z z = z := \refl(z);
  \definition divisionByOne: N.divSet four one = four := \refl(four);
  \definition remainderByOne: N.modSet four one = z := \refl(z);
  \definition divisionSelf: N.divSet three three = one := \refl(one);
  \definition remainderSelf: N.modSet three three = z := \refl(z);
  \definition gcdNontrivial: N.gcdSet eight six = two := \refl(two);
  \definition gcdReversed: N.gcdSet six eight = two := \refl(two);
  \definition gcdCoprime: N.gcdSet eight three = one := \refl(one);
  \definition gcdDivisible: N.gcdSet six three = three := \refl(three);
  \definition gcdSame: N.gcdSet three three = three := \refl(three);
  \definition gcdWithOne: N.gcdSet four one = one := \refl(one);
  \definition gcdLeftZero: N.gcdSet z three = three := \refl(three);
  \definition gcdRightZero: N.gcdSet three z = three := \refl(three);
  \definition gcdBothZero: N.gcdSet z z = z := \refl(z);
  \definition importedDivSpecification: (a, b: N.Nat) -> N.divSet a b = N.divPrec a b := N.divMatchesPrec;
  \definition importedModSpecification: (a, b: N.Nat) -> N.modSet a b = N.modPrec a b := N.modMatchesPrec;
  \definition importedGcdSpecification: (a, b: N.Nat) -> N.gcdSet a b = N.gcdPrec a b := N.gcdMatchesPrec;
  \definition importedDivisionLaw: (a, b: N.Nat) ->
    N.addSet (N.mulSet b (N.divSet a b)) (N.modSet a b) = a := N.divModReconstructs;
  \definition importedRemainderBound: (a, d: N.Nat) ->
    N.Lt (N.modSet a (N.Nat::succ d)) (N.Nat::succ d) := N.modLt;
  \definition importedGcdDividesLeft: (a, b: N.Nat) -> N.Divides (N.gcdSet a b) a := N.gcdDividesLeft;
  \definition importedGcdDividesRight: (a, b: N.Nat) -> N.Divides (N.gcdSet a b) b := N.gcdDividesRight;
  \definition importedGcdGreatest: (d, a, b: N.Nat) ->
    N.Divides d a -> N.Divides d b -> N.Divides d (N.gcdSet a b) := N.gcdGreatest;
  \definition importedAddLaw: (a, b: N.Nat) -> N.addSet a b = N.addSet b a := N.addComm;
  \definition importedMulLaw: (a, b, c: N.Nat) ->
    N.mulSet (N.mulSet a b) c = N.mulSet a (N.mulSet b c) := N.mulAssoc;
  \definition importedSpecification: (a, b: N.Nat) -> N.mulSet a b = N.mulPrec a b :=
    N.mulMatchesPrec;
}

\module BooleanExamples {
  \import \root.Bool() \as B;
  \definition neg: B.negSet B.Bool::false = B.Bool::true := \refl(B.Bool::true);
  \definition xor: B.xorSet B.Bool::true B.Bool::true = B.Bool::false := \refl(B.Bool::false);
  \definition implication: B.impliesSet B.Bool::true B.Bool::false = B.Bool::false := \refl(B.Bool::false);
  \definition importedLaw: (a: B.Bool) -> B.negSet (B.negSet a) = a := B.negInvolutive;
}


\module IntegerExamples {
  \import \root.Int() \as I;
  \use I.natZero;
  \use I.natSucc;
  \use I.boolTrue;
  \use I.boolFalse;
  \definition z: I.Nat := natZero!{};
  \definition one: I.Nat := natSucc!{z};
  \definition two: I.Nat := natSucc!{one};
  \definition three: I.Nat := natSucc!{two};
  \definition four: I.Nat := natSucc!{three};
  \definition six: I.Nat := natSucc!{(natSucc!{four})};
  \definition eight: I.Nat := natSucc!{(natSucc!{six})};
  \definition p2: I.Int := I.Int::ofNat two;
  \definition p3: I.Int := I.Int::ofNat three;
  \definition m2: I.Int := I.Int::negSucc one;
  \definition m3: I.Int := I.Int::negSucc two;
  \definition zeroNegation: I.negSet I.zeroSet = I.zeroSet := \refl(I.zeroSet);
  \definition negativeZero: I.negOfNatSet z = I.zeroSet := \refl(I.zeroSet);
  \definition successorAcrossZero: I.succSet I.minusOneSet = I.zeroSet := \refl(I.zeroSet);
  \definition predecessorAcrossZero: I.predSet I.zeroSet = I.minusOneSet := \refl(I.minusOneSet);
  \definition positiveSum: I.addSet p2 p3 = I.Int::ofNat (natSucc!{four}) := \refl(I.Int::ofNat (natSucc!{four}));
  \definition negativeSum: I.addSet m2 m3 = I.Int::negSucc four := \refl(I.Int::negSucc four);
  \definition mixedPositive: I.addSet p3 m2 = I.oneSet := \refl(I.oneSet);
  \definition mixedNegative: I.addSet p2 m3 = I.minusOneSet := \refl(I.minusOneSet);
  \definition cancel: I.addSet p3 m3 = I.zeroSet := \refl(I.zeroSet);
  \definition signedSubtraction: I.subSet m2 p3 = I.Int::negSucc four := \refl(I.Int::negSucc four);
  \definition negativeProduct: I.mulSet p2 m3 = I.Int::negSucc (natSucc!{four}) := \refl(I.Int::negSucc (natSucc!{four}));
  \definition positiveProduct: I.mulSet m2 m3 = I.Int::ofNat six := \refl(I.Int::ofNat six);
  \definition zeroProduct: I.mulSet I.zeroSet m3 = I.zeroSet := \refl(I.zeroSet);
  \definition oddPower: I.powSet m2 three = I.Int::negSucc (natSucc!{six}) := \refl(I.Int::negSucc (natSucc!{six}));
  \definition evenPower: I.powSet m2 two = I.Int::ofNat four := \refl(I.Int::ofNat four);
  \definition zeroPowerZero: I.powSet I.zeroSet z = I.oneSet := \refl(I.oneSet);
  \definition absolute: I.absSet m3 = p3 := \refl(p3);
  \definition magnitude: I.natAbsSet m3 = three := \refl(three);
  \definition signNegative: I.signSet m3 = I.minusOneSet := \refl(I.minusOneSet);
  \definition signZero: I.signSet I.zeroSet = I.zeroSet := \refl(I.zeroSet);
  \definition signPositive: I.signSet p3 = I.oneSet := \refl(I.oneSet);
  \definition equalityTrue: I.eqbSet m3 m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition equalityFalse: I.eqbSet m3 p3 = boolFalse!{} := \refl(boolFalse!{});
  \definition negativeOrder: I.ltbSet m3 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition crossingOrder: I.lebSet m3 p2 = boolTrue!{} := \refl(boolTrue!{});
  \definition reversedOrder: I.lebSet p2 m3 = boolFalse!{} := \refl(boolFalse!{});
  \definition equalOrder: I.lebSet m2 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition strictEqual: I.ltbSet m2 m2 = boolFalse!{} := \refl(boolFalse!{});
  \definition minimum: I.minSet m3 p2 = m3 := \refl(m3);
  \definition maximum: I.maxSet m3 m2 = m2 := \refl(m2);
  \definition negativeEven: I.evenSet m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition negativeOdd: I.oddSet m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition reducedDifference: I.diffSet three two = I.oneSet := \refl(I.oneSet);
  \definition quotientCancellation: I.diffMath three two = I.diffMath one z :=
    I.classOfEq (I.pair three two) (I.pair one z) (\refl(three));
  \definition noncanonicalSum:
    I.addMath (I.class (I.pair three two)) (I.class (I.pair two three)) =
      I.class (I.addRep (I.pair three two) (I.pair two three)) :=
    I.addMathClass (I.pair three two) (I.pair two three);
  \definition roundTrip: (x: I.Int) -> I.fromMath (I.toMath x) = x := I.fromTo;
  \definition quotientRoundTrip: (x: I.Grothendieck) -> I.toMath (I.fromMath x) = x := I.toFrom;
  \definition additionAgreement: (x, y: I.Int) ->
    I.toMath (I.addSet x y) = I.addMath (I.toMath x) (I.toMath y) := I.addMatchesMath;
  \definition multiplicationAgreement: (x, y: I.Int) ->
    I.toMath (I.mulSet x y) = I.mulMath (I.toMath x) (I.toMath y) := I.mulMatchesMath;
  \definition inverseLaw: (x: I.Int) -> I.addSet (I.negSet x) x = I.zeroSet := I.negInverse;
}
