\module Logic;

\module Equality;

\module Quotient(
  A: \Set,
  Equivalent: A -> A -> \Prop,
  equivalentRefl: (x: A) -> Equivalent x x,
  equivalentSym: (x, y: A) -> Equivalent x y -> Equivalent y x,
  equivalentTrans: (x, y, z: A) -> Equivalent x y -> Equivalent y z -> Equivalent x z,
);

\module Pair;

\module Bool;

\module Finset(A: \Set);

\module Classical;

\module Nat;

\module Int;

\module AxiomaticReals(Carrier: \Set);

\module Rat;

\module DedekindReal;

\module CauchyReal;
