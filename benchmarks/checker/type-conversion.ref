\module TypeConversion {
  \definition Direct0[A: \Set]: \Set := A -> A;
  \definition ViaBeta0[A: \Set]: \Set := (\fun (T: \Set) => T -> T) A;
  \definition Direct1[A: \Set]: \Set := Direct0 (Direct0 A);
  \definition ViaBeta1[A: \Set]: \Set := ViaBeta0 (ViaBeta0 A);
  \definition Direct2[A: \Set]: \Set := Direct1 (Direct1 A);
  \definition ViaBeta2[A: \Set]: \Set := ViaBeta1 (ViaBeta1 A);
  \definition Direct3[A: \Set]: \Set := Direct2 (Direct2 A);
  \definition ViaBeta3[A: \Set]: \Set := ViaBeta2 (ViaBeta2 A);
  \definition Direct4[A: \Set]: \Set := Direct3 (Direct3 A);
  \definition ViaBeta4[A: \Set]: \Set := ViaBeta3 (ViaBeta3 A);
  \definition Direct5[A: \Set]: \Set := Direct4 (Direct4 A);
  \definition ViaBeta5[A: \Set]: \Set := ViaBeta4 (ViaBeta4 A);
  \definition Direct6[A: \Set]: \Set := Direct5 (Direct5 A);
  \definition ViaBeta6[A: \Set]: \Set := ViaBeta5 (ViaBeta5 A);
  \definition Direct7[A: \Set]: \Set := Direct6 (Direct6 A);
  \definition ViaBeta7[A: \Set]: \Set := ViaBeta6 (ViaBeta6 A);
  \definition Direct8[A: \Set]: \Set := Direct7 (Direct7 A);
  \definition ViaBeta8[A: \Set]: \Set := ViaBeta7 (ViaBeta7 A);
  \definition convertForward4[A: \Set][value: Direct4 A]: ViaBeta4 A := value;
  \definition convertBackward4[A: \Set][value: ViaBeta4 A]: Direct4 A := value;
  \definition convertForward8[A: \Set][value: Direct8 A]: ViaBeta8 A := value;
  \definition convertBackward8[A: \Set][value: ViaBeta8 A]: Direct8 A := value;
}
