\module TypeInference {
  \definition identity: \forall (A: \Set) -> A -> A :=
    \fun (A: \Set) (value: A) => value;
  \definition keepLeft: \forall (A, B: \Set) -> A -> B -> A :=
    \fun (A, B: \Set) (left: A) (right: B) => left;

  \definition select24:
    \forall (
      A0, A1, A2, A3, A4, A5, A6, A7,
      A8, A9, A10, A11, A12, A13, A14, A15,
      A16, A17, A18, A19, A20, A21, A22, A23: \Set
    ) ->
    A0 -> A1 -> A2 -> A3 -> A4 -> A5 -> A6 -> A7 ->
    A8 -> A9 -> A10 -> A11 -> A12 -> A13 -> A14 -> A15 ->
    A16 -> A17 -> A18 -> A19 -> A20 -> A21 -> A22 -> A23 ->
    A0 :=
    \fun (
      A0, A1, A2, A3, A4, A5, A6, A7,
      A8, A9, A10, A11, A12, A13, A14, A15,
      A16, A17, A18, A19, A20, A21, A22, A23: _
    )
      (value0: _)
      (value1: _)
      (value2: _)
      (value3: _)
      (value4: _)
      (value5: _)
      (value6: _)
      (value7: _)
      (value8: _)
      (value9: _)
      (value10: _)
      (value11: _)
      (value12: _)
      (value13: _)
      (value14: _)
      (value15: _)
      (value16: _)
      (value17: _)
      (value18: _)
      (value19: _)
      (value20: _)
      (value21: _)
      (value22: _)
      (value23: _)
      =>
      keepLeft _ _ (identity _ value0) (
        keepLeft _ _ (identity _ value1) (
          keepLeft _ _ (identity _ value2) (
            keepLeft _ _ (identity _ value3) (
              keepLeft _ _ (identity _ value4) (
                keepLeft _ _ (identity _ value5) (
                  keepLeft _ _ (identity _ value6) (
                    keepLeft _ _ (identity _ value7) (
                      keepLeft _ _ (identity _ value8) (
                        keepLeft _ _ (identity _ value9) (
                          keepLeft _ _ (identity _ value10) (
                            keepLeft _ _ (identity _ value11) (
                              keepLeft _ _ (identity _ value12) (
                                keepLeft _ _ (identity _ value13) (
                                  keepLeft _ _ (identity _ value14) (
                                    keepLeft _ _ (identity _ value15) (
                                      keepLeft _ _ (identity _ value16) (
                                        keepLeft _ _ (identity _ value17) (
                                          keepLeft _ _ (identity _ value18) (
                                            keepLeft _ _ (identity _ value19) (
                                              keepLeft _ _ (identity _ value20) (
                                                keepLeft _ _ (identity _ value21) (
                                                  keepLeft _ _ (identity _ value22) (
                                                    identity _ value23
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
}
