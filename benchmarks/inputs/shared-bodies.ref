\module SharedBodies {
  \structure Bundle { Carrier: \Set, seed: Carrier }
  \definition f0(B: Bundle)(x: B.Carrier): B.Carrier := x;
  \definition f1(B: Bundle)(x: B.Carrier): B.Carrier := f0 B (f0 B x);
  \definition f2(B: Bundle)(x: B.Carrier): B.Carrier := f1 B (f1 B x);
  \definition f3(B: Bundle)(x: B.Carrier): B.Carrier := f2 B (f2 B x);
  \definition f4(B: Bundle)(x: B.Carrier): B.Carrier := f3 B (f3 B x);
  \definition f5(B: Bundle)(x: B.Carrier): B.Carrier := f4 B (f4 B x);
  \definition f6(B: Bundle)(x: B.Carrier): B.Carrier := f5 B (f5 B x);
  \definition f7(B: Bundle)(x: B.Carrier): B.Carrier := f6 B (f6 B x);
  \definition f8(B: Bundle)(x: B.Carrier): B.Carrier := f7 B (f7 B x);
  \definition f9(B: Bundle)(x: B.Carrier): B.Carrier := f8 B (f8 B x);
  \definition f10(B: Bundle)(x: B.Carrier): B.Carrier := f9 B (f9 B x);
  \definition f11(B: Bundle)(x: B.Carrier): B.Carrier := f10 B (f10 B x);
  \definition f12(B: Bundle)(x: B.Carrier): B.Carrier := f11 B (f11 B x);
  \inductive Unit: \Set := | unit: Unit;
  \definition bundle: Bundle := Bundle { Carrier := Unit, seed := Unit::unit };
  \definition proof: f12 bundle Unit::unit = Unit::unit := \refl(Unit::unit);
}
