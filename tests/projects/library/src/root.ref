/* Concrete boundary cases supplement the universally quantified library laws. */
\module AnalysisExamples;
\module ComplexExamples;
\module LinearAlgebraExamples;
\module CalculusExamples {
  \import calculus.Real[] \as C;
  \import C.Limit[].Def[] \as Limit;
  \import C.Limit[].Prop[] \as LimitLaws;
  \import C.Derivative[].Def[] \as D;
  \import C.Derivative[].Prop[] \as DL;

  \definition constantLimit: \forall (c, a: C.Real) ->
    Limit.HasLimitAt (C.constant c) a c := LimitLaws.constantLimit;
  \definition identityLimit: \forall (a: C.Real) ->
    Limit.HasLimitAt C.identity a a := LimitLaws.identityLimit;
  \definition constantDerivative: \forall (c, a: C.Real) ->
    D.HasDerivativeAt (C.constant c) a C.zero := DL.constantDerivative;
  \definition identityDerivative: \forall (a: C.Real) ->
    D.HasDerivativeAt C.identity a C.one := DL.identityDerivative;
  \definition affineDerivative: \forall (m, b, a: C.Real) ->
    D.HasDerivativeAt (C.affine m b) a m := DL.affineDerivative;

  \definition identityDifferentiable: \forall (a: C.Real) -> D.DifferentiableAt C.identity a :=
    \fun (a: _) => DL.differentiableOfDerivative C.identity a C.one (DL.identityDerivative a);
  \definition affineFunction(m, b: C.Real): D.DifferentiableFunction :=
    DL.affineDifferentiable m b;
  \definition affineLaw: \forall (m, b: C.Real) ->
    D.HasDerivative
      #function{(affineFunction m b)}
      #derivative{(affineFunction m b)} :=
    \fun (m, b: _) => #differentiable{(affineFunction m b)};
}

\module MultivariableCalculusExamples {
  \import std.Data[].Nat[] \as N;
  \import std.Data[].FinSet[] \as Fin;
  \import std.Data[].List[] \as Lists;
  \import std.Logic[].Proposition[] \as Logic;
  \import calculus.Real[] \as C;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.trans;
  \use Equality.sym;

  \module Dimension(n: N.Nat^) {
    \import C.Multivariable[n := n] \as M;
    \import M.Space[].Def[] \as Space;
    \import M.Partial[].Def[] \as Partial;
    \import M.Partial[].Prop[] \as PartialLaws;
    \import M.Differential[].Def[] \as Differential;
    \import M.Differential[].Prop[] \as DifferentialLaws;
    \import M.Directional[].Def[] \as Directional;
    \import M.Directional[].Prop[] \as DirectionalLaws;
    \import M.Smooth[].Def[] \as Smooth;
    \import M.Smooth[].Prop[] \as SmoothLaws;

    \definition projectionPartial: \forall (i: M.Coordinate) ->
      Partial.HasPartialDerivative (Space.projection i) i (Space.constantFunction C.one) :=
      PartialLaws.projectionPartial;

    \definition constantDifferential: \forall (c: C.Real) ->
      Differential.HasDifferential (Space.constantFunction c) (\fun (a: _) => DifferentialLaws.zeroDifferential) :=
      DifferentialLaws.constantDifferential;

    \definition constantDifferentiable: \forall (c: C.Real) -> \forall (a: M.Point) ->
      Differential.DifferentiableAt (Space.constantFunction c) a :=
      \fun (c: _) (a: _) => DifferentialLaws.differentiableOfDifferential
        (Space.constantFunction c) a DifferentialLaws.zeroDifferential (DifferentialLaws.constantDifferential c a);

    \definition coordinateDifferential(i: M.Coordinate): Differential.LinearMap :=
      DifferentialLaws.coordinateDifferential i;

    \definition projectionDifferential: \forall (i: M.Coordinate) ->
      Differential.HasDifferential (Space.projection i) (\fun (a: _) => coordinateDifferential i) :=
      DifferentialLaws.projectionDifferential;

    \definition constantMixedPartials: \forall (c: C.Real) ->
      Partial.MixedPartialsCommute (Space.constantFunction c) := PartialLaws.constantMixedPartialsCommute;

    \definition constantSmooth: \forall (c: C.Real) -> Smooth.Smooth (Space.constantFunction c) :=
      SmoothLaws.constantSmooth;

    \definition constantCn: \forall (k: N.Nat^) -> \forall (c: C.Real) ->
      Smooth.ContDiff k (Space.constantFunction c) := SmoothLaws.constantContDiff;

    \definition cZero: \forall (f: M.Function) ->
      Logic.PropEquiv[Smooth.ContDiff N.Nat^::zero f, Space.Continuous f] := SmoothLaws.contDiffZero;

    \definition zeroCommutingPartials: \forall (k: N.Nat^) ->
      Smooth.CommutingPartials k (Space.constantFunction C.zero) := SmoothLaws.zeroCommutingPartials;

    \definition constantAlongCurve: \forall (c: C.Real) -> \forall (curve: Directional.Curve) ->
      Directional.HasDirectionalDerivativeAlong (Space.constantFunction c) curve C.zero :=
      DirectionalLaws.constantDirectionalDerivative;

    \definition constantAlongDirection: \forall (c: C.Real) -> \forall (point, velocity: M.Point) ->
      Directional.HasDirectionalDerivativeAt (Space.constantFunction c) point velocity C.zero :=
      DirectionalLaws.constantDirectionalDerivativeAt;

    \definition lineDirection: \forall (interval: Directional.ParameterInterval) ->
      \forall (point, velocity: M.Point) ->
      Directional.CurveDirection[Directional.line interval point velocity, point, velocity] :=
      \fun (interval: _) (point: _) (velocity: _) =>
        Directional.CurveDirection[Directional.line interval point velocity, point, velocity] {
          center := DirectionalLaws.lineCenter interval point velocity,
          tangent := DirectionalLaws.lineTangent interval point velocity,
        };

    \definition differentIntervals: \forall (first, second: Directional.ParameterInterval) ->
      \forall (point, velocity: M.Point) -> \forall (c: C.Real) ->
      Directional.AgreementConditions[Space.constantFunction c,
        Directional.line first point velocity, Directional.line second point velocity,
        velocity, DifferentialLaws.zeroDifferential] :=
      \fun (first: _) (second: _) (point: _) (velocity: _) (c: _) =>
        Directional.AgreementConditions[Space.constantFunction c,
          Directional.line first point velocity, Directional.line second point velocity,
          velocity, DifferentialLaws.zeroDifferential] {
          direction := Directional.SameDirection[
            Directional.line first point velocity, Directional.line second point velocity, velocity] {
            center := trans!{M.Point} _ point _ (DirectionalLaws.lineCenter first point velocity)
              (sym!{M.Point} _ _ (DirectionalLaws.lineCenter second point velocity)),
            firstTangent := DirectionalLaws.lineTangent first point velocity,
            secondTangent := DirectionalLaws.lineTangent second point velocity,
          },
          differentiable := DifferentialLaws.constantDifferential c
            (Directional.center (Directional.line first point velocity)),
        };

    \definition curvesAgree: \forall (c: C.Real) -> \forall (first, second: Directional.Curve) ->
      Directional.DirectionalDerivativesAgree (Space.constantFunction c) first second :=
      DirectionalLaws.constantDerivativesAgree;

    \definition projectionAlongLine: \forall (interval: Directional.ParameterInterval) ->
      \forall (point, velocity: M.Point) -> \forall (i: M.Coordinate) ->
      Directional.HasDirectionalDerivativeAlong (Space.projection i)
        (Directional.line interval point velocity) (velocity i) :=
      \fun (interval: _) (point: _) (velocity: _) (i: _) =>
        DirectionalLaws.projectionDirectionalDerivative (Directional.line interval point velocity) velocity
          (DirectionalLaws.lineTangent interval point velocity) i;

    \definition projectionsAgree: \forall (first, second: Directional.Curve) ->
      \forall (velocity: M.Point) -> Directional.SameDirection[first, second, velocity] ->
      \forall (i: M.Coordinate) -> Directional.DirectionalDerivativesAgree (Space.projection i) first second :=
      DirectionalLaws.projectionDerivativesAgree;

    \definition sameTangentImages: \forall (f: M.Function) -> \forall (first, second: Directional.Curve) ->
      \forall (velocity: M.Point) -> \forall (differential: Differential.LinearMap) ->
      Directional.AgreementConditions[f, first, second, velocity, differential] ->
      Directional.DifferentialAgreementConditions[f, first, second, velocity, velocity, differential] :=
      DirectionalLaws.differentialAgreementOfSameDirection;
  }

  \import C.Multivariable[n := N.Nat^::zero] \as Empty;
  \import Empty.Space[].Def[] \as EmptySpace;
  \definition emptyNorm: \forall (x: Empty.Point) -> EmptySpace.norm x = C.zero :=
    \fun (x: _) => \refl(C.zero);

  \definition two: N.Nat^ := N.Nat^::succ (N.Nat^::succ N.Nat^::zero);
  \import C.Multivariable[n := two] \as Two;
  \import Two.Space[].Def[] \as TwoSpace;
  \import Two.Partial[].Def[] \as TwoPartial;
  \import Two.Partial[].Prop[] \as TwoPartialLaws;
  \import Two.Differential[].Prop[] \as TwoDifferential;
  \import Two.Smooth[].Def[] \as TwoSmooth;

  \definition first: Two.Coordinate := Fin.zero (N.Nat^::succ N.Nat^::zero);
  \definition second: Two.Coordinate := Fin.succ (N.Nat^::succ N.Nat^::zero) (Fin.zero N.Nat^::zero);

  \definition replaceFirst: \forall (x: Two.Point) -> \forall (t: C.Real) ->
    TwoSpace.replace x first t first = t := \fun (x: _) (t: _) => \refl(t);
  \definition preserveSecond: \forall (x: Two.Point) -> \forall (t: C.Real) ->
    TwoSpace.replace x first t second = x second := \fun (x: _) (t: _) => \refl(x second);
  \definition secondPartial:
    TwoPartial.HasPartialDerivative (TwoSpace.projection second) second (TwoSpace.constantFunction C.one) :=
    TwoPartialLaws.projectionPartial second;
  \definition differentialApplication: \forall (h: Two.Point) ->
    #apply{(TwoDifferential.coordinateDifferential second)} h = h second := \fun (h: _) => \refl(h second);

  \definition ij: TwoSmooth.Directions :=
    Lists.List[Two.Coordinate]::cons first
      (Lists.List[Two.Coordinate]::cons second Lists.List[Two.Coordinate]::nil);
  \definition ji: TwoSmooth.Directions :=
    Lists.List[Two.Coordinate]::cons second
      (Lists.List[Two.Coordinate]::cons first Lists.List[Two.Coordinate]::nil);
  \definition mixedOrder: TwoSmooth.order ij = two := \refl(two);
  \definition firstMultiplicity: TwoSmooth.multiplicity first ij = TwoSmooth.multiplicity first ji :=
    \refl(N.Nat^::succ N.Nat^::zero);
  \definition secondMultiplicity: TwoSmooth.multiplicity second ij = TwoSmooth.multiplicity second ji :=
    \refl(N.Nat^::succ N.Nat^::zero);
}

\module EitherExamples {
  \import std.Logic[].Proposition[] \as L;
  \use L.either;

  \definition eliminate(P, Q, R: \Prop):
    (P -> R) -> (Q -> R) -> L.Or[P, Q] -> R :=
    \fun (p: P -> R) (q: Q -> R) => either!{
      P "or" Q "either" R
      "lt:" p
      "rt:" q
    };

  \definition leftBranch(P: \Prop): L.Or[P, L.False] -> P := either!{
    P "or" L.False "either" P
    "lt:" {\fun (value: P) => value}
    "rt:" {L.falseElim P}
  };

  \definition rightBranch(P: \Prop): L.Or[L.False, P] -> P := either!{
    L.False "or" P "either" P
    "lt:" {L.falseElim P}
    "rt:" {\fun (value: P) => value}
  };

  \definition nested(P: \Prop): L.Or[L.False, L.Or[P, L.False]] -> P := either!{
    L.False "or" {L.Or[P, L.False]} "either" P
    "lt:" {L.falseElim P}
    "rt:" either!{
      P "or" L.False "either" P
      "lt:" {\fun (value: P) => value}
      "rt:" {L.falseElim P}
    }
  };

  \definition appliedLeft(P: \Prop) (p: P): P :=
    leftBranch P (L.Or[P, L.False]::left p);
  \definition appliedRight(P: \Prop) (p: P): P :=
    rightBranch P (L.Or[L.False, P]::right p);

  \definition map(P, Q, R, S: \Prop):
    (P -> R) -> (Q -> S) -> L.Or[P, Q] -> L.Or[R, S] :=
    \fun (onLeft: P -> R) (onRight: Q -> S) => either!{
      P "or" Q "either" {L.Or[R, S]}
      "lt:" {\fun (p: P) => L.Or[_, _]::left (onLeft p)}
      "rt:" {\fun (q: Q) => L.Or[_, _]::right (onRight q)}
    };
}

\module ClassicalExamples {
  \import std.Logic[].Proposition[] \as L;
  \import std.Logic[].Classical[] \as C;
  \definition excludedMiddle(P: \Prop): L.Or[P, L.Not P] := C.excludedMiddle P;
}

\module NaturalExamples {
  \import std.Program[] \as Program;
  \use Program.runBox;
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Basic[].ProgramProp[] \as NatOpProgramProp;
  \import std.Data[].Nat[].Basic[].Program[] \as NatOpProgram;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Pair[].ProgramProp[] \as NatPairProgramProp;
  \import std.Data[].Nat[].Pair[].Program[] \as NatPairProgram;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Division[].Program[] \as NatDivisionProgram;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Gcd[].ProgramProp[] \as NGProgramProp;
  \import std.Data[].Nat[].Gcd[].Program[] \as NGProgram;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import std.Data[].Nat[].Parity[].Program[] \as NPProgram;
  \import std.Data[].Nat[].Basic[].Prop[] \as NL;
  \import std.Data[].Nat[].Division[].Prop[] \as ND;
  \import std.Data[].Nat[].Gcd[].Prop[] \as GcdLaw;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.sym;
  \use Equality.eq_reason;
  \use Equality.congr;
  \use NatOp.nat_add;
  \use NatOp.nat_mul;
  \definition expanded (a, b, c: N.Nat^):
    \(a "*" (b "+" c)\) = \((b "*" a) "+" (c "*" a)\) :=
    eq_reason!{
      \(a "*" (b "+" c)\)
      "=" \((b "+" c) "*" a\) "by" { NL.mulComm a \(b "+" c\) }
      "=" \((b "*" a) "+" (c "*" a)\) "by" { NL.mulDistribRight b c a }
    };
  \definition z: N.Nat := N.Nat::zero;
  \definition one: N.Nat := N.Nat::succ z;
  \definition two: N.Nat := N.Nat::succ one;
  \definition three: N.Nat := N.Nat::succ two;
  \definition four: N.Nat := N.Nat::succ three;
  \definition six: N.Nat := N.Nat::succ (N.Nat::succ four);
  \definition eight: N.Nat := N.Nat::succ (N.Nat::succ six);
  \definition sum: NatOpProgram.add^ two^ three^ = N.Nat^::succ four^ := \refl(N.Nat^::succ four^);

  \definition appliedCoherence: NatOpProgram.add^ two^ three^ = NatOp.add two^ three^ :=
    (congr!{NatOpProgramProp.Add.T^ _} (\fun (f: _) => f two^ three^) _ _ NatOpProgramProp.Add.coherence);
  \definition additionCoherence: NatOpProgram.add^ = NatOp.add := NatOpProgramProp.Add.coherence;
  \definition pairIterationCoherence: NatPairProgram.pairIter^ = NatPairDef.pairIter := NatPairProgramProp.PairIter.coherence;
  \definition additionInput: \Box[\F(NatOpProgram.AddLoop.State)] :=
    \box[_](\return NatOpProgram.AddState::running two three);
  \definition bundledSum:
    \squash[_](\boxapp(runBox!{NatOpProgram.AddLoop}, additionInput)) = N.Nat^::succ four^ :=
    \refl(N.Nat^::succ four^);
  \import std.Data[].Nat[].Iteration[] \as Iteration;
  \import Iteration.Def[A := N.Nat^] \as NI;
  \definition iteration: Iteration.Iteration[N.Nat^] := NI.specification;
  \definition iterationZero (f: N.Nat^ -> N.Nat^) (n: N.Nat^):
    (iteration #apply) f n z^ = n := (iteration #zero) f n;
  \definition iterationSucc (f: N.Nat^ -> N.Nat^) (n, count: N.Nat^):
    (iteration #apply) f n (N.Nat^::succ count) = f ((iteration #apply) f n count) :=
    (iteration #succ) f n count;
  \definition subtract: NatOpProgram.sub^ three^ two^ = one^ := \refl(one^);
  \definition truncated: NatOpProgram.sub^ two^ three^ = z^ := \refl(z^);
  \definition product: NatOpProgram.mul^ two^ three^ = six^ := \refl(six^);
  \definition power: NatOpProgram.pow^ two^ three^ = eight^ := \refl(eight^);
  \definition zeroPowerZero: NatOpProgram.pow^ z^ z^ = one^ := \refl(one^);
  \definition minLeft: NatOpProgram.min^ two^ three^ = two^ := \refl(two^);
  \definition minRight: NatOpProgram.min^ three^ two^ = two^ := \refl(two^);
  \definition maxLeft: NatOpProgram.max^ three^ two^ = three^ := \refl(three^);
  \definition maxRight: NatOpProgram.max^ two^ three^ = three^ := \refl(three^);
  \definition minSame: NatOpProgram.min^ two^ two^ = two^ := \refl(two^);
  \definition maxSame: NatOpProgram.max^ two^ two^ = two^ := \refl(two^);
  \definition less: NL.Lt two^ three^ := \refl(NatOpProgram.ltb^ z^ one^);
  \definition notLess: NatOpProgram.ltb^ three^ two^ = NatOpProgram.ltb^ z^ z^ := \refl(NatOpProgram.ltb^ z^ z^);
  \definition notLe: NatOpProgram.leb^ three^ two^ = NatOpProgram.leb^ one^ z^ := \refl(NatOpProgram.leb^ one^ z^);
  \definition equal: NatOpProgram.eqb^ two^ two^ = NatOpProgram.eqb^ z^ z^ := \refl(NatOpProgram.eqb^ z^ z^);
  \definition unequal: NatOpProgram.eqb^ two^ three^ = NatOpProgram.eqb^ z^ one^ := \refl(NatOpProgram.eqb^ z^ one^);
  \definition evenFour: NPProgram.even^ four^ = NPProgram.even^ z^ := \refl(NPProgram.even^ z^);
  \definition oddThree: NPProgram.odd^ three^ = NPProgram.odd^ one^ := \refl(NPProgram.odd^ one^);
  \definition evenThree: NPProgram.even^ three^ = NPProgram.even^ one^ := \refl(NPProgram.even^ one^);
  \definition oddFour: NPProgram.odd^ four^ = NPProgram.odd^ z^ := \refl(NPProgram.odd^ z^);
  /* Quotient/remainder boundaries and several Euclidean transitions. */
  \definition quotientExact: NatDivisionProgram.div^ six^ two^ = three^ := \refl(three^);
  \definition quotientInexact: NatDivisionProgram.div^ eight^ three^ = two^ := \refl(two^);
  \definition quotientSmall: NatDivisionProgram.div^ two^ three^ = z^ := \refl(z^);
  \definition remainderExact: NatDivisionProgram.mod^ six^ three^ = z^ := \refl(z^);
  \definition remainderInexact: NatDivisionProgram.mod^ eight^ three^ = two^ := \refl(two^);
  \definition remainderSmall: NatDivisionProgram.mod^ two^ three^ = two^ := \refl(two^);
  \definition divisionTogether: NatDivisionProgram.divMod^ eight^ three^ = NatPairDef.natPair two^ two^ :=
    \refl(NatPairDef.natPair two^ two^);
  \definition divisionByZero: NatDivisionProgram.div^ three^ z^ = z^ := \refl(z^);
  \definition remainderByZero: NatDivisionProgram.mod^ three^ z^ = three^ := \refl(three^);
  \definition divisionZeroZero: NatDivisionProgram.div^ z^ z^ = z^ := \refl(z^);
  \definition remainderZeroZero: NatDivisionProgram.mod^ z^ z^ = z^ := \refl(z^);
  \definition divisionByOne: NatDivisionProgram.div^ four^ one^ = four^ := \refl(four^);
  \definition remainderByOne: NatDivisionProgram.mod^ four^ one^ = z^ := \refl(z^);
  \definition divisionSelf: NatDivisionProgram.div^ three^ three^ = one^ := \refl(one^);
  \definition remainderSelf: NatDivisionProgram.mod^ three^ three^ = z^ := \refl(z^);
  \definition gcdNontrivial: NGProgram.gcd^ eight^ six^ = two^ := \refl(two^);
  \definition gcdReversed: NGProgram.gcd^ six^ eight^ = two^ := \refl(two^);
  \definition gcdCoprime: NGProgram.gcd^ eight^ three^ = one^ := \refl(one^);
  \definition gcdDivisible: NGProgram.gcd^ six^ three^ = three^ := \refl(three^);
  \definition gcdSame: NGProgram.gcd^ three^ three^ = three^ := \refl(three^);
  \definition gcdWithOne: NGProgram.gcd^ four^ one^ = one^ := \refl(one^);
  \definition gcdLeftZero: NGProgram.gcd^ z^ three^ = three^ := \refl(three^);
  \definition gcdRightZero: NGProgram.gcd^ three^ z^ = three^ := \refl(three^);
  \definition gcdBothZero: NGProgram.gcd^ z^ z^ = z^ := \refl(z^);
  \definition gcdSetZeroRight: NG.gcd three^ z^ = three^ := GcdLaw.gcdZeroRight three^;
  \definition gcdSetZeroLeft: NG.gcd z^ three^ = three^ := GcdLaw.gcdZeroLeft three^;
  \definition gcdSetBothZero: NG.gcd z^ z^ = z^ := GcdLaw.gcdZeroRight z^;
  \definition gcdSetReversed: NG.gcd eight^ six^ = NG.gcd six^ eight^ :=
    GcdLaw.gcdComm eight^ six^;
  \definition gcdSetNontrivial: NG.gcd eight^ six^ = two^ :=
    eq_reason!{
      { NG.gcd eight^ six^ }
      "=" { NGProgram.gcd^ eight^ six^ } "by" { sym!{N.Nat^} _ _ (congr!{NGProgramProp.Gcd.T^ N.Nat^} (\fun (f: _) => f eight^ six^) _ _ NGProgramProp.Gcd.coherence) }
      "=" two^ "by" gcdNontrivial
    };
  \definition importedDivisionLaw: \forall (a, b: N.Nat^) ->
    NatOp.add (NatOp.mul b (NatDivisionDef.div a b)) (NatDivisionDef.mod a b) = a := ND.divModReconstructs;
  \definition importedRemainderBound: \forall (a, d: N.Nat^) ->
    NL.Lt (NatDivisionDef.mod a (N.Nat^::succ d)) (N.Nat^::succ d) := ND.modLt;
  \definition importedGcdGreatest: \forall (d, a, b: N.Nat^) ->
    ND.Divides d a -> ND.Divides d b -> ND.Divides d (NG.gcd a b) := GcdLaw.gcdGreatest;
  \definition importedMulLaw: \forall (a, b, c: N.Nat^) ->
    NatOp.mul (NatOp.mul a b) c = NatOp.mul a (NatOp.mul b c) := NL.mulAssoc;
  \definition importedPositiveCancellation: \forall (k, a, b: N.Nat^) ->
    NatOp.mul a (N.Nat^::succ k) = NatOp.mul b (N.Nat^::succ k) -> a = b :=
    NL.mulCancelRightSucc;
  \definition importedSpecification: NatOpProgram.mul^ = NatOp.mul := NatOpProgramProp.Mul.coherence;
  \import std.Alg[].Monoid[] \as M;
  \import std.Alg[].Alg[] \as A;

  \definition additiveRaw: M.MonoidData[N.Nat^] :=
    M.MonoidData[N.Nat^]::# NatOp.zero NatOp.add;
  \definition additiveLaws: M.MonoidLaws[N.Nat^, additiveRaw] :=
    M.MonoidLaws[N.Nat^, additiveRaw] {
      leftIdentity := NL.addZeroLeft,
      rightIdentity := NL.addZeroRight,
      associative := NL.addAssoc,
    };
  \definition additiveMonoid: M.Monoid[N.Nat^] :=
    \into[M.MonoidData[N.Nat^]](additiveRaw, M.Monoid[N.Nat^]) \by { additiveLaws };
  \definition additiveIdentity: \forall (n: N.Nat^) ->
    #op{(additiveMonoid)} (#unit{(additiveMonoid)}) n = n :=
    #leftIdentity{additiveMonoid};

  \definition naturalSemiringRaw: A.SemiringData[N.Nat^] :=
    A.SemiringData[N.Nat^]::# NatOp.zero NatOp.one NatOp.add NatOp.mul;
  \definition naturalSemiringLaws: A.SemiringLaws[N.Nat^, naturalSemiringRaw] :=
    A.SemiringLaws[N.Nat^, naturalSemiringRaw] {
      additive := M.CommutativeMonoidLaws[N.Nat^, M.CommutativeMonoidData[N.Nat^]::# (A.additiveMonoid N.Nat^ naturalSemiringRaw)] {
        monoid := M.MonoidLaws[N.Nat^, A.additiveMonoid N.Nat^ naturalSemiringRaw] {
          leftIdentity := NL.addZeroLeft,
          rightIdentity := NL.addZeroRight,
          associative := NL.addAssoc,
        },
        commutative := NL.addComm,
      },
      multiplicative := M.MonoidLaws[N.Nat^, A.multiplicativeMonoid N.Nat^ naturalSemiringRaw] {
        leftIdentity := NL.mulOneLeft,
        rightIdentity := NL.mulOneRight,
        associative := NL.mulAssoc,
      },
      leftDistributive := NL.mulDistribLeft,
      rightDistributive := NL.mulDistribRight,
      zeroAbsorbsLeft := NL.mulZeroLeft,
      zeroAbsorbsRight := NL.mulZeroRight,
    };
  \definition naturalSemiring: A.Semiring[N.Nat^] :=
    \into[A.SemiringData[N.Nat^]](naturalSemiringRaw, A.Semiring[N.Nat^])
      \by { naturalSemiringLaws };
}

\module IntegerExamples {
  \import std.Arithmetic[].Int[] \as I;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.eq_reason;
  \use I.int_add;
  \use I.int_mul;
  \definition expanded (a, b, c: I.Integer):
    \(a "*" (b "+" c)\) = \((b "*" a) "+" (c "*" a)\) :=
    eq_reason!{
      \(a "*" (b "+" c)\)
      "=" \((b "+" c) "*" a\) "by" { I.mulIntegerComm a \(b "+" c\) }
      "=" \((b "*" a) "+" (c "*" a)\) "by" { I.mulIntegerDistribRight b c a }
    };
  \import I.Math[] \as IM;
  \import IM.Specification[] \as Specification;
\import Specification.Def[] \as IS;
  \import Specification.Prop[] \as IL;
  \use I.natZero;
  \use I.natSucc;
  \use I.boolTrue;
  \use I.boolFalse;
  \definition z: I.Nat := natZero!{};
  \definition one: I.Nat := natSucc!{z};
  \definition two: I.Nat := natSucc!{one};
  \definition three: I.Nat := natSucc!{two};
  \definition four: I.Nat := natSucc!{three};
  \definition six: I.Nat := natSucc!{{ natSucc!{four} }};
  \definition eight: I.Nat := natSucc!{{ natSucc!{six} }};
  \definition p2: I.Int^ := I.Int^::ofNat two;
  \definition p3: I.Int^ := I.Int^::ofNat three;
  \definition m2: I.Int^ := I.Int^::negSucc one;
  \definition m3: I.Int^ := I.Int^::negSucc two;
  \definition zeroNegation: I.Neg.program^ I.Zero.program^ = I.Zero.program^ := \refl(I.Zero.program^);
  \definition negativeZero: I.NegOfNat.program^ z = I.Zero.program^ := \refl(I.Zero.program^);
  \definition successorAcrossZero: I.Succ.program^ I.MinusOne.program^ = I.Zero.program^ := \refl(I.Zero.program^);
  \definition predecessorAcrossZero: I.Pred.program^ I.Zero.program^ = I.MinusOne.program^ := \refl(I.MinusOne.program^);
  \definition positiveSum: I.Add.program^ p2 p3 = I.Int^::ofNat (natSucc!{four}) := \refl(I.Int^::ofNat (natSucc!{four}));
  \definition negativeSum: I.Add.program^ m2 m3 = I.Int^::negSucc four := \refl(I.Int^::negSucc four);
  \definition mixedPositive: I.Add.program^ p3 m2 = I.One.program^ := \refl(I.One.program^);
  \definition mixedNegative: I.Add.program^ p2 m3 = I.MinusOne.program^ := \refl(I.MinusOne.program^);
  \definition cancel: I.Add.program^ p3 m3 = I.Zero.program^ := \refl(I.Zero.program^);
  \definition signedSubtraction: I.Sub.program^ m2 p3 = I.Int^::negSucc four := \refl(I.Int^::negSucc four);
  \definition negativeProduct: I.Mul.program^ p2 m3 = I.Int^::negSucc (natSucc!{four}) := \refl(I.Int^::negSucc (natSucc!{four}));
  \definition positiveProduct: I.Mul.program^ m2 m3 = I.Int^::ofNat six := \refl(I.Int^::ofNat six);
  \definition zeroProduct: I.Mul.program^ I.Zero.program^ m3 = I.Zero.program^ := \refl(I.Zero.program^);
  \definition oddPower: I.Pow.program^ m2 three = I.Int^::negSucc (natSucc!{six}) := \refl(I.Int^::negSucc (natSucc!{six}));
  \definition evenPower: I.Pow.program^ m2 two = I.Int^::ofNat four := \refl(I.Int^::ofNat four);
  \definition zeroPowerZero: I.Pow.program^ I.Zero.program^ z = I.One.program^ := \refl(I.One.program^);
  \definition absolute: I.Abs.program^ m3 = p3 := \refl(p3);
  \definition magnitude: I.NatAbs.program^ m3 = three := \refl(three);
  \definition signNegative: I.Sign.program^ m3 = I.MinusOne.program^ := \refl(I.MinusOne.program^);
  \definition signZero: I.Sign.program^ I.Zero.program^ = I.Zero.program^ := \refl(I.Zero.program^);
  \definition signPositive: I.Sign.program^ p3 = I.One.program^ := \refl(I.One.program^);
  \definition equalityTrue: I.Eqb.program^ m3 m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition equalityFalse: I.Eqb.program^ m3 p3 = boolFalse!{} := \refl(boolFalse!{});
  \definition negativeOrder: I.Ltb.program^ m3 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition crossingOrder: I.Leb.program^ m3 p2 = boolTrue!{} := \refl(boolTrue!{});
  \definition reversedOrder: I.Leb.program^ p2 m3 = boolFalse!{} := \refl(boolFalse!{});
  \definition equalOrder: I.Leb.program^ m2 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition strictEqual: I.Ltb.program^ m2 m2 = boolFalse!{} := \refl(boolFalse!{});
  \definition minimum: I.Min.program^ m3 p2 = m3 := \refl(m3);
  \definition maximum: I.Max.program^ m3 m2 = m2 := \refl(m2);
  \definition negativeEven: I.Even.program^ m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition negativeOdd: I.Odd.program^ m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition reducedDifference: I.Diff.program^ three two = I.One.program^ := \refl(I.One.program^);
  \definition quotientCancellation: IS.diffMath three two = IS.diffMath one z :=
    IM.classOfEq (I.pair three two) (I.pair one z) (\refl(three));
  \definition noncanonicalSum:
    IM.addMath (IM.class (I.pair three two)) (IM.class (I.pair two three)) =
      IM.class (IM.addRep (I.pair three two) (I.pair two three)) :=
    IM.addMathClass (I.pair three two) (I.pair two three);
  \definition additionAgreement: \forall (x, y: I.Int^) ->
    IM.toMath (I.Add.program^ x y) = IM.addMath (IM.toMath x) (IM.toMath y) := IM.addMatchesMath;
  \definition multiplicationAgreement: \forall (x, y: I.Int^) ->
    IM.toMath (I.Mul.program^ x y) = IM.mulMath (IM.toMath x) (IM.toMath y) := IM.mulMatchesMath;
  \definition additionAssociative: \forall (x, y, z: I.Int^) ->
    I.Add.specification (I.Add.specification x y) z = I.Add.specification x (I.Add.specification y z) := IL.addAssoc;
  \definition multiplicationCommutative: \forall (x, y: I.Int^) ->
    I.Mul.specification x y = I.Mul.specification y x := IL.mulComm;
}

\module IntegerAlgebraExamples {
  \import std.Arithmetic[].IntAlgebra[] \as IA;
  \definition additiveGroup: IA.Group := IA.additiveGroup;
  \definition additiveCommutativeGroup: IA.CommutativeGroup :=
    IA.additiveCommutativeGroup;
}

/* Heterogeneous products share one Program datatype and Set mirror. */
\module PairExamples {
  \import std.Data[].Pair[] \as P;
  \import std.Data[].Bool[] \as B;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.congr;
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Basic[].Program[] \as NatOpProgram;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import P.Prop[A := B.Bool^, B := N.Nat^] \as PL;
  \import P.Program[A := B.Bool, B := N.Nat] \as PP;
  \import PP.Def[] \as PD;
  \import PP.Mapping[C := N.Nat, D := B.Bool].Def[] \as PM;
  \import PP.Functions[C := N.Nat].Def[] \as PF;

  \definition neg: B.Neg.program^ B.Bool^::false = B.Bool^::true := \refl(B.Bool^::true);
  \definition xor: B.Xor.program^ B.Bool^::true B.Bool^::true = B.Bool^::false := \refl(B.Bool^::false);
  \definition implication: B.Implies.program^ B.Bool^::true B.Bool^::false = B.Bool^::false := \refl(B.Bool^::false);

  \definition value: P.Times[B.Bool, N.Nat] :=
    P.Times[_, _]::pair B.Bool::true (N.Nat::succ N.Nat::zero);
  \definition reflected: P.Times^[B.Bool^, N.Nat^] :=
    \squash[_](\box[_](\return value));
  \definition first: P.first B.Bool^ N.Nat^ reflected = B.Bool^::true := \refl(B.Bool^::true);
  \definition second: P.second B.Bool^ N.Nat^ reflected = NatOp.one := \refl(NatOp.one);
  \definition swapped: P.swap B.Bool^ N.Nat^ reflected = P.pair N.Nat^ B.Bool^ NatOp.one B.Bool^::true :=
    \refl(P.pair N.Nat^ B.Bool^ NatOp.one B.Bool^::true);
  \definition mapped: P.map B.Bool^ N.Nat^ B.Bool^ N.Nat^ B.Neg.program^ NatOpProgram.pred^ reflected =
      P.pair B.Bool^ N.Nat^ B.Bool^::false NatOp.zero :=
    \refl(P.pair B.Bool^ N.Nat^ B.Bool^::false NatOp.zero);

  /* Reflect complete operations, then prove agreement for arbitrary arguments. */

  \definition makeAgrees (b: B.Bool^) (n: N.Nat^): PD.Make.program^ b n = P.pair B.Bool^ N.Nat^ b n :=
    congr!{PD.Make.T^ _} (\fun (operation: _) => operation b n) _ _ PD.Make.coherence;
  \definition firstAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PD.First.program^ p = P.first B.Bool^ N.Nat^ p :=
    \fun (p: _) => congr!{PD.First.T^ _} (\fun (operation: _) => operation p) _ _ PD.First.coherence;
  \definition secondAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PD.Second.program^ p = P.second B.Bool^ N.Nat^ p :=
    \fun (p: _) => congr!{PD.Second.T^ _} (\fun (operation: _) => operation p) _ _ PD.Second.coherence;
  \definition swapAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PD.Swap.program^ p = P.swap B.Bool^ N.Nat^ p :=
    \fun (p: _) => congr!{PD.Swap.T^ _} (\fun (operation: _) => operation p) _ _ PD.Swap.coherence;

  \definition mapAgrees (f: B.Bool^ -> N.Nat^) (g: N.Nat^ -> B.Bool^):
    \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PM.Map.program^ f g p = P.map B.Bool^ N.Nat^ N.Nat^ B.Bool^ f g p :=
    \fun (p: _) => congr!{PM.Map.T^ _} (\fun (operation: _) => operation f g p) _ _ PM.Map.coherence;
  \definition mapFirstAgrees (f: B.Bool^ -> N.Nat^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PM.MapFirst.program^ f p = P.mapFirst B.Bool^ N.Nat^ N.Nat^ f p :=
    \fun (p: _) => congr!{PM.MapFirst.T^ _} (\fun (operation: _) => operation f p) _ _ PM.MapFirst.coherence;
  \definition mapSecondAgrees (g: N.Nat^ -> B.Bool^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PM.MapSecond.program^ g p = P.mapSecond B.Bool^ N.Nat^ B.Bool^ g p :=
    \fun (p: _) => congr!{PM.MapSecond.T^ _} (\fun (operation: _) => operation g p) _ _ PM.MapSecond.coherence;

  \definition curryAgrees (f: P.Times^[B.Bool^, N.Nat^] -> N.Nat^) (b: B.Bool^) (n: N.Nat^):
    PF.Curry.program^ f b n = P.curry B.Bool^ N.Nat^ N.Nat^ f b n :=
    congr!{PF.Curry.T^ _} (\fun (operation: _) => operation f b n) _ _ PF.Curry.coherence;
  \definition uncurryAgrees (f: B.Bool^ -> N.Nat^ -> N.Nat^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PF.Uncurry.program^ f p = P.uncurry B.Bool^ N.Nat^ N.Nat^ f p :=
    \fun (p: _) => congr!{PF.Uncurry.T^ _} (\fun (operation: _) => operation f p) _ _ PF.Uncurry.coherence;

  \definition assocAgrees: \forall (p: P.Times^[P.Times^[B.Bool^, N.Nat^], N.Nat^]) ->
    PF.Assoc.program^ p = P.assoc B.Bool^ N.Nat^ N.Nat^ p :=
    \fun (p: _) => congr!{PF.Assoc.T^ _} (\fun (operation: _) => operation p) _ _ PF.Assoc.coherence;
  \definition unassocAgrees: \forall (p: P.Times^[B.Bool^, P.Times^[N.Nat^, N.Nat^]]) ->
    PF.Unassoc.program^ p = P.unassoc B.Bool^ N.Nat^ N.Nat^ p :=
    \fun (p: _) => congr!{PF.Unassoc.T^ _} (\fun (operation: _) => operation p) _ _ PF.Unassoc.coherence;

  /* Direct Program use: type inference, type-changing maps, and thunked callbacks. */
  \definition boolToNat(b: B.Bool): \F(N.Nat) :=
    \match b \in B.Bool \with {
    | false : \return N.Nat::zero
    | true : \return N.Nat::succ N.Nat::zero
    };
  \definition natToBool(n: N.Nat): \F(B.Bool) :=
    \match n \in N.Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false };
  \definition pipeline: \F(B.Bool) := \program {
    \bind input: P.Times[B.Bool, N.Nat] <- P.Times::make B.Bool::true (N.Nat::succ N.Nat::zero) \then
    \bind mapped: P.Times[N.Nat, B.Bool] <- (\force PM.Map.program) (\thunk boolToNat) (\thunk natToBool) input \then
    \bind swapped: P.Times[B.Bool, N.Nat] <- P.Times::swap mapped \then
    \bind result: B.Bool <- P.Times::first swapped \then
    \return result
  };
  \definition pipelineResult: \squash[_](\box[_](pipeline)) = B.Bool^::false := \refl(B.Bool^::false);
  \definition changeFirst: \F(P.Times[N.Nat, N.Nat]) := (\force PM.MapFirst.program) (\thunk boolToNat) value;
  \definition changeSecond: \F(P.Times[B.Bool, B.Bool]) := (\force PM.MapSecond.program) (\thunk natToBool) value;
  \definition changedFirst: \squash[_](\box[_](changeFirst)) =
    P.pair _ _ NatOp.one NatOp.one := \refl(P.pair _ _ NatOp.one NatOp.one);
  \definition changedSecond: \squash[_](\box[_](changeSecond)) =
    P.pair _ _ B.Bool^::true B.Bool^::false := \refl(P.pair _ _ B.Bool^::true B.Bool^::false);
  \definition curried: \F(N.Nat) := (\force PF.Curry.program) (\thunk (\force PD.Second.program)) B.Bool::false (N.Nat::succ N.Nat::zero);
  \definition choose(b: B.Bool, n: N.Nat): \F(N.Nat) :=
    \match b \in B.Bool \with { | false : \return N.Nat::zero | true : \return n };
  \definition uncurried: \F(N.Nat) := (\force PF.Uncurry.program) (\thunk choose) value;
  \definition curriedResult: \squash[_](\box[_](curried)) = NatOp.one := \refl(NatOp.one);
  \definition uncurriedResult: \squash[_](\box[_](uncurried)) = NatOp.one := \refl(NatOp.one);
  \definition nestedRoundTrip: \F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]) := \program {
    \bind right: P.Times[B.Bool, P.Times[N.Nat, N.Nat]] <- (\force PF.Assoc.program) (P.Times[_, _]::pair value N.Nat::zero) \then
    \bind left: P.Times[P.Times[B.Bool, N.Nat], N.Nat] <- (\force PF.Unassoc.program) right \then
    \return left
  };
  \definition nestedResult:
    \squash[_](\box[_](nestedRoundTrip)) = P.pair _ _ reflected NatOp.zero :=
    \refl(P.pair _ _ reflected NatOp.zero);
}

/* The Set API also accepts carriers that have no Program representation. */
\module AbstractPairExamples(A, B, C, D: \Set, a: A, b: B) {
  \import std.Data[].Pair[] \as P;
  \import P.Prop[A := A, B := B] \as PL;
  \import P.Mapping[A := A, B := B, C := C, D := D].Prop[] \as ML;
  \import P.Functions[A := A, B := B, C := C].Prop[] \as FL;
  \definition value: P.Times^[A, B] := P.pair A B a b;
  \definition first: P.first A B value = a := \refl(a);
  \definition second: P.second A B value = b := \refl(b);
  \definition uncurried: P.uncurry A B A (\fun (x: A) => \fun (y: B) => x) value = a := \refl(a);
  \definition equalComponents: \forall (p, q: P.Times^[A, B]) ->
    P.first _ _ p = P.first _ _ q -> P.second _ _ p = P.second _ _ q -> p = q := PL.ext;
  \definition injective (x: A) (y: B): value = P.pair A B x y -> a = x := PL.pairInjectiveFirst a x b y;
  \definition separateMaps: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: P.Times^[A, B]) ->
    P.mapSecond C B D g (P.mapFirst A B C f p) = P.map A B C D f g p := ML.mapSeparate;
  \definition leftRoundTrip: \forall (p: P.Times^[P.Times^[A, B], C]) -> P.unassoc A B C (P.assoc A B C p) = p :=
    FL.unassocAssoc;
  \definition rightRoundTrip: \forall (p: P.Times^[A, P.Times^[B, C]]) -> P.assoc A B C (P.unassoc A B C p) = p :=
    FL.assocUnassoc;
}

\module EqualityExamples(A, B: \Set, f: A -> B, a, b, c: A, ab: a = b, bc: b = c) {
  \import std.Logic[].Equality[] \as E;
  \use E.sym;
  \use E.trans;
  \use E.congr;
  \import std.Logic[].Equality[].Prop[A := A] \as Laws;
  \definition reverse: b = a := sym!{A} _ _ ab;
  \definition chained: a = c := trans!{A} _ _ _ ab bc;
  \definition mapped: f a = f c := congr!{A B} f _ _ (Laws.trans a b c ab bc);
}

\module EquationalReasoningExamples(A, B: \Set, f: A -> B,
  a, b, c, d: A, ab: a = b, bc: b = c, cd: c = d) {
  \import std.Logic[].Equality[] \as E;
  \use E.eq_reason;
  \use E.congr;

  \definition reflexive: a = a := eq_reason!{a};
  \definition single: a = b := eq_reason!{a "=" b "by" ab};
  \definition chained: a = d := eq_reason!{
    a "=" b "by" ab
      "=" c "by" bc
      "=" d "by" cd
  };
  \definition mapped: f a = f c := eq_reason!{
    { f a } "=" { f b } "by" { congr!{A B} f a b ab }
            "=" { f c } "by" { congr!{A B} f b c bc }
  };
  \definition local(x, h: A, xh: x = h): x = h :=
    eq_reason!{x "=" h "by" xh};
}

\module FiniteSubsetExamples(A: \Set, a, b: A) {
  \import std.Set[].FiniteSubset[A := A] \as F;
  \definition empty: F.FiniteSubset := F.empty;
  \definition singleton: F.FiniteSubset := F.singleton a;
  \definition pair: F.FiniteSubset := F.unorderedPair a b;
  \definition singletonMember: \In[A] (F.Singleton a) a := F.inSingleton a;
  \definition leftMember: \In[A] (F.UnorderedPair a b) a :=
    F.inUnorderedPairLeft a b;
  \definition rightMember: \In[A] (F.UnorderedPair a b) b :=
    F.inUnorderedPairRight a b;
}

\module SumExamples(A, B: \Set, a: A, b: B) {
  \import std.Data[].Sum[] \as S;
  \definition left: S.Sum[A, B] := S.Sum[A, B]::inl a;
  \definition right: S.Sum[A, B] := S.Sum[A, B]::inr b;
}

\module FinSetExamples {
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import std.Data[].FinSet[] \as F;
  \definition one: F.Fin (N.Nat^::succ N.Nat^::zero) :=
    F.zero N.Nat^::zero;
  \definition two: F.Fin (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) :=
    F.succ (N.Nat^::succ N.Nat^::zero) one;
}

\module RelationExamples(A: \Set, R: A -> A -> \Prop) {
  \import std.Logic[].Rel[] \as Rel;
  \import Rel.Closure[] \as Closure;
  \definition intoReflexiveClosure:
    \forall (x, y: A) -> R x y -> Closure.ReflexiveClosure A R x y :=
    Closure.reflexiveClosureOf A R;
  \definition closureReflexive:
    \forall (x: A) -> Closure.ReflexiveClosure A R x x :=
    Closure.reflexiveClosureRefl A R;
}

\module LawExamples(
  A: \Set,
  op, other: A -> A -> A,
  unit: A,
  inverse: A -> A,
  leftUnit: \forall (x: A) -> op unit x = x,
  rightUnit: \forall (x: A) -> op x unit = x,
  leftInverse: \forall (x: A) -> op (inverse x) x = unit,
  rightInverse: \forall (x: A) -> op x (inverse x) = unit,
  leftDistrib: \forall (x, y, z: A) ->
    op x (other y z) = other (op x y) (op x z),
  rightDistrib: \forall (x, y, z: A) ->
    op (other x y) z = other (op x z) (op y z),
) {
  \import std.Logic[].Algebra[].Def[] \as Law;
  \definition unital: Law.Unital[A, op, unit] :=
    Law.Unital[A, op, unit]::# leftUnit rightUnit;
  \definition invertible: Law.Invertible[A, op, unit, inverse] :=
    Law.Invertible[A, op, unit, inverse]::# leftInverse rightInverse;
  \definition distributive: Law.Distributive[A, op, other] :=
    Law.Distributive[A, op, other]::# leftDistrib rightDistrib;
}

\module RationalExamples {
  \import std.Arithmetic[].Rat[] \as R;
  \import R.Fractions[] \as RF;
  \import RF.Arithmetic[].Def[] \as RO;
\import RF.Arithmetic[].Prop[] \as ROProp;
  \import RF.Order[] \as RFO;
  \definition fractionTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y z -> RF.FractionEq x z :=
    RF.fractionEqTrans;
  \definition fractionSymmetry:
    \forall (x, y: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y x :=
    RF.fractionEqSym;
  \definition fractionMultiplicationCompatibility:
    \forall (x, y, u, v: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq u v ->
      RF.FractionEq (RO.mul x u) (RO.mul y v) :=
    ROProp.fractionMulRespects;
  \definition reciprocalLaw:
    \forall (x: RF.Fraction) -> RF.NumeratorNonZero x ->
      RF.FractionEq (RO.mul x (RO.reciprocal x)) RF.one :=
    ROProp.fractionMulReciprocal;
  \definition fractionAdditionZero:
    \forall (x: RF.Fraction) ->
      RF.FractionEq (RO.add x RF.zero) x :=
    ROProp.fractionAddZeroRight;
  \definition fractionOrderTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.lt x y -> RF.lt y z -> RF.lt x z := RFO.ltTrans;
  \definition fractionOrderCompatibility:
    \forall (x, x2, y, y2: RF.Fraction) ->
      RF.FractionEq x x2 -> RF.FractionEq y y2 -> RF.lt x y ->
      RF.lt x2 y2 := RFO.ltRespects;
  \import RF.Quotient[] \as RQ;
  \definition quotientNegation: RQ.Rat -> RQ.Rat := RQ.neg;
  \definition quotientNegationInvolutive:
    \forall (x: RQ.Rat) -> RQ.neg (RQ.neg x) = x := RQ.negInvolutive;
  \definition quotientNegatesInteger:
    \forall (n: RQ.IntegerCarrier) ->
      RQ.neg (RQ.ofInteger n) = RQ.ofInteger (RQ.integerNeg n) :=
    RQ.negOfInteger;
  \definition quotientMultiplication:
    RQ.Rat -> RQ.Rat -> RQ.Rat := RQ.mulRat;
  \definition quotientMultiplicationCommutative:
    \forall (x, y: RQ.Rat) ->
      RQ.mulRat x y = RQ.mulRat y x :=
    RQ.mulRatComm;
  \import RQ.Division[].Def[] \as RQD;
  \definition quotientDivision: RQ.Rat -> RQ.NonZeroRat -> RQ.Rat := RQD.div;
  \definition quotientDivisionRepresentative:
    \forall (a, b: RF.Fraction) -> \forall (nonzero: RF.NumeratorNonZero b) ->
      RQD.div (RQ.class a)
        (\into[RQ.Rat](RQ.class b, RQ.NonZeroRatSet) \by { RQ.classIsNonZero b nonzero }) =
      RQ.class (RO.mul a (RO.reciprocal b)) :=
    \block {
      \fun (a, b: _) (nonzero: _) \then
      \let denominator: RQ.NonZeroRat :=
        \into[RQ.Rat](RQ.class b, RQ.NonZeroRatSet) \by { RQ.classIsNonZero b nonzero } \then
      \return RQD.divOfRepresentatives (RQ.class a) denominator a b
        (\refl(RQ.ClassOf a)) (\refl(RQ.ClassOf b))
    };
}

\module DedekindRealExamples {
  \import real.DedekindReal[] \as D;
  \import D.Cuts[].Def[] \as DO;
  \import D.Arithmetic[].Def[] \as DC;
  \import D.Arithmetic[].Prop[] \as DL;
  \import D.Field[].Def[] \as DF;
  \import real.AxiomaticReals[Carrier := D.Real] \as DAR;
  \import D.Cuts[].Prop[] \as DCL;
  \import D.Completeness[] \as DComplete;
  \definition orderReflexive:
    \forall (x: D.Real) -> D.Le x x := D.leRefl;
  \definition additionAssociative:
    \forall (x, y, z: D.Real) ->
      DC.add (DC.add x y) z = DC.add x (DC.add y z) := DL.addAssoc;
  \definition additionInverse:
    \forall (x: D.Real) -> DC.add (DC.neg x) x = DC.zero := DL.addNegLeft;
  \definition rationalAddition:
    \forall (a, b: D.Rat) ->
      DC.add (DC.ofRat a) (DC.ofRat b) = DC.ofRat (D.addRat a b) :=
    DL.ofRatAdd;
  \definition rationalStrictOrder:
    \forall (a, b: D.Rat) -> D.lt a b -> D.Lt (DC.ofRat a) (DC.ofRat b) :=
    DL.ltOfRat;
  \definition additiveGroup: DL.CommutativeGroup :=
    DL.additiveCommutativeGroup;
  \definition multiplicationCommutative:
    \forall (x, y: D.Real) -> DC.mul x y = DC.mul y x := DL.mulComm;
  \definition multiplicationIdentity:
    \forall (x: D.Real) -> DC.mul DC.one x = x := DL.mulOneLeft;
  \definition multiplicationZero:
    \forall (x: D.Real) -> DC.mul DC.zero x = DC.zero := DL.mulZeroLeft;
  \definition inverse: D.Real -> D.Real := DC.inv;
  \definition inverseClosure:
    \forall (x: D.Real) ->
      \In[\Pow D.Rat] D.CutSet (DO.InvLower x) :=
    DCL.invCut;
  \definition lowerCompleteness:
    \forall (S: \Pow D.Real) -> DComplete.Nonempty S ->
      DComplete.BoundedBelow S ->
      \exists { l : D.Real \where DComplete.GreatestLowerBound S l } :=
    DComplete.completeBelow;
}

\module CauchyRealExamples {
  \import real.CauchyReal[] \as C;
  \import C.Completeness[] \as CComplete;
  \import C.Order[] \as COrder;
  \import C.Quotient[] \as CQ;
  \import CQ.Arithmetic[].Def[] \as CR;
\import CQ.Arithmetic[].Prop[] \as CRProp;
  \definition closenessSymmetry:
    \forall (x, y, eps: C.Rat) ->
      C.Close x y eps -> C.Close y x eps :=
    C.closeSym;
  \definition sequenceEquivalenceSymmetry:
    \forall (x, y: C.CauchySeq) ->
      C.Equivalent x y -> C.Equivalent y x :=
    C.equivalentSym;
  \definition sequenceEquivalenceTransitivity:
    \forall (x, y, z: C.CauchySeq) ->
      C.Equivalent x y -> C.Equivalent y z -> C.Equivalent x z :=
    C.equivalentTrans;
  \definition additionAssociative:
    \forall (x, y, z: CQ.Real) ->
      CR.add (CR.add x y) z = CR.add x (CR.add y z) :=
    CRProp.addAssoc;
  \definition additionInverse:
    \forall (x: CQ.Real) -> CR.add (CR.neg x) x = CR.zero :=
    CRProp.addNegLeft;
  \definition negationInvolutive:
    \forall (x: CQ.Real) -> CR.neg (CR.neg x) = x :=
    CRProp.negInvolutive;
  \import real.AxiomaticReals[Carrier := CQ.Real] \as CAR;
  \definition completeness: CAR.Completeness COrder.raw :=
    CComplete.completeness;
  \definition axiomaticReal: CAR.AxiomaticRealStructure :=
    CComplete.axiomaticReal;
}

\module QuotientExamples(A: \Set, x, y: A, xy: x = y) {
  \import std.Logic[].Equality[].Prop[A := A] \as E;
  \import std.Set[].Quotient[A := A, Equivalent := (\fun (a, b: A) => a = b)] \as Q;
  \definition relationLaws: Q.EquivalenceLaws := Q.EquivalenceLaws {
    refl := \fun (a: _) => \refl(a),
    sym := E.sym,
    trans := E.trans,
  };
  \definition equalClasses: Q.ClassOf x = Q.ClassOf y := Q.classOfEq relationLaws x y xy;
  \definition extensionality: \forall (a, b: Q.Carrier) ->
    (\forall (z: A) -> Q.mem a z -> Q.mem b z) -> (\forall (z: A) -> Q.mem b z -> Q.mem a z) -> a = b := Q.eqByExt;
  \definition identityRespects: Q.UnaryRespects (\fun (a: A) => a) :=
    \fun (a, b: A) => \fun (ab: a = b) => ab;
  \definition identityImageClosed:
    \forall (a: Q.Carrier) -> Q.IsClass (Q.UnaryImage (\fun (z: A) => z) a) :=
    Q.unaryImageClosed relationLaws (\fun (z: A) => z) identityRespects;
}
\module TopologyExamples {
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import topology.Topology[Carrier := N.Nat^] \as T;
  \import T.Presentations[] \as TP;
  \import topology.Continuity[A := N.Nat^, B := N.Nat^] \as C;
  \import topology.Composition[A := N.Nat^, B := N.Nat^, C := N.Nat^] \as CC;
  \import topology.Product[A := N.Nat^, B := N.Nat^] \as P;
  \import P.Universal[X := N.Nat^] \as PU;
  \import T.Subspace[S := T.Singleton N.Nat^::zero] \as S;
  \import C.Restriction[S := T.Singleton N.Nat^::zero] \as SM;
  \import topology.Continuity[A := S.CarrierSet, B := N.Nat^] \as SC;
  \import T.SingletonSpace[point := N.Nat^::zero] \as One;

  \definition product: P.ProductTopology :=
    P.topology T.Discrete T.Indiscrete;
  \definition subspace: S.SubspaceTopology := S.topology T.Discrete;
  \definition onePoint: One.PointTopology := One.topology;
  \definition discreteOpen: T.IsOpenIn T.Discrete (T.Singleton N.Nat^::zero) :=
    T.discreteOpen (T.Singleton N.Nat^::zero);
  \definition closure: TP.SetOperator := TP.ClosureOf T.Discrete;
  \definition interior: TP.SetOperator := TP.InteriorOf T.Discrete;
  \definition neighborhoods: TP.NeighborhoodAssignment :=
    TP.NeighborhoodsOf T.Discrete;
  \definition identityContinuous:
    C.Continuous T.Discrete T.Discrete (\fun (x: N.Nat^) => x) :=
    \fun (U: \Pow N.Nat^) =>
      \fun (_: T.IsOpenIn T.Discrete U) =>
        T.discreteOpen (C.Preimage (\fun (x: N.Nat^) => x) U);
  \definition composedIdentityContinuous:
    C.Continuous T.Discrete T.Discrete
      (C.compose N.Nat^ (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)) :=
    CC.composeContinuous T.Discrete T.Discrete T.Discrete
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)
      identityContinuous identityContinuous;
  \definition restrictedIdentityContinuous:
    SC.Continuous (S.topology T.Discrete) T.Discrete
      (\fun (x: S.CarrierSet) => x) :=
    SM.restrictContinuous T.Discrete T.Discrete
      (\fun (x: N.Nat^) => x) identityContinuous;
  \definition pairContinuous:
    PU.PairContinuous PU.discreteSource
      T.Discrete T.Discrete
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x) :=
    PU.pairContinuous PU.discreteSource
      T.Discrete T.Discrete
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)
      (\fun (U: \Pow N.Nat^) =>
        \fun (_: T.IsOpenIn T.Discrete U) =>
          PU.discreteSourceOpen (PU.LeftPreimage (\fun (x: N.Nat^) => x) U))
      (\fun (V: \Pow N.Nat^) =>
        \fun (_: T.IsOpenIn T.Discrete V) =>
          PU.discreteSourceOpen (PU.RightPreimage (\fun (x: N.Nat^) => x) V));
  \definition pairFirstContinuous:
    PU.LeftContinuous PU.discreteSource
      T.Discrete (\fun (x: N.Nat^) => x) :=
    #left{(#ltr{(PU.universal PU.discreteSource
      T.Discrete T.Discrete
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x))}
      pairContinuous)};
}

\module BijectionExamples(A: \Set) {
  \import std.Data[].Bijection[A := A, B := A] \as B;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.sym;

  \definition compose(first, second: B.Bijection): B.Bijection :=
    B.Bijection {
      forward := \fun (x: A) => #forward{second} (#forward{first} x),
      backward := \fun (x: A) => #backward{first} (#backward{second} x),

      leftInverse := \fun (x: A) =>
        \idelim #forward{first} x = #backward{second} (#forward{second} (#forward{first} x))
          \with y: A => #backward{first} y = x
          \by { base: #leftInverse{first} x, equality: sym!{A} _ _ (#leftInverse{second} (#forward{first} x)) },
      rightInverse := \fun (x: A) =>
        \idelim #backward{second} x = #forward{first} (#backward{first} (#backward{second} x))
          \with y: A => #forward{second} y = x
          \by { base: #rightInverse{second} x, equality: sym!{A} _ _ (#rightInverse{first} (#backward{second} x)) },
    };
}

\module MetricExamples(Carrier: \Set) {
  \import topology.MetricSpace[Carrier := Carrier] \as M;
  \import M.Topology[] \as MT;
  \import topology.Topology[Carrier := Carrier] \as T;

  \definition induced(metric: M.Metric): T.Topology :=
    MT.topology metric;

  \definition openBall(metric: M.Metric) (x: Carrier) (radius: M.DistanceValue):
    T.IsOpenIn (induced metric) (M.Ball metric x radius) :=
    MT.ballOpenIn metric x radius;

  \definition intersectionOfBalls(metric: M.Metric)
    (x, y: Carrier) (r, s: M.DistanceValue):
    T.IsOpenIn (induced metric) (T.Intersection (M.Ball metric x r) (M.Ball metric y s)) :=
    #intersectionOpen{(induced metric)} (M.Ball metric x r) (M.Ball metric y s)
      (openBall metric x r) (openBall metric y s);
}

\module PresentationExamples(Carrier: \Set) {
  \import topology.Topology[Carrier := Carrier] \as T;
  \import T.Presentations[] \as P;

  \definition identityClosure: P.ClosureOperator :=
    P.ClosureOperator { apply := \fun (S: \Pow Carrier) => S,

      empty := \refl(T.Empty),
      extensive := \fun (S: \Pow Carrier) (x: Carrier) (member: T.Member S x) => member,
      union := \fun (S, U: \Pow Carrier) => \refl(P.BinaryUnion S U),
      idempotent := \fun (S: \Pow Carrier) => \refl(S),
    };

  \definition arbitraryIntersection(system: P.ClosedSetSystem)
    (family: \Pow (\Pow Carrier))
    (closed: \forall (F: \Pow Carrier) -> T.FamilyMember family F -> P.IsClosedBy system F):
    P.IsClosedBy system (P.ArbitraryIntersection family) :=
    #intersectionClosed{system} family closed;
}

\module RelationBundleExamples {
  \import std.Logic[].Rel[] \as R;
  \inductive Unit: \Set := | unit: Unit;
  \definition equality: R.EquivalenceRelation := R.Equality Unit;
  \definition relation: R.RelationData := R.underlying equality;
  \import R.QuotientOf[r := relation] \as Q;
  \definition quotient: R.QuotientData := Q.quotient;
  \definition selfClass: quotient.class Unit::unit = quotient.class Unit::unit :=
    quotient.relatedEqual equality.laws Unit::unit Unit::unit (\refl(Unit::unit));
}

\module IntegrationExamples {
  \import integration.Real[] \as I;
  \import real.DedekindReal[] \as R;
  \import R.Arithmetic[].Prop[] \as Laws;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.trans;
  \use Equality.congr;

  \definition interval: I.Interval := I.Interval {
    left := I.zero,
    right := I.one,
    ordered := Laws.oneNonnegative,
  };
  \import I.Riemann[interval := interval].Def[] \as Riemann;
  \import I.Riemann[interval := interval].Prop[] \as RI;
  \import I.Lebesgue[interval := interval].Def[] \as Lebesgue;
  \import I.Lebesgue[interval := interval].Prop[] \as LI;

  \definition constantRiemannValue: \forall (c: I.Real) -> (RI.constant c).integral = c :=
    \fun (c: I.Real) => trans!{I.Real} _ _ _
      (congr!{I.Real I.Real} (\fun (length: I.Real) => I.mul length c) _ _ (Laws.subZeroRight I.one))
      (Laws.fieldMulOneLeft c);

  \definition constantLebesgueValue: \forall (c: I.Real) -> LI.integral (LI.ofRiemann (RI.constant c)) = c :=
    \fun (c: I.Real) => trans!{I.Real} _ _ _ (LI.riemannAgreement (RI.constant c)) (constantRiemannValue c);

  \definition signedExample: LI.integral (LI.ofRiemann (RI.constant (I.neg I.one))) = I.neg I.one :=
    constantLebesgueValue (I.neg I.one);

  \import std.Data[].Nat[] \as N;
  \definition zeroRiemann: Riemann.Function := Riemann.Function {
    function := \fun (x: I.Real) => I.zero,
    integral := I.zero,
    hasIntegral := \idelim (RI.constant I.zero).integral = I.zero \with value: I.Real =>
      Riemann.HasIntegral[(\fun (x: I.Real) => I.zero), value]
      \by { base: (RI.constant I.zero).hasIntegral, equality: constantRiemannValue I.zero },
  };

  \definition zeroRepresentationsEquivalent:
    Lebesgue.Equivalent (LI.constantRepresentation (RI.constant I.zero)) (LI.constantRepresentation zeroRiemann) :=
    \fun (epsilon: I.Real) (positive: R.Lt I.zero epsilon) =>
      \exact(\into[N.Nat^](N.Nat^::zero, { threshold: N.Nat^ \where
        Lebesgue.EquivalenceControl (LI.constantRepresentation (RI.constant I.zero)) (LI.constantRepresentation zeroRiemann) epsilon threshold }) \by {
          \fun (n: N.Nat^) (later: _) => RI.smallSelf (\fun (x: I.Real) => I.zero) epsilon positive },
        \Cast[N.Nat^] ({ threshold: N.Nat^ \where
          Lebesgue.EquivalenceControl (LI.constantRepresentation (RI.constant I.zero)) (LI.constantRepresentation zeroRiemann) epsilon threshold }));

  \definition zeroClassIndependent: LI.ofRiemann (RI.constant I.zero) = LI.ofRiemann zeroRiemann :=
    LI.equivalentClasses (LI.constantRepresentation (RI.constant I.zero)) (LI.constantRepresentation zeroRiemann) zeroRepresentationsEquivalent;

  \definition allRiemannFunctions: \forall (f: I.Real -> I.Real) -> \forall (value: I.Real) ->
    Riemann.HasIntegral[f, value] -> \exists { lebesgue: Lebesgue.Function \where LI.Agreement[f, value, lebesgue] } :=
    LI.riemannLebesgueAgreement;

  \definition pointInterval: I.Interval := I.Interval {
    left := I.zero,
    right := I.zero,
    ordered := R.leRefl I.zero,
  };
  \import I.Riemann[interval := pointInterval].Prop[] \as PointRI;
  \import I.Lebesgue[interval := pointInterval].Prop[] \as PointLI;

  \definition pointIntegral: \forall (c: I.Real) -> PointLI.integral (PointLI.ofRiemann (PointRI.constant c)) = I.zero :=
    \fun (c: I.Real) => trans!{I.Real} _ _ _ (PointLI.riemannAgreement (PointRI.constant c))
      (trans!{I.Real} _ _ _
        (congr!{I.Real I.Real} (\fun (length: I.Real) => I.mul length c) _ _ (Laws.subSelf I.zero))
        (Laws.fieldMulZeroLeft c));
}
