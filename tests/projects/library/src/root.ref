/* Concrete boundary cases supplement the universally quantified library laws. */
\module ClassicalExamples {
  \import std.Logic[].Proposition[] \as L;
  \import std.Logic[].Classical[] \as C;
  \definition excludedMiddle(P: \Prop): L.Or[P, L.Not P] := C.excludedMiddle P;
}

\module NaturalExamples {
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import std.Data[].Nat[].Basic[].Prop[] \as NL;
  \import std.Data[].Nat[].Division[].Prop[] \as ND;
  \import std.Data[].Nat[].Gcd[].Prop[] \as GcdLaw;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.sym;
  \use Equality.eq_reason;
  \use Equality.congr;
  \use NatOp.nat_add;
  \use NatOp.nat_mul;
  \definition expanded (a, b, c: N.Nat^):
    \(a "*" (b "+" c)\) = \((b "*" a) "+" (c "*" a)\) :=
    eq_reason!{
      \(a "*" (b "+" c)\)
      "=" \((b "+" c) "*" a\) "by" { NL.mulComm a \(b "+" c\) }
      "=" \((b "*" a) "+" (c "*" a)\) "by" { NL.mulDistribRight b c a }
    };
  \definition z: N.Nat := N.Nat::zero;
  \definition one: N.Nat := N.Nat::succ z;
  \definition two: N.Nat := N.Nat::succ one;
  \definition three: N.Nat := N.Nat::succ two;
  \definition four: N.Nat := N.Nat::succ three;
  \definition six: N.Nat := N.Nat::succ (N.Nat::succ four);
  \definition eight: N.Nat := N.Nat::succ (N.Nat::succ six);
  \definition sum: NatOp.Add::[program]^ two^ three^ = N.Nat^::succ four^ := \refl(N.Nat^::succ four^);

  \definition appliedCoherence: NatOp.Add::[program]^ two^ three^ = NatOp.Add::[set] two^ three^ :=
    (congr!{NatOp.Add::[Type]^ _} (\fun (f: _) => f two^ three^) _ _ NatOp.Add::[coherence]);
  \definition additionCoherence: NatOp.Add::[program]^ = NatOp.Add::[set] := NatOp.Add::[coherence];
  \definition pairIterationCoherence: NatPairDef.PairIter::[program]^ = NatPairDef.PairIter::[set] := NatPairDef.PairIter::[coherence];
  \definition additionInput: \Box[\F(NatOp.AddLoop::[State])] :=
    \box[_](\return NatOp.AddState::running two three);
  \definition bundledSum:
    \squash[_](\boxapp(NatOp.AddLoop::[runbox], additionInput)) = N.Nat^::succ four^ :=
    \refl(N.Nat^::succ four^);
  \import std.Data[].Nat[].Iteration[] \as Iteration;
  \import Iteration.Def[A := N.Nat^] \as NI;
  \definition iteration: Iteration.Iteration[N.Nat^]::[Set] := NI.specification;
  \definition iterationZero (f: N.Nat^ -> N.Nat^) (n: N.Nat^):
    (iteration #apply) f n z^ = n := (iteration #zero) f n;
  \definition iterationSucc (f: N.Nat^ -> N.Nat^) (n, count: N.Nat^):
    (iteration #apply) f n (N.Nat^::succ count) = f ((iteration #apply) f n count) :=
    (iteration #succ) f n count;
  \definition subtract: NatOp.Sub::[program]^ three^ two^ = one^ := \refl(one^);
  \definition truncated: NatOp.Sub::[program]^ two^ three^ = z^ := \refl(z^);
  \definition product: NatOp.Mul::[program]^ two^ three^ = six^ := \refl(six^);
  \definition power: NatOp.Pow::[program]^ two^ three^ = eight^ := \refl(eight^);
  \definition zeroPowerZero: NatOp.Pow::[program]^ z^ z^ = one^ := \refl(one^);
  \definition minLeft: NatOp.Min::[program]^ two^ three^ = two^ := \refl(two^);
  \definition minRight: NatOp.Min::[program]^ three^ two^ = two^ := \refl(two^);
  \definition maxLeft: NatOp.Max::[program]^ three^ two^ = three^ := \refl(three^);
  \definition maxRight: NatOp.Max::[program]^ two^ three^ = three^ := \refl(three^);
  \definition minSame: NatOp.Min::[program]^ two^ two^ = two^ := \refl(two^);
  \definition maxSame: NatOp.Max::[program]^ two^ two^ = two^ := \refl(two^);
  \definition less: NL.Lt two^ three^ := \refl(NatOp.Ltb::[program]^ z^ one^);
  \definition notLess: NatOp.Ltb::[program]^ three^ two^ = NatOp.Ltb::[program]^ z^ z^ := \refl(NatOp.Ltb::[program]^ z^ z^);
  \definition notLe: NatOp.Leb::[program]^ three^ two^ = NatOp.Leb::[program]^ one^ z^ := \refl(NatOp.Leb::[program]^ one^ z^);
  \definition equal: NatOp.Eqb::[program]^ two^ two^ = NatOp.Eqb::[program]^ z^ z^ := \refl(NatOp.Eqb::[program]^ z^ z^);
  \definition unequal: NatOp.Eqb::[program]^ two^ three^ = NatOp.Eqb::[program]^ z^ one^ := \refl(NatOp.Eqb::[program]^ z^ one^);
  \definition evenFour: NP.Even::[program]^ four^ = NP.Even::[program]^ z^ := \refl(NP.Even::[program]^ z^);
  \definition oddThree: NP.Odd::[program]^ three^ = NP.Odd::[program]^ one^ := \refl(NP.Odd::[program]^ one^);
  \definition evenThree: NP.Even::[program]^ three^ = NP.Even::[program]^ one^ := \refl(NP.Even::[program]^ one^);
  \definition oddFour: NP.Odd::[program]^ four^ = NP.Odd::[program]^ z^ := \refl(NP.Odd::[program]^ z^);
  /* Quotient/remainder boundaries and several Euclidean transitions. */
  \definition quotientExact: NatDivisionDef.Div::[program]^ six^ two^ = three^ := \refl(three^);
  \definition quotientInexact: NatDivisionDef.Div::[program]^ eight^ three^ = two^ := \refl(two^);
  \definition quotientSmall: NatDivisionDef.Div::[program]^ two^ three^ = z^ := \refl(z^);
  \definition remainderExact: NatDivisionDef.Mod::[program]^ six^ three^ = z^ := \refl(z^);
  \definition remainderInexact: NatDivisionDef.Mod::[program]^ eight^ three^ = two^ := \refl(two^);
  \definition remainderSmall: NatDivisionDef.Mod::[program]^ two^ three^ = two^ := \refl(two^);
  \definition divisionTogether: NatDivisionDef.DivMod::[program]^ eight^ three^ = NatPairDef.natPair two^ two^ :=
    \refl(NatPairDef.natPair two^ two^);
  \definition divisionByZero: NatDivisionDef.Div::[program]^ three^ z^ = z^ := \refl(z^);
  \definition remainderByZero: NatDivisionDef.Mod::[program]^ three^ z^ = three^ := \refl(three^);
  \definition divisionZeroZero: NatDivisionDef.Div::[program]^ z^ z^ = z^ := \refl(z^);
  \definition remainderZeroZero: NatDivisionDef.Mod::[program]^ z^ z^ = z^ := \refl(z^);
  \definition divisionByOne: NatDivisionDef.Div::[program]^ four^ one^ = four^ := \refl(four^);
  \definition remainderByOne: NatDivisionDef.Mod::[program]^ four^ one^ = z^ := \refl(z^);
  \definition divisionSelf: NatDivisionDef.Div::[program]^ three^ three^ = one^ := \refl(one^);
  \definition remainderSelf: NatDivisionDef.Mod::[program]^ three^ three^ = z^ := \refl(z^);
  \definition gcdNontrivial: NG.Gcd::[program]^ eight^ six^ = two^ := \refl(two^);
  \definition gcdReversed: NG.Gcd::[program]^ six^ eight^ = two^ := \refl(two^);
  \definition gcdCoprime: NG.Gcd::[program]^ eight^ three^ = one^ := \refl(one^);
  \definition gcdDivisible: NG.Gcd::[program]^ six^ three^ = three^ := \refl(three^);
  \definition gcdSame: NG.Gcd::[program]^ three^ three^ = three^ := \refl(three^);
  \definition gcdWithOne: NG.Gcd::[program]^ four^ one^ = one^ := \refl(one^);
  \definition gcdLeftZero: NG.Gcd::[program]^ z^ three^ = three^ := \refl(three^);
  \definition gcdRightZero: NG.Gcd::[program]^ three^ z^ = three^ := \refl(three^);
  \definition gcdBothZero: NG.Gcd::[program]^ z^ z^ = z^ := \refl(z^);
  \definition gcdSetZeroRight: NG.Gcd::[set] three^ z^ = three^ := GcdLaw.gcdZeroRight three^;
  \definition gcdSetZeroLeft: NG.Gcd::[set] z^ three^ = three^ := GcdLaw.gcdZeroLeft three^;
  \definition gcdSetBothZero: NG.Gcd::[set] z^ z^ = z^ := GcdLaw.gcdZeroRight z^;
  \definition gcdSetReversed: NG.Gcd::[set] eight^ six^ = NG.Gcd::[set] six^ eight^ :=
    GcdLaw.gcdComm eight^ six^;
  \definition gcdSetNontrivial: NG.Gcd::[set] eight^ six^ = two^ :=
    eq_reason!{
      { NG.Gcd::[set] eight^ six^ }
      "=" { NG.Gcd::[program]^ eight^ six^ } "by" { sym!{N.Nat^} _ _ (congr!{NG.Gcd::[Type]^ N.Nat^} (\fun (f: _) => f eight^ six^) _ _ NG.Gcd::[coherence]) }
      "=" two^ "by" gcdNontrivial
    };
  \definition importedDivisionLaw: \forall (a, b: N.Nat^) ->
    NatOp.Add::[set] (NatOp.Mul::[set] b (NatDivisionDef.Div::[set] a b)) (NatDivisionDef.Mod::[set] a b) = a := ND.divModReconstructs;
  \definition importedRemainderBound: \forall (a, d: N.Nat^) ->
    NL.Lt (NatDivisionDef.Mod::[set] a (N.Nat^::succ d)) (N.Nat^::succ d) := ND.modLt;
  \definition importedGcdGreatest: \forall (d, a, b: N.Nat^) ->
    ND.Divides d a -> ND.Divides d b -> ND.Divides d (NG.Gcd::[set] a b) := GcdLaw.gcdGreatest;
  \definition importedMulLaw: \forall (a, b, c: N.Nat^) ->
    NatOp.Mul::[set] (NatOp.Mul::[set] a b) c = NatOp.Mul::[set] a (NatOp.Mul::[set] b c) := NL.mulAssoc;
  \definition importedPositiveCancellation: \forall (k, a, b: N.Nat^) ->
    NatOp.Mul::[set] a (N.Nat^::succ k) = NatOp.Mul::[set] b (N.Nat^::succ k) -> a = b :=
    NL.mulCancelRightSucc;
  \definition importedSpecification: NatOp.Mul::[program]^ = NatOp.Mul::[set] := NatOp.Mul::[coherence];
  \import std.Alg[].Monoid[] \as M;
  \import std.Alg[].Alg[] \as A;

  \definition additiveRaw: M.Monoid[N.Nat^]::[Raw] :=
    M.Monoid[N.Nat^]::[Raw]::# NatOp.zero^ NatOp.Add::[set];
  \definition additiveLaws: M.Monoid[N.Nat^]::[Law][additiveRaw] :=
    M.Monoid[N.Nat^]::[Law][additiveRaw] {
      leftIdentity := NL.addZeroLeft,
      rightIdentity := NL.addZeroRight,
      associative := NL.addAssoc,
    };
  \definition additiveMonoid: M.Monoid[N.Nat^]::[Set] :=
    \into[M.Monoid[N.Nat^]::[Raw]](additiveRaw, M.Monoid[N.Nat^]) \by { additiveLaws };
  \definition additiveIdentity: \forall (n: N.Nat^) ->
    #op{(M.Monoid[N.Nat^]::[raw] additiveMonoid)} (#unit{(M.Monoid[N.Nat^]::[raw] additiveMonoid)}) n = n :=
    #leftIdentity{additiveMonoid};

  \definition naturalSemiringRaw: A.Semiring[N.Nat^]::[Raw] :=
    A.Semiring[N.Nat^]::[Raw]::# NatOp.zero^ NatOp.one^ NatOp.Add::[set] NatOp.Mul::[set];
  \definition naturalSemiringLaws: A.Semiring[N.Nat^]::[Law][naturalSemiringRaw] :=
    A.Semiring[N.Nat^]::[Law][naturalSemiringRaw] {
      additive := M.CommutativeMonoid[N.Nat^]::[Law][M.CommutativeMonoid[N.Nat^]::[Raw]::# (A.additiveMonoid N.Nat^ naturalSemiringRaw)] {
        monoid := M.Monoid[N.Nat^]::[Law][A.additiveMonoid N.Nat^ naturalSemiringRaw] {
          leftIdentity := NL.addZeroLeft,
          rightIdentity := NL.addZeroRight,
          associative := NL.addAssoc,
        },
        commutative := NL.addComm,
      },
      multiplicative := M.Monoid[N.Nat^]::[Law][A.multiplicativeMonoid N.Nat^ naturalSemiringRaw] {
        leftIdentity := NL.mulOneLeft,
        rightIdentity := NL.mulOneRight,
        associative := NL.mulAssoc,
      },
      leftDistributive := NL.mulDistribLeft,
      rightDistributive := NL.mulDistribRight,
      zeroAbsorbsLeft := NL.mulZeroLeft,
      zeroAbsorbsRight := NL.mulZeroRight,
    };
  \definition naturalSemiring: A.Semiring[N.Nat^]::[Set] :=
    \into[A.Semiring[N.Nat^]::[Raw]](naturalSemiringRaw, A.Semiring[N.Nat^])
      \by { naturalSemiringLaws };
}

\module IntegerExamples {
  \import std.Arithmetic[].Int[] \as I;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.eq_reason;
  \use I.int_add;
  \use I.int_mul;
  \definition expanded (a, b, c: I.Integer):
    \(a "*" (b "+" c)\) = \((b "*" a) "+" (c "*" a)\) :=
    eq_reason!{
      \(a "*" (b "+" c)\)
      "=" \((b "+" c) "*" a\) "by" { I.mulIntegerComm a \(b "+" c\) }
      "=" \((b "*" a) "+" (c "*" a)\) "by" { I.mulIntegerDistribRight b c a }
    };
  \import I.Math[] \as IM;
  \import IM.Specification[] \as Specification;
\import Specification.Def[] \as IS;
  \import Specification.Prop[] \as IL;
  \use I.natZero;
  \use I.natSucc;
  \use I.boolTrue;
  \use I.boolFalse;
  \definition z: I.Nat := natZero!{};
  \definition one: I.Nat := natSucc!{z};
  \definition two: I.Nat := natSucc!{one};
  \definition three: I.Nat := natSucc!{two};
  \definition four: I.Nat := natSucc!{three};
  \definition six: I.Nat := natSucc!{{ natSucc!{four} }};
  \definition eight: I.Nat := natSucc!{{ natSucc!{six} }};
  \definition p2: I.Int^ := I.Int^::ofNat two;
  \definition p3: I.Int^ := I.Int^::ofNat three;
  \definition m2: I.Int^ := I.Int^::negSucc one;
  \definition m3: I.Int^ := I.Int^::negSucc two;
  \definition zeroNegation: I.Neg::[program]^ I.Zero::[program]^ = I.Zero::[program]^ := \refl(I.Zero::[program]^);
  \definition negativeZero: I.NegOfNat::[program]^ z = I.Zero::[program]^ := \refl(I.Zero::[program]^);
  \definition successorAcrossZero: I.Succ::[program]^ I.MinusOne::[program]^ = I.Zero::[program]^ := \refl(I.Zero::[program]^);
  \definition predecessorAcrossZero: I.Pred::[program]^ I.Zero::[program]^ = I.MinusOne::[program]^ := \refl(I.MinusOne::[program]^);
  \definition positiveSum: I.Add::[program]^ p2 p3 = I.Int^::ofNat (natSucc!{four}) := \refl(I.Int^::ofNat (natSucc!{four}));
  \definition negativeSum: I.Add::[program]^ m2 m3 = I.Int^::negSucc four := \refl(I.Int^::negSucc four);
  \definition mixedPositive: I.Add::[program]^ p3 m2 = I.One::[program]^ := \refl(I.One::[program]^);
  \definition mixedNegative: I.Add::[program]^ p2 m3 = I.MinusOne::[program]^ := \refl(I.MinusOne::[program]^);
  \definition cancel: I.Add::[program]^ p3 m3 = I.Zero::[program]^ := \refl(I.Zero::[program]^);
  \definition signedSubtraction: I.Sub::[program]^ m2 p3 = I.Int^::negSucc four := \refl(I.Int^::negSucc four);
  \definition negativeProduct: I.Mul::[program]^ p2 m3 = I.Int^::negSucc (natSucc!{four}) := \refl(I.Int^::negSucc (natSucc!{four}));
  \definition positiveProduct: I.Mul::[program]^ m2 m3 = I.Int^::ofNat six := \refl(I.Int^::ofNat six);
  \definition zeroProduct: I.Mul::[program]^ I.Zero::[program]^ m3 = I.Zero::[program]^ := \refl(I.Zero::[program]^);
  \definition oddPower: I.Pow::[program]^ m2 three = I.Int^::negSucc (natSucc!{six}) := \refl(I.Int^::negSucc (natSucc!{six}));
  \definition evenPower: I.Pow::[program]^ m2 two = I.Int^::ofNat four := \refl(I.Int^::ofNat four);
  \definition zeroPowerZero: I.Pow::[program]^ I.Zero::[program]^ z = I.One::[program]^ := \refl(I.One::[program]^);
  \definition absolute: I.Abs::[program]^ m3 = p3 := \refl(p3);
  \definition magnitude: I.NatAbs::[program]^ m3 = three := \refl(three);
  \definition signNegative: I.Sign::[program]^ m3 = I.MinusOne::[program]^ := \refl(I.MinusOne::[program]^);
  \definition signZero: I.Sign::[program]^ I.Zero::[program]^ = I.Zero::[program]^ := \refl(I.Zero::[program]^);
  \definition signPositive: I.Sign::[program]^ p3 = I.One::[program]^ := \refl(I.One::[program]^);
  \definition equalityTrue: I.Eqb::[program]^ m3 m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition equalityFalse: I.Eqb::[program]^ m3 p3 = boolFalse!{} := \refl(boolFalse!{});
  \definition negativeOrder: I.Ltb::[program]^ m3 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition crossingOrder: I.Leb::[program]^ m3 p2 = boolTrue!{} := \refl(boolTrue!{});
  \definition reversedOrder: I.Leb::[program]^ p2 m3 = boolFalse!{} := \refl(boolFalse!{});
  \definition equalOrder: I.Leb::[program]^ m2 m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition strictEqual: I.Ltb::[program]^ m2 m2 = boolFalse!{} := \refl(boolFalse!{});
  \definition minimum: I.Min::[program]^ m3 p2 = m3 := \refl(m3);
  \definition maximum: I.Max::[program]^ m3 m2 = m2 := \refl(m2);
  \definition negativeEven: I.Even::[program]^ m2 = boolTrue!{} := \refl(boolTrue!{});
  \definition negativeOdd: I.Odd::[program]^ m3 = boolTrue!{} := \refl(boolTrue!{});
  \definition reducedDifference: I.Diff::[program]^ three two = I.One::[program]^ := \refl(I.One::[program]^);
  \definition quotientCancellation: IS.diffMath three two = IS.diffMath one z :=
    IM.classOfEq (I.pair three two) (I.pair one z) (\refl(three));
  \definition noncanonicalSum:
    IM.addMath (IM.class (I.pair three two)) (IM.class (I.pair two three)) =
      IM.class (IM.addRep (I.pair three two) (I.pair two three)) :=
    IM.addMathClass (I.pair three two) (I.pair two three);
  \definition additionAgreement: \forall (x, y: I.Int^) ->
    IM.toMath (I.Add::[program]^ x y) = IM.addMath (IM.toMath x) (IM.toMath y) := IM.addMatchesMath;
  \definition multiplicationAgreement: \forall (x, y: I.Int^) ->
    IM.toMath (I.Mul::[program]^ x y) = IM.mulMath (IM.toMath x) (IM.toMath y) := IM.mulMatchesMath;
  \definition additionAssociative: \forall (x, y, z: I.Int^) ->
    I.Add::[set] (I.Add::[set] x y) z = I.Add::[set] x (I.Add::[set] y z) := IL.addAssoc;
  \definition multiplicationCommutative: \forall (x, y: I.Int^) ->
    I.Mul::[set] x y = I.Mul::[set] y x := IL.mulComm;
}

\module IntegerAlgebraExamples {
  \import std.Arithmetic[].IntAlgebra[] \as IA;
  \definition additiveGroup: IA.Group := IA.additiveGroup;
  \definition additiveCommutativeGroup: IA.CommutativeGroup :=
    IA.additiveCommutativeGroup;
}

/* Heterogeneous products share one Program datatype and Set mirror. */
\module PairExamples {
  \import std.Data[].Pair[] \as P;
  \import std.Data[].Bool[] \as B;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.congr;
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import P.Prop[A := B.Bool^, B := N.Nat^] \as PL;
  \import P.Program[A := B.Bool, B := N.Nat] \as PP;
  \import PP.Def[] \as PD;
  \import PP.Mapping[C := N.Nat, D := B.Bool].Def[] \as PM;
  \import PP.Functions[C := N.Nat].Def[] \as PF;

  \definition neg: B.Neg::[program]^ B.Bool^::false = B.Bool^::true := \refl(B.Bool^::true);
  \definition xor: B.Xor::[program]^ B.Bool^::true B.Bool^::true = B.Bool^::false := \refl(B.Bool^::false);
  \definition implication: B.Implies::[program]^ B.Bool^::true B.Bool^::false = B.Bool^::false := \refl(B.Bool^::false);

  \definition value: P.Times[B.Bool, N.Nat] :=
    P.Times[_, _]::pair B.Bool::true (N.Nat::succ N.Nat::zero);
  \definition reflected: P.Times^[B.Bool^, N.Nat^] :=
    \squash[_](\box[_](\return value));
  \definition first: P.first B.Bool^ N.Nat^ reflected = B.Bool^::true := \refl(B.Bool^::true);
  \definition second: P.second B.Bool^ N.Nat^ reflected = NatOp.one^ := \refl(NatOp.one^);
  \definition swapped: P.swap B.Bool^ N.Nat^ reflected = P.pair N.Nat^ B.Bool^ NatOp.one^ B.Bool^::true :=
    \refl(P.pair N.Nat^ B.Bool^ NatOp.one^ B.Bool^::true);
  \definition mapped: P.map B.Bool^ N.Nat^ B.Bool^ N.Nat^ B.Neg::[program]^ NatOp.Pred::[program]^ reflected =
      P.pair B.Bool^ N.Nat^ B.Bool^::false NatOp.zero^ :=
    \refl(P.pair B.Bool^ N.Nat^ B.Bool^::false NatOp.zero^);

  /* Reflect complete operations, then prove agreement for arbitrary arguments. */

  \definition makeAgrees (b: B.Bool^) (n: N.Nat^): PD.Make::[program]^ b n = P.pair B.Bool^ N.Nat^ b n :=
    congr!{PD.Make::[Type]^ _} (\fun (operation: _) => operation b n) _ _ PD.Make::[coherence];
  \definition firstAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PD.First::[program]^ p = P.first B.Bool^ N.Nat^ p :=
    \fun (p: _) => congr!{PD.First::[Type]^ _} (\fun (operation: _) => operation p) _ _ PD.First::[coherence];
  \definition secondAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PD.Second::[program]^ p = P.second B.Bool^ N.Nat^ p :=
    \fun (p: _) => congr!{PD.Second::[Type]^ _} (\fun (operation: _) => operation p) _ _ PD.Second::[coherence];
  \definition swapAgrees: \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PD.Swap::[program]^ p = P.swap B.Bool^ N.Nat^ p :=
    \fun (p: _) => congr!{PD.Swap::[Type]^ _} (\fun (operation: _) => operation p) _ _ PD.Swap::[coherence];

  \definition mapAgrees (f: B.Bool^ -> N.Nat^) (g: N.Nat^ -> B.Bool^):
    \forall (p: P.Times^[B.Bool^, N.Nat^]) -> PM.Map::[program]^ f g p = P.map B.Bool^ N.Nat^ N.Nat^ B.Bool^ f g p :=
    \fun (p: _) => congr!{PM.Map::[Type]^ _} (\fun (operation: _) => operation f g p) _ _ PM.Map::[coherence];
  \definition mapFirstAgrees (f: B.Bool^ -> N.Nat^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PM.MapFirst::[program]^ f p = P.mapFirst B.Bool^ N.Nat^ N.Nat^ f p :=
    \fun (p: _) => congr!{PM.MapFirst::[Type]^ _} (\fun (operation: _) => operation f p) _ _ PM.MapFirst::[coherence];
  \definition mapSecondAgrees (g: N.Nat^ -> B.Bool^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PM.MapSecond::[program]^ g p = P.mapSecond B.Bool^ N.Nat^ B.Bool^ g p :=
    \fun (p: _) => congr!{PM.MapSecond::[Type]^ _} (\fun (operation: _) => operation g p) _ _ PM.MapSecond::[coherence];

  \definition curryAgrees (f: P.Times^[B.Bool^, N.Nat^] -> N.Nat^) (b: B.Bool^) (n: N.Nat^):
    PF.Curry::[program]^ f b n = P.curry B.Bool^ N.Nat^ N.Nat^ f b n :=
    congr!{PF.Curry::[Type]^ _} (\fun (operation: _) => operation f b n) _ _ PF.Curry::[coherence];
  \definition uncurryAgrees (f: B.Bool^ -> N.Nat^ -> N.Nat^): \forall (p: P.Times^[B.Bool^, N.Nat^]) ->
    PF.Uncurry::[program]^ f p = P.uncurry B.Bool^ N.Nat^ N.Nat^ f p :=
    \fun (p: _) => congr!{PF.Uncurry::[Type]^ _} (\fun (operation: _) => operation f p) _ _ PF.Uncurry::[coherence];

  \definition assocAgrees: \forall (p: P.Times^[P.Times^[B.Bool^, N.Nat^], N.Nat^]) ->
    PF.Assoc::[program]^ p = P.assoc B.Bool^ N.Nat^ N.Nat^ p :=
    \fun (p: _) => congr!{PF.Assoc::[Type]^ _} (\fun (operation: _) => operation p) _ _ PF.Assoc::[coherence];
  \definition unassocAgrees: \forall (p: P.Times^[B.Bool^, P.Times^[N.Nat^, N.Nat^]]) ->
    PF.Unassoc::[program]^ p = P.unassoc B.Bool^ N.Nat^ N.Nat^ p :=
    \fun (p: _) => congr!{PF.Unassoc::[Type]^ _} (\fun (operation: _) => operation p) _ _ PF.Unassoc::[coherence];

  /* Direct Program use: type inference, type-changing maps, and thunked callbacks. */
  \definition boolToNat(b: B.Bool): \F(N.Nat) :=
    \match b \in B.Bool \with {
    | false : \return N.Nat::zero
    | true : \return N.Nat::succ N.Nat::zero
    };
  \definition natToBool(n: N.Nat): \F(B.Bool) :=
    \match n \in N.Nat \with { | zero : \return B.Bool::true | succ k : \return B.Bool::false };
  \definition pipeline: \F(B.Bool) := \program {
    \bind input: P.Times[B.Bool, N.Nat] <- P.Times::make B.Bool::true (N.Nat::succ N.Nat::zero) \then
    \bind mapped: P.Times[N.Nat, B.Bool] <- PM.Map::[program] (\thunk boolToNat) (\thunk natToBool) input \then
    \bind swapped: P.Times[B.Bool, N.Nat] <- P.Times::swap mapped \then
    \bind result: B.Bool <- P.Times::first swapped \then
    \return result
  };
  \definition pipelineResult: \squash[_](\box[_](pipeline)) = B.Bool^::false := \refl(B.Bool^::false);
  \definition changeFirst: \F(P.Times[N.Nat, N.Nat]) := PM.MapFirst::[program] (\thunk boolToNat) value;
  \definition changeSecond: \F(P.Times[B.Bool, B.Bool]) := PM.MapSecond::[program] (\thunk natToBool) value;
  \definition changedFirst: \squash[_](\box[_](changeFirst)) =
    P.pair _ _ NatOp.one^ NatOp.one^ := \refl(P.pair _ _ NatOp.one^ NatOp.one^);
  \definition changedSecond: \squash[_](\box[_](changeSecond)) =
    P.pair _ _ B.Bool^::true B.Bool^::false := \refl(P.pair _ _ B.Bool^::true B.Bool^::false);
  \definition curried: \F(N.Nat) := PF.Curry::[program] (\thunk PD.Second::[program]) B.Bool::false (N.Nat::succ N.Nat::zero);
  \definition choose(b: B.Bool, n: N.Nat): \F(N.Nat) :=
    \match b \in B.Bool \with { | false : \return N.Nat::zero | true : \return n };
  \definition uncurried: \F(N.Nat) := PF.Uncurry::[program] (\thunk choose) value;
  \definition curriedResult: \squash[_](\box[_](curried)) = NatOp.one^ := \refl(NatOp.one^);
  \definition uncurriedResult: \squash[_](\box[_](uncurried)) = NatOp.one^ := \refl(NatOp.one^);
  \definition nestedRoundTrip: \F(P.Times[P.Times[B.Bool, N.Nat], N.Nat]) := \program {
    \bind right: P.Times[B.Bool, P.Times[N.Nat, N.Nat]] <- PF.Assoc::[program] (P.Times[_, _]::pair value N.Nat::zero) \then
    \bind left: P.Times[P.Times[B.Bool, N.Nat], N.Nat] <- PF.Unassoc::[program] right \then
    \return left
  };
  \definition nestedResult:
    \squash[_](\box[_](nestedRoundTrip)) = P.pair _ _ reflected NatOp.zero^ :=
    \refl(P.pair _ _ reflected NatOp.zero^);
}

/* The Set API also accepts carriers that have no Program representation. */
\module AbstractPairExamples(A, B, C, D: \Set, a: A, b: B) {
  \import std.Data[].Pair[] \as P;
  \import P.Prop[A := A, B := B] \as PL;
  \import P.Mapping[A := A, B := B, C := C, D := D].Prop[] \as ML;
  \import P.Functions[A := A, B := B, C := C].Prop[] \as FL;
  \definition value: P.Times^[A, B] := P.pair A B a b;
  \definition first: P.first A B value = a := \refl(a);
  \definition second: P.second A B value = b := \refl(b);
  \definition uncurried: P.uncurry A B A (\fun (x: A) => \fun (y: B) => x) value = a := \refl(a);
  \definition equalComponents: \forall (p, q: P.Times^[A, B]) ->
    P.first _ _ p = P.first _ _ q -> P.second _ _ p = P.second _ _ q -> p = q := PL.ext;
  \definition injective (x: A) (y: B): value = P.pair A B x y -> a = x := PL.pairInjectiveFirst a x b y;
  \definition separateMaps: \forall (f: A -> C) -> \forall (g: B -> D) -> \forall (p: P.Times^[A, B]) ->
    P.mapSecond C B D g (P.mapFirst A B C f p) = P.map A B C D f g p := ML.mapSeparate;
  \definition leftRoundTrip: \forall (p: P.Times^[P.Times^[A, B], C]) -> P.unassoc A B C (P.assoc A B C p) = p :=
    FL.unassocAssoc;
  \definition rightRoundTrip: \forall (p: P.Times^[A, P.Times^[B, C]]) -> P.assoc A B C (P.unassoc A B C p) = p :=
    FL.assocUnassoc;
}

\module EqualityExamples(A, B: \Set, f: A -> B, a, b, c: A, ab: a = b, bc: b = c) {
  \import std.Logic[].Equality[] \as E;
  \use E.sym;
  \use E.trans;
  \use E.congr;
  \import std.Logic[].Equality[].Prop[A := A] \as Laws;
  \definition reverse: b = a := sym!{A} _ _ ab;
  \definition chained: a = c := trans!{A} _ _ _ ab bc;
  \definition mapped: f a = f c := congr!{A B} f _ _ (Laws.trans a b c ab bc);
}

\module EquationalReasoningExamples(A, B: \Set, f: A -> B,
  a, b, c, d: A, ab: a = b, bc: b = c, cd: c = d) {
  \import std.Logic[].Equality[] \as E;
  \use E.eq_reason;
  \use E.congr;

  \definition reflexive: a = a := eq_reason!{a};
  \definition single: a = b := eq_reason!{a "=" b "by" ab};
  \definition chained: a = d := eq_reason!{
    a "=" b "by" ab
      "=" c "by" bc
      "=" d "by" cd
  };
  \definition mapped: f a = f c := eq_reason!{
    { f a } "=" { f b } "by" { congr!{A B} f a b ab }
            "=" { f c } "by" { congr!{A B} f b c bc }
  };
  \definition local(x, h: A, xh: x = h): x = h :=
    eq_reason!{x "=" h "by" xh};
}

\module FiniteSubsetExamples(A: \Set, a, b: A) {
  \import std.Set[].FiniteSubset[A := A] \as F;
  \definition empty: F.FiniteSubset := F.empty;
  \definition singleton: F.FiniteSubset := F.singleton a;
  \definition pair: F.FiniteSubset := F.unorderedPair a b;
  \definition singletonMember: \In[A] (F.Singleton a) a := F.inSingleton a;
  \definition leftMember: \In[A] (F.UnorderedPair a b) a :=
    F.inUnorderedPairLeft a b;
  \definition rightMember: \In[A] (F.UnorderedPair a b) b :=
    F.inUnorderedPairRight a b;
}

\module SumExamples(A, B: \Set, a: A, b: B) {
  \import std.Data[].Sum[] \as S;
  \definition left: S.Sum[A, B] := S.Sum[A, B]::inl a;
  \definition right: S.Sum[A, B] := S.Sum[A, B]::inr b;
}

\module FinSetExamples {
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import std.Data[].FinSet[] \as F;
  \definition one: F.Fin (N.Nat^::succ N.Nat^::zero) :=
    F.zero N.Nat^::zero;
  \definition two: F.Fin (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) :=
    F.succ (N.Nat^::succ N.Nat^::zero) one;
}

\module RelationExamples(A: \Set, R: A -> A -> \Prop) {
  \import std.Logic[].Rel[] \as Rel;
  \import Rel.Closure[] \as Closure;
  \definition intoReflexiveClosure:
    \forall (x, y: A) -> R x y -> Closure.ReflexiveClosure A R x y :=
    Closure.reflexiveClosureOf A R;
  \definition closureReflexive:
    \forall (x: A) -> Closure.ReflexiveClosure A R x x :=
    Closure.reflexiveClosureRefl A R;
}

\module LawExamples(
  A: \Set,
  op, other: A -> A -> A,
  unit: A,
  inverse: A -> A,
  leftUnit: \forall (x: A) -> op unit x = x,
  rightUnit: \forall (x: A) -> op x unit = x,
  leftInverse: \forall (x: A) -> op (inverse x) x = unit,
  rightInverse: \forall (x: A) -> op x (inverse x) = unit,
  leftDistrib: \forall (x, y, z: A) ->
    op x (other y z) = other (op x y) (op x z),
  rightDistrib: \forall (x, y, z: A) ->
    op (other x y) z = other (op x z) (op y z),
) {
  \import std.Logic[].Algebra[].Def[] \as Law;
  \definition unital: Law.Unital[A, op, unit] :=
    Law.Unital[A, op, unit]::# leftUnit rightUnit;
  \definition invertible: Law.Invertible[A, op, unit, inverse] :=
    Law.Invertible[A, op, unit, inverse]::# leftInverse rightInverse;
  \definition distributive: Law.Distributive[A, op, other] :=
    Law.Distributive[A, op, other]::# leftDistrib rightDistrib;
}

\module RationalExamples {
  \import std.Arithmetic[].Rat[] \as R;
  \import R.Fractions[] \as RF;
  \import RF.Arithmetic[].Def[] \as RO;
\import RF.Arithmetic[].Prop[] \as ROProp;
  \import RF.Order[] \as RFO;
  \definition fractionTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y z -> RF.FractionEq x z :=
    RF.fractionEqTrans;
  \definition fractionSymmetry:
    \forall (x, y: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq y x :=
    RF.fractionEqSym;
  \definition fractionMultiplicationCompatibility:
    \forall (x, y, u, v: RF.Fraction) ->
      RF.FractionEq x y -> RF.FractionEq u v ->
      RF.FractionEq (RO.mul x u) (RO.mul y v) :=
    ROProp.fractionMulRespects;
  \definition reciprocalLaw:
    \forall (x: RF.Fraction) -> RF.NumeratorNonZero x ->
      RF.FractionEq (RO.mul x (RO.reciprocal x)) RF.one :=
    ROProp.fractionMulReciprocal;
  \definition fractionAdditionZero:
    \forall (x: RF.Fraction) ->
      RF.FractionEq (RO.add x RF.zero) x :=
    ROProp.fractionAddZeroRight;
  \definition fractionOrderTransitivity:
    \forall (x, y, z: RF.Fraction) ->
      RF.lt x y -> RF.lt y z -> RF.lt x z := RFO.ltTrans;
  \definition fractionOrderCompatibility:
    \forall (x, x2, y, y2: RF.Fraction) ->
      RF.FractionEq x x2 -> RF.FractionEq y y2 -> RF.lt x y ->
      RF.lt x2 y2 := RFO.ltRespects;
  \import RF.Quotient[] \as RQ;
  \definition quotientNegation: RQ.Rat -> RQ.Rat := RQ.neg;
  \definition quotientNegationInvolutive:
    \forall (x: RQ.Rat) -> RQ.neg (RQ.neg x) = x := RQ.negInvolutive;
  \definition quotientNegatesInteger:
    \forall (n: RQ.IntegerCarrier) ->
      RQ.neg (RQ.ofInteger n) = RQ.ofInteger (RQ.integerNeg n) :=
    RQ.negOfInteger;
  \definition quotientMultiplication:
    RQ.Rat -> RQ.Rat -> RQ.Rat := RQ.mulRat;
  \definition quotientMultiplicationCommutative:
    \forall (x, y: RQ.Rat) ->
      RQ.mulRat x y = RQ.mulRat y x :=
    RQ.mulRatComm;
}

\module DedekindRealExamples {
  \import real.DedekindReal[] \as D;
  \import D.Cuts[].Def[] \as DO;
  \import D.Arithmetic[].Def[] \as DC;
  \import D.Arithmetic[].Prop[] \as DL;
  \import D.Field[].Def[] \as DF;
  \import real.AxiomaticReals[Carrier := D.Real] \as DAR;
  \import D.Cuts[].Prop[] \as DCL;
  \import D.Completeness[] \as DComplete;
  \definition orderReflexive:
    \forall (x: D.Real) -> D.Le x x := D.leRefl;
  \definition additionAssociative:
    \forall (x, y, z: D.Real) ->
      DC.add (DC.add x y) z = DC.add x (DC.add y z) := DL.addAssoc;
  \definition additionInverse:
    \forall (x: D.Real) -> DC.add (DC.neg x) x = DC.zero := DL.addNegLeft;
  \definition rationalAddition:
    \forall (a, b: D.Rat) ->
      DC.add (DC.ofRat a) (DC.ofRat b) = DC.ofRat (D.addRat a b) :=
    DL.ofRatAdd;
  \definition rationalStrictOrder:
    \forall (a, b: D.Rat) -> D.lt a b -> D.Lt (DC.ofRat a) (DC.ofRat b) :=
    DL.ltOfRat;
  \definition additiveGroup: DL.CommutativeGroup :=
    DL.additiveCommutativeGroup;
  \definition multiplicationCommutative:
    \forall (x, y: D.Real) -> DC.mul x y = DC.mul y x := DL.mulComm;
  \definition multiplicationIdentity:
    \forall (x: D.Real) -> DC.mul DC.one x = x := DL.mulOneLeft;
  \definition multiplicationZero:
    \forall (x: D.Real) -> DC.mul DC.zero x = DC.zero := DL.mulZeroLeft;
  \definition inverse: D.Real -> D.Real := DC.inv;
  \definition inverseClosure:
    \forall (x: D.Real) ->
      \In[\Pow D.Rat] D.CutSet (DO.InvLower x) :=
    DCL.invCut;
  \definition lowerCompleteness:
    \forall (S: \Pow D.Real) -> DComplete.Nonempty S ->
      DComplete.BoundedBelow S ->
      \exists { l : D.Real \where DComplete.GreatestLowerBound S l } :=
    DComplete.completeBelow;
}

\module CauchyRealExamples {
  \import real.CauchyReal[] \as C;
  \import C.Completeness[] \as CComplete;
  \import C.Order[] \as COrder;
  \import C.Quotient[] \as CQ;
  \import CQ.Arithmetic[].Def[] \as CR;
\import CQ.Arithmetic[].Prop[] \as CRProp;
  \definition closenessSymmetry:
    \forall (x, y, eps: C.Rat) ->
      C.Close x y eps -> C.Close y x eps :=
    C.closeSym;
  \definition sequenceEquivalenceSymmetry:
    \forall (x, y: C.CauchySeq::[Set]) ->
      C.Equivalent x y -> C.Equivalent y x :=
    C.equivalentSym;
  \definition sequenceEquivalenceTransitivity:
    \forall (x, y, z: C.CauchySeq::[Set]) ->
      C.Equivalent x y -> C.Equivalent y z -> C.Equivalent x z :=
    C.equivalentTrans;
  \definition additionAssociative:
    \forall (x, y, z: CQ.Real) ->
      CR.add (CR.add x y) z = CR.add x (CR.add y z) :=
    CRProp.addAssoc;
  \definition additionInverse:
    \forall (x: CQ.Real) -> CR.add (CR.neg x) x = CR.zero :=
    CRProp.addNegLeft;
  \definition negationInvolutive:
    \forall (x: CQ.Real) -> CR.neg (CR.neg x) = x :=
    CRProp.negInvolutive;
  \import real.AxiomaticReals[Carrier := CQ.Real] \as CAR;
  \definition completeness: CAR.Completeness COrder.raw :=
    CComplete.completeness;
  \definition axiomaticReal: CAR.AxiomaticRealStructure::[Set] :=
    CComplete.axiomaticReal;
}

\module QuotientExamples(A: \Set, x, y: A, xy: x = y) {
  \import std.Logic[].Equality[].Prop[A := A] \as E;
  \import std.Set[].Quotient[
    A := A, Equivalent := (\fun (a, b: A) => a = b),
    equivalentRefl := (\fun (a: A) => \refl(a)), equivalentSym := E.sym, equivalentTrans := E.trans
  ] \as Q;
  \definition equalClasses: Q.ClassOf x = Q.ClassOf y := Q.classOfEq x y xy;
  \definition extensionality: \forall (a, b: Q.Carrier) ->
    (\forall (z: A) -> Q.mem a z -> Q.mem b z) -> (\forall (z: A) -> Q.mem b z -> Q.mem a z) -> a = b := Q.eqByExt;
  \definition identityRespects: Q.UnaryRespects (\fun (a: A) => a) :=
    \fun (a, b: A) => \fun (ab: a = b) => ab;
  \definition identityImageClosed:
    \forall (a: Q.Carrier) -> Q.IsClass (Q.UnaryImage (\fun (z: A) => z) a) :=
    Q.unaryImageClosed (\fun (z: A) => z) identityRespects;
}
\module TopologyExamples {
  \import std.Data[].Nat[] \as N;
  \import std.Data[].Nat[].Basic[].Def[] \as NatOp;
  \import std.Data[].Nat[].Pair[].Def[] \as NatPairDef;
  \import std.Data[].Nat[].Division[].Def[] \as NatDivisionDef;
  \import std.Data[].Nat[].Gcd[].Def[] \as NG;
  \import std.Data[].Nat[].Parity[].Def[] \as NP;
  \import topology.Topology[Carrier := N.Nat^] \as T;
  \import T.Presentations[] \as TP;
  \import topology.Continuity[A := N.Nat^, B := N.Nat^] \as C;
  \import topology.Product[A := N.Nat^, B := N.Nat^] \as P;
  \import P.Universal[X := N.Nat^] \as PU;
  \import T.Subspace[S := T.Singleton N.Nat^::zero] \as S;
  \import S.Maps[B := N.Nat^] \as SM;
  \import topology.Continuity[A := S.CarrierSet, B := N.Nat^] \as SC;
  \import T.SingletonSpace[point := N.Nat^::zero] \as One;

  \definition product: P.ProductTopology :=
    P.topology (#openSets{(T.Topology::[raw] T.Discrete)}) (#openSets{(T.Topology::[raw] T.Indiscrete)});
  \definition subspace: S.SubspaceTopology := S.topology T.Discrete;
  \definition onePoint: One.PointTopology := One.topology;
  \definition discreteOpen: T.IsOpenIn T.Discrete (T.Singleton N.Nat^::zero) :=
    T.discreteOpen (T.Singleton N.Nat^::zero);
  \definition closure: TP.SetOperator := TP.ClosureOf T.Discrete;
  \definition interior: TP.SetOperator := TP.InteriorOf T.Discrete;
  \definition neighborhoods: TP.NeighborhoodAssignment :=
    TP.NeighborhoodsOf T.Discrete;
  \definition identityContinuous:
    C.Continuous (#openSets{(T.Topology::[raw] T.Discrete)})
      (#openSets{(T.Topology::[raw] T.Discrete)}) (\fun (x: N.Nat^) => x) :=
    \fun (U: \Pow N.Nat^) =>
      \fun (_: \In[\Pow N.Nat^] (#openSets{(T.Topology::[raw] T.Discrete)}) U) =>
        T.discreteOpen (C.Preimage (\fun (x: N.Nat^) => x) U);
  \definition composedIdentityContinuous:
    C.Continuous (#openSets{(T.Topology::[raw] T.Discrete)})
      (#openSets{(T.Topology::[raw] T.Discrete)})
      (C.compose N.Nat^ (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)) :=
    C.composeContinuous N.Nat^
      (#openSets{(T.Topology::[raw] T.Discrete)})
      (#openSets{(T.Topology::[raw] T.Discrete)})
      (#openSets{(T.Topology::[raw] T.Discrete)})
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)
      identityContinuous identityContinuous;
  \definition restrictedIdentityContinuous:
    SC.Continuous (S.openSets T.Discrete)
      (#openSets{(T.Topology::[raw] T.Discrete)})
      (\fun (x: S.CarrierSet) => x) :=
    SM.restrictContinuous T.Discrete
      (#openSets{(T.Topology::[raw] T.Discrete)})
      (\fun (x: N.Nat^) => x) identityContinuous;
  \definition pairContinuous:
    PU.PairContinuous PU.discreteSource
      (#openSets{(T.Topology::[raw] T.Discrete)}) (#openSets{(T.Topology::[raw] T.Discrete)})
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x) :=
    PU.pairContinuous PU.discreteSource
      (#openSets{(T.Topology::[raw] T.Discrete)}) (#openSets{(T.Topology::[raw] T.Discrete)})
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)
      (\fun (U: \Pow N.Nat^) =>
        \fun (_: \In[\Pow N.Nat^] (#openSets{(T.Topology::[raw] T.Discrete)}) U) =>
          PU.discreteSourceOpen (PU.LeftPreimage (\fun (x: N.Nat^) => x) U))
      (\fun (V: \Pow N.Nat^) =>
        \fun (_: \In[\Pow N.Nat^] (#openSets{(T.Topology::[raw] T.Discrete)}) V) =>
          PU.discreteSourceOpen (PU.RightPreimage (\fun (x: N.Nat^) => x) V));
  \definition pairFirstContinuous:
    PU.LeftContinuous PU.discreteSource
      (#openSets{(T.Topology::[raw] T.Discrete)}) (\fun (x: N.Nat^) => x) :=
    #left{(#ltr{(PU.universal PU.discreteSource
      (#openSets{(T.Topology::[raw] T.Discrete)}) (#openSets{(T.Topology::[raw] T.Discrete)})
      (\fun (x: N.Nat^) => x) (\fun (x: N.Nat^) => x)
      (T.discreteOpen PU.WholeLeft) (T.discreteOpen PU.WholeRight))}
      pairContinuous)};
}

\module BijectionExamples(A: \Set) {
  \import std.Data[].Bijection[A := A, B := A] \as B;
  \import std.Logic[].Equality[] \as Equality;
  \use Equality.sym;

  \definition compose(first, second: B.Bijection::[Set]): B.Bijection::[Set] :=
    B.Bijection {
      forward := \fun (x: A) => #forward{second} (#forward{first} x),
      backward := \fun (x: A) => #backward{first} (#backward{second} x),
    } \with {
      leftInverse := \fun (x: A) =>
        \idelim #forward{first} x = #backward{second} (#forward{second} (#forward{first} x))
          \with y: A => #backward{first} y = x
          \by { base: #leftInverse{first} x, equality: sym!{A} _ _ (#leftInverse{second} (#forward{first} x)) },
      rightInverse := \fun (x: A) =>
        \idelim #backward{second} x = #forward{first} (#backward{first} (#backward{second} x))
          \with y: A => #forward{second} y = x
          \by { base: #rightInverse{second} x, equality: sym!{A} _ _ (#rightInverse{first} (#backward{second} x)) },
    };
}

\module MetricExamples(Carrier: \Set) {
  \import topology.MetricSpace[Carrier := Carrier] \as M;
  \import M.Topology[] \as MT;
  \import topology.Topology[Carrier := Carrier] \as T;

  \definition induced(metric: M.Metric::[Set]): T.Topology::[Set] :=
    MT.topology metric;

  \definition openBall(metric: M.Metric::[Set]) (x: Carrier) (radius: M.DistanceValue):
    T.IsOpenIn (induced metric) (M.Ball metric x radius) :=
    MT.ballOpenIn metric x radius;

  \definition intersectionOfBalls(metric: M.Metric::[Set])
    (x, y: Carrier) (r, s: M.DistanceValue):
    T.IsOpenIn (induced metric) (T.Intersection (M.Ball metric x r) (M.Ball metric y s)) :=
    #intersectionOpen{(induced metric)} (M.Ball metric x r) (M.Ball metric y s)
      (openBall metric x r) (openBall metric y s);
}

\module PresentationExamples(Carrier: \Set) {
  \import topology.Topology[Carrier := Carrier] \as T;
  \import T.Presentations[] \as P;

  \definition identityClosure: P.ClosureOperator::[Set] :=
    P.ClosureOperator { apply := \fun (S: \Pow Carrier) => S } \with {
      empty := \refl(T.Empty),
      extensive := \fun (S: \Pow Carrier) (x: Carrier) (member: T.Member S x) => member,
      union := \fun (S, U: \Pow Carrier) => \refl(P.BinaryUnion S U),
      idempotent := \fun (S: \Pow Carrier) => \refl(S),
    };

  \definition arbitraryIntersection(system: P.ClosedSetSystem::[Set])
    (family: \Pow (\Pow Carrier))
    (closed: \forall (F: \Pow Carrier) -> T.FamilyMember family F -> P.IsClosedBy system F):
    P.IsClosedBy system (P.ArbitraryIntersection family) :=
    #intersectionClosed{system} family closed;
}
