\import complex.Complex[] \as C;
\import C.Def[] \as D;
\import C.Prop[] \as Laws;
\import C.Algebra[] \as Algebra;
\import real.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as Real;
\import R.Arithmetic[].Prop[] \as RealLaws;
\import std.Alg[].Field[] \as Field;
\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.congr2;
\use Equality.trans;

\definition onePlusI: C.Complex := C.make Real.one Real.one;
\definition two: C.Real := Real.add Real.one Real.one;
\definition sumOneI: D.add D.one D.i = onePlusI :=
  Laws.makeCong _ _ _ _ (RealLaws.addZeroRight Real.one) (RealLaws.addZeroLeft Real.one);
\definition squareOnePlusI: D.mul onePlusI onePlusI = C.make Real.zero two :=
  Laws.makeCong _ _ _ _ (RealLaws.subSelf (RealLaws.fieldMul Real.one Real.one))
    (congr2!{C.Real C.Real C.Real} Real.add _ _ _ _
      (RealLaws.fieldMulOneLeft Real.one) (RealLaws.fieldMulOneLeft Real.one));
\definition normOnePlusI: D.normSq onePlusI = two :=
  congr2!{C.Real C.Real C.Real} Real.add _ _ _ _
    (RealLaws.fieldMulOneLeft Real.one) (RealLaws.fieldMulOneLeft Real.one);
\definition productWithConjugate: D.mul onePlusI (D.conj onePlusI) = D.ofReal two :=
  trans!{C.Complex} _ _ _ (Laws.mulConjSelf onePlusI)
    (congr!{C.Real C.Complex} D.ofReal _ _ normOnePlusI);
\definition imaginarySquare: D.mul D.i D.i = D.neg D.one := Laws.iSquared;
\definition imaginaryQuotient: D.div D.i D.i = D.one := Laws.divSelf D.i Laws.iNonzero;
\definition zeroInverse: D.inv D.zero = D.zero := Laws.invZero;
\definition divisionByZero: D.div onePlusI D.zero = D.zero := Laws.divZeroRight onePlusI;

\definition field: Field.Field[C.Complex] := Algebra.field;
\definition ring: Ring.CommutativeRing[C.Complex] := Field.fieldAsCommutativeRing C.Complex field;
\definition fieldInverseI: D.mul (D.inv D.i) D.i = D.one := #inverse{field} D.i Laws.iNonzero;
\definition ringCommutes: D.mul onePlusI D.i = D.mul D.i onePlusI := #mulCommutative{ring} onePlusI D.i;
