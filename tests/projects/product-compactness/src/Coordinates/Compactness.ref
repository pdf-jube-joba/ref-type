\import topology.Product[A := I, B := K] \as Product;
\import Product.Compactness[] \as Products;
\import topology.Topology[Carrier := Product.CarrierSet] \as ProductSpace;
\definition productCompact: \forall (left: Space.Topology) (right: Scalars.Topology) ->
  Space.IsCompact left -> Scalars.IsCompact right -> ProductSpace.IsCompact (Product.topology left right) :=
  \fun (left: _) (right: _) (lc: _) (rc: _) => Products.productCompact left right lc rc;
\definition productCompactIn: \forall (left: Space.Topology) (right: Scalars.Topology) (S: \Pow I) (T: \Pow K) ->
  Space.IsCompactIn left S -> Scalars.IsCompactIn right T ->
  ProductSpace.IsCompactIn (Product.topology left right) (Product.Rectangle S T) :=
  \fun (left: _) (right: _) (S: _) (T: _) (lc: _) (rc: _) => Products.productCompactIn left right S T lc rc;
