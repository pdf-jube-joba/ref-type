\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := R.Real, field := Algebra.field] \as Spaces;
\import Local.CoordinateBasis[] \as Words;
\import Words.At[k := k] \as Coefficients;
\import Coefficients.Differential[] \as Differential;
\import Local.ExteriorDerivative[k := k] \as D;
\import Local.At[k := N.Nat^::succ k] \as Target;
\definition Tuple: \Set := Fin.Fin k -> Fin.Fin n;
\definition enumerationExists: \exists Coefficients.Enumeration := Coefficients.existsEnumeration;
\definition reconstruction: \forall (omega: Local.Form k)(enumeration: Coefficients.Enumeration) ->
  Coefficients.assemble enumeration (Local.coefficient k omega) = omega := Coefficients.reconstruction;
\import Spaces.Sums[I := Tuple].Vector[V := Local.Form (N.Nat^::succ k), space := Target.space] \as Terms;
\import Spaces.Sums[I := Fin.Fin n].Vector[V := Local.Form (N.Nat^::succ k), space := Target.space] \as CoordinateSums;
\definition exteriorDerivativeFormula: \forall (omega: Local.Form k)(enumeration: Coefficients.Enumeration) ->
  D.apply omega = CoordinateSums.sum (Fin.elements n) (\fun (j: Fin.Fin n) => Terms.sum enumeration (Differential.contribution j omega)) :=
  Differential.formula;
\import Spaces.FiniteCoordinates[n := n].Exterior[] \as PointWords;
\definition basisClosed: \forall (indices: Tuple) -> D.apply (Words.word k indices) = Target.zero :=
  \fun (indices: Tuple) => D.constant (PointWords.word k indices);
