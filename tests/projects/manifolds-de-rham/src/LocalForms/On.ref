\import Forms.On[U := U] \as Local;
\import Forms.Identity[U := U] \as Identity;
\import calculus.Identity[n := n] \as Maps;
\import Forms.Pullback[m := n, U := U, V := U, f := Maps.map U] \as Pullback;
\definition identity: \forall (k: N.Nat^)(omega: Local.Form k) -> Pullback.apply k omega = omega := Identity.law;
\module Degree(k: N.Nat^) {
  \import Local.ExteriorDerivative[k := k] \as D;
  \import Local.ExteriorDerivative[k := N.Nat^::succ k] \as Next;
  \import Local.At[k := N.Nat^::succ (N.Nat^::succ k)] \as Result;
  \definition squareZero: \forall (omega: Local.Form k) -> Next.apply (D.apply omega) = Result.zero := Local.Square[k := k].law;
}
\definition pullbackFunctionDifferential: \forall (omega: Local.Form N.Nat^::zero) ->
  Local.ExteriorDerivative[k := N.Nat^::zero].apply (Pullback.apply N.Nat^::zero omega) =
    Pullback.apply (N.Nat^::succ N.Nat^::zero) (Local.ExteriorDerivative[k := N.Nat^::zero].apply omega) := Pullback.DegreeZero[].law;
\import Local.DeRham[].DegreeZero[] \as HZero;
\definition flatFunctions: \Set := HZero.Function;
\definition flatFunctionSpace: linear_algebra.Field[].Space[K := R.Real, field := real.Analysis[].Algebra[].field].VectorSpace flatFunctions := HZero.vectorSpace;
\definition recoverFunction: \forall (f: flatFunctions) -> #apply{HZero.backward} (#apply{HZero.forward} f) = f := #leftInverse{HZero.isomorphism};
\module CoefficientExpression(k: N.Nat^);
