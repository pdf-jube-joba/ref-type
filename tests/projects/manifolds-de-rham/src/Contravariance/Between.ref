\import std.Data[].Nat[] \as Naturals;
\import manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as First;
\import manifolds.SmoothMap[n := m, m := l].Between[M := N, N := P] \as Second;
\import manifolds.Composition[n := n, m := m, l := l].Between[M := M, N := N, P := P] \as Composition;
\import differential_forms.Forms[n := l].On[M := P] \as TargetForms;
\module At(k: Naturals.Nat^) {
  \definition forms: \forall (f: First.Map)(g: Second.Map)(omega: TargetForms.Form k) ->
    differential_forms.Pullback[n := n, m := l].Between[M := M, N := P].Of[f := Composition.compose f g].At[k := k].apply omega =
    differential_forms.Pullback[n := n, m := m].Between[M := M, N := N].Of[f := f].At[k := k].apply
      (differential_forms.Pullback[n := m, m := l].Between[M := N, N := P].Of[f := g].At[k := k].apply omega) :=
        \fun (f: First.Map)(g: Second.Map) => differential_forms.PullbackComposition[n := n, m := m, l := l].Between[M := M, N := N, P := P].Of[f := f, g := g].At[k := k].law;
  \definition cohomology: \forall (f: First.Map)(g: Second.Map)(h: TargetForms.DeRham[].Cohomology k) ->
    differential_forms.Pullback[n := n, m := l].Between[M := M, N := P].Of[f := Composition.compose f g].DeRham[].At[k := k].apply h =
    differential_forms.Pullback[n := n, m := m].Between[M := M, N := N].Of[f := f].DeRham[].At[k := k].apply
      (differential_forms.Pullback[n := m, m := l].Between[M := N, N := P].Of[f := g].DeRham[].At[k := k].apply h) :=
        \fun (f: First.Map)(g: Second.Map) => differential_forms.PullbackComposition[n := n, m := m, l := l].Between[M := M, N := N, P := P].Of[f := f, g := g].At[k := k].cohomologyLaw;
}
