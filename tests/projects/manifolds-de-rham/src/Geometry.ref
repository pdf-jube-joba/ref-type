\import std.Data[].Nat[] \as N;
\import topological_algebra.Euclidean[].Zero[] \as Zero;
\import manifolds.Examples[].Point[] \as Point;
\import manifolds.Dimension[n := N.Nat^::zero].Topological[] \as ZeroManifolds;
\definition pointManifold: ZeroManifolds.Manifold := Point.manifold;
\definition pointUnique: \forall (x, y: Zero.Point) -> x = y := Zero.unique;
\definition two: N.Nat^ := N.Nat^::succ (N.Nat^::succ N.Nat^::zero);
\import manifolds.Dimension[n := two] \as Plane;
\import Plane.Examples[].Empty[] \as Empty;
\import Plane.Topological[] \as PlaneManifolds;
\definition emptyManifold: PlaneManifolds.Manifold := Empty.manifold;
\definition emptyPoints: \forall (x: Empty.Point) -> std.Logic[].Proposition[].False := Empty.impossible;
\import Plane.Examples[].Euclidean[] \as Standard;
\import topological_algebra.Euclidean[].Dimension[n := two] \as Coordinates;
\import Coordinates.Topology[] \as Euclidean;
\import Plane.Chart[M := Coordinates.Point, space := Euclidean.topology] \as Charts;
\import Plane.Atlas[M := Coordinates.Point, space := Euclidean.topology] \as Atlases;
\definition planeAtlas: Atlases.Atlas := Standard.atlas;
\definition identityTransition: Atlases.Compatible Standard.standard Standard.standard := Standard.standardCompatible;
\definition standardInSaturation: \In[Charts.Chart] (Atlases.Saturation planeAtlas) Standard.standard :=
  Atlases.includedInSaturation planeAtlas Standard.standard (\refl(Standard.standard));
\import Charts.Transition[left := Standard.standard, right := Standard.standard] \as Transition;
\definition transitionIdentity: \forall (x: calculus.Real[].Multivariable[n := two].Open[].Carrier Transition.domain) -> Transition.vector x = x :=
  \fun (x: _) => \refl(x);

\definition euclideanManifold: PlaneManifolds.Manifold := Standard.manifold;
\import manifolds.Dimension[n := two].Smooth[] \as Smooth;
\definition smoothPlane: Smooth.Manifold := Standard.smoothManifold;
\definition smoothEmpty: Smooth.Manifold := Empty.smoothManifold;
\import manifolds.SelfMap[n := two].Identity[M := Standard.smoothManifold] \as PlaneIdentity;
\import manifolds.SmoothMap[n := two, m := two].Between[M := Standard.smoothManifold, N := Standard.smoothManifold] \as PlaneSelfMaps;
\definition smoothPlaneIdentity: PlaneSelfMaps.Map := PlaneIdentity.map;
\import manifolds.SelfMap[n := two].Identity[M := Empty.smoothManifold] \as EmptyIdentity;
\import manifolds.SmoothMap[n := two, m := two].Between[M := Empty.smoothManifold, N := Empty.smoothManifold] \as EmptySelfMaps;
\definition smoothEmptyIdentity: EmptySelfMaps.Map := EmptyIdentity.map;
\import Atlases.Saturate[atlas := planeAtlas] \as Saturated;
\definition maximalAtlas: Atlases.MaximalAtlas := Atlases.saturate planeAtlas;
\definition maximality: Atlases.IsMaximal Saturated.saturated := Saturated.maximal;
\module OpenSubspace(U: calculus.Real[].Multivariable[n := two].Open[].OpenSet) {
  \import Standard.Subspace[U := U] \as Local;
  \definition manifold: PlaneManifolds.Manifold := Local.manifold;
}
