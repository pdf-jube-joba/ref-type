\import \root.Calculus[] \as Functions;
\import calculus.Real[] \as C;
\import C.Derivative[].Def[] \as Derivative;
\import C.Derivative[].Prop[] \as Derivatives;
\import C.MeanValue[].Interval[a := C.zero, b := C.one] \as Interval;
\import C.Limit[].Topology[].Subset[S := topology.RealLine[].ClosedInterval C.zero C.one] \as Closed;
\import real.Analysis[].Estimates[].Product[] \as Estimates;
\definition squareMeanValue: \exists { c: C.Real \where Interval.MeanValueResult[Functions.square, c] } :=
  Interval.meanValue Functions.square Estimates.onePositive (Closed.continuousOfGlobal Functions.square Functions.squareContinuous)
    (\fun (c: C.Real)(inside: _) => Derivatives.differentiableOfDerivative Functions.square c (C.add c c) (Functions.squareDerivative c));
\definition constantRolle: \forall (value: C.Real) -> \exists { c: C.Real \where Interval.RolleResult[C.constant value, c] } :=
  \fun (value: _) => Interval.rolle (C.constant value) Estimates.onePositive
    (Closed.continuousOfGlobal (C.constant value) (C.Limit[].Prop[].constantLimit value))
    (\fun (c: C.Real)(inside: _) => Derivatives.differentiableOfDerivative (C.constant value) c C.zero (Derivatives.constantDerivative value c))
    (\refl(value));
