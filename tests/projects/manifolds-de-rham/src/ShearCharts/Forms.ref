\import differential_forms.Forms[n := two].On[M := Standard.smoothManifold] \as Global;
\definition standardChart: Global.Chart := \into[Charts.Chart](Standard.standard, #charts{Standard.smoothManifold.atlas}) \by {
  Atlases.includedInSaturation Standard.atlas Standard.standard (\refl(Standard.standard))
};
\definition shearChart: Global.Chart := \into[Charts.Chart](shear, #charts{Standard.smoothManifold.atlas}) \by { shearInMaximal };
\import Global.Pair[left := standardChart, right := shearChart] \as Transition;
\definition coordinateChange: \forall (omega: Global.Form k) -> Transition.restrict k omega = Transition.transport k omega :=
  \fun (omega: Global.Form k) => (\bysub(Global.Family k,
    { family: Global.Family k \where Global.Compatible k family }, omega)) standardChart shearChart;
\definition differentialChange: \forall (omega: Global.Form k) ->
  Transition.restrict (std.Data[].Nat[].Nat^::succ k) (Global.ExteriorDerivative[k := k].apply omega) =
    Transition.transport (std.Data[].Nat[].Nat^::succ k) (Global.ExteriorDerivative[k := k].apply omega) :=
      \fun (omega: Global.Form k) => Transition.Differential[k := k].law omega (coordinateChange omega);
\import Global.Pointwise[k := k] \as Pointwise;
\definition standardCoordinates: \forall (omega: Global.Form k) -> Pointwise.Coordinates[chart := standardChart].family (Pointwise.value omega) = omega standardChart :=
  Pointwise.Coordinates[chart := standardChart].recover;
\definition shearCoordinates: \forall (omega: Global.Form k) -> Pointwise.Coordinates[chart := shearChart].family (Pointwise.value omega) = omega shearChart :=
  Pointwise.Coordinates[chart := shearChart].recover;
