\import category.Constructions[] \as Concrete;
\import category.Functor[] \as Functors;
\import category.Universal[] \as Universal;
\import category.Limits[] \as Limits;

\definition u: Concrete.Unit := Concrete.Unit::unit;
\definition unitEquality: \forall (p: Concrete.Unit) -> u = p :=
  \induction (p: Concrete.Unit) \return u = p \with {
    | unit : \refl(u)
  };

\import Universal.Object[C := Concrete.terminal] \as Objects;
\definition initial: Objects.Initial := Objects.Initial {
  vertex := u,
  arrow := \fun (v: Concrete.Unit) => u,
  unique := \fun (v: Concrete.Unit) (f: Concrete.Unit) => Concrete.unitUnique f,
};
\definition terminal: Objects.Terminal := Objects.Terminal {
  vertex := u,
  arrow := \fun (v: Concrete.Unit) => u,
  unique := \fun (v: Concrete.Unit) (f: Concrete.Unit) => Concrete.unitUnique f,
};

\definition identity: Functors.Functor Concrete.terminal Concrete.terminal := Functors.identity Concrete.terminal;
\import Limits.Diagram[J := Concrete.terminal, C := Concrete.terminal, F := identity] \as Diagram;

\definition cone: Diagram.Cone := Diagram.Cone {
  vertex := u,
  leg := \fun (i: Concrete.Unit) => u,
  commutes := \fun (i, j, f: Concrete.Unit) => \refl(u),
};
\definition cocone: Diagram.Cocone := Diagram.Cocone {
  vertex := u,
  leg := \fun (i: Concrete.Unit) => u,
  commutes := \fun (i, j, f: Concrete.Unit) => \refl(u),
};
\definition limit: Diagram.Limit := Diagram.Limit {
  cone := cone,
  lift := \fun (t: Diagram.Cone) => u,
  factorization := \fun (t: Diagram.Cone) (i: Concrete.Unit) => unitEquality (t.leg i),
  unique := \fun (t: Diagram.Cone) (f: Concrete.Unit) (commutes: _) => Concrete.unitUnique f,
};
\definition colimit: Diagram.Colimit := Diagram.Colimit {
  cocone := cocone,
  descend := \fun (t: Diagram.Cocone) => u,
  factorization := \fun (t: Diagram.Cocone) (i: Concrete.Unit) => unitEquality (t.leg i),
  unique := \fun (t: Diagram.Cocone) (f: Concrete.Unit) (commutes: _) => Concrete.unitUnique f,
};
\definition limitIdentity: limit.lift limit.cone = u := \refl(u);
\definition colimitIdentity: colimit.descend colimit.cocone = u := \refl(u);
