\import std.Data[].Nat[] \as N;
\import algebraic_topology.Euclidean[] \as Euclidean;
\definition disk(n: N.Nat^): \Set := algebraic_topology.Euclidean[].Dimension[n := n].Disk;
\definition diskAsFunction(n: N.Nat^) (x: disk n): Euclidean.Disk n := x;
\structure Cell: \Set {
  dimension: N.Nat^,
  point: Euclidean.Dimension[n := dimension].Disk,
}
\definition point(cell: Cell): Euclidean.Dimension[n := cell.dimension].Disk := cell.point;
\definition pointAsFunction(cell: Cell): Euclidean.Disk cell.dimension := cell.point;
