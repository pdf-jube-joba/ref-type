\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import topological_algebra.Complex[] \as Complex;
\import complex.Complex[].Def[] \as Operations;
\import topology.Topology[Carrier := Complex.Carrier] \as Source;
\import topology.Maps[A := Complex.Carrier, B := Complex.Carrier] \as Maps;
\import Maps.Identity[] \as Identity;
\import Complex.Functions[A := Complex.Carrier] \as Functions;
\definition Index: \Set := Fin.Fin (N.Nat^::succ (N.Nat^::succ N.Nat^::zero));
\import topological_algebra.Matrix[K := Complex.Carrier, I := Index, J := Index] \as Matrix;
\import Matrix.Universal[A := Complex.Carrier] \as Into;
\import topology.Continuity[A := Complex.Carrier, B := Matrix.Carrier] \as MatrixMaps;
\definition conjugateMatrix(z: Complex.Carrier): Matrix.Carrier := \fun (i, j: Index) => Operations.conj z;
\definition conjugateMatrixContinuous: MatrixMaps.Continuous Complex.topology (Matrix.topology Complex.topology) conjugateMatrix :=
  Into.continuous Complex.topology Complex.topology conjugateMatrix (\fun (i, j: Index) =>
    Functions.conjugateContinuous Complex.topology (\fun (z: Complex.Carrier) => z) (Identity.continuous Complex.topology));
\import Complex.Ring[] \as ComplexRing;
\import topological_algebra.Real[] \as Real;
\import topological_algebra.Topology[K := Complex.Carrier] \as ComplexStructures;
\import real.Analysis[] \as Scalars;
\import topological_algebra.Topology[K := Scalars.Real] \as RealStructures;
\definition realRing: RealStructures.TopologicalRing := Real.topologicalRing;
\definition complexRing: ComplexStructures.TopologicalRing := ComplexRing.topologicalRing;
\definition normSquaredMatrix(z: Complex.Carrier): Matrix.Carrier := \fun (i, j: Index) => Operations.mul z (Operations.conj z);
\definition normSquaredMatrixContinuous: MatrixMaps.Continuous Complex.topology (Matrix.topology Complex.topology) normSquaredMatrix :=
  Into.continuous Complex.topology Complex.topology normSquaredMatrix (\fun (i, j: Index) =>
    Functions.multiplicationContinuous Complex.topology (\fun (z: Complex.Carrier) => z) (\fun (z: Complex.Carrier) => Operations.conj z)
      (Identity.continuous Complex.topology)
      (Functions.conjugateContinuous Complex.topology (\fun (z: Complex.Carrier) => z) (Identity.continuous Complex.topology)));
