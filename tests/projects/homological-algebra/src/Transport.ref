\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\module Family(I: \Set, F: I -> \Set) {
  \import std.Set[].Transport[I := I] \as Regrade;
  \definition restore: \forall (a, b: I)(same: a = b)(x: F a) ->
    Regrade.cast F b a (sym!{I} a b same) (Regrade.cast F a b same x) = x := Regrade.castInverse F;
  \module Map(G: I -> \Set, f: \forall (i: I) -> F i -> G i) {
    \definition natural: \forall (a, b: I)(same: a = b)(x: F a) ->
      Regrade.cast G a b same (f a x) = f b (Regrade.cast F a b same x) := Regrade.natural F G f;
  }
}
