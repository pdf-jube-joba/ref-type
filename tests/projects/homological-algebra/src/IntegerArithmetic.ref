\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].ExtendedEuclid[] \as Euclid;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition three: N.Nat^ := N.Nat^::succ two;
\definition six: N.Nat^ := Nat.mul two three;
\definition eighteen: N.Nat^ := Nat.mul three six;
\definition thirty: N.Nat^ := Nat.mul (N.Nat^::succ (N.Nat^::succ three)) six;
\definition gcd: Euclid.left (Euclid.result thirty eighteen) = six := \refl(six);
\definition first: Euclid.first (Euclid.result thirty eighteen) = I.Int^::negSucc zero := \refl(I.Int^::negSucc zero);
\definition second: Euclid.second (Euclid.result thirty eighteen) = I.Int^::ofNat two := \refl(I.Int^::ofNat two);
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import N.Gcd[].Def[] \as Gcd;
\definition certified: Arithmetic.add (Arithmetic.mul (Euclid.first (Euclid.result thirty eighteen)) (Euclid.natural thirty))
  (Arithmetic.mul (Euclid.second (Euclid.result thirty eighteen)) (Euclid.natural eighteen)) = Euclid.natural (Gcd.gcd thirty eighteen) := Euclid.bezout thirty eighteen;
\definition program: Euclid.Euclid.program^ thirty eighteen = Euclid.result thirty eighteen := Euclid.EuclidImplementation[].matches thirty eighteen;
\import Euclid.Signed[] \as Signed;
\definition negativeThirty: I.Int^ := Arithmetic.neg (I.Int^::ofNat thirty);
\definition signedGcd: Signed.divisor (Signed.certificate negativeThirty (I.Int^::ofNat eighteen)) = six := \refl(six);
\definition signedFirst: Signed.firstCoefficient (Signed.certificate negativeThirty (I.Int^::ofNat eighteen)) = I.Int^::ofNat one := \refl(I.Int^::ofNat one);
\definition signedSecond: Signed.secondCoefficient (Signed.certificate negativeThirty (I.Int^::ofNat eighteen)) = I.Int^::ofNat two := \refl(I.Int^::ofNat two);
\definition signedCertificate: Signed.Laws[negativeThirty, I.Int^::ofNat eighteen, Signed.certificate negativeThirty (I.Int^::ofNat eighteen)] :=
  Signed.correctness negativeThirty (I.Int^::ofNat eighteen);
\definition signedProgram: Signed.Euclid.program^ negativeThirty (I.Int^::ofNat eighteen) = Signed.certificate negativeThirty (I.Int^::ofNat eighteen) :=
  Signed.Implementation[].matches negativeThirty (I.Int^::ofNat eighteen);
\import Signed.Division[] \as Division;
\definition negativeQuotient: Division.Quotient.program^ negativeThirty (I.Int^::ofNat eighteen) = I.Int^::negSucc zero := \refl(I.Int^::negSucc zero);
\definition negativeRemainder: Division.Remainder.program^ negativeThirty (I.Int^::ofNat eighteen) = Arithmetic.neg (I.Int^::ofNat (Nat.add six six)) := \refl(Arithmetic.neg (I.Int^::ofNat (Nat.add six six)));
\definition decreasing: std.Data[].Nat[].Basic[].Prop[].Lt (Signed.absolute (Division.remainder negativeThirty (I.Int^::ofNat eighteen))) eighteen := \refl(std.Data[].Bool[].Bool^::true);
