/* List is Set-valued and must not accept a Compute type as its element type. */
\module ReflectedListRejectsComputeElements {
  \inductive Nat: \Type :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \inductive List(A: \Set): \Set :=
  | nil: List;
  | cons: A -> List -> List;
  ;

  \definition bad: \Set := List[Nat];
}
