\module RunCaseWrongInvariant(
  A: \VType, B: \VType,
  step: \U(\CFun(A, \F(\RunStep(A, B)))),
  initial: A,
  output: B,
  termination: \Acc(A, B, step, \RfTerm(A, initial))
) {
  \definition bad: \F(B) :=
    \runCase(
      A,
      B,
      step,
      initial,
      \capp(\force(step), initial),
      termination,
      \refl(\RfTerm(
        \F(\RunStep(A, B)),
        \return(\finish(A, B, output)))));
}
