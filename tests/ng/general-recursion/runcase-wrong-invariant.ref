\module RunCaseWrongInvariant(
  A: \Set, B: \Set,
  step: A -> \RunStep(A, B),
  initial: A,
  transition: \RunStep(A, B),
  termination: \Acc(A, B, step, initial)
) {
  \definition bad: B :=
    \runCase(A, B, step, initial, transition)
      \by (termination, \refl(transition));
}
