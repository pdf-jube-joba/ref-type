\module BoxPartialProgram(A: \VType, a: A) {
  \vdefinition step: \U(\CFun(A, \F(\PRunStep(A, A)))) :=
    \thunk(\clam(state, A, \return(\Pfinish(A, A, state))));

  \cdefinition partial: \F(A) := \Prun(A, A, step, a);

  \definition rejected: \U(A) := \Force(\F(A), \box(\F(A), partial));
}
/* expect-error: Program syntax cannot be elaborated as a Set/Prop expression */
