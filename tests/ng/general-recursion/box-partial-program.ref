\module BoxPartialProgram(A: \VType, a: A) {
  \definition step: \U((A ~> \F(\RunStep[A, A]))) :=
    \thunk((\cfun (state: A) => \return(\finish[A, A](state))));

  \definition partial: \F(A) := \run[A, A](step, a);

  \definition rejected: \U(A) := \squash[_](\box[_](partial));
}
