\module BoxPartialProgram(A: \VType, a: A) {
  \definition step: \U((A ~> \F(\PRunStep(A, A)))) :=
    \thunk((\cfun (state: A) => \return(\Pfinish(A, A, state))));

  \definition partial: \F(A) := \Prun(A, A, step, a);

  \definition rejected: \U(A) := \Force(\F(A), \box(\F(A), partial));
}
