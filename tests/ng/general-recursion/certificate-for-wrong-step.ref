\module CertificateForWrongStep(
  A: \Set, B: \Set,
  first: A -> \RunStep(A, B),
  second: A -> \RunStep(A, B),
  initial: A,
  termination: \Acc(A, B, first, initial)
) {
  \definition bad: B :=
    \run(A, B, second, initial) \by termination;
}
