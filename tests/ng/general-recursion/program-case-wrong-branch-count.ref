\module IncompleteProgramCase {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;
  \cdefinition bad: (Bit ~> \F(Bit)) :=
    (\cfun (x: Bit) => \case (x) \in Bit {
      | zero() => \return(Bit::zero);
      });
}
/* expect-error: Program case must have one ordered branch per constructor */
