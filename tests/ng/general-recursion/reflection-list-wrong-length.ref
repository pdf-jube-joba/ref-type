/* A Set-valued list of length five cannot inhabit the reflected length-six subset. */
\module ReflectedListWrongLength(Element: \Set, element: Element) {
  \inductive Nat: \Type :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \inductive List(A: \Set): \Set :=
  | nil: List;
  | cons: A -> List -> List;
  ;

  \definition length:
    (A: \Set) -> List[A] -> \RfType(Nat) :=
    (A: \Set) => (values: List[A]) =>
      \prec(\Set, List[A])
        ((current: List[A]) => \RfType(Nat))
        (\RfTerm(Nat, Nat#zero))
        ((head: A) =>
         (tail: List[A]) =>
         (tailLength: \RfType(Nat)) =>
          (\RfTerm(Nat -> Nat, Nat#succ)) tailLength)
        values;

  \definition one: Nat := Nat#succ Nat#zero;
  \definition two: Nat := Nat#succ one;
  \definition three: Nat := Nat#succ two;
  \definition four: Nat := Nat#succ three;
  \definition five: Nat := Nat#succ four;
  \definition six: Nat := Nat#succ five;

  \definition candidate: List[Element] :=
    List[Element]#cons element
      (List[Element]#cons element
        (List[Element]#cons element
          (List[Element]#cons element
            (List[Element]#cons element List[Element]#nil))));

  \definition LengthSixLists: \Power(List[Element]) :=
    \Subset(
      values,
      List[Element],
      length Element values = \RfTerm(Nat, six));

  \definition bad:
    \Pred(List[Element], LengthSixLists, candidate) :=
    \refl(length Element candidate);
}
