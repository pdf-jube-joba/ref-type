\module WrongRunCaseInvariant(
  A: \VType, step: \U((A ~> \F(\PRunStep(A, A)))), a: A,
  termination: \Acc(A^, A^, step^, a^)
) {
  \definition rejected: \F(A) :=
    \PrunCase(A, A, step, a, \return(\Pfinish(A, A, a)))
      \by (termination, \refl(\finish(A^, A^, a^)));
}
