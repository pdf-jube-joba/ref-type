\module TerminationWrongState(
  A: \Set, B: \Set,
  f: A -> \RunStep[A, B],
  b: B
) {
  \definition bad: \Prop := (\forall (P: A -> \Prop) ->
    (\forall (s: A) ->
      (\step-match t: \RunStep[A, B] \return \Prop \with {
        | \continue next: P next
        | \finish output: \forall (Q: \Prop) -> Q -> Q
      }) (f s) -> P s) -> P b);
}
