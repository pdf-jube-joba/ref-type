/* expect-error: Program value types do not unify */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \cdefinition Pair(A: \VType)::bad: Pair[A] ~> \F(Unit) := \cfun (p: Pair[A]) => \return p;
}
