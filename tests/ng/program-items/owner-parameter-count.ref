/* expect-error: Program associated item expects 1 owner parameter(s), found 0 */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \record Pair(A: \VType): \VType := { first: A, second: A };
  \definition Pair::value: Unit := Unit::unit;
}
