/* expect-error: associated item is not a Program computation */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \vdefinition Unit::value: Unit := Unit::unit; \cinfer Unit::value;
}
