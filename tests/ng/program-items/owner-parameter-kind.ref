/* expect-error: Program associated item parameters must have type \VType */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \vdefinition Pair(A: \Set)::value: Unit := Unit::unit;
}
