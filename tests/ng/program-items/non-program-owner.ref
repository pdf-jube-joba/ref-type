/* expect-error: Program associated item owner must be a Program type in this module */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \structure P: \Set := {}; \vdefinition P::value: Unit := Unit::unit;
}
