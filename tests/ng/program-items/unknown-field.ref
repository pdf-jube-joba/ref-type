/* expect-error: Unknown structure field third */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \record Pair(A: \VType): \VType := { first: A, second: A };
  \definition bad: Pair[Unit] := \record Pair[Unit] { first := Unit::unit, second := Unit::unit, third := Unit::unit };
}
