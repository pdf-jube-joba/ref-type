/* expect-error: Associated item 'Pair::first' is already defined */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \cdefinition Pair(A: \VType)::first: \F(Unit) := \return Unit::unit;
}
