/* expect-error: Structure field first was supplied more than once */
\module Bad {
  \inductive Unit: \VType := | unit: Unit; ;
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \vdefinition bad: Pair[Unit] := \record Pair[Unit] { first := Unit::unit, first := Unit::unit, second := Unit::unit };
}
