/* expect-error: Program computation returned a function value; use explicit \bind and \force before applying another argument */
\module ProgramImplicitBind {
  \inductive Bool: \VType := | false: Bool | true: Bool;
  \definition first: Bool -> Bool -> Bool :=
    \fun (x, y: Bool) => \return(x);
  \definition bad: \F(Bool) := first Bool::true Bool::false;
}
