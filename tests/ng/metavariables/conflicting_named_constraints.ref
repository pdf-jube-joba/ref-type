\module ConflictingNamedConstraints(
  A: \Set(0),
  B: \Set(0),
  a: A,
  b: B
) {
  \definition chooseLeft:
    \forall (X: \Set(0)) -> X -> X -> X :=
    \fun (X: \Set(0)) => \fun (left: X) => \fun (right: X) => left;

  /* ?2 would have to be both A and B. */
  \definition impossible: A := chooseLeft ?2 a b;
}
/* expect-error: incompatible rigid expressions in metavariable constraint */
