\module NamedGoalCapturesSiblingBinder(
  A: \Set(0),
  P: \Prop
) {
  /* The two ?9 occurrences share only the scope outside x and y. */
  \definition impossible:
    (((x: A) -> x = x) -> ((y: A) -> y = y) -> P) -> P :=
    (consume: ((x: A) -> x = x) -> ((y: A) -> y = y) -> P) =>
      consume
        ((x: A) => \refl(?9))
        ((y: A) => \refl(?9));
}
/* expect-error: solution for ?m0 captures a variable outside its shared context */
