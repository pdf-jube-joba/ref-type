\module NamedGoalCapturesSiblingBinder(
  A: \Set(0),
  P: \Prop
) {
  /* The two _9 occurrences share only the scope outside x and y. */
  \definition impossible:
    ((\forall (x: A) -> x = x) -> (\forall (y: A) -> y = y) -> P) -> P :=
    \fun (consume: (\forall (x: A) -> x = x) -> (\forall (y: A) -> y = y) -> P) =>
      consume
        (\fun (x: A) => \refl(_9))
        (\fun (y: A) => \refl(_9));
}
/* expect-error: solution for _9 captures a variable outside its shared context */
