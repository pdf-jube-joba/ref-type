/* expect-error: not convertible */
\module First {
  \inductive Token: \Set := | token: Token; ;
}
\module Second {
  \inductive Token: \Set := | token: Token; ;
}
\module Consumer {
  \import \root.First[] \as Left;
  \import \root.Second[] \as Right;
  \definition invalid: Right.Token := Left.Token::token;
}
