\module LaterMacro(A: \Set(0), x: A, y: A) {
    \definition first: A -> A -> A :=
        \fun (left: A) => \fun (right: A) => left;
    \macro too_early($left, $right) := $($left + $right $);
    \math-macro plus($left, \+, $right) := first $left $right;

    \definition invalid: A := too_early!{x y};
}
