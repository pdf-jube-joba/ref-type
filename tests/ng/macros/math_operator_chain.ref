\module MathChain(A: \Set(0), x: A, y: A) {
    \definition first: A -> A -> A :=
        (left: A) => (right: A) => left;
    \math-macro plus($left, \+, $right) := first $left $right;

    \definition invalid: A := $(x + y + x $);
}
