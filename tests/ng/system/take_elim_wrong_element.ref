\module WrongElement(
    A, B: \Set(0),
    a: A,
    b: B,
    existsA: \exists A,
    uniqueA: \forall (x, y: A) -> x = y,
) {
    \definition chosen: A :=
        \take (x: A) => x \by { existence: existsA, uniqueness: uniqueA };
    \definition wrong: chosen = a :=
        \takeelim b \with x: A => x \by { existence: existsA, uniqueness: uniqueA };
}
