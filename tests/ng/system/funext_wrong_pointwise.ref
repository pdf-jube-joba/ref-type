/* funext requires equality of the results at every argument. */
\module FunExtWrongPointwise(
    X, Y: \Set,
    f, g: X -> Y,
    P: \Prop,
    wrong: (x: X) -> P,
) {
    \definition bad: f = g := \axiom:funext(f, g, wrong);
}
/* expect-error: ty, inferred_ty not convertible */
/* expect-error: check pointwise equality */
