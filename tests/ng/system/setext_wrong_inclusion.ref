/* setext checks that both inclusion proofs connect the supplied subsets. */
\module SetExtWrongInclusion(
    X: \Set,
    A, B: \Power(X),
    aa: (x: X) -> \Pred(X, A, x) -> \Pred(X, A, x),
    ba: (x: X) -> \Pred(X, B, x) -> \Pred(X, A, x),
) {
    \definition bad: A = B := \axiom:setext(A, B, aa, ba);
}
