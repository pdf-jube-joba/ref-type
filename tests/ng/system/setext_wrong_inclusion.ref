/* setext checks that both inclusion proofs connect the supplied subsets. */
\module SetExtWrongInclusion(
    X: \Set,
    A, B: \Pow (X),
    aa: \forall (x: X) -> \In[X] (A) (x) -> \In[X] (A) (x),
    ba: \forall (x: X) -> \In[X] (B) (x) -> \In[X] (A) (x),
) {
    \definition bad: A = B := \axiom:setext(A, B, aa, ba);
}
/* expect-error: ty, inferred_ty not convertible */
/* expect-error: check forward inclusion */
