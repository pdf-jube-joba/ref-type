\module DependentResult(
    A: \Set(0),
    a: A,
    Family: A -> \Set(0),
    f: \forall (x: A) -> Family x,
    existsA: \exists A,
) {
    \infer \takeelim a \with x: A => f x
      \by { existence: existsA, uniqueness: \fun (x, y: A) => \refl (f x) };
}
/* expect-error: metavariable solution captures a variable outside its context */
