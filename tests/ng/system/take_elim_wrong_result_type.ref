\module WrongResultType(
    A, B: \Set(0),
    a: A,
    b: B,
    existsA: \exists A,
) {
    \definition unique: \forall (x, y: A) -> a = a := \fun (x, y: A) => \refl a;
    \definition chosen: A :=
        \take (x: A) => a \by { existence: existsA, uniqueness: unique };
    \definition wrong: chosen = a :=
        \takeelim a \with x: A => b
          \by { existence: existsA, uniqueness: \fun (x, y: A) => \refl b };
}
/* expect-error: types are not convertible */
