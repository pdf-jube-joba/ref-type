/* Subset introduction checks the membership proof at the boundary. */
\module SubsetIntroWrongProof(
    A: \Set(0),
    P, Q: A -> \Prop,
    a: A,
    qa: Q a,
) {
    \definition PSet: \Power(A) := \Subset(x, A, P x);
    \definition PA: \Set(0) := \Ty(A, PSet);
    \definition bad: PA := \subsetinto(A, PSet, a, qa);
}
