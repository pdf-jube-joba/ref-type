/* Subset introduction checks the membership proof at the boundary. */
\module SubsetIntroWrongProof(
    A: \Set(0),
    P, Q: A -> \Prop,
    a: A,
    qa: Q a,
) {
    \definition PSet: \Pow (A) := { x : A \where P x };
    \definition PA: \Set(0) := \Cast[A] (PSet);
    \definition bad: PA := \into[A](a, PSet) \by { qa };
}
