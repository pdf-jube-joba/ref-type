/* Choice requires pointwise inhabitation of the supplied family. */
\module ClassicalChoiceWrongInhabited(
    X: \Set,
    Family: X -> \Set,
    wrong: \forall (x: X) -> \exists X,
) {
    \definition bad: \exists (\forall (x: X) -> Family x) :=
        \axiom:classicalIndefiniteChoice(X, Family, wrong);
}
/* expect-error: types are not convertible */
/* expect-error: check pointwise inhabitation */
