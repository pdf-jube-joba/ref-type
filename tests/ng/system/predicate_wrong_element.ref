/* Pred(A, S, x) requires x to inhabit the stated ambient set A. */
\module PredicateWrongElement(
    A, B: \Set(0),
    subsetOfA: \Pow (A),
    b: B,
) {
    \definition bad: \Prop := \In[A] (subsetOfA) (b);
}
/* expect-error: ty, inferred_ty not convertible */
