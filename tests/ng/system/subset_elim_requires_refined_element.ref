/* Membership cannot be recovered from an unrefined carrier element. */
\module SubsetElimRequiresRefinedElement(
    A: \Set(0),
    P: A -> \Prop,
    a: A,
) {
    \definition PSet: \Pow (A) := { x : A \where P x };
    \definition bad: \In[A] (PSet) (a) := \bysub(A, PSet, a);
}
/* expect-error: ty, inferred_ty not convertible */
/* expect-error: check subset elimination */
