/* A refinement subset must belong to the stated ambient set. */
\module TypeLiftWrongCarrier(
    A, B: \Set(0),
    subsetOfB: \Pow (B),
) {
    \definition bad: \Set(0) := \Cast[A] (subsetOfB);
}
