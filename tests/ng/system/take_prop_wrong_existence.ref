/* Proposition-valued Take also checks its domain's existence proof. */
\module TakePropWrongExistence(
    X, Y: \Set(0),
    P: \Prop,
    predicate: X -> P,
    existsY: \exists Y,
) {
    \definition bad: P :=
        \take (x: X) => predicate x \by (existsY);
}
/* expect-error: ty, inferred_ty not convertible */
/* expect-error: check existence */
