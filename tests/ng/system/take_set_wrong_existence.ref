/* Set-valued Take checks its existence premise. */
\module TakeSetWrongExistence(
    X, Y, T: \Set(0),
    f: X -> T,
    existsY: \exists Y,
    uniqueF: (x1: X) -> (x2: X) -> f x1 = f x2,
) {
    \definition bad: T :=
        \take (x: X) => f x \by (existsY, uniqueF);
}
/* expect-error: ty, inferred_ty not convertible */
/* expect-error: check existence */
