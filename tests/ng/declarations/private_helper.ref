\module Private {
  \inductive Unit: \VType := | unit: Unit;
  \correspondence identity: Unit ~> \F(Unit) {
    \definition helper: Unit ~> \F(Unit) := \cfun (x: Unit) => \return x;
    \program := helper,
    \set := \fun (x: Unit^) => x,
    \coherence := \refl(identity::[program]^),
  }
  \definition escaped: Unit ~> \F(Unit) := helper;
}
/* expect-error: Name 'helper' was not found in its scope */
