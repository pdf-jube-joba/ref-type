\module Forward {
  \inductive Unit: \VType := | unit: Unit;
  \correspondence identity: Unit ~> \F(Unit) {
    \definition early: Unit^ -> Unit^ := identity::[set];
    \program := \cfun (x: Unit) => \return x,
    \set := \fun (x: Unit^) => x,
    \coherence := \refl(identity::[program]^),
  }
}
