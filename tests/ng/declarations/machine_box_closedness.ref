\module Open(A: \VType) {
  \inductive True: \Prop := | intro: True;
  \machine echo {
    \State := A,
    \Output := A,
    \step := \thunk(\cfun (s: A) => \return(\finish[A, A](s))),
    \definition ready: \RunStep[A^, A^] -> \Prop :=
      \step-match t: \RunStep[A^, A^] \return \Prop \with {
        | \continue s: \Acc[A^, A^](echo::[step]^, s)
        | \finish o: True
      };
    \terminates := \fun (s: A^) =>
      \accintro[A^, A^](echo::[step]^, s,
        \fun (next: A^) => \fun (edge: echo::[step]^ s = \continue[A^, A^](next)) =>
          \idelim echo::[step]^ s = \continue[A^, A^](next)
            \with t: \RunStep[A^, A^] => ready t
            \by { base: True::intro, equality: edge }),
  }
}
/* expect-error: Box requires a closed computation type */
