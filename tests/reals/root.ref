\module Logic;

\module Pair(A, B: \Set);

\module AxiomaticReals(Carrier: \Set);

\module Rat;

\module DedekindReal(
  Rat: \Set,
  lt: Rat -> Rat -> \Prop,
  setExt:
    (A, B: \Power(Rat)) ->
      ((x: Rat) -> \Pred(Rat, A, x) -> \Pred(Rat, B, x)) ->
      ((x: Rat) -> \Pred(Rat, B, x) -> \Pred(Rat, A, x)) ->
      A = B,
);

\module CauchyReal(
  Rat: \Set,
  zeroRat: Rat,
  ltRat: Rat -> Rat -> \Prop,
  subRat: Rat -> Rat -> Rat,
  absRat: Rat -> Rat,
);
