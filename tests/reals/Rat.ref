/* Rationals as the localization of Integer at its nonzero elements. */
\import \root.Logic() \as Logic;

\inductive Nat: \Set :=
| zero: Nat;
| succ: Nat -> Nat;
;

\definition natAdd: Nat -> Nat -> Nat :=
  (m, n: Nat) =>
    \prec(\Set, Nat)
      ((k: Nat) => Nat)
      n
      ((k: Nat) => (sum: Nat) => Nat#succ sum)
      m;

\definition natMul: Nat -> Nat -> Nat :=
  (m, n: Nat) =>
    \prec(\Set, Nat)
      ((k: Nat) => Nat)
      Nat#zero
      ((k: Nat) => (product: Nat) => natAdd n product)
      m;

\definition zeroNat: Nat := Nat#zero;

\definition oneNat: Nat := Nat#succ Nat#zero;

/* The pair (a,b) represents a-b. */
\inductive Integer: \Set :=
| pair: Nat -> Nat -> Integer;
;

\definition positive: Integer -> Nat :=
  (z: Integer) =>
    \prec(\Set, Integer)
      ((z: Integer) => Nat)
      ((a, b: Nat) => a)
      z;

\definition negative: Integer -> Nat :=
  (z: Integer) =>
    \prec(\Set, Integer)
      ((z: Integer) => Nat)
      ((a, b: Nat) => b)
      z;

\definition integer: Nat -> Nat -> Integer :=
  (a, b: Nat) => Integer#pair a b;

\definition zeroInteger: Integer := integer zeroNat zeroNat;

\definition oneInteger: Integer := integer oneNat zeroNat;

\definition negInteger: Integer -> Integer :=
  (x: Integer) => integer (negative x) (positive x);

\definition addInteger: Integer -> Integer -> Integer :=
  (x, y: Integer) =>
    integer
      (natAdd (positive x) (positive y))
      (natAdd (negative x) (negative y));

/* (a-b)(c-d) = (ac+bd) - (ad+bc). */
\definition mulInteger: Integer -> Integer -> Integer :=
  (x, y: Integer) =>
    integer
      (natAdd
        (natMul (positive x) (positive y))
        (natMul (negative x) (negative y)))
      (natAdd
        (natMul (positive x) (negative y))
        (natMul (negative x) (positive y)));

\definition subInteger: Integer -> Integer -> Integer :=
  (x, y: Integer) => addInteger x (negInteger y);

\definition IntegerEq: Integer -> Integer -> \Prop :=
  (x, y: Integer) =>
    natAdd (positive x) (negative y) =
      natAdd (positive y) (negative x);

\definition IntegerNonZero: Integer -> \Prop :=
  (x: Integer) => Logic.Not (IntegerEq x zeroInteger);

\definition NonZeroIntegerSet: \Power(Integer) :=
  \Subset(x, Integer, IntegerNonZero x);

/* S = Integer ∖ {0}, the multiplicative set used for localization. */
\definition NonZeroInteger: \Set :=
  \Ty(Integer, NonZeroIntegerSet);

\definition underlyingNonZero: NonZeroInteger -> Integer :=
  (x: NonZeroInteger) => x;

/* A fraction is directly a pair Integer × S. */
\inductive Fraction: \Set :=
| fraction: Integer -> NonZeroInteger -> Fraction;
;

\definition numerator: Fraction -> Integer :=
  (x: Fraction) =>
    \prec(\Set, Fraction)
      ((x: Fraction) => Integer)
      ((n: Integer) => (d: NonZeroInteger) => n)
      x;

\definition denominatorNonZero: Fraction -> NonZeroInteger :=
  (x: Fraction) =>
    \prec(\Set, Fraction)
      ((x: Fraction) => NonZeroInteger)
      ((n: Integer) => (d: NonZeroInteger) => d)
      x;

\definition denominator: Fraction -> Integer :=
  (x: Fraction) => underlyingNonZero (denominatorNonZero x);

\definition fraction: Integer -> NonZeroInteger -> Fraction :=
  (n: Integer) => (d: NonZeroInteger) => Fraction#fraction n d;

/* Equality before quotienting is equality after cross multiplication. */
\definition FractionEq: Fraction -> Fraction -> \Prop :=
  (x, y: Fraction) =>
    IntegerEq
      (mulInteger (numerator x) (denominator y))
      (mulInteger (numerator y) (denominator x));

\definition NumeratorNonZero: Fraction -> \Prop :=
  (x: Fraction) => IntegerNonZero (numerator x);

/*
 * mulNonZero is multiplication internal to S.  Its correctness equation is
 * the computational content of multiplicative closure.
 */
\module Localization(
  mulNonZero: NonZeroInteger -> NonZeroInteger -> NonZeroInteger,
  mulNonZeroCorrect: (x, y: NonZeroInteger) ->
    IntegerEq
      (underlyingNonZero (mulNonZero x y))
      (mulInteger (underlyingNonZero x) (underlyingNonZero y)),
) {
  \definition addFraction: Fraction -> Fraction -> Fraction :=
    (x, y: Fraction) =>
      fraction
        (addInteger
          (mulInteger (numerator x) (denominator y))
          (mulInteger (numerator y) (denominator x)))
        (mulNonZero (denominatorNonZero x) (denominatorNonZero y));

  \definition negFraction: Fraction -> Fraction :=
    (x: Fraction) =>
      fraction (negInteger (numerator x)) (denominatorNonZero x);

  \definition subFraction: Fraction -> Fraction -> Fraction :=
    (x, y: Fraction) =>
      fraction
        (subInteger
          (mulInteger (numerator x) (denominator y))
          (mulInteger (numerator y) (denominator x)))
        (mulNonZero (denominatorNonZero x) (denominatorNonZero y));

  \definition mulFraction: Fraction -> Fraction -> Fraction :=
    (x, y: Fraction) =>
      fraction
        (mulInteger (numerator x) (numerator y))
        (mulNonZero (denominatorNonZero x) (denominatorNonZero y));

  /*
   * The quotient interface is abstract in the relation to avoid repeatedly
   * normalizing the concrete cross-multiplication formula.  Instantiate it
   * with FractionEq and the arithmetic proofs above.
   */
  \module Quotient(
    equivalent: Fraction -> Fraction -> \Prop,
    setExt:
      (A, B: \Power(Fraction)) ->
        ((x: Fraction) ->
          \Pred(Fraction, A, x) -> \Pred(Fraction, B, x)) ->
        ((x: Fraction) ->
          \Pred(Fraction, B, x) -> \Pred(Fraction, A, x)) ->
        A = B,
    equivalentRefl:
      (x: Fraction) -> equivalent x x,
    equivalentSym:
      (x, y: Fraction) -> equivalent x y -> equivalent y x,
    equivalentTrans:
      (x, y, z: Fraction) ->
        equivalent x y -> equivalent y z -> equivalent x z,
  ) {
    \import \root.Logic() \as QuotientLogic;

    \definition ClassOf: Fraction -> \Power(Fraction) :=
      (x: Fraction) => \Subset(y, Fraction, equivalent x y);

    \definition classOfEq:
      (x, y: Fraction) -> equivalent x y -> ClassOf x = ClassOf y :=
      (x, y: Fraction) => (xy: equivalent x y) =>
        setExt (ClassOf x) (ClassOf y)
          ((z: Fraction) => (xz: equivalent x z) =>
            equivalentTrans y x z (equivalentSym x y xy) xz)
          ((z: Fraction) => (yz: equivalent y z) =>
            equivalentTrans x y z xy yz);

    \definition IsClass: \Power(Fraction) -> \Prop :=
      (C: \Power(Fraction)) =>
        (P: \Prop) -> ((x: Fraction) -> C = ClassOf x -> P) -> P;

    \definition ClassSet: \Power(\Power(Fraction)) :=
      \Subset(C, \Power(Fraction), IsClass C);

    \definition Rat: \Set :=
      \Ty(\Power(Fraction), ClassSet);

    \definition mem: Rat -> Fraction -> \Prop :=
      (x: Rat) => (a: Fraction) => \Pred(Fraction, x, a);

    \definition Eq: Rat -> Rat -> \Prop :=
      (x, y: Rat) => x = y;

    \definition eqByExt:
      (x, y: Rat) ->
        ((a: Fraction) -> mem x a -> mem y a) ->
        ((a: Fraction) -> mem y a -> mem x a) -> Eq x y :=
      (x, y: Rat) =>
        (xy: (a: Fraction) -> mem x a -> mem y a) =>
        (yx: (a: Fraction) -> mem y a -> mem x a) =>
          setExt x y xy yx;

    \definition classIsClass:
      (x: Fraction) -> IsClass (ClassOf x) :=
      (x: Fraction) =>
        (P: \Prop) =>
        (intro: (y: Fraction) -> ClassOf x = ClassOf y -> P) =>
          intro x (\refl(ClassOf x));

    \definition class: Fraction -> Rat :=
      (x: Fraction) =>
        \subsetinto(
          \Power(Fraction), ClassSet,
          ClassOf x, classIsClass x);

    \definition IsNonZero: Rat -> \Prop :=
      (x: Rat) =>
        (a: Fraction) -> mem x a -> NumeratorNonZero a;

    \definition NonZeroRatSet: \Power(Rat) :=
      \Subset(x, Rat, IsNonZero x);

    \definition NonZeroRat: \Set :=
      \Ty(Rat, NonZeroRatSet);

    \definition AddClass: Rat -> Rat -> \Power(Fraction) :=
      (x, y: Rat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      equivalent z (addFraction a b)]))])));

    \definition SubClass: Rat -> Rat -> \Power(Fraction) :=
      (x, y: Rat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      equivalent z (subFraction a b)]))])));

    \definition MulClass: Rat -> Rat -> \Power(Fraction) :=
      (x, y: Rat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      equivalent z (mulFraction a b)]))])));

    /* z is x/y exactly when z*y=x; y is separately refined as nonzero. */
    \definition DivClass: Rat -> NonZeroRat -> \Power(Fraction) :=
      (x: Rat) => (y: NonZeroRat) =>
        \Subset(z, Fraction,
          \exists \Ty(Fraction,
            \Subset(a, Fraction,
              QuotientLogic.And[mem x a,
                \exists \Ty(Fraction,
                  \Subset(b, Fraction,
                    QuotientLogic.And[mem y b,
                      QuotientLogic.And[NumeratorNonZero b,
                        equivalent (mulFraction z b) a]]))])));

    \module ClassClosed(
      addClassIsClass: (x, y: Rat) -> IsClass (AddClass x y),
      subClassIsClass: (x, y: Rat) -> IsClass (SubClass x y),
      mulClassIsClass: (x, y: Rat) -> IsClass (MulClass x y),
      divClassIsClass: (x: Rat) -> (y: NonZeroRat) ->
        IsClass (DivClass x y),
    ) {
      \definition add: Rat -> Rat -> Rat :=
        (x, y: Rat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            AddClass x y, addClassIsClass x y);

      \definition sub: Rat -> Rat -> Rat :=
        (x, y: Rat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            SubClass x y, subClassIsClass x y);

      \definition mul: Rat -> Rat -> Rat :=
        (x, y: Rat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            MulClass x y, mulClassIsClass x y);

      \definition div: Rat -> NonZeroRat -> Rat :=
        (x: Rat) => (y: NonZeroRat) =>
          \subsetinto(
            \Power(Fraction), ClassSet,
            DivClass x y, divClassIsClass x y);
    }
  }
}
