\module Example {
  \inductive Bool: \VType := | no: Bool; | yes: Bool; ;
  \structure Pair(A: \VType): \VType := { first: A, second: A };
  \cdefinition Pair(A: \VType)::swap: Pair[A] ~> \F(Pair[A]) :=
    \cfun (p: Pair[A]) => (\bind x: A <- (Pair::first p) \in
      \bind y: A <- ((Pair[_]::second) p) \in
      \return \record Pair[A] { first := y, second := x });
  \vdefinition Pair(A: \VType)::swap_thunk: \U(Pair[A] ~> \F(Pair[A])) := \thunk (Pair[A]::swap);
  \vdefinition pair: Pair[Bool] := \record Pair[Bool] { second := Bool::yes, first := Bool::no };
  \cdefinition first: \F(Bool) := ((Pair[Bool]::first) pair);
  \cdefinition swapped: \F(Pair[Bool]) := ((Pair[Bool]::swap) pair);
  \cnormalize first;
  \cnormalize ((Pair[Bool]::swap) pair);
  \ccheck (Pair::first pair): \F(Bool);
  \ccheck ((Pair[_]::second) pair): \F(Bool);
  \vcheck \record Pair { first := Bool::yes, second := Bool::no }: Pair[Bool];
  \vcheck Pair::swap_thunk: \U(Pair[Bool] ~> \F(Pair[Bool]));
  \cnormalize ((\force Pair[Bool]::swap_thunk) pair);
}
