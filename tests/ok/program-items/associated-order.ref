\module Source {
  \inductive First: \VType := | first: First; ;
  \inductive Second: \VType := | second: Second; ;
  \vdefinition second: Second := Second::second;
  \vdefinition First::second: Second := second;
}
\module Consumer {
  \import \root.Source() \as S;
  \vcheck S.First::second: S.Second;
}
