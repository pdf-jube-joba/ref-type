/* A shared definition form also permits Set/Prop associated definitions. */
\module Bad {
  \inductive Unit: \VType := | unit: Unit;
  \inductive Bool: \VType := | no: Bool | yes: Bool;
  \record Pair[A: \VType]: \VType := { first: A, second: A };
  \record P: \Set := {}; \definition P::value: Unit^ := Unit^::unit;
}
