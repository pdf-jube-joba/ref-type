
        \module CertifiedSteps {
          \inductive Unit: \VType := | unit: Unit | other: Unit ;
          \record Owner[A: \VType]: \VType := {};
          \definition step: \U((Unit ~> \F(\RunStep[Unit, Unit]))) :=
            \thunk((\cfun (s: Unit) => \return(\finish[Unit, Unit](Unit::unit))));

          \definition ready: \RunStep[Unit^, Unit^] -> \Prop :=
            \fun (r: \RunStep[Unit^, Unit^]) => \In[Unit^] (\runStepRec[Unit^, Unit^](\fun (r: \RunStep[Unit^, Unit^]) => \Pow (Unit^), \fun (s: Unit^) => { x : Unit^ \where \Acc[Unit^, Unit^](step^, s) }, \fun (o: Unit^) => { x : Unit^ \where Unit^::unit = Unit^::unit }, r)) (Unit^::unit);
          \definition terminates: \forall (s: Unit^) -> \Acc[Unit^, Unit^](step^, s) :=
            \fun (s: Unit^) => \accintro[Unit^, Unit^](step^, s, \fun (next: Unit^) => \fun (edge: step^ s = \continue[Unit^, Unit^](next)) =>
                \idelim(step^ s = \continue[Unit^, Unit^](next)
                  \with r: \RunStep[Unit^, Unit^] => ready r) \by { base: \refl(Unit^::unit), equality: edge });
          \definition Owner(A: \VType)::result: \F(Unit) :=
            \run[Unit, Unit](step, Unit::unit) \by { terminates Unit^::unit };
          \definition Owner(A: \VType)::otherResult: \F(Unit) :=
            \run[Unit, Unit](step, Unit::other) \by { terminates Unit^::other };
          \definition boxed: \Box[\F(Unit)] := \box[_](Owner[Unit]::result);
        }

\module CertifiedConsumer {
  \import \root.CertifiedSteps[] \as S;
  \definition boxed: \Box[\F(S.Unit)] := \box[_](S.Owner[S.Unit]::result);
  \normalize \squash[_](boxed);
  \cnormalize S.Owner[S.Unit]::result;
}
