/* Power, subset formation/introduction/elimination, weakening, and equality. */
\module SubsetAndEquality(
    A: \Set(0),
    P, Q: A -> \Prop,
    a: A,
    pa: P a,
    qa: Q a,
) {
    \definition PSet: \Power(A) := \Subset(x, A, P x);
    \definition QSet: \Power(A) := \Subset(x, A, Q x);
    \definition PA: \Set(0) := \Ty(A, PSet);
    \definition QA: \Set(0) := \Ty(A, QSet);

    \definition inP: PA := \subsetinto(A, PSet, a, pa);
    \definition inQ: QA := \subsetinto(A, QSet, a, qa);
    \definition weakenedP: A := inP;
    \definition membershipP: \Pred(A, PSet, inP) :=
        \bysub(A, PSet, inP);

    /* Distinct refinements over the same carrier admit an equality type. */
    \definition same_carrier: inP = inQ := \refl(inP);
}
