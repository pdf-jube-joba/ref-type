/* Exists, set-valued Take, proposition-valued Take, and Take equality. */
\module ChoiceRules(
    X: \Set(0),
    T: \Set(0),
    P: \Prop,
    f: X -> T,
    predicate: X -> P,
    x: X,
    existsX: \exists X,
    uniqueF: \forall (x1: X) -> \forall (x2: X) -> f x1 = f x2,
) {
    \definition witnessed: \exists X := \exact(x, X);

    \definition chosen: T :=
        \take (y: X) => f y \by (existsX, uniqueF);
    \definition chosen_property: P :=
        \take (y: X) => predicate y \by (existsX);

    \definition chosen_at_x: chosen = f x :=
        \takeelim(\fun (y: X) => f y, x, X, T) \by (existsX, uniqueF);
}
