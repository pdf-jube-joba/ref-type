\module RefinedNaturalElimination {
  \inductive Nat: \Set :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \definition Reflexive: \Power(Nat) :=
    \Subset(n, Nat, n = n);

  \definition RefinedNat: \Set :=
    \Ty(Nat, Reflexive);

  \definition eliminate: RefinedNat -> Nat :=
    (n: RefinedNat) =>
      \elim n \in Nat \return ((k: Nat) => Nat) {
      | zero => Nat::zero;
      | succ => (k: Nat) => (result: Nat) => Nat::succ result;
      };
}
