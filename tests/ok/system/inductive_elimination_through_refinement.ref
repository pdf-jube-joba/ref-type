\module RefinedNaturalElimination {
  \inductive Nat: \Set :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \definition Reflexive: \Pow (Nat) :=
    { n : Nat \where n = n };

  \definition RefinedNat: \Set :=
    \Cast[Nat] (Reflexive);

  \definition eliminate: RefinedNat -> Nat :=
    \fun (n: RefinedNat) =>
      \case n \in Nat \return (\fun (k: Nat) => Nat) {
      | zero => Nat::zero
      | succ => \fun (k: Nat) => Nat::succ k
      };

  \normalize eliminate (Nat::succ Nat::zero);
}
