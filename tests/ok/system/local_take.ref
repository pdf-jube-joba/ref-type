/* Take codomains may refer to binders outside the map binder. */
\module LocalTake(X: \Set(0), existsX: \exists X) {
    \definition local_prop:
        \forall (p: \Prop) -> p -> p :=
        \fun (p: \Prop) => \fun (hp: p) =>
            \take (x: X) => hp \by (existsX);

    \definition local_set:
        \forall (T: \Set(0)) ->
        \forall (t: T) ->
        T :=
        \fun (T: \Set(0)) => \fun (t: T) =>
            \take (x: X) => t
            \by (existsX, \fun (x1: X) => \fun (x2: X) => \refl(t));
}
