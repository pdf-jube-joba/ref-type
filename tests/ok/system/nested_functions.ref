/* Nested App/Lam checking, including dependent substitution. */
\module NestedFunctions(
    A, B, C: \Set(0),
    a: A,
    f: A -> B,
    g: B -> C,
    Family: A -> \Set(0),
    dependent: (x: A) -> Family x,
) {
    \definition compose: (B -> C) -> (A -> B) -> A -> C :=
        (outer: B -> C) =>
        (inner: A -> B) =>
        (x: A) => outer (inner x);

    \definition composed_at_a: C := compose g f a;
    \definition nested_application: C :=
        ((identity: C -> C) => identity (g (f a))) ((x: C) => x);

    \definition dependent_identity:
        ((h: (x: A) -> Family x) -> (x: A) -> Family x) :=
        (h: (x: A) -> Family x) => (x: A) => h x;
    \definition dependent_at_a: Family a :=
        dependent_identity dependent a;

    \definition higher_order_check:
        ((h: A -> B) -> (k: B -> C) -> C) :=
        (h: A -> B) => (k: B -> C) => k (h a);
}
