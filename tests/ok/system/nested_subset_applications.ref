/* SubsetIntro is transparent in both positions of an application. */
\module NestedSubsetApplications(
    A: \Set(0),
    P: A -> \Prop,
    a: A,
    pa: P a,
    Family: A -> \Set(0),
    indexed: Family a,
) {
    \definition ASubset: \Power(A) := \Subset(x, A, P x);
    \definition RefinedA: \Set(0) := \Ty(A, ASubset);
    \definition refined_a: RefinedA :=
        \subsetinto(A, ASubset, a, pa);

    \definition Endo: \Set(0) := A -> A;
    \definition GoodEndoSet: \Power(Endo) :=
        \Subset(f, Endo, f = f);
    \definition GoodEndo: \Set(0) := \Ty(Endo, GoodEndoSet);
    \definition identity: Endo := (x: A) => x;
    \definition checked_identity: GoodEndo :=
        \subsetinto(Endo, GoodEndoSet, identity, \refl(identity));

    /* The function and argument are both literal SubsetIntro expressions. */
    \definition intro_in_both_positions: A :=
        (\subsetinto(Endo, GoodEndoSet, identity, \refl(identity)))
        (\subsetinto(A, ASubset, a, pa));

    /* The same path through named checked values. */
    \definition named_in_both_positions: A := checked_identity refined_a;
    \definition nested_higher_order: A :=
        ((f: Endo) => (x: A) => f x) checked_identity refined_a;

    /* Erased conversion also acts inside a dependent type argument. */
    \definition indexed_by_intro:
        Family (\subsetinto(A, ASubset, a, pa)) := indexed;
    \definition indexed_by_named_intro: Family refined_a := indexed;
}
