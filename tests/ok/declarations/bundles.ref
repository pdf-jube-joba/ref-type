\module Bundles {
  \inductive Unit: \VType := | unit: Unit;
  \inductive True: \Prop := | intro: True;

  \structure Fixed: \Set {
    value: Unit^,
  } \where {
    fixed: value = Unit^::unit,
  }
  \definition fixed: Fixed::[Set] :=
    Fixed { value := Unit^::unit } \with { fixed := \refl(Unit^::unit) };
  \definition value(s: Fixed::[Set]): Unit^ := s #value;
  \definition law(s: Fixed::[Set]): s #value = Unit^::unit := s #fixed;
  \definition raw(s: Fixed::[Set]): Fixed::[Raw] := Fixed::[raw] s;
  \definition laws(s: Fixed::[Set]): Fixed::[Law][Fixed::[raw] s] := Fixed::[law] s;
  \check law fixed: Unit^::unit = Unit^::unit;
  \definition computation: value fixed = Unit^::unit := \refl(Unit^::unit);

  \correspondence identity: Unit ~> \F(Unit) {
    \program := \cfun (x: Unit) => \return x,
    \set := \fun (x: Unit^) => x,
    \definition same: identity::[program]^ = identity::[set] := \refl(identity::[program]^);
    \coherence := same,
  };
  \definition copy: identity::[Type] := identity::[program];
  \check identity::[coherence]: copy^ = identity::[set];

  \machine echo {
    \State := Unit,
    \Output := Unit,
    \step := \thunk(\cfun (s: Unit) => \return(\finish[Unit, Unit](s))),
    \definition ready: \RunStep[Unit^, Unit^] -> \Prop :=
      \step-match t: \RunStep[Unit^, Unit^] \return \Prop \with {
        | \continue s: \Acc[Unit^, Unit^](echo::[step]^, s)
        | \finish o: True
      };
    \terminates := \fun (s: Unit^) =>
      \accintro[Unit^, Unit^](echo::[step]^, s,
        \fun (next: Unit^) => \fun (edge: echo::[step]^ s = \continue[Unit^, Unit^](next)) =>
          \idelim echo::[step]^ s = \continue[Unit^, Unit^](next)
            \with t: \RunStep[Unit^, Unit^] => ready t
            \by { base: True::intro, equality: edge }),
  }

  \correspondence wrapped: Unit ~> \F(Unit) {
    \machine implementation {
      \State := Unit,
      \Output := Unit,
      \step := \thunk(\cfun (s: Unit) => \return(\finish[Unit, Unit](s))),
      \definition ready: \RunStep[Unit^, Unit^] -> \Prop :=
        \step-match t: \RunStep[Unit^, Unit^] \return \Prop \with {
          | \continue s: \Acc[Unit^, Unit^](implementation::[step]^, s)
          | \finish o: True
        };
      \terminates := \fun (s: Unit^) =>
        \accintro[Unit^, Unit^](implementation::[step]^, s,
          \fun (next: Unit^) => \fun (edge: implementation::[step]^ s = \continue[Unit^, Unit^](next)) =>
            \idelim implementation::[step]^ s = \continue[Unit^, Unit^](next)
              \with t: \RunStep[Unit^, Unit^] => ready t
              \by { base: True::intro, equality: edge }),
    }
    \program := implementation::[run],
    \set := identity::[set],
    \coherence := \axiom:funext(wrapped::[program]^, wrapped::[set],
      \fun (s: Unit^) => \refl(s)),
  }
  \check wrapped::[coherence]: wrapped::[program]^ = identity::[set];
  \definition output: \F(echo::[Output]) := echo::[run] Unit::unit;
  \definition input: \Box[\F(echo::[State])] := \box[_](\return Unit::unit);
  \definition boxedResult:
    \squash[_](\boxapp(echo::[runbox], input)) = Unit^::unit := \refl(Unit^::unit);
  \check echo::[terminates] Unit^::unit: \Acc[Unit^, Unit^](echo::[step]^, Unit^::unit);
}
