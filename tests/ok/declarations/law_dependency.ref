\module Dependency(A: \Set, a: A) {
  \structure Witness: \Set { value: A } \where {
    same: value = value,
    witness: value = (\into[A](value, { x: A \where x = x }) \by { same }),
  }
  \definition w: Witness::[Set] :=
    Witness { value := a } \with { same := \refl(a), witness := \refl(a) };
  \definition get(s: Witness::[Set]): s #value = s #value := s #witness;
  \check get w: a = a;
}
