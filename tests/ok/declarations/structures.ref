\module Structures {
  \inductive Unit: \Set := | unit: Unit;
  \structure EqualPair[A: \Set]: \Set {
    first: A,
    second: A,
  } \where {
    same: first = second,
  }
  \definition pair: EqualPair[Unit]::[Set] :=
    EqualPair[Unit] { second := Unit::unit, first := Unit::unit }
      \with { same := \refl(Unit::unit) };
  \definition law(p: EqualPair[Unit]::[Set]): p #first = p #second := p #same;
  \definition get(p: EqualPair[Unit]::[Set]): Unit := p #first;
  \definition compute: get pair = Unit::unit := \refl(Unit::unit);
  \definition repack(p: EqualPair[Unit]::[Set]): EqualPair[Unit]::[Set] :=
    EqualPair[Unit] { first := p #first, second := p #second } \with { same := p #same };
  \definition raw: EqualPair[Unit]::[Raw] := EqualPair[Unit]::[raw] pair;
  \definition laws: EqualPair[Unit]::[Law][raw] := EqualPair[Unit]::[law] pair;
  \check laws #same: raw #first = raw #second;

  \structure Dependent[A: \Set, Family: A -> \Set]: \Set {
    index: A,
    item: Family index,
  } \where {
    stable: index = index,
  }
  \definition family(x: Unit): \Set := Unit;
  \definition dependent: Dependent[Unit, family]::[Set] :=
    Dependent[Unit, family] { index := Unit::unit, item := Unit::unit }
      \with { stable := \refl(Unit::unit) };
  \definition extract(p: Dependent[Unit, family]::[Set]): family (p #index) := p #item;
  \definition dependentComputes: extract dependent = Unit::unit := \refl(Unit::unit);
  \structure Empty: \Set {} \where {}
  \definition empty: Empty::[Set] := Empty {} \with {};
  \check Empty::[law] empty: Empty::[Law][Empty::[raw] empty];
}

\module Consumer {
  \import \root.Structures[] \as S;
  \definition p: S.EqualPair[S.Unit]::[Set] := S.pair;
  \definition proof: p #first = p #second := p #same;
  \check S.EqualPair[S.Unit]::[law] p: S.EqualPair[S.Unit]::[Law][S.EqualPair[S.Unit]::[raw] p];
}
