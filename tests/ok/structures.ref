\module Structures {
  \inductive Nat: \Set :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \structure Pair(A: \Set): \Set := {
    first: A,
    second: A,
  };

  \definition Pair(A: \Set)::swap(p: Pair[A]): Pair[A] := Pair[A] {
    first := Pair[A]::second p,
    second := Pair[A]::first p,
  };

  \definition pair: Pair[Nat] := Pair[Nat] {
    second := Nat::succ Nat::zero,
    first := Nat::zero,
  };
  \check Pair::first pair: Nat;
  \normalize Pair[Nat]::second (Pair::swap pair);

  \structure Packed: \SetKind := {
    carrier: \Set,
    value: carrier,
  };
  \definition packed: Packed := Packed {
    carrier := Nat,
    value := Nat::zero,
  };
  \check Packed::value packed: Packed::carrier packed;

  \structure Conjunction(P, Q: \Prop): \Prop := {
    left: P,
    right: Q,
  };
  \definition duplicate(P: \Prop)(p: P): Conjunction[P, P] :=
    Conjunction[P, P] { left := p, right := p };

  \structure Theory: \PropKind := {
    proposition: \Prop,
  };
  \inductive VNat: \VType :=
  | zero: VNat;
  | succ: VNat -> VNat;
  ;

  \structure Point(A: \VType): \VType := {
    x: A,
    y: A,
  };

  \cdefinition flip: \CFun(Point[VNat], \F(Point[VNat])) :=
    \clam(p, Point[VNat], \return(Point[VNat] {
      x := Point[VNat]::y p,
      y := Point[VNat]::x p,
    }));

  \vdefinition point: Point[VNat] := Point[VNat] {
    x := VNat::zero,
    y := VNat::succ VNat::zero,
  };
  \vcheck Point[VNat]::x point: VNat;
  \cnormalize \sequence(
    \capp(flip, point),
    flipped,
    Point[VNat],
    \return(Point[VNat]::y flipped));
}
