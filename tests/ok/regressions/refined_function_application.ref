\module RefinedFunctionApplication {
  \inductive Unit: \Set := | unit: Unit; ;
  \inductive True: \Prop := | yes: True; ;
  \definition Functions: \Power(Unit -> Unit) := \Subset(f, Unit -> Unit, True);
  \definition identity: \Ty(Unit -> Unit, Functions) :=
    \subsetinto(Unit -> Unit, Functions, \fun (x: Unit) => x, True::yes);
  \definition identityBeta (x: Unit): identity x = x := \refl(x);
}
