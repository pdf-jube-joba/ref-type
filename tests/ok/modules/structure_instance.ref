\module StructureSource(A: \Set, a: A) {
  \structure Box: \Set := {
    value: A,
  };
  \definition Box::get(box: Box): A := Box::value box;
  \definition boxed: Box := Box { value := a };
}

\module StructureConsumer(B: \Set, b: B) {
  \import \root.StructureSource(A := B, a := b) \as Source;
  \check Source.Box::get Source.boxed: B;
  \check Source.Box::value Source.boxed: B;
}

\module ProgramStructureSource(A: \VType, a: A) {
  \structure Box: \VType := {
    value: A,
  };
  \cdefinition get: \CFun(Box, \F(A)) :=
    \clam(box, Box, \return(Box::value box));
  \vdefinition boxed: Box := Box { value := a };
}

\module ProgramStructureConsumer(B: \VType, b: B) {
  \import \root.ProgramStructureSource(A := _, a := b) \as Source;
  \ccheck \capp(Source.get, Source.boxed): \F(B);
  \vcheck Source.Box::value Source.boxed: B;
}
