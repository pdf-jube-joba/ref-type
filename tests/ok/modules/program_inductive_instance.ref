\module ProgramSource {
  \inductive Box(X: \VType): \VType :=
  | box: X -> Box;
  ;
}

\module ProgramConsumer(A: \VType, a: A) {
  \import \root.ProgramSource() \as Source;
  \definition boxed: Source.Box[A] := Source.Box[A]#box a;
  \definition reflected: \RfType(Source.Box[A]) :=
    \RfTerm(Source.Box[A], boxed);
}
