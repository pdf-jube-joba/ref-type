\module ProgramSource {
  \inductive Box(X: \VType): \VType :=
  | box: X -> Box;
  ;
}

\module ProgramConsumer {
  \import \root.ProgramSource() \as Source;
  \inductive Unit: \VType :=
  | unit: Unit;
  ;
  \vdefinition boxed: Source.Box[Unit] := Source.Box[Unit]::box Unit::unit;
  \definition package: \Box(Source.Box[Unit]) :=
    \box(Source.Box[Unit], boxed);
  \normalize \Force(Source.Box[Unit], package);
}
