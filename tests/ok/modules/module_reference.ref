\module Test1{
  \definition i: \forall (X: \Set) -> \Set := \fun (X: \Set) => X;
}

\module Test2(
  A: \Set,
){
  \definition a1: \Set := (\fun (X: \Set) => X) A;
  \import \root.Test1() \as T;
  \definition i2: \forall (X: \Set) -> \Set := T.i;
  \definition a2: \Set := i2 A;
  \definition a3: \Set := T.i A;
}
