\module MetaProgramConstructor(A: \VType, a: A) {
  \inductive Box(X: \VType): \VType :=
    | box: X -> Box;
  ;

  \definition implicitBox: Box[A] := Box[_]::box a;
  \definition freshGoalBox: Box[A] := Box[?]::box a;
  \definition namedGoalBox: Box[A] := Box[?10]::box a;

  /* PTS inference fails first; Program-value inference must start cleanly. */
  \infer Box[_]::box a;
  \eval Box[_]::box a;
  \normalize Box[_]::box a;
}
