\module MetaProgramConstructor(A: \VType, a: A) {
  \inductive Box(X: \VType): \VType :=
    | box: X -> Box;
  ;

  \vdefinition implicitBox: Box[A] := Box[_]::box a;
  \vdefinition freshGoalBox: Box[A] := Box[?]::box a;
  \vdefinition namedGoalBox: Box[A] := Box[?10]::box a;

  \vinfer Box[_]::box a;
  \veval Box[_]::box a;
  \vnormalize Box[_]::box a;
}
