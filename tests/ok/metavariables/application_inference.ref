\module MetaApplication(A: \Set(0), a: A) {
  \definition id:
    \forall (X: \Set(0)) -> X -> X :=
    \fun (X: \Set(0)) => \fun (x: X) => x;

  \definition chooseLeft:
    \forall (X: \Set(0)) -> X -> X -> X :=
    \fun (X: \Set(0)) => \fun (left: X) => \fun (right: X) => left;

  /* All three surface forms can be solved by a later argument. */
  \definition implicit: A := id _ a;
  \definition freshGoal: A := id ? a;
  \definition namedGoal: A := id ?2 a;

  /* Repeated ?N occurrences in one declaration denote the same meta. */
  \definition sharedNamedGoal: A :=
    chooseLeft ?7 (id ?7 a) a;

  \infer id _ a;
  \eval id _ a;
  \normalize id _ a;
}
