\module MetaParameterized(X: \Set(0), x: X) {}

\module MetaModuleUse(A: \Set(0), a: A) {
  \import \root.MetaParameterized(X := _, x := a) \as ImplicitInstance;
  \import \root.MetaParameterized(X := ?, x := a) \as FreshGoalInstance;
  \import \root.MetaParameterized(X := ?8, x := a) \as NamedGoalInstance;
}
