\module MetaDeclarationScopes(A: \Set(0), a: A) {
  \definition id:
    \forall (X: \Set(0)) -> X -> X :=
    \fun (X: \Set(0)) => \fun (x: X) => x;

  /* Named metavariables are scoped to one declaration. */
  \definition first: A := id ?1 a;
  \definition second: A := id ?1 a;
  \definition third: A := id ?1 a;
}
