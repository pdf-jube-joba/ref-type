\module MetaProgram(A: \VType, a: A) {
  \definition finished: \RunStep(A, A) :=
    \finish(_, A, a);

  \definition identity: \CFun(A, \F(A)) :=
    \clam(x, _, \return(x));

  \definition sequenced: \F(A) :=
    \sequence(\return(a), x, _, \return(x));

  /* These exercise inference without a declared expected type. */
  \infer \sequence(\return(a), x, _, \return(x));
  \eval \sequence(\return(a), x, _, \return(x));
  \normalize \sequence(\return(a), x, _, \return(x));
}
