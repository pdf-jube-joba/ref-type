\module MetaProgram(A: \VType, a: A) {
  \vdefinition finished: \PRunStep(A, A) :=
    \Pfinish(_, A, a);

  \cdefinition identity: \CFun(A, \F(A)) :=
    \clam(x, _, \return(x));

  \cdefinition sequenced: \F(A) :=
    \sequence(\return(a), x, _, \return(x));

  \cinfer \sequence(\return(a), x, _, \return(x));
  \ceval \sequence(\return(a), x, _, \return(x));
  \cnormalize \sequence(\return(a), x, _, \return(x));
}
