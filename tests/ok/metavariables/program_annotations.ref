\module MetaProgram(A: \VType, a: A) {
  \definition finished: \RunStep(A, A) :=
    \finish(_, A, a);

  \definition identity: (A ~> \F(A)) :=
    (\cfun (x: _) => \return(x));

  \definition sequenced: \F(A) :=
    (\bind x: _ <- \return(a) \in \return(x));

  \cinfer (\bind x: _ <- \return(a) \in \return(x));
  \ceval (\bind x: _ <- \return(a) \in \return(x));
  \cnormalize (\bind x: _ <- \return(a) \in \return(x));
}
