\module MetaProgram(A: \VType, a: A) {
  \vdefinition finished: \PRunStep(A, A) :=
    \Pfinish(_, A, a);

  \cdefinition identity: (A ~> \F(A)) :=
    (\cfun (x: _) => \return(x));

  \cdefinition sequenced: \F(A) :=
    \do { \bind x: _ <- \return(a); \return(x) };

  \cinfer \do { \bind x: _ <- \return(a); \return(x) };
  \ceval \do { \bind x: _ <- \return(a); \return(x) };
  \cnormalize \do { \bind x: _ <- \return(a); \return(x) };
}
