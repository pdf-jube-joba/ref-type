\module Example(A: \Set(1), a, b, c: A, ab: a = b, bc: b = c) {
  \definition transitive: a = c :=
    \idelim(b = c \with x: _ => a = x) \by { base: ab, equality: bc };

  \definition local(x, y: A, xy: x = y): y = x :=
    \idelim(x = y \with z: _ => z = x) \by { base: \refl(x), equality: xy };
}
