\module MetaContextual {
  \definition apply:
    \forall (A: \Set(0)) -> A -> A :=
    \fun (A: \Set(0)) => \fun (x: A) =>
      (\fun (X: \Set(0)) => \fun (value: X) => value) _ x;

  \definition applyNamed:
    \forall (A: \Set(0)) -> A -> A :=
    \fun (A: \Set(0)) => \fun (x: A) =>
      (\fun (X: \Set(0)) => \fun (value: X) => value) ?4 x;

  /* A named meta shared by sibling lambdas may only use their common scope. */
  \definition siblingLambdas:
    \forall (A: \Set(0)) -> ((A -> A) -> (A -> A) -> A) -> A :=
    \fun (A: \Set(0)) =>
      \fun (consume: (A -> A) -> (A -> A) -> A) =>
        consume
          (\fun (x: A) => (\fun (X: \Set(0)) => \fun (value: X) => value) ?9 x)
          (\fun (y: A) => (\fun (X: \Set(0)) => \fun (value: X) => value) ?9 y);
}
