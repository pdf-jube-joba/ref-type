\module MetaContextual {
  \definition apply:
    (A: \Set(0)) -> A -> A :=
    (A: \Set(0)) => (x: A) =>
      ((X: \Set(0)) => (value: X) => value) _ x;

  \definition applyNamed:
    (A: \Set(0)) -> A -> A :=
    (A: \Set(0)) => (x: A) =>
      ((X: \Set(0)) => (value: X) => value) ?4 x;

  /* A named meta shared by sibling lambdas may only use their common scope. */
  \definition siblingLambdas:
    (A: \Set(0)) -> ((A -> A) -> (A -> A) -> A) -> A :=
    (A: \Set(0)) =>
      (consume: (A -> A) -> (A -> A) -> A) =>
        consume
          ((x: A) => ((X: \Set(0)) => (value: X) => value) ?9 x)
          ((y: A) => ((X: \Set(0)) => (value: X) => value) ?9 y);
}
