/* Primitive recursion must preserve multiple local inductive parameters. */
\module ParameterizedPrecPair {
  \inductive Times(A, B: \Set): \Set :=
  | pair: A -> B -> Times;
  ;

  \definition first:
    \forall (A, B: \Set) -> Times[A, B] -> A :=
    \fun (A, B: \Set) => \fun (p: Times[A, B]) =>
      \prec(\Set, Times[A, B])
        (\fun (q: Times[A, B]) => A)
        (\fun (a: A) => \fun (b: B) => a)
        p;

  \definition second:
    \forall (A, B: \Set) -> Times[A, B] -> B :=
    \fun (A, B: \Set) => \fun (p: Times[A, B]) =>
      \prec(\Set, Times[A, B])
        (\fun (q: Times[A, B]) => B)
        (\fun (a: A) => \fun (b: B) => b)
        p;
}
