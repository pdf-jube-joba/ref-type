/* Primitive recursion must preserve multiple local inductive parameters. */
\module ParameterizedPrecPair {
  \inductive Times(A, B: \Set): \Set :=
  | pair: A -> B -> Times;
  ;

  \definition first:
    (A, B: \Set) -> Times[A, B] -> A :=
    (A, B: \Set) => (p: Times[A, B]) =>
      \prec(\Set, Times[A, B])
        ((q: Times[A, B]) => A)
        ((a: A) => (b: B) => a)
        p;

  \definition second:
    (A, B: \Set) -> Times[A, B] -> B :=
    (A, B: \Set) => (p: Times[A, B]) =>
      \prec(\Set, Times[A, B])
        ((q: Times[A, B]) => B)
        ((a: A) => (b: B) => b)
        p;
}
