/*
 * A Cartesian product should be definable polymorphically inside one module.
 *
 * Times itself is accepted with two Set parameters.  Its polymorphic pair
 * function must also be accepted: quantifying over A and B places the whole
 * definition in the least universe containing all fibers, rather than making
 * either Times[A, B] or its elements ill-sorted.
 */
\module PairCumulative {
  \inductive Times(A, B: \Set): \Set :=
  | pairConstructor: A -> B -> Times;
  ;

  \definition pair:
    \forall (A, B: \Set) -> A -> B -> Times[A, B] :=
    \fun (A, B: \Set) => \fun (a: A) => \fun (b: B) =>
      Times[A, B]::pairConstructor a b;
}
