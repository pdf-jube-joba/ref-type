/* McCarthy's 91 function as a CBPV state machine.
 *
 *   M(n) = n - 10       when n > 100
 *          M(M(n + 11)) otherwise
 *
 * `pending` is the continuation for the outer call in M(M(n + 11)).
 * Inspecting the threshold and adding constants are also explicit machine
 * states, so every transition remains a CBPV computation returning RunStep.
 */
\module McCarthy91 {
  \inductive Nat: \VType :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \inductive Continuation: \VType :=
  | done: Continuation;
  | pending: Continuation -> Continuation;
  ;

  \inductive State: \VType :=
  | call: Nat -> Continuation -> State;
  | inspect: Nat -> Nat -> Nat -> Continuation -> State;
  | raise: Nat -> Nat -> Continuation -> State;
  | raiseAndCall: Nat -> Nat -> Continuation -> State;
  ;

  \vdefinition ten: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ Nat::zero)))))))));
  \vdefinition eleven: Nat := Nat::succ ten;
  \vdefinition twenty: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ ten)))))))));
  \vdefinition thirty: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ twenty)))))))));
  \vdefinition forty: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ thirty)))))))));
  \vdefinition fifty: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ forty)))))))));
  \vdefinition sixty: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ fifty)))))))));
  \vdefinition seventy: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ sixty)))))))));
  \vdefinition eighty: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ seventy)))))))));
  \vdefinition ninety: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ eighty)))))))));
  \vdefinition ninetyOne: Nat := Nat::succ ninety;
  \vdefinition hundred: Nat :=
    Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ
      (Nat::succ (Nat::succ (Nat::succ (Nat::succ (Nat::succ ninety)))))))));
  \vdefinition hundredOne: Nat := Nat::succ hundred;

  \vdefinition step:
    \U(\CFun(State, \F(\PRunStep(State, Nat)))) :=
    \thunk(\clam(state, State,
      \vcase(State, state) {
      | call(argument, continuation) =>
          \return(\Pcontinue(
            State,
            Nat,
            State::inspect
              argument
              argument
              hundredOne
              continuation));
      | inspect(original, remaining, threshold, continuation) =>
          \vcase(Nat, threshold) {
          | zero() =>
              /* original >= 101, and remaining + 91 = original - 10. */
              \return(\Pcontinue(
                State,
                Nat,
                State::raise remaining ninetyOne continuation));
          | succ(smallerThreshold) =>
              \vcase(Nat, remaining) {
              | zero() =>
                  /* original <= 100: first evaluate M(original + 11),
                   * then the pending continuation evaluates M once more.
                   */
                  \return(\Pcontinue(
                    State,
                    Nat,
                    State::raiseAndCall
                      original
                      eleven
                      (Continuation::pending continuation)));
              | succ(smallerRemaining) =>
                  \return(\Pcontinue(
                    State,
                    Nat,
                    State::inspect
                      original
                      smallerRemaining
                      smallerThreshold
                      continuation));
              };
          };
      | raise(result, additions, continuation) =>
          \vcase(Nat, additions) {
          | zero() =>
              \vcase(Continuation, continuation) {
              | done() =>
                  \return(\Pfinish(State, Nat, result));
              | pending(rest) =>
                  \return(\Pcontinue(
                    State,
                    Nat,
                    State::call result rest));
              };
          | succ(smallerAdditions) =>
              \return(\Pcontinue(
                State,
                Nat,
                State::raise
                  (Nat::succ result)
                  smallerAdditions
                  continuation));
          };
      | raiseAndCall(argument, additions, continuation) =>
          \vcase(Nat, additions) {
          | zero() =>
              \return(\Pcontinue(
                State,
                Nat,
                State::call argument continuation));
          | succ(smallerAdditions) =>
              \return(\Pcontinue(
                State,
                Nat,
                State::raiseAndCall
                  (Nat::succ argument)
                  smallerAdditions
                  continuation));
          };
      }));

  \cdefinition mcCarthy91: \CFun(Nat, \F(Nat)) :=
    \clam(argument, Nat,
      \Prun(
        State,
        Nat,
        step,
        State::call argument Continuation::done));

  \cnormalize \capp(mcCarthy91, hundred);
}
