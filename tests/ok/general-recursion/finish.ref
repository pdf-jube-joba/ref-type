/* A checked CBPV run reduces to return when its step finishes. */
\module RunFinish(
  A: \VType,
  B: \VType,
  a: A,
  b: B
) {
  \definition step: \U(\CFun(A, \F(\RunStep(A, B)))) :=
    \thunk(\clam(x, A, \return(\finish(A, B, b))));
  \definition result: \F(B) := \run(A, B, step, a);

  \eval \run(A, B, step, a);
  \normalize \run(A, B, step, a);
}
