/* A checked run reduces atomically to finish, even with an open initial state. */
\module RunFinish(
  A: \Type,
  B: \Type,
  a: A,
  b: B,
  termination:
    \Acc(A, B,
      (x: A) => \finish(A, B, b),
      \RfTerm(A, a))
) {
  \definition result: B :=
    \run(A, B, (x: A) => \finish(A, B, b), a, termination);

  \eval \run(A, B, (x: A) => \finish(A, B, b), a, termination);
  \normalize \run(A, B, (x: A) => \finish(A, B, b), a, termination);
}
