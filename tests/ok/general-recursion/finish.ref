/* A checked CBPV run reduces to return when its step finishes. */
\module RunFinish(
  A: \VType,
  B: \VType,
  a: A,
  b: B
) {
  \vdefinition step: \U((A ~> \F(\PRunStep(A, B)))) :=
    \thunk((\cfun (x: A) => \return(\Pfinish(A, B, b))));
  \definition stepSet: A -> \RunStep(A, B) :=
    step;
  \definition ready: \RunStep(A, B) -> \Prop :=
    \fun (r: \RunStep(A, B)) => \Pred(A,
      \runStepRec(A, B, \fun (r: \RunStep(A, B)) => \Power(A),
        \fun (s: A) => \Subset(x, A, \Acc(A, B, stepSet, s)),
        \fun (o: B) => \Subset(x, A, a = a), r), a);
  \definition terminates: \forall (s: A) -> \Acc(A, B, stepSet, s) :=
    \fun (s: A) => \accintro(A, B, stepSet, s,
      \fun (next: A) => \fun (edge: stepSet s = \continue(A, B, next)) =>
        \idelim(stepSet s = \continue(A, B, next)
          \with r: \RunStep(A, B) => ready r) \by (\refl(a), edge));
  \cdefinition result: \F(B) := \Prun(A, B, step, a) \by terminates a;

  \ceval \Prun(A, B, step, a) \by terminates a;
  \cnormalize \Prun(A, B, step, a) \by terminates a;
}
