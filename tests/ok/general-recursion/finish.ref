/* A checked CBPV run reduces to return when its step finishes. */
\module RunFinish(
  A: \VType,
  B: \VType,
  a: A,
  b: B,
  termination:
    \Acc(A, B,
      \thunk(\clam(x, A, \return(\finish(A, B, b)))),
      \RfTerm(A, a))
) {
  \definition step: \U(\CFun(A, \F(\RunStep(A, B)))) :=
    \thunk(\clam(x, A, \return(\finish(A, B, b))));
  \definition result: \F(B) := \run(A, B, step, a, termination);

  \eval \run(A, B, step, a, termination);
  \normalize \run(A, B, step, a, termination);
}
