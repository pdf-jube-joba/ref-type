/* Iterative quick sort using an explicit stack of sort/emit tasks.
 * Partitioning and list helpers are primitive recursive; the scheduler uses run.
 */
\module QuickSort {
  \inductive Bool: \Type :=
  | true: Bool;
  | false: Bool;
  ;

  \inductive Nat: \Type :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \inductive List: \Type :=
  | nil: List;
  | cons: Nat -> List -> List;
  ;

  \inductive Task: \Type :=
  | sort: List -> Task;
  | emit: Nat -> Task;
  ;

  \inductive Tasks: \Type :=
  | done: Tasks;
  | push: Task -> Tasks -> Tasks;
  ;

  \inductive State: \Type :=
  | state: Tasks -> List -> State;
  ;

  \definition lessOrEqual: Nat -> Nat -> Bool :=
    (left: Nat) =>
      \prec(\Type, Nat)
        ((current: Nat) => Nat -> Bool)
        ((right: Nat) => Bool#true)
        ((leftPrefix: Nat) => (prefixComparison: Nat -> Bool) => (right: Nat) =>
          \prec(\Type, Nat)
            ((current: Nat) => Bool)
            Bool#false
            ((rightPrefix: Nat) => (ignoredResult: Bool) =>
              prefixComparison rightPrefix)
            right)
        left;

  \definition ifList: Bool -> List -> List -> List :=
    (condition: Bool) => (whenTrue: List) => (whenFalse: List) =>
      \prec(\Type, Bool)
        ((current: Bool) => List)
        whenTrue
        whenFalse
        condition;

  \definition appendOne: List -> Nat -> List :=
    (values: List) => (value: Nat) =>
      \prec(\Type, List)
        ((current: List) => List)
        (List#cons value List#nil)
        ((head: Nat) => (tail: List) => (appendedTail: List) =>
          List#cons head appendedTail)
        values;

  \definition keepLessOrEqual: Nat -> List -> List :=
    (pivot: Nat) => (values: List) =>
      \prec(\Type, List)
        ((current: List) => List)
        List#nil
        ((head: Nat) => (tail: List) => (filteredTail: List) =>
          ifList
            (lessOrEqual head pivot)
            (List#cons head filteredTail)
            filteredTail)
        values;

  \definition keepGreater: Nat -> List -> List :=
    (pivot: Nat) => (values: List) =>
      \prec(\Type, List)
        ((current: List) => List)
        List#nil
        ((head: Nat) => (tail: List) => (filteredTail: List) =>
          ifList
            (lessOrEqual head pivot)
            filteredTail
            (List#cons head filteredTail))
        values;

  \definition quickSortStep: State -> \RunStep(State, List) :=
    (current: State) =>
      \prec(\Type, State)
        ((stateValue: State) => \RunStep(State, List))
        ((work: Tasks) => (output: List) =>
          \prec(\Type, Tasks)
            ((remaining: Tasks) => \RunStep(State, List))
            (\finish(State, List, output))
            ((task: Task) =>
             (rest: Tasks) =>
             (ignoredTasksResult: \RunStep(State, List)) =>
              \prec(\Type, Task)
                ((currentTask: Task) => \RunStep(State, List))
                ((values: List) =>
                  \prec(\Type, List)
                    ((currentList: List) => \RunStep(State, List))
                    (\continue(State, List, State#state rest output))
                    ((pivot: Nat) =>
                     (tail: List) =>
                     (ignoredListResult: \RunStep(State, List)) =>
                      \continue(
                        State,
                        List,
                        State#state
                          (Tasks#push
                            (Task#sort (keepLessOrEqual pivot tail))
                            (Tasks#push
                              (Task#emit pivot)
                              (Tasks#push
                                (Task#sort (keepGreater pivot tail))
                                rest)))
                          output))
                    values)
                ((value: Nat) =>
                  \continue(
                    State,
                    List,
                    State#state rest (appendOne output value)))
                task)
            work)
        current;

  \definition one: Nat := Nat#succ Nat#zero;
  \definition two: Nat := Nat#succ one;
  \definition three: Nat := Nat#succ two;

  \definition input: List :=
    List#cons three (List#cons one (List#cons two List#nil));

  \definition expected: List :=
    List#cons one (List#cons two (List#cons three List#nil));

  \definition initial: State :=
    State#state
      (Tasks#push (Task#sort input) Tasks#done)
      List#nil;

  \inductive IsExpected: (value: List) -> \Type :=
  | witness: IsExpected expected;
  ;

  /* Accessibility proves that task expansion eventually empties the stack. */
  \module Evaluate(
    termination:
      \Acc(State, List, quickSortStep, \RfTerm(State, initial))
  ) {
    \definition result: List :=
      \run(State, List, quickSortStep, initial, termination);

    /* This checks only when the normal form is [one, two, three]. */
    \definition computesToExpected: IsExpected result := IsExpected#witness;
  }
}
