/* Program datatype fields are bound as values in vcase branches. */
\module PairProgram(A: \VType, a: A, b: A) {
  \inductive Pair(X: \VType): \VType :=
  | pair: X -> X -> Pair;
  ;

  \definition input: Pair[A] := Pair[A]#pair a b;
  \definition swap: \CFun(Pair[A], \F(Pair[A])) :=
    \clam(p, Pair[A],
      \vcase(Pair, p) {
      | pair(left, right) => \return(Pair[A]#pair right left);
      });
  \normalize \capp(swap, input);
}
