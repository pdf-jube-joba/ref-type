/* Reflection exposes non-dependent compute arrows and reflected application. */
\module GeneralRecursionReflection(
  A: \Type,
  B: \Type,
  f: A -> B,
  a: A
) {
  \definition reflectedArrow: \Set(0) := \RfType(A -> B);
  \definition reflectedFunction: \RfType(A -> B) := \RfTerm(A -> B, f);
  \definition reflectedArgument: \RfType(A) := \RfTerm(A, a);

  \normalize \RfType(A -> B);
  \normalize (\RfTerm(A -> B, f)) (\RfTerm(A, a));
}
