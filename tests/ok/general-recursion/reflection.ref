/* Box/Force expose closed, well-terminated Program terms through reflection. */
\module ProgramReflection {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \cdefinition identity: (Bit ~> \F(Bit)) :=
    (\cfun (x: Bit) => \return(x));
  \definition boxedIdentity: \Box((Bit ~> \F(Bit))) :=
    \box((Bit ~> \F(Bit)), identity);
  \definition boxedZero: \Box(Bit) :=
    \box(Bit, Bit::zero);

  \infer \Force(Bit, boxedZero);
  \normalize \Force(Bit, boxedZero);
  \normalize \Force(
    \F(Bit),
    \boxapp(boxedIdentity, boxedZero));
  \infer \prec(\Set(0), Bit);
}
