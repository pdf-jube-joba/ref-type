/* Reflection exposes CBPV functions and generated datatype mirrors. */
\module ProgramReflection {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \definition identity: \CFun(Bit, \F(Bit)) :=
    \clam(x, Bit, \return(x));
  \definition reflectedType: \Set(0) := \RfType(Bit);
  \definition reflectedArrow: \Set(0) :=
    \RfType(\CFun(Bit, \F(Bit)));
  \definition reflectedZero: \RfType(Bit) :=
    \RfTerm(Bit, Bit#zero);

  \normalize \RfType(Bit);
  \normalize
    (\RfTerm(\CFun(Bit, \F(Bit)), identity))
    (\RfTerm(Bit, Bit#zero));
  \infer \prec(\Set(0), Bit);
}
