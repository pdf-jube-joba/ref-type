/* Box/Force expose closed, well-terminated Program terms through reflection. */
\module ProgramReflection {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \definition identity: (Bit ~> \F(Bit)) :=
    (\cfun (x: Bit) => \return(x));
  \definition boxedIdentity: \Box((Bit ~> \F(Bit))) :=
    \box((Bit ~> \F(Bit)), identity);
  \definition boxedZero: \Box(\F(Bit)) :=
    \box(\F(Bit), \return(Bit::zero));

  \infer \Force(\F(Bit), boxedZero);
  \normalize \Force(\F(Bit), boxedZero);
  \normalize \Force(
    \F(Bit),
    \boxapp(boxedIdentity, boxedZero));
  \infer \prec(\Set(0), Bit^);
}
