/* Program runCase carries its already-evaluating transition computation. */
\module ExplicitRunCase(
  A: \VType,
  B: \VType,
  step: \U((A ~> \F(\PRunStep(A, B)))),
  initial: A,
  termination: \Acc(A^, B^, step^, initial^)
) {
  \definition result: \F(B) :=
    \PrunCase(
      A,
      B,
      step,
      initial,
      ((\force(step)) initial)) \by (termination,
        \refl(step^ initial^));
}
