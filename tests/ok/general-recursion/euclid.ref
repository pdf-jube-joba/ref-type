/* Program runCase carries its already-evaluating transition computation. */
\module ExplicitRunCase(
  A: \VType,
  B: \VType,
  step: \U(\CFun(A, \F(\PRunStep(A, B)))),
  initial: A
) {
  \cdefinition result: \F(B) :=
    \PrunCase(
      A,
      B,
      step,
      initial,
      \capp(\force(step), initial));
}
