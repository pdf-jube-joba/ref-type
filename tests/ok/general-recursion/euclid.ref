/* runCase carries both its termination and one-step invariant certificates. */
\module ExplicitRunCase(
  A: \VType,
  B: \VType,
  step: \U(\CFun(A, \F(\RunStep(A, B)))),
  initial: A,
  termination: \Acc(A, B, step, \RfTerm(A, initial))
) {
  \definition result: \F(B) :=
    \runCase(
      A,
      B,
      step,
      initial,
      \capp(\force(step), initial),
      termination,
      \refl(\RfTerm(
        \F(\RunStep(A, B)),
        \capp(\force(step), initial))));
}
