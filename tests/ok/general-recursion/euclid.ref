/* Euclid's algorithm as a checked general-recursive computation.
 * The remainder helper is primitive recursive; gcd itself iterates with run.
 */
\module Euclid {
  \inductive Nat: \Type :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \inductive State: \Type :=
  | state: Nat -> Nat -> State;
  ;

  \inductive RemainderState: \Type :=
  | state: Nat -> Nat -> RemainderState;
  ;

  \definition predecessor: Nat -> Nat :=
    (n: Nat) =>
      \prec(\Type, Nat)
        ((current: Nat) => Nat)
        Nat#zero
        ((prefix: Nat) => (ignoredResult: Nat) => prefix)
        n;

  \definition advanceRemainder:
    Nat -> RemainderState -> RemainderState :=
    (limit: Nat) => (current: RemainderState) =>
      \prec(\Type, RemainderState)
        ((stateValue: RemainderState) => RemainderState)
        ((residue: Nat) => (countdown: Nat) =>
          \prec(\Type, Nat)
            ((countdownValue: Nat) => RemainderState)
            (RemainderState#state Nat#zero limit)
            ((countdownPrefix: Nat) => (ignoredResult: RemainderState) =>
              RemainderState#state (Nat#succ residue) countdownPrefix)
            countdown)
        current;

  \definition remainderValue: RemainderState -> Nat :=
    (current: RemainderState) =>
      \prec(\Type, RemainderState)
        ((stateValue: RemainderState) => Nat)
        ((residue: Nat) => (countdown: Nat) => residue)
        current;

  /* For a positive divisor, increment a residue and wrap at the divisor.
   * The recursive state is evaluated once at each CBV step.
   */
  \definition remainder: Nat -> Nat -> Nat :=
    (dividend: Nat) => (divisor: Nat) =>
      ((limit: Nat) =>
        remainderValue
          (\prec(\Type, Nat)
            ((current: Nat) => RemainderState)
            (RemainderState#state Nat#zero limit)
            ((prefix: Nat) => (state: RemainderState) =>
              advanceRemainder limit state)
            dividend))
      (predecessor divisor);

  \definition gcdStep: State -> \RunStep(State, Nat) :=
    (current: State) =>
      \prec(\Type, State)
        ((stateValue: State) => \RunStep(State, Nat))
        ((left: Nat) => (right: Nat) =>
          \prec(\Type, Nat)
            ((rightValue: Nat) => \RunStep(State, Nat))
            (\finish(State, Nat, left))
            ((rightPrefix: Nat) => (ignoredResult: \RunStep(State, Nat)) =>
              \continue(
                State,
                Nat,
                State#state right (remainder left right)))
            right)
        current;

  \definition one: Nat := Nat#succ Nat#zero;
  \definition two: Nat := Nat#succ one;
  \definition three: Nat := Nat#succ two;
  \definition four: Nat := Nat#succ three;
  \definition five: Nat := Nat#succ four;
  \definition six: Nat := Nat#succ five;
  \definition seven: Nat := Nat#succ six;
  \definition eight: Nat := Nat#succ seven;
  \definition nine: Nat := Nat#succ eight;
  \definition ten: Nat := Nat#succ nine;
  \definition eleven: Nat := Nat#succ ten;
  \definition twelve: Nat := Nat#succ eleven;
  \definition thirteen: Nat := Nat#succ twelve;
  \definition fourteen: Nat := Nat#succ thirteen;
  \definition fifteen: Nat := Nat#succ fourteen;
  \definition sixteen: Nat := Nat#succ fifteen;
  \definition seventeen: Nat := Nat#succ sixteen;
  \definition eighteen: Nat := Nat#succ seventeen;
  \definition twelveAndEighteen: State := State#state twelve eighteen;

  \inductive IsSix: (value: Nat) -> \Type :=
  | witness: IsSix six;
  ;

  /* Accessibility is the logical termination argument; run erases it. */
  \module Evaluate(
    termination:
      \Acc(State, Nat, gcdStep, \RfTerm(State, twelveAndEighteen))
  ) {
    \definition result: Nat :=
      \run(State, Nat, gcdStep, twelveAndEighteen, termination);

    /* This checks only when the normal form of result is six. */
    \definition computesToSix: IsSix result := IsSix#witness;
  }
}
