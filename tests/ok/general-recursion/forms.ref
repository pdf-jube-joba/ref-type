/* CBPV type, value, and computation forms are separate judgements. */
\module ProgramForms(
  A: \VType,
  a: A,
  suspended: \U(\F(A))
) {
  \cdefinition identity: \CFun(A, \F(A)) :=
    \clam(x, A, \return(x));
  \vdefinition thunked: \U(\CFun(A, \F(A))) := \thunk(identity);
  \cdefinition forced: \CFun(A, \F(A)) := \force(thunked);
  \cdefinition applied: \F(A) := \capp(identity, a);
  \cdefinition sequenced: \F(A) :=
    \sequence(\return(a), x, A, \return(x));
  \cdefinition valueLet: \F(A) :=
    \vlet(x, a, \return(x));
  \cdefinition forceParameter: \F(A) := \force(suspended);
  \ceval identity;
  \ceval applied;
}
