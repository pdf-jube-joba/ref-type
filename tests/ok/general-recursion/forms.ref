/* CBPV type, value, and computation forms are separate judgements. */
\module ProgramForms(
  A: \VType,
  a: A,
  suspended: \U(\F(A))
) {
  \cdefinition identity: A ~> \F(A) :=
    \cfun (x: A) => \return x;
  \vdefinition thunked: \U(A ~> \F(A)) := \thunk identity;
  \cdefinition forced: A ~> \F(A) := \force thunked;
  \cdefinition applied: \F(A) := \capp(identity, a);
  \cdefinition sequenced: \F(A) := \do {
    \bind x: A <- \return a;
    \return x
  };
  \cdefinition valueLet: \F(A) := \do {
    \let x: A := a;
    \return x
  };
  \cdefinition forceParameter: \F(A) := \force suspended;
  \ceval identity;
  \ceval applied;
}
