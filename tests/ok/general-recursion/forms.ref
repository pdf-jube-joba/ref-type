/* CBPV type, value, and computation forms are separate judgements. */
\module ProgramForms(
  A: \VType,
  a: A,
  suspended: \U(\F(A))
) {
  \definition identity: \CFun(A, \F(A)) :=
    \clam(x, A, \return(x));
  \definition thunked: \U(\CFun(A, \F(A))) := \thunk(identity);
  \definition forced: \CFun(A, \F(A)) := \force(thunked);
  \definition applied: \F(A) := \capp(identity, a);
  \definition sequenced: \F(A) :=
    \sequence(\return(a), x, A, \return(x));
  \definition valueLet: \F(A) :=
    \vlet(x, a, \return(x));
  \definition forceParameter: \F(A) := \force(suspended);
  \infer identity;
  \check applied: \F(A);
}
