/* CBPV type, value, and computation forms are separate judgements. */
\module ProgramForms(
  A: \VType,
  a: A,
  suspended: \U(\F(A))
) {
  \cdefinition identity(x: A): \F(A) := \return x;
  \cdefinition inferred(x: _): \F(A) := \return x;
  \vdefinition thunked: \U(A ~> \F(A)) := \thunk identity;
  \cdefinition forced: A ~> \F(A) := \force thunked;
  \cdefinition applied: \F(A) := identity a;
  \cdefinition sequenced: \F(A) :=
    \bind x: A <- \return a \in \return x;
  \cdefinition valueLet: \F(A) :=
    \let x: A := a \in \return x;
  \cdefinition forceParameter: \F(A) := \force suspended;
  \ceval identity;
  \ceval applied;
}
