\module ProgramInductive {
  \inductive Bit: \VType :=
  | zero: Bit
  | one: Bit
  ;

  \definition zero: Bit := Bit::zero;
  \definition flip: (Bit ~> \F(Bit)) :=
    (\cfun (x: Bit) => \match (x) \in Bit \with {
      | zero => \return(Bit::one)
      | one => \return(Bit::zero)
      });

  \definition one: \F(Bit) := (flip zero);
  \cnormalize (flip zero);
}
