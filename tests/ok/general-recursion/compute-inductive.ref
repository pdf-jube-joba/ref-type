\module ProgramInductive {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \vdefinition zero: Bit := Bit::zero;
  \cdefinition flip: (Bit ~> \F(Bit)) :=
    (\cfun (x: Bit) => \match (x) \in Bit \with {
      | zero => \return(Bit::one);
      | one => \return(Bit::zero);
      });

  \cdefinition one: \F(Bit) := (flip zero);
  \cnormalize (flip zero);
}
