\module ProgramInductive {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \definition zero: Bit := Bit#zero;
  \definition flip: \CFun(Bit, \F(Bit)) :=
    \clam(x, Bit,
      \vcase(Bit, x) {
      | zero() => \return(Bit#one);
      | one() => \return(Bit#zero);
      });

  \definition one: \F(Bit) := \capp(flip, zero);
  \normalize \capp(flip, zero);
}
