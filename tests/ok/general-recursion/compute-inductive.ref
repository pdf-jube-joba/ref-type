\module ProgramInductive {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \vdefinition zero: Bit := Bit::zero;
  \cdefinition flip: (Bit ~> \F(Bit)) :=
    (\cfun (x: Bit) => \case (x) \in Bit {
      | zero() => \return(Bit::one);
      | one() => \return(Bit::zero);
      });

  \cdefinition one: \F(Bit) := \capp(flip, zero);
  \cnormalize \capp(flip, zero);
}
