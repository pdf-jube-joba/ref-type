\module ProgramInductive {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;

  \vdefinition zero: Bit := Bit::zero;
  \cdefinition flip: \CFun(Bit, \F(Bit)) :=
    \clam(x, Bit,
      \vcase(Bit, x) {
      | zero() => \return(Bit::one);
      | one() => \return(Bit::zero);
      });

  \cdefinition one: \F(Bit) := \capp(flip, zero);
  \cnormalize \capp(flip, zero);
}
