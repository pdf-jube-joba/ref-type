/* Conversion, not just normalization, must expose named boxes and Programs. */
\module ReflectionConversion {
  \inductive Nat: \VType := | zero: Nat; | succ: Nat -> Nat; ;
  \inductive Wrap(A: \VType): \VType := | wrap: A -> Wrap; ;
  \cdefinition identity: (Nat ~> \F(Nat)) := (\cfun (x: Nat) => \return(x));
  \definition boxedIdentity: \Box((Nat ~> \F(Nat))) :=
    \box((Nat ~> \F(Nat)), identity);
  \definition boxedZero: \Box(Nat) := \box(Nat, Nat::zero);
  \definition identitySet: Nat -> Nat := \Force((Nat ~> \F(Nat)), boxedIdentity);
  \definition symbolic: \forall (x: Nat) -> identitySet x = x := \fun (x: Nat) => \refl(x);
  \definition boxedApplication:
    \Force(\F(Nat), \boxapp(boxedIdentity, boxedZero)) = Nat::zero := \refl(Nat::zero);
  \definition mirrorConstructor: Wrap[Nat] := Wrap[Nat]::wrap Nat::zero;
  \definition mirrorAgrees:
    mirrorConstructor = \Force(Wrap[Nat], \box(Wrap[Nat], Wrap[Nat]::wrap Nat::zero)) :=
    \refl(mirrorConstructor);
  \definition unwrap: Wrap[Nat] -> Nat := \prec(\Set, Wrap[Nat])
    (\fun (x: Wrap[Nat]) => Nat) (\fun (n: Nat) => n);
  \definition mirrorRecursor: unwrap mirrorConstructor = Nat::zero := \refl(Nat::zero);
}
