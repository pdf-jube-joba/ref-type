\module RecursiveProgramInductive {
  \inductive Nat: \VType :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \definition one: Nat := Nat::succ Nat::zero;
  \definition predecessor: \CFun(Nat, \F(Nat)) :=
    \clam(n, Nat,
      \vcase(Nat, n) {
      | zero() => \return(Nat::zero);
      | succ(previous) => \return(previous);
      });
  \normalize \capp(predecessor, one);
  \normalize \RfTerm(Nat, one);
}
