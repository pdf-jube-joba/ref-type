\module RecursiveProgramInductive {
  \inductive Nat: \VType :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \vdefinition one: Nat := Nat::succ Nat::zero;
  \cdefinition predecessor: (Nat ~> \F(Nat)) :=
    (\cfun (n: Nat) => \match (n) \in Nat \with {
      | zero => \return(Nat::zero);
      | succ previous => \return(previous);
      });
  \cnormalize (predecessor one);
  \definition boxedOne: \Box(Nat) := \box(Nat, one);
  \normalize \Force(Nat, boxedOne);
}
