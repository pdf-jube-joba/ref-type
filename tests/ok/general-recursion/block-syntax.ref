/* Surface sequencing preserves CBPV value/computation scopes and evaluation. */
\module Blocks {
  \inductive Bit: \VType :=
  | zero: Bit;
  | one: Bit;
  ;
  \cdefinition identity(x: Bit): \F(Bit) := \return x;
  \cdefinition first(x, y: Bit): \F(Bit) := \return x;
  \cdefinition second(x: Bit)(y: Bit): \F(Bit) := \return y;
  \vdefinition suspended: \U(Bit ~> \F(Bit)) := \thunk identity;
  \cdefinition result: \F(Bit) :=
    \let x: Bit := Bit::one \in
    \bind x: Bit <- \force suspended x \in
    \bind x: Bit <- first x Bit::zero \in
    \match x \in Bit \with {
      | zero => \return Bit::zero;
      | one =>
          \let y: Bit := x \in
          second Bit::zero y;
    };
  \ceval result;
  \ccheck result: \F(Bit);
}
