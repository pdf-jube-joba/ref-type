/* Parameterized Program datatypes generate parameterized Set mirrors. */
\module ParameterizedReflection(A: \VType, a: A) {
  \inductive Box(X: \VType): \VType :=
  | box: X -> Box;
  ;

  \definition boxed: Box[A] := Box[A]#box a;
  \definition reflectedBoxType: \Set(0) := \RfType(Box[A]);
  \definition reflectedBox: \RfType(Box[A]) :=
    \RfTerm(Box[A], boxed);
  \normalize \RfType(Box[A]);
  \normalize \RfTerm(Box[A], boxed);
}
