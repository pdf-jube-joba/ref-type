/* Reflection connects a Compute gcd to the length index of a Set-valued list. */
\module ReflectedGcdLength(Element: \Set, element: Element) {
  /* The arithmetic state remains entirely in the Compute universe. */
  \inductive Nat: \Type :=
  | zero: Nat;
  | succ: Nat -> Nat;
  ;

  \inductive GcdState: \Type :=
  | state: Nat -> Nat -> GcdState;
  ;

  \inductive RemainderState: \Type :=
  | state: Nat -> Nat -> RemainderState;
  ;

  /* List elements live in Set, not in Type. */
  \inductive List(A: \Set): \Set :=
  | nil: List;
  | cons: A -> List -> List;
  ;

  \definition one: Nat := Nat#succ Nat#zero;
  \definition two: Nat := Nat#succ one;
  \definition three: Nat := Nat#succ two;
  \definition four: Nat := Nat#succ three;
  \definition five: Nat := Nat#succ four;
  \definition six: Nat := Nat#succ five;
  \definition seven: Nat := Nat#succ six;
  \definition eight: Nat := Nat#succ seven;
  \definition nine: Nat := Nat#succ eight;
  \definition ten: Nat := Nat#succ nine;
  \definition eleven: Nat := Nat#succ ten;
  \definition twelve: Nat := Nat#succ eleven;
  \definition thirteen: Nat := Nat#succ twelve;
  \definition fourteen: Nat := Nat#succ thirteen;
  \definition fifteen: Nat := Nat#succ fourteen;
  \definition sixteen: Nat := Nat#succ fifteen;
  \definition seventeen: Nat := Nat#succ sixteen;
  \definition eighteen: Nat := Nat#succ seventeen;

  \definition predecessor: Nat -> Nat :=
    (n: Nat) =>
      \prec(\Type, Nat)
        ((current: Nat) => Nat)
        Nat#zero
        ((prefix: Nat) => (ignoredResult: Nat) => prefix)
        n;

  \definition advanceRemainder:
    Nat -> RemainderState -> RemainderState :=
    (limit: Nat) => (current: RemainderState) =>
      \prec(\Type, RemainderState)
        ((stateValue: RemainderState) => RemainderState)
        ((residue: Nat) => (countdown: Nat) =>
          \prec(\Type, Nat)
            ((countdownValue: Nat) => RemainderState)
            (RemainderState#state Nat#zero limit)
            ((countdownPrefix: Nat) => (ignoredResult: RemainderState) =>
              RemainderState#state (Nat#succ residue) countdownPrefix)
            countdown)
        current;

  \definition remainderValue: RemainderState -> Nat :=
    (current: RemainderState) =>
      \prec(\Type, RemainderState)
        ((stateValue: RemainderState) => Nat)
        ((residue: Nat) => (countdown: Nat) => residue)
        current;

  /* The primitive-recursive state is evaluated once before each step uses it.
   * A countdown avoids the nested equality recursion that strict CBV would
   * otherwise evaluate eagerly.
   */
  \definition remainder: Nat -> Nat -> Nat :=
    (dividend: Nat) => (divisor: Nat) =>
      ((limit: Nat) =>
        remainderValue
          (\prec(\Type, Nat)
            ((current: Nat) => RemainderState)
            (RemainderState#state Nat#zero limit)
            ((prefix: Nat) => (state: RemainderState) =>
              advanceRemainder limit state)
            dividend))
      (predecessor divisor);

  /* Euclid's algorithm using remainder. */
  \definition gcdStep: GcdState -> \RunStep(GcdState, Nat) :=
    (current: GcdState) =>
      \prec(\Type, GcdState)
        ((stateValue: GcdState) => \RunStep(GcdState, Nat))
        ((left: Nat) => (right: Nat) =>
          \prec(\Type, Nat)
            ((rightValue: Nat) => \RunStep(GcdState, Nat))
            (\finish(GcdState, Nat, left))
            ((rightPrefix: Nat) => (ignoredResult: \RunStep(GcdState, Nat)) =>
              \continue(
                GcdState,
                Nat,
                GcdState#state right (remainder left right)))
            right)
        current;

  /* Reflection of succ turns a reflected Nat into another reflected Nat. */
  \definition length:
    (A: \Set) -> List[A] -> \RfType(Nat) :=
    (A: \Set) => (values: List[A]) =>
      \prec(\Set, List[A])
        ((current: List[A]) => \RfType(Nat))
        (\RfTerm(Nat, Nat#zero))
        ((head: A) =>
         (tail: List[A]) =>
         (tailLength: \RfType(Nat)) =>
          (\RfTerm(Nat -> Nat, Nat#succ)) tailLength)
        values;

  /* Lists whose length is the Set-side value n. */
  \definition ListsOfLength:
    (A: \Set) -> \RfType(Nat) -> \Power(List[A]) :=
    (A: \Set) => (n: \RfType(Nat)) =>
      \Subset(values, List[A], length A values = n);

  \definition LengthIndexedList:
    (A: \Set) -> \RfType(Nat) -> \Set :=
    (A: \Set) => (n: \RfType(Nat)) =>
      \Ty(List[A], ListsOfLength A n);

  \definition twelveAndEighteen: GcdState :=
    GcdState#state twelve eighteen;

  \module Evaluate(
    termination:
      \Acc(
        GcdState,
        Nat,
        gcdStep,
        \RfTerm(GcdState, twelveAndEighteen))
  ) {
    \definition gcdResult: Nat :=
      \run(GcdState, Nat, gcdStep, twelveAndEighteen, termination);

    \definition reflectedGcd: \RfType(Nat) :=
      \RfTerm(Nat, gcdResult);

    /* Reflection normalizes through run: remainder-based gcd(12, 18) = 6. */
    \definition reflectedGcdIsSix:
      reflectedGcd = \RfTerm(Nat, six) :=
      \refl(reflectedGcd);

    \definition candidate: List[Element] :=
      List[Element]#cons element
        (List[Element]#cons element
          (List[Element]#cons element
            (List[Element]#cons element
              (List[Element]#cons element
                (List[Element]#cons element List[Element]#nil)))));

    /* Reflected application of succ computes the Set-side list length. */
    \definition candidateLengthIsSix:
      length Element candidate = \RfTerm(Nat, six) :=
      \refl(length Element candidate);

    \definition GcdLengthLists: \Power(List[Element]) :=
      ListsOfLength Element reflectedGcd;

    \definition GcdLengthList: \Set :=
      LengthIndexedList Element reflectedGcd;

    \definition candidateHasGcdLength:
      \Pred(List[Element], GcdLengthLists, candidate) :=
      /* This succeeds only when both sides normalize to reflected six. */
      \refl(length Element candidate);

    /* A Set-valued list refined by a length computed in Type. */
    \definition checkedList: GcdLengthList :=
      \subsetinto(
        List[Element],
        GcdLengthLists,
        candidate,
        candidateHasGcdLength);
  }
}
