/* Parameterized Program datatypes generate parameterized Set mirrors. */
\module ParameterizedReflection {
  \inductive Unit: \VType :=
  | unit: Unit;
  ;

  \inductive Box(X: \VType): \VType :=
  | box: X -> Box;
  ;

  \definition boxed: Box[Unit] := Box[Unit]::box Unit::unit;
  \definition package: \Box(Box[Unit]) :=
    \box(Box[Unit], boxed);
  \infer \Force(Box[Unit], package);
  \normalize \Force(Box[Unit], package);
}
