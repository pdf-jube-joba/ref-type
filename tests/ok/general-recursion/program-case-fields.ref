/* Program datatype fields are bound as values in case branches. */
\module PairProgram(A: \VType, a: A, b: A) {
  \inductive Pair(X: \VType): \VType :=
  | pair: X -> X -> Pair;
  ;

  \vdefinition input: Pair[A] := Pair[A]::pair a b;
  \cdefinition swap: Pair[A] ~> \F(Pair[A]) :=
    \cfun (p: Pair[A]) => \match p \in Pair \with {
      | pair left right => \return Pair[A]::pair right left;
    };
  \cnormalize (swap input);
}
