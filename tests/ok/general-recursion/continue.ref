/* A Program run may continue to a new state before finishing. */
\module RunContinue {
  \inductive True: \Prop := | intro: True;
  \inductive State: \VType :=
  | first: State
  | last: State
  ;

  \definition step: \U((State ~> \F(\RunStep[State, State]))) :=
    \thunk((\cfun (state: State) => \match (state) \in State \with {
      | first : \return(\continue[State, State](State::last))
      | last : \return(\finish[State, State](State::last))
      }));


  \definition ready: \RunStep[State^, State^] -> \Prop :=
    \step-match r: \RunStep[State^, State^] \return \Prop \with {
      | \continue s: \Acc[State^, State^](step^, s)
      | \finish o: True
    };
  \definition accIntro: \forall (s: State^) -> ready (step^ s) -> \Acc[State^, State^](step^, s) :=
    \fun (s: State^) => \fun (proof: ready (step^ s)) =>
      \accintro[State^, State^](step^, s, \fun (next: State^) => \fun (edge: step^ s = \continue[State^, State^](next)) =>
          \idelim step^ s = \continue[State^, State^](next)
            \with r: \RunStep[State^, State^] => ready r \by { base: proof, equality: edge });
  \definition lastTerminates: \Acc[State^, State^](step^, State^::last) :=
    accIntro State^::last True::intro;
  \definition firstTerminates: \Acc[State^, State^](step^, State^::first) :=
    accIntro State^::first lastTerminates;

  \definition result: \F(State) :=
    \run[State, State](step, State::first) \by { firstTerminates };
  \cnormalize \run[State, State](step, State::first) \by { firstTerminates };
}
