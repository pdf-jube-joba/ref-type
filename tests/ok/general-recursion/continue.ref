/* A Program run may continue to a new state before finishing. */
\module RunContinue {
  \inductive State: \VType :=
  | first: State;
  | last: State;
  ;

  \definition step: \U((State ~> \F(\PRunStep(State, State)))) :=
    \thunk((\cfun (state: State) => \match (state) \in State \with {
      | first => \return(\Pcontinue(State, State, State::last))
      | last => \return(\Pfinish(State, State, State::last))
      }));

  \definition stepSet: State^ -> \RunStep(State^, State^) :=
    \Force(\U((State ~> \F(\PRunStep(State, State)))),
      \box(\U((State ~> \F(\PRunStep(State, State)))), step));
  \definition ready: \RunStep(State^, State^) -> \Prop :=
    \fun (r: \RunStep(State^, State^)) => \Pred(State^,
      \runStepRec(State^, State^, \fun (r: \RunStep(State^, State^)) => \Power(State^),
        \fun (s: State^) => \Subset(x, State^, \Acc(State^, State^, stepSet, s)),
        \fun (o: State^) => \Subset(x, State^, State^::last = State^::last), r), State^::last);
  \definition accIntro: \forall (s: State^) -> ready (stepSet s) -> \Acc(State^, State^, stepSet, s) :=
    \fun (s: State^) => \fun (proof: ready (stepSet s)) =>
      \accintro(State^, State^, stepSet, s,
        \fun (next: State^) => \fun (edge: stepSet s = \continue(State^, State^, next)) =>
          \idelim(stepSet s = \continue(State^, State^, next)
            \with r: \RunStep(State^, State^) => ready r) \by (proof, edge));
  \definition lastTerminates: \Acc(State^, State^, stepSet, State^::last) :=
    accIntro State^::last (\refl(State^::last));
  \definition firstTerminates: \Acc(State^, State^, stepSet, State^::first) :=
    accIntro State^::first lastTerminates;

  \definition result: \F(State) :=
    \Prun(State, State, step, State::first) \by firstTerminates;
  \cnormalize \Prun(State, State, step, State::first) \by firstTerminates;
}
