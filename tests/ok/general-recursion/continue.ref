/* A certified run may continue to a new state before finishing. */
\module RunContinue {
  \inductive State: \VType :=
  | first: State;
  | last: State;
  ;

  \definition step: \U(\CFun(State, \F(\RunStep(State, State)))) :=
    \thunk(\clam(state, State,
      \vcase(State, state) {
      | first() => \return(\continue(State, State, State#last));
      | last() => \return(\finish(State, State, State#last));
      }));

  \module Certified(
    termination:
      \Acc(State, State, step, \RfTerm(State, State#first))
  ) {
    \definition result: \F(State) :=
      \run(State, State, step, State#first, termination);
    \normalize \run(State, State, step, State#first, termination);
  }
}
