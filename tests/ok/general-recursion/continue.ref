/* A Program run may continue to a new state before finishing. */
\module RunContinue {
  \inductive State: \VType :=
  | first: State;
  | last: State;
  ;

  \definition step: \U(\CFun(State, \F(\RunStep(State, State)))) :=
    \thunk(\clam(state, State,
      \vcase(State, state) {
      | first() => \return(\continue(State, State, State::last));
      | last() => \return(\finish(State, State, State::last));
      }));

  \definition result: \F(State) :=
    \run(State, State, step, State::first);
  \normalize \run(State, State, step, State::first);
}
