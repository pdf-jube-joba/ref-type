/* A Program run may continue to a new state before finishing. */
\module RunContinue {
  \inductive State: \VType :=
  | first: State;
  | last: State;
  ;

  \vdefinition step: \U((State ~> \F(\PRunStep(State, State)))) :=
    \thunk((\cfun (state: State) => \case (state) \in State {
      | first() => \return(\Pcontinue(State, State, State::last));
      | last() => \return(\Pfinish(State, State, State::last));
      }));

  \cdefinition result: \F(State) :=
    \Prun(State, State, step, State::first);
  \cnormalize \Prun(State, State, step, State::first);
}
