/* Reflection commutes through U/F before exposing a recursive constructor. */
\module NestedRecursiveReflection {
  \inductive LazyTree: \VType :=
  | leaf: LazyTree;
  | delay: \U(\F(LazyTree)) -> LazyTree;
  ;

  \definition delayedLeaf: LazyTree :=
    LazyTree::delay \thunk(\return(LazyTree::leaf));
  \definition reflected: \RfType(LazyTree) :=
    \RfTerm(LazyTree, delayedLeaf);

  \normalize \RfType(\U(\F(LazyTree)));
  \normalize \RfTerm(LazyTree, delayedLeaf);
}
