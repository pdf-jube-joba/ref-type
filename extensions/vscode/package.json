{
  "name": "ref-type",
  "displayName": "Ref Type",
  "description": "Language support for Ref Type",
  "version": "0.1.0",
  "publisher": "ref-type",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ref"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ref",
        "aliases": [
          "Ref Type",
          "ref"
        ],
        "extensions": [
          ".ref"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ref",
        "scopeName": "source.ref",
        "path": "./syntaxes/ref.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ref Type",
      "properties": {
        "ref.server.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to the ref-lsp executable. When empty, use the bundled server, workspace build, or PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=out/extension.js",
    "check": "tsc -p . --noEmit",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3"
  }
}
