{
  "name": "Ref Type",
  "scopeName": "source.ref",
  "patterns": [
    { "name": "comment.block.ref", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#comments" }] },
    { "name": "string.quoted.double.ref", "begin": "\"", "end": "\"" },
    { "name": "keyword.control.ref", "match": "\\\\[A-Za-z][A-Za-z0-9-]*" },
    { "name": "variable.other.macro.ref", "match": "\\$[A-Za-z][A-Za-z0-9_]*" },
    { "name": "constant.numeric.ref", "match": "\\b[0-9]+\\b" },
    { "name": "keyword.operator.ref", "match": "(?::=|->|=>|~>|<-|::#|::)" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.block.ref", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#comments" }] }] }
  }
}
