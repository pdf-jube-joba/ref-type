\module Shapes {
  \structure Space { Point: \Set, }
}
\module Model(A: \Set) {
  \import \root.Shapes[] \as Shapes;
  \definition space: Shapes.Space := Shapes.Space { Point := A };
}
\module Client(B: \Set, x: B) {
  \import \root.Model[A := B] \as Chosen;
  \definition identity: Chosen.space.Point := x;
}
